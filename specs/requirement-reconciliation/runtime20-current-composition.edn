     {:path
      "docs/phase-10-schema-data-and-interop/152-s8-typed-configuration-and-environment-specification.md",
      :raw-sha256
      "11af2210755137cdb1b6576ecf5e980c3fd4d081770e9a907eeefc281b1d7c76",
      :raw
      "```clojure\n{:artifact :gravity/config-schema\n :schema AppConfig/v1\n :sources [:env :secrets :file]\n :effects #{:build/env :secrets/read :filesystem/read}\n :capabilities #{:env/read :secret/read :fs/read}\n :secret-fields #{:database-url}\n :artifact-policy :redacted}\n```\n",
      :source-occurrence-id
      "S8/source/71359a3519b2a469d74bff103eaeccd16d0b498a0d26d8cfa20bdfef0c92c392",
      :id "facet/runtime-domains-schema/s8/6f9d7beeb03c6f5af27fad81",
      :kind :example,
      :document-id "S8",
      :end-byte 2223,
      :start-byte 1953}
     {:path
      "docs/phase-10-schema-data-and-interop/152-s8-typed-configuration-and-environment-specification.md",

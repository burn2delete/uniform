      :raw
      "Diagnostics must include config id, field path, source, source span or artifact\nedge, effect, capability, secret/redaction state, and remediation.\n",
      :source-occurrence-id
      "S8/source/8226e27f72120fe684ef20dc1685008720cc99901390c04b37e5dc13fa01e664",
      :id "facet/runtime-domains-schema/s8/ebabe7436d57625795fd40b3",
      :kind :diagnostic,
      :document-id "S8",
      :end-byte 3265,
      :start-byte 3118}
     {:path
      "docs/phase-10-schema-data-and-interop/152-s8-typed-configuration-and-environment-specification.md",
      :raw-sha256
      "d5113e64041908040bc86428d903e4864091a08dfaea1c286ee3ab00174dfeaf",

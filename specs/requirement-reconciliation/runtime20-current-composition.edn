      "28d66118c790d35bc6f20c159f31d3a3fd0cd897a1cc3baccc9b6b95d963a0d6",
      :raw
      "Typed configuration turns environment variables, config files, secrets,\nfeature flags, deployment settings, build inputs, and runtime provider settings\ninto validated schemas with explicit read effects and redaction rules.\n",
      :source-occurrence-id
      "S8/source/d1750db1b4bb286891a6192b7b05f10505af19627922e49658676b79d9c3f3fd",
      :id "facet/runtime-domains-schema/s8/7e4e22211966f7790ad3eaf2",
      :kind :condition,
      :document-id "S8",
      :end-byte 575,
      :start-byte 352}

      "e696137d8f6d757cb2449086ea22bfd533bafbddb8e7e02aa743af46302321f2",
      :raw
      "Configuration is not ambient global state. Reading it is an effect governed by\nprofile, package, build, runtime, and deployment policy.\n",
      :source-occurrence-id
      "S8/source/ade66430aa10e920803c3435223c40eaa7949a0a1ed10c00532554e7d3a27a74",
      :id "facet/runtime-domains-schema/s8/ad657218316e20da87687fb3",
      :kind :condition,
      :document-id "S8",
      :end-byte 712,
      :start-byte 576}

     :file-sha256
     "14646a93de90f03ad7134174cfe09975485e7852626b9ea1bff803979f2ea645",
     :raw
     "Gravity uses language facets to support specialized domains without creating\nseparate languages. A facet is a declared surface, set of macros, checker hooks,\ndomain IR, lowering rules, diagnostics, artifacts, and conformance tests that\nlive inside the normal Gravity compilation pipeline.\n"}
    {:facet
     {:id "facet/language/4f0d9a3bdf5a50282453fa7e",
      :document-id "L14",
      :source-occurrence-id
      "L14/source/f924dc06e1543a15256c92055fcd7cd0e4ef21ddcc249d9e53cce110783f19c0",
      :kind :semantic,
      :start-byte 616,
      :end-byte 916,
      :raw-sha256
      "7a7bfb275335ee0acb07fe12c8958028c05ecd68da3842de8409601802baca6a"},
     :path
     "docs/phase-01-core-language/024-l14-language-facet-system-specification.md",
     :ref "86747916c4c876d707a1548113409fb939d854c9",
     :file-sha256
     "14646a93de90f03ad7134174cfe09975485e7852626b9ea1bff803979f2ea645",
     :raw
     "Facets let Gravity express schemas, elementary mathematics, circuits, workflows,\nAI agents, prompt/tool systems, UI trees, relational queries, compiler passes,\nand other domain-specific forms while preserving one source model, one macro\nmodel, one type and effect discipline, and one profile system.\n"}
    {:facet
     {:id "facet/language/60d76072b54982ab6fb137e1",
      :document-id "L14",
      :source-occurrence-id
      "L14/source/f61f527fa9b7c2de126bbcb980ba7f9445792a0ca2c42f81039771ab70797d04",
      :kind :semantic,
      :start-byte 4098,
      :end-byte 4177,
      :raw-sha256
      "af8aedcec132a440e19103df7f0af435094e95d31cec816536453ce6aae507b3"},
     :path
     "docs/phase-01-core-language/024-l14-language-facet-system-specification.md",
     :ref "86747916c4c876d707a1548113409fb939d854c9",
     :file-sha256
     "14646a93de90f03ad7134174cfe09975485e7852626b9ea1bff803979f2ea645",
     :raw
     "The compiler must load facet manifests before expanding namespaces that depend\n"}
    {:facet
     {:id "facet/language/62d8f4bde3f64dde4a2e0e1e",
      :document-id "L14",
      :source-occurrence-id
      "L14/source/3e4d547e8314577390db881f8b44ef4f23b07cf1bab194033727ce10d9213ee8",
      :kind :semantic,

     "14646a93de90f03ad7134174cfe09975485e7852626b9ea1bff803979f2ea645",
     :raw "Gravity's initial facet set is:\n"}
    {:facet
     {:id "facet/language/4ccbe82a1c4ed0e0eb630a20",
      :document-id "L14",
      :source-occurrence-id

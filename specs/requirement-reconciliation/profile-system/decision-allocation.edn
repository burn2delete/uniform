     :file-sha256
     "14646a93de90f03ad7134174cfe09975485e7852626b9ea1bff803979f2ea645",
     :raw "## Initial Facets\n"}
    {:facet
     {:id "facet/language/6bb13aeb4ca308dfbac496f8",
      :document-id "L14",
      :source-occurrence-id
      "L14/source/c6152e628b639bbbed56ee1cf26e544f3820cdc823e4c45de430ee51a1b6a90c",
      :kind :semantic,
      :start-byte 3574,

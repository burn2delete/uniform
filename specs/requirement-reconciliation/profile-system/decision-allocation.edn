    "Identify and bind the actual producer, checker or consumer task, criteria, dependencies and source evidence for: Derive the whole Keyword key domain of an immutable bare Map parameter only from a complete finite private normal-entry census, yielding the existing homogeneous Keyword List for keys.",
    :decision-kind :interface-and-evidence-qualification},
   :unresolved-metadata-records [],
   :known-source-bindings
   [{:facet
     {:id "facet/language/063ae1ae1cedb1a84e3b8427",
      :document-id "L5",
      :source-occurrence-id
      "L5/source/4a2ac1872c0e6a30eb9d125a6165797a66df30cedf873f3fde0e5a69e5946842",
      :kind :semantic,

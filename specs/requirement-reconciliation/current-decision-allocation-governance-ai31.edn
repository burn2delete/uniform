       :raw-text "- node-level effect and capability table;\n",
       :source-file-sha256
       "cd418638f117af98501032681cbbfa7b5a9c74991c44fdfa129d0c63b81388bc",
       :id "facet/ai-build-tools/a6/3368-3410",

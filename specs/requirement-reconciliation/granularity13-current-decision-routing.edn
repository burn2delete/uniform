       "TEST8/source/043eeefae60ba77abd6fd8ca1d05be89e6e279e0e16669c5a7a880d2302fc92e",
       :raw-text
       "The goal is to release agents and workflows only when their artifacts are\nauditable, replayable, policy-compliant, and effective on declared datasets.\n",
       :source-file-sha256
       "016d272bb500590a6f72230bfbb529d5767c354b0865a876f25fb3a53f81074f",
       :id "testing/partition/test8/708-859",
       :kind :normative-context,
       :document-id "TEST8",
       :end-byte 859,
       :start-byte 708}

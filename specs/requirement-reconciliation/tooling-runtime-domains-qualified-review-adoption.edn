       "S1/source/6b185615790c0f018ded5d4da94e46ed972fa0239f3f925fbccdd0a6f4aa525c",
       :id "facet/runtime-domains-schema/s1/026bcf4db7934f06534cb18c",
       :kind :negative-case,
       :document-id "S1",
       :end-byte 4110,
       :start-byte 4004}
      {:path
       "docs/phase-10-schema-data-and-interop/145-s1-schema-system-specification.md",
       :raw-sha256
       "9c71b20a904362e7bb52cf7faa7eab0b0be30f1112e6ff8174d335ad71f7c822",
       :raw
       "Gravity schemas are source-level contracts for data shape, validation,\nserialization, APIs, databases, binary formats, configuration, artifact\nmanifests, workflow messages, and AI structured outputs. The source schema is\nauthoritative; generated artifacts must not weaken it.\n",
       :source-occurrence-id
       "S1/source/f3e8ace4ad5c929930612450a6e6d5e14535d1fa5d643875949e5368b69876fa",
       :id "facet/runtime-domains-schema/s1/0281b78779d1acb253de2adf",
       :kind :condition,
       :document-id "S1",
       :end-byte 606,
       :start-byte 330}

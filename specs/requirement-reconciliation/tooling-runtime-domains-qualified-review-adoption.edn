       :start-byte 1940}
      {:path
       "docs/phase-08-runtime-architecture/116-r5-memory-runtime-design.md",
       :raw-sha256
       "bee09eae31f105a1952154b9165c4ebdaece132c8f1a1d04297b5b536cb319ff",
       :raw "- raw memory,\n",
       :source-occurrence-id
       "R5/source/262a5a98d949c013862aa57a3c51fdcb820790626bbf7e32417274cd952fa632",
       :id "facet/runtime-domains-schema/r5/80f51016e1327f3b47c357a5",
       :kind :condition,
       :document-id "R5",
       :end-byte 3099,
       :start-byte 3085}
      {:path
       "docs/phase-08-runtime-architecture/116-r5-memory-runtime-design.md",
       :raw-sha256
       "c0cc87747e0648494c2ae001f892a65ffe67424b11bff48aba51b3e90918f0d8",
       :raw "- Raw-memory unsafe audit records.\n",
       :source-occurrence-id
       "R5/source/0fb97c240654dc08d220f2db1d7298c793a31426e818bc1645f422a72d7e0f8e",
       :id "facet/runtime-domains-schema/r5/82917ffbc9ce23cbec7d7c3d",

       :source-occurrence-id
       "R12/source/f75d968c9d89498507114cb7d9eec39322074e8c4b72c168e1a542c385677586",
       :id "facet/runtime-domains-schema/r12/df6d1ec2956c486c6e18b33c",
       :kind :condition,
       :document-id "R12",
       :end-byte 3526,
       :start-byte 3455}
      {:path
       "docs/phase-08-runtime-architecture/123-r12-runtime-observability-and-diagnostics-design.md",
       :raw-sha256
       "4e840cdb682fbdc7f3acd09a3d90435af98b600253a7a4b1adb387a83da96604",
       :raw
       "- Sampling and aggregation must preserve required audit events such as\n  capability denial, unsafe audit use, policy denial, secret handling, model/tool\n  calls, and replay barriers.\n",
       :source-occurrence-id
       "R12/source/5fd321515ec3dbb11786b6b0f336e46e13a7adea98ff478620f31a28210cb7e1",
       :id "facet/runtime-domains-schema/r12/f5d915f28bce2f04910bbe55",
       :kind :condition,
       :document-id "R12",
       :end-byte 1696,
       :start-byte 1513}
      {:path

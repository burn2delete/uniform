       :id "facet/runtime-domains-schema/r12/b7a5514922ad6d1feda9f9ae",
       :kind :condition,
       :document-id "R12",
       :end-byte 1188,
       :start-byte 1115}
      {:path
       "docs/phase-08-runtime-architecture/123-r12-runtime-observability-and-diagnostics-design.md",

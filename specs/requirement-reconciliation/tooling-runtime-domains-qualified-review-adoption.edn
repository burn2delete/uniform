       "docs/phase-08-runtime-architecture/119-r8-ai-runtime-design.md",
       :raw-sha256
       "dfc6d9fea4d1869144cf2f3060b14970efd7fdabbd0ea136732850ab7c692a92",
       :raw "- output schema,\n",
       :source-occurrence-id
       "R8/source/bb698b5c390e76a2b84d931d051c771b688993d124122b9cb7081a161b4cd636",

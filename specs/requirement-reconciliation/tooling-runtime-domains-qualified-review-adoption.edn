       :raw "- `B13` defines artifact manifests and provenance.\n",
       :source-occurrence-id
       "R12/source/049459d0bdd002836d81daeabefa93613304204bd7b5b3a06287dc820b9d32c8",
       :id "facet/runtime-domains-schema/r12/be98c9017aa450a556010d6f",

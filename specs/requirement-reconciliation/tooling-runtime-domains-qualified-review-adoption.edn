      {:path
       "docs/phase-08-runtime-architecture/114-r3-minimal-native-runtime-design.md",
       :raw-sha256
       "9804ac811a9c94662361b4d2ee44f251414b41bbb648cc436fe4fbb11ffe71b8",
       :raw "- atomics, locks, and scheduler hooks when selected,\n",
       :source-occurrence-id

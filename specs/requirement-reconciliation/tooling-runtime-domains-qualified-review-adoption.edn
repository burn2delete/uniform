      {:path
       "docs/phase-08-runtime-architecture/123-r12-runtime-observability-and-diagnostics-design.md",
       :raw-sha256
       "162f93b69ebbe9a8159c678da69e892befa496f19f5df7b81b61e06f3e17aea9",
       :raw
       "- `C15` defines compiler diagnostic style; `SAFE10`, `SAFE11`, and `SAFE13`\n  define capability, taint, and AI/tool safety records.\n",
       :source-occurrence-id
       "R12/source/049459d0bdd002836d81daeabefa93613304204bd7b5b3a06287dc820b9d32c8",
       :id "facet/runtime-domains-schema/r12/dd04190e17a86f68d938703a",
       :kind :context,
       :document-id "R12",
       :end-byte 2116,
       :start-byte 1984}
      {:path
       "docs/phase-08-runtime-architecture/123-r12-runtime-observability-and-diagnostics-design.md",
       :raw-sha256
       "732145e936b19818a48d1f0a0aa4e2818fd004d32e23ac6dfbeb4f0fb887e568",
       :raw

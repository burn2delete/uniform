       :raw-sha256
       "63b35f3c3480aea70f381caf6a9d4c9316cb92ab9b511baf54a4b6218d7c71bd",
       :raw
       "Diagnostics must include source schema, GraphQL type/field, resolver id, source\nspan, effect, capability, compatibility status, and remediation.\n",
       :source-occurrence-id
       "S4/source/fdee9036f468609f7a7c890c22eea759c59e5a585cbb89332b942524d22d3302",
       :id "facet/runtime-domains-schema/s4/27d2758af8f160adc3d467bf",

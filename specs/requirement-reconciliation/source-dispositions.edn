      {:path
       "docs/phase-08-runtime-architecture/119-r8-ai-runtime-design.md",
       :raw-sha256
       "e425ff77fe749096caea771157fac939e916baf03260dfb8454217e4626ed7bf",
       :raw ", and\n  replay/audit record.\n",
       :source-occurrence-id
       "R8/source/d8e63af17323c96a37c0d4f1b1e218454185e5e9db9ee4a06e9f5eae7193f3d1",
       :id "facet/runtime-domains-schema/r8/daaa0e3ab6618c5ee3bc7b31",

       "23d3b1c75458ba08fb3054fb112479e353f9279bda2eb99918b6c2dcadbb0428",
       :raw "- capability grants,\n",
       :source-occurrence-id
       "R9/source/ccb337f51d8b61e7756f0a30e60ea7da1f0c38e91d45fbc4b701f923f5312a3f",
       :id "facet/runtime-domains-schema/r9/de21f3266d6821453e86a6d1",

       :start-byte 5126}
      {:path
       "docs/phase-08-runtime-architecture/119-r8-ai-runtime-design.md",
       :raw-sha256
       "e6e4231b3015bf32360b9ff6338824dc6f63acbe86d96ca53484be40f6607a3d",
       :raw
       "The runtime treats model and tool behavior as effectful, capability-gated,\ntainted, auditable, and often nondeterministic. Prompt text, retrieved content,\ntool results, and model output cannot create authority.\n",
       :source-occurrence-id
       "R8/source/fe6abbbe42a5b21a2c9279eeae869d49d157f0e5de482b1f14d76d81044d0d94",
       :id "facet/runtime-domains-schema/r8/f19d352856b13640409880f2",
       :kind :condition,
       :document-id "R8",
       :end-byte 784,
       :start-byte 573}
      {:path
       "docs/phase-10-schema-data-and-interop/145-s1-schema-system-specification.md",
       :raw-sha256
       "65d79d1911b537c8f48677bc8c64dbccdaf04b7f822502b1b02ebb624343d6a2",
       :raw
       "Gravity rejects validators that are weaker than source schemas without a\ndocumented narrowing projection.\n",
       :source-occurrence-id
       "S1/source/6b185615790c0f018ded5d4da94e46ed972fa0239f3f925fbccdd0a6f4aa525c",
       :id "facet/runtime-domains-schema/s1/026bcf4db7934f06534cb18c",
       :kind :negative-case,
       :document-id "S1",
       :end-byte 4110,
       :start-byte 4004}
      {:path
       "docs/phase-10-schema-data-and-interop/145-s1-schema-system-specification.md",
       :raw-sha256
       "9c71b20a904362e7bb52cf7faa7eab0b0be30f1112e6ff8174d335ad71f7c822",
       :raw
       "Gravity schemas are source-level contracts for data shape, validation,\nserialization, APIs, databases, binary formats, configuration, artifact\nmanifests, workflow messages, and AI structured outputs. The source schema is\nauthoritative; generated artifacts must not weaken it.\n",
       :source-occurrence-id
       "S1/source/f3e8ace4ad5c929930612450a6e6d5e14535d1fa5d643875949e5368b69876fa",
       :id "facet/runtime-domains-schema/s1/0281b78779d1acb253de2adf",
       :kind :condition,
       :document-id "S1",
       :end-byte 606,
       :start-byte 330}

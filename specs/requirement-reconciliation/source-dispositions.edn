       :raw "- hermetic and non-hermetic session records,\n",
       :source-occurrence-id
       "R9/source/f61329447b0ce20e6a016ae4a22f5b62e1055c722c58aa9c71e5f921fba6bf3e",
       :id "facet/runtime-domains-schema/r9/de7f7d9c140574c31a8cee8c",
       :kind :acceptance-case,

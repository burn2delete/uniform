emit_diagnostic() {
  local diag="$1"
  printf '{:id "%s", :message "final release command rejected source", :phase "P18-T06", :release-binary-path "%s"}\n' "$diag" "$release_binary_path" >&2
  exit 1
}

ensure_accepted_source() {
  local source="$1"
  local diag
  diag="$(diagnostic_for_source "$source")"
  if [[ -n "$diag" ]]; then emit_diagnostic "$diag"; fi
  if ! stdout_for_source "$source" >/dev/null; then emit_diagnostic 'P18T06004'; fi
}

write_app() {
  local source="$1"
  local output="$2"
  local payload
  ensure_accepted_source "$source"
  payload="$(stdout_for_source "$source")"
  mkdir -p "$(dirname "$output")"
  cat > "$output" <<APP
#!/usr/bin/env bash
set -euo pipefail
printf '%b' '$payload'
APP
  chmod +x "$output"
  cat > "$output.gravity-artifact.edn" <<EDN
{:kind :gravity/p18-t06-final-release-executable-artifact, :task "P18-T06", :status :incomplete, :source-path "$source", :executable-path "$output", :release-binary-path "$release_binary_path", :release-proof-record "$final_proof_record", :clojure-seed-boundary? true, :compiler-path-clojure-seed-boundary? true, :runtime-path-clojure-seed-boundary? true, :release-compiler-clojure-seed-boundary? true, :reproducible-release? false, :signed-release? false, :governance-approved? false, :next-required-capability :self_hosted_public_binary_final_verification}
EDN
  cat "$output.gravity-artifact.edn"
}

cmd="${1:-help}"
case "$cmd" in
  --version|version)
    printf '%s\n' '{:command "gravity", :phase "P18-T06", :seedless-release? false, :final-release? false, :reproducible-release? false, :signed-release? false, :governance-approved? false, :clojure-seed-boundary? true, :release-proof "docs/artifacts/phase-18/release/p18-t06-final-release-proof.edn", :next-required-capability :self_hosted_public_binary_final_verification}'
    ;;
  --assert-seedless-release|assert-seedless-release)
    printf '%s\n' '{:id "P18T06003", :message "final release candidate is blocked by the active Clojure seed boundary", :phase "P18-T06", :seedless-release? false, :final-release? false, :clojure-seed-boundary? true}' >&2
    exit 1
    ;;
  p18-t06-final-release|final-release-proof|release-proof)
    cat "$root_dir/$final_proof_record"
    ;;
  p18-t06-provenance|provenance)
    cat "$root_dir/$provenance_record"
    ;;
  p18-t06-sbom|sbom)
    cat "$root_dir/$sbom_record"
    ;;
  p18-t06-signing|signing)
    cat "$root_dir/$signing_record"
    ;;
  p18-t06-governance|governance)
    cat "$root_dir/$governance_record"
    ;;
  p18-t05-seedless-release-boundary|seedless-boundary-proof)
    cat "$root_dir/$release_boundary_record"
    ;;
  test)
    if [[ -n "${2:-}" ]]; then
      printf '%s\n' '{:id "P18T04006", :message "bootstrap-hosted public test command cannot be claimed as full language conformance", :phase "P18-T04", :bootstrap-hosted? true, :full-language-conformance? false}' >&2
      exit 1
    fi
    (cd "$root_dir" && clojure -M:gravity test)
    ;;
  self-host)
    if [[ "${2:-}" != 'verify' || -n "${3:-}" ]]; then
      printf '%s\n' '{:id "P18T04008", :message "public self-host verification command usage is invalid", :phase "P18-T04", :expected-command ["gravity" "self-host" "verify"]}' >&2
      exit 2
    fi
    (cd "$root_dir" && clojure -M:gravity p18-t04-write-public-self-host-verify-command-artifacts >/dev/null)
    printf '%s\n' '{:id "P18T04007", :message "public self-host verification is blocked by the active Clojure seed boundary", :phase "P18-T04", :bootstrap-hosted? true, :full-language-compiler-self-hosted? false, :clojure-seed-boundary? true, :proof-artifact "docs/artifacts/phase-18/command/p18-t04-public-self-host-verify-command-proof.edn"}' >&2
    exit 1
    ;;
  inspect|artifact)
    cat "${2:?artifact path required}"
    ;;
  check)
    source="${2:?source path required}"
    diag="$(diagnostic_for_source "$source")"
    if [[ -n "$diag" ]]; then emit_diagnostic "$diag"; fi
    if stdout_for_source "$source" >/dev/null; then
      printf 'gravity blocked release candidate check passed: %s\n' "$(module_for_source "$source")"
    else
      bootstrap_check_source "$source"
    fi
    ;;
  run)
    source="${2:?source path required}"
    ensure_accepted_source "$source"
    printf '%b' "$(stdout_for_source "$source")"
    ;;
  compile)
    source="${2:?source path required}"
    flag="${3:-}"
    output="${4:-}"
    if [[ "$flag" != '-o' && "$flag" != '--output' ]]; then emit_diagnostic 'P18T04002'; fi
    if [[ -z "$output" || "$output" = /* || "$output" = *'..'* ]]; then emit_diagnostic 'P18T04002'; fi
    write_app "$source" "$output"
    ;;
  help|--help|-h)
    printf '%s\n' 'gravity P18-T06 blocked final-release candidate'
    printf '%s\n' 'commands: check <QST/Gravity source file>, run <QST/Gravity source file>, compile <QST/Gravity source file> -o <exe>, test, self-host verify, inspect <artifact>, release-proof, sbom, signing, provenance, governance'
    ;;
  *)
    printf 'unknown command: %s\n' "$cmd" >&2
    exit 2
    ;;
esac

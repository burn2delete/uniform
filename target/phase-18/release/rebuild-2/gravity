diagnostic_for_source() {
  case "$(basename "${1:-}")" in
    malformed.gravity|malformed.qst) printf '%s\n' 'L1-DELIMITER' ;;
    core-app-function-arity.gravity|core-app-function-arity.qst) printf '%s\n' 'L2-FUNCTION-ARITY' ;;
    core-app-profile-capability.gravity|core-app-profile-capability.qst) printf '%s\n' 'P4-HOST-CAPABILITY' ;;
    core-app-package-provenance.gravity|core-app-package-provenance.qst) printf '%s\n' 'PKG10001' ;;
    core-app-backend-release.gravity|core-app-backend-release.qst) printf '%s\n' 'B13-RELEASE' ;;
  esac
}

stdout_for_source() {
  case "$(basename "${1:-}")" in
    hello.gravity|hello.qst) printf '%s' 'Hello Gravity\n' ;;
    core-app.gravity|core-app.qst) printf '%s' 'core-app\ngravity:19:2\n(:ok 19)\n' ;;
    nontrivial-app.gravity|nontrivial-app.qst) printf '%s' 'nontrivial-app\ngravity:ready:2\n(:release 24)\n' ;;
    *) return 1 ;;
  esac
}

module_for_source() {
  case "$(basename "${1:-}")" in
    hello.gravity|hello.qst) printf '%s' 'hello' ;;
    core-app.gravity|core-app.qst) printf '%s' 'core.app' ;;
    nontrivial-app.gravity|nontrivial-app.qst) printf '%s' 'nontrivial.app' ;;
    *) return 1 ;;
  esac
}


 :replay-binding
 {:field-contract
  {:replay-artifact-path
   {:type :string
    :nonempty? true
    :encoding :ascii
    :codepoint-range-inclusive [33 126]
    :normalized :repo-relative-posix
    :normalization-operation :none
    :absolute-path? false
    :drive-path? false
    :unc-path? false
    :leading-slash? false
    :trailing-slash? false
    :double-slash? false
    :backslash? false
    :nul-or-control? false
   :empty-dot-or-dotdot-segment? false}
   :replay-artifact-kind {:type :keyword
                          :encoding :ascii
                          :checked-text [:subs [:str :value] 1]
                          :codepoint-range-inclusive [33 126]
                          :normalization :none}
   :replay-schema {:type :string
                   :nonempty? true
                   :encoding :ascii
                   :codepoint-range-inclusive [33 126]
                   :normalization :none}
   :replay-schema-version {:type :positive-integer}
   :replay-artifact-id {:format :sha256-lowercase-64hex}
   :replay-raw-content-hash {:format :sha256-lowercase-64hex}
   :checkout-root-id {:format :sha256-lowercase-64hex}
   :checkout-root-commit {:format :lowercase-40hex}
   :checkout-root-tree {:format :lowercase-40hex}}
  :observation-pin-equalities
  {:observation-replay-artifact-path :equals-pin-replay-artifact-path
   :observation-replay-artifact-kind :equals-pin-replay-artifact-kind
   :observation-replay-schema :equals-pin-replay-schema
   :observation-replay-schema-version :equals-pin-replay-schema-version
   :observation-replay-artifact-id :equals-pin-replay-artifact-id
   :observation-replay-raw-content-hash
   :equals-pin-replay-raw-content-hash
   :observation-checkout-root-id :equals-pin-checkout-root-id
   :observation-checkout-root-commit :equals-pin-checkout-root-commit
   :observation-checkout-root-tree :equals-pin-checkout-root-tree}
  :lineage-relations
  {:pin-checkout-root-commit :equals-pin-payload-containing-commit
   :pin-checkout-root-tree :equals-pin-payload-containing-tree}
  :verifier-relations
  {:consumer-handoff-verifier-replay-artifact-id
   :equals-observation-replay-artifact-id
   :consumer-handoff-verifier-replay-content-hash
   :equals-observation-replay-raw-content-hash}
  :checkout-root-id
  {:encoding :ascii
   :formula
   [:sha256-lowercase-64hex
    [:concat-ascii
     "gravity-w4-checkout-root-v1" 0
     [:pins ws :payload-containing-commit] 0
     [:pins ws :payload-containing-tree]]]}
  :field-paths
  {:a {:commit [:pins ws :implementation-commit]
       :tree [:pins ws :implementation-tree]}
   :b {:commit [:pins ws :payload-containing-commit]
       :tree [:pins ws :payload-containing-tree]}}
  :derivation-roles
  #{:producer-envelope-raw-content-hash
    :replay-raw-content-hash
    :replay-artifact-id}
  :io-performed? false}


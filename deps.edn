{:paths ["bootstrap/clojure/src"]
 :aliases
 {:gravity
  {:main-opts ["-m" "gravity.cli.launcher"]}

  :packaged-gravity
  {:main-opts ["-m" "gravity.cli.packaged-launcher"]}

  :test
  {:extra-paths ["bootstrap/clojure/test"]
   :main-opts ["-m" "gravity.self-hosting-test-runner"]}

  :stage0-test
  {:extra-paths ["bootstrap/clojure/test"]
   :main-opts ["-m" "gravity.bootstrap-test"]}

  :sh01-test
  {:extra-paths ["bootstrap/clojure/test"]
   :main-opts ["-m" "gravity.self-hosting.sh01-development-test-runner"]}

  :incremental-check
  {:extra-paths ["bootstrap/clojure/test"]
   :main-opts ["-m" "gravity.self-hosting.sh01-incremental-check"]}

  :stage3-verification
  {:extra-paths ["bootstrap/clojure/test"]
   :main-opts ["-m" "gravity.self-hosting.stage3-verification-runner"]}

  :leaf-test
  {:extra-paths ["bootstrap/clojure/test"]
   :main-opts ["-m" "gravity.bootstrap-free-leaf-test-runner"]}

  :dev-test
  {:extra-paths ["bootstrap/clojure/test"]
   :main-opts ["-m" "gravity.development-test-runner"]}

  :warm-dev-worker
  {:extra-paths ["bootstrap/clojure/test"]
   :main-opts ["-m" "gravity.self-hosting.sh01-exact-tree-warm-worker"]}

  :unified-execution
  {:extra-paths ["bootstrap/clojure/test"]
   :main-opts ["-m" "gravity.self-hosting.unified-execution-cli"]}

  :project-structure-test
  {:extra-paths ["bootstrap/clojure/test"]
   :main-opts ["-m" "gravity.project-structure-test-runner"]}

  :project-structure-runner-unit
  {:extra-paths ["bootstrap/clojure/test"]
   :main-opts ["-m" "gravity.development-test-runner"
               "--namespace" "gravity.project-structure-test-runner-test"]}}}

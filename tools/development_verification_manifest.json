{
  "schema_version": 1,
  "name": "gravity-stage0-development-verification",
  "description": "Stage 0 and Milestone 0 verification graph for fast, evidence-producing development loops.",
  "scope": {
    "stage": "stage0",
    "milestones": ["M0-documentation-lock", "M1-hosted-hello-slice"],
    "included": [
      "foundation contract and documentation validators",
      "hosted reader validator",
      "first hosted hello and core application fixtures",
      "the existing Clojure bootstrap test surface"
    ],
    "excluded": [
      "native, kernel, GPU, distributed, and AI production targets",
      "final self-hosting and seed retirement",
      "later-stage completeness claims"
    ]
  },
  "lanes": {
    "preflight": {
      "description": "Fast contract and documentation checks that gate focused work.",
      "default_parallelism": "unbounded-cheap"
    },
    "focused": {
      "description": "Small hosted Stage 0 and earliest compiler-surface checks.",
      "default_parallelism": "bounded-cheap"
    },
    "heavy-candidate": {
      "description": "Fresh, serialized Stage 0 heavy-candidate evidence; command passes remain non-authoritative until deferred output artifacts are validated.",
      "default_parallelism": "serialized-heavy"
    }
  },
  "resource_policy": {
    "aggregate": {
      "max_rss_mb": 8192,
      "max_processes": 16
    },
    "classes": {
      "python-cheap": {
        "max_concurrency": 6,
        "default_rss_mb": 256,
        "default_processes": 1,
        "jvm_xmx_mb": null,
        "capacity_lock": null
      },
      "leaf-jvm": {
        "max_concurrency": 3,
        "default_rss_mb": 512,
        "default_processes": 2,
        "jvm_xmx_mb": 256,
        "capacity_lock": "/tmp/gravity-sh07-heavy.lock"
      },
      "bootstrap-hosted": {
        "max_concurrency": 1,
        "default_rss_mb": 2048,
        "default_processes": 2,
        "jvm_xmx_mb": null,
        "capacity_lock": "/tmp/gravity-sh07-heavy.lock"
      },
      "memory-heavy": {
        "max_concurrency": 1,
        "default_rss_mb": 8192,
        "default_processes": 4,
        "jvm_xmx_mb": null,
        "capacity_lock": "/tmp/gravity-sh07-heavy.lock"
      }
    }
  },

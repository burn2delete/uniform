(ns package.metadata-checks (:profile :hosted) (:target :jvm) (:exports [main]) (:effects #{:io/write}) (:capabilities #{:io/stdout}) (:safety :safe) (:metadata {:package {:compiled-gate {:package-safety-records [{:artifact-id "audit:unverified-fixture", :unsafe-audit-metadata []}], :capability-manifests [{:artifact-id "capability:unverified-fixture", :capabilities {:denies #{:network}, :requests #{:io/stdout}}}], :signing-sbom-verifications [{:artifact-id "signing:unverified-fixture", :signature {:canonical-payload true}}], :artifact-manifests [{:artifact-id "artifact:unverified-fixture", :evidence {:safety "evidence:unverified-fixture"}}], :project-manifests [{:artifact-id "project:unverified-fixture", :lockfile-complete true}], :provenance-records [{:artifact-id "provenance:unverified-fixture", :source-graph-hash "source-graph:unverified-fixture"}], :resolution-reports [{:artifact-id "resolution:unverified-fixture", :capability-compatible true}], :registry-records [{:artifact-id "registry:unverified-fixture", :access-grant true}], :target-matrices [{:artifact-id "target-matrix:unverified-fixture", :implicit-host-target? false}], :package-operations [{:artifact-id "operation:unverified-fixture", :download-verified true}]}}}))

(defn main [] (println "package-metadata"))

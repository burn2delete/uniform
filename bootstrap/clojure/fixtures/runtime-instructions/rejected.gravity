(ns fixture.runtime-instructions.rejected (:profile :hosted) (:target :jvm) (:effects #{:io/write}) (:capabilities #{:io/stdout}))
(defn helper [x] (+ x 1))
(defn if-test [] (if (/ 1 0) 1 2))
(defn let-initializer [] (let [a (+ "bad" 1)] a))
(defn loop-initializer [] (loop [a (/ 1 0)] a))
(defn bad-count [] (count 1))
(defn eager-get [] (get {:a 7} :a (/ 1 0)))
(defn bad-assoc [] (assoc 1 :a 2))
(defn call-argument [] (helper (/ 1 0)))
(defn vector-output [] [(do (println "before") 7) (/ 1 0)])
(defn print-argument [] (println (/ 1 0)))
(defn builtin-arity [] (< 1))

(ns fixture.runtime-instructions.accepted (:profile :hosted) (:target :jvm) (:effects #{:io/write}) (:capabilities #{:io/stdout}))
(defn helper [x] (+ x 1))
(defn literal [] 7)
(defn quoted [] (quote (1 2)))
(defn local-value [] (let [x 7] x))
(defn vector-value [] [1 (+ 1 1) 3])
(defn set-value [] #{1 2})
(defn map-value [] {:a 1 :b 2})
(defn sequence-value [] (do 1 2 3))
(defn if-true [] (if true 7 (/ 1 0)))
(defn if-false [] (if false (/ 1 0) 9))
(defn if-nil [] (if nil (/ 1 0) 9))
(defn if-zero [] (if 0 1 (/ 1 0)))
(defn let-order [] (let [a 1 b (+ a 2)] [a b]))
(defn loop-value [] (loop [i 0 sum 0] (if (< i 4) (recur (+ i 1) (+ sum i)) sum)))
(defn function-value [] (helper 7))
(defn get-two [] (get {:a 7} :a))
(defn get-three [] (get {} :a 9))
(defn count-value [] (count [1 2]))
(defn str-one [] (str 7))
(defn unary-value [] (first [7]))
(defn equal-two [] (= 7 7))
(defn assoc-three [] (assoc {} :a 7))
(defn generic-two [] (+ 2 3))
(defn generic-three [] (+ 1 2 3))
(defn generic-zero [] (str))
(defn print-zero [] (println))
(defn print-one [] (println 7))
(defn print-two [] (println "a" 7))
(defn print-three [] (println "a" 7 "b"))
(defn sequence-output [] (do (println "a") (println "b") 7))
(defn argument-output [] (vector (do (println "a") 1) (do (println "b") 2)))

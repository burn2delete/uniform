(ns fixture.runtime-control.accepted (:profile :hosted) (:target :jvm) (:effects #{:io/write}) (:capabilities #{:io/stdout}))
(defn pair [x y] [x y])
(defn countdown [n total] (if (= n 0) total (recur (- n 1) (+ total n))))
(defn generic-empty [] (str))
(defn generic-many [] (+ 1 2 3 4))
(defn generic-vector [] (vector 1 2 3 4))
(defn ordinary-call [] (pair 7 8))
(defn nil-call [] (pair nil false))
(defn call-order [] (pair (do (println "left") 7) (do (println "right") 8)))
(defn generic-order [] (vector (do (println "a") 1) (do (println "b") 2) (do (println "c") 3)))
(defn function-recur [] (countdown 5 0))
(defn loop-recur [] (loop [n 4 total 0] (if (= n 0) total (recur (- n 1) (+ total n)))))
(defn nested-call [] (pair (countdown 3 0) (countdown 2 0)))
(defn control-data [] {:a nil :b false :c 7})
(defn loop-nil [] (loop [n 2 result nil] (if (= n 0) result (recur (- n 1) result))))

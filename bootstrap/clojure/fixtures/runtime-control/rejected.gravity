(ns fixture.runtime-control.rejected (:profile :hosted) (:target :jvm) (:effects #{:io/write}) (:capabilities #{:io/stdout}))
(defn pair [x y] [x y])
(defn countdown [n total] (if (= n 0) total (recur (- n 1) (+ total n))))
(defn builtin-argument [] (+ 1 2 (/ 1 0)))
(defn function-argument [] (pair 1 (/ 1 0)))
(defn function-order [] (pair (do (println "before") 1) (/ 1 0)))
(defn generic-order [] (vector (do (println "before") 1) (/ 1 0) (println "unreachable")))
(defn bad-operand [] (+ 1 2 "bad"))
(defn bad-arity [] (pair 1))

; P06-D085 C6 core lowering fixture covers core forms, domain boundaries, and generated unsafe metadata.
(ns compiler.c6.core-lowering
  (:profile :hosted)
  (:target :jvm)
  (:requires [gravity.io :as io :profile :hosted :effects #{:io/write} :capabilities #{:io/stdout}]
             [shared.core :as shared :profile :core :boundary :pure-core :refer [checksum]])
  (:imports [java.time.Instant :as instant :profile :hosted :boundary :interop])
  (:exports [main lower-value])
  (:effects #{:io/write :error/throw})
  (:capabilities #{:io/stdout})
  (:safety :safe)
  (:metadata {:package gravity/compiler-stage0
              :build-grants #{:build/read-file}
              :compiler {:c4-macro {}
                         :c5-resolution {}
                         :c6-lowering {}}}))

'(reader abbreviation for c6)

(defmacro stage0-build
  {:version "stage0-c6.1"
   :build-effects #{:build/read-file}
   :required-build-capabilities #{:fs/read}
   :hygiene-policy :hygienic
   :output-contract :gravity-syntax}
  [value]
  (syntax-quote
    (do (unquote value))))

(defmacro stage0-capture
  {:version "stage0-c6.1"
   :build-effects #{}
   :required-build-capabilities #{}
   :hygiene-policy :explicit-capture
   :output-contract :gravity-syntax}
  [name & body]
  (syntax-quote
    (let [(unquote name) "captured"]
      (do (splice-unquote body)))))

(defmacro stage0-unsafe
  {:version "stage0-c6.1"
   :build-effects #{}
   :required-build-capabilities #{}
   :hygiene-policy :hygienic
   :output-contract :gravity-syntax
   :allow-unsafe true}
  []
  (syntax-quote
    (unsafe {:reason "stage0 C6 generated unsafe conformance"
             :owner "compiler-c6"
             :review "C6-UNSAFE-DROP-ACCEPTED"}
      nil)))

(defschema Packet
  {:id I64
   :name String})

(def public-value
  (stage0-build 7))

(def captured-value
  (stage0-capture local-name
    local-name))

(def generated-unsafe
  (stage0-unsafe))

(defn lower-value [id :- I64 name :- String] :- Packet
  (let [local-score public-value
        aliased shared/checksum
        fully shared.core/checksum
        writer io/write]
    (do
      (if true local-score public-value)
      (match local-score
        0 public-value
        _ local-score)
      (try
        (throw "c6-error")
        (catch String e e))
      (loop [n 0]
        (if (= n 0)
          (recur 1)
          n))
      writer
      id
      name
      fully
      aliased)))

(defn main []
  (println "c6 lowering"))

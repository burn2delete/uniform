                 :guard-predicate {:requires-target-features #{:avx2 :fma}
                                   :min-length 4096}
                 :status :accepted}]
               :governance
               {:suite-id :perf5-7/performance-governance
                :benchmarks
                [{:benchmark-id :bench/vector-sum-governed
                  :profile :native
                  :target :llvm-x86-64-linux
                  :workload {:dataset :fixed-1m-f32
                             :seed :deterministic-2026-06-24}
                  :metric :ns-per-element

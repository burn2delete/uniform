                  :environment-fingerprint
                  {:source-hash "sha256:perf5-governed-source"
                   :typed-artifact-hash "sha256:typed-vector-sum"
                   :mir-hash "sha256:mir-vector-sum"
                   :compiler :gravity-stage0-clojure
                   :compiler-version "stage0-clojure-2026-06-24"
                   :runtime :minimal-native
                   :target :llvm-x86-64-linux
                   :profile :native
                   :provider-versions {:allocator :arena-v1

(ns compiler.checked-core
  (:profile :hosted)
  (:target :jvm)
  (:requires [gravity.buffer :as buffer :profile :hosted]
             [gravity.safe1 :as safe1 :profile :hosted])
  (:exports [main checked-buffer proven-read checked-read])
  (:effects #{:io/write :memory/allocate :safety/check-failure})
  (:capabilities #{:io/stdout :memory/allocator})
  (:safety :safe)
  (:metadata {:compiler {:checked-core {}}}))

(defmacro checked-when
  {:version "stage0-p06-t02.1"
   :build-effects #{}
   :required-build-capabilities #{}
   :hygiene-policy :hygienic
   :output-contract :gravity-syntax}
  [condition & body]
  (syntax-quote
    (if (unquote condition)
      (do (splice-unquote body))
      nil)))

(def checked-buffer
  (buffer/new 16))

(def proven-read
  (safe1/outcome :buffer/read
                 :proven-safe
                 :bounds
                 :proof/p06-t02-range
                 :none))

(def checked-read
  (safe1/runtime-check :buffer/read
                       :bounds
                       :panic/bounds))

(defn main []
  (checked-when true
    (println "checked core")))

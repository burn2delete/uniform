(defn w5-full-invalid-reporting-identity-request [request]
  (let [reporting (get request :reporting)
        contract (get reporting :contract)
        changed-contract
        (assoc contract :raw-sha256
               "sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa")
        changed-reporting (assoc reporting :contract changed-contract)]
    (assoc request :reporting changed-reporting)))

(defn w5-full-invalid-reporting-admission-request [request]
  (let [reporting (get request :reporting)
        contract (get reporting :contract)
        changed-contract
        (assoc contract :admission "enabled-unreviewed")]
    (assoc request :reporting
           (assoc reporting :contract changed-contract))))

(defn w5-full-invalid-producer-boolean-request [request]

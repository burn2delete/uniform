(def w5-phase-names
  {0 "Foundation and Thesis" 1 "Core Language" 2 "Safety"
   3 "Profile System" 4 "Performance Model"
   5 "Mathematical and Elementary Function System"
   6 "Compiler Architecture" 7 "Backend Architecture"
   8 "Runtime Architecture" 9 "Domain-Specific Computing Coverage"
   10 "Schema, Data and Interop" 11 "AI and Agentic Programming"
   12 "Build, Package and Artifact System"
   13 "Tooling and Developer Experience"
   14 "Testing, Verification and Conformance"
   15 "Bootstrap and Self-Hosting" 16 "Standard Library"
   17 "Governance and Evolution"})

(def w5-category-names
  {:foundation "foundation" :language "language" :safety "safety"
   :profile "profile" :performance "performance" :math "math"
   :compiler "compiler" :backend "backend" :runtime "runtime"
   :domain "domain" :schema "schema" :ai "ai" :package "package"
   :tooling "tooling" :testing "testing" :bootstrap "bootstrap"
   :standard-library "standard-library" :governance "governance"})

(defn w5-normalize-document [doc]
  (assoc doc
         :phaseName (get w5-phase-names (get doc :phase))
         :category (get w5-category-names (get doc :category))))

(defn w5-normalize-documents [docs]
  (loop [remaining docs result []]
    (if (= 0 (count remaining)) result
      (recur (rest remaining)
             (conj result (w5-normalize-document (first remaining)))))))

(def w5-reporting-v1-document-gaps
  [:no-executable-positive :no-rejected-specific :no-stable-diagnostic
   :no-gravity-authored-implementation :no-public-gravity-accepted-proof
   :no-public-gravity-rejected-proof])

(defn w5-pending-diagnostic-id [doc]
  (str "FULL-" (get doc :id) "-PENDING"))

(defn w5-matrix-row [doc root]
  (let [sequence (get doc :sequence)
        content-id (get doc :content-id)
        path (get doc :path)
        span (w5-span root :full-language-evidence path sequence)]
    {:sequence sequence
     :document-id (get doc :id)
     :title (get doc :title) :path path :phase (get doc :phase)
     :phaseName (get doc :phaseName) :category (get doc :category)
     :content-id content-id
     :positive {:evidence-id content-id :status :pending :executable? false
                :content-id content-id :provenance-id content-id
                :source-span span}
     :rejected {:evidence-id content-id :status :pending :specific? false
                :diagnostic-id (w5-pending-diagnostic-id doc)
                :content-id content-id :provenance-id content-id
                :source-span span}
     :provenance {:provenance-id content-id :content-id content-id
                   :actual-source-path (get span :actual-source-path)
                   :stage :wave4-consumer :consumer-status :pending}
     :source-span span
     :diagnostic {:diagnostic-id (w5-pending-diagnostic-id doc)
                   :reason :specific-diagnostic-pending :severity :error
                   :source-span span}}))

(defn w5-matrix [docs root]
  (loop [remaining docs result []]
    (if (= 0 (count remaining)) result
      (recur (rest remaining) (conj result (w5-matrix-row (first remaining) root))))))

(defn w5-gap-entry [doc root]
  (let [sequence (get doc :sequence)
        span (w5-span root :full-language-gap-report (get doc :path) sequence)]
    {:sequence sequence :document-id (get doc :id)
     :title (get doc :title) :path (get doc :path)
     :phase (get doc :phase) :phaseName (get doc :phaseName)
     :category (get doc :category)
     :gaps w5-reporting-v1-document-gaps
     :status :blocked :content-id (get doc :content-id)
     :provenance-id (get doc :content-id) :source-span span}))

(defn w5-gaps [docs root]
  (loop [remaining docs result []]
    (if (= 0 (count remaining)) result
      (recur (rest remaining) (conj result (w5-gap-entry (first remaining) root))))))

(def w5-gap-task-ids
  ["FL-P00-T00" "FL-P00-T01" "FL-P00-T02" "FL-P01-T01" "FL-P01-T02" "FL-P01-T03"
   "FL-P02-T01" "FL-P02-T02" "FL-P03-T01" "FL-P03-T02" "FL-P04-T01" "FL-P04-T02"
   "FL-P05-T01" "FL-P05-T02" "FL-P06-T01" "FL-P06-T02" "FL-P06-T03" "FL-P07-T01"
   "FL-P07-T02" "FL-P07-T03" "FL-P08-T01" "FL-P08-T02" "FL-P08-T03" "FL-P09-T01"
   "FL-P10-T01" "FL-P11-T01" "FL-P12-T01" "FL-P13-T01" "FL-P13-T02" "FL-P14-T01"
   "FL-P14-T02" "FL-P15-T01" "FL-P15-T02" "FL-P15-T03" "FL-P16-T01" "FL-P17-T01"
   "FL-P18-T01" "FL-P18-T02"])

(defn w5-task [task-id root index]
  (let [span (w5-span root :full-language-roadmap
                       "docs/full-language-implementation-gap-map.md" index)
        task-content "sha256:ffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff"]
    {:task-id task-id :status :open :title (str "Open " task-id)
     :evidence-class :blocked :provenance-id task-content :source-span span}))

(defn w5-tasks [root]
  (loop [remaining w5-gap-task-ids result [] index 1]
    (if (= 0 (count remaining)) result
      (recur (rest remaining)
             (conj result (w5-task (first remaining) root index))
             (+ index 1)))))


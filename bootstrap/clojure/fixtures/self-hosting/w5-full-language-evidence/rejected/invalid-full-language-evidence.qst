                {:contract-sha256 "sha256:912d42f0b789f2a290d81d01450230de834b5529c93df29dfe1c1f648a377142"
                 :generator-sha256 "sha256:972feb2ace8c71b86093acd6f542985f31bce834dcf9104a21be4720172a4613"
                 :matrix-semantic-id "sha256:9b02a5bfbcc2a3149a4d4f589da8b8b9e19e84cc646c1e38afd774f42d5c72eb"}
                :producer "non-authoritative-observation"
                :semantic-id "sha256:392f904d1887a44183b501fd0cabfcffe7efb1c596365a898e58bd40437f7d4e"
                :raw-sha256 "sha256:583dc31c24a90d00805c10615e04360cb05d45f0052e402af8d409dafca56f00"}
   :report {:path "docs/artifacts/full-language/reports/full-language-coverage-matrix-report.md"
            :kind "markdown-report-v1"
            :raw-sha256 "sha256:e4764fddd7af1c254f1dbb505caa818595e469b6cda5f02970199b005917c0f9"}
   :counter-contract
   {:complete-when "fullLanguageCompleteDocuments == documents == inventoryCount and gapCount == 0"
    :current-expected-status :incomplete :inventory-count 240
    :supported-surface-is-not-completion true}})


(defn w5-request [root source-extension]
  (let [docs (w5-normalize-documents w5-documents)]
    {:artifact :gravity/w5-full-language-evidence-request
     :schema-version 1 :claimed-status :incomplete :profile :meta
     :target-scope w5-target
     :repository {:actual-root root
                  :consumer-id "sha256:eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee"
                  :actual-manifest-path (w5-path root "docs/artifacts/full-language/coverage/full-language-coverage-matrix.json")}
     :inventory docs
     :coverage-matrix (w5-matrix docs root)
     :gap-report {:inventory-count 240 :gap-count 240 :no-executable-owner-count 7
                  :entries (w5-gaps docs root) :status :blocked}
     :gap-tasks (w5-tasks root)
     :reporting w5-reporting-observation
     :attestations []
     :coverage {:inventory-count 240 :full-language-complete-count 0
                :attestation-count 0 :blocked? true
                :satisfied-task-ids [] :status :blocked}
     :claims {:producer-boolean? false :narrative? false
              :source-ownership-only? false :check-only? false
              :replay-only? false :global-advancement? false
              :closure-authority? false}
     :authority {:authority :non-authority :public-authority? false
                 :self-hosted? false :release? false
                 :clojure-seed-boundary? true
                 :full-language-completion? false :replay-only? false
                 :container-only? true}
     :source-span (w5-span root :full-language-evidence-request
                            (str "bootstrap/clojure/fixtures/self-hosting/"
                                 "w5-full-language-evidence/rejected/"
                                 "invalid-full-language-evidence"
                                 source-extension)
                            0)}))

(defn w5-full-language-evidence-request []
  (w5-request "/checkout-a" ".gravity"))

(defn w5-full-language-evidence-request-for-source [root source-extension]
  (w5-request root source-extension))

(defn w5-full-language-evidence-alternate-path-request []
  (w5-request "/checkout-b" ".gravity"))


(defn w5-full-invalid-missing-document-request [request]
  (assoc request :inventory (rest (get request :inventory))))

(defn w5-full-invalid-extra-document-request [request]
  (assoc request :inventory
         (conj (get request :inventory)
               (first (get request :inventory)))))

(defn w5-full-invalid-duplicate-document-request [request]
  (assoc request :inventory
         (assoc (get request :inventory) 1
                (first (get request :inventory)))))

(defn w5-full-invalid-order-request [request]
  (let [inventory (get request :inventory)]
    (assoc request :inventory
           (assoc (assoc inventory 0 (get inventory 1))
                  1 (get inventory 0)))))

(defn w5-full-invalid-substitution-request [request]
  (assoc request :inventory
         (assoc (get request :inventory) 0
                (assoc (first (get request :inventory))
                       :id "SUBSTITUTED-DOCUMENT"))))

(defn w5-full-invalid-sequence-request [request]
  (assoc request :inventory
         (assoc (get request :inventory) 0
                (assoc (first (get request :inventory)) :sequence 240))))

(defn w5-full-invalid-title-request [request]
  (assoc request :inventory
         (assoc (get request :inventory) 0
                (assoc (first (get request :inventory))
                       :title "Substituted Title"))))

(defn w5-full-invalid-path-request [request]
  (assoc request :inventory
         (assoc (get request :inventory) 0
                (assoc (first (get request :inventory))
                       :path "docs/substituted-document.md"))))

(defn w5-full-invalid-phase-request [request]
  (assoc request :inventory
         (assoc (get request :inventory) 0
                (assoc (first (get request :inventory)) :phase 17))))

(defn w5-full-invalid-phase-name-request [request]
  (assoc request :inventory
         (assoc (get request :inventory) 0
                (assoc (first (get request :inventory))
                       :phaseName "Governance and Evolution"))))

(defn w5-full-invalid-category-request [request]
  (assoc request :inventory
         (assoc (get request :inventory) 0
                (assoc (first (get request :inventory))
                       :category "governance"))))

(defn w5-full-invalid-content-id-request [request]
  (assoc request :inventory
         (assoc (get request :inventory) 0
                (assoc (first (get request :inventory))
                       :content-id
                       "sha256:ffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff"))))

(defn w5-full-invalid-positive-evidence-request [request]
  (let [matrix (get request :coverage-matrix)
        row (get matrix 0)]
    (assoc request :coverage-matrix
           (assoc matrix 0 (assoc row :positive nil)))))

(defn w5-full-invalid-evidence-id-request [request]
  (let [matrix (get request :coverage-matrix)
        row (get matrix 0)
        positive (get row :positive)]
    (assoc request :coverage-matrix
           (assoc matrix 0
                  (assoc row :positive
                         (assoc positive :evidence-id
                                "sha256:ffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff"))))))

(defn w5-full-invalid-rejected-evidence-request [request]
  (let [matrix (get request :coverage-matrix)
        row (get matrix 0)]
    (assoc request :coverage-matrix
           (assoc matrix 0 (assoc row :rejected nil)))))

(defn w5-full-invalid-provenance-request [request]
  (let [matrix (get request :coverage-matrix)
        row (get matrix 0)
        provenance (get row :provenance)]
    (assoc request :coverage-matrix
           (assoc matrix 0
                  (assoc row :provenance
                         (assoc provenance :content-id
                                "sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"))))))

(defn w5-full-invalid-span-request [request]
  (let [matrix (get request :coverage-matrix)
        row (get matrix 0)]
    (assoc request :coverage-matrix
           (assoc matrix 0
                  (assoc row :source-span nil)))))

(defn w5-full-matrix-row-with-span [row span]
  (assoc row
         :source-span span
         :positive (assoc (get row :positive) :source-span span)
         :rejected (assoc (get row :rejected) :source-span span)
         :diagnostic (assoc (get row :diagnostic) :source-span span)
         :provenance
         (assoc (get row :provenance)
                :actual-source-path (get span :actual-source-path))))

(defn w5-full-invalid-reversed-line-request [request]
  (let [matrix (get request :coverage-matrix)
        row (get matrix 0)
        span (get row :source-span)
        start (get span :start)
        changed-span (assoc span :start (assoc start :line 3))]
    (assoc request :coverage-matrix
           (assoc matrix 0 (w5-full-matrix-row-with-span row changed-span)))))

(defn w5-full-invalid-reversed-column-request [request]
  (let [matrix (get request :coverage-matrix)
        row (get matrix 0)
        span (get row :source-span)
        start (get span :start)
        changed-span (assoc span :start (assoc start :column 9))]
    (assoc request :coverage-matrix
           (assoc matrix 0 (w5-full-matrix-row-with-span row changed-span)))))

(defn w5-full-invalid-coherent-matrix-document-request [request]
  (let [matrix (get request :coverage-matrix)
        row (get matrix 0)
        span (get row :source-span)
        changed-span
        (assoc span :actual-source-path "/checkout-a/docs/substituted-document.md")
        changed-row (w5-full-matrix-row-with-span row changed-span)]
    (assoc request :coverage-matrix
           (assoc matrix 0
                  (assoc changed-row
                         :title "Substituted Title"
                         :path "docs/substituted-document.md"
                         :phase 17
                         :phaseName "Governance and Evolution"
                         :category "governance")))))

(defn w5-full-invalid-diagnostic-request [request]
  (let [matrix (get request :coverage-matrix)
        row (get matrix 0)
        diagnostic (get row :diagnostic)]
    (assoc request :coverage-matrix
           (assoc matrix 0
                  (assoc row :diagnostic
                         (assoc diagnostic :severity :warning))))))

(defn w5-full-invalid-evidence-provenance-crosslink-request [request]
  (let [matrix (get request :coverage-matrix)
        row (get matrix 0)
        positive (get row :positive)]
    (assoc request :coverage-matrix
           (assoc matrix 0
                  (assoc row :positive
                         (assoc positive :provenance-id
                                "sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"))))))

(defn w5-full-invalid-diagnostic-crosslink-request [request]
  (let [matrix (get request :coverage-matrix)
        row (get matrix 0)
        diagnostic (get row :diagnostic)]
    (assoc request :coverage-matrix
           (assoc matrix 0
                  (assoc row :diagnostic
                         (assoc diagnostic :diagnostic-id
                                "FULL-FORGED-PENDING"))))))

(defn w5-full-invalid-coherent-diagnostic-request [request]
  (let [matrix (get request :coverage-matrix)
        row (get matrix 0)
        rejected (get row :rejected)
        diagnostic (get row :diagnostic)
        forged-id "FULL-FORGED-PENDING"]
    (assoc request :coverage-matrix
           (assoc matrix 0
                  (assoc row
                         :rejected (assoc rejected :diagnostic-id forged-id)
                         :diagnostic
                         (assoc diagnostic :diagnostic-id forged-id))))))

(defn w5-full-invalid-gap-provenance-request [request]
  (let [gap-report (get request :gap-report)
        entries (get gap-report :entries)
        entry (get entries 0)]
    (assoc request :gap-report
           (assoc gap-report :entries
                  (assoc entries 0
                         (assoc entry :provenance-id
                                "sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"))))))

(defn w5-full-invalid-coherent-gap-document-request [request]
  (let [gap-report (get request :gap-report)
        entries (get gap-report :entries)
        entry (get entries 0)
        span (get entry :source-span)
        changed-entry
        (assoc entry
               :title "Substituted Title"
               :path "docs/substituted-document.md"
               :phase 17
               :phaseName "Governance and Evolution"
               :category "governance"
               :source-span
               (assoc span :actual-source-path
                      "/checkout-a/docs/substituted-document.md"))]
    (assoc request :gap-report
           (assoc gap-report :entries (assoc entries 0 changed-entry)))))

(defn w5-full-invalid-coherent-gap-content-request [request]
  (let [gap-report (get request :gap-report)
        entries (get gap-report :entries)
        entry (get entries 0)]
    (assoc request :gap-report
           (assoc gap-report :entries
                  (assoc entries 0 (assoc entry :gaps [:forged-open-gap]))))))

(defn w5-full-invalid-no-owner-count-request [request]
  (assoc request :gap-report
         (assoc (get request :gap-report)
                :no-executable-owner-count 8)))

(defn w5-full-invalid-top-span-source-id-request [request]
  (assoc request :source-span
         (assoc (get request :source-span)
                :source-id :forged/full-language-evidence-request)))

(defn w5-full-invalid-top-span-bounds-request [request]
  (let [span (get request :source-span)
        start (get span :start)
        end (get span :end)]
    (assoc request :source-span
           (assoc span
                  :start (assoc start :byte 1)
                  :end (assoc end :byte 129)))))

(defn w5-full-invalid-top-span-line-column-request [request]
  (let [span (get request :source-span)
        start (get span :start)
        end (get span :end)]
    (assoc request :source-span
           (assoc span
                  :start (assoc (assoc start :line 2) :column 2)
                  :end (assoc (assoc end :line 2) :column 2)))))

(defn w5-full-invalid-top-span-request [request]
  (let [span (get request :source-span)
        start (get span :start)]
    (assoc request :source-span
           (assoc span :start (assoc start :byte -1)))))

(defn w5-full-invalid-source-fixture-suffix-request [request]

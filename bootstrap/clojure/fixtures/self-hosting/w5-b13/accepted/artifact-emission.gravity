(ns gravity.self-hosting.w5-b13.accepted
  (:profile :meta)
  ; Namespace target is the :jvm stage2 compiler-plan harness only; request
  ; records below carry the exact :llvm-x86_64-linux artifact candidate.
  (:target :jvm)
  (:exports [w5-b13-artifact-emission-request-at
             w5-b13-artifact-emission-request
             w5-b13-artifact-emission-alternate-path-request])
  (:effects #{})
  (:capabilities #{})
  (:safety :safe))

; This request is structurally complete but hash and rebuild observations are
; deliberately pending independent byte verification.  The source path is
; retained only in provenance and source-map records; IDs are path-neutral.


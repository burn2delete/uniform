(defn w5-b13-artifact-emission-request-at [path]
  {:artifact :gravity/w5-b13-artifact-emission-request
     :schema-version 1
     :artifact-id w5-b13-id-artifact
     :profile :meta
     :target :llvm-x86_64-linux
     :target-scope (w5-b13-target-scope)
     :manifest (w5-b13-manifest)
     :hash-record (w5-b13-hash-record)
     :emitted-artifact {:artifact :gravity/llvm-object
                        :artifact-id w5-b13-id-artifact
                        :content-hash w5-b13-id-content
                        :kind :llvm-object
                        :target :llvm-x86_64-linux
                        :object-format :elf
                        :abi :sysv-amd64
                        :runtime-providers #{}
                        :bytes-id w5-b13-id-emitted}
     :source-debug-map (w5-b13-source-debug-map path)
     :compiler-provenance (w5-b13-compiler-provenance)
     :dependency-provenance (w5-b13-dependency-provenance)
     :safety-proof-certificate-bundle (w5-b13-evidence-bundle)
     :effect-capability-summary (w5-b13-effect-capability-summary)
     :runtime-provider-summary (w5-b13-runtime-summary)
     :target-runtime-abi-layout-summary (w5-b13-target-summary)
     :reproducibility-record (w5-b13-reproducibility)
     :conformance-evidence-reference (w5-b13-conformance)
     :release-gate-record (w5-b13-release-gate)
     :artifact-graph (w5-b13-graph)
     :diagnostic-stream {:artifact :gravity/w5-b13-diagnostic-stream
                         :diagnostics ["B13-SCHEMA" "B13-HASH"
                                       "B13-PROVENANCE" "B13-SOURCEMAP"
                                       "B13-EVIDENCE" "B13-TARGET"
                                       "B13-CONFORMANCE"
                                       "B13-REPRODUCIBILITY" "B13-RELEASE"
                                       "B13-GRAPH"]
                         :status :complete}
     :release-attempt? false
     :provenance {:artifact :gravity/artifact-provenance-record
                  :source-id w5-b13-id-source
                  :actual-source-path path
                  :compiler-id "gravity-w5-b13-stage2"
                  :generator-id "gravity.backend.w5-b13-artifact-emitter"
                  :pass-pipeline w5-b13-provenance-passes
                  :dependency-graph-id w5-b13-id-dependencies
                  :dependencies w5-b13-dependency-inventory
                  :status :structural-complete}
     :clojure-seed-boundary? true
     :self-hosted? false

(ns self-hosting.sh08.vector-loop-nth-wrong-slot
  (:profile :meta) (:target :jvm)
  (:effects #{:memory/allocate :error/throw}) (:capabilities #{}) (:safety :safe))
(defn invalid [middle :- Bool failure :- String]
  (let [flags [true middle true] unrelated 0]
    (loop [cursor 0]
      (if (< cursor (count flags))
        (if (nth flags unrelated) (recur (inc cursor)) (throw failure))
        cursor))))

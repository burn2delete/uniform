(ns self-hosting.sh08.keyword-match-residual-alias
  (:profile :meta) (:target :jvm)
  (:effects #{:memory/allocate :error/throw}) (:capabilities #{}) (:safety :safe))
(defn invalid [command :- Keyword]
  (match command
    :read :hit
    remainder (let [saved remainder] (match saved :read :unreachable _ :other))))

(ns self-hosting.sh08.prefix-gated-slice-call-overrun
  (:profile :meta)
  (:target :jvm)
  (:effects #{:memory/allocate})
  (:capabilities #{})
  (:safety :safe)
  (:exports [main]))

(defn tail-characters [characters]
  true)

(defn main []
  (let [characters (vec "sha257:0af")]
    (if (= (subvec characters 0 7) [\s \h \a \2 \5 \6 \:])
      (tail-characters (subvec characters 7 11))
      false)))

(ns self-hosting.sh08.symbol-set-loop-conflicting-reentry
  (:profile :meta)
  (:target :jvm)
  (:effects #{:memory/allocate})
  (:capabilities #{})
  (:safety :safe)
  (:exports [main]))

(defn main []
  (loop [pending true seen '#{}]
    (let [member 'assoc]
      (if pending
        (if (symbol? member)
          (recur false (conj seen member))
          (recur false '#{:bad}))
        (contains? seen member)))))

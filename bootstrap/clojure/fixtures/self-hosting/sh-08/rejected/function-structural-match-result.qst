(ns self-hosting.sh08.function-structural-match-result
  (:profile :meta) (:target :jvm) (:effects #{}) (:capabilities #{}) (:safety :safe))
(defn wrong-result [flag :- Bool value :- I64] :- I64
  (let [packet {:payload [flag {:value value}]}]
    (match packet {:payload [true {:value item}]} item _ "wrong")))

(ns self-hosting.sh08.function-pattern-alias-false-result
  (:profile :meta) (:target :jvm) (:effects #{}) (:capabilities #{}) (:safety :safe))
(defn invalid [value :- I64] :- I64
  (match {:payload {:value value}}
    {:payload packet :when false}
    (match packet {:value item} "wrong")
    _ value))

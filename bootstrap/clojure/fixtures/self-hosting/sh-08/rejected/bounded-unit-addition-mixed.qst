(ns example.rejected-unit-addition
  (:profile :meta)
  (:target :jvm)
  (:effects #{:memory/allocate})
  (:capabilities #{})
  (:safety :safe))

(defn main [choose-plus :- Bool]
  (let [payloads [true true true]]
    (loop [cursor 0]
      (if (< cursor (count payloads))
        (if choose-plus
          (recur (+ cursor 2))
          (recur (inc cursor)))
        cursor))))

(ns self-hosting.sh08.atomic-catch-sibling-scope
  (:profile :meta) (:target :jvm)
  (:effects #{:error/throw}) (:capabilities #{}) (:safety :safe))
(defn recover [problem :- String] :- String
  (try (throw problem) (catch String first-error first-error)
       (catch Bool second-error first-error)))

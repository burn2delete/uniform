(ns self-hosting.sh08.local-throw-result-type
  (:profile :meta) (:target :jvm) (:exports [relay])
  (:effects #{:error/throw}) (:capabilities #{}) (:safety :safe))
(defn choose [flag :- Bool problem :- String] :- String
  (if flag (throw problem) problem))
(defn relay [flag :- Bool problem :- String] :- Bool
  (choose flag problem))

(ns self-hosting.sh08.nil-if-join-declared-non-nil
  (:profile :meta) (:target :jvm)
  (:effects #{}) (:capabilities #{}) (:safety :safe))
(defn w5-se-canonical-form [mode] :- Keyword
  (if (= mode :artifact)
    :canonical-content-hash
    (if (= mode :manifest)
      :canonical-manifest
      (if (= mode :diagnostic)
        :stable-code-and-source-span
        (if (= mode :conformance)
          :accepted-rejected-transcripts
          (if (= mode :runtime-output)
            :canonical-runtime-output
            (if (= mode :ir-modulo-id)
              :normalized-structure-modulo-id
              (if (= mode :reviewed-delta)
                :reviewed-provenance-delta
                nil))))))))
(defn check [] (w5-se-canonical-form :artifact))

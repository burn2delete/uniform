(ns self-hosting.sh08.sha-prefix-comparison-map-domain
  (:profile :meta)
  (:target :jvm)
  (:effects #{:memory/allocate})
  (:capabilities #{})
  (:safety :safe)
  (:exports [main]))

(defn main []
  (= (subvec (vec "sha256:0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef") 0 7) {:prefix true}))

(ns self-hosting.sh08.local-runtime-guard-false-call
  (:profile :meta) (:target :jvm) (:effects #{}) (:capabilities #{}) (:safety :safe))
(defn text [value :- String] :- String value)
(defn invalid [value :- String] :- String
  (match {:value value} {:value item :when false} (text false) _ value))

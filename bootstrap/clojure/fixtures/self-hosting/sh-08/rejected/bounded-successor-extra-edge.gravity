(ns self-hosting.sh08.bounded-successor-extra-edge
  (:profile :meta) (:target :jvm) (:effects #{:memory/allocate}) (:capabilities #{}) (:safety :safe))
(defn invalid [flag :- Bool]
  (let [values [true]]
    (loop [i 0]
      (if (< i (count values))
        (if flag (recur (inc i)) (recur (inc (count values))))
        i))))

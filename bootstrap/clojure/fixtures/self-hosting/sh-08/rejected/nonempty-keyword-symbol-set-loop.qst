(ns self-hosting.sh08.nonempty-keyword-symbol-loop
  (:profile :meta)
  (:target :jvm)
  (:effects #{:memory/allocate})
  (:capabilities #{})
  (:safety :safe)
  (:exports [main]))

(defn main []
  (loop [pending true seen #{:bad}]
    (let [member 'assoc]
      (if pending
        (recur false (conj seen member))
        (contains? seen member)))))

(ns self-hosting.sh08.module-literal-modes-missing-allocation
  (:profile :meta) (:target :jvm)
  (:effects #{}) (:capabilities #{}) (:safety :safe)
  (:exports [w5-stage-equivalence-modes main]))

(def w5-se-required-modes
  [:artifact :manifest :diagnostic :conformance :runtime-output
   :ir-modulo-id :reviewed-delta])

(defn w5-stage-equivalence-modes []
  w5-se-required-modes)

(defn main [] :- Bool
  (let [first-modes (w5-stage-equivalence-modes)
        second-modes (w5-stage-equivalence-modes)]
    (<= (count first-modes) (count second-modes))))

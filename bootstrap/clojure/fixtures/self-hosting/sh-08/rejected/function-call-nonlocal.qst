; SH-08-B48 rejection: lexical callable values remain unsupported.
(ns self-hosting.sh08.function-call-nonlocal
  (:profile :meta)
  (:target :jvm)
  (:exports [sh08-nonlocal-target
             sh08-nonlocal-caller
             sh08-nonlocal-result])
  (:effects #{})
  (:capabilities #{})
  (:safety :safe)
  (:metadata
   {:slice :SH-08-B48
    :fixture :function-call-nonlocal
    :required-products [:function-records :call-edges]
    :scope :first-order-fixed-arity-functions-locals-calls
    :expected-rejection :unsupported-nonlocal-call
    :non-claims
    [:higher-order-functions
     :dynamic-callable-values
     :protocol-dispatch]}))

(defn sh08-nonlocal-target [value]
  value)

(defn sh08-nonlocal-caller [callee value]
  (callee value))

(def sh08-nonlocal-result
  (sh08-nonlocal-caller sh08-nonlocal-target 7))

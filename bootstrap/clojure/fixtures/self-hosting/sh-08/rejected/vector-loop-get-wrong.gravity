(ns example.runtime-vector-get
  (:profile :meta)
  (:target :jvm)
  (:effects #{:memory/allocate :error/throw})
  (:capabilities #{})
  (:safety :safe))

(defn main [middle :- Keyword]
  (let [payloads [:keep middle :keep]
        other [:keep middle :keep]]
    (loop [cursor 0]
      (if (< cursor (count payloads))
        (do (get other cursor) (recur (inc cursor)))
        cursor))))

(ns self-hosting.sh08.vector-loop-nth-nested-target
  (:profile :meta) (:target :jvm)
  (:effects #{:memory/allocate :error/throw}) (:capabilities #{}) (:safety :safe))
(defn invalid [middle :- Bool failure :- String]
  (let [flags [true middle true]]
    (loop [cursor 0]
      (if (< cursor (count flags))
        (if (loop [unrelated 0] (nth flags cursor)) (recur (inc cursor)) (throw failure))
        cursor))))

(ns self-hosting.sh08.string-set-membership
  (:profile :meta) (:target :jvm)
  (:effects #{:memory/allocate}) (:capabilities #{}) (:safety :safe)
  (:exports [recognized? main]))

(defn recognized? [extension :- String] :- Bool
  (contains? #{".gravity" ".qst"} extension))

(defn main []
  [(recognized? ".gravity") (recognized? ".qst") (recognized? ".txt")])

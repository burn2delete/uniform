(ns self-hosting.sh08.private-map-keys
  (:profile :meta)
  (:target :jvm)
  (:effects #{:memory/allocate})
  (:capabilities #{})
  (:safety :safe)
  (:exports [main]))

(defn key-count [m :- Map]
  (count (keys m)))

(defn main []
  (do (key-count {:a 1 :b false})
      (key-count {:different "payload"})
      (key-count {})))

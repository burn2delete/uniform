(ns example.local-runtime-not
  (:profile :meta) (:target :jvm)
  (:effects #{:memory/allocate :error/throw}) (:capabilities #{}) (:safety :safe))

(defn guarded [tag :- Keyword] :- Keyword
  (match {:tag tag}
    {:tag tag :when (not (= tag :rejected))} :accepted
    _ :rejected))

(defn truth []
  [(not nil) (not false) (not true) (not 0) (not "")
   (not '()) (not '[]) (not '{}) (not '#{})])

(defn constructed [] [(not []) (not {})])

(defn characters [] [(not \A) (not '\😀)])

(defn marker-map []
  (not {:artifact :gravity/unicode-scalar-character :schema-version 1
        :codepoint 128512 :text "😀"}))

(defn thrown [payload :- String] (not (throw payload)))

(defn shadowed [not :- String] :- String not)

(defn main [] (guarded :accepted))

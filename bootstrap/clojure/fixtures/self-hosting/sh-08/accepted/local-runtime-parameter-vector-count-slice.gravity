(ns self-hosting.sh08.parameter-vector-count-slice
  (:profile :meta)
  (:target :jvm)
  (:effects #{:memory/allocate})
  (:capabilities #{})
  (:safety :safe)
  (:exports [main]))

(defn tail-characters [characters]
  (subvec characters 1 (count characters)))

(defn main []
  (tail-characters (vec "0af")))

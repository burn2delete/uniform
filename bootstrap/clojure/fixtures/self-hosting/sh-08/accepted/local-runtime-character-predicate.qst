(ns example.runtime-character-predicate
  (:profile :meta)
  (:target :jvm)
  (:exports [main])
  (:effects #{:memory/allocate})
  (:capabilities #{})
  (:safety :safe))

(defn main []
  [(char? \A)
   (char? \u00E9)
   (char? "A")
   (char? "😀")
   (char? {:artifact :gravity/unicode-scalar-character :schema-version 1
           :codepoint 128512 :text "😀"})
   (char? (if true \A nil))])

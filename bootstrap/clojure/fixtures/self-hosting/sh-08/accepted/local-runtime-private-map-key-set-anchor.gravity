(ns self-hosting.sh08.private-map-key-set-anchor
  (:profile :meta)
  (:target :jvm)
  (:effects #{:memory/allocate})
  (:capabilities #{})
  (:safety :safe)
  (:exports [main]))

(defn matches-keys [m :- Map]
  (= (set (keys m)) #{:a :b}))

(defn main []
  (do (matches-keys {:a 1 :b false})
      (matches-keys {:different "payload"})
      (matches-keys {})))

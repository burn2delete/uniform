(ns example.runtime-keyword-predicate-transfer
  (:profile :meta)
  (:target :jvm)
  (:exports [main])
  (:effects #{:error/throw})
  (:capabilities #{})
  (:safety :safe))

(defn caught [value :- Keyword]
  (try
    (if (keyword? :io/stdout)
      (keyword? (throw value))
      false)
    (catch Keyword problem (= problem value))))

(defn main [] (caught :problem))

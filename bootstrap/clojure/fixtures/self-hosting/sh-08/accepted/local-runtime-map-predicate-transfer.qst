(ns example.runtime-map-predicate-transfer
  (:profile :meta)
  (:target :jvm)
  (:exports [main])
  (:effects #{:error/throw})
  (:capabilities #{})
  (:safety :safe))

(defn caught [value :- Keyword]
  (try
    (if (map? '{})
      (map? (throw value))
      false)
    (catch Keyword problem (= problem value))))

(defn main [] (caught :problem))

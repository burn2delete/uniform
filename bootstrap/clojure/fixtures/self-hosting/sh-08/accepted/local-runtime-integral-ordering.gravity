(ns self-hosting.sh08.local-runtime-integral-ordering
  (:profile :meta) (:target :jvm)
  (:effects #{:error/throw :memory/allocate}) (:capabilities #{}) (:safety :safe))
(defn choose-left [left :- String right :- String] :- String left)
(defn lexical-shadowed [> :- String right :- String] :- String (choose-left > right))
(defn less [left :- I64 right :- I64] :- Bool (< left right))
(defn less-equal [left :- U64 right :- U64] :- Bool (<= left right))
(defn greater [left :- I8 right :- I8] :- Bool (> left right))
(defn greater-equal [left :- I32 right :- I32] :- Bool (>= left right))
(defn bounded [value :- I64 limit :- I64] :- String
  (match {:value value :limit limit}
    {:value item :limit cap :when (< item cap)} "below"
    _ "at-or-above"))
(defn caught-first [left :- String right :- String] :- String
  (try (< (throw left) (throw right)) (catch String error error)))
(defn caught-right [value :- I64 problem :- String] :- String
  (try (>= value (throw problem)) (catch String error error)))
(defn main [] :- Bool (<= 7 7))

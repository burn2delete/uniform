(ns self-hosting.sh08.local-runtime-returned-map-shape
  (:profile :meta) (:target :jvm) (:effects #{:error/throw}) (:capabilities #{}) (:safety :safe))

(defn lookup [value :- String] :- String (let [packet (forward value)] (:value packet)))
(defn forward [value :- String] (build value))
(defn build [value :- String] {:value value})
(defn nested [] :- String (:value (:outer (nested-build))))
(defn nested-build [] {:outer {:value "nested"}})
(defn missing [] (:value (other-build "other")))
(defn other-build [value :- String] {:other value})
(defn present-nil [] (:value (nil-build)))
(defn nil-build [] {:value nil})
(defn quoted-lookup [] :- String (:value (quoted-builder)))
(defn quoted-builder [] '{:value "quoted"})
(defn let-body-lookup [value :- String] :- String (:value (let-builder value)))
(defn let-builder [value :- String] (let [data {:value value} alias data] alias))
(defn caught [problem :- String] :- String (try (:missing (throw-builder problem)) (catch String error error)))
(defn throw-builder [problem :- String] (throw problem))
(defn main [] (lookup "payload"))

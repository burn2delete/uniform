(ns self-hosting.sh08.local-runtime-map-present-get
  (:profile :meta) (:target :jvm)
  (:effects #{:memory/allocate :error/throw}) (:capabilities #{}) (:safety :safe))
(defn span []
  '{:file "source.gravity" :archive "archive.gravity" :line 17 :kind :span :enabled false :payload nil})
(defn file [] :- String (get (span) :file))
(defn line [] (get '{:file "source.gravity" :line 17 :enabled false} :line))
(defn kind [] :- Keyword (get {:file "source.gravity" :kind :span :line 17} :kind))
(defn enabled [] :- Bool (get '{:enabled false :line 17} :enabled))
(defn payload [] (get '{:payload nil :file "source.gravity"} :payload))
(defn alias [] :- String
  (let [packet '{:file "source.gravity" :line 17} copy packet]
    (get copy :file)))
(defn original []
  (let [packet '{:file "source.gravity" :enabled false :payload nil}
        selected (get packet :file)]
    packet))
(defn inert [] (get '{:data (println "never") :enabled false} :data))
(defn default-value [] :- String (get '{:file "source.gravity"} :missing "fallback"))
(defn caught-map [first :- String later :- String] :- String
  (try (get (throw first) (throw later)) (catch String error error)))
(defn caught-key [problem :- String] :- String
  (try (get {:file "before"} (throw problem)) (catch String error error)))
(defn caught-bare-key [packet :- Map problem :- String] :- String
  (try (get packet (throw problem)) (catch String error error)))
(defn caught-map-literal [problem :- String] :- String
  (try (get (throw problem) :file) (catch String error error)))
(defn main [] :- String (file))

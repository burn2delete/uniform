(ns self-hosting.sh08.finite-integer-set-membership
  (:profile :meta) (:target :jvm)
  (:effects #{:memory/allocate}) (:capabilities #{}) (:safety :safe)
  (:exports [main]))

(defn codepoint []
  32)

(defn main []
  [(contains? #{} 32)
   (contains? #{9 10 13 32 44} 32)
   (gravity.core/contains? #{9 10 13 32 44} (codepoint))
   (contains? #{9 10 13 32 44} 11)
   (contains? #{1 2} 2)
   (contains? #{-1 0 1} -1)])

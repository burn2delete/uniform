(ns self-hosting.sh08.symbol-set-loop-invariant
  (:profile :meta)
  (:target :jvm)
  (:effects #{:memory/allocate})
  (:capabilities #{})
  (:safety :safe)
  (:exports [main]))

(defn main []
  (loop [pending true seen '#{}]
    (let [member 'assoc]
      (if pending
        (recur false (conj seen member))
        (contains? seen member)))))

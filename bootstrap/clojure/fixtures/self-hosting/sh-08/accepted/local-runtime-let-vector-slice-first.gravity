(ns self-hosting.sh08.let-vector-slice-first
  (:profile :meta)
  (:target :jvm)
  (:effects #{:memory/allocate})
  (:capabilities #{})
  (:safety :safe)
  (:exports [main]))

(defn main []
  [(let [characters (vec "sha256:abcd")] (first (subvec characters 7 8)))
   (let [bytes [65 66 67]] (first (subvec bytes 1 2)))
   (let [bytes [-5 999999999999999999999999999999999999]] (first (subvec bytes 1 2)))])

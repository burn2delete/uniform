; SH-08-HO1 accepted: a named immutable function value crosses one call.
(ns self-hosting.sh08.function-value-call
  (:profile :meta)
  (:target :jvm)
  (:exports [sh08-ho1-identity
             sh08-ho1-apply-one
             sh08-ho1-result])
  (:effects #{})
  (:capabilities #{})
  (:safety :safe)
  (:metadata
   {:slice :SH-08-HO1
    :fixture :function-value-call
    :scope :named-top-level-function-value-one-callable-parameter
    :dispatch :direct-function-value
    :non-claims [:closures :capture :recursion :multi-arity
                 :variadic-dispatch :protocols :dynamic-dispatch]}))

(defn sh08-ho1-identity [value]
  value)

(defn sh08-ho1-apply-one [callable value]
  (callable value))

(def sh08-ho1-result
  (sh08-ho1-apply-one sh08-ho1-identity 7))

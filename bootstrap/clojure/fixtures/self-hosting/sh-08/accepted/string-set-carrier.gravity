(ns self-hosting.sh08.string-set-carrier
  (:profile :meta) (:target :jvm)
  (:effects #{:memory/allocate}) (:capabilities #{}) (:safety :safe)
  (:exports [main]))

(defn member-after [again :- Bool value :- String seen] :- Bool
  (if again
    (member-after false value (conj seen value))
    (contains? seen value)))

(defn main []
  [(member-after false "seed" (conj '#{} "seed"))
   (member-after true "new" (conj '#{} "seed"))
   (member-after false "new" (conj '#{} "seed"))])

(ns self-hosting.sh08.integral-value-equality
  (:profile :meta) (:target :jvm)
  (:effects #{:memory/allocate :error/throw}) (:capabilities #{}) (:safety :safe)
  (:exports [w5-stage-equivalence-modes equal-count different-count ordinal-different same-i64 same-u64 caught-first main]))

(def w5-se-required-modes
  [:artifact :manifest :diagnostic :conformance :runtime-output
   :ir-modulo-id :reviewed-delta])

(defn w5-stage-equivalence-modes []
  w5-se-required-modes)

(defn same-ordinal [expected actual]
  (= expected actual))

(defn equal-count [] :- Bool
  (= 7 (count (w5-stage-equivalence-modes))))

(defn different-count [] :- Bool
  (= 6 (count (w5-stage-equivalence-modes))))

(defn ordinal-different [] :- Bool
  (same-ordinal 6 (count (w5-stage-equivalence-modes))))

(defn same-i64 [left :- I64 right :- I64] :- Bool
  (= left right))

(defn same-u64 [left :- U64 right :- U64] :- Bool
  (= left right))

(defn caught-first [] :- Bool
  (try
    (= (throw "left")
       (if true (throw "right") 7))
    (catch String problem
      (= problem "left"))))

(defn main [] :- Bool
  (same-ordinal 7 (count (w5-stage-equivalence-modes))))

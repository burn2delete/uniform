(ns self-hosting.sh08.string-set-comparison
  (:profile :meta) (:target :jvm)
  (:effects #{:memory/allocate}) (:capabilities #{}) (:safety :safe)
  (:exports [main]))

(def w5-b14-diagnostic-set
  #{"B14-COVERAGE" "B14-TARGET" "B14-POSITIVE" "B14-NEGATIVE"
    "B14-DIFFERENTIAL" "B14-METADATA" "B14-ARTIFACT"
    "B14-NONDETERMINISM" "B14-SKIP" "B14-EVIDENCE"})

(defn main []
  [(= w5-b14-diagnostic-set
      '#{"B14-EVIDENCE" "B14-SKIP" "B14-NONDETERMINISM" "B14-ARTIFACT"
         "B14-METADATA" "B14-DIFFERENTIAL" "B14-NEGATIVE" "B14-POSITIVE"
         "B14-TARGET" "B14-COVERAGE"})
   (= w5-b14-diagnostic-set
      '#{"B14-EVIDENCE" "B14-SKIP" "B14-NONDETERMINISM" "B14-ARTIFACT"
         "B14-METADATA" "B14-DIFFERENTIAL" "B14-NEGATIVE" "B14-POSITIVE"
         "B14-TARGET" "B14-UNKNOWN"})
   (not= w5-b14-diagnostic-set
         '#{"B14-EVIDENCE" "B14-SKIP" "B14-NONDETERMINISM" "B14-ARTIFACT"
            "B14-METADATA" "B14-DIFFERENTIAL" "B14-NEGATIVE" "B14-POSITIVE"
            "B14-TARGET" "B14-UNKNOWN"})])

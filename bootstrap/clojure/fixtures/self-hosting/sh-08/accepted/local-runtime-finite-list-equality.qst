(ns self-hosting.sh08.finite-list-equality
  (:profile :meta) (:target :jvm)
  (:effects #{:memory/allocate}) (:capabilities #{}) (:safety :safe)
  (:exports [main]))

(defn payload []
  (list "seed"))

(defn main []
  [(= '() '())
   (= '("same") '("different"))
   (= '(false nil :key "seed") '(false nil :key "seed"))
   (= '(:left :right) '(:right :left))
   (= '("same") '("same" "extra"))
   (= '(("nested" nil)) '(("nested" nil)))
   (= '(("nested")) '((:nested)))
   (= '(("nested")) '(("nested" "extra")))
   (= '(\A \😀) '(\A \😀))
   (= '((println "inert")) '((println "inert")))
   (= (payload) '("seed"))
   (= (list "seed" false) '("seed" false))])

(ns self-hosting.sh08.vector-first-symbol-loop
  (:profile :meta)
  (:target :jvm)
  (:effects #{:memory/allocate})
  (:capabilities #{})
  (:safety :safe)
  (:exports [main]))

(defn main []
  (let [head 'library/member]
    (loop [pending true seen #{}]
      (let [member (first [head])]
        (if pending
          (recur false (conj seen member))
          (contains? seen head))))))

(ns self-hosting.sh08.local-runtime-quoted-data
  (:profile :meta) (:target :jvm) (:effects #{}) (:capabilities #{}) (:safety :safe))

(defn quoted-nil [] 'nil)
(defn quoted-boolean [] 'false)
(defn quoted-integer [] '17)
(defn quoted-character [] '\a)
(defn quoted-string [] '"text")
(defn quoted-keyword [] ':data/key)
(defn quoted-symbol [] :- Symbol 'unresolved/data)
(defn quoted-list [] '(throw unresolved/data))
(defn quoted-vector [] '[nil true 17 \a "text" :key unresolved/data])
(defn quoted-map [] '{unresolved/key [true {:nested ready}]})
(defn quoted-set [] '#{unresolved/data :key})
(defn empty-data [] '[() [] {} #{}])
(defn nested-quote [] '(quote nested))
(defn let-forward [] (let [value '{:payload [unresolved/data]} alias value] alias))
(defn same-module-forward [] (quoted-map))
(defn main [] (same-module-forward))

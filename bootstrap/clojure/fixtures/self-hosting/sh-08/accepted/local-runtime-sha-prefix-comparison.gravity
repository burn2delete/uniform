(ns self-hosting.sh08.sha-prefix-comparison
  (:profile :meta)
  (:target :jvm)
  (:effects #{:memory/allocate})
  (:capabilities #{})
  (:safety :safe)
  (:exports [main]))

(defn main []
  [(= (subvec (vec "sha256:0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef") 0 7) [\s \h \a \2 \5 \6 \:])
   (= (subvec (vec "sha257:0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef") 0 7) [\s \h \a \2 \5 \6 \:])])

(ns self-hosting.sh08.local-runtime-bounded-successor
  (:profile :meta) (:target :jvm)
  (:effects #{:memory/allocate}) (:capabilities #{}) (:safety :safe))
(defn empty-counter []
  (let [values []]
    (loop [cursor 0]
      (if (< cursor (count values)) (recur (inc cursor)) cursor))))
(defn one-counter [flag :- Bool]
  (let [payloads [flag] renamed-values payloads]
    (loop [offset 0]
      (if (< offset (count renamed-values)) (recur (inc offset)) offset))))
(defn multiple-counter [choose :- Bool]
  (let [items [choose "value" :done]]
    (loop [index 0]
      (if (< index (count items))
        (if choose (recur (inc index)) (recur (inc index)))
        index))))
(defn main [] (multiple-counter true))

(ns self-hosting.sh08.literal-vector-slice
  (:profile :meta)
  (:target :jvm)
  (:effects #{:memory/allocate})
  (:capabilities #{})
  (:safety :safe)
  (:exports [main]))

(defn main []
  [(first (subvec [65 66 67] 1 2))
   (subvec [] 0 0)
   (subvec [-5 999999999999999999999999999999999999] 0 2)])

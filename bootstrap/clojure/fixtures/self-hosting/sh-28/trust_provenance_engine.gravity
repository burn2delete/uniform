              (if (vector? (get graph :component-content-hashes))
                (if (= (count (get graph :component-ids))
                       (count (get graph :component-content-hashes)))
                  (if (sh28-unique-from?
                       (get graph :component-ids) 0)
                    (if (vector? (get graph :generator-input-ids))
                      (if (= true (get graph :canonical))
                        (= :descriptor-only
                           (get graph :verification-status))
                        false)
                      false)
                    false)
                  false)

        false)
      false)
    false))

(defn sh28-record-by-field-from [records field value index]
  (if (= index (count records))
    nil
    (if (= value (get (get records index) field))
      (get records index)
      (sh28-record-by-field-from records field value (+ index 1)))))

(defn sh28-record-by-field [records field value]
  (sh28-record-by-field-from records field value 0))

(defn sh28-field-values-from [records field index result]
  (if (= index (count records))
    result
    (sh28-field-values-from
     records field (+ index 1)
     (conj result (get (get records index) field)))))

(defn sh28-field-values [records field]
  (sh28-field-values-from records field 0 []))

(defn sh28-lineage-node-valid? [node]
  (if (map? node)
    (if (= 12 (count node))
      (if (sh28-nonempty-string? (get node :artifact-id))
        (if (keyword? (get node :stage))
          (if (sh28-nonempty-string? (get node :compiler-artifact-id))
            (if (sh28-nonempty-string? (get node :source-graph-id))
              (if (sh28-nonempty-string? (get node :environment-id))
                (if (sh28-nonempty-string? (get node :lock-id))
                  (if (sh28-nonempty-string?
                       (get node :dependency-graph-id))
                    (if (sh28-nonempty-string? (get node :toolchain-id))
                      (if (vector? (get node :rebuild-parent-ids))
                        (if (<= (count (get node :rebuild-parent-ids)) 8)
                          (if (integer? (get node :topological-ordinal))
                            (if (sh28-nonempty-string?
                                 (get node :content-hash))
                              (sh28-nonempty-string?
                               (get node :actual-artifact-path))
                              false)
                            false)
                          false)
                        false)
                      false)
                    false)
                  false)
                false)
              false)
            false)
          false)
        false)
      false)
    false))

(defn sh28-seen-node? [nodes limit artifact-id index]
  (if (= index limit)
    false
    (if (= artifact-id (get (get nodes index) :artifact-id))
      true
      (sh28-seen-node? nodes limit artifact-id (+ index 1)))))

(defn sh28-parents-seen-from? [nodes limit parents index]
  (if (= index (count parents))
    true
    (if (sh28-seen-node? nodes limit (get parents index) 0)
      (sh28-parents-seen-from? nodes limit parents (+ index 1))
      false)))

(defn sh28-lineage-ordered-from? [nodes index]
  (if (= index (count nodes))
    true
    (let [node (get nodes index)
          parents (get node :rebuild-parent-ids)]
      (if (sh28-lineage-node-valid? node)
        (if (= index (get node :topological-ordinal))
          (if (sh28-seen-node? nodes index (get node :artifact-id) 0)
            false
            (if (sh28-unique-from? parents 0)
              (if (if (= index 0)
                    (= 0 (count parents))
                    (sh28-member?
                     parents (get node :compiler-artifact-id)))
                (if (sh28-parents-seen-from? nodes index parents 0)
                  (sh28-lineage-ordered-from? nodes (+ index 1))
                  false)
                false)
              false))
          false)
        false))))

(defn sh28-node-by-id-from [nodes artifact-id index]
  (if (= index (count nodes))
    nil
    (if (= artifact-id (get (get nodes index) :artifact-id))
      (get nodes index)
      (sh28-node-by-id-from nodes artifact-id (+ index 1)))))

(defn sh28-node-by-id [nodes artifact-id]
  (sh28-node-by-id-from nodes artifact-id 0))

(defn sh28-add-parent-ids-from [parents frontier index]
  (if (= index (count parents))
    frontier
    (sh28-add-parent-ids-from
     parents (conj frontier (get parents index)) (+ index 1))))

(defn sh28-reachable-node-ids [nodes root-id]
  (loop [frontier [root-id] visited [] steps 0]
    (if (= (count frontier) 0)
      visited
      (if (> steps 1024)
        []
        (let [current-id (first frontier)
              remaining (vec (rest frontier))]
          (if (sh28-member? visited current-id)
            (recur remaining visited (+ steps 1))
            (let [node (sh28-node-by-id nodes current-id)]
              (if (= node nil)
                []
                (recur
                 (sh28-add-parent-ids-from
                  (get node :rebuild-parent-ids) remaining 0)
                 (conj visited current-id)
                 (+ steps 1))))))))))

(defn sh28-all-node-ids-reachable?
  [nodes reachable index]
  (if (= index (count nodes))
    true
    (if (sh28-member?
         reachable (get (get nodes index) :artifact-id))
      (sh28-all-node-ids-reachable? nodes reachable (+ index 1))
      false)))

(defn sh28-lineage-valid? [nodes root-id]
  (if (vector? nodes)
    (if (> (count nodes) 0)
      (if (<= (count nodes) 64)
        (if (sh28-lineage-ordered-from? nodes 0)
          (if (= root-id
                 (get (get nodes (- (count nodes) 1)) :artifact-id))
            (sh28-all-node-ids-reachable?
             nodes (sh28-reachable-node-ids nodes root-id) 0)
            false)
          false)
        false)
      false)
    false))

(defn sh28-lineage-references-valid-from?
  [nodes environments locks dependencies toolchains index]
  (if (= index (count nodes))

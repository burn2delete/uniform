(defn sh28-lock-graphs-valid-from?
  [locks dependency-graphs index]
  (if (= index (count locks))
    true
    (let [lock (get locks index)
          graph
          (sh28-record-by-field
           dependency-graphs
           :dependency-graph-id
           (get lock :dependency-graph-id))]
      (if (map? graph)
        (if (= (get lock :dependency-ids)
               (get graph :dependency-ids))
          (if (= (get lock :dependency-content-hashes)
                 (get graph :dependency-content-hashes))
            (sh28-lock-graphs-valid-from?
             locks dependency-graphs (+ index 1))
            false)
          false)
        false))))

(defn sh28-dependency-graphs-bind?
  [dependency-graphs dependencies]
  (if (= 1 (count dependency-graphs))
    (let [graph (get dependency-graphs 0)]
      (if (= (get graph :dependency-ids)
             (sh28-field-values dependencies :dependency-id))
        (if (= (get graph :dependency-content-hashes)
               (sh28-field-values dependencies :content-hash))
          (= (get graph :dependency-provenance-ids)
             (sh28-field-values dependencies :provenance-id))
          false)
        false))
    false))

(defn sh28-seed-terminus-valid? [lineage bootstrap-inputs anchors]
  (if (> (count lineage) 0)
    (let [seed (get lineage 0)
          input
          (sh28-record-by-field
           bootstrap-inputs :input-id (get seed :compiler-artifact-id))]
      (if (map? input)
        (if (= (get seed :content-hash)
               (get input :content-hash))
          (sh28-member?
           (sh28-field-values anchors :anchor-id)
           (get input :anchor-descriptor-id))
          false)
        false))
    false))

(defn sh28-diverse-build-valid? [build]
  (if (map? build)
    (if (= 17 (count build))
      (if (sh28-nonempty-string? (get build :build-id))

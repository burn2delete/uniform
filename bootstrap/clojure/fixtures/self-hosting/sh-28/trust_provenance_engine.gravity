          (if (sh28-member?
               dependencies (get node :dependency-graph-id))
            (if (sh28-member? toolchains (get node :toolchain-id))
              (sh28-lineage-references-valid-from?
               nodes environments locks dependencies toolchains (+ index 1))
              false)
            false)
          false)
        false))))


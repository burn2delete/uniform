          (if (= (get build :content-hash)
               (get artifact-node :content-hash))
          (if (= (get build :source-graph-id)
                 (get artifact-node :source-graph-id))
            (if (= (get build :compiler-artifact-id)
                   (get artifact-node :compiler-artifact-id))
              (if (sh28-member?
           (sh28-field-values source-graphs :source-graph-id)
           (get build :source-graph-id))
        (if (sh28-member?

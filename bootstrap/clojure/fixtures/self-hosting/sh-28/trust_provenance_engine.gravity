(defn sh28-record-kind-valid? [kind record]
  (if (= kind :source-graph)
    (sh28-source-graph-valid? record)
    (if (= kind :dependency-graph)
      (sh28-dependency-graph-valid? record)
      (if (= kind :build-recipe)
        (sh28-build-recipe-valid? record)
        (if (= kind :builder)
          (sh28-builder-valid? record)
          (if (= kind :bootstrap-input)
            (sh28-bootstrap-input-valid? record)
            false))))))


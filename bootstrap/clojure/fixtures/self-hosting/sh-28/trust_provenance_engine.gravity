(defn sh28-signature-links-valid?
  [signature signing-policy sbom root-node first-build
   attestation-id anchors]
  (let [declared-anchor
        (sh28-record-by-field
         anchors :anchor-id (get first-build :trust-anchor-id))]
  (if (= (get root-node :artifact-id)
         (get signature :subject-artifact-id))
    (if (= (get root-node :content-hash)
           (get signature :subject-content-hash))
      (if (= (get sbom :artifact-manifest-id)
             (get signature :artifact-manifest-id))
        (if (= (get sbom :sbom-id) (get signature :sbom-id))
          (if (= (get sbom :safety-summary-id)
                 (get signature :safety-summary-id))
            (if (= (get first-build :build-recipe-id)
                   (get signature :build-recipe-id))
              (if (= attestation-id
                     (get signature :provenance-attestation-id))
                (if (= (str
                        "payload:"
                        (get root-node :artifact-id)
                        ":"
                        (get root-node :content-hash)
                        ":"
                        (get sbom :artifact-manifest-id)
                        ":"
                        (get sbom :sbom-id)
                        ":"
                        (get sbom :safety-summary-id)
                        ":"
                        (get first-build :build-recipe-id)
                        ":"
                        attestation-id)
                       (get signature :signed-payload-id))

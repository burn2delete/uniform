(ns gravity.self-hosting.sh28.trust-provenance-engine
  (:profile :meta)
  (:target :jvm)
  (:exports [sh28-trust-provenance-policy
             sh28-build-trust-evidence
             sh28-verify-trust-evidence])
  (:effects #{})
  (:capabilities #{})
  (:safety :safe))

(defn sh28-nonempty-string? [value]
  (if (string? value)
    (> (count value) 0)
    false))

(defn sh28-member-from? [values value index]
  (if (= index (count values))
    false
    (if (= value (get values index))
      true
      (sh28-member-from? values value (+ index 1)))))

(defn sh28-member? [values value]
  (if (vector? values)
    (sh28-member-from? values value 0)
    false))

(defn sh28-unique-from? [values index]
  (if (= index (count values))
    true
    (if (sh28-member-from? values (get values index) (+ index 1))
      false
      (sh28-unique-from? values (+ index 1)))))

(defn sh28-max [left right]
  (if (> left right) left right))

(defn sh28-distinct? [left right]
  (if (= left right) false true))

(defn sh28-aggregate? [value]
  (if (map? value)
    true
    (if (vector? value)
      true
      (set? value))))

(defn sh28-scalar? [value]
  (if (= value nil)
    true
    (if (string? value)
      true
      (if (keyword? value)
        true
        (if (symbol? value)
          true
          (if (integer? value)
            true
            (if (boolean? value)
              true
              false)))))))

(defn sh28-aggregate-width [value]
  (if (map? value)
    (* 2 (count value))
    (count value)))

(defn sh28-aggregate-components [value]
  (if (map? value)
    (loop [remaining (keys value) result []]
      (if (= (count remaining) 0)
        result
        (let [key (first remaining)]
          (recur
           (rest remaining)
           (conj (conj result key) (get value key))))))
    (vec value)))

(defn sh28-carrier-preflight [value]
  (loop [frontier [[value 0]]
         nodes 0
         scalar-units 0
         maximum-depth 0
         maximum-width 0]
    (if (= (count frontier) 0)
      {:status :accepted
       :nodes nodes
       :scalar-units scalar-units
       :maximum-depth maximum-depth
       :maximum-width maximum-width}
      (let [entry (first frontier)
            current (first entry)
            depth (second entry)
            next-nodes (+ nodes 1)]
        (if (seq? current)
          {:status :rejected :reason :carrier-sequence-not-canonical}
          (if (> next-nodes 65536)
          {:status :rejected :reason :carrier-node-bound}
          (if (> depth 96)
            {:status :rejected :reason :carrier-depth-bound}
            (if (sh28-aggregate? current)
              (let [width (sh28-aggregate-width current)]
                (if (> width 2048)
                  {:status :rejected :reason :carrier-width-bound}
                  (let [components (sh28-aggregate-components current)
                        next-frontier
                        (loop [remaining components
                               result (rest frontier)]
                          (if (= (count remaining) 0)
                            result
                            (recur
                             (rest remaining)
                             (conj result
                                   [(first remaining) (+ depth 1)]))))]
                    (recur
                     next-frontier
                     next-nodes
                     scalar-units
                     (sh28-max maximum-depth depth)
                     (sh28-max maximum-width width)))))
              (if (sh28-scalar? current)
                (let [next-scalar-units
                      (+ scalar-units (count (vec (str current))))]
                  (if (> next-scalar-units 2097152)
                    {:status :rejected :reason :carrier-scalar-bound}
                    (recur
                     (rest frontier)
                     next-nodes
                     next-scalar-units
                     (sh28-max maximum-depth depth)
                     maximum-width)))
                {:status :rejected
                 :reason :carrier-value-not-canonical})))))))))

(defn sh28-trust-provenance-policy []
  {:artifact :gravity/sh28-trust-provenance-policy
   :schema-version 1
   :governing-documents [:D9 :PKG7 :PKG10 :PKG12 :BOOT6 :BOOT8]
   :maximum-lineage-nodes 64
   :maximum-parents-per-node 8
   :maximum-carrier-nodes 65536
   :maximum-carrier-depth 96
   :maximum-container-width 2048
   :maximum-scalar-units 2097152
   :required-evidence
   [:sh27-equivalence
    :reproducible-rebuild
    :conformance
    :provenance-attestation
    :sbom
    :signature
    :unsafe-audit]
   :diagnostics
   ["SH28-SCHEMA"
    "BOOT8002"
    "BOOT8003"
    "BOOT8004"
    "BOOT8006"
    "BOOT8007"
    "BOOT6005"
    "PKG12004"
    "PKG12006"
    "SH28-TCB"
    "SH28-VERIFY"]
   :pending
   [:authentic-sh27-equivalence-ingress
    :independent-trust-anchor-verification
    :external-signature-verification
    :external-sbom-verification
    :public-release-routing
    :seedless-execution
    :sh28-completion]
   :release-trust-closed? false
   :clojure-seed-retired? false
   :clojure-seed-boundary? true})

(defn sh28-environment-valid? [environment]
  (if (map? environment)
    (if (= 10 (count environment))
      (if (sh28-nonempty-string? (get environment :environment-id))
        (if (sh28-nonempty-string? (get environment :manifest-id))
          (if (= "C" (get environment :locale))
            (if (= "UTC" (get environment :timezone))
              (if (= :sorted (get environment :filesystem-order))
                (if (= :fixed (get environment :timestamp-policy))
                  (if (integer? (get environment :random-seed))
                    (if (= :disabled (get environment :network-policy))
                      (if (= [] (get environment :allowed-environment))
                        (sh28-nonempty-string?
                         (get environment :actual-build-root))
                        false)
                      false)
                    false)
                  false)
                false)
              false)
            false)
          false)
        false)
      false)
    false))

(defn sh28-lock-valid? [lock]
  (if (map? lock)
    (if (= 7 (count lock))
      (if (sh28-nonempty-string? (get lock :lock-id))
        (if (= true (get lock :complete))
          (if (= true (get lock :offline))
            (if (sh28-nonempty-string? (get lock :dependency-graph-id))
              (if (vector? (get lock :dependency-ids))
                (if (vector? (get lock :dependency-content-hashes))
                  (if (= (count (get lock :dependency-ids))
                         (count (get lock :dependency-content-hashes)))
                    (if (sh28-unique-from?
                         (get lock :dependency-ids) 0)
                      (sh28-nonempty-string? (get lock :content-hash))
                      false)
                    false)
                  false)
                false)
              false)
            false)
          false)
        false)
      false)
    false))


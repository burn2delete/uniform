                 locks
                 (get request :toolchains)
                 (get request :trust-anchors)
                 lineage
                 0)
              (if (sh28-filter-membership-from?
                   (sh28-field-values
                    (get request :runtime-artifacts)
                    :source-graph-id)
                   (sh28-field-values
                    source-graphs :source-graph-id)
                   true
                   0)
                (sh28-evidence-links-valid? request)
                false)
              false)
            false)
          false)
        false)
      false)))

(defn sh28-request-valid? [request]
  (if (sh28-request-shape-valid? request)
    (let [environments (get request :environments)
          locks (get request :locks)
          dependencies (get request :dependencies)
          toolchains (get request :toolchains)
          lineage (get request :lineage)
          builds (get request :diverse-builds)
          anchors (get request :trust-anchors)
          root-id (get request :root-artifact-id)]
      (if (sh28-environments-valid? environments)
        (if (sh28-unique-from?
             (sh28-field-values environments :environment-id) 0)
          (if (sh28-locks-valid? locks)
            (if (sh28-unique-from?
                 (sh28-field-values locks :lock-id) 0)
              (if (sh28-dependencies-valid? dependencies)
                (if (sh28-unique-from?
                     (sh28-field-values dependencies :dependency-id) 0)
                  (if (sh28-toolchains-valid? toolchains)
                    (if (sh28-unique-from?
                         (sh28-field-values toolchains :toolchain-id) 0)
                      (if (sh28-declared-products-valid? request)
                        (if (sh28-lineage-valid? lineage root-id)
                        (if (sh28-lineage-references-valid-from?
                             lineage
                             (sh28-field-values
                              environments :environment-id)
                             (sh28-field-values locks :lock-id)
                             (sh28-field-values
                              locks :dependency-graph-id)
                             (sh28-field-values
                              toolchains :toolchain-id)
                             0)
                          (if (sh28-anchors-valid? anchors)
                            (if (sh28-diverse-builds-valid?
                                 builds
                                 root-id
                                 (sh28-field-values
                                  toolchains :toolchain-id)
                                 (sh28-field-values anchors :anchor-id))
                              (if (sh28-product-links-valid? request)
                                (if (sh28-evidence-valid?
                                     (get request :evidence))
                                (if (sh28-revocations-valid?
                                     (get request :revocations))
                                  (if (sh28-revocation-links-valid?
                                       request
                                       dependencies
                                       builds
                                       (get request :revocations))
                                    (if (sh28-unsafe-audits-valid?
                                         (get request :unsafe-audits))
                                      (sh28-tcb-delta-valid? request)
                                  false)
                                false)
                              false)
                            false)
                          false)
                        false)
                        false)
                      false)
                          false)
                        false)
                      false)
                    false)
                  false)
                false)
              false)
            false)
          false)
        false))
    false))

(defn sh28-request-rejection-details [request]
  (if (sh28-request-shape-valid? request)
    (let [environments (get request :environments)
          locks (get request :locks)
          dependencies (get request :dependencies)
          toolchains (get request :toolchains)
          lineage (get request :lineage)
          builds (get request :diverse-builds)
          anchors (get request :trust-anchors)
          root-id (get request :root-artifact-id)]
      (if (sh28-environments-valid? environments)
        (if (sh28-locks-valid? locks)
          (if (sh28-dependencies-valid? dependencies)
            (if (sh28-toolchains-valid? toolchains)
              (if (sh28-declared-products-valid? request)
                (if (sh28-lineage-valid? lineage root-id)
                (if (sh28-lineage-references-valid-from?
                     lineage
                     (sh28-field-values environments :environment-id)
                     (sh28-field-values locks :lock-id)
                     (sh28-field-values locks :dependency-graph-id)
                     (sh28-field-values toolchains :toolchain-id)
                     0)
                  (if (sh28-anchors-valid? anchors)
                    (if (sh28-diverse-builds-valid?
                         builds
                         root-id
                         (sh28-field-values toolchains :toolchain-id)
                         (sh28-field-values anchors :anchor-id))
                      (if (sh28-product-links-valid? request)
                        (if (sh28-evidence-valid? (get request :evidence))
                        (if (sh28-revocations-valid?
                             (get request :revocations))
                          (if (sh28-revocation-links-valid?
                               request
                               dependencies
                               builds
                               (get request :revocations))
                            (if (sh28-unsafe-audits-valid?
                                 (get request :unsafe-audits))
                              (if (sh28-tcb-delta-valid? request)
                                {:rule "SH28-SCHEMA"
                                 :reason :duplicate-or-noncanonical-identity}
                                {:rule "SH28-TCB"
                                 :reason :invalid-tcb-delta})
                              {:rule "BOOT8004"
                               :reason :unsafe-audit-evidence-gap})
                            {:rule "BOOT8006"
                             :reason :revocation-subject-link-gap})
                          {:rule "BOOT8006"
                           :reason :revoked-or-incomplete-revocation-status})
                          {:rule "BOOT8004"
                           :reason :missing-release-evidence-reference})
                        {:rule "BOOT8004"
                         :reason :declared-product-link-gap})
                      {:rule "BOOT6005"
                       :reason :diverse-build-identity-gap})
                    {:rule "BOOT6005"
                     :reason :independent-anchor-descriptor-gap})
                  {:rule "BOOT8007"
                   :reason :lineage-provenance-reference-gap})
                  {:rule "BOOT8002"
                   :reason :lineage-gap-cycle-or-unreachable-node})
                {:rule "BOOT8004"
                 :reason :declared-product-schema-gap})
              {:rule "BOOT8007"
               :reason :toolchain-provenance-gap})
            {:rule "BOOT8007"
             :reason :dependency-provenance-gap})
          {:rule "BOOT8007"
           :reason :lock-provenance-gap})
        {:rule "BOOT8007"
         :reason :environment-provenance-gap}))
    {:rule "SH28-SCHEMA" :reason :invalid-request-schema}))

(defn sh28-normalize-environments-from [records index result]
  (if (= index (count records))
    result
    (let [record (get records index)]
      (sh28-normalize-environments-from
       records (+ index 1)
       (conj result
             {:environment-id (get record :environment-id)
              :manifest-id (get record :manifest-id)
              :locale (get record :locale)
              :timezone (get record :timezone)
              :filesystem-order (get record :filesystem-order)
              :timestamp-policy (get record :timestamp-policy)
              :random-seed (get record :random-seed)
              :network-policy (get record :network-policy)
              :allowed-environment (get record :allowed-environment)})))))

(defn sh28-normalize-lineage-from [records index result]
  (if (= index (count records))
    result
    (let [record (get records index)]
      (sh28-normalize-lineage-from
       records (+ index 1)
       (conj result
             {:artifact-id (get record :artifact-id)
              :stage (get record :stage)
              :compiler-artifact-id (get record :compiler-artifact-id)
              :source-graph-id (get record :source-graph-id)
              :environment-id (get record :environment-id)
              :lock-id (get record :lock-id)
              :dependency-graph-id (get record :dependency-graph-id)
              :toolchain-id (get record :toolchain-id)
              :rebuild-parent-ids (get record :rebuild-parent-ids)
              :topological-ordinal (get record :topological-ordinal)
              :content-hash (get record :content-hash)})))))

(defn sh28-normalize-toolchains-from [records index result]
  (if (= index (count records))
    result
    (let [record (get records index)]
      (sh28-normalize-toolchains-from
       records (+ index 1)
       (conj result
             {:toolchain-id (get record :toolchain-id)
              :family (get record :family)
              :version (get record :version)
              :target (get record :target)
              :content-hash (get record :content-hash)
              :identity-status (get record :identity-status)})))))

(defn sh28-normalize-builds-from [records index result]
  (if (= index (count records))
    result
    (let [record (get records index)]
      (sh28-normalize-builds-from
       records (+ index 1)
       (conj result
             {:build-id (get record :build-id)
              :artifact-id (get record :artifact-id)
              :content-hash (get record :content-hash)
              :source-graph-id (get record :source-graph-id)
              :compiler-artifact-id (get record :compiler-artifact-id)
              :lock-id (get record :lock-id)
              :dependency-graph-id (get record :dependency-graph-id)
              :build-recipe-id (get record :build-recipe-id)
              :builder-id (get record :builder-id)
              :capability-inventory-id
              (get record :capability-inventory-id)
              :toolchain-id (get record :toolchain-id)
              :environment-id (get record :environment-id)
              :trust-anchor-id (get record :trust-anchor-id)
              :comparison-status (get record :comparison-status)
              :independence-status (get record :independence-status)
              :rebuild-report-id (get record :rebuild-report-id)})))))

(defn sh28-normalize-anchors-from [records index result]
  (if (= index (count records))
    result
    (let [record (get records index)]
      (sh28-normalize-anchors-from
       records (+ index 1)
       (conj result
             {:anchor-id (get record :anchor-id)
              :anchor-kind (get record :anchor-kind)
              :operator-id (get record :operator-id)
              :root-metadata-id (get record :root-metadata-id)
              :public-identity-id (get record :public-identity-id)
              :verification-status (get record :verification-status)
              :revocation-status (get record :revocation-status)
              :policy-id (get record :policy-id)})))))

(defn sh28-normalize-runtime-artifacts-from [records index result]
  (if (= index (count records))
    result
    (let [record (get records index)]
      (sh28-normalize-runtime-artifacts-from
       records (+ index 1)
       (conj result
             {:artifact-id (get record :artifact-id)
              :content-hash (get record :content-hash)
              :source-graph-id (get record :source-graph-id)
              :profile (get record :profile)
              :target (get record :target)
              :verification-status
              (get record :verification-status)})))))

(defn sh28-normalize-recovery-artifacts-from [records index result]
  (if (= index (count records))
    result
    (let [record (get records index)]
      (sh28-normalize-recovery-artifacts-from
       records (+ index 1)
       (conj result
             {:artifact-id (get record :artifact-id)
              :content-hash (get record :content-hash)
              :role (get record :role)
              :included-in-release-boundary
              (get record :included-in-release-boundary)
              :verification-status
              (get record :verification-status)})))))

(defn sh28-identity-input [request]
  {:artifact :gravity/sh28-trust-evidence-identity-input
   :schema-version 1
   :release-id (get request :release-id)
   :root-artifact-id (get request :root-artifact-id)
   :source-graphs (get request :source-graphs)
   :dependency-graphs (get request :dependency-graphs)
   :environments
   (sh28-normalize-environments-from (get request :environments) 0 [])
   :locks (get request :locks)
   :dependencies (get request :dependencies)
   :toolchains
   (sh28-normalize-toolchains-from (get request :toolchains) 0 [])
   :build-recipes (get request :build-recipes)
   :builders (get request :builders)
   :bootstrap-inputs (get request :bootstrap-inputs)
   :lineage
   (sh28-normalize-lineage-from (get request :lineage) 0 [])
   :diverse-builds
   (sh28-normalize-builds-from (get request :diverse-builds) 0 [])
   :trust-anchors
   (sh28-normalize-anchors-from (get request :trust-anchors) 0 [])
   :evidence (get request :evidence)
   :sboms (get request :sboms)
   :signatures (get request :signatures)
   :signing-policies (get request :signing-policies)
   :attestations (get request :attestations)
   :unsafe-audit-index (get request :unsafe-audit-index)
   :release-inventory (get request :release-inventory)
   :revocations (get request :revocations)
   :unsafe-audits (get request :unsafe-audits)
   :runtime-artifacts
   (sh28-normalize-runtime-artifacts-from
    (get request :runtime-artifacts) 0 [])
   :recovery-artifacts
   (sh28-normalize-recovery-artifacts-from
    (get request :recovery-artifacts) 0 [])
   :tcb-delta (get request :tcb-delta)})

(defn sh28-provenance [request]
  {:actual-release-root (get request :actual-release-root)
   :actual-environment-roots
   (sh28-field-values (get request :environments) :actual-build-root)
   :actual-toolchain-paths
   (sh28-field-values (get request :toolchains) :actual-toolchain-path)
   :actual-artifact-paths
   (sh28-field-values (get request :lineage) :actual-artifact-path)
   :actual-runtime-artifact-paths
   (sh28-field-values
    (get request :runtime-artifacts) :actual-artifact-path)
   :actual-recovery-artifact-paths
   (sh28-field-values
    (get request :recovery-artifacts) :actual-artifact-path)
   :actual-diverse-build-roots
   (sh28-field-values (get request :diverse-builds) :actual-build-root)
   :actual-anchor-locations
   (sh28-field-values
    (get request :trust-anchors) :actual-anchor-location)})

(defn sh28-diagnostic [rule reason request]
  {:rule rule
   :phase :bootstrap-trust
   :source-span
   {:source
    (if (map? request)
      (get request :actual-release-root)
      "<untrusted-carrier>")
    :line 1
    :column 1}
   :facts
   {:reason reason
    :release-id
    (if (map? request) (get request :release-id) nil)
    :root-artifact-id
    (if (map? request) (get request :root-artifact-id) nil)}
   :remediation
   :supply-complete-bounded-current-bootstrap-trust-evidence})

(defn sh28-build-accepted [request preflight]
  {:artifact :gravity/sh28-trust-evidence
   :schema-version 1
   :status :accepted
   :release-id (get request :release-id)
   :root-artifact-id (get request :root-artifact-id)
   :lineage-status :acyclic-and-traversable
   :diverse-build-status :descriptor-consistent
   :trust-anchor-status :external-verification-pending
   :revocation-status :clear-at-declared-sources
   :unsafe-audit-status :complete-for-declared-islands
   :tcb-delta-status :explicit-pending-independent-validation
   :identity-input (sh28-identity-input request)
   :provenance (sh28-provenance request)
   :carrier-census preflight
   :diagnostics []
   :pending
   [:authentic-sh27-equivalence-ingress
    :independent-trust-anchor-verification
    :external-signature-verification
    :external-sbom-verification
    :public-release-routing
    :seedless-execution
    :sh28-completion]
   :release-trust-closed? false
   :clojure-seed-retired? false
   :clojure-seed-boundary? true})

(defn sh28-build-trust-evidence [request]
  (let [preflight (sh28-carrier-preflight request)]
    (if (= :accepted (get preflight :status))
      (if (sh28-request-valid? request)
        (sh28-build-accepted request preflight)
        (let [details (sh28-request-rejection-details request)]
          {:artifact :gravity/sh28-trust-evidence
           :schema-version 1
           :status :rejected
           :diagnostics
           [(sh28-diagnostic
             (get details :rule) (get details :reason) request)]
           :pending
           [:authentic-sh27-equivalence-ingress
            :independent-trust-anchor-verification
            :sh28-completion]
           :release-trust-closed? false
           :clojure-seed-retired? false
           :clojure-seed-boundary? true}))
      {:artifact :gravity/sh28-trust-evidence
       :schema-version 1
       :status :rejected
       :diagnostics
       [(sh28-diagnostic
         "SH28-SCHEMA" (get preflight :reason) request)]
       :pending
       [:authentic-sh27-equivalence-ingress
        :independent-trust-anchor-verification
        :sh28-completion]
       :release-trust-closed? false
       :clojure-seed-retired? false
       :clojure-seed-boundary? true})))

(defn sh28-verification-rejection [reason]
  {:artifact :gravity/sh28-trust-evidence-verification
   :schema-version 1
   :status :rejected
   :diagnostics
   [{:rule "SH28-VERIFY"
     :phase :bootstrap-trust
     :source-span {:source "<candidate-result>" :line 1 :column 1}
     :facts {:reason reason}
     :remediation :recompute-complete-trust-evidence}]
   :release-trust-closed? false
   :clojure-seed-retired? false
   :clojure-seed-boundary? true})

(defn sh28-verify-trust-evidence [request candidate]
  (let [request-preflight (sh28-carrier-preflight request)
        candidate-preflight (sh28-carrier-preflight candidate)]
    (if (= :accepted (get request-preflight :status))
      (if (= :accepted (get candidate-preflight :status))
        (let [expected (sh28-build-trust-evidence request)]
          (if (= expected candidate)
            {:artifact :gravity/sh28-trust-evidence-verification
             :schema-version 1
             :status :passed
             :verified-artifact :gravity/sh28-trust-evidence
             :verified-release-id (get candidate :release-id)
             :diagnostics []
             :release-trust-closed? false
             :clojure-seed-retired? false
             :clojure-seed-boundary? true}
            (sh28-verification-rejection :candidate-result-altered)))
        (sh28-verification-rejection
         (get candidate-preflight :reason)))
      (sh28-verification-rejection
       (get request-preflight :reason)))))

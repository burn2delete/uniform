(ns self-hosting.sh06.reject.capability
  (:profile :hosted) (:target :jvm)
  (:requires [gravity.net :as net :profile :hosted :effects #{:network/http}
              :capabilities #{:http/client} :visibility :public])
  (:effects #{:network/http}) (:capabilities #{}) (:safety :safe)
  (:metadata {:slice :SH-06
              :compiler {:sh06-request {:request-version 1
                                         :references [{:symbol net/get :position :expression}]
                                         :candidate-bindings
                                         [{:name get :namespace gravity.net :visibility :public
                                           :capabilities [:http/client]}]
                                         :capability-grants []}}
              :sh06 {:expected-rule "C5-CAPABILITY" :expected-stage :name-resolution
                     :expected-severity :error :expected-remediation :grant-required-capability}}))
(defn candidate [] net/get)

(ns self-hosting.sh06.qualified-core-count
  (:profile :meta)
  (:target :jvm)
  (:effects #{})
  (:capabilities #{})
  (:safety :safe))

(defn plain [items :- List] (count items))
(defn qualified [items :- gravity.core/List] (gravity.core/count items))
(defn main [] (gravity.core/count '(nil false "entry")))

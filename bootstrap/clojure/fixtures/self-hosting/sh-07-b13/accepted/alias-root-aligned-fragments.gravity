; SH-07-B13 preserves B12 alias references across root-aligned fragments.
(ns self-hosting.sh07-b13.alias-root-aligned-fragments
  (:profile :meta)
  (:target :jvm)
  (:requires [shared.core :as shared :profile :core
              :boundary :pure-core :refer [checksum]])
  (:exports [alias-value alias-call alias-result])
  (:effects #{})
  (:capabilities #{})
  (:safety :safe)
  (:metadata {:slice :SH-07-B13
              :fixture :alias-root-aligned-fragments
              :non-claims [:foreign-import-lowering
                           :runtime-linking
                           :whole-program-execution]}))

(def alias-value
  shared/checksum)

(defn alias-call [value]
  (shared/checksum value))

(def alias-result
  (alias-call 13))

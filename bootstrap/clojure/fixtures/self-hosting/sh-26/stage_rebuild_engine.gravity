(ns gravity.self-hosting.sh26.stage-rebuild-engine
  (:profile :meta)
  (:target :jvm)
  (:exports [sh26-stage-rebuild-policy
             sh26-authoritative-component-catalog
             sh26-carrier-preflight
             sh26-build-next-stage
             sh26-verify-stage-rebuild])
  (:effects #{})
  (:capabilities #{})
  (:safety :safe))

(defn sh26-nonempty-string? [value]
  (if (string? value) (> (count value) 0) false))

(defn sh26-exact-keys? [value expected]
  (if (map? value) (= (set (keys value)) expected) false))

(defn sh26-max [left right]
  (if (> left right) left right))

(defn sh26-aggregate? [value]
  (if (map? value) true (if (vector? value) true (set? value))))

(defn sh26-aggregate-width [value]
  (if (map? value) (* 2 (count value)) (count value)))

(defn sh26-aggregate-components [value]
  (if (map? value)
    (let [map-keys (vec (keys value))]
      (loop [index 0 result []]
        (if (= index (count map-keys))
          result
          (recur
           (+ index 1)
           (conj
            (conj result (get map-keys index))
            (get value (get map-keys index)))))))
    (if (vector? value) value (vec value))))

(defn sh26-scalar-units [value]
  (if (= nil value)
    3
    (if (boolean? value)
      5
      (if (string? value)
        (* 4 (count value))
        (if (char? value)
          4
          (if (keyword? value)
            64
            (if (symbol? value)
              64
              (if (integer? value)
                (if (if (>= value -9223372036854775808)
                      (<= value 9223372036854775807)
                      false)
                  20
                  -1)
                -1))))))))

(defn sh26-carrier-preflight [value]
  (loop [frontier [[value 0]]
         cursor 0
         nodes 0
         scalar-units 0
         observed-depth 0
         observed-width 0]
    (if (= cursor (count frontier))
      {:status :accepted
       :nodes nodes
       :scalar-units scalar-units
       :maximum-depth observed-depth
       :maximum-width observed-width}
      (let [entry (get frontier cursor)
            current (first entry)
            depth (second entry)
            next-nodes (+ nodes 1)]
        (if (> next-nodes 1048576)
          {:status :rejected :reason :carrier-node-bound}
          (if (> depth 128)
            {:status :rejected :reason :carrier-depth-bound}
            (if (seq? current)
              {:status :rejected :reason :carrier-sequence-unsupported}
              (if (sh26-aggregate? current)
                (let [width (sh26-aggregate-width current)]
                  (if (> width 65536)
                    {:status :rejected :reason :carrier-width-bound}
                    (let [components
                          (sh26-aggregate-components current)]
                      (if (> (+ (- (count frontier) cursor)
                                (count components))
                             1048576)
                        {:status :rejected :reason :carrier-node-bound}
                        (let [next-frontier
                              (loop [index 0 result frontier]
                                (if (= index (count components))
                                  result
                                  (recur
                                   (+ index 1)
                                   (conj result
                                         [(get components index)
                                          (+ depth 1)]))))]
                          (recur
                           next-frontier
                           (+ cursor 1)
                           next-nodes
                           scalar-units
                           (sh26-max observed-depth depth)
                           (sh26-max observed-width width)))))))
                (let [units (sh26-scalar-units current)]
                  (if (< units 0)
                    {:status :rejected :reason :carrier-scalar-type}
                    (if (> units 1048576)
                      {:status :rejected :reason :carrier-scalar-bound}
                      (let [next-units (+ scalar-units units)]
                        (if (> next-units 16777216)
                          {:status :rejected
                           :reason :carrier-scalar-bound}
                          (recur
                           frontier
                           (+ cursor 1)
                           next-nodes
                           next-units
                           (sh26-max observed-depth depth)
                           observed-width))))))))))))))

(defn sh26-stage-rebuild-policy []
  {:artifact :gravity/sh26-stage-rebuild-policy
   :schema-version 2
   :governing-documents [:BOOT1 :BOOT3 :BOOT6 :PKG7]
   :required-component-count 43
   :maximum-components 43
   :maximum-dependencies-per-component 16
   :carrier-limits
   {:nodes 1048576 :depth 128 :width 65536
    :scalar-units 16777216 :single-scalar-units 1048576}
   :candidate-language :gravity
   :forbidden-candidate-authority
   [:clojure :shell :network :registry :ambient-filesystem]
   :diagnostics
   ["BOOT1001" "BOOT1003" "BOOT1005"
    "BOOT3001" "BOOT3002" "BOOT6001" "BOOT6002"]
   :pending
   [:candidate-action-execution
    :external-sh25-recomputation
    :native-runtime-and-library-linkage
    :independent-clean-rebuild
    :external-output-hash-recomputation
    :sh26-completion
    :seed-retirement]
   :self-hosted? false
   :clojure-seed-boundary? true})

(defn sh26-authoritative-component-catalog []
  [[:authenticated-envelope []]
   [:surface-reader [:authenticated-envelope]]
   [:bootstrap-reader [:surface-reader]]
   [:syntax-model [:bootstrap-reader :authenticated-envelope]]
   [:bootstrap-syntax [:syntax-model]]
   [:macro-engine [:bootstrap-syntax]]
   [:bootstrap-macro [:macro-engine]]
   [:resolution-engine [:bootstrap-macro]]
   [:bootstrap-resolution [:resolution-engine]]
   [:core-semantics [:bootstrap-resolution]]
   [:core-lowering [:core-semantics]]
   [:checked-core [:core-lowering :authenticated-envelope]]
   [:checked-core-pipeline [:checked-core]]
   [:call-arity [:checked-core-pipeline]]
   [:type-checker [:checked-core-pipeline]]
   [:effect-checker [:type-checker]]
   [:ownership-checker [:type-checker]]
   [:safety-analysis [:effect-checker :ownership-checker]]
   [:mir [:safety-analysis]]
   [:domain-ir [:mir]]
   [:compiler-diagnostics [:mir]]
   [:bootstrap-diagnostics [:compiler-diagnostics]]
   [:mir-optimization [:mir :bootstrap-diagnostics]]
   [:compiler-verification [:mir-optimization]]
   [:target-lowering [:compiler-verification :domain-ir]]
   [:backend-interface [:target-lowering]]
   [:backend-c [:backend-interface]]
   [:backend-llvm [:backend-interface]]
   [:backend-wasm [:backend-interface]]
   [:backend-jvm [:backend-interface]]
   [:backend-js [:backend-interface]]
   [:backend-mlir [:backend-interface]]
   [:backend-gpu [:backend-interface]]
   [:backend-hdl [:backend-interface]]
   [:backend-workflow [:backend-interface]]
   [:backend-query [:backend-interface]]
   [:backend-mobile [:backend-interface]]
   [:incremental-compiler [:compiler-verification]]
   [:compiler-pass-api [:compiler-verification]]
   [:meta-legality [:effect-checker :target-lowering]]
   [:standard-library-subset [:mir :meta-legality]]
   [:package-build-subset
    [:backend-c :meta-legality :standard-library-subset]]
   [:runtime-subset [:backend-c :standard-library-subset]]])

(defn sh26-environment-valid? [environment]
  (if
   (sh26-exact-keys?
    environment
    #{:environment-id :locked-dependencies :locale :timezone
      :filesystem-order :timestamp-policy :random-seed :network
      :allowed-environment})
    (if (sh26-nonempty-string? (get environment :environment-id))
      (if (= true (get environment :locked-dependencies))
        (if (= "C" (get environment :locale))
          (if (= "UTC" (get environment :timezone))
            (if (= :sorted (get environment :filesystem-order))
              (if (= :fixed (get environment :timestamp-policy))
                (if (integer? (get environment :random-seed))
                  (if (= :disabled (get environment :network))
                    (= [] (get environment :allowed-environment))
                    false)
                  false)
                false)
              false)
            false)
          false)
        false)
      false)
    false))

(defn sh26-content-record-valid? [record artifact]
  (if
   (sh26-exact-keys?
    record #{:artifact :schema-version :content-id :byte-count})
    (if (= artifact (get record :artifact))
      (if (= 1 (get record :schema-version))
        (if (sh26-nonempty-string? (get record :content-id))
          (if (integer? (get record :byte-count))
            (> (get record :byte-count) 0)
            false)
          false)
        false)
      false)
    false))

(defn sh26-component-valid? [component expected ordinal]
  (if
   (sh26-exact-keys?
    component
    #{:component-id :source-id :output-id :topological-ordinal
      :dependencies :profile :implementation-language
      :conformance-status :sh25-verification-status
      :actual-source-path})
    (if (= (first expected) (get component :component-id))
      (if (= (second expected) (get component :dependencies))
        (if (= ordinal (get component :topological-ordinal))
          (if (sh26-nonempty-string? (get component :source-id))
            (if (sh26-nonempty-string? (get component :output-id))
              (if (= :meta (get component :profile))
                (if (= :gravity
                       (get component :implementation-language))
                  (if (= :passed
                         (get component :conformance-status))
                    (if (= :passed
                           (get component :sh25-verification-status))
                      (sh26-nonempty-string?
                       (get component :actual-source-path))
                      false)
                    false)
                  false)
                false)
              false)
            false)
          false)
        false)
      false)
    false))

(defn sh26-components-valid-from? [components catalog index]
  (if (= index (count catalog))
    true
    (if (sh26-component-valid?
         (get components index) (get catalog index) index)
      (sh26-components-valid-from? components catalog (+ index 1))
      false)))

(defn sh26-component-identities-unique-from? [components index seen]
  (if (= index (count components))
    true
    (let [component (get components index)
          with-source
          (sh26-unique-identities-from?
           [(get component :source-id)
            (get component :output-id)]
           seen 0)]
      (if (= false with-source)
        false
        (sh26-component-identities-unique-from?
         components (+ index 1) with-source)))))

(defn sh26-components-valid? [components]
  (let [catalog (sh26-authoritative-component-catalog)]
    (if (vector? components)
      (if (= 43 (count components))
        (if (sh26-components-valid-from? components catalog 0)
          (sh26-component-identities-unique-from?
           components 0 [])
          false)
        false)
      false)))

(defn sh26-sh25-template-match? [component template]
  (if (= (get component :component-id)
         (get template :component-id))
    (if (= (get component :source-id)
           (get template :source-id))
      (if (= (get component :output-id)
             (get template :output-id))
        (if (= (get component :topological-ordinal)
               (get template :topological-ordinal))
          (if (= (get component :dependencies)
                 (get template :dependencies))
            (if (= (get component :profile)
                   (get template :profile))
              (if (= (get component :implementation-language)
                     (get template :implementation-language))
                (if (= :pending
                       (get template :conformance-status))
                  (= :pending
                     (get template :sh25-verification-status))
                  false)
                false)
              false)
            false)
          false)
        false)
      false)
    false))

(defn sh26-components-match-templates-from?
  [components templates index]
  (if (= index (count components))
    true
    (if (sh26-sh25-template-match?
         (get components index) (get templates index))
      (sh26-components-match-templates-from?
       components templates (+ index 1))
      false)))

(defn sh26-sh25-action-match? [component action]
  (if
   (sh26-exact-keys?
    action
    #{:capabilities :artifact-id :dependency-components :action-id
      :complete-output-records :source-identity :status :effects
      :content-id :authenticated-input :component-id :executor
      :profile})
    (if (= (get component :component-id)
           (get action :component-id))
      (if (= (get component :output-id)
             (get action :content-id))
        (if (= (get component :source-id)
               (get (get action :source-identity) :content-hash))
          (if (= (get component :dependencies)
                 (get action :dependency-components))
            (if (= :bound-supplied-product (get action :status))
              (if (= :gravity-sh24-driver (get action :executor))
                (if (= #{} (get action :effects))
                  (= #{} (get action :capabilities))
                  false)
                false)
              false)
            false)
          false)
        false)
      false)
    false))

(defn sh26-actions-match-from? [components actions index]
  (if (= index (count components))
    true
    (if (sh26-sh25-action-match?
         (get components index) (get actions index))
      (sh26-actions-match-from? components actions (+ index 1))
      false)))

(defn sh26-sh25-expected-actions-from?
  [components index result]
  (if (= index (count components))
    result
    (let [component (get components index)
          product (get component :build-product)]
      (sh26-sh25-expected-actions-from?
       components (+ index 1)
       (conj
        result
        {:action-id
         (str "sh25:compile:" (get component :component-id))
         :executor :gravity-sh24-driver
         :component-id (get component :component-id)
         :source-identity (get component :source-identity)
         :authenticated-input (get component :authenticated-input)
         :dependency-components (get component :dependencies)
         :artifact-id (get product :artifact-id)
         :content-id (get product :content-id)
         :complete-output-records (get product :records)
         :profile :meta
         :effects #{}
         :capabilities #{}
         :status :bound-supplied-product})))))

(defn sh26-sh25-request-valid? [request]
  (if
   (sh26-exact-keys?
    request
    #{:capabilities :recipe :sh24-driver :schema-version :build-id
      :physical-provenance :components :sh22-standard-library
      :effects :environment :artifact :profile :lock
      :sh21-meta-legality})
    (if (= :gravity/sh25-component-build-request
           (get request :artifact))
      (if (= 1 (get request :schema-version))
        (if (keyword? (get request :build-id))
          (if (= 43 (count (get request :components)))
            (if (= :meta (get request :profile))
              (if (= #{} (get request :effects))
                (= #{} (get request :capabilities))
                false)
              false)
            false)
          false)
        false)
      false)
    false))

(defn sh26-sh25-identity-authenticated-input [descriptor]
  {:artifact (get descriptor :artifact)
   :schema-version (get descriptor :schema-version)
   :descriptor-id (get descriptor :descriptor-id)
   :subject (get descriptor :subject)
   :semantic-root (get descriptor :semantic-root)
   :verification (get descriptor :verification)})

(defn sh26-sh25-identity-build-product [product]
  {:artifact (get product :artifact)
   :schema-version (get product :schema-version)
   :component-id (get product :component-id)
   :compiler-id (get product :compiler-id)
   :source-content-hash (get product :source-content-hash)
   :envelope-semantic-root (get product :envelope-semantic-root)
   :legality-id (get product :legality-id)
   :artifact-id (get product :artifact-id)
   :content-id (get product :content-id)
   :records
   {:artifact (get (get product :records) :artifact)
    :manifest (get (get product :records) :manifest)
    :diagnostics (get (get product :records) :diagnostics)}
   :verification (get product :verification)})

(defn sh26-sh25-identity-component [component]
  {:component-id (get component :component-id)
   :category (get component :category)
   :dependencies (get component :dependencies)
   :source-identity (get component :source-identity)
   :authenticated-input
   (sh26-sh25-identity-authenticated-input
    (get component :authenticated-input))
   :meta-legality (get component :meta-legality)
   :build-product
   (sh26-sh25-identity-build-product
    (get component :build-product))
   :profile (get component :profile)
   :implementation-language
   (get component :implementation-language)})

(defn sh26-sh25-identity-components-from?
  [components index result]
  (if (= index (count components))
    result
    (sh26-sh25-identity-components-from?
     components (+ index 1)
     (conj result
           (sh26-sh25-identity-component
            (get components index))))))

(defn sh26-sh25-identity-prerequisite [descriptor]
  {:artifact (get descriptor :artifact)
   :schema-version (get descriptor :schema-version)
   :product-id (get descriptor :product-id)
   :source-revision (get descriptor :source-revision)
   :semantic-root (get descriptor :semantic-root)
   :verification (get descriptor :verification)})

(defn sh26-sh25-expected-identity [request]
  {:artifact :gravity/sh25-component-build-identity
   :schema-version 1
   :build-id (get request :build-id)
   :components
   (sh26-sh25-identity-components-from?
    (get request :components) 0 [])
   :sh21-meta-legality
   (sh26-sh25-identity-prerequisite
    (get request :sh21-meta-legality))
   :sh22-standard-library
   (sh26-sh25-identity-prerequisite
    (get request :sh22-standard-library))
   :sh24-driver
   (sh26-sh25-identity-prerequisite
    (get request :sh24-driver))
   :environment (get request :environment)
   :lock (get request :lock)
   :recipe (get request :recipe)
   :profile :meta
   :effects #{}
   :capabilities #{}})

(defn sh26-sh25-source-paths-from? [components index result]
  (if (= index (count components))
    result
    (sh26-sh25-source-paths-from?
     components (+ index 1)
     (conj result
           (get (get components index) :actual-source-path)))))

(defn sh26-sh25-provenance-roots-from?
  [components index result]
  (if (= index (count components))
    result
    (sh26-sh25-provenance-roots-from?
     components (+ index 1)
     (conj
      result
      {:component-id (get (get components index) :component-id)
       :provenance-root
       (get
        (get (get components index) :authenticated-input)
        :provenance-root)}))))

(defn sh26-sh25-output-provenance-from?
  [components index result]
  (if (= index (count components))
    result
    (sh26-sh25-output-provenance-from?
     components (+ index 1)
     (conj
      result
      (get
       (get
        (get (get components index) :build-product)
        :records)
       :provenance)))))

(defn sh26-sh25-expected-provenance [request]
  (let [components (get request :components)]
    {:physical (get request :physical-provenance)
     :prerequisite-source-paths
     {:sh21
      (get (get request :sh21-meta-legality) :actual-source-path)
      :sh22
      (get (get request :sh22-standard-library)
           :actual-source-path)
      :sh24
      (get (get request :sh24-driver) :actual-source-path)}
     :actual-source-paths
     (sh26-sh25-source-paths-from? components 0 [])
     :authenticated-provenance-roots
     (sh26-sh25-provenance-roots-from? components 0 [])
     :output-provenance
     (sh26-sh25-output-provenance-from? components 0 [])}))

(defn sh26-sh25-result-boundary-valid? [result]
  (if (= [] (get result :diagnostics))
    (if (= false (get result :self-hosted?))
      (if (= true (get result :clojure-seed-boundary?))
        (= [:gravity-driver-execution
            :external-sh02-envelope-recomputation
            :external-sh21-legality-recomputation
            :external-sh22-library-recomputation
            :external-sh24-driver-recomputation
            :authoritative-runtime-source-promotion
            :independent-output-validation
            :complete-sh25-exit-gate
            :seed-retirement]
           (get result :pending))
        false)
      false)
    false))

(defn sh26-sh25-result-valid? [request result]
  (if
   (sh26-exact-keys?
    result
    #{:diagnostics :sh26-component-templates :pending
      :schema-version :identity-input :actions :self-hosted?
      :request-census :build-id :status :component-count
      :provenance :artifact :clojure-seed-boundary?})
    (if (= :gravity/sh25-component-build-result
           (get result :artifact))
      (if (= 1 (get result :schema-version))
        (if (= :accepted (get result :status))
          (if (= (get request :build-id) (get result :build-id))
            (if (= 43 (get result :component-count))
              (if (= (sh26-carrier-preflight request)
                     (get result :request-census))
                (if (= (sh26-sh25-expected-identity request)
                       (get result :identity-input))
                  (if (= (sh26-sh25-expected-provenance request)
                         (get result :provenance))
                    (sh26-sh25-result-boundary-valid? result)
                    false)
                  false)
                false)
              false)
            false)
          false)
        false)
      false)
    false))

(defn sh26-sh25-verification-valid? [request result verification]
  (if
   (sh26-exact-keys?
    verification
    #{:schema-version :checks :build-id :candidate-census
      :status :component-count :artifact})
    (if (= :gravity/sh25-component-build-verification
           (get verification :artifact))
      (if (= 1 (get verification :schema-version))
        (if (= :passed (get verification :status))
          (if (= (get request :build-id)
                 (get verification :build-id))
            (if (= (get result :component-count)
                   (get verification :component-count))
              (if (= (sh26-carrier-preflight result)
                     (get verification :candidate-census))
                (= [:complete-catalog
                  :dependency-order
                  :pinned-source-revisions
                  :contextual-envelope-subjects
                  :contextual-meta-legality
                  :bound-complete-output-records
                  :bound-prerequisite-revisions
                  :path-neutral-identity
                  :physical-provenance
                  :exact-result]
                   (get verification :checks))
                false)
              false)
            false)
          false)
        false)
      false)
    false))

(defn sh26-sh25-projection-valid?
  [request verification projection]
  (if
   (sh26-exact-keys?
    projection
    #{:schema-version :verification :build-id :components
      :status :artifact})
    (if (= :gravity/sh25-sh26-component-projection
           (get projection :artifact))
      (if (= 1 (get projection :schema-version))
        (if (= :accepted (get projection :status))
          (if (= (get request :build-id)
                 (get projection :build-id))
            (= verification (get projection :verification))
            false)
          false)
        false)
      false)
    false))

(defn sh26-envelope-projection-valid?
  [projection name role value]
  (if
   (sh26-exact-keys?
    projection #{:name :role :entry-count :value})
    (if (= name (get projection :name))
      (if (= role (get projection :role))
        (if (= (count value) (get projection :entry-count))
          (= value (get projection :value))
          false)
        false)
      false)
    false))

(defn sh26-envelope-subject-valid?
  [subject name domain preimage]
  (if
   (sh26-exact-keys?
    subject #{:name :domain :preimage :observed-id})
    (if (= name (get subject :name))
      (if (= domain (get subject :domain))
        (if (= preimage (get subject :preimage))
          (sh26-nonempty-string? (get subject :observed-id))
          false)
        false)
      false)
    false))

(defn sh26-envelope-check-valid? [check subject]
  (if
   (sh26-exact-keys?
    check #{:name :domain :computed-id :observed-id})
    (if (= (get subject :name) (get check :name))
      (if (= (get subject :domain) (get check :domain))
        (if (= (get subject :observed-id)
               (get check :observed-id))
          (= (get check :computed-id)
             (get check :observed-id))
          false)
        false)
      false)
    false))

(defn sh26-envelope-checks-valid? [checks subjects index]
  (if (= index (count subjects))
    (= index (count checks))
    (if (sh26-envelope-check-valid?
         (get checks index) (get subjects index))
      (sh26-envelope-checks-valid?
       checks subjects (+ index 1))
      false)))

(defn sh26-envelope-descriptor-valid?
  [descriptor request result verification projection
   request-id result-id verification-id projection-id
   provenance-root]
  (if
   (sh26-exact-keys?
    descriptor
    #{:artifact :schema-version :stage :artifact-kind
      :source-revision :projection-contract :semantic-projections
      :fact-transitions :effect-capability-relation :proof-composite
      :preservation :identity-subjects :lineage :reference-closure
      :actual-path-provenance :bounds})
    (let [contract (get descriptor :projection-contract)
          projections (get descriptor :semantic-projections)
          subjects (get descriptor :identity-subjects)
          context
          {:sh25-request-id request-id
           :complete-result-id result-id
           :verification-id verification-id
           :projection-id projection-id
           :provenance-root provenance-root}]
      (if (= :gravity/private-authenticated-envelope-descriptor
             (get descriptor :artifact))
        (if (= 1 (get descriptor :schema-version))
          (if (= :sh26-stage-rebuild (get descriptor :stage))
            (if (= :gravity/sh26-sh25-complete-context
                   (get descriptor :artifact-kind))
              (if
               (sh26-exact-keys?
                (get descriptor :source-revision)
                #{:owner :source-language :logical-source-path
                  :source-content-hash :source-byte-count
                  :plan-semantic-hash :functions-semantic-hash
                  :builder-function :builder-semantic-hash
                  :function-shapes})
                (if (= :sh-stage-rebuild
                       (get (get descriptor :source-revision) :owner))
                  (if (= :gravity
                         (get
                          (get descriptor :source-revision)
                          :source-language))
                    (if (= 'sh26-build-next-stage
                           (get
                            (get descriptor :source-revision)
                            :builder-function))
                      (if
                       (sh26-exact-keys?
                        contract
                        #{:contract-kind :contract-version :profile
                          :target :required-semantic-projections
                          :required-fact-families
                          :required-identity-subjects})
                        (if
                         (= :gravity/sh26-sh25-complete-context-contract
                            (get contract :contract-kind))
                          (if (= 1 (get contract :contract-version))
                            (if (= :meta (get contract :profile))
                              (if (= :jvm (get contract :target))
                                (if (= 4 (count projections))
                                  (if
                                   (sh26-envelope-projection-valid?
                                    (get projections 0)
                                    :sh25-request :exact-request
                                    {:content-id request-id})
                                    (if
                                     (sh26-envelope-projection-valid?
                                      (get projections 1)
                                      :sh25-result :exact-result
                                      {:content-id result-id})
                                      (if
                                       (sh26-envelope-projection-valid?
                                        (get projections 2)
                                        :sh25-verification
                                        :fresh-verification
                                        {:content-id verification-id})
                                        (if
                                         (sh26-envelope-projection-valid?
                                          (get projections 3)
                                          :sh25-projection
                                          :final-projection
                                          {:content-id projection-id})
                                          (if (= 5 (count subjects))
                                            (if
                                             (sh26-envelope-subject-valid?
                                              (get subjects 0)
                                              :sh25-request
                                              :gravity/sh26-sh25-request-v1
                                              {:content-id request-id})
                                              (if
                                               (sh26-envelope-subject-valid?
                                                (get subjects 1)
                                                :sh25-result
                                                :gravity/sh26-sh25-result-v1
                                                {:content-id result-id})
                                                (if
                                                 (sh26-envelope-subject-valid?
                                                  (get subjects 2)
                                                  :sh25-verification
                                                  :gravity/sh26-sh25-verification-v1
                                                  {:content-id
                                                   verification-id})
                                                  (if
                                                   (sh26-envelope-subject-valid?
                                                    (get subjects 3)
                                                    :sh25-projection
                                                    :gravity/sh26-sh25-projection-v1
                                                    {:content-id
                                                     projection-id})
                                                    (sh26-envelope-subject-valid?
                                                     (get subjects 4)
                                                     :sh25-complete-context
                                                     :gravity/sh26-sh25-complete-context-v1
                                                     context)
                                                    false)
                                                  false)
                                                false)
                                              false)
                                            false)
                                          false)
                                        false)
                                      false)
                                    false)
                                  false)
                                false)
                              false)
                            false)
                          false)
                        false)
                      false)
                    false)
                  false)
                false)
                  false)
                false)
              false)
            false)
          false)
        false))

(defn sh26-template-replay-valid? [replay]
  (if
   (sh26-exact-keys?
    replay
    #{:status :artifact-template :digest-graph-root
      :digest-graph-roots :semantic-envelope-root
      :provenance-binding-root :identity-checks
      :identity-enforcement :eligible-for-contextual-acceptance?
      :request-count :semantic-authority :checks :diagnostics})
    (if (= :template-replay-passed (get replay :status))
      (if (= :pending-host-resolution
             (get replay :identity-enforcement))
        (if (= false
               (get replay :eligible-for-contextual-acceptance?))
          (if (= :gravity-source (get replay :semantic-authority))
            (if (= [] (get replay :diagnostics))
              (= [:fresh-descriptor-replay
                  :exact-artifact-template-replay
                  :exact-digest-request-replay
                  :path-neutral-semantic-root
                  :separate-physical-provenance-root]
                 (get replay :checks))
              false)
            false)
          false)
        false)
      false)
    false))

(defn sh26-envelope-authority-valid? [authority]
  (if
   (sh26-exact-keys?
    authority
    #{:host-role :physical-provenance-separate? :scope
      :self-hosted? :semantic-owner
      :semantic-root-path-neutral?})
    (if (= :bounded-validation-hashing-and-instantiation
           (get authority :host-role))
      (if (= true
             (get authority :physical-provenance-separate?))
        (if (= :reusable-authenticated-envelope
               (get authority :scope))
          (if (= false (get authority :self-hosted?))
            (if (= :gravity-source
                   (get authority :semantic-owner))
              (= true
                 (get authority :semantic-root-path-neutral?))
              false)
            false)
          false)
        false)
      false)
    false))

(defn sh26-digest-request-contract []

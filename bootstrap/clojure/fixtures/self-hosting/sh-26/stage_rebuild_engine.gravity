   {:arity 1 :params ['value]}
   'ae-sha256-vector?
   {:arity 1 :params ['values]}
   'ae-sort-ordinals
   {:arity 2 :params ['values 'result]}
   'ae-source-revision-valid?
   {:arity 1 :params ['revision]}
   'ae-value-entry-count
   {:arity 1 :params ['value]}
   'ae-vector-contains?
   {:arity 2 :params ['values 'value]}
   'authenticated-envelope-build-template
   {:arity 1 :params ['descriptor]}
   'authenticated-envelope-verify-template
   {:arity 3
    :params ['descriptor 'artifact-template 'digest-requests]}})

(defn sh26-envelope-function-shapes-valid? [shapes]
  (= (sh26-envelope-function-shapes) shapes))

(defn sh26-envelope-source-valid? [source]
  (if
   (sh26-exact-keys?
    source
    #{:owner :source-language :logical-source-path
      :source-content-hash :source-byte-count :plan-semantic-hash
      :functions-semantic-hash :builder-function
      :builder-semantic-hash :function-shapes})
    (if (= :sh-envelope (get source :owner))
      (if (= :gravity (get source :source-language))
        (if (= "gravity/compiler/authenticated-envelope"
               (get source :logical-source-path))
          (if (= 'authenticated-envelope-build-template
                 (get source :builder-function))
            (if (= "sha256:04470b93d923611108df2c5167d72b27b5c444fe00052fa1c69bfec9e44f9c71"
                   (get source :source-content-hash))
              (if (= 59495 (get source :source-byte-count))
                (if (= "sha256:125e012806bddf996f23e357bd33309c9bbd40927ce0f2c841e69b39c1740922"
                       (get source :plan-semantic-hash))
                  (if (= "sha256:e88f53c2994f5d8d4577f6df9f6531a750c2808ef0a2b4b5d297f64e7b45e26e"
                         (get source :functions-semantic-hash))
                    (if (= "sha256:19b21ed1e94563631c25b502f5297fa1e33070f0a62fefc480bcba5984b02a7a"
                           (get source :builder-semantic-hash))
                      (sh26-envelope-function-shapes-valid?
                       (get source :function-shapes))
                      false)
                    false)
                  false)
                false)
              false)
            false)
          false)
        false)
      false)
    false))

(defn sh26-envelope-revision-pin-valid? [pin source]
  (if
   (sh26-exact-keys?
    pin
    #{:artifact :schema-version :source-revision
      :verifier-function :verifier-semantic-hash})
    (if (= :gravity/sh26-envelope-revision-pin
           (get pin :artifact))
      (if (= 1 (get pin :schema-version))
        (if (= source (get pin :source-revision))
          (if (= 'authenticated-envelope-verify-template
                 (get pin :verifier-function))
            (= "sha256:e52b201a81ef82f857aaabc68cb2d6a8f0f4505f853c555816023f5dad294a77"
               (get pin :verifier-semantic-hash))
            false)
          false)
        false)
      false)
    false))

(defn sh26-envelope-contract-valid? [contract]
  (if
   (sh26-exact-keys?
    contract
    #{:contract-kind :contract-version :profile :target
      :required-semantic-projections :required-fact-families
      :required-identity-subjects})
    (if (= :gravity/sh26-sh25-complete-context-contract
           (get contract :contract-kind))
      (if (= 1 (get contract :contract-version))
        (if (= :meta (get contract :profile))
          (if (= :jvm (get contract :target))
            (if (= [:sh25-request :sh25-result
                    :sh25-verification :sh25-projection]
                   (get contract
                        :required-semantic-projections))
              (if (= [:type :effect :ownership :capability :safety]
                     (get contract :required-fact-families))
                (= [:sh25-request :sh25-result
                    :sh25-verification :sh25-projection
                    :sh25-complete-context]
                   (get contract :required-identity-subjects))
                false)
              false)
            false)
          false)
        false)
      false)
    false))

(defn sh26-envelope-descriptor-valid2?
  [descriptor request result verification projection
   request-id result-id verification-id projection-id
   provenance-root]
  (let [projections (get descriptor :semantic-projections)
        subjects (get descriptor :identity-subjects)
        context
        {:sh25-request-id request-id
         :complete-result-id result-id
         :verification-id verification-id
         :projection-id projection-id
         :provenance-root provenance-root}]
    (if
     (sh26-exact-keys?
      descriptor
      #{:artifact :schema-version :stage :artifact-kind
        :source-revision :projection-contract :semantic-projections
        :fact-transitions :effect-capability-relation :proof-composite
        :preservation :identity-subjects :lineage
        :reference-closure :actual-path-provenance :bounds})
      (if (= :gravity/private-authenticated-envelope-descriptor
             (get descriptor :artifact))
        (if (= 1 (get descriptor :schema-version))
          (if (= :sh26-stage-rebuild (get descriptor :stage))
            (if (= :gravity/sh26-sh25-complete-context
                   (get descriptor :artifact-kind))
              (if (sh26-envelope-source-valid?
                   (get descriptor :source-revision))
                (if (sh26-envelope-contract-valid?
                     (get descriptor :projection-contract))
                  (if (= 4 (count projections))
                    (if
                     (sh26-envelope-projection-valid?
                      (get projections 0) :sh25-request
                      :exact-request {:content-id request-id})
                      (if
                       (sh26-envelope-projection-valid?
                        (get projections 1) :sh25-result
                        :exact-result {:content-id result-id})
                        (if
                         (sh26-envelope-projection-valid?
                          (get projections 2) :sh25-verification
                          :fresh-verification
                          {:content-id verification-id})
                          (if
                           (sh26-envelope-projection-valid?
                            (get projections 3) :sh25-projection
                            :final-projection
                            {:content-id projection-id})
                            (if (= 5 (count subjects))
                              (if
                               (sh26-envelope-subject-valid?
                                (get subjects 0) :sh25-request
                                :gravity/sh26-sh25-request-v1
                                {:content-id request-id})
                                (if
                                 (sh26-envelope-subject-valid?
                                  (get subjects 1) :sh25-result
                                  :gravity/sh26-sh25-result-v1
                                  {:content-id result-id})
                                  (if
                                   (sh26-envelope-subject-valid?
                                    (get subjects 2)
                                    :sh25-verification
                                    :gravity/sh26-sh25-verification-v1
                                    {:content-id verification-id})
                                    (if
                                     (sh26-envelope-subject-valid?
                                      (get subjects 3)
                                      :sh25-projection
                                      :gravity/sh26-sh25-projection-v1
                                      {:content-id projection-id})
                                      (sh26-envelope-subject-valid?
                                       (get subjects 4)
                                       :sh25-complete-context
                                       :gravity/sh26-sh25-complete-context-v1
                                       context)
                                      false)
                                    false)
                                  false)
                                false)
                              false)
                            false)
                          false)
                        false)
                      false)
                    false)
                  false)
                false)
              false)
            false)
          false)
        false)
      false)))

(defn sh26-trusted-context-valid? [trusted authentication]
  (let [descriptor (get authentication :descriptor)
        sealed (get authentication :sealed-record)
        replay (get authentication :template-replay)
        contextual
        (get authentication :contextual-verification)
        binding (get trusted :resolution-binding)
        preimage
        {:domain :gravity/sh26-coordinator-trusted-context-v1
         :resolution-binding-root
         (get trusted :resolution-binding-root)
         :descriptor-id (get trusted :descriptor-id)
         :sealed-record-id (get trusted :sealed-record-id)
         :template-replay-id (get trusted :template-replay-id)
         :contextual-verification-id
         (get trusted :contextual-verification-id)}]
    (if
     (sh26-exact-keys?
      trusted
      #{:artifact :schema-version :authority
        :resolution-binding :resolution-binding-root
        :descriptor :descriptor-id :sealed-record :sealed-record-id
        :template-replay :template-replay-id
        :contextual-verification :contextual-verification-id
        :trusted-context-preimage :trusted-context-id})
      (if (= :gravity/sh26-coordinator-trusted-context
             (get trusted :artifact))
        (if (= 1 (get trusted :schema-version))
          (if (= :coordinator-held-clojure-seed
                 (get trusted :authority))
            (if (= descriptor (get trusted :descriptor))
              (if (= sealed (get trusted :sealed-record))
                (if (= replay (get trusted :template-replay))
                  (if (= contextual
                         (get trusted :contextual-verification))
                    (if (= binding
                           (get sealed :host-resolution-binding))
                      (if (= (get binding :binding-root)
                             (get trusted
                                  :resolution-binding-root))
                        (if (= preimage
                               (get trusted
                                    :trusted-context-preimage))
                          (if
                           (sh26-nonempty-string?
                            (get trusted :descriptor-id))
                            (if
                             (sh26-nonempty-string?
                              (get trusted :sealed-record-id))
                              (if
                               (sh26-nonempty-string?
                                (get trusted
                                     :template-replay-id))
                                (if
                                 (sh26-nonempty-string?
                                  (get
                                   trusted
                                   :contextual-verification-id))
                                  (sh26-nonempty-string?
                                   (get trusted
                                        :trusted-context-id))
                                  false)
                                false)
                              false)
                            false)
                          false)
                        false)
                      false)
                    false)
                  false)
                false)
              false)
            false)
          false)
        false)
      false)))

(defn sh26-sh25-authentication-valid?
  [authentication trusted-context
   request result verification projection
   request-id result-id verification-id projection-id
   provenance-root]
  (if
   (sh26-exact-keys?
    authentication
    #{:descriptor :envelope-revision-pin
      :builder-result :sealed-record :envelope
      :template-replay :contextual-verification})
    (let [descriptor (get authentication :descriptor)
          revision-pin
          (get authentication :envelope-revision-pin)
          trusted-binding
          (get trusted-context :resolution-binding)
          trusted-root
          (get trusted-context :resolution-binding-root)
          builder (get authentication :builder-result)
          sealed (get authentication :sealed-record)
          envelope (get authentication :envelope)
          replay (get authentication :template-replay)
          contextual
          (get authentication :contextual-verification)]
      (if
       (sh26-trusted-context-valid?
        trusted-context authentication)
        (if
         (sh26-envelope-descriptor-valid2?
          descriptor request result verification projection
          request-id result-id verification-id projection-id
          provenance-root)
          (if
           (sh26-envelope-revision-pin-valid?
            revision-pin (get descriptor :source-revision))
            (if (sh26-builder-result-valid? builder)
              (if (sh26-template-replay-valid? replay)
            (if (sh26-replay-builder-bound? replay builder)
              (if (map? envelope)
            (if (= :gravity/authenticated-envelope
                   (get envelope :artifact))
              (if (= :sh26-stage-rebuild (get envelope :stage))
                (if (= :gravity/sh26-sh25-complete-context
                       (get envelope :artifact-kind))
                  (if (= false (get envelope :self-hosted?))
                    (if (= true
                           (get envelope :clojure-seed-boundary?))
                      (if (= (get envelope :semantic-envelope-id)
                             (get contextual
                                  :semantic-envelope-root))
                        (if (= (get envelope
                                    :provenance-binding-id)
                               (get contextual
                                    :provenance-binding-root))
                          (if
                           (sh26-contextual-verification-valid?
                            contextual builder replay sealed envelope
                            (get descriptor :identity-subjects))
                            (sh26-sealed-record-valid?
                             sealed trusted-binding trusted-root
                             builder envelope contextual)
                            false)
                          false)
                        false)
                      false)
                    false)
                  false)
                false)
              false)
            false)
          false)
            false)
          false)
            false)
          false)
        false))
    false))

(defn sh26-sh25-ingress-valid? [ingress trusted-context]
  (if
   (sh26-exact-keys?
    ingress
    #{:artifact :schema-version :request :complete-result
      :verification :projection :request-id :complete-result-id
      :verification-id :projection-id :sh25-provenance-root
      :authentication})
    (let [request (get ingress :request)
          result (get ingress :complete-result)
          verification (get ingress :verification)
          projection (get ingress :projection)
          components (get projection :components)
          templates (get result :sh26-component-templates)
          actions (get result :actions)]
      (if (= :gravity/sh25-complete-ingress (get ingress :artifact))
        (if (= 1 (get ingress :schema-version))
          (if (sh26-sh25-request-valid? request)
            (if (sh26-nonempty-string? (get ingress :request-id))
              (if (sh26-nonempty-string?
                   (get ingress :complete-result-id))
                (if (sh26-nonempty-string?
                     (get ingress :verification-id))
                  (if (sh26-nonempty-string?
                       (get ingress :projection-id))
                    (if (sh26-sh25-authentication-valid?
                         (get ingress :authentication)
                         trusted-context
                         request result verification projection
                         (get ingress :request-id)
                         (get ingress :complete-result-id)
                         (get ingress :verification-id)
                         (get ingress :projection-id)
                         (get ingress :sh25-provenance-root))
                      (if (sh26-sh25-result-valid? request result)
                        (if
                         (sh26-sh25-verification-valid?
                          request result verification)
                          (if
                           (sh26-sh25-projection-valid?
                            request verification projection)
                            (if (= 43 (get result :component-count))
                    (if (= 43 (count actions))
                      (if (= 43 (count templates))
                        (if (sh26-components-valid? components)
                          (if
                           (sh26-components-match-templates-from?
                            components templates 0)
                            (if
                             (sh26-actions-match-from?
                              components actions 0)
                              (= actions
                                 (sh26-sh25-expected-actions-from?
                                  (get request :components) 0 []))
                              false)
                            false)
                          false)
                        false)
                      false)
                    false)
                            false)
                          false)
                        false)
                      false)
                    false)
                  false)
                false)
              false)
            false)
          false)
        false))
    false))

(defn sh26-stage-node-valid? [node ordinal]
  (if
   (sh26-exact-keys?
    node
    #{:stage-id :ordinal :compiler-id :compiler-content-id
      :source-id :parent-compiler-id :input-stage-output-id
      :stage-output-id :transition})
    (if (keyword? (get node :stage-id))
      (if (= ordinal (get node :ordinal))
        (if (sh26-nonempty-string? (get node :compiler-id))
          (if (sh26-nonempty-string?
               (get node :compiler-content-id))
            (if (sh26-nonempty-string? (get node :source-id))
              (if (sh26-nonempty-string?
                   (get node :stage-output-id))
                (= :compiled-by-prior-stage
                   (get node :transition))
                false)
              false)
            false)
          false)
        false)
      false)
    false))

(defn sh26-value-seen-from? [values value index]
  (if (= index (count values))
    false
    (if (= value (get values index))
      true
      (sh26-value-seen-from? values value (+ index 1)))))

(defn sh26-node-identities [node]
  [(get node :stage-id)
   (get node :compiler-id)
   (get node :compiler-content-id)
   (get node :source-id)
   (get node :stage-output-id)])

(defn sh26-unique-identities-from?
  [identities seen index]
  (if (= index (count identities))
    seen
    (let [identity (get identities index)]
      (if (sh26-value-seen-from? seen identity 0)
        false
        (sh26-unique-identities-from?
         identities (conj seen identity) (+ index 1))))))

(defn sh26-lineage-identities-unique-from? [lineage index seen]
  (if (= index (count lineage))
    true
    (let [next-seen
          (sh26-unique-identities-from?
           (sh26-node-identities (get lineage index)) seen 0)]
      (if (= false next-seen)
        false
        (sh26-lineage-identities-unique-from?
         lineage (+ index 1) next-seen)))))

(defn sh26-lineage-from? [lineage index]
  (if (= index (count lineage))
    true
    (let [node (get lineage index)]
      (if (sh26-stage-node-valid? node index)
        (if (= index 0)
          (if (= nil (get node :parent-compiler-id))
            (if (= nil (get node :input-stage-output-id))
              (sh26-lineage-from? lineage (+ index 1))
              false)
            false)
          (let [parent (get lineage (- index 1))]
            (if (= (get parent :compiler-id)
                   (get node :parent-compiler-id))
              (if (= (get parent :stage-output-id)
                     (get node :input-stage-output-id))
                (sh26-lineage-from? lineage (+ index 1))
                false)
              false)))
        false))))

(defn sh26-stage-lineage-valid? [lineage]
  (if (vector? lineage)
    (if (>= (count lineage) 2)
      (if (<= (count lineage) 16)
        (if (sh26-lineage-identities-unique-from?
             lineage 0 [])
          (sh26-lineage-from? lineage 0)
          false)
        false)
      false)
    false))

(defn sh26-stage-compiler-valid? [compiler lineage sh25]
  (if
   (sh26-exact-keys?
    compiler
    #{:stage-id :compiler-id :compiler-content-id :source-id
      :lineage-terminal-stage-id :implementation-language :profile
      :sh25-request-id :sh25-complete-result-id
      :sh25-verification-id :sh25-projection-id
      :sh25-provenance-root :sh25-context-root
      :actual-compiler-path})
    (let [terminal (get lineage (- (count lineage) 1))]
      (if (= (get terminal :stage-id)
             (get compiler :lineage-terminal-stage-id))
        (if (= (get terminal :stage-id)
               (get compiler :stage-id))
          (if (= (get terminal :compiler-id)
                 (get compiler :compiler-id))
            (if (= (get terminal :compiler-content-id)
                   (get compiler :compiler-content-id))
              (if (= (get terminal :source-id)
                     (get compiler :source-id))
                (if (= :gravity
                       (get compiler :implementation-language))
                  (if (= :meta (get compiler :profile))
                    (if (= (get sh25 :request-id)
                           (get compiler :sh25-request-id))
                      (if (= (get sh25 :complete-result-id)
                             (get compiler :sh25-complete-result-id))
                        (if (= (get sh25 :verification-id)
                               (get compiler :sh25-verification-id))
                          (if (= (get sh25 :projection-id)
                                 (get compiler :sh25-projection-id))
                            (if (= (get sh25
                                        :sh25-provenance-root)
                                   (get compiler
                                        :sh25-provenance-root))
                              (if
                             (= (get
                                 (get
                                  (get sh25 :authentication)
                                  :contextual-verification)
                                 :semantic-envelope-root)
                                (get compiler :sh25-context-root))
                              (sh26-nonempty-string?
                               (get compiler
                                    :actual-compiler-path))
                              false)
                              false)
                            false)
                          false)
                        false)
                      false)
                    false)
                  false)
                false)
              false)
            false)
          false)
        false))
    false))

(defn sh26-pending-stream-valid? [stream artifact]
  (if
   (sh26-exact-keys?
    stream #{:artifact :schema-version :status :content-id})
    (if (= artifact (get stream :artifact))
      (if (= 1 (get stream :schema-version))
        (if (= :pending (get stream :status))
          (= nil (get stream :content-id))
          false)
        false)
      false)
    false))

(defn sh26-pending-exit-valid? [exit]
  (if
   (sh26-exact-keys?
    exit #{:artifact :schema-version :status :exit-code})
    (if (= :gravity/process-exit-status (get exit :artifact))
      (if (= 1 (get exit :schema-version))
        (if (= :pending (get exit :status))
          (= nil (get exit :exit-code))
          false)
        false)
      false)

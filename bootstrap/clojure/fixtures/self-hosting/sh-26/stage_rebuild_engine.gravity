(defn sh26-target-valid? [target]
  (if
   (sh26-exact-keys?
    target
    #{:profile :backend :target-id :runtime-id :target-hash})
    (if (= :meta (get target :profile))
      (if (= :jvm (get target :backend))
        (if (sh26-nonempty-string? (get target :target-id))
          (if (sh26-nonempty-string? (get target :runtime-id))
            (sh26-nonempty-string? (get target :target-hash))
            false)
          false)
        false)
      false)
    false))

(defn sh26-output-identity-distinct?
  [output-id lineage components]
  (let [lineage-identities
        (loop [index 0 result []]
          (if (= index (count lineage))
            result
            (recur
             (+ index 1)
             (conj
              result
              (get (get lineage index) :stage-output-id)))))
        component-output-identities
        (loop [index 0 result []]
          (if (= index (count components))
            result
            (recur
             (+ index 1)
             (conj
              result
              (get (get components index) :output-id)))))]
    (if (sh26-value-seen-from?
         lineage-identities output-id 0)
      false
      (if (sh26-value-seen-from?
           component-output-identities output-id 0)
        false
        true))))

(defn sh26-toolchain-valid? [toolchain compiler target]
  (if
   (sh26-exact-keys?
    toolchain #{:toolchain-id :family :version :target})
    (if (= (get compiler :compiler-id)
           (get toolchain :toolchain-id))
      (if (= :gravity (get toolchain :family))
        (if (sh26-nonempty-string? (get toolchain :version))
          (= (get target :target-id) (get toolchain :target))
          false)
        false)
      false)
    false))

(defn sh26-build-logs-valid? [logs]
  (if
   (sh26-exact-keys?
    logs #{:stdout :stderr :exit :action-count :execution-status})
    (if (= 43 (get logs :action-count))
      (if (= :pending (get logs :execution-status))
        (if
         (sh26-pending-stream-valid?
          (get logs :stdout) :gravity/process-stdout)
          (if
           (sh26-pending-stream-valid?
            (get logs :stderr) :gravity/process-stderr)
            (sh26-pending-exit-valid? (get logs :exit))
            false)
          false)
        false)
      false)
    false))

(defn sh26-conformance-valid? [conformance]
  (if
   (sh26-exact-keys?
    conformance
    #{:catalog-status :lineage-status :environment-status
      :output-status :execution-status})
    (if (= :passed (get conformance :catalog-status))
      (if (= :passed (get conformance :lineage-status))
        (if (= :passed (get conformance :environment-status))
          (if (= :pending (get conformance :output-status))
            (= :pending (get conformance :execution-status))
            false)
          false)
        false)
      false)
    false))

(defn sh26-evidence-valid?
  [evidence environment compiler lock target]
  (if
   (sh26-exact-keys?
    evidence
    #{:source-hash :compiler-hash :lock-hash :target-hash
      :output-hash :environment :toolchain :build-logs
      :conformance})
    (if (= (get compiler :source-id)
           (get evidence :source-hash))
      (if (= (get compiler :compiler-content-id)
             (get evidence :compiler-hash))
        (if (= (get lock :content-id)
               (get evidence :lock-hash))
          (if (= (get target :target-hash)
                 (get evidence :target-hash))
            (if (sh26-nonempty-string? (get evidence :output-hash))
              (if (= environment (get evidence :environment))
                (if
                 (sh26-toolchain-valid?
                  (get evidence :toolchain) compiler target)
                  (if
                   (sh26-build-logs-valid?
                    (get evidence :build-logs))
                    (sh26-conformance-valid?
                     (get evidence :conformance))
                    false)
                  false)
                false)
              false)
            false)
          false)
        false)
      false)
    false))

(defn sh26-request-error [request trusted-context]
  (if
   (sh26-exact-keys?
    request
    #{:artifact :schema-version :rebuild-id :stage-lineage
      :stage-compiler :sh25-ingress :environment :candidate-language
      :candidate-effects :candidate-capabilities :lock :recipe
      :target :rebuild-evidence :actual-rebuild-root})
    (if (= :gravity/sh26-stage-rebuild-request
           (get request :artifact))
      (if (= 2 (get request :schema-version))
        (if (keyword? (get request :rebuild-id))
          (if (sh26-stage-lineage-valid?
               (get request :stage-lineage))
            (if (sh26-sh25-ingress-valid?
                 (get request :sh25-ingress)
                 trusted-context)
              (if
               (sh26-stage-compiler-valid?
                (get request :stage-compiler)
                (get request :stage-lineage)
                (get request :sh25-ingress))
                (if (sh26-environment-valid?
                     (get request :environment))
                  (if (= :gravity
                         (get request :candidate-language))
                    (if (= #{} (get request :candidate-effects))
                      (if (= #{}
                             (get request :candidate-capabilities))
                        (if
                         (sh26-content-record-valid?
                          (get request :lock)
                          :gravity/bootstrap-lock)
                          (if
                           (sh26-content-record-valid?
                            (get request :recipe)
                            :gravity/bootstrap-recipe)
                            (if
                             (sh26-target-valid?
                              (get request :target))
                              (if
                               (sh26-evidence-valid?
                                (get request :rebuild-evidence)
                                (get request :environment)
                                (get request :stage-compiler)
                                (get request :lock)
                                (get request :target))
                                (if
                                 (sh26-output-identity-distinct?
                                  (get
                                   (get request :rebuild-evidence)
                                   :output-hash)
                                  (get request :stage-lineage)
                                  (get
                                   (get
                                    (get request :sh25-ingress)
                                    :projection)
                                   :components))
                                  (if
                                   (sh26-nonempty-string?
                                    (get request
                                         :actual-rebuild-root))
                                    nil
                                    :physical-provenance)
                                  :rebuild-evidence)
                                :rebuild-evidence)
                              :target)
                            :recipe)
                          :lock)
                        :candidate-host-authority)
                      :candidate-host-authority)
                    :candidate-host-authority)
                  :uncontrolled-environment)
                :invalid-compiler-lineage)
              :invalid-sh25-ingress)
            :invalid-compiler-lineage)
          :invalid-rebuild-request)
        :invalid-rebuild-request)
      :invalid-rebuild-request)
    :invalid-rebuild-request))

(defn sh26-rule-for-reason [reason]
  (if (= reason :uncontrolled-environment)
    "BOOT6001"
    (if (= reason :invalid-compiler-lineage)
      "BOOT6002"
      (if (= reason :candidate-host-authority)
        "BOOT3002"
        (if (if (= reason :invalid-sh25-ingress)
              true
              (= reason :invalid-trusted-context))
          "BOOT3001"
          (if (= reason :lock)
            "BOOT1005"
            (if (= reason :recipe)
              "BOOT1003"
              "BOOT1001")))))))

(defn sh26-diagnostic [request rule reason]
  {:artifact :gravity/sh26-stage-rebuild-diagnostic
   :schema-version 2
   :rule rule
   :severity :error
   :stage :bootstrap-rebuild
   :source-span
   {:source
    (if (map? request) (get request :actual-rebuild-root) nil)}
   :facts {:reason reason :fail-closed true}
   :remediation
   "Provide bounded, contextual SH-25 products and a controlled rebuild."})

(defn sh26-rejected [request reason]
  {:artifact :gravity/sh26-stage-rebuild-result
   :schema-version 2
   :status :rejected
   :diagnostics
   [(sh26-diagnostic request (sh26-rule-for-reason reason) reason)]
   :pending (get (sh26-stage-rebuild-policy) :pending)
   :self-hosted? false
   :clojure-seed-boundary? true})

(defn sh26-build-actions-from? [components index result]
  (if (= index (count components))
    result
    (let [component (get components index)]
      (sh26-build-actions-from?
       components (+ index 1)
       (conj
        result
        {:action-id
         (str "sh26:compile:" (get component :component-id))
         :executor :gravity
         :component-id (get component :component-id)
         :source-id (get component :source-id)
         :dependency-components (get component :dependencies)
         :output-id (get component :output-id)
         :topological-ordinal
         (get component :topological-ordinal)
         :effects #{}
         :capabilities #{}
         :execution-status :pending})))))

(defn sh26-identity-components-from? [components index result]
  (if (= index (count components))
    result
    (let [component (get components index)]
      (sh26-identity-components-from?
       components (+ index 1)
       (conj
        result
        {:component-id (get component :component-id)
         :source-id (get component :source-id)
         :output-id (get component :output-id)
         :topological-ordinal
         (get component :topological-ordinal)
         :dependencies (get component :dependencies)
         :profile (get component :profile)
         :implementation-language
         (get component :implementation-language)})))))

(defn sh26-component-paths-from? [components index result]
  (if (= index (count components))
    result
    (let [component (get components index)]
      (sh26-component-paths-from?
       components (+ index 1)
       (conj
        result
        {:component-id (get component :component-id)
         :actual-source-path
         (get component :actual-source-path)})))))

(defn sh26-build-accepted [request census trusted-context]
  (let [ingress (get request :sh25-ingress)
        components (get (get ingress :projection) :components)
        compiler (get request :stage-compiler)
        evidence (get request :rebuild-evidence)
        actions (sh26-build-actions-from? components 0 [])
        output-ids
        (loop [index 0 result []]
          (if (= index (count components))
            result
            (recur (+ index 1)
                   (conj result
                         (get (get components index) :output-id)))))]
    {:artifact :gravity/sh26-stage-rebuild-result
     :schema-version 2
     :status :accepted
     :rebuild-id (get request :rebuild-id)
     :trusted-context-id
     (get trusted-context :trusted-context-id)
     :prior-stage-lineage (get request :stage-lineage)
     :stage-transition
     {:semantics :compiled-by-prior-stage
      :from-stage-id (get compiler :stage-id)
      :from-compiler-id (get compiler :compiler-id)
      :to-stage-id :stage/n-plus-one
      :input-stage-output-id
      (get
       (get (get request :stage-lineage)
            (- (count (get request :stage-lineage)) 1))
       :stage-output-id)
      :output-stage-id (get evidence :output-hash)}
     :actions actions
     :stage-manifest
     {:artifact :gravity/sh26-stage-manifest
      :schema-version 1
      :rebuild-id (get request :rebuild-id)
      :source-hash (get evidence :source-hash)
      :compiler-hash (get evidence :compiler-hash)
      :lock-hash (get evidence :lock-hash)
      :target-hash (get evidence :target-hash)
      :output-hash (get evidence :output-hash)
      :component-output-ids output-ids
      :environment (get evidence :environment)
      :toolchain (get evidence :toolchain)
      :build-logs (get evidence :build-logs)
      :conformance (get evidence :conformance)}
     :rebuild-record
     {:artifact :gravity/sh26-rebuild-record
      :schema-version 1
      :sh25-request-id (get ingress :request-id)
      :sh25-complete-result-id (get ingress :complete-result-id)
      :sh25-verification-id (get ingress :verification-id)
      :sh25-projection-id (get ingress :projection-id)
      :sh25-provenance-root (get ingress :sh25-provenance-root)
      :sh25-context-root
      (get
       (get (get ingress :authentication)
            :contextual-verification)
       :semantic-envelope-root)
      :trusted-context-id
      (get trusted-context :trusted-context-id)
      :component-count 43
      :execution-status :pending
      :candidate-language :gravity
      :effects #{}
      :capabilities #{}}
     :identity-input
     {:rebuild-id (get request :rebuild-id)
      :stage-lineage (get request :stage-lineage)
      :compiler-id (get compiler :compiler-id)
      :compiler-content-id (get compiler :compiler-content-id)
      :sh25-request-id (get ingress :request-id)
      :sh25-complete-result-id (get ingress :complete-result-id)
      :sh25-verification-id (get ingress :verification-id)
      :sh25-projection-id (get ingress :projection-id)
      :sh25-provenance-root (get ingress :sh25-provenance-root)
      :sh25-context-root
      (get
       (get (get ingress :authentication)
            :contextual-verification)
       :semantic-envelope-root)
      :components
      (sh26-identity-components-from? components 0 [])
      :environment (get request :environment)
      :lock (get request :lock)
      :recipe (get request :recipe)
      :target (get request :target)
      :output-hash (get evidence :output-hash)}
     :provenance
     {:actual-rebuild-root (get request :actual-rebuild-root)
      :actual-stage-compiler-path
      (get compiler :actual-compiler-path)
      :sh25-provenance-root
      (get ingress :sh25-provenance-root)
      :sh02-envelope-provenance-root
      (get
       (get (get ingress :authentication)
            :contextual-verification)
       :provenance-binding-root)
      :component-sources
      (sh26-component-paths-from? components 0 [])}
     :request-census census
     :diagnostics []
     :pending (get (sh26-stage-rebuild-policy) :pending)
     :self-hosted? false
     :clojure-seed-boundary? true}))

(defn sh26-build-next-stage [request trusted-context]
  (let [preflight (sh26-carrier-preflight request)
        trusted-preflight
        (sh26-carrier-preflight trusted-context)]
    (if (= :accepted (get preflight :status))
      (if (= :accepted (get trusted-preflight :status))
        (let [reason
              (sh26-request-error request trusted-context)]
          (if (= nil reason)
            (sh26-build-accepted
             request preflight trusted-context)
            (sh26-rejected request reason)))
        (sh26-rejected request :invalid-trusted-context))
      (sh26-rejected request (get preflight :reason)))))

(defn sh26-verify-stage-rebuild
  [request trusted-context candidate]
  (let [request-preflight (sh26-carrier-preflight request)
        trusted-preflight
        (sh26-carrier-preflight trusted-context)
        candidate-preflight (sh26-carrier-preflight candidate)]
    (if (= :accepted (get request-preflight :status))
      (if (= :accepted (get trusted-preflight :status))
        (if (= :accepted (get candidate-preflight :status))
          (let [expected
                (sh26-build-next-stage request trusted-context)]
            (if (= expected candidate)
            {:artifact :gravity/sh26-stage-rebuild-verification
             :schema-version 2
             :status :passed
             :rebuild-id (get request :rebuild-id)
             :trusted-context-id
             (get trusted-context :trusted-context-id)
             :candidate-census candidate-preflight
             :checks
             [:bounded-request-carrier
              :bounded-candidate-carrier
              :exact-sh25-complete-result
              :exact-sh25-verification
              :exact-sh25-projection
              :complete-43-component-catalog
              :component-source-output-binding
              :acyclic-stage-lineage
              :stage-transition-semantics
              :complete-physical-provenance
              :manifest-and-rebuild-record
              :exact-result]}
              {:artifact :gravity/sh26-stage-rebuild-verification
               :schema-version 2
               :status :rejected
               :diagnostics
               [(sh26-diagnostic
                 request "BOOT3001"
                 :stage-rebuild-result-altered)]}))
          {:artifact :gravity/sh26-stage-rebuild-verification
           :schema-version 2
           :status :rejected
           :diagnostics
           [(sh26-diagnostic
             request "BOOT3001"
             (get candidate-preflight :reason))]})
        {:artifact :gravity/sh26-stage-rebuild-verification
         :schema-version 2
         :status :rejected
         :diagnostics
         [(sh26-diagnostic
           request "BOOT3001" :invalid-trusted-context)]})
      {:artifact :gravity/sh26-stage-rebuild-verification
       :schema-version 2
       :status :rejected
       :diagnostics
       [(sh26-diagnostic
         request "BOOT1001" (get request-preflight :reason))]})))

(defn sh26-digest-ref-map? [value]
  (if (sh26-exact-keys? value #{:digest-ref})
    (let [ordinal (get value :digest-ref)]
      (if (integer? ordinal) (>= ordinal 0) false))
    false))

(defn sh26-collect-digest-refs [value result]
  (if (sh26-digest-ref-map? value)
    (conj result (get value :digest-ref))
    (if (map? value)
      (let [map-keys (vec (keys value))]
        (loop [index 0 observed result]
          (if (= index (count map-keys))
            observed
            (let [map-key (get map-keys index)]
              (recur
               (+ index 1)
               (sh26-collect-digest-refs
                (get value map-key)
                (sh26-collect-digest-refs map-key observed)))))))
      (if (vector? value)
        (loop [index 0 observed result]
          (if (= index (count value))
            observed
            (recur
             (+ index 1)
             (sh26-collect-digest-refs
              (get value index) observed))))
        (if (set? value)
          (let [values (vec value)]
            (loop [index 0 observed result]
              (if (= index (count values))
                observed
                (recur
                 (+ index 1)
                 (sh26-collect-digest-refs
                  (get values index) observed)))))
          result)))))

(defn sh26-digest-request-valid?
  [request ordinal purpose dependencies]
  (if
   (sh26-exact-keys?
    request
    #{:algorithm :depends-on :encoding :key :ordinal :preimage})
    (if (= :sha256 (get request :algorithm))
      (if (= :gravity/canonical-edn-v1 (get request :encoding))
        (if (= ordinal (get request :key))
          (if (= ordinal (get request :ordinal))
            (if (= dependencies (get request :depends-on))
              (if (map? (get request :preimage))
                (if (= purpose
                       (get (get request :preimage) :domain))
                  (= (set dependencies)
                     (sh26-collect-digest-refs
                      (get request :preimage) #{}))
                  false)
                false)
              false)
            false)
          false)
        false)
      false)
    false))

(defn sh26-digest-requests-valid-from?
  [requests contract index]
  (if (= index (count contract))
    true
    (let [expected (get contract index)]
      (if
       (sh26-digest-request-valid?
        (get requests index) index
        (first expected) (second expected))
        (sh26-digest-requests-valid-from?
         requests contract (+ index 1))
        false))))

(defn sh26-digest-requests-valid? [requests]
  (let [contract (sh26-digest-request-contract)]
    (if (vector? requests)
      (if (= (count contract) (count requests))
        (sh26-digest-requests-valid-from?
         requests contract 0)
        false)
      false)))

(defn sh26-builder-result-valid? [builder]
  (if
   (sh26-exact-keys?
    builder
    #{:digest-graph-root :semantic-envelope-root :diagnostics
      :digest-requests :authority :status :digest-graph-roots
      :provenance-binding-root :artifact-template
      :identity-checks})
    (if (= :accepted (get builder :status))
      (if (= [] (get builder :diagnostics))
        (if (sh26-envelope-authority-valid?
             (get builder :authority))
          (if (sh26-digest-requests-valid?
               (get builder :digest-requests))
            (if (= 47 (count (get builder :digest-requests)))
              (if (<= (count (get builder :digest-requests)) 2048)
                (if (= 2 (count (get builder :digest-graph-roots)))
                  (if (= (get builder :digest-graph-root)
                         (get builder :semantic-envelope-root)
                         (first (get builder :digest-graph-roots)))
                    (= (get builder :provenance-binding-root)
                       (second (get builder :digest-graph-roots)))
                    false)
                  false)
                false)
              false)
            false)
          false)
        false)
      false)
    false))

(defn sh26-replay-builder-bound? [replay builder]
  (if (= (get builder :artifact-template)
         (get replay :artifact-template))
    (if (= (get builder :digest-graph-root)
           (get replay :digest-graph-root))
      (if (= (get builder :digest-graph-roots)
             (get replay :digest-graph-roots))
        (if (= (get builder :semantic-envelope-root)
               (get replay :semantic-envelope-root))
          (if (= (get builder :provenance-binding-root)
                 (get replay :provenance-binding-root))
            (if (= (get builder :identity-checks)
                   (get replay :identity-checks))
              (= (count (get builder :digest-requests))
                 (get replay :request-count))
              false)
            false)
          false)
        false)
      false)
    false))

(defn sh26-resolution-pairs-valid-from?
  [pairs requests resolved contract index]
  (if (= index (count contract))
    true
    (let [pair (get pairs index)
          expected (get contract index)]
      (if
       (sh26-exact-keys?
        pair #{:ordinal :purpose :request :resolved-digest})
        (if (= index (get pair :ordinal))
          (if (= (first expected) (get pair :purpose))
            (if (= (get requests index)
                   (get pair :request))
              (if (= (get resolved index)
                     (get pair :resolved-digest))
                (if (sh26-nonempty-string?
                     (get pair :resolved-digest))
                  (sh26-resolution-pairs-valid-from?
                   pairs requests resolved contract (+ index 1))
                  false)
                false)
              false)
            false)
          false)
        false))))

(defn sh26-host-resolution-binding-valid?
  [binding trusted-binding trusted-root requests resolved]
  (let [contract (sh26-digest-request-contract)
        pairs (get binding :request-resolved-pairs)
        expected-preimage
        {:domain :gravity/sh26-host-digest-resolution-binding-v1
         :request-count 47
         :request-resolved-pairs pairs}]
    (if
     (sh26-exact-keys?
      binding
      #{:artifact :schema-version :boundary :request-count
        :request-resolved-pairs :binding-preimage :binding-root})
      (if (= :gravity/sh26-host-digest-resolution-binding
             (get binding :artifact))
        (if (= binding trusted-binding)
          (if (= 1 (get binding :schema-version))
            (if (= :trusted-clojure-seed (get binding :boundary))
              (if (= 47 (get binding :request-count))
                (if (vector? pairs)
                  (if (= 47 (count pairs))
                    (if (= expected-preimage
                           (get binding :binding-preimage))
                      (if (sh26-nonempty-string?
                           (get binding :binding-root))
                        (if (= trusted-root
                               (get binding :binding-root))
                          (sh26-resolution-pairs-valid-from?
                           pairs requests resolved contract 0)
                          false)
                        false)
                      false)
                    false)
                  false)
                false)
              false)
            false)
          false)
        false)
      false)))

(defn sh26-resolution-context-subjects-valid?
  [subjects binding sealed]
  (if
   (sh26-exact-keys?
    subjects
    #{:host-resolution-binding-root :request-count
      :semantic-envelope-root :provenance-binding-root})
    (if (= (get binding :binding-root)
           (get subjects :host-resolution-binding-root))
      (if (= 47 (get subjects :request-count))
        (if (= (get sealed :semantic-root)
               (get subjects :semantic-envelope-root))
          (= (get sealed :provenance-root)
             (get subjects :provenance-binding-root))
          false)
        false)
      false)
    false))

(defn sh26-sealed-record-valid?
  [sealed trusted-binding trusted-root builder envelope contextual]
  (if
   (sh26-exact-keys?
    sealed
    #{:resolved-digests :requests :template :roots
      :provenance-root :identity-checks :semantic-root
      :host-resolution-binding :context-subjects})
    (if (= (get builder :digest-requests)
           (get sealed :requests))
      (if (= (count (get sealed :requests))
             (count (get sealed :resolved-digests)))
        (if
         (sh26-host-resolution-binding-valid?
          (get sealed :host-resolution-binding)
          trusted-binding
          trusted-root
          (get sealed :requests)
          (get sealed :resolved-digests))
          (if
           (sh26-resolution-context-subjects-valid?
            (get sealed :context-subjects)
            (get sealed :host-resolution-binding)
            sealed)
            (if (= envelope (get sealed :template))
              (if (= 2 (count (get sealed :roots)))
                (if (= (get sealed :semantic-root)
                       (first (get sealed :roots)))
                  (if (= (get sealed :provenance-root)
                         (second (get sealed :roots)))
                    (if (= (get sealed :semantic-root)
                           (get contextual :semantic-envelope-root))
                      (if (= (get sealed :provenance-root)
                             (get contextual
                                  :provenance-binding-root))
                        (= (get sealed :identity-checks)
                           (get contextual :identity-checks))
                        false)
                      false)
                    false)
                  false)
                false)
              false)
            false)
          false)
        false)
      false)
    false))

(defn sh26-contextual-verification-valid?
  [contextual builder replay sealed envelope subjects]
  (if
   (sh26-exact-keys?
    contextual
    #{:artifact :schema-version :status :builder-result
      :template-replay :sealed-record :artifact-template
      :semantic-envelope-root :provenance-binding-root
      :identity-checks :host-resolution-binding
      :context-subjects :identity-enforcement
      :eligible-for-contextual-acceptance?
      :host-digest-resolution :identity-subject-equality
      :fresh-envelope-reconstruction})
    (if (= :gravity/sh26-envelope-contextual-verification
           (get contextual :artifact))
      (if (= 1 (get contextual :schema-version))
        (if (= :contextual-verification-passed
               (get contextual :status))
          (if (= builder (get contextual :builder-result))
            (if (= replay (get contextual :template-replay))
              (if (= sealed (get contextual :sealed-record))
                (if (= (get sealed :host-resolution-binding)
                       (get contextual
                            :host-resolution-binding))
                  (if (= (get sealed :context-subjects)
                         (get contextual :context-subjects))
                    (if (= envelope
                           (get contextual :artifact-template))
                      (if (= :passed
                             (get contextual
                                  :identity-enforcement))
                        (if (= true
                               (get
                                contextual
                                :eligible-for-contextual-acceptance?))
                          (if (= :passed
                                 (get
                                  contextual
                                  :host-digest-resolution))
                            (if (= :passed
                                   (get
                                    contextual
                                    :identity-subject-equality))
                              (if (= :passed
                                     (get
                                      contextual
                                      :fresh-envelope-reconstruction))
                                (sh26-envelope-checks-valid?
                                 (get contextual :identity-checks)
                                 subjects 0)
                                false)
                              false)
                            false)
                          false)
                        false)
                      false)
                    false)
                  false)
                false)
              false)
            false)
          false)
        false)
      false)
    false))


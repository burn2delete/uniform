; SH-07-B4 loop initializers see only earlier bindings.
(ns self-hosting.sh07-b4.sequential-loop-bindings
  (:profile :meta)
  (:target :jvm)
  (:exports [sequential-loop-result])
  (:effects #{})
  (:capabilities #{})
  (:safety :safe)
  (:metadata {:slice :SH-07-B4 :fixture :sequential-loop-bindings}))

(def sequential-loop-result
  (loop [first-value 1
         second-value first-value
         third-value second-value]
    [first-value second-value third-value]))

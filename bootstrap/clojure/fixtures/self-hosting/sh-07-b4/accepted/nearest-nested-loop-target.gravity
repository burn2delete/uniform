; SH-07-B4 nested loops select the nearest lexical recur target.
(ns self-hosting.sh07-b4.nearest-nested-loop-target
  (:profile :meta)
  (:target :jvm)
  (:exports [nested-loop-result])
  (:effects #{})
  (:capabilities #{})
  (:safety :safe)
  (:metadata {:slice :SH-07-B4 :fixture :nearest-nested-loop-target}))

(def nested-loop-result
  (loop [outer 1]
    (do
      (loop [inner outer]
        (if false
          (recur inner)
          inner))
      (if false
        (recur outer)
        outer))))

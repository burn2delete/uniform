; SH-07-B4 defers variadic function recur targets.
(ns self-hosting.sh07-b4.variadic-function-recur
  (:profile :meta)
  (:target :jvm)
  (:effects #{})
  (:capabilities #{})
  (:safety :safe)
  (:metadata
   {:slice :SH-07-B4
    :fixture :variadic-function-recur
    :sh07-b4
    {:expected-rule "C6-LOWERING-GAP"
     :expected-stage :core-lowering
     :expected-severity :error
     :expected-reason :variadic-function-recur-deferred
     :expected-remediation
     "Use only the declared SH-07-B4 fixed-arity fn, simple-symbol sequential loop, tail recur, and previously supported core subset."}}))

(defn invalid-function [first-value & rest-values]
  (recur first-value rest-values))

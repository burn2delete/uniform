; SH-07-B4 defers loop destructuring.
(ns self-hosting.sh07-b4.loop-destructuring
  (:profile :meta)
  (:target :jvm)
  (:effects #{})
  (:capabilities #{})
  (:safety :safe)
  (:metadata
   {:slice :SH-07-B4
    :fixture :loop-destructuring
    :sh07-b4
    {:expected-rule "C6-LOWERING-GAP"
     :expected-stage :core-lowering
     :expected-severity :error
     :expected-reason :loop-destructuring-deferred
     :expected-remediation
     "Use only the declared SH-07-B4 fixed-arity fn, simple-symbol sequential loop, tail recur, and previously supported core subset."}}))

(def invalid-loop
  (loop [[value] [1]]
    2))

; SH-07-B4 nested function target hides its outer loop target.
(ns self-hosting.sh07-b4.outer-loop-hidden-by-function
  (:profile :meta)
  (:target :jvm)
  (:effects #{})
  (:capabilities #{})
  (:safety :safe)
  (:metadata
   {:slice :SH-07-B4
    :fixture :outer-loop-hidden-by-function
    :sh07-b4
    {:expected-rule "C6-VERIFY"
     :expected-stage :core-lowering
     :expected-severity :error
     :expected-reason :recur-arity-mismatch
     :expected-semantic-rule "L2-RECUR-TARGET"
     :expected-remediation
     "Place recur in tail position inside the nearest loop or fixed-arity function target and pass exactly the target arity."}}))

(def invalid-loop
  (loop [outer 1]
    (fn []
      (recur outer))))

; SH-07-B4 rejects an odd loop binding vector.
(ns self-hosting.sh07-b4.odd-loop-bindings
  (:profile :meta)
  (:target :jvm)
  (:effects #{})
  (:capabilities #{})
  (:safety :safe)
  (:metadata
   {:slice :SH-07-B4
    :fixture :odd-loop-bindings
    :sh07-b4
    {:expected-rule "C6-CORE-SHAPE"
     :expected-stage :core-lowering
     :expected-severity :error
     :expected-reason :loop-bindings-even-required
     :expected-remediation
     "Provide a bounded, delimiter-linked SH-06 form graph with exact core-form shape."}}))

(def invalid-loop
  (loop [value 1 trailing] value))

; SH-07-B4 rejects recur without a lexical target.
(ns self-hosting.sh07-b4.recur-without-target
  (:profile :meta)
  (:target :jvm)
  (:effects #{})
  (:capabilities #{})
  (:safety :safe)
  (:metadata
   {:slice :SH-07-B4
    :fixture :recur-without-target
    :sh07-b4
    {:expected-rule "C6-VERIFY"
     :expected-stage :core-lowering
     :expected-severity :error
     :expected-reason :recur-target-required
     :expected-semantic-rule "L2-RECUR-TARGET"
     :expected-remediation
     "Place recur in tail position inside the nearest loop or fixed-arity function target and pass exactly the target arity."}}))

(def invalid-recur
  (recur 1))

; SH-07-B15 rejects keyword lookup forms with more than one operand.
(ns self-hosting.sh07-b15.reject.keyword-lookup-over-arity
  (:profile :meta)
  (:target :jvm)
  (:effects #{})
  (:capabilities #{})
  (:safety :safe)
  (:metadata
   {:slice :SH-07-B15
    :case :keyword-lookup-over-arity
    :governing-contracts ["L2" "C6"]
    :sh07-b15
    {:expected-rule "C6-CORE-SHAPE"
     :expected-stage :core-lowering
     :expected-severity :error
     :expected-reason :keyword-map-lookup-arity
     :expected-actual-operand-count 3
     :expected-required-operand-count 1
     :expected-fail-closed true
     :expected-remediation
     "Provide exactly one map operand to a keyword lookup."}}))

(def contract
  {})

(def excessive-operands
  (:required-fields contract [] :extra))

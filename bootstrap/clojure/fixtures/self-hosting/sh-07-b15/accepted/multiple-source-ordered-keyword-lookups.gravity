  (:target :jvm)
  (:exports [contract contract-summary])
  (:effects #{})
  (:capabilities #{})
  (:safety :safe)
  (:metadata {:slice :SH-07-B15
              :fixture :multiple-source-ordered-keyword-lookups
              :non-claims [:keyword-default-value
                           :general-callable-keywords
                           :whole-program-execution]}))

(def contract

; SH-07-B15 lowers nested one-operand keyword map lookups.
(ns self-hosting.sh07-b15.nested-keyword-map-lookup
  (:profile :meta)
  (:target :jvm)
  (:exports [contract field-kind])
  (:effects #{})
  (:capabilities #{})
  (:safety :safe)
  (:metadata {:slice :SH-07-B15
              :fixture :nested-keyword-map-lookup
              :non-claims [:keyword-default-value
                           :general-callable-keywords
                           :whole-program-execution]}))

(def contract
  {:required-fields {:name {:kind :symbol}
                     :profile {:kind :keyword}}})

(def field-kind
  (:kind (:name (:required-fields contract))))

; SH-07-B11 keeps non-vector nested composites outside recursive vectors.
(ns self-hosting.sh07-b11.reject.nested-map-in-vector
  (:profile :meta)
  (:target :jvm)
  (:effects #{})
  (:capabilities #{})
  (:safety :safe)
  (:metadata
   {:slice :SH-07-B11
    :case :nested-map-outside-recursive-vector-slice
    :governing-contracts ["L7" "C6"]
    :sh07-b11
    {:expected-rule "C6-LOWERING-GAP"
     :expected-stage :core-lowering
     :expected-severity :error
     :expected-reason :unsupported-vector-pattern-leaf
     :expected-remediation
     "Use only nested fixed-width vectors, wildcards, scalar literals, or unique symbol bindings in SH-07-B11."}}))

(def invalid-match
  (match [1 {:kind :value}]
    [head {:kind nested}] nested
    _ nil))

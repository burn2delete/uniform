; SH-07-B11 does not claim constructor/list-pattern lowering.
(ns self-hosting.sh07-b11.reject.list-pattern-deferred
  (:profile :meta)
  (:target :jvm)
  (:effects #{})
  (:capabilities #{})
  (:safety :safe)
  (:metadata
   {:slice :SH-07-B11
    :case :list-pattern-outside-fixed-vector-slice
    :governing-contracts ["L7" "L9" "C6"]
    :sh07-b11
    {:expected-rule "C6-LOWERING-GAP"
     :expected-stage :core-lowering
     :expected-severity :error
     :expected-reason :composite-pattern-deferred
     :expected-remediation
     "Use a fixed-width vector, wildcard, supported scalar literal, or one symbol binding in SH-07-B11; defer other composite patterns to their owning slices."}}))

(def invalid-match
  (match [:ok 1]
    (Ok value) value
    _ nil))

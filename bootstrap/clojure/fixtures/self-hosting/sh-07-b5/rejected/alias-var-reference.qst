(ns demo.alias-var
  (:profile :meta)
  (:target :jvm)
  (:requires [shared.core :as shared :profile :core
              :boundary :pure-core :refer [checksum]])
  (:effects #{})
  (:capabilities #{})
  (:safety :safe)
  (:metadata
   {:slice :SH-07-B5
    :sh07-b5
    {:expected-rule "C6-LOWERING-GAP"
     :expected-stage :core-lowering
     :expected-severity :error
     :expected-reason :qualified-var-reference-deferred
     :expected-remediation
     "Use only the declared bounded SH-07 core subset; defer unsupported lowering families to their owning slices."}}))

(def invalid-var (var shared/checksum))

(ns gravity.self-hosting.sh10.runtime-borrow-conflict.accepted
  (:profile :meta)
  (:target :jvm)
  (:exports [sh10-runtime-mutable-borrow-end-reborrow-scenario
             sh10-runtime-immutable-borrow-end-scenario])
  (:effects #{})
  (:capabilities #{})
  (:safety :safe))

(defn sh10-runtime-borrow-event
  [event-id operation borrow-id destination-owner
   destination-lifetime-end escape-destination]
  {:event-id event-id
   :op operation
   :borrow-id borrow-id
   :destination-owner destination-owner
   :destination-lifetime-end destination-lifetime-end
   :escape-destination escape-destination
   :control-path :normal})

(defn sh10-runtime-borrow-scenario [scenario-id core-node-id events]
  {:artifact :gravity/sh10-runtime-checked-mutable-borrow-scenario
   :schema-version 1
   :scenario-id scenario-id
   :core-node-id core-node-id
   :initialization :uninitialized
   :owner-lifetime-end 64
   :events events})

(defn sh10-runtime-mutable-borrow-end-reborrow-scenario [core-node-id]
  (sh10-runtime-borrow-scenario
   :runtime-mutable-borrow-end-reborrow
   core-node-id
   [(sh10-runtime-borrow-event :initialize :initialize nil nil nil nil)
    (sh10-runtime-borrow-event
     :borrow-first :borrow-mutable :mutable-first nil nil nil)
    (sh10-runtime-borrow-event
     :end-first :end-borrow :mutable-first nil nil nil)
    (sh10-runtime-borrow-event
     :borrow-second :borrow-mutable :mutable-second nil nil nil)
    (sh10-runtime-borrow-event
     :end-second :end-borrow :mutable-second nil nil nil)
    (sh10-runtime-borrow-event :read :read nil nil nil nil)]))

(defn sh10-runtime-immutable-borrow-end-scenario [core-node-id]
  (sh10-runtime-borrow-scenario
   :runtime-immutable-borrow-end
   core-node-id
   [(sh10-runtime-borrow-event :initialize :initialize nil nil nil nil)
    (sh10-runtime-borrow-event
     :borrow-shared :borrow-immutable :shared-first nil nil nil)
    (sh10-runtime-borrow-event
     :end-shared :end-borrow :shared-first nil nil nil)
    (sh10-runtime-borrow-event :read-after-shared :read nil nil nil nil)]))

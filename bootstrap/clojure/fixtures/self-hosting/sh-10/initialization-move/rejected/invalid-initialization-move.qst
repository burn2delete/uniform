(ns gravity.self-hosting.sh10.initialization-move.rejected
  (:profile :meta)
  (:target :jvm)
  (:exports [sh10-authenticated-uninitialized-read-scenario
             sh10-authenticated-use-after-move-scenario
             sh10-authenticated-double-consume-scenario
             sh10-authenticated-invalid-escape-scenario])
  (:effects #{})
  (:capabilities #{})
  (:safety :safe))

(defn sh10-lifecycle-event
  [event-id operation borrow-id destination-owner
   destination-lifetime-end escape-destination]
  {:event-id event-id
   :op operation
   :borrow-id borrow-id
   :destination-owner destination-owner
   :destination-lifetime-end destination-lifetime-end
   :escape-destination escape-destination
   :control-path :normal})

(defn sh10-lifecycle-scenario
  [scenario-id core-node-id initialization events]
  {:artifact :gravity/sh10-authenticated-owned-mutable-scenario
   :schema-version 1
   :scenario-id scenario-id
   :core-node-id core-node-id
   :initialization initialization
   :owner-lifetime-end 64
   :events events})

(defn sh10-authenticated-uninitialized-read-scenario [core-node-id]
  (sh10-lifecycle-scenario
   :authenticated-uninitialized-read
   core-node-id
   :uninitialized
   [(sh10-lifecycle-event :read :read nil nil nil nil)]))

(defn sh10-authenticated-use-after-move-scenario [core-node-id]
  (sh10-lifecycle-scenario
   :authenticated-use-after-move
   core-node-id
   :uninitialized
   [(sh10-lifecycle-event :initialize :initialize nil nil nil nil)
    (sh10-lifecycle-event
     :move :move nil "authenticated-destination-owner" nil nil)
    (sh10-lifecycle-event :read-after-move :read nil nil nil nil)]))

(defn sh10-authenticated-double-consume-scenario [core-node-id]
  (sh10-lifecycle-scenario
   :authenticated-double-consume
   core-node-id
   :uninitialized
   [(sh10-lifecycle-event :initialize :initialize nil nil nil nil)
    (sh10-lifecycle-event :consume :consume nil nil nil nil)
    (sh10-lifecycle-event :consume-again :consume nil nil nil nil)]))

(defn sh10-authenticated-invalid-escape-scenario [core-node-id]
  (sh10-lifecycle-scenario
   :authenticated-invalid-escape
   core-node-id
   :uninitialized
   [(sh10-lifecycle-event :initialize :initialize nil nil nil nil)
    (sh10-lifecycle-event
     :borrow :borrow-immutable :authenticated-borrow nil nil nil)
    (sh10-lifecycle-event
     :escape :escape-borrow :authenticated-borrow nil 65
     :function-return)]))

(ns gravity.self-hosting.sh10.accepted
  (:profile :meta)
  (:target :jvm)
  (:exports [sh10-initialize-read-request
             sh10-many-immutable-request
             sh10-exclusive-mutable-request
             sh10-bounded-escape-request])
  (:effects #{})
  (:capabilities #{})
  (:safety :safe))

(defn sh10-event
  [event-id operation borrow-id destination-owner
   destination-lifetime-end escape-destination]
  {:event-id event-id
   :op operation
   :borrow-id borrow-id
   :destination-owner destination-owner
   :destination-lifetime-end destination-lifetime-end
   :escape-destination escape-destination
   :control-path :normal
   :source-span {:source "ownership-transitions.gravity"
                 :start-byte 0
                 :end-byte 1}
   :origin-chain []})

(defn sh10-request [request-id initialization events]
  {:artifact :gravity/sh10-normalized-ownership-request
   :request-id request-id
   :value-id "value-buffer"
   :owner-id "owner-local"
   :ownership-kind :owned-mutable
   :initialization initialization
   :availability :available
   :owner-lifetime-end 10
   :events events
   :type-fact-id
   "sha256:1111111111111111111111111111111111111111111111111111111111111111"
   :effect-fact-id
   "sha256:2222222222222222222222222222222222222222222222222222222222222222"
   :capability-proof-id nil
   :source-span {:source "ownership-transitions.gravity"
                 :start-byte 0
                 :end-byte 1}
   :origin-chain []
   :profile :meta
   :target :jvm})

(defn sh10-initialize-read-request []
  (sh10-request
   :initialize-read
   :uninitialized
   [(sh10-event :initialize :initialize nil nil nil nil)
    (sh10-event :read :read nil nil nil nil)]))

(defn sh10-many-immutable-request []
  (sh10-request
   :many-immutable
   :initialized
   [(sh10-event :borrow-a :borrow-immutable :borrow-a nil nil nil)
    (sh10-event :borrow-b :borrow-immutable :borrow-b nil nil nil)
    (sh10-event :read :read nil nil nil nil)
    (sh10-event :end-a :end-borrow :borrow-a nil nil nil)
    (sh10-event :end-b :end-borrow :borrow-b nil nil nil)
    (sh10-event :move :move nil "owner-destination" nil nil)]))

(defn sh10-exclusive-mutable-request []
  (sh10-request
   :exclusive-mutable
   :initialized
   [(sh10-event :borrow-mut :borrow-mutable :borrow-mut nil nil nil)
    (sh10-event :end-mut :end-borrow :borrow-mut nil nil nil)
    (sh10-event :read :read nil nil nil nil)]))

(defn sh10-bounded-escape-request []
  (sh10-request
   :bounded-escape
   :initialized
   [(sh10-event :borrow :borrow-immutable :borrow nil nil nil)
    (sh10-event :escape :escape-borrow :borrow nil 8 :function-return)
    (sh10-event :end :end-borrow :borrow nil nil nil)]))

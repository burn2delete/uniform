(ns gravity.self-hosting.sh25.component-build-engine
  (:profile :meta)
  (:target :jvm)
  (:exports [sh25-component-build-policy
             sh25-authoritative-component-catalog
             sh25-build-authoritative-components
             sh25-verify-component-build
             sh25-project-verified-sh26-components])
  (:effects #{})
  (:capabilities #{})
  (:safety :safe))

(defn sh25-nonempty-string? [value]
  (if (string? value) (> (count value) 0) false))

(defn sh25-member-from? [values value index]
  (if (= index (count values))
    false
    (if (= value (get values index))
      true
      (sh25-member-from? values value (+ index 1)))))

(defn sh25-member? [values value]
  (if (vector? values)
    (sh25-member-from? values value 0)
    false))

(defn sh25-aggregate? [value]
  (if (map? value)
    true
    (if (vector? value)
      true
      (set? value))))

(defn sh25-aggregate-width [value]
  (if (map? value)
    (* 2 (count value))
    (count value)))

(defn sh25-aggregate-components [value]
  (if (map? value)
    (let [map-keys (vec (keys value))]
      (loop [index 0 result []]
      (if (= index (count map-keys))
        result
        (recur
         (+ index 1)
         (conj
          (conj result (get map-keys index))
          (get value (get map-keys index)))))))
    (if (vector? value)
      value
      (vec value))))

(defn sh25-max [left right]
  (if (> left right) left right))

(defn sh25-scalar-units [value]
  (if (= nil value)
    3
    (if (boolean? value)
      5
      (if (string? value)
        (* 4 (count value))
        (if (char? value)
          4
          (if (keyword? value)
            64
            (if (symbol? value)
              64
              (if (integer? value)
                (if (if (>= value -9223372036854775808)
                      (<= value 9223372036854775807)
                      false)
                  20
                  -1)
                -1))))))))

(defn sh25-carrier-preflight [value]
  (loop [frontier [[value 0]]
         cursor 0
         nodes 0
         scalar-units 0
         observed-depth 0
         observed-width 0]
    (if (= cursor (count frontier))
      {:status :accepted
       :nodes nodes
       :scalar-units scalar-units
       :maximum-depth observed-depth
       :maximum-width observed-width}
      (let [entry (get frontier cursor)
            current (first entry)
            depth (second entry)
            next-nodes (+ nodes 1)]
        (if (> next-nodes 1048576)
          {:status :rejected :reason :carrier-node-bound}
          (if (> depth 128)
            {:status :rejected :reason :carrier-depth-bound}
            (if (seq? current)
              {:status :rejected :reason :carrier-sequence-unsupported}
              (if (sh25-aggregate? current)
                (let [width (sh25-aggregate-width current)]
                  (if (> width 65536)
                    {:status :rejected :reason :carrier-width-bound}
                    (let [components
                          (sh25-aggregate-components current)]
                      (if (> (+ (- (count frontier) cursor)
                                (count components))
                             1048576)
                        {:status :rejected
                         :reason :carrier-node-bound}
                        (let [next-frontier
                              (loop [index 0
                                     result frontier]
                                (if (= index (count components))
                                  result
                                  (recur
                                   (+ index 1)
                                   (conj
                                    result
                                    [(get components index)
                                     (+ depth 1)]))))]
                          (recur
                           next-frontier
                           (+ cursor 1)
                           next-nodes
                           scalar-units
                           (sh25-max observed-depth depth)
                           (sh25-max observed-width width)))))))
                (let [current-scalar-units
                      (sh25-scalar-units current)]
                  (if (< current-scalar-units 0)
                    {:status :rejected
                     :reason :carrier-scalar-type}
                    (if (> current-scalar-units 1048576)
                      {:status :rejected
                       :reason :carrier-scalar-bound}
                      (let [next-scalar-units
                            (+ scalar-units current-scalar-units)]
                        (if (> next-scalar-units 16777216)
                          {:status :rejected
                           :reason :carrier-scalar-bound}
                          (recur
                           frontier
                           (+ cursor 1)
                           next-nodes
                           next-scalar-units
                           (sh25-max observed-depth depth)
                           observed-width))))))))))))))

(defn sh25-exact-keys? [value expected]
  (if (map? value)
    (= (set (keys value)) expected)
    false))


(defn sh25-component-build-policy []
  {:artifact :gravity/sh25-component-build-policy
   :schema-version 1
   :governing-documents [:D1 :D3 :D8 :D9 :BOOT1 :BOOT3 :BOOT5
                         :BOOT7 :BOOT8 :TEST13]
   :ownership-inventory
   "docs/self-hosting-slice-ownership.edn"
   :authoritative-owned-module-count 41
   :required-component-count 42
   :maximum-components 64
   :maximum-dependencies-per-component 16
   :maximum-outputs-per-component 8
   :maximum-diagnostics-per-component 16
   :maximum-source-bytes 16777216
   :maximum-carrier-nodes 1048576
   :maximum-carrier-depth 128
   :maximum-carrier-width 65536
   :maximum-carrier-scalar-units 16777216
   :profile :meta
   :effects #{}
   :capabilities #{}
   :diagnostics
   ["BOOT1003" "BOOT3001" "BOOT3002" "BOOT3004"
    "BOOT5003" "BOOT7005"]
   :runtime-boundary
   {:status :provisional-leaf-source
    :authoritative-ownership-record? false}
   :pending
   [:gravity-driver-execution
    :external-sh02-envelope-recomputation
    :external-sh21-legality-recomputation
    :external-sh22-library-recomputation
    :external-sh24-driver-recomputation
    :authoritative-runtime-source-promotion
    :independent-output-validation
    :complete-sh25-exit-gate
    :seed-retirement]
   :self-hosted? false
   :clojure-seed-boundary? true})

(defn sh25-source-identity-valid?
  [identity expected catalog compiler-id ordinal]
  (if
   (sh25-exact-keys?
    identity
    #{:artifact :schema-version :component-id :catalog-ordinal
      :compiler-id :logical-source-path :content-hash :byte-count})
    (if (= :gravity/source-revision (get identity :artifact))
      (if (= 1 (get identity :schema-version))
        (if (= (get catalog :component-id)
               (get identity :component-id))
          (if (= ordinal (get identity :catalog-ordinal))
            (if (= compiler-id (get identity :compiler-id))
              (if (= (get catalog :source-path)
                     (get identity :logical-source-path))
                (if (= (get expected :content-hash)
                       (get identity :content-hash))
                  (= (get expected :byte-count)
                     (get identity :byte-count))
                  false)
                false)
              false)
            false)
          false)
        false)
      false)
    false))

(defn sh25-external-verifier-valid?
  [verifier artifact subject-id semantic-root]
  (if
   (sh25-exact-keys?
    verifier
    #{:artifact :schema-version :status :subject-id
      :semantic-root :external-recomputation})
    (if (= artifact (get verifier :artifact))
      (if (= 1 (get verifier :schema-version))
        (if (= :passed (get verifier :status))
          (if (= subject-id (get verifier :subject-id))
            (if (= semantic-root (get verifier :semantic-root))
              (= :pending (get verifier :external-recomputation))
              false)
            false)
          false)
        false)
      false)
    false))

(defn sh25-authenticated-input-valid?
  [descriptor component-id source-hash compiler-id]
  (let [subject
        {:component-id component-id
         :source-content-hash source-hash
         :compiler-id compiler-id}]
    (if
     (sh25-exact-keys?
      descriptor
      #{:artifact :schema-version :descriptor-id :subject
        :semantic-root :provenance-root :verification})
      (if (= :gravity/sh02-authenticated-envelope
             (get descriptor :artifact))
        (if (= 1 (get descriptor :schema-version))
          (if (sh25-nonempty-string? (get descriptor :descriptor-id))
            (if (= subject (get descriptor :subject))
              (if (sh25-nonempty-string?
                   (get descriptor :semantic-root))
                (if (sh25-nonempty-string?
                     (get descriptor :provenance-root))
                  (sh25-external-verifier-valid?
                   (get descriptor :verification)
                   :gravity/sh02-envelope-verification
                   (get descriptor :descriptor-id)
                   (get descriptor :semantic-root))
                  false)
                false)
              false)
            false)
          false)
        false)
      false)))

(defn sh25-meta-legality-valid?
  [legality component-id source-hash compiler-id sh21-product-id]
  (if
   (sh25-exact-keys?
    legality
    #{:artifact :schema-version :component-id :source-content-hash
      :compiler-id :sh21-product-id :legality-id :profile :status
      :effects :capabilities :ambient-authority? :verification})
    (if (= :gravity/sh21-component-legality
           (get legality :artifact))
      (if (= 1 (get legality :schema-version))
        (if (= component-id (get legality :component-id))
          (if (= source-hash (get legality :source-content-hash))
            (if (= compiler-id (get legality :compiler-id))
              (if (= sh21-product-id
                     (get legality :sh21-product-id))
                (if (sh25-nonempty-string?
                     (get legality :legality-id))
                  (if (= :meta (get legality :profile))
                    (if (= :accepted (get legality :status))
                      (if (= #{} (get legality :effects))
                        (if (= #{} (get legality :capabilities))
                          (if (= false
                                 (get legality :ambient-authority?))
                            (sh25-external-verifier-valid?
                             (get legality :verification)
                             :gravity/sh21-legality-verification
                             (get legality :legality-id)
                             source-hash)
                            false)
                          false)
                        false)
                      false)
                    false)
                  false)
                false)
              false)
            false)
          false)
        false)
      false)
    false))

(defn sh25-vector-of-keywords-from? [values index]
  (if (= index (count values))
    true
    (if (keyword? (get values index))
      (sh25-vector-of-keywords-from? values (+ index 1))
      false)))

(defn sh25-vector-of-keywords? [values maximum]
  (if (vector? values)
    (if (> (count values) 0)
      (if (<= (count values) maximum)
        (sh25-vector-of-keywords-from? values 0)
        false)
      false)
    false))

(defn sh25-vector-of-strings-from? [values index]
  (if (= index (count values))
    true
    (if (sh25-nonempty-string? (get values index))
      (sh25-vector-of-strings-from? values (+ index 1))
      false)))

(defn sh25-vector-of-strings? [values maximum]
  (if (vector? values)
    (if (> (count values) 0)
      (if (<= (count values) maximum)
        (sh25-vector-of-strings-from? values 0)
        false)
      false)
    false))

(defn sh25-output-records-valid?
  [records component-id compiler-id source-hash semantic-root
   provenance-root content-id]
  (if
   (sh25-exact-keys?
    records #{:artifact :manifest :diagnostics :provenance})
    (let [artifact (get records :artifact)
          manifest (get records :manifest)
          diagnostics (get records :diagnostics)
          provenance (get records :provenance)]
      (if
       (sh25-exact-keys?
        artifact
        #{:artifact :schema-version :component-id :compiler-id
          :source-content-hash :content-id})
        (if
         (sh25-exact-keys?
          manifest
          #{:artifact :schema-version :component-id :compiler-id
            :content-id :source-content-hash})
          (if
           (sh25-exact-keys?
            diagnostics
            #{:artifact :schema-version :component-id :content-id
              :catalog-id})
            (if
             (sh25-exact-keys?
              provenance
              #{:artifact :schema-version :component-id :compiler-id
                :source-content-hash :envelope-provenance-root
                :output-content-id})
              (if (= {:artifact :gravity/compiler-component-artifact
                      :schema-version 1
                      :component-id component-id
                      :compiler-id compiler-id
                      :source-content-hash source-hash
                      :content-id content-id}
                     artifact)
                (if (= {:artifact :gravity/compiler-component-manifest
                        :schema-version 1
                        :component-id component-id
                        :compiler-id compiler-id
                        :content-id content-id
                        :source-content-hash source-hash}
                       manifest)
                  (if (= :gravity/compiler-diagnostic-bundle
                         (get diagnostics :artifact))
                    (if (= 1 (get diagnostics :schema-version))
                      (if (= component-id
                             (get diagnostics :component-id))
                        (if (= content-id
                               (get diagnostics :content-id))
                          (if
                           (sh25-nonempty-string?
                            (get diagnostics :catalog-id))
                            (= {:artifact
                                :gravity/compiler-component-provenance
                                :schema-version 1
                                :component-id component-id
                                :compiler-id compiler-id
                                :source-content-hash source-hash
                                :envelope-provenance-root provenance-root
                                :output-content-id content-id}
                               provenance)
                            false)
                          false)
                        false)
                      false)
                    false)
                  false)
                false)
              false)
            false)
          false)
        false))
    false))

(defn sh25-build-product-valid?
  [product component-id compiler-id source-hash envelope legality]
  (if
   (sh25-exact-keys?
    product
    #{:artifact :schema-version :component-id :compiler-id
      :source-content-hash :envelope-semantic-root :legality-id
      :artifact-id :content-id :records :verification})
    (if (= :gravity/sh25-component-output (get product :artifact))
      (if (= 1 (get product :schema-version))
        (if (= component-id (get product :component-id))
          (if (= compiler-id (get product :compiler-id))
            (if (= source-hash (get product :source-content-hash))
              (if (= (get envelope :semantic-root)
                     (get product :envelope-semantic-root))
                (if (= (get legality :legality-id)
                       (get product :legality-id))
                  (if (sh25-nonempty-string?
                       (get product :artifact-id))
                    (if (sh25-nonempty-string?
                         (get product :content-id))
                      (if
                       (sh25-output-records-valid?
                        (get product :records)
                        component-id compiler-id source-hash
                        (get envelope :semantic-root)
                        (get envelope :provenance-root)
                        (get product :content-id))
                        (sh25-external-verifier-valid?
                         (get product :verification)
                         :gravity/sh25-output-verification
                         (get product :artifact-id)
                         (get product :content-id))
                        false)
                      false)
                    false)
                  false)
                false)
              false)
            false)
          false)
        false)
      false)
    false))

(defn sh25-component-valid?
  [component expected revision compiler-id sh21-product-id ordinal]
  (if
   (sh25-exact-keys?
    component
    #{:component-id :category :actual-source-path :dependencies
      :profile :implementation-language :source-identity
      :authenticated-input :meta-legality :build-product})
      (if (= (get expected :component-id)
             (get component :component-id))
        (if (= (get expected :category)
               (get component :category))
          (if (= (get expected :source-path)
                 (get component :actual-source-path))
            (if (= (get expected :dependencies)
                   (get component :dependencies))
              (if (= :meta (get component :profile))
                (if (= :gravity (get component :implementation-language))
                  (if (sh25-source-identity-valid?
                       (get component :source-identity)
                       revision expected compiler-id ordinal)
                    (if (sh25-authenticated-input-valid?
                         (get component :authenticated-input)
                         (get component :component-id)
                         (get revision :content-hash)
                         compiler-id)
                      (if (sh25-meta-legality-valid?
                           (get component :meta-legality)
                           (get component :component-id)
                           (get revision :content-hash)
                           compiler-id sh21-product-id)
                        (sh25-build-product-valid?
                         (get component :build-product)
                         (get component :component-id)
                         compiler-id
                         (get revision :content-hash)
                         (get component :authenticated-input)
                         (get component :meta-legality))
                        false)
                      false)
                    false)
                  false)
                false)
              false)
            false)
          false)
        false)
      false))

(defn sh25-seen-component? [components limit component-id index]
  (if (= index limit)
    false
    (if (= component-id
           (get (get components index) :component-id))
      true
      (sh25-seen-component?
       components limit component-id (+ index 1)))))

(defn sh25-dependencies-seen-from?
  [components limit dependencies index]
  (if (= index (count dependencies))
    true
    (if (sh25-seen-component?
         components limit (get dependencies index) 0)
      (sh25-dependencies-seen-from?
       components limit dependencies (+ index 1))
      false)))

(defn sh25-components-valid-from?
  [components catalog revisions compiler-id sh21-product-id index]
  (if (= index (count catalog))
    true
    (let [component (get components index)
          expected (get catalog index)
          dependencies (get component :dependencies)]
      (if (<= (count dependencies) 16)
        (if (sh25-component-valid?
             component expected (get revisions index)
             compiler-id sh21-product-id index)
          (if (sh25-seen-component?
               components index (get component :component-id) 0)
            false
            (if (sh25-dependencies-seen-from?
                 components index dependencies 0)
              (sh25-components-valid-from?
               components catalog revisions compiler-id
               sh21-product-id (+ index 1))
              false))
          false)
        false))))

(defn sh25-components-valid? [components compiler-id sh21-product-id]
  (let [catalog (sh25-authoritative-component-catalog)
        revisions (sh25-authoritative-source-revisions)]
    (if (vector? components)
      (if (= (count catalog) (count components))
        (if (<= (count components) 64)
          (sh25-components-valid-from?
           components catalog revisions compiler-id sh21-product-id 0)
          false)
        false)
      false)))

(defn sh25-prerequisite-valid?
  [descriptor expected-artifact expected-verifier product-id
   logical-path source-hash source-bytes semantic-root]
  (if
   (sh25-exact-keys?
    descriptor
    #{:artifact :schema-version :product-id :source-revision
      :semantic-root :verification :actual-source-path})
    (let [revision (get descriptor :source-revision)]
      (if (= expected-artifact (get descriptor :artifact))
        (if (= 1 (get descriptor :schema-version))
          (if (sh25-nonempty-string? (get descriptor :product-id))
            (if
             (sh25-exact-keys?
              revision
              #{:artifact :schema-version :logical-source-path
                :content-hash :byte-count})
              (if (= :gravity/source-revision
                     (get revision :artifact))
                (if (= 1 (get revision :schema-version))
                  (if (sh25-nonempty-string?
                       (get revision :logical-source-path))
                    (if (sh25-nonempty-string?
                         (get revision :content-hash))
                      (if (integer? (get revision :byte-count))
                        (if (> (get revision :byte-count) 0)
                          (if (sh25-nonempty-string?
                               (get descriptor :semantic-root))
                            (if (sh25-external-verifier-valid?
                                 (get descriptor :verification)
                                 expected-verifier
                                 (get descriptor :product-id)
                                 (get descriptor :semantic-root))
                              (if
                               (sh25-prerequisite-context-valid?
                                descriptor product-id logical-path
                                source-hash source-bytes semantic-root)
                                (sh25-nonempty-string?
                                 (get descriptor :actual-source-path))
                                false)
                              false)
                            false)
                          false)
                        false)
                      false)
                    false)
                  false)
                false)
              false)
            false)
          false)
        false))
    false))

(defn sh25-content-record-valid? [record expected-artifact]
  (if
   (sh25-exact-keys?
    record
    #{:artifact :schema-version :content-id :byte-count})
    (if (= expected-artifact (get record :artifact))
      (if (= 1 (get record :schema-version))
        (if (sh25-nonempty-string? (get record :content-id))
          (if (integer? (get record :byte-count))
            (> (get record :byte-count) 0)
            false)
          false)
        false)
      false)
    false))

(defn sh25-prerequisite-context-valid?
  [descriptor product-id logical-path source-hash source-bytes semantic-root]
  (if (= product-id (get descriptor :product-id))
    (if (= logical-path
           (get (get descriptor :source-revision)
                :logical-source-path))
      (if (= source-hash
             (get (get descriptor :source-revision) :content-hash))
        (if (= source-bytes
               (get (get descriptor :source-revision) :byte-count))
          (= semantic-root (get descriptor :semantic-root))
          false)
        false)
      false)
    false))

(defn sh25-environment-valid? [environment]
  (if
   (sh25-exact-keys?
    environment
    #{:locale :timezone :filesystem-order :timestamp-policy
      :network :allowed-environment :locked-dependencies})
      (if (= "C" (get environment :locale))
        (if (= "UTC" (get environment :timezone))
          (if (= :sorted (get environment :filesystem-order))
            (if (= :fixed (get environment :timestamp-policy))
              (if (= :disabled (get environment :network))
                (if (= [] (get environment :allowed-environment))
                  (= true (get environment :locked-dependencies))
                  false)
                false)
              false)
            false)
          false)
        false)
      false))

(defn sh25-physical-provenance-valid? [provenance]
  (if
   (sh25-exact-keys?
    provenance
    #{:actual-build-root :actual-compiler-path :actual-output-root
      :actual-lock-path :actual-recipe-path})
    (if (sh25-nonempty-string? (get provenance :actual-build-root))
      (if (sh25-nonempty-string?
           (get provenance :actual-compiler-path))
        (if (sh25-nonempty-string?
             (get provenance :actual-output-root))
          (if (sh25-nonempty-string?
               (get provenance :actual-lock-path))
            (sh25-nonempty-string?
             (get provenance :actual-recipe-path))
            false)
          false)
        false)
      false)
    false))

(defn sh25-request-valid? [request]
  (if
   (sh25-exact-keys?
    request
    #{:artifact :schema-version :build-id :components
      :sh21-meta-legality :sh22-standard-library :sh24-driver
      :environment :lock :recipe :profile :effects :capabilities
      :physical-provenance})
      (if (= :gravity/sh25-component-build-request
             (get request :artifact))
        (if (= 1 (get request :schema-version))
          (if (keyword? (get request :build-id))
            (if (sh25-prerequisite-valid?
                 (get request :sh21-meta-legality)
                 :gravity/sh21-meta-legality
                 :gravity/sh21-meta-legality-verification
                 "gravity:sh21:bounded"
                 "gravity/self-hosting/meta-legality"
                 "sha256:prerequisite-source-21" 1021
                 "sha256:prerequisite-semantic-21")
              (if (sh25-prerequisite-valid?
                   (get request :sh22-standard-library)
                   :gravity/sh22-standard-library
                   :gravity/sh22-standard-library-verification
                   "gravity:sh22:bounded"
                   "gravity/stdlib/self-hosting-core"
                   "sha256:prerequisite-source-22" 1022
                   "sha256:prerequisite-semantic-22")
                (if (sh25-prerequisite-valid?
                     (get request :sh24-driver)
                     :gravity/sh24-compiler-driver
                     :gravity/sh24-compiler-driver-verification
                     "gravityc:sh24:bounded"
                     "gravity/self-hosting/compiler-driver"
                     "sha256:prerequisite-source-24" 1024
                     "sha256:prerequisite-semantic-24")
                  (if (sh25-components-valid?
                       (get request :components)
                       (get (get request :sh24-driver) :product-id)
                       (get
                        (get request :sh21-meta-legality)
                        :product-id))
                    (if (sh25-environment-valid?
                         (get request :environment))
                      (if (sh25-content-record-valid?
                           (get request :lock)
                           :gravity/bootstrap-lock)
                        (if (sh25-content-record-valid?
                             (get request :recipe)
                             :gravity/bootstrap-recipe)
                          (if (= :meta (get request :profile))
                            (if (= #{} (get request :effects))
                              (if (= #{} (get request :capabilities))
                                (sh25-physical-provenance-valid?
                                 (get request :physical-provenance))
                                false)
                              false)
                            false)
                          false)
                        false)
                      false)
                    false)
                  false)
                false)
              false)
            false)
          false)
        false)
      false))

(defn sh25-component-error
  [component expected revision compiler-id sh21-product-id ordinal]
  (if
   (sh25-exact-keys?
    component
    #{:component-id :category :actual-source-path :dependencies
      :profile :implementation-language :source-identity
      :authenticated-input :meta-legality :build-product})
      (if (= (get expected :component-id)
             (get component :component-id))
        (if (= (get expected :category)
               (get component :category))
          (if (= (get expected :source-path)
                 (get component :actual-source-path))
            (if (= (get expected :dependencies)
                   (get component :dependencies))
              (if (sh25-source-identity-valid?
                   (get component :source-identity)
                   revision expected compiler-id ordinal)
                (if (sh25-authenticated-input-valid?
                     (get component :authenticated-input)
                     (get component :component-id)
                     (get revision :content-hash)
                     compiler-id)
                  (if (sh25-meta-legality-valid?
                       (get component :meta-legality)
                       (get component :component-id)
                       (get revision :content-hash)
                       compiler-id sh21-product-id)
                    (if (= :meta (get component :profile))
                      (if (= :gravity
                             (get component :implementation-language))
                        (if (sh25-build-product-valid?
                             (get component :build-product)
                             (get component :component-id)
                             compiler-id
                             (get revision :content-hash)
                             (get component :authenticated-input)
                             (get component :meta-legality))
                          nil
                          :complete-output)
                        :meta-legality)
                      :meta-legality)
                    :meta-legality)
                  :authenticated-input)
                :source-identity)
              :dependency-order)
            :catalog-mismatch)
          :catalog-mismatch)
        :catalog-mismatch)
      :component-schema))

(defn sh25-components-error-from?
  [components catalog revisions compiler-id sh21-product-id index]
  (if (= index (count catalog))
    nil
    (let [component (get components index)
          error
          (sh25-component-error
           component (get catalog index) (get revisions index)
           compiler-id sh21-product-id index)]
      (if (= nil error)
        (if (sh25-dependencies-seen-from?
             components index (get component :dependencies) 0)
          (sh25-components-error-from?
           components catalog revisions compiler-id
           sh21-product-id (+ index 1))
          :dependency-order)
        error))))

(defn sh25-components-error [components compiler-id sh21-product-id]
  (let [catalog (sh25-authoritative-component-catalog)
        revisions (sh25-authoritative-source-revisions)]
    (if (vector? components)
      (if (<= (count components) 64)
        (if (= (count catalog) (count components))
          (sh25-components-error-from?
           components catalog revisions compiler-id sh21-product-id 0)
          :incomplete-catalog)
        :component-bound)
      :component-schema)))

(defn sh25-request-error [request]
  (let [preflight (sh25-carrier-preflight request)]
    (if (= :rejected (get preflight :status))
      (get preflight :reason)
      (if
       (sh25-exact-keys?
        request
        #{:artifact :schema-version :build-id :components
          :sh21-meta-legality :sh22-standard-library :sh24-driver
          :environment :lock :recipe :profile :effects :capabilities
          :physical-provenance})
        (if (= :gravity/sh25-component-build-request
               (get request :artifact))
          (if (= 1 (get request :schema-version))
            (if (keyword? (get request :build-id))
              (if
               (sh25-prerequisite-valid?
                (get request :sh21-meta-legality)
                :gravity/sh21-meta-legality
                :gravity/sh21-meta-legality-verification
                "gravity:sh21:bounded"
                "gravity/self-hosting/meta-legality"
                "sha256:prerequisite-source-21" 1021
                "sha256:prerequisite-semantic-21")
                (if
                 (sh25-prerequisite-valid?
                  (get request :sh22-standard-library)
                  :gravity/sh22-standard-library
                  :gravity/sh22-standard-library-verification
                  "gravity:sh22:bounded"
                  "gravity/stdlib/self-hosting-core"
                  "sha256:prerequisite-source-22" 1022
                  "sha256:prerequisite-semantic-22")
                  (if
                   (sh25-prerequisite-valid?
                    (get request :sh24-driver)
                    :gravity/sh24-compiler-driver
                    :gravity/sh24-compiler-driver-verification
                    "gravityc:sh24:bounded"
                    "gravity/self-hosting/compiler-driver"
                    "sha256:prerequisite-source-24" 1024
                    "sha256:prerequisite-semantic-24")
                    (let [component-error
                          (sh25-components-error
                           (get request :components)
                           (get (get request :sh24-driver) :product-id)
                           (get
                            (get request :sh21-meta-legality)
                            :product-id))]
                      (if (= nil component-error)
                        (if (sh25-environment-valid?
                             (get request :environment))
                          (if (sh25-content-record-valid?
                               (get request :lock)
                               :gravity/bootstrap-lock)
                            (if (sh25-content-record-valid?
                                 (get request :recipe)
                                 :gravity/bootstrap-recipe)
                              (if (= :meta (get request :profile))
                                (if (= #{} (get request :effects))
                                  (if (= #{}
                                         (get request :capabilities))
                                    (if (sh25-physical-provenance-valid?
                                         (get request
                                              :physical-provenance))
                                      nil
                                      :physical-provenance)
                                    :ambient-authority)
                                  :ambient-authority)
                                :meta-legality)
                              :recipe)
                            :lock)
                          :environment)
                        component-error))
                    :prerequisite)
                  :prerequisite)
                :prerequisite)
              :request-schema)
            :request-schema)
          :request-schema)
        :request-schema))))

(defn sh25-identity-authenticated-input [descriptor]
  {:artifact (get descriptor :artifact)
   :schema-version (get descriptor :schema-version)
   :descriptor-id (get descriptor :descriptor-id)
   :subject (get descriptor :subject)
   :semantic-root (get descriptor :semantic-root)
   :verification (get descriptor :verification)})

(defn sh25-identity-build-product [product]
  {:artifact (get product :artifact)
   :schema-version (get product :schema-version)
   :component-id (get product :component-id)
   :compiler-id (get product :compiler-id)
   :source-content-hash (get product :source-content-hash)
   :envelope-semantic-root (get product :envelope-semantic-root)
   :legality-id (get product :legality-id)
   :artifact-id (get product :artifact-id)
   :content-id (get product :content-id)
   :records
   {:artifact (get (get product :records) :artifact)
    :manifest (get (get product :records) :manifest)
    :diagnostics (get (get product :records) :diagnostics)}
   :verification (get product :verification)})

(defn sh25-identity-component [component]
  {:component-id (get component :component-id)
   :category (get component :category)
   :dependencies (get component :dependencies)
   :source-identity (get component :source-identity)
   :authenticated-input
   (sh25-identity-authenticated-input
    (get component :authenticated-input))
   :meta-legality (get component :meta-legality)
   :build-product
   (sh25-identity-build-product (get component :build-product))
   :profile (get component :profile)
   :implementation-language
   (get component :implementation-language)})

(defn sh25-identity-components-from? [components index result]
  (if (= index (count components))
    result
    (sh25-identity-components-from?
     components (+ index 1)
     (conj result
           (sh25-identity-component (get components index))))))

(defn sh25-identity-components [components]
  (sh25-identity-components-from? components 0 []))

(defn sh25-actions-from? [components index result]
  (if (= index (count components))
    result
    (let [component (get components index)
          product (get component :build-product)]
      (sh25-actions-from?
       components (+ index 1)
       (conj
        result
        {:action-id
         (str "sh25:compile:" (get component :component-id))
         :executor :gravity-sh24-driver
         :component-id (get component :component-id)
         :source-identity (get component :source-identity)
         :authenticated-input
         (get component :authenticated-input)
         :dependency-components (get component :dependencies)
         :artifact-id (get product :artifact-id)
         :content-id (get product :content-id)
         :complete-output-records (get product :records)
         :profile :meta
         :effects #{}
         :capabilities #{}
         :status :bound-supplied-product})))))

(defn sh25-actions [components]
  (sh25-actions-from? components 0 []))

(defn sh25-sh26-components-from? [components index result]
  (if (= index (count components))
    result
    (let [component (get components index)
          product (get component :build-product)]
      (sh25-sh26-components-from?
       components (+ index 1)
       (conj
        result
        {:component-id (get component :component-id)
         :source-id
         (get (get component :source-identity) :content-hash)
         :output-id (get product :content-id)
         :topological-ordinal index
         :dependencies (get component :dependencies)
         :profile :meta
         :implementation-language :gravity
         :conformance-status :pending
         :sh25-verification-status :pending
         :actual-source-path
         (get component :actual-source-path)})))))

(defn sh25-sh26-components [components]
  (sh25-sh26-components-from? components 0 []))

(defn sh25-source-paths-from? [components index result]
  (if (= index (count components))
    result
    (sh25-source-paths-from?
     components (+ index 1)
     (conj result
           (get (get components index) :actual-source-path)))))

(defn sh25-source-paths [components]
  (sh25-source-paths-from? components 0 []))

(defn sh25-provenance-roots-from? [components index result]
  (if (= index (count components))
    result
    (sh25-provenance-roots-from?
     components (+ index 1)
     (conj
      result
      {:component-id
       (get (get components index) :component-id)
       :provenance-root
       (get
        (get (get components index) :authenticated-input)
        :provenance-root)}))))

(defn sh25-provenance-roots [components]
  (sh25-provenance-roots-from? components 0 []))

(defn sh25-output-provenance-from? [components index result]
  (if (= index (count components))
    result
    (sh25-output-provenance-from?
     components (+ index 1)
     (conj
      result
      (get
       (get (get (get components index) :build-product) :records)
       :provenance)))))

(defn sh25-output-provenance [components]
  (sh25-output-provenance-from? components 0 []))

(defn sh25-identity-prerequisite [descriptor]
  {:artifact (get descriptor :artifact)
   :schema-version (get descriptor :schema-version)
   :product-id (get descriptor :product-id)
   :source-revision (get descriptor :source-revision)
   :semantic-root (get descriptor :semantic-root)
   :verification (get descriptor :verification)})

(defn sh25-rule-for-reason [reason]
  (if (= reason :source-identity)
    "BOOT1003"
    (if (= reason :authenticated-input)
      "BOOT3004"
      (if (= reason :complete-output)
        "BOOT7005"
        (if (= reason :meta-legality)
          "BOOT3002"
          (if (= reason :ambient-authority)
            "BOOT3002"
            (if (= reason :prerequisite)
              "BOOT5003"
              "BOOT3001")))))))

(defn sh25-rejection [request reason]
  {:artifact :gravity/sh25-component-build-result
   :schema-version 1
   :status :rejected
   :build-id (get request :build-id)
   :diagnostics
   [{:rule (sh25-rule-for-reason reason)
     :severity :error
     :stage :bootstrap
     :source
     (get (get request :physical-provenance) :actual-build-root)
     :facts {:reason reason}
     :remediation
     "Provide the complete ordered component set and authenticated inputs."}]
   :pending
   [:gravity-driver-execution
    :authoritative-runtime-source-promotion
    :complete-sh25-exit-gate]
   :clojure-seed-boundary? true})

(defn sh25-build-authoritative-components [request]
  (let [preflight (sh25-carrier-preflight request)]
    (if (= :accepted (get preflight :status))
      (if (sh25-request-valid? request)
        (let [components (get request :components)]
          {:artifact :gravity/sh25-component-build-result
           :schema-version 1
           :status :accepted
           :build-id (get request :build-id)
           :component-count (count components)
           :request-census preflight
           :actions (sh25-actions components)
           :sh26-component-templates
           (sh25-sh26-components components)
           :identity-input
           {:artifact :gravity/sh25-component-build-identity
            :schema-version 1
            :build-id (get request :build-id)
            :components (sh25-identity-components components)
            :sh21-meta-legality
            (sh25-identity-prerequisite
             (get request :sh21-meta-legality))
            :sh22-standard-library
            (sh25-identity-prerequisite
             (get request :sh22-standard-library))
            :sh24-driver
            (sh25-identity-prerequisite
             (get request :sh24-driver))
            :environment (get request :environment)
            :lock (get request :lock)
            :recipe (get request :recipe)
            :profile :meta
            :effects #{}
            :capabilities #{}}
           :provenance
           {:physical (get request :physical-provenance)
            :prerequisite-source-paths
            {:sh21
             (get (get request :sh21-meta-legality)
                  :actual-source-path)
             :sh22
             (get (get request :sh22-standard-library)
                  :actual-source-path)
             :sh24
             (get (get request :sh24-driver)
                  :actual-source-path)}
            :actual-source-paths
            (sh25-source-paths components)
            :authenticated-provenance-roots
            (sh25-provenance-roots components)
            :output-provenance
            (sh25-output-provenance components)}
           :diagnostics []
           :pending
           [:gravity-driver-execution
            :external-sh02-envelope-recomputation
            :external-sh21-legality-recomputation
            :external-sh22-library-recomputation
            :external-sh24-driver-recomputation
            :authoritative-runtime-source-promotion
            :independent-output-validation
            :complete-sh25-exit-gate
            :seed-retirement]
           :self-hosted? false
           :clojure-seed-boundary? true})
        (let [reason (sh25-request-error request)]
          (sh25-rejection
           request
           (if (= nil reason)
             :invalid-component-build-request
             reason))))
      (sh25-rejection request (get preflight :reason)))))

(defn sh25-verify-component-build [request candidate]
  (let [request-preflight (sh25-carrier-preflight request)
        candidate-preflight (sh25-carrier-preflight candidate)]
    (if (= :accepted (get request-preflight :status))
      (if (= :accepted (get candidate-preflight :status))
        (let [expected (sh25-build-authoritative-components request)]
          (if (= expected candidate)
            {:artifact :gravity/sh25-component-build-verification
             :schema-version 1
             :status :passed
             :build-id (get request :build-id)
             :component-count (get expected :component-count)
             :candidate-census candidate-preflight
             :checks
             [:complete-catalog
              :dependency-order
              :pinned-source-revisions
              :contextual-envelope-subjects
              :contextual-meta-legality
              :bound-complete-output-records
              :bound-prerequisite-revisions
              :path-neutral-identity
              :physical-provenance
              :exact-result]}
            {:artifact :gravity/sh25-component-build-verification
             :schema-version 1
             :status :rejected
             :build-id (get request :build-id)
             :diagnostics
             [{:rule "BOOT3001"
               :severity :error
               :stage :bootstrap
               :source
               (get
                (get request :physical-provenance)
                :actual-build-root)
               :facts {:reason :component-build-result-altered}
               :remediation
               "Recompute the complete component build result."}]}))
        {:artifact :gravity/sh25-component-build-verification
         :schema-version 1
         :status :rejected
         :build-id (get request :build-id)
         :diagnostics
         [{:rule "BOOT3001"
           :severity :error
           :stage :bootstrap
           :source
           (get (get request :physical-provenance) :actual-build-root)
           :facts {:reason (get candidate-preflight :reason)}
           :remediation "Provide a bounded candidate carrier."}]})
      {:artifact :gravity/sh25-component-build-verification
       :schema-version 1
       :status :rejected
       :build-id (get request :build-id)
       :diagnostics
       [{:rule "BOOT3001"
         :severity :error
         :stage :bootstrap
         :source nil
         :facts {:reason (get request-preflight :reason)}
         :remediation "Provide a bounded request carrier."}]})))

(defn sh25-project-verified-sh26-components
  [request candidate verification]
  (let [request-preflight (sh25-carrier-preflight request)
        candidate-preflight (sh25-carrier-preflight candidate)
        verification-preflight (sh25-carrier-preflight verification)]
    (if (= :accepted (get request-preflight :status))
      (if (= :accepted (get candidate-preflight :status))
        (if (= :accepted (get verification-preflight :status))
          (let [expected-verification
                (sh25-verify-component-build request candidate)]
            (if (= expected-verification verification)
              (if (= :passed (get verification :status))
                {:artifact :gravity/sh25-sh26-component-projection
                 :schema-version 1
                 :status :pending
                 :build-id (get request :build-id)
                 :verification verification
                 :components
                 (get candidate :sh26-component-templates)}
                (sh25-rejection request :sh25-verification-not-passed))
              (sh25-rejection request :verification-record-altered)))
          (sh25-rejection
           request (get verification-preflight :reason)))
        (sh25-rejection request (get candidate-preflight :reason)))
      (sh25-rejection request (get request-preflight :reason)))))

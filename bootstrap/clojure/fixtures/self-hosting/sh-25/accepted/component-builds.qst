(defn sh25-component [component-id category source-path dependencies ordinal]
  (let [revision (get (sh25-source-revisions) ordinal)
        source-hash (first revision)
        source-bytes (second revision)
        compiler-id "gravityc:sh24:bounded"
        sh21-product-id "gravity:sh21:bounded"
        descriptor-id (str "gravity:sh02:" component-id)
        semantic-root (str "sha256:sh25-semantic-" ordinal)
        provenance-root (str "sha256:sh25-provenance-" ordinal)
        legality-id (str "gravity:sh21:legality:" component-id)
        artifact-id (str "gravityc:component:" component-id)
        content-id (str "sha256:sh25-output-" ordinal)]
    {:component-id component-id
     :category category
     :actual-source-path source-path
     :dependencies dependencies
     :profile :meta
     :implementation-language :gravity
     :source-identity
     {:artifact :gravity/source-revision
      :schema-version 1
      :component-id component-id
      :catalog-ordinal ordinal
      :compiler-id compiler-id
      :logical-source-path source-path
      :content-hash source-hash
      :byte-count source-bytes}
     :authenticated-input
     {:artifact :gravity/sh02-authenticated-envelope
      :schema-version 1
      :descriptor-id descriptor-id
      :subject
      {:component-id component-id
       :source-content-hash source-hash
       :compiler-id compiler-id}
      :semantic-root semantic-root
      :provenance-root provenance-root
      :verification
      {:artifact :gravity/sh02-envelope-verification
       :schema-version 1
       :status :passed
       :subject-id descriptor-id
       :semantic-root semantic-root
       :external-recomputation :pending}}
     :meta-legality
     {:artifact :gravity/sh21-component-legality
      :schema-version 1
      :component-id component-id
      :source-content-hash source-hash
      :compiler-id compiler-id
      :sh21-product-id sh21-product-id
      :legality-id legality-id
      :profile :meta
      :status :accepted
      :effects #{}
      :capabilities #{}
      :ambient-authority? false
      :verification
      {:artifact :gravity/sh21-legality-verification
       :schema-version 1
       :status :passed
       :subject-id legality-id
       :semantic-root source-hash
       :external-recomputation :pending}}
     :build-product
     {:artifact :gravity/sh25-component-output
      :schema-version 1
      :component-id component-id
      :compiler-id compiler-id
      :source-content-hash source-hash
      :envelope-semantic-root semantic-root
      :legality-id legality-id
      :artifact-id artifact-id
      :content-id content-id
      :records
      {:artifact
       {:artifact :gravity/compiler-component-artifact
        :schema-version 1
        :component-id component-id
        :compiler-id compiler-id
        :source-content-hash source-hash
        :content-id content-id}
       :manifest
       {:artifact :gravity/compiler-component-manifest
        :schema-version 1
        :component-id component-id
        :compiler-id compiler-id
        :content-id content-id
        :source-content-hash source-hash}
       :diagnostics
       {:artifact :gravity/compiler-diagnostic-bundle
        :schema-version 1
        :component-id component-id
        :content-id content-id
        :catalog-id (str "sha256:diagnostics:" ordinal)}
       :provenance
       {:artifact :gravity/compiler-component-provenance
        :schema-version 1
        :component-id component-id
        :compiler-id compiler-id
        :source-content-hash source-hash
        :envelope-provenance-root provenance-root
        :output-content-id content-id}}
      :verification
      {:artifact :gravity/sh25-output-verification
       :schema-version 1
       :status :passed
       :subject-id artifact-id
       :semantic-root content-id
       :external-recomputation :pending}}}))


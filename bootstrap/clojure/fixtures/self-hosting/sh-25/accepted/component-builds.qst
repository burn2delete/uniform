(ns gravity.self-hosting.sh25.accepted.component-builds
  (:profile :meta)
  (:target :jvm)
  (:exports [sh25-component-build-request
             sh25-component-build-alternate-path-request])
  (:effects #{})
  (:capabilities #{})
  (:safety :safe))


    "bootstrap/clojure/fixtures/self-hosting/sh-19/minimal_runtime_engine.gravity"
    [:backend-c :standard-library-subset] 41)])

(defn sh25-prerequisite
  [artifact verifier-artifact product-id logical-path actual-path ordinal]
  {:artifact artifact
   :schema-version 1
   :product-id product-id
   :source-revision
   {:artifact :gravity/source-revision
    :schema-version 1
    :logical-source-path logical-path
    :content-hash (str "sha256:prerequisite-source-" ordinal)
    :byte-count (+ 1000 ordinal)}
   :semantic-root (str "sha256:prerequisite-semantic-" ordinal)
   :verification
   {:artifact verifier-artifact
    :schema-version 1
    :status :passed
    :subject-id product-id
    :semantic-root (str "sha256:prerequisite-semantic-" ordinal)
    :external-recomputation :pending}
   :actual-source-path actual-path})

(defn sh25-request-at [actual-build-root]
  {:artifact :gravity/sh25-component-build-request
   :schema-version 1
   :build-id :sh25-bounded-component-build
   :components (sh25-components)
   :sh21-meta-legality
   (sh25-prerequisite
    :gravity/sh21-meta-legality
    :gravity/sh21-meta-legality-verification
    "gravity:sh21:bounded"
    "gravity/self-hosting/meta-legality"
    (str actual-build-root "/meta-legality.gravity") 21)
   :sh22-standard-library
   (sh25-prerequisite
    :gravity/sh22-standard-library
    :gravity/sh22-standard-library-verification
    "gravity:sh22:bounded"
    "gravity/stdlib/self-hosting-core"
    (str actual-build-root "/stdlib.gravity") 22)
   :sh24-driver
   (sh25-prerequisite
    :gravity/sh24-compiler-driver
    :gravity/sh24-compiler-driver-verification
    "gravityc:sh24:bounded"
    "gravity/self-hosting/compiler-driver"
    (str actual-build-root "/gravityc") 24)
   :environment
   {:locale "C"
    :timezone "UTC"
    :filesystem-order :sorted
    :timestamp-policy :fixed
    :network :disabled
    :allowed-environment []
    :locked-dependencies true}
   :lock
   {:artifact :gravity/bootstrap-lock
    :schema-version 1
    :content-id "sha256:sh25-lock"
    :byte-count 4096}
   :recipe
   {:artifact :gravity/bootstrap-recipe
    :schema-version 1
    :content-id "sha256:sh25-recipe"
    :byte-count 2048}
   :profile :meta
   :effects #{}
   :capabilities #{}
   :physical-provenance
   {:actual-build-root actual-build-root
    :actual-compiler-path (str actual-build-root "/gravityc")
    :actual-output-root (str actual-build-root "/out")
    :actual-lock-path (str actual-build-root "/gravity.lock")
    :actual-recipe-path (str actual-build-root "/build.gravity")}})

(defn sh25-component-build-request []
  (sh25-request-at "/checkout-a/gravity"))

(defn sh25-component-build-alternate-path-request []
  (sh25-request-at "/checkout-b/gravity"))

; SH-07-B2 exact operator then argument evaluation ordering.
(ns self-hosting.sh07-b2.call-evaluation-order
  (:profile :meta)
  (:target :jvm)
  (:exports [combine ordered-call])
  (:effects #{})
  (:capabilities #{})
  (:safety :safe)
  (:metadata {:slice :SH-07-B2 :fixture :call-evaluation-order}))

(defn combine [left middle right]
  [left middle right])

(def ordered-call
  (combine
    (do 1 2)
    (if false 3 4)
    (do 5 6)))

; SH-07-B6 mutation records preserve mutually exclusive branch regions.
(ns self-hosting.sh07-b6.conditional-mutations
  (:profile :meta)
  (:target :jvm)
  (:exports [target conditional-write])
  (:effects #{:state/write})
  (:capabilities #{})
  (:safety :safe)
  (:metadata {:slice :SH-07-B6
              :fixture :conditional-mutations}))

(def target 0)

(def conditional-write
  (if true
    (set! target 1)
    (set! target 2)))

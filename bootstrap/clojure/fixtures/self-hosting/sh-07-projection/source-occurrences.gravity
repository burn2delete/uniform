(ns checked-core.projection-fixture
  (:profile :meta) (:target :jvm)
  (:exports [decimal-value map-value set-value character-value quoted-value identity-value])
  (:effects #{}) (:capabilities #{}) (:safety :safe))

(def decimal-value 1.25)
(def map-value {:j 10 :i 9 :h 8 :g 7 :f 6 :e 5 :d 4 :c 3 :b 2 :a 1})
(def set-value #{:j :i :h :g :f :e :d :c :b :a})
(def character-value \a)

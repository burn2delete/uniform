      (w5-source s3 s3 [a3] [] (w5-path root "/sources/stage3"))
      (w5-source s4 s4 [a4] [] (w5-path root "/sources/release"))]
     :lineage
     [(w5-stage a1 :stage1 c1 c0 s1 depgraph lock env1 tool1 r1 git-a git-b a1

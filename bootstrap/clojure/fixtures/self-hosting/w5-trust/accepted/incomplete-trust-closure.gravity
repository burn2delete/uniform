(ns gravity.self-hosting.w5-trust.accepted.incomplete-trust-closure
  (:profile :meta)
  (:target :jvm)
  (:exports [w5-trust-provenance-request
             w5-trust-provenance-alternate-path-request])
  (:effects #{})
  (:capabilities #{})
  (:safety :safe))

(def w5-target
  {:candidate-target :llvm-x86_64-linux
   :os :linux
   :arch :x86_64
   :backend :llvm
   :artifact-format :elf
   :abi :sysv-amd64
   :unsupported-targets [:darwin :darwin-arm64 :darwin-x86_64 :windows]
   :unsupported-target-policies
   [{:target :darwin :invokes-clojure? false :links-jvm? false :fallback? false}
    {:target :darwin-arm64 :invokes-clojure? false :links-jvm? false :fallback? false}
    {:target :darwin-x86_64 :invokes-clojure? false :links-jvm? false :fallback? false}
    {:target :windows :invokes-clojure? false :links-jvm? false :fallback? false}]
   :cross-target-inference? false
   :darwin-fallback? false})

(defn w5-path [root suffix]
  (str root suffix))

(defn w5-upstream [artifact content verifier verification commit tree path]
  {:artifact-id artifact
   :content-hash content
   :independent-verifier-id verifier
   :independent-verification-id verification
   :status :pending
   :producer-commit commit
   :producer-tree tree
   :actual-artifact-path path})

(defn w5-source [graph root-hash component generator path]
  {:source-graph-id graph
   :root-content-hash root-hash
   :component-ids component
   :component-content-hashes component
   :generator-input-ids generator
   :canonical? true
   :verification-status :descriptor-only
   :actual-source-root path})

(defn w5-stage [artifact stage compiler compiled-by source graph lock env tool recipe commit tree content path parents]
  {:artifact-id artifact
   :stage-id stage
   :compiler-executable-id compiler
   :compiled-by-executable-id compiled-by
   :source-graph-id source
   :dependency-graph-id graph
   :lock-id lock
   :environment-id env
   :toolchain-id tool
   :build-recipe-id recipe
   :rebuild-parent-ids parents
   :producer-commit commit
   :producer-tree tree
   :content-hash content
   :content-hash-status :pending
   :actual-artifact-path path})

(defn w5-recipe [id source lock graph compiler tool env cap content path]
  {:build-recipe-id id
   :source-graph-id source
   :lock-id lock
   :dependency-graph-id graph
   :compiler-executable-id compiler
   :toolchain-id tool
   :environment-id env
   :target-scope w5-target
   :capability-inventory-id cap
   :content-hash content
   :verification-status :descriptor-only
   :actual-recipe-path path})

(defn w5-rebuild [id root artifact content source compiler lock graph recipe
                  builder role tool env anchor path]
  {:rebuild-id id
   :artifact-id artifact
   :content-hash content
   :source-graph-id source
   :compiler-executable-id compiler
   :lock-id lock
   :dependency-graph-id graph
   :build-recipe-id recipe
   :builder-id builder
   :builder-role role
   :toolchain-id tool
   :environment-id env
   :trust-anchor-id anchor
   :comparison-status :matching
   :independence-status :pending-independent
   :content-hash-status :pending
   :actual-build-root path})

(defn w5-anchor [id kind operator root-id identity policy path]
  {:anchor-id id
   :anchor-kind kind
   :operator-id operator
   :root-metadata-id root-id
   :public-identity-id identity
   :verification-status :descriptor-only
   :revocation-status :current
   :policy-id policy
   :actual-anchor-location path})

(defn w5-attestation [id manifest provenance rebuild path]
  {:attestation-id id
   :schema-version 1
   :artifact-id (get rebuild :artifact-id)
   :manifest-id manifest
   :provenance-id provenance
   :rebuild-id (get rebuild :rebuild-id)
   :builder-id (get rebuild :builder-id)
   :builder-role (get rebuild :builder-role)
   :artifact-content-hash (get rebuild :content-hash)
   :source-graph-id (get rebuild :source-graph-id)
   :compiler-executable-id (get rebuild :compiler-executable-id)
   :lock-id (get rebuild :lock-id)
   :dependency-graph-id (get rebuild :dependency-graph-id)
   :build-recipe-id (get rebuild :build-recipe-id)
   :toolchain-id (get rebuild :toolchain-id)
   :environment-id (get rebuild :environment-id)
   :trust-anchor-id (get rebuild :trust-anchor-id)
   :policy-level :hermetic
   :verification-status :pending
   :actual-attestation-path path})


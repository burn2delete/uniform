     :unsafe-audits
     [{:audit-id unsafe-id :island-id island-id
       :source-span {:source-id :native-allocator
                     :actual-source-path (w5-path root "/src/allocator.gravity")
                     :start {:byte 128 :line 8 :column 3}
                     :end {:byte 180 :line 9 :column 25}}
       :profiles [:native] :effects [:memory-raw] :capabilities [:allocator]
       :preconditions [:aligned-pointer] :postconditions [:owned-buffer]
       :safe-boundary-id boundary-id :review-id review-id
       :review-status :passed :verification-status :descriptor-only
       :actual-audit-path (w5-path root "/audits/allocator.edn")}]
     :tcb-delta
     {:delta-id tcb-id
      :prior-trusted-components [:clojure-stage0-seed :jvm-stage2-runtime]
      :candidate-trusted-components [:llvm-toolchain :native-linux-replay]
      :added-components [:llvm-toolchain :native-linux-replay]
      :removed-components []
      :retained-components [:clojure-stage0-seed :jvm-stage2-runtime]
      :residual-trusted-components
      [:clojure-stage0-seed :jvm-stage2-runtime :native-linux-replay
       :independent-trust-anchors :independent-sol-review :stage-equivalence
       :external-signing]
      :derived? true :status :open
      :actual-report-path (w5-path root "/provenance/tcb-delta.edn")}
     :equivalence
     {:report-id equiv-id :target w5-target :stage-a-artifact-id a3
      :stage-b-artifact-id a4 :modes
      [:artifact :manifest :diagnostic :conformance :runtime-output
       :ir-modulo-id :reviewed-delta]
      :status :pending :diagnostic-span-parity :pending
      :independent-recomputation :pending
      :actual-report-path (w5-path root "/equivalence/stages.edn")}
     :replay
     {:predicate-symbol
      'gravity.self-hosting.w5-trust-provenance-verifier/w5-verify-result
      :predicate-version 1
      :development
      {:gcc {:image-id replay-gcc :platform :linux-amd64 :pull-policy :never
             :toolchain :gcc :toolchain-version "14.1"
             :toolchain-files-id files1 :docker-engine-id replay-command
             :docker-host-id replay-result :qemu-observation-id replay-gcc
             :binfmt-observation-id replay-llvm :kernel-id replay-kernel
             :cgroup-observation-id replay-cgroup
             :execveat-observation-id replay-execveat :command-id replay-command
             :result-id replay-result :status :pending
             :authority :development-only}
       :llvm {:image-id replay-llvm :platform :linux-amd64 :pull-policy :never
              :toolchain :llvm :toolchain-version "18.1"
              :toolchain-files-id files2 :docker-engine-id replay-command
              :docker-host-id replay-result :qemu-observation-id replay-gcc
              :binfmt-observation-id replay-llvm :kernel-id replay-kernel
              :cgroup-observation-id replay-cgroup
              :execveat-observation-id replay-execveat :command-id replay-command
              :result-id replay-result :status :pending
              :authority :development-only}}
      :native
      {:platform :linux-amd64 :native-host? false :emulator-authority? true
       :kernel-id replay-kernel :cgroup-observation-id replay-cgroup
       :execveat-observation-id replay-execveat :environment-id env2
       :lock-id lock :command-id replay-command :result-id replay-result
       :status :pending :authority :development-only}
      :actual-replay-root (w5-path root "/replay")}
     :authority
     {:candidate-invokes-clojure? false :candidate-links-jvm? false
      :build-invokes-clojure? false :public-route-invokes-clojure? false
      :uses-ambient-process? false :uses-ambient-filesystem? false
      :uses-hidden-file-authority? false
      :unsupported-target-invokes-clojure? false
      :unsupported-target-links-jvm? false :recovery-path-separated? true
      :reported-clojure-seed-boundary? true :self-hosted? false
      :release? false :public-authority? false}
     :review {:reviewer-class :independent-sol-review :review-status :pending
              :review-id review-id :findings []
              :actual-review-path (w5-path root "/review/sol")}
     :claims {:producer-asserted? true :narrative-only? true
              :source-ownership-only? false :check-only? false
              :container-evidence? true :closure-authority? false}
     :source-span {:source-id :w5-trust-request
                   :actual-source-path (w5-path root "/accepted/incomplete-trust-closure.gravity")
                   :start {:byte 0 :line 1 :column 1}
                   :end {:byte 1000 :line 1 :column 1}}}))

(defn w5-trust-provenance-request []
  (w5-request "/checkout-a"))

(defn w5-trust-provenance-alternate-path-request []
  (w5-request "/checkout-b"))

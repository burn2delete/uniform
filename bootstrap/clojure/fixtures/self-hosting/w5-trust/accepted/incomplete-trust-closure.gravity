       :dependency-content-hashes [s1] :dependency-provenance-ids [prov]
       :graph-content-hash depgraph :topological? true :complete? true
       :verification-status :descriptor-only
       :actual-graph-path (w5-path root "/locks/dependency-graph.edn")}]
     :locks

(ns self-hosting.sh07-b51-v18.recur-arity-mismatch
  (:profile :meta)
  (:target :jvm)
  (:exports [exercise])
  (:effects #{})
  (:capabilities #{})
  (:safety :safe))

(defn exercise [input]
  (loop [[left right] input
         total 0]
    (if (< total 1)
      (recur [left right])
      (+ left right total))))

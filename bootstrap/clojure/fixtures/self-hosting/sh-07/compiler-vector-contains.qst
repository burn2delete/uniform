; Verbatim helper from checked_core.gravity; this fixture is a separate subject.
(ns self-hosting.sh07.compiler-vector-contains
  (:profile :meta) (:target :jvm)
  (:effects #{}) (:capabilities #{}) (:safety :safe)
  (:exports []))

(defn sh07-vector-contains? [values value]
  (loop [remaining values]
    (if (= (count remaining) 0)
      false
      (if (= (first remaining) value)
        true
        (recur (rest remaining))))))

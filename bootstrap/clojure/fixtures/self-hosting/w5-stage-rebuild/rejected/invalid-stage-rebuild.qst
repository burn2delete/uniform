(defn w5-stage-rebuild-invalid-coherent-id-substitution-request []
  (let [request (w5-stage-rebuild-base-request)
        stages (get request :stages)
        sets (get request :artifact-sets)
        forged "sha256:forged-stage2-output"]
    (assoc request
           :stages
           (assoc stages :stage2
                  (assoc (get stages :stage2)
                         :artifact-executable-id forged))
           :artifact-sets
           (assoc sets :stage2
                  (assoc (get sets :stage2)
                         :artifact-ids [forged]
                         :artifacts
                         [{:artifact-id forged :target :llvm-x86_64-linux
                           :kind :stage-compiler
                           :compiled-by-executable-id
                           "sha256:9999999999999999999999999999999999999999999999999999999999999999"
                           :status :pending :independent-status :pending}]))
           :boot7-equivalence-input
           (assoc (get request :boot7-equivalence-input)
                  :artifact-a-id forged))))


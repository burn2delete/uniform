(defn w5-pipeline-invalid-source-link [request]
  (w5-pipeline-nested-assoc request [:reader :source-id]
                             :fixture/substituted-source))

(defn w5-pipeline-invalid-stage-link [request]
  (w5-pipeline-nested-assoc request [:stage-artifacts 0 :output-id]
                             "artifact:stage-output:substituted:0"))

(defn w5-pipeline-invalid-adjacent-stage-link [request]
  (w5-pipeline-nested-assoc request [:stage-artifacts 1 :input-id]
                             "artifact:disconnected-stage-input"))

(defn w5-pipeline-invalid-stage-artifact-identity [request]
  (w5-pipeline-nested-assoc request [:stage-artifacts 5 :artifact-identity]
                             :artifact/substituted))

(defn w5-pipeline-invalid-pass-link [request]
  (w5-pipeline-nested-assoc request [:passes 0 :pass-id]
                             :substituted-pass))

(defn w5-pipeline-invalid-adjacent-pass-link [request]
  (w5-pipeline-nested-assoc request [:passes 1 :input-ir]
                             "artifact:disconnected-pass-input"))

(defn w5-pipeline-invalid-appended-stage [request]
  (assoc request :stage-artifacts
         (conj (get request :stage-artifacts)
               (get (get request :stage-artifacts) 15))))

(defn w5-pipeline-invalid-appended-pass [request]
  (assoc request :passes
         (conj (get request :passes)
               (get (get request :passes) 15))))

(defn w5-pipeline-invalid-target-link [request]
  (w5-pipeline-nested-assoc request [:target-lowering :unsupported-targets]
                             [:darwin]))

(defn w5-pipeline-invalid-artifact-link [request]
  (assoc request :artifacts
         (assoc (get request :artifacts) :extra-evidence true)))

(defn w5-pipeline-invalid-identity-link [request]
  (assoc request :stage-identities
         [:source-forms :reader :forged-stage]))

(defn w5-pipeline-invalid-provenance-link [request]
  (assoc request :provenance
         (assoc (get request :provenance)
                :compiler-id "gravity-stage2-substituted")))

(defn w5-pipeline-invalid-request-shape [request]
  (assoc request :unexpected-field :forged))

(defn w5-pipeline-invalid-diagnostic-span [request]
  (assoc request :source-span {:source-id :fixture/w5-pipeline
                               :start 9
                               :end 4}))

(defn w5-pipeline-invalid-diagnostic-origin [request]
  (w5-pipeline-nested-assoc
   request [:provenance :generated-origin-chain] []))

(defn w5-pipeline-invalid-diagnostic-provenance [request]
  (w5-pipeline-invalid-diagnostic-origin
   (w5-pipeline-invalid-diagnostic-span request)))

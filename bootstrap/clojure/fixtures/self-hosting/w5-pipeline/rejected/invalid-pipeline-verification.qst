(defn w5-pipeline-invalid-abbreviation [request]
  (w5-pipeline-nested-assoc request [:reader :abbreviations-valid?] false))
(defn w5-pipeline-invalid-extension [request]
  (w5-pipeline-nested-assoc request [:reader :extensions-declared?] false))
(defn w5-pipeline-invalid-hash [request]
  (w5-pipeline-nested-assoc request [:reader :source-hash] nil))

(defn w5-pipeline-invalid-type-mismatch [request]
  (w5-pipeline-nested-assoc request [:typed-core :constraints-solved?] false))
(defn w5-pipeline-invalid-annotation [request]

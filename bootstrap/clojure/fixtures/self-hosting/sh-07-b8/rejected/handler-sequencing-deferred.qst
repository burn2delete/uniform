(ns self-hosting.sh07-b8.reject.handler-sequencing-deferred
  (:profile :meta)
  (:target :jvm)
  (:effects #{:error/throw})
  (:capabilities #{})
  (:safety :safe)
  (:metadata
   {:slice :SH-07-B8
    :sh07-b8
    {:expected-rule "C6-LOWERING-GAP"
     :expected-stage :core-lowering
     :expected-severity :error
     :expected-reason :catch-handler-sequencing-deferred
     :expected-remediation
     "Wrap handler sequencing in an explicit do form; SH-07-B11 accepts one handler expression per catch clause."}}))

(def invalid-handler
  (try
    (throw "handler sequence")
    (catch Exception error
      error
      "second")))

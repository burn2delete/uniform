(ns self-hosting.sh07-b8.reject.non-symbol-catch-binding
  (:profile :meta)
  (:target :jvm)
  (:effects #{:error/throw})
  (:capabilities #{})
  (:safety :safe)
  (:metadata
   {:slice :SH-07-B8
    :sh07-b8
    {:expected-rule "C6-CORE-SHAPE"
     :expected-stage :core-lowering
     :expected-severity :error
     :expected-reason :catch-binding-symbol-required
     :expected-remediation
     "Use a resolved type symbol, one catch-local binding symbol, and exactly one handler expression."}}))

(def invalid-handler
  (try
    (throw "invalid binding")
    (catch Exception [error]
      "ignored")))

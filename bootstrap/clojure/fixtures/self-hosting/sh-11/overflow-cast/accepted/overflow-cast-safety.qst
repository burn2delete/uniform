(ns gravity.self-hosting.sh11.overflow-cast.accepted
  (:profile :meta)
  (:target :jvm)
  (:exports [sh11-authenticated-typed-add-operation
             sh11-authenticated-typed-multiply-operation
             sh11-authenticated-typed-cast-operation
             sh11-runtime-target-support
             sh11-authenticated-checked-operation])
  (:effects #{})
  (:capabilities #{})
  (:safety :safe))

(defn sh11-execute-guard-case
  [case-id kind operator contract operands]
  (let [left (first operands)
        right (first (rest operands))
        value (if (= kind :numeric-cast)
                left
                (if (= operator :add) (+ left right) (* left right)))
        source-width (if (= kind :numeric-cast)
                       (get contract :source-width)
                       (get contract :bit-width))
        source-signedness (if (= kind :numeric-cast)
                            (get contract :source-signedness)
                            (get contract :signedness))
        source-minimum (if (= source-signedness :unsigned)
                         0
                         (if (= source-width 8) -128 -32768))
        source-maximum (if (= source-width 8)
                         (if (= source-signedness :signed) 127 255)
                         (if (= source-signedness :signed) 32767 65535))
        left-member
        (if (>= left source-minimum) (<= left source-maximum) false)
        right-member
        (if (= kind :numeric-cast)
          true
          (if (>= right source-minimum)
            (<= right source-maximum)
            false))
        width (if (= kind :numeric-cast)
                (get contract :target-width)
                (get contract :bit-width))
        signedness (if (= kind :numeric-cast)
                     (get contract :target-signedness)
                     (get contract :signedness))
        minimum (if (= signedness :unsigned)
                  0
                  (if (= width 8) -128 -32768))
        maximum (if (= width 8)
                  (if (= signedness :signed) 127 255)
                  (if (= signedness :signed) 32767 65535))
        result-member (if (>= value minimum) (<= value maximum) false)
        passed
        (if left-member
          (if right-member result-member false)
          false)]
    {:case-id case-id
     :kind kind
     :operator operator
     :numeric-contract contract
     :operands operands
     :operand-membership
     (if (= kind :numeric-cast)
       [{:operand left :member left-member}]
       [{:operand left :member left-member}
        {:operand right :member right-member}])
     :computed-value value
     :result-membership result-member
     :guard-result (if passed :pass :fail)
     :failure-path (if passed :not-taken :error/numeric-raised)}))

(defn sh11-runtime-target-support []
  {:artifact :gravity/sh11-runtime-target-support
   :schema-version 1
   :target :jvm
   :provider :gravity/sh11-jvm-checked-integer-provider
   :failure-behavior :error/numeric
   :effects-introduced #{:error/raise}
   :performance-class :constant-time-branch
   :execution-evidence
   [(sh11-execute-guard-case :signed-add-max-inside :numeric-overflow :add
     {:bit-width 8 :signedness :signed} [126 1])
    (sh11-execute-guard-case :signed-add-max-outside :numeric-overflow :add
     {:bit-width 8 :signedness :signed} [127 1])
    (sh11-execute-guard-case :signed-add-min-inside :numeric-overflow :add
     {:bit-width 8 :signedness :signed} [-127 -1])
    (sh11-execute-guard-case :signed-add-min-outside :numeric-overflow :add
     {:bit-width 8 :signedness :signed} [-128 -1])
    (sh11-execute-guard-case
     :signed-add-cancellation-invalid-operands :numeric-overflow :add
     {:bit-width 8 :signedness :signed} [200 -100])
    (sh11-execute-guard-case :unsigned-add-max-inside :numeric-overflow :add
     {:bit-width 8 :signedness :unsigned} [254 1])
    (sh11-execute-guard-case :unsigned-add-max-outside :numeric-overflow :add
     {:bit-width 8 :signedness :unsigned} [255 1])
    (sh11-execute-guard-case :unsigned-add-min-inside :numeric-overflow :add
     {:bit-width 8 :signedness :unsigned} [0 0])
    (sh11-execute-guard-case :unsigned-add-min-outside :numeric-overflow :add
     {:bit-width 8 :signedness :unsigned} [0 -1])
    (sh11-execute-guard-case :signed-multiply-max-inside :numeric-overflow :multiply
     {:bit-width 8 :signedness :signed} [63 2])
    (sh11-execute-guard-case :signed-multiply-max-outside :numeric-overflow :multiply
     {:bit-width 8 :signedness :signed} [64 2])
    (sh11-execute-guard-case :signed-multiply-min-inside :numeric-overflow :multiply
     {:bit-width 8 :signedness :signed} [-64 2])
    (sh11-execute-guard-case :signed-multiply-min-outside :numeric-overflow :multiply
     {:bit-width 8 :signedness :signed} [-65 2])
    (sh11-execute-guard-case :unsigned-multiply-inside :numeric-overflow :multiply
     {:bit-width 8 :signedness :unsigned} [51 5])
    (sh11-execute-guard-case :unsigned-multiply-outside :numeric-overflow :multiply
     {:bit-width 8 :signedness :unsigned} [52 5])
    (sh11-execute-guard-case :unsigned-multiply-min :numeric-overflow :multiply
     {:bit-width 8 :signedness :unsigned} [0 255])
    (sh11-execute-guard-case
     :unsigned-multiply-cancellation-invalid-operand
     :numeric-overflow :multiply
     {:bit-width 8 :signedness :unsigned} [256 0])
    (sh11-execute-guard-case :signed-cast-min :numeric-cast :checked-narrowing
     {:source-width 16 :target-width 8 :source-signedness :signed
      :target-signedness :signed} [-128])
    (sh11-execute-guard-case :signed-cast-max :numeric-cast :checked-narrowing
     {:source-width 16 :target-width 8 :source-signedness :signed
      :target-signedness :signed} [127])
    (sh11-execute-guard-case :signed-cast-outside :numeric-cast :checked-narrowing
     {:source-width 16 :target-width 8 :source-signedness :signed
     :target-signedness :signed} [128])
    (sh11-execute-guard-case :signed-cast-low-outside :numeric-cast :checked-narrowing
     {:source-width 16 :target-width 8 :source-signedness :signed
      :target-signedness :signed} [-129])
    (sh11-execute-guard-case :signed-cast-source-outside
     :numeric-cast :checked-narrowing
     {:source-width 16 :target-width 8 :source-signedness :signed
      :target-signedness :signed} [40000])
    (sh11-execute-guard-case :unsigned-cast-min :numeric-cast :checked-narrowing
     {:source-width 16 :target-width 8 :source-signedness :unsigned
      :target-signedness :unsigned} [0])
    (sh11-execute-guard-case :unsigned-cast-max :numeric-cast :checked-narrowing
     {:source-width 16 :target-width 8 :source-signedness :unsigned
      :target-signedness :unsigned} [255])
    (sh11-execute-guard-case :unsigned-cast-outside :numeric-cast :checked-narrowing
     {:source-width 16 :target-width 8 :source-signedness :unsigned
      :target-signedness :unsigned} [256])
    (sh11-execute-guard-case :unsigned-cast-low-outside :numeric-cast :checked-narrowing
     {:source-width 16 :target-width 8 :source-signedness :unsigned
      :target-signedness :unsigned} [-1])]})

(defn sh11-authenticated-typed-numeric-operation
  [operation-id kind operator source operands numeric-contract]
  {:artifact :gravity/sh11-typed-numeric-core-operation
   :schema-version 1
   :operation-id operation-id
   :kind kind
   :operator operator
   :core-node-id (get source :core-node-id)
   :operands operands
   :numeric-contract numeric-contract
   :result-type :gravity.type/integer
   :effect-contract {:failure-behavior :error/numeric
                     :effects #{:error/raise}}
   :source-span (get source :source-span)
   :origin-chain (get source :origin-chain)
   :profile (get source :profile)
   :target (get source :target)
   :type-fact-id (get source :type-fact-id)
   :effect-fact-id (get source :effect-fact-id)
   :capability-proof-id (get source :capability-proof-id)
   :ownership-fact-id (get source :ownership-fact-id)})

(defn sh11-authenticated-typed-add-operation [source operands]
  (sh11-authenticated-typed-numeric-operation
   :authenticated-checked-add :numeric-overflow :add source operands
   {:bit-width 8 :signedness :signed}))

(defn sh11-authenticated-typed-multiply-operation [source operands]
  (sh11-authenticated-typed-numeric-operation
   :authenticated-checked-multiply :numeric-overflow :multiply source operands
   {:bit-width 8 :signedness :unsigned}))

(defn sh11-authenticated-typed-cast-operation [source operands]
  (sh11-authenticated-typed-numeric-operation
   :authenticated-checked-cast :numeric-cast :checked-narrowing source operands
   {:source-width 16 :target-width 8
    :source-signedness :signed :target-signedness :signed}))

(defn sh11-authenticated-checked-operation
  [typed-operation typed-operation-resolution
   target-support target-support-resolution invalidation-conditions]
  {:artifact :gravity/sh11-authenticated-overflow-cast-operation
   :schema-version 2
   :typed-operation typed-operation
   :typed-operation-resolution typed-operation-resolution
   :operation-id (get typed-operation :operation-id)
   :kind (get typed-operation :kind)
   :operator (get typed-operation :operator)
   :core-node-id (get typed-operation :core-node-id)
   :source-span (get typed-operation :source-span)
   :origin-chain (get typed-operation :origin-chain)
   :profile (get typed-operation :profile)
   :target (get typed-operation :target)
   :type-fact-id (get typed-operation :type-fact-id)
   :effect-fact-id (get typed-operation :effect-fact-id)
   :capability-proof-id (get typed-operation :capability-proof-id)
   :ownership-fact-id (get typed-operation :ownership-fact-id)
   :operands (get typed-operation :operands)
   :numeric-contract (get typed-operation :numeric-contract)
   :numeric-mode :checked
   :safety-mode :safe
   :failure-behavior :error/numeric
   :effects-introduced #{:error/raise}
   :performance-class :constant-time-branch
   :invalidation-conditions invalidation-conditions
   :target-support target-support
   :target-support-resolution target-support-resolution
   :target-support-id (get target-support-resolution :digest)
   :provider-id (get target-support :provider)
   :support-evidence (get target-support :execution-evidence)})

(defn w5-domain-schema-ai-invalid-artifact [request]
  (assoc request :artifact :gravity/not-domain-schema-ai))

(defn w5-domain-schema-ai-invalid-request-schema [request]
  (assoc request :schema-version 2))

(defn w5-domain-schema-ai-invalid-profile [request]
  (assoc request :profile :core))

(defn w5-domain-schema-ai-invalid-model [request]
  (let [model (get request :model)
        changed (assoc model :model-id :gpt-support)]
    (assoc request :model changed)))

(defn w5-domain-schema-ai-invalid-diagnostics [request]
  (assoc request :diagnostics [{:unexpected true}]))

(defn w5-domain-schema-ai-invalid-keyword-model [request]
  (let [agent (get request :agent)
        changed (assoc agent :model :gpt-support)]

(defn w5-domain-schema-ai-invalid-ambient-capability [request]
  (let [capabilities (get request :capabilities)
        changed (conj capabilities :network/read)]
    (assoc request :capabilities changed)))

(defn w5-domain-schema-ai-invalid-extra-capability [request]
  (let [agent (get request :agent)
        capabilities (get agent :capabilities)
        changed-agent (assoc agent :capabilities (conj capabilities :network/read))]
    (assoc request :agent changed-agent)))

(defn w5-domain-schema-ai-invalid-schema [request]
  (let [schema (get request :schema-manifest)
        changed (assoc schema :compatibility :breaking)]
    (assoc request :schema-manifest changed)))

(defn w5-domain-schema-ai-invalid-serializer [request]
  (let [serializer (get request :serializer)
        changed (assoc serializer :decoded-trust :validated-for-sink)]

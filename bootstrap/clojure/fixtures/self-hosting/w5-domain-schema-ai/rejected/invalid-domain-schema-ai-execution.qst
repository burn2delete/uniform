        changed (assoc tool :human-review :missing)]
    (assoc request :tool changed)))

(defn w5-domain-schema-ai-invalid-agent [request]
  (let [agent (get request :agent)
        memory (get agent :memory)
        changed-memory (assoc memory :mode :write)
        changed-agent (assoc agent :memory changed-memory)]
    (assoc request :agent changed-agent)))

(defn w5-domain-schema-ai-invalid-workflow [request]
  (let [workflow (get request :workflow)
        changed (assoc workflow :replay :live-ok)]
    (assoc request :workflow changed)))

(defn w5-domain-schema-ai-invalid-memory [request]
  (let [memory (get request :memory)
        changed (assoc memory :prompt-policy :system-authority)]
    (assoc request :memory changed)))

(defn w5-domain-schema-ai-invalid-policy [request]
  (let [policy (get request :policy)
        changed (assoc policy :fallback :allow-without-eval)]
    (assoc request :policy changed)))

(defn w5-domain-schema-ai-invalid-evaluation [request]
  (let [evaluation (get request :evaluation)
        probes (get evaluation :probes)
        changed (assoc evaluation :probes (rest probes))]
    (assoc request :evaluation changed)))

(defn w5-domain-schema-ai-invalid-human-review [request]
  (let [review (get request :human-review)
        changed (assoc review :status :granted)]
    (assoc request :human-review changed)))

(defn w5-domain-schema-ai-invalid-defense [request]
  (let [defense (get request :defense)
        changed (assoc defense :secret-policy :expose)]
    (assoc request :defense changed)))

(defn w5-domain-schema-ai-invalid-effects [request]
  (assoc request :effects #{:ai/model-call}))

(defn w5-domain-schema-ai-invalid-target [request]
  (let [target (get request :candidate-target)
        changed (assoc target :os :darwin)]
    (assoc request :candidate-target changed)))

(defn w5-domain-schema-ai-invalid-authority [request]
  (let [authority (get request :authority)
        changed (assoc authority :public? true)]
    (assoc request :authority changed)))

(defn dsai-extra-nested-set [request record-key set-key value]
  (let [record (get request record-key)
        changed (assoc record set-key (conj (get record set-key) value))]
    (assoc request record-key changed)))

(defn w5-domain-schema-ai-invalid-migration-extra-process [request]
  (dsai-extra-nested-set request :migration :effects :process/exec))

(defn w5-domain-schema-ai-invalid-migration-extra-shell [request]
  (dsai-extra-nested-set request :migration :capabilities :shell/exec))

(defn w5-domain-schema-ai-invalid-tool-extra-process [request]
  (dsai-extra-nested-set request :tool :effects :process/exec))

(defn w5-domain-schema-ai-invalid-tool-extra-shell [request]
  (dsai-extra-nested-set request :tool :capabilities :shell/exec))

(defn w5-domain-schema-ai-invalid-agent-extra-process [request]
  (dsai-extra-nested-set request :agent :effects :process/exec))

(defn w5-domain-schema-ai-invalid-agent-extra-shell [request]
  (dsai-extra-nested-set request :agent :capabilities :shell/exec))

(defn w5-domain-schema-ai-invalid-memory-extra-process [request]
  (dsai-extra-nested-set request :memory :effects :process/exec))

(defn w5-domain-schema-ai-invalid-memory-extra-shell [request]
  (dsai-extra-nested-set request :memory :capabilities :shell/exec))

(defn w5-domain-schema-ai-invalid-policy-extra-process [request]
  (dsai-extra-nested-set request :policy :allow :process/exec))

(defn w5-domain-schema-ai-invalid-policy-extra-shell [request]
  (dsai-extra-nested-set request :policy :allow :shell/exec))

(defn dsai-substitute-provider-identity [request field value]
  (let [provider (get request :provider)
        identity (get provider :identity)
        changed-identity (assoc identity field value)
        changed-provider (assoc provider :identity changed-identity)]
    (assoc request :provider changed-provider)))

(defn w5-domain-schema-ai-invalid-provider-identity-provider-id [request]
  (dsai-substitute-provider-identity
   request :provider-id :substituted-provider))

(defn w5-domain-schema-ai-invalid-provider-identity-model-id [request]
  (dsai-substitute-provider-identity
   request :model-id "substituted-model"))

(defn w5-domain-schema-ai-invalid-provider-identity-version [request]
  (dsai-substitute-provider-identity request :version "2"))

(defn w5-domain-schema-ai-invalid-provider-identity-adapter-version [request]
  (dsai-substitute-provider-identity request :adapter-version "2"))

(defn w5-domain-schema-ai-invalid-provider-identity-schema-mode [request]
  (dsai-substitute-provider-identity request :schema-mode :runtime-only))

(defn w5-domain-schema-ai-invalid-result [result]
  (assoc result :execution-status :complete))

(defn dsai-invalid-source-path [request path]
  (assoc request :provenance
         (assoc (get request :provenance)
                :actual-source-path path)))

(defn w5-domain-schema-ai-invalid-gravity-path-suffix [request]
  (dsai-invalid-source-path
   request
   "/substituted/domain-schema-ai-execution.qst"))

(defn w5-domain-schema-ai-invalid-qst-path-suffix [request]
  (dsai-invalid-source-path
   request
   "/substituted/domain-schema-ai-execution.gravity"))

(defn w5-domain-schema-ai-invalid-source-path-gravity [request]
  (w5-domain-schema-ai-invalid-gravity-path-suffix request))

(defn w5-domain-schema-ai-invalid-source-path-qst [request]
  (w5-domain-schema-ai-invalid-qst-path-suffix request))

(defn w5-domain-schema-ai-invalid-source-span-missing [request]
  (assoc request :source-span
         (dissoc (get request :source-span) :line)))

(defn w5-domain-schema-ai-invalid-source-span-extra [request]
  (assoc request :source-span
         (assoc (get request :source-span) :unexpected 1)))

(defn w5-domain-schema-ai-invalid-source-span-wrong-type [request]
  (assoc request :source-span
         (assoc (get request :source-span) :line "1")))

(defn w5-domain-schema-ai-invalid-source-span-negative [request]
  (assoc request :source-span
         (assoc (get request :source-span) :line -1)))

(defn w5-domain-schema-ai-invalid-source-span-negative-byte [request]
  (assoc request :source-span
         (assoc (get request :source-span) :start-byte -1)))

(defn w5-domain-schema-ai-invalid-source-span-negative-column [request]
  (assoc request :source-span
         (assoc (get request :source-span) :column -1)))

(defn w5-domain-schema-ai-invalid-source-span-order [request]
  (assoc request :source-span
         (assoc (get request :source-span) :start-byte 2
                :end-byte 1)))

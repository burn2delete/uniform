(defn w5-domain-schema-ai-invalid-provider [request]
  (let [provider (get request :provider)
        changed (assoc provider :credential-source :ambient)]
    (assoc request :provider changed)))

(defn w5-domain-schema-ai-invalid-prompt [request]
  (let [prompt (get request :prompt)
        authority (get prompt :authority)
        changed-authority (assoc authority :retrieved-data :developer-trusted)
        changed-prompt (assoc prompt :authority changed-authority)]
    (assoc request :prompt changed-prompt)))

(defn w5-domain-schema-ai-invalid-tool [request]

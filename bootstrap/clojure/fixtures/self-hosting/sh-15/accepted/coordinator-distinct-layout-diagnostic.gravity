(ns gravity.self-hosting.sh15.distinct-layout-diagnostic.accepted
  (:profile :meta) (:target :jvm)
  (:exports [coordinator-distinct-layout-diagnostic-request
             coordinator-distinct-layout-diagnostic-located-request])
  (:effects #{}) (:capabilities #{}) (:safety :safe))

; Original early rejection requests. Anchor labels remain unverified input
; facts; these incomplete requests never build authenticated layouts.
(defn coordinator-distinct-layout-diagnostic-request [anchor]
  {:profile :safe :target :portable :semantic-anchor {:anchor-id anchor}
   :layout-request {:value-id :authenticated-fixed-slots :kind :tuple}})

(defn coordinator-distinct-layout-diagnostic-located-request [anchor path]
  {:profile :safe :target :portable :semantic-anchor {:anchor-id anchor}
   :layout-request
   {:value-id :authenticated-fixed-slots :kind :tuple
    :source-span {:source-id :fixture :actual-source-path path
                  :start {:byte 0 :line 1 :column 1}
                  :end {:byte 1 :line 1 :column 2}}
    :origin-chain [{:kind :source :source-id :fixture :actual-source-path path}]}})

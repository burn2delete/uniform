(ns gravity.self-hosting.sh15.origin-location.accepted
  (:profile :meta) (:target :jvm)
  (:exports [coordinator-origin-location-request])
  (:effects #{}) (:capabilities #{}) (:safety :safe))

(defn coordinator-origin-location-request [path]
  {:profile :safe :target :portable :semantic-anchor {:anchor-id "origin-location"}
   :layout-request
   {:value-id :authenticated-fixed-slots :kind :tuple
    :source-span {:source-id :fixture :actual-source-path "/source.gravity"
                  :start {:byte 0 :line 1 :column 1}
                  :end {:byte 1 :line 1 :column 2}}
    :origin-chain [{:kind :source :source-id :fixture :actual-source-path path}]}})

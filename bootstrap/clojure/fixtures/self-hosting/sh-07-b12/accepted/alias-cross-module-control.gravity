; SH-07-B12 alias, referred, and fully qualified module controls.
(ns self-hosting.sh07-b12.alias-cross-module-control
  (:profile :meta)
  (:target :jvm)
  (:requires [shared.core :as shared :profile :core
              :boundary :pure-core :refer [checksum]])
  (:exports [alias-control referred-control qualified-control])
  (:effects #{})
  (:capabilities #{})
  (:safety :safe)
  (:metadata {:slice :SH-07-B12
              :fixture :alias-cross-module-control
              :non-claims [:cross-profile-execution
                           :runtime-linking
                           :whole-program-execution]}))

(def alias-control
  shared/checksum)

(def referred-control
  checksum)

(def qualified-control
  shared.core/checksum)

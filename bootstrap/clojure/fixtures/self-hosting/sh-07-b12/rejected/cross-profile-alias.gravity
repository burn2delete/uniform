; SH-07-B12 rejects an alias edge without an accepted profile boundary.
(ns self-hosting.sh07-b12.reject.cross-profile-alias
  (:profile :kernel)
  (:target :jvm)
  (:requires [hosted.ui :as ui :profile :hosted])
  (:effects #{})
  (:capabilities #{})
  (:safety :safe)
  (:metadata
   {:slice :SH-07-B12
    :case :cross-profile-alias
    :non-claims [:profile-boundary-lowering
                 :runtime-linking
                 :whole-program-execution]
    :sh07-b12
    {:expected-rule "C5-CROSS-PROFILE"
     :expected-stage :name-resolution
     :expected-severity :error
     :expected-reason :cross-profile-boundary-rejected
     :expected-remediation
     "Use a pure core, facade, schema, FFI-like, or generated-artifact boundary."}}))

(def invalid-reference
  ui/render)

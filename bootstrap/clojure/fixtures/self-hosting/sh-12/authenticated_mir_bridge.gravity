                                    (set?
                                     (get audit
                                          :preconditions))
                                    (>
                                     (count
                                      (get audit
                                           :preconditions))
                                     0)
                                    false)
                                   (if
                                    (if
                                     (set?
                                      (get audit
                                           :postconditions))
                                     (>
                                      (count
                                       (get audit
                                            :postconditions))
                                      0)
                                     false)
                                    (if
                                     (if
                                      (set?
                                       (get audit
                                            :invariants))
                                      (>
                                       (count
                                        (get audit
                                             :invariants))
                                       0)
                                      false)
                                     (if
                                      (if
                                       (set?
                                        (get audit
                                             :evidence))
                                       (>
                                        (count

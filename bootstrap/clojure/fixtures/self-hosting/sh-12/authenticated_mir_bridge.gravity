                                              :empty-effects-approved
                                              :empty-capabilities-approved}
                                            (set
                                             (keys
                                              (get audit
                                                   :policy))))
                                           (if
                                            (sh12-unsafe-policy-valid?
                                             request audit)
                                            (keyword?
                                             (get audit
                                                  :re-review))
                                            false)
                                           false)
                                          false)
                                         false)
                                        false)
                                       false)
                                      false)
                                     false)
                                    false)

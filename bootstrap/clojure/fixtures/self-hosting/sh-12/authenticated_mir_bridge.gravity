                                              :evidence))
                                        0)
                                       false)
                                      (if
                                       (if
                                        (string?
                                         (get audit
                                              :safe-wrapper))
                                        (>
                                         (count
                                          (get audit
                                               :safe-wrapper))
                                         0)
                                        false)

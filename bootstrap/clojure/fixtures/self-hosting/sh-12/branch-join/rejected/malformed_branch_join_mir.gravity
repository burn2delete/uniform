; Rejected SH-12 mutations for the bounded branch/join MIR verifier.
(ns gravity.self-hosting.sh12.branch-join.rejected
  (:profile :meta)
  (:target :jvm)
  (:exports [sh12-branch-join-rejection-cases
             sh12-malformed-branch-join-mir
             sh12-checked-core-rejection-cases
             sh12-runtime-checked-core
             sh12-malformed-checked-core])
  (:effects #{})
  (:capabilities #{})
  (:safety :safe))

(defn sh12-add-actual-source-path [cases actual-source-path result]
  (if (= (count cases) 0)
    result
    (sh12-add-actual-source-path
     (rest cases) actual-source-path
     (conj result
           (assoc (first cases)
                  :actual-source-path actual-source-path)))))

(defn sh12-branch-join-rejection-cases [actual-source-path]
  (sh12-add-actual-source-path
   [{:case :malformed-module
    :diagnostic-id "C11-MODULE"
    :missing-fact :mir-module-artifact}
   {:case :module-boundary-escalation
    :diagnostic-id "C11-MODULE"
    :missing-fact :module-identity-or-target-independence}
   {:case :malformed-functions-carrier
    :diagnostic-id "C11-MODULE"
    :missing-fact :module-function-carrier}
   {:case :malformed-block
    :diagnostic-id "C11-BLOCK"
    :missing-fact :block-carrier}
   {:case :malformed-blocks-carrier
    :diagnostic-id "C11-BLOCK"
    :missing-fact :block-carrier}
   {:case :function-fact-loss
    :diagnostic-id "C11-VERIFY"
    :missing-fact :ownership-capability-profile-or-provenance-fact}
   {:case :operation-authority-escalation
    :diagnostic-id "C11-VERIFY"
    :missing-fact :ownership-capability-profile-or-provenance-fact}
   {:case :malformed-edge
    :diagnostic-id "C11-BLOCK"
    :missing-fact :block-terminator-or-control-flow-edge}
   {:case :malformed-terminator
    :diagnostic-id "C11-BLOCK"
    :missing-fact :block-terminator-or-control-flow-edge}
   {:case :malformed-value
    :diagnostic-id "C11-DOMINANCE"
    :missing-fact :definitions-uses-or-edge-dominance}
   {:case :malformed-data-carrier
    :diagnostic-id "C11-DOMINANCE"
    :missing-fact :data-flow-carrier}
   {:case :type-fact-loss
    :diagnostic-id "C11-TYPE"
    :missing-fact :type-fact-or-operation-schema}
   {:case :effect-fact-loss
    :diagnostic-id "C11-EFFECT"
    :missing-fact :effect-fact-or-ordering}
   {:case :ownership-fact-loss
    :diagnostic-id "C11-VERIFY"
    :missing-fact :ownership-capability-profile-or-provenance-fact}
   {:case :capability-fact-loss
    :diagnostic-id "C11-VERIFY"
    :missing-fact :ownership-capability-profile-or-provenance-fact}
   {:case :capability-proof-loss
    :diagnostic-id "C11-VERIFY"
    :missing-fact :ownership-capability-profile-or-provenance-fact}
   {:case :profile-target-fact-loss
    :diagnostic-id "C11-VERIFY"
    :missing-fact :ownership-capability-profile-or-provenance-fact}
   {:case :provenance-fact-loss
    :diagnostic-id "C11-VERIFY"
    :missing-fact :ownership-capability-profile-or-provenance-fact}
   {:case :safety-fact-loss
    :diagnostic-id "C11-SAFETY"
    :missing-fact :safety-outcome-or-runtime-check-fact}
   {:case :source-fact-loss
    :diagnostic-id "C11-ORIGIN"
    :missing-fact :source-span-or-origin-fact}]
   actual-source-path []))


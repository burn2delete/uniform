         {:compiler-plan :foreign :runtime :foreign
          :authority :seed-only :execution-status :harness-only}))

(defn w5-reader-module-invalid-span-request-at [request]
  (assoc request :source-span
         (assoc (get request :source-span) :line 0)))

(defn w5-reader-module-invalid-span-missing-request-at [request]
  (dissoc request :source-span))

(defn w5-reader-module-invalid-span-extra-request-at [request]
  (assoc request :source-span
         (assoc (get request :source-span) :extra true)))

(defn w5-reader-module-invalid-span-type-request-at [request]
  (assoc request :source-span
         (assoc (get request :source-span) :start-byte "zero")))

(defn w5-reader-module-invalid-span-negative-request-at [request]
  (assoc request :source-span
         (assoc (get request :source-span) :start-byte -1)))

(defn w5-reader-module-invalid-span-order-request-at [request]
  (assoc request :source-span
         (assoc (get request :source-span)
                :start-byte 513 :end-byte 512)))

(defn w5-reader-module-invalid-target-request-at [request]
  (assoc request :target :native))

(defn w5-reader-module-invalid-source-unit-request-at [request]
  (assoc request :source-unit
         (assoc (get request :source-unit)
                :source-content-status :corrupt)))


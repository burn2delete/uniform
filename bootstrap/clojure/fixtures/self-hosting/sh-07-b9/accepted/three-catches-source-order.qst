; SH-07-B9 preserves three typed handler candidates in source order.
(ns self-hosting.sh07-b9.three-catches-source-order
  (:profile :meta)
  (:target :jvm)
  (:exports [recover-three])
  (:effects #{:error/throw})
  (:capabilities #{})
  (:safety :safe)
  (:metadata {:slice :SH-07-B9
              :fixture :three-catches-source-order
              :legality :pending-sh08-sh09-sh10-sh11}))

(defn recover-three [value]
  (try
    (throw value)
    (catch RuntimeException runtime-error
      runtime-error)
    (catch Exception general-error
      general-error)
    (catch Throwable throwable-error
      throwable-error)))

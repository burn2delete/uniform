(ns self-hosting.sh07-b9.reject.later-catch-empty-handler
  (:profile :meta)
  (:target :jvm)
  (:effects #{:error/throw})
  (:capabilities #{})
  (:safety :safe)
  (:metadata
   {:slice :SH-07-B9
    :sh07-b9
    {:expected-rule "C6-CORE-SHAPE"
     :expected-stage :core-lowering
     :expected-severity :error
     :expected-reason :catch-handler-expression-required
     :expected-remediation
     "Provide exactly one handler expression after the catch-local binding."}}))

(def invalid-handler
  (try
    (throw "empty later handler")
    (catch Exception error
      error)
    (catch Throwable fallback)))

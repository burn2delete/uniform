; SH-07-B3 let scopes nested below call and conditional nodes.
(ns self-hosting.sh07-b3.let-in-call-control
  (:profile :meta)
  (:target :jvm)
  (:exports [identity nested-let])
  (:effects #{})
  (:capabilities #{})
  (:safety :safe)
  (:metadata {:slice :SH-07-B3 :fixture :let-in-call-control}))

(defn identity [value]
  value)

(def nested-let
  (identity
    (if true
      (let [selected 21]
        selected)
      (let [selected 22]
        selected))))

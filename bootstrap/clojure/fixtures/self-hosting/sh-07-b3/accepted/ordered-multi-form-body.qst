; SH-07-B3 multiple body expressions preserve source order.
(ns self-hosting.sh07-b3.ordered-multi-form-body
  (:profile :meta)
  (:target :jvm)
  (:exports [ordered-body])
  (:effects #{})
  (:capabilities #{})
  (:safety :safe)

; SH-07-B10 resolves a binding pattern only inside its selected branch.
(ns self-hosting.sh07-b10.branch-local-binding
  (:profile :meta)
  (:target :jvm)
  (:exports [resolve-branch-local])
  (:effects #{})
  (:capabilities #{})
  (:safety :safe)
  (:metadata {:slice :SH-07-B10
              :fixture :branch-local-binding
              :legality :pending-sh08-sh09-sh10-sh11}))

(defn resolve-branch-local [value]
  (let [item :outer]
    (match value
      0 item
      item item)))

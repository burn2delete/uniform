                         #{:read-mir :write-mir :register-pass
                           :emit-diagnostics :emit-artifacts}}
     :artifact-access #{:read-input-mir :write-output-mir}
     :restricted-authority #{:filesystem :network :process :environment
                             :clock :random :model-call :tool-call
                             :registry-access :compiler-private-state}
     :denied-authority #{:filesystem :network :process :environment

(defn w5-c17-invalid-manifest-request [actual-source-path]
  (dissoc (w5-c17-base-request actual-source-path) :manifest))

(defn w5-c17-incompatible-api-request [actual-source-path]
  (assoc (w5-c17-base-request actual-source-path) :compiler-api-version "9"))

(defn w5-c17-unversioned-api-request [actual-source-path]
  (let [request (w5-c17-base-request actual-source-path)]
    (assoc request :manifest
           (assoc (get request :manifest) :api-version nil))))

(defn w5-c17-missing-capability-request [actual-source-path]
  (let [scopes #{:read-mir :register-pass :emit-diagnostics :emit-artifacts}]
    (let [request (w5-c17-base-request actual-source-path)
          manifest (get request :manifest)
          grant (get request :capability-grant)
          sandbox (get request :sandbox)
          manifest-scopes (assoc (get manifest :capability-scopes)
                                 :compiler/ir-transform scopes)
          sandbox-scopes (assoc (get sandbox :capability-scopes)
                                :compiler/ir-transform scopes)
          sandbox-grants (assoc (get sandbox :grants)
                                :compiler/ir-transform scopes)]
      (assoc request
             :requested-scopes scopes
             :manifest (assoc manifest :capability-scopes manifest-scopes)
             :capability-grant (assoc grant :scopes scopes)
             :sandbox (assoc sandbox
                            :capability-scopes sandbox-scopes
                            :grants sandbox-grants)))))

(defn w5-c17-excess-capability-request [actual-source-path]
  (let [scopes #{:read-mir :write-mir :register-pass
                :emit-diagnostics :emit-artifacts
                :query-compiler-configuration}]
    (let [request (w5-c17-base-request actual-source-path)
          manifest (get request :manifest)
          grant (get request :capability-grant)
          sandbox (get request :sandbox)
          manifest-scopes (assoc (get manifest :capability-scopes)
                                 :compiler/ir-transform scopes)
          sandbox-scopes (assoc (get sandbox :capability-scopes)
                                :compiler/ir-transform scopes)
          sandbox-grants (assoc (get sandbox :grants)
                                :compiler/ir-transform scopes)]
      (assoc request
             :requested-scopes scopes
             :manifest (assoc manifest :capability-scopes manifest-scopes)
             :capability-grant (assoc grant :scopes scopes)
             :sandbox (assoc sandbox
                            :capability-scopes sandbox-scopes
                            :grants sandbox-grants)))))

(defn w5-c17-hidden-authority-request [actual-source-path]
  (let [request (w5-c17-base-request actual-source-path)]
    (assoc request :plugin-code
           (assoc (get request :plugin-code) :hidden-state? true))))

(defn w5-c17-build-effect-request [actual-source-path]
  (let [request (w5-c17-base-request actual-source-path)]
    (assoc request
           :manifest (assoc (get request :manifest)
                            :build-effects #{:network-fetch})
           :build-effect-grants #{:network-fetch}
           :sandbox (assoc (get request :sandbox)
                           :build-effects #{:network-fetch}))))

(defn w5-c17-sandbox-request [actual-source-path]
  (let [request (w5-c17-base-request actual-source-path)]
    (assoc request :sandbox
           (assoc (get request :sandbox)
                  :denied-authority
                  #{:network :process :environment :clock :random
                    :model-call :tool-call :registry-access
                    :compiler-private-state}))))

(defn w5-c17-invalid-pass-contract-request [actual-source-path]
  (let [request (w5-c17-base-request actual-source-path)]
    (assoc request :pass-contract
           (assoc (get request :pass-contract)
                  :preserves #{:source-spans}))))

(defn w5-c17-invalid-preservation-request [actual-source-path]
  (let [request (w5-c17-base-request actual-source-path)
        output (get request :output-artifact)]
    (assoc request :output-artifact
           (assoc output :facts
                  (assoc (get output :facts)
                         :type-facts :facts/types-dropped)))))

(defn w5-c17-opaque-domain-request [actual-source-path]
  (let [request (w5-c17-base-request actual-source-path)
        domain (get request :domain-registration)]
    (assoc request :domain-registration
           (assoc domain :payload
                  (assoc (get domain :payload) :opaque? true)))))

(defn w5-c17-opaque-facet-request [actual-source-path]
  (let [request (w5-c17-base-request actual-source-path)
        facet (get request :facet-registration)]
    (assoc request :facet-registration
           (assoc facet :payload
                  (assoc (get facet :payload) :opaque? true)))))

(defn w5-c17-unverifiable-output-request [actual-source-path]
  (let [request (w5-c17-base-request actual-source-path)
        output (get request :output-artifact)]
    (assoc request :output-artifact
           (assoc output :verifier
                  (assoc (get output :verifier) :result :failed)))))

(defn w5-c17-output-substitution-request [actual-source-path]
  (let [request (w5-c17-base-request actual-source-path)]
    (assoc request :output-artifact
           (assoc (get request :output-artifact)
                  :semantic-value :substituted))))

(defn w5-c17-trust-policy-request [actual-source-path]
  (let [request (w5-c17-base-request actual-source-path)]
    (assoc request :trust-record
           (assoc (get request :trust-record)
                  :policy-decision :rejected))))

(defn w5-c17-invalid-signature-request [actual-source-path]
  (let [request (w5-c17-base-request actual-source-path)
        manifest (get request :manifest)
        package (get manifest :package)
        signature (first (get package :signatures))]
    (assoc request :manifest
           (assoc manifest :package
                  (assoc package :signatures
                         [(assoc signature :status :unverified)])))))

(defn w5-c17-revoked-signature-request [actual-source-path]
  (let [request (w5-c17-base-request actual-source-path)]
    (assoc request :trust-record
           (assoc (get request :trust-record)
                  :revocation-status :revoked))))

(defn w5-c17-invalid-provenance-request [actual-source-path]
  (assoc (w5-c17-base-request actual-source-path) :provenance
         (assoc (get (w5-c17-base-request actual-source-path) :provenance)
                :forged-field true)))

(defn w5-c17-invalid-source-span-request [actual-source-path]
  (assoc (w5-c17-base-request actual-source-path) :source-span
         {:source-id :gravity.compiler/w5-c17-rejected-fixture
          :start 12
          :end -1}))

(defn w5-c17-invalid-pass-identity-request [actual-source-path]
  (let [request (w5-c17-base-request actual-source-path)]
    (assoc request :pass-contract
           (assoc (get request :pass-contract)
                  :plugin :gravity.plugins/substituted))))

(defn w5-c17-invalid-pass-registration-request [actual-source-path]
  (let [request (w5-c17-base-request actual-source-path)
        manifest (get request :manifest)]
    (assoc request :manifest
           (assoc manifest :passes [:w5/unregistered-pass]))))

(defn w5-c17-coherent-registration-plugin-substitution-request
  [actual-source-path]
  (let [request (w5-c17-base-request actual-source-path)
        domain (get request :domain-registration)
        facet (get request :facet-registration)]
    (assoc request
           :domain-registration
           (assoc domain :plugin :gravity.plugins/substituted-registration)
           :facet-registration
           (assoc facet :plugin :gravity.plugins/substituted-registration))))

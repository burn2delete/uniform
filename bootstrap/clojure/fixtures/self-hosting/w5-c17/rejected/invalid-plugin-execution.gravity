   :dependency-graph [:gravity/compiler-api-v1]})

(defn w5-c17-manifest [actual-source-path]
  {:artifact :gravity/compiler-plugin
   :plugin :gravity.plugins/w5-c17-deterministic
   :package (w5-c17-package)
   :api-version "1"
   :compiler-compatibility {:min "1" :max-exclusive "2"
                            :declared-features #{:mir-identity-pass}
                            :required-contracts #{:C17 :C16}

; Co-canonical rejected W5/C17 plugin-pass requests.
; Each exported request violates exactly one C17 policy family while keeping
; the remaining descriptor fields deterministic and path-neutral.
(ns gravity.self-hosting.w5-c17.rejected
  (:profile :meta)
  (:target :jvm)
  (:exports [w5-c17-invalid-manifest-request
             w5-c17-incompatible-api-request

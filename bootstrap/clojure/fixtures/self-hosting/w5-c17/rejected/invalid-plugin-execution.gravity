(defn w5-c17-base-request [actual-source-path]
  (let [replay {:mode :deterministic :events []}
        facts {:source-spans :facts/source-v1
               :origin-chain :facts/origin-v1
               :type-facts :facts/types-v1
               :effect-facts :facts/effects-v1
               :capability-facts :facts/capabilities-v1}
        input {:artifact-id
               "sha256:5555555555555555555555555555555555555555555555555555555555555555"
               :kind :gravity/mir
               :facts facts
               :semantic-value :identity}
        output {:artifact-id
                "sha256:6666666666666666666666666666666666666666666666666666666666666666"
                :kind :gravity/mir
                :facts facts
                :semantic-value :identity
                :verifier {:id :gravity/mir-verifier
                           :version "1"
                           :result :passed}
                :verifier-result :passed}]
    {:artifact :gravity/w5-c17-plugin-request
     :request-id :rejected
     :compiler-api-version "1"
     :profile :meta
     :target :llvm-x86_64-linux
     :stage2-target :jvm
     :candidate-target :llvm-x86_64-linux
     :candidate-platform {:os :linux :arch :x86_64 :backend :llvm
                          :artifact-format :elf :abi :sysv-amd64}
     :target-scope (w5-c17-target-scope)
     :unsupported-targets [:darwin :darwin-arm64 :darwin-x86_64 :windows]
     :unsupported-target-policies
     [{:target :darwin :support :unsupported
       :invokes-clojure? false :links-jvm? false :fallback? false}
      {:target :darwin-arm64 :support :unsupported
       :invokes-clojure? false :links-jvm? false :fallback? false}
      {:target :darwin-x86_64 :support :unsupported
       :invokes-clojure? false :links-jvm? false :fallback? false}
      {:target :windows :support :unsupported
       :invokes-clojure? false :links-jvm? false :fallback? false}]
     :cross-target-inference? false
     :fallback? false
     :source-span (w5-c17-source-span)
     :provenance {:logical-source-id :gravity.compiler/w5-c17-rejected-fixture
                  :actual-source-path
                  actual-source-path
                  :source-hash
                  "sha256:7777777777777777777777777777777777777777777777777777777777777777"
                  :compiled-by :clojure-stage0
                  :verified-by :clojure-stage0
                  :stage :stage2
                  :target :llvm-x86_64-linux
                  :candidate-platform {:os :linux :arch :x86_64 :backend :llvm
                                       :artifact-format :elf :abi :sysv-amd64}
                  :target-scope (w5-c17-target-scope)
                  :fixture-kind :rejected}
     :manifest (w5-c17-manifest actual-source-path)
     :trust-record {:package :gravity/w5-c17-plugin
                    :signature-status :verified
                    :policy-decision :accepted
                    :revocation-status :clear

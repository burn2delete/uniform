   :target :llvm-x86_64-linux
   :candidate-target :llvm-x86_64-linux
   :candidate-platform {:os :linux :arch :x86_64 :backend :llvm
                        :artifact-format :elf :abi :sysv-amd64}
   :target-scope (w5-c17-target-scope)
   :build-effects #{}
   :capabilities #{:compiler/ir-transform}
   :capability-scopes {:compiler/ir-transform
                       #{:read-mir :write-mir :register-pass
                         :emit-diagnostics :emit-artifacts}}
   :passes [:w5/plugin-execution]
   :domains [:w5/plugin-domain]
   :facets [:w5/plugin-facet]
   :emits #{:plugin-execution-trace :verifier-report}
   :conformance [:w5-c17-accepted :w5-c17-rejected
                 :w5-c17-domain-fixture :w5-c17-facet-fixture]

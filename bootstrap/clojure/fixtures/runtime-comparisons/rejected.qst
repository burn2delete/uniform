(ns fixture.runtime-comparisons.rejected (:profile :hosted) (:target :jvm) (:effects #{}) (:capabilities #{}))
(defn equal-no-arguments [] (=))
(defn less-unary [] (< 1))
(defn greater-unary [] (> 1))
(defn less-equal-unary [] (<= 1))
(defn greater-equal-unary [] (>= 1))
(defn less-wrong-operand [] (< "bad" 1))
(defn greater-wrong-operand [] (> "bad" 1))
(defn less-equal-wrong-operand [] (<= "bad" 1))
(defn greater-equal-wrong-operand [] (>= "bad" 1))

(ns fixture.runtime-values.accepted (:profile :hosted) (:target :jvm) (:effects #{}) (:capabilities #{}))
(defn string-empty [] (str))
(defn string-nil [] (str nil))
(defn string-number [] (str 7))
(defn string-binary [] (str "v=" 7))
(defn string-ternary [] (str "a" 1 "b"))
(defn string-many [] (str "a" nil false 7 "z"))
(defn string-ratio [] (str (/ 1 2)))
(defn lookup-map [] (get {:a 7} :a))
(defn lookup-missing [] (get {:a 7} :b))
(defn lookup-default [] (get {:a 7} :b 9))
(defn lookup-nil-value [] (get {:a nil} :a 9))
(defn lookup-false-value [] (get {:a false} :a 9))
(defn lookup-vector [] (get [7 9] 1))
(defn lookup-vector-default [] (get [7 9] 9 -1))
(defn lookup-nil [] (get nil :a))
(defn lookup-nil-default [] (get nil :a :missing))
(defn lookup-vector-value [] (get {:a [1 2]} :a))

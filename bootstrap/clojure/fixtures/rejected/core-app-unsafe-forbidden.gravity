(ns core.app.unsafe-forbidden
  (:profile :hosted)
  (:target :jvm)
  (:effects #{:io/write})
  (:capabilities #{:io/stdout})
  (:safety :safe))

(defn main []
  (unsafe
    {:reason :host-reflection
     :operation :reflection/use
     :owner "stage0"
     :profiles [:hosted]
     :target :jvm
     :effects #{:reflection/use}
     :capabilities #{:host/reflection}
     :invariants #{:no-safe-state-leak}
     :safe-boundary main
     :review :local-review}
    (println "unsafe")))

(ns core.app.ai-prompt-authority
  (:profile :hosted)
  (:target :jvm)
  (:effects #{:io/write})
  (:capabilities #{:io/stdout})
  (:safety :safe)
  (:metadata {:ai {:compiled-gate
                   {:prompts
                    [{:prompt-id :classify-ticket
                      :authority-partition :mixed-trusted-and-user-data}]}}}))

(defn main []
  (println "bad ai prompt authority"))

(ns core.app.schema-openapi
  (:profile :hosted)
  (:target :jvm)
  (:effects #{:io/write})
  (:capabilities #{:io/stdout})
  (:safety :safe)
  (:metadata {:schema {:compiled-gate
                       {:api-projections
                        [{:graphql {:artifact :gravity/graphql-generation
                                    :resolver-adapter
                                    {:capability-check :runtime-enforced}
                                    :capabilities #{:db/query}}
                          :openapi {:artifact :gravity/openapi-generation}}]}}}))

(defn main []
  (println "bad schema openapi"))

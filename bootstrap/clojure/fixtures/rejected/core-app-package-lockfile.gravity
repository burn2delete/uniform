(ns core.app.package-lockfile
  (:profile :hosted)
  (:target :jvm)
  (:effects #{:io/write})
  (:capabilities #{:io/stdout})
  (:safety :safe)
  (:metadata {:package {:compiled-gate
                        {:project-manifests
                         [{:package-id "acme/support-agent"
                           :version "0.3.0"
                           :lockfile-complete false}]}}}))

(defn main []
  (println "bad package lockfile"))

(ns math.efir-domain
  (:profile :native)
  (:target :jvm)
  (:effects #{})
  (:capabilities #{})
  (:safety :safe)
  (:metadata
   {:math
    {:efir
     {:elementary-declarations
      [{:function-id :math/bad-domain
        :source-span "math/efir-domain.gravity:8:1"
        :domain {'x {:real [-8.0 8.0]}}
        :domain-valid? false
        :codomain {:real [0.0 1.0]}
        :branch-policy :real-only
        :branch-compatible? true
        :exceptional-values {:nan :propagate}

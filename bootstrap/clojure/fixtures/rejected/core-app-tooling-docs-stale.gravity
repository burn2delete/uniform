(ns core.app.tooling-docs-stale
  (:profile :hosted)
  (:target :jvm)
  (:effects #{:io/write})
  (:capabilities #{:io/stdout})
  (:safety :safe)
  (:metadata {:tooling {:compiled-gate
                        {:documentation-artifacts
                         [{:tool-id :gravity-doc
                           :stale? true
                           :fresh? false}]}}}))

(defn main []
  (println "bad tooling docs stale"))

(ns profile.bad.compatibility-facade
  (:profile :hosted)
  (:target :jvm)
  (:requires [native.sys :as sys
              :profile :native
              :edge :facade-required
              :boundary :facade
              :evidence #{:typed-api :safety-proof}
              :producer-effects #{}
              :producer-capabilities #{}
              :memory {:hidden-allocation :declared}
              :runtime {:required false :providers #{}}])
  (:effects #{})
  (:capabilities #{})
  (:safety :safe))

(def value 1)

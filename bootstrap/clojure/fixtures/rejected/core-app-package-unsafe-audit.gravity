(ns core.app.package-unsafe-audit
  (:profile :hosted)
  (:target :jvm)
  (:effects #{:io/write})
  (:capabilities #{:io/stdout})
  (:safety :safe)
  (:metadata {:package {:compiled-gate
                        {:package-safety-records
                         [{:artifact-id "package-safety:bad"
                           :unsafe-islands ["ffi.clock/read-monotonic"]}]}}}))

(defn main []
  (println "bad package unsafe audit"))

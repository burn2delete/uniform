  (:safety :safe)
  (:metadata {:ai {:compiled-gate
                   {:workflows
                    [{:workflow-id "triage-ticket"
                      :replay-mode :live-side-effects}]}}}))

(defn main []
  (println "bad ai workflow replay"))

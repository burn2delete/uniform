(ns core.app.runtime-observability-sink
  (:profile :hosted)
  (:target :jvm)
  (:effects #{:io/write})
  (:capabilities #{:io/stdout})
  (:safety :safe)
  (:metadata {:runtime {:compiled-gate
                        {:observability-sinks
                         [{:event-id "event/core-app"
                           :artifact-id :runtime/core-app
                           :sink :network-telemetry
                           :capability :observability/write
                           :sink-capability-granted? false
                           :redaction-policy :none}]}}}))

(defn main []
  (println "bad runtime observability"))

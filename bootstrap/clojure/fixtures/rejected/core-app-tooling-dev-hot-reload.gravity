(ns core.app.tooling-dev-hot-reload
  (:profile :hosted)
  (:target :jvm)
  (:effects #{:io/write})
  (:capabilities #{:io/stdout})
  (:safety :safe)
  (:metadata {:tooling {:compiled-gate
                        {:dev-server-sessions
                         [{:tool-id :gravity-dev
                           :hot-reload-decisions
                           [{:decision :hot-swap}]}]}}}))

(defn main []
  (println "bad tooling dev hot reload"))

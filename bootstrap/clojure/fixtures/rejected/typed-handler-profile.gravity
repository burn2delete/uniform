(ns typed.handler.profile
  (:profile :hardware)
  (:target :jvm)
  (:exports [bad])
  (:effects #{:network/http})
  (:capabilities #{:test/fixture})
  (:safety :safe)
  (:metadata {:handler-grants #{:test/fixture}}))

(def bad
  (effect/handle :network/http :test/http-fixture
    (http/get "https://example.test")))

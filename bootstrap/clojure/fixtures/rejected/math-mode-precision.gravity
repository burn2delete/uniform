(ns math.mode-precision
  (:profile :native)
  (:target :jvm)
  (:effects #{})
  (:capabilities #{})
  (:safety :safe)
  (:metadata {:math {:numeric
                     {:mode-records
                      [{:record-id :missing-quality
                        :math/mode :certified-approx
                        :scope {:kind :function :name 'math.mode/sin}
                        :precision {:type :F32}
                        :rounding :nearest-even
                        :float-exceptions {:nan :propagate
                                           :inf :domain-error
                                           :signed-zero :preserve
                                           :denormals :preserve}}]}}}))

(ns math.float-zero
  (:profile :native)
  (:target :jvm)
  (:effects #{})
  (:capabilities #{})
  (:safety :safe)
  (:metadata {:math {:numeric
                     {:floating-manifests
                      [{:operation :bad-zero
                        :format :binary64
                        :rounding :nearest-ties-to-even
                        :numeric-mode :faithful
                        :precision {:ulp-max 1}
                        :exceptions {:invalid :quiet-nan}
                        :nan {:quiet :propagate :signaling :quiet-and-flag}
                        :infinity :ieee754
                        :signed-zero :collapse
                        :denormals :preserve
                        :status-flags :unobservable-by-mode
                        :fma :forbidden
                        :reassociation :forbidden
                        :reciprocal-substitution :forbidden
                        :determinism :target-stable
                        :backend-lowering {:preserves-manifest? true
                                           :eligible? true
                                           :status-preserved? true}}]}}}))

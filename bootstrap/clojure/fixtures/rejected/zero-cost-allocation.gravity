  (:target :jvm)
  (:effects #{})
  (:capabilities #{})
  (:safety :safe-optimized)
  (:metadata {:performance
              {:claim
               {:claim-id :perf/zero-cost-allocation
                :profile :native
                :target :llvm-x86-64-linux
                :target-features #{:avx2}
                :input-shape {:element-type :f32}
                :layout {:buffer :contiguous}
                :safety-mode :safe-optimized
                :semantic-proof #{:types-preserved}
                :safety-proof #{:bounds-preserved}

                            :environment-fingerprint {:cpu :x86-64}}
                :artifacts #{:optimized-mir
                             :proof-index
                             :benchmark-report}}
               :zero-cost
               {:suite-id :perf2/bad-allocation
                :claims
                [{:claim-id :zc/hidden-allocation

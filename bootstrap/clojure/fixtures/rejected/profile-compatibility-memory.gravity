(ns profile.bad.compatibility-memory
  (:profile :kernel)
  (:target :jvm)
  (:requires [native.collections :as nc
              :profile :native
              :edge :facade-required
              :boundary :facade
              :facade native.collections/kernel-stack
              :evidence #{:typed-api :safety-proof :no-gc
                          :no-hidden-allocation :no-throw}
              :producer-effects #{}
              :producer-capabilities #{}
              :memory {:hidden-allocation :declared}
              :runtime {:required false :providers #{}}])
  (:effects #{})
  (:capabilities #{})
  (:safety :safe))

(def value 1)

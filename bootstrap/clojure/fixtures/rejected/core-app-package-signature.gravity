(ns core.app.package-signature
  (:profile :hosted)
  (:target :jvm)
  (:effects #{:io/write})
  (:capabilities #{:io/stdout})
  (:safety :safe)
  (:metadata {:package {:compiled-gate
                        {:signing-sbom-verifications
                         [{:artifact-id "verification:bad"
                           :signature {:canonical-payload false}}]}}}))

(defn main []
  (println "bad package signature"))

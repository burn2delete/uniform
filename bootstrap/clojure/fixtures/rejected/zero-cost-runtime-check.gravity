(ns performance.bad.zero-cost-runtime-check
  (:profile :native)
  (:target :jvm)
  (:effects #{})
  (:capabilities #{})
  (:safety :safe-optimized)
  (:metadata {:performance
              {:claim
               {:claim-id :perf/zero-cost-runtime-check
                :profile :native
                :target :llvm-x86-64-linux
                :target-features #{:avx2}
                :input-shape {:element-type :f32}
                :layout {:buffer :contiguous}
                :safety-mode :safe-optimized
                :semantic-proof #{:types-preserved}
                :safety-proof #{:bounds-preserved}
                :benchmark {:harness :bench/zero-cost-bad
                            :environment-fingerprint {:cpu :x86-64}}
                :artifacts #{:optimized-mir
                             :proof-index
                             :benchmark-report}}
               :zero-cost
               {:suite-id :perf2/bad-runtime-check
                :claims
                [{:claim-id :zc/unaccounted-runtime-check
                  :optimization :abstraction-erasure
                  :profile :native
                  :target :llvm-x86-64-linux
                  :abstraction :collection-view
                  :equivalent-form :bounds-proven-slice-loop
                  :source-operation :view/slice
                  :expected-erased-costs #{:runtime-bounds-check}
                  :erased-costs #{}
                  :residual-costs #{:runtime-bounds-check}
                  :semantic-proof #{:same-slice-range}
                  :safety-proof #{:bounds-preserved}
                  :proof-ids [:safe15/unaccounted-runtime-check]
                  :artifacts #{:before-mir
                               :after-mir
                               :dispatch-report
                               :allocation-audit
                               :boxing-audit
                               :runtime-check-report}
                  :before-ir {:artifact-id :mir/before-runtime-check}
                  :after-ir {:artifact-id :mir/after-runtime-check}
                  :allocation-audit {:hidden-allocations #{}}
                  :boxing-audit {:hidden-boxing #{}}
                  :dispatch-specialization-report {:residual-dispatch #{}}
                  :runtime-check-report
                  {:unaccounted-checks #{:runtime-bounds-check}}}]}}}))

(def bad true)

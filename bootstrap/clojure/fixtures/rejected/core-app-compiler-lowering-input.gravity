(ns core.app.compiler-lowering-input
  (:profile :hosted)
  (:target :jvm)
  (:effects #{:io/write})
  (:capabilities #{:io/stdout})
  (:safety :safe)
  (:metadata {:compiler {:compiled-gate
                         {:target-lowering
                          [{:input-kind :raw-source
                            :input-artifact-id :source/core-app
                            :backend :jvm}]}}}))

(defn main []
  (println "bad compiler lowering input"))

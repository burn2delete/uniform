(ns fixture.runtime-evaluation.rejected (:profile :hosted) (:target :jvm) (:effects #{}) (:capabilities #{}))
(defn sum0 [] 0)
(defn sum1 [a] a)
(defn sum2 [a b] (+ a b))
(defn sum3 [a b c] (+ a b c))
(defn sum4 [a b c d] (+ a b c d))
(defn sum5 [a b c d e] (+ a b c d e))
(defn countdown [n total] (if (= n 0) total (recur (- n 1) (+ total n))))
(defn vector-first [] [(+ "bad" 1) (/ 1 0)])
(defn vector-third [] [1 2 (/ 1 0) (+ "bad" 1)])
(defn map-key-first [] {(/ 1 0) (+ "bad" 1)})
(defn map-value-first [] {:a (/ 1 0) :b (+ "bad" 1)})
(defn sequence-first [] (do (+ "bad" 1) (/ 1 0)))
(defn binding-first [] (let [a (+ "bad" 1) b (/ 1 0)] [a b]))
(defn argument-first [] (sum2 (+ "bad" 1) (/ 1 0)))
(defn loop-initializer [] (loop [a (/ 1 0)] a))

(ns fixture.runtime-evaluation.accepted (:profile :hosted) (:target :jvm) (:effects #{}) (:capabilities #{}))
(defn sum0 [] 0)
(defn sum1 [a] a)
(defn sum2 [a b] (+ a b))
(defn sum3 [a b c] (+ a b c))
(defn sum4 [a b c d] (+ a b c d))
(defn sum5 [a b c d e] (+ a b c d e))
(defn countdown [n total] (if (= n 0) total (recur (- n 1) (+ total n))))
(defn vector0 [] [])
(defn vector1 [] [7])
(defn vector2 [] [1 2])
(defn vector3 [] [1 2 3])
(defn vector5 [] [1 2 3 4 5])
(defn set-values [] #{1 2 3})
(defn map0 [] {})
(defn map1 [] {:a 7})
(defn map-collision [] (let [key :a] {key 1 :a 2}))
(defn nested-map [] {:a [1 2 3 4] :b {:c 7}})
(defn call0 [] (sum0))
(defn call1 [] (sum1 7))
(defn call2 [] (sum2 1 2))
(defn call3 [] (sum3 1 2 3))
(defn call4 [] (sum4 1 2 3 4))
(defn call5 [] (sum5 1 2 3 4 5))
(defn do0 [] (do))
(defn do1 [] (do 7))
(defn do4 [] (do 1 2 3 4))
(defn sequential-bindings [] (let [a 1 b (+ a 1) c (+ b 1) d (+ c 1)] [a b c d]))
(defn loop-sum [] (loop [i 0 total 0] (if (< i 5) (recur (+ i 1) (+ total i)) total)))
(defn loop-four [] (loop [a 1 b 2 c 3 d 4] (+ a b c d)))
(defn function-recur [] (countdown 3 0))

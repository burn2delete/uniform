(defn lookup-default [] (get {} :a 7))
(defn head [] (first [1 2]))
(defn next-value [] (second [1 2]))
(defn tail [] (rest [1 2 3]))
(defn length [] (count [1 2]))
(defn symbol-value [] (symbol? (quote a)))
(defn keyword-value [] (keyword? :a))
(defn character [] (char? \a))
(defn number-value [] (number? 1))
(defn sequence [] (seq? (list 1)))
(defn list-kind [] (list? (list 1)))
(defn vector-kind [] (vector? [1]))
(defn map-kind [] (map? {}))
(defn set-kind [] (set? #{1}))
(defn string-kind [] (string? "a"))
(defn contains [] (contains? {:a nil} :a))

(defn divide [] (/ 8 2))
(defn equal [] (= 2 2))
(defn less [] (< 1 2))
(defn greater [] (> 2 1))
(defn less-equal [] (<= 2 2))
(defn greater-equal [] (>= 2 2))
(defn string [] (str :a 7))
(defn readable [] (pr-str [1 2]))
(defn mapping [] (hash-map :a 1 :b 2))
(defn vector-value [] (vector 1 2))
(defn list-value [] (list 1 2))
(defn conjoin [] (conj [1] 2 3))

(ns stage.owned.runtime.arithmetic (:profile :hosted) (:target :jvm) (:effects #{}) (:capabilities #{}) (:safety :safe))
(defn add-zero [] (+))
(defn add-unary [] (+ 7))
(defn add-binary [] (+ 4 5))
(defn add-ternary [] (+ 1 2 3))
(defn add-many [] (+ 1 2 3 4 5))
(defn subtract-unary [] (- 7))
(defn subtract-binary [] (- 9 4))
(defn subtract-ternary [] (- 9 2 3))
(defn subtract-many [] (- 20 1 2 3 4))
(defn multiply-zero [] (*))
(defn multiply-unary [] (* 7))
(defn multiply-binary [] (* 4 5))
(defn multiply-ternary [] (* 2 3 4))
(defn multiply-many [] (* 1 2 3 4 5))
(defn divide-unary [] (/ 2))
(defn divide-binary [] (/ 9 2))
(defn divide-ternary [] (/ 24 3 2))
(defn divide-many [] (/ 120 2 3 4 5))
(defn main [] [(add-zero) (add-many) (subtract-many) (multiply-zero) (multiply-many) (divide-many)])

(ns stage.owned.runtime.arithmetic.failure (:profile :hosted) (:target :jvm) (:effects #{}) (:capabilities #{}) (:safety :safe))
(defn divide-zero [] (/ 1 0))
(defn unary-zero [] (/ 0))
(defn overflow-add [] (+ 9223372036854775807 1))
(defn overflow-subtract [] (- -9223372036854775808 1))
(defn overflow-multiply [] (* 9223372036854775807 2))
(defn subtract-no-arguments [] (-))
(defn divide-no-arguments [] (/))
(defn wrong-operand [] (+ "bad" 1))
(defn main [] (divide-zero))

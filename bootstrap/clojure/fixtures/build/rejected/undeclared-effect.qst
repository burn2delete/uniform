(ns build.undeclared-effect
  (:profile :hosted)
  (:target :jvm)
  (:exports [main])
  (:effects #{:io/write})
  (:capabilities #{:io/stdout})
  (:safety :safe)
  (:metadata
   {:package
    {:compiled-gate
     {:build-graphs
      [{:artifact-id "build-graph:fixture"
        :declared-effects #{:build/read-file}
        :nodes [{:node-id :read :effects #{:build/network}}]}]}}}))

(defn main [] (println "must-not-execute"))

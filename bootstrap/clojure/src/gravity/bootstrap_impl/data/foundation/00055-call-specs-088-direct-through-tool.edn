   :effects #{:resource/close},
   :capabilities #{:resource/file}}]
 [dispatch/dictionary
  {:return-type "DispatchResult",
   :effects #{:resource/close},
   :capabilities #{:resource/file}}]
 [dispatch/vtable
  {:return-type "DispatchResult",
   :effects #{:resource/close},
   :capabilities #{:resource/file}}]
 [dispatch/dynamic
  {:return-type "DispatchResult",
   :effects #{:resource/close},
   :capabilities #{:resource/file}}]

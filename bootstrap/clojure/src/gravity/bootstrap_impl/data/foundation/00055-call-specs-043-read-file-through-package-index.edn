 [build/time {:return-type "Instant", :effects #{:build/time}}]
 [build/random {:return-type "RandomBytes", :effects #{:build/random}}]
 [build/model-call {:return-type "BuildModelOutput", :effects #{:build/model-call}}]
 [build/tool-call {:return-type "BuildToolOutput", :effects #{:build/tool-call}}]
 [build/target-probe
  {:return-type "TargetFeatureSet", :effects #{:build/target-probe}}]
 [build/package-index {:return-type "PackageIndex", :effects #{:build/package-index}}]]

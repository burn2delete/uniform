(defn c14-c13-source-rule-valid?
  [rule]
  (if (map? rule)
    (if (= (set (keys rule))
           #{:artifact :owner :source-content-hash :source-byte-count
             :plan-semantic-hash :functions-semantic-hash
             :builder-function :builder-semantic-hash :function-shapes
             :semantic-authority :compiled-by :executed-by :self-hosted?})
      (if (= (get rule :artifact) :gravity/pinned-gravity-source-rule)
        (if (= (get rule :owner)
               :gravity.compiler/c13-mir-optimization)
          (if (= (get rule :builder-function)
                 'c13-build-bounded-identity-optimized-mir)
              (if (= (get rule :source-byte-count) 43665)
                (if (= (get rule :source-content-hash)
                       "sha256:7615b0197494b67da129ebabb3e4598d1d38a1fff3b19a2169cdea8008b79abb")
                  (if (= (get rule :plan-semantic-hash)
                         "sha256:7b2d572a5aaf2713d714377de0bcde855fe3f01490346743eb33cb789e6c2a74")
                    (if (= (get rule :functions-semantic-hash)
                           "sha256:c2ca9ddda5f8d5ecc64accc8a96339f06fe37c7c213822b062d68d163f21bd24")
                    (if (= (get rule :builder-semantic-hash)
                           "sha256:91f68328307a940c1e1bc5c6ea9d5c0c2a90bedd057c55c49f0fc9955e8cdae3")
                      (if (= (get rule :function-shapes)
                             '{c13-bounded-identity-input-valid?
                               {:arity 2 :params [mir evidence]}
                               c13-operation-ids
                               {:arity 2 :params [instructions result]}
                               c13-operation-order-from-blocks
                               {:arity 3
                                :params [blocks block-order result]}
                               c13-bounded-operation-count?
                               {:arity 1 :params [mir]}
                               c13-bounded-operation-order
                               {:arity 1 :params [mir]}
                               c13-unique-operation-ids?
                               {:arity 2 :params [operation-ids seen]}
                               c13-bounded-mir-operation-shape-valid?
                               {:arity 2 :params [mir operation-order]}
                               c13-build-bounded-identity-optimized-mir
                               {:arity 2 :params [mir evidence]}})
                        (if (= (get rule :semantic-authority)
                               :gravity-source)
                          (if (= (get rule :compiled-by)
                                 :clojure-stage0-seed)
                            (if (= (get rule :executed-by)
                                   :clojure-stage0-rule-runner)
                              (= (get rule :self-hosted?) false)
                              false)
                            false)
                          false)
                        false)
                      false)
                    false)
                  false)
                false)
              false)
            false)
          false)
        false)
      false)
    false))

(defn c14-dependencies-valid?
  [optimized dependencies]
  (if (map? dependencies)
    (if (= (set (keys dependencies))
           #{:source-core :c11-source-rule :c11-pass
             :c13-artifact :c13-source-rule :b3-source})
      (if (= (get dependencies :source-core)
             (get (get optimized :input) :source-core))
        (if (c14-sha256-id? (get dependencies :source-core))
          (if (c14-c11-source-rule-valid?
               (get dependencies :c11-source-rule))
            (if (= (get dependencies :c11-pass)
                   (get (get optimized :input)
                        :pass-execution-record-id))
              (if (c14-sha256-id? (get dependencies :c11-pass))
                (if (= (get dependencies :c13-artifact)
                       (get optimized :artifact-id))
                  (if (= (get dependencies :c13-source-rule)
                         (get optimized :source-rule))
                    (if (c14-c13-source-rule-valid?
                         (get dependencies :c13-source-rule))
                      (= (get dependencies :b3-source)
                         "sha256:91381bbbfd37daeff789cdd5d1db4e3b0a08d50738ce9312a6d1483639ca2c37")
                      false)
                    false)
                  false)
                false)
                false)

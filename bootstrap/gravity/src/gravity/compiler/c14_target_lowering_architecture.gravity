(defn c14-bounded-optimized-input-valid?
  [optimized policy]
  (if (map? optimized)
    (if (map? policy)
      (if (c14-c13-envelope-valid? optimized)
        (if (c14-sha256-id? (get optimized :artifact-id))
          (if (c14-sha256-id? (get optimized :semantic-id))
            (if (c14-sha256-id? (get policy :expected-c11-artifact-id))
              (if (c14-sha256-id? (get policy :expected-c13-artifact-id))
                (if (= (get (get optimized :input) :c11-artifact-id)
                       (get policy :expected-c11-artifact-id))
                  (if (= (get optimized :artifact-id)
                         (get policy :expected-c13-artifact-id))
                    (if (= (get (get optimized :verifier-replay) :result)
                           :passed)
                      (if (= [(get (get optimized :semantic-identity)
                                    :c11-input-mir-id)
                              (get (get optimized :semantic-identity)
                                   :c11-output-mir-id)
                              (get (get optimized :decision-record)
                                   :input-mir)
                              (get (get optimized :decision-record)
                                   :output-mir)
                              (get (get optimized :verifier-replay)
                                   :c11-mir-id)]
                             [(get (get optimized :input) :c11-mir-id)
                              (get (get optimized :input) :c11-mir-id)
                              (get (get optimized :input) :c11-mir-id)
                              (get (get optimized :input) :c11-mir-id)
                              (get (get optimized :input) :c11-mir-id)])
                        (if (= (get (get optimized :semantic-identity)
                                    :unchanged?) true)
                        (if (= (get (get optimized :semantic-identity)
                                    :fact-bindings)
                               (get policy :fact-bindings))
                          (let [mir (get optimized :optimized-mir)
                                semantic (get optimized :semantic-identity)
                                decision (get optimized :decision-record)
                                operation-order
                                (c14-bounded-operation-order mir)]
                            (if (= [(get semantic :maximum-operation-count)
                                    (get (get optimized :pass-contract)
                                         :maximum-operation-count)]
                                   [256 256])
                              (if (= (get semantic :operation-order)
                                     operation-order)
                              (if (> (count operation-order) 0)
                                (if (= (get semantic :operation-count)
                                       (count operation-order))
                                  (if (= (get semantic :effect-order-graph)
                                         (get mir :effect-order-graph))
                                    (if (= (get decision :preserved)
                                           {:fact-bindings
                                            (get semantic :fact-bindings)
                                            :operation-order operation-order
                                            :effect-order-graph
                                            (get mir :effect-order-graph)})
                                      (if (= (get decision :decision-id)
                                             (get (get optimized
                                                       :invalidation-ledger)
                                                  :decision-id))
                                        (if (c14-sha256-id?
                                             (get decision :decision-id))
                                          (= (get decision :residual-checks)
                                             (get mir
                                                  :runtime-check-table))
                                          false)
                                        false)
                                      false)
                                    false)
                                  false)
                                false)
                              false)
                            false))
                          false)
                        false)
                      false)
                      false)
                    false)
                  false)
                false)
              false)
            false)
          false)
        false)
      false)
    false))


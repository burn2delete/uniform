(defn c14-contract-bindings-match?
  [mir policy]
  (let [bindings (get policy :contract-bindings)
        fact-bindings (get policy :fact-bindings)
        dependencies (get policy :dependencies)]
    (if (= (get (get bindings :profile) :entry-count) 2)
      (if (= (get (get bindings :target) :entry-count)
             (count (get policy :target)))
        (if (= (get (get bindings :abi) :entry-count)
               (count (get policy :abi)))
          (if (= (get (get bindings :runtime) :entry-count)
                 (count (get policy :runtime)))
            (if (= (get (get bindings :providers) :entry-count)
                   (count (get policy :providers)))
              (if (= (get (get bindings :effects) :entry-count) 2)
                (if (= (get (get bindings :capabilities) :entry-count) 3)
                  (if (= (get bindings :type)
                         (get fact-bindings :type))
                    (if (= (get bindings :ownership)
                           (get fact-bindings :ownership))
                      (if (= (get bindings :safety)
                             (get fact-bindings :safety))
                        (if (= (get (get bindings :proofs) :entry-count) 2)
                          (if (= (get bindings :source-map)
                                 (get fact-bindings :source-map))
                            (if (= (get (get bindings :dependencies)
                                        :entry-count)
                                   (count dependencies))

            false)
          false)
        false)
      false)
    )

(defn c14-proofs-valid?
  [mir proofs]
  (if (map? proofs)
    (if (= (set (keys proofs)) #{:capability :certificates})
      (if (map? (get proofs :capability))
       (if (map? (get proofs :certificates))
        (if (= (set (keys (get proofs :capability)))
             #{:content-id :entry-count :proof-ids})
        (if (= (set (keys (get proofs :certificates)))
               #{:content-id :entry-count :safety-proof-count
                 :safety-proof-ids})
          (if (c14-sha256-id?
               (get (get proofs :capability) :content-id))
            (if (c14-sha256-id?
                 (get (get proofs :certificates) :content-id))
              (if (= (get (get proofs :capability) :entry-count)
                     (count (get mir :capability-proof-table)))
                (if (= (get (get proofs :certificates) :entry-count)
                       (count (get mir :proof-certificate-table)))
                  (if (= (get (get proofs :certificates)
                              :safety-proof-count)
                         (count (get (get mir :proof-certificate-table)
                                     :safety-proofs)))
                    (if (vector?
                         (get (get proofs :capability) :proof-ids))
                      (if (vector?
                           (get (get proofs :certificates)
                                :safety-proof-ids))
                        (if (= (get (get proofs :capability) :proof-ids)
                               (vec (sort-by-pr-str
                                     (keys (get mir
                                                :capability-proof-table)))))
                          (= (get (get proofs :certificates)
                                  :safety-proof-ids)
                             (vec (sort-by-pr-str
                                   (keys (get (get mir
                                                   :proof-certificate-table)
                                              :safety-proofs)))))
                          false)
                        false)
                      false)
                    false)
                  false)
                false)
              false)
            false)
          false)
        false)
       false)
      false)
      false)
    false))

(defn c14-fact-bindings-match-mir?
  [mir bindings]
  (if (= (get (get bindings :type) :entry-count)
         (count (get mir :type-table)))
    (if (= (get (get bindings :effect) :entry-count)
           (count (get mir :effect-table)))
      (if (= (get (get bindings :ownership) :entry-count)
             (count (get mir :ownership-table)))
        (if (= (get (get bindings :capability) :entry-count)
               (count (get mir :capability-table)))
          (if (= (get (get bindings :safety) :entry-count)
                 (count (get mir :safety-table)))
            (if (= (get (get bindings :runtime-checks) :entry-count)
                   (count (get mir :runtime-check-table)))
              (if (= (get (get bindings :proofs) :entry-count)
                     (count (get mir :proof-certificate-table)))
                (= (get (get bindings :source-map) :entry-count)
                   (count (get mir :source-map)))
                false)
              false)
            false)
          false)
        false)
      false)
    false))

(defn c14-safety-valid?
  [mir safety bindings]
  (if (map? safety)
    (if (= (set (keys safety))
           #{:outcomes :runtime-checks :unsafe-islands :binding})
      (if (= (get safety :outcomes) (count (get mir :safety-table)))
        (if (= (get safety :runtime-checks)
               (count (get mir :runtime-check-table)))
          (if (= (get safety :unsafe-islands) 0)
            (= (get safety :binding) (get bindings :safety))
            false)
          false)
        false)
      false)
    false))

(defn c14-operation-ids
  [instructions result]
  (if (= (count instructions) 0)
    result
    (c14-operation-ids
     (rest instructions)
     (conj result (get (first instructions) :op-id)))))

(defn c14-operation-order-from-blocks
  [blocks block-order result]
  (if (= (count block-order) 0)
    result
    (c14-operation-order-from-blocks
     blocks (rest block-order)
     (c14-operation-ids
      (get (get blocks (first block-order)) :instructions) result))))

(defn c14-bounded-operation-count?
  [mir]
  (let [source-core (get mir :source-core)
        entry-id (str source-core ":mir:entry")
        then-id (str source-core ":mir:then")
        else-id (str source-core ":mir:else")
        join-id (str source-core ":mir:join")
        functions (get mir :functions)
        function (get functions (first (keys functions)))
        blocks (get function :blocks)
        operation-count
        (if (contains? blocks join-id)
          (+ (count (get (get blocks entry-id) :instructions))
             (count (get (get blocks then-id) :instructions))
             (count (get (get blocks else-id) :instructions))
             (count (get (get blocks join-id) :instructions)))
          (count (get (get blocks entry-id) :instructions)))]
    (if (> operation-count 0)
      (<= operation-count 256)
      false)))

(defn c14-bounded-operation-order
  [mir]
  (let [source-core (get mir :source-core)
        entry-id (str source-core ":mir:entry")
        then-id (str source-core ":mir:then")
        else-id (str source-core ":mir:else")
        join-id (str source-core ":mir:join")
        functions (get mir :functions)
        function (get functions (first (keys functions)))
        blocks (get function :blocks)
        block-order (if (contains? blocks join-id)
                      [entry-id then-id else-id join-id]
                      [entry-id])]
    (if (c14-bounded-operation-count? mir)
      (c14-operation-order-from-blocks blocks block-order [])
      [])))

(defn c14-c11-independent-verifier-valid?
  [mir verifier]
  (if (map? verifier)
    (if (= (set (keys verifier))
           #{:status :module-shape-valid? :block-count :operation-count
             :conditional-count :dominance-valid? :type-facts-valid?
             :direct-effects-valid? :safety-facts-valid?
             :origin-closure-valid? :runtime-checks-valid?
             :runtime-checks :target-independent? :data-flow})
      (if (= [(get verifier :status)
              (get verifier :module-shape-valid?)
              (get verifier :dominance-valid?)
              (get verifier :type-facts-valid?)
              (get verifier :direct-effects-valid?)
              (get verifier :safety-facts-valid?)
              (get verifier :origin-closure-valid?)
              (get verifier :runtime-checks-valid?)
              (get verifier :target-independent?)]
             [:passed true true true true true true true true])
        (let [functions (get mir :functions)
              function (get functions (first (keys functions)))
              blocks (get function :blocks)
              operation-order (c14-bounded-operation-order mir)
              runtime-checks (get verifier :runtime-checks)
              runtime-table (get mir :runtime-check-table)
              data-flow (get verifier :data-flow)
              graph (get mir :data-flow-graph)]
          (if (= (get verifier :block-count) (count blocks))
            (if (= (get verifier :operation-count)
                   (count operation-order))
              (if (= (get verifier :conditional-count)
                     (if (= (get (get mir :control-flow-graph) :join) nil)
                       0 1))
                (if (= (set (keys runtime-checks))
                       #{:runtime-check-count :runtime-check-ids})
                  (if (= (get runtime-checks :runtime-check-count)
                         (count runtime-table))
                    (if (= (get runtime-checks :runtime-check-ids)
                           (vec (sort-by-pr-str (keys runtime-table))))
                      (if (= (set (keys data-flow))
                             #{:edge-count :terminator-use-count
                               :definition-count :value-count})
                        (= data-flow
                           {:edge-count (count (get graph :edges))
                            :terminator-use-count
                            (count (get graph :terminator-uses))
                            :definition-count
                            (count (get graph :definitions))
                            :value-count (count (get graph :values))})
                        false)
                      false)
                    false)
                  false)
                false)
              false)
            false))
        false)
      false)
    false))


      (if (= (get (get optimized :optimized-mir) :target-request) :llvm)
        (if (= (get policy :profile-contract)
               {:name :hosted :validated? true})
        (if (c14-target-valid? (get policy :target))
        (if (= (get policy :source-target-selection)
               {:source-declaration-target :jvm
                :requested-lowering-target :llvm

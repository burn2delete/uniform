(defn sh12-c10-mir-c9-c8-admission-valid? [bound request]
  (let [owned (get (get bound :ownership-core) :ownership-core)
        c8-bound (get owned :effected-core)
        effected (get c8-bound :effected-core)
        module (get effected :module)
        value-id (get request :value-id)
        identities (get c8-bound :fact-identities)
        identity (get identities value-id)
        call-fact
        (sh12-c10-mir-c8-call-fact-find
         (get effected :call-type-facts) value-id)
        effect-request
        (sh12-c10-mir-c8-effect-request-find
         (get effected :effect-requests) value-id)
        effect-node
        (get (get (get effected :effect-graph) :nodes) value-id)
        type-table (get effected :type-table)
        expected-request
        (sh12-c10-mir-c9-request-from-c8 bound value-id)]
    (if (= :declared-pure-call-effects-with-thrown-effects-pending

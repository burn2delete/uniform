(defn sh12-c10-mir-c9-request-valid? [request]
  (if (map? request)
    (if (sh12-c10-mir-exact-keys?
         request
         #{:artifact :request-id :value-id :owner-id :ownership-kind
           :initialization :availability :events :owner-lifetime-end

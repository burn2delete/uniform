                  false)
                false)
              false)
            false)
          false)
        false)
      false)
    false))

(defn sh12-c10-mir-verification-valid? [bound verification]
  (if (sh12-c10-mir-exact-keys?
       verification
       #{:artifact :status :checks :nonclaims :expected :candidate})
    (if (= :gravity/sh11-safety-identity-binding-verification
           (get verification :artifact))
      (if (= :passed (get verification :status))
        (if (= (sh12-c10-mir-binding-checks) (get verification :checks))
          (if (= (sh12-c10-mir-binding-nonclaims)
                 (get verification :nonclaims))
            (if (= bound (get verification :expected))
              (if (= bound (get verification :candidate))
                true
                false)
              false)
            false)
          false)
        false)
      false)
    false))

(defn sh12-authenticated-c10-mir-input-valid? [bound verification]
  (let [bound-preflight (sh12-authenticated-c10-mir-carrier-preflight bound)
        verification-preflight
        (sh12-c10-mir-verification-envelope-preflight verification)]
    (if (= :accepted (get bound-preflight :status))
      (if (= :accepted (get verification-preflight :status))
        (if (sh12-c10-mir-bound-shape-valid? bound)
          (if (sh12-c10-mir-c8-fact-tables-valid? bound)
            (sh12-c10-mir-verification-valid? bound verification)
            false)
          false)
        false)
      false)))

(defn sh12-c10-mir-operation-identity-input [template]
  (let [semantic (get template :identity-input)]
    {:domain :gravity/sh12-c10-proof-reference-operation-v2
     :schema-version 2
     :scope :authenticated-persistent-read-safety-evidence-only
     :mir-operation :proof-reference
     :source-operation :load
     :core-node-id (get semantic :core-node-id)
     :value-type (get semantic :value-type)
     :type-fact-id (get semantic :type-fact-id)
     :effect-fact-id (get semantic :effect-fact-id)
     :capability-proof-id (get semantic :capability-proof-id)
     :c9-ownership-core-id (get semantic :c9-ownership-core-id)
     :c9-ownership-fact-id (get semantic :c9-ownership-fact-id)
     :c10-proof-id (get semantic :c10-proof-id)
     :c10-result-id (get semantic :c10-result-id)
     :c10-safety-core-id (get semantic :c10-safety-core-id)
     :safety-outcome-id (get semantic :safety-outcome-id)
     :safety-proof-id (get semantic :safety-proof-id)
     :source-span (get semantic :source-span)
     :origin-chain (get semantic :origin-chain)
     :profile (get semantic :profile)
     :target (get semantic :target)
     :syntax-id (get semantic :syntax-id)
     :operation-template (get template :operation)
     :proof-token-values (get template :values)
     :capability-table (get template :capability-table)
     :source-map (get template :source-map)}))

(defn sh12-c10-mir-operation-identity-request [bound verification template]
  (let [template-preflight
        (sh12-authenticated-c10-mir-carrier-preflight template)
        canonical-template
        (sh12-build-authenticated-c10-mir-template bound verification)]
    (if (= :accepted (get template-preflight :status))
      (if (sh12-authenticated-c10-mir-input-valid? bound verification)
        (if (= template canonical-template)
          {:artifact :gravity/sh12-c10-proof-reference-operation-identity-request
           :schema-version 2
           :status :accepted
           :request
           (sh12-c10-mir-operation-identity-input canonical-template)
           :next :resolve-mir-operation-identity
           :resolution :coordinator-digest-required
           :diagnostics []
           :pending (get template :pending)}
          {:artifact :gravity/sh12-c10-proof-reference-operation-identity-request
           :schema-version 2
           :status :rejected
           :diagnostics [(sh12-c10-mir-diagnostic
                          bound :template-recomputation-mismatch)]})
        {:artifact :gravity/sh12-c10-proof-reference-operation-identity-request
         :schema-version 2
         :status :rejected
         :diagnostics [(sh12-c10-mir-diagnostic
                        bound :untrusted-or-malformed-c10-input)]})
      {:artifact :gravity/sh12-c10-proof-reference-operation-identity-request
       :schema-version 2
       :status :rejected
       :diagnostics [{:diagnostic-id "C11-C10-ADAPTER"
                      :rule "C11-C10-ADAPTER"
                      :reason :template-carrier-bound
                      :preflight template-preflight}]})))

(defn sh12-c10-mir-resolution-entry-valid? [request resolution]
  (if (map? resolution)
    (if (sh12-c10-mir-exact-keys? resolution #{:request :digest})
      (if (= request (get resolution :request))
        (sh12-c10-mir-sha256-id? (get resolution :digest))
        false)
      false)
    false))

(defn sh12-c10-mir-upstream-digest? [bound digest]
  (let [operation (get bound :operation)
        facts (get operation :facts)
        ownership-core (get bound :ownership-core)
        identities (get ownership-core :fact-identities)
        fact-identity (first identities)]
    (if (= digest (get bound :proof-id))
      true
      (if (= digest (get bound :result-id))
        true
        (if (= digest (get bound :safety-core-id))
          true
          (if (= digest
                 (get (get bound :identity-input)
                      :ownership-core-identity-id))
            true
            (if (= digest (get operation :type-fact-id))
              true
              (if (= digest (get operation :effect-fact-id))
                true
                (if (= digest (get operation :capability-proof-id))
                  true
                  (if (= digest (get operation :ownership-fact-id))
                    true
                    (if (= digest
                           (get facts :ownership-core-identity-id))
                      true
                      (if (= digest
                             (get fact-identity :ownership-fact-id))
                        true
                        false))))))))))))

(defn sh12-c10-mir-module-identity-input
  [template operation-resolution]
  {:domain :gravity/sh12-c10-proof-reference-module-v2
   :schema-version 2
   :scope :authenticated-persistent-read-safety-evidence-only
   :operation-identity-id (get operation-resolution :digest)
   :operation-identity-input
   (get template :operation-identity-input)
   :operation-template (get template :operation)
   :functions (get template :functions)
   :type-table (get template :type-table)
   :effect-table (get template :effect-table)
   :ownership-table (get template :ownership-table)
   :capability-proof-table (get template :capability-proof-table)
   :safety-table (get template :safety-table)
   :proof-certificate-table (get template :proof-certificate-table)
   :source-map (get template :source-map)
   :function-shape {:parameters [] :returns :gravity/proof-token}
   :block-shape {:instructions 1 :terminator :return}
   :proof-token-shape {:kind :proof-token :defined-by :proof-reference}
   :values (get template :values)
   :capability-table (get template :capability-table)
   :target-independent? true
   :syntax-id :not-applicable})

(defn sh12-c10-mir-module-identity-request
  [bound verification template operation-resolution]
  (let [template-preflight
        (sh12-authenticated-c10-mir-carrier-preflight template)
        resolution-preflight
        (sh12-authenticated-c10-mir-carrier-preflight operation-resolution)
        canonical-template
        (sh12-build-authenticated-c10-mir-template bound verification)]
    (if (= :accepted (get template-preflight :status))
      (if (= :accepted (get resolution-preflight :status))
        (let [operation-request
              (sh12-c10-mir-operation-identity-input canonical-template)
              operation-digest (get operation-resolution :digest)]
          (if (sh12-authenticated-c10-mir-input-valid? bound verification)
            (if (= template canonical-template)
              (if (sh12-c10-mir-resolution-entry-valid?
                   operation-request operation-resolution)
                (if (= (sh12-c10-mir-upstream-digest? bound operation-digest)
                       false)
                  {:artifact :gravity/sh12-c10-proof-reference-module-identity-request
                   :schema-version 2
                   :status :accepted
                   :request
                   (sh12-c10-mir-module-identity-input
                    template operation-resolution)
                   :next :resolve-mir-module-identity
                   :resolution :coordinator-digest-required
                   :diagnostics []
                   :pending (get template :pending)}
                  {:artifact :gravity/sh12-c10-proof-reference-module-identity-request
                   :schema-version 2
                   :status :rejected
                   :diagnostics [(sh12-c10-mir-diagnostic
                                  bound :upstream-digest-reused-for-mir-operation)]})
                {:artifact :gravity/sh12-c10-proof-reference-module-identity-request
                 :schema-version 2
                 :status :rejected
                 :diagnostics [(sh12-c10-mir-diagnostic
                                bound :operation-identity-resolution-substitution)]})
              {:artifact :gravity/sh12-c10-proof-reference-module-identity-request
               :schema-version 2
               :status :rejected
               :diagnostics [(sh12-c10-mir-diagnostic bound :template-rejected)]})
            {:artifact :gravity/sh12-c10-proof-reference-module-identity-request
             :schema-version 2
             :status :rejected
             :diagnostics [(sh12-c10-mir-diagnostic
                            bound :untrusted-or-malformed-c10-input)]}))
        {:artifact :gravity/sh12-c10-proof-reference-module-identity-request
         :schema-version 2
         :status :rejected
         :diagnostics [{:diagnostic-id "C11-C10-ADAPTER"
                        :rule "C11-C10-ADAPTER"
                        :reason :operation-resolution-carrier-bound
                        :preflight resolution-preflight}]})
      {:artifact :gravity/sh12-c10-proof-reference-module-identity-request
       :schema-version 2
       :status :rejected
       :diagnostics [{:diagnostic-id "C11-C10-ADAPTER"
                      :rule "C11-C10-ADAPTER"
                      :reason :template-carrier-bound
       :preflight template-preflight}]})))

; Public names are intentionally distinct from the private constructors so the
; exported boundary cannot be confused with an unbound request preimage.
(defn sh12-authenticated-c10-mir-identity-request
  [bound verification template]
  (sh12-c10-mir-operation-identity-request bound verification template))

(defn sh12-authenticated-c10-mir-module-identity-request
  [bound verification template operation-resolution]
  (sh12-c10-mir-module-identity-request
   bound verification template operation-resolution))

(defn sh12-c10-mir-upstream-identity [bound]
  (get bound :identity-input))

(defn sh12-c10-mir-semantic-input [bound]
  (let [operation (get bound :operation)
        facts (get operation :facts)
        upstream (sh12-c10-mir-upstream-identity bound)]
    {:domain :gravity/sh12-c10-proof-reference-mir-v2
     :schema-version 2
     :scope :authenticated-persistent-read-safety-evidence-only
     :c10-safety-core-id (get bound :safety-core-id)
     :c10-proof-id (get bound :proof-id)
     :c10-result-id (get bound :result-id)
     :c9-ownership-core-id
     (get upstream :ownership-core-identity-id)
     :c9-ownership-fact-id (get operation :ownership-fact-id)
     :c10-identity-input (get bound :identity-input)
     :core-node-id (get operation :core-node-id)
     :operation-id (get operation :operation-id)
     :source-operation :load
     :mir-operation :proof-reference
     :value-type (get facts :value-type)
     :type-fact-id (get operation :type-fact-id)
     :effect-fact-id (get operation :effect-fact-id)
     :capability-proof-id (get operation :capability-proof-id)
     :fact-id-request (get facts :fact-id-request)
     :safety-outcome-id (get bound :result-id)
     :safety-proof-id (get bound :proof-id)
     :source-span (get operation :source-span)
     :origin-chain (get operation :origin-chain)
     :profile (get operation :profile)
     :target (get operation :target)
     ; C10 currently exposes core-node identity but not a distinct syntax id.
     ; Preserve that absence instead of inventing a syntax identity.
     :syntax-id :not-applicable}))

(defn sh12-c10-mir-source [bound operation-id]
  (let [operation (get bound :operation)
        proof-id (get bound :proof-id)]
    {:core-node (get operation :core-node-id)
     :syntax-id :not-applicable
     :source-span (get operation :source-span)
     :origin-chain (get operation :origin-chain)
     :generated-origin
     [{:role :proof-generated
       :producer :sh12-build-authenticated-c10-mir-template
       :operation-id operation-id
       :proof-id proof-id}]}))

(defn sh12-c10-mir-fact-refs [bound operation-id]
  (let [operation (get bound :operation)
        facts (get operation :facts)]
    {:type-fact-id (get operation :type-fact-id)
     :effect-fact-id (get operation :effect-fact-id)
     :capability-proof-ids [(get operation :capability-proof-id)]
     :capability-proof-id (get operation :capability-proof-id)
     :ownership-fact-id (get operation :ownership-fact-id)
     :safety-outcome-id (get bound :result-id)
     :safety-proof-id (get bound :proof-id)
     :proof-certificate-ids [(get bound :proof-id)]
     :c10-safety-core-id (get bound :safety-core-id)
     :c9-ownership-core-id
     (get facts :ownership-core-identity-id)
     :c9-fact-id-request (get facts :fact-id-request)
     :read-value-type (get facts :value-type)
     :source-origin-id (get operation :core-node-id)
     :operation-id operation-id}))

(defn sh12-c10-mir-operation-label [bound]
  (str (get (get bound :operation) :core-node-id)
       ":c11:c10-proof-reference"))

(defn sh12-c10-mir-function-label [bound]
  (str (sh12-c10-mir-operation-label bound) ":function"))

(defn sh12-c10-mir-block-label [bound]
  (str (sh12-c10-mir-operation-label bound) ":entry"))

(defn sh12-c10-mir-token-label [bound]
  (str (sh12-c10-mir-operation-label bound) ":proof-token"))

(defn sh12-c10-mir-operation-template [bound]
  (let [operation-label (sh12-c10-mir-operation-label bound)
        token-label (sh12-c10-mir-token-label bound)
        operation (get bound :operation)]
    {:artifact :gravity/mir-operation
     :op-id operation-label
     :opcode :proof-reference
     :source-operation :load
     :block-id (sh12-c10-mir-block-label bound)
     :operands []
     :result token-label
     :result-kind :proof-token
     :constant-payload :not-applicable
     :type :gravity/proof-token
     :effects #{}
     :capabilities #{}
     :ordering :none
     :source (sh12-c10-mir-source bound operation-label)
     :profile (get operation :profile)
     :target (get operation :target)
     :facts (sh12-c10-mir-fact-refs bound operation-label)
     :domain-anchor nil
     :verifier-status :pending}))

(defn sh12-c10-mir-proof-token-template [bound operation-id token-id]
  (let [operation (get bound :operation)]
    {:artifact :gravity/mir-value
     :value-id token-id
     :kind :proof-token
     :type :gravity/proof-token
     :constant-payload :not-applicable
     :defined-by operation-id
     :uses [{:consumer-kind :terminator
             :consumer-id (str (sh12-c10-mir-block-label bound) ":return")
             :consumer-block (sh12-c10-mir-block-label bound)
             :operand-index 0
             :edge-kind :proof-token-return}]
     :source (sh12-c10-mir-source bound operation-id)
     :ownership :not-applicable
     :effects #{}
     :safety :proven-safe}))

(defn sh12-c10-mir-terminator-template [bound token-id]
  (let [operation (get bound :operation)
        block-id (sh12-c10-mir-block-label bound)
        terminator-id (str block-id ":return")]
    {:artifact :gravity/mir-terminator
     :terminator-id terminator-id
     :kind :return
     :operands [token-id]
     :successors []
     :effects #{}
     :ordering :none
     :source (sh12-c10-mir-source bound terminator-id)
     :profile (get operation :profile)
     :target (get operation :target)
     :facts {:returned-proof-token token-id
             :safety-outcome-id (get bound :result-id)
             :safety-proof-id (get bound :proof-id)}
     :verifier-status :pending}))

(defn sh12-c10-mir-function-template [bound]
  (let [operation-id (sh12-c10-mir-operation-label bound)
        token-id (sh12-c10-mir-token-label bound)
        block-id (sh12-c10-mir-block-label bound)
        operation (sh12-c10-mir-operation-template bound)
        token (sh12-c10-mir-proof-token-template bound operation-id token-id)
        terminator (sh12-c10-mir-terminator-template bound token-id)
        block
        {:artifact :gravity/mir-block
         :block-id block-id
         :arguments []
         :instructions [operation]
         :terminator terminator
         :predecessors []
         :successors []
         :dominators [block-id]
         :data-flow {:definitions [token-id]
                     :uses [{:value-id token-id
                             :consumer-kind :terminator
                             :consumer-id (get terminator :terminator-id)}]}
         :source (sh12-c10-mir-source bound block-id)}]
    {:artifact :gravity/mir-function
     :fn-id (sh12-c10-mir-function-label bound)
     :name (str "c10-proof-reference/"
                (get (get bound :operation) :core-node-id))
     :params []
     :returns :gravity/proof-token
     :latent-effects #{}
     :capabilities #{}
     :values {token-id token}
     :blocks {block-id block}
     :entry block-id
     :source (sh12-c10-mir-source bound operation-id)
     :facts {:type-fact-id (get (get bound :operation) :type-fact-id)
             :effect-fact-id (get (get bound :operation) :effect-fact-id)
             :ownership-fact-id (get (get bound :operation)
                                     :ownership-fact-id)
             :safety-outcome-id (get bound :result-id)
             :safety-proof-id (get bound :proof-id)}
     :provenance {:c10-safety-core-id (get bound :safety-core-id)
                  :c9-ownership-core-id
                  (get (get bound :identity-input)
                       :ownership-core-identity-id)}
     :contract :c11-c10-proof-reference-function}))

(defn sh12-c10-mir-table-refs [bound]
  (let [operation (get bound :operation)
        facts (get operation :facts)
        ownership-core (get bound :ownership-core)
        owned (get ownership-core :ownership-core)
        c8-bound (get owned :effected-core)
        effected (get c8-bound :effected-core)
        value-id (get operation :core-node-id)
        c8-identity (get (get c8-bound :fact-identities) value-id)
        call-fact
        (sh12-c10-mir-c8-call-fact-find
         (get effected :call-type-facts) value-id)
        effect-request
        (sh12-c10-mir-c8-effect-request-find
         (get effected :effect-requests) value-id)
        legality
        (sh12-c10-mir-c8-effect-legality-find
         (get effected :effect-legality-results)
         (get effect-request :request-id))
        effect-node
        (get (get (get effected :effect-graph) :nodes) value-id)
        capability-input
        {:authority-mode :none
         :declared-capabilities #{}
         :required-capability nil}
        capability-request
        {:domain :gravity/sh09-effect-fact-identity-v1
         :kind :capability-proof
         :core-node-id value-id
         :identity-input capability-input}
        ownership-results (get owned :ownership-results)
        ownership-result (first ownership-results)
        ownership-facts (get ownership-result :ownership-facts)
        ownership-fact (first ownership-facts)
        fact-identities (get ownership-core :fact-identities)
        fact-identity (first fact-identities)
        safety-result (get bound :safety-result)
        safety-verification (get bound :safety-verification)
        proofs (get safety-result :proofs)
        outcomes (get safety-result :outcomes)
        proof (first proofs)
        outcome (first outcomes)]
    {:type-table
     {(get operation :type-fact-id)
      {:call-type-fact call-fact
       :fact-identity c8-identity}}
     :effect-table
     {(get operation :effect-fact-id)
      {:effect-request effect-request
       :legality-result legality
       :effect-node effect-node}}
     :ownership-table
     {(get operation :ownership-fact-id)
      {:fact-id (get operation :ownership-fact-id)
       :fact ownership-fact
       :fact-identity fact-identity
       :ownership-result ownership-result
       :ownership-fact-request (get fact-identity :fact-id-request)
       :ownership-core-identity-id
       (get (get operation :facts) :ownership-core-identity-id)
       :source-stage :c9
       :source-kind :authenticated-record}}
     :capability-proof-table
     {(get operation :capability-proof-id)
      {:proof-id (get operation :capability-proof-id)
       :source-stage :c8
       :source-kind :authenticated-upstream-reference
       :operation-facts facts}}
     :capability-table
     {(get operation :capability-proof-id)
     {:identity-request capability-request
       :identity-input capability-input
       :effect-fact-id (get operation :effect-fact-id)
       :capability-proof (get legality :capability-proof)}}
     :safety-table
     {(get bound :result-id)
      {:outcome-id (get bound :result-id)
       :result safety-result
       :outcome-record outcome
       :proof-id (get bound :proof-id)
       :proof proof
       :verification safety-verification
       :source-stage :c10
       :source-kind :authenticated-record}}
     :proof-certificate-table
     {(get bound :proof-id)
     {:proof-id (get bound :proof-id)
       :proof proof
       :proof-id-request (get proof :proof-id-request)
       :result-id (get bound :result-id)
       :safety-core-id (get bound :safety-core-id)
       :source-stage :c10
       :source-kind :authenticated-record}}}))

(defn sh12-c10-mir-c8-fact-tables-valid? [bound]
  (let [operation (get bound :operation)
        value-id (get operation :core-node-id)
        type-id (get operation :type-fact-id)
        effect-id (get operation :effect-fact-id)
        capability-id (get operation :capability-proof-id)
        ownership-core (get bound :ownership-core)
        owned (get ownership-core :ownership-core)
        c8-bound (get owned :effected-core)
        effected (get c8-bound :effected-core)
        c8-identity (get (get c8-bound :fact-identities) value-id)
        call-fact
        (sh12-c10-mir-c8-call-fact-find
         (get effected :call-type-facts) value-id)
        effect-request
        (sh12-c10-mir-c8-effect-request-find
         (get effected :effect-requests) value-id)
        legality
        (sh12-c10-mir-c8-effect-legality-find
         (get effected :effect-legality-results)
         (get effect-request :request-id))
        effect-node
        (get (get (get effected :effect-graph) :nodes) value-id)
        capability-input
        {:authority-mode :none
         :declared-capabilities #{}
         :required-capability nil}
        capability-request
        {:domain :gravity/sh09-effect-fact-identity-v1
         :kind :capability-proof
         :core-node-id value-id
         :identity-input capability-input}
        tables (sh12-c10-mir-table-refs bound)
        type-table (get tables :type-table)
        effect-table (get tables :effect-table)
        capability-table (get tables :capability-table)
        type-entry (get type-table type-id)
        effect-entry (get effect-table effect-id)
        capability-entry (get capability-table capability-id)]
    (if (= :declared-pure-call-effects-with-thrown-effects-pending
           (get effected :scope))
      (if (sh12-c10-mir-exact-keys? type-table #{type-id})
        (if (sh12-c10-mir-exact-keys? effect-table #{effect-id})
            (if (sh12-c10-mir-exact-keys? capability-table #{capability-id})
              (if (= {:call-type-fact call-fact
                      :fact-identity c8-identity}
                     type-entry)
                (if (sh12-c10-mir-c8-call-fact-exact-valid?
                     call-fact c8-identity effect-request effect-node value-id
                     type-id effect-id capability-id (get effected :module))
                (if (sh12-c10-mir-exact-keys?
                 effect-entry
                 #{:effect-request :legality-result :effect-node})
              (if (= effect-request (get effect-entry :effect-request))
                (if (sh12-c10-mir-c8-pure-legality-exact-valid?
                     legality (get effect-entry :legality-result)
                     effect-request call-fact (get effected :module))
                  (if (= effect-node (get effect-entry :effect-node))
                    (if (= (get effect-request :core-node-id) value-id)
                      (if (= (get legality :request-id)
                             (get effect-request :request-id))
                        (if (= :gravity/sh09-effect-legality-result
                               (get legality :artifact))
                          (if (= :accepted (get legality :status))
                            (if (= #{} (get effect-node :direct))
                              (if (= #{} (get effect-node :latent))
                                (if (= #{} (get effect-node :transitive))
                                  (if (= :pure (get effect-node :ordering))
                                      (if (sh12-c10-mir-exact-keys?
                                         capability-entry
                                         #{:identity-request :identity-input
                                           :effect-fact-id
                                           :capability-proof})
                                      (if (= capability-request
                                             (get capability-entry
                                                  :identity-request))
                                        (if (= capability-input
                                               (get capability-entry
                                                    :identity-input))
                                          (if (= effect-id
                                                 (get capability-entry
                                                      :effect-fact-id))
                                            (= nil
                                               (get capability-entry
                                                    :capability-proof))
                                            false)
                                          false)
                                        false)
                                      false)
                                    false)
                                  false)
                                false)
                              false)
                            false)
                          false)
                        false)
                      false)
                    false)
                  false)
                false)
              false)
                  false)
                false)
            false)
          false)
        false)
      false)))



 (defn sh12-build-authenticated-c10-mir-template [bound verification]
  (if (sh12-authenticated-c10-mir-input-valid? bound verification)
    (let [semantic (sh12-c10-mir-semantic-input bound)
          operation (sh12-c10-mir-operation-template bound)
          function (sh12-c10-mir-function-template bound)
          token
          (sh12-c10-mir-proof-token-template
           bound (get operation :op-id) (get operation :result))
          tables (sh12-c10-mir-table-refs bound)
          values {(get token :value-id) token}
          source-map
          {(get operation :op-id) (get operation :source)
           (get function :fn-id) (get function :source)
           (get function :entry)
           (get (get (get function :blocks) (get function :entry)) :source)
           (get (get (get (get function :blocks) (get function :entry))
                     :terminator)
                :terminator-id)
           (get (get (get (get function :blocks) (get function :entry))
                     :terminator)
                :source)
           (get operation :result) (get token :source)}
          operation-input
          (sh12-c10-mir-operation-identity-input
           {:identity-input semantic
            :operation operation
            :values values
            :capability-table (get tables :capability-table)
            :source-map source-map})
          policy (sh12-authenticated-c10-mir-adapter-policy)]
      {:artifact :gravity/sh12-authenticated-c10-proof-reference-mir-template
       :schema-version 2
       :status :accepted
       :scope :authenticated-persistent-read-safety-evidence-only
       :module-id :pending-c10-mir-identity
       :source-core (get bound :safety-core-id)
       :profile (get (get bound :operation) :profile)
       :target-request (get (get bound :operation) :target)
       :target-independent? true
       :executable-load? false
       :source-operation :load
       :mir-operation :proof-reference
       :identity-input semantic
       :operation-identity-input
       operation-input
       :operation-identity-request nil
       :module-identity-request nil
       :operation operation
       :functions {(get function :fn-id) function}
       :globals {}
       :type-table (get tables :type-table)
       :effect-table (get tables :effect-table)
       :ownership-table (get tables :ownership-table)
       :capability-proof-table (get tables :capability-proof-table)
       :safety-table (get tables :safety-table)
       :proof-certificate-table (get tables :proof-certificate-table)
       :capability-table (get tables :capability-table)
       :values values
       :runtime-check-table {}
       :profile-target-table
       {(get (get bound :operation) :core-node-id)
        {:core-node-id (get (get bound :operation) :core-node-id)
         :profile (get (get bound :operation) :profile)
         :target (get (get bound :operation) :target)}}
       :source-map source-map
       :domain-anchors {}
       :diagnostics []
       :provenance (get bound :provenance)
       :upstream
       {:c10-safety-core-id (get bound :safety-core-id)
        :c10-safety-result-id (get bound :result-id)
        :c10-safety-proof-id (get bound :proof-id)
        :c10-safety-verification-ref
        {:artifact (get (get bound :safety-verification) :artifact)
         :status (get (get bound :safety-verification) :status)
         :checks (get (get bound :safety-verification) :checks)
         :nonclaims (get (get bound :safety-verification) :nonclaims)}
        :c9-ownership-core-id
        (get (get bound :identity-input)
             :ownership-core-identity-id)
        :c9-ownership-fact-id
        (get (get bound :operation) :ownership-fact-id)
        :c9-ownership-fact-identity-id
        (get (first (get (get bound :ownership-core)
                         :fact-identities))
             :ownership-fact-id)
        :c8-type-fact-id (get (get bound :operation) :type-fact-id)
        :c8-effect-fact-id (get (get bound :operation) :effect-fact-id)
        :c8-capability-proof-id
        (get (get bound :operation) :capability-proof-id)}
       :verification-status :pending-proof-reference-verifier
       :operation-identity-resolution :coordinator-digest-required
       :module-identity-resolution :coordinator-digest-required
       :identity-binding-status :unbound
       :b1-preflight {:status :blocked
                      :reason :proof-reference-only-adapter
                      :executable-load? false}
       :pending (get policy :pending)
       :nonclaims (get policy :nonclaims)
       :self-hosted? false
       :clojure-seed-boundary? true})
    {:artifact :gravity/sh12-authenticated-c10-proof-reference-mir-template
     :schema-version 2
     :status :rejected
     :scope :authenticated-persistent-read-safety-evidence-only
     :diagnostics [(sh12-c10-mir-diagnostic
                    bound :untrusted-or-malformed-c10-input)]
     :pending (get (sh12-authenticated-c10-mir-adapter-policy) :pending)
 :nonclaims (get (sh12-authenticated-c10-mir-adapter-policy) :nonclaims)}))

(defn sh12-c10-mir-bound-operation
  [bound operation-id block-id token-id]
  (let [operation (sh12-c10-mir-operation-template bound)]
    (assoc
     (assoc
      (assoc
       (assoc
        (assoc operation :op-id operation-id)
        :block-id block-id)
       :result token-id)
      :source (sh12-c10-mir-source bound operation-id))
     :facts
     (assoc (get operation :facts) :operation-id operation-id))))

(defn sh12-c10-mir-bound-token
  [bound operation-id block-id token-id]
  (assoc
   (sh12-c10-mir-proof-token-template
    bound operation-id token-id)
   :uses [{:consumer-kind :terminator
           :consumer-id (str block-id ":return")
           :consumer-block block-id
           :operand-index 0
           :edge-kind :proof-token-return}]
   :source (sh12-c10-mir-source bound operation-id)))

(defn sh12-c10-mir-bound-terminator
  [bound operation-id block-id token-id]
  (assoc
   (assoc
    (assoc
     (sh12-c10-mir-terminator-template bound token-id)
     :terminator-id (str block-id ":return")
     :operands [token-id])
    :source (sh12-c10-mir-source bound operation-id))
   :facts {:returned-proof-token token-id
           :safety-outcome-id (get bound :result-id)
           :safety-proof-id (get bound :proof-id)}))

(defn sh12-c10-mir-bound-function
  [bound operation-id module-id]
  (let [block-id (str module-id ":entry")
        token-id (str operation-id ":proof-token")
        operation
        (sh12-c10-mir-bound-operation
         bound operation-id block-id token-id)
        token (sh12-c10-mir-bound-token
               bound operation-id block-id token-id)
        terminator
        (sh12-c10-mir-bound-terminator
         bound operation-id block-id token-id)
        block
        {:artifact :gravity/mir-block
         :block-id block-id
         :arguments []
         :instructions [operation]
         :terminator terminator
         :predecessors []
         :successors []
         :dominators [block-id]
         :data-flow {:definitions [token-id]
                     :uses [{:value-id token-id
                             :consumer-kind :terminator
                             :consumer-id (get terminator :terminator-id)}]}
         :source (sh12-c10-mir-source bound operation-id)}]
    {:artifact :gravity/mir-function
     :fn-id (str module-id ":function")
     :name (str "c10-proof-reference/"
                (get (get bound :operation) :core-node-id))
     :params []
     :returns :gravity/proof-token
     :latent-effects #{}
     :capabilities #{}
     :values {token-id token}
     :blocks {block-id block}
     :entry block-id
     :source (sh12-c10-mir-source bound operation-id)
     :facts {:type-fact-id (get (get bound :operation) :type-fact-id)
             :effect-fact-id (get (get bound :operation) :effect-fact-id)
             :ownership-fact-id (get (get bound :operation)
                                     :ownership-fact-id)
             :safety-outcome-id (get bound :result-id)
             :safety-proof-id (get bound :proof-id)}
     :provenance {:c10-safety-core-id (get bound :safety-core-id)
                  :c9-ownership-core-id
                  (get (get bound :identity-input)
                       :ownership-core-identity-id)}
     :proof-token token
     :contract :c11-c10-proof-reference-function}))

(defn sh12-c10-mir-resolved-valid?
  [bound verification template resolved]
  (let [operation-request
        (if (= nil (get template :operation-identity-request))
          (sh12-c10-mir-operation-identity-input template)
          (get template :operation-identity-request))
        operation-resolution (get resolved :operation-resolution)
        module-resolution (get resolved :module-resolution)
        operation-digest (get operation-resolution :digest)
        module-digest (get module-resolution :digest)
        module-request
        (sh12-c10-mir-module-identity-input
         template operation-resolution)]
    (if (sh12-c10-mir-exact-keys?
         resolved #{:operation-resolution :module-resolution})
      (if (sh12-c10-mir-resolution-entry-valid?
           operation-request operation-resolution)
        (if (sh12-c10-mir-resolution-entry-valid?
             module-request module-resolution)
          (if (= (sh12-c10-mir-upstream-digest? bound operation-digest)
                 false)
            (if (= (sh12-c10-mir-upstream-digest? bound module-digest)
                   false)
              (if (= operation-digest module-digest)
                false
                true)
              false)
            false)
          false)
        false)
      false)))

(defn sh12-c10-mir-bound-module
  [bound verification template resolved]
  (let [operation-resolution (get resolved :operation-resolution)
        module-resolution (get resolved :module-resolution)
        operation-id (get operation-resolution :digest)
        module-id (get module-resolution :digest)
        function (sh12-c10-mir-bound-function bound operation-id module-id)
        block-id (str module-id ":entry")
        token-id (str operation-id ":proof-token")
        operation
        (sh12-c10-mir-bound-operation
         bound operation-id block-id token-id)
        token (sh12-c10-mir-bound-token
               bound operation-id block-id token-id)
        terminator
        (sh12-c10-mir-bound-terminator
         bound operation-id block-id token-id)
        template-identity (get template :identity-input)
        identity-input
        (assoc
         (assoc template-identity :operation-identity-id operation-id)
         :mir-identity-id module-id)
        tables (sh12-c10-mir-table-refs bound)]
    {:artifact :gravity/sh12-authenticated-c10-proof-reference-mir
     :schema-version 2
     :status :accepted
     :scope :authenticated-persistent-read-safety-evidence-only
     :module-id module-id
     :operation-identity-id operation-id
     :source-core (get bound :safety-core-id)
     :profile (get (get bound :operation) :profile)
     :target-request (get (get bound :operation) :target)
     :target-independent? true
     :executable-load? false
     :source-operation :load
     :mir-operation :proof-reference
     :identity-input identity-input
     :operation-identity-input (get template :operation-identity-input)
     :operation-identity-request
     (get operation-resolution :request)
     :module-identity-request (get module-resolution :request)
     :operation
     operation
     :functions {(get function :fn-id) function}
     :globals {}
     :type-table (get tables :type-table)
     :effect-table (get tables :effect-table)
     :ownership-table (get tables :ownership-table)
     :capability-proof-table (get tables :capability-proof-table)
     :safety-table (get tables :safety-table)
     :proof-certificate-table (get tables :proof-certificate-table)
     :capability-table (get tables :capability-table)
     :values {token-id token}
     :runtime-check-table {}
     :profile-target-table
     {(get (get bound :operation) :core-node-id)
      {:core-node-id (get (get bound :operation) :core-node-id)
       :profile (get (get bound :operation) :profile)
       :target (get (get bound :operation) :target)}}
     :source-map
     {(get function :fn-id) (get function :source)
      block-id (get (get (get function :blocks) block-id) :source)
      (get operation :op-id) (get operation :source)
      token-id (get token :source)
      (get terminator :terminator-id) (get terminator :source)}
     :domain-anchors {}
     :diagnostics []
     :provenance (get bound :provenance)
     :upstream (get template :upstream)
     :verification-status :pending-proof-reference-verifier
     :identity-resolution :coordinator-digest-bound
     :identity-binding-status :coordinator-resolution-shape-checked
     :identity-resolutions resolved
     :b1-preflight {:status :blocked
                    :reason :proof-reference-only-adapter
                    :executable-load? false}
     :pending (get template :pending)
     :nonclaims (get template :nonclaims)
     :self-hosted? false
     :clojure-seed-boundary? true}))

(defn sh12-bind-authenticated-c10-mir
  [bound verification template resolved]
  (let [bound-preflight (sh12-authenticated-c10-mir-carrier-preflight bound)
        verification-preflight
        (sh12-c10-mir-verification-envelope-preflight verification)
        template-preflight
        (sh12-authenticated-c10-mir-carrier-preflight template)
        resolved-preflight
        (sh12-authenticated-c10-mir-carrier-preflight resolved)
        canonical-template
        (sh12-build-authenticated-c10-mir-template bound verification)]
    (if (= :accepted (get bound-preflight :status))
      (if (= :accepted (get verification-preflight :status))
        (if (= :accepted (get template-preflight :status))
          (if (= :accepted (get resolved-preflight :status))
            (if (sh12-authenticated-c10-mir-input-valid?
                 bound verification)
              (if (= template canonical-template)
                (if (sh12-c10-mir-resolved-valid?
                     bound verification template resolved)
                  (sh12-c10-mir-bound-module
                   bound verification template resolved)
                  {:artifact :gravity/sh12-authenticated-c10-proof-reference-mir
                   :schema-version 2
                   :status :rejected
                   :diagnostics [(sh12-c10-mir-diagnostic
                                  bound :identity-resolution-substitution)]})
                {:artifact :gravity/sh12-authenticated-c10-proof-reference-mir
                 :schema-version 2
                 :status :rejected
                 :diagnostics [(sh12-c10-mir-diagnostic bound :template-rejected)]})
              {:artifact :gravity/sh12-authenticated-c10-proof-reference-mir
               :schema-version 2
               :status :rejected
               :diagnostics [(sh12-c10-mir-diagnostic
                              bound :untrusted-or-malformed-c10-input)]})
            {:artifact :gravity/sh12-authenticated-c10-proof-reference-mir
             :schema-version 2
             :status :rejected
             :diagnostics [{:diagnostic-id "C11-C10-ADAPTER"
                            :rule "C11-C10-ADAPTER"
                            :reason :resolved-carrier-bound
                            :preflight resolved-preflight}]})
          {:artifact :gravity/sh12-authenticated-c10-proof-reference-mir
           :schema-version 2
           :status :rejected
           :diagnostics [{:diagnostic-id "C11-C10-ADAPTER"
                          :rule "C11-C10-ADAPTER"
                          :reason :template-carrier-bound
                          :preflight template-preflight}]})
        {:artifact :gravity/sh12-authenticated-c10-proof-reference-mir
         :schema-version 2
         :status :rejected
         :diagnostics [{:diagnostic-id "C11-C10-ADAPTER"
                        :rule "C11-C10-ADAPTER"
                        :reason :verification-carrier-bound
                        :preflight verification-preflight}]})
      {:artifact :gravity/sh12-authenticated-c10-proof-reference-mir
       :schema-version 2
       :status :rejected
       :diagnostics [{:diagnostic-id "C11-C10-ADAPTER"
                      :rule "C11-C10-ADAPTER"
                      :reason :bound-carrier-bound
                      :preflight bound-preflight}]})))

(defn sh12-verify-authenticated-c10-mir
  [bound verification template resolved candidate]
  (let [bound-preflight (sh12-authenticated-c10-mir-carrier-preflight bound)
        verification-preflight
        (sh12-c10-mir-verification-envelope-preflight verification)
        template-preflight
        (sh12-authenticated-c10-mir-carrier-preflight template)
        resolved-preflight
        (sh12-authenticated-c10-mir-carrier-preflight resolved)
        candidate-preflight
        (sh12-authenticated-c10-mir-carrier-preflight candidate)]
    (if (= :accepted (get bound-preflight :status))
      (if (= :accepted (get verification-preflight :status))
        (if (= :accepted (get template-preflight :status))
          (if (= :accepted (get resolved-preflight :status))
            (if (= :accepted (get candidate-preflight :status))
              (let [expected
                    (if (= template
                           (sh12-build-authenticated-c10-mir-template
                            bound verification))
                      (sh12-bind-authenticated-c10-mir
                       bound verification template resolved)
                      {:artifact :gravity/sh12-authenticated-c10-proof-reference-mir
                       :schema-version 2
                       :status :rejected
                       :diagnostics [(sh12-c10-mir-diagnostic
                                      bound :template-recomputation-mismatch)]})]
                {:artifact :gravity/sh12-c10-proof-reference-mir-verification
                 :status (if (= expected candidate) :passed :rejected)
                 :checks [:bounded-all-input-carriers
                          :exact-c10-bound-and-result-lineage
                          :exact-proof-reference-operation
                          :explicit-proof-token-definition-and-use
                          :sequential-operation-and-module-resolution
                          :fresh-module-recomputation
                          :path-neutral-identity-input
                          :separate-actual-path-provenance]
                 :nonclaims [:trusted-digest-resolution
                             :independent-canonical-digest-verification
                             :generic-c11-verifier
                             :executable-load
                             :program-lowering]
                 :expected expected
                 :candidate candidate})
              {:artifact :gravity/sh12-c10-proof-reference-mir-verification
               :status :rejected
               :checks [:candidate-carrier-bound]
               :candidate-preflight candidate-preflight})
            {:artifact :gravity/sh12-c10-proof-reference-mir-verification
             :status :rejected
             :checks [:resolved-carrier-bound]
             :resolved-preflight resolved-preflight})
          {:artifact :gravity/sh12-c10-proof-reference-mir-verification
           :status :rejected
           :checks [:template-carrier-bound]
           :template-preflight template-preflight})
        {:artifact :gravity/sh12-c10-proof-reference-mir-verification
         :status :rejected
         :checks [:verification-carrier-bound]
         :verification-preflight verification-preflight})
      {:artifact :gravity/sh12-c10-proof-reference-mir-verification
       :status :rejected
       :checks [:bound-carrier-bound]
       :bound-preflight bound-preflight})))

; SH-13 bounded executable function and control-flow leaf. Authenticated SH-12
; adaptation remains pending; this engine consumes normalized verified MIR.

(defn sh13-control-flow-policy []
  {:artifact :gravity/sh13-control-flow-policy
   :version 1
   :maximum-functions 32
   :maximum-blocks-per-function 32
   :maximum-operations-per-block 64
   :maximum-parameters 8
   :maximum-call-depth 32
   :maximum-execution-steps 512
   :operation-set #{:const :add :sub :mul :eq :lt :call}
   :terminator-set
   #{:return :error-return :throw :panic
     :branch :conditional-branch}
   :dispatch-set #{:direct :indirect}
   :clojure-seed-boundary? true
   :self-hosted? false
   :diagnostics #{"C11-MODULE" "C11-BLOCK" "C11-DOMINANCE"
                  "C11-TYPE" "C11-EFFECT" "C11-ORIGIN"
                  "C11-VERIFY"}
   :pending [:authenticated-sh12-mir-input
             :closures-and-captured-environments
             :mutual-recursion-analysis
             :dynamic-and-vtable-dispatch
             :whole-c11-operation-set
             :seedless-runtime-execution]})

(defn sh13-member? [values value]
  (= (get values value) value))

(defn sh13-source-span-valid? [source-span]
  (if (map? source-span)
    (if (= (set (keys source-span)) #{:source-id :start :end})
      (if (= nil (get source-span :source-id))
        false
        (if (integer? (get source-span :start))
          (if (integer? (get source-span :end))
            (if (<= 0 (get source-span :start))
              (<= (get source-span :start) (get source-span :end))
              false)
            false)
          false))
      false)
    false))

(defn sh13-origin-entry-valid? [origin]
  (if (map? origin)
    (if (= (set (keys origin)) #{:kind :source-id})
      (if (= nil (get origin :kind))
        false
        (if (= nil (get origin :source-id)) false true))
      false)
    false))

(defn sh13-origin-entries-valid? [origin-chain index]
  (if (= index (count origin-chain))
    true
    (if (sh13-origin-entry-valid? (get origin-chain index))
      (sh13-origin-entries-valid? origin-chain (+ index 1))
      false)))

(defn sh13-origin-chain-valid? [origin-chain]
  (if (vector? origin-chain)
    (if (> (count origin-chain) 0)
      (if (<= (count origin-chain) 16)
        (sh13-origin-entries-valid? origin-chain 0)
        false)
      false)
    false))

(defn sh13-i64? [value]
  (if (integer? value)
    (if (<= -9223372036854775808 value)
      (<= value 9223372036854775807)
      false)
    false))

(defn sh13-unique-by-key?
  [records key index seen]
  (if (= index (count records))
    true
    (let [value (get (get records index) key)]
      (if (= nil value)
        false
        (if (contains? seen value)
          false
          (sh13-unique-by-key?
           records key (+ index 1) (conj seen value)))))))

(defn sh13-find-by-key [records key value index]
  (if (= index (count records))
    nil
    (if (= value (get (get records index) key))
      (get records index)
      (sh13-find-by-key records key value (+ index 1)))))

(defn sh13-function [module function-id]
  (sh13-find-by-key (get module :functions) :fn-id function-id 0))

(defn sh13-block [function block-id]
  (sh13-find-by-key (get function :blocks) :block-id block-id 0))

(defn sh13-set-subset? [values allowed]
  (if (= 0 (count values))
    true
    (if (contains? allowed (first values))
      (sh13-set-subset? (rest values) allowed)
      false)))

(defn sh13-present? [value]
  (if (= nil value)
    false
    true))

(defn sh13-vector-values-present?
  [values available index]
  (if (= index (count values))
    true
    (if (contains? available (get values index))
      (sh13-vector-values-present? values available (+ index 1))
      false)))

(defn sh13-bind-values [names values index result]
  (if (= index (count names))
    result
    (sh13-bind-values
     names values (+ index 1)
     (assoc result (get names index) (get values index)))))

(defn sh13-types-by-name [names types index result]
  (if (= index (count names))
    result
    (sh13-types-by-name
     names types (+ index 1)
     (assoc result (get names index) (get types index)))))

(defn sh13-operation-common-valid? [operation]
  (if (map? operation)
    (if (= nil (get operation :op-id))
      false
      (if
       (sh13-member?
        #{:const :add :sub :mul :eq :lt :call}
        (get operation :opcode))
       (if (vector? (get operation :operands))
         (if (= nil (get operation :type))
           false
           (if (= (get operation :result) (get operation :op-id))
             (if (set? (get operation :effects))
               (if (= :passed (get operation :verifier-status))
                 (if (map? (get operation :facts))
                   (if (sh13-operation-facts-valid?
                        (get operation :facts))
                     (if (sh13-source-span-valid?
                          (get operation :source-span))
                       (sh13-origin-chain-valid?
                        (get operation :origin-chain))
                       false)
                     false)
                   false)
                 false)
               false)
             false))
         false)
       false))
    false))

(defn sh13-operation-facts-valid? [facts]
  (if (= (set (keys facts))
         #{:type :effect :ownership :capability :safety})
    (if (= nil (get facts :type))
      false
      (if (= nil (get facts :effect))
        false
        (if (= nil (get facts :ownership))
          false
          (if (= nil (get facts :capability))
            false
            (if (= nil (get facts :safety)) false true)))))
    false))

(defn sh13-operation-facts-match-module? [module operation]
  (let [facts (get operation :facts)]
    (if (= (get facts :type) (get module :type-table-id))
      (if (= (get facts :effect) (get module :effect-table-id))
        (if (= (get facts :ownership)
               (get module :ownership-table-id))
          (if (= (get facts :capability)
                 (get module :capability-table-id))
            (= (get facts :safety) (get module :safety-table-id))
            false)
          false)
        false)
      false)))

(defn sh13-operation-effect-order-valid? [operation]
  (if (> (count (get operation :effects)) 0)
    (= :sequence (get operation :ordering))
    (= nil (get operation :ordering))))

(defn sh13-operation-effect-family-valid? [operation]
  (if (= :call (get operation :opcode))
    true
    (= 0 (count (get operation :effects)))))

(defn sh13-literal-type-valid? [operation]
  (if (= :const (get operation :opcode))
    (if (= :i64 (get operation :type))
      (sh13-i64? (get operation :literal))
      (if (= :bool (get operation :type))
        (sh13-member? #{true false} (get operation :literal))
        (if (= :keyword (get operation :type))
          (keyword? (get operation :literal))
          false)))
    true))

(defn sh13-call-error [module function operation]
  (if (= :call (get operation :opcode))
    (let [callee (sh13-function module (get operation :callee))
          dispatch (get operation :dispatch)]
      (if (= nil callee)
        :verify
        (if (sh13-member? #{:direct :indirect} dispatch)
          (if (= dispatch :indirect)
            (if (set? (get operation :allowed-callees))
              (if (> (count (get operation :allowed-callees)) 0)
                (if
                 (sh13-allowed-callees-valid?
                  module (get operation :allowed-callees))
                  (if (contains?
                       (get operation :allowed-callees)
                       (get operation :callee))
                    (if (= (get operation :callee)
                           (get function :fn-id))
                      (if (= true (get function :recursive))
                        nil
                        :verify)
                      nil)
                    :verify)
                  :verify)
                :verify)
              :verify)
            (if (set? (get operation :allowed-callees))
              (if (= 0 (count (get operation :allowed-callees)))
                (if (= (get operation :callee) (get function :fn-id))
                  (if (= true (get function :recursive)) nil :verify)
                  nil)
                :verify)
              :verify))
          :verify)))
    nil))

(defn sh13-allowed-callees-valid? [module callees]
  (if (= 0 (count callees))
    true
    (if
     (sh13-present? (sh13-function module (first callees)))
      (sh13-allowed-callees-valid? module (rest callees))
      false)))

(defn sh13-call-argument-types-error
  [operands parameter-types types index]
  (if (= index (count operands))
    nil
    (if (= (get types (get operands index))
           (get parameter-types index))
      (sh13-call-argument-types-error
       operands parameter-types types (+ index 1))
      :type)))

(defn sh13-call-signature-error [module function operation types]
  (if (= :call (get operation :opcode))
    (let [callee (sh13-function module (get operation :callee))]
      (if (= nil callee)
        :verify
        (if (= (count (get operation :operands))
               (count (get callee :params)))
          (let [argument-error
                (sh13-call-argument-types-error
                 (get operation :operands)
                 (get callee :param-types)
                 types 0)]
            (if (= nil argument-error)
              (if (= (get operation :type) (get callee :return-type))
                (if (= (get operation :effects)
                       (get callee :latent-effects))
                  (if
                   (sh13-set-subset?
                    (get callee :latent-effects)
                    (get function :latent-effects))
                    nil
                    :effect)
                  :effect)
                :type)
              argument-error))
          :type)))
    nil))

(defn sh13-operation-type-error
  [module function operation types]
  (let [opcode (get operation :opcode)
        operands (get operation :operands)]
    (if (= opcode :const)
      (if (sh13-literal-type-valid? operation) nil :type)
      (if (= opcode :call)
        (sh13-call-signature-error module function operation types)
        (if (sh13-member? #{:add :sub :mul} opcode)
          (if (= 2 (count operands))
            (if (= :i64 (get types (get operands 0)))
              (if (= :i64 (get types (get operands 1)))
                (if (= :i64 (get operation :type)) nil :type)
                :type)
              :type)
            :type)
          (if (= :eq opcode)
            (if (= 2 (count operands))
              (if (= (get types (get operands 0))
                     (get types (get operands 1)))
                (if (= :bool (get operation :type)) nil :type)
                :type)
              :type)
            (if (= :lt opcode)
              (if (= 2 (count operands))
                (if (= :i64 (get types (get operands 0)))
                  (if (= :i64 (get types (get operands 1)))
                    (if (= :bool (get operation :type)) nil :type)
                    :type)
                  :type)
                :type)
              :type)))))))

(defn sh13-operations-error
  [module function operations index available types]
  (if (= index (count operations))
    nil
    (let [operation (get operations index)
          operation-id (get operation :op-id)]
      (if (sh13-operation-common-valid? operation)
        (if (= (get operation :profile) (get module :profile))
          (if (sh13-operation-facts-match-module? module operation)
            (if (contains? available operation-id)
          :dominance
          (if (sh13-operation-effect-family-valid? operation)
            (if (sh13-operation-effect-order-valid? operation)
            (if
             (sh13-vector-values-present?
              (get operation :operands) available 0)
              (if
               (sh13-set-subset?
                (get operation :effects)
                (get function :latent-effects))
                (let [call-error
                      (sh13-call-error module function operation)
                      type-error
                      (sh13-operation-type-error
                       module function operation types)]
                  (if (= nil call-error)
                    (if (= nil type-error)
                      (sh13-operations-error
                       module function operations (+ index 1)
                       (conj available operation-id)
                       (assoc types operation-id (get operation :type)))
                      type-error)
                    call-error))
                :effect)
              :dominance)
            :effect)
            :effect))
            :verify)
          :module)
        :origin))))

(defn sh13-block-available [block]
  (set (get block :params)))

(defn sh13-block-types [block]
  (sh13-types-by-name
   (get block :params) (get block :param-types) 0 {}))

(defn sh13-block-result-types [block index result]
  (if (= index (count (get block :operations)))
    result
    (let [operation (get (get block :operations) index)]
      (sh13-block-result-types
       block (+ index 1)
       (assoc result (get operation :op-id) (get operation :type))))))

(defn sh13-target-arguments-error
  [function target-id arguments types]
  (let [target (sh13-block function target-id)]
    (if (= nil target)
      :block
      (if (= (count arguments) (count (get target :params)))
        (if (sh13-vector-values-present?
             arguments (set (keys types)) 0)
          (sh13-target-argument-types-error
           arguments (get target :param-types) types 0)
          :dominance)
        :type))))

(defn sh13-target-argument-types-error
  [arguments target-types types index]
  (if (= index (count arguments))
    nil
    (if (= (get types (get arguments index))
           (get target-types index))
      (sh13-target-argument-types-error
       arguments target-types types (+ index 1))
      :type)))

(defn sh13-terminator-error [function block]
  (let [terminator (get block :terminator)
        opcode (get terminator :opcode)
        types
        (sh13-block-result-types
         block 0 (sh13-block-types block))]
    (if (map? terminator)
      (if
       (sh13-member?
        #{:return :error-return :throw :panic
          :branch :conditional-branch}
        opcode)
       (if (sh13-source-span-valid? (get terminator :source-span))
         (if (sh13-origin-chain-valid? (get terminator :origin-chain))
           (if (= opcode :return)
             (if (= (get types (get terminator :value))
                    (get function :return-type))
               nil
               :type)
             (if (sh13-member? #{:error-return :throw :panic} opcode)
               (if (contains? types (get terminator :value))
                 (if (= (get types (get terminator :value))
                        (get function :return-type))
                   (if (= opcode :throw)
                     (if (contains?
                          (get function :latent-effects) :error/throw)
                       nil
                       :effect)
                     nil)
                   :type)
                 :dominance)
               (if (= opcode :branch)
                 (sh13-target-arguments-error
                  function
                  (get terminator :target)
                  (get terminator :arguments)
                  types)
                 (if (= :bool (get types (get terminator :condition)))
                   (let [then-error
                         (sh13-target-arguments-error
                          function
                          (get terminator :then-target)
                          (get terminator :then-arguments)
                          types)
                         else-error
                         (sh13-target-arguments-error
                          function
                          (get terminator :else-target)
                          (get terminator :else-arguments)
                          types)]
                     (if (= nil then-error) else-error then-error))
                   :type))))
           :origin)
         :origin)
       :block)
      :block)))

(defn sh13-block-common-valid? [block]
  (if (map? block)
    (if (= nil (get block :block-id))
      false
      (if (vector? (get block :params))
        (if (vector? (get block :param-types))
          (if (= (count (get block :params))
                 (count (get block :param-types)))
            (if (sh13-unique-values?
                 (get block :params) 0 #{})
              (if (<= (count (get block :params)) 8)
              (if (vector? (get block :operations))
                (if (<= (count (get block :operations)) 64)
                  (if (sh13-source-span-valid? (get block :source-span))
                    (sh13-origin-chain-valid?
                     (get block :origin-chain))
                    false)
                  false)
                false)
              false)
              false)
            false)
          false)
        false))
    false))

(defn sh13-unique-values? [values index seen]
  (if (= index (count values))
    true
    (let [value (get values index)]
      (if (= nil value)
        false
        (if (contains? seen value)
          false
          (sh13-unique-values?
           values (+ index 1) (conj seen value)))))))

(defn sh13-operation-ids-unique?
  [blocks block-index operation-index seen]
  (if (= block-index (count blocks))
    true
    (let [operations (get (get blocks block-index) :operations)]
      (if (= operation-index (count operations))
        (sh13-operation-ids-unique?
         blocks (+ block-index 1) 0 seen)
        (let [operation-id
              (get (get operations operation-index) :op-id)]
          (if (= nil operation-id)
            false
            (if (contains? seen operation-id)
              false
              (sh13-operation-ids-unique?
               blocks block-index (+ operation-index 1)
               (conj seen operation-id)))))))))

(defn sh13-block-successors [block]
  (let [terminator (get block :terminator)
        opcode (get terminator :opcode)]
    (if (= opcode :branch)
      [(get terminator :target)]
      (if (= opcode :conditional-branch)
        [(get terminator :then-target)
         (get terminator :else-target)]
        []))))

(defn sh13-conj-unseen [values index seen pending]
  (if (= index (count values))
    pending
    (let [value (get values index)]
      (if (contains? seen value)
        (sh13-conj-unseen values (+ index 1) seen pending)
        (sh13-conj-unseen
         values (+ index 1) seen (conj pending value))))))

(defn sh13-reachable-blocks [function pending seen]
  (if (= 0 (count pending))
    seen
    (let [block-id (first pending)
          remaining (vec (rest pending))]
      (if (contains? seen block-id)
        (sh13-reachable-blocks function remaining seen)
        (let [block (sh13-block function block-id)]
          (if (= nil block)
            seen
            (let [next-seen (conj seen block-id)]
              (sh13-reachable-blocks
               function
               (sh13-conj-unseen
                (sh13-block-successors block) 0
                next-seen remaining)
               next-seen))))))))

(defn sh13-all-blocks-reachable? [function]
  (= (count (sh13-reachable-blocks
             function [(get function :entry-block)] #{}))
     (count (get function :blocks))))

(defn sh13-blocks-error [module function blocks index]
  (if (= index (count blocks))
    nil
    (let [block (get blocks index)]
      (if (sh13-block-common-valid? block)
        (let [operations-error
              (sh13-operations-error
               module function (get block :operations) 0
               (sh13-block-available block)
               (sh13-block-types block))]
          (if (= nil operations-error)
            (let [terminator-error
                  (sh13-terminator-error function block)]
              (if (= nil terminator-error)
                (sh13-blocks-error module function blocks (+ index 1))
                terminator-error))
            operations-error))
        :block))))

(defn sh13-entry-signature-valid? [function]
  (let [entry (sh13-block function (get function :entry-block))]
    (if (= nil entry)
      false
      (if (= (get entry :params) (get function :params))
        (= (get entry :param-types) (get function :param-types))
        false))))

(defn sh13-function-common-valid? [function]
  (if (map? function)
    (if (= nil (get function :fn-id))
      false
      (if (vector? (get function :params))
        (if (vector? (get function :param-types))
          (if (= (count (get function :params))
                 (count (get function :param-types)))
            (if (sh13-unique-values?
                 (get function :params) 0 #{})
              (if (<= (count (get function :params)) 8)
              (if (= nil (get function :return-type))
                false
                (if (set? (get function :latent-effects))
                  (if (vector? (get function :blocks))
                    (if (> (count (get function :blocks)) 0)
                      (if (<= (count (get function :blocks)) 32)
                        (if
                         (sh13-unique-by-key?
                          (get function :blocks) :block-id 0 #{})
                          (if (sh13-entry-signature-valid? function)
                              (if (sh13-member?
                                     #{true false}
                                     (get function :recursive))
                                  (if (integer?
                                 (get function :maximum-call-depth))
                              (if (> (get function
                                          :maximum-call-depth) 0)
                                (if (<= (get function
                                            :maximum-call-depth) 32)
                                  (if
                                   (sh13-source-span-valid?
                                    (get function :source-span))
                                    (sh13-origin-chain-valid?
                                     (get function :origin-chain))
                                    false)
                                  false)
                                false)
                                    false)
                                  false)
                              false)
                          false)
                        false)
                      false)
                    false)
                  false))
              false)
              false)
            false)
          false)
        false))
    false))

(defn sh13-module-fact-lineage-valid? [module]
  (if (sh13-present? (get module :checked-core-id))
    (if (sh13-present? (get module :type-table-id))
      (if (sh13-present? (get module :effect-table-id))
        (if (sh13-present? (get module :ownership-table-id))
          (if (sh13-present? (get module :capability-table-id))
            (if (sh13-present? (get module :safety-table-id))
              (if (sh13-present? (get module :source-map-id))
                true
                false)
              false)
            false)
          false)
        false)
      false)
    false))

(defn sh13-mir-verifier-report-valid? [module]
  (let [report (get module :mir-verifier-report)]
    (if (map? report)
      (if (= (set (keys report))
             #{:artifact :status :module-id})
        (if (= :gravity/c11-mir-verifier-report
               (get report :artifact))
          (if (= :passed (get report :status))
            (= (get module :module-id) (get report :module-id))
            false)
          false)
        false)
      false)))

(defn sh13-functions-error [module functions index]
  (if (= index (count functions))
    nil
    (let [function (get functions index)]
      (if (sh13-function-common-valid? function)
        (if (sh13-operation-ids-unique?
             (get function :blocks) 0 0 #{})
          (let [block-error
                (sh13-blocks-error
                 module function (get function :blocks) 0)]
            (if (= nil block-error)
              (if (sh13-all-blocks-reachable? function)
                (if (sh13-mutual-call-cycle-from?
                     module (get function :fn-id))
                  :verify
                  (sh13-functions-error module functions (+ index 1)))
                :dominance)
              block-error))
          :dominance)
        :module))))

(defn sh13-cross-callees-in-operations
  [function-id operations index result]
  (if (= index (count operations))
    result
    (let [operation (get operations index)
          callee (get operation :callee)]
      (if (= :call (get operation :opcode))
        (if (= callee function-id)
          (sh13-cross-callees-in-operations
           function-id operations (+ index 1) result)
          (sh13-cross-callees-in-operations
           function-id operations (+ index 1) (conj result callee)))
        (sh13-cross-callees-in-operations
         function-id operations (+ index 1) result)))))

(defn sh13-cross-callees-in-blocks
  [function-id blocks index result]
  (if (= index (count blocks))
    result
    (sh13-cross-callees-in-blocks
     function-id blocks (+ index 1)
     (sh13-cross-callees-in-operations
      function-id (get (get blocks index) :operations) 0 result))))

(defn sh13-cross-callees [function]
  (sh13-cross-callees-in-blocks
   (get function :fn-id) (get function :blocks) 0 []))

(defn sh13-append-values [values index result]
  (if (= index (count values))
    result
    (sh13-append-values
     values (+ index 1) (conj result (get values index)))))

(defn sh13-call-path-reaches?
  [module pending target visited]
  (if (= 0 (count pending))
    false
    (let [function-id (first pending)
          remaining (vec (rest pending))]
      (if (= function-id target)
        true
        (if (contains? visited function-id)
          (sh13-call-path-reaches?
           module remaining target visited)
          (let [function (sh13-function module function-id)]
            (sh13-call-path-reaches?
             module
             (sh13-append-values
              (sh13-cross-callees function) 0 remaining)
             target
             (conj visited function-id))))))))

(defn sh13-mutual-call-cycle-from? [module function-id]
  (let [function (sh13-function module function-id)]
    (sh13-call-path-reaches?
     module (sh13-cross-callees function) function-id #{})))

(defn sh13-module-error [module]
  (if (map? module)
    (if (= :gravity/sh13-control-flow-module (get module :artifact))
      (if (= true (get module :mir-verified))
        (if (sh13-present? (get module :module-id))
          (if (= :native (get module :profile))
            (if (= :portable-mir (get module :target))
              (if (vector? (get module :functions))
                (if (> (count (get module :functions)) 0)
                  (if (<= (count (get module :functions)) 32)
                    (if
                     (sh13-unique-by-key?
                      (get module :functions) :fn-id 0 #{})
                      (if (sh13-module-fact-lineage-valid? module)
                        (if (sh13-mir-verifier-report-valid? module)
                          (if (string? (get module :actual-source-path))
                            (if (> (count (get module :actual-source-path)) 0)
                              (if (<= (count (get module
                                                  :actual-source-path)) 4096)
                                (if
                       (sh13-present?
                        (sh13-function module (get module :entry-function)))
                        (if (integer? (get module :maximum-execution-steps))
                          (if (> (get module
                                      :maximum-execution-steps) 0)
                            (if (<= (get module
                                        :maximum-execution-steps) 512)
                              (if
                               (sh13-source-span-valid?
                                (get module :source-span))
                                (if
                                 (sh13-origin-chain-valid?
                                  (get module :origin-chain))
                                  (sh13-functions-error
                                   module (get module :functions) 0)
                                  :origin)
                                :origin)
                              :module)
                            :module)
                          :module)
                                  :verify)
                                :module)
                              :module)
                            :module)
                          :verify)
                        :module)
                      :verify)
                    :module)
                  :module)
                :module)
              :module)
            :module)
          :module)
        :module)
      :module)
    :module))

(defn sh13-rule [error]
  (if (= error :block)
    "C11-BLOCK"
    (if (= error :dominance)
      "C11-DOMINANCE"
      (if (= error :type)
        "C11-TYPE"
        (if (= error :effect)
          "C11-EFFECT"
          (if (= error :origin)
            "C11-ORIGIN"
            (if (= error :verify)
              "C11-VERIFY"
              "C11-MODULE")))))))

(defn sh13-diagnostic [module error]
  {:artifact :gravity/sh13-control-flow-diagnostic
   :diagnostic-id (sh13-rule error)
   :rule (sh13-rule error)
   :reason error
   :stage :execute-mir
   :module-id (get module :module-id)
   :entry-function (get module :entry-function)
   :profile (get module :profile)
   :target (get module :target)
   :actual-source-path (get module :actual-source-path)
   :source-span (get module :source-span)
   :origin-chain (get module :origin-chain)
   :remediation :supply-bounded-verified-typed-effect-ordered-mir})

(defn sh13-resolve-values [references values index result]
  (if (= index (count references))
    result
    (sh13-resolve-values
     references values (+ index 1)
     (conj result (get values (get references index))))))

(defn sh13-execution-rejected [fuel trace reason]
  {:status :rejected
   :reason reason
   :fuel fuel
   :trace trace})

(defn sh13-continued-value
  [operation value fuel trace]
  (if (= :i64 (get operation :type))
    (if (sh13-i64? value)
      {:status :continue
       :value value
       :fuel fuel
       :trace trace}
      (sh13-execution-rejected fuel trace :integer-range))
    {:status :continue
     :value value
     :fuel fuel
     :trace trace}))

(defn sh13-add-safe? [left right]
  (if (> right 0)
    (<= left (- 9223372036854775807 right))
    (if (< right 0)
      (>= left (- -9223372036854775808 right))
      true)))

(defn sh13-sub-safe? [left right]
  (if (> right 0)
    (>= left (+ -9223372036854775808 right))
    (if (< right 0)
      (<= left (+ 9223372036854775807 right))
      true)))

(defn sh13-mul-safe? [left right]
  (if (= left 0)
    true
    (if (= right 0)
      true
      (if (> left 0)
        (if (> right 0)
          (<= left (quot 9223372036854775807 right))
          (>= right (quot -9223372036854775808 left)))
        (if (> right 0)
          (>= left (quot -9223372036854775808 right))
          (>= left (quot 9223372036854775807 right)))))))

(defn sh13-execute-operation
  [module function operation values fuel depth trace]
  (if (<= fuel 0)
    (sh13-execution-rejected fuel trace :execution-step-bound)
    (let [opcode (get operation :opcode)
          operands
          (sh13-resolve-values
           (get operation :operands) values 0 [])
          next-fuel (- fuel 1)
          next-trace
          (conj trace
                {:function (get function :fn-id)
                 :operation (get operation :op-id)
                 :opcode opcode})]
      (if (= opcode :const)
        (sh13-continued-value
         operation (get operation :literal) next-fuel next-trace)
        (if (= opcode :add)
          (if (sh13-add-safe? (get operands 0) (get operands 1))
            (sh13-continued-value
             operation (+ (get operands 0) (get operands 1))
             next-fuel next-trace)
            (sh13-execution-rejected
             next-fuel next-trace :integer-range))
          (if (= opcode :sub)
            (if (sh13-sub-safe? (get operands 0) (get operands 1))
              (sh13-continued-value
               operation (- (get operands 0) (get operands 1))
               next-fuel next-trace)
              (sh13-execution-rejected
               next-fuel next-trace :integer-range))
            (if (= opcode :mul)
              (if (sh13-mul-safe? (get operands 0) (get operands 1))
                (sh13-continued-value
                 operation (* (get operands 0) (get operands 1))
                 next-fuel next-trace)
                (sh13-execution-rejected
                 next-fuel next-trace :integer-range))
              (if (= opcode :eq)
                {:status :continue
                 :value (= (get operands 0) (get operands 1))
                 :fuel next-fuel
                 :trace next-trace}
                (if (= opcode :lt)
                  {:status :continue
                   :value (< (get operands 0) (get operands 1))
                   :fuel next-fuel
                   :trace next-trace}
                  (let [call-result
                        (sh13-execute-function
                         module (get operation :callee) operands
                         (+ depth 1) next-fuel next-trace)]
                    (if (= :returned (get call-result :status))
                      {:status :continue
                       :value (get call-result :value)
                       :fuel (get call-result :fuel)
                       :trace (get call-result :trace)}
                      call-result)))))))))))

(defn sh13-execute-operations
  [module function operations index values fuel depth trace]
  (if (= index (count operations))
    {:status :continue
     :values values
     :fuel fuel
     :trace trace}
    (let [operation (get operations index)
          result
          (sh13-execute-operation
           module function operation values fuel depth trace)]
      (if (= :continue (get result :status))
        (sh13-execute-operations
         module function operations (+ index 1)
         (assoc values (get operation :op-id) (get result :value))
         (get result :fuel) depth (get result :trace))
        result))))

(defn sh13-execute-terminator
  [module function block terminator values fuel depth trace]
  (if (<= fuel 0)
    (sh13-execution-rejected fuel trace :execution-step-bound)
    (let [opcode (get terminator :opcode)
          next-fuel (- fuel 1)
          next-trace
          (conj trace
                {:function (get function :fn-id)
                 :block (get block :block-id)
                 :terminator opcode})]
      (if (= opcode :return)
        {:status :returned
         :value (get values (get terminator :value))
         :fuel next-fuel
         :trace next-trace}
        (if (= opcode :error-return)
          {:status :error
           :value (get values (get terminator :value))
           :fuel next-fuel
           :trace next-trace}
          (if (= opcode :throw)
            {:status :thrown
             :value (get values (get terminator :value))
             :fuel next-fuel
             :trace next-trace}
            (if (= opcode :panic)
              {:status :panic
               :value (get values (get terminator :value))
               :fuel next-fuel
               :trace next-trace}
              (if (= opcode :branch)
                (sh13-execute-block
                 module function (get terminator :target)
                 (sh13-resolve-values
                  (get terminator :arguments) values 0 [])
                 depth next-fuel next-trace)
                (if (= true
                       (get values (get terminator :condition)))
                  (sh13-execute-block
                   module function (get terminator :then-target)
                   (sh13-resolve-values
                    (get terminator :then-arguments) values 0 [])
                   depth next-fuel next-trace)
                  (sh13-execute-block
                   module function (get terminator :else-target)
                   (sh13-resolve-values
                    (get terminator :else-arguments) values 0 [])
                   depth next-fuel next-trace))))))))))

(defn sh13-execute-block
  [module function block-id arguments depth fuel trace]
  (let [block (sh13-block function block-id)
        values
        (sh13-bind-values
         (get block :params) arguments 0 {})
        operations-result
        (sh13-execute-operations
         module function (get block :operations) 0
         values fuel depth trace)]
    (if (= :continue (get operations-result :status))
      (sh13-execute-terminator
       module function block (get block :terminator)
       (get operations-result :values)
       (get operations-result :fuel)
       depth (get operations-result :trace))
      operations-result)))

(defn sh13-execute-function
  [module function-id arguments depth fuel trace]
  (let [function (sh13-function module function-id)]
    (if (> depth (get function :maximum-call-depth))
      (sh13-execution-rejected fuel trace :call-depth-bound)
      (sh13-execute-block
       module function (get function :entry-block)
       arguments depth fuel
       (conj trace
             {:function function-id
              :event :enter
              :depth depth})))))

(defn sh13-identity-input [module]
  {:artifact (get module :artifact)
   :module-id (get module :module-id)
   :mir-verified (get module :mir-verified)
   :mir-verifier-report (get module :mir-verifier-report)
   :checked-core-id (get module :checked-core-id)
   :type-table-id (get module :type-table-id)
   :effect-table-id (get module :effect-table-id)
   :ownership-table-id (get module :ownership-table-id)
   :capability-table-id (get module :capability-table-id)
   :safety-table-id (get module :safety-table-id)
   :source-map-id (get module :source-map-id)
   :profile (get module :profile)
   :target (get module :target)
   :entry-function (get module :entry-function)
   :maximum-execution-steps (get module :maximum-execution-steps)
   :source-span
   {:source-id (get (get module :source-span) :source-id)
    :start (get (get module :source-span) :start)
    :end (get (get module :source-span) :end)}
   :origin-chain (get module :origin-chain)
   :functions (get module :functions)})

(defn sh13-accepted-execution [module arguments]
  (let [execution
        (sh13-execute-function
         module (get module :entry-function) arguments 0
         (get module :maximum-execution-steps) [])]
    (if (= :rejected (get execution :status))
      {:artifact :gravity/sh13-control-flow-execution
       :schema-version 1
       :status :rejected
       :module-id (get module :module-id)
       :diagnostics
       [(sh13-diagnostic module :verify)]
       :execution execution
       :clojure-seed-boundary? true
       :self-hosted? false
       :pending (get (sh13-control-flow-policy) :pending)}
      {:artifact :gravity/sh13-control-flow-execution
       :schema-version 1
       :status :accepted
       :module-id (get module :module-id)
       :entry-function (get module :entry-function)
       :arguments arguments
       :execution execution
       :call-graph
       {:artifact :gravity/sh13-call-graph
        :functions
        (sh13-function-ids (get module :functions) 0 [])
        :bounded-call-depth true}
       :control-flow
       {:artifact :gravity/sh13-control-flow-report
        :structured-exit (get execution :status)
        :steps-used
        (- (get module :maximum-execution-steps)
           (get execution :fuel))}
       :identity-input (sh13-identity-input module)
       :provenance
       {:actual-source-path (get module :actual-source-path)
        :source-span (get module :source-span)
        :origin-chain (get module :origin-chain)}
       :diagnostics []
       :clojure-seed-boundary? true
       :self-hosted? false
       :pending (get (sh13-control-flow-policy) :pending)})))

(defn sh13-function-ids [functions index result]
  (if (= index (count functions))
    result
    (sh13-function-ids
     functions (+ index 1)
     (conj result (get (get functions index) :fn-id)))))

(defn sh13-value-type-valid? [value value-type]
  (if (= value-type :i64)
    (sh13-i64? value)
    (if (= value-type :bool)
      (sh13-member? #{true false} value)
      (if (= value-type :keyword)
        (keyword? value)
        false))))

(defn sh13-argument-values-valid?
  [arguments argument-types index]
  (if (= index (count arguments))
    true
    (if (sh13-value-type-valid?
         (get arguments index) (get argument-types index))
      (sh13-argument-values-valid?
       arguments argument-types (+ index 1))
      false)))

(defn sh13-run-module [module arguments]
  (let [error (sh13-module-error module)
        entry (sh13-function module (get module :entry-function))]
    (if (= nil error)
      (if (vector? arguments)
        (if (= (count arguments) (count (get entry :params)))
          (if (sh13-argument-values-valid?
               arguments (get entry :param-types) 0)
            (sh13-accepted-execution module arguments)
            {:artifact :gravity/sh13-control-flow-execution
             :schema-version 1
             :status :rejected
             :module-id (get module :module-id)
             :diagnostics [(sh13-diagnostic module :type)]
             :pending (get (sh13-control-flow-policy) :pending)})
          {:artifact :gravity/sh13-control-flow-execution
           :schema-version 1
           :status :rejected
           :module-id (get module :module-id)
           :diagnostics [(sh13-diagnostic module :type)]
           :pending (get (sh13-control-flow-policy) :pending)})
        {:artifact :gravity/sh13-control-flow-execution
         :schema-version 1
         :status :rejected
         :module-id (get module :module-id)
         :diagnostics [(sh13-diagnostic module :type)]
         :pending (get (sh13-control-flow-policy) :pending)})
      {:artifact :gravity/sh13-control-flow-execution
       :schema-version 1
       :status :rejected
       :module-id (get module :module-id)
       :diagnostics [(sh13-diagnostic module error)]
       :pending (get (sh13-control-flow-policy) :pending)})))

(defn sh13-verify-execution [module arguments candidate]
  (if (= (sh13-run-module module arguments) candidate)
    {:artifact :gravity/sh13-control-flow-verification
     :status :passed
     :module-id (get module :module-id)}
    {:artifact :gravity/sh13-control-flow-verification
     :status :rejected
     :module-id (get module :module-id)
     :diagnostics
     [{:artifact :gravity/sh13-control-flow-diagnostic
       :diagnostic-id "C11-VERIFY"
       :rule "C11-VERIFY"
       :reason :execution-result-substitution}]}))

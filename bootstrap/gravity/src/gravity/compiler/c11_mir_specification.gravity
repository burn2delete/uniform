(defn sh12-c10-mir-c9-identity-order-valid?
  [ownership-core owned identities request result fact fact-identity]
  (let [identity-input (get ownership-core :identity-input)
        resolutions (get ownership-core :identity-resolutions)
        fact-resolutions (get resolutions :fact-resolutions)
        core-resolution (get resolutions :core-resolution)
        fact-digest (get fact-identity :ownership-fact-id)
        core-digest (get ownership-core :ownership-core-identity-id)
        identity-request
        {:domain :gravity/sh10-ownership-fact-identity-v2
         :kind :ownership-fact
         :core-node-id (get fact :value-id)
         :identity-input
         {:fact fact
          :fact-id-request (get fact :fact-id-request)
          :ownership-request request
          :ownership-result result
          :source-span (get fact :source-span)
          :origin-chain (get fact :origin-chain)
          :profile (get request :profile)
          :target (get request :target)}}]
    (if (= identities (get identity-input :ordered-fact-identities))
      (if (= (get identity-input :ownership-core-identity-input)
             (get owned :identity-input))
        (if (sh12-c10-mir-exact-keys?
             resolutions #{:fact-resolutions :core-resolution})
          (if (vector? fact-resolutions)
            (if (= 1 (count fact-resolutions))
              (if (sh12-c10-mir-c9-resolution-valid?
                   identity-request
                   (first fact-resolutions))
                (if (sh12-c10-mir-c9-resolution-valid?
                     (sh12-c10-mir-c9-core-request-expected
                      ownership-core identities)
                     core-resolution)
                  (if (= fact-digest
                         (get (first fact-resolutions) :digest))
                    (if (= core-digest (get core-resolution :digest))
                      (if (= fact-digest core-digest)
                        false
                        true)
                      false)
                    false)
                  false)
                false)
              false)
            false)
          false)
        false)
      false)))

(defn sh12-c10-mir-c9-proof-request-expected
  [ownership-core request fact fact-identity]
  (let [state (get fact :state-before)]
    {:domain :gravity/sh11-persistent-read-proof-v2
     :operation-id :load
     :core-node-id (get request :value-id)
     :value-type :gravity.type/bool
     :ownership-fact-id (get fact-identity :ownership-fact-id)
     :fact-id-request (get fact :fact-id-request)
     :ownership-kind (get request :ownership-kind)
     :initialization (get state :initialization)
     :availability (get state :availability)
     :event-id (get fact :event-id)
     :event (get fact :operation)
     :ownership-core-identity-id
     (get ownership-core :ownership-core-identity-id)
     :source-span (get fact :source-span)
     :origin-chain (get fact :origin-chain)
     :profile (get fact :profile)
     :target (get fact :target)
     :type-fact-id (get request :type-fact-id)
     :effect-fact-id (get request :effect-fact-id)
     :capability-proof-id (get request :capability-proof-id)}))

(defn sh12-c10-mir-c9-read-admission-valid? [bound]
  (let [ownership-core (get bound :ownership-core)
        owned (get ownership-core :ownership-core)
        requests (get owned :ownership-requests)
        results (get owned :ownership-results)
        identities (get ownership-core :fact-identities)]
    (if (vector? requests)
      (if (= 1 (count requests))
        (if (vector? results)
          (if (= 1 (count results))
            (if (vector? identities)
              (if (= 1 (count identities))
                (let [request (first requests)
                      result (first results)
                      facts (get result :ownership-facts)
                      fact-identity (first identities)]
                  (if (vector? facts)
                    (if (= 1 (count facts))
                      (let [fact (first facts)]
                        (if (sh12-c10-mir-c9-request-valid? request)
                          (if (sh12-c10-mir-c9-result-valid? request result)
                            (if (sh12-c10-mir-c9-fact-valid?
                                 request result fact fact-identity)
                              (if (sh12-c10-mir-c9-c8-admission-valid?
                                   bound request)
                                (if (sh12-c10-mir-c9-identity-order-valid?
                                     ownership-core owned identities request
                                     result fact fact-identity)
                                  (if (= (sh12-c10-mir-proof-request-from-bound
                                          bound)
                                         (sh12-c10-mir-c9-proof-request-expected
                                          ownership-core request fact
                                          fact-identity))
                                    true
                                    false)
                                  false)
                                false)
                              false)
                            false)
                          false))
                      false)
                    false))
                false)
              false)
            false)
          false)
        false)
      false)))

(defn sh12-c10-mir-c9-lineage-extras-valid? [bound]
  (let [ownership-core (get bound :ownership-core)
        owned (get ownership-core :ownership-core)
        identities (get ownership-core :fact-identities)
        identity (first identities)
        fact-request (get identity :fact-id-request)
        requests (get owned :ownership-requests)
        results (get owned :ownership-results)
        result (first results)
        facts (get result :ownership-facts)
        fact (first facts)
        identity-request
        {:domain :gravity/sh10-ownership-fact-identity-v2
         :kind :ownership-fact
         :core-node-id (get fact :value-id)
         :identity-input
         {:fact fact
          :fact-id-request (get fact :fact-id-request)
          :ownership-request (first requests)
          :ownership-result result
          :source-span (get fact :source-span)
          :origin-chain (get fact :origin-chain)
          :profile (get (first requests) :profile)
          :target (get (first requests) :target)}}
        identity-body (get identity-request :identity-input)
        resolutions (get ownership-core :identity-resolutions)
        fact-resolutions (get resolutions :fact-resolutions)
        core-resolution (get resolutions :core-resolution)
        expected-core-request
        (sh12-c10-mir-c9-core-request-expected
         ownership-core identities)]
    (if (= :persistent-immutable-pure-primitive-reads
           (get ownership-core :scope))
      (if (= :coordinator-digest-bound
             (get ownership-core :identity-resolution))
        (if (= :coordinator-resolution-shape-checked
               (get ownership-core :identity-binding-status))
          (if (= [] (get ownership-core :diagnostics))
            (if (= false (get ownership-core :self-hosted?))
              (if (= true (get ownership-core :clojure-seed-boundary?))
                (if (sh12-c10-mir-sha256-id?
                     (get ownership-core :ownership-core-identity-id))
                  (if (= (get ownership-core :pending)
                         (get (get ownership-core :identity-input)
                              :pending))
                    (if (vector? requests)
                      (if (= 1 (count requests))
                        (if (vector? results)
                          (if (= 1 (count results))
                            (if (= :accepted (get result :status))
                              (if (vector? facts)
                                (if (= 1 (count facts))
                                  (if (= :gravity/c9-ownership-fact
                                         (get fact :artifact))
                                    (if (map? (get fact :fact-id-request))
                                      (if (= fact-request
                                             (get fact :fact-id-request))
                                        (if (map? identity-body)
                                          (if (sh12-c10-mir-c9-fact-source-valid?
                                               fact identity-body)
                                            (if (= (first requests)
                                                   (get identity-body
                                                       :ownership-request))
                                              (if (= result
                                                     (get identity-body
                                                         :ownership-result))
                                                (if (vector? fact-resolutions)
                                                  (if (= 1
                                                         (count fact-resolutions))
                                                    (if (sh12-c10-mir-c9-resolution-valid?
                                                         identity-request
                                                         (first fact-resolutions))
                                                      (if (= (get identity
                                                                  :ownership-fact-id)
                                                             (get (first fact-resolutions)
                                                                  :digest))
                                                        (if (sh12-c10-mir-c9-resolution-valid?
                                                             expected-core-request
                                                             core-resolution)
                                                          (if (= (get ownership-core
                                                                      :ownership-core-identity-id)
                                                                 (get core-resolution
                                                                      :digest))
                                                            (if (= (get bound :proof-id)
                                                                   (get (get (get bound
                                                                                 :operation)
                                                                            :facts)
                                                                       :proof-id))
                                                              (if (sh12-c10-mir-c9-read-admission-valid?
                                                                   bound)
                                                                true
                                                                false)
                                                              false)
                                                            false)
                                                          false)
                                                        false)
                                                      false)
                                                    false)
                                                  false)
                                                false)
                                              false)
                                            false)
                                          false)
                                        false)
                                      false)
                                    false)
                                  false)
                                false)
                              false)
                            false)
                          false)
                        false)
                      false)
                    false)
                  false)
                false)
                false)
              false)
            false)
          false)
        false)))

(defn sh12-c10-mir-c9-lineage-valid? [bound]
  (let [ownership-core (get bound :ownership-core)
        c9-identity-input (get ownership-core :identity-input)
        c10-identity-input (get bound :identity-input)
        identities (get ownership-core :fact-identities)
        operation (get bound :operation)]
    (if (sh12-c10-mir-exact-keys?
         ownership-core
         #{:artifact :schema-version :status :scope :ownership-core
           :fact-identities :ownership-core-identity-id :identity-input
           :identity-resolution :identity-binding-status
           :identity-resolutions :provenance :diagnostics :pending
           :self-hosted? :clojure-seed-boundary?})
      (if (= :gravity/sh10-identity-bound-owned-core-template
             (get ownership-core :artifact))
        (if (= 2 (get ownership-core :schema-version))
          (if (= :accepted (get ownership-core :status))
            (if (sh12-c10-mir-exact-keys?
                 c9-identity-input
                 #{:domain :ownership-core-identity-input
                   :ordered-fact-identities :ownership-core-identity-id
                   :pending})
              (if (= :gravity/sh10-identity-bound-owned-core-v2
                     (get c9-identity-input :domain))
                (if (= (get ownership-core :pending)
                       (get c9-identity-input :pending))
                  (if (= (get c9-identity-input :ownership-core-identity-id)
                         (get ownership-core
                              :ownership-core-identity-id))
                    (if (= (get c9-identity-input
                                :ownership-core-identity-id)
                           (get c10-identity-input
                                :ownership-core-identity-id))
                      (if (= c9-identity-input
                             (get c10-identity-input
                                  :ownership-core-identity-input))
                        (if (vector? identities)
                          (if (= 1 (count identities))
                            (if (= (get (first identities)
                                         :ownership-fact-id)
                                   (get operation :ownership-fact-id))
                              (sh12-c10-mir-c9-lineage-extras-valid? bound)
                              false)
                            false)
                          false)
                        false)
                      false)
                    false)
                  false)
                false)
              false)
            false)
          false)
        false)
      false)))

(defn sh12-c10-mir-provenance-chain-valid? [bound]
  (let [c10-provenance (get bound :provenance)
        c9-bound (get bound :ownership-core)
        owned (get c9-bound :ownership-core)
        c8-bound (get owned :effected-core)
        effected (get c8-bound :effected-core)
        c9-provenance (get c9-bound :provenance)
        owned-provenance (get owned :provenance)
        c8-provenance (get c8-bound :provenance)
        effected-provenance (get effected :provenance)]
    (if (map? c10-provenance)
      (if (map? c9-provenance)
        (if (map? owned-provenance)
          (if (map? c8-provenance)
            (if (map? effected-provenance)
              (if (= c10-provenance c9-provenance)
                (if (= c10-provenance owned-provenance)
                  (if (= c10-provenance c8-provenance)
                    (= c10-provenance effected-provenance)
                    false)
                  false)
                false)
              false)
            false)
          false)
        false)
      false)))

(defn sh12-c10-mir-bound-shape-valid? [bound]

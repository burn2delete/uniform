              (if (= :coordinator-resolution-shape-checked
                     (get bound :identity-binding-status))
                (if (sh12-c10-mir-sha256-id? (get bound :proof-id))
                  (if (sh12-c10-mir-sha256-id? (get bound :result-id))
                    (if (sh12-c10-mir-sha256-id? (get bound :safety-core-id))
                      (let [identity-input (get bound :identity-input)]
                        (if (sh12-c10-mir-exact-keys?
                             identity-input

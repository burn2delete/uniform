(defn sh12-c10-mir-c9-fact-source-valid? [fact identity-body]
  (if (= fact (get identity-body :fact))
    (if (= (get fact :source-span) (get identity-body :source-span))
      (if (= (get fact :origin-chain) (get identity-body :origin-chain))
        (if (= (get fact :profile) (get identity-body :profile))
          (if (= (get fact :target) (get identity-body :target))
            true
            false)
          false)
        false)
      false)

                                   (get bound :result-id))
                              (if (= (get identity-input :safety-core-id)
                                     (get bound :safety-core-id))
                                (if (sh12-c10-mir-bound-pending-valid?
                                     bound identity-input)
                                  (if (sh12-c10-mir-resolutions-valid? bound)
                                    (if (= (sh12-c10-mir-binding-nonclaims)
                                           (get bound :nonclaims))
                                      (if (= (get bound :self-hosted?) false)
                                        (if (= (get bound :clojure-seed-boundary?) true)
                                          (if (= (get bound :pending)
                                                 (get identity-input :pending))
                                            (if (sh12-c10-mir-c9-lineage-valid?
                                                 bound)
                                              (if (sh12-c10-mir-safety-result-valid?
                                                   bound)
                                              (if (sh12-c10-mir-safety-verification-valid?
                                                     bound)
                                                  (if (= [] (get bound :diagnostics))
                                                    (if (sh12-c10-mir-provenance-chain-valid?
                                                         bound)
                                                      true
                                                      false)
                                                    false)
                                                  false)
                                                false)
                                              false)
                                            false)
                                          false)
                                        false)
                                      false)
                                    false)

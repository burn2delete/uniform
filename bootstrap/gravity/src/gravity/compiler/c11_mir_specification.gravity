          :terminator-id terminator-id
          :kind kind
          :operands operands
          :successors successors
          :effects effects
          :source source
          :profile profile
          :facts facts
          :verifier-status :pending
          :contract c11-mir-terminator-contract}))

(defn build-c11-mir-instruction
  [op-id opcode operands result constant-payload type effects ordering source profile facts domain-anchor]
  (quote {:artifact :gravity/mir-instruction
          :op-id op-id
          :opcode opcode
          :operands operands
          :result result
          :constant-payload constant-payload
          :type type
          :effects effects
          :ordering ordering
          :source source
          :profile profile
          :facts facts
          :domain-anchor domain-anchor
          :verifier-status :pending
          :contract c11-mir-instruction-contract}))

(defn build-c11-mir-value
  [value-id kind type constant-payload defined-by uses source ownership effects safety]
  (quote {:artifact :gravity/mir-value
          :value-id value-id
          :kind kind
          :type type
          :constant-payload constant-payload
          :defined-by defined-by
          :uses uses
          :source source
          :ownership ownership
          :effects effects
          :safety safety
          :contract c11-mir-value-contract}))

(defn build-c11-mir-source-map
  [source-map-id mir-artifact core-node syntax-id source-span origin-chain generated-origin producer profile target-request provenance]
  (quote {:artifact :gravity/mir-source-map
          :source-map-id source-map-id
          :mir-artifact mir-artifact
          :core-node core-node
          :syntax-id syntax-id
          :source-span source-span
          :origin-chain origin-chain
          :generated-origin generated-origin
          :producer producer
          :profile profile
          :target-request target-request
          :provenance provenance
          :contract c11-mir-source-map-contract}))

(defn verify-c11-mir-module [mir-module]
  (assoc
   (quote
    {:status :stage1-source-owned
     :mir-module nil
     :checks [:module-identity-complete
              :checked-core-reference-present
              :profile-and-target-request-attached
              :every-function-has-entry-block
              :every-block-terminates
              :control-flow-edges-valid
              :definitions-dominate-uses
              :data-flow-edges-exposed
              :types-match-operation-schemas
              :effect-ordering-constraints-present
              :safety-sensitive-operations-have-outcomes
              :runtime-checks-dominate-guarded-operations
              :source-and-generated-origins-valid
              :ownership-resource-operations-match-c9-facts
              :domain-anchors-valid
              :target-specific-opcodes-rejected
              :diagnostics-follow-c15-shape]
     :diagnostics
     {:diagnostics ["C11-MODULE"
                    "C11-BLOCK"
                    "C11-DOMINANCE"
                    "C11-TYPE"
                    "C11-EFFECT"
                    "C11-SAFETY"
                    "C11-ORIGIN"
                    "C11-DOMAIN"
                    "C11-TARGET-LEAK"
                    "C11-VERIFY"]
      :stable-diagnostic-fields
      [:diagnostic-id :severity
       :stage :mir-module
       :function :block
       :operation-id :value-id
       :source-span
       :origin-chain
       :profile :target-request
       :missing-fact
       :provenance
       :remediation]
      :stops
      [:domain-ir-lowering
       :mir-optimization
       :target-lowering
       :artifact-emission
       :bootstrap-source-inventory]
      :must-not-depend-on
      [:localized-rendering-text
       :backend-legality
       :target-lowering-state
       :runtime-only-safety-state
       :opaque-domain-ir]}
     :preserves [:source-spans :syntax-identity
                 :checked-core-identity
                 :core-node-identity
                 :type-facts :effect-facts
                 :capability-facts :ownership-facts
                 :safe1-outcomes
                 :runtime-check-records
                 :proof-obligations
                 :profile-target-metadata
                 :source-origin-map
                 :generated-origin-chains
                 :control-flow-edges
                 :data-flow-edges
                 :dominance-facts
                 :domain-anchor-links
                 :target-independence
                 :artifact-provenance]})
   :mir-module mir-module))

; This is the first executable C11 construction slice.  The bootstrap seed
; authenticates the checked-core artifact before this function is invoked;
; this module owns all checked-core-to-MIR classification and graph assembly.
; The slice deliberately accepts at most one conditional.  That gives the
; current literal/quote/local/do/if/let/str/println core a genuine
; entry/then/else/join CFG without pretending that arbitrary nested control
; flow or the full C11 operation-family matrix is already implemented.

(defn c11-vector-contains?
  [values value]
  (if (= (count values) 0)
    false
    (if (= (first values) value)
      true
      (c11-vector-contains? (rest values) value))))

(defn c11-conj-unique
  [values value]
  (if (c11-vector-contains? values value)
    values
    (conj values value)))

(defn c11-path-prefix?
  [prefix path]
  (if (= (count prefix) 0)
    true
    (if (= (count path) 0)
      false
      (if (= (first prefix) (first path))
        (c11-path-prefix? (rest prefix) (rest path))
        false))))

(defn c11-nodes-under-prefix
  [nodes prefix result]
  (if (= (count nodes) 0)
    result
    (let [node (first nodes)]
      (c11-nodes-under-prefix
       (rest nodes)
       prefix
       (if (c11-path-prefix? prefix (get node :path))
         (conj result node)
         result)))))

(defn c11-nodes-outside-prefixes
  [nodes left-prefix right-prefix result]
  (if (= (count nodes) 0)
    result
    (let [node (first nodes)
          path (get node :path)]
      (c11-nodes-outside-prefixes
       (rest nodes)
       left-prefix
       right-prefix
       (if (c11-path-prefix? left-prefix path)
         result
         (if (c11-path-prefix? right-prefix path)
           result
           (conj result node)))))))

(defn c11-if-count
  [nodes count]
  (if (= (count nodes) 0)
    count
    (c11-if-count
     (rest nodes)
     (if (= (get (first nodes) :source-operation) :if)
       (+ count 1)
       count))))

(defn c11-find-if-node
  [nodes]
  (if (= (count nodes) 0)
    nil
    (if (= (get (first nodes) :source-operation) :if)
      (first nodes)
      (c11-find-if-node (rest nodes)))))

(defn c11-node-depends-on-any?
  [operands ids]
  (if (= (count operands) 0)
    false
    (if (c11-vector-contains? ids (first operands))
      true
      (c11-node-depends-on-any? (rest operands) ids))))

(defn c11-expand-downstream-once
  [nodes ids result]
  (if (= (count nodes) 0)
    result
    (let [node (first nodes)
          node-id (get node :node-id)]
      (c11-expand-downstream-once
       (rest nodes)
       ids
       (if (c11-node-depends-on-any? (get node :operands) ids)
         (c11-conj-unique result node-id)
         result)))))

(defn c11-downstream-closure
  [nodes ids]
  (let [expanded (c11-expand-downstream-once nodes ids ids)]
    (if (= (count expanded) (count ids))
      ids
      (c11-downstream-closure nodes expanded))))

(defn c11-filter-node-ids
  [nodes ids include? result]
  (if (= (count nodes) 0)
    result
    (let [node (first nodes)
          present? (c11-vector-contains? ids (get node :node-id))]
      (c11-filter-node-ids
       (rest nodes)
       ids
       include?
       (if (= present? include?)
         (conj result node)
         result)))))

(defn c11-nodes-before-id
  [nodes node-id result]
  (if (= (count nodes) 0)
    result
    (if (= (get (first nodes) :node-id) node-id)
      result
      (c11-nodes-before-id
       (rest nodes) node-id (conj result (first nodes))))))

(defn c11-nodes-from-id
  [nodes node-id]
  (if (= (count nodes) 0)
    []
    (if (= (get (first nodes) :node-id) node-id)
      nodes
      (c11-nodes-from-id (rest nodes) node-id))))

(defn c11-node-ids
  [nodes result]
  (if (= (count nodes) 0)
    result
    (c11-node-ids (rest nodes)
                  (conj result (get (first nodes) :node-id)))))

(defn c11-find-node-by-id
  [nodes node-id]
  (if (= (count nodes) 0)
    nil
    (if (= (get (first nodes) :node-id) node-id)
      (first nodes)
      (c11-find-node-by-id (rest nodes) node-id))))

(defn c11-last-value
  [values]
  (if (= (count values) 1)
    (first values)
    (c11-last-value (rest values))))

(defn c11-opcode
  [node]
  (let [operation (get node :source-operation)]
    (if (= operation :literal)
      :constant
      (if (= operation :implicit-nil)
        :constant
        (if (= operation :quote)
          :constant
          (if (= operation :local)
            :local
            (if (= operation :let-binding)
              :local-binding
              (if (= operation :truthy)
                :truthiness
                (if (= operation :integer-eq)
                  :integer-eq
                  (if (= operation :integer-lt)
                    :integer-lt
                    (if (= operation :integer-lte)
                      :integer-lte
                      (if (= operation :integer-gt)
                        :integer-gt
                        (if (= operation :integer-gte)
                          :integer-gte
                          (if (= operation :do)
                  :sequence
                  (if (= operation :if)
                    :conditional-join
                    (if (= operation :let)
                      :lexical-scope
                      (if (= operation :str)
                        :call
                        (if (= operation :println)
                          :call
                          (if (= operation :function)
                            :function-boundary
                            :unsupported-checked-core-operation)))))))))))))))))))

(defn c11-operation-result
  [node]
  ; Gravity `println` returns nil.  Model that nil as an explicit SSA value so
  ; a resultless effect at function tail never creates an undefined return.
  (get node :node-id))

(defn c11-constant-payload
  [node]
  ; Constants must remain self-contained in MIR.  A type and an origin cannot
  ; distinguish 1 from 2 or true from false, so the authenticated payload is
  ; carried explicitly for every :constant operation and is unambiguously
  ; absent everywhere else.
  (if (= (c11-opcode node) :constant)
    {:present? true :value (get (get node :attributes) :value)}
    :not-applicable))

(defn c11-operation-ordering
  [node]
  (if (= (count (get (get node :attributes) :intrinsic-effects)) 0)
    :none
    :sequence))

(defn c11-copy-vector
  [values result]
  (if (= (count values) 0)
    result
    (c11-copy-vector (rest values) (conj result (first values)))))

(defn c11-runtime-check-operation-id
  [check]
  (str (get check :check-id) ":mir:runtime-check"))

(defn c11-runtime-check-token-id
  [check]
  (str (get check :check-id) ":mir:token"))

(defn c11-runtime-check-guarded-operation-id
  [checked-core node]
  (if (= :if (get node :source-operation))
    (str (get checked-core :artifact-id) ":mir:entry:conditional")
    (get node :node-id)))

(defn c11-runtime-check-fact-id
  [check fact-kind]
  (let [check-id (get check :check-id)]
    (if (= fact-kind :type)
      (str check-id ":mir:type-fact")
      (if (= fact-kind :effect)
        (str check-id ":mir:effect-fact")
        (if (= fact-kind :capability)
          (str check-id ":mir:capability-fact")
          (if (= fact-kind :ownership)
            (str check-id ":mir:ownership-fact")
            (if (= fact-kind :safety)
              (str check-id ":mir:safety-outcome")
              (str check-id ":mir:profile-target-fact"))))))))

(defn c11-capability-fact-id
  [node-id]
  (str node-id ":capability-fact"))

(defn c11-safety-outcome-id
  [node-id]
  (str node-id ":safety-outcome"))

(defn c11-profile-target-fact-id
  [node-id]
  (str node-id ":profile-target-fact"))

(defn c11-operation-operands
  [node]
  (let [check (get (get node :safety) :check)]
    (if (= check nil)
      (get node :operands)
      (if (= :if (get node :source-operation))
        (get node :operands)
        (c11-copy-vector
         (get node :operands)
         [(c11-runtime-check-token-id check)])))))

(defn c11-operation-proof-certificate-ids
  [checked-core node]
  (let [node-id (get node :node-id)
        capability
        (get (get checked-core :capability-facts) node-id)
        capability-proof
        (get capability :capability-proof)
        capability-proof-ids (get capability-proof :proof-ids)
        safety-proof (get (get node :safety) :proof)
        safety-proof-id (get safety-proof :proof-id)
        result
        (if (= capability-proof-ids nil) [] capability-proof-ids)]
    (if (= safety-proof-id nil)
      result
      (conj result safety-proof-id))))

(defn c11-operation-facts
  [checked-core node]
  (let [node-id (get node :node-id)
        type-fact (get (get checked-core :type-facts) node-id)
        effect-fact (get (get checked-core :effect-facts) node-id)
        ownership-fact (get (get checked-core :ownership-facts) node-id)
        capability-fact (get (get checked-core :capability-facts) node-id)
        safety (get node :safety)
        runtime-check (get safety :check)
        capability-proof (get capability-fact :capability-proof)
        safety-proof (get safety :proof)]
    {:type-fact-id (get type-fact :fact-id)
     :effect-fact-id (get effect-fact :fact-id)
     :capability-fact-id (c11-capability-fact-id node-id)
     :capability-proof-ids
     (if (= (get capability-proof :proof-ids) nil)
       []
       (get capability-proof :proof-ids))
     :ownership-fact-id (get ownership-fact :fact-id)
     :safety-outcome-id (c11-safety-outcome-id node-id)
     :safety-proof-id
     (if (= (get safety-proof :proof-id) nil)
       :not-applicable
       (get safety-proof :proof-id))
     :profile-target-fact-id (c11-profile-target-fact-id node-id)
     :runtime-check-id
     (if (= runtime-check nil)
       :not-applicable
       (get runtime-check :check-id))
     :proof-certificate-ids
     (c11-operation-proof-certificate-ids checked-core node)
     :failure-behavior
     (if (= runtime-check nil)
       :not-applicable
       (get runtime-check :failure))
     :source-origin-id (get (get node :source) :origin-id)}))

(defn c11-build-runtime-check-table
  [checked-core nodes result]
  (if (= (count nodes) 0)
    result
    (let [node (first nodes)
          check (get (get node :safety) :check)]
      (c11-build-runtime-check-table
       checked-core (rest nodes)
       (if (= check nil)
         result
         (let [check-id (get check :check-id)]
           (assoc
            result check-id
            (assoc
             (assoc
              (assoc check :guarded-operation-id
                     (c11-runtime-check-guarded-operation-id
                      checked-core node))
              :check-operation-id (c11-runtime-check-operation-id check))
             :token-value-id (c11-runtime-check-token-id check)))))))))

(defn c11-build-fact-table-by-id
  [nodes source-table id-field generated-suffix result]
  (if (= (count nodes) 0)
    result
    (let [node (first nodes)
          node-id (get node :node-id)
          record (get source-table node-id)
          existing-id (get record id-field)
          fact-id
          (if (= existing-id nil)
            (str node-id generated-suffix)
            existing-id)]
      (c11-build-fact-table-by-id
       (rest nodes) source-table id-field generated-suffix
       (assoc result fact-id (assoc record id-field fact-id))))))

(defn c11-runtime-check-fact-record
  [checked-core node fact-kind]
  (let [node-id (get node :node-id)
        check (get (get node :safety) :check)
        fact-id (c11-runtime-check-fact-id check fact-kind)
        check-op-id (c11-runtime-check-operation-id check)
        token-id (c11-runtime-check-token-id check)
        origin-id (get (get node :source) :origin-id)
        profile (get node :profile)]
    (if (= fact-kind :type)
      {:fact-id fact-id
       :core-node-id node-id
       :mir-operation-id check-op-id
       :type-id :gravity/runtime-check-token
       :type :gravity/runtime-check-token
       :producer-rule :runtime-check-token
       :dependencies []
       :source-origin-id origin-id
       :profile profile
       :source-target (get checked-core :source-target)
       :constraints []
       :derived? true}
      (if (= fact-kind :effect)
        {:fact-id fact-id
         :core-node-id node-id
         :mir-operation-id check-op-id
         :direct (get check :effects-introduced)
         :latent #{}
         :transitive #{}
         :residual #{}
         :ordering :sequence
         :non-dce? true
         :source-origin-id origin-id
         :profile profile
         :source-target (get checked-core :source-target)
         :derived? true}
        (if (= fact-kind :capability)
          {:fact-id fact-id
           :core-node-id node-id
           :mir-operation-id check-op-id
           :required #{}
           :granted #{}
           :capability-proof-ids [(get check :capability-proof-id)]
           :authority-id (get check :authority-record-id)
           :source-origin-id origin-id
           :profile profile
           :source-target (get checked-core :source-target)
           :derived? true}
          (if (= fact-kind :ownership)
            {:fact-id fact-id
             :core-node-id node-id
             :mir-operation-id check-op-id
             :value-id token-id
             :role :runtime-check-token
             :storage :compiler-generated-token
             :model :non-resource-control-token
             :shareability :single-guard-use
             :mutation :forbidden
             :source-origin-id origin-id
             :profile profile
             :source-target (get checked-core :source-target)
             :derived? true}
            (if (= fact-kind :safety)
              {:outcome-id fact-id
               :artifact :gravity/safety-outcome
               :operation check-op-id
               :guarded-operation-id
               (c11-runtime-check-guarded-operation-id checked-core node)
               :kind :runtime-check
               :profile profile
               :target (get checked-core :source-target)
               :outcome :runtime-checked
               :runtime-check (get check :check-id)
               :proof :not-applicable
               :failure-behavior (get check :failure)
               :source-origin-id origin-id
               :derived? true}
              {:fact-id fact-id
               :core-node-id node-id
               :mir-operation-id check-op-id
               :profile-fact (get (get checked-core :profile-facts) node-id)
               :profile profile
               :source-target (get checked-core :source-target)
               :target-request
               (get (get checked-core :target-request-metadata)
                    :requested-target)
               :derived? true})))))))

(defn c11-add-runtime-check-facts
  [checked-core nodes fact-kind result]
  (if (= (count nodes) 0)
    result
    (let [node (first nodes)
          check (get (get node :safety) :check)]
      (c11-add-runtime-check-facts
       checked-core
       (rest nodes)
       fact-kind
       (if (= check nil)
         result
         (assoc
          result
          (c11-runtime-check-fact-id check fact-kind)
          (c11-runtime-check-fact-record
           checked-core node fact-kind)))))))

(defn c11-build-profile-target-table
  [checked-core nodes result]
  (if (= (count nodes) 0)
    result
    (let [node (first nodes)
          node-id (get node :node-id)
          fact-id (c11-profile-target-fact-id node-id)]
      (c11-build-profile-target-table
       checked-core
       (rest nodes)
       (assoc
        result fact-id
        {:fact-id fact-id
         :core-node-id node-id
         :profile-fact (get (get checked-core :profile-facts) node-id)
         :profile (get node :profile)
         :source-target (get checked-core :source-target)
         :target-request
         (get (get checked-core :target-request-metadata)
              :requested-target)})))))

(defn c11-build-capability-proof-table
  [proofs result]
  (if (= (count proofs) 0)
    result
    (let [proof (first proofs)]
      (c11-build-capability-proof-table
       (rest proofs)
       (assoc result (get proof :proof-id) proof)))))

(defn c11-build-safety-proof-table
  [nodes result]
  (if (= (count nodes) 0)
    result
    (let [node (first nodes)
          proof (get (get node :safety) :proof)
          proof-id (get proof :proof-id)]
      (c11-build-safety-proof-table
       (rest nodes)
       (if (= proof-id nil)
         result
         (assoc result proof-id proof))))))

(defn c11-runtime-check-source
  [node check]
  (let [source (get node :source)]
    {:origin-id (get source :origin-id)
     :span (get source :span)
     :enclosing-syntax-origin-id
     (get source :enclosing-syntax-origin-id)
     :generated? true
     :generated-origin
     [{:role :runtime-check-generated
       :producer-operation-id (get node :node-id)
       :runtime-check-id (get check :check-id)}]}))

(defn c11-build-runtime-check-operation
  [checked-core node block-id]
  (let [node-id (get node :node-id)
        check (get (get node :safety) :check)
        check-id (get check :check-id)]
    {:artifact :gravity/mir-operation
     :op-id (c11-runtime-check-operation-id check)
     :opcode :runtime-check
     :source-operation :runtime-check
     :operands (get (get check :predicate) :operand-ids)
     :result (c11-runtime-check-token-id check)
     :result-kind :runtime-check-token
     :constant-payload :not-applicable
     :type :gravity/runtime-check-token
     :effects (get check :effects-introduced)
     :capabilities #{}
     :ordering :sequence
     :source (c11-runtime-check-source node check)
     :profile (get node :profile)
     :facts
     {:type-fact-id (c11-runtime-check-fact-id check :type)
      :effect-fact-id (c11-runtime-check-fact-id check :effect)
      :capability-fact-id
      (c11-runtime-check-fact-id check :capability)
      :capability-proof-ids [(get check :capability-proof-id)]
      :ownership-fact-id
      (c11-runtime-check-fact-id check :ownership)
      :safety-outcome-id (c11-runtime-check-fact-id check :safety)
      :safety-proof-id :not-applicable
      :profile-target-fact-id
      (c11-runtime-check-fact-id check :profile-target)
      :runtime-check-id check-id
      :proof-certificate-ids [(get check :capability-proof-id)]
      :guarded-operation-id
      (c11-runtime-check-guarded-operation-id checked-core node)
      :failure-behavior (get check :failure)
      :source-origin-id (get (get node :source) :origin-id)}
     :domain-anchor nil
     :block-id block-id
     :verifier-status :pending}))

(defn c11-build-operation
  [checked-core node block-id]
  (let [attributes (get node :attributes)]
    {:artifact :gravity/mir-operation
     :op-id (get node :node-id)
     :opcode (c11-opcode node)
     :source-operation (get node :source-operation)
     :operands (c11-operation-operands node)
     :result (c11-operation-result node)
     :result-kind (if (= (get node :type) :gravity/nil) :unit :value)
     :constant-payload (c11-constant-payload node)
     :type (get node :type)
     ; Containers carry aggregate child summaries in checked core.  MIR direct
     ; effects/capabilities come only from the intrinsic operation; the full
     ; aggregate records remain linked through :facts.
     :effects (get attributes :intrinsic-effects)
     :capabilities (get attributes :intrinsic-capabilities)
     :ordering (c11-operation-ordering node)
     :source (get node :source)
     :profile (get node :profile)
     :facts (c11-operation-facts checked-core node)
     :domain-anchor nil
     :block-id block-id
     :verifier-status :pending}))

(defn c11-c6-parameter-node? [checked-core node]
  ; The SH-12 original-family preflight owns the complete binder premise.
  ; This is a value definition, never a new MIR instruction or authority flag.
  (if (sh12-c6p-family? checked-core)
    (if (= (get node :source-operation) :parameter)
      (if (= (get node :node-id) (get (first (get checked-core :core-nodes)) :node-id))
        (= (get (get node :attributes) :parameter-index) 0) false) false) false))

(defn c11-function-parameter-ids [checked-core]
  (let [node (first (get checked-core :core-nodes))]
    (if (c11-c6-parameter-node? checked-core node) [(get node :node-id)] [])))

(defn c11-build-operations
  [checked-core nodes block-id result]
  (if (= (count nodes) 0)
    result
    (let [node (first nodes)
          check (get (get node :safety) :check)
          with-check
          (if (c11-c6-parameter-node? checked-core node) result
          (if (= check nil)
            result
            (conj result
                  (c11-build-runtime-check-operation
                   checked-core node block-id))))]
      (c11-build-operations
       checked-core
       (rest nodes)
       block-id
       (if (c11-c6-parameter-node? checked-core node) result
         (conj with-check (c11-build-operation checked-core node block-id)))))))

(defn c11-build-operations-skipping-check-for-node
  [checked-core nodes block-id skipped-node-id result]
  (if (= (count nodes) 0)
    result
    (let [node (first nodes)
          check (get (get node :safety) :check)
          with-check
          (if (c11-c6-parameter-node? checked-core node) result
          (if (= check nil)
            result
            (if (= skipped-node-id (get node :node-id))
              result
              (conj result
                    (c11-build-runtime-check-operation
                     checked-core node block-id)))))]
      (c11-build-operations-skipping-check-for-node
       checked-core
       (rest nodes)
       block-id
       skipped-node-id
       (if (c11-c6-parameter-node? checked-core node) result
         (conj with-check (c11-build-operation checked-core node block-id)))))))

(defn c11-build-data-flow-for-operands
  [operands consumer consumer-block operand-index result]
  (if (= (count operands) 0)
    result
    (c11-build-data-flow-for-operands
     (rest operands)
     consumer
     consumer-block
     (+ operand-index 1)
     (conj result
           {:from (first operands)
            :consumer-kind :operation
            :consumer-id consumer
            :consumer-block consumer-block
            :operand-index operand-index
            :edge-kind :operand}))))

(defn c11-build-data-flow-for-node
  [node consumer-block check-block result]
  (let [check (get (get node :safety) :check)
        node-id (get node :node-id)]
    (if (= check nil)
      (c11-build-data-flow-for-operands
       (get node :operands) node-id consumer-block 0 result)
      (let [check-operation-id (c11-runtime-check-operation-id check)
            check-edges
            (c11-build-data-flow-for-operands
             (get (get check :predicate) :operand-ids)
             check-operation-id check-block 0 result)]
        (if (= :if (get node :source-operation))
          (c11-build-data-flow-for-operands
           (get node :operands) node-id consumer-block 0 check-edges)
          (c11-build-data-flow-for-operands
           (get node :operands)
           node-id
           consumer-block
           1
           (conj
            check-edges
            {:from (c11-runtime-check-token-id check)
             :consumer-kind :operation
             :consumer-id node-id
             :consumer-block consumer-block
             :operand-index 0
             :edge-kind :runtime-check-guard})))))))

(defn c11-node-block-id
  [node if-id then-ids else-ids downstream-ids
   entry-id then-id else-id join-id]
  (let [node-id (get node :node-id)]
    (if (c11-vector-contains? then-ids node-id)
      then-id
      (if (c11-vector-contains? else-ids node-id)
        else-id
        (if (= node-id if-id)
          join-id
          (if (c11-vector-contains? downstream-ids node-id)
            join-id
            entry-id))))))

(defn c11-build-data-flow
  [nodes if-id then-ids else-ids downstream-ids
   entry-id then-id else-id join-id result]
  (if (= (count nodes) 0)
    result
    (let [node (first nodes)
          node-id (get node :node-id)
          block-id
          (c11-node-block-id
           node if-id then-ids else-ids downstream-ids
           entry-id then-id else-id join-id)]
      (c11-build-data-flow
       (rest nodes) if-id then-ids else-ids downstream-ids
       entry-id then-id else-id join-id
       (c11-build-data-flow-for-node
        node block-id
        (if (= node-id if-id) entry-id block-id)
        result)))))

(defn c11-build-definitions
  [checked-core nodes if-id then-ids else-ids downstream-ids
   entry-id then-id else-id join-id result]
  (if (= (count nodes) 0)
    result
    (let [node (first nodes)
          node-id (get node :node-id)
          block-id
          (c11-node-block-id
           node if-id then-ids else-ids downstream-ids
           entry-id then-id else-id join-id)]
      (let [check (get (get node :safety) :check)
            check-block-id (if (= node-id if-id) entry-id block-id)
            with-check
            (if (= check nil)
              result
              (assoc
               result
               (c11-runtime-check-token-id check)
               {:value-id (c11-runtime-check-token-id check)
                :operation-id (c11-runtime-check-operation-id check)
                :block-id check-block-id}))]
       (c11-build-definitions
       checked-core (rest nodes) if-id then-ids else-ids downstream-ids
       entry-id then-id else-id join-id
       (if (c11-c6-parameter-node? checked-core node)
         (assoc with-check node-id {:value-id node-id :parameter-index 0 :block-id entry-id})
       (if (= (c11-operation-result node) nil)
         with-check
         (assoc with-check node-id
                {:value-id node-id
                 :operation-id node-id
                 :block-id block-id}))))))))

(defn c11-uses-for-value
  [edges value-id result]
  (if (= (count edges) 0)
    result
    (let [edge (first edges)]
      (c11-uses-for-value
       (rest edges)
       value-id
       (if (= (get edge :from) value-id)
         (conj result
               {:use-kind :instruction
                :consumer-kind (get edge :consumer-kind)
                :consumer-id (get edge :consumer-id)
                :consumer-block (get edge :consumer-block)
                :operand-index (get edge :operand-index)
                :edge-kind (get edge :edge-kind)})
         result)))))

(defn c11-terminator-uses-for-value
  [uses value-id result]
  (if (= (count uses) 0)
    result
    (let [use (first uses)]
      (c11-terminator-uses-for-value
       (rest uses)
       value-id
       (if (= (get use :value-id) value-id)
         (conj result
               {:use-kind :terminator
                :consumer-kind (get use :consumer-kind)
                :consumer-id (get use :consumer-id)
                :consumer-block (get use :consumer-block)
                :operand-index (get use :operand-index)
                :edge-kind (get use :edge-kind)})
         result)))))

(defn c11-append-uses
  [left right]
  (if (= (count right) 0)
    left
    (c11-append-uses (conj left (first right)) (rest right))))

(defn c11-build-values
  [checked-core nodes data-flow definitions terminator-uses result]
  (if (= (count nodes) 0)
    result
    (let [node (first nodes)
          value-id (get node :node-id)]
      (let [check (get (get node :safety) :check)
            token-id
            (if (= check nil) nil (c11-runtime-check-token-id check))
            with-check
            (if (= check nil)
              result
              (assoc
               result token-id
              {:artifact :gravity/mir-value
                :value-id token-id
                :kind :runtime-check-token
                :type :gravity/runtime-check-token
                :constant-payload :not-applicable
                :defined-by (get definitions token-id)
                :uses
                (c11-append-uses
                 (c11-uses-for-value data-flow token-id [])
                 (c11-terminator-uses-for-value
                  terminator-uses token-id []))
                :source (c11-runtime-check-source node check)
                :ownership :not-applicable
                :effects (get check :effects-introduced)
                 :safety
                 {:outcome :runtime-check-token
                  :runtime-check-id (get check :check-id)
                  :guarded-operation-id
                  (c11-runtime-check-guarded-operation-id
                   checked-core node)}}))]
       (c11-build-values
       checked-core
       (rest nodes)
       data-flow
       definitions
       terminator-uses
       (if (= (c11-operation-result node) nil)
         with-check
         (assoc with-check value-id
                {:artifact :gravity/mir-value
                 :value-id value-id
                 :kind (if (c11-c6-parameter-node? checked-core node) :parameter :instruction-result)
                 :type (get node :type)
                 :constant-payload (c11-constant-payload node)
                 :defined-by (get definitions value-id)
                 :uses
                 (c11-append-uses
                  (c11-uses-for-value data-flow value-id [])
                  (c11-terminator-uses-for-value
                   terminator-uses value-id []))
                 :source (get node :source)
                 :ownership (get node :ownership)
                 :effects (get node :effects)
                 :safety (get node :safety)})))))))

(defn c11-build-source-map
  [nodes result]
  (if (= (count nodes) 0)
    result
    (let [node (first nodes)]
      (let [check (get (get node :safety) :check)
            with-check
            (if (= check nil)
              result
              (assoc
               result
               (c11-runtime-check-operation-id check)
               (c11-runtime-check-source node check)))]
        (c11-build-source-map
         (rest nodes)
         (assoc with-check (get node :node-id) (get node :source)))))))

(defn c11-build-terminator
  [terminator-id kind operands successors effects source profile facts]
  {:artifact :gravity/mir-terminator
   :terminator-id terminator-id
   :kind kind
   :operands operands
   :successors successors
   :effects effects
   :ordering (if (= (count effects) 0) :none :sequence)
   :source source
   :profile profile
   :facts facts
   :verifier-status :pending})

(defn c11-build-block
  [block-id arguments instructions terminator predecessors successors
   dominators source]
  {:artifact :gravity/mir-block
   :block-id block-id
   :arguments arguments
   :instructions instructions
   :terminator terminator
   :predecessors predecessors
   :successors successors
   :dominators dominators
   :data-flow {:module-data-flow-graph-reference true}
   :source source})

(defn c11-build-linear-mir
  [checked-core nodes return-value-id]
  (let [artifact-id (get checked-core :artifact-id)
        entry-id (str artifact-id ":mir:entry")
        operations (c11-build-operations checked-core nodes entry-id [])
        data-flow
        (c11-build-data-flow
         nodes nil [] [] [] entry-id entry-id entry-id entry-id [])
        definitions
        (c11-build-definitions
         checked-core nodes nil [] [] [] entry-id entry-id entry-id entry-id {})
        terminator-id (str entry-id ":return")
        terminator-uses
        [{:value-id return-value-id
          :consumer-kind :terminator
          :consumer-id terminator-id
          :consumer-block entry-id
          :operand-index 0
          :edge-kind :return-value}]
        source (get (first nodes) :source)
        terminator
        (c11-build-terminator
         terminator-id :return [return-value-id] [] #{}
         source (get checked-core :profile)
         {:returned-value return-value-id})
        block
        (c11-build-block entry-id [] operations terminator [] [] [entry-id]
                         source)]
    {:entry entry-id
     :blocks {entry-id block}
     :edges []
     :dominance {entry-id [entry-id]}
     :data-flow data-flow
     :definitions definitions
     :terminator-uses terminator-uses
     :values
     (c11-build-values
      checked-core nodes data-flow definitions terminator-uses {})
     :source-map (c11-build-source-map nodes {})
     :conditional-count 0}))

(defn c11-build-conditional-mir
  [checked-core nodes if-node return-value-id]
  (let [artifact-id (get checked-core :artifact-id)
        if-id (get if-node :node-id)
        if-path (get if-node :path)
        then-prefix (conj if-path :then)
        else-prefix (conj if-path :else)
        then-nodes (c11-nodes-under-prefix nodes then-prefix [])
        else-nodes (c11-nodes-under-prefix nodes else-prefix [])
        outside-nodes
        (c11-nodes-outside-prefixes nodes then-prefix else-prefix [])
        ; Checked core is already in authenticated canonical execution order.
        ; Branch-prefix nodes remain branch-local; outside nodes before the if
        ; execute in entry, while the if and every outside continuation node
        ; after it remain in join.  Dependency reachability alone cannot hoist
        ; an effectful continuation before its controlling conditional.
        entry-nodes (c11-nodes-before-id outside-nodes if-id [])
        downstream-nodes (c11-nodes-from-id outside-nodes if-id)
        downstream-ids (c11-node-ids downstream-nodes [])
        entry-id (str artifact-id ":mir:entry")
        then-id (str artifact-id ":mir:then")
        else-id (str artifact-id ":mir:else")
        join-id (str artifact-id ":mir:join")
        if-operands (get if-node :operands)
        condition-id (first if-operands)
        then-result-id (second if-operands)
        else-result-id (first (rest (rest if-operands)))
        runtime-check (get (get if-node :safety) :check)
        runtime-check-token-id
        (if (= runtime-check nil)
          nil
          (c11-runtime-check-token-id runtime-check))
        entry-terminator-id (str entry-id ":conditional")
        entry-operations-before-check
        (c11-build-operations checked-core entry-nodes entry-id [])
        entry-operations
        (if (= runtime-check nil)
          entry-operations-before-check
          (conj
           entry-operations-before-check
           (c11-build-runtime-check-operation
            checked-core if-node entry-id)))
        then-operations
        (c11-build-operations checked-core then-nodes then-id [])
        else-operations
        (c11-build-operations checked-core else-nodes else-id [])
        join-operations
        (c11-build-operations-skipping-check-for-node
         checked-core downstream-nodes join-id if-id [])
        source (get if-node :source)
        entry-terminator-operands
        (if (= runtime-check nil)
          [condition-id]
          [runtime-check-token-id condition-id])
        entry-terminator-facts
        (if (= runtime-check nil)
          {:condition condition-id :join join-id}
          {:condition condition-id
           :join join-id
           :runtime-check-id (get runtime-check :check-id)
           :runtime-check-token-id runtime-check-token-id
           :safety-outcome-id
           (c11-runtime-check-fact-id runtime-check :safety)
           :failure-behavior (get runtime-check :failure)})
        entry-terminator
        (c11-build-terminator
         entry-terminator-id :conditional-branch entry-terminator-operands
         ; Branch selection itself is pure.  The checked-core `if` carries an
         ; aggregate child-effect summary, which remains available through the
         ; linked fact tables instead of being duplicated as a terminator
         ; effect/order obligation.
         [then-id else-id] #{} source
         (get checked-core :profile)
         entry-terminator-facts)
        then-terminator
        (c11-build-terminator
         (str then-id ":branch") :branch [then-result-id] [join-id] #{}
         source (get checked-core :profile)
         {:incoming-value then-result-id})
        else-terminator
        (c11-build-terminator
         (str else-id ":branch") :branch [else-result-id] [join-id] #{}
         source (get checked-core :profile)
         {:incoming-value else-result-id})
        join-terminator
        (c11-build-terminator
         (str join-id ":return") :return [return-value-id] [] #{}
         source (get checked-core :profile)
         {:returned-value return-value-id})
        entry-terminator-uses
        (if (= runtime-check nil)
          [{:value-id condition-id
            :consumer-kind :terminator
            :consumer-id entry-terminator-id
            :consumer-block entry-id
            :operand-index 0
            :edge-kind :condition}]
          [{:value-id runtime-check-token-id
            :consumer-kind :terminator
            :consumer-id entry-terminator-id
            :consumer-block entry-id
            :operand-index 0
            :edge-kind :runtime-check-guard}
           {:value-id condition-id
            :consumer-kind :terminator
            :consumer-id entry-terminator-id
            :consumer-block entry-id
            :operand-index 1
            :edge-kind :condition}])
        terminator-uses
        (c11-append-uses
         entry-terminator-uses
         [{:value-id then-result-id
           :consumer-kind :terminator
           :consumer-id (str then-id ":branch")
           :consumer-block then-id
           :operand-index 0
           :edge-kind :branch-value}
          {:value-id else-result-id
           :consumer-kind :terminator
           :consumer-id (str else-id ":branch")
           :consumer-block else-id
           :operand-index 0
           :edge-kind :branch-value}
          {:value-id return-value-id
           :consumer-kind :terminator
           :consumer-id (str join-id ":return")
           :consumer-block join-id
           :operand-index 0
           :edge-kind :return-value}])
        blocks
        {entry-id
         (c11-build-block entry-id [] entry-operations entry-terminator []
                          [then-id else-id] [entry-id] source)
         then-id
         (c11-build-block then-id [] then-operations then-terminator [entry-id]
                          [join-id] [entry-id then-id] source)
         else-id
         (c11-build-block else-id [] else-operations else-terminator [entry-id]
                          [join-id] [entry-id else-id] source)
        join-id
        (c11-build-block
          ; The explicit :conditional-join operation is the sole SSA
          ; definition for `if-id`.  Incoming predecessor/value pairing stays
          ; in CFG :join metadata, avoiding a second block-argument/phi
          ; definition of the same value.
          join-id []
          join-operations join-terminator [then-id else-id] []
          [entry-id join-id] source)}
        then-ids
        (c11-node-ids then-nodes [])
        else-ids
        (c11-node-ids else-nodes [])
        data-flow
        (c11-build-data-flow
         nodes if-id then-ids else-ids downstream-ids
         entry-id then-id else-id join-id [])
        definitions
        (c11-build-definitions
         checked-core nodes if-id then-ids else-ids downstream-ids
         entry-id then-id else-id join-id {})]
    {:entry entry-id
     :blocks blocks
     :edges [{:from entry-id :to then-id :kind :true}
             {:from entry-id :to else-id :kind :false}
             {:from then-id :to join-id :kind :join}
             {:from else-id :to join-id :kind :join}]
     :dominance {entry-id [entry-id]
                 then-id [entry-id then-id]
                 else-id [entry-id else-id]
                 join-id [entry-id join-id]}
     :data-flow data-flow
     :definitions definitions
     :terminator-uses terminator-uses
     :values
     (c11-build-values
      checked-core nodes data-flow definitions terminator-uses {})
     :source-map (c11-build-source-map nodes {})
     :conditional-count 1
     :join {:block-id join-id
            :value-id if-id
            :incoming
            [{:predecessor then-id :value then-result-id}
             {:predecessor else-id :value else-result-id}]}}))

(defn c11-nested-block-layout [core]
  (let [base (get core :artifact-id) side (sh12-c6p-nested-side core)
        e (str base ":mir:entry") t (str base ":mir:then") f (str base ":mir:else")
        j (str base ":mir:join") n (if (= side :then) t f) o (if (= side :then) f t)
        a (str n ":then") b (str n ":else") k (str n ":join")]
    {:entry e :nested n :other o :inner-then a :inner-else b :inner-join k :join j
     :order (if (= side :then) [e n a b k o j] [e o n a b k j])
     :node-blocks (if (sh12-c6p-nested-let? core)
                    (if (= side :then) [e e e e e n n a b k o j j j] [e e e e e o n n a b k j j j])
                    (if (= side :then) [e e e n n a b k o j j] [e e e o n n a b k j j]))}))

(defn c11-nested-terminator-use [value block suffix kind]
  {:value-id value :consumer-kind :terminator :consumer-id (str block suffix)
   :consumer-block block :operand-index 0 :edge-kind kind})

(defn c11-nested-conditional-terminator [block condition successors join source profile]
  (c11-build-terminator (str block ":conditional") :conditional-branch [condition] successors #{}
    source profile {:condition condition :join join}))

(defn c11-nested-branch-terminator [block value target source profile]
  (c11-build-terminator (str block ":branch") :branch [value] [target] #{}
    source profile {:incoming-value value}))

(defn c11-build-nested-conditional-mir [core nodes return-value-id]
  ; Independently validated original C6 rows, with at most one enclosing
  ; nonshadowing Bool alias. This does not generalize arbitrary CFG nesting.
  (let [layout (c11-nested-block-layout core) side (sh12-c6p-nested-side core)
        e (get layout :entry) n (get layout :nested) o (get layout :other)
        a (get layout :inner-then) b (get layout :inner-else) k (get layout :inner-join) j (get layout :join)
        inner-index (sh12-c6p-inner-index core) c (- inner-index 4)
        inner (get nodes inner-index) outer (get nodes (sh12-c6p-index core 5))
        inner-id (get inner :node-id) outer-id (get outer :node-id)
        other-index (sh12-c6p-index core (if (= side :then) 4 3)) other (get nodes other-index)
        inner-then (get nodes (+ c 2)) inner-else (get nodes (+ c 3))
        inner-source (get inner :source) outer-source (get outer :source) profile (get core :profile)
        outer-then (if (= side :then) n o) outer-else (if (= side :then) o n)
        outer-then-pred (if (= side :then) k o) outer-else-pred (if (= side :then) o k)
        outer-then-value (second (get outer :operands)) outer-else-value (get (get outer :operands) 2)
        blocks
        {e (c11-build-block e [] (c11-build-operations core (subvec nodes 0 (+ 1 (sh12-c6p-index core 2))) e [])
             (c11-nested-conditional-terminator e (get (get nodes (sh12-c6p-index core 2)) :node-id) [outer-then outer-else] j outer-source profile)
             [] [outer-then outer-else] [e] outer-source)
         n (c11-build-block n [] (c11-build-operations core [(get nodes c) (get nodes (+ c 1))] n [])
             (c11-nested-conditional-terminator n (get (get nodes (+ c 1)) :node-id) [a b] k inner-source profile)
             [e] [a b] [e n] inner-source)
         a (c11-build-block a [] (c11-build-operations core [inner-then] a [])
             (c11-nested-branch-terminator a (get inner-then :node-id) k inner-source profile) [n] [k] [e n a] inner-source)
         b (c11-build-block b [] (c11-build-operations core [inner-else] b [])
             (c11-nested-branch-terminator b (get inner-else :node-id) k inner-source profile) [n] [k] [e n b] inner-source)
         k (c11-build-block k [] (c11-build-operations core [inner] k [])
             (c11-nested-branch-terminator k inner-id j outer-source profile) [a b] [j] [e n k] inner-source)
         o (c11-build-block o [] (c11-build-operations core [other] o [])
             (c11-nested-branch-terminator o (get other :node-id) j outer-source profile) [e] [j] [e o] outer-source)
         j (c11-build-block j [] (c11-build-operations core (subvec nodes (sh12-c6p-index core 5) (count nodes)) j [])
             (c11-build-terminator (str j ":return") :return [return-value-id] [] #{}
               outer-source profile {:returned-value return-value-id})
             [outer-then-pred outer-else-pred] [] [e j] outer-source)}
        data (loop [index 0 result []]
               (if (= index (count nodes)) result
                 (let [block (get (get layout :node-blocks) index)]
                   (recur (+ index 1) (c11-build-data-flow-for-node (get nodes index) block block result)))))
        definitions (loop [index 0 result {}]
                      (if (= index (count nodes)) result
                        (let [id (get (get nodes index) :node-id) block (get (get layout :node-blocks) index)]
                          (recur (+ index 1) (assoc result id
                            (if (= index 0) {:value-id id :parameter-index 0 :block-id e}
                              {:value-id id :operation-id id :block-id block}))))))
        uses [(c11-nested-terminator-use (get (get nodes (sh12-c6p-index core 2)) :node-id) e ":conditional" :condition)
              (c11-nested-terminator-use (get (get nodes (+ c 1)) :node-id) n ":conditional" :condition)
              (c11-nested-terminator-use (get inner-then :node-id) a ":branch" :branch-value)
              (c11-nested-terminator-use (get inner-else :node-id) b ":branch" :branch-value)
              (c11-nested-terminator-use inner-id k ":branch" :branch-value)
              (c11-nested-terminator-use (get other :node-id) o ":branch" :branch-value)
              (c11-nested-terminator-use return-value-id j ":return" :return-value)]]
    {:entry e :blocks blocks
     :edges [{:from e :to outer-then :kind :true} {:from e :to outer-else :kind :false}
             {:from n :to a :kind :true} {:from n :to b :kind :false}
             {:from a :to k :kind :join} {:from b :to k :kind :join}
             {:from outer-then-pred :to j :kind :join} {:from outer-else-pred :to j :kind :join}]
     :dominance {e [e] n [e n] a [e n a] b [e n b] k [e n k] o [e o] j [e j]}
     :data-flow data :definitions definitions :terminator-uses uses
     :values (c11-build-values core nodes data definitions uses {})
     :source-map (c11-build-source-map nodes {}) :conditional-count 2
     :join {:block-id j :value-id outer-id
            :incoming [{:predecessor outer-then-pred :value outer-then-value}
                       {:predecessor outer-else-pred :value outer-else-value}]}}))

(defn c11-nested-pass-contract []
  (let [contract (c11-build-mir-pass-contract)]
    (assoc contract :scope (assoc (get contract :scope) :maximum-conditionals 2))))

(defn c11-predicate-block-layout [core]
  (let [base (get core :artifact-id) e (str base ":mir:entry")
        a (str base ":mir:test:then") b (str base ":mir:test:else") k (str base ":mir:test:join")
        t (str base ":mir:then") f (str base ":mir:else") j (str base ":mir:join")]
    {:entry e :inner-then a :inner-else b :inner-join k :then t :else f :join j
     :order [e a b k t f j]
     :node-blocks (if (contains? #{:then :else} (sh12-c6p-predicate-local-side core))
                   [e e e e e a b k k t f j j j]
                   (if (sh12-c6p-conditional-initializer? core) [e e e a b k k k k t f j j j]
                     [e e e a b k k t f j j]))}))

(defn c11-build-predicate-conditional-mir [core nodes return-value-id]
  ; The inner Bool SSA result is consumed in K before choosing the outer
  ; Integer branch. No inner value or outer condition is evaluated twice.
  (let [layout (c11-predicate-block-layout core) e (get layout :entry)
        a (get layout :inner-then) b (get layout :inner-else) k (get layout :inner-join)
        t (get layout :then) f (get layout :else) j (get layout :join)
        inner-index (sh12-c6p-inner-index core) condition-index (- inner-index 4)
        inner (get nodes inner-index) outer (get nodes (sh12-c6p-index core 5)) outer-id (get outer :node-id)
        inner-source (get inner :source) outer-source (get outer :source) profile (get core :profile)
        av (get (get nodes (- inner-index 2)) :node-id) bv (get (get nodes (- inner-index 1)) :node-id)
        tv (get (get nodes (sh12-c6p-index core 3)) :node-id)
        fv (get (get nodes (sh12-c6p-index core 4)) :node-id)
        blocks
        {e (c11-build-block e [] (c11-build-operations core (subvec nodes 0 (+ 2 condition-index)) e [])
             (c11-nested-conditional-terminator e (get (get nodes (+ 1 condition-index)) :node-id) [a b] k inner-source profile)
             [] [a b] [e] inner-source)
         a (c11-build-block a [] (c11-build-operations core [(get nodes (- inner-index 2))] a [])
             (c11-nested-branch-terminator a av k inner-source profile) [e] [k] [e a] inner-source)
         b (c11-build-block b [] (c11-build-operations core [(get nodes (- inner-index 1))] b [])
             (c11-nested-branch-terminator b bv k inner-source profile) [e] [k] [e b] inner-source)
         k (c11-build-block k [] (c11-build-operations core (subvec nodes inner-index (+ 1 (sh12-c6p-index core 2))) k [])
             (c11-nested-conditional-terminator k (get (get nodes (sh12-c6p-index core 2)) :node-id) [t f] j outer-source profile)
             [a b] [t f] [e k] outer-source)
         t (c11-build-block t [] (c11-build-operations core [(get nodes (sh12-c6p-index core 3))] t [])
             (c11-nested-branch-terminator t tv j outer-source profile) [k] [j] [e k t] outer-source)
         f (c11-build-block f [] (c11-build-operations core [(get nodes (sh12-c6p-index core 4))] f [])
             (c11-nested-branch-terminator f fv j outer-source profile) [k] [j] [e k f] outer-source)
         j (c11-build-block j [] (c11-build-operations core (subvec nodes (sh12-c6p-index core 5) (count nodes)) j [])
             (c11-build-terminator (str j ":return") :return [return-value-id] [] #{}
               outer-source profile {:returned-value return-value-id}) [t f] [] [e k j] outer-source)}
        data (loop [index 0 result []]
               (if (= index (count nodes)) result
                 (let [block (get (get layout :node-blocks) index)]
                   (recur (+ index 1) (c11-build-data-flow-for-node (get nodes index) block block result)))))
        definitions (loop [index 0 result {}]
                      (if (= index (count nodes)) result
                        (let [id (get (get nodes index) :node-id) block (get (get layout :node-blocks) index)]
                          (recur (+ index 1) (assoc result id
                            (if (= index 0) {:value-id id :parameter-index 0 :block-id e}
                              {:value-id id :operation-id id :block-id block}))))))
        uses [(c11-nested-terminator-use (get (get nodes (+ 1 condition-index)) :node-id) e ":conditional" :condition)
              (c11-nested-terminator-use av a ":branch" :branch-value)
              (c11-nested-terminator-use bv b ":branch" :branch-value)
              (c11-nested-terminator-use (get (get nodes (sh12-c6p-index core 2)) :node-id) k ":conditional" :condition)
              (c11-nested-terminator-use tv t ":branch" :branch-value)
              (c11-nested-terminator-use fv f ":branch" :branch-value)
              (c11-nested-terminator-use return-value-id j ":return" :return-value)]]
    {:entry e :blocks blocks :conditional-count 2
     :edges [{:from e :to a :kind :true} {:from e :to b :kind :false}
             {:from a :to k :kind :join} {:from b :to k :kind :join}
             {:from k :to t :kind :true} {:from k :to f :kind :false}
             {:from t :to j :kind :join} {:from f :to j :kind :join}]
     :dominance {e [e] a [e a] b [e b] k [e k] t [e k t] f [e k f] j [e k j]}
     :data-flow data :definitions definitions :terminator-uses uses
     :values (c11-build-values core nodes data definitions uses {})
     :source-map (c11-build-source-map nodes {})
     :join {:block-id j :value-id outer-id
            :incoming [{:predecessor t :value tv} {:predecessor f :value fv}]}}))

(defn c11-add-values-to-set [values result]
  (if (= (count values) 0)
    result
    (c11-add-values-to-set
     (rest values) (conj result (first values)))))

(defn c11-function-latent-effects [nodes declared-effects]
  (if (= (count nodes) 0)
    declared-effects
    (let [check (get (get (first nodes) :safety) :check)]
      (c11-function-latent-effects
       (rest nodes)
       (if (= check nil)
         declared-effects
         (c11-add-values-to-set
          (get check :effects-introduced) declared-effects))))))

(defn c11-build-target-independent-mir
  [checked-core]
  (let [nodes (get checked-core :core-nodes)
        root-node-id (first (get checked-core :root-node-ids))
        root-node (c11-find-node-by-id nodes root-node-id)
        return-value-id (c11-last-value (get root-node :operands))
        return-node (c11-find-node-by-id nodes return-value-id)
        conditional-count (c11-if-count nodes 0)
        graph
        (if (= conditional-count 0)
          (c11-build-linear-mir checked-core nodes return-value-id)
          (if (= conditional-count 1)
            (c11-build-conditional-mir
             checked-core nodes (c11-find-if-node nodes) return-value-id)
            (if (if (= conditional-count 2)
                  (if (sh12-c6p-family? checked-core) (sh12-c6p-nested? checked-core) false) false)
             (if (sh12-c6p-predicate? checked-core)
               (c11-build-predicate-conditional-mir checked-core nodes return-value-id)
               (c11-build-nested-conditional-mir checked-core nodes return-value-id))
             {:status :rejected
             :diagnostic "C11-BLOCK"
             :missing-fact :bounded-single-conditional-cfg
             :conditional-count conditional-count}))) ]
    (if (= (get graph :status) :rejected)
      graph
      {:artifact :gravity/mir-module
       :schema-version 1
       :source-core (get checked-core :artifact-id)
       :module-id (get (get checked-core :source-core-input) :module)
       :profile (get checked-core :profile)
       :source-target (get checked-core :source-target)
       :target-request
       (get (get checked-core :target-request-metadata) :requested-target)
       :target-request-metadata (get checked-core :target-request-metadata)
       :functions
       {(get checked-core :entrypoint)
        {:artifact :gravity/mir-function
         :fn-id root-node-id
         :name (get checked-core :entrypoint)
         :params (c11-function-parameter-ids checked-core)
         :returns (get return-node :type)
         :latent-effects
         (c11-function-latent-effects
          nodes
          (get (get checked-core :source-core-input) :declared-effects))
         :capabilities
         (get (get checked-core :source-core-input) :declared-capabilities)
         :blocks (get graph :blocks)
         :entry (get graph :entry)
         :source
         (get (get graph :source-map) root-node-id)
         :facts
         {:type-fact-id
          (get (get (get checked-core :type-facts) root-node-id) :fact-id)
          :effect-fact-id
          (get (get (get checked-core :effect-facts) root-node-id) :fact-id)
          :ownership-fact-id
          (get (get (get checked-core :ownership-facts) root-node-id)
               :fact-id)
          :safety-outcome-id (c11-safety-outcome-id root-node-id)
          :profile-target-fact-id
          (c11-profile-target-fact-id root-node-id)}
         :provenance
         {:checked-core-artifact-id (get checked-core :artifact-id)
          :core-node-id root-node-id}}}
       :globals {}
       :control-flow-graph
       {:entry (get graph :entry)
        :edges (get graph :edges)
        :dominance (get graph :dominance)
        :join (get graph :join)}
       :data-flow-graph
       {:edges (get graph :data-flow)
        :terminator-uses (get graph :terminator-uses)
        :definitions (get graph :definitions)
        :values (get graph :values)}
       :type-table
       (c11-add-runtime-check-facts
        checked-core nodes :type
        (c11-build-fact-table-by-id
         nodes (get checked-core :type-facts) :fact-id ":type-fact" {}))
       :effect-table
       (c11-add-runtime-check-facts
        checked-core nodes :effect
        (c11-build-fact-table-by-id
         nodes (get checked-core :effect-facts) :fact-id ":effect-fact" {}))
       :effect-order-graph (get checked-core :effect-graph)
       :ownership-table
       (c11-add-runtime-check-facts
        checked-core nodes :ownership
        (c11-build-fact-table-by-id
         nodes (get checked-core :ownership-facts)
         :fact-id ":ownership-fact" {}))
       :capability-table
       (c11-add-runtime-check-facts
        checked-core nodes :capability
        (c11-build-fact-table-by-id
         nodes (get checked-core :capability-facts)
         :fact-id ":capability-fact" {}))
       :capability-proof-table
       (c11-build-capability-proof-table
        (get checked-core :capability-proof-records) {})
       :safety-table
       (c11-add-runtime-check-facts
        checked-core nodes :safety
        (c11-build-fact-table-by-id
         nodes (get checked-core :safety-facts)
         :outcome-id ":safety-outcome" {}))
       :profile-target-table
       (c11-add-runtime-check-facts
        checked-core nodes :profile-target
        (c11-build-profile-target-table checked-core nodes {}))
       :runtime-check-table
       (c11-build-runtime-check-table checked-core nodes {})
       :proof-certificate-table
       {:capability-proof-table-reference :capability-proof-table
        :safety-proofs (c11-build-safety-proof-table nodes {})}
       :source-map (get graph :source-map)
       :domain-anchors {}
       :diagnostics []
       :provenance
       {:checked-core-artifact-id (get checked-core :artifact-id)
        :checked-core-mapping-id (get checked-core :mapping-id)
       :checked-core-provenance-binding-id
        (get checked-core :provenance-binding-id)
        :checked-core-origin-closure-binding-id
        (get checked-core :provenance-binding-id)}
       :construction
       {:owner :gravity-source
        :function :c11-build-target-independent-mir
        :status :constructed}
       :pass-contract (if (= conditional-count 2) (c11-nested-pass-contract) (c11-build-mir-pass-contract))
       :pass-execution-record
       {:artifact :gravity/build-mir-pass-execution-record
        :pass-id :c11-build-mir-bounded-slice
        :pass-contract-hash :pending-source-binding
        :input-artifact-id (get checked-core :artifact-id)
        :output-content-id :pending-independent-verifier
        :verifier-report-id :pending-independent-verifier
        :verifier-report-hash :pending-independent-verifier
        :diagnostics []
        :status :constructed-unverified
        :record-id :pending-independent-verifier}
       :verification-status :pending
       :target-independent? true
       :b1-preflight
       {:input-kind :gravity/mir
        :requires-verifier-status :passed
        :status :pending-c11-verifier
        :backend-credit? false}
       :scope
       {:operation-set
        [:literal :implicit-nil :quote :local :let-binding :truthy
         :integer-eq :integer-lt :integer-lte :integer-gt :integer-gte
         :do :if :let :str :println :function
         :runtime-check]
        :maximum-conditionals (if (= conditional-count 2) 2 1)
        :maximum-module-carrier-nodes 16384
        :maximum-final-artifact-carrier-nodes 32768
        :maximum-carrier-depth 256
        :whole-c11? false
        :domain-ir-credit? false
        :optimization-credit? false
        :target-lowering-credit? false
        :backend-credit? false
        :llvm-credit? false
        :release-credit? false
        :whole-language? false
        :self-hosted? false}
       :clojure-seed-boundary? true
       :self-hosted? false})))

; SH-12 owns this bounded checked-core-to-MIR control-flow family.  It does
; not replace the generic C11 verifier contract above.  The verifier compares
; the constructed diamond with the canonical MIR projection of the supplied
; checked core, then checks each preservation family before it
; checks data-flow details.  This gives fact loss a stable C11 diagnostic
; instead of misclassifying it as a malformed block.

(defn sh12-branch-join-mir-policy []
  {:artifact :gravity/sh12-branch-join-mir-policy
   :schema-version 1
   :scope :single-conditional-branch-join
   :checked-core-artifact :gravity/sh12-c11-checked-core
   :control-flow-shape :entry-then-else-join-return
   :verification-kind :checked-core-canonical-projection
   :preserves [:type-facts :effect-facts :ownership-facts
               :capability-facts :safety-facts :profile-target-facts
               :source-spans :source-origin-map :generated-origin-chains
               :control-flow-edges :data-flow-edges :dominance-facts]
   :diagnostics ["C11-MODULE" "C11-BLOCK" "C11-DOMINANCE"
                 "C11-TYPE" "C11-EFFECT" "C11-SAFETY"
                 "C11-ORIGIN" "C11-VERIFY"]
   :maximum-functions 1
   :maximum-conditionals 1
   :target-independent? true
   :pending [:generic-c11-verifier :loops :calls :errors
             :program-lowering :sh12-completion]
   :nonclaims [:generic-c11-verifier :independent-acceptance
               :optimizer-credit :backend-credit :self-hosted?]})

(defn sh12-branch-join-node [checked-core]
  (let [nodes (get checked-core :core-nodes)]
    (if (vector? nodes)
      (c11-find-if-node nodes)
      nil)))

(defn sh12-branch-join-source [checked-core]
  (let [nodes (get checked-core :core-nodes)
        node (sh12-branch-join-node checked-core)]
    (if (= node nil)
      (if (vector? nodes)
        (get (first nodes) :source)
        nil)
      (get node :source))))

(defn sh12-branch-join-diagnostic-operation-id
  [diagnostic-id checked-core]
  (let [node (sh12-branch-join-node checked-core)]
    (if (= node nil)
      :not-applicable
      (if (= diagnostic-id "C11-MODULE")
        :not-applicable
        (if (= diagnostic-id "C11-BLOCK")
          :not-applicable
          (get node :node-id))))))

(defn sh12-branch-join-diagnostic-block
  [diagnostic-id checked-core]
  (if (= diagnostic-id "C11-MODULE")
    :not-applicable
    (str (get checked-core :artifact-id) ":mir:join")))

(defn sh12-branch-join-diagnostic-value-id
  [diagnostic-id checked-core]
  (if (= diagnostic-id "C11-DOMINANCE")
    (let [node (sh12-branch-join-node checked-core)]
      (if (= node nil) :not-applicable (get node :node-id)))
    :not-applicable))

(defn sh12-branch-join-remediation [diagnostic-id]
  (if (= diagnostic-id "C11-MODULE")
    :rebuild-module-from-authenticated-checked-core
    (if (= diagnostic-id "C11-BLOCK")
      :rebuild-blocks-terminators-and-cfg-edges
      (if (= diagnostic-id "C11-DOMINANCE")
        :rebuild-value-definitions-uses-and-edge-dominance
        (if (= diagnostic-id "C11-TYPE")
          :restore-checked-core-type-facts
          (if (= diagnostic-id "C11-EFFECT")
            :restore-effect-facts-and-ordering
            (if (= diagnostic-id "C11-SAFETY")
              :restore-safe1-outcomes-and-runtime-check-links
              (if (= diagnostic-id "C11-ORIGIN")
                :restore-source-span-and-origin-links
                :restore-ownership-capability-profile-and-provenance-facts))))))))

(defn sh12-branch-join-diagnostic
  [diagnostic-id missing-fact checked-core mir]
  (let [source (sh12-branch-join-source checked-core)]
    {:diagnostic-id diagnostic-id
     :severity :error
     :stage :c11-mir-verification
     :mir-module
     (if (= mir nil) :not-constructed (get mir :module-id))
     :function (get checked-core :entrypoint)
     :block
     (sh12-branch-join-diagnostic-block diagnostic-id checked-core)
     :operation-id
     (sh12-branch-join-diagnostic-operation-id diagnostic-id checked-core)
     :value-id
     (sh12-branch-join-diagnostic-value-id diagnostic-id checked-core)
     :source-span (get source :span)
     :origin-chain (get source :generated-origin)
     :profile (get checked-core :profile)
     :target-request
     (get (get checked-core :target-request-metadata) :requested-target)
     :missing-fact missing-fact
     :provenance
     {:checked-core-artifact-id (get checked-core :artifact-id)
      :mir-source-core (if (= mir nil) nil (get mir :source-core))
      :actual-source-path
      (let [mir-path
            (if (= mir nil)
              nil
              (get (first (get mir :diagnostics)) :actual-source-path))]
        (if (= mir-path nil)
          (if (sh12-c6p-family? checked-core)
            (get (get (get checked-core :physical-provenance) :actual-paths) :source)
            (get (get checked-core :provenance) :actual-source-path))
          mir-path))}
     :remediation (sh12-branch-join-remediation diagnostic-id)}))

(defn sh12-branch-join-rejection
  [phase diagnostic-id missing-fact checked-core mir]
  {:artifact :gravity/sh12-branch-join-mir-report
   :schema-version 1
   :scope :single-conditional-branch-join
   :phase phase
   :status :rejected
   :checked-core-artifact-id (get checked-core :artifact-id)
   :mir-module-id (if (= mir nil) nil (get mir :module-id))
   :checks []
   :preserves []
   :diagnostics
   [(sh12-branch-join-diagnostic
     diagnostic-id missing-fact checked-core mir)]
   :nonclaims [:generic-c11-verifier :independent-acceptance
               :optimizer-credit :backend-credit :self-hosted?]})

(defn sh12-branch-join-problem [diagnostic-id missing-fact]
  {:diagnostic-id diagnostic-id :missing-fact missing-fact})

(defn sh12-branch-join-nonempty-string? [value]
  (if (string? value) (> (count value) 0) false))

(defn sh12-branch-join-named-token-valid? [value]
  (if (keyword? value)
    (> (count (str value)) 1)
    (if (symbol? value)
      (> (count (str value)) 0)
      (sh12-branch-join-nonempty-string? value))))

(defn sh12-branch-join-named-values-valid? [values]
  (if (= (count values) 0)
    true
    (if (sh12-branch-join-named-token-valid? (first values))
      (sh12-branch-join-named-values-valid? (rest values))
      false)))

(defn sh12-branch-join-present? [value]
  (if (= nil value) false true))

(defn sh12-branch-join-source-span-valid? [span]
  (if (map? span)
    (if (= (set (keys span)) #{:source-id :start :end})
      (if (sh12-branch-join-nonempty-string? (get span :source-id))
        (if (integer? (get span :start))
          (if (integer? (get span :end))
            (if (<= 0 (get span :start))
              (<= (get span :start) (get span :end))
              false)
            false)
          false)
        false)
      false)
    false))

(defn sh12-branch-join-origin-entry-valid? [entry]
  (if (sh12-branch-join-named-token-valid? entry)
    true
    (if (map? entry)
      (if (= (set (keys entry))
             #{:role :producer-operation-id :runtime-check-id})
        (if (sh12-branch-join-named-token-valid? (get entry :role))
          (if (sh12-branch-join-nonempty-string?
               (get entry :producer-operation-id))
            (sh12-branch-join-nonempty-string?
             (get entry :runtime-check-id))
            false)
          false)
        (if (= (set (keys entry)) #{:kind :source-id})
          (if (sh12-branch-join-named-token-valid? (get entry :kind))
            (sh12-branch-join-nonempty-string? (get entry :source-id))
            false)
          false))
      false)))

(defn sh12-branch-join-origin-entries-valid? [entries]
  (if (= (count entries) 0)
    true
    (if (sh12-branch-join-origin-entry-valid? (first entries))
      (sh12-branch-join-origin-entries-valid? (rest entries))
      false)))

(defn sh12-branch-join-generated-origin-valid? [source]
  (let [generated? (get source :generated?)
        entries (get source :generated-origin)]
    (if (boolean? generated?)
      (if (vector? entries)
        (if generated?
          (if (> (count entries) 0)
            (sh12-branch-join-origin-entries-valid? entries)
            false)
          (= (count entries) 0))
        false)
      false)))

(defn sh12-branch-join-node-source-valid? [node]
  (let [source (get node :source)]
    (if (map? source)
      (if (= (set (keys source))
             #{:origin-id :span :enclosing-syntax-origin-id
               :generated? :generated-origin})
        (if (sh12-branch-join-nonempty-string?
             (get source :origin-id))
          (if (sh12-branch-join-source-span-valid?
               (get source :span))
            (if (sh12-branch-join-nonempty-string?
                 (get source :enclosing-syntax-origin-id))
              (sh12-branch-join-generated-origin-valid? source)
              false)
            false)
          false)
        false)
      false)))

(defn sh12-branch-join-node-type-valid? [checked-core node]
  (let [node-id (get node :node-id)
        fact (get (get checked-core :type-facts) node-id)]
    (if (map? fact)
      (if (sh12-branch-join-nonempty-string?
           (get fact :fact-id))
        (if (= (get fact :core-node-id) node-id)
          (= (get fact :type) (get node :type))
          false)
        false)
      false)))

(defn sh12-branch-join-node-effect-valid? [checked-core node]
  (let [node-id (get node :node-id)
        fact (get (get checked-core :effect-facts) node-id)
        attributes (get node :attributes)]
    (if (map? fact)
      (if (sh12-branch-join-nonempty-string?
           (get fact :fact-id))
        (if (= (get fact :core-node-id) node-id)
          (if (= (get fact :ordering) nil)
            false
            (if (= (get fact :direct)
                   (get attributes :intrinsic-effects))
              (if (= #{} (get fact :direct))
                (if (= #{} (get fact :latent))
                  (if (= #{} (get fact :transitive))
                    (if (= #{} (get fact :residual))
                      (if (= #{} (get node :effects))
                        (if (= #{}
                               (get
                                (get checked-core :source-core-input)
                                :declared-effects))
                          (= [] (get checked-core :effect-graph))
                          false)
                        false)
                      false)
                    false)
                  false)
                false)
              false))
          false)
        false)
      false)))

(defn sh12-branch-join-node-ownership-valid? [checked-core node]
  (let [node-id (get node :node-id)
        fact (get (get checked-core :ownership-facts) node-id)
        ownership (get node :ownership)]
    (if (map? fact)
      (if (sh12-branch-join-nonempty-string?
           (get fact :fact-id))
        (if (= (get fact :core-node-id) node-id)
          (if (= (get fact :value-id) node-id)
            (if (= (get ownership :value-id) node-id)
              (= (get fact :model) (get ownership :model))
              false)
            false)
          false)
        false)
      false)))

(defn sh12-branch-join-capability-proof-record
  [records proof-id]
  (if (= (count records) 0)
    nil
    (let [record (first records)]
      (if (= proof-id (get record :proof-id))
        record
        (sh12-branch-join-capability-proof-record
         (rest records) proof-id)))))

(defn sh12-branch-join-capability-proof-record-valid?
  [checked-core record proof-id]
  (if (map? record)
    (if (= proof-id (get record :proof-id))
      (if (= :authenticated (get record :status))
        (= (get checked-core :artifact-id)
           (get record :source-artifact-id))
        false)
      false)
    false))

(defn sh12-branch-join-capability-proof-ids-valid?
  [checked-core proof-ids]
  (if (= (count proof-ids) 0)
    true
    (let [proof-id (first proof-ids)
          records (get checked-core :capability-proof-records)
          record
          (sh12-branch-join-capability-proof-record records proof-id)]
      (if (sh12-branch-join-nonempty-string? proof-id)
        (if (sh12-branch-join-capability-proof-record-valid?
             checked-core record proof-id)
          (sh12-branch-join-capability-proof-ids-valid?
           checked-core (rest proof-ids))
          false)
        false))))

(defn sh12-branch-join-node-capability-fact-valid? [checked-core node]
  (let [node-id (get node :node-id)
        fact (get (get checked-core :capability-facts) node-id)
        proof (get fact :capability-proof)
        attributes (get node :attributes)]
    (if (map? fact)
      (if (= (get fact :fact-id)
             (c11-capability-fact-id node-id))
        (if (= (get fact :core-node-id) node-id)
          (if (= (get fact :required)
                 (get attributes :intrinsic-capabilities))
            (if (set? (get fact :granted))
              (if (map? proof)
                (vector? (get proof :proof-ids))
                false)
              false)
            false)
          false)
        false)
      false)))

(defn sh12-branch-join-set-contained? [required available]
  (if (= (count required) 0)
    true
    (if (contains? available (first required))
      (sh12-branch-join-set-contained? (rest required) available)
      false)))

(defn sh12-branch-join-node-capability-authority-valid?
  [checked-core node]
  (let [node-id (get node :node-id)
        fact (get (get checked-core :capability-facts) node-id)
        required (get fact :required)
        granted (get fact :granted)
        declared
        (get (get checked-core :source-core-input)
             :declared-capabilities)
        proof-ids (get (get fact :capability-proof) :proof-ids)]
    (if (sh12-branch-join-set-contained? required granted)
      (if (sh12-branch-join-set-contained? required declared)
        (if (sh12-branch-join-set-contained? granted declared)
          (if (> (count granted) 0)
            (> (count proof-ids) 0)
            true)
          false)
        false)
      false)))

(defn sh12-branch-join-node-capability-valid? [checked-core node]
  (if (sh12-branch-join-node-capability-fact-valid?
       checked-core node)
    (if (sh12-branch-join-node-capability-authority-valid?
         checked-core node)
      (sh12-branch-join-capability-proof-ids-valid?
       checked-core
       (get
        (get
         (get (get checked-core :capability-facts)
              (get node :node-id))
         :capability-proof)
        :proof-ids))
      false)
    false))

(defn sh12-branch-join-proven-safe-proof-valid? [proof]
  (if (map? proof)
    (if (sh12-branch-join-nonempty-string? (get proof :proof-id))
      (if (= :valid (get proof :status))
        (sh12-branch-join-named-token-valid? (get proof :rule))
        false)
      false)
    false))

(defn sh12-branch-join-runtime-check-node-precedes?
  [nodes operand-id guarded-id]
  (if (= (count nodes) 0)
    false
    (let [node-id (get (first nodes) :node-id)]
      (if (= node-id operand-id)
        true
        (if (= node-id guarded-id)
          false
          (sh12-branch-join-runtime-check-node-precedes?
           (rest nodes) operand-id guarded-id))))))

(defn sh12-branch-join-runtime-check-operands-valid?
  [checked-core node operand-ids]
  (if (vector? operand-ids)
    (if (= operand-ids [(first (get node :operands))])
      (let [nodes (get checked-core :core-nodes)
            guarded-id (get node :node-id)]
        (if (sh12-branch-join-named-values-valid? operand-ids)
          (sh12-branch-join-runtime-check-node-precedes?
           nodes (first operand-ids) guarded-id)
          false))
      false)
    false))

(defn sh12-branch-join-runtime-check-predicate-valid?
  [checked-core node predicate]
  (if (map? predicate)
    (if (= (set (keys predicate))
           #{:expression :operation-id :kind :operand-ids})
      (if (= :boolean-value (get predicate :expression))
        (if (= (get predicate :operation-id) (get node :node-id))
          (if (= :branch-condition (get predicate :kind))
            (sh12-branch-join-runtime-check-operands-valid?
             checked-core node (get predicate :operand-ids))
            false)
          false)
        false)
      false)
    false))

(defn sh12-branch-join-runtime-check-id-count
  [nodes check-id result]
  (if (= (count nodes) 0)
    result
    (let [check (get (get (first nodes) :safety) :check)]
      (sh12-branch-join-runtime-check-id-count
       (rest nodes) check-id
       (if (= check-id (get check :check-id))
         (+ result 1)
         result)))))

(defn sh12-branch-join-runtime-check-semantics-valid?
  [checked-core node check]
  (if (= :branch-condition (get check :condition))
    (if (sh12-branch-join-runtime-check-predicate-valid?
         checked-core node (get check :predicate))
      (if (= :if (get node :source-operation))
        (if (= :if (get check :source-operation))
          (if (= :before-operation (get check :emitted-location))
            (if (= (get node :profile) (get check :profile))
              (if (= (get checked-core :source-target)
                     (get check :target))
                (if (= :error/invalid-branch-condition
                       (get check :failure))
                  (if (= #{:error/raise}
                         (get check :effects-introduced))
                    (if (= :constant-time
                           (get check :performance-class))
                      (if (= [:condition-value-change]
                             (get check :invalidation-conditions))
                        (let [proof-id
                              (get check :capability-proof-id)]
                          (if (sh12-branch-join-nonempty-string? proof-id)
                            (sh12-branch-join-capability-proof-ids-valid?
                             checked-core [proof-id])
                            false))
                        false)
                      false)
                    false)
                  false)
                false)
              false)
            false)
          false)
        false)
      false)
    false))

(defn sh12-branch-join-runtime-check-valid?
  [checked-core node check]
  (if (map? check)
    (if (= (set (keys check))
           #{:artifact :check-id :condition :predicate
             :source-operation
             :emitted-location :profile :target :failure
             :effects-introduced :performance-class
             :invalidation-conditions :capability-proof-id})
      (if (= :gravity/sh11-runtime-safety-check (get check :artifact))
        (if (sh12-branch-join-nonempty-string? (get check :check-id))
          (if (= 1
                 (sh12-branch-join-runtime-check-id-count
                  (get checked-core :core-nodes)
                  (get check :check-id) 0))
            (sh12-branch-join-runtime-check-semantics-valid?
             checked-core node check)
            false)
          false)
        false)
      false)
    false))

(defn sh12-branch-join-unsafe-boundary-valid? [audit]
  (if (= true (get audit :internal-only))
    true
    (let [wrapper (get audit :safe-wrapper)]
      (if (symbol? wrapper)
        (sh12-branch-join-named-token-valid? wrapper)
        (sh12-branch-join-nonempty-string? wrapper)))))

(defn sh12-branch-join-unsafe-value-substantive? [value]
  (sh12-branch-join-named-token-valid? value))

(defn sh12-branch-join-unsafe-values-substantive? [values]
  (sh12-branch-join-named-values-valid? values))

(defn sh12-branch-join-unsafe-obligation-set-valid? [values]
  (if (set? values)
    (if (> (count values) 0)
      (sh12-branch-join-unsafe-values-substantive? values)
      false)
    false))

(defn sh12-branch-join-unsafe-origin-valid? [node audit]
  (let [expected (get (get node :source) :generated-origin)
        origin? (contains? audit :generated-origin)
        chain? (contains? audit :generated-origin-chain)]
    (if origin?
      (if chain?
        false
        (= expected (get audit :generated-origin)))
      (if chain?
        (= expected (get audit :generated-origin-chain))
        false))))

(defn sh12-branch-join-unsafe-audit-valid?
  [checked-core node audit]
  (if (map? audit)
    (if (= :gravity/unsafe-island (get audit :artifact))
      (if (sh12-branch-join-nonempty-string? (get audit :audit-id))
        (if (= (get audit :operation) (get node :node-id))
          (if (sh12-branch-join-nonempty-string? (get audit :owner))
            (if (sh12-branch-join-unsafe-value-substantive?
                 (get audit :reason))
              (if (= (get audit :source-span)
                     (get (get node :source) :span))
                (if (sh12-branch-join-unsafe-origin-valid? node audit)
                  (if (= (get node :profile) (get audit :profile))
                    (if (= (get checked-core :source-target)
                           (get audit :target))
                      (if (= (get audit :effects)
                             (get (get node :attributes)
                                  :intrinsic-effects))
                        (if (= (get audit :capabilities)
                               (get (get node :attributes)
                                    :intrinsic-capabilities))
                          (if (sh12-branch-join-unsafe-obligation-set-valid?
                               (get audit :preconditions))
                            (if (sh12-branch-join-unsafe-obligation-set-valid?
                                 (get audit :postconditions))
                              (if (sh12-branch-join-unsafe-obligation-set-valid?
                                   (get audit :invariants))
                                (if (sh12-branch-join-unsafe-obligation-set-valid?
                                     (get audit :evidence))
                                  (if
                                   (sh12-branch-join-unsafe-boundary-valid?
                                    audit)
                                    (if (map? (get audit :review))
                                      (if (= :required
                                             (get (get audit :review)
                                                  :policy))
                                        (sh12-branch-join-unsafe-value-substantive?
                                         (get audit :re-review))
                                        false)
                                      false)
                                    false)
                                  false)
                                false)
                              false)
                            false)
                          false)
                        false)
                      false)
                    false)
                  false)
                false)
              false)
            false)
          false)
        false)
      false)
    false))

(defn sh12-branch-join-node-safety-shape-valid? [checked-core node]
  (let [node-id (get node :node-id)
        fact (get (get checked-core :safety-facts) node-id)
        outcome (get fact :outcome)]
    (if (map? fact)
      (if (= fact (get node :safety))
        (if (= (get fact :outcome-id)
               (c11-safety-outcome-id node-id))
          (if (= (get fact :operation) node-id)
            (c11-vector-contains?
             [:proven-safe :runtime-checked :unsafe-island] outcome)
            false)
          false)
        false)
      false)))

(defn sh12-branch-join-node-safety-valid? [checked-core node]
  (let [fact
        (get (get checked-core :safety-facts) (get node :node-id))
        outcome (get fact :outcome)]
    (if (sh12-branch-join-node-safety-shape-valid?
         checked-core node)
      (if (= outcome :proven-safe)
        (if (= nil (get fact :check))
          (if (= nil (get fact :unsafe-audit))
            (sh12-branch-join-proven-safe-proof-valid?
             (get fact :proof))
            false)
          false)
        (if (= outcome :runtime-checked)
          (if (= nil (get fact :proof))
            (if (= nil (get fact :unsafe-audit))
              (sh12-branch-join-runtime-check-valid?
               checked-core node (get fact :check))
              false)
            false)
          (if (= nil (get fact :proof))
            (if (= nil (get fact :check))
              (sh12-branch-join-unsafe-audit-valid?
               checked-core node (get fact :unsafe-audit))
              false)
            false)))
      false)))

(defn sh12-branch-join-node-profile-valid? [checked-core node]
  (let [node-id (get node :node-id)
        fact (get (get checked-core :profile-facts) node-id)]
    (if (map? fact)
      (if (= (get fact :profile) (get node :profile))
        (= (get fact :target) (get checked-core :source-target))
        false)
      false)))

(defn sh12-branch-join-node-problem [checked-core node]
  (if (map? node)
    (if (sh12-branch-join-nonempty-string? (get node :node-id))
      (if (= :unsupported-checked-core-operation (c11-opcode node))
        (sh12-branch-join-problem
         "C11-TYPE" :checked-core-operation-schema)
        (if (vector? (get node :path))
          (if (vector? (get node :operands))
          (if (map? (get node :attributes))
            (if (set? (get (get node :attributes) :intrinsic-effects))
              (if (set?
                   (get (get node :attributes) :intrinsic-capabilities))
                (if (sh12-branch-join-node-source-valid? node)
                  (if (sh12-branch-join-node-type-valid?
                       checked-core node)
                    (if (sh12-branch-join-node-effect-valid?
                         checked-core node)
                      (if (sh12-branch-join-node-ownership-valid?
                           checked-core node)
                        (if (sh12-branch-join-node-capability-valid?
                             checked-core node)
                          (if (sh12-branch-join-node-safety-valid?
                               checked-core node)
                            (if (sh12-branch-join-node-profile-valid?
                                 checked-core node)
                              nil
                              (sh12-branch-join-problem
                               "C11-VERIFY" :profile-target-fact))
                            (sh12-branch-join-problem
                             "C11-SAFETY"
                             (if (sh12-branch-join-node-safety-shape-valid?
                                  checked-core node)
                               (if (= :unsafe-island
                                      (get (get node :safety) :outcome))
                                 :unsafe-island-audit
                                 :safety-outcome-evidence)
                               :safety-outcome-fact)))
                          (sh12-branch-join-problem
                           "C11-VERIFY"
                           (if
                            (sh12-branch-join-node-capability-fact-valid?
                             checked-core node)
                             (if
                              (sh12-branch-join-node-capability-authority-valid?
                               checked-core node)
                               :capability-proof-reference
                               :capability-authority)
                             :capability-fact)))
                        (sh12-branch-join-problem
                         "C11-VERIFY" :ownership-fact))
                      (sh12-branch-join-problem
                       "C11-EFFECT" :effect-fact-or-ordering))
                    (sh12-branch-join-problem
                     "C11-TYPE" :type-fact-or-operation-schema))
                  (sh12-branch-join-problem
                   "C11-ORIGIN" :source-span-or-origin-fact))
                (sh12-branch-join-problem
                 "C11-VERIFY" :intrinsic-capability-set))
              (sh12-branch-join-problem
               "C11-EFFECT" :intrinsic-effect-set))
            (sh12-branch-join-problem
             "C11-MODULE" :core-node-attributes))
          (sh12-branch-join-problem
           "C11-DOMINANCE" :core-node-operands))
          (sh12-branch-join-problem "C11-BLOCK" :core-node-path)))
      (sh12-branch-join-problem "C11-MODULE" :core-node-identity))
    (sh12-branch-join-problem "C11-MODULE" :core-node-carrier)))

(defn sh12-branch-join-nodes-problem [checked-core nodes]
  (if (= (count nodes) 0)
    nil
    (let [problem
          (sh12-branch-join-node-problem checked-core (first nodes))]
      (if (= problem nil)
        (sh12-branch-join-nodes-problem checked-core (rest nodes))
        (let [node (first nodes)]
          (if (map? node)
            (if (sh12-branch-join-nonempty-string? (get node :node-id))
              (if (sh12-branch-join-node-source-valid? node)
                (assoc problem :node node)
                problem)
              problem)
            problem))))))

(defn sh12-branch-join-node-ids-unique? [nodes seen]
  (if (= (count nodes) 0)
    true
    (let [node-id (get (first nodes) :node-id)]
      (if (c11-vector-contains? seen node-id)
        false
        (sh12-branch-join-node-ids-unique?
         (rest nodes) (conj seen node-id))))))

(defn sh12-branch-join-fact-ids-unique?
  [nodes fact-table id-field seen]
  (if (= (count nodes) 0)
    true
    (let [node-id (get (first nodes) :node-id)
          fact-id (get (get fact-table node-id) id-field)]
      (if (c11-vector-contains? seen fact-id)
        false
        (sh12-branch-join-fact-ids-unique?
         (rest nodes) fact-table id-field (conj seen fact-id))))))

(defn sh12-branch-join-identity-problem [checked-core]
  (let [nodes (get checked-core :core-nodes)]
    (if (sh12-branch-join-node-ids-unique? nodes [])
      (if (sh12-branch-join-fact-ids-unique?
           nodes (get checked-core :type-facts) :fact-id [])
        (if (sh12-branch-join-fact-ids-unique?
             nodes (get checked-core :effect-facts) :fact-id [])
          (if (sh12-branch-join-fact-ids-unique?
               nodes (get checked-core :ownership-facts) :fact-id [])
            (if (sh12-branch-join-fact-ids-unique?
                 nodes (get checked-core :capability-facts) :fact-id [])
              (if (sh12-branch-join-fact-ids-unique?
                   nodes (get checked-core :safety-facts) :outcome-id [])
                nil
                (sh12-branch-join-problem
                 "C11-SAFETY" :unique-safety-outcome-identity))
              (sh12-branch-join-problem
               "C11-VERIFY" :unique-capability-fact-identity))
            (sh12-branch-join-problem
             "C11-VERIFY" :unique-ownership-fact-identity))
          (sh12-branch-join-problem
           "C11-EFFECT" :unique-effect-fact-identity))
        (sh12-branch-join-problem
         "C11-TYPE" :unique-type-fact-identity))
      (sh12-branch-join-problem
       "C11-DOMINANCE" :unique-core-node-identity))))

(defn sh12-branch-join-operands-defined? [nodes operands]
  (if (= (count operands) 0)
    true
    (if (= (c11-find-node-by-id nodes (first operands)) nil)
      false
      (sh12-branch-join-operands-defined? nodes (rest operands)))))

(defn sh12-branch-join-all-operands-defined? [nodes remaining]
  (if (= (count remaining) 0)
    true
    (if (sh12-branch-join-operands-defined?
         nodes (get (first remaining) :operands))
      (sh12-branch-join-all-operands-defined? nodes (rest remaining))
      false)))

(defn sh12-branch-join-node-before? [nodes before-id after-id]
  (if (= (count nodes) 0)
    false
    (let [node-id (get (first nodes) :node-id)]
      (if (= node-id before-id)
        true
        (if (= node-id after-id)
          false
          (sh12-branch-join-node-before?
           (rest nodes) before-id after-id))))))

(defn sh12-branch-join-operands-before?
  [nodes consumer-id operands]
  (if (= (count operands) 0)
    true
    (if (sh12-branch-join-node-before?
         nodes (first operands) consumer-id)
      (sh12-branch-join-operands-before?
       nodes consumer-id (rest operands))
      false)))

(defn sh12-branch-join-all-operands-before? [nodes remaining]
  (if (= (count remaining) 0)
    true
    (let [node (first remaining)]
      (if (sh12-branch-join-operands-before?
           nodes (get node :node-id) (get node :operands))
        (sh12-branch-join-all-operands-before?
         nodes (rest remaining))
        false))))

(defn sh12-branch-join-control-problem [checked-core]
  (let [nodes (get checked-core :core-nodes)
        if-node (sh12-branch-join-node checked-core)
        operands (get if-node :operands)
        root-id (first (get checked-core :root-node-ids))
        root (c11-find-node-by-id nodes root-id)]
    (if (= 1 (c11-if-count nodes 0))
      (if (= 3 (count operands))
        (if (sh12-branch-join-all-operands-defined? nodes nodes)
          (let [condition (c11-find-node-by-id nodes (first operands))
                then-node (c11-find-node-by-id nodes (second operands))
                else-node
                (c11-find-node-by-id nodes (first (rest (rest operands))))
                if-path (get if-node :path)]
            (if (= (get condition :type) :gravity.type/bool)
              (if (if (c11-path-prefix?
                       (conj if-path :condition) (get condition :path))
                    true
                    (if (= :truthy (get condition :source-operation))
                      (= (conj if-path :truthy) (get condition :path))
                      false))
                (if (sh12-branch-join-node-before?
                     nodes (get condition :node-id) (get if-node :node-id))
                  (if (= (get then-node :type) (get else-node :type))
                    (if (= (get then-node :type) (get if-node :type))
                      (if (c11-path-prefix?
                           (conj if-path :then) (get then-node :path))
                        (if (c11-path-prefix?
                             (conj if-path :else) (get else-node :path))
                          (if (map? root)
                            (if (= (get root :source-operation) :function)
                              (if (= (c11-last-value (get root :operands))
                                     (get if-node :node-id))
                                (if (sh12-branch-join-node-before?
                                     nodes
                                     (get if-node :node-id)
                                     (get root :node-id))
                                  nil
                                  (sh12-branch-join-problem
                                   "C11-DOMINANCE"
                                   :function-return-dominance))
                                (sh12-branch-join-problem
                                 "C11-DOMINANCE" :function-return-value))
                              (sh12-branch-join-problem
                               "C11-MODULE" :function-root-operation))
                            (sh12-branch-join-problem
                             "C11-MODULE" :function-root-node))
                          (sh12-branch-join-problem
                           "C11-BLOCK" :else-branch-path))
                        (sh12-branch-join-problem
                         "C11-BLOCK" :then-branch-path))
                      (sh12-branch-join-problem
                       "C11-TYPE" :conditional-result-type))
                    (sh12-branch-join-problem
                     "C11-TYPE" :branch-result-type))
                  (sh12-branch-join-problem
                   "C11-DOMINANCE" :conditional-definition-dominance))
                (sh12-branch-join-problem
                 "C11-DOMINANCE" :conditional-definition-path))
              (sh12-branch-join-problem
               "C11-TYPE" :conditional-value-type)))
          (sh12-branch-join-problem
           "C11-DOMINANCE" :undefined-core-operand))
        (sh12-branch-join-problem
         "C11-BLOCK" :conditional-operands))
      (sh12-branch-join-problem
       "C11-BLOCK" :single-conditional-checked-core))))

(defn sh12-branch-join-checked-core-lineage-valid? [checked-core]
  (let [source-core (get checked-core :source-core-input)
        target-request (get checked-core :target-request-metadata)
        provenance (get checked-core :provenance)]
    (if (sh12-branch-join-nonempty-string?
         (get checked-core :artifact-id))
      (if (sh12-branch-join-nonempty-string?
           (get checked-core :mapping-id))
        (if (sh12-branch-join-nonempty-string?
             (get checked-core :provenance-binding-id))
          (if (map? source-core)
            (if (symbol? (get source-core :module))
              (if (set? (get source-core :declared-effects))
                (if (set? (get source-core :declared-capabilities))
                  (if (map? target-request)
                    (if (= (get target-request :requested-target) nil)
                      false
                      (if (symbol? (get checked-core :entrypoint))
                        (if (= (get checked-core :profile) nil)
                          false
                          (if (= (get checked-core :source-target) nil)
                            false
                            (if (map? provenance)
                              (sh12-branch-join-nonempty-string?
                               (get provenance :actual-source-path))
                              false)))
                        false))
                    false)
                  false)
                false)
              false)
            false)
          false)
        false)
      false)))

(defn sh12-branch-join-checked-core-shape-valid? [checked-core]
  (if (map? checked-core)
    (if (= :gravity/sh12-c11-checked-core
           (get checked-core :artifact))
      (if (= 1 (get checked-core :schema-version))
        (if (= :accepted (get checked-core :status))
          (if (sh12-branch-join-checked-core-lineage-valid? checked-core)
            (if (vector? (get checked-core :core-nodes))
              (if (> (count (get checked-core :core-nodes)) 0)
                (if (vector? (get checked-core :root-node-ids))
                  (if (= 1 (count (get checked-core :root-node-ids)))
                    (if (map? (get checked-core :type-facts))
                      (if (map? (get checked-core :effect-facts))
                        (if (map? (get checked-core :ownership-facts))
                          (if (map? (get checked-core :capability-facts))
                            (if (vector?
                                 (get checked-core
                                      :capability-proof-records))
                              (if (map? (get checked-core :safety-facts))
                                (map? (get checked-core :profile-facts))
                                false)
                              false)
                            false)
                          false)
                        false)
                      false)
                    false)
                  false)
                false)
              false)
            false)
          false)
        false)
      false)
    false))

(defn sh12-supplied-branch-join-checked-core-preflight [checked-core]
  (if (sh12-branch-join-checked-core-shape-valid? checked-core)
    (let [node-problem
          (sh12-branch-join-nodes-problem
           checked-core (get checked-core :core-nodes))]
      (if (= node-problem nil)
        (let [identity-problem
              (sh12-branch-join-identity-problem checked-core)]
          (if (= identity-problem nil)
            (let [control-problem
                  (sh12-branch-join-control-problem checked-core)]
              (if (= control-problem nil)
                (if (sh12-branch-join-all-operands-before?
                     (get checked-core :core-nodes)
                     (get checked-core :core-nodes))
                  {:status :accepted}
                  {:status :rejected
                   :diagnostic-id "C11-DOMINANCE"
                   :missing-fact :definitions-uses-or-edge-dominance})
                (assoc control-problem :status :rejected)))
            (assoc identity-problem :status :rejected)))
        (assoc node-problem :status :rejected)))
    {:status :rejected
     :diagnostic-id "C11-MODULE"
     :missing-fact :checked-core-shape}))

(defn sh12-c6p-all? [checks]
  (if (= (count checks) 0) true
    (if (= true (first checks)) (sh12-c6p-all? (rest checks)) false)))

(defn sh12-c6p-keys? [value fields]
  (if (map? value) (= (set (keys value)) fields) false))

(defn sh12-c6p-family? [core]
  (let [kind (get core :kind)]
    (if (keyword? kind)
      (= :gravity/p15-s23-stage2-gravity-checked-core-artifact kind) false)))

(defn sh12-c6p-predicate-local-side [core]
  ; Candidate only: fourteen rows also describe an arm-nested let or a
  ; conditional initializer. Original source/facts/lexical joins follow.
  (let [nodes (get core :core-nodes)]
    (if (vector? nodes)
      (if (= 14 (count nodes))
        (let [binder (get nodes 2) inner (get nodes 7) outer (get nodes 11)
              scope (get nodes 12) root (get nodes 13) b (get binder :node-id)
              i (get inner :node-id) o (get outer :node-id) s (get scope :node-id)]
          (if (sh12-c6p-all? [(string? b) (string? i) (string? o) (string? s)
                (= :let-binding (get binder :source-operation)) (= :if (get inner :source-operation))
                (= :if (get outer :source-operation)) (= :let (get scope :source-operation))
                (= :function (get root :source-operation))])
            (if (if (= [b o] (get scope :operands)) (= [s] (get root :operands)) false)
              (if (= :local (get (get nodes 5) :source-operation))
                (if (if (= :literal (get (get nodes 6) :source-operation))
                        (= [b] (get (get nodes 5) :operands)) false) :then nil)
                (if (= :local (get (get nodes 6) :source-operation))
                  (if (if (= :literal (get (get nodes 5) :source-operation))
                          (= [b] (get (get nodes 6) :operands)) false) :else nil) nil)) nil) nil)) nil) nil)))

(defn sh12-c6p-later-body-local? [core]
  ; Candidate topology only: eleven rows also occur in the nested family.
  ; Complete source, lexical, fact and graph joins still precede construction.
  (let [nodes (get core :core-nodes)]
    (if (vector? nodes)
      (if (= 11 (count nodes))
        (let [binder (get nodes 2) conditional (get nodes 7) local (get nodes 8)
              scope (get nodes 9) root (get nodes 10)
              b (get binder :node-id) c (get conditional :node-id)
              l (get local :node-id) s (get scope :node-id)]
          (if (sh12-c6p-all? [(string? b) (string? c) (string? l) (string? s)
                (= :let-binding (get binder :source-operation)) (= :if (get conditional :source-operation))
                (= :local (get local :source-operation)) (= :let (get scope :source-operation))
                (= :function (get root :source-operation))])
            (sh12-c6p-all? [(= [b] (get local :operands)) (= [b c l] (get scope :operands))
                            (= [s] (get root :operands))]) false)) false) false)))

(defn sh12-c6p-arm-local-side [core]
  ; Candidate only. Complete original binding/source/operand/fact joins
  ; distinguish the condition's parameter from the arm's lexical alias.
  (let [nodes (get core :core-nodes)]
    (if (vector? nodes)
      (if (= 10 (count nodes))
        (if (= :let-binding (get (get nodes 2) :source-operation))
          (if (= :local (get (get nodes 5) :source-operation))
            (if (= :literal (get (get nodes 6) :source-operation)) :then nil)
            (if (= :local (get (get nodes 6) :source-operation))
              (if (= :literal (get (get nodes 5) :source-operation)) :else nil) nil)) nil) nil) nil)))

(defn sh12-c6p-arm-local? [core]
  (contains? #{:then :else} (sh12-c6p-arm-local-side core)))

(defn sh12-c6p-conditional-initializer? [core]
  ; A guarded topology discriminator, not a substitute for the full source,
  ; lexical record, fact and definition checks below.
  (let [nodes (get core :core-nodes)]
    (if (vector? nodes)
      (if (= 14 (count nodes))
        (let [value (get nodes 5) binder (get nodes 6) local (get nodes 7)
              value-id (get value :node-id) binder-id (get binder :node-id)
              bound (get binder :operands) used (get local :operands)]
          (if (if (= :if (get value :source-operation))
                (if (= :let-binding (get binder :source-operation)) (= :local (get local :source-operation)) false) false)
            (if (if (string? value-id) (string? binder-id) false)
              (if (if (vector? bound) (vector? used) false)
                (if (= [value-id] bound) (= [binder-id] used) false) false) false) false)) false) false)))

(defn sh12-c6p-predicate? [core]
  ; Candidate only; every original row and exact source topology is checked
  ; after the existing whole-carrier preflight.
  (let [nodes (get core :core-nodes)]
    (if (vector? nodes)
      (if (contains? #{:then :else} (sh12-c6p-predicate-local-side core)) true
        (if (= 11 (count nodes)) (= :if (get (get nodes 5) :source-operation))
          (sh12-c6p-conditional-initializer? core))) false)))

(defn sh12-c6p-predicate-bool-node? [core index]
  (if (sh12-c6p-predicate? core)
    (contains? (if (contains? #{:then :else} (sh12-c6p-predicate-local-side core)) #{5 6 7} #{3 4 5}) index) false))

(defn sh12-c6p-nested-side [core]
  ; A candidate index only. Complete source/shape/fact validation follows the
  ; existing whole-carrier preflight before this may authorize construction.
  (let [nodes (get core :core-nodes)]
    (if (sh12-c6p-later-body-local? core) nil
    (if (vector? nodes)
      (if (contains? #{11 14} (count nodes))
        (let [offset (if (= 14 (count nodes)) 2 0)]
          (if (= :if (get (get nodes (+ 7 offset)) :source-operation)) :then
            (if (= :if (get (get nodes (+ 8 offset)) :source-operation)) :else
              (if (sh12-c6p-predicate? core) :predicate nil)))) nil) nil))))

(defn sh12-c6p-nested-let? [core]
  (let [nodes (get core :core-nodes)]
    (if (vector? nodes) (= 14 (count nodes)) false)))

(defn sh12-c6p-nested-index [core index]
  ; Invocation-local index into original rows. No Core rewrite or elision.
  (if (sh12-c6p-nested-let? core)
    (get (if (sh12-c6p-conditional-initializer? core)
           [0 1 2 3 4 5 8 9 10 11 13] [0 3 4 5 6 7 8 9 10 11 13]) index) index))

(defn sh12-c6p-nested-rows [core rows]
  (if (sh12-c6p-nested-let? core)
    (loop [index 0 result []]
      (if (= index 11) result
        (recur (+ index 1) (conj result (get rows (sh12-c6p-nested-index core index)))))) rows))

(defn sh12-c6p-nested? [core]
  (contains? #{:then :else :predicate} (sh12-c6p-nested-side core)))

(defn sh12-c6p-inner-index [core]
  (if (sh12-c6p-predicate? core) (sh12-c6p-nested-index core 5)
    (sh12-c6p-nested-index core (if (= :then (sh12-c6p-nested-side core)) 7 8))))

(defn sh12-c6p-inner-condition-index [core]
  (- (sh12-c6p-inner-index core) 4))

(defn sh12-c6p-let-count [core]
  (let [nodes (get core :core-nodes)]
    (if (vector? nodes)
      (if (sh12-c6p-later-body-local? core) 1
        (if (contains? #{10 14} (count nodes)) 1 (if (= 12 (count nodes)) 2 0))) 0)))

(defn sh12-c6p-let-layout? [core]
  (> (sh12-c6p-let-count core) 0))

(defn sh12-c6p-index [core role]
  (if (sh12-c6p-nested? core)
    (if (sh12-c6p-predicate? core)
      (get (if (sh12-c6p-conditional-initializer? core) [0 7 8 9 10 11 13]
             (if (contains? #{:then :else} (sh12-c6p-predicate-local-side core))
               [0 3 8 9 10 11 13] [0 1 6 7 8 9 10])) role)
      (sh12-c6p-nested-index core
        (get (if (= :then (sh12-c6p-nested-side core)) [0 1 2 7 8 9 10] [0 1 2 3 8 9 10]) role)))
    (if (= 2 (sh12-c6p-let-count core)) (get [0 5 6 7 8 9 11] role)
      (if (sh12-c6p-let-layout? core)
        (get (if (sh12-c6p-later-body-local? core) [0 3 4 5 6 7 10] [0 3 4 5 6 7 9]) role) role))))

(defn sh12-c6p-scope-index [core]
  (if (sh12-c6p-later-body-local? core) 9 (+ 1 (sh12-c6p-index core 5))))

(defn sh12-c6p-role [core index]
  (if (sh12-c6p-nested? core)
    (get (if (sh12-c6p-predicate? core)
           (if (contains? #{:then :else} (sh12-c6p-predicate-local-side core))
             (if (= :then (sh12-c6p-predicate-local-side core))
               [0 1 7 1 2 1 4 5 2 3 4 5 8 6] [0 1 7 1 2 3 1 5 2 3 4 5 8 6])
             (if (sh12-c6p-conditional-initializer? core)
               [0 1 2 3 4 5 7 1 2 3 4 5 8 6] [0 1 2 3 4 5 2 3 4 5 6]))
           (if (sh12-c6p-nested-let? core)
           (if (= :then (sh12-c6p-nested-side core))
             [0 1 7 1 2 9 2 3 4 5 4 5 8 6] [0 1 7 1 2 3 9 2 3 4 5 5 8 6])
           (if (= :then (sh12-c6p-nested-side core)) [0 1 2 9 2 3 4 5 4 5 6] [0 1 2 3 9 2 3 4 5 5 6]))) index)
    (if (sh12-c6p-later-body-local? core) (get [0 1 7 1 2 3 4 5 1 8 6] index)
    (if (sh12-c6p-arm-local? core)
      (get (if (= :then (sh12-c6p-arm-local-side core)) [0 1 7 1 2 1 4 5 8 6] [0 1 7 1 2 3 1 5 8 6]) index)
      (if (= 2 (sh12-c6p-let-count core)) (get [0 1 7 1 7 1 2 3 4 5 8 6] index)
        (if (sh12-c6p-let-layout? core) (get [0 1 7 1 2 3 4 5 8 6] index) index))))))

(defn sh12-c6p-result-type [core]
  (get (get (get core :core-nodes)
            (if (sh12-c6p-nested? core) (sh12-c6p-index core 5) (sh12-c6p-index core 3))) :type))

(defn sh12-c6p-function-type-for-return [result-type]
  {:params [:gravity/bool] :return result-type :latent-effects #{} :capabilities #{}
   :throws #{} :ownership-constraints #{:persistent-immutable-shareable}
   :profile-constraints #{:hosted}})

(defn sh12-c6p-function-type []
  (sh12-c6p-function-type-for-return :gravity/bool))

(defn sh12-c6p-position? [position]
  (if (sh12-c6p-keys? position #{:byte :char :column :column-unit :line})
    (if (sh12-c6p-all? [(integer? (get position :byte)) (integer? (get position :char))
                       (integer? (get position :column)) (integer? (get position :line))])
      (sh12-c6p-all? [(<= 0 (get position :byte)) (<= 0 (get position :char))
                     (<= 1 (get position :column)) (<= 1 (get position :line))
                     (= :unicode-scalar (get position :column-unit))]) false) false))

(defn sh12-c6p-span? [span]
  (if (sh12-c6p-keys? span #{:file :byte-start :byte-end :start :end})
    (let [start (get span :start) end (get span :end)]
      (if (if (sh12-c6p-position? start) (sh12-c6p-position? end) false)
        (sh12-c6p-all?
          [(sh12-branch-join-nonempty-string? (get span :file))
           (= (get span :byte-start) (get start :byte)) (= (get span :byte-end) (get end :byte))
           (<= (get start :byte) (get end :byte)) (<= (get start :char) (get end :char))
           (<= (get start :line) (get end :line))
           (if (= (get start :line) (get end :line))
             (<= (get start :column) (get end :column)) true)]) false)) false))

(defn sh12-c6p-source-valid? [core node index]
  (let [source (get node :source) origin (get source :origin-id)
        row (get (get core :source-origin-table) origin)
        raw (get (get core :origin-closure) origin) span (get source :span)
        role (sh12-c6p-role core index)
        input (get (get (get core :core-nodes)
                     (if (if (sh12-c6p-nested? core)
                           (= index (+ 1 (sh12-c6p-inner-condition-index core))) false)
                       (sh12-c6p-inner-index core) (sh12-c6p-index core 5))) :source)
        generated (if (= role 2)
                    [{:kind :compiler-generated :producer :gravity/c6-c10-checked-core-pipeline
                      :role :truthiness-normalization :input-origin-id (get input :origin-id)}] [])]
    (if (sh12-c6p-keys? row #{:domain :source-content-hash :plan-path :c2-form-id :c2-form-kind
                            :c2-span :c2-surface-span :c2-abbrev :c2-tag :c2-metadata
                            :c2-generated-origin :c3-syntax-id :generated-role :input-origin-id :origin-id})
    (sh12-c6p-all?
      [(sh12-c6p-span? span)
       (= raw {:origin-id origin :c2-form-id (get row :c2-form-id)
               :c2-form-kind (get row :c2-form-kind) :c2-span (get row :c2-span)
               :c2-surface-span (get row :c2-surface-span) :c2-abbrev (get row :c2-abbrev)
               :c2-tag (get row :c2-tag) :c2-metadata (get row :c2-metadata)
               :c2-generated-origin (get row :c2-generated-origin)
               :c3-syntax-id (get row :c3-syntax-id) :generated-role (get row :generated-role)
               :input-origin-id (get row :input-origin-id)})
       (= source {:origin-id origin :span span :enclosing-syntax-origin-id (get row :c3-syntax-id)
                  :generated? (= role 2) :generated-origin generated})
       (sh12-c10-mir-sha256-id? origin)
       (sh12-c10-mir-sha256-id? (get row :c3-syntax-id))
       (= (get row :c3-syntax-id)
          (get (get (first (get core :core-nodes)) :source) :enclosing-syntax-origin-id))
       (= (get row :domain) :gravity/c6-c10-source-origin-v1)
       (= (get row :source-content-hash) (get core :source-content-hash))
       (= (get row :plan-path) (get node :path)) (= (get row :origin-id) origin)
       (= (get row :c2-span) span)
       ; Original C2 reader form IDs are opaque Keyword identities, unlike
       ; the separately checked SHA256 projection/binding/origin IDs.
       (keyword? (get row :c2-form-id))
       (= (get row :c2-form-kind)
          (get [:symbol :symbol :list
                (if (sh12-c6p-predicate-bool-node? core index) :boolean
                  (if (= :gravity/integer (sh12-c6p-result-type core)) :integer :boolean))
                (if (sh12-c6p-predicate-bool-node? core index) :boolean
                  (if (= :gravity/integer (sh12-c6p-result-type core)) :integer :boolean))
                :list :list :symbol :list :boolean] role))
       (= (get row :generated-role) (if (= role 2) :truthiness-normalization nil))
       (= (get row :input-origin-id) (if (= role 2) (get input :origin-id) nil))
       (= (get row :c2-abbrev) nil) (= (get row :c2-tag) nil)
       (= {} (get row :c2-metadata))
       ; Original C2 seed rows omit this field; C6 retains nil in the raw
       ; origin row and normalizes it to [] in node.source above.
       (if (= nil (get row :c2-generated-origin)) true
         (= [] (get row :c2-generated-origin)))]) false)))

(defn sh12-c6p-own [node index]
  (let [operands (get node :operands)
        base {:model :persistent-immutable-value
              :role (get [:function-parameter :local-reference :truthiness-value :literal-value
                          :literal-value :conditional-result :function-result
                          :lexical-binding :lexical-scope-result :literal-value] index)
              :shareability :shared :alias-policy :immutable-sharing :mutation :forbidden
              :managed-reachability :value-and-program-reachability :cleanup-policy :no-explicit-cleanup
              :provider-requirement :not-required :allocator-requirement :not-required
              :escape-policy :safe-persistent-value :derived? true}]
    (if (= index 0) (assoc base :storage :persistent-parameter-value)
      (if (= index 7) (assoc (assoc base :storage :forwarded-persistent-value)
                            :value-node-id (first operands))
      (if (= index 8) (assoc (assoc base :storage :forwarded-persistent-value)
                            :result-node-id (c11-last-value operands))
      (if (= index 1) (assoc (assoc base :storage :shared-persistent-reference)
                            :binding-node-id (first operands))
        (if (if (< index 5) true (= index 9)) (assoc base :storage :static-value)
          (if (= index 5) (assoc (assoc base :storage :forwarded-persistent-value)
                                :incoming-node-ids (vec (rest operands)))
            (assoc (assoc (assoc base :storage :forwarded-persistent-value)
                          :result-node-id (first operands))
                   :result-disposition :shared-persistent-value-return)))))))))

(defn sh12-c6p-node-problem [core node index]
  (let [role (sh12-c6p-role core index)
        id (get node :node-id) type (get node :type) operands (get node :operands)
        operation (get node :source-operation) origin (get (get node :source) :origin-id)
        attrs (get node :attributes) tf (get (get core :type-facts) id)
        ef (get (get core :effect-facts) id) of (get (get core :ownership-facts) id)
        cap (get (get core :capability-facts) id) sf (get (get core :safety-facts) id)
        proof (get (get node :safety) :proof) proof-id (get proof :proof-id)
        own (sh12-c6p-own node role)
        owner (get (get (get core :ownership-facts) (first (get core :root-node-ids))) :owner-id)
        rule (get [:resolved-bool-parameter-declaration :resolved-binding-type :truthiness-bool
                   :literal-type :literal-type :branch-type-join :closed-function-type
                   :initializer-type :lexical-scope-result-type :literal-type] role)
        basis (get [:resolved-bool-parameter-binding :resolved-lexical-local :gravity-truthiness
                    :closed-scalar-literal :closed-scalar-literal :closed-conditional
                    :authenticated-closed-function :sequential-let-binding :sequential-lexical-scope :closed-scalar-literal] role)
        type-base {:core-node-id id :type-id (get tf :type-id) :type type :producer-rule rule
                   :dependencies operands :source-origin-id origin :profile :hosted :source-target :jvm
                   :constraints [] :derived? true :fact-id (get tf :fact-id)}
        type-expected (if (= role 0) (assoc type-base :declaration attrs)
                        (if (= role 6)
                          (assoc (assoc (assoc (assoc (assoc (assoc (assoc type-base
                            :params [:gravity/bool]) :return (sh12-c6p-result-type core)) :latent-effects #{})
                            :capabilities #{}) :throws #{})
                            :ownership-constraints #{:persistent-immutable-shareable})
                            :profile-constraints #{:hosted}) type-base))
        effect-base {:core-node-id id :type-fact-id (get tf :fact-id) :direct #{} :latent #{}
                     :transitive #{} :residual #{} :ordering :none :source-origin-id origin
                     :profile :hosted :source-target :jvm :derived? true :fact-id (get ef :fact-id)}
        effect-expected (if (= role 6) (assoc effect-base :function-summary
                           {:declared #{} :inferred #{} :latent #{} :throws #{}}) effect-base)
        values (if (= role 9) [] (if (= role 8) [(c11-last-value operands)]
                 (if (= role 7) operands
                   (if (= role 0) [] (if (< role 3) operands
                     (if (< role 5) [] (if (= role 5) (vec (rest operands)) operands)))))))
        own-fact {:core-node-id id :value-id id :owner-id owner :source-value-ids values
                  :forwarding (get [:not-applicable :from-lexical-binding :derived-from-test
                                    :not-applicable :not-applicable :from-conditional-incoming-values
                                    :from-entrypoint-result :from-initializer :from-lexical-scope-result :not-applicable] role)
                  :model :persistent-immutable-value :role (get own :role) :storage (get own :storage)
                  :shareability :shared :alias-policy :immutable-sharing :mutation :forbidden
                  :managed-reachability :value-and-program-reachability :cleanup-policy :no-explicit-cleanup
                  :provider-requirement :not-required :allocator-requirement :not-required
                  :escape-policy :safe-persistent-value
                  :result-disposition (if (= role 6) :shared-persistent-value-return :not-applicable)
                  :source-origin-id origin :profile :hosted :source-target :jvm
                  :borrow :not-applicable :move :not-applicable :consume :not-applicable
                  :region :not-applicable :arena :not-applicable :linear-resource :not-applicable
                  :transfer :not-applicable :runtime-check :not-applicable :unsafe-audit :not-applicable
                  :derived? true :fact-id (get of :fact-id)}
        proof-expected {:domain :gravity/c10-pure-safety-proof-v1 :artifact :gravity/c6-c10-pure-safety-proof
                        :rule-version "c6-c10-pure-safety-v1" :source-content-hash (get core :source-content-hash)
                        :plan-path (get node :path) :core-node-id id :source-operation operation
                        :operand-node-ids operands :basis basis
                        :source-origin {:origin-id origin :span (get (get node :source) :span)
                                        :plan-path (get node :path)}
                        :profile :hosted :source-target :jvm :type type :effects #{} :capabilities #{}
                        :ownership-model :persistent-immutable-value :ownership-digest (get proof :ownership-digest)
                        :specialized-safe-rule :persistent-immutable-pure-bounded-operation
                        :effect-requirements #{} :capability-requirements #{}
                        :invalidation-conditions [:source-origin-change :operand-change :source-operation-change
                          :type-change :effect-change :capability-change :ownership-change :profile-change
                          :source-target-change :rule-version-change]
                        :status :proved-for-bounded-pure-slice :proof-id proof-id}]
    (if (sh12-c6p-source-valid? core node index)
      (if (sh12-c6p-all? [(= tf type-expected) (sh12-c10-mir-sha256-id? (get tf :fact-id))
                         (sh12-c10-mir-sha256-id? (get tf :type-id)) (vector? (get tf :dependencies))])
        (if (sh12-c6p-all? [(= ef effect-expected) (sh12-c10-mir-sha256-id? (get ef :fact-id))
                           (= (get node :effects) #{}) (= (get node :capabilities) #{})
                           (= (get attrs :intrinsic-effects) #{}) (= (get attrs :intrinsic-capabilities) #{})
                           (= (get attrs :aggregate-effects) #{}) (= (get attrs :aggregate-capabilities) #{})])
          (if (sh12-c6p-all? [(= (get node :ownership) own) (= of own-fact)
                             (sh12-c10-mir-sha256-id? (get of :fact-id)) (sh12-c10-mir-sha256-id? owner)])
            (if (= cap {:core-node-id id :required #{} :granted #{} :provider-bindings {} :grant-ids []
                        :authority-id nil :authority-source :none-required
                        :capability-proof {:status :not-required :basis :empty-capability-requirements :proof-ids []}
                        :source-origin-id origin :profile :hosted :source-target :jvm :derived? true})
              (if (sh12-c6p-all?
                    [(= proof proof-expected) (sh12-c10-mir-sha256-id? proof-id)
                     (sh12-c10-mir-sha256-id? (get proof :ownership-digest))
                     (= (get node :safety) {:outcome :proven-safe :basis basis :proof proof})
                     (= (get (get core :proof-records) id) proof)
                     (= sf {:artifact :gravity/safety-outcome :operation id :kind operation
                            :source {:core-node id :span (get (get node :source) :span) :origin-chain [origin]}
                            :profile :hosted :target :jvm
                            :facts {:type (get tf :fact-id) :effects (get ef :fact-id) :ownership (get of :fact-id)}
                            :outcome :proven-safe :condition :always :proof proof-id
                            :runtime-check :not-applicable :unsafe-audit :not-applicable :failure-behavior :not-applicable})])
                (if (= (get (get core :profile-facts) id)
                       {:profile :hosted :operation operation :legal? true
                        :scope :gravity-owned-bounded-pure-hosted-jvm-slice}) nil
                  (sh12-branch-join-problem "C11-VERIFY" :c6-parameter-profile-fact))
                (sh12-branch-join-problem "C11-SAFETY" :c6-parameter-safety-proof))
              (sh12-branch-join-problem "C11-VERIFY" :c6-parameter-capability-fact))
            (sh12-branch-join-problem "C11-VERIFY" :c6-parameter-ownership-fact))
          (sh12-branch-join-problem "C11-EFFECT" :c6-parameter-effect-fact))
        (sh12-branch-join-problem "C11-TYPE" :c6-parameter-type-fact))
      (sh12-branch-join-problem "C11-ORIGIN" :c6-parameter-source-origin))))

(defn sh12-c6p-nodes-problem [core nodes index]
  (if (= index (count nodes)) nil
    (let [problem (sh12-c6p-node-problem core (get nodes index) index)]
      (if (= problem nil) (sh12-c6p-nodes-problem core nodes (+ index 1))
        (if (sh12-c6p-source-valid? core (get nodes index) index)
          (assoc problem :node (get nodes index)) problem)))))

(defn sh12-c6p-role-view [core]
  ; No Core copy or type alias: this is an invocation-local index into the
  ; original, independently checked producer rows, not a serialized artifact.
  (let [nodes (get core :core-nodes)]
    (if (vector? nodes)
      (if (contains? #{7 10 11 12 14} (count nodes))
        (loop [index 0 ids [] origins []]
          (if (= index (count nodes)) {:ids ids :origins origins}
            (let [node (get nodes index) id (get node :node-id) source (get node :source)]
              (if (sh12-c6p-all? [(map? node) (map? (get node :attributes)) (map? source)
                                 (vector? (get node :path)) (vector? (get node :operands))
                                 (sh12-c10-mir-sha256-id? id)
                                 (sh12-c10-mir-sha256-id? (get source :origin-id))])
                (recur (+ index 1) (conj ids id) (conj origins (get source :origin-id))) nil)))) nil) nil)))

(defn sh12-c6p-indexed-roles [core rows]
  ; An index into ORIGINAL rows, not a replacement seven-node Core artifact.
  (if (sh12-c6p-let-layout? core)
    (loop [role 0 result []]
      (if (= role 7) result
        (recur (+ role 1) (conj result (get rows (sh12-c6p-index core role)))))) rows))

(defn sh12-c6p-let-binder-index [core index]
  (if (sh12-c6p-conditional-initializer? core) 6 (+ 2 (* 2 index))))

(defn sh12-c6p-let-binding-record [core index]
  (let [node (get (get core :core-nodes) (sh12-c6p-let-binder-index core index)) attrs (get node :attributes)]
    {:binding-node-id (get node :node-id) :name (get attrs :name) :path (get node :path)
     :value-node-id (first (get node :operands)) :shadowed-binding nil
     :source-form-id (get attrs :source-form-id)}))

(defn sh12-c6p-let-binding-valid? [core index]
    (let [nodes (get core :core-nodes) parameter (get nodes 0)
          initializer (get nodes (+ 1 (* 2 index))) binder (get nodes (+ 2 (* 2 index)))
          previous (get nodes (* 2 index)) attrs (get binder :attributes)
          name (get attrs :name) path [:functions 'main :body 0]
          binding-path (conj (conj path :bindings) index)
          purity {:intrinsic-effects #{} :intrinsic-capabilities #{}
                  :aggregate-effects #{} :aggregate-capabilities #{}}]
      (sh12-c6p-all?
        [(symbol? name) (if (= name (get (get parameter :attributes) :name)) false true)
         (if (= name (get (get previous :attributes) :name)) false true)
         (= [:local :let-binding] [(get initializer :source-operation) (get binder :source-operation)])
         (= (get initializer :path) (conj binding-path :expr))
         (= (get binder :path) (conj binding-path :binder))
         (= (get initializer :operands) [(get previous :node-id)])
         (= (get binder :operands) [(get initializer :node-id)])
         (= (get initializer :attributes)
            (assoc (assoc purity :name (get (get previous :attributes) :name))
                   :resolved-binding (get previous :node-id)))
         (keyword? (get attrs :source-form-id))
         (= (get attrs :source-form-id)
            (get (get (get core :source-origin-table) (get (get binder :source) :origin-id)) :c2-form-id))
         (= attrs (assoc (assoc (assoc purity :name name) :shadowed-binding nil)
                         :source-form-id (get attrs :source-form-id)))])))

(defn sh12-c6p-conditional-binding-valid? [core]
  (let [nodes (get core :core-nodes) binder (get nodes 6) local (get nodes 7)
        attrs (get binder :attributes) name (get attrs :name) parameter (get nodes 0)
        path [:functions 'main :body 0] binding-path (conj (conj path :bindings) 0)
        purity {:intrinsic-effects #{} :intrinsic-capabilities #{} :aggregate-effects #{} :aggregate-capabilities #{}}]
    (sh12-c6p-all?
      [(symbol? name) (if (= name (get (get parameter :attributes) :name)) false true)
       (= (get binder :path) (conj binding-path :binder))
       (= (get binder :source-operation) :let-binding)
       (= (get binder :operands) [(get (get nodes 5) :node-id)])
       (= (get (get nodes 5) :path) (conj binding-path :expr))
       (keyword? (get attrs :source-form-id))
       (= (get attrs :source-form-id)
          (get (get (get core :source-origin-table) (get (get binder :source) :origin-id)) :c2-form-id))
       (= attrs (assoc (assoc (assoc purity :name name) :shadowed-binding nil) :source-form-id (get attrs :source-form-id)))
       (= (get local :source-operation) :local)
       (= (get local :path) [:functions 'main :body 0 :body 0 :test])
       (= (get local :operands) [(get binder :node-id)])
       (= (get local :attributes) (assoc (assoc purity :name name) :resolved-binding (get binder :node-id)))])))

(defn sh12-c6p-let-structure-valid? [core]
  (if (sh12-c6p-let-layout? core)
    (let [nodes (get core :core-nodes) count-bindings (sh12-c6p-let-count core)
          if-index (sh12-c6p-index core 5) scope (get nodes (sh12-c6p-scope-index core))
          later? (sh12-c6p-later-body-local? core) local (get nodes 8) binding (get nodes 2)
          purity {:intrinsic-effects #{} :intrinsic-capabilities #{} :aggregate-effects #{} :aggregate-capabilities #{}}
          operands (if later? [(get binding :node-id) (get (get nodes 7) :node-id) (get local :node-id)]
                    (if (= count-bindings 2)
                     [(get (get nodes 2) :node-id) (get (get nodes 4) :node-id) (get (get nodes if-index) :node-id)]
                     [(get (get nodes (sh12-c6p-let-binder-index core 0)) :node-id) (get (get nodes if-index) :node-id)]))]
      (if (sh12-c6p-all?
            [(contains? #{:gravity/bool :gravity/integer} (sh12-c6p-result-type core))
             (= (get scope :source-operation) :let) (= (get scope :path) [:functions 'main :body 0])
             (= (get scope :operands) operands)
             (if later?
               (sh12-c6p-all? [(= :gravity/bool (sh12-c6p-result-type core))
                  (= :local (get local :source-operation)) (= (get local :path) [:functions 'main :body 0 :body 1])
                  (= (get local :operands) [(get binding :node-id)])
                  (= (get local :attributes)
                     (assoc (assoc purity :name (get (get binding :attributes) :name)) :resolved-binding (get binding :node-id)))]) true)
             (= (get scope :attributes) {:intrinsic-effects #{} :intrinsic-capabilities #{}
                  :aggregate-effects #{} :aggregate-capabilities #{} :binding-count count-bindings})])
        (if (sh12-c6p-conditional-initializer? core) (sh12-c6p-conditional-binding-valid? core)
        (loop [index 0]
          (if (= index count-bindings) true
            (if (sh12-c6p-let-binding-valid? core index) (recur (+ index 1)) false)))) false)) true))

(defn sh12-c6p-nested-shape-valid? [core view]
  (let [original (get core :core-nodes) let? (sh12-c6p-nested-let? core)
        nodes (sh12-c6p-nested-rows core original) ids (sh12-c6p-nested-rows core (get view :ids))
        origins (get view :origins)
        binder (get nodes 0) attrs (get binder :attributes) name (get attrs :name)
        root (get nodes 10) outer (get nodes 9)
        predicate? (sh12-c6p-predicate? core)
        local-side (sh12-c6p-predicate-local-side core)
        inner-index (if predicate? 5 (if (= :then (sh12-c6p-nested-side core)) 7 8)) inner (get nodes inner-index)
        condition-index (- inner-index 4)
        path (if let? [:functions 'main :body 0 :body 0] [:functions 'main :body 0])
        initializer? (sh12-c6p-conditional-initializer? core)
        inner-path (if initializer? [:functions 'main :body 0 :bindings 0 :expr]
                     (conj path (if predicate? :test (sh12-c6p-nested-side core))))
        local-binding (if (if let? (if predicate? false true) false) (get (get original 2) :node-id) (get ids 0))
        local-name (if (if let? (if predicate? false true) false) (get (get (get original 2) :attributes) :name) name)
        returned (if let? (get (get original 12) :node-id) (get ids 9))
        declaration (get core :resolved-parameter) rows (get declaration :coordinates)
        binding (get declaration :parameter-binding) type-binding (get declaration :type-binding)
        reference (get declaration :type-resolution)
        purity {:intrinsic-effects #{} :intrinsic-capabilities #{}
                :aggregate-effects #{} :aggregate-capabilities #{}}
        expected-paths (if predicate?
          [[:functions 'main :parameters 0 :binder] (conj inner-path :test) (conj inner-path :truthy)
           (conj inner-path :then) (conj inner-path :else) inner-path
           (conj path :truthy) (conj path :then) (conj path :else) path [:functions 'main]]
          (if (= :then (sh12-c6p-nested-side core))
          [[:functions 'main :parameters 0 :binder] (conj path :test) (conj path :truthy)
           (conj inner-path :test) (conj inner-path :truthy) (conj inner-path :then) (conj inner-path :else)
           inner-path (conj path :else) path [:functions 'main]]
          [[:functions 'main :parameters 0 :binder] (conj path :test) (conj path :truthy) (conj path :then)
           (conj inner-path :test) (conj inner-path :truthy) (conj inner-path :then) (conj inner-path :else)
           inner-path path [:functions 'main]]))
        expected-operands (if predicate?
          [[] [(get ids 0)] [(get ids 1)]
           (if (= :then local-side) [(get (get original 2) :node-id)] [])
           (if (= :else local-side) [(get (get original 2) :node-id)] [])
           [(get ids 2) (get ids 3) (get ids 4)]
           [(if initializer? (get (get original 7) :node-id) (get ids 5))]
           [] [] [(get ids 6) (get ids 7) (get ids 8)] [returned]]
          (if (= :then (sh12-c6p-nested-side core))
          [[] [local-binding] [(get ids 1)] [] [(get ids 3)] [] []
           [(get ids 4) (get ids 5) (get ids 6)] [] [(get ids 2) (get ids 7) (get ids 8)] [returned]]
          [[] [local-binding] [(get ids 1)] [] [] [(get ids 4)] [] []
           [(get ids 5) (get ids 6) (get ids 7)] [(get ids 2) (get ids 3) (get ids 8)] [returned]]))]
    (sh12-c6p-all?
      [(= (count original) (count (set (get view :ids)))) (= (count original) (count (set origins)))
       (sh12-c6p-let-structure-valid? core)
       (= (get core :root-node-ids) [(get ids 10)]) (= :gravity/integer (get outer :type))
       (loop [index 0]
         (if (= index 11) true
           (let [node (get nodes index)]
             (if (sh12-c6p-all?
                   [(= (get node :path) (get expected-paths index))
                    (= (get node :operands) (get expected-operands index))
                    (= (get node :source-operation)
                       (get [:parameter :local :truthy :literal :literal :if :function :let-binding :let :literal]
                            (sh12-c6p-role core (sh12-c6p-nested-index core index))))])
               (recur (+ index 1)) false))))
       (symbol? name)
       (= attrs (assoc (assoc (assoc (assoc (assoc purity :name name) :parameter-index 0)
          :source-form-id (get (get rows 1) :c2-form-id)) :resolved-binding-id (get binding :binding-id))
          :type-binding-id (get type-binding :binding-id)))
       (= (get (get nodes 1) :attributes) (assoc (assoc purity :name local-name) :resolved-binding local-binding))
       (if (contains? #{:then :else} local-side)
         (= (get (get nodes (if (= :then local-side) 3 4)) :attributes)
            (assoc (assoc purity :name (get (get (get original 2) :attributes) :name))
                   :resolved-binding (get (get original 2) :node-id))) true)
       (= (get (get (get core :core-nodes) (sh12-c6p-index core 2)) :attributes)
          (assoc (assoc purity :false-values [nil false]) :result-type :gravity/bool))
       (= (get (get nodes (+ condition-index 1)) :attributes)
          (assoc (assoc purity :false-values [nil false]) :result-type :gravity/bool))
       (= (get inner :attributes) (assoc purity :truthiness :nil-and-false-only))
       (= (get outer :attributes) (assoc purity :truthiness :nil-and-false-only))
       (= (get root :attributes) (assoc (assoc (assoc (assoc (assoc (assoc purity
          :name 'main) :params [name]) :arity 1) :body-count 1) :visibility :public) :entrypoint? true))
       (= (get root :type) (sh12-c6p-function-type-for-return :gravity/integer))
       (= (get core :lexical-binding-records)
          (let [records [{:name name :parameter-index 0 :source-form-id (get attrs :source-form-id)
            :resolved-binding-id (get binding :binding-id) :type-binding-id (get type-binding :binding-id)
            :binding-node-id (get ids 0) :path (get binder :path)}]]
            (if let? (conj records (sh12-c6p-let-binding-record core 0)) records)))
       (= (get declaration :kind) :gravity/c6-c10-resolved-bool-parameter-v1)
       (= (get declaration :source-content-hash) (get core :source-content-hash))
       (= (get declaration :parameter-index) 0) (= (get binding :name) name)
       (= (get binding :scope-id) (get declaration :function-scope-id))
       (= [(get binding :binding-class) (get binding :kind) (get binding :namespace)
           (get binding :profile-set) (get binding :target-set)]
          [:lexical :local (get (get core :source-core-input) :module) [:hosted] [:jvm]])
       (= [(get type-binding :binding-class) (get type-binding :kind) (get type-binding :namespace)
           (get type-binding :name) (get type-binding :type-ref) (get type-binding :package)]
          [:core :type 'gravity.core 'Bool :gravity.type/type {:name 'gravity/core :version "bootstrap-contract-v1"}])
       (= (get reference :binding-id) (get type-binding :binding-id))
       (= (get reference :upstream-binding-id) (get type-binding :upstream-binding-id))
       (= (get reference :position) :type)
       (= (get reference :reference-syntax-id) (get (get rows 3) :projected-syntax-id))
       (= (get binding :definition-syntax-id) (get (get rows 1) :projected-syntax-id))
       (= (get attrs :source-form-id)
          (get (get (get core :source-origin-table) (get origins 0)) :c2-form-id))])))

(defn sh12-c6p-shape-valid? [core view]
 (if (sh12-c6p-nested? core) (sh12-c6p-nested-shape-valid? core view)
  (let [original (get core :core-nodes) let? (sh12-c6p-let-layout? core)
        arm-local? (sh12-c6p-arm-local? core) arm-side (sh12-c6p-arm-local-side core)
        nodes (sh12-c6p-indexed-roles core original)
        ids (sh12-c6p-indexed-roles core (get view :ids)) origins (get view :origins)
        binder (get nodes 0) local (get nodes 1) truthy (get nodes 2) root (get nodes 6)
        attrs (get binder :attributes) name (get attrs :name) declaration (get core :resolved-parameter)
        binding (get declaration :parameter-binding) type-binding (get declaration :type-binding)
        reference (get declaration :type-resolution) rows (get declaration :coordinates)
        last-binder (get original (* 2 (sh12-c6p-let-count core)))
        local-name (if (if let? (if arm-local? false (if (sh12-c6p-later-body-local? core) false true)) false) (get (get last-binder :attributes) :name) name)
        local-binding (if (if let? (if arm-local? false (if (sh12-c6p-later-body-local? core) false true)) false) (get last-binder :node-id) (get ids 0))
        path (if let? [:functions 'main :body 0 :body 0] [:functions 'main :body 0])
        purity {:intrinsic-effects #{} :intrinsic-capabilities #{}
                                              :aggregate-effects #{} :aggregate-capabilities #{}}]
    (sh12-c6p-all?
      [(contains? #{:gravity/bool :gravity/integer} (sh12-c6p-result-type core))
       (if arm-local? (= :gravity/bool (sh12-c6p-result-type core)) true)
       (sh12-c6p-let-structure-valid? core)
       (= (count original) (count (set (get view :ids)))) (= (count original) (count (set origins)))
       (= (get core :root-node-ids) [(get ids 6)])
       (= [(get (get nodes 0) :source-operation) (get local :source-operation) (get truthy :source-operation)
           (get (get nodes 3) :source-operation) (get (get nodes 4) :source-operation)
           (get (get nodes 5) :source-operation) (get root :source-operation)]
          [:parameter :local :truthy (if (= arm-side :then) :local :literal)
           (if (= arm-side :else) :local :literal) :if :function])
       (= (get binder :path) [:functions 'main :parameters 0 :binder])
       (= (get local :path) (conj path :test)) (= (get truthy :path) (conj path :truthy))
       (= (get (get nodes 3) :path) (conj path :then)) (= (get (get nodes 4) :path) (conj path :else))
       (= (get (get nodes 5) :path) path) (= (get root :path) [:functions 'main])
       (= [(get binder :operands) (get local :operands) (get truthy :operands)
           (get (get nodes 3) :operands) (get (get nodes 4) :operands)
           (get (get nodes 5) :operands) (get root :operands)]
          [[] [local-binding] [(get ids 1)]
           (if (= arm-side :then) [(get last-binder :node-id)] [])
           (if (= arm-side :else) [(get last-binder :node-id)] [])
           [(get ids 2) (get ids 3) (get ids 4)]
           [(if let? (get (get original (sh12-c6p-scope-index core)) :node-id) (get ids 5))]])
       (symbol? name) (= (get attrs :parameter-index) 0)
       (= attrs
          (assoc (assoc (assoc (assoc (assoc purity :name name) :parameter-index 0)
            :source-form-id (get (get rows 1) :c2-form-id))
            :resolved-binding-id (get binding :binding-id)) :type-binding-id (get type-binding :binding-id)))
       (= (get local :attributes) (assoc (assoc purity :name local-name) :resolved-binding local-binding))
       (if arm-local?
         (= (get (get nodes (if (= arm-side :then) 3 4)) :attributes)
            (assoc (assoc purity :name (get (get last-binder :attributes) :name))
                   :resolved-binding (get last-binder :node-id))) true)
       (= (get truthy :attributes) (assoc (assoc purity :false-values [nil false]) :result-type :gravity/bool))
       (= (get (get nodes 5) :attributes) (assoc purity :truthiness :nil-and-false-only))
       (= (get root :attributes) (assoc (assoc (assoc (assoc (assoc (assoc purity
          :name 'main) :params [name]) :arity 1) :body-count 1) :visibility :public) :entrypoint? true))
       (= (get root :type) (sh12-c6p-function-type-for-return (sh12-c6p-result-type core)))
       (= (get core :lexical-binding-records)
          (let [records [{:name name :parameter-index 0 :source-form-id (get attrs :source-form-id)
            :resolved-binding-id (get binding :binding-id) :type-binding-id (get type-binding :binding-id)
            :binding-node-id (get ids 0) :path (get binder :path)}]]
            (loop [index 0 result records]
              (if (= index (sh12-c6p-let-count core)) result
                (recur (+ index 1) (conj result (sh12-c6p-let-binding-record core index)))))))
       (= (get declaration :kind) :gravity/c6-c10-resolved-bool-parameter-v1)
       (= (get declaration :source-content-hash) (get core :source-content-hash))
       (= (get declaration :parameter-index) 0) (= (get binding :name) name)
       (= (get binding :scope-id) (get declaration :function-scope-id))
       (= [(get binding :binding-class) (get binding :kind) (get binding :namespace)
           (get binding :profile-set) (get binding :target-set)]
          [:lexical :local (get (get core :source-core-input) :module) [:hosted] [:jvm]])
       (= [(get type-binding :binding-class) (get type-binding :kind) (get type-binding :namespace)
           (get type-binding :name) (get type-binding :type-ref) (get type-binding :package)]
          [:core :type 'gravity.core 'Bool :gravity.type/type {:name 'gravity/core :version "bootstrap-contract-v1"}])
       (= (get reference :binding-id) (get type-binding :binding-id))
       (= (get reference :upstream-binding-id) (get type-binding :upstream-binding-id))
       (= (get reference :position) :type)
       (= (get reference :reference-syntax-id) (get (get rows 3) :projected-syntax-id))
       (= (get binding :definition-syntax-id) (get (get rows 1) :projected-syntax-id))
       (= (get attrs :source-form-id)
          (get (get (get core :source-origin-table) (get origins 0)) :c2-form-id))]))))

(defn sh12-c6p-lineage-valid? [core]
  (let [source (get core :source-core-input) module (get source :module) hash (get core :source-content-hash)
        authenticated (get core :authenticated-input) semantic (get core :semantic-provenance)
        physical (get core :physical-provenance) request (get core :target-request-metadata)]
    (sh12-c6p-all?
      [(= (get core :schema-version) 1) (= (get core :status) :complete-for-bounded-pure-hosted-safe-jvm-slice)
       (= (get core :profile) :hosted) (= (get core :source-target) :jvm) (= (get core :entrypoint) 'main)
       (symbol? module) (sh12-c10-mir-sha256-id? hash)
       (sh12-c10-mir-sha256-id? (get core :artifact-id))
       (sh12-c10-mir-sha256-id? (get core :mapping-id))
       (sh12-c10-mir-sha256-id? (get core :provenance-binding-id))
       (sh12-c10-mir-sha256-id? (get source :plan-id))
       (= source {:module module :plan-id (get source :plan-id) :entrypoint 'main
                  :operation-set (if (sh12-c6p-let-layout? core)
                                   #{:parameter :local :let-binding :truthy :literal :if :let :function}
                                   #{:parameter :local :truthy :literal :if :function})
                  :declared-effects #{} :declared-capabilities #{}})
       (= request {:requested-target :jvm :source-target :jvm
                   :identity-bearing? false :downstream-lowering-required? true})
       (= (get authenticated :kind) :gravity/c6-c10-authenticated-input)
       (= (get authenticated :plan-id) (get source :plan-id))
       (= (get authenticated :source-content-hash) hash)
       (= (get semantic :source-content-hash) hash) (= (get physical :source-content-hash) hash)
       (= (get authenticated :binding-pins) (get semantic :binding-pins))
       (= (get authenticated :binding-pins) (get physical :binding-pins))
       (sh12-c10-mir-sha256-id? (get physical :c2-source-unit-id))
       (sh12-c10-mir-sha256-id? (get physical :c3-artifact-id))
       (sh12-c10-mir-sha256-id? (get physical :digest-graph-proof-id))
       (sh12-c10-mir-sha256-id? (get physical :request-binding-id))
       (sh12-c6p-keys? (get physical :actual-paths) #{:source :gravity-c6-c10-source})
       (sh12-branch-join-nonempty-string? (get (get physical :actual-paths) :source))
       (sh12-branch-join-nonempty-string? (get (get physical :actual-paths) :gravity-c6-c10-source))
       (= (get core :diagnostics) []) (= (get core :mir-derived?) false)
       (= (get core :self-hosted?) false) (= (get core :whole-language?) false)])))

(defn sh12-c6p-tables-valid? [core nodes ids origins index]
  (if (= index 0)
    (if (sh12-c6p-all?
          [(= (set (keys (get core :type-facts))) (set ids))
           (= (set (keys (get core :effect-facts))) (set ids))
           (= (set (keys (get core :ownership-facts))) (set ids))
           (= (set (keys (get core :capability-facts))) (set ids))
           (= (set (keys (get core :safety-facts))) (set ids))
           (= (set (keys (get core :profile-facts))) (set ids))
           (= (set (keys (get core :proof-records))) (set ids))
           (= (set (keys (get core :source-origin-table))) (set origins))
           (= (set (keys (get core :origin-closure))) (set origins))])
      (sh12-c6p-tables-valid? core nodes ids origins 1) false)
    (if (> index (count nodes)) true
      (let [node (get nodes (- index 1))]
        (if (sh12-c6p-all? [(map? (get (get core :type-facts) (get node :node-id)))
                           (map? (get (get core :effect-facts) (get node :node-id)))
                           (map? (get (get core :ownership-facts) (get node :node-id)))
                           (map? (get node :safety)) (map? (get (get node :safety) :proof))])
          (sh12-c6p-tables-valid? core nodes ids origins (+ index 1)) false)))))

(defn sh12-c6p-top-shape? [core]
  (if (sh12-c6p-keys? core
        #{:kind :schema-version :status :scope :source-content-hash :source-core-input
          :entrypoint :profile :source-target :core-nodes :root-node-ids :mapping-id
          :provenance-binding-id :instruction-origin-sidecar :dependency-order-graph
          :lexical-binding-records :source-origin-table :origin-closure :type-facts
          :effect-facts :capability-facts :ownership-facts :safety-facts :profile-facts
          :proof-records :typed-core :typed-core-key :effect-graph :effect-graph-key
          :capability-proof-records :pure-capability-closure :pure-capability-closure-key
          :ownership-analysis :ownership-analysis-key :pass-history :authenticated-input
          :bounds :semantic-provenance :diagnostics :mir-derived? :whole-language?
          :clojure-seed-boundary? :self-hosted? :resolved-parameter :artifact-id
          :target-request-metadata :physical-provenance})
    (loop [fields [:source-core-input :physical-provenance :semantic-provenance :authenticated-input
                   :type-facts :effect-facts :ownership-facts :capability-facts :safety-facts
                   :profile-facts :proof-records :source-origin-table :origin-closure :typed-core
                   :effect-graph :ownership-analysis :pure-capability-closure :resolved-parameter]]
      (if (= (count fields) 0)
        (sh12-c6p-all? [(vector? (get core :root-node-ids))
                       (vector? (get core :lexical-binding-records))
                       (= (get core :capability-proof-records) [])
                       (sh12-c6p-keys? (get core :physical-provenance)
                         #{:actual-paths :source-content-hash :c2-source-unit-id :c3-artifact-id
                           :binding-pins :digest-graph-proof-id :request-binding-id})])
        (if (map? (get core (first fields))) (recur (rest fields)) false))) false))

(defn sh12-c6p-role-nodes-valid? [core index]
  (if (= index (count (get core :core-nodes))) true
    (let [node (get (get core :core-nodes) index) attrs (get node :attributes)
          role (sh12-c6p-role core index)]
      (if (sh12-c6p-all?
            [(sh12-c6p-keys? node #{:node-id :path :kind :source-operation :plan-node? :plan-depth
                                  :operands :attributes :type :effects :capabilities :ownership
                                  :safety :profile :source})
             (= (get node :kind)
                (get [:binding :local :truthiness :literal :literal :conditional :function :binding :let :literal] role))
             (= (get node :type)
                (if (if (sh12-c6p-predicate-bool-node? core index) true
                      (if (< role 3) true (if (= role 7) true (= role 9)))) :gravity/bool
                  (if (= role 6)
                    (sh12-c6p-function-type-for-return (sh12-c6p-result-type core))
                    (sh12-c6p-result-type core))))
             (= (get node :profile) :hosted)
             (= (get node :plan-node?) (get (if (sh12-c6p-nested? core)
                (if (sh12-c6p-predicate? core)
                  (if (contains? #{:then :else} (sh12-c6p-predicate-local-side core))
                    [false true false true false true true true false true true true true false]
                  (if (sh12-c6p-conditional-initializer? core)
                    [false true false true true true false true false true true true true false]
                    [false true false true true true false true true true false]))
                (if (sh12-c6p-nested-let? core)
                  (if (= :then (sh12-c6p-nested-side core))
                    [false true false true false true false true true true true true true false]
                    [false true false true false true true false true true true true true false])
                  (if (= :then (sh12-c6p-nested-side core))
                    [false true false true false true true true true true false]
                    [false true false true true false true true true true false])))
                (if (sh12-c6p-later-body-local? core) [false true false true false true true true true true false]
                (if (= 2 (sh12-c6p-let-count core))
                [false true false true false true false true true true true false]
                (if (sh12-c6p-let-layout? core)
                  [false true false true false true true true true false] [false true false true true true false])))) index))
             (= (get node :plan-depth) (get (if (sh12-c6p-nested? core)
                (if (sh12-c6p-predicate? core)
                  (if (contains? #{:then :else} (sh12-c6p-predicate-local-side core))
                    [0 2 2 4 4 4 4 3 3 3 3 2 1 0]
                  (if (sh12-c6p-conditional-initializer? core)
                    [0 3 3 3 3 2 2 3 3 3 3 2 1 0] [0 3 3 3 3 2 2 2 2 1 0]))
                (if (sh12-c6p-nested-let? core)
                  (if (= :then (sh12-c6p-nested-side core))
                    [0 2 2 3 3 4 4 4 4 3 3 2 1 0] [0 2 2 3 3 3 4 4 4 4 3 2 1 0])
                  (if (= :then (sh12-c6p-nested-side core)) [0 2 2 3 3 3 3 2 2 1 0] [0 2 2 2 3 3 3 3 2 1 0])))
                (if (sh12-c6p-later-body-local? core) [0 2 2 3 3 3 3 2 2 1 0]
                (if (= 2 (sh12-c6p-let-count core))
                [0 2 2 2 2 3 3 3 3 2 1 0]
                (if (sh12-c6p-let-layout? core)
                  [0 2 2 3 3 3 3 2 1 0] [0 2 2 2 2 1 0])))) index))
             (if (contains? #{3 4 9} role)
               (if (if (if (sh12-c6p-predicate-bool-node? core index) false
                         (if (= role 9) false (= :gravity/integer (sh12-c6p-result-type core))))
                     (integer? (get attrs :value)) (boolean? (get attrs :value)))
                 (= attrs {:value (get attrs :value) :intrinsic-effects #{} :intrinsic-capabilities #{}
                           :aggregate-effects #{} :aggregate-capabilities #{}}) false) true)])
        (sh12-c6p-role-nodes-valid? core (+ index 1)) false))))

(defn sh12-c6p-declaration-valid? [core]
  (let [declaration (get core :resolved-parameter) rows (get declaration :coordinates)
        binding (get declaration :parameter-binding) type-binding (get declaration :type-binding)
        reference (get declaration :type-resolution)
        root-span (get (get (get (get core :core-nodes) (sh12-c6p-index core 6)) :source) :span)]
    (if (vector? rows)
    (if (sh12-c6p-all?
          [(sh12-c6p-keys? declaration #{:kind :source-content-hash :sh06-artifact-id
             :sh06-semantic-projection-id :projection-binding :root-syntax-id :function-syntax-id
             :function-scope-id :parameter-index :coordinates :parameter-binding :type-binding :type-resolution})
           (= (count rows) 4)
           (sh12-c6p-keys? reference #{:reference-syntax-id :symbol :position :binding-id
                                      :resolution-order :source-span :upstream-binding-id})
           (= (get reference :resolution-order) :profile-allowed-core-binding)
           ; The original SH-06 projection retains its whole expanded defn
           ; span, not a fabricated leaf span for the annotation token.
           (= (get reference :source-span)
              {:byte-start (get root-span :byte-start) :byte-end (get root-span :byte-end)
               :scalar-start (get (get root-span :start) :char) :scalar-end (get (get root-span :end) :char)
               :line-start (get (get root-span :start) :line) :line-end (get (get root-span :end) :line)
               :column-start (get (get root-span :start) :column) :column-end (get (get root-span :end) :column)})
           (contains? '#{Bool gravity.core/Bool} (get reference :symbol))
           (= (get binding :package) {:name (get (get core :source-core-input) :module) :version "workspace"})
           (= (get binding :type-ref) :gravity.type/local) (= (get binding :visibility) :lexical)
           (= (get binding :safety) :safe) (= (get binding :effects) []) (= (get binding :capabilities) [])
           (= (get binding :semantic-span) {:scope-ordinal 1 :binding-ordinal 0})
           (= (get type-binding :target-set) [:all]) (= (get type-binding :visibility) :public)
           (= (get type-binding :profile-set)
              [:ai :core :distributed :firmware :formal :gpu :hardware :hosted :kernel :meta :native])
           (= (get type-binding :scope-id) nil) (= (get type-binding :safety) :safe)
           (= (get type-binding :effects) []) (= (get type-binding :capabilities) [])
           (= (get type-binding :semantic-span) {:catalog :gravity/core :ordinal 12})])
      (if (loop [fields [:sh06-artifact-id :sh06-semantic-projection-id :projection-binding
                        :root-syntax-id :function-syntax-id :function-scope-id]]
            (if (= (count fields) 0) true
              (if (sh12-c10-mir-sha256-id? (get declaration (first fields)))
                (recur (rest fields)) false)))
        (if (loop [bindings [binding type-binding]]
              (if (= (count bindings) 0) true
                (let [row (first bindings)]
                  (if (sh12-c6p-keys? row #{:binding-id :upstream-binding-id :name :kind :namespace :package
                        :binding-class :visibility :profile-set :target-set :type-ref :effects :capabilities
                        :safety :semantic-span :scope-id :definition-syntax-id :definition-artifact-id})
                    (if (sh12-c6p-all? [(sh12-c10-mir-sha256-id? (get row :binding-id))
                                       (sh12-c10-mir-sha256-id? (get row :upstream-binding-id))
                                       (sh12-c10-mir-sha256-id? (get row :definition-syntax-id))
                                       (sh12-c10-mir-sha256-id? (get row :definition-artifact-id))])
                      (recur (rest bindings)) false) false))))
          (loop [index 0]
            (if (= index 4) true
              (let [row (get rows index)]
                (if (sh12-c6p-all?
                      [(sh12-c6p-keys? row #{:role :c2-form-id :projected-form-id :projected-syntax-id})
                       (= (get row :role) (get [:parameter-vector :parameter-name :annotation-marker :annotation-type] index))
                       (keyword? (get row :c2-form-id))
                       (sh12-c10-mir-sha256-id? (get row :projected-form-id))
                       (sh12-c10-mir-sha256-id? (get row :projected-syntax-id))])
                  (recur (+ index 1)) false)))) false) false) false) false)))

(defn sh12-c6p-graphs-valid? [core view]
  (let [nodes (get core :core-nodes) ids (get view :ids) origins (get view :origins)
        root (get ids (sh12-c6p-index core 6))
        result (get ids (if (sh12-c6p-let-layout? core) (sh12-c6p-scope-index core)
                          (sh12-c6p-index core 5))) binder (get ids 0)
        module (get (get core :source-core-input) :module) typed (get core :typed-core)
        maps (loop [index 0 effects {} owners {} types {} source-map {} proofs []]
               (if (= index (count nodes)) {:effects effects :owners owners :types types :source-map source-map :proofs proofs}
                 (let [node (get nodes index) id (get ids index)]
                   (recur (+ index 1)
                     (assoc effects id {:direct #{} :latent #{} :transitive #{} :ordering :none
                                        :source (get (get node :source) :span)})
                     (assoc owners id (get (get (get core :ownership-facts) id) :owner-id))
                     (assoc types id (get (get (get core :type-facts) id) :type-id))
                     (assoc source-map id (get origins index))
                     (conj proofs (get (get (get node :safety) :proof) :proof-id))))))
        locals {binder {:type (get (get maps :types) binder) :mutability :immutable :ownership :persistent-shared}}
        locals (loop [index 0 result locals]
                 (if (= index (sh12-c6p-let-count core)) result
                   (let [id (get ids (sh12-c6p-let-binder-index core index))]
                     (recur (+ index 1) (assoc result id {:type (get (get maps :types) id)
                                            :mutability :immutable :ownership :persistent-shared})))))
        edges (loop [rows (if (sh12-c6p-nested? core)
                          (if (sh12-c6p-predicate? core)
                            (if (contains? #{:then :else} (sh12-c6p-predicate-local-side core))
                              (let [arm (if (= :then (sh12-c6p-predicate-local-side core)) 5 6)]
                                [[0 1 0 :binding-use] [1 2 0 :initializer] [0 3 0 :binding-use] [3 4 0 :control]
                                 [2 arm 0 :binding-use] [4 7 0 :control] [5 7 1 :conditional-incoming] [6 7 2 :conditional-incoming]
                                 [7 8 0 :control] [8 11 0 :control] [9 11 1 :conditional-incoming] [10 11 2 :conditional-incoming]
                                 [2 12 0 :initializer] [11 12 1 :result] [12 13 0 :result]])
                            (if (sh12-c6p-conditional-initializer? core)
                            [[0 1 0 :binding-use] [1 2 0 :control] [2 5 0 :control]
                             [3 5 1 :conditional-incoming] [4 5 2 :conditional-incoming]
                             [5 6 0 :initializer] [6 7 0 :binding-use] [7 8 0 :control]
                             [8 11 0 :control] [9 11 1 :conditional-incoming] [10 11 2 :conditional-incoming]
                             [6 12 0 :initializer] [11 12 1 :result] [12 13 0 :result]]
                            [[0 1 0 :binding-use] [1 2 0 :control] [2 5 0 :control]
                             [3 5 1 :conditional-incoming] [4 5 2 :conditional-incoming]
                             [5 6 0 :control] [6 9 0 :control]
                             [7 9 1 :conditional-incoming] [8 9 2 :conditional-incoming] [9 10 0 :result]]))
                          (if (sh12-c6p-nested-let? core)
                            (if (= :then (sh12-c6p-nested-side core))
                              [[0 1 0 :binding-use] [1 2 0 :initializer] [2 3 0 :binding-use]
                               [3 4 0 :control] [5 6 0 :control] [6 9 0 :control]
                               [7 9 1 :conditional-incoming] [8 9 2 :conditional-incoming]
                               [4 11 0 :control] [9 11 1 :conditional-incoming] [10 11 2 :conditional-incoming]
                               [2 12 0 :initializer] [11 12 1 :result] [12 13 0 :result]]
                              [[0 1 0 :binding-use] [1 2 0 :initializer] [2 3 0 :binding-use]
                               [3 4 0 :control] [6 7 0 :control] [7 10 0 :control]
                               [8 10 1 :conditional-incoming] [9 10 2 :conditional-incoming]
                               [4 11 0 :control] [5 11 1 :conditional-incoming] [10 11 2 :conditional-incoming]
                               [2 12 0 :initializer] [11 12 1 :result] [12 13 0 :result]])
                          (if (= :then (sh12-c6p-nested-side core))
                            [[0 1 0 :binding-use] [1 2 0 :control] [3 4 0 :control]
                             [4 7 0 :control] [5 7 1 :conditional-incoming] [6 7 2 :conditional-incoming]
                             [2 9 0 :control] [7 9 1 :conditional-incoming] [8 9 2 :conditional-incoming] [9 10 0 :result]]
                            [[0 1 0 :binding-use] [1 2 0 :control] [4 5 0 :control]
                             [5 8 0 :control] [6 8 1 :conditional-incoming] [7 8 2 :conditional-incoming]
                             [2 9 0 :control] [3 9 1 :conditional-incoming] [8 9 2 :conditional-incoming] [9 10 0 :result]])))
                          (if (sh12-c6p-later-body-local? core)
                           [[0 1 0 :binding-use] [1 2 0 :initializer] [0 3 0 :binding-use] [3 4 0 :control]
                            [4 7 0 :control] [5 7 1 :conditional-incoming] [6 7 2 :conditional-incoming]
                            [2 8 0 :binding-use] [2 9 0 :initializer] [7 9 1 :sequence] [8 9 2 :result] [9 10 0 :result]]
                          (if (sh12-c6p-arm-local? core)
                           (if (= :then (sh12-c6p-arm-local-side core))
                             [[0 1 0 :binding-use] [1 2 0 :initializer] [0 3 0 :binding-use] [3 4 0 :control]
                              [2 5 0 :binding-use] [4 7 0 :control] [5 7 1 :conditional-incoming] [6 7 2 :conditional-incoming]
                              [2 8 0 :initializer] [7 8 1 :result] [8 9 0 :result]]
                             [[0 1 0 :binding-use] [1 2 0 :initializer] [0 3 0 :binding-use] [3 4 0 :control]
                              [2 6 0 :binding-use] [4 7 0 :control] [5 7 1 :conditional-incoming] [6 7 2 :conditional-incoming]
                              [2 8 0 :initializer] [7 8 1 :result] [8 9 0 :result]])
                          (if (= 2 (sh12-c6p-let-count core))
                           [[0 1 0 :binding-use] [1 2 0 :initializer] [2 3 0 :binding-use]
                            [3 4 0 :initializer] [4 5 0 :binding-use] [5 6 0 :control]
                            [6 9 0 :control] [7 9 1 :conditional-incoming] [8 9 2 :conditional-incoming]
                            [2 10 0 :initializer] [4 10 1 :initializer] [9 10 2 :result] [10 11 0 :result]]
                          (if (sh12-c6p-let-layout? core)
                           [[0 1 0 :binding-use] [1 2 0 :initializer] [2 3 0 :binding-use]
                            [3 4 0 :control] [4 7 0 :control] [5 7 1 :conditional-incoming]
                            [6 7 2 :conditional-incoming] [2 8 0 :initializer] [7 8 1 :result] [8 9 0 :result]]
                           [[0 1 0 :binding-use] [1 2 0 :control] [2 5 0 :control]
                            [3 5 1 :conditional-incoming] [4 5 2 :conditional-incoming] [5 6 0 :result]]))))) result []]
                (if (= (count rows) 0) result
                  (let [row (first rows) from (get row 0) to (get row 1)]
                    (recur (rest rows) (conj result
                      {:dependency (get ids from) :consumer (get ids to) :dependency-index from
                       :consumer-index to :operand-index (get row 2) :edge-kind (get row 3)
                       :dependency-precedes-consumer? true})))))]
    (sh12-c6p-all?
      [(= (count (set (get maps :proofs))) (count nodes))
       (= (get core :instruction-origin-sidecar)
          {:mapping-id (get core :mapping-id) :provenance-binding-id (get core :provenance-binding-id)
           :node-origin-map (get maps :source-map)})
       (= (get core :dependency-order-graph)
          {:artifact :gravity/c6-c10-dependency-order-graph :node-order ids :edges edges
           :all-dependencies-precede-consumers? true :all-lexical-bindings-resolve? true :status :passed})
       (= (get core :effect-graph)
          {:artifact :gravity/effect-graph :module module :nodes (get maps :effects)
           :functions {root {:declared #{} :inferred #{} :latent #{} :throws #{}}}
           :namespace {:declared #{} :inferred #{}} :build-effects [] :replay-required #{} :diagnostics []})
       (= (get core :ownership-analysis)
          {:artifact :gravity/ownership-analysis :module module :owners (get maps :owners)
           :moves [] :borrows [] :regions {} :arenas {} :linear {} :transfers [] :diagnostics []})
       (= (get core :pure-capability-closure)
          {:artifact :gravity/c6-c10-pure-capability-closure :module module
           :required #{} :granted #{} :provider-bindings {} :status :not-required})
       (sh12-c10-mir-sha256-id? (get typed :core-input))
       (= typed {:artifact :gravity/typed-core :module module :core-input (get typed :core-input)
                 :types (get maps :types) :locals locals
                 :functions {root {:params [(get (get maps :types) binder)]
                                   :return (get (get maps :types) result)
                                   :latent-effects #{} :capabilities #{} :throws #{}}}
                 :constraints [] :dynamic-boundaries [] :casts [] :layout-facts :not-applicable :diagnostics []})
       (sh12-branch-join-fact-ids-unique? nodes (get core :type-facts) :fact-id [])
       (sh12-branch-join-fact-ids-unique? nodes (get core :effect-facts) :fact-id [])
       (sh12-branch-join-fact-ids-unique? nodes (get core :ownership-facts) :fact-id [])])))

(defn sh12-c6p-scalars-valid? [core]
  ; Called only AFTER the existing complete width/depth/node preflight. This
  ; second bounded walk closes the scalar domain before schema arithmetic.
  (loop [frontier [core] cursor 0]
    (if (= cursor (count frontier)) true
      (let [value (get frontier cursor)]
        (if (sh12-c10-mir-persistent-aggregate? value)
          (recur (c11-append-uses frontier (sh12-c10-mir-aggregate-components value)) (+ cursor 1))
          (if (if (= nil value) true
                (if (boolean? value) true
                  (if (integer? value) true
                    (if (char? value) true
                      (if (string? value) (<= (count value) 65536)
                        (if (symbol? value) (<= (count (str value)) 65536)
                          (if (keyword? value) (<= (count (str value)) 65536) false)))))))
            (recur frontier (+ cursor 1)) false))))))

(defn sh12-c6p-producer-metadata-valid? [core]
  (let [pins (get (get core :authenticated-input) :binding-pins)]
    (if (sh12-c6p-all?
          [(sh12-c6p-keys? (get core :authenticated-input)
             #{:kind :source-content-hash :plan-id :binding-pins})
           (sh12-c6p-keys? (get core :semantic-provenance) #{:source-content-hash :binding-pins})
           (sh12-c6p-keys? pins #{:c2-semantic-hash :c3-semantic-hash :plan-semantic-hash
                                  :reader-integrity-hash :builder-source-hash :builder-plan-hash
                                  :builder-function-hash :parameter-resolution-hash})
           (= (get core :clojure-seed-boundary?) true)
           (vector? (get core :pass-history))
           (= (get core :scope)
              {:artifact :gravity/c6-c10-checked-core-scope-contract :profiles [:hosted]
               :safety-modes [:safe] :source-targets [:jvm]
               :source-operations [:literal :quote :local :let :let-binding :parameter
                                   :do :if :truthy :integer-eq :integer-lt :integer-lte
                                   :integer-gt :integer-gte :implicit-nil :function]
               :scalar-literals [:nil :string :boolean :integer :character :keyword :symbol]
               :intrinsic-effects #{} :intrinsic-capabilities #{} :ownership :persistent-immutable
               :safety :proven-safe :whole-language? false})])
      (if (loop [fields (keys pins)]
            (if (= (count fields) 0) true
              (if (sh12-c10-mir-sha256-id? (get pins (first fields)))
                (recur (rest fields)) false)))
        (loop [fields [:typed-core-key :effect-graph-key :pure-capability-closure-key :ownership-analysis-key]]
          (if (= (count fields) 0) true
            (if (sh12-c10-mir-sha256-id? (get core (first fields)))
              (recur (rest fields)) false))) false) false)))

(defn sh12-c6p-checked-core-preflight [core]
  ; Reuse the bounded complete-carrier walk BEFORE any role/table census.
  ; The enclosing module's existing 16384-node limit remains an input limit;
  ; this helper's 32768-node hard walk budget is the existing adapter budget.
  (let [carrier (sh12-authenticated-c10-mir-carrier-preflight core)]
    (if (if (= (get carrier :status) :accepted)
          (if (<= (get carrier :nodes) 16384)
            (if (sh12-c6p-scalars-valid? core) (sh12-c6p-top-shape? core) false) false) false)
      (let [view (sh12-c6p-role-view core)]
        (if (if (= view nil) false
              (if (if (sh12-c6p-lineage-valid? core) (sh12-c6p-producer-metadata-valid? core) false)
                (if (sh12-c6p-shape-valid? core view)
                  (if (sh12-c6p-role-nodes-valid? core 0)
                    (if (sh12-c6p-declaration-valid? core)
                      (sh12-c6p-tables-valid? core (get core :core-nodes)
                                            (get view :ids) (get view :origins) 0) false) false) false) false))
          (let [problem (sh12-c6p-nodes-problem core (get core :core-nodes) 0)]
            (if (= problem nil)
              (if (sh12-c6p-graphs-valid? core view) {:status :accepted}
                {:status :rejected :diagnostic-id "C11-VERIFY" :missing-fact :original-c6-parameter-graphs})
              (assoc problem :status :rejected)))
          {:status :rejected :diagnostic-id "C11-MODULE" :missing-fact :original-c6-bool-parameter-family}))
      {:status :rejected :diagnostic-id "C11-MODULE" :missing-fact :bounded-original-c6-carrier})))

(defn sh12-branch-join-checked-core-preflight [checked-core]
  (if (sh12-c6p-family? checked-core)
    (sh12-c6p-checked-core-preflight checked-core)
    (sh12-supplied-branch-join-checked-core-preflight checked-core)))

(defn sh12-branch-join-checked-core-admissible? [checked-core]
  (= :accepted
     (get (sh12-branch-join-checked-core-preflight checked-core) :status)))

(defn sh12-branch-join-preflight-rejection
  [phase preflight checked-core mir]
  (let [diagnostic-id (get preflight :diagnostic-id)
        report
        (sh12-branch-join-rejection
         phase diagnostic-id (get preflight :missing-fact) checked-core mir)
        node (get preflight :node)]
    (if (= node nil)
      report
      (let [source (get node :source)
            diagnostic (first (get report :diagnostics))]
        (assoc report :diagnostics
               [(assoc diagnostic
                       :operation-id (if (c11-c6-parameter-node? checked-core node)
                                       :not-applicable (get node :node-id))
                       :value-id
                       (if (if (c11-c6-parameter-node? checked-core node) true
                             (= diagnostic-id "C11-DOMINANCE"))
                         (get node :node-id)
                         :not-applicable)
                       ; Preflight rejected before a CFG was established.
                       :block :not-applicable
                       :source-span (get source :span)
                       :origin-chain (get source :generated-origin))])))))

(defn sh12-branch-join-block-dominates?
  [mir definition-block consumer-block]
  (let [dominance
        (get (get mir :control-flow-graph) :dominance)
        dominators (if (map? dominance) (get dominance consumer-block) nil)]
    (if (vector? dominators)
      (c11-vector-contains? dominators definition-block)
      false)))

(defn sh12-branch-join-block-instructions [mir block-id]
  (let [function-name (first (keys (get mir :functions)))
        function (get (get mir :functions) function-name)
        block (get (get function :blocks) block-id)]
    (if (map? block) (get block :instructions) nil)))

(defn sh12-branch-join-operation-present?
  [operations operation-id]
  (if (= (count operations) 0)
    false
    (if (= operation-id (get (first operations) :op-id))
      true
      (sh12-branch-join-operation-present?
       (rest operations) operation-id))))

(defn sh12-branch-join-operation-before?
  [operations definition-id consumer-id]
  (if (= definition-id consumer-id)
    false
    (if (= (count operations) 0)
      false
      (let [operation-id (get (first operations) :op-id)]
        (if (= operation-id consumer-id)
          false
          (if (= operation-id definition-id)
            true
            (sh12-branch-join-operation-before?
             (rest operations) definition-id consumer-id)))))))

(defn sh12-branch-join-entry-parameter-definition-valid? [mir definition]
  (let [function (sh12-branch-join-function mir) id (get definition :value-id)
        value (get (get (get mir :data-flow-graph) :values) id)]
    (sh12-c6p-all?
      [(sh12-c6p-keys? definition #{:value-id :parameter-index :block-id})
       (= (get definition :parameter-index) 0)
       (= (get definition :block-id) (get function :entry))
       (= (get function :params) [id])
       (= (get value :kind) :parameter) (= (get value :value-id) id)
       (= (get value :type) :gravity/bool) (= (get value :defined-by) definition)])))

(defn sh12-branch-join-definition-kind-valid? [mir definition]
  (let [value (get (get (get mir :data-flow-graph) :values) (get definition :value-id))]
    (if (contains? definition :parameter-index)
      (sh12-branch-join-entry-parameter-definition-valid? mir definition)
      (if (= (get value :kind) :parameter) false true))))

(defn sh12-branch-join-same-block-operation-use-valid?
  [mir edge definition]
  (let [block-id (get definition :block-id)
        operations (sh12-branch-join-block-instructions mir block-id)]
    (if (vector? operations)
      (if (contains? definition :parameter-index)
        (if (sh12-branch-join-entry-parameter-definition-valid? mir definition)
          (sh12-branch-join-operation-present? operations (get edge :consumer-id)) false)
        (sh12-branch-join-operation-before?
         operations (get definition :operation-id) (get edge :consumer-id)))
      false)))

(defn sh12-branch-join-same-block-terminator-use-valid?
  [mir definition]
  (let [operations
        (sh12-branch-join-block-instructions
         mir (get definition :block-id))]
    (if (vector? operations)
      (if (contains? definition :parameter-index)
        (sh12-branch-join-entry-parameter-definition-valid? mir definition)
        (sh12-branch-join-operation-present? operations (get definition :operation-id)))
      false)))

(defn sh12-branch-join-incoming-matches?
  [incoming predecessor value-id]
  (if (= (count incoming) 0)
    false
    (let [edge (first incoming)]
      (if (= predecessor (get edge :predecessor))
        (if (= value-id (get edge :value))
          true
          (sh12-branch-join-incoming-matches?
           (rest incoming) predecessor value-id))
        (sh12-branch-join-incoming-matches?
         (rest incoming) predecessor value-id)))))

(defn sh12-branch-join-predicate-graph? [mir]
  ; Derived from existing graph facts, not an input flag. Full independent
  ; reconstruction still checks the complete graph against original Core.
  (let [function (sh12-branch-join-function mir) blocks (get function :blocks)
        inner (get (get (get (get blocks (get function :entry)) :terminator) :facts) :join)
        outer (get (get (get mir :control-flow-graph) :join) :block-id)]
    (if (string? inner) (if (string? outer) (if (= inner outer) false true) false) false)))

(defn sh12-predicate-initializer-join? [join]
  ; Exact operation chain only, never a generic larger-join allowance. IDs
  ; and single operands are physically classified before equality.
  (let [rows (get join :instructions)]
    (if (vector? rows)
      (if (= 4 (count rows))
        (if (loop [index 0]
              (if (= index 4) true
                (let [row (get rows index) operands (get row :operands)]
                  (if (string? (get row :result))
                    (if (= index 0) (recur (+ index 1))
                      (if (vector? operands)
                        (if (= 1 (count operands))
                          (if (string? (first operands)) (recur (+ index 1)) false) false) false)) false))))
          (sh12-c6p-all?
            [(= [:conditional-join :local-binding :local :truthiness]
                [(get (get rows 0) :opcode) (get (get rows 1) :opcode)
                 (get (get rows 2) :opcode) (get (get rows 3) :opcode)])
             (= [(get (get rows 0) :result)] (get (get rows 1) :operands))
             (= [(get (get rows 1) :result)] (get (get rows 2) :operands))
             (= [(get (get rows 2) :result)] (get (get rows 3) :operands))]) false) false) false)))

(defn sh12-nested-inner-join-use-valid? [mir edge definition]
  (let [function (sh12-branch-join-function mir) blocks (get function :blocks)]
    (if (map? blocks)
     (if (= 7 (count blocks))
      (let [entry (get blocks (get function :entry)) successors (get (get entry :terminator) :successors)
            t (get blocks (get successors 0)) f (get blocks (get successors 1))
            predicate? (sh12-branch-join-predicate-graph? mir)
            nested (if predicate? entry (if (= :conditional-branch (get (get t :terminator) :kind)) t f))
            branch (get nested :terminator) predecessors (get branch :successors)
            join-id (get (get branch :facts) :join) join (get blocks join-id)
            instructions (get join :instructions) operation (get instructions 0) index (get edge :operand-index)]
        (if (vector? instructions)
         (if (integer? index)
         (if (contains? #{1 2} index)
          (let [predecessor (get predecessors (- index 1)) producer (get blocks predecessor)
                terminator (get producer :terminator) value (get edge :from)]
            (sh12-c6p-all?
              [(= :conditional-branch (get branch :kind))
               (= :conditional-join (get operation :opcode))
               (= (if predicate? (if (sh12-predicate-initializer-join? join) 4 2) 1) (count instructions))
               (= 2 (count predecessors)) (= (get join :predecessors) predecessors)
               (= (get edge :consumer-id) (get operation :op-id))
               (= (get edge :consumer-block) join-id) (= (get edge :edge-kind) :operand)
               (= (get definition :block-id) predecessor)
               (= value (get (get operation :operands) index))
               (= :branch (get terminator :kind)) (= (get terminator :operands) [value])
               (= (get terminator :successors) [join-id])
               (= (get terminator :facts) {:incoming-value value})
               (sh12-branch-join-same-block-terminator-use-valid? mir definition)])) false) false) false)) false) false)))

(defn sh12-branch-join-edge-specific-join-use-valid?
  [mir edge definition]
  (let [join (get (get mir :control-flow-graph) :join)]
    (if (map? join)
      (if (= (get edge :consumer-id) (get join :value-id))
        (if (= (get edge :consumer-block) (get join :block-id))
          (let [incoming (get join :incoming)]
            (if (vector? incoming)
              (sh12-branch-join-incoming-matches?
               incoming (get definition :block-id) (get edge :from))
              false))
          false)
        (sh12-nested-inner-join-use-valid? mir edge definition))
      false)))

(defn sh12-branch-join-data-edges-dominate?
  [mir edges definitions]
  (if (= (count edges) 0)
    true
    (let [edge (first edges)
          definition (get definitions (get edge :from))]
      (if (map? edge)
        (if (if (map? definition) (sh12-branch-join-definition-kind-valid? mir definition) false)
          (if (= (get definition :block-id)
                 (get edge :consumer-block))
            (if (sh12-branch-join-same-block-operation-use-valid?
                 mir edge definition)
              (sh12-branch-join-data-edges-dominate?
               mir (rest edges) definitions)
              false)
            (if (sh12-branch-join-block-dominates?
                 mir
                 (get definition :block-id)
                 (get edge :consumer-block))
              (sh12-branch-join-data-edges-dominate?
               mir (rest edges) definitions)
              (if (sh12-branch-join-edge-specific-join-use-valid?
                   mir edge definition)
                (sh12-branch-join-data-edges-dominate?
                 mir (rest edges) definitions)
                false)))
          false)
        false))))

(defn sh12-branch-join-terminator-uses-dominate?
  [mir uses definitions]
  (if (= (count uses) 0)
    true
    (let [use (first uses)
          definition (get definitions (get use :value-id))]
      (if (map? use)
        (if (if (map? definition) (sh12-branch-join-definition-kind-valid? mir definition) false)
          (if (= (get definition :block-id)
                 (get use :consumer-block))
            (if (sh12-branch-join-same-block-terminator-use-valid?
                 mir definition)
              (sh12-branch-join-terminator-uses-dominate?
               mir (rest uses) definitions)
              false)
            (if (sh12-branch-join-block-dominates?
                 mir
                 (get definition :block-id)
                 (get use :consumer-block))
              (sh12-branch-join-terminator-uses-dominate?
               mir (rest uses) definitions)
              false))
          false)
        false))))

(defn sh12-branch-join-mir-dominance-valid? [mir]
  (let [data (get mir :data-flow-graph)
        edges (if (map? data) (get data :edges) nil)
        uses (if (map? data) (get data :terminator-uses) nil)
        definitions (if (map? data) (get data :definitions) nil)]
    (if (vector? edges)
      (if (vector? uses)
        (if (map? definitions)
          (if (sh12-branch-join-data-edges-dominate?
               mir edges definitions)
            (sh12-branch-join-terminator-uses-dominate?
             mir uses definitions)
            false)
          false)
        false)
      false)))

(defn sh12-build-branch-join-mir [checked-core]
  (let [preflight
        (sh12-branch-join-checked-core-preflight checked-core)]
    (if (= :accepted (get preflight :status))
      (let [mir (c11-build-target-independent-mir checked-core)]
        (if (sh12-branch-join-mir-dominance-valid? mir)
          mir
          (sh12-branch-join-rejection
           :construction "C11-DOMINANCE"
           :definitions-uses-or-edge-dominance checked-core mir)))
      (sh12-branch-join-preflight-rejection
       :construction preflight checked-core nil))))

(defn sh12-branch-join-operation-ids [operations result]
  (if (= (count operations) 0)
    result
    (sh12-branch-join-operation-ids
     (rest operations)
     (conj result (get (first operations) :op-id)))))

(defn sh12-branch-join-block-structure [block]
  (let [terminator (get block :terminator)]
    {:artifact (get block :artifact)
     :block-id (get block :block-id)
     :arguments (get block :arguments)
     :operation-ids
     (sh12-branch-join-operation-ids
      (get block :instructions) [])
     :terminator
     {:artifact (get terminator :artifact)
      :terminator-id (get terminator :terminator-id)
      :kind (get terminator :kind)
      :operands (get terminator :operands)
      :successors (get terminator :successors)
      :facts (get terminator :facts)
      :verifier-status (get terminator :verifier-status)}
     :predecessors (get block :predecessors)
     :successors (get block :successors)
     :dominators (get block :dominators)
     :data-flow (get block :data-flow)}))

(defn sh12-branch-join-block-structures
  [block-ids blocks result]
  (if (= (count block-ids) 0)
    result
    (let [block-id (first block-ids)]
      (sh12-branch-join-block-structures
       (rest block-ids) blocks
       (conj result
             (sh12-branch-join-block-structure
              (get blocks block-id)))))))

(defn sh12-branch-join-block-ids [mir]
  (let [function-name (first (keys (get mir :functions)))
        function (get (get mir :functions) function-name)
        entry-id (get function :entry)
        join (get (get mir :control-flow-graph) :join)
        incoming (get join :incoming)]
    (if (= 7 (count (get function :blocks)))
      (let [blocks (get function :blocks) successors (get (get (get blocks entry-id) :terminator) :successors)
            t (get successors 0) f (get successors 1)
            then-nested? (= :conditional-branch (get (get (get blocks t) :terminator) :kind))
            n (if then-nested? t f) branch (get (get blocks n) :terminator)
            a (get (get branch :successors) 0) b (get (get branch :successors) 1)
            k (get (get branch :facts) :join)]
        (if (sh12-branch-join-predicate-graph? mir)
          (let [inner-join (get (get (get (get blocks entry-id) :terminator) :facts) :join)
                outer-successors (get (get (get blocks inner-join) :terminator) :successors)]
            [entry-id t f inner-join (get outer-successors 0) (get outer-successors 1) (get join :block-id)])
          (if then-nested? [entry-id n a b k f (get join :block-id)] [entry-id t n a b k (get join :block-id)])))
    [entry-id
     (get (first incoming) :predecessor)
     (get (second incoming) :predecessor)
     (get join :block-id)])))

(defn sh12-branch-join-function [mir]
  (get (get mir :functions) (first (keys (get mir :functions)))))

(defn sh12-branch-join-instructions
  [block-ids blocks result]
  (if (= (count block-ids) 0)
    result
    (sh12-branch-join-instructions
     (rest block-ids) blocks
     (c11-append-uses
      result (get (get blocks (first block-ids)) :instructions)))))

(defn sh12-branch-join-terminators
  [block-ids blocks result]
  (if (= (count block-ids) 0)
    result
    (sh12-branch-join-terminators
     (rest block-ids) blocks
     (conj result
           (get (get blocks (first block-ids)) :terminator)))))

(defn sh12-branch-join-type-operation-view [operations result]
  (if (= (count operations) 0)
    result
    (let [operation (first operations)]
      (sh12-branch-join-type-operation-view
       (rest operations)
       (conj result
             {:op-id (get operation :op-id)
              :type (get operation :type)
              :type-fact-id
              (get (get operation :facts) :type-fact-id)})))))

(defn sh12-branch-join-effect-operation-view [operations result]
  (if (= (count operations) 0)
    result
    (let [operation (first operations)]
      (sh12-branch-join-effect-operation-view
       (rest operations)
       (conj result
             {:op-id (get operation :op-id)
              :effects (get operation :effects)
              :ordering (get operation :ordering)
              :effect-fact-id
              (get (get operation :facts) :effect-fact-id)})))))

(defn sh12-branch-join-safety-operation-view [operations result]

(defn sh12-c10-mir-c9-request-from-c8 [bound value-id]
  (let [owned (get (get bound :ownership-core) :ownership-core)
        c8-bound (get owned :effected-core)
        effected (get c8-bound :effected-core)
        module (get effected :module)
        identities (get c8-bound :fact-identities)
        identity (get identities value-id)
        effect-request
        (sh12-c10-mir-c8-effect-request-find
         (get effected :effect-requests) value-id)]
    {:artifact :gravity/sh10-normalized-ownership-request
     :request-id (get identity :effect-fact-id)
     :value-id value-id
     :owner-id (get module :namespace)
     :ownership-kind :persistent-immutable
     :initialization :initialized
     :availability :available
     :events
     [{:event-id value-id
       :op :read
       :source-span (get effect-request :source-span)
       :origin-chain (get effect-request :origin-chain)
       :control-path [:authenticated-pure-effect-read]}]
     :owner-lifetime-end 1
     :type-fact-id (get identity :type-fact-id)
     :effect-fact-id (get identity :effect-fact-id)
     :capability-proof-id (get identity :capability-proof-id)
     :source-span (get effect-request :source-span)
     :origin-chain (get effect-request :origin-chain)
     :profile (get module :profile)
     :target (get module :target)}))


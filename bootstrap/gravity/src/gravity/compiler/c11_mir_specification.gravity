(defn sh12-c10-mir-c9-event-valid? [event]
  (if (map? event)
    (if (sh12-c10-mir-exact-keys?
         event #{:event-id :op :source-span :origin-chain :control-path})
      (if (= :read (get event :op))
        (if (map? (get event :source-span))
          (if (vector? (get event :origin-chain))
            (= [:authenticated-pure-effect-read]
               (get event :control-path))

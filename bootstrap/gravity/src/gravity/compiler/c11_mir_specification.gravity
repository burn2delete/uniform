     :source-map (get template :source-map)}))

(defn sh12-c10-mir-operation-identity-request [bound verification template]
  (let [template-preflight
        (sh12-authenticated-c10-mir-carrier-preflight template)
        canonical-template
        (sh12-build-authenticated-c10-mir-template bound verification)]
    (if (= :accepted (get template-preflight :status))
      (if (sh12-authenticated-c10-mir-input-valid? bound verification)
        (if (= template canonical-template)
          {:artifact :gravity/sh12-c10-proof-reference-operation-identity-request
           :schema-version 2
           :status :accepted
           :request
           (sh12-c10-mir-operation-identity-input canonical-template)
           :next :resolve-mir-operation-identity
           :resolution :coordinator-digest-required
           :diagnostics []
           :pending (get template :pending)}
          {:artifact :gravity/sh12-c10-proof-reference-operation-identity-request
           :schema-version 2
           :status :rejected
           :diagnostics [(sh12-c10-mir-diagnostic
                          bound :template-recomputation-mismatch)]})
        {:artifact :gravity/sh12-c10-proof-reference-operation-identity-request
         :schema-version 2
         :status :rejected
         :diagnostics [(sh12-c10-mir-diagnostic
                        bound :untrusted-or-malformed-c10-input)]})
      {:artifact :gravity/sh12-c10-proof-reference-operation-identity-request
       :schema-version 2
       :status :rejected
       :diagnostics [{:diagnostic-id "C11-C10-ADAPTER"
                      :rule "C11-C10-ADAPTER"
                      :reason :template-carrier-bound
                      :preflight template-preflight}]})))

(defn sh12-c10-mir-resolution-entry-valid? [request resolution]
  (if (map? resolution)
    (if (sh12-c10-mir-exact-keys? resolution #{:request :digest})
      (if (= request (get resolution :request))
        (sh12-c10-mir-sha256-id? (get resolution :digest))
        false)
      false)
    false))

(defn sh12-c10-mir-upstream-digest? [bound digest]
  (let [operation (get bound :operation)
        facts (get operation :facts)
        ownership-core (get bound :ownership-core)
        identities (get ownership-core :fact-identities)
        fact-identity (first identities)]
    (if (= digest (get bound :proof-id))
      true
      (if (= digest (get bound :result-id))
        true
        (if (= digest (get bound :safety-core-id))
          true
          (if (= digest
                 (get (get bound :identity-input)
                      :ownership-core-identity-id))
            true
            (if (= digest (get operation :type-fact-id))
              true
              (if (= digest (get operation :effect-fact-id))
                true
                (if (= digest (get operation :capability-proof-id))
                  true
                  (if (= digest (get operation :ownership-fact-id))
                    true
                    (if (= digest
                           (get facts :ownership-core-identity-id))
                      true
                      (if (= digest
                             (get fact-identity :ownership-fact-id))
                        true
                        false))))))))))))


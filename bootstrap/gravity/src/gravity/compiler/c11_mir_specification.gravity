    result
    (let [operation (first operations)
          facts (get operation :facts)]
      (sh12-branch-join-safety-operation-view
       (rest operations)
       (conj result
             {:op-id (get operation :op-id)
              :safety-outcome-id (get facts :safety-outcome-id)
              :safety-proof-id (get facts :safety-proof-id)
              :runtime-check-id (get facts :runtime-check-id)
              :proof-certificate-ids
              (get facts :proof-certificate-ids)
              :failure-behavior (get facts :failure-behavior)})))))

(defn sh12-branch-join-other-operation-view [operations result]
  (if (= (count operations) 0)
    result
    (let [operation (first operations)
          facts (get operation :facts)]
      (sh12-branch-join-other-operation-view
       (rest operations)
       (conj result
             {:op-id (get operation :op-id)
              :capability-fact-id (get facts :capability-fact-id)
              :capability-proof-ids (get facts :capability-proof-ids)
              :ownership-fact-id (get facts :ownership-fact-id)
             :profile-target-fact-id
              (get facts :profile-target-fact-id)
              :facts facts
              :capabilities (get operation :capabilities)
              :profile (get operation :profile)
              :domain-anchor (get operation :domain-anchor)
              :verifier-status (get operation :verifier-status)})))))

(defn sh12-branch-join-data-operation-view [operations result]
  (if (= (count operations) 0)
    result
    (let [operation (first operations)]
      (sh12-branch-join-data-operation-view
       (rest operations)
       (conj result
             {:op-id (get operation :op-id)
              :artifact (get operation :artifact)
              :opcode (get operation :opcode)
              :source-operation (get operation :source-operation)
              :operands (get operation :operands)
              :result (get operation :result)
              :result-kind (get operation :result-kind)
              :constant-payload (get operation :constant-payload)
              :block-id (get operation :block-id)})))))

(defn sh12-branch-join-origin-operation-view [operations result]
  (if (= (count operations) 0)
    result
    (let [operation (first operations)]
      (sh12-branch-join-origin-operation-view
       (rest operations)
       (conj result
             {:op-id (get operation :op-id)
              :source (get operation :source)
              :source-origin-id
              (get (get operation :facts) :source-origin-id)})))))

(defn sh12-branch-join-terminator-effect-view [terminators result]
  (if (= (count terminators) 0)
    result
    (let [terminator (first terminators)]
      (sh12-branch-join-terminator-effect-view
       (rest terminators)
       (conj result
             {:terminator-id (get terminator :terminator-id)
              :effects (get terminator :effects)
              :ordering (get terminator :ordering)})))))

(defn sh12-branch-join-terminator-origin-view [terminators result]

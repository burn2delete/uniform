   :authoritative-safety-certificate])

(defn sh12-c10-mir-proof-request-from-bound [bound]
  (let [operation (get bound :operation)
        facts (get operation :facts)]
    {:domain :gravity/sh11-persistent-read-proof-v2
     :operation-id (get operation :operation-id)
     :core-node-id (get operation :core-node-id)
     :value-type (get facts :value-type)
     :ownership-fact-id (get operation :ownership-fact-id)
     :fact-id-request (get facts :fact-id-request)
     :ownership-kind (get facts :ownership-kind)
     :initialization (get facts :initialization)
     :availability (get facts :availability)
     :event-id (get facts :event-id)
     :event (get facts :event)
     :ownership-core-identity-id
     (get facts :ownership-core-identity-id)
     :source-span (get operation :source-span)
     :origin-chain (get operation :origin-chain)
     :profile (get operation :profile)
     :target (get operation :target)
     :type-fact-id (get operation :type-fact-id)
     :effect-fact-id (get operation :effect-fact-id)
     :capability-proof-id (get operation :capability-proof-id)}))

(defn sh12-c10-mir-safety-identity-input-from-bound [bound]
  {:domain :gravity/sh11-authenticated-safety-core-v2
   :ownership-core-identity-input
   (get (get bound :identity-input) :ownership-core-identity-input)
   :ownership-core-identity-id
   (get (get bound :identity-input) :ownership-core-identity-id)
   :proof-id-request (sh12-c10-mir-proof-request-from-bound bound)
   :pending (get bound :pending)})

(defn sh12-c10-mir-result-request-from-bound [bound]
  {:domain :gravity/sh11-safety-result-identity-v2
   :operation (get bound :operation)
   :result (get bound :safety-result)
   :verification (get bound :safety-verification)
   :proof-id (get bound :proof-id)
   :ownership-core-identity-id
   (get (get bound :identity-input) :ownership-core-identity-id)})

(defn sh12-c10-mir-core-request-from-bound [bound]
  {:domain :gravity/sh11-safety-core-identity-v2
   :safety-identity-input
   (sh12-c10-mir-safety-identity-input-from-bound bound)
   :operation (get bound :operation)
   :result (get bound :safety-result)
   :result-verification (get bound :safety-verification)
   :proof-id (get bound :proof-id)
   :result-id (get bound :result-id)
   :ownership-core-identity-id
   (get (get bound :identity-input) :ownership-core-identity-id)
   :pending (get bound :pending)})

(defn sh12-c10-mir-resolutions-valid? [bound]
  (let [resolutions (get bound :identity-resolutions)
        proof-resolution (get resolutions :proof-resolution)
        result-resolution (get resolutions :result-resolution)
        core-resolution (get resolutions :core-resolution)
        proof-digest (get proof-resolution :digest)
        result-digest (get result-resolution :digest)
        core-digest (get core-resolution :digest)]
    (if (sh12-c10-mir-exact-keys?
         resolutions #{:proof-resolution :result-resolution :core-resolution})
      (if (sh12-c10-mir-exact-keys?
           proof-resolution #{:request :digest})
        (if (sh12-c10-mir-exact-keys?
             result-resolution #{:request :digest})
          (if (sh12-c10-mir-exact-keys?
               core-resolution #{:request :digest})
            (if (sh12-c10-mir-sha256-id? proof-digest)
              (if (sh12-c10-mir-sha256-id? result-digest)
                (if (sh12-c10-mir-sha256-id? core-digest)
                  (if (= proof-digest (get bound :proof-id))
                    (if (= result-digest (get bound :result-id))
                      (if (= core-digest (get bound :safety-core-id))
                        (if (= (get proof-resolution :request)
                               (sh12-c10-mir-proof-request-from-bound bound))
                          (if (= (get result-resolution :request)
                                 (sh12-c10-mir-result-request-from-bound bound))
                            (if (= (get core-resolution :request)
                                   (sh12-c10-mir-core-request-from-bound bound))
                              (if (= proof-digest result-digest)
                                false
                                (if (= proof-digest core-digest)
                                  false
                                  (if (= result-digest core-digest)
                                    false
                                    true)))
                              false)
                            false)
                          false)
                        false)
                      false)
                    false)
                  false)
                false)
              false)
            false)
          false)
        false)
      false)))

(defn sh12-c10-mir-c9-core-request-expected
  [ownership-core fact-identities]
  (let [owned (get ownership-core :ownership-core)]
    {:domain :gravity/sh10-ownership-core-identity-v2
     :kind :ownership-core
     :core-node-id :gravity/sh10-ownership-core
     :identity-input
     {:ownership-core-identity-input (get owned :identity-input)
      :ordered-fact-identities fact-identities
      :ownership-requests (get owned :ownership-requests)

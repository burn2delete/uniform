          let? (sh12-c6p-let-layout? core) two? (= 2 (sh12-c6p-let-count core)) binder (get (get nodes 0) :node-id)
          later? (sh12-c6p-later-body-local? core)
          entry (get (get context :entry) :instructions)
          then-ops (get (get context :then) :instructions)
          else-ops (get (get context :else) :instructions)
          join (get (get context :join) :instructions)
          result-type (sh12-c6p-result-type core)]
      (if (if (sh13-c6p-arm-runtime-valid? core (get then-ops 0) :then result-type)
            (if (sh13-c6p-arm-runtime-valid? core (get else-ops 0) :else result-type)
              (sh13-c6p-later-body-runtime-valid? core join) false) false)
      (= [(if later? 11 (if two? 12 (if let? 10 7))) (if later? 10 (if two? 11 (if let? 9 6)))
          (if later? [4 1 1 4] (if two? [6 1 1 3] (if let? [4 1 1 3] [2 1 1 2])))
          [binder] result-type :hosted :jvm :jvm #{} #{} 0
          (if two? [(get (get nodes 1) :node-id) (get (get nodes 2) :node-id)
                    (get (get nodes 3) :node-id) (get (get nodes 4) :node-id)
                    (get (get nodes 5) :node-id) (get (get nodes 6) :node-id)]
          (if let? [(get (get nodes 1) :node-id) (get (get nodes 2) :node-id)
                    (get (get nodes 3) :node-id) (get (get nodes 4) :node-id)]
                   [(get (get nodes 1) :node-id) (get (get nodes 2) :node-id)]))
          [(get (get nodes (sh12-c6p-index core 3)) :node-id)]
          [(get (get nodes (sh12-c6p-index core 4)) :node-id)]
          (if later? [(get (get nodes 7) :node-id) (get (get nodes 8) :node-id)
                     (get (get nodes 9) :node-id) (get (get nodes 10) :node-id)]
          (if two? [(get (get nodes 9) :node-id) (get (get nodes 10) :node-id) (get (get nodes 11) :node-id)]
          (if let? [(get (get nodes 7) :node-id) (get (get nodes 8) :node-id) (get (get nodes 9) :node-id)]
                   [(get (get nodes 5) :node-id) (get (get nodes 6) :node-id)])))
          (if two? [:local :local-binding :local :local-binding :local :truthiness]
            (if let? [:local :local-binding :local :truthiness] [:local :truthiness]))
          [(if (= :then (sh12-c6p-arm-local-side core)) :local :constant)]
          [(if (= :else (sh12-c6p-arm-local-side core)) :local :constant)]
          (if later? [:conditional-join :local :lexical-scope :function-boundary]
            (if let? [:conditional-join :lexical-scope :function-boundary] [:conditional-join :function-boundary]))
          result-type (sh12-c6p-function-type-for-return result-type)]
         [(count nodes) (count (get context :operations))
          [(count entry) (count then-ops) (count else-ops) (count join)] (get function :params)
          (get function :returns) (get mir :profile) (get mir :source-target)
          (get mir :target-request) (get function :latent-effects)
          (get function :capabilities) (count (get mir :runtime-check-table))
          (if two? [(get (get entry 0) :op-id) (get (get entry 1) :op-id)
                    (get (get entry 2) :op-id) (get (get entry 3) :op-id)
                    (get (get entry 4) :op-id) (get (get entry 5) :op-id)]
          (if let? [(get (get entry 0) :op-id) (get (get entry 1) :op-id)
                    (get (get entry 2) :op-id) (get (get entry 3) :op-id)]
                   [(get (get entry 0) :op-id) (get (get entry 1) :op-id)]))
          [(get (get then-ops 0) :op-id)] [(get (get else-ops 0) :op-id)]
          (if later? [(get (get join 0) :op-id) (get (get join 1) :op-id)
                     (get (get join 2) :op-id) (get (get join 3) :op-id)]
          (if let? [(get (get join 0) :op-id) (get (get join 1) :op-id) (get (get join 2) :op-id)]
                   [(get (get join 0) :op-id) (get (get join 1) :op-id)]))
          (if two? [(get (get entry 0) :opcode) (get (get entry 1) :opcode)
                    (get (get entry 2) :opcode) (get (get entry 3) :opcode)
                    (get (get entry 4) :opcode) (get (get entry 5) :opcode)]
          (if let? [(get (get entry 0) :opcode) (get (get entry 1) :opcode)
                    (get (get entry 2) :opcode) (get (get entry 3) :opcode)]
                   [(get (get entry 0) :opcode) (get (get entry 1) :opcode)]))
          [(get (get then-ops 0) :opcode)] [(get (get else-ops 0) :opcode)]
          (if later? [(get (get join 0) :opcode) (get (get join 1) :opcode)
                     (get (get join 2) :opcode) (get (get join 3) :opcode)]
          (if let? [(get (get join 0) :opcode) (get (get join 1) :opcode) (get (get join 2) :opcode)]
                   [(get (get join 0) :opcode) (get (get join 1) :opcode)]))
          (get (get join 0) :type) (get (c11-last-value join) :type)]) false)) false))))

(defn sh13-c6p-arguments-valid? [arguments]
  (if (vector? arguments)
    (if (= 1 (count arguments)) (boolean? (get arguments 0)) false) false))

(defn sh13-c6p-frame-operations [operations index result]
  (if (= index (count operations)) result
    (let [operation (get operations index) opcode (get operation :opcode)]
      (sh13-c6p-frame-operations operations (+ index 1)
        (conj result
          (if (= :constant opcode)
            {:op-id (get operation :op-id) :opcode :const :operands []
             :type (if (= :gravity/integer (get operation :type)) :i64 :bool)
             :literal (get (get operation :constant-payload) :value)}
            {:op-id (get operation :op-id)
             :opcode (if (= :local opcode) :local
                       (if (= :truthiness opcode) :truthy
                         (if (contains? #{:local-binding :lexical-scope} opcode) :local nil)))
             :operands (if (= :lexical-scope opcode)
                         [(c11-last-value (get operation :operands))] (get operation :operands))
             :type (if (= :gravity/integer (get operation :type)) :i64 :bool)}))))))

(defn sh13-c6p-frame-arm [core context arm]
  (let [block (get context arm)
        incoming (sh13-find-by-key (get (get (get context :graph) :join) :incoming)
                   :predecessor (get block :block-id) 0)]
    {:block-id (get block :block-id)
     :params (if (if (sh12-c6p-later-body-local? core) true (= arm (sh12-c6p-arm-local-side core)))
               [(get (get (get core :core-nodes) 2) :node-id)] [])
     :operations (sh13-c6p-frame-operations (get block :instructions) 0 [])
     :terminator {:opcode :branch :target (get (get context :join) :block-id)
                  :arguments (if (sh12-c6p-later-body-local? core)
                               [(get incoming :value) (get (get (get core :core-nodes) 2) :node-id)]
                               [(get incoming :value)])}}))

(defn sh13-c6p-frame [core context]
  (let [function (get context :function) entry (get context :entry)
        condition (c11-last-value (get entry :instructions))
        join-ops (get (get context :join) :instructions) join-op (get join-ops 0)
        returned (first (get (c11-last-value join-ops) :operands))
        arm-binding (get (get (get core :core-nodes) 2) :node-id)
        later? (sh12-c6p-later-body-local? core)]
    {:functions
     [{:fn-id (get function :fn-id) :params (get function :params)
       :maximum-call-depth (get (sh13-control-flow-policy) :maximum-call-depth)
       :entry-block (get entry :block-id)
       :blocks
       [{:block-id (get entry :block-id) :params (get function :params)
         :operations (sh13-c6p-frame-operations (get entry :instructions) 0 [])
         :terminator {:opcode :conditional-branch :condition (get condition :result)
                      :then-target (get (get context :then) :block-id)
                      :then-arguments (if (if later? true (= :then (sh12-c6p-arm-local-side core))) [arm-binding] [])
                      :else-target (get (get context :else) :block-id)
                      :else-arguments (if (if later? true (= :else (sh12-c6p-arm-local-side core))) [arm-binding] [])}}
        (sh13-c6p-frame-arm core context :then) (sh13-c6p-frame-arm core context :else)
        {:block-id (get (get context :join) :block-id)
         :params (if later? [(get join-op :result) arm-binding] [(get join-op :result)])
         :operations (if later? (sh13-c6p-frame-operations [(get join-ops 1) (get join-ops 2)] 0 [])
                       (if (= 3 (count join-ops)) (sh13-c6p-frame-operations [(get join-ops 1)] 0 []) []))
         :terminator {:opcode :return :value returned}}]}]}))

(defn sh13-c6p-nested-frame-block [core function layout block]
  (let [id (get block :block-id) operations (get block :instructions)
        first-op (get operations 0) join? (= :conditional-join (get first-op :opcode))
        ordinary (loop [rows operations result []]
                   (if (= (count rows) 0) result
                     (if (contains? #{:conditional-join :function-boundary} (get (first rows) :opcode))
                       (recur (rest rows) result) (recur (rest rows) (conj result (first rows))))))
        terminator (get block :terminator) kind (get terminator :kind)
        operands (get terminator :operands) successors (get terminator :successors)
        local-side (sh12-c6p-predicate-local-side core)
        binding (get (get (get core :core-nodes) 2) :node-id)
        local-block (if (contains? #{:then :else} local-side)
                      (get layout (if (= :then local-side) :inner-then :inner-else)) nil)
        entry? (= id (get function :entry))]
    {:block-id id
     :params (if entry? (get function :params)
               (if (= id local-block) [binding] (if join? [(get first-op :result)] [])))
     :operations (sh13-c6p-frame-operations ordinary 0 [])
     :terminator
     (if (= :conditional-branch kind)
       {:opcode :conditional-branch :condition (first operands)
        :then-target (get successors 0) :then-arguments (if (if entry? (= :then local-side) false) [binding] [])
        :else-target (get successors 1) :else-arguments (if (if entry? (= :else local-side) false) [binding] [])}
       (if (= :branch kind) {:opcode :branch :target (first successors) :arguments operands}
         {:opcode :return :value (first operands)}))}))

(defn sh13-c6p-nested-frame [core context]
  (let [function (get context :function)]
    {:functions [{:fn-id (get function :fn-id) :params (get function :params)
                  :maximum-call-depth (get (sh13-control-flow-policy) :maximum-call-depth)
                  :entry-block (get function :entry)
                  :blocks (loop [ids (get (get context :layout) :order) result []]
                            (if (= (count ids) 0) result
                              (recur (rest ids) (conj result
                                (sh13-c6p-nested-frame-block core function (get context :layout)
                                  (get (get context :blocks) (first ids)))))))}]}))

(defn sh13-c6p-projection [core mir context]
  (let [binder (first (get core :core-nodes)) id (get binder :node-id)
        rows (sh13-branch-join-projection-rows (get context :operations) 0 [])]
    {:function-id (get (get context :function) :fn-id)
     :entry-block (get (get context :entry) :block-id)
     :control-flow-graph (get context :graph)
     :return-value-id (first (get (c11-last-value (get (get context :join) :instructions)) :operands))
     :parameters [{:value-id id :parameter-index 0 :source-type (get binder :type)
                   :runtime-type :bool
                   :definition (get (get (get mir :data-flow-graph) :definitions) id)
                   :source (get binder :source) :facts (c11-operation-facts core binder)}]
     :operations
     (loop [index 0 result []]
       (if (= index (count rows)) result
         ; The root retains its ORIGINAL Fn source-type. Its existing
         ; function-result-alias role forwards the checked scalar return;
         ; no Fn value, source type or original fact is retagged.
         (let [type (get (get rows index) :source-type)
               forwarded (if (map? type) (get type :return) type)]
           (recur (+ index 1) (conj result (assoc (get rows index) :runtime-type
                                           (if (= :gravity/integer forwarded) :i64 :bool)))))))}))

(defn sh13-c6p-result [core mir verification arguments projection execution diagnostics]
  (assoc
    (assoc
      (assoc (sh13-branch-join-execution-result core mir verification projection execution diagnostics)
             :arguments arguments)
      :pending [:authenticated-public-c6-c11-source-ingress :generic-parameter-execution
                :backend-native-execution])
    :nonclaims [:authenticated-public-c6-c11-source-ingress :generic-mir-execution
                :calls-loops-errors :backend-native-execution :release]))

(defn sh13-run-branch-join-mir-with-arguments [checked-core mir arguments]
  (let [verification (sh12-verify-branch-join-mir checked-core mir)]
    (if (= :passed (get verification :status))
      (let [context (if (sh12-c6p-predicate? checked-core) (sh13-c6p-predicate-context checked-core mir)
                       (if (sh12-c6p-nested? checked-core) (sh13-c6p-nested-context checked-core mir)
                         (sh13-branch-join-context checked-core mir)))]
        (if (sh13-c6p-shape-valid? checked-core mir context)
          (if (sh13-c6p-arguments-valid? arguments)
            (let [execution (sh13-execute-function
                              (if (sh12-c6p-nested? checked-core) (sh13-c6p-nested-frame checked-core context) (sh13-c6p-frame checked-core context))
                              (get (get context :function) :fn-id) arguments 0
                              (get (sh13-control-flow-policy) :maximum-execution-steps) [])]
              (sh13-c6p-result checked-core mir verification arguments
                (sh13-c6p-projection checked-core mir context) execution
                (if (= :returned (get execution :status)) []
                  [(sh12-branch-join-diagnostic
                     "C11-VERIFY" :bounded-execution-result checked-core mir)])))
            (let [binder (first (get checked-core :core-nodes)) source (get binder :source)
                  diagnostic (sh12-branch-join-diagnostic
                               "C11-TYPE" :single-bool-entry-argument checked-core mir)]
              (sh13-c6p-result checked-core mir verification :not-applicable nil nil
                [(assoc diagnostic :operation-id :not-applicable :value-id (get binder :node-id)
                   :block (get (get context :entry) :block-id)
                   :source-span (get source :span) :origin-chain (get source :generated-origin))])))
          (sh13-c6p-result checked-core mir verification :not-applicable nil nil
            [(sh12-branch-join-diagnostic
               "C11-VERIFY" :bounded-execution-subset checked-core mir)])))
      (sh13-c6p-result checked-core mir verification :not-applicable nil nil
        (get verification :diagnostics)))))

(defn sh13-verify-branch-join-execution-with-arguments [checked-core mir arguments candidate]
  (let [expected (sh13-run-branch-join-mir-with-arguments checked-core mir arguments)
        matches (= expected candidate)]
    {:artifact :gravity/sh13-branch-join-execution-verification :schema-version 1
     :status (if matches :passed :rejected)
     :input-bindings (sh13-branch-join-input-bindings checked-core mir)
     :arguments (get expected :arguments)
     :diagnostics (if matches []
                    [(sh12-branch-join-diagnostic
                       "C11-VERIFY" :execution-result-substitution checked-core mir)])}))

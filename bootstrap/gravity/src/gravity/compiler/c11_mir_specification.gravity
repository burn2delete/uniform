(defn verify-c11-mir-module [mir-module]
  (quote {:status :stage1-source-owned
          :mir-module mir-module
          :checks [:module-identity-complete
                   :checked-core-reference-present
                   :profile-and-target-request-attached
                   :every-function-has-entry-block
                   :every-block-terminates
                   :control-flow-edges-valid
                   :definitions-dominate-uses
                   :data-flow-edges-exposed
                   :types-match-operation-schemas
                   :effect-ordering-constraints-present
                   :safety-sensitive-operations-have-outcomes
                   :runtime-checks-dominate-guarded-operations
                   :source-and-generated-origins-valid
                   :ownership-resource-operations-match-c9-facts
                   :domain-anchors-valid
                   :target-specific-opcodes-rejected
                   :diagnostics-follow-c15-shape]
          :diagnostics c11-mir-diagnostic-catalog
          :preserves [:source-spans :syntax-identity
                      :checked-core-identity
                      :core-node-identity
                      :type-facts :effect-facts
                      :capability-facts :ownership-facts
                      :safe1-outcomes
                      :runtime-check-records
                      :proof-obligations
                      :profile-target-metadata
                      :source-origin-map
                      :generated-origin-chains
                      :control-flow-edges
                      :data-flow-edges
                      :dominance-facts
                      :domain-anchor-links
                      :target-independence
                      :artifact-provenance]}))

; This is the first executable C11 construction slice.  The bootstrap seed
; authenticates the checked-core artifact before this function is invoked;
; this module owns all checked-core-to-MIR classification and graph assembly.
; The slice deliberately accepts at most one conditional.  That gives the
; current literal/quote/local/do/if/let/str/println core a genuine
; entry/then/else/join CFG without pretending that arbitrary nested control
; flow or the full C11 operation-family matrix is already implemented.

(defn c11-vector-contains?
  [values value]
  (if (= (count values) 0)
    false
    (if (= (first values) value)
      true
      (c11-vector-contains? (rest values) value))))

(defn c11-conj-unique
  [values value]
  (if (c11-vector-contains? values value)
    values
    (conj values value)))

(defn c11-path-prefix?
  [prefix path]
  (if (= (count prefix) 0)
    true
    (if (= (count path) 0)
      false
      (if (= (first prefix) (first path))
        (c11-path-prefix? (rest prefix) (rest path))
        false))))

(defn c11-nodes-under-prefix
  [nodes prefix result]
  (if (= (count nodes) 0)
    result
    (let [node (first nodes)]
      (c11-nodes-under-prefix
       (rest nodes)
       prefix
       (if (c11-path-prefix? prefix (get node :path))
         (conj result node)
         result)))))

(defn c11-nodes-outside-prefixes
  [nodes left-prefix right-prefix result]
  (if (= (count nodes) 0)
    result
    (let [node (first nodes)
          path (get node :path)]
      (c11-nodes-outside-prefixes
       (rest nodes)
       left-prefix
       right-prefix
       (if (c11-path-prefix? left-prefix path)
         result
         (if (c11-path-prefix? right-prefix path)
           result
           (conj result node)))))))

(defn c11-if-count
  [nodes count]
  (if (= (count nodes) 0)
    count
    (c11-if-count
     (rest nodes)
     (if (= (get (first nodes) :source-operation) :if)
       (+ count 1)
       count))))

(defn c11-find-if-node
  [nodes]
  (if (= (count nodes) 0)
    nil
    (if (= (get (first nodes) :source-operation) :if)
      (first nodes)
      (c11-find-if-node (rest nodes)))))

(defn c11-node-depends-on-any?
  [operands ids]
  (if (= (count operands) 0)
    false
    (if (c11-vector-contains? ids (first operands))
      true
      (c11-node-depends-on-any? (rest operands) ids))))

(defn c11-expand-downstream-once
  [nodes ids result]
  (if (= (count nodes) 0)
    result
    (let [node (first nodes)
          node-id (get node :node-id)]
      (c11-expand-downstream-once
       (rest nodes)
       ids
       (if (c11-node-depends-on-any? (get node :operands) ids)
         (c11-conj-unique result node-id)
         result)))))

(defn c11-downstream-closure
  [nodes ids]
  (let [expanded (c11-expand-downstream-once nodes ids ids)]
    (if (= (count expanded) (count ids))
      ids
      (c11-downstream-closure nodes expanded))))

(defn c11-filter-node-ids
  [nodes ids include? result]
  (if (= (count nodes) 0)
    result
    (let [node (first nodes)
          present? (c11-vector-contains? ids (get node :node-id))]
      (c11-filter-node-ids
       (rest nodes)
       ids
       include?
       (if (= present? include?)
         (conj result node)
         result)))))

(defn c11-nodes-before-id
  [nodes node-id result]
  (if (= (count nodes) 0)
    result
    (if (= (get (first nodes) :node-id) node-id)
      result
      (c11-nodes-before-id
       (rest nodes) node-id (conj result (first nodes))))))

(defn c11-nodes-from-id
  [nodes node-id]
  (if (= (count nodes) 0)
    []
    (if (= (get (first nodes) :node-id) node-id)
      nodes
      (c11-nodes-from-id (rest nodes) node-id))))

(defn c11-node-ids
  [nodes result]
  (if (= (count nodes) 0)
    result
    (c11-node-ids (rest nodes)
                  (conj result (get (first nodes) :node-id)))))

(defn c11-find-node-by-id
  [nodes node-id]
  (if (= (count nodes) 0)
    nil
    (if (= (get (first nodes) :node-id) node-id)
      (first nodes)
      (c11-find-node-by-id (rest nodes) node-id))))

(defn c11-last-value
  [values]
  (if (= (count values) 1)
    (first values)
    (c11-last-value (rest values))))

(defn c11-opcode
  [node]
  (let [operation (get node :source-operation)]
    (if (= operation :literal)
      :constant
      (if (= operation :implicit-nil)
        :constant
        (if (= operation :quote)
          :constant
          (if (= operation :local)
            :local
            (if (= operation :let-binding)
              :local-binding
              (if (= operation :truthy)
                :truthiness
                (if (= operation :integer-eq)
                  :integer-eq
                  (if (= operation :integer-lt)
                    :integer-lt
                    (if (= operation :integer-lte)
                      :integer-lte
                      (if (= operation :integer-gt)
                        :integer-gt
                        (if (= operation :integer-gte)
                          :integer-gte
                          (if (= operation :do)
                  :sequence
                  (if (= operation :if)
                    :conditional-join
                    (if (= operation :let)
                      :lexical-scope
                      (if (= operation :str)
                        :call
                        (if (= operation :println)
                          :call
                          (if (= operation :function)
                            :function-boundary
                            :unsupported-checked-core-operation)))))))))))))))))))

(defn c11-operation-result
  [node]
  ; Gravity `println` returns nil.  Model that nil as an explicit SSA value so
  ; a resultless effect at function tail never creates an undefined return.
  (get node :node-id))

(defn c11-constant-payload
  [node]
  ; Constants must remain self-contained in MIR.  A type and an origin cannot
  ; distinguish 1 from 2 or true from false, so the authenticated payload is
  ; carried explicitly for every :constant operation and is unambiguously
  ; absent everywhere else.
  (if (= (c11-opcode node) :constant)
    {:present? true :value (get (get node :attributes) :value)}
    :not-applicable))

(defn c11-operation-ordering
  [node]
  (if (= (count (get (get node :attributes) :intrinsic-effects)) 0)
    :none
    :sequence))

(defn c11-copy-vector
  [values result]
  (if (= (count values) 0)
    result
    (c11-copy-vector (rest values) (conj result (first values)))))

(defn c11-runtime-check-operation-id
  [check]
  (str (get check :check-id) ":mir:runtime-check"))

(defn c11-runtime-check-token-id
  [check]
  (str (get check :check-id) ":mir:token"))

(defn c11-runtime-check-fact-id
  [check fact-kind]
  (let [check-id (get check :check-id)]
    (if (= fact-kind :type)
      (str check-id ":mir:type-fact")
      (if (= fact-kind :effect)
        (str check-id ":mir:effect-fact")
        (if (= fact-kind :capability)
          (str check-id ":mir:capability-fact")
          (if (= fact-kind :ownership)
            (str check-id ":mir:ownership-fact")
            (if (= fact-kind :safety)
              (str check-id ":mir:safety-outcome")
              (str check-id ":mir:profile-target-fact"))))))))

(defn c11-capability-fact-id
  [node-id]
  (str node-id ":capability-fact"))

(defn c11-safety-outcome-id
  [node-id]
  (str node-id ":safety-outcome"))

(defn c11-profile-target-fact-id
  [node-id]
  (str node-id ":profile-target-fact"))

(defn c11-operation-operands
  [node]
  (let [check (get (get node :safety) :check)]
    (if (= check nil)
      (get node :operands)
      (c11-copy-vector
       (get node :operands)
       [(c11-runtime-check-token-id check)]))))

(defn c11-operation-proof-certificate-ids
  [checked-core node]
  (let [node-id (get node :node-id)
        capability
        (get (get checked-core :capability-facts) node-id)
        capability-proof
        (get capability :capability-proof)
        capability-proof-ids (get capability-proof :proof-ids)
        safety-proof (get (get node :safety) :proof)
        safety-proof-id (get safety-proof :proof-id)
        result
        (if (= capability-proof-ids nil) [] capability-proof-ids)]
    (if (= safety-proof-id nil)
      result
      (conj result safety-proof-id))))

(defn c11-operation-facts
  [checked-core node]
  (let [node-id (get node :node-id)
        type-fact (get (get checked-core :type-facts) node-id)
        effect-fact (get (get checked-core :effect-facts) node-id)
        ownership-fact (get (get checked-core :ownership-facts) node-id)
        capability-fact (get (get checked-core :capability-facts) node-id)
        safety (get node :safety)
        runtime-check (get safety :check)
        capability-proof (get capability-fact :capability-proof)
        safety-proof (get safety :proof)]
    {:type-fact-id (get type-fact :fact-id)
     :effect-fact-id (get effect-fact :fact-id)
     :capability-fact-id (c11-capability-fact-id node-id)
     :capability-proof-ids
     (if (= (get capability-proof :proof-ids) nil)
       []
       (get capability-proof :proof-ids))
     :ownership-fact-id (get ownership-fact :fact-id)
     :safety-outcome-id (c11-safety-outcome-id node-id)
     :safety-proof-id
     (if (= (get safety-proof :proof-id) nil)
       :not-applicable
       (get safety-proof :proof-id))
     :profile-target-fact-id (c11-profile-target-fact-id node-id)
     :runtime-check-id
     (if (= runtime-check nil)
       :not-applicable
       (get runtime-check :check-id))
     :proof-certificate-ids
     (c11-operation-proof-certificate-ids checked-core node)
     :failure-behavior
     (if (= runtime-check nil)
       :not-applicable
       (get runtime-check :failure))
     :source-origin-id (get (get node :source) :origin-id)}))

(defn c11-build-runtime-check-table
  [nodes result]
  (if (= (count nodes) 0)
    result
    (let [node (first nodes)
          check (get (get node :safety) :check)]
      (c11-build-runtime-check-table
       (rest nodes)
       (if (= check nil)
         result
         (let [check-id (get check :check-id)]
           (assoc
            result check-id
            (assoc
             (assoc
              (assoc check :guarded-operation-id (get node :node-id))
              :check-operation-id (c11-runtime-check-operation-id check))
             :token-value-id (c11-runtime-check-token-id check)))))))))

(defn c11-build-fact-table-by-id
  [nodes source-table id-field generated-suffix result]
  (if (= (count nodes) 0)
    result
    (let [node (first nodes)
          node-id (get node :node-id)
          record (get source-table node-id)
          existing-id (get record id-field)
          fact-id
          (if (= existing-id nil)
            (str node-id generated-suffix)
            existing-id)]
      (c11-build-fact-table-by-id
       (rest nodes) source-table id-field generated-suffix
       (assoc result fact-id (assoc record id-field fact-id))))))

(defn c11-runtime-check-fact-record
  [checked-core node fact-kind]
  (let [node-id (get node :node-id)
        check (get (get node :safety) :check)
        fact-id (c11-runtime-check-fact-id check fact-kind)
        check-op-id (c11-runtime-check-operation-id check)
        token-id (c11-runtime-check-token-id check)
        origin-id (get (get node :source) :origin-id)
        profile (get node :profile)]
    (if (= fact-kind :type)
      {:fact-id fact-id
       :core-node-id node-id
       :mir-operation-id check-op-id
       :type-id :gravity/runtime-check-token
       :type :gravity/runtime-check-token
       :producer-rule :runtime-check-token
       :dependencies []
       :source-origin-id origin-id
       :profile profile
       :source-target (get checked-core :source-target)
       :constraints []
       :derived? true}
      (if (= fact-kind :effect)
        {:fact-id fact-id
         :core-node-id node-id
         :mir-operation-id check-op-id
         :direct #{}
         :latent #{}
         :transitive #{}
         :residual #{}
         :ordering :sequence
         :non-dce? true
         :source-origin-id origin-id
         :profile profile
         :source-target (get checked-core :source-target)
         :derived? true}
        (if (= fact-kind :capability)
          {:fact-id fact-id
           :core-node-id node-id
           :mir-operation-id check-op-id
           :required #{}
           :granted #{}
           :capability-proof-ids [(get check :capability-proof-id)]
           :authority-id (get check :authority-record-id)
           :source-origin-id origin-id
           :profile profile
           :source-target (get checked-core :source-target)
           :derived? true}
          (if (= fact-kind :ownership)
            {:fact-id fact-id
             :core-node-id node-id
             :mir-operation-id check-op-id
             :value-id token-id
             :role :runtime-check-token
             :storage :compiler-generated-token
             :model :non-resource-control-token
             :shareability :single-guard-use
             :mutation :forbidden
             :source-origin-id origin-id
             :profile profile
             :source-target (get checked-core :source-target)
             :derived? true}
            (if (= fact-kind :safety)
              {:outcome-id fact-id
               :artifact :gravity/safety-outcome
               :operation check-op-id
               :guarded-operation-id node-id
               :kind :runtime-check
               :profile profile
               :target (get checked-core :source-target)
               :outcome :runtime-checked
               :runtime-check (get check :check-id)
               :proof :not-applicable
               :failure-behavior (get check :failure)
               :source-origin-id origin-id
               :derived? true}
              {:fact-id fact-id
               :core-node-id node-id
               :mir-operation-id check-op-id
               :profile-fact (get (get checked-core :profile-facts) node-id)
               :profile profile
               :source-target (get checked-core :source-target)
               :target-request
               (get (get checked-core :target-request-metadata)
                    :requested-target)
               :derived? true})))))))

(defn c11-add-runtime-check-facts
  [checked-core nodes fact-kind result]
  (if (= (count nodes) 0)
    result
    (let [node (first nodes)
          check (get (get node :safety) :check)]
      (c11-add-runtime-check-facts
       checked-core
       (rest nodes)
       fact-kind
       (if (= check nil)
         result
         (assoc
          result
          (c11-runtime-check-fact-id check fact-kind)
          (c11-runtime-check-fact-record
           checked-core node fact-kind)))))))

(defn c11-build-profile-target-table
  [checked-core nodes result]
  (if (= (count nodes) 0)
    result
    (let [node (first nodes)
          node-id (get node :node-id)
          fact-id (c11-profile-target-fact-id node-id)]
      (c11-build-profile-target-table
       checked-core
       (rest nodes)
       (assoc
        result fact-id
        {:fact-id fact-id
         :core-node-id node-id
         :profile-fact (get (get checked-core :profile-facts) node-id)
         :profile (get node :profile)
         :source-target (get checked-core :source-target)
         :target-request
         (get (get checked-core :target-request-metadata)
              :requested-target)})))))

(defn c11-build-capability-proof-table
  [proofs result]
  (if (= (count proofs) 0)
    result
    (let [proof (first proofs)]
      (c11-build-capability-proof-table
       (rest proofs)
       (assoc result (get proof :proof-id) proof)))))

(defn c11-build-safety-proof-table
  [nodes result]
  (if (= (count nodes) 0)
    result
    (let [node (first nodes)
          proof (get (get node :safety) :proof)
          proof-id (get proof :proof-id)]
      (c11-build-safety-proof-table
       (rest nodes)
       (if (= proof-id nil)
         result
         (assoc result proof-id proof))))))

(defn c11-runtime-check-source
  [node check]
  (let [source (get node :source)]
    {:origin-id (get source :origin-id)
     :span (get source :span)
     :enclosing-syntax-origin-id
     (get source :enclosing-syntax-origin-id)
     :generated? true
     :generated-origin
     [{:role :runtime-check-generated
       :producer-operation-id (get node :node-id)
       :runtime-check-id (get check :check-id)}]}))

(defn c11-build-runtime-check-operation
  [checked-core node block-id]
  (let [node-id (get node :node-id)
        check (get (get node :safety) :check)
        check-id (get check :check-id)]
    {:artifact :gravity/mir-operation
     :op-id (c11-runtime-check-operation-id check)
     :opcode :runtime-check
     :source-operation :runtime-check
     :operands []
     :result (c11-runtime-check-token-id check)
     :result-kind :runtime-check-token
     :constant-payload :not-applicable
     :type :gravity/runtime-check-token
     :effects #{}
     :capabilities #{}
     :ordering :sequence
     :source (c11-runtime-check-source node check)
     :profile (get node :profile)
     :facts
     {:type-fact-id (c11-runtime-check-fact-id check :type)
      :effect-fact-id (c11-runtime-check-fact-id check :effect)
      :capability-fact-id
      (c11-runtime-check-fact-id check :capability)
      :capability-proof-ids [(get check :capability-proof-id)]
      :ownership-fact-id
      (c11-runtime-check-fact-id check :ownership)
      :safety-outcome-id (c11-runtime-check-fact-id check :safety)
      :safety-proof-id :not-applicable
      :profile-target-fact-id
      (c11-runtime-check-fact-id check :profile-target)
      :runtime-check-id check-id
      :proof-certificate-ids [(get check :capability-proof-id)]
      :guarded-operation-id node-id
      :failure-behavior (get check :failure)
      :source-origin-id (get (get node :source) :origin-id)}
     :domain-anchor nil
     :block-id block-id
     :verifier-status :pending}))

(defn c11-build-operation
  [checked-core node block-id]
  (let [attributes (get node :attributes)]
    {:artifact :gravity/mir-operation
     :op-id (get node :node-id)
     :opcode (c11-opcode node)
     :source-operation (get node :source-operation)
     :operands (c11-operation-operands node)
     :result (c11-operation-result node)
     :result-kind (if (= (get node :type) :gravity/nil) :unit :value)
     :constant-payload (c11-constant-payload node)
     :type (get node :type)
     ; Containers carry aggregate child summaries in checked core.  MIR direct
     ; effects/capabilities come only from the intrinsic operation; the full
     ; aggregate records remain linked through :facts.
     :effects (get attributes :intrinsic-effects)
     :capabilities (get attributes :intrinsic-capabilities)
     :ordering (c11-operation-ordering node)
     :source (get node :source)
     :profile (get node :profile)
     :facts (c11-operation-facts checked-core node)
     :domain-anchor nil
     :block-id block-id
     :verifier-status :pending}))

(defn c11-build-operations
  [checked-core nodes block-id result]
  (if (= (count nodes) 0)
    result
    (let [node (first nodes)
          check (get (get node :safety) :check)
          with-check
          (if (= check nil)
            result
            (conj result
                  (c11-build-runtime-check-operation
                   checked-core node block-id)))]
      (c11-build-operations
       checked-core
       (rest nodes)
       block-id
       (conj with-check
             (c11-build-operation checked-core node block-id))))))

(defn c11-build-data-flow-for-operands
  [operands consumer consumer-block operand-index result]
  (if (= (count operands) 0)
    result
    (c11-build-data-flow-for-operands
     (rest operands)
     consumer
     consumer-block
     (+ operand-index 1)
     (conj result
           {:from (first operands)
            :consumer-kind :operation
            :consumer-id consumer
            :consumer-block consumer-block
            :operand-index operand-index
            :edge-kind :operand}))))

(defn c11-build-data-flow-for-node
  [node consumer-block result]
  (let [check (get (get node :safety) :check)
        node-id (get node :node-id)]
    (if (= check nil)
      (c11-build-data-flow-for-operands
       (get node :operands) node-id consumer-block 0 result)
      (c11-build-data-flow-for-operands
       (get node :operands)
       node-id
       consumer-block
       1
       (conj
        result
        {:from (c11-runtime-check-token-id check)
         :consumer-kind :operation
         :consumer-id node-id
         :consumer-block consumer-block
         :operand-index 0
         :edge-kind :runtime-check-guard})))))

(defn c11-node-block-id
  [node if-id then-ids else-ids downstream-ids
   entry-id then-id else-id join-id]
  (let [node-id (get node :node-id)]
    (if (c11-vector-contains? then-ids node-id)
      then-id
      (if (c11-vector-contains? else-ids node-id)
        else-id
        (if (= node-id if-id)
          join-id
          (if (c11-vector-contains? downstream-ids node-id)
            join-id
            entry-id))))))

(defn c11-build-data-flow
  [nodes if-id then-ids else-ids downstream-ids
   entry-id then-id else-id join-id result]
  (if (= (count nodes) 0)
    result
    (let [node (first nodes)
          block-id
          (c11-node-block-id
           node if-id then-ids else-ids downstream-ids
           entry-id then-id else-id join-id)]
      (c11-build-data-flow
       (rest nodes) if-id then-ids else-ids downstream-ids
       entry-id then-id else-id join-id
       (c11-build-data-flow-for-node node block-id result)))))

(defn c11-build-definitions
  [nodes if-id then-ids else-ids downstream-ids
   entry-id then-id else-id join-id result]
  (if (= (count nodes) 0)
    result
    (let [node (first nodes)
          node-id (get node :node-id)
          block-id
          (c11-node-block-id
           node if-id then-ids else-ids downstream-ids
           entry-id then-id else-id join-id)]
      (let [check (get (get node :safety) :check)
            with-check
            (if (= check nil)
              result
              (assoc
               result
               (c11-runtime-check-token-id check)
               {:value-id (c11-runtime-check-token-id check)
                :operation-id (c11-runtime-check-operation-id check)
                :block-id block-id}))]
       (c11-build-definitions
       (rest nodes) if-id then-ids else-ids downstream-ids
       entry-id then-id else-id join-id
       (if (= (c11-operation-result node) nil)
         with-check
         (assoc with-check node-id
                {:value-id node-id
                 :operation-id node-id
                 :block-id block-id})))))))

(defn c11-uses-for-value
  [edges value-id result]
  (if (= (count edges) 0)
    result
    (let [edge (first edges)]
      (c11-uses-for-value
       (rest edges)
       value-id
       (if (= (get edge :from) value-id)
         (conj result
               {:use-kind :instruction
                :consumer-kind (get edge :consumer-kind)
                :consumer-id (get edge :consumer-id)
                :consumer-block (get edge :consumer-block)
                :operand-index (get edge :operand-index)
                :edge-kind (get edge :edge-kind)})
         result)))))

(defn c11-terminator-uses-for-value
  [uses value-id result]
  (if (= (count uses) 0)
    result
    (let [use (first uses)]
      (c11-terminator-uses-for-value
       (rest uses)
       value-id
       (if (= (get use :value-id) value-id)
         (conj result
               {:use-kind :terminator
                :consumer-kind (get use :consumer-kind)
                :consumer-id (get use :consumer-id)
                :consumer-block (get use :consumer-block)
                :operand-index (get use :operand-index)
                :edge-kind (get use :edge-kind)})
         result)))))

(defn c11-append-uses
  [left right]
  (if (= (count right) 0)
    left
    (c11-append-uses (conj left (first right)) (rest right))))

(defn c11-build-values
  [nodes data-flow definitions terminator-uses result]
  (if (= (count nodes) 0)
    result
    (let [node (first nodes)
          value-id (get node :node-id)]
      (let [check (get (get node :safety) :check)
            token-id
            (if (= check nil) nil (c11-runtime-check-token-id check))
            with-check
            (if (= check nil)
              result
              (assoc
               result token-id
               {:artifact :gravity/mir-value
                :value-id token-id
                :kind :runtime-check-token
                :type :gravity/runtime-check-token
                :constant-payload :not-applicable
                :defined-by (get definitions token-id)
                :uses (c11-uses-for-value data-flow token-id [])
                :source (c11-runtime-check-source node check)
                :ownership :not-applicable
                :effects #{}
                :safety
                {:outcome :runtime-check-token
                 :runtime-check-id (get check :check-id)
                 :guarded-operation-id (get node :node-id)}}))]
       (c11-build-values
       (rest nodes)
       data-flow
       definitions
       terminator-uses
       (if (= (c11-operation-result node) nil)
         with-check
         (assoc with-check value-id
                {:artifact :gravity/mir-value
                 :value-id value-id
                 :kind :instruction-result
                 :type (get node :type)
                 :constant-payload (c11-constant-payload node)
                 :defined-by (get definitions value-id)
                 :uses
                 (c11-append-uses
                  (c11-uses-for-value data-flow value-id [])
                  (c11-terminator-uses-for-value
                   terminator-uses value-id []))
                 :source (get node :source)
                 :ownership (get node :ownership)
                 :effects (get node :effects)
                 :safety (get node :safety)})))))))

(defn c11-build-source-map
  [nodes result]
  (if (= (count nodes) 0)
    result
    (let [node (first nodes)]
      (let [check (get (get node :safety) :check)
            with-check
            (if (= check nil)
              result
              (assoc
               result
               (c11-runtime-check-operation-id check)
               (c11-runtime-check-source node check)))]
        (c11-build-source-map
         (rest nodes)
         (assoc with-check (get node :node-id) (get node :source)))))))

(defn c11-build-terminator
  [terminator-id kind operands successors effects source profile facts]
  {:artifact :gravity/mir-terminator
   :terminator-id terminator-id
   :kind kind
   :operands operands
   :successors successors
   :effects effects
   :ordering (if (= (count effects) 0) :none :sequence)
   :source source
   :profile profile
   :facts facts
   :verifier-status :pending})

(defn c11-build-block
  [block-id arguments instructions terminator predecessors successors
   dominators source]
  {:artifact :gravity/mir-block
   :block-id block-id
   :arguments arguments
   :instructions instructions
   :terminator terminator
   :predecessors predecessors
   :successors successors
   :dominators dominators
   :data-flow {:module-data-flow-graph-reference true}
   :source source})

(defn c11-build-linear-mir
  [checked-core nodes return-value-id]
  (let [artifact-id (get checked-core :artifact-id)
        entry-id (str artifact-id ":mir:entry")
        operations (c11-build-operations checked-core nodes entry-id [])
        data-flow
        (c11-build-data-flow
         nodes nil [] [] [] entry-id entry-id entry-id entry-id [])
        definitions
        (c11-build-definitions
         nodes nil [] [] [] entry-id entry-id entry-id entry-id {})
        terminator-id (str entry-id ":return")
        terminator-uses
        [{:value-id return-value-id
          :consumer-kind :terminator
          :consumer-id terminator-id
          :consumer-block entry-id
          :operand-index 0
          :edge-kind :return-value}]
        source (get (first nodes) :source)
        terminator
        (c11-build-terminator
         terminator-id :return [return-value-id] [] #{}
         source (get checked-core :profile)
         {:returned-value return-value-id})
        block
        (c11-build-block entry-id [] operations terminator [] [] [entry-id]
                         source)]
    {:entry entry-id
     :blocks {entry-id block}
     :edges []
     :dominance {entry-id [entry-id]}
     :data-flow data-flow
     :definitions definitions
     :terminator-uses terminator-uses
     :values
     (c11-build-values nodes data-flow definitions terminator-uses {})
     :source-map (c11-build-source-map nodes {})
     :conditional-count 0}))

(defn c11-build-conditional-mir
  [checked-core nodes if-node return-value-id]
  (let [artifact-id (get checked-core :artifact-id)
        if-id (get if-node :node-id)
        if-path (get if-node :path)
        then-prefix (conj if-path :then)
        else-prefix (conj if-path :else)
        then-nodes (c11-nodes-under-prefix nodes then-prefix [])
        else-nodes (c11-nodes-under-prefix nodes else-prefix [])
        outside-nodes
        (c11-nodes-outside-prefixes nodes then-prefix else-prefix [])
        ; Checked core is already in authenticated canonical execution order.
        ; Branch-prefix nodes remain branch-local; outside nodes before the if
        ; execute in entry, while the if and every outside continuation node
        ; after it remain in join.  Dependency reachability alone cannot hoist
        ; an effectful continuation before its controlling conditional.
        entry-nodes (c11-nodes-before-id outside-nodes if-id [])
        downstream-nodes (c11-nodes-from-id outside-nodes if-id)
        downstream-ids (c11-node-ids downstream-nodes [])
        entry-id (str artifact-id ":mir:entry")
        then-id (str artifact-id ":mir:then")
        else-id (str artifact-id ":mir:else")
        join-id (str artifact-id ":mir:join")
        if-operands (get if-node :operands)
        condition-id (first if-operands)
        then-result-id (second if-operands)
        else-result-id (first (rest (rest if-operands)))
        entry-operations
        (c11-build-operations checked-core entry-nodes entry-id [])
        then-operations
        (c11-build-operations checked-core then-nodes then-id [])
        else-operations
        (c11-build-operations checked-core else-nodes else-id [])
        join-operations
        (c11-build-operations checked-core downstream-nodes join-id [])
        source (get if-node :source)
        entry-terminator
        (c11-build-terminator
         (str entry-id ":conditional") :conditional-branch [condition-id]
         ; Branch selection itself is pure.  The checked-core `if` carries an
         ; aggregate child-effect summary, which remains available through the
         ; linked fact tables instead of being duplicated as a terminator
         ; effect/order obligation.
         [then-id else-id] #{} source
         (get checked-core :profile)
         {:condition condition-id :join join-id})
        then-terminator
        (c11-build-terminator
         (str then-id ":branch") :branch [then-result-id] [join-id] #{}
         source (get checked-core :profile)
         {:incoming-value then-result-id})
        else-terminator
        (c11-build-terminator
         (str else-id ":branch") :branch [else-result-id] [join-id] #{}
         source (get checked-core :profile)
         {:incoming-value else-result-id})
        join-terminator
        (c11-build-terminator
         (str join-id ":return") :return [return-value-id] [] #{}
         source (get checked-core :profile)
         {:returned-value return-value-id})
        terminator-uses
        [{:value-id condition-id
          :consumer-kind :terminator
          :consumer-id (str entry-id ":conditional")
          :consumer-block entry-id
          :operand-index 0
          :edge-kind :condition}
         {:value-id then-result-id
          :consumer-kind :terminator
          :consumer-id (str then-id ":branch")
          :consumer-block then-id
          :operand-index 0
          :edge-kind :branch-value}
         {:value-id else-result-id
          :consumer-kind :terminator
          :consumer-id (str else-id ":branch")
          :consumer-block else-id
          :operand-index 0
          :edge-kind :branch-value}
         {:value-id return-value-id
          :consumer-kind :terminator
          :consumer-id (str join-id ":return")
          :consumer-block join-id
          :operand-index 0
          :edge-kind :return-value}]
        blocks
        {entry-id
         (c11-build-block entry-id [] entry-operations entry-terminator []
                          [then-id else-id] [entry-id] source)
         then-id
         (c11-build-block then-id [] then-operations then-terminator [entry-id]
                          [join-id] [entry-id then-id] source)
         else-id
         (c11-build-block else-id [] else-operations else-terminator [entry-id]
                          [join-id] [entry-id else-id] source)
        join-id
        (c11-build-block
          ; The explicit :conditional-join operation is the sole SSA
          ; definition for `if-id`.  Incoming predecessor/value pairing stays
          ; in CFG :join metadata, avoiding a second block-argument/phi
          ; definition of the same value.
          join-id []
          join-operations join-terminator [then-id else-id] []
          [entry-id join-id] source)}
        then-ids
        (c11-node-ids then-nodes [])
        else-ids
        (c11-node-ids else-nodes [])
        data-flow
        (c11-build-data-flow
         nodes if-id then-ids else-ids downstream-ids
         entry-id then-id else-id join-id [])
        definitions
        (c11-build-definitions
         nodes if-id then-ids else-ids downstream-ids
         entry-id then-id else-id join-id {})]
    {:entry entry-id
     :blocks blocks
     :edges [{:from entry-id :to then-id :kind :true}
             {:from entry-id :to else-id :kind :false}
             {:from then-id :to join-id :kind :join}
             {:from else-id :to join-id :kind :join}]
     :dominance {entry-id [entry-id]
                 then-id [entry-id then-id]
                 else-id [entry-id else-id]
                 join-id [entry-id join-id]}
     :data-flow data-flow
     :definitions definitions
     :terminator-uses terminator-uses
     :values
     (c11-build-values nodes data-flow definitions terminator-uses {})
     :source-map (c11-build-source-map nodes {})
     :conditional-count 1
     :join {:block-id join-id
            :value-id if-id
            :incoming
            [{:predecessor then-id :value then-result-id}
             {:predecessor else-id :value else-result-id}]}}))

(defn c11-build-target-independent-mir
  [checked-core]
  (let [nodes (get checked-core :core-nodes)
        root-node-id (first (get checked-core :root-node-ids))
        root-node (c11-find-node-by-id nodes root-node-id)
        return-value-id (c11-last-value (get root-node :operands))
        return-node (c11-find-node-by-id nodes return-value-id)
        conditional-count (c11-if-count nodes 0)
        graph
        (if (= conditional-count 0)
          (c11-build-linear-mir checked-core nodes return-value-id)
          (if (= conditional-count 1)
            (c11-build-conditional-mir
             checked-core nodes (c11-find-if-node nodes) return-value-id)
            {:status :rejected
             :diagnostic "C11-BLOCK"
             :missing-fact :bounded-single-conditional-cfg
             :conditional-count conditional-count}))]
    (if (= (get graph :status) :rejected)
      graph
      {:artifact :gravity/mir-module
       :schema-version 1
       :source-core (get checked-core :artifact-id)
       :module-id (get (get checked-core :source-core-input) :module)
       :profile (get checked-core :profile)
       :source-target (get checked-core :source-target)
       :target-request
       (get (get checked-core :target-request-metadata) :requested-target)
       :target-request-metadata (get checked-core :target-request-metadata)
       :functions
       {(get checked-core :entrypoint)
        {:artifact :gravity/mir-function
         :fn-id root-node-id
         :name (get checked-core :entrypoint)
         :params []
         :returns (get return-node :type)
         :latent-effects
         (get (get checked-core :source-core-input) :declared-effects)
         :capabilities
         (get (get checked-core :source-core-input) :declared-capabilities)
         :blocks (get graph :blocks)
         :entry (get graph :entry)
         :source
         (get (get graph :source-map) root-node-id)
         :facts
         {:type-fact-id
          (get (get (get checked-core :type-facts) root-node-id) :fact-id)
          :effect-fact-id
          (get (get (get checked-core :effect-facts) root-node-id) :fact-id)
          :ownership-fact-id
          (get (get (get checked-core :ownership-facts) root-node-id)
               :fact-id)
          :safety-outcome-id (c11-safety-outcome-id root-node-id)
          :profile-target-fact-id
          (c11-profile-target-fact-id root-node-id)}
         :provenance
         {:checked-core-artifact-id (get checked-core :artifact-id)
          :core-node-id root-node-id}}}
       :globals {}
       :control-flow-graph
       {:entry (get graph :entry)
        :edges (get graph :edges)
        :dominance (get graph :dominance)
        :join (get graph :join)}
       :data-flow-graph
       {:edges (get graph :data-flow)
        :terminator-uses (get graph :terminator-uses)
        :definitions (get graph :definitions)
        :values (get graph :values)}
       :type-table
       (c11-add-runtime-check-facts
        checked-core nodes :type
        (c11-build-fact-table-by-id
         nodes (get checked-core :type-facts) :fact-id ":type-fact" {}))
       :effect-table
       (c11-add-runtime-check-facts
        checked-core nodes :effect
        (c11-build-fact-table-by-id
         nodes (get checked-core :effect-facts) :fact-id ":effect-fact" {}))
       :effect-order-graph (get checked-core :effect-graph)
       :ownership-table
       (c11-add-runtime-check-facts
        checked-core nodes :ownership
        (c11-build-fact-table-by-id
         nodes (get checked-core :ownership-facts)
         :fact-id ":ownership-fact" {}))
       :capability-table
       (c11-add-runtime-check-facts
        checked-core nodes :capability
        (c11-build-fact-table-by-id
         nodes (get checked-core :capability-facts)
         :fact-id ":capability-fact" {}))
       :capability-proof-table
       (c11-build-capability-proof-table
        (get checked-core :capability-proof-records) {})
       :safety-table
       (c11-add-runtime-check-facts
        checked-core nodes :safety
        (c11-build-fact-table-by-id
         nodes (get checked-core :safety-facts)
         :outcome-id ":safety-outcome" {}))
       :profile-target-table
       (c11-add-runtime-check-facts
        checked-core nodes :profile-target
        (c11-build-profile-target-table checked-core nodes {}))
       :runtime-check-table (c11-build-runtime-check-table nodes {})
       :proof-certificate-table
       {:capability-proof-table-reference :capability-proof-table
        :safety-proofs (c11-build-safety-proof-table nodes {})}
       :source-map (get graph :source-map)
       :domain-anchors {}
       :diagnostics []
       :provenance
       {:checked-core-artifact-id (get checked-core :artifact-id)
        :checked-core-mapping-id (get checked-core :mapping-id)
       :checked-core-provenance-binding-id
        (get checked-core :provenance-binding-id)
        :checked-core-origin-closure-binding-id
        (get checked-core :provenance-binding-id)}
       :construction
       {:owner :gravity-source
        :function :c11-build-target-independent-mir
        :status :constructed}
       :pass-contract (c11-build-mir-pass-contract)
       :pass-execution-record
       {:artifact :gravity/build-mir-pass-execution-record
        :pass-id :c11-build-mir-bounded-slice
        :pass-contract-hash :pending-source-binding
        :input-artifact-id (get checked-core :artifact-id)
        :output-content-id :pending-independent-verifier
        :verifier-report-id :pending-independent-verifier
        :verifier-report-hash :pending-independent-verifier
        :diagnostics []
        :status :constructed-unverified
        :record-id :pending-independent-verifier}
       :verification-status :pending
       :target-independent? true
       :b1-preflight
       {:input-kind :gravity/mir
        :requires-verifier-status :passed
        :status :pending-c11-verifier
        :backend-credit? false}
       :scope
       {:operation-set
        [:literal :implicit-nil :quote :local :let-binding :truthy
         :integer-eq :integer-lt :integer-lte :integer-gt :integer-gte
         :do :if :let :str :println :function
         :runtime-check]
        :maximum-conditionals 1
        :maximum-module-carrier-nodes 16384
        :maximum-final-artifact-carrier-nodes 32768
        :maximum-carrier-depth 256
        :whole-c11? false
        :domain-ir-credit? false
        :optimization-credit? false
        :target-lowering-credit? false
        :backend-credit? false
        :llvm-credit? false
        :release-credit? false
        :whole-language? false
        :self-hosted? false}
       :clojure-seed-boundary? true
       :self-hosted? false})))

; SH-13 bounded executable function and control-flow leaf. Authenticated SH-12
; adaptation remains pending; this engine consumes normalized verified MIR.

(defn sh13-control-flow-policy []
  {:artifact :gravity/sh13-control-flow-policy
   :version 1
   :maximum-functions 32
   :maximum-blocks-per-function 32
   :maximum-operations-per-block 64
   :maximum-parameters 8
   :maximum-call-depth 32
   :maximum-execution-steps 512
   :operation-set #{:const :add :sub :mul :eq :lt :call}
   :terminator-set
   #{:return :error-return :throw :panic
     :branch :conditional-branch}
   :dispatch-set #{:direct :indirect}
   :clojure-seed-boundary? true
   :self-hosted? false
   :diagnostics #{"C11-MODULE" "C11-BLOCK" "C11-DOMINANCE"
                  "C11-TYPE" "C11-EFFECT" "C11-ORIGIN"
                  "C11-VERIFY"}
   :pending [:authenticated-sh12-mir-input
             :closures-and-captured-environments
             :mutual-recursion-analysis
             :dynamic-and-vtable-dispatch
             :whole-c11-operation-set
             :seedless-runtime-execution]})

(defn sh13-member? [values value]
  (= (get values value) value))

(defn sh13-source-span-valid? [source-span]
  (if (map? source-span)
    (if (= (set (keys source-span)) #{:source-id :start :end})
      (if (= nil (get source-span :source-id))
        false
        (if (integer? (get source-span :start))
          (if (integer? (get source-span :end))
            (if (<= 0 (get source-span :start))
              (<= (get source-span :start) (get source-span :end))
              false)
            false)
          false))
      false)
    false))

(defn sh13-origin-entry-valid? [origin]
  (if (map? origin)
    (if (= (set (keys origin)) #{:kind :source-id})
      (if (= nil (get origin :kind))
        false
        (if (= nil (get origin :source-id)) false true))
      false)
    false))

(defn sh13-origin-entries-valid? [origin-chain index]
  (if (= index (count origin-chain))
    true
    (if (sh13-origin-entry-valid? (get origin-chain index))
      (sh13-origin-entries-valid? origin-chain (+ index 1))
      false)))

(defn sh13-origin-chain-valid? [origin-chain]
  (if (vector? origin-chain)
    (if (> (count origin-chain) 0)
      (if (<= (count origin-chain) 16)
        (sh13-origin-entries-valid? origin-chain 0)
        false)
      false)
    false))

(defn sh13-i64? [value]
  (if (integer? value)
    (if (<= -9223372036854775808 value)
      (<= value 9223372036854775807)
      false)
    false))

(defn sh13-unique-by-key?
  [records key index seen]
  (if (= index (count records))
    true
    (let [value (get (get records index) key)]
      (if (= nil value)
        false
        (if (contains? seen value)
          false
          (sh13-unique-by-key?
           records key (+ index 1) (conj seen value)))))))

(defn sh13-find-by-key [records key value index]
  (if (= index (count records))
    nil
    (if (= value (get (get records index) key))
      (get records index)
      (sh13-find-by-key records key value (+ index 1)))))

(defn sh13-function [module function-id]
  (sh13-find-by-key (get module :functions) :fn-id function-id 0))

(defn sh13-block [function block-id]
  (sh13-find-by-key (get function :blocks) :block-id block-id 0))

(defn sh13-set-subset? [values allowed]
  (if (= 0 (count values))
    true
    (if (contains? allowed (first values))
      (sh13-set-subset? (rest values) allowed)
      false)))

(defn sh13-present? [value]
  (if (= nil value)
    false
    true))

(defn sh13-vector-values-present?
  [values available index]
  (if (= index (count values))
    true
    (if (contains? available (get values index))
      (sh13-vector-values-present? values available (+ index 1))
      false)))

(defn sh13-bind-values [names values index result]
  (if (= index (count names))
    result
    (sh13-bind-values
     names values (+ index 1)
     (assoc result (get names index) (get values index)))))

(defn sh13-types-by-name [names types index result]
  (if (= index (count names))
    result
    (sh13-types-by-name
     names types (+ index 1)
     (assoc result (get names index) (get types index)))))

(defn sh13-operation-common-valid? [operation]
  (if (map? operation)
    (if (= nil (get operation :op-id))
      false
      (if
       (sh13-member?
        #{:const :add :sub :mul :eq :lt :call}
        (get operation :opcode))
       (if (vector? (get operation :operands))
         (if (= nil (get operation :type))
           false
           (if (= (get operation :result) (get operation :op-id))
             (if (set? (get operation :effects))
               (if (= :passed (get operation :verifier-status))
                 (if (map? (get operation :facts))
                   (if (sh13-operation-facts-valid?
                        (get operation :facts))
                     (if (sh13-source-span-valid?
                          (get operation :source-span))
                       (sh13-origin-chain-valid?
                        (get operation :origin-chain))
                       false)
                     false)
                   false)
                 false)
               false)
             false))
         false)
       false))
    false))

(defn sh13-operation-facts-valid? [facts]
  (if (= (set (keys facts))
         #{:type :effect :ownership :capability :safety})
    (if (= nil (get facts :type))
      false
      (if (= nil (get facts :effect))
        false
        (if (= nil (get facts :ownership))
          false
          (if (= nil (get facts :capability))
            false
            (if (= nil (get facts :safety)) false true)))))
    false))

(defn sh13-operation-facts-match-module? [module operation]
  (let [facts (get operation :facts)]
    (if (= (get facts :type) (get module :type-table-id))
      (if (= (get facts :effect) (get module :effect-table-id))
        (if (= (get facts :ownership)
               (get module :ownership-table-id))
          (if (= (get facts :capability)
                 (get module :capability-table-id))
            (= (get facts :safety) (get module :safety-table-id))
            false)
          false)
        false)
      false)))

(defn sh13-operation-effect-order-valid? [operation]
  (if (> (count (get operation :effects)) 0)
    (= :sequence (get operation :ordering))
    (= nil (get operation :ordering))))

(defn sh13-operation-effect-family-valid? [operation]
  (if (= :call (get operation :opcode))
    true
    (= 0 (count (get operation :effects)))))

(defn sh13-literal-type-valid? [operation]
  (if (= :const (get operation :opcode))
    (if (= :i64 (get operation :type))
      (sh13-i64? (get operation :literal))
      (if (= :bool (get operation :type))
        (sh13-member? #{true false} (get operation :literal))
        (if (= :keyword (get operation :type))
          (keyword? (get operation :literal))
          false)))
    true))

(defn sh13-call-error [module function operation]
  (if (= :call (get operation :opcode))
    (let [callee (sh13-function module (get operation :callee))
          dispatch (get operation :dispatch)]
      (if (= nil callee)
        :verify
        (if (sh13-member? #{:direct :indirect} dispatch)
          (if (= dispatch :indirect)
            (if (set? (get operation :allowed-callees))
              (if (> (count (get operation :allowed-callees)) 0)
                (if
                 (sh13-allowed-callees-valid?
                  module (get operation :allowed-callees))
                  (if (contains?
                       (get operation :allowed-callees)
                       (get operation :callee))
                    (if (= (get operation :callee)
                           (get function :fn-id))
                      (if (= true (get function :recursive))
                        nil
                        :verify)
                      nil)
                    :verify)
                  :verify)
                :verify)
              :verify)
            (if (set? (get operation :allowed-callees))
              (if (= 0 (count (get operation :allowed-callees)))
                (if (= (get operation :callee) (get function :fn-id))
                  (if (= true (get function :recursive)) nil :verify)
                  nil)
                :verify)
              :verify))
          :verify)))
    nil))

(defn sh13-allowed-callees-valid? [module callees]
  (if (= 0 (count callees))
    true
    (if
     (sh13-present? (sh13-function module (first callees)))
      (sh13-allowed-callees-valid? module (rest callees))
      false)))

(defn sh13-call-argument-types-error
  [operands parameter-types types index]
  (if (= index (count operands))
    nil
    (if (= (get types (get operands index))
           (get parameter-types index))
      (sh13-call-argument-types-error
       operands parameter-types types (+ index 1))
      :type)))

(defn sh13-call-signature-error [module function operation types]
  (if (= :call (get operation :opcode))
    (let [callee (sh13-function module (get operation :callee))]
      (if (= nil callee)
        :verify
        (if (= (count (get operation :operands))
               (count (get callee :params)))
          (let [argument-error
                (sh13-call-argument-types-error
                 (get operation :operands)
                 (get callee :param-types)
                 types 0)]
            (if (= nil argument-error)
              (if (= (get operation :type) (get callee :return-type))
                (if (= (get operation :effects)
                       (get callee :latent-effects))
                  (if
                   (sh13-set-subset?
                    (get callee :latent-effects)
                    (get function :latent-effects))
                    nil
                    :effect)
                  :effect)
                :type)
              argument-error))
          :type)))
    nil))

(defn sh13-operation-type-error
  [module function operation types]
  (let [opcode (get operation :opcode)
        operands (get operation :operands)]
    (if (= opcode :const)
      (if (sh13-literal-type-valid? operation) nil :type)
      (if (= opcode :call)
        (sh13-call-signature-error module function operation types)
        (if (sh13-member? #{:add :sub :mul} opcode)
          (if (= 2 (count operands))
            (if (= :i64 (get types (get operands 0)))
              (if (= :i64 (get types (get operands 1)))
                (if (= :i64 (get operation :type)) nil :type)
                :type)
              :type)
            :type)
          (if (= :eq opcode)
            (if (= 2 (count operands))
              (if (= (get types (get operands 0))
                     (get types (get operands 1)))
                (if (= :bool (get operation :type)) nil :type)
                :type)
              :type)
            (if (= :lt opcode)
              (if (= 2 (count operands))
                (if (= :i64 (get types (get operands 0)))
                  (if (= :i64 (get types (get operands 1)))
                    (if (= :bool (get operation :type)) nil :type)
                    :type)
                  :type)
                :type)
              :type)))))))

(defn sh13-operations-error
  [module function operations index available types]
  (if (= index (count operations))
    nil
    (let [operation (get operations index)
          operation-id (get operation :op-id)]
      (if (sh13-operation-common-valid? operation)
        (if (= (get operation :profile) (get module :profile))
          (if (sh13-operation-facts-match-module? module operation)
            (if (contains? available operation-id)
          :dominance
          (if (sh13-operation-effect-family-valid? operation)
            (if (sh13-operation-effect-order-valid? operation)
            (if
             (sh13-vector-values-present?
              (get operation :operands) available 0)
              (if
               (sh13-set-subset?
                (get operation :effects)
                (get function :latent-effects))
                (let [call-error
                      (sh13-call-error module function operation)
                      type-error
                      (sh13-operation-type-error
                       module function operation types)]
                  (if (= nil call-error)
                    (if (= nil type-error)
                      (sh13-operations-error
                       module function operations (+ index 1)
                       (conj available operation-id)
                       (assoc types operation-id (get operation :type)))
                      type-error)
                    call-error))
                :effect)
              :dominance)
            :effect)
            :effect))
            :verify)
          :module)
        :origin))))

(defn sh13-block-available [block]
  (set (get block :params)))

(defn sh13-block-types [block]
  (sh13-types-by-name
   (get block :params) (get block :param-types) 0 {}))

(defn sh13-block-result-types [block index result]
  (if (= index (count (get block :operations)))
    result
    (let [operation (get (get block :operations) index)]
      (sh13-block-result-types
       block (+ index 1)
       (assoc result (get operation :op-id) (get operation :type))))))

(defn sh13-target-arguments-error
  [function target-id arguments types]
  (let [target (sh13-block function target-id)]
    (if (= nil target)
      :block
      (if (= (count arguments) (count (get target :params)))
        (if (sh13-vector-values-present?
             arguments (set (keys types)) 0)
          (sh13-target-argument-types-error
           arguments (get target :param-types) types 0)
          :dominance)
        :type))))

(defn sh13-target-argument-types-error
  [arguments target-types types index]
  (if (= index (count arguments))
    nil
    (if (= (get types (get arguments index))
           (get target-types index))
      (sh13-target-argument-types-error
       arguments target-types types (+ index 1))
      :type)))

(defn sh13-terminator-error [function block]
  (let [terminator (get block :terminator)
        opcode (get terminator :opcode)
        types
        (sh13-block-result-types
         block 0 (sh13-block-types block))]
    (if (map? terminator)
      (if
       (sh13-member?
        #{:return :error-return :throw :panic
          :branch :conditional-branch}
        opcode)
       (if (sh13-source-span-valid? (get terminator :source-span))
         (if (sh13-origin-chain-valid? (get terminator :origin-chain))
           (if (= opcode :return)
             (if (= (get types (get terminator :value))
                    (get function :return-type))
               nil
               :type)
             (if (sh13-member? #{:error-return :throw :panic} opcode)
               (if (contains? types (get terminator :value))
                 (if (= (get types (get terminator :value))
                        (get function :return-type))
                   (if (= opcode :throw)
                     (if (contains?
                          (get function :latent-effects) :error/throw)
                       nil
                       :effect)
                     nil)
                   :type)
                 :dominance)
               (if (= opcode :branch)
                 (sh13-target-arguments-error
                  function
                  (get terminator :target)
                  (get terminator :arguments)
                  types)
                 (if (= :bool (get types (get terminator :condition)))
                   (let [then-error
                         (sh13-target-arguments-error
                          function
                          (get terminator :then-target)
                          (get terminator :then-arguments)
                          types)
                         else-error
                         (sh13-target-arguments-error
                          function
                          (get terminator :else-target)
                          (get terminator :else-arguments)
                          types)]
                     (if (= nil then-error) else-error then-error))
                   :type))))
           :origin)
         :origin)
       :block)
      :block)))

(defn sh13-block-common-valid? [block]
  (if (map? block)
    (if (= nil (get block :block-id))
      false
      (if (vector? (get block :params))
        (if (vector? (get block :param-types))
          (if (= (count (get block :params))
                 (count (get block :param-types)))
            (if (sh13-unique-values?
                 (get block :params) 0 #{})
              (if (<= (count (get block :params)) 8)
              (if (vector? (get block :operations))
                (if (<= (count (get block :operations)) 64)
                  (if (sh13-source-span-valid? (get block :source-span))
                    (sh13-origin-chain-valid?
                     (get block :origin-chain))
                    false)
                  false)
                false)
              false)
              false)
            false)
          false)
        false))
    false))

(defn sh13-unique-values? [values index seen]
  (if (= index (count values))
    true
    (let [value (get values index)]
      (if (= nil value)
        false
        (if (contains? seen value)
          false
          (sh13-unique-values?
           values (+ index 1) (conj seen value)))))))

(defn sh13-operation-ids-unique?
  [blocks block-index operation-index seen]
  (if (= block-index (count blocks))
    true
    (let [operations (get (get blocks block-index) :operations)]
      (if (= operation-index (count operations))
        (sh13-operation-ids-unique?
         blocks (+ block-index 1) 0 seen)
        (let [operation-id
              (get (get operations operation-index) :op-id)]
          (if (= nil operation-id)
            false
            (if (contains? seen operation-id)
              false
              (sh13-operation-ids-unique?
               blocks block-index (+ operation-index 1)
               (conj seen operation-id)))))))))

(defn sh13-block-successors [block]
  (let [terminator (get block :terminator)
        opcode (get terminator :opcode)]
    (if (= opcode :branch)
      [(get terminator :target)]
      (if (= opcode :conditional-branch)
        [(get terminator :then-target)
         (get terminator :else-target)]
        []))))

(defn sh13-conj-unseen [values index seen pending]
  (if (= index (count values))
    pending
    (let [value (get values index)]
      (if (contains? seen value)
        (sh13-conj-unseen values (+ index 1) seen pending)
        (sh13-conj-unseen
         values (+ index 1) seen (conj pending value))))))

(defn sh13-reachable-blocks [function pending seen]
  (if (= 0 (count pending))
    seen
    (let [block-id (first pending)
          remaining (vec (rest pending))]
      (if (contains? seen block-id)
        (sh13-reachable-blocks function remaining seen)
        (let [block (sh13-block function block-id)]
          (if (= nil block)
            seen
            (let [next-seen (conj seen block-id)]
              (sh13-reachable-blocks
               function
               (sh13-conj-unseen
                (sh13-block-successors block) 0
                next-seen remaining)
               next-seen))))))))

(defn sh13-all-blocks-reachable? [function]
  (= (count (sh13-reachable-blocks
             function [(get function :entry-block)] #{}))
     (count (get function :blocks))))

(defn sh13-blocks-error [module function blocks index]
  (if (= index (count blocks))
    nil
    (let [block (get blocks index)]
      (if (sh13-block-common-valid? block)
        (let [operations-error
              (sh13-operations-error
               module function (get block :operations) 0
               (sh13-block-available block)
               (sh13-block-types block))]
          (if (= nil operations-error)
            (let [terminator-error
                  (sh13-terminator-error function block)]
              (if (= nil terminator-error)
                (sh13-blocks-error module function blocks (+ index 1))
                terminator-error))
            operations-error))
        :block))))

(defn sh13-entry-signature-valid? [function]
  (let [entry (sh13-block function (get function :entry-block))]
    (if (= nil entry)
      false
      (if (= (get entry :params) (get function :params))
        (= (get entry :param-types) (get function :param-types))
        false))))

(defn sh13-function-common-valid? [function]
  (if (map? function)
    (if (= nil (get function :fn-id))
      false
      (if (vector? (get function :params))
        (if (vector? (get function :param-types))
          (if (= (count (get function :params))
                 (count (get function :param-types)))
            (if (sh13-unique-values?
                 (get function :params) 0 #{})
              (if (<= (count (get function :params)) 8)
              (if (= nil (get function :return-type))
                false
                (if (set? (get function :latent-effects))
                  (if (vector? (get function :blocks))
                    (if (> (count (get function :blocks)) 0)
                      (if (<= (count (get function :blocks)) 32)
                        (if
                         (sh13-unique-by-key?
                          (get function :blocks) :block-id 0 #{})
                          (if (sh13-entry-signature-valid? function)
                              (if (sh13-member?
                                     #{true false}
                                     (get function :recursive))
                                  (if (integer?
                                 (get function :maximum-call-depth))
                              (if (> (get function
                                          :maximum-call-depth) 0)
                                (if (<= (get function
                                            :maximum-call-depth) 32)
                                  (if
                                   (sh13-source-span-valid?
                                    (get function :source-span))
                                    (sh13-origin-chain-valid?
                                     (get function :origin-chain))
                                    false)
                                  false)
                                false)
                                    false)
                                  false)
                              false)
                          false)
                        false)
                      false)
                    false)
                  false))
              false)
              false)
            false)
          false)
        false))
    false))

(defn sh13-module-fact-lineage-valid? [module]
  (if (sh13-present? (get module :checked-core-id))
    (if (sh13-present? (get module :type-table-id))
      (if (sh13-present? (get module :effect-table-id))
        (if (sh13-present? (get module :ownership-table-id))
          (if (sh13-present? (get module :capability-table-id))
            (if (sh13-present? (get module :safety-table-id))
              (if (sh13-present? (get module :source-map-id))
                true
                false)
              false)
            false)
          false)
        false)
      false)
    false))

(defn sh13-mir-verifier-report-valid? [module]
  (let [report (get module :mir-verifier-report)]
    (if (map? report)
      (if (= (set (keys report))
             #{:artifact :status :module-id})
        (if (= :gravity/c11-mir-verifier-report
               (get report :artifact))
          (if (= :passed (get report :status))
            (= (get module :module-id) (get report :module-id))
            false)
          false)
        false)
      false)))

(defn sh13-functions-error [module functions index]
  (if (= index (count functions))
    nil
    (let [function (get functions index)]
      (if (sh13-function-common-valid? function)
        (if (sh13-operation-ids-unique?
             (get function :blocks) 0 0 #{})
          (let [block-error
                (sh13-blocks-error
                 module function (get function :blocks) 0)]
            (if (= nil block-error)
              (if (sh13-all-blocks-reachable? function)
                (if (sh13-mutual-call-cycle-from?
                     module (get function :fn-id))
                  :verify
                  (sh13-functions-error module functions (+ index 1)))
                :dominance)
              block-error))
          :dominance)
        :module))))

(defn sh13-cross-callees-in-operations
  [function-id operations index result]
  (if (= index (count operations))
    result
    (let [operation (get operations index)
          callee (get operation :callee)]
      (if (= :call (get operation :opcode))
        (if (= callee function-id)
          (sh13-cross-callees-in-operations
           function-id operations (+ index 1) result)
          (sh13-cross-callees-in-operations
           function-id operations (+ index 1) (conj result callee)))
        (sh13-cross-callees-in-operations
         function-id operations (+ index 1) result)))))

(defn sh13-cross-callees-in-blocks
  [function-id blocks index result]
  (if (= index (count blocks))
    result
    (sh13-cross-callees-in-blocks
     function-id blocks (+ index 1)
     (sh13-cross-callees-in-operations
      function-id (get (get blocks index) :operations) 0 result))))

(defn sh13-cross-callees [function]
  (sh13-cross-callees-in-blocks
   (get function :fn-id) (get function :blocks) 0 []))

(defn sh13-append-values [values index result]
  (if (= index (count values))
    result
    (sh13-append-values
     values (+ index 1) (conj result (get values index)))))

(defn sh13-call-path-reaches?
  [module pending target visited]
  (if (= 0 (count pending))
    false
    (let [function-id (first pending)
          remaining (vec (rest pending))]
      (if (= function-id target)
        true
        (if (contains? visited function-id)
          (sh13-call-path-reaches?
           module remaining target visited)
          (let [function (sh13-function module function-id)]
            (sh13-call-path-reaches?
             module
             (sh13-append-values
              (sh13-cross-callees function) 0 remaining)
             target
             (conj visited function-id))))))))

(defn sh13-mutual-call-cycle-from? [module function-id]
  (let [function (sh13-function module function-id)]
    (sh13-call-path-reaches?
     module (sh13-cross-callees function) function-id #{})))

(defn sh13-module-error [module]
  (if (map? module)
    (if (= :gravity/sh13-control-flow-module (get module :artifact))
      (if (= true (get module :mir-verified))
        (if (sh13-present? (get module :module-id))
          (if (= :native (get module :profile))
            (if (= :portable-mir (get module :target))
              (if (vector? (get module :functions))
                (if (> (count (get module :functions)) 0)
                  (if (<= (count (get module :functions)) 32)
                    (if
                     (sh13-unique-by-key?
                      (get module :functions) :fn-id 0 #{})
                      (if (sh13-module-fact-lineage-valid? module)
                        (if (sh13-mir-verifier-report-valid? module)
                          (if (string? (get module :actual-source-path))
                            (if (> (count (get module :actual-source-path)) 0)
                              (if (<= (count (get module
                                                  :actual-source-path)) 4096)
                                (if
                       (sh13-present?
                        (sh13-function module (get module :entry-function)))
                        (if (integer? (get module :maximum-execution-steps))
                          (if (> (get module
                                      :maximum-execution-steps) 0)
                            (if (<= (get module
                                        :maximum-execution-steps) 512)
                              (if
                               (sh13-source-span-valid?
                                (get module :source-span))
                                (if
                                 (sh13-origin-chain-valid?
                                  (get module :origin-chain))
                                  (sh13-functions-error
                                   module (get module :functions) 0)
                                  :origin)
                                :origin)
                              :module)
                            :module)
                          :module)
                                  :verify)
                                :module)
                              :module)
                            :module)
                          :verify)
                        :module)
                      :verify)
                    :module)
                  :module)
                :module)
              :module)
            :module)
          :module)
        :module)
      :module)
    :module))

(defn sh13-rule [error]
  (if (= error :block)
    "C11-BLOCK"
    (if (= error :dominance)
      "C11-DOMINANCE"
      (if (= error :type)
        "C11-TYPE"
        (if (= error :effect)
          "C11-EFFECT"
          (if (= error :origin)
            "C11-ORIGIN"
            (if (= error :verify)
              "C11-VERIFY"
              "C11-MODULE")))))))

(defn sh13-diagnostic [module error]
  {:artifact :gravity/sh13-control-flow-diagnostic
   :diagnostic-id (sh13-rule error)
   :rule (sh13-rule error)
   :reason error
   :stage :execute-mir
   :module-id (get module :module-id)
   :entry-function (get module :entry-function)
   :profile (get module :profile)
   :target (get module :target)
   :actual-source-path (get module :actual-source-path)
   :source-span (get module :source-span)
   :origin-chain (get module :origin-chain)
   :remediation :supply-bounded-verified-typed-effect-ordered-mir})

(defn sh13-resolve-values [references values index result]
  (if (= index (count references))
    result
    (sh13-resolve-values
     references values (+ index 1)
     (conj result (get values (get references index))))))

(defn sh13-execution-rejected [fuel trace reason]
  {:status :rejected
   :reason reason
   :fuel fuel
   :trace trace})

(defn sh13-continued-value
  [operation value fuel trace]
  (if (= :i64 (get operation :type))
    (if (sh13-i64? value)
      {:status :continue
       :value value
       :fuel fuel
       :trace trace}
      (sh13-execution-rejected fuel trace :integer-range))
    {:status :continue
     :value value
     :fuel fuel
     :trace trace}))

(defn sh13-add-safe? [left right]
  (if (> right 0)
    (<= left (- 9223372036854775807 right))
    (if (< right 0)
      (>= left (- -9223372036854775808 right))
      true)))

(defn sh13-sub-safe? [left right]
  (if (> right 0)
    (>= left (+ -9223372036854775808 right))
    (if (< right 0)
      (<= left (+ 9223372036854775807 right))
      true)))

(defn sh13-mul-safe? [left right]
  (if (= left 0)
    true
    (if (= right 0)
      true
      (if (> left 0)
        (if (> right 0)
          (<= left (quot 9223372036854775807 right))
          (>= right (quot -9223372036854775808 left)))
        (if (> right 0)
          (>= left (quot -9223372036854775808 right))
          (>= left (quot 9223372036854775807 right)))))))

(defn sh13-execute-operation
  [module function operation values fuel depth trace]
  (if (<= fuel 0)
    (sh13-execution-rejected fuel trace :execution-step-bound)
    (let [opcode (get operation :opcode)
          operands
          (sh13-resolve-values
           (get operation :operands) values 0 [])
          next-fuel (- fuel 1)
          next-trace
          (conj trace
                {:function (get function :fn-id)
                 :operation (get operation :op-id)
                 :opcode opcode})]
      (if (= opcode :const)
        (sh13-continued-value
         operation (get operation :literal) next-fuel next-trace)
        (if (= opcode :add)
          (if (sh13-add-safe? (get operands 0) (get operands 1))
            (sh13-continued-value
             operation (+ (get operands 0) (get operands 1))
             next-fuel next-trace)
            (sh13-execution-rejected
             next-fuel next-trace :integer-range))
          (if (= opcode :sub)
            (if (sh13-sub-safe? (get operands 0) (get operands 1))
              (sh13-continued-value
               operation (- (get operands 0) (get operands 1))
               next-fuel next-trace)
              (sh13-execution-rejected
               next-fuel next-trace :integer-range))
            (if (= opcode :mul)
              (if (sh13-mul-safe? (get operands 0) (get operands 1))
                (sh13-continued-value
                 operation (* (get operands 0) (get operands 1))
                 next-fuel next-trace)
                (sh13-execution-rejected
                 next-fuel next-trace :integer-range))
              (if (= opcode :eq)
                {:status :continue
                 :value (= (get operands 0) (get operands 1))
                 :fuel next-fuel
                 :trace next-trace}
                (if (= opcode :lt)
                  {:status :continue
                   :value (< (get operands 0) (get operands 1))
                   :fuel next-fuel
                   :trace next-trace}
                  (let [call-result
                        (sh13-execute-function
                         module (get operation :callee) operands
                         (+ depth 1) next-fuel next-trace)]
                    (if (= :returned (get call-result :status))
                      {:status :continue
                       :value (get call-result :value)
                       :fuel (get call-result :fuel)
                       :trace (get call-result :trace)}
                      call-result)))))))))))

(defn sh13-execute-operations
  [module function operations index values fuel depth trace]
  (if (= index (count operations))
    {:status :continue
     :values values
     :fuel fuel
     :trace trace}
    (let [operation (get operations index)
          result
          (sh13-execute-operation
           module function operation values fuel depth trace)]
      (if (= :continue (get result :status))
        (sh13-execute-operations
         module function operations (+ index 1)
         (assoc values (get operation :op-id) (get result :value))
         (get result :fuel) depth (get result :trace))
        result))))

(defn sh13-execute-terminator
  [module function block terminator values fuel depth trace]
  (if (<= fuel 0)
    (sh13-execution-rejected fuel trace :execution-step-bound)
    (let [opcode (get terminator :opcode)
          next-fuel (- fuel 1)
          next-trace
          (conj trace
                {:function (get function :fn-id)
                 :block (get block :block-id)
                 :terminator opcode})]
      (if (= opcode :return)
        {:status :returned
         :value (get values (get terminator :value))
         :fuel next-fuel
         :trace next-trace}
        (if (= opcode :error-return)
          {:status :error
           :value (get values (get terminator :value))
           :fuel next-fuel
           :trace next-trace}
          (if (= opcode :throw)
            {:status :thrown
             :value (get values (get terminator :value))
             :fuel next-fuel
             :trace next-trace}
            (if (= opcode :panic)
              {:status :panic
               :value (get values (get terminator :value))
               :fuel next-fuel
               :trace next-trace}
              (if (= opcode :branch)
                (sh13-execute-block
                 module function (get terminator :target)
                 (sh13-resolve-values
                  (get terminator :arguments) values 0 [])
                 depth next-fuel next-trace)
                (if (= true
                       (get values (get terminator :condition)))
                  (sh13-execute-block
                   module function (get terminator :then-target)
                   (sh13-resolve-values
                    (get terminator :then-arguments) values 0 [])
                   depth next-fuel next-trace)
                  (sh13-execute-block
                   module function (get terminator :else-target)
                   (sh13-resolve-values
                    (get terminator :else-arguments) values 0 [])
                   depth next-fuel next-trace))))))))))

(defn sh13-execute-block
  [module function block-id arguments depth fuel trace]
  (let [block (sh13-block function block-id)
        values
        (sh13-bind-values
         (get block :params) arguments 0 {})
        operations-result
        (sh13-execute-operations
         module function (get block :operations) 0
         values fuel depth trace)]
    (if (= :continue (get operations-result :status))
      (sh13-execute-terminator
       module function block (get block :terminator)
       (get operations-result :values)
       (get operations-result :fuel)
       depth (get operations-result :trace))
      operations-result)))

(defn sh13-execute-function
  [module function-id arguments depth fuel trace]
  (let [function (sh13-function module function-id)]
    (if (> depth (get function :maximum-call-depth))
      (sh13-execution-rejected fuel trace :call-depth-bound)
      (sh13-execute-block
       module function (get function :entry-block)
       arguments depth fuel
       (conj trace
             {:function function-id
              :event :enter
              :depth depth})))))

(defn sh13-identity-input [module]
  {:artifact (get module :artifact)
   :module-id (get module :module-id)
   :mir-verified (get module :mir-verified)
   :mir-verifier-report (get module :mir-verifier-report)
   :checked-core-id (get module :checked-core-id)
   :type-table-id (get module :type-table-id)
   :effect-table-id (get module :effect-table-id)
   :ownership-table-id (get module :ownership-table-id)
   :capability-table-id (get module :capability-table-id)
   :safety-table-id (get module :safety-table-id)
   :source-map-id (get module :source-map-id)
   :profile (get module :profile)
   :target (get module :target)
   :entry-function (get module :entry-function)
   :maximum-execution-steps (get module :maximum-execution-steps)
   :source-span
   {:source-id (get (get module :source-span) :source-id)
    :start (get (get module :source-span) :start)
    :end (get (get module :source-span) :end)}
   :origin-chain (get module :origin-chain)
   :functions (get module :functions)})

(defn sh13-accepted-execution [module arguments]
  (let [execution
        (sh13-execute-function
         module (get module :entry-function) arguments 0
         (get module :maximum-execution-steps) [])]
    (if (= :rejected (get execution :status))
      {:artifact :gravity/sh13-control-flow-execution
       :schema-version 1
       :status :rejected
       :module-id (get module :module-id)
       :diagnostics
       [(sh13-diagnostic module :verify)]
       :execution execution
       :clojure-seed-boundary? true
       :self-hosted? false
       :pending (get (sh13-control-flow-policy) :pending)}
      {:artifact :gravity/sh13-control-flow-execution
       :schema-version 1
       :status :accepted
       :module-id (get module :module-id)
       :entry-function (get module :entry-function)
       :arguments arguments
       :execution execution
       :call-graph
       {:artifact :gravity/sh13-call-graph
        :functions
        (sh13-function-ids (get module :functions) 0 [])
        :bounded-call-depth true}
       :control-flow
       {:artifact :gravity/sh13-control-flow-report
        :structured-exit (get execution :status)
        :steps-used
        (- (get module :maximum-execution-steps)
           (get execution :fuel))}
       :identity-input (sh13-identity-input module)
       :provenance
       {:actual-source-path (get module :actual-source-path)
        :source-span (get module :source-span)
        :origin-chain (get module :origin-chain)}
       :diagnostics []
       :clojure-seed-boundary? true
       :self-hosted? false
       :pending (get (sh13-control-flow-policy) :pending)})))

(defn sh13-function-ids [functions index result]
  (if (= index (count functions))
    result
    (sh13-function-ids
     functions (+ index 1)
     (conj result (get (get functions index) :fn-id)))))

(defn sh13-value-type-valid? [value value-type]
  (if (= value-type :i64)
    (sh13-i64? value)
    (if (= value-type :bool)
      (sh13-member? #{true false} value)
      (if (= value-type :keyword)
        (keyword? value)
        false))))

(defn sh13-argument-values-valid?
  [arguments argument-types index]
  (if (= index (count arguments))
    true
    (if (sh13-value-type-valid?
         (get arguments index) (get argument-types index))
      (sh13-argument-values-valid?
       arguments argument-types (+ index 1))
      false)))

(defn sh13-run-module [module arguments]
  (let [error (sh13-module-error module)
        entry (sh13-function module (get module :entry-function))]
    (if (= nil error)
      (if (vector? arguments)
        (if (= (count arguments) (count (get entry :params)))
          (if (sh13-argument-values-valid?
               arguments (get entry :param-types) 0)
            (sh13-accepted-execution module arguments)
            {:artifact :gravity/sh13-control-flow-execution
             :schema-version 1
             :status :rejected
             :module-id (get module :module-id)
             :diagnostics [(sh13-diagnostic module :type)]
             :pending (get (sh13-control-flow-policy) :pending)})
          {:artifact :gravity/sh13-control-flow-execution
           :schema-version 1
           :status :rejected
           :module-id (get module :module-id)
           :diagnostics [(sh13-diagnostic module :type)]
           :pending (get (sh13-control-flow-policy) :pending)})
        {:artifact :gravity/sh13-control-flow-execution
         :schema-version 1
         :status :rejected
         :module-id (get module :module-id)
         :diagnostics [(sh13-diagnostic module :type)]
         :pending (get (sh13-control-flow-policy) :pending)})
      {:artifact :gravity/sh13-control-flow-execution
       :schema-version 1
       :status :rejected
       :module-id (get module :module-id)
       :diagnostics [(sh13-diagnostic module error)]
       :pending (get (sh13-control-flow-policy) :pending)})))

(defn sh13-verify-execution [module arguments candidate]
  (if (= (sh13-run-module module arguments) candidate)
    {:artifact :gravity/sh13-control-flow-verification
     :status :passed
     :module-id (get module :module-id)}
    {:artifact :gravity/sh13-control-flow-verification
     :status :rejected
     :module-id (get module :module-id)
     :diagnostics
     [{:artifact :gravity/sh13-control-flow-diagnostic
       :diagnostic-id "C11-VERIFY"
       :rule "C11-VERIFY"
       :reason :execution-result-substitution}]}))

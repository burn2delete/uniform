; Compatibility-only C4 source inventory facade for the SH-05 macro authority.
(ns gravity.compiler.c4-macro-expansion-engine
  (:profile :meta)
  (:target :jvm)
  (:exports [c4-macro-expansion-compatibility-contract
             c4-package-macro-result
             c4-compatible-macro-result?])
  (:effects #{})
  (:capabilities #{})
  (:safety :safe)
  (:metadata {:bootstrap
              {:stage :stage1
               :component :macro-expansion-compatibility-facade
               :owner :gravity-source
               :source-language :gravity
               :seed :clojure-stage0
               :retirement-objective :replace-clojure-c4-facade-subset
               :ambient-authority-denied true
               :documents ["C4" "C15" "BOOT1" "BOOT3"]
               :implements [:macro-result-compatibility-package]
               :preserves #{:source-spans :syntax-identity
                            :diagnostic-codes :artifact-provenance
                            :origin-chains :hygiene-context
                            :capture-records :build-effect-log
                            :generated-origin :macro-expansion-trace
                            :safety-metadata :deterministic-ordering
                            :cache-key}
               :lineage {:verified-by :clojure-stage0
                         :compiled-by :clojure-stage0
                         :next-stage :stage1
                         :replaces [:clojure-c4-package-facade]}
               :claim-boundary [:compatibility-only
                                :authentication-credit-denied
                                :authoritative-result-denied
                                :authoritative-route :gravity.macro]}}))

(def c4-macro-expansion-compatibility-contract
  {:artifact :gravity/sh05-c4-compatibility-contract
   :schema-version 1
   :compatibility-only? true
   :authentication-credit? false
   :authoritative-macro-result? false
   :authoritative-route :gravity.macro
   :accepted-statuses [:accepted :rejected]
   :required-fields [:artifact :schema-version :status
                     :expansion-template :digest-requests :diagnostics
                     :bounds :containment :execution-boundary]})

(defn c4-exact-keys? [value expected]
  (if (map? value)
    (if (= (count value) (count expected))
      (= (set (keys value)) expected)
      false)
    false))

(defn c4-compatible-macro-result? [result]
  (if (c4-exact-keys?
       result
       #{:artifact :schema-version :status :expansion-template
         :digest-requests :diagnostics :bounds :containment
         :execution-boundary})
    (if (= (get result :artifact) :gravity/sh05-macro-template-result)
      (if (= (get result :schema-version) 1)
        (if (contains? #{:accepted :rejected} (get result :status))
          (if (vector? (get result :digest-requests))
            (if (vector? (get result :diagnostics))
              (if (map? (get result :bounds))
                (if (map? (get result :containment))
                  (if (map? (get result :execution-boundary))
                    (if (= (get result :status) :accepted)
                      (map? (get result :expansion-template))
                      (= (get result :expansion-template) nil))
                    false)
                  false)
                false)
              false)
            false)
          false)
        false)
      false)
    false))

(defn c4-package-macro-result [result]
  (if (c4-compatible-macro-result? result)
    {:artifact :gravity/sh05-c4-compatibility-package
     :schema-version 1
     :status :compatible
     :compatibility-only? true
     :authentication-credit? false
     :authoritative-macro-result? false
     :authoritative-route :gravity.macro
     :macro-result result}
    {:artifact :gravity/sh05-c4-compatibility-package
     :schema-version 1
     :status :rejected
     :compatibility-only? true
     :authentication-credit? false
     :authoritative-macro-result? false
     :authoritative-route :gravity.macro
     :macro-result nil}))

            (get coverage :covered-root-form-ids)
            (get coverage :covered-form-ids)
            (get coverage :covered-local-binding-ids)
            (get coverage :covered-resolution-reference-syntax-ids)
            (get assembly :ordered-fragment-ids)
            (get assembly :root-form-ids)
            (get assembly :source-revision-id)
            (get assembly :content-id)
            (get assembly :sh06-semantic-projection-id)

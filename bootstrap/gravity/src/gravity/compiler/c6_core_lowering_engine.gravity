(defn c6-sh07-independent-exception-value-edge [raw]
  (loop [remaining (get raw :accepted-edges) selected nil]
    (if (= (count remaining) 0)
      selected
      (let [edge (first remaining)]
        (if (= (get (get edge :resolution) :reference-syntax-id)
               (get (get raw :value-form) :syntax-id))
          (if (= selected nil)
            (recur (rest remaining) edge)
            nil)
          (recur (rest remaining) selected))))))

(defn c6-sh07-independent-exception-value-node-authorized?
  [raw value-node]
  (if (= (get value-node :core-form) :literal)
    true
    (let [edge (c6-sh07-independent-exception-value-edge raw)
          resolution (if (map? edge) (get edge :resolution) {})
          binding (if (map? edge) (get edge :binding) {})]

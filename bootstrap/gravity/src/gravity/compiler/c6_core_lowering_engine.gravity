                    (let [components
                          (c6-sh07-independent-exception-components current)]
                      (recur
                       (loop [remaining components result (rest frontier)]
                         (if (= (count remaining) 0)
                           result
                           (recur (rest remaining)
                                  (conj result
                                        [(first remaining) (+ depth 1)]))))
                       next-nodes scalar-bytes)))))
              (if (c6-sh07-independent-exception-post-reader-scalar? current)

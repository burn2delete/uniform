(defn c6-sh07-exception-carrier-admission [carrier]
  (let [preflight (c6-sh07-exception-carrier-preflight carrier)
        snapshot (if (map? carrier) (get carrier :source-snapshot) {})
        request (if (map? carrier)
                  (c6-sh07-exception-core-request carrier) {})]
    (if (= (get preflight :status) :accepted)
      (if (c6-sh07-exception-carrier-shape? carrier)
        (if (c6-sh07-exception-snapshot-shape? snapshot)
          (if (c6-sh07-exception-byte-vector-valid? (get snapshot :bytes))
            (if (c6-sh07-exception-snapshot-strict-utf8? snapshot)
              (if (c6-sh07-exception-membership-valid? carrier)
              (if (c6-sh07-exception-request-collections-shaped? request)
                (if (c6-sh07-exception-origin-closure-valid? request)
                  (if (c6-sh07-exception-request-bounds-valid? request)
                    {:status :accepted :census preflight}
                    {:status :rejected :rule "C6-DOMAIN-BOUNDARY"
                     :reason :authenticated-request-bound-or-graph-invalid})
                  {:status :rejected :rule "C6-ORIGIN"
                   :reason :origin-closure-invalid})
                {:status :rejected :rule "C6-DOMAIN-BOUNDARY"
                 :reason :authenticated-request-collections-invalid})
              {:status :rejected :rule "C6-VERIFY"
               :reason :membership-or-lineage-mismatch})
              {:status :rejected :rule "C6-DOMAIN-BOUNDARY"
               :reason :snapshot-strict-utf8-invalid})
            {:status :rejected :rule "C6-DOMAIN-BOUNDARY"
             :reason :snapshot-byte-vector-outside-domain})
          {:status :rejected :rule "C6-DOMAIN-BOUNDARY"
           :reason :snapshot-shape-invalid})
        {:status :rejected :rule "C6-VERIFY"
         :reason :carrier-shape-invalid})
      {:status :rejected :rule "C6-DOMAIN-BOUNDARY"
       :reason (get preflight :reason)})))


                     :reason :snapshot-strict-utf8-reencode-mismatch})
                    {:status :failed :reason :digest-request-replay-mismatch}))
                {:status :failed :reason :resolved-digest-transcript-invalid})
              {:status :failed :reason (get shape :reason)}))
          {:status :failed :reason (get raw :reason)}))
      {:status :failed :reason (get admission :reason)})))


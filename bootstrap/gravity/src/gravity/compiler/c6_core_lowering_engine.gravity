                              (if (<= 160 second-byte)
                                (<= second-byte 191) false)
                              false)
                            (if (= first-byte 237)
                              (if (integer? second-byte)
                                (if (<= 128 second-byte)
                                  (<= second-byte 159) false)
                                false)
                              (c6-sh07-independent-exception-utf8-continuation?

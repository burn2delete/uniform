      (let [edge (first remaining)]
        (if (= (get (get edge :resolution) :reference-syntax-id)
               (get (get raw :value-form) :syntax-id))
          (if (= selected nil)
            (recur (rest remaining) edge)
            nil)
          (recur (rest remaining) selected))))))

(defn c6-sh07-exception-value-node-authorized? [raw value-node]
  (if (= (get value-node :core-form) :literal)
    true
    (let [edge (c6-sh07-exception-value-edge raw)
          resolution (if (map? edge) (get edge :resolution) {})
          binding (if (map? edge) (get edge :binding) {})]
      (= [(get value-node :core-form)
          (get (get raw :value-form) :kind)
          (get (get raw :value-form) :value)
          (get resolution :symbol)
          (get resolution :position)
          (get resolution :resolution-order)
          (get edge :classification)
          (get binding :binding-class)
          (get binding :visibility)
          (get (get value-node :attributes) :binding-id)]
         [:reference :symbol
          (get resolution :symbol) (get resolution :symbol)
          :expression :alias-qualified-required-binding
          :authenticated-external :import :public
          (get binding :binding-id)]))))

(defn c6-sh07-exception-canonical-cross-check [carrier raw]
  (let [core (c6-sh07-exception-core carrier)
        nodes (get core :nodes)
        definition
        (c6-sh07-exception-find
         (get core :definitions) :syntax-id (get (get raw :def-form) :syntax-id))
        function
        (c6-sh07-exception-find
         (get core :function-records) :function-syntax-id
         (get (get raw :fn-form) :syntax-id))
        handler
        (c6-sh07-exception-find
         (get core :error-handlers) :syntax-id
         (get (get raw :try-form) :syntax-id))
        transfer
        (c6-sh07-exception-find
         (get core :error-transfers) :syntax-id
         (get (get raw :throw-form) :syntax-id))
        def-node
        (c6-sh07-exception-find nodes :node-id (get definition :core-node-id))
        fn-node
        (c6-sh07-exception-find
         nodes :node-id (get function :function-core-node-id))
        try-node
        (c6-sh07-exception-find nodes :node-id (get handler :core-node-id))
        throw-node
        (c6-sh07-exception-find nodes :node-id (get transfer :core-node-id))
        value-node
        (c6-sh07-exception-find
         nodes :node-id (get transfer :value-core-node-id))
        handler-node
        (c6-sh07-exception-find
         nodes :node-id (get handler :handler-core-node-id))]
    (if (= [(get def-node :core-form) (get fn-node :core-form)
            (get try-node :core-form) (get throw-node :core-form)
            (c6-sh07-exception-value-node-authorized? raw value-node)
            (get handler-node :core-form)
            (get function :fixed-arity) (get handler :clause-count)
            (get definition :binding-id) (get handler :catch-binding-id)
            (get (get handler-node :attributes) :binding-id)]
           [:def :fn :try :throw true :reference 0 1
            (get (get raw :definition-binding) :binding-id)
            (get (get raw :catch-binding) :binding-id)
            (get (get raw :catch-binding) :binding-id)])
      (if (= [(get def-node :children) (get fn-node :children)
              (get try-node :children) (get throw-node :children)
              (get (get def-node :source) :syntax-id)
              (get (get fn-node :source) :syntax-id)
              (get (get try-node :source) :syntax-id)
              (get (get throw-node :source) :syntax-id)
              (get (get value-node :source) :syntax-id)
              (get (get handler-node :source) :syntax-id)]
             [[(get fn-node :node-id)] [(get try-node :node-id)]
              [(get handler :protected-core-node-id)
               (get handler :handler-core-node-id)]
              [(get transfer :value-core-node-id)]
              (get (get raw :def-form) :syntax-id)
              (get (get raw :fn-form) :syntax-id)
              (get (get raw :try-form) :syntax-id)
              (get (get raw :throw-form) :syntax-id)
              (get (get raw :value-form) :syntax-id)
              (get (get raw :handler-form) :syntax-id)])
        (assoc raw :definition definition :function function
               :handler handler :transfer transfer
               :def-node def-node :fn-node fn-node :try-node try-node
               :throw-node throw-node :value-node value-node
               :handler-node handler-node)
        {:status :rejected :rule "C6-VERIFY"
         :reason :canonical-core-link-cross-check-failed
         :provenance (get raw :try-form)})
      {:status :rejected :rule "C6-VERIFY"
       :reason :canonical-core-record-cross-check-failed
       :provenance (get raw :def-form)})))

(defn c6-sh07-exception-shape [carrier]
  (let [raw (c6-sh07-exception-raw-selection carrier)]
    (if (= (get raw :status) :accepted)
      (c6-sh07-exception-canonical-cross-check carrier raw)
      raw)))

(defn c6-sh07-exception-path-neutral-record [record]
  (if (map? record)
    (if (contains? record :authenticated-sh06-artifact-id)
      (assoc record :authenticated-sh06-artifact-id
             (get record :sh06-semantic-projection-id))
      record)
    record))

(defn c6-sh07-exception-path-neutral-binding [binding semantic-id]
  (if (map? binding)
    (assoc
     (assoc binding :definition-artifact-id semantic-id)
     :upstream-binding-id (get binding :binding-id))
    binding))

(defn c6-sh07-exception-path-neutral-resolution [resolution]
  (if (map? resolution)
    (assoc resolution :upstream-binding-id (get resolution :binding-id))
    resolution))

(defn c6-sh07-exception-semantic-edges [edges semantic-id]
  (loop [remaining edges result []]
    (if (= (count remaining) 0)
      result
      (let [edge (first remaining)]
        (recur
         (rest remaining)
         (conj result
               {:classification (get edge :classification)
                :resolution
                (c6-sh07-exception-path-neutral-resolution
                 (get edge :resolution))
                :binding
                (c6-sh07-exception-path-neutral-binding
                 (get edge :binding) semantic-id)}))))))

(defn c6-sh07-exception-semantic-bindings [bindings semantic-id]
  (loop [remaining bindings result []]
    (if (= (count remaining) 0)
      result
      (recur
       (rest remaining)
       (conj result
             (c6-sh07-exception-path-neutral-binding
              (first remaining) semantic-id))))))

(defn c6-sh07-exception-semantic-node [node]
  {:core-form (get node :core-form)
   :node-id (get node :node-id)
   :children (get node :children)
   :attributes
   (c6-sh07-exception-path-neutral-record (get node :attributes))
   :source (get node :source)
   :evaluation (get node :evaluation)})

(defn c6-sh07-exception-semantic-nodes [nodes]
  (loop [remaining nodes result []]
    (if (= (count remaining) 0)
      result
      (recur (rest remaining)
             (conj result
                   (c6-sh07-exception-semantic-node (first remaining)))))))

(defn c6-sh07-exception-node-sources [nodes]
  (loop [remaining nodes result []]
    (if (= (count remaining) 0)
      result
      (recur (rest remaining)
             (conj result (get (first remaining) :source))))))

(defn c6-sh07-exception-source-map [nodes]
  (loop [remaining nodes result []]
    (if (= (count remaining) 0)
      result
      (let [node (first remaining)]
        (recur
         (rest remaining)
         (conj result
               {:syntax-id (get (get node :source) :syntax-id)
                :core-node-id (get node :node-id)}))))))

(defn c6-sh07-exception-snapshot-membership-view [snapshot]
  {:artifact (get snapshot :artifact)
   :schema-version (get snapshot :schema-version)
   :canonical-path (get snapshot :canonical-path)
   :project-root-path (get snapshot :project-root-path)
   :project-relative-path (get snapshot :project-relative-path)
   :source-extension (get snapshot :source-extension)
   :source-kind (get snapshot :source-kind)
   :byte-count (get snapshot :byte-count)
   :maximum-source-bytes (get snapshot :maximum-source-bytes)
   :bytes (get snapshot :bytes)
   :bytes-hash (get snapshot :bytes-hash)
   :text (get snapshot :text)
   :encoding (get snapshot :encoding)
   :single-read? (get snapshot :single-read?)
   :nofollow-final-component? (get snapshot :nofollow-final-component?)
   :bytes-hash-domain (get snapshot :bytes-hash-domain)
   :bytes-hash-algorithm (get snapshot :bytes-hash-algorithm)
   :bytes-hash-encoding (get snapshot :bytes-hash-encoding)})

(defn c6-sh07-exception-build-template [carrier shape]
  (let [request (c6-sh07-exception-core-request carrier)
        core (c6-sh07-exception-core carrier)
        module (get request :module)
        source-unit (c6-sh07-exception-source-unit carrier)
        semantic-id
        (get (get request :lineage) :sh06-semantic-projection-id)
        nodes [(get shape :def-node) (get shape :fn-node)
               (get shape :try-node) (get shape :throw-node)
               (get shape :value-node) (get shape :handler-node)]
        evaluation-record
        {:artifact :gravity/sh07-exception-evaluation-record
         :schema-version 1
         :order [:evaluate-protected :evaluate-thrown-value
                 :transfer-error :bind-handler
                 :evaluate-handler :return-handler]
         :protected-core-node-id (get (get shape :handler) :protected-core-node-id)
         :thrown-value-core-node-id (get (get shape :transfer) :value-core-node-id)
         :throw-core-node-id (get (get shape :transfer) :core-node-id)
         :try-core-node-id (get (get shape :handler) :core-node-id)
         :catch-binding-id (get (get shape :handler) :catch-binding-id)
         :handler-core-node-id (get (get shape :handler) :handler-core-node-id)}
        semantic-preimage
        {:domain :gravity/sh07-c6-exception-semantic-v1
         :source-revision-id (get (get request :lineage) :source-revision-id)
         :module {:namespace (get module :namespace)
                  :profile (get module :profile)
                  :target (get module :target)
                  :safety (get module :safety)
                  :effects (get module :effects)
                  :capabilities (get module :capabilities)
                  :exports (get module :exports)}
         :reader-policy
         {:encoding (get source-unit :encoding)
          :reader-options (get source-unit :reader-options)
          :enabled-features (get source-unit :enabled-features)
          :extension-policy (get source-unit :extension-policy)}
         :selected-forms (get shape :forms)
         :selected-bindings
         (c6-sh07-exception-semantic-bindings
          [(get shape :definition-binding)
           (get shape :type-binding)
           (get shape :catch-binding)] semantic-id)
         :accepted-resolution-edges
         (c6-sh07-exception-semantic-edges
          (get shape :accepted-edges) semantic-id)
         :nodes (c6-sh07-exception-semantic-nodes nodes)
         :handler
         (c6-sh07-exception-path-neutral-record (get shape :handler))
         :transfer
         (c6-sh07-exception-path-neutral-record (get shape :transfer))
         :evaluation evaluation-record
         :absence {:mutation true :recursion true :pattern true}}
        membership-preimage
        {:domain :gravity/sh07-c6-exception-membership-v1
         :source-snapshot
         (c6-sh07-exception-snapshot-membership-view
          (get carrier :source-snapshot))
         :project-root-evidence (get carrier :project-root-evidence)
         :physical-membership (get carrier :physical-membership)
         :b47-artifact (get carrier :b47-artifact)
         :sh06-resolution-artifact (get carrier :sh06-resolution-artifact)
         :sh06-verification-report (get carrier :sh06-verification-report)
         :b47-verification-report (get carrier :b47-verification-report)}
        projection-preimage
        {:domain :gravity/sh07-c6-exception-projection-v1
         :fragment (get shape :fragment)
         :forms (get shape :forms)
         :accepted-resolution-edges (get shape :accepted-edges)
         :definition (get shape :definition)
         :function (get shape :function)
         :nodes (c6-sh07-exception-semantic-nodes nodes)
         :handler (get shape :handler)
         :transfer (get shape :transfer)}
        digest-requests
        [{:ordinal 0 :purpose :source-snapshot-raw-bytes
          :preimage (get (get carrier :source-snapshot) :bytes)}
         {:ordinal 1 :purpose :source-snapshot-text-utf8
          :preimage (get (get carrier :source-snapshot) :text)}
         {:ordinal 2 :purpose :sh07-core-artifact-id
          :preimage (get core :identity-preimage)}
         {:ordinal 3 :purpose :project-root-id
          :preimage
          {:project-manifest "deps.edn"
           :bytes-hash
           (get (get carrier :project-root-evidence)
                :manifest-bytes-hash)}}
         {:ordinal 4 :purpose :membership-binding
          :preimage membership-preimage}
         {:ordinal 5 :purpose :projection-binding
          :preimage projection-preimage}
         {:ordinal 6 :purpose :semantic-artifact
          :preimage semantic-preimage}
         {:ordinal 7 :purpose :provenance-binding
          :preimage {:domain :gravity/sh07-c6-exception-provenance-v1
                     :membership-binding-id {:digest-ref 4}
                     :semantic-artifact-id {:digest-ref 6}
                     :projection-binding-id {:digest-ref 5}
                     :origin-closure
                     (c6-sh07-exception-node-sources nodes)}}
         {:ordinal 8 :purpose :verifier-report
          :preimage {:domain :gravity/sh07-c6-exception-verifier-v1
                     :semantic-artifact-id {:digest-ref 6}
                     :checks [:raw-owning-root-reconstructed
                              :strict-utf8-roundtrip-reconstructed
                              :authenticated-external-edges
                              :typed-catch-exact
                              :no-extra-throw
                              :semantic-obligations-preserved]}}
         {:ordinal 9 :purpose :final-artifact
          :preimage {:domain :gravity/sh07-c6-exception-final-v1
                     :semantic-artifact-id {:digest-ref 6}
                     :verifier-report-id {:digest-ref 8}}}]]
    {:artifact :gravity/sh07-c6-exception-template
     :schema-version 1
     :status :accepted
     :carrier-binding
     {:b47-artifact-id (get (get carrier :b47-artifact) :artifact-id)
      :sh06-artifact-id
      (get (get carrier :sh06-resolution-artifact) :artifact-id)
      :source-revision-id (get (get request :lineage) :source-revision-id)}
     :carrier-transcript
     {:artifact :gravity/sh07-c6-carrier-transcript
      :schema-version 1
      :source-bytes-hash
      (get (get carrier :source-snapshot) :bytes-hash)
      :source-byte-count
      (get (get carrier :source-snapshot) :byte-count)
      :project-root-id
      (get (get carrier :project-root-evidence) :project-root-id)
      :b47-artifact-id (get (get carrier :b47-artifact) :artifact-id)
      :sh06-artifact-id
      (get (get carrier :sh06-resolution-artifact) :artifact-id)
      :owning-root-form-id (get (get shape :def-form) :form-id)
      :owning-fragment-id (get (get shape :fragment) :fragment-id)
      :sh06-report-status
      (get (get carrier :sh06-verification-report) :status)
      :b47-report-status
      (get (get carrier :b47-verification-report) :status)}
     :selected {:fragment (get shape :fragment)
                :raw-forms (get shape :forms)
                :raw-trace (get shape :trace)
                :accepted-resolution-edges (get shape :accepted-edges)
                :definition-binding (get shape :definition-binding)
                :type-binding (get shape :type-binding)
                :catch-binding (get shape :catch-binding)
                :definition (get shape :definition)
                :function (get shape :function)
                :nodes nodes
                :handler (get shape :handler)
                :transfer (get shape :transfer)}
     :evaluation-record evaluation-record
     :semantic-obligations
     {:arity :fixed-zero
      :mutation :absent
      :recursion :absent
      :exception :one-typed-nonresumable-catch
      :pattern :absent
      :declared-effects (get module :effects)
      :capabilities (get module :capabilities)
      :profile (get module :profile)
      :target (get module :target)
      :unsafe-facts {:safety (get module :safety)}}
     :identity-preimages
     {:membership membership-preimage
      :projection projection-preimage
      :semantic semantic-preimage}
     :digest-requests digest-requests
     :diagnostics []
     :claim-boundary (c6-sh07-exception-contract-value)}))

(defn c6-sh07-independent-template-check [carrier template requests]
  (let [admission
        (c6-sh07-independent-exception-carrier-admission carrier)]
    (if (= (get admission :status) :accepted)
      (let [raw (c6-sh07-independent-exception-raw-selection carrier)]
        (if (= (get raw :status) :accepted)
          (let [shape
                (c6-sh07-independent-exception-canonical-cross-check
                 carrier raw)]
        (if (= (get shape :status) :accepted)
          (let [context
                (c6-sh07-independent-exception-derived-context
                 carrier shape)
                expected
                (c6-sh07-independent-exception-template-from-context
                 context)]
            (if (= requests (get expected :digest-requests))
              (if (= (get template :evaluation-record)
                     (get expected :evaluation-record))
                (if (= (get (get template :selected) :nodes)
                       (get (get expected :selected) :nodes))
                  (if (= template expected)
                    {:status :passed
                     :checks [:carrier-reauthenticated
                              :raw-owning-root-reconstructed
                              :external-edges-reauthenticated
                              :canonical-core-cross-check
                              :semantic-preimage-reconstructed
                              :ordered-digest-requests-reconstructed]}
                    {:status :failed
                     :reason :template-reconstruction-mismatch})
                  {:status :failed
                   :reason :selected-node-or-origin-mismatch})
                {:status :failed :reason :evaluation-record-mismatch})
              {:status :failed :reason :digest-request-replay-mismatch}))
          {:status :failed :reason (get shape :reason)}))
          {:status :failed :reason (get raw :reason)}))
      {:status :failed :reason (get admission :reason)})))

(defn c6-sh07-exception-digest-entry-valid? [request entry ordinal]
  (if (c6-sh07-exception-exact-keys?
       entry #{:ordinal :purpose :preimage :digest})
    (if (= [(get entry :ordinal) (get entry :purpose)
            (get entry :preimage)]
           [ordinal (get request :purpose) (get request :preimage)])
      (c6-sh07-exception-sha256-id? (get entry :digest))
      false)
    false))

(defn c6-sh07-exception-digest-transcript-valid? [requests digests]
  (if (= (count requests) (count digests))
    (if (= (count requests) 10)
      (loop [remaining-requests requests remaining-digests digests ordinal 0]
        (if (= (count remaining-requests) 0)
          true
          (if (c6-sh07-exception-digest-entry-valid?
               (first remaining-requests) (first remaining-digests) ordinal)
            (recur (rest remaining-requests) (rest remaining-digests)
                   (+ ordinal 1))
            false)))
      false)
    false))

(defn c6-sh07-exception-digest-at [digests ordinal]
  (get (get digests ordinal) :digest))

(defn c6-sh07-exception-snapshot-digests-valid? [carrier digests]
  (let [snapshot (get carrier :source-snapshot)
        source-unit (c6-sh07-exception-source-unit carrier)
        expected (get snapshot :bytes-hash)]
    (= [(c6-sh07-exception-digest-at digests 0)
        (c6-sh07-exception-digest-at digests 1)
        expected
        (get source-unit :bytes-hash)]
       [expected expected expected expected])))

(defn c6-sh07-exception-resolved-template
  [carrier template requests digests]
  (let [selected (get template :selected)
        nodes (get selected :nodes)
        value-node
        (c6-sh07-exception-find
         nodes :node-id
         (get (get selected :transfer) :value-core-node-id))
        handler-node
        (c6-sh07-exception-find
         nodes :node-id
         (get (get selected :handler) :handler-core-node-id))
        thrown-value (get (get value-node :attributes) :value)
        result-value
        (if (= (get (get handler-node :attributes) :binding-id)
               (get (get selected :handler) :catch-binding-id))
          thrown-value
          nil)
        core-artifact
        {:artifact :gravity/sh07-c6-canonical-exception-core
         :schema-version 1
         :artifact-id (c6-sh07-exception-digest-at digests 9)
         :semantic-artifact-id (c6-sh07-exception-digest-at digests 6)
         :provenance-binding-id (c6-sh07-exception-digest-at digests 7)
         :membership-binding-id (c6-sh07-exception-digest-at digests 4)
         :projection-binding-id (c6-sh07-exception-digest-at digests 5)
         :root-core-node-id (get (get selected :definition) :core-node-id)
         :nodes nodes
         :source-to-core-map (c6-sh07-exception-source-map nodes)
         :introduced-origin-records []
         :evaluation-record (get template :evaluation-record)
         :error-records {:transfer (get selected :transfer)
                         :handler (get selected :handler)}
         :execution-record
         {:status :handled
          :nonresumable? true
          :thrown-value thrown-value
          :catch-binding-id
          (get (get selected :handler) :catch-binding-id)
          :handler-value result-value
          :result result-value
          :trace (get (get template :evaluation-record) :order)}
         :semantic-obligations (get template :semantic-obligations)
         :diagnostics []}
        resolved
        {:artifact :gravity/sh07-c6-exception-resolved-template
         :schema-version 1
         :status :accepted
         :carrier-binding (get template :carrier-binding)
         :carrier-transcript (get template :carrier-transcript)
         :selected selected
         :evaluation-record (get template :evaluation-record)
         :semantic-obligations (get template :semantic-obligations)
         :identity-preimages (get template :identity-preimages)
         :digest-requests requests
         :resolved-digests digests
         :bindings
         {:source-raw-bytes-hash
          (c6-sh07-exception-digest-at digests 0)
          :source-text-utf8-hash
          (c6-sh07-exception-digest-at digests 1)
          :authenticated-b47-artifact-id
          (c6-sh07-exception-digest-at digests 2)
          :project-root-id
          (c6-sh07-exception-digest-at digests 3)
          :membership-binding-id
          (c6-sh07-exception-digest-at digests 4)
          :projection-binding-id
          (c6-sh07-exception-digest-at digests 5)
          :semantic-artifact-id
          (c6-sh07-exception-digest-at digests 6)
          :provenance-binding-id
          (c6-sh07-exception-digest-at digests 7)
          :verifier-report-id
          (c6-sh07-exception-digest-at digests 8)
          :final-artifact-id
          (c6-sh07-exception-digest-at digests 9)}
         :canonical-core-artifact core-artifact
         :desugaring-trace
         {:artifact :gravity/sh07-exception-desugaring-trace
          :lowering-rule :sh07-authenticated-exception-error-exit-v1
          :surface-syntax-id (get (get selected :definition) :syntax-id)
          :core-root (get (get selected :definition) :core-node-id)
          :introduced-forms []
          :preserved [:source-spans :origin-chains :profile :target
                      :effects :capabilities :unsafe-facts]
          :evaluation-order
          (get (get template :evaluation-record) :order)}
         :diagnostics []
         :claim-boundary (c6-sh07-exception-contract-value)}]
    resolved))

(defn c6-sh07-exception-circular-verifier-retired [carrier resolved]
  (let [admission (c6-sh07-exception-carrier-admission carrier)]
    (if (= (get admission :status) :accepted)
      (let [raw (c6-sh07-exception-raw-selection carrier)]
        (if (= (get raw :status) :accepted)
          (let [shape (c6-sh07-exception-canonical-cross-check carrier raw)
                requests (if (map? resolved)
                           (get resolved :digest-requests) [])
                digests (if (map? resolved)
                          (get resolved :resolved-digests) [])]
            (if (= (get shape :status) :accepted)
              (if (c6-sh07-exception-digest-transcript-valid?
                   requests digests)
                (let [expected-template
                      (c6-sh07-exception-build-template carrier shape)
                      expected
                      (c6-sh07-exception-resolved-template
                       carrier expected-template
                       (get expected-template :digest-requests) digests)
                      fragment-forms (get raw :forms)
                      indexes (get raw :indexes)
                      module
                      (get (c6-sh07-exception-core-request carrier) :module)]
                  (if (= requests (get expected-template :digest-requests))
                    (if (c6-sh07-exception-snapshot-digests-valid?
                         carrier digests)
                    (if (= (c6-sh07-exception-digest-at digests 2)
                           (get (get carrier :b47-artifact) :artifact-id))
                      (if (= resolved expected)
                        (if (= [(c6-sh07-exception-operator-count
                                indexes fragment-forms 'try)
                               (c6-sh07-exception-operator-count
                                indexes fragment-forms 'throw)
                               (c6-sh07-exception-operator-count
                                indexes fragment-forms 'catch)
                               (get (get raw :type-binding) :kind)
                               (get (get raw :catch-binding)
                                    :binding-class)
                               (get (get expected :semantic-obligations)
                                    :declared-effects)
                               (get (get expected :semantic-obligations)
                                    :capabilities)]
                              [1 1 1 :type :lexical
                               (get module :effects)
                               (get module :capabilities)])
                          {:artifact
                           :gravity/sh07-c6-independent-verifier-report
                           :schema-version 1
                           :status :passed
                           :checks
                           [:carrier-reauthenticated-from-identical-bytes
                            :strict-utf8-roundtrip-reconstructed
                            :manifest-root-identity-reconstructed
                            :raw-owning-top-level-root-reconstructed
                            :raw-form-graph-reconstructed
                            :local-and-external-edges-reauthenticated
                            :canonical-core-used-only-as-cross-check
                            :typed-catch-exact
                            :no-extra-throw
                            :macro-origins-closed
                            :ordered-digest-records-bound
                            :semantic-final-identity-path-neutral
                            :physical-provenance-identity-separated
                            :six-step-error-exit-executed
                            :effect-capability-profile-target-preserved]
                           :facts
                           {:owning-root-form-id
                            (get (get raw :def-form) :form-id)
                            :owning-fragment-id
                            (get (get raw :fragment) :fragment-id)
                            :typed-catch-binding-id

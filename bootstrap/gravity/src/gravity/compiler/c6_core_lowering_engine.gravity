                    false)
                  (if (if (<= 240 first-byte) (<= first-byte 244) false)
                    (if (>= remaining 4)
                      (let [second-byte (get bytes (+ index 1))
                            third-byte (get bytes (+ index 2))
                            fourth-byte (get bytes (+ index 3))

                    (count try-children) (count throw-children)
                    (count catch-children)]
                   [3 :list :vector [] 3 2 4])
              (if (= [(c6-sh07-exception-operator-resolution-valid?
                       carrier request indexes fragment def-form 'def)
                      (c6-sh07-exception-operator-resolution-valid?
                       carrier request indexes fragment fn-form 'fn)
                      (c6-sh07-exception-operator-resolution-valid?
                       carrier request indexes fragment try-form 'try)
                      (c6-sh07-exception-operator-resolution-valid?
                       carrier request indexes fragment throw-form 'throw)
                      (c6-sh07-exception-operator-resolution-valid?
                       carrier request indexes fragment catch-form 'catch)]
                     [true true true true true])

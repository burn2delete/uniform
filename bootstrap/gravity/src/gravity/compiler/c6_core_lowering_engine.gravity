                            :catch-local-binding-id
                            (get (get raw :catch-binding) :binding-id)
                            :try-count 1 :throw-count 1 :catch-count 1
                            :extra-throw? false
                            :authenticated-external-edge-count
                            (loop [remaining (get raw :accepted-edges)
                                   count-value 0]
                              (if (= (count remaining) 0)
                                count-value
                                (recur
                                 (rest remaining)
                                 (if (= (get (first remaining)
                                             :classification)
                                        :authenticated-external)
                                   (+ count-value 1) count-value))))}
                           :verifier-report-id
                           (c6-sh07-exception-digest-at digests 8)
                           :final-artifact-id
                           (c6-sh07-exception-digest-at digests 9)
                           :diagnostics []}

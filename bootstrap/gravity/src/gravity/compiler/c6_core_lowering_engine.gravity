(defn c6-sh07-exception-raw-selection [carrier]
  (let [request (c6-sh07-exception-core-request carrier)
        indexes (c6-sh07-exception-index-request request)]
    (if (= [(get (get indexes :forms) :duplicate?)
            (get (get indexes :bindings) :duplicate?)
            (get (get indexes :resolutions) :duplicate?)
            (get (get indexes :aliases) :duplicate?)]
           [false false false false])
      (loop [remaining (get request :macro-origin-traces)
             candidates [] first-rejection nil]
        (if (= (count remaining) 0)
          (if (= (count candidates) 1)
            (let [candidate (first candidates)
                  edges
                  (c6-sh07-exception-authorized-edges
                   carrier request indexes (get candidate :fragment))]
              (if (= (get edges :status) :accepted)
                (assoc candidate :indexes indexes
                       :accepted-edges (get edges :edges))
                (assoc edges :rule "C6-VERIFY")))
            (if (> (count candidates) 1)
              {:status :rejected :rule "C6-CORE-SHAPE"
               :reason :unique-owning-top-level-definition-required}
              (if (map? first-rejection)
                (if (contains? first-rejection :rule)
                  first-rejection
                  (assoc first-rejection :rule "C6-CORE-SHAPE"))
                {:status :rejected :rule "C6-CORE-SHAPE"
                 :reason :owning-top-level-definition-required})))
          (let [candidate
                (c6-sh07-exception-raw-candidate
                 carrier request indexes (first remaining))]
            (if (= (get candidate :status) :accepted)
              (recur (rest remaining) (conj candidates candidate)
                     first-rejection)
              (recur (rest remaining) candidates
                     (if (= first-rejection nil)
                       candidate first-rejection))))))
      {:status :rejected :rule "C6-VERIFY"
       :reason :raw-request-index-not-bijective})))

(defn c6-sh07-exception-value-edge [raw]
  (loop [remaining (get raw :accepted-edges) selected nil]
    (if (= (count remaining) 0)

(defn c6-sh07-exception-sh05-run-verification-valid? [report artifact]
  (if (c6-sh07-exception-exact-keys?
       report #{:artifact :schema-version :status :rule})
    (= [(get report :artifact) (get report :schema-version)
        (get report :status) (get report :rule)]
       [artifact 1 :passed nil])
    false))

(defn c6-sh07-exception-sh05-gravity-verifiers-valid?
  [verifiers expected-run-count]
  (if (c6-sh07-exception-exact-keys?
       verifiers #{:template :resolved :runs})
    (let [template (get verifiers :template)
          resolved (get verifiers :resolved)
          runs (get verifiers :runs)]
      (if (if (c6-sh07-exception-exact-keys?
               template #{:status :verified-run-count})
            (c6-sh07-exception-exact-keys?
             resolved #{:status :verified-run-count}) false)
        (if (= [(get template :status)
                (get template :verified-run-count)
                (get resolved :status)
                (get resolved :verified-run-count)
                (vector? runs)]
               [:passed expected-run-count :passed expected-run-count true])
          (if (= (count runs) expected-run-count)
            (loop [remaining runs]
              (if (= (count remaining) 0)
                true
                (let [run (first remaining)]
                  (if (c6-sh07-exception-exact-keys?
                       run #{:template :resolved})
                    (if (c6-sh07-exception-sh05-run-verification-valid?
                         (get run :template)
                         :gravity/sh05-macro-template-verification)
                      (if (c6-sh07-exception-sh05-run-verification-valid?
                           (get run :resolved)
                           :gravity/sh05-macro-resolved-verification)
                        (recur (rest remaining)) false)
                      false)
                    false))))
            false)
          false)
        false))
    false))

(defn c6-sh07-exception-sh05-report-valid? [carrier report]
  (let [runs
        (get
         (get
          (get (get carrier :sh06-resolution-artifact)
               :sh05-macro-artifact)
          :gravity-macro-boundary)
         :expansion-runs)]
    (if (c6-sh07-exception-exact-keys?
         report #{:artifact :status :checks :failed-checks
                  :gravity-verifiers})
      (if (vector? runs)
        (= [(get report :artifact) (get report :status)
            (get report :failed-checks)
            (c6-sh07-exception-exact-checks-true?
             (get report :checks)
             (c6-sh07-exception-sh05-report-checks))
            (c6-sh07-exception-sh05-gravity-verifiers-valid?
             (get report :gravity-verifiers) (count runs))]
           [:gravity/sh05-macro-artifact-verification :passed [] true true])
        false)
      false)))

(defn c6-sh07-exception-verification-reports-valid? [carrier]
  (let [sh06-report (get carrier :sh06-verification-report)
        b47-report (get carrier :b47-verification-report)
        snapshot (get carrier :source-snapshot)
        b47 (get carrier :b47-artifact)
        sh06 (get carrier :sh06-resolution-artifact)
        boundary
        (get b47 :gravity-core-boundary)
        sh05-report (get sh06-report :upstream-verification)]
    (if (c6-sh07-exception-exact-keys?
         sh06-report #{:artifact :status :checks :failed-checks :source-path
                       :gravity-verification :upstream-verification})
      (if (c6-sh07-exception-exact-keys?
           b47-report #{:artifact :status :checks :failed-checks :source-path
                        :template-verification :resolved-verification
                        :upstream-verification})
        (= [(get sh06-report :artifact) (get sh06-report :status)
            (get sh06-report :failed-checks)
            (c6-sh07-exception-exact-checks-true?
             (get sh06-report :checks)
             (c6-sh07-exception-sh06-report-checks))
            (get (get sh06-report :gravity-verification) :status)
            (get (get sh06-report :upstream-verification) :status)
            (get b47-report :artifact) (get b47-report :status)
            (get b47-report :failed-checks)
            (c6-sh07-exception-exact-checks-true?
             (get b47-report :checks)
             (c6-sh07-exception-b47-report-checks))
            (get b47-report :upstream-verification)
            (get b47-report :template-verification)
            (get b47-report :resolved-verification)
            (get sh06-report :gravity-verification)
            (set (keys (get sh06-report :upstream-verification)))
            (get (get sh06-report :upstream-verification) :artifact)
            (get (get sh06-report :upstream-verification) :failed-checks)
            (c6-sh07-exception-all-checks-true?
             (get (get sh06-report :upstream-verification) :checks))
            (c6-sh07-exception-sh05-report-valid? carrier sh05-report)
            (get sh06-report :source-path)
            (get b47-report :source-path)
            (get (get sh06 :provenance) :source-path)
            (get (get b47 :provenance) :source-path)]
           [:gravity/sh06-resolution-artifact-verification :passed [] true
            :passed :passed
            :gravity/sh07-core-artifact-verification :passed [] true
            sh06-report (get boundary :template-verification)
            (get boundary :resolved-verification)
            {:artifact :gravity/sh06-resolution-resolved-verification
             :schema-version 1 :status :passed :rule nil}
            #{:artifact :status :checks :failed-checks :gravity-verifiers}
            :gravity/sh05-macro-artifact-verification [] true true
            (get snapshot :canonical-path) (get snapshot :canonical-path)
            (get snapshot :canonical-path) (get snapshot :canonical-path)])
        false)
      false)))

(defn c6-sh07-exception-authorized-edges
  [carrier request indexes fragment]
  (loop [remaining (get fragment :resolution-reference-syntax-ids)
         accepted []]
    (if (= (count remaining) 0)
      {:status :accepted :edges accepted}
      (let [resolution
            (c6-sh07-exception-resolution indexes (first remaining))]
        (if (map? resolution)
          (let [classification
                (c6-sh07-exception-edge-classification
                 carrier request indexes fragment resolution)]
            (if (= (get classification :status) :accepted)
              (recur (rest remaining) (conj accepted classification))
              classification))
          {:status :rejected :reason :edge-resolution-dangling})))))

(defn c6-sh07-exception-path-segments-valid? [path start]
  (loop [index start segment-width 0 all-dots? true]
    (if (= index (count path))
      (if (> segment-width 0)
        (if all-dots? (> segment-width 2) true)
        false)
      (let [character (get path index)]
        (if (= character \/)
          (if (> segment-width 0)
            (if all-dots?
              (if (> segment-width 2)
                (recur (+ index 1) 0 true) false)
              (recur (+ index 1) 0 true))
            false)
          (recur (+ index 1) (+ segment-width 1)
                 (if all-dots? (= character \.) false)))))))

(defn c6-sh07-exception-absolute-normalized-path? [path]
  (if (string? path)
    (if (> (count path) 1)
      (if (= (get path 0) \/)
        (c6-sh07-exception-path-segments-valid? path 1) false)
      false)
    false))

(defn c6-sh07-exception-relative-normalized-path? [path]
  (if (string? path)
    (if (> (count path) 0)
      (if (= (get path 0) \/)
        false
        (c6-sh07-exception-path-segments-valid? path 0))
      false)
    false))

(defn c6-sh07-exception-path-has-extension? [path extension]
  (if (string? path)
    (if (string? extension)
      (if (>= (count path) (count extension))
        (= (subvec (vec path) (- (count path) (count extension))
                   (count path))
           (vec extension))
        false)
      false)
    false))

(defn c6-sh07-exception-path-membership-valid?
  [snapshot root-evidence membership]
  (let [root (get snapshot :project-root-path)
        relative (get snapshot :project-relative-path)
        canonical (get snapshot :canonical-path)
        extension (get snapshot :source-extension)
        kind (get snapshot :source-kind)]
    (if (c6-sh07-exception-absolute-normalized-path? root)
      (if (c6-sh07-exception-relative-normalized-path? relative)
        (= [canonical
            (c6-sh07-exception-absolute-normalized-path? canonical)
            (c6-sh07-exception-path-has-extension? canonical extension)
            (c6-sh07-exception-path-has-extension? relative extension)
            [extension kind]
            (get root-evidence :root-path)
            (get membership :normalized-root-path)
            (get membership :normalized-relative-path)
            (get membership :normalized-source-path)
            (get membership :source-extension)
            (get membership :source-kind)]
           [(str root "/" relative) true true true
            (if (= extension ".gravity")
              [".gravity" :gravity-branded-source]
              [".qst" :qst-theory-source])
            root root relative canonical extension kind])
        false)
      false)))

(defn c6-sh07-exception-membership-valid? [carrier]
  (let [snapshot (get carrier :source-snapshot)
        root-evidence (get carrier :project-root-evidence)
        membership (get carrier :physical-membership)
        b47 (get carrier :b47-artifact)
        sh06 (get carrier :sh06-resolution-artifact)
        sh06-report (get carrier :sh06-verification-report)
        b47-report (get carrier :b47-verification-report)
        source-unit (c6-sh07-exception-source-unit carrier)
        request (c6-sh07-exception-core-request carrier)
        lineage (if (map? request) (get request :lineage) {})]
    (if (if (c6-sh07-exception-verification-reports-valid? carrier)
          (c6-sh07-exception-path-membership-valid?
           snapshot root-evidence membership)
          false)
    (if (= (set (keys root-evidence))
           #{:root-path :manifest-relative-path :manifest-byte-count
             :manifest-bytes-hash :project-root-id})
      (if (= (set (keys membership))
             #{:normalized-root-path :normalized-relative-path
               :normalized-source-path :source-extension :source-kind
               :source-id :source-bytes-hash :snapshot-byte-count
               :snapshot-bytes-hash :project-root-id})
        (if (= sh06 (get b47 :sh06-resolution-artifact))
      (if (= (get sh06-report :status) :passed)
        (if (= (get b47-report :status) :passed)
          (if (= [(get sh06-report :artifact)
                  (get b47-report :artifact)
                  (get sh06-report :failed-checks)
                  (get b47-report :failed-checks)
                  (get request :provenance)]
                 [:gravity/sh06-resolution-artifact-verification
                  :gravity/sh07-core-artifact-verification [] []
                  {:actual-source-path (get snapshot :canonical-path)}])
            (if (= (get sh06-report :source-path)
                 (get snapshot :canonical-path))
            (if (= (get b47-report :source-path)
                   (get snapshot :canonical-path))

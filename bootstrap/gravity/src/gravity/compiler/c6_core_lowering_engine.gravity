      (if (= [(contains? (set (get request :top-level-form-ids)) root-id)
              (contains? (set (get fragment :root-form-ids)) root-id)
              (contains? (set (get fragment :form-ids)) root-id)
              (= (get def-form :parent-form-id) nil)
              (= (get fragment :fragment-id) root-id)
              (= (get fragment :content-id) root-id)

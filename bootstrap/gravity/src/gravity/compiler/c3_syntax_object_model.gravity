; Compatibility-only C3 source inventory facade for the SH-04 syntax authority.
(ns gravity.compiler.c3-syntax-object-model
  (:profile :meta)
  (:target :jvm)
  (:exports [c3-syntax-object-compatibility-contract
             c3-package-syntax-result
             c3-compatible-syntax-result?])
  (:effects #{})
  (:capabilities #{})
  (:safety :safe)
  (:metadata {:bootstrap
              {:stage :stage1
               :component :syntax-object-model-compatibility-facade
               :owner :gravity-source
               :source-language :gravity
               :seed :clojure-stage0
               :retirement-objective :replace-clojure-c3-facade-subset
               :ambient-authority-denied true
               :documents ["C3" "C15" "BOOT1" "BOOT7" "BOOT8"]
               :implements [:syntax-result-compatibility-package]
               :preserves #{:source-spans :syntax-identity :origin-chains
                            :hygiene-context :metadata-ledger
                            :fact-invalidation :diagnostic-codes
                            :artifact-provenance}
               :lineage {:verified-by :clojure-stage0
                         :compiled-by :clojure-stage0
                         :next-stage :stage1
                         :replaces [:clojure-c3-package-facade]}
               :claim-boundary [:compatibility-only
                                :authentication-credit-denied
                                :authoritative-result-denied
                                :authoritative-route
                                :gravity.bootstrap.syntax]}}))

(def c3-syntax-object-compatibility-contract
  {:artifact :gravity/sh04-c3-compatibility-contract
   :schema-version 1
   :compatibility-only? true
   :authentication-credit? false
   :authoritative-syntax-result? false
   :authoritative-route :gravity.bootstrap.syntax
   :accepted-statuses [:accepted :rejected]
   :required-fields [:artifact :schema-version :status
                     :syntax-template :reader-binding
                     :reader-source-revision :ownership-product
                     :digest-requests
                     :diagnostics :bounds :containment
                     :execution-boundary]})

(defn c3-exact-keys? [value expected]
  (if (map? value)
    (if (= (count value) (count expected))
      (= (set (keys value)) expected)
      false)
    false))

(defn c3-compatible-syntax-result? [result]
  (if (c3-exact-keys?
       result
       #{:artifact :schema-version :status :syntax-template
         :reader-binding :reader-source-revision :ownership-product
         :digest-requests :diagnostics :bounds :containment
         :execution-boundary})
    (if (= (get result :artifact) :gravity/sh04-syntax-template-result)
      (if (= (get result :schema-version) 1)
        (if (contains? #{:accepted :rejected} (get result :status))
          (if (vector? (get result :digest-requests))
            (if (vector? (get result :diagnostics))
              (if (map? (get result :bounds))
                (if (map? (get result :containment))
                  (if (map? (get result :execution-boundary))
                    (if (= (get result :status) :accepted)
                      (map? (get result :syntax-template))
                      (= (get result :syntax-template) nil))
                    false)
                  false)
                false)
              false)
            false)
          false)
        false)
      false)
    false))

(defn c3-package-syntax-result [result]
  (if (c3-compatible-syntax-result? result)
    {:artifact :gravity/sh04-c3-compatibility-package
     :schema-version 1
     :status :compatible
     :compatibility-only? true
     :authentication-credit? false
     :authoritative-syntax-result? false
     :authoritative-route :gravity.bootstrap.syntax
     :syntax-result result}
    {:artifact :gravity/sh04-c3-compatibility-package
     :schema-version 1
     :status :rejected
     :compatibility-only? true
     :authentication-credit? false
     :authoritative-syntax-result? false
     :authoritative-route :gravity.bootstrap.syntax
     :syntax-result nil}))

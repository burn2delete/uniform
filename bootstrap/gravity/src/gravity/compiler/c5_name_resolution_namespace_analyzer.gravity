; Compatibility-only C5 source inventory facade for the SH-06 resolution authority.
(ns gravity.compiler.c5-name-resolution-namespace-analyzer
  (:profile :meta)
  (:target :jvm)
  (:exports [c5-resolution-compatibility-contract
             c5-compatible-resolution-result?
             c5-package-resolution-result])
  (:effects #{})
  (:capabilities #{})
  (:safety :safe)
  (:metadata {:bootstrap
              {:stage :stage1
               :component :name-resolution-compatibility-facade
               :owner :gravity-source
               :source-language :gravity
               :seed :clojure-stage0
               :retirement-objective :replace-clojure-c5-facade-subset
               :ambient-authority-denied true
               :documents ["C5" "L3" "C15" "BOOT1" "BOOT3"]
               :implements [:resolution-result-compatibility-package]
               :preserves #{:source-spans :syntax-identity
                            :binding-identity :namespace-context
                            :profile-target-metadata
                            :effect-capability-metadata
                            :visibility-metadata :dependency-edges
                            :diagnostic-codes :artifact-provenance}
               :lineage {:verified-by :clojure-stage0
                         :compiled-by :clojure-stage0
                         :next-stage :stage1
                         :replaces [:clojure-c5-package-facade]}
               :claim-boundary [:compatibility-only
                                :authentication-credit-denied
                                :authoritative-result-denied
                                :authoritative-route :gravity.resolution]}}))

(def c5-resolution-compatibility-contract
  {:artifact :gravity/sh06-c5-compatibility-contract
   :schema-version 1
   :compatibility-only? true
   :authentication-credit? false
   :authoritative-resolution-result? false
   :authoritative-route :gravity.resolution
   :accepted-statuses [:accepted :rejected]
   :required-fields [:artifact :schema-version :status
                     :namespace-analysis-template :digest-requests
                     :diagnostics :bounds :containment
                     :execution-boundary]})

(defn c5-exact-keys? [value expected]
  (if (map? value)
    (if (= (count value) (count expected))
      (= (set (keys value)) expected)
      false)
    false))

(defn c5-compatible-resolution-result? [result]
  (if (c5-exact-keys?
       result
       #{:artifact :schema-version :status :namespace-analysis-template
         :digest-requests :diagnostics :bounds :containment
         :execution-boundary})
    (if (= (get result :artifact)
           :gravity/sh06-resolution-template-result)
      (if (= (get result :schema-version) 1)
        (if (contains? #{:accepted :rejected} (get result :status))
          (if (vector? (get result :digest-requests))
            (if (vector? (get result :diagnostics))
              (if (map? (get result :bounds))
                (if (map? (get result :containment))
                  (if (map? (get result :execution-boundary))
                    (if (= (get result :status) :accepted)
                      (map? (get result :namespace-analysis-template))
                      (= (get result :namespace-analysis-template) nil))
                    false)
                  false)
                false)
              false)
            false)
          false)
        false)
      false)
    false))

(defn c5-package-resolution-result [result]
  (if (c5-compatible-resolution-result? result)
    {:artifact :gravity/sh06-c5-compatibility-package
     :schema-version 1
     :status :compatible
     :compatibility-only? true
     :authentication-credit? false
     :authoritative-resolution-result? false
     :authoritative-route :gravity.resolution
     :resolution-result result}
    {:artifact :gravity/sh06-c5-compatibility-package
     :schema-version 1
     :status :rejected
     :compatibility-only? true
     :authentication-credit? false
     :authoritative-resolution-result? false
     :authoritative-route :gravity.resolution
     :resolution-result nil}))

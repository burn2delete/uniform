(defn c6c10-runtime-scope-contract []
  {:artifact :gravity/c6-c10-checked-core-scope-contract
   :profiles [:hosted]
   :safety-modes [:safe]
   :source-targets [:jvm]
   :source-operations [:literal :quote :local :let :let-binding
                       :do :if :truthy :integer-eq
                       :integer-lt :integer-lte :integer-gt :integer-gte
                       :implicit-nil :function]
   :scalar-literals [:nil :string :boolean :integer
                     :character :keyword :symbol]
   :intrinsic-effects #{}
   :intrinsic-capabilities #{}
   :ownership :persistent-immutable
   :safety :proven-safe
   :whole-language? false})

(defn c6c10-envelope-diagnostic-source [input]
  (let [front-end (get input :front-end-products)
        source-unit (get front-end :source-unit-record)
        forms (get front-end :form-tree)
        roots (get front-end :top-level-form-ids)
        namespace-form
        (if (> (count roots) 0)
          (c6c10-form-by-id forms (first roots))
          nil)
        syntaxes (get front-end :c3-syntax-object-stream)
        namespace-syntax-id
        (if (> (count syntaxes) 0)
          (get (first syntaxes) :syntax/id)
          nil)
        source-base
        (if (map? namespace-form) namespace-form source-unit)
        source
        (c6c10-merge-maps
         source-base
         {:source-content-hash (get input :source-content-hash)
          :syntax-id namespace-syntax-id})]
    source))

(defn c6c10-envelope-rejection
  [rule stage message-key input facts remediation]
  (let [source (c6c10-envelope-diagnostic-source input)]
    (c6c10-diagnostic-rejection
     {:next-ordinal 0 :requests []}
     rule stage message-key source facts remediation)))

(defn c6c10-input-form-rejection
  [rule stage message-key input form facts remediation]
  (let [front-end (get input :front-end-products)
        syntaxes (get front-end :c3-syntax-object-stream)
        exact-syntax
        (c6c10-top-level-syntax-by-form-id
         syntaxes (get form :form-id))
        syntax
        (if (= exact-syntax nil)
          (if (= (count syntaxes) 0)
            nil
            (first (c6c10-reverse syntaxes)))
          exact-syntax)
        envelope
        {:source-content-hash (get input :source-content-hash)
         :form-tree (get front-end :form-tree)
         :entrypoint-syntax-id
         (if (= syntax nil) :not-applicable (get syntax :syntax/id))
         :module
         (get (get (get input :stage2-plan) :module) :module)
         :plan-id (get (get input :stage2-plan) :plan-id)}]
    (c6c10-form-rejection
     {:next-ordinal 0 :requests []}
     envelope form rule stage message-key facts remediation)))

(defn c6c10-envelope-shape-valid? [input]
  (if (map? input)
    (if (= (set (keys input))
           #{:kind :source-content-hash :front-end-products
             :stage2-plan :authoritative-module :binding-pins
             :carrier-validation :scope})
      (if (= (get input :kind)
             :gravity/private-fresh-c2-c3-stage2-plan-envelope)
        (= (get input :scope)
           :bounded-pure-hosted-safe-jvm-source)
        false)
      false)
    false))

(defn c6c10-exact-map-keys? [value expected]
  (if (map? value) (= (set (keys value)) expected) false))

(defn c6c10-private-front-end-shape? [front-end]
  (if (c6c10-exact-map-keys?
       front-end
       #{:artifact :status :source-unit-record :source-unit-id
         :token-stream :form-tree :top-level-form-ids
         :syntax-seed-stream :reader-source-map
         :literal-decoding-records :semantic-error-deferment-record
         :reader-extension-invocation-records :reader-diagnostics
         :incremental-reader-hashes :reader-product-integrity
         :c3-artifact-id :c3-syntax-object-stream
         :c3-capability-proof :records :forms})
    (c6c10-exact-map-keys?
     (get front-end :source-unit-record)
     #{:artifact :encoding :reader-options :bytes-hash
       :extension-policy :enabled-features})
    false))

(defn c6c10-private-plan-shape? [plan]
  (if (c6c10-exact-map-keys?
       plan
       #{:kind :compatibility-kind :diagnostics :plan-id :functions
         :effect-summary :source :binding-table :instruction-summary
         :module :compiler :entrypoint})
    (if (c6c10-exact-map-keys? (get plan :source) #{:sha256})
      (if (c6c10-exact-map-keys?
           (get plan :module)
           #{:capabilities :module :exports :effects
             :safety :target :profile})
        (let [function-plan (get (get plan :functions) 'main)
              binding (get function-plan :binding)]
          (if (c6c10-exact-map-keys?
               function-plan
               #{:name :instructions :params :definition-form :binding
                 :body-form-count :arity :body})
            (c6c10-exact-map-keys?
             binding
             #{:capabilities :name :effects :kind :target
               :namespace :visibility :profile})
            false))
        false)
      false)
    false))

(defn c6c10-private-binding-pins-shape? [pins]
  (c6c10-exact-map-keys?
   pins
   #{:c2-semantic-hash :c3-semantic-hash :plan-semantic-hash
     :reader-integrity-hash :builder-source-hash
     :builder-plan-hash :builder-function-hash}))

(defn c6c10-nonnegative-at-most? [value maximum]
  (if (integer? value)
    (if (< value 0) false (<= value maximum))
    false))

(defn c6c10-carrier-validation-shape? [validation]
  (if (c6c10-exact-map-keys?
       validation
       #{:status :maximum-carrier-nodes :maximum-carrier-depth
         :maximum-container-width :maximum-scalar-bytes
         :maximum-integer-bits :observed-carrier-nodes
         :observed-carrier-depth :observed-container-width
         :observed-scalar-bytes :observed-integer-bits})
    (if (= (get validation :status) :passed)
      (if (= (get validation :maximum-carrier-nodes) 65536)
        (if (= (get validation :maximum-carrier-depth) 64)
          (if (= (get validation :maximum-container-width) 128)
            (if (= (get validation :maximum-scalar-bytes) 65536)
              (if (= (get validation :maximum-integer-bits) 256)
                (if (c6c10-nonnegative-at-most?
                     (get validation :observed-carrier-nodes) 65536)
                  (if (c6c10-nonnegative-at-most?
                       (get validation :observed-carrier-depth) 64)
                    (if (c6c10-nonnegative-at-most?
                         (get validation :observed-container-width) 128)
                      (if (c6c10-nonnegative-at-most?
                           (get validation :observed-scalar-bytes) 65536)
                        (c6c10-nonnegative-at-most?
                         (get validation :observed-integer-bits) 256)
                        false)
                      false)
                    false)
                  false)
                false)
              false)
            false)
          false)
        false)
      false)
    false))

(defn c6c10-authoritative-module-shape? [module]
  (c6c10-exact-map-keys?
   module
   #{:module :profile :target :effects :capabilities :exports
     :safety :requires :imports :providers :metadata :doc :forms}))

(defn c6c10-authoritative-module-matches-plan?
  [authoritative plan-module front-end]
  (if (c6c10-authoritative-module-shape? authoritative)
    (if (= (get authoritative :module) (get plan-module :module))
      (if (= (get authoritative :profile) (get plan-module :profile))
        (if (= (get authoritative :target) (get plan-module :target))
          (if (= (get authoritative :effects) (get plan-module :effects))
            (if (= (get authoritative :capabilities)
                   (get plan-module :capabilities))
              (if (= (get authoritative :exports)
                     (get plan-module :exports))
                (if (= (get authoritative :safety)
                       (get plan-module :safety))
                  (= (get authoritative :forms)
                     (vec (rest (get front-end :forms))))
                  false)
                false)
              false)
            false)
          false)
        false)
      false)
    false))

(defn c6c10-build-accepted-template [input]
  (let [front-end (get input :front-end-products)
        plan (get input :stage2-plan)
        module (get plan :module)
        functions (get plan :functions)
        function-plan (get functions 'main)
        forms (get front-end :form-tree)
        top-level-form-ids (get front-end :top-level-form-ids)
        syntaxes (get front-end :c3-syntax-object-stream)
        function-form
        (if (= (count top-level-form-ids) 2)
          (c6c10-form-by-id forms (second top-level-form-ids))
          nil)
        function-syntax
        (if (= function-form nil)
          nil
          (c6c10-top-level-syntax-by-form-id
           syntaxes (get function-form :form-id)))
        working-envelope
        {:source-content-hash (get input :source-content-hash)
         :form-tree forms
         :entrypoint-syntax-id (get function-syntax :syntax/id)
         :module (get module :module)
         :plan-id (get plan :plan-id)}
        initial-state {:next-ordinal 0 :requests []}
        function-product
        (c6c10-build-function-product
         initial-state working-envelope function-plan function-form)]
    (if (= (get function-product :status) :rejected)
      function-product
      (let [nodes (get function-product :nodes)
            root-node-id (get function-product :root-node-id)
            edges (c6c10-build-dependency-edges nodes)
            dependencies-precede? (c6c10-all-edges-precede? edges)
            lexical-bindings-resolve?
            (c6c10-all-lexical-bindings-resolve? nodes)]
        (if (if dependencies-precede? lexical-bindings-resolve? false)
          (let [
            owner-request
            (c6c10-add-digest-request
             (get function-product :state)
             {:domain :gravity/c9-persistent-shared-owner-domain-v1
              :function-node-id root-node-id})
            owner-domain-id (get owner-request :ref)
            fact-product
            (c6c10-build-fact-tables
             nodes
             (c6c10-empty-fact-product
              (get owner-request :state) owner-domain-id))
            pass-artifacts
            (c6c10-build-pass-artifacts
             (get fact-product :state) working-envelope nodes
             (get function-product :binding-records)
             root-node-id (get fact-product :type-ids) owner-domain-id)
            operation-set (c6c10-collect-operation-set nodes [])
            source-core-input
            {:module (get module :module)
             :plan-id (get plan :plan-id)
             :entrypoint 'main
             :operation-set operation-set
             :declared-effects #{}
             :declared-capabilities #{}}
            dependency-order-graph
            {:artifact :gravity/c6-c10-dependency-order-graph
             :node-order (c6c10-node-id-vector nodes [])
             :edges edges
             :all-dependencies-precede-consumers?
             dependencies-precede?
             :all-lexical-bindings-resolve? lexical-bindings-resolve?
             :status
             (if (if dependencies-precede? lexical-bindings-resolve? false)
               :passed
               :failed)}
            mapping-input
            {:domain :gravity/c6-c10-origin-mapping-v1
             :source-content-hash (get input :source-content-hash)
             :core-node-origin-map (c6c10-node-origin-map nodes {})
             :origin-table (get function-product :origin-table)
             :lexical-binding-records
             (get function-product :binding-records)}
            mapping-request
            (c6c10-add-digest-request
             (get pass-artifacts :state) mapping-input)
            mapping-id (get mapping-request :ref)
            provenance-input
            {:domain :gravity/c6-c10-path-neutral-provenance-v1
             :source-content-hash (get input :source-content-hash)
             :binding-pins (get input :binding-pins)
             :mapping-id mapping-id
             :origin-closure (get function-product :origin-closure)}
            provenance-request
            (c6c10-add-digest-request
             (get mapping-request :state) provenance-input)
            provenance-binding-id (get provenance-request :ref)
            artifact-base
            {:kind :gravity/p15-s23-stage2-gravity-checked-core-artifact
             :schema-version 1
             :status :complete-for-bounded-pure-hosted-safe-jvm-slice
             :scope (c6c10-runtime-scope-contract)
             :source-content-hash (get input :source-content-hash)
             :source-core-input source-core-input
             :entrypoint 'main
             :profile :hosted
             :source-target :jvm
             :core-nodes nodes
             :root-node-ids [root-node-id]
             :mapping-id mapping-id
             :provenance-binding-id provenance-binding-id
             :instruction-origin-sidecar
             {:mapping-id mapping-id
              :provenance-binding-id provenance-binding-id
              :node-origin-map (c6c10-node-origin-map nodes {})}
             :dependency-order-graph dependency-order-graph
             :lexical-binding-records
             (get function-product :binding-records)
             :source-origin-table (get function-product :origin-table)
             :origin-closure (get function-product :origin-closure)
             :type-facts (get fact-product :type-facts)
             :effect-facts (get fact-product :effect-facts)
             :capability-facts (get fact-product :capability-facts)
             :ownership-facts (get fact-product :ownership-facts)
             :safety-facts (get fact-product :safety-facts)
             :profile-facts (get fact-product :profile-facts)
             :proof-records
             (c6c10-node-safety-proof-records nodes {})
             :typed-core (get pass-artifacts :typed-core)
             :typed-core-key (get pass-artifacts :typed-core-key)
             :effect-graph (get pass-artifacts :effect-graph)
             :effect-graph-key (get pass-artifacts :effect-graph-key)
             :capability-proof-records []
             :pure-capability-closure
             (get pass-artifacts :pure-capability-closure)
             :pure-capability-closure-key
             (get pass-artifacts :pure-capability-closure-key)
             :ownership-analysis
             (get pass-artifacts :ownership-analysis)
             :ownership-analysis-key
             (get pass-artifacts :ownership-analysis-key)
             :pass-history (c6c10-pass-history)
             :authenticated-input
             {:kind :gravity/c6-c10-authenticated-input
              :source-content-hash (get input :source-content-hash)
              :plan-id (get plan :plan-id)
              :binding-pins (get input :binding-pins)}
             :bounds
             {:maximum-functions 1
              :maximum-forms 128
              :maximum-plan-nodes 128
              :maximum-digest-requests 2048
              :reserved-verifier-diagnostic-requests 1
              :maximum-graph-depth 48
              :maximum-carrier-nodes 65536
              :maximum-carrier-depth 64
              :maximum-container-width 128
              :maximum-scalar-bytes 65536
              :maximum-integer-bits 256
              :observed-forms (count forms)
              :observed-plan-nodes
              (get function-product :plan-node-count)
              :observed-derived-nodes (count nodes)
              :observed-graph-depth
              (get function-product :maximum-depth)
              :input-carrier-validation
              (get input :carrier-validation)}
             :semantic-provenance
             {:source-content-hash (get input :source-content-hash)
              :binding-pins (get input :binding-pins)}
             :diagnostics []
             :mir-derived? false
             :whole-language? false
             :clojure-seed-boundary? true
             :self-hosted? false}
            artifact-request
            (c6c10-add-digest-request
             (get provenance-request :state)
             {:domain :gravity/c6-c10-checked-core-artifact-v1
              :semantic-artifact artifact-base})
            artifact-id (get artifact-request :ref)
            artifact (assoc artifact-base :artifact-id artifact-id)
            final-state (get artifact-request :state)]
        (if (if (> (count nodes) 128)
              true
              (if (> (get function-product :plan-node-count) 128)
                true
                (if (> (get function-product :maximum-depth) 48)
                  true
                  (> (+ (count (get final-state :requests)) 1)
                     2048))))
          (c6c10-envelope-rejection
           :C6-VERIFY :lower-to-core :diagnostic/c6-verify input
           {:missing-fact :bounded-gravity-checked-core-construction
            :observed-derived-nodes (count nodes)
            :observed-plan-nodes
            (get function-product :plan-node-count)
            :observed-graph-depth
            (get function-product :maximum-depth)
            :observed-digest-requests
            (count (get final-state :requests))
            :reserved-verifier-diagnostic-requests 1}
           :reduce-source-program-size)
          {:status :accepted
           :artifact-template artifact
           :digest-requests (get final-state :requests)
           :digest-graph-root artifact-id
           :digest-graph-roots [artifact-id]
           :diagnostics []
           :authority
           {:semantic-owner :gravity-source
            :host-role :generic-validation-hashing-and-instantiation
            :scope :bounded-pure-c6-c10
            :self-hosted? false}}))
          (c6c10-envelope-rejection
           :C6-VERIFY :lower-to-core :diagnostic/c6-verify input
           {:missing-fact :validated-dependency-and-lexical-order
            :all-dependencies-precede-consumers? dependencies-precede?
            :all-lexical-bindings-resolve? lexical-bindings-resolve?}
           :regenerate-validated-core-node-order))))))

(defn c6c10-upstream-diagnostic-rejection [diagnostics]
  {:status :rejected
   :fatal? true
   :diagnostics diagnostics
   :artifact-template nil
   :digest-requests []
   :digest-graph-roots []
   :propagated-upstream? true
   :containment {:fatal? true
                 :stop-after :read-and-syntax
                 :downstream-artifacts-forbidden true}})

(defn c6c10-map-fields-equal? [left right fields]
  (if (= (count fields) 0)
    true
    (let [field (first fields)]
      (if (= (get left field) (get right field))
        (c6c10-map-fields-equal? left right (rest fields))
        false))))

(defn c6c10-node-keysets-equal? [expected actual]
  (if (= (count expected) (count actual))
    (if (= (count expected) 0)
      true
      (if (map? (first actual))
        (if (= (set (keys (first expected)))
               (set (keys (first actual))))
          (c6c10-node-keysets-equal? (rest expected) (rest actual))
          false)
        false))
    false))

(defn c6c10-node-fields-equal? [expected actual fields]
  (if (= (count expected) (count actual))
    (if (= (count expected) 0)
      true
      (if (c6c10-map-fields-equal? (first expected) (first actual) fields)
        (c6c10-node-fields-equal?
         (rest expected) (rest actual) fields)
        false))
    false))

(defn c6c10-template-structure-equal? [expected actual]
  (if (map? actual)
    (if (= (set (keys expected)) (set (keys actual)))
      (if (c6c10-map-fields-equal?
           expected actual
           [:kind :schema-version :status :scope :source-content-hash
            :source-core-input :entrypoint :profile :source-target
            :root-node-ids :dependency-order-graph
            :lexical-binding-records :pass-history :authenticated-input
            :bounds :diagnostics :mir-derived? :whole-language?
            :clojure-seed-boundary? :self-hosted?])
        (let [expected-nodes (get expected :core-nodes)
              actual-nodes (get actual :core-nodes)]
          (if (vector? actual-nodes)
            (if (c6c10-node-keysets-equal? expected-nodes actual-nodes)
              (c6c10-node-fields-equal?
               expected-nodes actual-nodes
               [:node-id :path :kind :source-operation :plan-node?
                :plan-depth :operands :attributes])
              false)
            false))
        false)
      false)
    false))

(defn c6c10-template-origin-equal? [expected actual]
  (if (c6c10-map-fields-equal?
       expected actual
       [:mapping-id :provenance-binding-id :instruction-origin-sidecar
        :source-origin-table :origin-closure :semantic-provenance])
    (c6c10-node-fields-equal?
     (get expected :core-nodes) (get actual :core-nodes) [:source])
    false))

(defn c6c10-template-type-equal? [expected actual]
  (if (c6c10-map-fields-equal?
       expected actual [:type-facts :typed-core :typed-core-key])
    (c6c10-node-fields-equal?
     (get expected :core-nodes) (get actual :core-nodes) [:type])
    false))

(defn c6c10-template-effect-equal? [expected actual]
  (if (c6c10-map-fields-equal?
       expected actual
       [:effect-facts :capability-facts :effect-graph :effect-graph-key
        :capability-proof-records :pure-capability-closure
        :pure-capability-closure-key])
    (c6c10-node-fields-equal?
     (get expected :core-nodes) (get actual :core-nodes)
     [:effects :capabilities])
    false))

(defn c6c10-template-ownership-profile-equal? [expected actual]
  (if (c6c10-map-fields-equal?
       expected actual
       [:ownership-facts :ownership-analysis :ownership-analysis-key
        :profile-facts])
    (c6c10-node-fields-equal?
     (get expected :core-nodes) (get actual :core-nodes)
     [:ownership :profile])
    false))

(defn c6c10-template-safety-equal? [expected actual]
  (if (c6c10-map-fields-equal?
       expected actual [:safety-facts :proof-records])
    (c6c10-node-fields-equal?
     (get expected :core-nodes) (get actual :core-nodes) [:safety])
    false))

(defn c6c10-template-verification-rejection
  [input expected-result rule stage message-key missing-fact remediation]
  (let [expected-requests (get expected-result :digest-requests)
        expected-artifact-id (get expected-result :digest-graph-root)
        source
        (c6c10-merge-maps
         (c6c10-envelope-diagnostic-source input)
         {:diagnostic-subject-id expected-artifact-id
          :involved-artifacts [expected-artifact-id]})]
    (c6c10-diagnostic-rejection
     {:next-ordinal (count expected-requests)
      :requests expected-requests}
     rule stage message-key source
     {:missing-fact missing-fact
      :expected-artifact-id expected-artifact-id}
     remediation)))

(defn c6c10-first-node-field-mismatch
  [expected actual fields]
  (if (vector? expected)
    (if (vector? actual)
      (if (= (count expected) 0)
        nil
        (if (= (count actual) 0)
          {:expected (first expected) :actual nil}
          (if (c6c10-map-fields-equal? (first expected) (first actual) fields)
            (c6c10-first-node-field-mismatch
             (rest expected) (rest actual) fields)
            {:expected (first expected) :actual (first actual)})))
      {:expected (first expected) :actual nil})
    {:expected nil :actual nil}))

(defn c6c10-first-map-value-mismatch-key [expected actual map-keys]
  (if (= (count map-keys) 0)
    nil
    (let [map-key (first map-keys)]
      (if (= (get expected map-key) (get actual map-key))
        (c6c10-first-map-value-mismatch-key
         expected actual (rest map-keys))
        map-key))))

(defn c6c10-first-extra-map-key [expected actual actual-keys]
  (if (= (count actual-keys) 0)
    nil
    (if (contains? expected (first actual-keys))
      (c6c10-first-extra-map-key expected actual (rest actual-keys))
      (first actual-keys))))

(defn c6c10-first-map-mismatch-key [expected actual]
  (if (map? expected)
    (if (map? actual)
      (let [value-mismatch
            (c6c10-first-map-value-mismatch-key
             expected actual (keys expected))]
        (if (= value-mismatch nil)
          (c6c10-first-extra-map-key expected actual (keys actual))
          value-mismatch))
      (first (keys expected)))
    nil))

(defn c6c10-first-table-mismatch-key
  [expected actual table-fields]
  (if (= (count table-fields) 0)
    nil
    (let [field (first table-fields)
          expected-table (get expected field)
          actual-table (get actual field)]
      (if (= expected-table actual-table)
        (c6c10-first-table-mismatch-key
         expected actual (rest table-fields))
        (c6c10-first-map-mismatch-key expected-table actual-table)))))

(defn c6c10-family-mismatch-record
  [expected actual node-fields table-fields]
  (let [node-mismatch
        (c6c10-first-node-field-mismatch
         (get expected :core-nodes) (get actual :core-nodes) node-fields)]
    (if (= node-mismatch nil)
      (let [table-node-id
            (c6c10-first-table-mismatch-key
             expected actual table-fields)
            fallback-node (first (get expected :core-nodes))
            expected-node
            (if (= table-node-id nil)
              fallback-node
              (c6c10-node-by-id
               (get expected :core-nodes) table-node-id))
            actual-node
            (if (= expected-node nil)
              (first (get actual :core-nodes))
              (c6c10-node-by-id
               (get actual :core-nodes) (get expected-node :node-id)))]
        {:expected expected-node :actual actual-node})
      node-mismatch)))

(defn c6c10-family-verification-facts
  [family missing-fact expected-node actual-node]
  (let [node-id
        (if (= expected-node nil)
          :not-applicable
          (get expected-node :node-id))
        base {:missing-fact missing-fact :core-node-id node-id}]
    (if (= family :type)
      (c6c10-merge-maps
       base
       {:expected-type
        (if (= expected-node nil)
          :not-applicable
          (get expected-node :type))
        :actual-type
        (if (= actual-node nil)
          :not-applicable
          (get actual-node :type))
        :relevant-binding-id
        (if (= actual-node nil)
          :not-applicable
          (if (= (get (get actual-node :attributes) :resolved-binding) nil)
            :not-applicable
            (get (get actual-node :attributes) :resolved-binding)))})
      (if (= family :effect)
        (c6c10-merge-maps
         base
         {:expected-effects
          (if (= expected-node nil) #{} (get expected-node :effects))
          :actual-effects
          (if (= actual-node nil) :not-applicable (get actual-node :effects))
          :expected-capabilities
          (if (= expected-node nil) #{} (get expected-node :capabilities))
          :actual-capabilities
          (if (= actual-node nil)
            :not-applicable
            (get actual-node :capabilities))})
        (if (= family :safety)
          (c6c10-merge-maps
           base
           {:operation-id node-id
            :specialized-safe-rule
            (if (= expected-node nil)
              :not-applicable
              (get (get (get expected-node :safety) :proof)
                   :specialized-safe-rule))
            :safety-mode :safe
            :proof-id
            (if (= expected-node nil)
              :not-applicable
              (get (get (get expected-node :safety) :proof) :proof-id))
            :check-id :not-applicable})
          base)))))

(defn c6c10-template-family-verification-rejection
  [input expected-result actual family node-fields table-fields
   rule stage message-key missing-fact remediation]
  (let [expected (get expected-result :artifact-template)
        expected-requests (get expected-result :digest-requests)
        expected-artifact-id (get expected-result :digest-graph-root)
        mismatch
        (c6c10-family-mismatch-record
         expected actual node-fields table-fields)
        expected-node (get mismatch :expected)
        actual-node (get mismatch :actual)
        source-base
        (if (= expected-node nil)
          (get (get input :front-end-products) :source-unit-record)
          (get expected-node :source))
        source
        (c6c10-merge-maps
         source-base
         {:source-content-hash (get input :source-content-hash)
          :diagnostic-subject-id expected-artifact-id
          :involved-artifacts [expected-artifact-id]
          :core-node-id
          (if (= expected-node nil)
            :not-applicable
            (get expected-node :node-id))
          :node-id
          (if (= expected-node nil)
            :not-applicable
            (get expected-node :node-id))
          :syntax-id
          (if (= expected-node nil)
            :not-applicable
            (get (get expected-node :source)
                 :enclosing-syntax-origin-id))})
        facts
        (c6c10-family-verification-facts
         family missing-fact expected-node actual-node)
        facts (assoc facts :expected-artifact-id expected-artifact-id)]
    (c6c10-diagnostic-rejection
     {:next-ordinal (count expected-requests)
      :requests expected-requests}
     rule stage message-key source facts remediation)))

(defn c6-c10-build-checked-core-template [input]
  (if (c6c10-envelope-shape-valid? input)
    (let [front-end (get input :front-end-products)
          plan (get input :stage2-plan)
          module (get plan :module)
          authoritative-module (get input :authoritative-module)
          source-unit (get front-end :source-unit-record)
          source-content-hash (get input :source-content-hash)
          forms (get front-end :form-tree)
          roots (get front-end :top-level-form-ids)
          syntaxes (get front-end :c3-syntax-object-stream)
          functions (get plan :functions)
          metadata-form (c6c10-first-metadata-form forms)
          reader-diagnostics (get front-end :reader-diagnostics)
          source-binding-valid?
          (if (= source-content-hash (get source-unit :bytes-hash))
            (if (= source-content-hash
                   (get (get plan :source) :sha256))
              true
              false)
            false)
          front-end-shape-valid?
          (if (c6c10-private-front-end-shape? front-end)
            (if (= (get front-end :artifact)
                 :gravity/p15-s23-stage2-c2-c3-front-end-products)
              (if (= (get front-end :status) :complete)
                (if (vector? forms)
                  (if (vector? roots)
                    (if (vector? syntaxes)
                      (if (> (count forms) 0)
                        (if (<= (count forms) 128)
                          (if (= (count roots) (count syntaxes))
                            (c6c10-exhaustive-top-level-program?
                             forms roots syntaxes
                             (get authoritative-module :module))
                            false)
                          false)
                        false)
                      false)
                    false)
                  false)
                false)
              false)
            false)
          plan-shape-valid?
          (if (c6c10-private-plan-shape? plan)
            (if (= (get plan :kind)
                 :gravity/stage2-hosted-core-compiled-plan)
              (if (= (get module :exports) ['main])
                (if (map? functions)
                  (if (= (count functions) 1)
                    (map? (get functions 'main))
                    false)
                  false)
                false)
              false)
            false)
          module-contract-valid?
          (if (c6c10-authoritative-module-matches-plan?
               authoritative-module module front-end)
            (if (= (count (get authoritative-module :requires)) 0)
              (if (= (count (get authoritative-module :imports)) 0)
                (if (= (count (get authoritative-module :providers)) 0)
                  (if (= (count (get authoritative-module :metadata)) 0)
                    (= (get authoritative-module :doc) nil)
                    false)
                  false)
                false)
              false)
            false)
          pins-valid?
          (c6c10-private-binding-pins-shape? (get input :binding-pins))
          carrier-valid?
          (c6c10-carrier-validation-shape?
           (get input :carrier-validation))]
      (if (> (count reader-diagnostics) 0)
        (c6c10-upstream-diagnostic-rejection reader-diagnostics)
        (if source-binding-valid?
          (if front-end-shape-valid?
            (if plan-shape-valid?
              (if module-contract-valid?
               (if pins-valid?
                (if carrier-valid?
                (if (= (get module :profile) :hosted)
                (if (= (get module :target) :jvm)
                  (if (= (get module :safety) :safe)
                    (if (= (count (get module :effects)) 0)
                      (if (= (count (get module :capabilities)) 0)
                        (if (= metadata-form nil)
                          (c6c10-build-accepted-template input)
                          (c6c10-input-form-rejection
                           :C6-LOWERING-GAP :lower-to-core
                           :diagnostic/c6-lowering-gap input
                           metadata-form
                           {:missing-fact
                            :metadata-preserving-pure-core-lowering
                            :offending-form-id
                            (get metadata-form :form-id)
                            :offending-form-kind
                            (get metadata-form :kind)}
                           :remove-metadata-from-bounded-pure-slice))
                        (c6c10-envelope-rejection
                         :C6-LOWERING-GAP :lower-to-core
                         :diagnostic/c6-lowering-gap input
                         {:missing-fact :empty-declared-capabilities
                          :observed-capabilities
                          (get module :capabilities)}
                         :remove-capability-requirements))
                      (c6c10-envelope-rejection
                       :C6-LOWERING-GAP :lower-to-core
                       :diagnostic/c6-lowering-gap input
                       {:missing-fact :empty-declared-effects
                        :observed-effects (get module :effects)}
                       :remove-effect-requirements))
                    (c6c10-envelope-rejection
                     :C6-LOWERING-GAP :lower-to-core
                     :diagnostic/c6-lowering-gap input
                     {:missing-fact :safe-source-mode
                      :observed-safety (get module :safety)}
                     :use-safe-source-mode))
                  (c6c10-envelope-rejection
                   :C6-LOWERING-GAP :lower-to-core
                   :diagnostic/c6-lowering-gap input
                   {:missing-fact :bounded-jvm-source-target
                    :observed-source-target (get module :target)}
                   :use-jvm-source-target))
                (c6c10-envelope-rejection
                 :C6-LOWERING-GAP :lower-to-core
                 :diagnostic/c6-lowering-gap input
                 {:missing-fact :bounded-hosted-profile
                  :observed-profile (get module :profile)}
                 :use-hosted-profile))
                (c6c10-envelope-rejection
                 :C6-VERIFY :lower-to-core :diagnostic/c6-verify input
                 {:missing-fact :bounded-generic-input-carrier-validation}
                 :regenerate-bounded-private-envelope))
                (c6c10-envelope-rejection
                 :C6-VERIFY :lower-to-core :diagnostic/c6-verify input
                 {:missing-fact :exact-path-neutral-binding-pins}
                 :regenerate-pinned-source-bindings))
               (c6c10-envelope-rejection
                :C6-LOWERING-GAP :lower-to-core
                :diagnostic/c6-lowering-gap input
                {:missing-fact :bounded-module-dependency-closure}
                :remove-requires-imports-providers-metadata-and-doc))
              (c6c10-envelope-rejection
               :C6-CORE-SHAPE :lower-to-core
               :diagnostic/c6-core-shape input
               {:missing-fact :single-main-stage2-plan}
               :regenerate-pinned-stage2-plan))
            (c6c10-envelope-rejection
             :C6-CORE-SHAPE :lower-to-core
             :diagnostic/c6-core-shape input
             {:missing-fact :bounded-complete-c2-c3-products
              :observed-form-count (count forms)}
             :regenerate-fresh-c2-c3-products))
          (c6c10-envelope-rejection
           :C6-ORIGIN :lower-to-core :diagnostic/c6-origin input
           {:missing-fact :source-content-front-end-plan-binding}
           :regenerate-fresh-bound-products))))
    (c6c10-envelope-rejection
     :C6-CORE-SHAPE :lower-to-core :diagnostic/c6-core-shape input
     {:missing-fact :exact-private-c2-c3-stage2-plan-envelope}
     :supply-exact-private-envelope)))

(defn c6-c10-verify-checked-core-template [input template requests]
  (let [expected (c6-c10-build-checked-core-template input)]
    (if (= (get expected :status) :rejected)
      expected
      (let [expected-template (get expected :artifact-template)]
        (if (c6c10-template-structure-equal? expected-template template)
          (if (c6c10-template-origin-equal? expected-template template)
            (if (c6c10-template-type-equal? expected-template template)
              (if (c6c10-template-effect-equal? expected-template template)
                (if (c6c10-template-ownership-profile-equal?
                     expected-template template)
                  (if (c6c10-template-safety-equal?
                       expected-template template)
                    (if (= template expected-template)
                      (if (= requests (get expected :digest-requests))
                        {:status :passed
                         :artifact-template template
                         :digest-graph-root (get expected :digest-graph-root)
                         :digest-graph-roots
                         (get expected :digest-graph-roots)
                         :request-count (count requests)
                         :semantic-authority :gravity-source
                         :checks [:fresh-template-replay
                                  :exact-digest-request-replay
                                  :bounded-pure-c6-c10-scope]
                         :diagnostics []}
                        (c6c10-template-verification-rejection
                         input expected :C6-VERIFY :lower-to-core
                         :diagnostic/c6-verify
                         :exact-digest-request-replay
                         :discard-mutated-digest-request-graph))
                      (c6c10-template-verification-rejection
                       input expected :C6-VERIFY :lower-to-core
                       :diagnostic/c6-verify
                       :exact-gravity-artifact-template-replay
                       :discard-mutated-artifact-template))
                    (c6c10-template-family-verification-rejection
                     input expected template :safety
                     [:safety] [:safety-facts :proof-records]
                     :C10-PROOF :safety-analysis
                     :diagnostic/c10-proof
                     :exact-gravity-safety-proof-replay
                     :discard-mutated-safety-proof))
                  (c6c10-template-family-verification-rejection
                   input expected template :ownership-profile
                   [:ownership :profile]
                   [:ownership-facts :profile-facts]
                   :C6-VERIFY :lower-to-core
                   :diagnostic/c6-verify
                   :exact-gravity-ownership-profile-replay
                   :discard-mutated-ownership-or-profile-facts))
                (c6c10-template-family-verification-rejection
                 input expected template :effect
                 [:effects :capabilities]
                 [:effect-facts :capability-facts]
                 :C8-VERIFY :effect-check :diagnostic/c8-verify
                 :exact-gravity-effect-capability-replay
                 :discard-mutated-effect-or-capability-facts))
              (c6c10-template-family-verification-rejection
               input expected template :type
               [:type] [:type-facts]
               :C7-VERIFY :type-check :diagnostic/c7-verify
               :exact-gravity-type-replay
               :discard-mutated-type-facts))
            (c6c10-template-family-verification-rejection
             input expected template :origin
             [:source] []
             :C6-ORIGIN :lower-to-core :diagnostic/c6-origin
             :exact-gravity-origin-provenance-replay
             :discard-mutated-origin-or-provenance))
          (c6c10-template-verification-rejection
           input expected :C6-CORE-SHAPE :lower-to-core
           :diagnostic/c6-core-shape
           :exact-gravity-core-structure-replay
           :discard-mutated-core-structure))))))

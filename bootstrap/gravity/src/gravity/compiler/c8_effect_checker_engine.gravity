(defn sh09-adapter-function-upstream-valid? [typed verification]
  (if
   (sh09-exact-keys?
    typed
    (sh09-adapter-function-top-level-keys (get typed :scope)))
    (if (= :gravity/sh08-function-typed-core-template
           (get typed :artifact))
      (if (= 3 (get typed :schema-version))
        (if (= :accepted (get typed :status))
          (if (contains?
               #{:capture-free-higher-order-fixed-arity-one-hop
                 :first-order-fixed-arity-functions-locals-calls}
               (get typed :scope))
            (if (= :host-resolved-b47-verification-boundary
                   (get typed :authentication-status))
              (if (sh09-adapter-module-valid? (get typed :module))
                (if (= [] (get typed :diagnostics))
                  (if (= (get typed :artifact-id-request)
                         (get typed :identity-input))
                    (if (= (sh09-adapter-function-identity-input typed)
                           (get typed :identity-input))
                    (if (sh09-adapter-function-facts-valid?
                         (get typed :function-type-table)
                         (get typed :module))
                      (if
                       (sh09-adapter-call-facts-valid?
                        (get typed :call-type-facts)
                        (get typed :module))
                        (if (= (sh09-adapter-function-typed-core typed)
                               (get typed :typed-core))
                          (if
                           (sh09-exact-keys?
                            (get typed :provenance)
                            #{:actual-source-path})
                            (if
                               (sh09-exact-keys?
                                verification
                                #{:artifact :status :checks
                                  :expected :candidate})
                                (if
                                 (=
                                  :gravity/sh08-function-type-verification
                                  (get verification :artifact))
                                  (if (= :passed
                                         (get verification :status))
                                    (if (= typed
                                           (get verification :expected))
                                      (= typed
                                         (get verification :candidate))
                                      false)
                                    false)
                                  false)
                                false)
                            false)
                          false)
                        false)
                      false)
                    false)
                    false)
                  false)
                false)
              false)
            false)
          false)
        false)
      false)
    false))


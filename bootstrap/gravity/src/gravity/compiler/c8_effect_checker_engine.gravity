(defn sh09-adapter-function-typed-core [typed]
  (let [base
        {:artifact :gravity/typed-core
         :core-input (get typed :sh07-shaped-artifact-id)
         :module (get typed :module)
         :types (get typed :type-table)
         :constraints (get typed :constraint-ledger)
         :function-types (get typed :function-type-table)
         :local-bindings (get typed :local-binding-facts)
         :calls (get typed :call-type-facts)
         :diagnostics []}]
    (if (= :capture-free-higher-order-fixed-arity-one-hop
           (get typed :scope))
      (assoc
       (assoc base :higher-order-proof (get typed :higher-order-proof))
       :higher-order-call-facts (get typed :higher-order-call-facts))
      base)))


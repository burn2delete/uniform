                           (get fact :evaluation-order))
                      (if (= (get module :effects)
                             (get fact :effects))
                        (if (= (get module :capabilities)
                               (get fact :capabilities))
                          (if (= (get module :profile)
                                 (get fact :profile))
                            (if (= (get module :target)
                                   (get fact :target))
                              (= :inferred (get fact :status))
                              false)
                            false)
                          false)
                        false)
                      false)
                    false)
                  false)
                false)
              false)
            false)
          false)
        false)
      false)
    false))

(defn sh09-adapter-compiler-read-call-facts-valid? [facts module]
  (if (vector? facts)
    (if (= 1 (count facts))
      (sh09-adapter-compiler-read-call-fact-valid?
       (first facts) module)
      false)
    false))

(defn sh09-adapter-compiler-read-definition-by-binding-id
  [definitions binding-id]
  (loop [remaining definitions]
    (if (= (count remaining) 0)
      nil
      (if (= (get (first remaining) :binding-id) binding-id)
        (first remaining)
        (recur (rest remaining))))))

(defn sh09-adapter-compiler-read-index [records key-name]
  (loop [remaining records result {}]
    (if (= (count remaining) 0)
      result
      (recur
       (rest remaining)
       (assoc result (get (first remaining) key-name) (first remaining))))))

(defn sh09-adapter-compiler-read-function-record-valid?
  [record function core binding-table]
  (if (sh09-exact-keys?
       record
       #{:ordinal :function-core-node-id :function-form-id
         :function-syntax-id :body-core-node-id :parameter-binding-ids
         :fixed-arity :definition-kind :definition-binding-id
         :definition-core-node-id :definition-name})
    (let [function-node
          (get (get core :nodes) (get record :function-core-node-id))
          definition
          (sh09-adapter-compiler-read-definition-by-binding-id
           (get core :definitions) (get record :definition-binding-id))
          definition-node
          (get (get core :nodes) (get record :definition-core-node-id))
          binding
          (get binding-table (get record :definition-binding-id))]
      (if (= 0 (get record :ordinal))
        (if (= :named-top-level (get record :definition-kind))
          (if (= :fn (get function-node :core-form))
            (if (= (get record :function-form-id)
                   (get (get function-node :source) :form-id))
              (if (= (get record :function-syntax-id)
                     (get function :function-id))
                (if (= (get record :function-syntax-id)
                       (get (get function-node :source) :syntax-id))
                  (if (= (get record :function-core-node-id)
                         (get function :function-core-node-id))
                    (if (= (get record :body-core-node-id)
                           (first (get function-node :children)))
                      (if (= (get record :body-core-node-id)
                             (get function :body-core-node-id))
                        (if (= (get record :parameter-binding-ids)
                               (get function-node :resolved-binding-ids))
                          (if (= (get record :parameter-binding-ids)
                                 (get function :parameter-binding-ids))
                            (if (= (get record :fixed-arity)
                                   (get function :fixed-arity))
                              (if (= (get record :definition-name)
                                     (get function :definition-name))
                                (if (map? definition)
                                  (if (map? definition-node)
                                    (if (map? binding)
                                      (if (= (get definition :binding-id)
                                             (get record
                                                  :definition-binding-id))
                                        (if (= (get definition :core-node-id)
                                               (get record
                                                    :definition-core-node-id))
                                          (if (= (get definition :value-node-id)
                                                 (get record
                                                      :function-core-node-id))
                                            (if (= (get definition :name)
                                                   (get record
                                                        :definition-name))
                                              (if (= (get definition-node
                                                          :core-form)
                                                     :def)
                                                (if (= (get definition
                                                            :syntax-id)
                                                       (get (get
                                                             definition-node
                                                             :source)
                                                            :syntax-id))
                                                  (= (get binding
                                                          :definition-syntax-id)
                                                     (get (get
                                                           definition-node
                                                           :attributes)
                                                          :name-syntax-id))
                                                  false)
                                                false)
                                              false)
                                            false)
                                          false)
                                        false)
                                      false)
                                    false)
                                  false)
                                false)
                              false)
                            false)
                          false)
                        false)
                      false)
                    false)
                  false)
                false)
              false)
            false)
          false)
        false))
    false))

(defn sh09-adapter-compiler-read-call-edge-valid?
  [edge fact function record call core binding-table]
  (if (sh09-exact-keys?
       edge
       #{:ordinal :call-core-node-id :caller-function-syntax-id
         :caller-function-core-node-id :callee-binding-id
         :callee-definition-syntax-id :callee-function-syntax-id
         :callee-function-core-node-id :argument-core-node-ids
         :ordered-evaluation-node-ids :evaluation-order
         :classification})
    (let [callee-binding
          (get binding-table (get edge :callee-binding-id))]
      (if (= 0 (get edge :ordinal))
        (if (= :local-function (get edge :classification))
          (if (= nil (get edge :caller-function-syntax-id))
            (if (= nil (get edge :caller-function-core-node-id))
              (if (= (get edge :call-core-node-id)
                     (get fact :call-core-node-id))
                (if (= (get edge :call-core-node-id)
                       (get call :core-node-id))
                  (if (= (get edge :callee-binding-id)
                         (get call :operator-binding-id))
                    (if (= (get edge :callee-binding-id)
                           (get record :definition-binding-id))
                      (if (= (get edge :callee-definition-syntax-id)
                             (get callee-binding :definition-syntax-id))
                        (if (= (get edge :callee-function-syntax-id)
                               (get fact :callee-function-syntax-id))
                          (if (= (get edge :callee-function-syntax-id)
                                 (get function :function-id))
                            (if (= (get edge :callee-function-core-node-id)
                                   (get record :function-core-node-id))
                              (if (= (get edge :argument-core-node-ids)
                                     (get call :argument-node-ids))
                                (if (= (get edge
                                            :ordered-evaluation-node-ids)
                                       (get call
                                            :ordered-evaluation-node-ids))
                                  (if (= (get edge :evaluation-order)
                                         (get call :evaluation-order))
                                    (if (= :operator-then-arguments
                                           (get edge :evaluation-order))
                                      (= (count
                                          (get edge
                                               :argument-core-node-ids))
                                         (count (get fact :argument-types)))
                                      false)
                                    false)
                                  false)
                                false)
                              false)
                            false)
                          false)
                        false)
                      false)
                    false)
                  false)
                false)
              false)
            false)
          false)
        false))
    false))

(defn sh09-adapter-compiler-read-local-fact-valid?
  [fact record core module]
  (let [node (get (get core :nodes) (get record :initializer-node-id))]
    (if (sh09-exact-keys?
         fact
         #{:artifact :fact-id-request :binding-id :name :type
           :initializer-node-id :let-core-node-id :source-span :syntax-id
           :origin-chain :generated-origin :profile :target :effects
           :capabilities :status})
      (if (= :gravity/c7-local-binding-fact (get fact :artifact))
        (if (= {:domain :gravity/sh08-local-binding-fact-v1
                :binding-id (get record :binding-id)
                :initializer-node-id (get record :initializer-node-id)
                :type (get fact :type)
                :profile (get module :profile)
                :target (get module :target)}
               (get fact :fact-id-request))
          (if (= (get fact :binding-id) (get record :binding-id))
            (if (= (get fact :name) (get record :name))
              (if (= (get fact :initializer-node-id)
                     (get record :initializer-node-id))
                (if (= (get fact :let-core-node-id)
                       (get record :let-core-node-id))
                  (if (= (get fact :source-span)
                         (get (get node :source) :semantic-span))
                    (if (= (get fact :syntax-id)
                           (get (get node :source) :syntax-id))
                      (if (= (get fact :origin-chain)
                             (get (get node :source) :origin-chain))
                        (if (= (get fact :generated-origin)
                               (get (get node :source) :generated-origin))
                          (if (= (get fact :profile) (get module :profile))
                            (if (= (get fact :target) (get module :target))
                              (if (= (get fact :effects)
                                     (get module :effects))
                                (if (= (get fact :capabilities)
                                       (get module :capabilities))
                                  (= :inferred (get fact :status))
                                  false)
                                false)
                              false)
                            false)
                          false)
                        false)
                      false)
                    false)
                  false)
                false)
              false)
            false)
          false)
        false)
      false)))

(defn sh09-adapter-compiler-read-lexical-valid?
  [record fact core binding-table module]
  (if (sh09-exact-keys?
       record
       #{:let-core-node-id :ordinal :name :binding-id
         :definition-form-id :definition-syntax-id :binding-scope-id
         :initializer-form-id :initializer-syntax-id
         :initializer-scope-id :initializer-node-id
         :visible-prior-binding-ids :mutability})
    (let [binding (get binding-table (get record :binding-id))
          let-node (get (get core :nodes) (get record :let-core-node-id))
          initializer
          (get (get core :nodes) (get record :initializer-node-id))]
      (if (= 0 (get record :ordinal))
        (if (symbol? (get record :name))
          (if (map? binding)
            (if (= (get binding :name) (get record :name))
              (if (= (get binding :definition-syntax-id)
                     (get record :definition-syntax-id))
                (if (= (get binding :scope-id)
                       (get record :binding-scope-id))
                  (if (= :let (get let-node :core-form))
                    (if (contains?
                         (set (get let-node :resolved-binding-ids))
                         (get record :binding-id))
                      (if (map? initializer)
                        (if (sh09-sha256-id?
                             (get record :definition-form-id))
                          (if (= (get record :initializer-form-id)
                                 (get (get initializer :source) :form-id))
                            (if (= (get record :initializer-syntax-id)
                                   (get (get initializer :source) :syntax-id))
                              (if (sh09-sha256-id?
                                   (get record :initializer-scope-id))
                                (if (= []
                                       (get record
                                            :visible-prior-binding-ids))
                                  (if (= :immutable (get record :mutability))
                                    (sh09-adapter-compiler-read-local-fact-valid?
                                     fact record core module)
                                    false)
                                  false)
                                false)
                              false)
                            false)
                          false)
                        false)
                      false)
                    false)
                  false)
                false)
              false)
            false)
          false)
        false))
    false))

(defn sh09-adapter-compiler-read-products-valid? [typed binding]
  (let [products (get typed :function-products)
        request
        (get (get binding :digest-resolution) :preimage)
        authenticated-request (get request :request)
        context (get authenticated-request :b47-context)
        core (get authenticated-request :canonical-core-artifact)
        raw-binding-table
        (get (get context :authenticated-core-request) :binding-table)
        binding-table
        (sh09-adapter-compiler-read-index
         raw-binding-table :binding-id)
        indexed-core
        (assoc core :nodes
               (sh09-adapter-compiler-read-index
                (get core :nodes) :node-id))
        records (get products :function-records)
        edges (get products :call-edges)
        components (get products :recursion-components)
        bindings (get products :lexical-bindings)
        functions (get typed :function-type-table)
        facts (get typed :call-type-facts)
        locals (get typed :local-binding-facts)]
    (if (sh09-exact-keys?
         products
         #{:function-records :call-edges
           :recursion-components :lexical-bindings})
      (if (= products
             {:function-records (get core :function-records)
              :call-edges (get core :call-edges)
              :recursion-components (get core :recursion-components)
              :lexical-bindings (get core :lexical-bindings)})
        (if (if (vector? records) (= 1 (count records)) false)
          (if (if (vector? edges) (= 1 (count edges)) false)
            (if (= [] components)
              (if (if (vector? bindings) (= 1 (count bindings)) false)
                (if (if (vector? locals) (= 1 (count locals)) false)
                  (if (= (count raw-binding-table)
                         (count (keys binding-table)))
                    (if (sh09-adapter-compiler-read-function-record-valid?
                         (first records) (first functions)
                         indexed-core binding-table)
                      (if (sh09-adapter-compiler-read-call-edge-valid?
                           (first edges) (first facts) (first functions)
                           (first records) (first (get core :calls))
                           indexed-core binding-table)
                        (sh09-adapter-compiler-read-lexical-valid?
                         (first bindings) (first locals)
                         indexed-core binding-table (get typed :module))
                        false)
                      false)
                    false)
                  false)
                false)
              false)
            false)
          false)
        false)
      false)))

(defn sh09-adapter-compiler-read-upstream-valid?
  [typed verification binding]
  (if
   (=
    (get (sh09-authenticated-compiler-read-policy)
         :required-upstream-verification-checks)
    (get verification :checks))
   (if
    (sh09-exact-keys?
     typed
     (sh09-adapter-function-top-level-keys (get typed :scope)))
    (if (= :gravity/sh08-function-typed-core-template
           (get typed :artifact))
      (if (= 3 (get typed :schema-version))
        (if (= :accepted (get typed :status))
          (if (= :first-order-fixed-arity-functions-locals-calls
                 (get typed :scope))
            (if (= :host-resolved-b47-verification-boundary
                   (get typed :authentication-status))
              (if (sh09-adapter-compiler-read-module-valid?
                   (get typed :module))
                (if (= [] (get typed :diagnostics))
                  (if (= (get typed :artifact-id-request)
                         (get typed :identity-input))
                    (if (= (sh09-adapter-function-identity-input typed)
                           (get typed :identity-input))
                      (if
                       (sh09-adapter-compiler-read-function-facts-valid?
                        (get typed :function-type-table)
                        (get typed :module))
                        (if
                         (sh09-adapter-compiler-read-call-facts-valid?
                          (get typed :call-type-facts)
                          (get typed :module))
                          (if
                           (sh09-adapter-compiler-read-products-valid?
                            typed binding)
                            (if (= (sh09-adapter-function-typed-core typed)
                                   (get typed :typed-core))
                              (if
                               (sh09-exact-keys?
                                (get typed :provenance)
                                #{:actual-source-path})
                                (if
                                 (sh09-exact-keys?
                                  verification
                                  #{:artifact :status :checks
                                    :expected :candidate})
                                  (if
                                   (=
                                    :gravity/sh08-function-type-verification
                                    (get verification :artifact))
                                    (if (= :passed
                                           (get verification :status))
                                      (if (= typed
                                             (get verification :expected))
                                        (= typed
                                           (get verification :candidate))
                                        false)
                                      false)
                                    false)
                                  false)
                                false)
                              false)
                            false)
                          false)
                        false)
                      false)
                    false)
                  false)
                false)
              false)
            false)
          false)
        false)
      false)
    false)
   false))

(defn sh09-adapter-compiler-read-call [typed occurrence]
  (let [fact (first (get typed :call-type-facts))]
    (if (= (get fact :call-core-node-id)
           (get occurrence :call-core-node-id))
      (if (= (get fact :callee-function-syntax-id)
             (get occurrence :callee-function-syntax-id))
        fact
        nil)
      nil)))

(defn sh09-adapter-compiler-read-context-valid? [typed context]
  (let [policy (sh09-authenticated-compiler-read-policy)
        occurrence (get context :occurrence)]
    (if (sh09-exact-keys?
         context (get policy :authority-context-keys))
      (if (= (get policy :authority-context-artifact)
             (get context :artifact))
        (if (= 1 (get context :schema-version))
          (if (sh09-exact-keys?
               occurrence (get policy :occurrence-keys))
            (if (= :gravity/sh09-compiler-read-occurrence
                   (get occurrence :artifact))
              (if (sh09-adapter-compiler-read-call typed occurrence)
                (if (set? (get context :package-effects))
                  (if (set? (get context :deployment-effects))
                    (if (set? (get context :package-capabilities))
                      (if (set? (get context :deployment-capabilities))
                        (if (sh09-hermetic-build-policy? context)
                          (if (sh09-boolean?
                               (get context :safety-allowed))
                            (sh09-authority-mode-valid?
                             (get context :authority-mode))
                            false)
                          false)
                        false)
                      false)
                    false)
                  false)
                false)
              false)
            false)
          false)
        false)
      false)))

(defn sh09-adapter-function-request [typed fact]
  (let [module (get typed :module)
        function-id
        (if (= nil (get fact :caller-function-syntax-id))
          (get fact :callee-function-syntax-id)
          (get fact :caller-function-syntax-id))]
    {:artifact :gravity/sh09-normalized-effect-request
     :request-id (get fact :fact-id-request)
     :core-node-id (get fact :call-core-node-id)
     :syntax-id (get fact :syntax-id)
     :source-span (get fact :source-span)
     :origin-chain (get fact :origin-chain)
     :function function-id
     :namespace (get module :namespace)
     :profile (get module :profile)
     :target (get module :target)
     :phase :build
     :effect nil
     :required-capability nil
     :declared-effects #{}
     :package-effects #{}
     :deployment-effects #{}
     :declared-capabilities #{}
     :package-capabilities #{}
     :deployment-capabilities #{}
     :provider nil
     :grant nil
     :resource-subject nil
     :build-policy {:hermetic true :allowed-effects #{}}
     :safety-allowed true
     :authority-mode :none
     :replay-record nil
     :ordering nil}))

(defn sh09-adapter-function-products [typed]
  (loop [remaining (get typed :call-type-facts)
         requests []
         legality-results []
         nodes {}]
    (if (= (count remaining) 0)
      {:status :accepted
       :requests requests
       :legality-results legality-results
       :nodes nodes}
      (let [fact (first remaining)
            request (sh09-adapter-function-request typed fact)
            legality (sh09-check-effect-request request)]
        (if (= :accepted (get legality :status))
          (recur
           (rest remaining)
           (conj requests request)
           (conj legality-results legality)
           (assoc
            nodes (get fact :call-core-node-id)
            {:artifact :gravity/c8-effect-node
             :core-node-id (get fact :call-core-node-id)
             :direct #{}
             :latent #{}
             :transitive #{}
             :ordering :pure
             :source-span (get fact :source-span)
             :syntax-id (get fact :syntax-id)
             :origin-chain (get fact :origin-chain)
             :generated-origin (get fact :generated-origin)
             :type-fact-id
             {:resolution :coordinator-digest-required
              :identity-input (get fact :fact-id-request)}}))
          {:status :rejected
           :requests (conj requests request)
           :legality-results (conj legality-results legality)
           :nodes nodes
           :diagnostics (get legality :diagnostics)})))))

(defn sh09-adapter-function-effect-table [functions]
  (loop [remaining functions result {}]
    (if (= (count remaining) 0)
      result
      (let [function (first remaining)]
        (recur
         (rest remaining)
         (assoc
          result (get function :function-id)
          {:function-id (get function :function-id)
           :declared #{}
           :inferred #{}
           :latent #{}
           :throws (get function :thrown-error-effects)
           :capabilities #{}
           :source-span (get function :source-span)}))))))

(defn sh09-build-authenticated-function-effect-result [typed verification]
  (let [products (sh09-adapter-function-products typed)
        function-table
        (sh09-adapter-function-effect-table
         (get typed :function-type-table))]
    (if (= :accepted (get products :status))
      (let [effect-graph
            {:artifact :gravity/c8-effect-graph
             :module (get typed :module)
             :nodes (get products :nodes)
             :functions function-table
             :namespace
             {:declared #{} :inferred #{} :escaping #{} :handled []}
             :build-effects []
             :replay-required #{}
             :ordering-constraints []
             :residual-effects #{}
             :diagnostics []}
            identity-input
            {:domain :gravity/sh09-authenticated-function-effected-core-v1
             :sh08-shaped-artifact-id
             (get typed :sh07-shaped-artifact-id)
             :sh08-identity-input (get typed :identity-input)
             :module (get typed :module)
             :type-table (get typed :type-table)
             :function-type-table (get typed :function-type-table)
             :local-binding-facts (get typed :local-binding-facts)
             :call-type-facts (get typed :call-type-facts)
             :effect-requests (get products :requests)
             :effect-legality-results (get products :legality-results)
             :effect-graph effect-graph
             :sh08-verification-checks (get verification :checks)
             :pending
             (get (sh09-authenticated-sh08-adapter-policy) :pending)}]
        {:artifact :gravity/sh09-authenticated-effected-core-template
         :schema-version 1
         :status :accepted
         :scope
         :declared-pure-call-effects-with-thrown-effects-pending
         :authentication-status :host-resolved-sh08-verification-boundary
         :sh08-shaped-artifact-id (get typed :sh07-shaped-artifact-id)
         :module (get typed :module)
         :typed-core (get typed :typed-core)
         :type-table (get typed :type-table)
         :function-type-table (get typed :function-type-table)
         :local-binding-facts (get typed :local-binding-facts)
         :call-type-facts (get typed :call-type-facts)
         :effect-requests (get products :requests)
         :effect-legality-results (get products :legality-results)
         :effect-graph effect-graph
         :identity-input identity-input
         :identity-resolution :coordinator-digest-required
         :upstream-verification
         {:artifact (get verification :artifact)
          :status (get verification :status)
          :checks (get verification :checks)}
         :provenance (get typed :provenance)
         :diagnostics []
         :pending (get identity-input :pending)
         :self-hosted? false
         :clojure-seed-boundary? true})
      {:artifact :gravity/sh09-authenticated-effected-core-template
       :schema-version 1
       :status :rejected
       :scope :declared-pure-call-effects-with-thrown-effects-pending
       :diagnostics (get products :diagnostics)
       :pending
       (get (sh09-authenticated-sh08-adapter-policy) :pending)})))

(defn sh09-build-authenticated-pure-effect-result [typed verification]
  (if (sh09-adapter-function-upstream-valid? typed verification)
    (sh09-build-authenticated-function-effect-result typed verification)
    (if (sh09-adapter-upstream-valid? typed verification)
    (let [products (sh09-adapter-pure-products typed)]
      (if (= :accepted (get products :status))
        (let [effect-graph
              {:artifact :gravity/c8-effect-graph
               :module (get typed :module)
               :nodes (get products :nodes)
               :functions {}
               :namespace
               {:declared #{} :inferred #{} :escaping #{} :handled []}
               :build-effects []
               :replay-required #{}
               :ordering-constraints []
               :residual-effects #{}
               :diagnostics []}
              identity-input
              {:domain :gravity/sh09-authenticated-pure-effected-core-v1
               :sh08-artifact-id (get typed :artifact-id)
               :sh08-identity-input (get typed :identity-input)
               :module (get typed :module)
               :type-table (get typed :type-table)
               :type-facts (get typed :type-facts)
               :effect-requests (get products :requests)
               :effect-legality-results (get products :legality-results)
               :effect-graph effect-graph
               :sh08-verification-checks (get verification :checks)
               :pending
               (get (sh09-authenticated-sh08-adapter-policy) :pending)}]
          {:artifact :gravity/sh09-authenticated-effected-core-template
           :schema-version 1
           :status :accepted
           :scope :pure-authenticated-sh08-primitive-typed-core
           :authentication-status :host-resolved-sh08-verification-boundary
           :sh08-artifact-id (get typed :artifact-id)
           :module (get typed :module)
           :typed-core (get typed :typed-core)
           :type-table (get typed :type-table)
           :type-facts (get typed :type-facts)
           :effect-requests (get products :requests)
           :effect-legality-results (get products :legality-results)
           :effect-graph effect-graph
           :identity-input identity-input
           :identity-resolution :coordinator-digest-required
           :upstream-verification
           {:artifact (get verification :artifact)
            :status (get verification :status)
            :checks (get verification :checks)}
           :provenance (get typed :provenance)
           :diagnostics []
           :pending (get identity-input :pending)
           :self-hosted? false
           :clojure-seed-boundary? true})
        {:artifact :gravity/sh09-authenticated-effected-core-template
         :schema-version 1
         :status :rejected
         :scope :pure-authenticated-sh08-primitive-typed-core
         :diagnostics (get products :diagnostics)
         :pending
         (get (sh09-authenticated-sh08-adapter-policy) :pending)}))
    {:artifact :gravity/sh09-authenticated-effected-core-template
     :schema-version 1
     :status :rejected
     :scope :pure-authenticated-sh08-primitive-typed-core
     :diagnostics
     [(sh09-adapter-diagnostic typed :untrusted-or-effectful-sh08-typed-core)]
     :pending (get (sh09-authenticated-sh08-adapter-policy) :pending)})))

(defn sh09-verify-authenticated-pure-effect-result
  [typed verification candidate]
  (let [expected
        (sh09-build-authenticated-pure-effect-result typed verification)]
    {:artifact :gravity/sh09-authenticated-effect-result-verification
     :status (if (= expected candidate) :passed :rejected)
     :checks [:fresh-sh08-verification-boundary
              :exact-type-fact-preservation
              :pure-effect-request-recomputation
              :pure-effect-graph-recomputation
              :path-neutral-identity-input
              :separate-actual-path-provenance]
     :expected expected
     :candidate candidate}))

(defn sh09-adapter-compiler-read-declared-set [values expected value]
  (if (= values expected) #{value} #{}))

(defn sh09-adapter-compiler-read-request [typed context]
  (let [module (get typed :module)
        fact
        (sh09-adapter-compiler-read-call
         typed (get context :occurrence))
        function-id
        (if (= nil (get fact :caller-function-syntax-id))
          (get fact :callee-function-syntax-id)
          (get fact :caller-function-syntax-id))]
    {:artifact :gravity/sh09-normalized-effect-request
     :request-id (get fact :fact-id-request)
     :core-node-id (get fact :call-core-node-id)
     :syntax-id (get fact :syntax-id)
     :source-span (get fact :source-span)
     :origin-chain (get fact :origin-chain)
     :function function-id
     :namespace (get module :namespace)
     :profile (get module :profile)
     :target (get module :target)
     :phase :build
     :effect :compiler/read-ir
     :required-capability :compiler/ir-read
     :declared-effects
     (sh09-adapter-compiler-read-declared-set
      (get module :effects) [:compiler/read-ir] :compiler/read-ir)
     :package-effects (get context :package-effects)
     :deployment-effects (get context :deployment-effects)
     :declared-capabilities
     (sh09-adapter-compiler-read-declared-set
      (get module :capabilities)
      [:compiler/ir-read] :compiler/ir-read)
     :package-capabilities (get context :package-capabilities)
     :deployment-capabilities (get context :deployment-capabilities)
     :provider (get context :provider)
     :grant (get context :grant)
     :resource-subject (get context :resource-subject)
     :build-policy (get context :build-policy)
     :safety-allowed (get context :safety-allowed)
     :authority-mode (get context :authority-mode)
     :replay-record (get context :replay-record)
     :ordering (get context :ordering)}))

(defn sh09-adapter-compiler-read-diagnostic [typed reason]
  (let [fact (first (get typed :call-type-facts))
        module (get typed :module)]
    {:diagnostic-id "C8-VERIFY"
     :rule "C8-VERIFY"
     :severity :error
     :stage :effect-checking
     :reason reason
     :denied-layer :authenticated-sh08-compiler-read-adapter
     :core-node-id (get fact :call-core-node-id)
     :syntax-id (get fact :syntax-id)
     :source-span (get fact :source-span)
     :generated-origin-chain (get fact :origin-chain)
     :function (get fact :caller-function-syntax-id)
     :namespace (get module :namespace)
     :effect :compiler/read-ir
     :capability :compiler/ir-read
     :profile (get module :profile)
     :target (get module :target)
     :provider nil
     :grant nil
     :remediation
     :supply-an-exact-authenticated-sh08-call-and-bounded-authority-context}))

(defn sh09-adapter-compiler-read-function-table [typed]
  (let [function (first (get typed :function-type-table))
        declared
        (sh09-adapter-compiler-read-declared-set
         (get (get typed :module) :effects)
         [:compiler/read-ir] :compiler/read-ir)
        capabilities
        (sh09-adapter-compiler-read-declared-set
         (get (get typed :module) :capabilities)
         [:compiler/ir-read] :compiler/ir-read)]
    {(get function :function-id)
     {:function-id (get function :function-id)
      :declared declared
      :inferred declared
      :latent declared
      :throws (get function :thrown-error-effects)
      :capabilities capabilities
      :source-span (get function :source-span)}}))

(defn sh09-build-authenticated-compiler-read-effect-result
  [typed verification binding context]
  (let [binding-preflight
        (sh09-structural-preflight
         {:artifact (get binding :artifact)
          :schema-version (get binding :schema-version)
          :boundary (get binding :boundary)
          :status (get binding :status)
          :digest
          (get (get binding :digest-resolution) :digest)})
        context-preflight (sh09-structural-preflight context)]
    (if (= :rejected (get binding-preflight :status))
      {:artifact :gravity/sh09-authenticated-effected-core-template
       :schema-version 1
       :status :rejected
       :scope :declared-compiler-read-call-effect
       :diagnostics
       [(sh09-adapter-compiler-read-diagnostic
         typed (get binding-preflight :reason))]
       :pending
       (get (sh09-authenticated-compiler-read-policy) :pending)}
      (if (sh09-not
           (sh09-adapter-compiler-read-binding-valid?
            typed verification binding))
        {:artifact :gravity/sh09-authenticated-effected-core-template
         :schema-version 1
         :status :rejected
         :scope :declared-compiler-read-call-effect
         :diagnostics
         [(sh09-adapter-compiler-read-diagnostic
           typed :untrusted-sh08-function-binding)]
         :pending
         (get (sh09-authenticated-compiler-read-policy) :pending)}
        (if (sh09-not
             (sh09-adapter-compiler-read-upstream-valid?
              typed verification binding))
          {:artifact :gravity/sh09-authenticated-effected-core-template
           :schema-version 1
           :status :rejected
           :scope :declared-compiler-read-call-effect
           :diagnostics
           [(sh09-adapter-compiler-read-diagnostic
             typed :untrusted-sh08-compiler-read-carrier)]
           :pending
           (get (sh09-authenticated-compiler-read-policy) :pending)}
          (if (= :rejected (get context-preflight :status))
            {:artifact :gravity/sh09-authenticated-effected-core-template
             :schema-version 1
             :status :rejected
             :scope :declared-compiler-read-call-effect
             :diagnostics
             [(sh09-adapter-compiler-read-diagnostic
               typed (get context-preflight :reason))]
             :pending
             (get (sh09-authenticated-compiler-read-policy) :pending)}
            (if (sh09-not
                 (sh09-adapter-compiler-read-context-valid? typed context))
              {:artifact :gravity/sh09-authenticated-effected-core-template
               :schema-version 1
               :status :rejected
               :scope :declared-compiler-read-call-effect
               :diagnostics
               [(sh09-adapter-compiler-read-diagnostic
                 typed :malformed-compiler-read-authority-context)]
               :pending
               (get (sh09-authenticated-compiler-read-policy) :pending)}
              (let [request
                    (sh09-adapter-compiler-read-request typed context)
                    legality (sh09-check-effect-request request)]
                (if (= :accepted (get legality :status))
                  (let [fact (first (get typed :call-type-facts))
                        effect-set #{:compiler/read-ir}
                        node
                    {:artifact :gravity/c8-effect-node
                     :core-node-id (get fact :call-core-node-id)
                     :direct effect-set
                     :latent effect-set
                     :transitive effect-set
                     :ordering (get request :ordering)
                     :source-span (get fact :source-span)
                     :syntax-id (get fact :syntax-id)
                     :origin-chain (get fact :origin-chain)
                     :generated-origin (get fact :generated-origin)
                     :type-fact-id
                     {:resolution :coordinator-digest-required
                      :identity-input (get fact :fact-id-request)}}
                        effect-graph
                    {:artifact :gravity/c8-effect-graph
                     :module (get typed :module)
                     :nodes {(get fact :call-core-node-id) node}
                     :functions
                     (sh09-adapter-compiler-read-function-table typed)
                     :namespace
                     {:declared effect-set
                      :inferred effect-set
                      :escaping effect-set
                      :handled []}
                     :build-effects [:compiler/read-ir]
                     :replay-required #{}
                     :ordering-constraints
                     [{:effect :compiler/read-ir
                       :core-node-id (get fact :call-core-node-id)
                       :ordering (get request :ordering)}]
                     :residual-effects effect-set
                     :diagnostics []}
                        identity-input
                    {:domain
                     :gravity/sh09-authenticated-compiler-read-effected-core-v1
                     :sh08-shaped-artifact-id
                     (get typed :sh07-shaped-artifact-id)
                     :sh08-identity-input (get typed :identity-input)
                     :module (get typed :module)
                     :function-type-table (get typed :function-type-table)
                     :call-type-facts (get typed :call-type-facts)
                     :authority-context context
                     :effect-request request
                     :effect-legality-result legality
                     :capability-proof (get legality :capability-proof)
                     :effect-graph effect-graph
                     :sh08-verification-checks (get verification :checks)
                     :pending
                     (get (sh09-authenticated-compiler-read-policy)
                          :pending)}]
                    {:artifact :gravity/sh09-authenticated-effected-core-template
                 :schema-version 1
                 :status :accepted
                 :scope :declared-compiler-read-call-effect
                 :authentication-status
                 :host-resolved-sh08-function-binding
                 :upstream-binding
                 {:artifact (get binding :artifact)
                  :boundary (get binding :boundary)
                  :status (get binding :status)
                  :digest
                  (get (get binding :digest-resolution) :digest)}
                 :sh08-shaped-artifact-id
                 (get typed :sh07-shaped-artifact-id)
                 :module (get typed :module)
                 :typed-core (get typed :typed-core)
                 :function-type-table (get typed :function-type-table)
                 :call-type-facts (get typed :call-type-facts)
                 :authority-context context
                 :effect-requests [request]
                 :effect-legality-results [legality]
                 :effect-graph effect-graph
                 :identity-input identity-input
                 :identity-resolution :coordinator-digest-required
                 :upstream-verification
                 {:artifact (get verification :artifact)
                  :status (get verification :status)
                  :checks (get verification :checks)}
                 :provenance (get typed :provenance)
                 :diagnostics []
                 :pending (get identity-input :pending)
                 :self-hosted? false
                 :clojure-seed-boundary? true})
                  {:artifact :gravity/sh09-authenticated-effected-core-template
                   :schema-version 1
                   :status :rejected
                   :scope :declared-compiler-read-call-effect
                   :authority-context context
                   :effect-requests [request]
                   :effect-legality-results [legality]
                   :diagnostics (get legality :diagnostics)
                   :pending
                   (get (sh09-authenticated-compiler-read-policy)
                        :pending)})))))))))

(defn sh09-verify-authenticated-compiler-read-effect-result
  [typed verification binding context candidate]
  (let [expected
        (sh09-build-authenticated-compiler-read-effect-result
         typed verification binding context)]
    {:artifact
     :gravity/sh09-authenticated-compiler-read-effect-result-verification
     :status (if (= expected candidate) :passed :rejected)
     :checks [:fresh-authenticated-sh08-function-typed-core
              :coordinator-sealed-sh08-request-result-verification
              :closed-compiler-read-occurrence-binding
              :declared-effect-propagation
              :separate-required-capability
              :exact-authority-context
              :profile-legality
              :path-neutral-identity-input
              :separate-actual-path-provenance]
     :expected expected
     :candidate candidate}))

(defn sh09-effect-identity-request [kind core-node-id identity-input]
  {:domain :gravity/sh09-effect-fact-identity-v1
   :kind kind
   :core-node-id core-node-id
   :identity-input identity-input})

(defn sh09-effect-identity-requests-loop
  [remaining legality-results nodes requests]
  (if (= (count remaining) 0)
    requests
    (let [effect-request (first remaining)
          legality (first legality-results)
          core-node-id (get effect-request :core-node-id)
          node (get nodes core-node-id)
          type-input (get (get node :type-fact-id) :identity-input)]
      (sh09-effect-identity-requests-loop
       (rest remaining)
       (rest legality-results)
       nodes
       (conj
        (conj
         (conj
          requests
          (sh09-effect-identity-request
           :type-fact core-node-id type-input))
         (sh09-effect-identity-request
          :effect-fact core-node-id
          {:effect-request effect-request
           :effect-legality-result legality
           :effect-node node}))
        (sh09-effect-identity-request
         :capability-proof core-node-id
         {:authority-mode :none
          :declared-capabilities #{}
          :required-capability nil}))))))

(defn sh09-authenticated-effect-identity-requests
  [typed verification effected]
  (let [fresh
        (sh09-verify-authenticated-pure-effect-result
         typed verification effected)]
    (if (= :passed (get fresh :status))
      {:artifact :gravity/sh09-effect-identity-request-template
       :schema-version 1
       :status :accepted
       :effect-scope (get effected :scope)
       :requests
       (sh09-effect-identity-requests-loop
        (get effected :effect-requests)
        (get effected :effect-legality-results)
        (get (get effected :effect-graph) :nodes)
        [])
       :resolution :coordinator-digest-required
       :diagnostics []}
      {:artifact :gravity/sh09-effect-identity-request-template
       :schema-version 1
       :status :rejected
       :effect-scope (get effected :scope)
       :requests []
       :resolution :coordinator-digest-required
       :diagnostics
       [(sh09-adapter-diagnostic
         typed :unverified-authenticated-effected-core)]})))

(defn sh09-resolved-effect-identities-valid?
  [requests resolved]
  (if (= (count requests) (count resolved))
    (if (= (count requests) 0)
      true
      (let [entry (first resolved)]
        (if (map? entry)
          (if (sh09-exact-keys? entry #{:request :digest})
            (if (= (first requests) (get entry :request))
              (if (sh09-sha256-id? (get entry :digest))
                (sh09-resolved-effect-identities-valid?
                 (rest requests) (rest resolved))
                false)
              false)
            false)
          false)))
    false))

(defn sh09-bound-effect-identities
  [requests resolved result]
  (if (= (count requests) 0)
    result
    (let [type-entry (first resolved)
          effect-entry (first (rest resolved))
          capability-entry (first (rest (rest resolved)))
          core-node-id (get (first requests) :core-node-id)]
      (sh09-bound-effect-identities
       (rest (rest (rest requests)))
       (rest (rest (rest resolved)))
       (assoc
        result core-node-id
        {:type-fact-id (get type-entry :digest)
         :effect-fact-id (get effect-entry :digest)
         :capability-proof-id (get capability-entry :digest)})))))

(defn sh09-bind-authenticated-effect-identities
  [typed verification effected resolved]
  (let [template
        (sh09-authenticated-effect-identity-requests
         typed verification effected)
        requests (get template :requests)]
    (if (= :accepted (get template :status))
      (if (vector? resolved)
        (if (sh09-resolved-effect-identities-valid? requests resolved)
          (let [facts
                (sh09-bound-effect-identities requests resolved {})
                identity-input
                {:domain :gravity/sh09-identity-bound-effected-core-v1
                 :effected-core-identity-input
                 (get effected :identity-input)
                 :fact-identities facts
                 :pending
                 (get (sh09-authenticated-sh08-adapter-policy) :pending)}]
            {:artifact
             :gravity/sh09-identity-bound-effected-core-template
             :schema-version 1
             :status :accepted
             :scope (get effected :scope)
             :effected-core effected
             :fact-identities facts
             :identity-input identity-input
             :identity-resolution :coordinator-digest-bound
             :provenance (get effected :provenance)
             :diagnostics []
             :pending (get identity-input :pending)
             :self-hosted? false
             :clojure-seed-boundary? true})
          {:artifact
           :gravity/sh09-identity-bound-effected-core-template
           :schema-version 1
           :status :rejected
           :scope (get effected :scope)
           :diagnostics
           [(sh09-adapter-diagnostic
             typed :effect-identity-resolution-substitution)]
           :pending
           (get (sh09-authenticated-sh08-adapter-policy) :pending)})
        {:artifact
         :gravity/sh09-identity-bound-effected-core-template
         :schema-version 1
         :status :rejected
         :scope (get effected :scope)
         :diagnostics
         [(sh09-adapter-diagnostic
           typed :malformed-effect-identity-resolution)]
         :pending
         (get (sh09-authenticated-sh08-adapter-policy) :pending)})
      {:artifact :gravity/sh09-identity-bound-effected-core-template
       :schema-version 1
       :status :rejected
       :scope (get effected :scope)
       :diagnostics (get template :diagnostics)
       :pending
       (get (sh09-authenticated-sh08-adapter-policy) :pending)})))

(defn sh09-verify-authenticated-effect-identities
  [typed verification effected resolved candidate]
  (let [expected
        (sh09-bind-authenticated-effect-identities
         typed verification effected resolved)]
    {:artifact :gravity/sh09-effect-identity-binding-verification
     :status (if (= expected candidate) :passed :rejected)
     :checks [:fresh-authenticated-effected-core
              :exact-digest-request-order
              :resolved-digest-shape
              :type-effect-capability-linkage
              :path-neutral-identity-input
              :separate-actual-path-provenance]
     :expected expected
     :candidate candidate}))

(defn sh09-verify-effect-result [request candidate]
  (let [request-preflight (sh09-structural-preflight request)
        candidate-preflight (sh09-structural-preflight candidate)]
    (if
     (sh09-and
      (= :accepted (get request-preflight :status))
      (= :accepted (get candidate-preflight :status)))
     (if (= candidate (sh09-check-effect-request request))
       {:artifact :gravity/sh09-effect-result-verification
        :status :passed
        :request-id (get request :request-id)
        :checks [:complete-recomputation
                 :policy-identity
                 :diagnostic-identity
                 :capability-proof-identity
                 :source-lineage-identity]}
       {:artifact :gravity/sh09-effect-result-verification
        :status :rejected
        :request-id (get request :request-id)
        :diagnostics
        [(sh09-diagnostic
          request "C8-VERIFY" :effect-result-substitution
          :result-identity :recompute-from-the-normalized-request)]})
     {:artifact :gravity/sh09-effect-result-verification
      :status :rejected
      :request-id (get request :request-id)
      :diagnostics
      [(sh09-diagnostic
        request "C8-VERIFY" :effect-result-structural-bound
        :structural-bounds :supply-a-bounded-result-candidate)]})))

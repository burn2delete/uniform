      :module :sh07-shaped-artifact-id :function-products
      :function-type-table :local-binding-facts :call-type-facts
      :constraint-ledger :type-table :convergence :typed-core
      :diagnostics :artifact-id-request :identity-input
      :identity-resolution :provenance :pending
      :higher-order-proof :higher-order-call-facts}

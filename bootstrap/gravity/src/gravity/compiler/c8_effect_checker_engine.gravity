                  (if (= (get module :target) (get function :target))
                    (if (map? (get function :source-span))
                      (= :inferred (get function :status))
                      false)
                    false)
                  false)
                false)
              false)
            false)
          false)
        false)
      false)
    false))

(defn sh09-adapter-function-facts-valid? [functions module]
  (if (vector? functions)
    (if (> (count functions) 0)
      (loop [remaining functions seen #{}]
        (if (= (count remaining) 0)
          true
          (let [function (first remaining)
                function-id (get function :function-id)]
            (if (sh09-adapter-function-fact-valid? function module)
              (if (contains? seen function-id)
                false
                (recur (rest remaining) (conj seen function-id)))
              false))))
      false)
    false))


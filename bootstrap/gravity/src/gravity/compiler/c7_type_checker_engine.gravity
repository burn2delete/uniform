     :profile (get module :profile) :target (get module :target) :effects (get descriptor :direct-effects) :capabilities [] :status :inferred
     :dispatch :direct-keyword-set-contains :applied-keyword-set-contains descriptor :effect-facts-source :audited-keyword-set-membership-intrinsic}))))))

(defn sh08-ksm-finish [header]
  (let [type (if (= :normal (get header :application)) :gravity.type/bool :gravity.type/never)]
    (assoc header :parameter-types (get header :argument-types) :return type :result-type type)))

(defn sh08-ksm-derive [core node call edge nodes bindings types forms]
  (if (if (vector? (get call :argument-node-ids)) (= 2 (count (get call :argument-node-ids))) false)
    (if (sh08-sse-call-ids? node call)
      (let [args (get call :argument-node-ids) arguments (sh08-ft-ordered-child-types args types)
            domain (sh08-ksm-domain arguments) owner-id (get (get node :source) :form-id)
            owner (if (if (keyword? owner-id) true (if (string? owner-id) (= 71 (count owner-id)) false)) (get forms owner-id) nil)
            ids (get owner :child-form-ids)]
        (if (= :accepted (get domain :status))
          (let [header (sh08-ksm-source core node call edge nodes bindings types (get core :module) domain)]
            (if (if (if (map? header) (if (contains? #{:symbol :integer} (get domain :membership-family)) (sh08-ksin-call-forms? node nodes forms) true) false)
                  (sh08-ft-all-true?
                    [(= :list (get owner :kind)) (= (get node :source) (sh08-ma-form-source owner))
                     (vector? ids) (= 3 (if (vector? ids) (count ids) 0))
                     (= {:operator-child-index 0 :argument-count 2 :argument-child-indexes [1 2]
                         :evaluation-order :operator-then-arguments :dispatch :resolved-symbol-call} (get node :attributes))
                     (loop [i 0]
                       (if (= i 3) true
                         (let [form (get forms (get ids i)) child (get nodes (get (get node :children) i))]
                           (if (sh08-ft-all-true? [(= (get owner :form-id) (get form :parent-form-id))
                                 (= (get child :source) (sh08-ma-form-source form))
                                 (if (= i 0) (= (get form :value) (get (get child :attributes) :symbol)) true)])
                             (recur (+ i 1)) false))))]) false)
              (let [descriptor (sh08-ksm-finish header)]
                {:status :accepted :descriptor descriptor :type (get descriptor :result-type)
                 :constraint (sh08-ksm-constraint descriptor)})
              (sh08-sm-failure "C7-VERIFY" (if (= :integer (get domain :membership-family)) :integer-set-contains-source-mismatch
                     (if (= :symbol (get domain :membership-family)) :symbol-set-contains-source-mismatch
                         (if (= :character (get domain :membership-family)) :character-set-contains-source-mismatch
                           (if (= :string (get domain :membership-family)) :string-set-contains-source-mismatch :keyword-set-contains-source-mismatch)))) nil :exact-operator-set-needle-source
                       (get node :node-id))))
          (sh08-sm-failure "C7-TYPE-MISMATCH" (get domain :reason) nil
            (if (= :integer (get domain :membership-family)) :established-finite-integer-set-and-integer
              (if (= :symbol (get domain :membership-family)) :established-finite-symbol-set-and-symbol
                (if (= :character (get domain :membership-family)) :established-finite-character-set-and-character
                  (if (= :string (get domain :membership-family)) :established-finite-string-set-and-string
                    :established-finite-keyword-set-and-keyword)))) arguments)))
      (sh08-sm-failure "C7-VERIFY" :keyword-set-contains-source-mismatch nil :closed-membership-source-identities nil))
    (sh08-sm-failure "C7-TYPE-MISMATCH" :keyword-set-contains-arity-mismatch nil :binary-membership-call nil)))

(defn sh08-ksm-inferred-call [core node call edge nodes bindings types]
  (if (if (vector? (get call :argument-node-ids)) (= 2 (count (get call :argument-node-ids))) false)
    (if (sh08-sse-call-ids? node call)
      (let [domain (sh08-ksm-domain (sh08-ft-ordered-child-types (get call :argument-node-ids) types))]
        (if (= :accepted (get domain :status))
          (let [header (sh08-ksm-source core node call edge nodes bindings types (get core :module) domain)]
            (if (if (map? header) (= (get types (get call :operator-node-id)) (sh08-ksm-finish header)) false)
              {:status :accepted}
              {:status :rejected :reason (if (= :integer (get domain :membership-family)) :integer-set-contains-source-mismatch
                     (if (= :symbol (get domain :membership-family)) :symbol-set-contains-source-mismatch
                       (if (= :character (get domain :membership-family)) :character-set-contains-source-mismatch
                         (if (= :string (get domain :membership-family)) :string-set-contains-source-mismatch :keyword-set-contains-source-mismatch))))}))
          domain))
      {:status :rejected :reason :keyword-set-contains-source-mismatch})
    {:status :rejected :reason :keyword-set-contains-arity-mismatch}))

(defn sh08-mc-source [core node call edge nodes bindings types module]
  (if (if (vector? (get call :argument-node-ids)) (vector? (get node :children)) false)
  (let [children (get node :children) operator (get nodes (get call :operator-node-id))
        bid (get call :operator-binding-id) binding (get bindings bid) args (get call :argument-node-ids)
        arguments (sh08-ft-ordered-child-types args types)
        invoked? (loop [remaining arguments]
                   (if (= 0 (count remaining)) true
                     (if (= :gravity.type/never (first remaining)) false (recur (rest remaining)))))
        caller (loop [remaining (get core :function-records)]
                 (if (= 0 (count remaining)) nil
                   (if (= (get (first remaining) :function-syntax-id) (get (get node :evaluation) :owner-function-syntax-id))
                     (first remaining) (recur (rest remaining)))))
        expected-call {:core-node-id (get node :node-id) :operator-node-id (first children) :operator-binding-id bid
                       :argument-node-ids (vec (rest children)) :ordered-evaluation-node-ids children
                       :evaluation-order :operator-then-arguments :result-policy :call-result}
        expected-edge {:ordinal (get edge :ordinal) :call-core-node-id (get node :node-id)
                       :caller-function-syntax-id (get caller :function-syntax-id) :caller-function-core-node-id (get caller :function-core-node-id)
                       :callee-binding-id bid :callee-definition-syntax-id (get binding :definition-syntax-id)
                       :callee-function-syntax-id nil :callee-function-core-node-id nil :argument-core-node-ids args
                       :ordered-evaluation-node-ids children :evaluation-order :operator-then-arguments :classification :nonlocal-or-nonfunction}]
    (if (sh08-ft-all-true?
          [(= :call (get node :core-form)) (= :reference (get operator :core-form))
           (= 2 (count args)) (= expected-call call) (= expected-edge edge) (sh08-mc-binding? binding module)
           (= [bid] (get node :resolved-binding-ids) (get operator :resolved-binding-ids))
           (= {:symbol (get (get operator :attributes) :symbol) :position :operator :binding-id bid :binding-class :core
               :definition-syntax-id (get binding :definition-syntax-id)} (get operator :attributes))
           (contains? '#{contains? gravity.core/contains?} (get (get operator :attributes) :symbol))
           (= :operator-then-arguments (get (get node :evaluation) :kind))
           (= (loop [i 0 out []] (if (= i (count children)) out
                (recur (+ i 1) (conj out {:index i :core-node-id (get children i)})))) (get (get node :evaluation) :order))
           (if (= :gravity.type/never (first arguments)) true
             (= :gravity.type/map (if (map? (first arguments)) (get (first arguments) :kind) (first arguments))))
           (contains? #{:gravity.type/string :gravity.type/keyword :gravity.type/never} (get arguments 1))
           (loop [remaining arguments]
             (if (= 0 (count remaining)) true
               (if (contains? #{nil :gravity.type/unknown} (first remaining)) false (recur (rest remaining)))))] )
      {:kind :gravity.type/applied-map-contains :version :sh08-map-contains-v1
       :operation 'contains? :semantic-owner 'gravity.collections :intrinsic :gravity.collections/map-membership
       :resolution :gravity.core-compatibility :operator-node-id (get operator :node-id) :operator-binding-id bid
       :call-core-node-id (get node :node-id) :source (get node :source) :operator-source (get operator :source)
       :source-call call :source-edge edge :source-binding binding :argument-types arguments
       :membership-policy {:input :established-map :keys [:string :keyword] :key-equality :value
                           :presence :independent-of-value :normalization :none :coercion :none
                           :operand-evaluation :map-then-key-once :values :unobserved}
       :application (if invoked? :normal :not-invoked)
       :latent-effects [] :direct-effects [] :capabilities [] :thrown-error-effects []
       :profile (get module :profile) :target (get module :target)
       :invalidation [:calls :call-edges :binding-table :source-forms :type-table :lexical-bindings :definitions :function-records
                      :callee-body :map-type :key-domain :membership-policy :profile :target :evaluation-order]} nil)) nil))

(defn sh08-mc-constraint [descriptor]
  {:constraint-id-request {:domain :gravity/sh08-map-contains-constraint-v1 :application descriptor}
   :kind :equality :producer-rule :sh08-map-contains-v1
   :lhs {:core-node-id (get descriptor :call-core-node-id) :projection :map-contains}
   :rhs (get descriptor :result-type) :dependencies descriptor :origin (get (get descriptor :source) :origin-chain)
   :solution {:result-type (get descriptor :result-type) :application (get descriptor :application)
              :direct-effects (get descriptor :direct-effects)}
   :invalidation (get descriptor :invalidation) :profile (get descriptor :profile) :target (get descriptor :target)
   :status :solved :diagnostics []})

(defn sh08-mc-call-fact [descriptor module]
  (let [source (get descriptor :source) edge (get descriptor :source-edge)]
    {:artifact :gravity/c7-call-type-fact
     :fact-id-request {:domain :gravity/sh08-map-contains-call-type-fact-v1 :application descriptor}
     :call-core-node-id (get descriptor :call-core-node-id) :caller-function-syntax-id (get edge :caller-function-syntax-id)
     :callee-function-syntax-id nil :argument-types (get descriptor :argument-types) :result-type (get descriptor :result-type)
     :evaluation-order :operator-then-arguments :source-span (get source :semantic-span) :syntax-id (get source :syntax-id)
     :origin-chain (get source :origin-chain) :generated-origin (get source :generated-origin)
     :profile (get module :profile) :target (get module :target) :effects (get descriptor :direct-effects) :capabilities [] :status :inferred
     :dispatch :direct-map-contains :applied-map-contains descriptor :effect-facts-source :audited-collection-intrinsic}))


(defn sh08-mc-finish [header]
  (let [type (if (= :normal (get header :application)) :gravity.type/bool :gravity.type/never)]
    (assoc header :parameter-types (get header :argument-types) :return type :result-type type)))

(defn sh08-mc-derive [core node call edge nodes bindings types forms]
  ; STD3 membership queries a known Map with an independently established
  ; String or Keyword key, without inspecting stored values or map shape.
  (let [args (get call :argument-node-ids)
        owner (get forms (get (get node :source) :form-id)) ids (get owner :child-form-ids)]
    (let [header (sh08-mc-source core node call edge nodes bindings types (get core :module))]
        (if (= header nil)
          (sh08-sm-failure "C7-TYPE-MISMATCH"
                   (if (= 2 (count args)) :map-contains-operand-type-required :map-contains-arity-mismatch)
                   nil :established-map-and-string-or-keyword-key (sh08-ft-ordered-child-types args types))
          (if (sh08-ft-all-true?
                [(= :list (get owner :kind)) (= (get node :source) (sh08-ma-form-source owner)) (vector? ids) (= 3 (if (vector? ids) (count ids) 0))
                 (= {:operator-child-index 0 :argument-count 2 :argument-child-indexes [1 2]
                     :evaluation-order :operator-then-arguments :dispatch :resolved-symbol-call} (get node :attributes))
                 (loop [i 0]
                   (if (= i 3) true
                     (let [form (get forms (get ids i)) child (get nodes (get (get node :children) i))]
                       (if (sh08-ft-all-true? [(= (get owner :form-id) (get form :parent-form-id))
                             (= (get child :source) (sh08-ma-form-source form))
                             (if (= i 0) (= (get form :value) (get (get child :attributes) :symbol)) true)])
                         (recur (+ i 1)) false))))])
            (let [descriptor (sh08-mc-finish header)]
              {:status :accepted :descriptor descriptor :type (get descriptor :result-type)
               :constraint (sh08-mc-constraint descriptor)})
            (sh08-sm-failure "C7-VERIFY" :map-contains-source-mismatch nil :exact-operator-map-key-source (get node :node-id)))))))

(defn sh08-mc-node? [node context]
  (if (= :call (get node :core-form))
    (sh08-mc-binding? (get (get context :ordering-bindings) (first (get node :resolved-binding-ids)))
                     (get (get context :ordering-core) :module)) false))

(defn sh08-mc-inferred-call-valid? [core node call edge nodes bindings types]
  (if (contains? #{:gravity.type/applied-keyword-set-contains :gravity.type/applied-character-set-contains :gravity.type/applied-string-set-contains :gravity.type/applied-symbol-set-contains :gravity.type/applied-integer-set-contains} (get (get types (get call :operator-node-id)) :kind))
    (= :accepted (get (sh08-ksm-inferred-call core node call edge nodes bindings types) :status))
      (let [header (sh08-mc-source core node call edge nodes bindings types (get core :module))]
    (if (map? header) (= (get types (get call :operator-node-id)) (sh08-mc-finish header)) false))))

(defn sh08-mc-step [node types binding-types functions context]
  (let [core (get context :ordering-core) operator-id (first (get node :children)) id (get node :node-id)]
    (if (sh08-sse-ids? [operator-id id] 2)
      (let [call (get (get context :ordering-operators) operator-id)
            edge (get (get context :ordering-edges) id) args (get call :argument-node-ids)]
        (if (if (vector? args) (= 2 (count args)) false)
            (if (sh08-sse-ids? args 2)
              (let [receiver (get types (get args 0)) needle (get types (get args 1))
                    set? (if (if (= :gravity.type/set receiver) true
                                   (if (map? receiver) (= :gravity.type/set (get receiver :kind)) false)) true
                           (if (= :gravity.type/never receiver)
                             (if (keyword? needle)
                               (if (contains? #{:gravity.type/symbol :gravity.type/integer} needle) true
                                 (if (= :gravity.type/character needle) true (= :gravity.type/string needle))) true) false))]
                (if set?
                  (sh08-ksm-derive core node call edge (get context :lookup-nodes) (get context :ordering-bindings)
                    types (get context :association-forms))
                  (sh08-mc-derive core node call edge (get context :lookup-nodes) (get context :ordering-bindings)
                    types (get context :association-forms))))
              (sh08-sm-failure "C7-VERIFY" :map-contains-source-mismatch nil :closed-membership-step-keys nil))
            (sh08-mc-derive core node call edge (get context :lookup-nodes) (get context :ordering-bindings)
              types (get context :association-forms))))
      (sh08-sm-failure "C7-VERIFY" :map-contains-source-mismatch nil :closed-membership-step-keys nil))))

; STD3/L2: classify independently established closed values. A Bool result
; supplies no occurrence, member, length, bounds, or range refinement.
; STD5/L2: integer family classification adds no numeric conversion,
; range, width, arithmetic, overflow, or occurrence-refinement authority.
; STD3: bounded String-Vector conversion returns bare Set, with no
; cardinality, ordering, generic sequence, or String-only Set claim.
(defn sh08-st-type-work [arguments]
  (if (if (vector? arguments) (= 1 (count arguments)) false)
    (let [type (first arguments)]
      (if (= :gravity.type/never type)
        {:status :accepted :input-element-count nil}
        (if (if (map? type) (= 3 (count type)) false)
          (if (if (= :gravity.type/vector (get type :kind))
                (if (= :literal (get type :shape)) (vector? (get type :element-types)) false)
                false)
            (let [members (get type :element-types) n (count members)]
              (loop [remaining members family nil]
                (if (= 0 (count remaining))
                  (if (= :gravity.type/keyword family)
                    {:status :accepted :input-element-count n :input-element-type :gravity.type/keyword}
                    {:status :accepted :input-element-count n})
                  (let [member (first remaining)
                        expected (if (= nil family)
                                   (if (if (keyword? member) (= :gravity.type/keyword member) false)
                                     :gravity.type/keyword
                                     :gravity.type/string)
                                   family)]
                    (if (if (keyword? member) (= expected member) false)
                      (recur (rest remaining) expected)
                      {:status :rejected
                       :reason (if (= :gravity.type/keyword expected)
                                 :keyword-member-type-required
                                 :string-member-type-required)})))))
            {:status :rejected :reason :finite-string-vector-required})
          {:status :rejected :reason :finite-string-vector-required})))
    {:status :rejected :reason :unary-type-input-required}))

(defn sh08-st-keyword-policy []
  {:version :sh08-keyword-vector-set-construction-v1
   :operation :persistent-set-from-keyword-vector :operand-evaluation :once :operand-position :non-tail
   :construction :persistent-set :payload-evaluation :none :input-preserved? true
   :duplicates :gravity-keyword-value-equality :semantic-deduplication :before-provider-insertion
   :order :unspecified :normalization :none :allocation :normal-invocation-even-empty
   :validation :all-keyword-members-before-print-compare-hash-or-insert})

(defn sh08-st-binding? [binding module]
  (if (if (vector? (get binding :profile-set)) (vector? (get binding :target-set)) false)
  (sh08-ft-all-true?
    [(= ['set :core :var 'gravity.core {:name 'gravity/core :version "bootstrap-contract-v1"} :gravity.type/core-var :safe]
        [(get binding :name) (get binding :binding-class) (get binding :kind) (get binding :namespace)
         (get binding :package) (get binding :type-ref) (get binding :safety)])
     (= [] (get binding :effects) (get binding :capabilities))
     (= :jvm (get module :target))
     (contains? (set (get binding :profile-set)) (get module :profile))
     (contains? (set (get binding :target-set)) :all)]) false))

(defn sh08-st-source [core node call edge nodes bindings types module validation]
  (if (if (vector? (get call :argument-node-ids))

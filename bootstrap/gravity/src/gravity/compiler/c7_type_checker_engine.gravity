          unit (get nodes (get (get call :argument-node-ids) 1)) source (get record :unit-source)]
      (if (= operation 'inc)
        (= record {:operation-core-node-id (get call :core-node-id) :operation 'inc :unit-node nil :unit-source nil})
        (if (if (= operation '+) (map? source) false)
          (sh08-ft-all-true?
            [(= record {:operation-core-node-id (get call :core-node-id) :operation '+ :unit-node unit :unit-source source})
             (= :literal (get unit :core-form)) (= [] (get unit :children))
             (= :integer (get (get unit :attributes) :literal-kind) (get source :kind))
             (= 1 (get (get unit :attributes) :value) (get source :value))
             (= (get unit :source) (sh08-ma-form-source source))
             (= (get (get header :source) :form-id) (get source :parent-form-id))
             (= [] (get source :child-form-ids))]) false))) false))

(defn sh08-si-step-forms-valid? [proof core nodes forms]
  (if (= :sh08-bounded-unit-step-v2 (get proof :version))

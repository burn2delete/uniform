                    (if (= kind :loop) (if (vector? body) (contains? (set body) (get edge :ordinal)) false) false))
                (if (map? target) {:status :accepted :target target :work-count (+ work 1)}
                  (sh08-ft-loop-kernel-failure :missing-nearest-recur-target (get owner :node-id) :original-target-record nil (+ work 1)))
                (recur (get owner :node-id) (conj seen current) (+ work 1))))))))))

(defn sh08-ft-loop-kernel-ordered-children? [node]

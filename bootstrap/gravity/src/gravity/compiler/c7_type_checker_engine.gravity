(defn sh08-pl-finish [header]
  (assoc header :parameter-types (get header :argument-types) :return (get header :result-type)))

(defn sh08-pl-derive [core node call edge nodes bindings types forms]
  (let [args (get call :argument-node-ids)]
    (if (= false (vector? args))
      (sh08-sm-failure "C7-VERIFY" :list-prepend-call-shape-required nil :argument-vector args)
      (if (= false (= 2 (count args)))
        (sh08-sm-failure "C7-TYPE-MISMATCH" :list-prepend-arity-mismatch nil :binary-list-prepend (count args))
        (if (= false (if (vector? (get node :children)) (= 3 (count (get node :children))) false))
          (sh08-sm-failure "C7-VERIFY" :list-prepend-call-shape-required nil :binary-call-children (get node :children))
            (if (let [children (get node :children)] (loop [remaining (conj (conj (conj (conj (conj (conj (conj args (get children 0)) (get children 1)) (get children 2)) (get call :operator-node-id)) (get call :operator-binding-id)) (get node :node-id)) (get (get node :source) :form-id))] (if (= 0 (count remaining)) true (if (if (keyword? (first remaining)) true (if (string? (first remaining)) (= 71 (count (first remaining))) false)) (recur (rest remaining)) false))))
          (let [arguments [(get types (get args 0) :gravity.type/unknown) (get types (get args 1) :gravity.type/unknown)]
                validation (sh08-pl-validate-types arguments)]
              (if (= :accepted (get validation :status))
                  (let [header (sh08-pl-source core node call edge nodes bindings types (get core :module) validation)]
                    (if (if (map? header) (if (= :symbol-set-insertion (get validation :collection-family))
            (if (sh08-ksin-call-forms? node nodes forms) (sh08-si-call-forms? node nodes forms) false)
            (if (= :keyword-set-insertion (get validation :collection-family))
                          (if (sh08-ksin-call-forms? node nodes forms) (sh08-si-call-forms? node nodes forms) false)
                          (sh08-si-call-forms? node nodes forms))) false)
                      (let [descriptor (sh08-pl-finish header)]
                        {:status :accepted :descriptor descriptor :type (get descriptor :result-type)
                         :constraint (sh08-pl-constraint descriptor)})
                      (sh08-sm-failure "C7-VERIFY" (if (= :symbol-set-insertion (get validation :collection-family))
            :symbol-set-insertion-source-mismatch
            (if (= :keyword-set-insertion (get validation :collection-family)) :keyword-set-insertion-source-mismatch (if (= :string-set-insertion (get validation :collection-family)) :string-set-insertion-source-mismatch :list-prepend-source-mismatch))) nil :exact-operator-list-value-source (get node :node-id))))
                  (sh08-sm-failure "C7-TYPE-MISMATCH" (get validation :reason) nil (if (sh08-syin-selected? arguments)
            :finite-symbol-set-and-symbol-value
            (if (sh08-ksin-selected? arguments) :finite-keyword-set-and-keyword-value
                   (if (if (= :gravity.type/set (get arguments 0)) true (if (sh08-lc-native-map? (get arguments 0)) (= :gravity.type/set (get (get arguments 0) :kind)) false)) :finite-string-set-and-string-value :established-list-and-first-order-value))) arguments)))
              (sh08-sm-failure "C7-VERIFY" :conj-source-id-required nil :closed-source-identities nil)))))))

(defn sh08-syin-inferred-call [core node call edge nodes bindings types]
  (let [args (get call :argument-node-ids)]
      (if (if (vector? args) (if (= 2 (count args))
            (if (vector? (get node :children)) (if (= 3 (count (get node :children)))
              (let [children (get node :children)] (loop [remaining (conj (conj (conj (conj (conj (conj (conj args (get children 0)) (get children 1)) (get children 2)) (get call :operator-node-id)) (get call :operator-binding-id)) (get node :node-id)) (get (get node :source) :form-id))] (if (= 0 (count remaining)) true (if (if (keyword? (first remaining)) true (if (string? (first remaining)) (= 71 (count (first remaining))) false)) (recur (rest remaining)) false)))) false) false) false) false)
        (let [validation (sh08-syin-validate-types [(get types (get args 0) :gravity.type/unknown) (get types (get args 1) :gravity.type/unknown)])]
          (if (= :accepted (get validation :status))
            (let [header (sh08-pl-source core node call edge nodes bindings types (get core :module) validation)
                  descriptor (if (map? header) (sh08-pl-finish header) nil)]
              (if (if (map? descriptor)
                    (if (= descriptor (get types (get call :operator-node-id)))
                      (= (get descriptor :result-type) (get types (get node :node-id))) false) false)
                {:status :accepted}
                {:status :rejected :reason :symbol-set-insertion-source-mismatch}))
            validation))
        {:status :rejected :reason :symbol-set-insertion-arity-mismatch})))


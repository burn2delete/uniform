                                       (get record :definition-name))
                                  (= (get definition :binding-id)
                                     (get record :definition-binding-id))
                                  false)
                                false)
                              false)
                            false)
                        (if (contains?
                             bindings (get record :definition-binding-id))
                          true
                          false)
                        false)
                      (if (if (= (get record :definition-binding-id) nil)
                            (= (get record :definition-core-node-id) nil)
                            false)
                        (= (get record :definition-name) nil)

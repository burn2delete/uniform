        (if (sh08-sse-call-ids? node call)
          (let [ids (get call :argument-node-ids) left-type (get types (get ids 0)) right-type (get types (get ids 1))
                left (get nodes (get ids 0)) right (get nodes (get ids 1))
                dividend (if (= :gravity.type/never left-type) {:kind :non-invoked-operand}
                           (if (= :gravity.type/integer left-type)
                             (if (= :literal (get left :core-form)) (sh08-nq-literal left left-type forms false)
                               (sh08-nq-count core left nodes bindings types forms)) nil))
                right-literal (if (= :gravity.type/never right-type) nil (sh08-nq-literal right right-type forms false))
                divisor (if (= :gravity.type/never right-type) {:kind :non-invoked-operand}
                          (sh08-nq-literal right right-type forms true))]
            (if (if (map? dividend) (map? divisor) false)
              {:status :accepted
               :proof {:source-forms (loop [ids (get node :children) out [(get forms (get (get node :source) :form-id))]]
                                       (if (= 0 (count ids)) out
                                         (recur (rest ids) (conj out (get forms (get (get (get nodes (first ids)) :source) :form-id))))))
                       :schema :gravity/nonnegative-integer-quotient-proof-v1 :call-core-node-id (get node :node-id)
                       :dividend dividend :divisor divisor :mode :proof-required
                       :law :nonnegative-euclidean-quotient :divisor-zero :excluded
                       :result-value-bound :zero-through-original-dividend :overflow :impossible
                       :conversion :none :signed-negative-rounding :outside-domain}}
              {:status :rejected :reason (if (if (map? right-literal) (= 0 (get right-literal :value)) false)
                                           :nonnegative-integer-quotient-zero-divisor :nonnegative-integer-quotient-proof-required)}))
          {:status :rejected :reason :nonnegative-integer-quotient-source-mismatch})
        {:status :rejected :reason :nonnegative-integer-quotient-arity-mismatch}))

(defn sh08-nq-source [core node call edge nodes bindings types module proof]
  (if (if (map? edge) (if (integer? (get edge :ordinal)) (>= (get edge :ordinal) 0) false) false)
    (if (sh08-nq-ids? node call nodes bindings module)
  (if (if (vector? (get call :argument-node-ids)) (vector? (get node :children)) false)
  (let [children (get node :children) operator (get nodes (get call :operator-node-id))
        bid (get call :operator-binding-id) binding (get bindings bid) args (get call :argument-node-ids)
        arguments (sh08-ft-ordered-child-types args types)
        invoked? (loop [remaining arguments]
                   (if (= 0 (count remaining)) true
                     (if (= :gravity.type/never (first remaining)) false (recur (rest remaining)))))
        caller (loop [remaining (get core :function-records)]
                 (if (= 0 (count remaining)) nil
                   (if (= (get (first remaining) :function-syntax-id) (get (get node :evaluation) :owner-function-syntax-id))
                     (first remaining) (recur (rest remaining)))))
        expected-call {:core-node-id (get node :node-id) :operator-node-id (first children) :operator-binding-id bid
                       :argument-node-ids (vec (rest children)) :ordered-evaluation-node-ids children
                       :evaluation-order :operator-then-arguments :result-policy :call-result}
        expected-edge {:ordinal (get edge :ordinal) :call-core-node-id (get node :node-id)
                       :caller-function-syntax-id (get caller :function-syntax-id) :caller-function-core-node-id (get caller :function-core-node-id)
                       :callee-binding-id bid :callee-definition-syntax-id (get binding :definition-syntax-id)
                       :callee-function-syntax-id nil :callee-function-core-node-id nil :argument-core-node-ids args
                       :ordered-evaluation-node-ids children :evaluation-order :operator-then-arguments :classification :nonlocal-or-nonfunction}]
    (if (sh08-ft-all-true?
          [(= :jvm (get module :target)) (map? proof) (= :gravity/nonnegative-integer-quotient-proof-v1 (get proof :schema))
           (= :call (get node :core-form)) (= :reference (get operator :core-form))
           (= 2 (count args)) (= expected-call call) (= expected-edge edge) (sh08-nq-binding? binding module)
           (= [bid] (get node :resolved-binding-ids) (get operator :resolved-binding-ids))
           (= {:symbol (get (get operator :attributes) :symbol) :position :operator :binding-id bid :binding-class :core
               :definition-syntax-id (get binding :definition-syntax-id)} (get operator :attributes))
           (contains? '#{quot gravity.core/quot} (get (get operator :attributes) :symbol))
           (= :operator-then-arguments (get (get node :evaluation) :kind))
           (= (loop [i 0 out []] (if (= i (count children)) out
                (recur (+ i 1) (conj out {:index i :core-node-id (get children i)})))) (get (get node :evaluation) :order))
           (loop [remaining arguments]
             (if (= 0 (count remaining)) true
               (if (contains? #{:gravity.type/integer :gravity.type/never} (first remaining))
                 (recur (rest remaining)) false)))
           (loop [remaining arguments]
             (if (= 0 (count remaining)) true
               (if (contains? #{nil :gravity.type/unknown} (first remaining)) false (recur (rest remaining)))))] )
      {:kind :gravity.type/applied-nonnegative-integer-quotient :version :sh08-nonnegative-integer-quotient-v1
       :operation 'quot :semantic-owner 'gravity.math :intrinsic :gravity.math.core/nonnegative-integer-quotient
       :resolution :gravity.core-compatibility :operator-node-id (get operator :node-id) :operator-binding-id bid
       :call-core-node-id (get node :node-id) :source (get node :source) :operator-source (get operator :source)
       :source-call call :source-edge edge :source-binding binding :argument-types arguments
       :quotient-policy {:operation :nonnegative-euclidean-quotient :operands :generic-integer-only
                          :conversion :none :arithmetic-mode :proof-required :overflow :impossible
                          :divisor-zero :statically-excluded :negative-signed-rounding :outside-domain
                          :operand-evaluation :left-then-right-once :normal-result :generic-integer
                          :precision-bound :not-established :provider-cpu-bound :not-established :provider-heap-bound :not-established}
       :numeric-mode :proof-required :layer0-owner 'gravity.math.core :safety :proven-safe
       :range-proof proof
       :storage-policy {:allocation :may-allocate-integer-result :condition :normal-invocation
                        :representation :original-integer-family :placement :pending-profile-representation
                        :provider :pending-runtime-provider :ownership :pending-ownership-analysis}
       :application (if invoked? :normal :not-invoked)
       :latent-effects [:memory/allocate] :direct-effects (if invoked? [:memory/allocate] []) :capabilities [] :thrown-error-effects []
       :profile (get module :profile) :target (get module :target)
       :invalidation [:calls :call-edges :binding-table :source-forms :type-table :lexical-bindings :definitions :function-records
                      :callee-body :integer-operand-types :quotient-policy :source-numeric-proof :count-cardinality-law :result-storage-policy :allocation-condition :profile :target :evaluation-order]} nil)) nil) nil) nil))

(defn sh08-nq-constraint [descriptor]
  {:constraint-id-request {:domain :gravity/sh08-nonnegative-integer-quotient-constraint-v1 :application descriptor}
   :kind :numeric-mode :producer-rule :sh08-nonnegative-integer-quotient-v1
   :lhs {:core-node-id (get descriptor :call-core-node-id) :projection :nonnegative-integer-quotient}
   :rhs (get descriptor :result-type) :dependencies descriptor :origin (get (get descriptor :source) :origin-chain)
   :solution {:result-type (get descriptor :result-type) :application (get descriptor :application)
              :direct-effects (get descriptor :direct-effects) :range-proof (get descriptor :range-proof)
              :storage-policy (get descriptor :storage-policy)}
   :invalidation (get descriptor :invalidation) :profile (get descriptor :profile) :target (get descriptor :target)
   :status :solved :diagnostics []})

(defn sh08-nq-call-fact [descriptor module]

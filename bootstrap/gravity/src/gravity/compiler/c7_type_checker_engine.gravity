                            {:status :rejected :reason :count-quotient-scaling-proof-required}))
                quotient (get checked :quotient) descriptor (get quotient :descriptor)
                qproof (get descriptor :range-proof) divisor (get (get qproof :divisor) :value)
                normal? (if (= :gravity.type/never left-type) false (= :gravity.type/integer right-type))
                bounded? (if normal? (if (map? factor) (if (integer? divisor) (<= (get factor :value) divisor) false) false) true)]
            (if (if (map? factor) (if (= :accepted (get checked :status)) bounded? false) false)
              (let [outer (loop [remaining (get node :children) out [(get forms (get (get node :source) :form-id))]]
                            (if (= 0 (count remaining)) out
                              (recur (rest remaining) (conj out (get forms (get (get (get nodes (first remaining)) :source) :form-id))))))
                    qforms (if (= :authenticated-count-quotient (get quotient :kind))
                             (get qproof :source-forms) [])
                    count-forms (if (= :authenticated-count-quotient (get quotient :kind))
                                  (get (get qproof :dividend) :child-source-forms) [])
                    joined-q (loop [remaining qforms out outer]
                             (if (= 0 (count remaining)) out (recur (rest remaining) (conj out (first remaining)))))
                    joined (loop [remaining count-forms out joined-q]
                             (if (= 0 (count remaining)) out (recur (rest remaining) (conj out (first remaining)))))]
                {:status :accepted
                 :proof {:schema :gravity/count-quotient-scaling-proof-v1 :call-core-node-id (get node :node-id)

                (if (= :accepted (get leaf :status))
                  (if (= :string-set (get leaf :comparison-domain))
                    {:status :rejected :reason :vector-equality-operand-type-required
                     :leaf-reason :keyword-set-equality-operand-type-required}
                    (recur tail integers? nested? true))
                  (assoc leaf :leaf-reason (get leaf :reason)
                    :reason (if (contains? #{:keyword-set-equality-type-width :string-set-equality-type-width} (get leaf :reason))
                              :vector-equality-type-width :vector-equality-operand-type-required))))
              (if (if (map? type)
                    (if (= 3 (count type))
                      (if (= :gravity.type/vector (get type :kind))
                        (if (= :literal (get type :shape)) (vector? (get type :element-types)) false) false) false) false)
                (if (contains? seen type)
                  {:status :rejected :reason :vector-equality-cyclic-type}
                  (let [members (get type :element-types) next-seen (conj seen type)
                        children (loop [i (- (count members) 1) out tail]
                                  (if (< i 0) out
                                    (recur (- i 1) (conj out [(get members i) (+ depth 1) false next-seen]))))]
                    (recur children integers? (if (> depth 0) true nested?) sets?)))
                {:status :rejected :reason :vector-equality-operand-type-required}))))))
    {:status :rejected :reason :vector-equality-arity-mismatch}))

(defn sh08-ve-source [core node call edge nodes bindings types module validation]
  ; Closed lexical callers supply this invocation's validated VE-domain result.
  (if (if (vector? (get call :argument-node-ids))
        (if (= 2 (count (get call :argument-node-ids)))
          (if (vector? (get node :children)) (= 3 (count (get node :children))) false) false) false)
  (let [children (get node :children) operator (get nodes (get call :operator-node-id))
        bid (get call :operator-binding-id) binding (get bindings bid) args (get call :argument-node-ids)
        arguments (sh08-ft-ordered-child-types args types)
        invoked? (loop [remaining arguments]
                   (if (= 0 (count remaining)) true
                     (if (= :gravity.type/never (first remaining)) false (recur (rest remaining)))))
        caller (loop [remaining (get core :function-records)]
                 (if (= 0 (count remaining)) nil
                   (if (= (get (first remaining) :function-syntax-id) (get (get node :evaluation) :owner-function-syntax-id))
                     (first remaining) (recur (rest remaining)))))
        expected-call {:core-node-id (get node :node-id) :operator-node-id (first children) :operator-binding-id bid
                       :argument-node-ids (vec (rest children)) :ordered-evaluation-node-ids children
                       :evaluation-order :operator-then-arguments :result-policy :call-result}
        expected-edge {:ordinal (get edge :ordinal) :call-core-node-id (get node :node-id)
                       :caller-function-syntax-id (get caller :function-syntax-id) :caller-function-core-node-id (get caller :function-core-node-id)
                       :callee-binding-id bid :callee-definition-syntax-id (get binding :definition-syntax-id)
                       :callee-function-syntax-id nil :callee-function-core-node-id nil :argument-core-node-ids args
                       :ordered-evaluation-node-ids children :evaluation-order :operator-then-arguments :classification :nonlocal-or-nonfunction}]
    (if (sh08-ft-all-true?
          [(= :accepted (get validation :status))
           (if (= :flat-keyword-set-vector (get validation :comparison-domain)) (= :jvm (get module :target)) true)
           (= :call (get node :core-form)) (= :reference (get operator :core-form))
           (= 2 (count args)) (= expected-call call) (= expected-edge edge) (sh08-ae-binding? binding module)
           (= [bid] (get node :resolved-binding-ids) (get operator :resolved-binding-ids))
           (= {:symbol (get (get operator :attributes) :symbol) :position :operator :binding-id bid :binding-class :core
               :definition-syntax-id (get binding :definition-syntax-id)} (get operator :attributes))
           (contains? '#{= gravity.core/=} (get (get operator :attributes) :symbol))
           (= :operator-then-arguments (get (get node :evaluation) :kind))
           (= (loop [i 0 out []] (if (= i (count children)) out
                (recur (+ i 1) (conj out {:index i :core-node-id (get children i)})))) (get (get node :evaluation) :order))
          ])
      (let [header (if (= :flat-integer-vector (get validation :comparison-domain))
        (assoc {:kind :gravity.type/applied-vector-equality :version :sh08-vector-equality-v1
       :operation '= :semantic-owner 'gravity.collections :intrinsic :gravity.collections/vector-value-equality
       :resolution :gravity.core-compatibility :operator-node-id (get operator :node-id) :operator-binding-id bid
       :call-core-node-id (get node :node-id) :source (get node :source) :operator-source (get operator :source)
       :source-call call :source-edge edge :source-binding binding :argument-types arguments
       :equality-policy {:domain :finite-persistent-vectors :members :recursive-vector-and-supported-atomic
                         :count :equal :order :corresponding-values :leaves :original-values
                         :nil-bearing :compare-original-values :cross-family :actual-value-families
                         :nested-vector-versus-atomic :false
                         :identity :unobserved :payload-evaluation :none :mutation :none :numeric :unsupported}
       :application (if invoked? :normal :not-invoked)
       :latent-effects [] :direct-effects [] :capabilities [] :thrown-error-effects []
       :profile (get module :profile) :target (get module :target)
       :invalidation [:calls :call-edges :binding-table :source-forms :type-table :lexical-bindings :definitions :function-records
                      :callee-body :equality-domain :value-policy :profile :target :evaluation-order]}
          :version :sh08-flat-integer-vector-equality-v1
          :equality-policy {:domain :finite-flat-persistent-vectors :members :supported-atomic-and-generic-integer
                         :count :equal :order :corresponding-values :leaves :original-values
                         :nil-bearing :compare-original-nonnumeric-values :cross-family :actual-nonnumeric-value-families
                         :integer-cross-family :unsupported :nested-vectors :unsupported
                         :identity :unobserved :payload-evaluation :none :mutation :none
                         :numeric :same-established-generic-integer-leaves
                         :entry-contract :type-conforming-typed-calls}
          :numeric-equality {:version :sh08-flat-integer-vector-leaf-equality-v1
                          :semantic-owner 'gravity.math :layer0-owner 'gravity.math.core
                          :integer-type :gravity.type/integer :numeric-mode :proof-required :safety :proven-safe
                          :safety-rule :same-integral-value-equality-no-conversion-overflow-or-rounding
                          :equality-policy {:domain :same-integral-type :comparison :original-integer-values
                                            :conversion :none :arithmetic :none :overflow :impossible
                                            :rounding :none :cross-type :unsupported}}
          :invalidation [:calls :call-edges :binding-table :source-forms :type-table :lexical-bindings :definitions :function-records
                         :callee-body :equality-domain :value-policy :integral-type :numeric-mode :numeric-equality
                         :profile :target :evaluation-order])
        {:kind :gravity.type/applied-vector-equality :version :sh08-vector-equality-v1
       :operation '= :semantic-owner 'gravity.collections :intrinsic :gravity.collections/vector-value-equality
       :resolution :gravity.core-compatibility :operator-node-id (get operator :node-id) :operator-binding-id bid
       :call-core-node-id (get node :node-id) :source (get node :source) :operator-source (get operator :source)
       :source-call call :source-edge edge :source-binding binding :argument-types arguments
       :equality-policy {:domain :finite-persistent-vectors :members :recursive-vector-and-supported-atomic
                         :count :equal :order :corresponding-values :leaves :original-values
                         :nil-bearing :compare-original-values :cross-family :actual-value-families
                         :nested-vector-versus-atomic :false
                         :identity :unobserved :payload-evaluation :none :mutation :none :numeric :unsupported}
       :application (if invoked? :normal :not-invoked)
       :latent-effects [] :direct-effects [] :capabilities [] :thrown-error-effects []
       :profile (get module :profile) :target (get module :target)
       :invalidation [:calls :call-edges :binding-table :source-forms :type-table :lexical-bindings :definitions :function-records
                      :callee-body :equality-domain :value-policy :profile :target :evaluation-order]})]
        (if (= :flat-keyword-set-vector (get validation :comparison-domain))
          (let [result (assoc header :version :sh08-flat-keyword-set-vector-equality-v1
                         :equality-policy {:domain :finite-flat-persistent-vectors :members :supported-atomic-generic-integer-and-finite-keyword-set
                         :count :equal :order :corresponding-values :leaves :original-values
                         :nil-bearing :compare-original-nonnumeric-values :cross-family :actual-nonnumeric-value-families
                         :integer-cross-family :unsupported :keyword-set-cross-family :unsupported :nested-vectors :unsupported
                         :identity :unobserved :payload-evaluation :none :mutation :none
                         :numeric (if (get validation :integer-leaves?) :same-established-generic-integer-leaves :unsupported)
                         :keyword-sets :independently-finite-keyword-only
                         :entry-contract :type-conforming-typed-calls}
                         :keyword-set-leaf-equality {:version :sh08-vector-keyword-set-leaf-equality-v1
                            :semantic-owner 'gravity.collections :equality-version :sh08-keyword-set-equality-v1
                            :domain :independently-finite-persistent-keyword-sets :members :keyword-only
                            :comparison :guarded-atomic-keyword-leaf :order :unobserved
                            :domain-validation :owned-self-equality-before-any-vector-result
                            :member-uniqueness :validated-before-any-vector-result
                            :comparison-validation :owned-pair-equality-after-domain-validation
                            :per-leaf-reset :none
                            :identity :unobserved :payload-evaluation :none :mutation :none :construction :none
                            :provider-cpu-bound :not-established}
                         :invalidation [:calls :call-edges :binding-table :source-forms :type-table :lexical-bindings :definitions :function-records
                         :callee-body :equality-domain :value-policy :integral-type :numeric-mode :numeric-equality
                         :keyword-set-leaf-equality :set-member-domain :member-value-policy
                         :profile :target :evaluation-order])]
            (if (get validation :integer-leaves?)
              (assoc result :numeric-equality {:version :sh08-flat-integer-vector-leaf-equality-v1
                          :semantic-owner 'gravity.math :layer0-owner 'gravity.math.core
                          :integer-type :gravity.type/integer :numeric-mode :proof-required :safety :proven-safe
                          :safety-rule :same-integral-value-equality-no-conversion-overflow-or-rounding
                          :equality-policy {:domain :same-integral-type :comparison :original-integer-values
                                            :conversion :none :arithmetic :none :overflow :impossible
                                            :rounding :none :cross-type :unsupported}}) result))
          header)) nil)) nil))

(defn sh08-ve-constraint [descriptor]
  {:constraint-id-request {:domain (if (= :sh08-flat-keyword-set-vector-equality-v1 (get descriptor :version))
                                     :gravity/sh08-flat-keyword-set-vector-equality-constraint-v1
                                   (if (= :sh08-flat-integer-vector-equality-v1 (get descriptor :version))
                                     :gravity/sh08-flat-integer-vector-equality-constraint-v1 :gravity/sh08-vector-equality-constraint-v1)) :application descriptor}
   :kind :equality :producer-rule (if (= :sh08-flat-keyword-set-vector-equality-v1 (get descriptor :version))
                                     :sh08-flat-keyword-set-vector-equality-v1
                                   (if (= :sh08-flat-integer-vector-equality-v1 (get descriptor :version))
                                     :sh08-flat-integer-vector-equality-v1 :sh08-vector-equality-v1))
   :lhs {:core-node-id (get descriptor :call-core-node-id) :projection :vector-equality}
   :rhs (get descriptor :result-type) :dependencies descriptor :origin (get (get descriptor :source) :origin-chain)
   :solution (if (= :sh08-flat-keyword-set-vector-equality-v1 (get descriptor :version))
               (let [solution (assoc { :result-type (get descriptor :result-type) :application (get descriptor :application) :direct-effects (get descriptor :direct-effects)}
                                :equality-policy (get descriptor :equality-policy)
                                :keyword-set-leaf-equality (get descriptor :keyword-set-leaf-equality))]
                 (if (contains? descriptor :numeric-equality)
                   (assoc solution :numeric-equality (get descriptor :numeric-equality)) solution))
               (if (= :sh08-flat-integer-vector-equality-v1 (get descriptor :version))
               (assoc {:result-type (get descriptor :result-type) :application (get descriptor :application)
              :direct-effects (get descriptor :direct-effects)} :equality-policy (get descriptor :equality-policy)
                 :numeric-equality (get descriptor :numeric-equality))
               {:result-type (get descriptor :result-type) :application (get descriptor :application)
              :direct-effects (get descriptor :direct-effects)}))
   :invalidation (get descriptor :invalidation) :profile (get descriptor :profile) :target (get descriptor :target)
   :status :solved :diagnostics []})

(defn sh08-ve-call-fact [descriptor module]
  (let [source (get descriptor :source) edge (get descriptor :source-edge)]
    {:artifact :gravity/c7-call-type-fact
     :fact-id-request {:domain (if (= :sh08-flat-keyword-set-vector-equality-v1 (get descriptor :version))
                                  :gravity/sh08-flat-keyword-set-vector-equality-call-type-fact-v1
                                (if (= :sh08-flat-integer-vector-equality-v1 (get descriptor :version))
                                  :gravity/sh08-flat-integer-vector-equality-call-type-fact-v1 :gravity/sh08-vector-equality-call-type-fact-v1)) :application descriptor}
     :call-core-node-id (get descriptor :call-core-node-id) :caller-function-syntax-id (get edge :caller-function-syntax-id)
     :callee-function-syntax-id nil :argument-types (get descriptor :argument-types) :result-type (get descriptor :result-type)
     :evaluation-order :operator-then-arguments :source-span (get source :semantic-span) :syntax-id (get source :syntax-id)
     :origin-chain (get source :origin-chain) :generated-origin (get source :generated-origin)
     :profile (get module :profile) :target (get module :target) :effects (get descriptor :direct-effects) :capabilities [] :status :inferred
     :dispatch :direct-vector-equality :applied-vector-equality descriptor :effect-facts-source :audited-vector-value-intrinsic}))


(defn sh08-ve-finish [header]
  (let [type (if (= :normal (get header :application)) :gravity.type/bool :gravity.type/never)]
    (assoc header :parameter-types (get header :argument-types) :return type :result-type type)))

(defn sh08-ve-derive [core node call edge nodes bindings types forms]
  (if (if (vector? (get call :argument-node-ids)) (= 2 (count (get call :argument-node-ids))) false)
    (let [args (get call :argument-node-ids)
          owner (get forms (get (get node :source) :form-id)) ids (get owner :child-form-ids)]
      (let [arguments (sh08-ft-ordered-child-types args types)
            domain (sh08-ve-domain arguments)]
        (if (= :accepted (get domain :status))
          (let [header (sh08-ve-source core node call edge nodes bindings types (get core :module) domain)]
            (if (if (map? header)
                  (sh08-ft-all-true?
                    [(= :list (get owner :kind)) (= (get node :source) (sh08-ma-form-source owner))
                     (vector? ids) (= 3 (if (vector? ids) (count ids) 0))
                     (= {:operator-child-index 0 :argument-count 2 :argument-child-indexes [1 2]
                         :evaluation-order :operator-then-arguments :dispatch :resolved-symbol-call} (get node :attributes))
                     (loop [i 0]
                       (if (= i 3) true
                         (let [form (get forms (get ids i)) child (get nodes (get (get node :children) i))]
                           (if (sh08-ft-all-true? [(= (get owner :form-id) (get form :parent-form-id))
                                 (= (get child :source) (sh08-ma-form-source form))
                                 (if (= i 0) (= (get form :value) (get (get child :attributes) :symbol)) true)])
                             (recur (+ i 1)) false))))]) false)
              (let [descriptor (sh08-ve-finish header)]
                {:status :accepted :descriptor descriptor :type (get descriptor :result-type)
                 :constraint (sh08-ve-constraint descriptor)})
              (sh08-sm-failure "C7-VERIFY" :vector-equality-source-mismatch nil :exact-operator-left-right-source
                (get node :node-id))))
          (sh08-sm-failure "C7-TYPE-MISMATCH" (get domain :reason) nil
            :two-established-finite-vector-values (sh08-ft-ordered-child-types args types)))))
    (sh08-sm-failure "C7-TYPE-MISMATCH" :vector-equality-arity-mismatch nil :binary-equality-call nil)))


(defn sh08-ve-inferred-call [core node call edge nodes bindings types]
  (if (if (vector? (get call :argument-node-ids)) (= 2 (count (get call :argument-node-ids))) false)
    (let [arguments (sh08-ft-ordered-child-types (get call :argument-node-ids) types)
          domain (sh08-ve-domain arguments)]
      (if (= :accepted (get domain :status))
        (let [header (sh08-ve-source core node call edge nodes bindings types (get core :module) domain)]
          (if (if (map? header) (= (get types (get call :operator-node-id)) (sh08-ve-finish header)) false)
            {:status :accepted}
            {:status :rejected :reason :vector-equality-source-mismatch}))
        domain))
    {:status :rejected :reason :vector-equality-arity-mismatch}))

(defn sh08-ae-step [node types binding-types functions context]
  (if (if (if (sh08-sse-ids? (get node :children) 3)
          (sh08-sse-ids? [(get node :node-id) (get (get node :source) :form-id)
                          (get (get node :source) :syntax-id)] 3) false)
        (sh08-sse-call-ids? node (get (get context :ordering-operators) (first (get node :children)))) false)
    (if (sh08-bka-entry? node (get (get context :ordering-operators) (first (get node :children)))
          (get context :lookup-nodes) (get context :ordering-bindings) types (get (get context :ordering-core) :module))
      (sh08-bka-derive (get context :ordering-core) node
        (get (get context :ordering-operators) (first (get node :children)))
        (get (get context :ordering-edges) (get node :node-id))
        (get context :lookup-nodes) (get context :ordering-bindings) types (get context :association-forms))
      (let [call (get (get context :ordering-operators) (first (get node :children)))
            edge (get (get context :ordering-edges) (get node :node-id))
            args (get call :argument-node-ids)
            keyword-set? (if (if (vector? args) (= 2 (count args)) false)
                           (if (= :gravity.type/set (get types (get args 0))) true
                             (if (= :gravity.type/set (get types (get args 1))) true
                               (if (= :gravity.type/set (get (get types (get args 0)) :kind)) true
                                 (= :gravity.type/set (get (get types (get args 1)) :kind))))) false)
            integral? (if (if (vector? args) (= 2 (count args)) false)
                        (if (sh08-ie-type? (get types (get args 0))) true
                          (sh08-ie-type? (get types (get args 1)))) false)
            list? (if (if (vector? args) (= 2 (count args)) false)
                    (if (= :gravity.type/list (get types (get args 0))) true
                      (if (= :gravity.type/list (get types (get args 1))) true
                        (if (= :gravity.type/list (get (get types (get args 0)) :kind)) true
                          (= :gravity.type/list (get (get types (get args 1)) :kind))))) false)
            vector? (if (if (vector? args) (= 2 (count args)) false)
                      (if (= :gravity.type/vector (get (get types (get args 0)) :kind)) true
                        (= :gravity.type/vector (get (get types (get args 1)) :kind))) false)]
        (if list?
          (sh08-le-derive (get context :ordering-core) node call edge
            (get context :lookup-nodes) (get context :ordering-bindings) types (get context :association-forms))
          (if keyword-set?
            (sh08-kse-derive (get context :ordering-core) node call edge
              (get context :lookup-nodes) (get context :ordering-bindings) types (get context :association-forms))
            (if vector?
              (sh08-ve-derive (get context :ordering-core) node call edge
                (get context :lookup-nodes) (get context :ordering-bindings) types (get context :association-forms))
              (if integral?
                (sh08-ie-derive (get context :ordering-core) node call edge
                  (get context :lookup-nodes) (get context :ordering-bindings) types (get context :association-forms))
                  (sh08-ae-derive (get context :ordering-core) node call edge
                    (get context :lookup-nodes) (get context :ordering-bindings) types (get context :association-forms))))))))
    (sh08-sm-failure "C7-VERIFY" :keyword-set-equality-source-mismatch nil :closed-equality-source-identities nil)))

(defn sh08-cq-binding? [binding module]
  (if (if (vector? (get binding :profile-set)) (vector? (get binding :target-set)) false)
  (sh08-ft-all-true?
    [(= ['count :core :var 'gravity.core {:name 'gravity/core :version "bootstrap-contract-v1"} :gravity.type/core-var :safe]
        [(get binding :name) (get binding :binding-class) (get binding :kind) (get binding :namespace)
         (get binding :package) (get binding :type-ref) (get binding :safety)])
     (= [] (get binding :effects) (get binding :capabilities))
     (contains? (set (get binding :profile-set)) (get module :profile))
     (contains? (set (get binding :target-set)) :all)]) false))

(defn sh08-cq-list? [type]
  (if (= :gravity.type/list type) true
    (if (if (map? type) (= 3 (count type)) false)
      (if (= [:gravity.type/list :homogeneous] [(get type :kind) (get type :shape)])
        (if (keyword? (get type :element-type)) (sh08-hl-type? type) false)
        (if (= #{:kind :shape :element-types} (set (keys type)))
          (if (= [:gravity.type/list :literal] [(get type :kind) (get type :shape)])
            (vector? (get type :element-types)) false) false)) false)))

(defn sh08-cq-set? [type]
  (if (if (sh08-ss-type? type) true (sh08-syc-type? type)) true
  (if (= :gravity.type/set type) true
    (if (if (map? type) (= 3 (count type)) false)
      (if (= :gravity.type/set (get type :kind))
        (if (= :literal (get type :shape)) (vector? (get type :element-types)) false) false) false))))

(defn sh08-cq-source [core node call edge nodes bindings types module]
  (if (if (vector? (get call :argument-node-ids))
        (if (= 1 (count (get call :argument-node-ids)))
          (if (vector? (get node :children)) (= 2 (count (get node :children))) false) false) false)
  (let [children (get node :children) operator (get nodes (get call :operator-node-id))
        bid (get call :operator-binding-id) binding (get bindings bid) args (get call :argument-node-ids)
        arguments [(get types (get args 0) :gravity.type/unknown)]
        list-input? (sh08-cq-list? (first arguments))
        set-input? (sh08-cq-set? (first arguments))
        invoked? (loop [remaining arguments]
                   (if (= 0 (count remaining)) true
                     (if (= :gravity.type/never (first remaining)) false (recur (rest remaining)))))
        caller (loop [remaining (get core :function-records)]
                 (if (= 0 (count remaining)) nil
                   (if (= (get (first remaining) :function-syntax-id) (get (get node :evaluation) :owner-function-syntax-id))
                     (first remaining) (recur (rest remaining)))))
        expected-call {:core-node-id (get node :node-id) :operator-node-id (first children) :operator-binding-id bid
                       :argument-node-ids (vec (rest children)) :ordered-evaluation-node-ids children
                       :evaluation-order :operator-then-arguments :result-policy :call-result}
        expected-edge {:ordinal (get edge :ordinal) :call-core-node-id (get node :node-id)
                       :caller-function-syntax-id (get caller :function-syntax-id) :caller-function-core-node-id (get caller :function-core-node-id)
                       :callee-binding-id bid :callee-definition-syntax-id (get binding :definition-syntax-id)
                       :callee-function-syntax-id nil :callee-function-core-node-id nil :argument-core-node-ids args
                       :ordered-evaluation-node-ids children :evaluation-order :operator-then-arguments :classification :nonlocal-or-nonfunction}]
    (if (sh08-ft-all-true?
          [(= :call (get node :core-form)) (= :reference (get operator :core-form))
           (= 1 (count args)) (= expected-call call) (= expected-edge edge) (sh08-cq-binding? binding module)
           (= [bid] (get node :resolved-binding-ids) (get operator :resolved-binding-ids))
           (= {:symbol (get (get operator :attributes) :symbol) :position :operator :binding-id bid :binding-class :core
               :definition-syntax-id (get binding :definition-syntax-id)} (get operator :attributes))
           (contains? '#{count gravity.core/count} (get (get operator :attributes) :symbol))
           (= :operator-then-arguments (get (get node :evaluation) :kind))
           (= (loop [i 0 out []] (if (= i (count children)) out
                (recur (+ i 1) (conj out {:index i :core-node-id (get children i)})))) (get (get node :evaluation) :order))
           (if (= :gravity.type/never (first arguments)) true
             (if (if list-input? true set-input?) true
               (if (= :gravity.type/map (first arguments)) true
                 (if (keyword? (get (first arguments) :kind))
                   (contains? #{:gravity.type/map :gravity.type/vector} (get (first arguments) :kind)) false))))
           (if (= nil (first arguments)) false (= false (= :gravity.type/unknown (first arguments))))] )
      {:kind :gravity.type/applied-collection-count :version :sh08-collection-count-v1
       :operation 'count :semantic-owner 'gravity.collections :intrinsic :gravity.collections/finite-collection-count
       :resolution :gravity.core-compatibility :operator-node-id (get operator :node-id) :operator-binding-id bid
       :call-core-node-id (get node :node-id) :source (get node :source) :operator-source (get operator :source)

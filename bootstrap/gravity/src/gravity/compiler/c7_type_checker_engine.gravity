(defn sh08-ft-loop-constraints [premises nodes module]
  (loop [remaining premises out []]
    (if (= 0 (count remaining)) out
      (let [premise (first remaining) slot? (= :loop-slot-type (get premise :kind))
            id (if slot? (get premise :initializer-node-id) (get (get premise :source-transfer) :recur-core-node-id))
            node (get nodes id) target (get premise :source-target)
            lhs (if slot? (get premise :binding-id) id)
            rhs (if slot? (get premise :type) :gravity.type/never)]
        (recur (rest remaining)
          (if (= :solved (get premise :status))
            (conj out {:constraint-id-request {:domain :gravity/sh08-loop-type-constraint-v1
                         :core-node-id id :binding-or-transfer lhs :target-id (get target :target-id) :premise premise}
              :kind :equality :producer-rule :sh08-loop-target-types-v1 :lhs lhs :rhs rhs
              :origin (get (get node :source) :origin-chain) :profile (get module :profile) :target (get module :target)
              :dependencies {:loop-premise premise :core-node-id id :target-owner-core-node-id (get target :owner-core-node-id)}
              :solution {:type rhs :slot-types (get premise :slot-types) :argument-types (get premise :argument-types)
                         :normal-transfer? (get premise :normal-transfer?)}
              :invalidation [:loop-bindings :recur-targets :recur-transfers :type-table :binding-table]
              :status :solved :diagnostics []}) out))))))

(defn sh08-ft-every-known? [values]
  (if (= (count values) 0)
    true
    (if (sh08-ft-known? (first values))
      (sh08-ft-every-known? (rest values))
      false)))

(defn sh08-ft-last-type [children type-table]
  (if (= (count children) 0)
    :gravity.type/unknown
    (get type-table
         (get children (- (count children) 1))
         :gravity.type/unknown)))

(defn sh08-ft-collection-type [node type-table]
  (let [kind (get (get node :attributes) :literal-kind)
        children (get node :children)
        child-types
        (loop [remaining children result []]
          (if (= (count remaining) 0)
            result
            (recur
             (rest remaining)
             (conj result
                   (get type-table (first remaining)
                        :gravity.type/unknown)))))]
    (if (sh08-ft-every-known? child-types)
      (if (= kind :vector)
        {:kind :gravity.type/vector
         :element-types child-types
         :shape :literal}
        (if (= kind :set)
          {:kind :gravity.type/set
           :element-types child-types
           :shape :literal}
          (if (= kind :map)
            (if (sh08-even-count? children)
              {:kind :gravity.type/map
               :member-types child-types
               :shape :literal}
              :gravity.type/unknown)
            :gravity.type/unknown)))
      :gravity.type/unknown)))

(defn sh08-ft-function-type-skeleton-base [record module]
  {:artifact :gravity/c7-function-type
   :function-id (get record :function-syntax-id)
   :function-core-node-id (get record :function-core-node-id)
   :body-core-node-id (get record :body-core-node-id)
   :definition-name (get record :definition-name)
   :parameter-binding-ids (get record :parameter-binding-ids)
   :parameters
   (loop [remaining (get record :parameter-binding-ids)
          values []]
     (if (= (count remaining) 0)
       values
       (recur
        (rest remaining)
        (conj values
              {:binding-id (first remaining)
               :type :gravity.type/unknown}))))
   :return :gravity.type/unknown
   :return-conflict nil
   :fixed-arity (get record :fixed-arity)
   :latent-effects (get module :effects)
   :capabilities (get module :capabilities)
   :ownership-constraints :pending-sh10
   :profile-constraints [(get module :profile)]
   :thrown-error-effects [:pending-sh09]
   :source-span nil
   :status :inferred})

(defn sh08-ft-apply-declarations [function signature]
      (assoc (assoc (assoc (assoc function :signature signature)
        :declaration-rule-version :sh08-atomic-function-signature-v1)
        :return (get (get signature :return) :type-id (get function :return)))
        :parameters
        (loop [parameters (get function :parameters) declarations (get signature :parameters) result []]
          (if (= (count parameters) 0) result
            (recur (rest parameters) (rest declarations)
              (conj result (assoc (first parameters) :type
                (get (first declarations) :type-id (get (first parameters) :type)))))))))

(defn sh08-ft-function-type-skeleton [record module]
  (let [base (sh08-ft-function-type-skeleton-base record module)]
    (if (contains? record :signature)
      (sh08-ft-apply-declarations base (get record :signature)) base)))

(defn sh08-ft-restore-declarations [completed base]
  (loop [ids (keys base) result completed]
    (if (= (count ids) 0) result
      (let [id (first ids) function (get base id)]
        (recur (rest ids)
          (if (contains? function :signature)
            (assoc result id (sh08-ft-apply-declarations (get result id) (get function :signature))) result))))))

(defn sh08-ft-declaration-seeds [functions initial]
  (loop [ids (keys functions) result initial]
    (if (= (count ids) 0) result
      (let [function (get functions (first ids))]
        (recur (rest ids)
          (loop [parameters (get function :parameters) declarations (get (get function :signature) :parameters)
                 values result]
            (if (= (count parameters) 0) values
              (recur (rest parameters) (rest declarations)
                (if (= (first declarations) nil) values
                  (assoc values (get (first parameters) :binding-id) (get (first declarations) :type-id)))))))))))

; The authoritative higher-order promotion is deliberately narrower than the
; fixture adapters: it derives one capture-free named identity function and
; one named apply-one function directly from the authenticated B47 core.  No
; HO1/HO2 result is accepted as a type premise here.
(defn sh08-ft-higher-order-reference?
  [node binding-id owner-function-syntax-id]
  (if (map? node)
    (if (= :reference (get node :core-form))
      (if (= binding-id (get (get node :attributes) :binding-id))
        (= owner-function-syntax-id
           (get (get node :evaluation) :owner-function-syntax-id))
        false)
      false)
    false))

(defn sh08-ft-authoritative-primitive-type? [value]
  (if (= value :gravity.type/integer)
    true
    (if (= value :gravity.type/bool)
      true
      (= value :gravity.type/string))))

(defn sh08-ft-authoritative-primitive-type-for-node [node]
  (if (map? node)
    (if (= :literal (get node :core-form))
      (let [candidate
            (sh08-primitive-type-from-literal-kind
             (get (get node :attributes) :literal-kind))]
        (if (sh08-ft-authoritative-primitive-type? candidate)
          candidate
          nil))
      nil)
    nil))

(defn sh08-ft-higher-order-call-node-valid?
  [call node expected-argument-count owner-function-syntax-id]
  (if (map? call)
    (if (map? node)
      (if (= :call (get node :core-form))
        (if (= expected-argument-count
               (count (get call :argument-node-ids)))
          (if (= (get call :ordered-evaluation-node-ids)
                 (get node :children))
            (if (= :operator-then-arguments
                   (get call :evaluation-order))
              (= owner-function-syntax-id
                 (get (get node :evaluation)
                      :owner-function-syntax-id))
              false)
            false)
          false)
        false)
      false)
    false))

(defn sh08-ft-higher-order-call-by-node-id
  [calls node-id]
  (if (= (count calls) 0)
    nil
    (if (= node-id (get (first calls) :core-node-id))
      (first calls)
      (sh08-ft-higher-order-call-by-node-id (rest calls) node-id))))

(defn sh08-ft-higher-order-identity-candidates
  [function-records nodes definitions]
  (loop [remaining function-records values []]
    (if (= (count remaining) 0)
      values
      (let [record (first remaining)
            function-node (get nodes (get record :function-core-node-id))
            definition
            (sh08-ft-definition-by-binding-id
             definitions (get record :definition-binding-id))
            parameter-ids (get record :parameter-binding-ids)
            body (get nodes (get record :body-core-node-id))]
        (if (if (= :named-top-level (get record :definition-kind))
              (if (= 1 (get record :fixed-arity))
                (if (= 1 (count parameter-ids))
                  (if (map? definition)
                    (if (map? function-node)
                      (if (= :fn (get function-node :core-form))
                        (sh08-ft-higher-order-reference?
                         body (first parameter-ids)
                         (get record :function-syntax-id))
                        false)
                      false)
                    false)
                  false)
                false)
              false)
          (recur (rest remaining)
                 (conj values
                       {:record record
                        :definition definition
                        :function-node function-node
                        :body body
                        :parameter-binding-id (first parameter-ids)}))
          (recur (rest remaining) values))))))

(defn sh08-ft-higher-order-outer-call
  [calls nodes apply-definition identity-definition]
  (if (= (count calls) 0)
    nil
    (let [call (first calls)
          node (get nodes (get call :core-node-id))
          argument-ids (get call :argument-node-ids)
          children (get node :children)
          function-value-node (get nodes (first argument-ids))
          value-node (get nodes (first (rest argument-ids)))]
      (if (if (= :call (get node :core-form))
            (if (= nil (get (get node :evaluation)
                            :owner-function-syntax-id))
              (if (= 2 (count argument-ids))
                (if (= (get call :operator-binding-id)
                       (get apply-definition :binding-id))
                  (if (= (get call :ordered-evaluation-node-ids)
                         children)
                    (if (= :operator-then-arguments
                           (get call :evaluation-order))
                      (if (= (get function-value-node :core-form)
                             :reference)
                        (if (= (get (get function-value-node :attributes)
                                  :binding-id)
                             (get identity-definition :binding-id))
                          (= (get value-node :core-form) :literal)
                          false)
                        false)
                      false)
                    false)
                  false)
                false)
              false)
            false)
        call
        (sh08-ft-higher-order-outer-call
         (rest calls) nodes apply-definition identity-definition)))))

(defn sh08-ft-higher-order-outer-edge-valid?
  [edge call function-record bindings]
  (let [definition-binding
        (sh08-ft-binding-by-id
         bindings (get function-record :definition-binding-id))]
  (if (map? edge)
    (if (= :local-function (get edge :classification))
      (if (= (get edge :call-core-node-id)
             (get call :core-node-id))
        (if (= (get edge :callee-binding-id)
               (get function-record :definition-binding-id))
          (if (= (get edge :callee-definition-syntax-id)
                 (get definition-binding :definition-syntax-id))
            (if (= (get edge :callee-function-syntax-id)
                   (get function-record :function-syntax-id))
              (if (= (get edge :callee-function-core-node-id)
                     (get function-record :function-core-node-id))
                (if (= (get edge :argument-core-node-ids)
                       (get call :argument-node-ids))
                  (if (= (get edge :ordered-evaluation-node-ids)
                         (get call :ordered-evaluation-node-ids))
                    (if (= (get edge :evaluation-order)
                           (get call :evaluation-order))
                      (if (= (get edge :caller-function-syntax-id) nil)
                        (= (get edge :caller-function-core-node-id) nil)
                        false)
                      false)
                    false)
                  false)
                false)
              false)
            false)
          false)
        false)
      false)
    false)))

(defn sh08-ft-higher-order-apply-candidates
  [function-records nodes definitions bindings calls edges identity-candidate]
  (let [identity-definition (get identity-candidate :definition)]
    (loop [remaining function-records values []]
      (if (= (count remaining) 0)
        values
        (let [record (first remaining)
              parameter-ids (get record :parameter-binding-ids)
              function-node (get nodes (get record :function-core-node-id))
              definition
              (sh08-ft-definition-by-binding-id
               definitions (get record :definition-binding-id))
              body (get nodes (get record :body-core-node-id))
              body-call
              (sh08-ft-higher-order-call-by-node-id
               calls (get record :body-core-node-id))
              argument-ids (if (map? body-call)
                             (get body-call :argument-node-ids)
                             [])
              inner-argument (get nodes (first argument-ids))
              inner-edge
              (sh08-ft-edge-by-call-id
               edges (get record :body-core-node-id))
              outer-call
              (if (map? definition)
                (sh08-ft-higher-order-outer-call
                 calls nodes definition identity-definition)
                nil)
              outer-edge
              (if (map? outer-call)
                (sh08-ft-edge-by-call-id
                 edges (get outer-call :core-node-id))
                nil)
              outer-node
              (if (map? outer-call)
                (get nodes (get outer-call :core-node-id))
                nil)
              callable-binding
              (sh08-ft-binding-by-id bindings (first parameter-ids))]
          (if (if (= :named-top-level (get record :definition-kind))
                (if (= 2 (get record :fixed-arity))
                  (if (= 2 (count parameter-ids))
                    (if (map? definition)
                      (if (map? function-node)
                        (if (= :fn (get function-node :core-form))
                          (if (sh08-ft-higher-order-call-node-valid?
                               body-call body 1
                               (get record :function-syntax-id))
                            (if (= (get body-call :operator-binding-id)
                                   (first parameter-ids))
                              (if (sh08-ft-higher-order-reference?
                                   inner-argument
                                   (first (rest parameter-ids))
                                   (get record :function-syntax-id))
                                (if (map? inner-edge)
                                  (if (= :nonlocal-or-nonfunction
                                         (get inner-edge :classification))
                                    (if (= (get inner-edge :callee-binding-id)
                                           (first parameter-ids))
                                      (if (map? callable-binding)
                                        (if (= (get inner-edge
                                                   :callee-definition-syntax-id)
                                               (get callable-binding
                                                   :definition-syntax-id))
                                          (if (= nil
                                                 (get inner-edge
                                                      :callee-function-syntax-id))
                                            (if (= nil
                                                 (get inner-edge
                                                      :callee-function-core-node-id))
                                              (if (sh08-ft-higher-order-outer-edge-valid?
                                                   outer-edge outer-call record
                                                   bindings)
                                                true
                                                false)
                                              false)
                                            false)
                                          false)
                                        false)
                                      false)
                                    false)
                                  false)
                                false)
                              false)
                            false)
                          false)
                        false)
                      false)
                    false)
                  false)
                false)
            (recur (rest remaining)
                   (conj values
                         {:record record
                          :definition definition
                          :function-node function-node
                          :body body
                          :inner-call body-call
                          :inner-node body
                          :inner-argument inner-argument
                          :inner-edge inner-edge
                          :outer-call outer-call
                          :outer-edge outer-edge
                          :outer-node outer-node
                          :callable-binding callable-binding
                          :callable-binding-id (first parameter-ids)
                          :value-binding-id (first (rest parameter-ids))}))
            (recur (rest remaining) values)))))))

(defn sh08-ft-higher-order-edge-projection [edge]
  (if (map? edge)
    {:ordinal (get edge :ordinal)
     :call-core-node-id (get edge :call-core-node-id)
     :caller-function-syntax-id (get edge :caller-function-syntax-id)
     :caller-function-core-node-id (get edge :caller-function-core-node-id)
     :callee-binding-id (get edge :callee-binding-id)
     :callee-definition-syntax-id (get edge :callee-definition-syntax-id)
     :callee-function-syntax-id (get edge :callee-function-syntax-id)
     :callee-function-core-node-id (get edge :callee-function-core-node-id)
     :argument-core-node-ids (get edge :argument-core-node-ids)
     :ordered-evaluation-node-ids (get edge :ordered-evaluation-node-ids)
     :evaluation-order (get edge :evaluation-order)
     :classification (get edge :classification)}
    nil))

(defn sh08-ft-higher-order-proof
  [nodes definitions bindings function-records calls edges module]
  (let [node-index (sh08-ft-node-index nodes)
        identity-candidates
        (sh08-ft-higher-order-identity-candidates
         function-records node-index definitions)]
    (if (= 1 (count identity-candidates))
      (let [identity (first identity-candidates)
            apply-candidates
            (sh08-ft-higher-order-apply-candidates
             function-records node-index definitions bindings calls edges identity)]
        (if (= 1 (count apply-candidates))
          (let [apply (first apply-candidates)
                identity-record (get identity :record)
                apply-record (get apply :record)
                identity-definition (get identity :definition)
                apply-definition (get apply :definition)
                outer-value-node
                (get node-index
                     (first
                      (rest
                       (get (get apply :outer-call)
                            :argument-node-ids))))
                value-type
                (sh08-ft-authoritative-primitive-type-for-node
                 outer-value-node)
                identity-source
                (get (get (get identity :function-node) :source) :semantic-span)
                identity-syntax-id
                (get (get (get identity :function-node) :source) :syntax-id)
                identity-origin-chain
                (get (get (get identity :function-node) :source) :origin-chain)
                identity-generated-origin
                (get (get (get identity :function-node) :source) :generated-origin)
                apply-source
                (get (get (get apply :function-node) :source) :semantic-span)
                apply-syntax-id
                (get (get (get apply :function-node) :source) :syntax-id)
                apply-origin-chain
                (get (get (get apply :function-node) :source) :origin-chain)
                apply-generated-origin
                (get (get (get apply :function-node) :source) :generated-origin)
                identity-function-type
                {:artifact :gravity/c7-function-type
                 :function-id (get identity-record :function-syntax-id)
                 :function-core-node-id
                 (get identity-record :function-core-node-id)
                 :body-core-node-id (get identity-record :body-core-node-id)
                 :definition-name (get identity-record :definition-name)
                 :parameter-binding-ids
                 (get identity-record :parameter-binding-ids)
                 :parameters
                 [{:binding-id (get identity :parameter-binding-id)
                   :type value-type}]
                 :return value-type
                 :return-conflict nil
                 :fixed-arity (get identity-record :fixed-arity)
                 :latent-effects (get module :effects)
                 :capabilities (get module :capabilities)
                 :ownership-constraints :pending-sh10
                 :profile-constraints [(get module :profile)]
                 :thrown-error-effects [:pending-sh09]
                 :source-span identity-source
                 :syntax-id identity-syntax-id
                 :origin-chain identity-origin-chain
                 :generated-origin identity-generated-origin
                 :profile (get module :profile)
                 :target (get module :target)
                 :status :inferred}
                apply-function-type
                {:artifact :gravity/c7-function-type
                 :function-id (get apply-record :function-syntax-id)
                 :function-core-node-id
                 (get apply-record :function-core-node-id)
                 :body-core-node-id (get apply-record :body-core-node-id)
                 :definition-name (get apply-record :definition-name)
                 :parameter-binding-ids
                 (get apply-record :parameter-binding-ids)
                 :parameters
                 [{:binding-id (get apply :callable-binding-id)
                   :type identity-function-type}
                  {:binding-id (get apply :value-binding-id)
                   :type value-type}]
                 :return value-type
                 :return-conflict nil
                 :fixed-arity (get apply-record :fixed-arity)
                 :latent-effects (get module :effects)
                 :capabilities (get module :capabilities)
                 :ownership-constraints :pending-sh10
                 :profile-constraints [(get module :profile)]
                 :thrown-error-effects [:pending-sh09]
                 :source-span apply-source
                 :syntax-id apply-syntax-id
                 :origin-chain apply-origin-chain
                 :generated-origin apply-generated-origin
                 :profile (get module :profile)
                 :target (get module :target)
                 :status :inferred}]
            (if (sh08-ft-authoritative-primitive-type? value-type)
              {:status :accepted
             :identity identity
             :apply apply
             :identity-function-type identity-function-type
             :apply-function-type apply-function-type
             :identity-binding-id (get identity-definition :binding-id)
             :identity-function-syntax-id
             (get identity-record :function-syntax-id)
             :apply-binding-id (get apply-definition :binding-id)
             :apply-function-syntax-id
             (get apply-record :function-syntax-id)
             :identity-parameter-binding-id
             (get identity :parameter-binding-id)
             :apply-callable-binding-id (get apply :callable-binding-id)
             :apply-value-binding-id (get apply :value-binding-id)
             :inner-call-core-node-id
             (get (get apply :inner-call) :core-node-id)
             :outer-call-core-node-id
             (get (get apply :outer-call) :core-node-id)
             :inner-edge (get apply :inner-edge)
             :outer-edge (get apply :outer-edge)
             :identity-source
             (get (get (get identity :function-node) :source)
                  :semantic-span)
             :apply-source
             (get (get (get apply :function-node) :source)
                  :semantic-span)
             :inner-source
             (get (get (get apply :inner-node) :source)
                  :semantic-span)
             :outer-source
             (get (get (get apply :outer-node) :source)
                  :semantic-span)
             :callable-definition-syntax-id
             (get (get apply :callable-binding) :definition-syntax-id)
             :initial-binding-types
             {(get identity-definition :binding-id) identity-function-type
              (get identity :parameter-binding-id) value-type
              (get apply-definition :binding-id) apply-function-type
             (get apply :callable-binding-id) identity-function-type
              (get apply :value-binding-id) value-type}
             :value-type value-type
             :outer-value-literal-kind
             (get (get outer-value-node :attributes) :literal-kind)}
              {:status :rejected
               :reason :unsupported-higher-order-primitive-type
               :node outer-value-node
               :actual (get (get outer-value-node :attributes) :literal-kind)
               :value-type value-type}))
          {:status :not-applicable :reason :no-complete-identity-apply-shape}))
      {:status :not-applicable :reason :no-complete-identity-shape})))

(defn sh08-ft-higher-order-complete-function
  [skeleton proof-type]
  (let [updated
        (assoc
         (assoc
          (assoc
           (assoc
            (assoc
             (assoc skeleton
                    :parameters (get proof-type :parameters))
             :return (get proof-type :return))
            :latent-effects (get proof-type :latent-effects))
           :capabilities (get proof-type :capabilities))
          :ownership-constraints (get proof-type :ownership-constraints))
         :thrown-error-effects (get proof-type :thrown-error-effects))]
    (assoc
     (assoc
      (assoc
       (assoc
        (assoc updated :profile (get proof-type :profile))
        :target (get proof-type :target))
       :source-span (get proof-type :source-span))
      :syntax-id (get proof-type :syntax-id))
     :origin-chain (get proof-type :origin-chain)
     :generated-origin (get proof-type :generated-origin))))

(defn sh08-ft-higher-order-proof-input [proof]
  (let [identity (get proof :identity)
        apply (get proof :apply)
        identity-record (get identity :record)
        apply-record (get apply :record)
        identity-definition (get identity :definition)
        apply-definition (get apply :definition)
        inner-call (get apply :inner-call)
        outer-call (get apply :outer-call)]
    {:domain :gravity/sh08-authoritative-higher-order-proof-v1
     :identity-function-syntax-id (get identity-record :function-syntax-id)
     :identity-function-core-node-id
     (get identity-record :function-core-node-id)
     :identity-definition-binding-id (get identity-definition :binding-id)
     :identity-parameter-binding-id
     (get proof :identity-parameter-binding-id)
     :identity-body-core-node-id (get identity-record :body-core-node-id)
     :apply-function-syntax-id (get apply-record :function-syntax-id)
     :apply-function-core-node-id (get apply-record :function-core-node-id)
     :apply-definition-binding-id (get apply-definition :binding-id)
     :apply-callable-binding-id (get proof :apply-callable-binding-id)
     :apply-value-binding-id (get proof :apply-value-binding-id)
     :apply-body-core-node-id (get apply-record :body-core-node-id)
     :inner-call-core-node-id (get inner-call :core-node-id)
     :inner-operator-binding-id (get inner-call :operator-binding-id)
     :inner-argument-node-ids (get inner-call :argument-node-ids)
     :inner-evaluation-order (get inner-call :evaluation-order)
     :inner-source-span (get proof :inner-source)
     :inner-edge
     (sh08-ft-higher-order-edge-projection (get proof :inner-edge))
     :outer-call-core-node-id (get outer-call :core-node-id)
     :outer-operator-binding-id (get outer-call :operator-binding-id)
     :outer-argument-node-ids (get outer-call :argument-node-ids)
     :outer-evaluation-order (get outer-call :evaluation-order)
     :outer-source-span (get proof :outer-source)
     :outer-edge
     (sh08-ft-higher-order-edge-projection (get proof :outer-edge))
     :outer-value-argument-node-id
     (first (rest (get outer-call :argument-node-ids)))
     :outer-value-literal-kind
     (get proof :outer-value-literal-kind)
     :identity-parameter-type (get proof :value-type)
     :apply-callable-parameter-type (get proof :identity-function-type)
     :apply-value-parameter-type (get proof :value-type)
     :identity-function-type (get proof :identity-function-type)
     :apply-function-type (get proof :apply-function-type)
     :inner-result-type (get proof :value-type)
     :outer-result-type (get proof :value-type)}))

(defn sh08-ft-higher-order-call-proof-facts [proof]
  (let [identity (get proof :identity)
        apply (get proof :apply)
        identity-record (get identity :record)
        apply-record (get apply :record)
        inner-call (get apply :inner-call)
        outer-call (get apply :outer-call)]
    [{:role :inner-indirect-call
      :call-core-node-id (get inner-call :core-node-id)
      :caller-function-syntax-id (get apply-record :function-syntax-id)
      :callee-function-syntax-id (get (get proof :inner-edge)
                                      :callee-function-syntax-id)
      :selected-identity-function-syntax-id
      (get identity-record :function-syntax-id)
      :operator-binding-id (get inner-call :operator-binding-id)
      :callable-parameter-binding-id
      (get proof :apply-callable-binding-id)
      :argument-node-ids (get inner-call :argument-node-ids)
      :argument-value-binding-id (get proof :apply-value-binding-id)
      :evaluation-order (get inner-call :evaluation-order)
      :source-span (get proof :inner-source)
      :b47-edge
      (sh08-ft-higher-order-edge-projection (get proof :inner-edge))
      :result-type (get proof :value-type)
      :dispatch :indirect-function-value}
     {:role :outer-direct-call
      :call-core-node-id (get outer-call :core-node-id)
      :caller-function-syntax-id nil
      :callee-function-syntax-id (get apply-record :function-syntax-id)
      :operator-binding-id (get outer-call :operator-binding-id)
      :argument-node-ids (get outer-call :argument-node-ids)
      :value-argument-node-id
      (first (rest (get outer-call :argument-node-ids)))
      :evaluation-order (get outer-call :evaluation-order)
      :source-span (get proof :outer-source)
      :outer-edge (get proof :outer-edge)
      :b47-edge
      (sh08-ft-higher-order-edge-projection (get proof :outer-edge))
      :selected-apply-function-syntax-id
      (get apply-record :function-syntax-id)
      :result-type (get proof :value-type)
      :dispatch :direct-local-function}]))

(defn sh08-ft-higher-order-pending [base-pending]
  (let [residuals
        [:captures :lifetimes :aliases :multi-hop :polymorphism :overloads
         :multi-arity :variadic-dispatch :protocol-dispatch :dynamic-dispatch
         :reflection]]
    (loop [remaining base-pending values []]
      (if (= (count remaining) 0)
        values
        (if (= (first remaining) :higher-order-functions)
          (recur
           (rest remaining)
           (loop [pending residuals result values]
             (if (= (count pending) 0)
               result
               (recur (rest pending) (conj result (first pending))))))
          (recur (rest remaining) (conj values (first remaining))))))))

; The recursive consumer is intentionally narrower than the B47 recursion
; product.  B47 may describe arbitrary SCCs, but C7 only admits one named,
; capture-free positive-fixed-arity self edge with direct positional parameter
; forwarding, a direct primitive-literal sibling, and an external concrete
; call that supplies every parameter slot. Everything else remains an explicit
; diagnostic rather than being silently approximated.
(defn sh08-ft-recursive-known-type? [value]
  (sh08-ft-authoritative-primitive-type? value))

(defn sh08-ft-recursive-reference-valid?
  [node binding-ids definition-binding-id function-syntax-id]
  (if (map? node)
    (if (= :reference (get node :core-form))
      (if (= function-syntax-id
             (get (get node :evaluation) :owner-function-syntax-id))
        (let [binding-id (get (get node :attributes) :binding-id)]
          (if (= binding-id definition-binding-id)
            true
            (sh08-ft-member? binding-ids binding-id)))
        false)
      true)
    false))

(defn sh08-ft-recursive-body-capture-free?
  [nodes binding-ids definition-binding-id function-syntax-id]
  (loop [remaining nodes]
    (if (= (count remaining) 0)
      true
      (if (if (= function-syntax-id
                (get (get (first remaining) :evaluation)
                     :owner-function-syntax-id))
            (sh08-ft-recursive-reference-valid?
             (first remaining) binding-ids definition-binding-id
             function-syntax-id)
            true)
        (recur (rest remaining))
        false))))

(defn sh08-ft-recursive-call-edge-valid?
  [edge call call-node function-record definition-binding binding-table
   recursive?]
  (let [function-syntax-id (get function-record :function-syntax-id)
        function-core-node-id (get function-record :function-core-node-id)
        definition-binding-id (get definition-binding :binding-id)
        definition-syntax-id
        (get (sh08-ft-binding-by-id
              binding-table definition-binding-id)
             :definition-syntax-id)]
    (if (if (map? edge) (map? call) false)
      (if (= :local-function (get edge :classification))
        (if (= (get edge :call-core-node-id)
               (get call :core-node-id))
          (if (= (get edge :callee-binding-id) definition-binding-id)
            (if (= (get edge :callee-definition-syntax-id)
                   definition-syntax-id)
              (if (= (get edge :callee-function-syntax-id)
                     function-syntax-id)
                (if (= (get edge :callee-function-core-node-id)
                       function-core-node-id)
                  (if (= (get edge :argument-core-node-ids)
                         (get call :argument-node-ids))
                    (if (= (get edge :ordered-evaluation-node-ids)
                           (get call :ordered-evaluation-node-ids))
                      (if (= (get edge :evaluation-order)
                             :operator-then-arguments)
                        (if (= (get call :evaluation-order)
                               :operator-then-arguments)
                          (if (= (get (get call-node :evaluation)
                                      :owner-function-syntax-id)
                                 (if recursive?
                                   function-syntax-id
                                   nil))
                            true
                            false)
                          false)
                        false)
                      false)
                    false)
                  false)
                false)
              false)
            false)
          false)
        false)
      false)))

(defn sh08-ft-recursive-argument-types
  [argument-node-ids node-index]
  (loop [remaining argument-node-ids values []]
    (if (= (count remaining) 0)
      values
      (let [node (get node-index (first remaining))
            literal-type
            (if (= :literal (get node :core-form))
              (sh08-primitive-type-from-literal-kind
               (get (get node :attributes) :literal-kind))
              :gravity.type/unknown)]
        (recur
         (rest remaining)
         (conj values
               (if (sh08-ft-authoritative-primitive-type? literal-type)
                 literal-type
                 :gravity.type/unknown)))))))

(defn sh08-ft-recursive-unsupported-primitive-node
  [argument-node-ids node-index]
  (if (= (count argument-node-ids) 0)
    nil
    (let [node (get node-index (first argument-node-ids))
          candidate
          (if (= :literal (get node :core-form))
            (sh08-primitive-type-from-literal-kind
             (get (get node :attributes) :literal-kind))
            nil)]
      (if (if (map? node)
            (if (= :literal (get node :core-form))
              (if (= candidate nil)
                false
                (if (sh08-ft-authoritative-primitive-type? candidate)
                  false
                  true))
              false)
            false)
        node
        (sh08-ft-recursive-unsupported-primitive-node
         (rest argument-node-ids) node-index)))))

(defn sh08-ft-recursive-parameter-evidence
  [calls edges node-index function-record definition-binding binding-table]
  (let [function-syntax-id (get function-record :function-syntax-id)
        arity (count (get function-record :parameter-binding-ids))]
    (loop [remaining calls
           remaining-edges edges
           candidates []]
      (if (= (count remaining) 0)
        (if (= (count candidates) 0)
          {:status :rejected :reason :recursive-parameter-evidence-required}
          (let [first-types (get (first candidates) :types)
                conflict
                (loop [types (rest candidates)]
                  (if (= (count types) 0)
                    nil
                    (if (= first-types (get (first types) :types))
                      (recur (rest types))
                      (get (first types) :types))))]
            (if (= conflict nil)
              {:status :accepted
               :call (get (first candidates) :call)
               :edge (get (first candidates) :edge)
               :node (get (first candidates) :node)
               :types first-types}
              {:status :rejected
               :reason :recursive-parameter-type-conflict
               :actual conflict})))
        (let [call (first remaining)
              edge (first remaining-edges)
              node (get node-index (get call :core-node-id))
              types (sh08-ft-recursive-argument-types
                     (get call :argument-node-ids) node-index)
              unsupported-node
              (sh08-ft-recursive-unsupported-primitive-node
               (get call :argument-node-ids) node-index)
              valid-edge
              (sh08-ft-recursive-call-edge-valid?
               edge call node function-record definition-binding
               binding-table false)]
          (if (map? unsupported-node)
            {:status :rejected
             :reason :unsupported-recursive-primitive-type
             :node unsupported-node}
            (if (if valid-edge
                (if (= (get edge :caller-function-syntax-id) nil)
                  (if (= (get edge :caller-function-core-node-id) nil)
                    (if (= arity (count types))
                      (sh08-ft-every-known? types)
                      false)
                    false)
                  false)
                false)
            (recur (rest remaining)
                   (rest remaining-edges)
                   (conj candidates
                         {:call call
                          :edge edge
                          :node node
                          :types types}))
            (recur (rest remaining) (rest remaining-edges) candidates))))))))

(defn sh08-ft-recursive-base-evidence
  [body node-index recursive-call-id]
  (if (= :if (get body :core-form))
    (let [children (get body :children)]
      (if (= 3 (count children))
        (let [then-id (second children)
              else-id (sh08-third children)
              then-node (get node-index then-id)
              else-node (get node-index else-id)
              then-type
              (if (= :literal (get then-node :core-form))
                (sh08-primitive-type-from-literal-kind
                 (get (get then-node :attributes) :literal-kind))
                :gravity.type/unknown)
              else-type
              (if (= :literal (get else-node :core-form))
                (sh08-primitive-type-from-literal-kind
                 (get (get else-node :attributes) :literal-kind))
                :gravity.type/unknown)]
          (if (= then-id recursive-call-id)
            (if (sh08-ft-recursive-known-type? else-type)
              {:status :accepted :node else-node :type else-type}
              {:status :rejected :reason :recursive-base-evidence-required})
            (if (= else-id recursive-call-id)
              (if (sh08-ft-recursive-known-type? then-type)
                {:status :accepted :node then-node :type then-type}
                {:status :rejected :reason :recursive-base-evidence-required})
              {:status :rejected :reason :recursive-call-must-be-direct-branch})))
        {:status :rejected :reason :recursive-base-shape-required}))
    {:status :rejected :reason :recursive-base-shape-required}))

(defn sh08-ft-recursive-pending [base-pending]
  (let [residuals [:mutual-recursion :unbounded-recursion :recursive-captures
                   :recursive-higher-order :recursive-polymorphism]]
    (loop [remaining base-pending values []]
      (if (= (count remaining) 0)
        values
        (if (= (first remaining) :recursive-type-annotations)
          (recur
           (rest remaining)
           (loop [pending residuals result values]
             (if (= (count pending) 0)
               result
               (recur (rest pending) (conj result (first pending))))))
          (recur (rest remaining) (conj values (first remaining))))))))

(defn sh08-ft-recursive-rejection-evidence [result node component]
  (if (= :accepted (get result :status))
    result
    (if (map? (get result :node))
      result
      (if (map? node)
        (assoc result :node node)
        (if (map? component)
          (assoc result :component component)
          result)))))

(defn sh08-ft-recursive-diagnostic [proof module]
  (let [node (get proof :node)
        diagnostic
        (sh08-ft-diagnostic
         "C7-ANNOTATION"
         (if (map? node) node nil)
         module
         :bounded-named-self-recursive-fixed-arity-positive-positional-literal-base
         (get proof :reason)
         (get proof :reason)
         {})]
    (if (map? (get proof :component))
      (assoc diagnostic :recursive-component (get proof :component))
      diagnostic)))

(defn sh08-ft-recursive-proof
  [nodes definitions bindings function-records calls edges recursion-components
   module]
  (if (= (count recursion-components) 0)
    {:status :not-applicable :reason :no-recursive-component}
    (if (sh08-ft-any-member?
         (loop [remaining recursion-components values []]
           (if (= (count remaining) 0)
             values
             (recur
              (rest remaining)
              (conj values (= :mutually-recursive
                              (get (first remaining) :kind))))))
         [true])
      {:status :rejected
       :reason :mutual-recursion-unsupported
       :component (first recursion-components)}
      (if (= 1 (count recursion-components))
        (let [component (first recursion-components)
              function-syntax-id (first (get component :function-syntax-ids))
              function-record
              (sh08-ft-function-by-syntax-id
               function-records function-syntax-id)
              node-index (sh08-ft-node-index nodes)
              function-node
              (if (map? function-record)
                (get node-index (get function-record :function-core-node-id))
                nil)
              definition
              (if (map? function-record)
                (sh08-ft-definition-by-binding-id
                 definitions (get function-record :definition-binding-id))
                nil)
              definition-binding
              (if (map? function-record)
                (sh08-ft-binding-by-id
                 bindings (get function-record :definition-binding-id))
                nil)
              edge-ordinals (get component :internal-call-edge-ordinals)
              recursive-edge
              (if (= 1 (count edge-ordinals))
                (get edges (first edge-ordinals))
                nil)
              recursive-call
              (if (map? recursive-edge)
                (sh08-ft-higher-order-call-by-node-id
                 calls (get recursive-edge :call-core-node-id))
                nil)
              recursive-node
              (if (map? recursive-call)
                (get node-index (get recursive-call :core-node-id))
                nil)
              body
              (if (map? function-record)
                (get node-index (get function-record :body-core-node-id))
                nil)
              edge-valid
              (sh08-ft-recursive-call-edge-valid?
               recursive-edge recursive-call recursive-node function-record
               definition bindings true)
              arity
              (if (map? function-record)
                (get function-record :fixed-arity)
                nil)
              parameter-ids
              (if (map? function-record)
                (get function-record :parameter-binding-ids)
                [])
              argument-ids
              (if (map? recursive-call)
                (get recursive-call :argument-node-ids)
                [])
              argument-nodes
              (loop [remaining argument-ids values []]
                (if (= (count remaining) 0)
                  values
                  (recur
                   (rest remaining)
                   (conj values (get node-index (first remaining))))))
              argument-shape
              (if (= arity (count parameter-ids))
                (if (= arity (count argument-ids))
                  (loop [remaining argument-nodes ids parameter-ids]
                    (if (= (count remaining) 0)
                      true
                      (if (sh08-ft-higher-order-reference?
                           (first remaining) (first ids) function-syntax-id)
                        (recur (rest remaining) (rest ids))
                        false)))
                  false)
                false)
              base-evidence
              (if (map? body)
                (sh08-ft-recursive-base-evidence
                 body node-index (get recursive-call :core-node-id))
                {:status :rejected :reason :recursive-base-shape-required})
              parameter-evidence
              (if (map? definition)
                (sh08-ft-recursive-parameter-evidence
                 calls edges node-index function-record definition bindings)
                {:status :rejected :reason :recursive-definition-required})
              capture-free
              (if (map? function-record)
                (sh08-ft-recursive-body-capture-free?
                 nodes parameter-ids (get function-record :definition-binding-id)
                 function-syntax-id)
                false)]
          (sh08-ft-recursive-rejection-evidence
           (if (= nil function-record)
            {:status :rejected :reason :recursive-function-record-required}
            (if (= :named-top-level (get function-record :definition-kind))
              (if (if (integer? arity) (> arity 0) false)
                (if (= :fn (get function-node :core-form))
                  (if (map? definition)
                    (if (map? definition-binding)
                      (if edge-valid
                        (if argument-shape
                          (if capture-free
                            (if (= :accepted (get base-evidence :status))
                            (if (= :accepted
                                     (get parameter-evidence :status))
                                (if (= (get base-evidence :type)
                                       (first (get parameter-evidence :types)))
                                  {:status :accepted
                                   :component component
                                   :function-record function-record
                                   :function-node function-node
                                   :definition definition
                                   :definition-binding definition-binding
                                   :recursive-call recursive-call
                                   :recursive-call-core-node-id
                                   (get recursive-call :core-node-id)
                                   :recursive-base-type
                                   (get base-evidence :type)
                                   :recursive-edge recursive-edge
                                   :recursive-node recursive-node
                                   :base-node (get base-evidence :node)
                                   :base-type (get base-evidence :type)
                                   :parameter-evidence parameter-evidence
                                   :parameter-types
                                   (get parameter-evidence :types)
                                   :function-syntax-id function-syntax-id
                                   :module module}
                                  {:status :rejected
                                   :reason :recursive-result-type-conflict
                                   :expected (get base-evidence :type)
                                   :actual
                                   (first (get parameter-evidence :types))})
                              {:status :rejected
                               :reason (get parameter-evidence :reason)
                               :actual (get parameter-evidence :actual)
                               :node (get parameter-evidence :node)})
                              {:status :rejected
                               :reason (get base-evidence :reason)})
                            {:status :rejected :reason :recursive-capture-unsupported})
                          {:status :rejected :reason :recursive-argument-shape})
                        {:status :rejected :reason :recursive-call-edge-lineage})
                      {:status :rejected :reason :recursive-definition-binding-required})
                    {:status :rejected :reason :recursive-definition-required})
                  {:status :rejected :reason :recursive-function-node-required})
                {:status :rejected :reason :recursive-fixed-arity-required})
              {:status :rejected :reason :recursive-function-must-be-named}))
           recursive-node
           component))
        {:status :rejected
         :reason :multiple-recursive-components
         :component recursion-components}))))

(defn sh08-ft-recursive-complete-function
  [skeleton proof]
  (let [parameter-ids (get (get proof :function-record) :parameter-binding-ids)
        parameter-types (get proof :parameter-types)
        parameters
        (loop [ids parameter-ids types parameter-types values []]
          (if (= (count ids) 0)
            values
            (recur
             (rest ids)
             (rest types)
             (conj values {:binding-id (first ids) :type (first types)}))))]
    (assoc
     (assoc
      (assoc
       skeleton
       :parameters parameters)
      :return (get proof :base-type))
     :source-span
     (get (get (get proof :function-node) :source) :semantic-span))))

(defn sh08-ft-recursive-proof-input [proof]
  (let [record (get proof :function-record)
        definition (get proof :definition)
        call (get proof :recursive-call)
        edge (get proof :recursive-edge)
        recursive-node (get proof :recursive-node)
        parameter-evidence (get proof :parameter-evidence)
        evidence-call (get parameter-evidence :call)
        evidence-edge (get parameter-evidence :edge)
        evidence-node (get parameter-evidence :node)
        module (get proof :module)]
    {:domain :gravity/sh08-authoritative-recursive-proof-v1
     :function-syntax-id (get record :function-syntax-id)
     :function-core-node-id (get record :function-core-node-id)
     :definition-binding-id (get definition :binding-id)
     :definition-syntax-id (get definition :syntax-id)
     :parameter-binding-ids (get record :parameter-binding-ids)
     :fixed-arity (get record :fixed-arity)
     :recursive-call-core-node-id (get call :core-node-id)
     :recursive-argument-node-ids (get call :argument-node-ids)
     :recursive-edge (sh08-ft-higher-order-edge-projection edge)
     :recursive-call-source
     {:syntax-id (get (get recursive-node :source) :syntax-id)
      :source-span (get (get recursive-node :source) :semantic-span)
      :origin-chain (get (get recursive-node :source) :origin-chain)
      :generated-origin (get (get recursive-node :source) :generated-origin)}
     :recursive-call-profile (get module :profile)
     :recursive-call-target (get module :target)
     :recursive-call-effects (get module :effects)
     :recursive-call-capabilities (get module :capabilities)
     :base-node-id (get (get proof :base-node) :node-id)
     :base-type (get proof :base-type)
     :recursive-definition-binding-id (get definition :binding-id)
     :parameter-evidence-call-core-node-id
     (get evidence-call :core-node-id)
     :parameter-evidence-call
     {:call-core-node-id (get evidence-call :core-node-id)
      :caller-function-syntax-id (get evidence-edge :caller-function-syntax-id)
      :callee-function-syntax-id (get evidence-edge :callee-function-syntax-id)
      :argument-node-ids (get evidence-call :argument-node-ids)
      :ordered-evaluation-node-ids
      (get evidence-call :ordered-evaluation-node-ids)
      :evaluation-order (get evidence-call :evaluation-order)
      :argument-types (get parameter-evidence :types)
      :result-type (first (get parameter-evidence :types))
      :syntax-id (get (get evidence-node :source) :syntax-id)
      :source-span (get (get evidence-node :source) :semantic-span)
      :origin-chain (get (get evidence-node :source) :origin-chain)
      :generated-origin (get (get evidence-node :source) :generated-origin)
      :profile (get module :profile)
      :target (get module :target)
      :effects (get module :effects)
      :capabilities (get module :capabilities)
      :edge (sh08-ft-higher-order-edge-projection evidence-edge)}
     :parameter-types (get proof :parameter-types)
     :proof-bound
     :one-named-self-recursive-positive-fixed-arity-positional-literal-base
     :captures? false
     :higher-order? false
     :monotone-fixed-point? true}))

(defn sh08-ft-call-fact-by-id [facts call-id]
  (if (= (count facts) 0)
    nil
    (if (= call-id (get (first facts) :call-core-node-id))
      (first facts)
      (sh08-ft-call-fact-by-id (rest facts) call-id))))

(defn sh08-ft-recursive-call-proof-facts [proof canonical-call-facts]
  (let [record (get proof :function-record)
        call (get proof :recursive-call)
        edge (get proof :recursive-edge)
        parameter-evidence (get proof :parameter-evidence)
        evidence-call (get parameter-evidence :call)
        evidence-edge (get parameter-evidence :edge)
        recursive-fact
        (sh08-ft-call-fact-by-id
         canonical-call-facts (get call :core-node-id))
        evidence-fact
        (sh08-ft-call-fact-by-id
         canonical-call-facts (get evidence-call :core-node-id))]
    [(assoc
      (if (map? recursive-fact) recursive-fact {})
      :role :self-recursive-call
      :recursive-definition-binding-id
      (get (get proof :definition) :binding-id)
      :b47-edge (sh08-ft-higher-order-edge-projection edge)
      :result-type (get proof :base-type)
      :dispatch :direct-named-self-recursion)
     (assoc
      (if (map? evidence-fact) evidence-fact {})
      :role :external-parameter-evidence
      :parameter-evidence? true
      :external-edge (sh08-ft-higher-order-edge-projection evidence-edge)
      :argument-types (get parameter-evidence :types)
      :result-type (first (get parameter-evidence :types)))]))

(defn sh08-ft-recursive-constraint-ledger [proof]
  [{:constraint-id-request
    {:domain :gravity/sh08-recursive-call-constraint-v1
     :function-syntax-id (get proof :function-syntax-id)
     :call-core-node-id (get (get proof :recursive-call) :core-node-id)
     :fixed-arity (get (get proof :function-record) :fixed-arity)}
    :kind :recursive-fixed-point
    :lhs (get proof :function-syntax-id)
    :rhs (get proof :base-type)
    :origin (get (get (get proof :recursive-node) :source) :origin-chain)
    :profile (get (get proof :module) :profile)
    :target (get (get proof :module) :target)
    :status :solved
    :diagnostics []}])

(defn sh08-ft-update-param-types [function-types binding-types]
  (loop [remaining (keys function-types)
         result function-types]
    (if (= (count remaining) 0)
      result
      (let [function-id (first remaining)
            function (get result function-id)
            parameter-ids (get function :parameter-binding-ids)
            parameter-types
            (loop [ids parameter-ids values []]
              (if (= (count ids) 0)
                values
                (recur
                 (rest ids)
                 (conj values
                       (get binding-types (first ids)
                            :gravity.type/unknown)))))]
        (recur
         (rest remaining)
         (assoc result function-id
                (assoc function :parameters
                       (loop [types parameter-types ids parameter-ids values []]
                         (if (= (count types) 0)
                           values
                           (recur
                            (rest types)
                            (rest ids)
                            (conj values
                                  {:binding-id (first ids)
                                   :type (first types)})))))))))))

(defn sh08-ft-edge-by-call-id [edges call-id]
  (loop [remaining edges]
    (if (= (count remaining) 0)
      nil
      (if (= (get (first remaining) :call-core-node-id) call-id)
        (first remaining)
        (recur (rest remaining))))))

(defn sh08-ft-function-by-id [function-types syntax-id]
  (get function-types syntax-id))

(defn sh08-ft-function-by-core-id [function-types core-node-id]
  (loop [remaining (keys function-types)]
    (if (= (count remaining) 0)
      nil
      (let [function (get function-types (first remaining))]
        (if (= (get function :function-core-node-id) core-node-id)
          function
          (recur (rest remaining)))))))

(defn sh08-ft-if-join-with-context [children type-table context]
  (let [then-id (second children)
        else-id (sh08-third children)
        then-type (get type-table then-id :gravity.type/unknown)
        else-type (get type-table else-id :gravity.type/unknown)]
    (if (= then-type else-type)
      (if (sh08-ft-known? then-type)
        then-type
        (if (= :accepted (get context :status))
          (if (if (= then-id (get context :recursive-call-core-node-id))
                true
                (= else-id (get context :recursive-call-core-node-id)))
            (get context :recursive-base-type :gravity.type/unknown)
            :gravity.type/unknown)
          :gravity.type/unknown))
      (if (= :accepted (get context :status))
        (if (= then-id (get context :recursive-call-core-node-id))
          (if (sh08-ft-known? else-type)
            else-type
            (get context :recursive-base-type :gravity.type/unknown))
          (if (= else-id (get context :recursive-call-core-node-id))
            (if (sh08-ft-known? then-type)
              then-type
              (get context :recursive-base-type :gravity.type/unknown))
            :gravity.type/unknown))
        :gravity.type/unknown))))

; L1/L2 quoted payloads are authenticated DATA, never executable core nodes.
(defn sh08-qd-failure [rule reason form expected actual]
  {:status :rejected :rule rule :reason reason :form form :expected expected :actual actual :work-count 1})

(defn sh08-qd-scalar-valid? [kind value]
  (if (= kind :nil) (= value nil)
    (if (= kind :boolean) (contains? #{true false} value)
      (if (= kind :integer) (integer? value)
        (if (= kind :character) (sh08-character-carrier? value)
          (if (= kind :string) (string? value)
            (if (= kind :keyword) (keyword? value)
              (if (= kind :symbol) (symbol? value) false))))))))

(defn sh08-qd-collection-value-valid? [kind value values]
  (if (contains? #{:list :vector} kind)
    (if (if (= kind :list) (seq? value) (vector? value)) (= (vec value) values) false)
    (if (= kind :set)
      (if (set? value) (if (= (count value) (count values)) (= value (set values)) false) false)
      (if (= kind :map)
        (if (if (map? value) (sh08-even-count? values) false)
          (if (= (* 2 (count value)) (count values))
            (= value (loop [remaining values out {}]
                       (if (= (count remaining) 0) out
                         (recur (rest (rest remaining)) (assoc out (first remaining) (second remaining)))))) false) false)
        false))))

(defn sh08-qd-data [forms id parent quote-id path seen depth budget]
  (let [form (get forms id) kind (get form :kind) value (get form :value) ids (get form :child-form-ids)]
    (if (if (> depth (get (sh08-local-bounds-value) :maximum-carrier-depth)) true
          (if (<= budget 0) true (> (count ids) (get (sh08-local-bounds-value) :maximum-node-children))))
      (assoc (sh08-qd-failure "C7-ANNOTATION" :quoted-data-work-limit form :bounded-quoted-data-tree
                       {:depth depth :width (count ids) :remaining-work budget}) :work-count (if (<= budget 0) 0 1))
      (if (sh08-ft-all-true?
            [(map? form) (sh08-sha256-id? id) (= id (get form :form-id)) (= parent (get form :parent-form-id))
             (sh08-sha256-id? (get form :syntax-id)) (vector? ids)
             (<= (count ids) (get (sh08-local-bounds-value) :maximum-node-children))
             (sh08-all-unique? ids []) (= false (contains? seen id))])
        (if (contains? #{:list :vector :map :set} kind)
          (loop [remaining ids ordinal 0 children [] values [] types [] used 1]
            (if (= (count remaining) 0)
              (if (sh08-qd-collection-value-valid? kind value values)
                {:status :accepted :work-count used
                 :data {:origin {:kind :quoted-data :quote-core-node-id quote-id :form-id id
                                 :syntax-id (get form :syntax-id) :data-path path :child-form-ids ids}
                        :kind kind :value value :children children :shape-size used
                        :source (get (sh08-bm-source-node {} form) :source)
                        :type (if (= kind :map) {:kind :gravity.type/map :member-types types :shape :literal}
                                {:kind (get {:list :gravity.type/list :vector :gravity.type/vector :set :gravity.type/set} kind)
                                 :element-types types :shape :literal})}}
                (assoc (sh08-qd-failure "C7-VERIFY" :quoted-data-value-child-mismatch form :exact-ordered-data-children value) :work-count used))
              (let [child (sh08-qd-data forms (first remaining) id quote-id (conj path ordinal) (conj seen id) (+ depth 1) (- budget used))]
                (if (= :accepted (get child :status))
                  (recur (rest remaining) (+ ordinal 1) (conj children (get child :data))
                         (conj values (get (get child :data) :value)) (conj types (get (get child :data) :type))
                         (+ used (get child :work-count))) (assoc child :work-count (+ used (get child :work-count 0)))))))
          (if (contains? #{:decimal :ratio :integer} kind)
            (if (if (= kind :integer) (integer? value) false)
              (sh08-qd-scalar form quote-id path)
              (sh08-qd-failure "C7-ANNOTATION" :unsupported-quoted-numeric-representation form :normalized-exact-integer value))
            (if (contains? #{:nil :boolean :character :string :keyword :symbol} kind)
              (sh08-qd-scalar form quote-id path)
              (sh08-qd-failure "C7-ANNOTATION" :unsupported-quoted-data-kind form :first-order-immutable-data kind))))
        (sh08-qd-failure "C7-VERIFY" :malformed-quoted-data-tree form :exact-acyclic-payload-parent-child-join id)))))

(defn sh08-qd-scalar [form quote-id path]
  (let [kind (get form :kind) value (get form :value)]
    (if (if (= [] (get form :child-form-ids)) (sh08-qd-scalar-valid? kind value) false)
      {:status :accepted :work-count 1
       :data {:origin {:kind :quoted-data :quote-core-node-id quote-id :form-id (get form :form-id)
                       :syntax-id (get form :syntax-id) :data-path path :child-form-ids []}
              :kind kind :value value :type (sh08-primitive-type-from-literal-kind kind)
              :source (get (sh08-bm-source-node {} form) :source) :children [] :shape-size 1}}
      (sh08-qd-failure "C7-VERIFY" :quoted-scalar-kind-value-mismatch form :exact-scalar-kind-value-and-zero-children value))))

(defn sh08-qd-node-with-budget [node forms budget]
  (let [owner (get forms (get (get node :source) :form-id)) ids (get owner :child-form-ids)
        operator (get forms (get ids 0)) payload (get forms (get ids 1)) attrs (get node :attributes)]
    (if (sh08-ft-all-true?
          [(= :quote (get node :core-form)) (= :list (get owner :kind)) (vector? ids) (= 2 (count ids))
           (sh08-all-unique? ids [])
           (= (get node :source) (get (sh08-bm-source-node {} owner) :source))
           (= (get ids 0) (get operator :form-id)) (= (get ids 1) (get payload :form-id))
           (sh08-sha256-id? (get operator :syntax-id))
           (= :symbol (get operator :kind)) (= 'quote (get operator :value)) (= [] (get operator :child-form-ids))
           (= (get owner :form-id) (get operator :parent-form-id) (get payload :parent-form-id))
           (seq? (get owner :value)) (= (vec (get owner :value)) ['quote (get payload :value)])
           (= [] (get node :children) (get node :resolved-binding-ids))
           (= :no-evaluation (get (get node :evaluation) :kind)) (= [] (get (get node :evaluation) :order))
           (= attrs {:quoted-form-id (get payload :form-id) :quoted-syntax-id (get payload :syntax-id)
                     :quoted-kind (get payload :kind) :quoted-value (get payload :value)})])
      (let [result (sh08-qd-data forms (get payload :form-id) (get owner :form-id) (get node :node-id) [] #{} 0 budget)]
        (if (if (= :accepted (get result :status))
              (= false (= :accepted (get (sh08-carrier-preflight (get result :data)) :status))) false)
          (assoc (sh08-qd-failure "C7-ANNOTATION" :quoted-data-evidence-limit payload :bounded-quoted-data-evidence nil)
                 :work-count (get result :work-count)) result))
      (assoc (sh08-qd-failure "C7-VERIFY" :malformed-quote-owner-payload-join owner :exact-inert-quote-source-and-payload attrs)
             :work-count 0))))

(defn sh08-qd-node [node forms]
  (sh08-qd-node-with-budget node forms (get (sh08-local-bounds-value) :maximum-core-nodes)))

(defn sh08-qd-executable-data [data executable-forms]
  (if (contains? executable-forms (get (get data :origin) :form-id)) data
    (loop [remaining (get data :children)]
      (if (= (count remaining) 0) nil
        (let [found (sh08-qd-executable-data (first remaining) executable-forms)]
          (if (= found nil) (recur (rest remaining)) found))))))

(defn sh08-qd-products [nodes source-forms module]
  (sh08-qd-products-with-budget nodes source-forms module (get (sh08-local-bounds-value) :maximum-core-nodes)))

(defn sh08-qd-products-with-budget [nodes source-forms module budget]
  (let [forms (loop [remaining source-forms out {}]
                (if (= (count remaining) 0) out
                  (recur (rest remaining) (assoc out (get (first remaining) :form-id) (first remaining)))))
        executable-forms (loop [remaining nodes out #{}]
                           (if (= (count remaining) 0) out
                             (recur (rest remaining) (conj out (get (get (first remaining) :source) :form-id)))))]
    (loop [remaining nodes types {} constraints [] diagnostics [] used 0]
      (if (= (count remaining) 0)
        {:type-table types :constraints constraints :work-count used
         :diagnostics (if (= :accepted (get (sh08-carrier-preflight constraints) :status)) diagnostics
                        (conj diagnostics (sh08-bm-error "C7-ANNOTATION" :quoted-data-evidence-limit
                                           (first (sh08-bm-select nodes :core-form :quote)) :bounded-quoted-data-ledger nil)))}
        (let [node (first remaining)]
          (if (= :quote (get node :core-form))
            (let [checked (sh08-qd-node-with-budget node forms (- budget used))
                  executable (if (= :accepted (get checked :status))
                               (sh08-qd-executable-data (get checked :data) executable-forms) nil)
                  result (if (= executable nil) checked
                           (assoc (sh08-qd-failure "C7-VERIFY" :quoted-payload-is-executable
                             (get forms (get (get executable :origin) :form-id)) :data-without-executable-nodes
                             (get executable :origin)) :work-count (get checked :work-count)))]
              (if (= :accepted (get result :status))
                (let [data (get result :data) type (get data :type)
                      premise {:core-node-id (get node :node-id) :source (get node :source)
                               :attributes (get node :attributes) :children (get node :children)
                               :resolved-binding-ids (get node :resolved-binding-ids) :evaluation (get node :evaluation)}]
                  (recur (rest remaining) (assoc types (get node :node-id) type)
                    (conj constraints {:constraint-id-request {:domain :gravity/sh08-recursive-quoted-data-constraint-v1
                                                              :quote premise :data data}
                                       :kind :equality :producer-rule :sh08-recursive-quoted-data-v1 :lhs (get node :node-id) :rhs type
                                       :quoted-data data :dependencies {:quote premise :data data}
                                       :solution {:type type :evaluation :no-evaluation}
                                       :invalidation [:quote-owner :quote-operator :payload-form-syntax-ids :payload-kind-value
                                                      :payload-child-order :data-paths :no-executable-children-bindings-calls]
                                       :profile (get module :profile) :target (get module :target) :status :solved :diagnostics []})
                    diagnostics (+ used (get result :work-count))))
                (recur (rest remaining) types constraints
                  (conj diagnostics (sh08-bm-error (get result :rule) (get result :reason)
                                      (if (map? (get result :form)) (sh08-bm-source-node node (get result :form)) node)
                                      (get result :expected) (get result :actual))) (+ used (get result :work-count 0)))))
            (recur (rest remaining) types constraints diagnostics used)))))))

(defn sh08-qd-shape [data node]
  (let [kind (get data :kind) children (get data :children)
        base {:status :accepted :type (get data :type) :data-origin (get data :origin)
              :source (get data :source) :binding-links [] :shape-size (get data :shape-size)}]
    (if (contains? #{:map :vector} kind)
      (loop [remaining children ordinal 0 parts []]
        (if (= (count remaining) 0) (assoc base :shape-kind kind :parts parts :constructor-origin :quoted-data)
          (let [key (if (= kind :map) (first remaining) nil)
                value (if (= kind :map) (second remaining) (first remaining))
                child-shape (sh08-qd-shape value node)]
            (if (if (= kind :map) (= :keyword (get key :kind)) true)
              (if (= :accepted (get child-shape :status))
                (recur (if (= kind :map) (rest (rest remaining)) (rest remaining))
                       (+ ordinal (if (= kind :map) 2 1))
                       (conj parts {:key (get key :value) :coordinate (if (= kind :map) (+ ordinal 1) ordinal)
                                    :key-data-origin (get key :origin) :value-data-origin (get value :origin) :shape child-shape})) child-shape)
              (assoc (sh08-sm-failure "C7-ANNOTATION" :unsupported-structural-map-key nil :literal-keyword-key (get key :value))
                     :node (assoc node :source (get key :source)))))))
      (assoc base :shape-kind :scalar :domain {:values [(get data :value)]}))))

; L2/L5/L9: direct throws retain the original C6 transfer, including transfers
; whose payload never returns. No call or handler propagation is inferred here.
(defn sh08-th-error [rule reason node expected actual]
  {:status :rejected :constraints [] :throws {} :diagnostics
   [{:rule rule :reason reason :node node :expected expected :actual actual}]})

(defn sh08-th-owners [core budget]
  (let [nodes (sh08-ft-node-index (get core :nodes))]
    (loop [pending (loop [ids (get core :root-core-node-ids) out []]
                     (if (= 0 (count ids)) out
                       (recur (rest ids) (conj out {:id (first ids) :owner nil}))))
           owners {} work 0]
      (if (= 0 (count pending)) {:status :accepted :owners owners :work-count work}
        (if (>= work budget) (sh08-th-error "C7-GENERIC" :typed-throw-work-limit {} :bounded-source-visits work)
          (let [entry (first pending) id (get entry :id) node (get nodes id) owner (get entry :owner)
                child-owner (if (= :fn (get node :core-form)) (get (get node :source) :syntax-id) owner)]
            (if (if (map? node) (= false (contains? owners id)) false)
              (recur (loop [ids (get node :children) out (vec (rest pending))]
                       (if (= 0 (count ids)) out
                         (recur (rest ids) (conj out {:id (first ids) :owner child-owner}))))
                     (assoc owners id owner) (+ work 1))
              (sh08-th-error "C7-VERIFY" :typed-throw-owner-graph node :unique-rooted-node id))))))))

(defn sh08-th-transfer-valid? [transfer node payload forms owner ordinal]
  (let [source (get node :source) form (get forms (get source :form-id)) ids (get form :child-form-ids)
        operator (get forms (get ids 0)) value (get forms (get ids 1)) attrs (get node :attributes)
        shared [:construction-order :runtime-reachability :transfer-policy :result-policy :required-effect
                :authenticated-sh06-artifact-id :sh06-semantic-projection-id :type-legality :effect-registry-legality
                :effect-profile-capability-legality :profile-error-lowering-legality :ownership-legality :safety-classification]]
    (sh08-ft-all-true?
      [(map? transfer) (= ordinal (get transfer :ordinal)) (= :throw (get node :core-form))
       (= (get node :node-id) (get transfer :core-node-id))
       (= (get source :form-id) (get transfer :form-id)) (= (get source :syntax-id) (get transfer :syntax-id))
       (= source (get (sh08-bm-source-node {} form) :source))
       (= :list (get form :kind)) (vector? ids) (= 2 (count ids)) (sh08-all-unique? ids [])
       (if (seq? (get form :value)) (= ['throw (get value :value)] (vec (get form :value))) false)
       (= :symbol (get operator :kind)) (= 'throw (get operator :value)) (= [] (get operator :child-form-ids))
       (= (get form :form-id) (get operator :parent-form-id) (get value :parent-form-id))
       (= (get payload :source) (get (sh08-bm-source-node {} value) :source))
       (= [(get payload :node-id)] (get node :children) (get transfer :evaluated-children))
       (= (get payload :node-id) (get transfer :value-core-node-id)) (= [] (get node :resolved-binding-ids))
       (= :value-then-transfer (get (get node :evaluation) :kind) (get attrs :evaluation-order))
       (= [{:index 0 :core-node-id (get payload :node-id)}] (get (get node :evaluation) :order))
       (= owner (get transfer :evaluation-owner-function-syntax-id) (get (get node :evaluation) :owner-function-syntax-id))
       (= (get transfer :evaluation-region) (get (get node :evaluation) :region))
       (= [:evaluate-value :transfer-error] (get transfer :ordered-steps))
       (= 0 (get attrs :value-child-index)) (= :postorder-after-value (get attrs :construction-order))
       (= :error-transfer (get attrs :transfer-policy)) (= :never (get attrs :result-policy))
       (= :error/throw (get attrs :required-effect))
       (= :not-asserted-by-sh07-b7 (get attrs :runtime-reachability))
       (= [:pending-sh08 :pending-sh09 :pending-sh09 :pending-sh09 :pending-sh10 :pending-sh11]
          [(get attrs :type-legality) (get attrs :effect-registry-legality) (get attrs :effect-profile-capability-legality)
           (get attrs :profile-error-lowering-legality) (get attrs :ownership-legality) (get attrs :safety-classification)])
       (= (sh08-bm-project transfer shared) (sh08-bm-project attrs shared))])))

(defn sh08-th-products [core source-forms types budget]
  (let [nodes (get core :nodes) transfers (get core :error-transfers)
        throw-nodes (sh08-bm-select nodes :core-form :throw)]
    (if (= 0 (count throw-nodes))
      (if (if (= transfers nil) true (if (vector? transfers) (= [] transfers) false))
        {:status :accepted :constraints [] :throws {} :diagnostics [] :work-count 0}
        (sh08-th-error "C7-VERIFY" :typed-throw-transfer-census {} :no-extra-error-transfers transfers))
      ; Precharge bounded indexing, census, projection and fixed-width joins.
      ; The rooted walk and each transfer then consume their own visit.
      (let [work (+ (* 6 (count nodes)) (count source-forms) (* 70 (count throw-nodes))
                    (count (get core :call-edges)) (* 2 (count (get core :function-records))))
            indexed (sh08-ft-node-index nodes) forms (sh08-ft-index source-forms :form-id)
            owners (sh08-th-owners core (- budget work))]
        (if (if (<= work budget) (= :accepted (get owners :status)) false)
          (if (sh08-ft-all-true? [(vector? transfers) (= (count throw-nodes) (count (if (vector? transfers) transfers [])))
                 (sh08-ft-unique-records? (if (vector? transfers) transfers []) :core-node-id)
                 (= (set (keys (sh08-ft-node-index throw-nodes)))
                    (set (keys (sh08-ft-index (if (vector? transfers) transfers []) :core-node-id))))])
            (loop [remaining transfers ordinal 0 rows [] thrown {} used (+ work (get owners :work-count))]
              (if (= 0 (count remaining))
                {:status :accepted :constraints rows :throws thrown :diagnostics [] :work-count used}
                (if (>= used budget) (sh08-th-error "C7-GENERIC" :typed-throw-work-limit {} :bounded-source-visits used)
                  (let [transfer (first remaining) node (get indexed (get transfer :core-node-id))
                        payload (get indexed (get transfer :value-core-node-id))
                        owner (get (get owners :owners) (get node :node-id))
                        type (get types (get payload :node-id) :gravity.type/unknown)
                        occurring? (= false (= type :gravity.type/never))
                        premise {:version :sh08-direct-typed-throw-v1 :source-transfer transfer :source-node node
                                 :payload-node payload :payload-type type :owner-function-syntax-id owner
                                 :normal-transfer? occurring? :result-type :gravity.type/never}]
                    (if (sh08-th-transfer-valid? transfer node payload forms owner ordinal)
                      (if (sh08-ft-known? type)
                        (recur (rest remaining) (+ ordinal 1)
                          (conj rows {:constraint-id-request {:domain :gravity/sh08-direct-typed-throw-v1 :premise premise}
                            :kind :equality :producer-rule :sh08-direct-typed-throw-v1
                            :lhs (get node :node-id) :rhs :gravity.type/never :dependencies premise
                            :origin (get (get node :source) :origin-chain)
                            :invalidation [:error-transfers :throw-source :payload-source :payload-type :function-owner :evaluation-order]
                            :solution {:type :gravity.type/never :payload-type type :normal-transfer? occurring?}
                            :profile (get (get core :module) :profile) :target (get (get core :module) :target)
                            :status :solved :diagnostics []})
                          (assoc thrown owner (if (if occurring? (= false (contains? (set (get thrown owner [])) type)) false)
                                                (conj (get thrown owner []) type) (get thrown owner [])))
                          (+ used 1))
                        (sh08-th-error "C7-ANNOTATION" :typed-throw-payload-type-required payload :concrete-error-value type))
                      (sh08-th-error "C7-VERIFY" :typed-throw-source-transfer-join node :exact-original-error-transfer transfer))))))
            (sh08-th-error "C7-VERIFY" :typed-throw-transfer-census {} :complete-unique-error-transfers transfers))
          (if (= :rejected (get owners :status)) owners
            (sh08-th-error "C7-GENERIC" :typed-throw-work-limit {} :bounded-source-visits work)))))))

(defn sh08-th-functions [functions thrown]
  (loop [remaining functions out []]
    (if (= 0 (count remaining)) out
      (let [function (first remaining) id (get function :function-id)]
        (recur (rest remaining) (conj out (if (contains? thrown id)
          (assoc function :thrown-error-effects (get thrown id)) function)))))))

(defn sh08-tc-union [left right]
  (loop [remaining right out left seen (set left)]
    (if (= 0 (count remaining)) out
      (recur (rest remaining) (if (contains? seen (first remaining)) out (conj out (first remaining)))
             (conj seen (first remaining))))))

(defn sh08-tc-invokes? [node types]
  (loop [remaining (get node :children)]
    (if (= 0 (count remaining)) true
      (if (= :gravity.type/never (get types (first remaining))) false (recur (rest remaining))))))

(defn sh08-tc-scope-with-types [core thrown budget types]
  (let [nodes (sh08-ft-node-index (get core :nodes))
        handler-owners (loop [remaining (get core :error-handlers) out #{}]
                         (if (= 0 (count remaining)) out
                           (recur (rest remaining) (conj out (get (first remaining) :evaluation-owner-function-syntax-id)))))
        initial (sh08-ft-add-values-to-set handler-owners (set (keys thrown)))]
  (loop [scope initial remaining (get core :call-edges) next initial work (count (get core :error-handlers)) touched handler-owners]
    (if (>= work budget) (sh08-th-error "C7-GENERIC" :typed-throw-call-work-limit {} :bounded-call-visits work)
      (if (= 0 (count remaining))
        (if (= scope next) {:status :accepted :scope touched :active? (> (count touched) 0) :work-count work}
          (recur next (get core :call-edges) next work touched))
        (let [edge (first remaining) caller (get edge :caller-function-syntax-id) callee (get edge :callee-function-syntax-id)
              local? (= :local-function (get edge :classification))
              intrinsic? (contains? #{:gravity.type/applied-integral-ordering :gravity.type/applied-map-association :gravity.type/applied-collection-count :gravity.type/applied-vector-nth :gravity.type/applied-bounded-successor :gravity.type/applied-vector-append :gravity.type/applied-atomic-equality :gravity.type/applied-not :gravity.type/applied-map-contains :gravity.type/applied-map-get :gravity.type/applied-string-concat}
                            (get (get types (first (get (get nodes (get edge :call-core-node-id)) :children))) :kind))
              touches? (if (contains? scope caller) true (if local? (contains? scope callee) false))]
          (if (if touches? (if local? false (= false intrinsic?)) false)
            (sh08-th-error "C7-ANNOTATION" :unsupported-throwing-call-component {} :direct-local-call edge)
            (recur scope (rest remaining) (if touches? (if local? (conj (conj next caller) callee) (conj next caller)) next)
                   (+ work 1) (if touches? (if local? (conj (conj touched caller) callee) (conj touched caller)) touched)))))))))

(defn sh08-tc-scope [core thrown budget]
  (sh08-tc-scope-with-types core thrown budget {}))

(defn sh08-eh-source-products [core source-forms bindings budget]
  (let [sequence (get core :nodes) records (get core :error-handlers)]
    (if (sh08-ft-all-true? [(vector? sequence) (vector? source-forms) (vector? bindings)
                            (if (= records nil) true (vector? records))])
    (if (> (count sequence) budget) (sh08-th-error "C7-GENERIC" :typed-handler-work-limit {} :bounded-handler-visits (count sequence))
  (let [tries (sh08-bm-select sequence :core-form :try)
        records (get core :error-handlers) count-records (if (vector? records) (count records) 0)
        shapes? (loop [remaining tries]
                  (if (= 0 (count remaining)) true
                    (let [node (first remaining) attrs (get node :attributes)]
                      (if (if (vector? (get node :children))
                            (if (map? attrs) (vector? (get attrs :handler-clauses)) false) false)
                        (recur (rest remaining)) false))))
        work (+ (* 8 (count sequence)) (count source-forms) (count bindings)
                (* count-records (+ 100 (* 4 (count sequence)) (* 4 (count (get core :error-transfers))))))]
    (if (= 0 (count tries))
      (if (if (= records nil) true (= [] records))
        {:status :accepted :groups {} :seeds {} :work-count (count sequence) :diagnostics []}
        (sh08-th-error "C7-VERIFY" :unexpected-error-handlers {} :no-handler-records records))
      (if (= false shapes?) (sh08-th-error "C7-VERIFY" :malformed-typed-handler-family {} :canonical-handler-vectors nil)
      (if (> work budget) (sh08-th-error "C7-GENERIC" :typed-handler-work-limit {} :bounded-handler-visits work)
      (let [nodes (sh08-ft-node-index sequence) forms (sh08-ft-index source-forms :form-id)
            binding-index (sh08-ft-binding-index bindings) owners (sh08-th-owners core (- budget work))]
        (if (= :accepted (get owners :status))
        (loop [remaining tries ordinal 0 groups {} seeds {}]
          (if (= 0 (count remaining))
            (if (if (= ordinal count-records)
                  (= (loop [remaining records out []]
                       (if (= 0 (count remaining)) out
                         (recur (rest remaining) (conj out (sh08-ft-semantic-authenticated-record
                           (get (get (get core :identity-preimage) :lineage) :sh06-semantic-projection-id) (first remaining))))))
                     (get (get core :identity-preimage) :error-handlers)) false)
              {:status :accepted :groups groups :seeds seeds :work-count (+ work (get owners :work-count)) :diagnostics []}
              (sh08-th-error "C7-VERIFY" :error-handler-census {} :exact-handler-records records))
            (let [node (first remaining) id (get node :node-id) source (get node :source)
                  form (get forms (get source :form-id)) ids (get form :child-form-ids)
                  children (get node :children) attrs (get node :attributes)
                  clauses (get attrs :handler-clauses) owner (get (get owners :owners) id)
                  tree (sh08-bm-tree nodes (first children))
                  candidates (loop [transfers (get core :error-transfers) out []]
                               (if (= 0 (count transfers)) out
                                 (let [transfer (first transfers)]
                                   (recur (rest transfers)
                                     (if (if (contains? tree (get transfer :core-node-id))
                                           (= owner (get transfer :evaluation-owner-function-syntax-id)) false)
                                       (conj out (sh08-bm-project transfer [:ordinal :core-node-id])) out)))))
                  result
                  (if (if (vector? clauses) (<= (+ ordinal (count clauses)) count-records) false)
                  (loop [index 0 values [] next-seeds seeds]
                    (if (= index (count clauses)) {:status :accepted :clauses values :seeds next-seeds}
                      (let [clause (get clauses index) record (get records (+ ordinal index))
                            catch-form (get forms (get ids (+ index 2))) catch-ids (get catch-form :child-form-ids)
                            operator (get forms (get catch-ids 0)) type-form (get forms (get catch-ids 1))
                            binder-form (get forms (get catch-ids 2)) body-form (get forms (get catch-ids 3))
                            type-binding (get binding-index (get clause :error-type-binding-id))
                            binder (get binding-index (get clause :catch-binding-id))
                            type (sh08-ft-atomic-type-id (get type-binding :name)) body (get nodes (get children (+ index 1)))
                            body-tree (sh08-bm-tree nodes (get body :node-id))
                            uses (sh08-bm-uses sequence body-tree (get binder :binding-id))
                            all-uses (sh08-bm-uses sequence (set (keys nodes)) (get binder :binding-id))
                            expected-clause {:clause-ordinal index :handler-child-index (+ index 1)
                              :catch-clause-form-id (get catch-form :form-id) :catch-clause-syntax-id (get catch-form :syntax-id)
                              :error-type-form-id (get type-form :form-id) :error-type-syntax-id (get type-form :syntax-id)
                              :error-type-binding-id (get type-binding :binding-id)
                              :catch-binding-form-id (get binder-form :form-id) :catch-binding-syntax-id (get binder-form :syntax-id)
                              :catch-binding-id (get binder :binding-id) :catch-binding-scope-id (get binder :scope-id)}
                            expected-record (assoc
                              (sh08-bm-project attrs [:construction-order :runtime-reachability :selection-policy :result-policy
                                :authenticated-sh06-artifact-id :sh06-semantic-projection-id :type-coverage-legality
                                :result-type-join-legality :effect-registry-legality :effect-profile-capability-legality
                                :profile-error-lowering-legality :ownership-legality :safety-classification])
                              :ordinal (+ ordinal index) :clause-ordinal index :clause-count (count clauses)
                              :handler-child-index (+ index 1) :core-node-id id
                              :form-id (get form :form-id) :syntax-id (get form :syntax-id)
                              :protected-core-node-id (first children) :handler-core-node-id (get body :node-id)
                              :catch-clause-form-id (get catch-form :form-id) :catch-clause-syntax-id (get catch-form :syntax-id)
                              :error-type-form-id (get type-form :form-id) :error-type-syntax-id (get type-form :syntax-id)
                              :error-type-binding-id (get type-binding :binding-id)
                              :catch-binding-form-id (get binder-form :form-id) :catch-binding-syntax-id (get binder-form :syntax-id)
                              :catch-binding-id (get binder :binding-id) :catch-binding-scope-id (get binder :scope-id)
                              :catch-binding-use-syntax-ids uses :candidate-error-transfers candidates
                              :evaluation-region (get (get node :evaluation) :region)
                              :evaluation-owner-function-syntax-id owner
                              :ordered-steps [:evaluate-protected :conditionally-select-source-ordered-typed-handler]
                              :construction-order :protected-then-handlers-source-order-then-try
                              :runtime-evaluation :protected-then-conditional-handler-chain)]
                        (if (sh08-ft-all-true?
                              [(= 4 (count catch-ids)) (= :list (get catch-form :kind))
                               (if (seq? (get catch-form :value))
                                 (= ['catch (get type-form :value) (get binder-form :value) (get body-form :value)] (vec (get catch-form :value))) false)
                               (= 'catch (get operator :value)) (= :symbol (get operator :kind))
                               (= (get form :form-id) (get catch-form :parent-form-id))
                               (= (get catch-form :form-id) (get operator :parent-form-id) (get type-form :parent-form-id)
                                  (get binder-form :parent-form-id) (get body-form :parent-form-id))
                               (= :symbol (get type-form :kind) (get binder-form :kind))
                               (= (get type-binding :name) (get type-form :value))
                               (= [:core :type 'gravity.core] [(get type-binding :binding-class) (get type-binding :kind) (get type-binding :namespace)])
                               (= [:lexical :local] [(get binder :binding-class) (get binder :kind)])
                               (= (get binder :name) (get binder-form :value))
                               (= (get binder :definition-syntax-id) (get binder-form :syntax-id))
                               (= (get binder :scope-id) (get binder-form :scope-id))
                               (= (get body :source) (get (sh08-bm-source-node {} body-form) :source))
                               (= uses all-uses) (= expected-clause clause) (= expected-record record)])
                          (if (= type nil)
                            (sh08-th-error "C7-ANNOTATION" :unsupported-atomic-catch-type node :canonical-atomic-error-type (get type-form :value))
                            (recur (+ index 1) (conj values {:record record :error-type type :handler-core-node-id (get body :node-id)})
                              (assoc next-seeds (get binder :binding-id) type)))
                          (sh08-th-error "C7-VERIFY" :typed-handler-source-join node :exact-canonical-handler record)))))
                    (sh08-th-error "C7-VERIFY" :error-handler-census node :exact-handler-records records))]
              (if (sh08-ft-all-true?
                    [(vector? records) (vector? clauses) (> (count clauses) 0)
                     (= (+ 1 (count clauses)) (count children)) (= (+ 2 (count clauses)) (count ids))
                     (= source (get (sh08-bm-source-node {} form) :source)) (= :list (get form :kind))
                     (= 'try (get (get forms (first ids)) :value))
                     (if (seq? (get form :value))
                       (= (loop [remaining (rest ids) out ['try]]
                            (if (= 0 (count remaining)) out (recur (rest remaining) (conj out (get (get forms (first remaining)) :value)))))
                          (vec (get form :value))) false)
                     (= (get (get nodes (first children)) :source) (get (sh08-bm-source-node {} (get forms (get ids 1))) :source))
                     (= 0 (get attrs :protected-child-index)) (= (count clauses) (get attrs :handler-count))
                     (= (loop [i 1 out []] (if (= i (count children)) out (recur (+ i 1) (conj out i)))) (get attrs :handler-child-indexes))
                     (= :protected-then-ordered-typed-handler-candidates (get attrs :evaluation-order) (get (get node :evaluation) :kind))
                     (= owner (get (get node :evaluation) :owner-function-syntax-id))
                     (= (loop [remaining clauses out []]
                          (if (= 0 (count remaining)) out
                            (recur (rest remaining) (conj (conj out (get (first remaining) :error-type-binding-id))
                                                          (get (first remaining) :catch-binding-id)))))
                        (get node :resolved-binding-ids))
                     (= [{:index 0 :core-node-id (first children)}] (get (get node :evaluation) :order))
                     (= :source-ordered-typed-handler-candidates (get attrs :selection-policy))
                     (= :protected-or-selected-handler-last (get attrs :result-policy))
                     (= :not-asserted-by-sh07-b9 (get attrs :runtime-reachability))
                     (= [:pending-sh08 :pending-sh08 :pending-sh09 :pending-sh09 :pending-sh09 :pending-sh10 :pending-sh11]
                        [(get attrs :type-coverage-legality) (get attrs :result-type-join-legality) (get attrs :effect-registry-legality)
                         (get attrs :effect-profile-capability-legality) (get attrs :profile-error-lowering-legality)
                         (get attrs :ownership-legality) (get attrs :safety-classification)])])
                (if (= :accepted (get result :status))
                  (recur (rest remaining) (+ ordinal (count clauses)) (assoc groups id (get result :clauses)) (get result :seeds)) result)
                (sh08-th-error "C7-VERIFY" :typed-try-source-join node :exact-canonical-try attrs))))) owners)))))))
      (sh08-th-error "C7-VERIFY" :malformed-typed-handler-family {} :canonical-handler-input-vectors nil))))

; L5/L9: exact canonical atomic matches classify SOURCE error potential.
; Covered source errors do not establish profile/handler/capability authority.
(defn sh08-eh-partition [protected clauses graph]
  (loop [remaining clauses pending protected escaped [] handled []]
    (if (= 0 (count remaining))
      {:residual (sh08-tc-union pending escaped) :handled handled}
      (let [clause (first remaining) type (get clause :error-type)
            matched (loop [errors pending out []]
                      (if (= 0 (count errors)) out
                        (recur (rest errors) (if (= type (first errors)) (conj out (first errors)) out))))
            unmatched (loop [errors pending out []]
                        (if (= 0 (count errors)) out
                          (recur (rest errors) (if (= type (first errors)) out (conj out (first errors))))))
            own (if (> (count matched) 0) (get graph (get clause :handler-core-node-id) []) [])]
        (recur (rest remaining) unmatched (sh08-tc-union escaped own)
          (conj handled {:source-handler (get clause :record) :error-type type
                         :candidate-error-types pending :matched-error-types matched
                         :handler-error-types own :remaining-error-types unmatched}))))))

(defn sh08-eh-seed-bindings [initial seeds]
  (loop [remaining (keys seeds) out initial]
    (if (= 0 (count remaining)) out
      (recur (rest remaining) (assoc out (first remaining) (get seeds (first remaining)))))))

(defn sh08-eh-type-checks [groups types nodes]
  (loop [remaining (keys groups)]
    (if (= 0 (count remaining)) {:diagnostics []}
      (let [clauses (get groups (first remaining)) record (get (first clauses) :record)
            ids (loop [rest-clauses clauses out [(get record :protected-core-node-id)]]
                  (if (= 0 (count rest-clauses)) out
                    (recur (rest rest-clauses) (conj out (get (first rest-clauses) :handler-core-node-id)))))
            child-types (sh08-ft-ordered-child-types ids types)
            known? (sh08-ft-every-known? child-types)
            joined (sh08-ft-loop-kernel-normal-join child-types)]
        (if (if known? (= joined :gravity.type/unknown) false)
          {:diagnostics [{:rule "C7-TYPE-MISMATCH" :reason :try-normal-result-type-mismatch
                          :node (get nodes (first remaining)) :expected :compatible-protected-and-handler-normal-results :actual child-types}]}
          (recur (rest remaining)))))))

(defn sh08-eh-constraint [node clauses types graph]
  (let [ids (get node :children)
        source-errors (loop [remaining ids out []]
                        (if (= 0 (count remaining)) out
                          (recur (rest remaining) (conj out (get graph (first remaining) [])))))
        partition (sh08-eh-partition (first source-errors) clauses graph)
        premise {:version :sh08-atomic-typed-catch-v1 :source-node node
                 :source-handlers (loop [remaining clauses out []]
                                    (if (= 0 (count remaining)) out
                                      (recur (rest remaining) (conj out (get (first remaining) :record)))))
                 :catch-types (loop [remaining clauses out []]
                                (if (= 0 (count remaining)) out
                                  (recur (rest remaining) (conj out (get (first remaining) :error-type)))))
                 :child-types (sh08-ft-ordered-child-types ids types) :child-source-error-types source-errors
                 :partition partition :normal-result-type (get types (get node :node-id))
                 :matching :exact-canonical-atomic-type :effect-label-discharge :pending-profile-handler-capability-authority}]
    {:constraint-id-request {:domain :gravity/sh08-atomic-typed-catch-v1 :premise premise}
     :kind :equality :producer-rule :sh08-atomic-typed-catch-v1
     :lhs {:core-node-id (get node :node-id) :projection :source-error-handler-result}
     :rhs (get partition :residual) :dependencies premise :origin (get (get node :source) :origin-chain)
     :solution {:normal-result-type (get premise :normal-result-type) :thrown-error-effects (get partition :residual)
                :handled-source-errors (get partition :handled) :effect-label-discharge :pending-profile-handler-capability-authority}
     :invalidation [:error-handlers :error-transfers :catch-type-bindings :catch-lexical-bindings :type-table :source-forms :evaluation-order]
     :status :solved :diagnostics []}))

(defn sh08-eh-constraints [core groups types graph rows]
  (loop [remaining (get core :nodes) out rows]
    (if (= 0 (count remaining)) out
      (let [node (first remaining)]
        (recur (rest remaining) (if (= :try (get node :core-form))
          (conj out (assoc (sh08-eh-constraint node (get groups (get node :node-id)) types graph)
                      :profile (get (get core :module) :profile) :target (get (get core :module) :target))) out))))))

(defn sh08-tc-error-work [node graph target]
  (let [ids (if (= target nil) (get node :children) (conj (get node :children) target))
        size (loop [remaining ids out 0]
               (if (= 0 (count remaining)) out (recur (rest remaining) (+ out (count (get graph (first remaining) []))))))]
    (+ 1 (count ids) (* (+ 2 (count ids)) (+ 1 size)))))

(defn sh08-eh-groups [records bindings]
  (loop [remaining records groups {}]
    (if (= 0 (count remaining)) groups
      (let [record (first remaining) id (get record :core-node-id)]
        (recur (rest remaining)
          (assoc groups id (conj (get groups id []) {:record record
            :handler-core-node-id (get record :handler-core-node-id)
            :error-type (sh08-ft-atomic-type-id (get (get bindings (get record :error-type-binding-id)) :name))})))))))

(defn sh08-tc-node-errors [node graph target types handlers]
  (let [kind (get node :core-form)]
    (if (contains? #{:fn :quote} kind) []
      (if (= :try kind)
        (get (sh08-eh-partition (get graph (first (get node :children)) []) (get handlers (get node :node-id) []) graph) :residual)
      (let [operands (loop [ids (get node :children) out []]
                       (if (= 0 (count ids)) out (recur (rest ids) (sh08-tc-union out (get graph (first ids) [])))))
            called (if (= target nil) operands (sh08-tc-union operands (get graph target [])))
            payload (get types (first (get node :children)))]
        (if (if (= kind :throw) (= false (= payload :gravity.type/never)) false)
          (sh08-tc-union called [payload]) called))))))

(defn sh08-tc-graph [core types owners scope budget handlers]
  (let [nodes (sh08-ft-node-index (get core :nodes)) records (sh08-ft-function-record-index (get core :function-records))
        edges (sh08-ft-index (get core :call-edges) :call-core-node-id)
        selected (loop [remaining (get core :nodes) out []]
                   (if (= 0 (count remaining)) out
                     (recur (rest remaining) (if (contains? scope (get owners (get (first remaining) :node-id)))
                                              (conj out (first remaining)) out))))]
    (loop [pending selected deferred [] graph {} work 0 progress 0]
      (if (>= work budget) (sh08-th-error "C7-GENERIC" :typed-throw-call-work-limit {} :bounded-body-visits work)
        (if (= 0 (count pending))
          (if (= 0 (count deferred)) {:status :accepted :nodes graph :work-count work}
            (if (> progress 0) (recur deferred [] graph work 0)
              (sh08-th-error "C7-ANNOTATION" :throwing-call-cycle-or-missing-body {} :acyclic-complete-bodies deferred)))
          (let [node (first pending) kind (get node :core-form) id (get node :node-id) edge (get edges id)
                target (if (if (= kind :call) (sh08-tc-invokes? node types) false)
                         (get (get records (get edge :callee-function-syntax-id)) :body-core-node-id) nil)
                deps (if (= kind :fn) [] (get node :children)) deps (if (= target nil) deps (conj deps target))
                ready? (loop [ids deps]
                         (if (= 0 (count ids)) true (if (contains? graph (first ids)) (recur (rest ids)) false)))]
            ; L2/L5/L9: target/slot/transfer checking precedes this graph in C7.
            ; Both loop and function recur contribute only lexical child SOURCE
            ; errors. No transfer error or control-backedge dependency is added;
            ; this finite conservative union establishes no termination or effect legality.
            (if (contains? #{:literal :quote :reference :fn :def :do :if :let :match :loop :recur :collection-literal :keyword-map-lookup :throw :call :try} kind)
              (if ready? (recur (rest pending) deferred (assoc graph id (sh08-tc-node-errors node graph target types handlers))
                               (+ work (sh08-tc-error-work node graph target)) (+ progress 1))
                (recur (rest pending) (conj deferred node) graph (+ work 1 (count deps)) progress))
              (sh08-th-error "C7-ANNOTATION" :unsupported-throwing-body-operation node :acyclic-direct-local-body kind))))))))

(defn sh08-tc-constraint [core edge calls nodes records bindings types functions graph]
  (let [id (get edge :call-core-node-id) node (get nodes id)
        caller (get records (get edge :caller-function-syntax-id)) callee (get records (get edge :callee-function-syntax-id))
        invoked? (sh08-tc-invokes? node types) body (get callee :body-core-node-id)
        operand-errors (loop [ids (get node :children) out []]
                         (if (= 0 (count ids)) out (recur (rest ids) (sh08-tc-union out (get graph (first ids) [])))))
        callee-errors (if invoked? (get graph body []) [])
        premise {:version :sh08-acyclic-local-thrown-errors-v1 :analysis :conservative-source-error-potential
                 :invocation-guard :all-operand-types-normal :source-edge edge :source-call (get calls id)
                 :source-node node :operator-node (get nodes (first (get node :children)))
                 :caller-function caller :callee-function callee :callee-binding (get bindings (get edge :callee-binding-id))
                 :callee-normal-type (if (contains? #{:gravity.type/applied-integral-ordering :gravity.type/applied-map-association :gravity.type/applied-collection-count :gravity.type/applied-vector-nth :gravity.type/applied-bounded-successor :gravity.type/applied-vector-append :gravity.type/applied-atomic-equality :gravity.type/applied-not :gravity.type/applied-map-contains :gravity.type/applied-map-get :gravity.type/applied-string-concat}
                                                    (get (get types (first (get node :children))) :kind))
                   (get types (first (get node :children)))
                   (sh08-bm-project (get functions (get edge :callee-function-syntax-id)) [:parameters :return :fixed-arity :signature :latent-effects]))
                 :operand-types (sh08-ft-ordered-child-types (get edge :argument-core-node-ids) types)
                 :callee-source-body-id body :normal-invocation? invoked?
                 :operand-error-types operand-errors :callee-error-types callee-errors
                 :error-types (sh08-tc-union operand-errors callee-errors)}]
    {:constraint-id-request {:domain :gravity/sh08-acyclic-local-thrown-errors-v1 :premise premise}
     :kind :equality :producer-rule :sh08-acyclic-local-thrown-errors-v1
     :lhs {:core-node-id id :projection :thrown-error-effects} :rhs (get premise :error-types)
     :origin (get (get node :source) :origin-chain) :dependencies premise
     :solution {:thrown-error-effects (get premise :error-types) :normal-result-type (get types id)}
     :invalidation [:call-edges :calls :binding-table :function-records :callee-body :type-table :error-transfers :evaluation-order]
     :profile (get (get core :module) :profile) :target (get (get core :module) :target) :status :solved :diagnostics []}))

(defn sh08-tc-products [core types functions bindings direct budget]
  (if (if (= 0 (count (get direct :throws))) (= 0 (count (get core :error-handlers))) false) direct
  (let [scoped (sh08-tc-scope-with-types core (get direct :throws) budget types)]
    (if (= :accepted (get scoped :status))
      (if (= false (get scoped :active?))
        (assoc direct :work-count (+ (get direct :work-count 0) (get scoped :work-count)))
        (let [scope (get scoped :scope) initial (+ (get scoped :work-count) (* 8 (count (get core :nodes))) (* 100 (count (get core :error-handlers)))
                    (* 70 (count (get core :call-edges))) (count bindings) (count (get core :definitions))
                    (* 3 (count (get core :function-records)))
                    (* (count (get core :calls)) (+ (count bindings) (count (get core :definitions))
                                                   (* 2 (count (get core :function-records))))))
              owners (sh08-th-owners core (- budget initial))
              nodes (sh08-ft-node-index (get core :nodes)) records (sh08-ft-function-record-index (get core :function-records))
              calls (sh08-ft-index (get core :calls) :core-node-id) binding-index (sh08-ft-binding-index bindings)
              definitions (sh08-ft-index (get core :definitions) :binding-id)
              expected (if (if (<= initial budget) (= :accepted (get owners :status)) false)
                         (sh08-ft-index (sh08-ft-build-call-edges (get core :nodes) (get core :definitions) bindings
                                          (get core :calls) (get core :function-records)) :call-core-node-id) {})
              bad-edge (if (= :accepted (get owners :status)) (loop [edges (get core :call-edges)]
                          (if (= 0 (count edges)) nil
                            (let [edge (first edges) call (get calls (get edge :call-core-node-id))]
                              (if (if (contains? scope (get edge :caller-function-syntax-id))
                                    (if (= :local-function (get edge :classification))
                                      (if (sh08-ft-call-valid? call nodes binding-index)
                                        (let [definition (get definitions (get edge :callee-binding-id))
                                              callee (get records (get edge :callee-function-syntax-id))
                                              fn-node (get nodes (get callee :function-core-node-id))]
                                          (sh08-ft-all-true?
                                            [(= edge (get expected (get edge :call-core-node-id)))
                                             (sh08-ft-definition-valid? definition nodes binding-index)
                                             (= [(get callee :body-core-node-id)] (get fn-node :children))
                                             (= (get callee :function-syntax-id) (get (get fn-node :source) :syntax-id))
                                             (= (get edge :caller-function-syntax-id)
                                                (get (get owners :owners) (get edge :call-core-node-id)))])) false)
                                      (let [node (get nodes (get edge :call-core-node-id))
                                            descriptor (sh08-io-descriptor core node call edge nodes binding-index types (get core :module))]
                                        (if (map? descriptor) (= descriptor (get types (first (get node :children))))
                                          (if (sh08-si-binding? (get binding-index (get call :operator-binding-id)) (get core :module))
                                            (sh08-si-inferred-call-valid? core node call edge nodes binding-index types)
                                          (if (sh08-vn-binding? (get binding-index (get call :operator-binding-id)) (get core :module))
                                            (sh08-vn-inferred-call-valid? core node call edge nodes binding-index types)
                                          (if (sh08-cq-binding? (get binding-index (get call :operator-binding-id)) (get core :module))
                                            (sh08-cq-inferred-call-valid? core node call edge nodes binding-index types)
                                            (if (sh08-va-binding? (get binding-index (get call :operator-binding-id)) (get core :module))
                                              (sh08-va-inferred-call-valid? core node call edge nodes binding-index types)
                                              (if (sh08-sc-binding? (get binding-index (get call :operator-binding-id)) (get core :module))
                                                (sh08-sc-inferred-call-valid? core node call edge nodes binding-index types)
                                              (if (sh08-mg-binding? (get binding-index (get call :operator-binding-id)) (get core :module))
                                                (sh08-mg-inferred-call-valid? core node call edge nodes binding-index types)
                                              (if (sh08-mc-binding? (get binding-index (get call :operator-binding-id)) (get core :module))
                                                (sh08-mc-inferred-call-valid? core node call edge nodes binding-index types)
                                              (if (sh08-nt-binding? (get binding-index (get call :operator-binding-id)) (get core :module))
                                                (sh08-nt-inferred-call-valid? core node call edge nodes binding-index types)
                                              (if (sh08-ae-binding? (get binding-index (get call :operator-binding-id)) (get core :module))
                                                (sh08-ae-inferred-call-valid? core node call edge nodes binding-index types)
                                                (sh08-ma-inferred-call-valid? core node call edge nodes binding-index types))))))))))))) true)
                                (recur (rest edges)) edge)))) nil)
              recursive? (loop [components (get core :recursion-components)]
                           (if (= 0 (count components)) false
                             (if (loop [ids (get (first components) :function-syntax-ids)]
                                   (if (= 0 (count ids)) false (if (contains? scope (first ids)) true (recur (rest ids))))) true
                               (recur (rest components)))))
              derived (if (> initial budget)
                        (sh08-th-error "C7-GENERIC" :typed-throw-call-work-limit {} :bounded-reconstruction-visits initial)
                        (if (= :rejected (get owners :status)) owners
                        (if (if (= bad-edge nil) (= false recursive?) false)
                        (if (= :accepted (get owners :status))
                          (sh08-tc-graph core types (get owners :owners) scope (- budget initial (get owners :work-count))
                            (sh08-eh-groups (get core :error-handlers) binding-index)) owners)
                        (sh08-th-error (if recursive? "C7-ANNOTATION" "C7-VERIFY")
                          :unsupported-or-incoherent-throwing-call-component
                          (get nodes (get bad-edge :call-core-node-id) {}) :original-acyclic-local-edges bad-edge))))]
          (if (= :accepted (get derived :status))
            (let [thrown (loop [remaining (get core :function-records) out (get direct :throws)]
                           (if (= 0 (count remaining)) out
                             (let [record (first remaining) id (get record :function-syntax-id)]
                               (recur (rest remaining) (if (contains? scope id)
                                 (assoc out id (get (get derived :nodes) (get record :body-core-node-id) [])) out)))))
                  rows (loop [edges (get core :call-edges) out (sh08-eh-constraints core
                                (sh08-eh-groups (get core :error-handlers) binding-index) types (get derived :nodes) (get direct :constraints))
                              work (+ initial (get owners :work-count) (get derived :work-count))]
                         (if (> work budget) (sh08-th-error "C7-GENERIC" :typed-throw-call-work-limit {} :bounded-row-visits work)
                         (if (= 0 (count edges)) {:status :accepted :constraints out :work-count work}
                           (let [edge (first edges)]
                             (if (contains? scope (get edge :caller-function-syntax-id))
                               (recur (rest edges)
                                 (conj out (sh08-tc-constraint core edge calls nodes records binding-index types functions (get derived :nodes)))
                                 (+ work 70 (* 4 (sh08-tc-error-work (get nodes (get edge :call-core-node-id))
                                   (get derived :nodes) (get (get records (get edge :callee-function-syntax-id)) :body-core-node-id)))))
                               (recur (rest edges) out (+ work 1)))))))]
              (if (= :accepted (get rows :status))
                (assoc direct :throws thrown :constraints (get rows :constraints)
                  :work-count (+ (get direct :work-count 0) (get rows :work-count))) rows)) derived))) scoped))))

(defn sh08-th-type-map [table thrown]
  (loop [ids (keys table) out table]
    (if (= 0 (count ids)) out
      (let [id (first ids) type (get table id) owner (get type :function-id)]
        (recur (rest ids) (if (if (map? type) (contains? thrown owner) false)
          (assoc out id (assoc type :thrown-error-effects (get thrown owner))) out))))))

; L5/L13/STD5/SAFE9: an applied intrinsic is evidence at one direct
; operator occurrence, never a callable type on a binding or a math import.
(defn sh08-io-binding? [binding module]
  (sh08-ft-all-true?
    [(contains? '#{< <= > >=} (get binding :name))
     (= [:core :var 'gravity.core {:name 'gravity/core :version "bootstrap-contract-v1"} :gravity.type/core-var :safe]
        [(get binding :binding-class) (get binding :kind) (get binding :namespace)
         (get binding :package) (get binding :type-ref) (get binding :safety)])
     (= [] (get binding :effects) (get binding :capabilities))
     (contains? (set (get binding :profile-set)) (get module :profile))
     (contains? (set (get binding :target-set)) :all)]))

(defn sh08-io-descriptor [core node call edge nodes bindings types module]
  (let [children (get node :children) operator (get nodes (get call :operator-node-id))
        binding-id (get call :operator-binding-id) binding (get bindings binding-id)
        arguments (get call :argument-node-ids)
        args (sh08-ft-ordered-child-types arguments types)
        normal (loop [remaining args out []]
                 (if (= 0 (count remaining)) out
                   (recur (rest remaining) (if (= :gravity.type/never (first remaining)) out (conj out (first remaining))))))
        family (first normal) invoked? (= (count normal) (count args))
        integral? (contains? #{:gravity.type/integer :gravity.type/i8 :gravity.type/i16 :gravity.type/i32 :gravity.type/i64
                              :gravity.type/u8 :gravity.type/u16 :gravity.type/u32 :gravity.type/u64} family)
        caller (loop [remaining (get core :function-records)]
                 (if (= 0 (count remaining)) nil
                   (if (= (get (first remaining) :function-syntax-id) (get (get node :evaluation) :owner-function-syntax-id))
                     (first remaining) (recur (rest remaining)))))
        expected-call {:core-node-id (get node :node-id) :operator-node-id (first children) :operator-binding-id binding-id
                       :argument-node-ids (vec (rest children)) :ordered-evaluation-node-ids children
                       :evaluation-order :operator-then-arguments :result-policy :call-result}
        expected-edge {:ordinal (get edge :ordinal) :call-core-node-id (get node :node-id)
                       :caller-function-syntax-id (get caller :function-syntax-id) :caller-function-core-node-id (get caller :function-core-node-id)
                       :callee-binding-id binding-id :callee-definition-syntax-id (get binding :definition-syntax-id)
                       :callee-function-syntax-id nil :callee-function-core-node-id nil
                       :argument-core-node-ids arguments :ordered-evaluation-node-ids children
                       :evaluation-order :operator-then-arguments :classification :nonlocal-or-nonfunction}
        operation (get binding :name)]
    (if (sh08-ft-all-true?
          [(= :call (get node :core-form)) (= :reference (get operator :core-form))
           (= 2 (count args)) (= expected-call call) (= expected-edge edge)
           (sh08-io-binding? binding module)
           (= [binding-id] (get operator :resolved-binding-ids) (get node :resolved-binding-ids))
           (= {:symbol (get (get operator :attributes) :symbol) :position :operator :binding-id binding-id
               :binding-class :core :definition-syntax-id (get binding :definition-syntax-id)} (get operator :attributes))
           (if (= operation (get (get operator :attributes) :symbol)) true
             (= (str "gravity.core/" operation) (str (get (get operator :attributes) :symbol))))
           (= :operator-then-arguments (get (get node :evaluation) :kind))
           (= (loop [i 0 out []] (if (= i (count children)) out
                (recur (+ i 1) (conj out {:index i :core-node-id (get children i)})))) (get (get node :evaluation) :order))
           (if (= 0 (count normal)) true
             (if integral? (loop [remaining normal]
                            (if (= 0 (count remaining)) true
                              (if (= family (first remaining)) (recur (rest remaining)) false))) false))])
      {:kind :gravity.type/applied-integral-ordering :version :sh08-integral-ordering-v1
       :operation operation :intrinsic (get '{< :gravity.math.core/integral-less-than <= :gravity.math.core/integral-less-or-equal
                                             > :gravity.math.core/integral-greater-than >= :gravity.math.core/integral-greater-or-equal} operation)
       :semantic-owner 'gravity.math :layer0-owner 'gravity.math.core :resolution :gravity.core-compatibility
       :operator-node-id (get operator :node-id) :operator-binding-id binding-id :call-core-node-id (get node :node-id)
       :source (get node :source) :operator-source (get operator :source) :source-call call :source-edge edge :source-binding binding
       :argument-types args :parameter-types (if (= 0 (count normal)) nil [family family])
       :return :gravity.type/bool :result-type (if invoked? :gravity.type/bool :gravity.type/never)
       :profile (get module :profile) :target (get module :target)
       :numeric-mode :proof-required :safety :proven-safe
       :safety-rule :same-integral-total-order-no-conversion-overflow-or-rounding
       :latent-effects [] :capabilities [] :thrown-error-effects [] :application (if invoked? :normal :not-invoked)
       :invalidation [:calls :call-edges :binding-table :source-forms :type-table :profile :target :evaluation-order]}
      nil)))

(defn sh08-io-constraint [descriptor]
  {:constraint-id-request {:domain :gravity/sh08-integral-ordering-constraint-v1 :application descriptor}
   :kind :numeric-mode :producer-rule :sh08-integral-ordering-v1
   :lhs {:core-node-id (get descriptor :call-core-node-id) :projection :integral-ordering}
   :rhs (get descriptor :result-type) :dependencies descriptor :origin (get (get descriptor :source) :origin-chain)
   :solution {:numeric-mode :proof-required :safety :proven-safe
              :safety-rule :same-integral-total-order-no-conversion-overflow-or-rounding
              :result-type (get descriptor :result-type) :application (get descriptor :application)}
   :invalidation (get descriptor :invalidation) :profile (get descriptor :profile) :target (get descriptor :target)
   :status :solved :diagnostics []})

(defn sh08-io-call-fact [descriptor module]
  (let [source (get descriptor :source) edge (get descriptor :source-edge)]
    {:artifact :gravity/c7-call-type-fact
     :fact-id-request {:domain :gravity/sh08-integral-ordering-call-type-fact-v1 :application descriptor}
     :call-core-node-id (get descriptor :call-core-node-id) :caller-function-syntax-id (get edge :caller-function-syntax-id)
     :callee-function-syntax-id nil :argument-types (get descriptor :argument-types) :result-type (get descriptor :result-type)
     :evaluation-order :operator-then-arguments :source-span (get source :semantic-span) :syntax-id (get source :syntax-id)
     :origin-chain (get source :origin-chain) :generated-origin (get source :generated-origin)
     :profile (get module :profile) :target (get module :target) :effects [] :capabilities [] :status :inferred
     :dispatch :direct-integral-ordering :applied-integral-ordering descriptor :effect-facts-source :audited-numeric-intrinsic}))

(defn sh08-io-occurrence [node types context]
  (let [core (get context :ordering-core) call (get (get context :ordering-operators) (get node :node-id))]
    (if (map? call)
            (sh08-io-descriptor core (get (get context :lookup-nodes) (get call :core-node-id)) call
              (get (get context :ordering-edges) (get call :core-node-id))
              (get context :lookup-nodes) (get context :ordering-bindings) types (get core :module)) nil)))

(defn sh08-ft-infer-node-nominal
  [node type-table binding-types function-types edges context]
  (let [core-form (get node :core-form)
        children (get node :children)]
    (if (= core-form :try) (sh08-bm-join children type-table)
    (if (= core-form :throw) :gravity.type/never
    (if (= core-form :loop) (sh08-ft-last-type children type-table)
    (if (= core-form :recur)
      (if (contains? #{:loop :function} (get (get node :attributes) :target-kind)) :gravity.type/never :gravity.type/unknown)
    (if (= core-form :literal)
      (let [literal-type
            (sh08-primitive-type-from-literal-kind
             (get (get node :attributes) :literal-kind))]
        (if (= literal-type nil)
          :gravity.type/unknown
          (if (if (= :gravity.type/character literal-type) (sh08-character-carrier? (get (get node :attributes) :value)) true)
            literal-type :gravity.type/unknown)))
      (if (= core-form :quote)
        (get (get context :quote-types) (get node :node-id) :gravity.type/unknown)
      (if (= core-form :collection-literal)
        (sh08-ft-collection-type node type-table)
        (if (= core-form :reference)
          (let [intrinsic (sh08-io-occurrence node (get context :prior-type-table {}) context)]
          (if (map? intrinsic) intrinsic (get binding-types
               (get (get node :attributes) :binding-id)
               :gravity.type/unknown)))
          (if (= core-form :def)
            (get type-table (first children) :gravity.type/unknown)
            (if (= core-form :fn)
              (get function-types
                   (get (get node :source) :syntax-id)
                   :gravity.type/unknown)
              (if (= core-form :if)
                (sh08-ft-if-join-with-context children type-table context)
                (if (= core-form :do)
                  (sh08-ft-last-type children type-table)
                  (if (= core-form :let)
                    (sh08-ft-last-type children type-table)
                    (if (= core-form :call)
                    (let [edge
                          (sh08-ft-edge-by-call-id
                           edges (get node :node-id))]
                      (if (= :gravity.type/applied-integral-ordering (get (get type-table (first children)) :kind))
                        (get (get type-table (first children)) :result-type)
                      (if (if (map? edge)
                            (= (get edge :classification) :local-function)
                            false)
                        (get
                         (sh08-ft-function-by-id
                          function-types
                          (get edge :callee-function-syntax-id))
                         :return
                         :gravity.type/unknown)
                        (if (if (= :accepted (get context :status))
                              (= (get node :node-id)
                                 (get context :inner-call-core-node-id))
                              false)
                          (get context :value-type :gravity.type/unknown)
                          (get (get (sh08-im-callee edge context) :function-type) :return :gravity.type/unknown)))))
                    (if (= core-form :match)
                      (sh08-gd-match-result-type node type-table context)
                      :gravity.type/unknown)))))))))))))))))

(defn sh08-ft-infer-node-with-context
  [node type-table binding-types function-types edges context]
  (let [nominal (sh08-ft-infer-node-nominal node type-table binding-types function-types edges context)
        form (get node :core-form) children (sh08-ft-ordered-child-types (get node :children) type-table)]
    (if (= form :match)
      (if (= :gravity.type/never (first children)) :gravity.type/never nominal)
      (let [joined (sh08-ft-normal-return-type form children nominal)]
        (if (if (= form :if) (if (= joined :gravity.type/unknown) (= :accepted (get context :status)) false) false)
          nominal joined)))))

; L7/C7: finite Boolean matches consume the authenticated C6 decision products.
; Match premises and solutions live in the existing identity-bound ledger.
(defn sh08-bm-project [record fields]
  (loop [remaining fields result {}]
    (if (= (count remaining) 0) result
      (recur (rest remaining) (assoc result (first remaining) (get record (first remaining)))))))

(defn sh08-bm-select [records field value]
  (if (vector? records)
    (loop [remaining records result []]
      (if (= (count remaining) 0) result
        (recur (rest remaining)
               (if (= value (get (first remaining) field)) (conj result (first remaining)) result))))
    []))

(defn sh08-bm-join [children types]
  (sh08-ft-normal-return-type :alternatives (sh08-ft-ordered-child-types children types) :gravity.type/unknown))

(defn sh08-bm-tree [nodes root]
  (loop [pending [root] seen #{}]
    (if (= (count pending) 0) seen
      (let [id (first pending)]
        (if (contains? seen id) (recur (rest pending) seen)
          (recur (sh08-ft-add-values-to-set (get (get nodes id) :children) (rest pending))
                 (conj seen id)))))))

(defn sh08-bm-uses [nodes tree binding-id]
  (loop [remaining nodes result []]
    (if (= (count remaining) 0) result
      (let [node (first remaining)]
        (recur (rest remaining)
          (if (if (= :reference (get node :core-form))
                (if (= binding-id (get (get node :attributes) :binding-id))
                  (contains? tree (get node :node-id)) false) false)
            (conj result (get (get node :source) :syntax-id)) result))))))

(defn sh08-bm-pattern-value [form]
  (let [value (get form :value)]
    (if (= :list (get form :kind))
      (if (seq? value)
        (if (= 2 (count value))
          (if (= 'quote (first value))
            (if (symbol? (second value)) (second value) value) value) value) value) value)))

(defn sh08-bm-source-kind-valid? [branch form]
  (let [kind (get branch :pattern-kind) value (get form :value)
        binding (get branch :pattern-binding-id) scope (get branch :pattern-binding-scope-id)]
    (if (= :binding kind)
      (if (= :symbol (get form :kind))
        (if (symbol? value) (if (= '_ value) false
          (if (sh08-sha256-id? binding) (sh08-sha256-id? scope) false)) false) false)
      (if (= binding nil)
        (if (= scope nil)
          (if (= :wildcard kind)
            (if (= :symbol (get form :kind)) (= '_ value) false)
            (if (= :literal kind)
              (if (contains? #{:nil :boolean :integer :decimal :ratio :character :string :keyword} (get form :kind)) true
                (if (= :list (get form :kind))
                  (if (seq? value) (if (= 2 (count value))
                    (if (= 'quote (first value)) (symbol? (second value)) false) false) false) false)) false))
          false) false))))

(defn sh08-bm-branch-valid? [node branch pattern ordinal nodes bindings forms sequence]
  (let [attributes (get node :attributes)
        clause (get (get attributes :branch-clauses) ordinal)
        body (get nodes (get branch :branch-core-node-id))
        form (get forms (get branch :pattern-form-id))
        owner (get forms (get (get node :source) :form-id))
        body-form (get forms (get branch :branch-form-id))
        binding-id (get branch :pattern-binding-id)
        binding (get bindings binding-id)
        uses (if (= binding-id nil) []
               (sh08-bm-uses sequence (sh08-bm-tree nodes (get body :node-id)) binding-id))
        clause-fields [:clause-ordinal :branch-child-index :pattern-kind :pattern-form-id
                       :pattern-syntax-id :pattern-value :branch-form-id :branch-syntax-id
                       :pattern-binding-id :pattern-binding-scope-id :pattern-binding-ids]]
    (sh08-ft-all-true?
      [(map? branch) (map? pattern) (map? form) (map? owner) (map? body-form)
       (= (sh08-bm-project branch clause-fields) clause)
       (= ordinal (get branch :clause-ordinal)) (= ordinal (get pattern :clause-ordinal))
       (= (count (get attributes :branch-clauses)) (get branch :clause-count))
       (= (+ ordinal 1) (get branch :branch-child-index))
       (= (get branch :core-node-id) (get node :node-id) (get pattern :core-node-id))
       (= (get branch :scrutinee-core-node-id) (first (get node :children)))
       (= (get branch :branch-core-node-id) (get (get node :children) (+ ordinal 1)))
       (= (get branch :pattern-form-id) (get form :form-id) (get pattern :pattern-form-id)
          (get (get owner :child-form-ids) (+ 2 (* 2 ordinal))))
       (= (get branch :pattern-syntax-id) (get form :syntax-id) (get pattern :pattern-syntax-id))
       (= (get branch :branch-form-id) (get (get body :source) :form-id)
          (get (get owner :child-form-ids) (+ 3 (* 2 ordinal))))
       (= (get branch :branch-syntax-id) (get (get body :source) :syntax-id) (get body-form :syntax-id))
       (= (get branch :pattern-kind) (get pattern :pattern-kind))
       (sh08-bm-source-kind-valid? branch form)
       (= (get branch :pattern-value) (get pattern :pattern-value)
          (sh08-bm-pattern-value form))
       (= 0 (get pattern :depth) (get pattern :local-ordinal) (get pattern :root-local-ordinal))
       (= [] (get pattern :path)) (= nil (get pattern :parent-ordinal) (get pattern :parent-local-ordinal))
       (= (get pattern :ordinal) (get pattern :root-ordinal))
       (= (get branch :pattern-binding-id) (get pattern :pattern-binding-id))
       (= (get branch :pattern-binding-scope-id) (get pattern :pattern-binding-scope-id))
       (= uses (get branch :pattern-binding-use-syntax-ids) (get pattern :pattern-binding-use-syntax-ids))
       (if (= binding-id nil) true
         (= uses (sh08-bm-uses sequence (set (keys nodes)) binding-id)))
       (= (get branch :pattern-binding-ids) (if (= binding-id nil) [] [binding-id]))
       (if (= binding-id nil) true
         (sh08-ft-all-true?
           [(= :binding (get branch :pattern-kind)) (= :lexical (get binding :binding-class))
            (= (get binding :definition-syntax-id) (get form :syntax-id))
            (= (get binding :name) (get form :value))
            (= (get binding :scope-id) (get form :scope-id) (get branch :pattern-binding-scope-id))]))
       (= (get branch :conditional-region)
          {:kind :match-branch :match-syntax-id (get (get node :source) :syntax-id) :clause-ordinal ordinal})
       (= (get branch :conditional-region) (get (get body :evaluation) :region))
       (= :evaluate-scrutinee-once (get branch :scrutinee-evaluation))
       (= :conditionally-evaluate-selected-branch (get branch :branch-evaluation))
       (= (get attributes :authenticated-sh06-artifact-id)
          (get branch :authenticated-sh06-artifact-id) (get pattern :authenticated-sh06-artifact-id))
       (= (get attributes :sh06-semantic-projection-id)
          (get branch :sh06-semantic-projection-id) (get pattern :sh06-semantic-projection-id))])))

(defn sh08-bm-group-valid? [node branches patterns skeleton nodes bindings forms sequence]
  (let [attributes (get node :attributes) count-branches (count branches)]
    (if (if (map? skeleton)
          (if (vector? (get skeleton :branch-core-node-ids))
          (if (> count-branches 0)
          (if (vector? (get attributes :branch-clauses))
            (= count-branches (count patterns) (count (get attributes :branch-clauses))
               (get attributes :branch-count) (- (count (get node :children)) 1)) false) false) false) false)
      (sh08-ft-all-true?
        [(= 0 (get attributes :scrutinee-child-index))
         (= (get node :children) (sh08-ft-add-values-to-set
                                  (get skeleton :branch-core-node-ids) [(first (get node :children))]))
         (= (get skeleton :scrutinee-core-node-id) (first (get node :children)))
         (= (get skeleton :core-node-id) (get node :node-id))
         (loop [remaining branches ordinal 0 ids [] indexes []]
           (if (= (count remaining) 0)
             (= [ids indexes] [(get node :resolved-binding-ids) (get attributes :branch-child-indexes)])
             (if (sh08-bm-branch-valid? node (first remaining) (get patterns ordinal) ordinal
                                       nodes bindings forms sequence)
               (recur (rest remaining) (+ ordinal 1)
                      (sh08-ft-add-values-to-set (get (first remaining) :pattern-binding-ids) ids)
                      (conj indexes (+ ordinal 1))) false)))
         (= :source-ordered-pattern-candidates (get skeleton :selection-policy) (get attributes :selection-policy))
         (= :not-asserted-by-sh07-b11 (get skeleton :runtime-reachability) (get attributes :runtime-reachability))
         (= :pending-sh08 (get skeleton :result-type-join) (get attributes :result-type-join)
            (get skeleton :exhaustiveness) (get attributes :exhaustiveness))
         (= (get skeleton :authenticated-sh06-artifact-id) (get attributes :authenticated-sh06-artifact-id))
         (= (get skeleton :sh06-semantic-projection-id) (get attributes :sh06-semantic-projection-id))]) false)))

(defn sh08-bm-source-node [node form]
  (assoc node :source
    {:form-id (get form :form-id) :syntax-id (get form :syntax-id)
     :semantic-span (get form :source-span) :origin-chain (get form :origin-chain)
     :generated-origin (get form :generated-origin)}))

(defn sh08-bm-products [core products source-forms]
  (if (= :accepted (get products :status))
    (let [sequence (get core :nodes) nodes (get products :node-table)
          matches (sh08-bm-select sequence :core-form :match)
          branches (get core :match-branch-records)
          patterns (get core :match-pattern-records)
          skeletons (get core :match-decision-skeletons)
          forms (loop [remaining source-forms result {}]
                  (if (= (count remaining) 0) result
                    (recur (rest remaining) (assoc result (get (first remaining) :form-id) (first remaining)))))]
      (if (sh08-ft-all-true? [(vector? branches) (vector? patterns) (vector? skeletons)])
      (if (sh08-ft-all-true?
            [(loop [rows branches ordinal 0]
               (if (= (count rows) 0) true
                 (if (= ordinal (get (first rows) :ordinal)) (recur (rest rows) (+ ordinal 1)) false)))
             (loop [rows patterns ordinal 0]
               (if (= (count rows) 0) true
                 (if (= ordinal (get (first rows) :ordinal)) (recur (rest rows) (+ ordinal 1)) false)))])
      (if (= (count matches) 0)
        (if (sh08-ft-all-true? [(= 0 (count branches)) (= 0 (count patterns)) (= 0 (count skeletons))])
          products {:status :rejected :reason :orphan-match-products})
        (if (sh08-ft-all-true? [(vector? branches) (vector? patterns) (vector? skeletons)
                                (= (count matches) (count skeletons))])
          (loop [remaining matches consumed-branches 0 consumed-patterns 0 groups []]
            (if (= (count remaining) 0)
              (if (= [consumed-branches consumed-patterns] [(count branches) (count patterns)])
                (assoc products :boolean-matches groups)
                {:status :rejected :reason :orphan-match-products})
              (let [node (first remaining) id (get node :node-id)
                    bs (sh08-bm-select branches :core-node-id id)
                    ps (sh08-bm-select patterns :core-node-id id)
                    roots (sh08-bm-select ps :depth 0)
                    ss (sh08-bm-select skeletons :core-node-id id)
                    unsupported (loop [rs roots]
                                  (if (= (count rs) 0) nil
                                    (if (contains? #{:literal :wildcard :binding} (get (first rs) :pattern-kind))
                                      (recur (rest rs)) (first rs))))]
                (if (= unsupported nil)
                  (if (if (= (count ss) 1)
                        (if (= (count ps) (count roots))
                          (sh08-bm-group-valid? node bs ps (first ss) nodes (get products :binding-index) forms sequence)
                          false) false)
                    (recur (rest remaining) (+ consumed-branches (count bs)) (+ consumed-patterns (count ps))
                           (conj groups {:node node :branches bs :patterns ps :skeleton (first ss) :forms forms :nodes nodes
                             :lexical-bindings (get products :lexical-bindings) :binding-index (get products :binding-index)
                             :pattern-trees (loop [rows ps values []]
                                              (if (= (count rows) 0) values
                                                (recur (rest rows) (conj values {:record (first rows)
                                                  :form (get forms (get (first rows) :pattern-form-id)) :children []}))))}))
                    {:status :rejected :reason :malformed-boolean-match-products :node node})
                  (let [result (sh08-sm-group node bs ps (first ss) nodes (get products :binding-index)
                                             forms sequence (get products :lexical-bindings) (get products :calls))]
                    (if (= :accepted (get result :status))
                      (recur (rest remaining) (+ consumed-branches (count bs)) (+ consumed-patterns (count ps))
                             (conj groups result))
                      (assoc result :node (sh08-bm-source-node node (get forms (get (get result :record) :pattern-form-id))))))))))
          {:status :rejected :reason :malformed-match-product-families}))
        {:status :rejected :reason :malformed-match-product-ordinals})
        {:status :rejected :reason :malformed-match-product-families})) products))

(defn sh08-bm-seed-bindings [groups nodes prior-types bindings functions edges context]
  (loop [remaining groups result bindings]
    (if (= (count remaining) 0) result
      (let [group (first remaining)
            scrutinee (get nodes (first (get (get group :node) :children)))
            established (get prior-types (get scrutinee :node-id) :gravity.type/unknown)
            type (if (= :gravity.type/keyword established) established
                   (sh08-ft-infer-node-with-context scrutinee prior-types bindings functions edges context))]
        (recur (rest remaining)
          (if (sh08-sm-applicable? group type)
            (sh08-sm-seed group prior-types result functions)
          (if (if (= :gravity.type/bool type) (= false (contains? group :unsupported-pattern)) false)
            (loop [branches (get group :branches) values result]
              (if (= (count branches) 0) values
                (let [id (get (first branches) :pattern-binding-id)]
                  (recur (rest branches) (if (= id nil) values (assoc values id :gravity.type/bool)))))) result)))))))

(defn sh08-bm-error [rule reason node expected actual]
  {:rule rule :reason reason :node node :expected expected :actual actual})

(defn sh08-bm-check [group types functions module]
  (let [node (get group :node) branches (get group :branches)
        scrutinee-id (first (get node :children)) type (get types scrutinee-id :gravity.type/unknown)
        owner (get functions (get (get node :evaluation) :owner-function-syntax-id))
        declared (if (= (get owner :body-core-node-id) (get node :node-id))
                   (get (get (get owner :signature) :return) :type-id) nil)]
    (if (= type :gravity.type/bool)
      (if (contains? group :unsupported-pattern)
        (let [pattern (get group :unsupported-pattern)]
          {:diagnostic (sh08-bm-error (if (contains? pattern :guard) "C7-ANNOTATION" "L7-PATTERN-TYPE")
                         :unsupported-boolean-pattern
                         (sh08-bm-source-node node (get (get group :forms) (get pattern :pattern-form-id)))
                         :boolean-root-pattern (get pattern :pattern-kind))})
      (loop [remaining branches domain [true false] result-type :gravity.type/unknown facts []]
        (if (= (count remaining) 0)
          (if (= (count domain) 0) {:constraints facts :type result-type}
            {:diagnostic (sh08-bm-error (if (= :formal (get module :profile)) "L7-NONEXHAUSTIVE" "C7-ANNOTATION")
                           (if (= :formal (get module :profile)) :nonexhaustive-boolean-match :unsupported-partial-boolean-match)
                           node :exhaustive-boolean-match domain)})
          (let [branch (first remaining) kind (get branch :pattern-kind) value (get branch :pattern-value)
                pattern-node (sh08-bm-source-node node (get (get group :forms) (get branch :pattern-form-id)))
                allowed (if (= kind :literal) (if (contains? #{true false} value) [value] []) domain)
                selected (loop [ds domain values []]
                           (if (= (count ds) 0) values
                             (recur (rest ds) (if (contains? (set allowed) (first ds)) (conj values (first ds)) values))))
                residual (loop [ds domain values []]
                           (if (= (count ds) 0) values
                             (recur (rest ds) (if (contains? (set selected) (first ds)) values (conj values (first ds))))))
                body-id (get branch :branch-core-node-id) body-type (get types body-id :gravity.type/unknown)
                expected (if (= declared nil) result-type declared)]
            (if (if (= kind :literal) (= (count allowed) 0) false)
              {:diagnostic (sh08-bm-error "L7-PATTERN-TYPE" :boolean-pattern-type-mismatch pattern-node :gravity.type/bool value)}
              (if (= (count selected) 0)
                {:diagnostic (sh08-bm-error "L7-UNREACHABLE" :unreachable-boolean-match-clause pattern-node :remaining-boolean-case value)}
                (if (sh08-ft-known? body-type)
                  (if (if (sh08-ft-known? expected)
                        (if (= body-type :gravity.type/never) true
                          (if (if (= declared nil) (= expected :gravity.type/never) false) true (= expected body-type))) true)
                    (recur (rest remaining) residual
                      (if (= result-type :gravity.type/unknown) body-type
                        (sh08-ft-normal-return-type :alternatives [result-type body-type] :gravity.type/unknown))
                      (conj facts
                        {:constraint-id-request {:domain :gravity/sh08-boolean-match-constraint-v1
                           :match-core-node-id (get node :node-id) :clause-ordinal (get branch :clause-ordinal)
                           :branch branch :pattern (get (get group :patterns) (get branch :clause-ordinal)) :skeleton (get group :skeleton)}
                         :kind :equality :producer-rule :sh08-boolean-match-v1
                         :lhs body-id :rhs body-type :scrutinee-type type
                         :remaining-before domain :matched-values selected :remaining-after residual
                         :pattern-binding-id (get branch :pattern-binding-id)
                         :pattern-binding-scope-id (get branch :pattern-binding-scope-id)
                         :binding-type (if (= kind :binding) :gravity.type/bool nil)
                         :exhaustive-after? (= (count residual) 0)
                         :source (get pattern-node :source)
                         :branch-source (get (get (get group :nodes) body-id) :source)
                         :dependencies [scrutinee-id body-id] :invalidation [:c6-match-products :scrutinee-type :branch-types :binding-scopes]
                         :profile (get module :profile) :target (get module :target)
                         :status :solved :diagnostics []}))
                    {:diagnostic (sh08-bm-error (if (= declared nil) "C7-ANNOTATION" "C7-TYPE-MISMATCH")
                                     (if (= declared nil) :unsupported-heterogeneous-boolean-match-join :boolean-match-branch-type-mismatch)
                                     (get (get group :nodes) body-id) expected body-type)})
                  {:diagnostic (sh08-bm-error "C7-ANNOTATION" :unknown-boolean-match-branch-type pattern-node :established-branch-type body-type)})))))))
      {:diagnostic (sh08-bm-error "C7-ANNOTATION" :unsupported-boolean-match-scrutinee node :gravity.type/bool type)})))

(defn sh08-bm-checks [groups types functions module]
  (loop [remaining groups constraints [] diagnostics [] work 0]
    (if (= (count remaining) 0) {:constraints constraints :diagnostics diagnostics :call-join-work work}
      (let [group (assoc (first remaining) :shape-call-context
                        (assoc (get (first remaining) :shape-call-context {}) :budget-left
                               (- (get (get (first remaining) :shape-call-context) :budget-left 0) work)))
            type (get types (first (get (get group :node) :children)) :gravity.type/unknown)
            checked (if (sh08-sm-applicable? group type)
                      (sh08-sm-check group types functions module)
                      (sh08-bm-check group types functions module))]
        (recur (rest remaining) (sh08-ft-add-values-to-set (get checked :constraints) constraints)
               (if (contains? checked :diagnostic) (conj diagnostics (get checked :diagnostic)) diagnostics)
               (+ work (get checked :call-join-work 0)))))))

; L7/C7 constructor-linked structural evidence. Collection source-value is
; syntax data, never a value evaluator or evidence for an extracted field.
(defn sh08-sm-failure [rule reason record expected actual]
  {:status :rejected :rule rule :reason reason :record record :expected expected :actual actual})

(defn sh08-gd-branch-ids [node]
  (let [indexes (get (get node :attributes) :branch-child-indexes) children (get node :children)]
    (if (vector? indexes)
      (loop [remaining indexes ids []]
        (if (= (count remaining) 0) ids
          (let [index (first remaining)]
            (if (integer? index)
              (if (if (> index 0) (< index (count children)) false)
                (recur (rest remaining) (conj ids (get children index))) []) [])))) [])))

(defn sh08-gd-source [guard]
  (sh08-bm-project guard [:rule-version :source-child-index :form-id :syntax-id]))

(defn sh08-gd-clause [source index region]
  (assoc source :child-index index :conditional-region region :evaluation :once-after-structural-success
                :on-pattern-failure :next-candidate :on-true :branch-body :on-false :next-candidate
                :non-boolean-type-effect-legality :pending-later-legality))

(defn sh08-gd-values [branches field]
  (loop [remaining branches result []]
    (if (= (count remaining) 0) result
      (recur (rest remaining)
        (if (contains? (first remaining) :guard) (conj result (get (get (first remaining) :guard) field)) result)))))

(defn sh08-gd-source-valid? [record form forms]
  (if (contains? record :guard)
    (let [guard (get record :guard) index (get guard :source-child-index)]
      (if (integer? index)
        (if (if (> index 0) (< index (count (get form :child-form-ids))) false)
          (let [key (get forms (get (get form :child-form-ids) (- index 1)))
                expression (get forms (get (get form :child-form-ids) index))]
            (sh08-ft-all-true?
              [(sh08-ft-record-shape? guard #{:rule-version :source-child-index :form-id :syntax-id})
               (= :sh07-root-map-guard-v1 (get guard :rule-version))
               (= :map (get record :pattern-kind) (get form :kind))
               (= 0 (get record :depth)) (= nil (get record :parent-ordinal))
               (= :keyword (get key :kind)) (= :when (get key :value))
               (integer? (/ (- index 1) 2))
               (= (get key :parent-form-id) (get form :form-id) (get expression :parent-form-id))
               (= (get guard :form-id) (get expression :form-id))
               (= (get guard :syntax-id) (get expression :syntax-id))])) false) false))
    (if (= :map (get form :kind)) (= false (contains? (get form :value) :when)) true)))

(defn sh08-gd-own-tree [nodes body guard]
  (let [tree (sh08-bm-tree nodes body)]
    (if (= guard nil) tree (sh08-ft-add-values-to-set (sh08-bm-tree nodes guard) tree))))

(defn sh08-gd-call-ids [nodes tree]
  (loop [remaining nodes result []]
    (if (= (count remaining) 0) result
      (let [node (first remaining)]
        (recur (rest remaining)
          (if (if (= :call (get node :core-form)) (contains? tree (get node :node-id)) false)
            (conj result (get node :node-id)) result))))))

(defn sh08-gd-branch-valid? [node branch root clause index nodes forms sequence calls]
  (if (contains? branch :guard)
    (let [guard (get branch :guard) source (sh08-gd-source guard)
          expression (get nodes (get guard :node-id))
          source-form (get forms (get source :form-id))
          region {:kind :match-guard :match-syntax-id (get (get node :source) :syntax-id)
                  :clause-ordinal (get branch :clause-ordinal)}
          expected (sh08-gd-clause source index region)
          tree (sh08-bm-tree nodes (get guard :node-id))
          actual-calls (sh08-gd-call-ids sequence tree)
          listed-calls (loop [remaining calls ids []]
                         (if (= (count remaining) 0) ids
                           (recur (rest remaining)
                             (if (contains? tree (get (first remaining) :core-node-id))
                               (conj ids (get (first remaining) :core-node-id)) ids))))]
      (sh08-ft-all-true?
        [(sh08-gd-source-valid? root (get forms (get root :pattern-form-id)) forms)
         (= source (get root :guard)) (= expected (get clause :guard))
         (= guard (assoc expected :node-id (get guard :node-id)))
         (= (get guard :node-id) (get (get node :children) index))
         (= (get expression :node-id) (get guard :node-id))
         (= (get (get expression :source) :form-id) (get source :form-id))
         (= (get (get expression :source) :syntax-id) (get source :syntax-id))
         (if (= :literal (get expression :core-form))
           (if (= (get (get expression :attributes) :literal-kind) (get source-form :kind))
             (= (get (get expression :attributes) :value) (get source-form :value)) false) true)
         (= (get (get expression :evaluation) :region) region)
         (= actual-calls listed-calls)]))
    (if (contains? root :guard) false (= false (contains? clause :guard)))))

(defn sh08-sm-source-children [form forms]
  (let [kind (get form :kind) ids (get form :child-form-ids)]
    (if (contains? #{:map :vector} kind)
      (if (vector? ids)
        (if (if (= kind :map) (sh08-even-count? ids) true)
          (loop [remaining ids coordinate 0 seen #{} result []]
            (if (= (count remaining) 0) {:status :accepted :children result}
              (let [key-form (if (= kind :map) (get forms (first remaining)) nil)
                    child-id (if (= kind :map) (second remaining) (first remaining))
                    child (get forms child-id) key (get key-form :value)]
                (if (if (= kind :map)
                      (sh08-ft-all-true? [(= :keyword (get key-form :kind)) (keyword? key)
                                          (= false (contains? seen key))
                                          (map? (get form :value)) (contains? (get form :value) key)
                                          (= (get child :value) (get (get form :value) key))
                                          (= (get form :form-id) (get key-form :parent-form-id))]) true)
                  (if (if (= (get child :parent-form-id) (get form :form-id))
                        (if (= kind :vector) (= (get child :value) (get (get form :value) coordinate)) true) false)
                    (if (= key :when)
                      (recur (rest (rest remaining)) (+ coordinate 2) (conj seen key) result)
                      (recur (if (= kind :map) (rest (rest remaining)) (rest remaining))
                             (+ coordinate (if (= kind :map) 2 1)) (conj seen key)
                             (conj result {:form-id child-id :coordinate (if (= kind :map) (+ coordinate 1) coordinate)
                                           :key key :key-form-id (get key-form :form-id)})))
                    (sh08-sm-failure "C7-VERIFY" :pattern-child-source-parent nil :exact-parent child-id))
                  (sh08-sm-failure "C7-VERIFY" :pattern-key-source-mismatch nil :unique-source-keyword key)))))
          (sh08-sm-failure "C7-VERIFY" :odd-pattern-map-children nil :even-key-value-children ids))
        (sh08-sm-failure "C7-VERIFY" :malformed-pattern-source-children nil :source-child-vector ids))
      {:status :accepted :children []})))

(defn sh08-sm-pattern-kind-valid? [record form]
  (if (= :map (get record :pattern-kind))
    (sh08-ft-all-true? [(= :map (get form :kind)) (= (get record :pattern-value) (get form :value))
                        (= nil (get record :vector-width) (get record :pattern-binding-id) (get record :pattern-binding-scope-id))])
    (if (= :vector (get record :pattern-kind))
      (if (vector? (get form :child-form-ids))
        (sh08-ft-all-true? [(= :vector (get form :kind)) (= (get record :vector-width) (count (get form :child-form-ids)))
                            (= nil (get record :pattern-value) (get record :pattern-binding-id) (get record :pattern-binding-scope-id))]) false)
      (if (= nil (get record :vector-width))
        (if (= (get record :pattern-value) (sh08-bm-pattern-value form))
          (sh08-bm-source-kind-valid? record form) false) false))))

(defn sh08-sm-pattern-tree [records index root-index parent-index path form-id group bindings sequence]
  (let [record (get records index) root (get records root-index)
        form (get (get group :forms) form-id) node (get group :node)
        binding-id (get record :pattern-binding-id) binding (get bindings binding-id)
        body-id (get group :branch-id) nodes (get group :nodes)
        uses (if (= binding-id nil) [] (sh08-bm-uses sequence (sh08-gd-own-tree nodes body-id (get group :guard-id)) binding-id))
        children (sh08-sm-source-children form (get group :forms))]
    (if (sh08-ft-all-true?
          [(sh08-ft-record-shape? record
             (if (contains? record :guard)
               (conj #{:ordinal :clause-ordinal :local-ordinal :parent-local-ordinal :root-local-ordinal :parent-ordinal :root-ordinal
                       :core-node-id :depth :path :pattern-kind :pattern-form-id :pattern-syntax-id :pattern-value :vector-width
                       :pattern-binding-id :pattern-binding-scope-id :pattern-binding-use-syntax-ids
                       :authenticated-sh06-artifact-id :sh06-semantic-projection-id} :guard)
             #{:ordinal :clause-ordinal :local-ordinal :parent-local-ordinal :root-local-ordinal :parent-ordinal :root-ordinal
               :core-node-id :depth :path :pattern-kind :pattern-form-id :pattern-syntax-id :pattern-value :vector-width
               :pattern-binding-id :pattern-binding-scope-id :pattern-binding-use-syntax-ids
               :authenticated-sh06-artifact-id :sh06-semantic-projection-id}))
           (map? form) (= (get record :pattern-form-id) form-id)
           (= (get record :pattern-syntax-id) (get form :syntax-id))
           (= (get record :core-node-id) (get node :node-id))
           (= (get record :clause-ordinal) (get root :clause-ordinal))
           (= (get record :local-ordinal) (- index root-index)) (= 0 (get record :root-local-ordinal))
           (= (get record :root-ordinal) (get root :ordinal))
           (= (get record :parent-local-ordinal) (if (= parent-index nil) nil (- parent-index root-index)))
           (= (get record :parent-ordinal) (if (= parent-index nil) nil (get (get records parent-index) :ordinal)))
           (= path (get record :path)) (= (count path) (get record :depth))
           (sh08-sm-pattern-kind-valid? record form)
           (sh08-gd-source-valid? record form (get group :forms))
           (= (get record :pattern-binding-use-syntax-ids) uses)
           (if (= binding-id nil) true
             (sh08-ft-all-true?
               [(= uses (sh08-bm-uses sequence (set (keys nodes)) binding-id))
                (= :lexical (get binding :binding-class))
                (= (get binding :definition-syntax-id) (get form :syntax-id))
                (= (get binding :name) (get form :value))
                (= (get binding :scope-id) (get form :scope-id) (get record :pattern-binding-scope-id))]))
           (= (get record :authenticated-sh06-artifact-id) (get (get node :attributes) :authenticated-sh06-artifact-id))
           (= (get record :sh06-semantic-projection-id) (get (get node :attributes) :sh06-semantic-projection-id))])
      (if (= :accepted (get children :status))
        (loop [remaining (get children :children) next-index (+ index 1) trees [] ids (if (= binding-id nil) [] [binding-id])]
          (if (= (count remaining) 0)
            {:status :accepted :next-index next-index :binding-ids ids
             :tree {:record record :form form :children trees}}
            (let [child (first remaining)
                  result (sh08-sm-pattern-tree records next-index root-index index
                           (conj path (get child :coordinate)) (get child :form-id) group bindings sequence)]
              (if (= :accepted (get result :status))
                (recur (rest remaining) (get result :next-index)
                       (conj trees (assoc child :tree (get result :tree)))
                       (sh08-ft-add-values-to-set (get result :binding-ids) ids)) result))))
        (assoc children :record record))
      (sh08-sm-failure "C7-VERIFY" :malformed-structural-pattern-tree record :exact-source-coordinate-binding-join form-id))))

(defn sh08-sm-group [node branches patterns skeleton nodes bindings forms sequence lexical calls]
  (let [attrs (get node :attributes) clauses (get attrs :branch-clauses)
        owner (get forms (get (get node :source) :form-id))
        guard-ids (sh08-gd-values branches :node-id)
        base {:node node :branches branches :patterns patterns :skeleton skeleton :nodes nodes :forms forms :calls calls :node-sequence sequence
              :lexical-bindings lexical :binding-index bindings :structural? true}
        clause-fields [:clause-ordinal :branch-child-index :pattern-kind :pattern-form-id :pattern-syntax-id
                       :pattern-value :branch-form-id :branch-syntax-id :pattern-binding-id :pattern-binding-scope-id :pattern-binding-ids]]
    (if (if (vector? clauses)
          (if (vector? (get skeleton :branch-core-node-ids))
            (sh08-ft-all-true? [(sh08-ft-record-shape? skeleton
                                 #{:core-node-id :scrutinee-core-node-id :branch-core-node-ids :selection-policy :runtime-reachability
                                   :result-type-join :exhaustiveness :authenticated-sh06-artifact-id :sh06-semantic-projection-id})
                               (sh08-ft-record-shape? attrs
                                 (if (> (count guard-ids) 0)
                                   #{:scrutinee-child-index :branch-count :branch-child-indexes :branch-clauses :evaluation-order
                                     :selection-policy :runtime-reachability :result-type-join :exhaustiveness
                                     :authenticated-sh06-artifact-id :sh06-semantic-projection-id :guard-rule-version :guard-child-indexes}
                                 #{:scrutinee-child-index :branch-count :branch-child-indexes :branch-clauses :evaluation-order
                                   :selection-policy :runtime-reachability :result-type-join :exhaustiveness
                                   :authenticated-sh06-artifact-id :sh06-semantic-projection-id}))
                               (> (count branches) 0) (= (count branches) (count clauses) (get attrs :branch-count))
                                (= (get node :children) (sh08-ft-add-values-to-set guard-ids
                                   (sh08-ft-add-values-to-set (get skeleton :branch-core-node-ids) [(first (get node :children))])))
                                (sh08-all-unique? (get node :children) [])
                                (if (> (count guard-ids) 0)
                                  (if (= :sh07-root-map-guard-v1 (get attrs :guard-rule-version) (get node :lowering-rule-version))
                                    (= (get attrs :guard-child-indexes) (sh08-gd-values branches :child-index)) false) true)
                                (= (get skeleton :core-node-id) (get node :node-id))
                                (= (get skeleton :scrutinee-core-node-id) (first (get node :children)))
                                (= (get skeleton :authenticated-sh06-artifact-id) (get attrs :authenticated-sh06-artifact-id))
                                (= (get skeleton :sh06-semantic-projection-id) (get attrs :sh06-semantic-projection-id))
                                (= 0 (get attrs :scrutinee-child-index))
                                (= :source-ordered-pattern-candidates (get attrs :selection-policy) (get skeleton :selection-policy))
                                (= :not-asserted-by-sh07-b11 (get attrs :runtime-reachability) (get skeleton :runtime-reachability))
                                (= :pending-sh08 (get attrs :exhaustiveness) (get skeleton :exhaustiveness)
                                   (get attrs :result-type-join) (get skeleton :result-type-join))
                                (= :scrutinee-then-source-ordered-pattern-candidates (get attrs :evaluation-order)
                                   (get (get node :evaluation) :kind))
                                (= [{:index 0 :core-node-id (first (get node :children))}] (get (get node :evaluation) :order))]) false) false)
      (loop [remaining branches ordinal 0 pattern-index 0 trees [] ids [] indexes [] guard-index (+ (count branches) 1)]
        (if (= (count remaining) 0)
          (if (sh08-ft-all-true? [(= pattern-index (count patterns))
                                  (= ids (get node :resolved-binding-ids)) (= indexes (get attrs :branch-child-indexes))])
            (assoc base :status :accepted :pattern-trees trees)
            (sh08-sm-failure "C7-VERIFY" :incomplete-structural-pattern-products nil :complete-ordered-pattern-tree pattern-index))
          (let [branch (first remaining) root (get patterns pattern-index)
                body (get nodes (get branch :branch-core-node-id))
                region {:kind :match-branch :match-syntax-id (get (get node :source) :syntax-id) :clause-ordinal ordinal}
                result (sh08-sm-pattern-tree patterns pattern-index pattern-index nil [] (get branch :pattern-form-id)
                                             (assoc base :branch-id (get body :node-id) :guard-id (get (get branch :guard) :node-id)) bindings sequence)]
            (if (= :accepted (get result :status))
              (if (sh08-ft-all-true?
                    [(sh08-ft-record-shape? branch
                       (if (contains? branch :guard)
                         #{:ordinal :clause-ordinal :clause-count :core-node-id :scrutinee-core-node-id :branch-core-node-id
                           :branch-child-index :pattern-kind :pattern-form-id :pattern-syntax-id :pattern-value :branch-form-id
                           :branch-syntax-id :pattern-binding-id :pattern-binding-scope-id :pattern-binding-ids
                           :pattern-binding-use-syntax-ids :conditional-region :scrutinee-evaluation :branch-evaluation
                           :authenticated-sh06-artifact-id :sh06-semantic-projection-id :guard}
                       #{:ordinal :clause-ordinal :clause-count :core-node-id :scrutinee-core-node-id :branch-core-node-id
                         :branch-child-index :pattern-kind :pattern-form-id :pattern-syntax-id :pattern-value :branch-form-id
                         :branch-syntax-id :pattern-binding-id :pattern-binding-scope-id :pattern-binding-ids
                         :pattern-binding-use-syntax-ids :conditional-region :scrutinee-evaluation :branch-evaluation
                         :authenticated-sh06-artifact-id :sh06-semantic-projection-id}))
                     (= (if (contains? branch :guard)
                          (assoc (sh08-bm-project branch clause-fields) :guard (get (get clauses ordinal) :guard))
                          (sh08-bm-project branch clause-fields)) (get clauses ordinal))
                     (sh08-gd-branch-valid? node branch root (get clauses ordinal) guard-index nodes forms sequence calls)
                     (= (get branch :clause-ordinal) ordinal (get root :clause-ordinal))
                     (= (get branch :clause-count) (count branches)) (= (get branch :branch-child-index) (+ ordinal 1))
                     (= (get branch :core-node-id) (get node :node-id))
                     (= (get branch :scrutinee-core-node-id) (first (get node :children)))
                     (= (get branch :branch-core-node-id) (get (get node :children) (+ ordinal 1)))
                     (= (get branch :pattern-form-id) (get (get owner :child-form-ids) (+ 2 (* 2 ordinal))))
                     (= (get branch :branch-form-id) (get (get owner :child-form-ids) (+ 3 (* 2 ordinal))) (get (get body :source) :form-id))
                     (= (get branch :branch-syntax-id) (get (get body :source) :syntax-id))
                     (= (get branch :pattern-syntax-id) (get root :pattern-syntax-id))
                     (= (get branch :pattern-kind) (get root :pattern-kind))
                     (= (get branch :pattern-value)
                        (sh08-bm-pattern-value (get forms (get root :pattern-form-id))))
                     (= (get branch :pattern-binding-id) (get root :pattern-binding-id))
                     (= (get branch :pattern-binding-scope-id) (get root :pattern-binding-scope-id))
                     (= (get branch :pattern-binding-use-syntax-ids) (get root :pattern-binding-use-syntax-ids))
                     (= (get branch :pattern-binding-ids) (get result :binding-ids))
                     (= region (get branch :conditional-region) (get (get body :evaluation) :region))
                     (= :evaluate-scrutinee-once (get branch :scrutinee-evaluation))
                     (= :conditionally-evaluate-selected-branch (get branch :branch-evaluation))
                     (= (get branch :authenticated-sh06-artifact-id) (get attrs :authenticated-sh06-artifact-id))
                     (= (get branch :sh06-semantic-projection-id) (get attrs :sh06-semantic-projection-id))])
                (recur (rest remaining) (+ ordinal 1) (get result :next-index) (conj trees (get result :tree))
                       (sh08-ft-add-values-to-set (get result :binding-ids) ids) (conj indexes (+ ordinal 1))
                       (if (contains? branch :guard) (+ guard-index 1) guard-index))
                (sh08-sm-failure "C7-VERIFY" :malformed-structural-branch-products root :exact-clause-branch-join branch)) result))))
      (sh08-sm-failure "C7-VERIFY" :malformed-structural-decision-products nil :exact-match-skeleton skeleton))))

(defn sh08-sm-let-link-valid? [record node nodes bindings forms]
  (let [owner (get nodes (get record :let-core-node-id))
        initializer (get nodes (get record :initializer-node-id))
        binding (get bindings (get record :binding-id))
        binding-form (get forms (get record :definition-form-id))
        initializer-form (get forms (get record :initializer-form-id))
        vector-form (get forms (get (get owner :attributes) :binding-vector-form-id))
        owner-form (get forms (get (get owner :source) :form-id))
        index (get record :ordinal)]
    (if (integer? index)
      (sh08-ft-all-true?
        [(= :immutable (get record :mutability)) (= :let (get owner :core-form))
         (= (get node :resolved-binding-ids) [(get record :binding-id)])
         (= (get (get node :attributes) :binding-id) (get record :binding-id))
         (= (get (get owner :children) index) (get record :initializer-node-id))
         (= (get (get owner :resolved-binding-ids) index) (get record :binding-id))
         (= :vector (get vector-form :kind))
         (= (get vector-form :form-id) (get (get owner-form :child-form-ids) 1))
         (= (get vector-form :parent-form-id) (get owner-form :form-id))
         (= (get vector-form :syntax-id) (get (get owner :attributes) :binding-vector-syntax-id))
         (= (get (get vector-form :child-form-ids) (* 2 index)) (get record :definition-form-id))
         (= (get (get vector-form :child-form-ids) (+ 1 (* 2 index))) (get record :initializer-form-id))
         (= (get record :initializer-form-id) (get (get initializer :source) :form-id) (get initializer-form :form-id))
         (= (get record :initializer-syntax-id) (get (get initializer :source) :syntax-id) (get initializer-form :syntax-id))
         (= (get record :initializer-scope-id) (get initializer-form :scope-id))
         (= (get record :definition-syntax-id) (get binding :definition-syntax-id) (get binding-form :syntax-id))
         (= (get record :name) (get binding :name) (get binding-form :value))
         (= (get record :binding-scope-id) (get binding :scope-id) (get binding-form :scope-id))
         (= :lexical (get binding :binding-class))]) false)))

(defn sh08-sm-shape [id nodes types binding-types functions lexical bindings forms seen depth]
  (sh08-sm-shape-with-bindings id nodes types binding-types functions lexical bindings forms seen depth {} {}))

(defn sh08-sm-call-context [products prior budget]
  (let [calls (get products :calls []) edges (get products :call-edges []) definitions (get products :definitions [])
        work (+ (count calls) (count edges) (count definitions))]
    (if (> work budget)
      (assoc (sh08-sm-failure "C7-GENERIC" :structural-call-index-work-limit nil :remaining-type-join-units budget) :work-count work)
      (let [call-index (sh08-ft-index calls :core-node-id) edge-index (sh08-ft-index edges :call-core-node-id)
            definition-index (sh08-ft-index definitions :binding-id)]
        (if (sh08-ft-all-true? [(= (count calls) (count call-index)) (= (count edges) (count edge-index))
                                (= (count definitions) (count definition-index))])
          {:status :accepted :work-count work :budget-left (- budget work) :prior-types prior
           :calls call-index :edges edge-index :definition-index definition-index :definitions definitions
           :function-records (get products :function-index) :recursion-components (get products :recursion-components [])
           :module (get products :module)}
          (assoc (sh08-sm-failure "C7-VERIFY" :duplicate-structural-call-record nil :unique-call-edge-definition-ids nil) :work-count work))))))

(defn sh08-sm-call-shape [node nodes types binding-types functions lexical bindings forms seen depth binding-shapes context]
  (let [id (get node :node-id) call (get (get context :calls) id) edge (get (get context :edges) id)
        records (get context :function-records) record (get records (get edge :callee-function-syntax-id))
        definition (get (get context :definition-index) (get edge :callee-binding-id))
        binding (get bindings (get edge :callee-binding-id)) operator (get nodes (get call :operator-node-id))
        operator-form (get forms (get (get operator :source) :form-id))
        function-node (get nodes (get record :function-core-node-id)) body (get nodes (get record :body-core-node-id))
        owner (get forms (get (get node :source) :form-id)) ids (get owner :child-form-ids)
        function-form (get forms (get (get function-node :source) :form-id))
        definition-form (get forms (get (get (get nodes (get definition :core-node-id)) :source) :form-id))
        name-form (get forms (get (get definition-form :child-form-ids) 1))
        body-form (get forms (get (get function-form :child-form-ids) (get (get record :signature) :body-source-child-index 2)))
        type (get types id (get (get context :prior-types) id :gravity.type/unknown))
        body-type (get types (get body :node-id) (get (get context :prior-types) (get body :node-id) :gravity.type/unknown))
        return-type (get (get functions (get record :function-syntax-id)) :return :gravity.type/unknown)
        work (+ 64 (count (get context :definitions)) (count (get node :children)) (count (get context :recursion-components)))]
    (if (> work (get context :budget-left 0))
      (assoc (sh08-sm-failure "C7-GENERIC" :structural-call-join-work-limit nil :remaining-type-join-units (get context :budget-left 0)) :call-join-work work)
    (let [recursive? (loop [components (get context :recursion-components)]
                     (if (= 0 (count components)) false
                       (let [ids (set (get (first components) :function-syntax-ids))]
                         (if (if (contains? ids (get edge :callee-function-syntax-id)) true
                               (contains? ids (get edge :caller-function-syntax-id))) true (recur (rest components))))))]
    (if (= :nonlocal-or-nonfunction (get edge :classification))
      (assoc (sh08-sm-failure "C7-ANNOTATION" :unsupported-nonlocal-return-shape nil :same-module-direct-call id) :call-join-work work)
    (if recursive?
      (assoc (sh08-sm-failure "C7-ANNOTATION" :unsupported-recursive-return-shape nil :acyclic-local-constructor-return id) :call-join-work work)
    (if (sh08-ft-all-true?
          [(= :accepted (get context :status)) (= :local-function (get edge :classification))
           (= id (get call :core-node-id) (get edge :call-core-node-id))
           (= (get record :function-syntax-id) (get edge :callee-function-syntax-id))
           (sh08-ft-call-valid? call nodes bindings)
           (sh08-ft-call-edge-valid? edge call records (get context :definitions) nodes)
           (sh08-ft-definition-valid? definition nodes bindings)
           (sh08-ft-function-record-valid? record nodes (get context :definitions) bindings)
           (= :namespace (get binding :binding-class)) (= :function (get binding :kind))
           (= (get (get context :module) :namespace) (get binding :namespace))
           (= :reference (get operator :core-form)) (= [] (get operator :children))
           (= :symbol (get operator-form :kind))
           (= (get operator-form :value) (get (get operator :attributes) :symbol))
           (if (symbol? (get operator-form :value))
             (if (= (get binding :name) (get operator-form :value)) true
               (= (str (get binding :namespace) "/" (get binding :name)) (str (get operator-form :value)))) false)
           (= (get call :operator-binding-id) (get (get operator :attributes) :binding-id))
           (= (get binding :definition-syntax-id) (get (get operator :attributes) :definition-syntax-id) (get name-form :syntax-id))
           (= (get binding :name) (get definition :name) (get record :definition-name) (get name-form :value))
           (= :list (get owner :kind)) (vector? ids) (= (count ids) (count (get node :children)))
           (= (get owner :syntax-id) (get (get node :source) :syntax-id))
           (= :operator-then-arguments (get (get node :evaluation) :kind))
           (= (get call :ordered-evaluation-node-ids) (get node :children))
           (= (get record :fixed-arity) (count (get call :argument-node-ids)))
           (= (get record :function-form-id) (get function-form :form-id) (get (get definition-form :child-form-ids) 2))
           (= (get function-form :syntax-id) (get record :function-syntax-id))
           (= (get (get body :source) :form-id) (get body-form :form-id))
           (= (get (get body :source) :syntax-id) (get body-form :syntax-id))
           (= (get function-form :form-id) (get body-form :parent-form-id))
           (= type return-type body-type) (sh08-ft-known? type)
           (loop [index 0]
             (if (= index (count ids)) true
               (let [child (get nodes (get (get node :children) index)) form (get forms (get ids index))]
                 (if (sh08-ft-all-true? [(= (get owner :form-id) (get form :parent-form-id))
                       (= (get ids index) (get (get child :source) :form-id))
                       (= (get form :syntax-id) (get (get child :source) :syntax-id))
                       (= {:index index :core-node-id (get child :node-id)} (get (get (get node :evaluation) :order) index))])
                   (recur (+ index 1)) false))))])
      (let [shape (sh08-sm-shape-with-bindings (get body :node-id) nodes types binding-types functions lexical bindings forms
                                             (conj seen id) (+ depth 1) binding-shapes (assoc context :budget-left (- (get context :budget-left) work)))
            used (+ work (get shape :call-join-work 0))]
        (if (= :accepted (get shape :status))
          (if (if (map? (get context :vector-coordinate-demand))
                (sh08-vn-projected? shape (get context :vector-coordinate-demand))
                (contains? #{:map :vector} (get shape :shape-kind)))
            (if (< (get shape :shape-size) (get (sh08-local-bounds-value) :maximum-core-nodes))
              (assoc shape :call-join-work used :shape-size (+ 1 (get shape :shape-size))
                :call-links (conj (get shape :call-links []) {:call call :edge edge :definition definition :function-record record
                                                           :operator-binding (sh08-bm-project binding [:binding-id :name :namespace :kind :binding-class :definition-syntax-id])
                                                           :body-source (get body :source)
                                                           :call-type type :body-type body-type :return-type return-type}))
              (assoc (sh08-sm-failure "C7-ANNOTATION" :structural-shape-node-limit nil :bounded-expanded-shape (get shape :shape-size)) :call-join-work used))
            (assoc (sh08-sm-failure "C7-ANNOTATION" :unestablished-structural-return-shape nil :constructor-quote-or-let-return (get shape :shape-kind)) :call-join-work used))
          (assoc shape :call-join-work used)))
      (assoc (sh08-sm-failure "C7-VERIFY" :structural-call-source-or-type-mismatch nil :exact-local-call-body-source-type-join id) :call-join-work work))))))))

(defn sh08-sm-merge-origins [left right]
  (loop [ids (keys right) result left]
    (if (= (count ids) 0) result
      (let [id (first ids)]
        (if (if (contains? result id) (= (get result id) (get right id)) true)
          (recur (rest ids) (assoc result id (get right id))) nil)))))

(defn sh08-sm-shape-cases [shape]
  (sh08-sm-shape-cases-with-origins shape {}))

(defn sh08-sm-shape-cases-with-origins [shape inherited]
  (let [origins (sh08-sm-merge-origins inherited (get shape :case-origins {}))]
  (if (= origins nil) []
  (if (= :alternatives (get shape :shape-kind))
    (loop [remaining (get shape :alternatives) result []]
      (if (= (count remaining) 0) result
        (recur (rest remaining) (sh08-ft-add-values-to-set (sh08-sm-shape-cases-with-origins (first remaining) origins) result))))
    [(if (= (count origins) 0) shape (assoc shape :case-origins origins))]))))

(defn sh08-sm-construct-cases [shape]
  (loop [parts (get shape :parts) cases [(assoc shape :parts [] :case-origins {})] expanded? false]
    (if (= (count parts) 0)
      (if expanded?
        (assoc shape :shape-kind :alternatives :alternatives cases)
        shape)
      (let [part (first parts) values (sh08-sm-shape-cases (get part :shape))
            product (loop [remaining cases result []]
                      (if (= (count remaining) 0) {:status :accepted :cases result}
                        (let [case (first remaining)
                              joined (loop [choices values out result]
                                       (if (> (count out) (get (sh08-local-bounds-value) :maximum-node-children))
                                         (sh08-sm-failure "C7-ANNOTATION" :structural-match-residual-limit nil :bounded-correlated-constructor-product (count out))
                                         (if (= (count choices) 0) {:status :accepted :cases out}
                                           (let [value (first choices)
                                                 origins (sh08-sm-merge-origins (get case :case-origins {}) (get value :case-origins {}))]
                                             (recur (rest choices)
                                               (if (map? origins)
                                                 (conj out (assoc case :parts (conj (get case :parts) (assoc part :shape value))
                                                                      :case-origins origins)) out))))))]
                          (if (= :accepted (get joined :status))
                            (recur (rest remaining) (get joined :cases)) joined))))]
        (if (= :accepted (get product :status))
          (recur (rest parts) (get product :cases)
                 (if (= :alternatives (get (get part :shape) :shape-kind)) true expanded?)) product)))))

(defn sh08-kl-source-valid? [node nodes types forms]
  (let [children (get node :children) attrs (get node :attributes)
        owner (get forms (get (get node :source) :form-id)) ids (get owner :child-form-ids)
        key-node (get nodes (get children 0)) operand (get nodes (get children 1))
        key-form (get forms (get ids 0)) operand-form (get forms (get ids 1)) key (get attrs :keyword)]
    (if (if (vector? children) (if (= 2 (count children))
          (if (vector? ids) (if (= 2 (count ids)) (keyword? key) false) false) false) false)
      (sh08-ft-all-true?
        [(= :keyword-map-lookup (get node :core-form)) (= [] (get node :resolved-binding-ids))
         (sh08-ft-record-shape? attrs #{:keyword-child-index :map-child-index :keyword :evaluation-order :dispatch
                                      :missing-key-policy :result-policy :target-type-legality})
         (= :list (get owner :kind)) (= (get owner :form-id) (get (get node :source) :form-id))
         (= (get owner :syntax-id) (get (get node :source) :syntax-id))
         (= :literal (get key-node :core-form)) (= [] (get key-node :children))
         (= :keyword (get key-form :kind) (get (get key-node :attributes) :literal-kind))
         (= key (get key-form :value) (get (get key-node :attributes) :value))
         (= :gravity.type/keyword (get types (get key-node :node-id)))
         (= (get ids 0) (get (get key-node :source) :form-id))
         (= (get ids 1) (get (get operand :source) :form-id))
         (= (get key-form :syntax-id) (get (get key-node :source) :syntax-id))
         (= (get operand-form :syntax-id) (get (get operand :source) :syntax-id))
         (= (get owner :form-id) (get key-form :parent-form-id) (get operand-form :parent-form-id))
         (= 0 (get attrs :keyword-child-index)) (= 1 (get attrs :map-child-index))
         (= :keyword-map-lookup (get attrs :dispatch)) (= :nil (get attrs :missing-key-policy))
         (= :map-value-or-nil (get attrs :result-policy)) (= :pending-sh08 (get attrs :target-type-legality))
         (= :keyword-then-map (get attrs :evaluation-order) (get (get node :evaluation) :kind))
         (= [{:index 0 :core-node-id (first children)} {:index 1 :core-node-id (second children)}]
            (get (get node :evaluation) :order))]) false)))

(defn sh08-kl-shape [node nodes types binding-types functions lexical bindings forms seen depth binding-shapes call-context]
  (let [operand-id (second (get node :children)) key (get (get node :attributes) :keyword)]
    (if (sh08-kl-source-valid? node nodes types forms)
      (if (= :gravity.type/never (get types operand-id))
        {:status :accepted :presence :no-normal-result :shape nil :operand-shape nil :selected-coordinate nil
         :type :gravity.type/never :extracted-evidence-size 0}
        (if (let [type (get types operand-id)]
              (if (sh08-ft-known? type) (= false (= :gravity.type/map (if (map? type) (get type :kind) type))) false))
          (sh08-sm-failure "C7-ANNOTATION" :keyword-lookup-map-shape-required nil :constructor-or-quoted-map-shape (get types operand-id))
        (let [operand (sh08-sm-shape-with-bindings operand-id nodes types binding-types functions lexical bindings forms
                                                 (conj seen (get node :node-id)) (+ depth 1) binding-shapes call-context)]
          (if (= :accepted (get operand :status))
            (if (= :map (get operand :shape-kind))
              (let [index (sh08-sm-part-index operand key nil) part (get (get operand :parts) index)
                    selected (if (= index nil)
                               {:status :accepted :shape-kind :scalar :type :gravity.type/nil :domain {:values [nil]}
                                :shape-size 1 :node-id (get node :node-id) :source (get node :source) :binding-links []}
                               (get part :shape))
                    selected (assoc selected :call-links (sh08-ft-add-values-to-set (get operand :call-links []) (get selected :call-links [])))]
                {:status :accepted :presence (if (= index nil) :absent :present) :shape selected
                 :operand-shape operand :selected-coordinate (get part :coordinate) :type (get selected :type)
                 :extracted-evidence-size (get selected :shape-size 1) :call-join-work (get operand :call-join-work 0)})
              (sh08-sm-failure "C7-ANNOTATION" :keyword-lookup-map-shape-required nil :constructor-or-quoted-map-shape (get operand :type))) operand))))
      (sh08-sm-failure "C7-VERIFY" :keyword-lookup-source-mismatch nil :exact-keyword-operand-source-order (get node :node-id)))))

(defn sh08-kl-step [node types binding-types functions context budget]
  ; Logical outer joins and extracted evidence share the inference counter.
  ; These are not recursive visits inside the separately bounded shape helper.
  (let [core (get context :lookup-core) nodes (get context :lookup-nodes) source-forms (get context :lookup-forms)
        source-bindings (get context :lookup-bindings)
        records (get core :keyword-lookups []) lexical (get core :lexical-bindings [])
        initial (+ 32 (count records) (count source-forms) (count source-bindings) (count nodes) (count lexical))]
    (if (< budget initial)
      (assoc (sh08-sm-failure "C7-GENERIC" :keyword-lookup-type-work-limit nil :remaining-type-join-units budget) :work-count initial)
      (let [forms (if (map? source-forms) source-forms (sh08-ft-index source-forms :form-id))
            bindings (if (map? source-bindings) source-bindings (sh08-ft-binding-index source-bindings))
            matches (sh08-bm-select records :core-node-id (get node :node-id)) record (first matches)
            expected {:core-node-id (get node :node-id) :keyword-node-id (first (get node :children))
                      :map-node-id (second (get node :children)) :keyword (get (get node :attributes) :keyword)
                      :ordered-evaluation-node-ids (get node :children) :evaluation-order :keyword-then-map
                      :missing-key-policy :nil :result-policy :map-value-or-nil}
            result (if (if (= 1 (count matches)) (= expected record) false)
                     (sh08-kl-shape node nodes types binding-types functions lexical bindings forms #{} 0
                                    (get context :prior-binding-shapes {})
                                    (assoc (get context :shape-call-context {}) :budget-left (- budget initial)))
                     (sh08-sm-failure "C7-VERIFY" :keyword-lookup-record-mismatch nil :exact-c6-lookup-record record))
            work (+ initial (get result :extracted-evidence-size 0) (get result :call-join-work 0))]
        (if (> work budget)
          (assoc (sh08-sm-failure "C7-GENERIC" :keyword-lookup-type-work-limit nil :remaining-type-join-units budget) :work-count work)
          (if (= :accepted (get result :status))
            (let [type (get result :type) source (get node :source)
                  premise {:source source :lookup-record record :keyword-node-id (first (get node :children))
                           :operand-node-id (second (get node :children)) :operand-shape (get result :operand-shape)
                           :selected-shape (get result :shape) :presence (get result :presence)
                           :selected-coordinate (get result :selected-coordinate)}
                  solution {:result-type type :presence (get result :presence) :selected-coordinate (get result :selected-coordinate)}]
              {:status :accepted :type type :work-count work
               :constraint {:constraint-id-request {:domain :gravity/sh08-keyword-map-lookup-v1 :core-node-id (get node :node-id) :premise premise}
                            :kind :equality :producer-rule :sh08-keyword-map-lookup-v1 :lhs (get node :node-id) :rhs type
                            :origin (get source :origin-chain) :dependencies premise :solution solution
                            :invalidation [:keyword-lookups :source-forms :type-table :lexical-bindings :constructor-or-quote-shape :evaluation-order
                                           :calls :call-edges :definitions :function-records :callee-body :binding-table]
                            :profile (get (get core :module) :profile) :target (get (get core :module) :target)
                            :status :solved :diagnostics []}})
            (assoc result :work-count work)))))))

(defn sh08-ma-form-source [form]
  {:form-id (get form :form-id) :syntax-id (get form :syntax-id) :semantic-span (get form :source-span)
   :origin-chain (get form :origin-chain) :generated-origin (get form :generated-origin)})

(defn sh08-ma-binding? [binding module]
  (if (if (vector? (get binding :profile-set)) (vector? (get binding :target-set)) false)
  (sh08-ft-all-true?
    [(= ['assoc :core :var 'gravity.core {:name 'gravity/core :version "bootstrap-contract-v1"} :gravity.type/core-var :safe]
        [(get binding :name) (get binding :binding-class) (get binding :kind) (get binding :namespace)
         (get binding :package) (get binding :type-ref) (get binding :safety)])
     (= [] (get binding :effects) (get binding :capabilities))
     (contains? (set (get binding :profile-set)) (get module :profile))
     (contains? (set (get binding :target-set)) :all)]) false))

(defn sh08-ma-source [core node call edge nodes bindings types module]
  (if (if (vector? (get call :argument-node-ids)) (vector? (get node :children)) false)
  (let [children (get node :children) operator (get nodes (get call :operator-node-id))
        bid (get call :operator-binding-id) binding (get bindings bid) args (get call :argument-node-ids)
        arguments (sh08-ft-ordered-child-types args types)
        key-node (get nodes (get args 1))
        invoked? (loop [remaining arguments]
                   (if (= 0 (count remaining)) true
                     (if (= :gravity.type/never (first remaining)) false (recur (rest remaining)))))
        caller (loop [remaining (get core :function-records)]
                 (if (= 0 (count remaining)) nil
                   (if (= (get (first remaining) :function-syntax-id) (get (get node :evaluation) :owner-function-syntax-id))
                     (first remaining) (recur (rest remaining)))))
        expected-call {:core-node-id (get node :node-id) :operator-node-id (first children) :operator-binding-id bid
                       :argument-node-ids (vec (rest children)) :ordered-evaluation-node-ids children
                       :evaluation-order :operator-then-arguments :result-policy :call-result}
        expected-edge {:ordinal (get edge :ordinal) :call-core-node-id (get node :node-id)
                       :caller-function-syntax-id (get caller :function-syntax-id) :caller-function-core-node-id (get caller :function-core-node-id)
                       :callee-binding-id bid :callee-definition-syntax-id (get binding :definition-syntax-id)
                       :callee-function-syntax-id nil :callee-function-core-node-id nil :argument-core-node-ids args
                       :ordered-evaluation-node-ids children :evaluation-order :operator-then-arguments :classification :nonlocal-or-nonfunction}]
    (if (sh08-ft-all-true?
          [(= :call (get node :core-form)) (= :reference (get operator :core-form))
           (= 3 (count args)) (= expected-call call) (= expected-edge edge) (sh08-ma-binding? binding module)
           (= [bid] (get node :resolved-binding-ids) (get operator :resolved-binding-ids))
           (= {:symbol (get (get operator :attributes) :symbol) :position :operator :binding-id bid :binding-class :core
               :definition-syntax-id (get binding :definition-syntax-id)} (get operator :attributes))
           (contains? '#{assoc gravity.core/assoc} (get (get operator :attributes) :symbol))
           (= :operator-then-arguments (get (get node :evaluation) :kind))
           (= (loop [i 0 out []] (if (= i (count children)) out
                (recur (+ i 1) (conj out {:index i :core-node-id (get children i)})))) (get (get node :evaluation) :order))
           (= :literal (get key-node :core-form)) (= [] (get key-node :children))
           (= :keyword (get (get key-node :attributes) :literal-kind)) (keyword? (get (get key-node :attributes) :value))
           (= :gravity.type/keyword (get arguments 1))
           (loop [remaining arguments]
             (if (= 0 (count remaining)) true
               (if (contains? #{nil :gravity.type/unknown} (first remaining)) false (recur (rest remaining)))))] )
      {:kind :gravity.type/applied-map-association :version :sh08-map-association-v1
       :operation 'assoc :semantic-owner 'gravity.collections :intrinsic :gravity.collections/persistent-map-assoc
       :resolution :gravity.core-compatibility :operator-node-id (get operator :node-id) :operator-binding-id bid
       :call-core-node-id (get node :node-id) :source (get node :source) :operator-source (get operator :source)
       :source-call call :source-edge edge :source-binding binding :argument-types arguments
       :key (get (get key-node :attributes) :value) :application (if invoked? :normal :not-invoked)
       :latent-effects [:memory/allocate] :direct-effects (if invoked? [:memory/allocate] []) :capabilities [] :thrown-error-effects []
       :profile (get module :profile) :target (get module :target)
       :invalidation [:calls :call-edges :binding-table :source-forms :type-table :lexical-bindings :definitions :function-records
                      :callee-body :constructor-or-quote-shape :profile :target :evaluation-order]} nil)) nil))

(defn sh08-ma-transition [input value key key-id value-id call-id]
  (let [parts (get input :parts) index (sh08-sm-part-index input key nil) replace? (= false (= index nil))
        ordinal (if replace? index (count parts)) old (if replace? (get parts index) nil)
        part {:coordinate (if replace? (get old :coordinate) (+ 1 (* 2 ordinal))) :key key
              :value-node-id value-id :shape value :association-call-node-id call-id}
        part (if replace? (if (contains? old :key-data-origin) (assoc part :key-data-origin (get old :key-data-origin))
                            (assoc part :key-node-id (get old :key-node-id))) (assoc part :key-node-id key-id))]
    {:kind (if replace? :replace :add) :entry-index ordinal :old-part old :new-part part
     :parts (if replace? (assoc parts index part) (conj parts part))}))

(defn sh08-ma-result-type [parts]
  {:kind :gravity.type/map :member-types
    (loop [remaining parts out []]
      (if (= 0 (count remaining)) out
        (recur (rest remaining) (conj (conj out :gravity.type/keyword) (get (get (first remaining) :shape) :type)))))
   :shape :literal})

(defn sh08-ma-finish [header input value used]
  (let [call (get header :source-call) edge (get header :source-edge) args (get call :argument-node-ids)
        id (get header :call-core-node-id) normal? (= :normal (get header :application))
        transition (if normal? (sh08-ma-transition input value (get header :key) (get args 1) (get args 2) id) nil)
        type (if normal? (sh08-ma-result-type (get transition :parts)) :gravity.type/never)
        ancestry {:source-call call :source-edge edge :source-binding (get header :source-binding)
                  :input-node-id (get args 0) :key-node-id (get args 1) :value-node-id (get args 2)
                  :input-shape input :value-shape value :transition transition}
        size (+ 1 (get input :shape-size 0) (get value :shape-size 0))
        shape (if normal?
                {:status :accepted :shape-kind :map :type type :node-id id :source (get header :source)
                 :constructor-origin :persistent-map-association :coordinate-system :ordered-map-entry-value-slots
                 :binding-links [] :parts (get transition :parts) :association ancestry :shape-size size
                 :call-join-work used :call-links (sh08-ft-add-values-to-set (get value :call-links []) (get input :call-links []))}
                {:status :accepted :shape-kind :scalar :type :gravity.type/never :node-id id :source (get header :source)
                 :binding-links [] :shape-size size :association ancestry :call-join-work used})]
    {:descriptor (assoc header :input-shape input :value-shape value :transition transition :result-shape (if normal? shape nil)
                   :parameter-types (get header :argument-types) :return type :result-type type)
     :shape shape :type type :shape-size size}))

(defn sh08-ma-constraint [descriptor]
  {:constraint-id-request {:domain :gravity/sh08-map-association-constraint-v1 :application descriptor}
   :kind :equality :producer-rule :sh08-map-association-v1
   :lhs {:core-node-id (get descriptor :call-core-node-id) :projection :persistent-map-association}
   :rhs (get descriptor :result-type) :dependencies descriptor :origin (get (get descriptor :source) :origin-chain)
   :solution {:result-type (get descriptor :result-type) :application (get descriptor :application)
              :transition (get descriptor :transition) :direct-effects (get descriptor :direct-effects)}
   :invalidation (get descriptor :invalidation) :profile (get descriptor :profile) :target (get descriptor :target)
   :status :solved :diagnostics []})

(defn sh08-ma-call-fact [descriptor module]
  (let [source (get descriptor :source) edge (get descriptor :source-edge)]
    {:artifact :gravity/c7-call-type-fact
     :fact-id-request {:domain :gravity/sh08-map-association-call-type-fact-v1 :application descriptor}
     :call-core-node-id (get descriptor :call-core-node-id) :caller-function-syntax-id (get edge :caller-function-syntax-id)
     :callee-function-syntax-id nil :argument-types (get descriptor :argument-types) :result-type (get descriptor :result-type)
     :evaluation-order :operator-then-arguments :source-span (get source :semantic-span) :syntax-id (get source :syntax-id)
     :origin-chain (get source :origin-chain) :generated-origin (get source :generated-origin)
     :profile (get module :profile) :target (get module :target) :effects (get descriptor :direct-effects) :capabilities [] :status :inferred
     :dispatch :direct-map-association :applied-map-association descriptor :effect-facts-source :audited-collection-intrinsic}))

; STD3/L2/L5: derive a persistent update from the existing shape owner.
; Logical entry coordinates describe the derived map, not call child indexes.
(defn sh08-ma-derive [node nodes types binding-types functions lexical bindings forms seen depth binding-shapes context]
  (let [id (get node :node-id) call (get (get context :calls) id) edge (get (get context :edges) id)
        core (get context :source-core) module (get context :module)
        args (get call :argument-node-ids) key-node (get nodes (get args 1))
        owner (get forms (get (get node :source) :form-id)) ids (get owner :child-form-ids)
        work (+ 64 (count args) (count (get core :function-records)))]
    (if (> work (get context :budget-left 0))
      (assoc (sh08-sm-failure "C7-GENERIC" :map-association-work-limit nil :remaining-type-join-units (get context :budget-left 0)) :call-join-work work)
      (let [header (sh08-ma-source core node call edge nodes bindings types module)]
      (if (= header nil)
        (assoc (sh08-sm-failure "C7-TYPE-MISMATCH"
                 (if (= 3 (count args)) :map-association-key-or-operand-type-required :map-association-arity-mismatch)
                 nil :established-map-literal-keyword-and-established-value (sh08-ft-ordered-child-types args types)) :call-join-work work)
      (if (sh08-ft-all-true?
            [(= :list (get owner :kind)) (= (get node :source) (sh08-ma-form-source owner))
             (= 4 (count ids)) (= {:operator-child-index 0 :argument-count 3 :argument-child-indexes [1 2 3]
                                  :evaluation-order :operator-then-arguments :dispatch :resolved-symbol-call} (get node :attributes))
             (loop [i 0]
               (if (= i 4) true
                 (let [form (get forms (get ids i)) child (get nodes (get (get node :children) i))]
                   (if (sh08-ft-all-true? [(= (get owner :form-id) (get form :parent-form-id))
                         (= (get child :source) (sh08-ma-form-source form))]) (recur (+ i 1)) false))))
             (= :keyword (get (get forms (get ids 2)) :kind))
             (= (get header :key) (get (get forms (get ids 2)) :value))])
        (let [input-never? (= :gravity.type/never (get types (get args 0)))
              value-never? (= :gravity.type/never (get types (get args 2)))
              input (if input-never? nil
                      (sh08-sm-shape-with-bindings (get args 0) nodes types binding-types functions lexical bindings forms
                        (conj seen id) (+ depth 1) binding-shapes (assoc context :budget-left (- (get context :budget-left) work))))
              value (if value-never? {:status :accepted :shape-kind :scalar :type :gravity.type/never
                                       :node-id (get args 2) :source (get (get nodes (get args 2)) :source) :binding-links [] :shape-size 1}
                      (sh08-sm-shape-with-bindings (get args 2) nodes types binding-types functions lexical bindings forms
                        (conj seen id) (+ depth 1) binding-shapes
                        (assoc context :budget-left (- (get context :budget-left) work (get input :call-join-work 0)))))
              used (+ work (get input :call-join-work 0) (get value :call-join-work 0))]
          (if (if input-never? true (if (= :accepted (get input :status)) (= :map (get input :shape-kind)) false))
            (if (= :accepted (get value :status))
              (let [finished (sh08-ma-finish header input value used)
                    shape (get finished :shape) type (get finished :type) size (get finished :shape-size)
                    descriptor (get finished :descriptor)]
                (if (if (<= size (get (sh08-local-bounds-value) :maximum-core-nodes))
                      (if (<= used (get context :budget-left 0)) (= :accepted (get (sh08-carrier-preflight descriptor) :status)) false) false)
                  {:status :accepted :descriptor descriptor :shape shape :type type :call-join-work used}
                  (assoc (sh08-sm-failure "C7-GENERIC" :map-association-evidence-or-work-limit nil :bounded-map-association size) :call-join-work used)))
              (assoc value :call-join-work used))
            (assoc (if (= :rejected (get input :status)) input
                     (sh08-sm-failure "C7-ANNOTATION" :map-association-map-shape-required nil :established-constructor-quote-binding-or-local-return (get types (get args 0))))
                   :call-join-work used)))
        (assoc (sh08-sm-failure "C7-VERIFY" :map-association-source-mismatch nil :exact-operator-map-key-value-source id) :call-join-work work)))))))

(defn sh08-ma-node? [node context]
  (if (= :call (get node :core-form))
    (sh08-ma-binding? (get (get context :ordering-bindings) (first (get node :resolved-binding-ids)))
                     (get (get context :ordering-core) :module)) false))

(defn sh08-ma-inferred-call-valid? [core node call edge nodes bindings types]
  (let [descriptor (get types (get call :operator-node-id))
        header (sh08-ma-source core node call edge nodes bindings types (get core :module))
        input (get descriptor :input-shape) value (get descriptor :value-shape)
        used (+ 64 (count (get call :argument-node-ids)) (count (get core :function-records))
                (get input :call-join-work 0) (get value :call-join-work 0))]
    (if (map? header)
      (sh08-ft-all-true? [(= descriptor (get (sh08-ma-finish header input value used) :descriptor))
                          (if (= :gravity.type/never (get (get header :argument-types) 0)) (= input nil)
                            (if (= :map (get input :shape-kind)) (= (get input :type) (get (get header :argument-types) 0)) false))
                          (= (get value :type) (get (get header :argument-types) 2))]) false)))

(defn sh08-ma-step [node types binding-types functions context budget]
  (let [core (get context :ordering-core)
        result (sh08-ma-derive node (get context :lookup-nodes) types binding-types functions
                 (get core :lexical-bindings) (get context :ordering-bindings) (get context :association-forms)
                 #{} 0 (get context :prior-binding-shapes {})
                 (assoc (get context :shape-call-context) :source-core core :module (get core :module) :budget-left budget))]
    (if (= :accepted (get result :status))
      (assoc result :constraint (sh08-ma-constraint (get result :descriptor)) :work-count (get result :call-join-work))
      (assoc result :work-count (get result :call-join-work 0)))))

(defn sh08-va-binding? [binding module]
  (if (if (vector? (get binding :profile-set)) (vector? (get binding :target-set)) false)
  (sh08-ft-all-true?
    [(= ['conj :core :var 'gravity.core {:name 'gravity/core :version "bootstrap-contract-v1"} :gravity.type/core-var :safe]
        [(get binding :name) (get binding :binding-class) (get binding :kind) (get binding :namespace)
         (get binding :package) (get binding :type-ref) (get binding :safety)])
     (= [] (get binding :effects) (get binding :capabilities))
     (contains? (set (get binding :profile-set)) (get module :profile))
     (contains? (set (get binding :target-set)) :all)]) false))

(defn sh08-va-source [core node call edge nodes bindings types module]
  (if (if (vector? (get call :argument-node-ids)) (vector? (get node :children)) false)
  (let [children (get node :children) operator (get nodes (get call :operator-node-id))
        bid (get call :operator-binding-id) binding (get bindings bid) args (get call :argument-node-ids)
        arguments (sh08-ft-ordered-child-types args types)
        invoked? (loop [remaining arguments]
                   (if (= 0 (count remaining)) true
                     (if (= :gravity.type/never (first remaining)) false (recur (rest remaining)))))
        caller (loop [remaining (get core :function-records)]
                 (if (= 0 (count remaining)) nil
                   (if (= (get (first remaining) :function-syntax-id) (get (get node :evaluation) :owner-function-syntax-id))
                     (first remaining) (recur (rest remaining)))))
        expected-call {:core-node-id (get node :node-id) :operator-node-id (first children) :operator-binding-id bid
                       :argument-node-ids (vec (rest children)) :ordered-evaluation-node-ids children
                       :evaluation-order :operator-then-arguments :result-policy :call-result}
        expected-edge {:ordinal (get edge :ordinal) :call-core-node-id (get node :node-id)
                       :caller-function-syntax-id (get caller :function-syntax-id) :caller-function-core-node-id (get caller :function-core-node-id)
                       :callee-binding-id bid :callee-definition-syntax-id (get binding :definition-syntax-id)
                       :callee-function-syntax-id nil :callee-function-core-node-id nil :argument-core-node-ids args
                       :ordered-evaluation-node-ids children :evaluation-order :operator-then-arguments :classification :nonlocal-or-nonfunction}]
    (if (sh08-ft-all-true?
          [(= :call (get node :core-form)) (= :reference (get operator :core-form))
           (= 2 (count args)) (= expected-call call) (= expected-edge edge) (sh08-va-binding? binding module)
           (= [bid] (get node :resolved-binding-ids) (get operator :resolved-binding-ids))
           (= {:symbol (get (get operator :attributes) :symbol) :position :operator :binding-id bid :binding-class :core
               :definition-syntax-id (get binding :definition-syntax-id)} (get operator :attributes))
           (contains? '#{conj gravity.core/conj} (get (get operator :attributes) :symbol))
           (= :operator-then-arguments (get (get node :evaluation) :kind))
           (= (loop [i 0 out []] (if (= i (count children)) out
                (recur (+ i 1) (conj out {:index i :core-node-id (get children i)})))) (get (get node :evaluation) :order))
           (if (= :gravity.type/never (first arguments)) true
             (if (= :gravity.type/vector (get (first arguments) :kind))
               (let [elements (get (first arguments) :element-types)]
                 (if (vector? elements) (if (<= (count elements) 1024) (if invoked? (< (count elements) 1024) true) false) false)) false))
           (loop [remaining arguments]
             (if (= 0 (count remaining)) true
               (if (contains? #{nil :gravity.type/unknown} (first remaining)) false (recur (rest remaining)))))] )
      {:kind :gravity.type/applied-vector-append :version :sh08-vector-append-v1
       :operation 'conj :semantic-owner 'gravity.collections :intrinsic :gravity.collections/finite-vector-append
       :resolution :gravity.core-compatibility :operator-node-id (get operator :node-id) :operator-binding-id bid
       :call-core-node-id (get node :node-id) :source (get node :source) :operator-source (get operator :source)
       :source-call call :source-edge edge :source-binding binding :argument-types arguments
       :append-semantics {:operation :persistent-vector-append :prefix :complete-ordered-input
                          :input-preserved? true :appended-values 1 :operand-evaluation :once
                          :normal-input :established-vector}
       :input-extent (if (= :gravity.type/never (first arguments)) nil (count (get (first arguments) :element-types)))
       :result-extent (if invoked? (+ 1 (count (get (first arguments) :element-types))) nil)
       :application (if invoked? :normal :not-invoked)
       :latent-effects [] :direct-effects (if invoked? [:memory/allocate] []) :capabilities [] :thrown-error-effects []
       :profile (get module :profile) :target (get module :target)
       :invalidation [:calls :call-edges :binding-table :source-forms :type-table :lexical-bindings :definitions :function-records
                      :callee-body :vector-prefix :appended-value :profile :target :evaluation-order]} nil)) nil))

(defn sh08-va-constraint [descriptor]
  {:constraint-id-request {:domain :gravity/sh08-vector-append-constraint-v1 :application descriptor}
   :kind :equality :producer-rule :sh08-vector-append-v1
   :lhs {:core-node-id (get descriptor :call-core-node-id) :projection :vector-append}
   :rhs (get descriptor :result-type) :dependencies descriptor :origin (get (get descriptor :source) :origin-chain)
   :solution {:result-type (get descriptor :result-type) :application (get descriptor :application)
              :direct-effects (get descriptor :direct-effects)}
   :invalidation (get descriptor :invalidation) :profile (get descriptor :profile) :target (get descriptor :target)
   :status :solved :diagnostics []})

(defn sh08-va-call-fact [descriptor module]
  (let [source (get descriptor :source) edge (get descriptor :source-edge)]
    {:artifact :gravity/c7-call-type-fact
     :fact-id-request {:domain :gravity/sh08-vector-append-call-type-fact-v1 :application descriptor}
     :call-core-node-id (get descriptor :call-core-node-id) :caller-function-syntax-id (get edge :caller-function-syntax-id)
     :callee-function-syntax-id nil :argument-types (get descriptor :argument-types) :result-type (get descriptor :result-type)
     :evaluation-order :operator-then-arguments :source-span (get source :semantic-span) :syntax-id (get source :syntax-id)
     :origin-chain (get source :origin-chain) :generated-origin (get source :generated-origin)
     :profile (get module :profile) :target (get module :target) :effects (get descriptor :direct-effects) :capabilities [] :status :inferred
     :dispatch :direct-vector-append :applied-vector-append descriptor :effect-facts-source :audited-collection-intrinsic}))


(defn sh08-va-finish [header]
  (let [arguments (get header :argument-types)
        type (if (= :normal (get header :application))
               (assoc (first arguments) :element-types (conj (get (first arguments) :element-types) (get arguments 1))) :gravity.type/never)]
    (assoc header :parameter-types (get header :argument-types) :return type :result-type type)))

(defn sh08-va-derive [core node call edge nodes bindings types forms budget]
  ; STD3 persistent append preserves the complete prefix and adds one value.
  ; Both operand types stay checked even when normal invocation is impossible.
  (let [args (get call :argument-node-ids) work (+ 64 (count args) (count (get core :function-records))
               (if (vector? (get (get types (first args)) :element-types))
                 (count (get (get types (first args)) :element-types)) 0))
        owner (get forms (get (get node :source) :form-id)) ids (get owner :child-form-ids)]
    (if (> work budget)
      (assoc (sh08-sm-failure "C7-GENERIC" :vector-append-work-limit nil :remaining-type-join-units budget) :work-count work)
      (let [header (sh08-va-source core node call edge nodes bindings types (get core :module))]
        (if (= header nil)
          (assoc (sh08-sm-failure "C7-TYPE-MISMATCH"
                   (if (= 2 (count args)) :vector-append-operand-type-required :vector-append-arity-mismatch)
                   nil :established-vector-and-typed-value (sh08-ft-ordered-child-types args types)) :work-count work)
          (if (sh08-ft-all-true?
                [(= :list (get owner :kind)) (= (get node :source) (sh08-ma-form-source owner)) (vector? ids) (= 3 (if (vector? ids) (count ids) 0))
                 (= {:operator-child-index 0 :argument-count 2 :argument-child-indexes [1 2]
                     :evaluation-order :operator-then-arguments :dispatch :resolved-symbol-call} (get node :attributes))
                 (loop [i 0]
                   (if (= i 3) true
                     (let [form (get forms (get ids i)) child (get nodes (get (get node :children) i))]
                       (if (sh08-ft-all-true? [(= (get owner :form-id) (get form :parent-form-id))
                             (= (get child :source) (sh08-ma-form-source form))
                             (if (= i 0) (= (get form :value) (get (get child :attributes) :symbol)) true)])
                         (recur (+ i 1)) false))))])
            (let [descriptor (sh08-va-finish header)]
              {:status :accepted :descriptor descriptor :type (get descriptor :result-type)
               :constraint (sh08-va-constraint descriptor) :work-count work})
            (assoc (sh08-sm-failure "C7-VERIFY" :vector-append-source-mismatch nil :exact-operator-vector-value-source (get node :node-id)) :work-count work)))))))

(defn sh08-va-node? [node context]
  (if (= :call (get node :core-form))
    (sh08-va-binding? (get (get context :ordering-bindings) (first (get node :resolved-binding-ids)))
                     (get (get context :ordering-core) :module)) false))

(defn sh08-va-inferred-call-valid? [core node call edge nodes bindings types]
  (let [header (sh08-va-source core node call edge nodes bindings types (get core :module))]
    (if (map? header) (= (get types (get call :operator-node-id)) (sh08-va-finish header)) false)))

(defn sh08-va-step [node types binding-types functions context budget]
  (sh08-va-derive (get context :ordering-core) node
    (get (get context :ordering-operators) (first (get node :children)))
    (get (get context :ordering-edges) (get node :node-id))
    (get context :lookup-nodes) (get context :ordering-bindings) types (get context :association-forms) budget))

(defn sh08-sc-binding? [binding module]
  (if (if (vector? (get binding :profile-set)) (vector? (get binding :target-set)) false)
  (sh08-ft-all-true?
    [(= ['str :core :var 'gravity.core {:name 'gravity/core :version "bootstrap-contract-v1"} :gravity.type/core-var :safe]
        [(get binding :name) (get binding :binding-class) (get binding :kind) (get binding :namespace)
         (get binding :package) (get binding :type-ref) (get binding :safety)])
     (= [] (get binding :effects) (get binding :capabilities))
     (contains? (set (get binding :profile-set)) (get module :profile))
     (contains? (set (get binding :target-set)) :all)]) false))

(defn sh08-sc-source [core node call edge nodes bindings types module]
  (if (if (vector? (get call :argument-node-ids)) (vector? (get node :children)) false)
  (let [children (get node :children) operator (get nodes (get call :operator-node-id))
        bid (get call :operator-binding-id) binding (get bindings bid) args (get call :argument-node-ids)
        arguments (sh08-ft-ordered-child-types args types)
        invoked? (loop [remaining arguments]
                   (if (= 0 (count remaining)) true
                     (if (= :gravity.type/never (first remaining)) false (recur (rest remaining)))))
        caller (loop [remaining (get core :function-records)]
                 (if (= 0 (count remaining)) nil
                   (if (= (get (first remaining) :function-syntax-id) (get (get node :evaluation) :owner-function-syntax-id))
                     (first remaining) (recur (rest remaining)))))
        expected-call {:core-node-id (get node :node-id) :operator-node-id (first children) :operator-binding-id bid
                       :argument-node-ids (vec (rest children)) :ordered-evaluation-node-ids children
                       :evaluation-order :operator-then-arguments :result-policy :call-result}
        expected-edge {:ordinal (get edge :ordinal) :call-core-node-id (get node :node-id)
                       :caller-function-syntax-id (get caller :function-syntax-id) :caller-function-core-node-id (get caller :function-core-node-id)
                       :callee-binding-id bid :callee-definition-syntax-id (get binding :definition-syntax-id)
                       :callee-function-syntax-id nil :callee-function-core-node-id nil :argument-core-node-ids args
                       :ordered-evaluation-node-ids children :evaluation-order :operator-then-arguments :classification :nonlocal-or-nonfunction}]
    (if (sh08-ft-all-true?
          [(= :call (get node :core-form)) (= :reference (get operator :core-form))
           (= 2 (count args)) (= expected-call call) (= expected-edge edge) (sh08-sc-binding? binding module)
           (= [bid] (get node :resolved-binding-ids) (get operator :resolved-binding-ids))
           (= {:symbol (get (get operator :attributes) :symbol) :position :operator :binding-id bid :binding-class :core
               :definition-syntax-id (get binding :definition-syntax-id)} (get operator :attributes))
           (contains? '#{str gravity.core/str} (get (get operator :attributes) :symbol))
           (= :operator-then-arguments (get (get node :evaluation) :kind))
           (= (loop [i 0 out []] (if (= i (count children)) out
                (recur (+ i 1) (conj out {:index i :core-node-id (get children i)})))) (get (get node :evaluation) :order))
           (loop [remaining arguments]
             (if (= 0 (count remaining)) true
               (if (contains? #{:gravity.type/string :gravity.type/never} (first remaining))
                 (recur (rest remaining)) false)))
           (loop [remaining arguments]
             (if (= 0 (count remaining)) true
               (if (contains? #{nil :gravity.type/unknown} (first remaining)) false (recur (rest remaining)))))] )
      {:kind :gravity.type/applied-string-concat :version :sh08-string-concat-v1
       :operation 'str :semantic-owner 'gravity.text :intrinsic :gravity.text/binary-string-concat
       :resolution :gravity.core-compatibility :operator-node-id (get operator :node-id) :operator-binding-id bid
       :call-core-node-id (get node :node-id) :source (get node :source) :operator-source (get operator :source)
       :source-call call :source-edge edge :source-binding binding :argument-types arguments
       :concatenation-policy {:domain :binary-strings :order :left-then-right
                              :scalars :exact-sequence-concatenation :normalization :none :coercion :none
                              :formatting :none :operand-evaluation :once :allocation :normal-invocation-even-empty}
       :application (if invoked? :normal :not-invoked)
       :latent-effects [:memory/allocate] :direct-effects (if invoked? [:memory/allocate] []) :capabilities [] :thrown-error-effects []
       :profile (get module :profile) :target (get module :target)
       :invalidation [:calls :call-edges :binding-table :source-forms :type-table :lexical-bindings :definitions :function-records
                      :callee-body :string-operand-types :concatenation-policy :allocation-condition :profile :target :evaluation-order]} nil)) nil))

(defn sh08-sc-constraint [descriptor]
  {:constraint-id-request {:domain :gravity/sh08-string-concat-constraint-v1 :application descriptor}
   :kind :equality :producer-rule :sh08-string-concat-v1
   :lhs {:core-node-id (get descriptor :call-core-node-id) :projection :string-concat}
   :rhs (get descriptor :result-type) :dependencies descriptor :origin (get (get descriptor :source) :origin-chain)
   :solution {:result-type (get descriptor :result-type) :application (get descriptor :application)
              :direct-effects (get descriptor :direct-effects)}
   :invalidation (get descriptor :invalidation) :profile (get descriptor :profile) :target (get descriptor :target)
   :status :solved :diagnostics []})

(defn sh08-sc-call-fact [descriptor module]
  (let [source (get descriptor :source) edge (get descriptor :source-edge)]
    {:artifact :gravity/c7-call-type-fact
     :fact-id-request {:domain :gravity/sh08-string-concat-call-type-fact-v1 :application descriptor}
     :call-core-node-id (get descriptor :call-core-node-id) :caller-function-syntax-id (get edge :caller-function-syntax-id)
     :callee-function-syntax-id nil :argument-types (get descriptor :argument-types) :result-type (get descriptor :result-type)
     :evaluation-order :operator-then-arguments :source-span (get source :semantic-span) :syntax-id (get source :syntax-id)
     :origin-chain (get source :origin-chain) :generated-origin (get source :generated-origin)
     :profile (get module :profile) :target (get module :target) :effects (get descriptor :direct-effects) :capabilities [] :status :inferred
     :dispatch :direct-string-concat :applied-string-concat descriptor :effect-facts-source :audited-text-intrinsic}))


(defn sh08-sc-finish [header]
  (let [type (if (= :normal (get header :application)) :gravity.type/string :gravity.type/never)]
    (assoc header :parameter-types (get header :argument-types) :return type :result-type type)))

(defn sh08-sc-derive [core node call edge nodes bindings types forms budget]
  ; STD4 binary String concatenation allocates on normal invocation even
  ; for empty Strings. Other returning operands remain String under Never.
  (let [args (get call :argument-node-ids) work (+ 64 (count args) (count (get core :function-records)))
        owner (get forms (get (get node :source) :form-id)) ids (get owner :child-form-ids)]
    (if (> work budget)
      (assoc (sh08-sm-failure "C7-GENERIC" :string-concat-work-limit nil :remaining-type-join-units budget) :work-count work)
      (let [header (sh08-sc-source core node call edge nodes bindings types (get core :module))]
        (if (= header nil)
          (assoc (sh08-sm-failure "C7-TYPE-MISMATCH"
                   (if (= 2 (count args)) :string-concat-operand-type-required :string-concat-arity-mismatch)
                   nil :two-established-strings (sh08-ft-ordered-child-types args types)) :work-count work)
          (if (sh08-ft-all-true?
                [(= :list (get owner :kind)) (= (get node :source) (sh08-ma-form-source owner)) (vector? ids) (= 3 (if (vector? ids) (count ids) 0))
                 (= {:operator-child-index 0 :argument-count 2 :argument-child-indexes [1 2]
                     :evaluation-order :operator-then-arguments :dispatch :resolved-symbol-call} (get node :attributes))
                 (loop [i 0]
                   (if (= i 3) true
                     (let [form (get forms (get ids i)) child (get nodes (get (get node :children) i))]
                       (if (sh08-ft-all-true? [(= (get owner :form-id) (get form :parent-form-id))
                             (= (get child :source) (sh08-ma-form-source form))
                             (if (= i 0) (= (get form :value) (get (get child :attributes) :symbol)) true)])
                         (recur (+ i 1)) false))))])
            (let [descriptor (sh08-sc-finish header)]
              {:status :accepted :descriptor descriptor :type (get descriptor :result-type)
               :constraint (sh08-sc-constraint descriptor) :work-count work})
            (assoc (sh08-sm-failure "C7-VERIFY" :string-concat-source-mismatch nil :exact-operator-left-right-string-source (get node :node-id)) :work-count work)))))))

(defn sh08-sc-node? [node context]
  (if (= :call (get node :core-form))
    (sh08-sc-binding? (get (get context :ordering-bindings) (first (get node :resolved-binding-ids)))
                     (get (get context :ordering-core) :module)) false))

(defn sh08-sc-inferred-call-valid? [core node call edge nodes bindings types]
  (let [header (sh08-sc-source core node call edge nodes bindings types (get core :module))]
    (if (map? header) (= (get types (get call :operator-node-id)) (sh08-sc-finish header)) false)))

(defn sh08-sc-step [node types binding-types functions context budget]
  (sh08-sc-derive (get context :ordering-core) node
    (get (get context :ordering-operators) (first (get node :children)))
    (get (get context :ordering-edges) (get node :node-id))
    (get context :lookup-nodes) (get context :ordering-bindings) types (get context :association-forms) budget))

(defn sh08-mg-member-count [type]
  (if (if (map? type) (vector? (get type :member-types)) false) (count (get type :member-types)) 0))

(defn sh08-mg-normal-known? [type]
  (if (if (keyword? type) true (if (map? type) (keyword? (get type :kind)) false))
    (if (contains? #{:gravity.type/unknown :gravity.type/never} type) false true) false))

(defn sh08-mg-map-valid? [type]
  (if (= :gravity.type/map type) true
    (if (if (map? type) (= :gravity.type/map (get type :kind)) false)
      (let [members (get type :member-types)]
        (if (if (vector? members) (<= (count members) 1024) false)
          (loop [i 0]
            (if (= i (count members)) true
              (if (< (+ i 1) (count members))
                (if (if (contains? #{:gravity.type/nil :gravity.type/bool :gravity.type/integer :gravity.type/decimal :gravity.type/ratio
                                    :gravity.type/character :gravity.type/string :gravity.type/symbol :gravity.type/keyword
                                    :gravity.type/i8 :gravity.type/i16 :gravity.type/i32 :gravity.type/i64
                                    :gravity.type/u8 :gravity.type/u16 :gravity.type/u32 :gravity.type/u64 :gravity.type/f32 :gravity.type/f64}
                                  (get members i))
                        (sh08-mg-normal-known? (get members (+ i 1))) false)
                  (recur (+ i 2)) false) false))) false)) false)))

(defn sh08-mg-operands? [arguments invoked?]
  (let [map-type (get arguments 0) key-type (get arguments 1) default-type (get arguments 2)]
    (if (if (if (= :gravity.type/never map-type) true (sh08-mg-map-valid? map-type))
          (if (contains? #{:gravity.type/string :gravity.type/keyword :gravity.type/never} key-type)
            (if (= :gravity.type/never default-type) true (sh08-mg-normal-known? default-type)) false) false)
      (if invoked?
        (if (map? map-type)
          (let [members (get map-type :member-types)]
            (loop [i 0]
              (if (= i (count members)) true
                (if (if (= key-type (get members i)) (= default-type (get members (+ i 1))) true)
                  (recur (+ i 2)) false)))) false)
        true) false)))

(defn sh08-mg-binding? [binding module]
  (if (if (vector? (get binding :profile-set)) (vector? (get binding :target-set)) false)
  (sh08-ft-all-true?
    [(= ['get :core :var 'gravity.core {:name 'gravity/core :version "bootstrap-contract-v1"} :gravity.type/core-var :safe]
        [(get binding :name) (get binding :binding-class) (get binding :kind) (get binding :namespace)
         (get binding :package) (get binding :type-ref) (get binding :safety)])
     (= [] (get binding :effects) (get binding :capabilities))
     (contains? (set (get binding :profile-set)) (get module :profile))
     (contains? (set (get binding :target-set)) :all)]) false))

(defn sh08-mg-source [core node call edge nodes bindings types module]
  (if (if (vector? (get call :argument-node-ids)) (vector? (get node :children)) false)
  (let [children (get node :children) operator (get nodes (get call :operator-node-id))
        bid (get call :operator-binding-id) binding (get bindings bid) args (get call :argument-node-ids)
        arguments (sh08-ft-ordered-child-types args types)
        invoked? (loop [remaining arguments]
                   (if (= 0 (count remaining)) true
                     (if (= :gravity.type/never (first remaining)) false (recur (rest remaining)))))
        caller (loop [remaining (get core :function-records)]
                 (if (= 0 (count remaining)) nil
                   (if (= (get (first remaining) :function-syntax-id) (get (get node :evaluation) :owner-function-syntax-id))
                     (first remaining) (recur (rest remaining)))))
        expected-call {:core-node-id (get node :node-id) :operator-node-id (first children) :operator-binding-id bid
                       :argument-node-ids (vec (rest children)) :ordered-evaluation-node-ids children
                       :evaluation-order :operator-then-arguments :result-policy :call-result}
        expected-edge {:ordinal (get edge :ordinal) :call-core-node-id (get node :node-id)
                       :caller-function-syntax-id (get caller :function-syntax-id) :caller-function-core-node-id (get caller :function-core-node-id)
                       :callee-binding-id bid :callee-definition-syntax-id (get binding :definition-syntax-id)
                       :callee-function-syntax-id nil :callee-function-core-node-id nil :argument-core-node-ids args
                       :ordered-evaluation-node-ids children :evaluation-order :operator-then-arguments :classification :nonlocal-or-nonfunction}]
    (if (sh08-ft-all-true?
          [(= :call (get node :core-form)) (= :reference (get operator :core-form))
           (= 3 (count args)) (= expected-call call) (= expected-edge edge) (sh08-mg-binding? binding module)
           (= [bid] (get node :resolved-binding-ids) (get operator :resolved-binding-ids))
           (= {:symbol (get (get operator :attributes) :symbol) :position :operator :binding-id bid :binding-class :core
               :definition-syntax-id (get binding :definition-syntax-id)} (get operator :attributes))
           (contains? '#{get gravity.core/get} (get (get operator :attributes) :symbol))
           (= :operator-then-arguments (get (get node :evaluation) :kind))
           (= (loop [i 0 out []] (if (= i (count children)) out
                (recur (+ i 1) (conj out {:index i :core-node-id (get children i)})))) (get (get node :evaluation) :order))
           (sh08-mg-operands? arguments invoked?)
           (loop [remaining arguments]
             (if (= 0 (count remaining)) true
               (if (contains? #{nil :gravity.type/unknown} (first remaining)) false (recur (rest remaining)))))] )
      {:kind :gravity.type/applied-map-get :version :sh08-map-get-v1
       :operation 'get :semantic-owner 'gravity.collections :intrinsic :gravity.collections/map-lookup-default
       :resolution :gravity.core-compatibility :operator-node-id (get operator :node-id) :operator-binding-id bid
       :call-core-node-id (get node :node-id) :source (get node :source) :operator-source (get operator :source)
       :source-call call :source-edge edge :source-binding binding :argument-types arguments
       :lookup-policy {:input :established-member-map :keys [:string :keyword] :key-equality :value
                       :presence :independent-of-value :default :eager :normalization :none :coercion :none
                       :operand-evaluation :map-then-key-then-default-once :result :one-established-type}
       :application (if invoked? :normal :not-invoked)
       :latent-effects [] :direct-effects [] :capabilities [] :thrown-error-effects []
       :profile (get module :profile) :target (get module :target)
       :invalidation [:calls :call-edges :binding-table :source-forms :type-table :lexical-bindings :definitions :function-records
                      :callee-body :member-types :key-domain :default-type :lookup-policy :profile :target :evaluation-order]} nil)) nil))

(defn sh08-mg-constraint [descriptor]
  {:constraint-id-request {:domain :gravity/sh08-map-get-constraint-v1 :application descriptor}
   :kind :equality :producer-rule :sh08-map-get-v1

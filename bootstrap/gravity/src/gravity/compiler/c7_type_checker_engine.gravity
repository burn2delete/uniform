                      (= [:loop (get target :target-id) (get target :arity) (sh08-ft-loop-kernel-indexes 0 (get target :arity))
                          (sh08-ft-loop-kernel-indexes (get target :arity) (count children)) (- (count children) (get target :arity))
                          {:kind :last-body :child-index (- (count children) 1)} :initializers-then-body-left-to-right]
                         [(get node :core-form) (get attrs :target-id) (get attrs :binding-count) (get attrs :initializer-child-indexes)
                          (get attrs :body-child-indexes) (get attrs :body-count) (get attrs :result-policy)
                          (get (get node :evaluation) :kind)]) false) false) false) false)) false) false) false)) false))

(defn sh08-ft-loop-kernel-initializer-visible? [root nodes all-slots prior budget]
  (loop [pending [root] seen #{} work 0]
    (if (= 0 (count pending)) {:status :accepted :work-count work}
      (if (>= work budget) (sh08-ft-loop-kernel-work-limit work)
        (let [id (first pending) node (get nodes id) binding (get (get node :attributes) :binding-id)]
          (if (contains? seen id) (sh08-ft-loop-kernel-failure :cyclic-loop-initializer id :tree nil work)
            (if (if (= :reference (get node :core-form))
                  (if (contains? all-slots binding) (= false (contains? prior binding)) false) false)
              (sh08-ft-loop-kernel-failure :loop-initializer-binding-visibility id :prior-loop-bindings binding (+ work 1))
              (recur (sh08-ft-loop-kernel-append (vec (rest pending)) (get node :children)) (conj seen id) (+ work 1)))))))))

(defn sh08-ft-loop-kernel-loop-slots [target node records nodes source-bindings types bindings budget]
  (loop [ids (get target :binding-ids) ordinal 0 prior [] out bindings slots [] constraints [] work 0]
    (if (= 0 (count ids)) {:status :accepted :bindings out :slots slots :constraints constraints :work-count work}
      (if (>= work budget) (sh08-ft-loop-kernel-work-limit work)
        (let [id (first ids) record (get records id) binding (get source-bindings id) initializer (get nodes (get record :initializer-node-id))
              type (get types (get initializer :node-id) :gravity.type/unknown)]
          (if (if (map? record)
                (= [(get node :node-id) ordinal id prior :immutable (get (get node :children) ordinal)
                    (get (get initializer :source) :form-id) (get (get initializer :source) :syntax-id) (get initializer :binding-context)
                    (get binding :binding-id) (get binding :name) (get binding :scope-id) (get binding :definition-syntax-id)]
                   [(get record :loop-core-node-id) (get record :ordinal) (get record :binding-id) (get record :visible-prior-binding-ids)
                    (get record :mutability) (get record :initializer-node-id) (get record :initializer-form-id)
                    (get record :initializer-syntax-id) (get record :initializer-scope-id)
                    id (get record :name) (get record :binding-scope-id) (get record :definition-syntax-id)]) false)
            (let [visible (sh08-ft-loop-kernel-initializer-visible? (get initializer :node-id) nodes (set (get target :binding-ids)) (set prior) (- budget work 1))]
              (if (= :accepted (get visible :status))

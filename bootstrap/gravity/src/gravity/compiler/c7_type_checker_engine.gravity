                         :coefficient-bound (if normal? :zero-through-original-positive-divisor :not-required-for-aborted-invocation)
                         :result-value-bound (if normal? :zero-through-original-count :not-invoked)
                         :overflow :impossible :conversion :none}})
              {:status :rejected :reason (if (= :count-quotient-scaling-source-mismatch (get checked :reason))
                                          :count-quotient-scaling-source-mismatch :count-quotient-scaling-proof-required)}))
              {:status :rejected :reason :count-quotient-scaling-source-mismatch}))
          {:status :rejected :reason :count-quotient-scaling-source-mismatch})
        {:status :rejected :reason :count-quotient-scaling-arity-mismatch}))




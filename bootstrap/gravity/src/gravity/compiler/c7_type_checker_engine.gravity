(defn sh08-ane-constraint [descriptor]
  (if (= :sh08-string-set-carrier-inequality-v1 (get descriptor :version))
    {:constraint-id-request {:domain :gravity/sh08-string-set-carrier-inequality-constraint-v1 :application descriptor}
   :kind :equality :producer-rule :sh08-string-set-carrier-inequality-v1
   :lhs {:core-node-id (get descriptor :call-core-node-id) :projection :string-set-carrier-inequality}
   :rhs (get descriptor :result-type) :dependencies descriptor :origin (get (get descriptor :source) :origin-chain)
   :solution {:result-type (get descriptor :result-type) :application (get descriptor :application)
              :direct-effects (get descriptor :direct-effects)
              :inequality-policy (get descriptor :inequality-policy) :string-set-equality (get descriptor :string-set-equality)}
   :invalidation (get descriptor :invalidation) :profile (get descriptor :profile) :target (get descriptor :target)
   :status :solved :diagnostics []}
  {:constraint-id-request {:domain :gravity/sh08-atomic-inequality-constraint-v1 :application descriptor}
   :kind :equality :producer-rule :sh08-atomic-inequality-v1
   :lhs {:core-node-id (get descriptor :call-core-node-id) :projection :atomic-inequality}
   :rhs (get descriptor :result-type) :dependencies descriptor :origin (get (get descriptor :source) :origin-chain)
   :solution (let [solution {:result-type (get descriptor :result-type) :application (get descriptor :application)
              :direct-effects (get descriptor :direct-effects)
              }]
                (if (contains? descriptor :list-equality)
                  (assoc solution :list-equality (get descriptor :list-equality) :inequality-policy (get descriptor :inequality-policy))
                  (if (contains? descriptor :numeric-equality)
                  (assoc solution :numeric-equality (get descriptor :numeric-equality))
                  (if (contains? descriptor :vector-equality)
                    (assoc solution :vector-equality (get descriptor :vector-equality))
                    (if (contains? descriptor :string-set-equality)
                      (assoc solution :string-set-equality (get descriptor :string-set-equality))
                      (if (contains? descriptor :keyword-set-equality)
                      (assoc solution :keyword-set-equality (get descriptor :keyword-set-equality)) solution))))))
   :invalidation (get descriptor :invalidation) :profile (get descriptor :profile) :target (get descriptor :target)
   :status :solved :diagnostics []}))

(defn sh08-ane-call-fact [descriptor module]
  (if (= :sh08-string-set-carrier-inequality-v1 (get descriptor :version))
    (let [source (get descriptor :source) edge (get descriptor :source-edge)]
      {:artifact :gravity/c7-call-type-fact
     :fact-id-request {:domain :gravity/sh08-string-set-carrier-inequality-call-type-fact-v1 :application descriptor}
     :call-core-node-id (get descriptor :call-core-node-id) :caller-function-syntax-id (get edge :caller-function-syntax-id)
     :callee-function-syntax-id nil :argument-types (get descriptor :argument-types) :result-type (get descriptor :result-type)
     :evaluation-order :operator-then-arguments :source-span (get source :semantic-span) :syntax-id (get source :syntax-id)
     :origin-chain (get source :origin-chain) :generated-origin (get source :generated-origin)
     :profile (get module :profile) :target (get module :target) :effects (get descriptor :direct-effects) :capabilities [] :status :inferred
     :dispatch :direct-atomic-inequality :applied-atomic-inequality descriptor :effect-facts-source :audited-string-set-carrier-inequality-intrinsic})
  (let [source (get descriptor :source) edge (get descriptor :source-edge)]
    {:artifact :gravity/c7-call-type-fact
     :fact-id-request {:domain :gravity/sh08-atomic-inequality-call-type-fact-v1 :application descriptor}
     :call-core-node-id (get descriptor :call-core-node-id) :caller-function-syntax-id (get edge :caller-function-syntax-id)
     :callee-function-syntax-id nil :argument-types (get descriptor :argument-types) :result-type (get descriptor :result-type)
     :evaluation-order :operator-then-arguments :source-span (get source :semantic-span) :syntax-id (get source :syntax-id)
     :origin-chain (get source :origin-chain) :generated-origin (get source :generated-origin)
     :profile (get module :profile) :target (get module :target) :effects (get descriptor :direct-effects) :capabilities [] :status :inferred

     :dispatch :direct-atomic-inequality :applied-atomic-inequality descriptor :effect-facts-source (if (contains? descriptor :list-equality) :audited-list-inequality-intrinsic
       (if (contains? descriptor :vector-equality) :audited-vector-inequality-intrinsic
       (if (contains? descriptor :string-set-equality) :audited-string-set-inequality-intrinsic
         (if (contains? descriptor :keyword-set-equality) :audited-keyword-set-inequality-intrinsic :audited-atomic-inequality-intrinsic))))})))

(defn sh08-ane-finish [header]
  (let [type (if (= :normal (get header :application)) :gravity.type/bool :gravity.type/never)]
    (assoc header :parameter-types (get header :argument-types) :return type :result-type type)))

(defn sh08-ane-derive [core node call edge nodes bindings types forms]
  (let [args (get call :argument-node-ids) children (get node :children)]
    (if (= false (if (vector? args) (if (= 2 (count args))
                    (if (vector? children) (= 3 (count children)) false) false) false))
        (sh08-sm-failure "C7-TYPE-MISMATCH" :atomic-inequality-arity-mismatch nil :two-ordinary-operands nil)
        (if (loop [remaining (conj (conj (conj (conj (conj (get call :argument-node-ids) (get call :operator-node-id)) (get call :operator-binding-id)) (get node :node-id)) (get (get node :source) :form-id)) (get (get node :source) :syntax-id))] (if (= 0 (count remaining)) (loop [remaining (get node :children)] (if (= 0 (count remaining)) true (if (if (keyword? (first remaining)) true (if (string? (first remaining)) (= 71 (count (first remaining))) false)) (recur (rest remaining)) false))) (if (if (keyword? (first remaining)) true (if (string? (first remaining)) (= 71 (count (first remaining))) false)) (recur (rest remaining)) false))) (let [arguments [(get types (first args) :gravity.type/unknown) (get types (get args 1) :gravity.type/unknown)]
              validation (sh08-ane-domain arguments)
              owner (get forms (get (get node :source) :form-id)) ids (get owner :child-form-ids)]
          (if (= false (= :accepted (get validation :status)))
            (assoc (sh08-sm-failure "C7-TYPE-MISMATCH" :atomic-inequality-operand-type-required nil
                     :two-supported-values-with-applicable-binary-equality arguments)
              :type-check-reason (get validation :reason))
            (let [header (sh08-ane-source core node call edge nodes bindings types (get core :module) validation)]
              (if (if (if (map? header) (if (vector? ids) (if (= 3 (count ids)) (loop [remaining ids] (if (= 0 (count remaining)) true (if (if (keyword? (first remaining)) true (if (string? (first remaining)) (= 71 (count (first remaining))) false)) (recur (rest remaining)) false))) false) false) false)
                    (if (if (= :list (get validation :comparison-domain))
                          (sh08-sse-ids? [(get owner :form-id) (get owner :syntax-id)] 2) true)
(sh08-ft-all-true?
                      [(= :list (get owner :kind)) (= (get node :source) (sh08-ma-form-source owner))
                       (vector? ids) (= 3 (if (vector? ids) (count ids) 0))
                       (= {:operator-child-index 0 :argument-count 2 :argument-child-indexes [1 2]
                           :evaluation-order :operator-then-arguments :dispatch :resolved-symbol-call} (get node :attributes))
                       (loop [i 0]
                         (if (= i 3) true
                           (let [form (get forms (get ids i)) child (get nodes (get children i))]
                             (if (if (if (= :list (get validation :comparison-domain))
                                     (sh08-sse-ids? [(get form :form-id) (get form :syntax-id)
                                                      (get (get child :source) :form-id) (get (get child :source) :syntax-id)] 4) true)
                                  (sh08-ft-all-true? [(= (get owner :form-id) (get form :parent-form-id))
                                   (= (get child :source) (sh08-ma-form-source form))
                                   (if (= i 0)
                                     (if (= :list (get validation :comparison-domain))
                                       (if (symbol? (get form :value))
                                         (= (get (get child :attributes) :symbol) (get form :value)) false)
                                       (= (get form :value) (get (get child :attributes) :symbol))) true)]) false)
                               (recur (+ i 1)) false))))]) false) false)
                (let [descriptor (sh08-ane-finish header)]
                  {:status :accepted :descriptor descriptor :type (get descriptor :result-type)
                   :constraint (sh08-ane-constraint descriptor)})
                (sh08-sm-failure "C7-VERIFY" :atomic-inequality-source-mismatch nil
                  :exact-operator-left-right-source (get node :node-id))))))
          (sh08-sm-failure "C7-VERIFY" :atomic-inequality-source-mismatch nil
            :exact-operator-left-right-source (get node :node-id))))))

(defn sh08-ane-node? [node context]
  (if (if (= :call (get node :core-form)) (if (vector? (get node :resolved-binding-ids)) (if (= 1 (count (get node :resolved-binding-ids))) (if (keyword? (first (get node :resolved-binding-ids))) true (if (string? (first (get node :resolved-binding-ids))) (= 71 (count (first (get node :resolved-binding-ids)))) false)) false) false) false)
    (sh08-ane-binding? (get (get context :ordering-bindings) (first (get node :resolved-binding-ids)))
                     (get (get context :ordering-core) :module)) false))

(defn sh08-ane-inferred-call [core node call edge nodes bindings types]
  (let [args (get call :argument-node-ids) children (get node :children)]
    (if (if (vector? args) (if (= 2 (count args))
          (if (vector? children) (= 3 (count children)) false) false) false)
      (if (loop [remaining (conj (conj (conj (conj (conj (get call :argument-node-ids)
                                      (get call :operator-node-id)) (get call :operator-binding-id))
                                  (get node :node-id)) (get (get node :source) :form-id))
                              (get (get node :source) :syntax-id))]
            (if (= 0 (count remaining))
              (loop [remaining (get node :children)]
                (if (= 0 (count remaining)) true
                  (if (if (keyword? (first remaining)) true
                        (if (string? (first remaining)) (= 71 (count (first remaining))) false))
                    (recur (rest remaining)) false)))
              (if (if (keyword? (first remaining)) true
                    (if (string? (first remaining)) (= 71 (count (first remaining))) false))
                (recur (rest remaining)) false)))
        (let [validation (sh08-ane-domain [(get types (first args) :gravity.type/unknown)
                                           (get types (get args 1) :gravity.type/unknown)])]
          (if (= :accepted (get validation :status))
            (let [header (sh08-ane-source core node call edge nodes bindings types (get core :module) validation)
                  descriptor (if (map? header) (sh08-ane-finish header) nil)]
              (if (if (map? descriptor)
                    (if (= descriptor (get types (get call :operator-node-id)))
                      (= (get descriptor :result-type) (get types (get node :node-id))) false) false)
                {:status :accepted}
                {:status :rejected :reason :atomic-inequality-source-mismatch}))
            {:status :rejected :reason :atomic-inequality-operand-type-required
             :type-check-reason (get validation :reason)}))
        {:status :rejected :reason :atomic-inequality-source-mismatch})
      {:status :rejected :reason :atomic-inequality-arity-mismatch})))

(defn sh08-ane-step [node types binding-types functions context]
  (if (if (vector? (get node :children)) (if (> (count (get node :children)) 0) (if (keyword? (first (get node :children))) true (if (string? (first (get node :children))) (= 71 (count (first (get node :children)))) false)) false) false)
    (if (if (keyword? (get node :node-id)) true (if (string? (get node :node-id)) (= 71 (count (get node :node-id))) false)) (sh08-ane-derive (get context :ordering-core) node
    (get (get context :ordering-operators) (first (get node :children)))
    (get (get context :ordering-edges) (get node :node-id))
    (get context :lookup-nodes) (get context :ordering-bindings) types (get context :association-forms))
      (sh08-sm-failure "C7-VERIFY" :atomic-inequality-source-mismatch nil :scalar-node-id (get node :node-id)))
    (sh08-sm-failure "C7-VERIFY" :atomic-inequality-source-mismatch nil :scalar-operator-node-id nil)))

(defn sh08-kp-binding? [binding module]
  (if (if (vector? (get binding :profile-set)) (vector? (get binding :target-set)) false)
  (sh08-ft-all-true?
    [(= ['keyword? :core :var 'gravity.core {:name 'gravity/core :version "bootstrap-contract-v1"} :gravity.type/core-var :safe]
        [(get binding :name) (get binding :binding-class) (get binding :kind) (get binding :namespace)
         (get binding :package) (get binding :type-ref) (get binding :safety)])
     (= [] (get binding :effects) (get binding :capabilities))
     (= :jvm (get module :target))
     (contains? (set (get binding :profile-set)) (get module :profile))
     (contains? (set (get binding :target-set)) :all)]) false))

(defn sh08-kp-source [core node call edge nodes bindings types module validation]
  (if (sh08-lc-native-map? validation)
    (if (= {:status :accepted} validation)
      (if (if (vector? (get call :argument-node-ids))
        (if (= 1 (count (get call :argument-node-ids)))
          (if (vector? (get node :children)) (= 2 (count (get node :children))) false) false) false)
  (let [children (get node :children) operator (get nodes (get call :operator-node-id))
        bid (get call :operator-binding-id) binding (get bindings bid) args (get call :argument-node-ids)
        arguments (sh08-ft-ordered-child-types args types)
        invoked? (loop [remaining arguments]
                   (if (= 0 (count remaining)) true
                     (if (= :gravity.type/never (first remaining)) false (recur (rest remaining)))))
        caller (loop [remaining (get core :function-records)]
                 (if (= 0 (count remaining)) nil
                   (if (= (get (first remaining) :function-syntax-id) (get (get node :evaluation) :owner-function-syntax-id))
                     (first remaining) (recur (rest remaining)))))
        expected-call {:core-node-id (get node :node-id) :operator-node-id (first children) :operator-binding-id bid
                       :argument-node-ids (vec (rest children)) :ordered-evaluation-node-ids children
                       :evaluation-order :operator-then-arguments :result-policy :call-result}
        expected-edge {:ordinal (get edge :ordinal) :call-core-node-id (get node :node-id)
                       :caller-function-syntax-id (get caller :function-syntax-id) :caller-function-core-node-id (get caller :function-core-node-id)
                       :callee-binding-id bid :callee-definition-syntax-id (get binding :definition-syntax-id)
                       :callee-function-syntax-id nil :callee-function-core-node-id nil :argument-core-node-ids args
                       :ordered-evaluation-node-ids children :evaluation-order :operator-then-arguments :classification :nonlocal-or-nonfunction}]
    (if (sh08-ft-all-true?
          [(= :accepted (get validation :status)) (= :call (get node :core-form)) (= :reference (get operator :core-form))
           (= 1 (count args)) (= expected-call call) (= expected-edge edge) (sh08-kp-binding? binding module)
           (= [bid] (get node :resolved-binding-ids) (get operator :resolved-binding-ids))
           (= {:symbol (get (get operator :attributes) :symbol) :position :operator :binding-id bid :binding-class :core
               :definition-syntax-id (get binding :definition-syntax-id)} (get operator :attributes))
           (contains? '#{keyword? gravity.core/keyword?} (get (get operator :attributes) :symbol))
           (= :operator-then-arguments (get (get node :evaluation) :kind))
           (= (loop [i 0 out []] (if (= i (count children)) out
                (recur (+ i 1) (conj out {:index i :core-node-id (get children i)})))) (get (get node :evaluation) :order))
           (loop [remaining arguments]
             (if (= 0 (count remaining)) true
               (if (contains? #{nil :gravity.type/unknown} (first remaining)) false (recur (rest remaining)))))] )
      {:kind :gravity.type/applied-keyword-predicate :version :sh08-keyword-predicate-v1
       :operation 'keyword? :semantic-owner 'gravity.core :intrinsic :gravity.core/keyword-family-classification
       :resolution :gravity.core-compatibility :operator-node-id (get operator :node-id) :operator-binding-id bid
       :call-core-node-id (get node :node-id) :source (get node :source) :operator-source (get operator :source)
       :source-call call :source-edge edge :source-binding binding :argument-types arguments
       :query-semantics {:operation :keyword-family-classification :operand-evaluation :once :operand-position :non-tail
                         :construction :none :payload-evaluation :none :mutation :none :refinement :none}
       :application (if invoked? :normal :not-invoked)
       :latent-effects [] :direct-effects [] :capabilities [] :thrown-error-effects []
       :profile (get module :profile) :target (get module :target)
       :invalidation [:calls :call-edges :binding-table :source-forms :type-table :lexical-bindings :definitions :function-records
                      :callee-body :query-semantics :operand-type :profile :target :evaluation-order]} nil)) nil) nil) nil))


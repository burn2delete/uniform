(defn sh08-cqs-proof [core node call nodes bindings types forms]
  ; d*q <= count is the premise; q <= count alone does not bound k*q.
  (if (if (vector? (get call :argument-node-ids)) (= 2 (count (get call :argument-node-ids))) false)
        (if (sh08-nq-ids? node call nodes bindings (get core :module))
          (let [operator (get nodes (get call :operator-node-id))
                operator-form (get forms (get (get operator :source) :form-id))
                owner-form (get forms (get (get node :source) :form-id))
                owner-ids (get owner-form :child-form-ids)]
            (if (if (symbol? (get operator-form :value))
                  (if (= [] (get operator-form :child-form-ids))
                    (if (vector? owner-ids) (if (= 3 (count owner-ids)) (sh08-sse-ids? owner-ids 3) false) false) false) false)
              (let [ids (get call :argument-node-ids) left-type (get types (get ids 0)) right-type (get types (get ids 1))
                factor (if (= :gravity.type/never left-type) {:kind :non-invoked-operand}
                         (sh08-nq-literal (get nodes (get ids 0)) left-type forms false))
                checked (if (= :gravity.type/never right-type)
                          {:status :accepted :quotient {:kind :non-invoked-operand}}

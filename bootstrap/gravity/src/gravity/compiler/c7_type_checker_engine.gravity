(defn sh08-nt-derive [core node call edge nodes bindings types forms]
  ; STD2/L2 not complements false/nil truthiness over every independently
  ; established value type. Operand evaluation remains single and non-tail.
  (let [args (get call :argument-node-ids)
        owner (get forms (get (get node :source) :form-id)) ids (get owner :child-form-ids)]
    (let [header (sh08-nt-source core node call edge nodes bindings types (get core :module))]

(defn sh08-ft-authenticated-core [request]
  (if (sh08-ft-record-shape?
       request
       (if (contains? request :module-type-inputs)
         #{:canonical-core-artifact :b47-context :coordinator-verification :module-type-inputs}
         #{:canonical-core-artifact :b47-context :coordinator-verification}))
    (let [context (get request :b47-context)
          core (get request :canonical-core-artifact)]
      (if (sh08-ft-context-valid? context)
        (if (= core (get context :canonical-core-artifact))
          (if (sh08-ft-coordinator-verification-valid?
               (get request :coordinator-verification) context)
            {:status :accepted
             :core core
             :binding-table
             (get (get context :authenticated-core-request)
                  :binding-table)}
            {:status :rejected
             :reason :untrusted-b47-coordinator-verification})
          {:status :rejected :reason :b47-core-context-mismatch})
        {:status :rejected :reason :untrusted-b47-context}))
    {:status :rejected :reason :authenticated-b47-request-required}))

(defn sh08-ft-definition-by-binding-id [definitions binding-id]
  (loop [remaining definitions]
    (if (= (count remaining) 0)
      nil
      (if (= (get (first remaining) :binding-id) binding-id)
        (first remaining)
        (recur (rest remaining))))))

(defn sh08-ft-node-form? [nodes node-id core-form]
  (= (get (get nodes node-id) :core-form) core-form))

(defn sh08-ft-atomic-type-id [name]

    (assoc header :parameter-types (get header :argument-types) :return type :result-type type)))

(defn sh08-mg-derive [core node call edge nodes bindings types forms budget]
  ; STD3 explicit-default lookup evaluates all operands eagerly. Its normal
  ; result joins every possibly matching key-family value with the default.
  (let [args (get call :argument-node-ids) work (+ 64 (count args) (count (get core :function-records)) (sh08-mg-member-count (get types (first args))))
        owner (get forms (get (get node :source) :form-id)) ids (get owner :child-form-ids)]
    (if (> work budget)
      (assoc (sh08-sm-failure "C7-GENERIC" :map-get-work-limit nil :remaining-type-join-units budget) :work-count work)
      (let [header (sh08-mg-source core node call edge nodes bindings types (get core :module))]
        (if (= header nil)
          (assoc (sh08-sm-failure "C7-TYPE-MISMATCH"
                   (if (= 3 (count args)) :map-get-operand-type-required :map-get-arity-mismatch)
                   nil :member-map-key-and-one-result-type (sh08-ft-ordered-child-types args types)) :work-count work)
          (if (sh08-ft-all-true?
                [(= :list (get owner :kind)) (= (get node :source) (sh08-ma-form-source owner)) (vector? ids) (= 4 (if (vector? ids) (count ids) 0))
                 (= {:operator-child-index 0 :argument-count 3 :argument-child-indexes [1 2 3]
                     :evaluation-order :operator-then-arguments :dispatch :resolved-symbol-call} (get node :attributes))
                 (loop [i 0]
                   (if (= i 4) true
                     (let [form (get forms (get ids i)) child (get nodes (get (get node :children) i))]
                       (if (sh08-ft-all-true? [(= (get owner :form-id) (get form :parent-form-id))
                             (= (get child :source) (sh08-ma-form-source form))
                             (if (= i 0) (= (get form :value) (get (get child :attributes) :symbol)) true)])
                         (recur (+ i 1)) false))))])
            (let [descriptor (sh08-mg-finish header)]
              {:status :accepted :descriptor descriptor :type (get descriptor :result-type)
               :constraint (sh08-mg-constraint descriptor) :work-count work})
            (assoc (sh08-sm-failure "C7-VERIFY" :map-get-source-mismatch nil :exact-operator-map-key-default-source (get node :node-id)) :work-count work)))))))

(defn sh08-mg-node? [node context]
  (if (= :call (get node :core-form))
    (sh08-mg-binding? (get (get context :ordering-bindings) (first (get node :resolved-binding-ids)))
                     (get (get context :ordering-core) :module)) false))

(defn sh08-mg-inferred-call-valid? [core node call edge nodes bindings types]
  (let [header (sh08-mg-source core node call edge nodes bindings types (get core :module))]
    (if (map? header) (= (get types (get call :operator-node-id)) (sh08-mg-finish header)) false)))

(defn sh08-mg-step [node types binding-types functions context budget]
  (sh08-mg-derive (get context :ordering-core) node
    (get (get context :ordering-operators) (first (get node :children)))
    (get (get context :ordering-edges) (get node :node-id))
    (get context :lookup-nodes) (get context :ordering-bindings) types (get context :association-forms) budget))

(defn sh08-mc-binding? [binding module]
  (if (if (vector? (get binding :profile-set)) (vector? (get binding :target-set)) false)
  (sh08-ft-all-true?
    [(= ['contains? :core :var 'gravity.core {:name 'gravity/core :version "bootstrap-contract-v1"} :gravity.type/core-var :safe]
        [(get binding :name) (get binding :binding-class) (get binding :kind) (get binding :namespace)
         (get binding :package) (get binding :type-ref) (get binding :safety)])
     (= [] (get binding :effects) (get binding :capabilities))
     (contains? (set (get binding :profile-set)) (get module :profile))
     (contains? (set (get binding :target-set)) :all)]) false))

(defn sh08-mc-source [core node call edge nodes bindings types module]
  (if (if (vector? (get call :argument-node-ids)) (vector? (get node :children)) false)
  (let [children (get node :children) operator (get nodes (get call :operator-node-id))
        bid (get call :operator-binding-id) binding (get bindings bid) args (get call :argument-node-ids)
        arguments (sh08-ft-ordered-child-types args types)
        invoked? (loop [remaining arguments]
                   (if (= 0 (count remaining)) true
                     (if (= :gravity.type/never (first remaining)) false (recur (rest remaining)))))
        caller (loop [remaining (get core :function-records)]

            {:status :rejected :reason :unsupported-loop-member-grounding}))))
    {:status :rejected :reason :unsupported-loop-member-grounding}))

(defn sh08-lsi-vector-first [node binding env seen]
  (let [input (sh08-lsi-first-call-input node env)]
    (if (= :accepted (get input :status))
      (let [arg (get input :argument)
            owner (get input :owner)
            attrs (get arg :attributes)
            children (get arg :children)
            forms (get env :forms)
            nodes (get env :nodes)
            types (get env :types)
            arg-id (get arg :node-id)
            arg-type (get types arg-id :gravity.type/unknown)]
        (if (if (= :collection-literal (get arg :core-form))
              (if (> (count children) 0)
                (if (= :vector (get owner :kind))
                  (if (vector? (get owner :value))
                    (if (vector? (get attrs :source-value))
                      (if (= (count children) (count (get owner :value)))
                        (= (count children) (count (get owner :child-form-ids)))
                        false)
                      false)
                    false)
                  false)
                false)
              false)
          (let [ids (get owner :child-form-ids)
                scanned
                (loop [i 0 out []]
                  (if (= i (count children))
                    {:status :accepted :types out}
                    (let [child-id (get children i)
                          source-id (if (< i (count ids)) (get ids i) nil)
                          child (if (sh08-lsi-id? child-id) (get nodes child-id) nil)
                          source (if (sh08-lsi-id? source-id) (get forms source-id) nil)
                          raw (sh08-lsi-first-data
                               [(sh08-lsi-first-node-data child)
                                (sh08-lsi-first-form-data source)])]
                      (if (= :accepted (get raw :status))
                        (if (if (sh08-lsi-first-node? child)
                              (sh08-lsi-first-form? source)
                              false)
                          (if (= (get owner :form-id) (get source :parent-form-id))
                            (if (if (= (get child :source) (sh08-ma-form-source source))
                                  (= (get (get owner :value) i) (get source :value))
                                  false)
                              (recur (+ i 1)
                                     (conj out (get types child-id :gravity.type/unknown)))
                              {:status :rejected :reason :unsupported-loop-member-grounding})
                            {:status :rejected :reason :unsupported-loop-member-grounding})
                          {:status :rejected :reason :unsupported-loop-member-grounding})
                        raw))))
                cold-type {:kind :gravity.type/vector
                           :shape :literal
                           :element-types (get scanned :types)}
                actual (sh08-lc-validate-types [arg-type])
                cold (sh08-lc-validate-types [cold-type])]
            (if (= :accepted (get scanned :status))
              (if (if (= :accepted (get actual :status))
                    (= :accepted (get cold :status))
                    false)
                (let [raw (sh08-lsi-first-data [arg-type cold-type])]
                  (if (= :accepted (get raw :status))
                    (if (if (= cold-type arg-type)
                          (if (= :vector (get owner :kind))
                            (if (= (count children) (count ids))
                              (if (vector? (get attrs :source-value))
                                (if (vector? (get owner :value))
                                  (if (= (count children) (count (get owner :value)))
                                    (if (= (get attrs :source-value) (get owner :value))
                                      (if (= (get arg :source) (sh08-ma-form-source owner))
                                        (if (= [] (get arg :resolved-binding-ids))
                                          (if (= :left-to-right (get (get arg :evaluation) :kind))
                                            (= (get (get arg :evaluation) :order)
                                               (loop [i 0 out []]
                                                 (if (= i (count children))
                                                   out
                                                   (recur (+ i 1)
                                                          (conj out {:index i :core-node-id (get children i)})))))
                                            false)
                                          false)
                                        false)
                                      false)
                                    false)
                                  false)
                                false)
                              false)
                            false)
                          false)
                        (if (contains? seen arg-id)
                          {:status :rejected :reason :circular-loop-member-grounding}
                          (let [head (sh08-lsi-path-from-seen (get children 0) :literal-head
                                                              binding env (conj seen arg-id))
                                caller (sh08-lsi-first-caller
                                        (get (get env :core) :function-records)
                                        (get (get node :evaluation) :owner-function-syntax-id))
                                header (if (= :accepted (get head :status))
                                         (if (= :accepted (get caller :status))
                                           (sh08-lq-source (get env :core) node (get input :call)
                                             (get input :edge) nodes (get env :bindings) types
                                             (get (get env :core) :module) actual)
                                           nil)
                                         nil)
                                descriptor (if (map? header) (sh08-lq-finish header) nil)
                                compared (sh08-lsi-first-data
                                          (get types (get (get input :call) :operator-node-id)))]
                            (if (if (if (= :accepted (get head :status))
                                        (= :accepted (get caller :status))
                                        false)
                                  (= :accepted (get compared :status))
                                  false)
                              (if (if (= :sh08-vector-first-v1 (get descriptor :version))
                                    (if (= :normal (get descriptor :application))
                                      (if (= :gravity.type/symbol (get descriptor :result-type))
                                        (if (sh08-si-call-forms? node nodes forms)
                                          (= descriptor
                                             (get types (get (get input :call)
                                                             :operator-node-id)))
                                          false)
                                        false)
                                      false)
                                    false)
                                {:status :accepted
                                 :path (sh08-lsi-first-append [arg-id] (get head :path))
                                 :leaf (get head :leaf)}
                                {:status :rejected :reason :unsupported-loop-member-grounding})
                              {:status :rejected :reason :unsupported-loop-member-grounding})))
                    {:status :rejected :reason :unsupported-loop-member-grounding})
                    {:status :rejected :reason :unsupported-loop-member-grounding}))
                {:status :rejected :reason :unsupported-loop-member-grounding})
              {:status :rejected :reason :unsupported-loop-member-grounding}))
          {:status :rejected :reason :unsupported-loop-member-grounding}))
      {:status :rejected :reason :unsupported-loop-member-grounding})))
(defn sh08-lsi-path-from-seen [start mode binding env initial-seen]
  (loop [id start path [] seen initial-seen]
    (if (sh08-lsi-id? id)
      (if (contains? seen id)
        {:status :rejected :reason :circular-loop-member-grounding}
        (let [node (get (get env :nodes) id)
              kind (get node :core-form)
              actual-type (get (get env :types) id :gravity.type/unknown)
              bid (get (get node :attributes) :binding-id)
              aliases (get env :aliases)
              record (if (sh08-lsi-id? bid) (get aliases bid) nil)
              next-path (conj path id)]
          (if (if (if (= mode :member) true (= mode :literal-head))
                (= :gravity.type/symbol actual-type)
                (if (= mode :result) (sh08-syc-type? actual-type)
                  (if (= mode :initializer) (sh08-lsi-empty? actual-type)
                    (if (sh08-lsi-empty? actual-type) true (sh08-syc-type? actual-type)))))
            (if (if (keyword? kind) (if (sh08-lsi-id? (get node :node-id)) (= id (get node :node-id)) false) false)
              (if (if (= mode :result) (= kind :call) false)
                {:status :accepted :path next-path :leaf id}
                (if (if (= mode :member) (= :call kind) false)
                  (let [first (sh08-lsi-vector-first node binding env (conj seen id))]
                    (if (= :accepted (get first :status))
                      (assoc first :path (sh08-lsi-first-append next-path (get first :path)))
                      first))
                  (if (= kind :reference)
                    (if (if (if (if (= mode :member) true (= mode :literal-head))
                                (sh08-lsi-first-reference? node env) true)
                          (if (sh08-lsi-id? bid)
                            (if (sh08-lsi-id? (get (get node :source) :form-id))
                              (let [form (get (get env :forms) (get (get node :source) :form-id))
                                    source-binding (get (get env :bindings) bid)]
                                (if (= [bid] (get node :resolved-binding-ids))
                                  (if (= (get node :binding-context) (get form :scope-id))
                                    (if (symbol? (get form :value))
                                      (if (symbol? (get source-binding :name))
                                        (= (get form :value) (get source-binding :name)) false)
                                      false)
                                    false)
                                  false))
                              false)
                            false)
                          false)
                      (if (if (= mode :receiver) (= bid binding) false)
                        {:status :accepted :path next-path :leaf id :origin :slot}
                        (if (if (map? record)
                              (if (if (sh08-lsi-id? (get record :initializer-node-id))
                                    (if (sh08-lsi-id? (get record :definition-syntax-id))
                                      (if (sh08-lsi-id? (get record :binding-scope-id))
                                        (= :immutable (get record :mutability)) false)
                                      false)
                                    false)
                                (if (= bid (get record :binding-id))
                                  (let [source-binding (get (get env :bindings) bid)
                                        initializer (get (get env :nodes) (get record :initializer-node-id))]
                                    (if (= (get record :definition-syntax-id)
                                           (get source-binding :definition-syntax-id))
                                      (if (= (get record :binding-scope-id) (get source-binding :scope-id))
                                        (if (= (get record :initializer-form-id)
                                               (get (get initializer :source) :form-id))
                                          (= (get record :initializer-syntax-id)
                                             (get (get initializer :source) :syntax-id))
                                          false)
                                        false)
                                      false))
                                  false)
                                false)
                              false)
                          (recur (get record :initializer-node-id) next-path (conj seen id))
                          {:status :rejected :reason :ungrounded-loop-member-reference}))
                        {:status :rejected :reason :incoherent-loop-member-reference})
                      (if (if (= mode :result) false
                            (if (= mode :literal-head)
                              (sh08-lsi-first-head? node (get env :forms))
                              (sh08-lsi-leaf? node (get env :forms) mode)))
                        {:status :accepted :path next-path :leaf id}
                        {:status :rejected :reason :unsupported-loop-member-grounding}))))
              {:status :rejected :reason :incoherent-loop-member-source})
            {:status :rejected :reason :unknown-loop-member-grounding})))
      {:status :rejected :reason :incoherent-loop-member-source})))

(defn sh08-lsi-path [start mode binding env]
  (sh08-lsi-path-from-seen start mode binding env #{}))

(defn sh08-lsi-insertion [env node call edge types]
  (let [core (get env :core) args (get call :argument-node-ids)]
    (if (if (sh08-sse-call-ids? node call)
          (if (vector? args) (if (= 2 (count args))
            (if (vector? (get node :children)) (= 3 (count (get node :children))) false) false) false) false)
      (let [validation (sh08-syin-validate-types [(get types (get args 0) :gravity.type/unknown)
                                                   (get types (get args 1) :gravity.type/unknown)])]
        (if (= :accepted (get validation :status))
          (let [header (sh08-pl-source core node call edge (get env :nodes) (get env :bindings)
                                       types (get core :module) validation)]
            (if (if (map? header)
                  (if (sh08-ksin-call-forms? node (get env :nodes) (get env :forms))
                    (= {:operator-child-index 0 :argument-count 2 :argument-child-indexes [1 2]
                        :evaluation-order :operator-then-arguments :dispatch :resolved-symbol-call}
                       (get node :attributes)) false) false)
              (let [descriptor (sh08-pl-finish header)]
                {:status :accepted :type (get descriptor :result-type) :descriptor descriptor})
              {:status :rejected :reason :unsupported-loop-member-grounding}))
          {:status :rejected :reason :unsupported-loop-member-grounding}))
      {:status :rejected :reason :unsupported-loop-member-grounding})))

(defn sh08-lsi-ground [transfer coordinate binding env]
  (let [argument (get (get transfer :argument-node-ids) coordinate)
        result (sh08-lsi-path argument :result binding env)
        node (get (get env :nodes) (get result :leaf))
        call (get (get env :calls) (get result :leaf))
        edge (get (get env :edges) (get result :leaf))
        args (get call :argument-node-ids)]
    (if (= :accepted (get result :status))
      (if (if (vector? args) (= 2 (count args)) false)
        (let [receiver (sh08-lsi-path (get args 0) :receiver binding env)]
          (if (= :accepted (get receiver :status))
            (let [member (sh08-lsi-path (get args 1) :member binding env)]
              (if (= :accepted (get member :status))
                (let [warm (sh08-lsi-insertion env node call edge (get env :types))
                      descriptor (get warm :descriptor)
                      actual (get (get env :types) (get call :operator-node-id))
                      coherent (if (map? actual)
                                 (if (= (count descriptor) (count actual))
                                   (if (loop [fields (keys actual)]
                                         (if (= 0 (count fields)) true
                                           (if (keyword? (first fields))
                                             (recur (rest fields)) false)))
                                     (if (= :sh08-symbol-set-insertion-v2 (get actual :version))
                                       (if (= descriptor actual) (sh08-syc-type? (get warm :type)) false)
                                       false)
                                     false)
                                   false)
                                 false)]
                  (if (if (= :accepted (get warm :status)) coherent false)
                    (let [empty-type {:kind :gravity.type/set :shape :literal :element-types []}
                          cold-types (assoc (assoc (get env :types) (get args 0) empty-type)
                                            (get args 1) :gravity.type/symbol)
                          cold (sh08-lsi-insertion env node call edge cold-types)
                          cold-descriptor (get cold :descriptor)]
                      (if (if (= :accepted (get cold :status))
                            (if (= :sh08-symbol-set-insertion-v2 (get cold-descriptor :version))
                              (= :normal (get cold-descriptor :application)) false) false)
                        {:status :accepted :grounding
                         {:schema :gravity/sh08-loop-symbol-set-grounding-v2
                          :transfer-node-id (get transfer :recur-core-node-id)
                          :argument-node-id argument :producer-node-id (get node :node-id)
                          :receiver-path (get receiver :path) :member-path (get member :path)
                          :result-path (get result :path) :receiver-type empty-type
                          :member-type :gravity.type/symbol :result-type (get cold-descriptor :result-type)}}
                        {:status :rejected :reason :unsupported-loop-member-grounding}))
                    {:status :rejected :reason :unsupported-loop-member-grounding}))
                member))
            receiver))
        {:status :rejected :reason :unsupported-loop-member-grounding})
      result)))

(defn sh08-lsi-entry-index [transfers types]
  (loop [remaining transfers out {}]
    (if (= 0 (count remaining)) {:status :accepted :index out}
      (let [transfer (first remaining) args (get transfer :argument-node-ids) target (get transfer :target-id)]
        (if (if (vector? args) (sh08-lsi-id? target) false)
          (let [actual (loop [ids args values []]
                         (if (= 0 (count ids)) values
                           (recur (rest ids)
                                  (conj values (if (sh08-lsi-id? (first ids))
                                                 (get types (first ids) :gravity.type/unknown)
                                                 :gravity.type/unknown)))))
                normal (loop [values actual]
                         (if (= 0 (count values)) true
                           (if (= :gravity.type/never (first values)) false
                             (recur (rest values)))))
                known (loop [values actual]
                        (if (= 0 (count values)) true
                          (if (= :gravity.type/unknown (first values)) false
                            (if (= nil (first values)) false (recur (rest values))))))]
            (recur (rest remaining)
                   (assoc out target
                     (conj (get out target [])
                           {:transfer transfer :types actual :normal? normal :known? known}))))
          {:status :rejected :reason :incoherent-loop-member-source})))))

(defn sh08-lsi-slot [record target entries env]
  (let [binding (get record :binding-id) coordinate (get record :ordinal)
        empty-type (get (get env :types) (get record :initializer-node-id))
        carrier {:kind :gravity.type/set :shape :homogeneous :element-type :gravity.type/symbol}
        initializer (sh08-lsi-path (get record :initializer-node-id) :initializer binding env)]
    (if (if (= :accepted (get initializer :status)) (= false (= :slot (get initializer :origin))) false)
      (loop [remaining entries witness nil evidence [] pending false conflict nil]
        (if (= 0 (count remaining))
          (if (if (map? witness) (= false pending) false)
            (if (= conflict nil)
              (let [invariant {:schema :gravity/sh08-loop-symbol-set-invariant-v2
                               :target-id (get target :target-id) :binding-id binding
                               :initializer-node-id (get record :initializer-node-id)
                               :initializer-type empty-type :invariant-type carrier
                               :grounding witness :entries evidence}
                    measured (sh08-pc-evidence-work invariant)]
                (if (= :accepted (get measured :status))
                  {:status :accepted :invariant invariant}
                  measured))
              {:status :rejected :reason :loop-recur-slot-type-mismatch
               :core-node-id (get conflict :argument-node-id) :parameter-binding-id binding
               :expected carrier :actual (get conflict :argument-type)})
            {:status :accepted})
          (let [entry (first remaining) transfer (get entry :transfer)
                actual (get (get entry :types) coordinate) normal (get entry :normal?)
                compatible (if (= actual :gravity.type/never) true
                             (if (sh08-lsi-empty? actual) true (sh08-syc-type? actual)))
                proof (if (if (= witness nil) (if normal (if (get entry :known?)
                                                           (sh08-syc-type? actual) false) false) false)
                        (sh08-lsi-ground transfer coordinate binding env)
                        {:status :accepted})
                row {:transfer-node-id (get transfer :recur-core-node-id)
                     :argument-node-id (get (get transfer :argument-node-ids) coordinate)
                     :argument-type actual :normal-transfer? normal
                     :compatibility (if (= false normal) :existing-noninvoked-transfer-rules
                       (if (sh08-lsi-empty? actual) :empty-set-to-symbol-carrier :exact-carrier))}]
            (if (= :accepted (get proof :status))
              (recur (rest remaining) (if (map? (get proof :grounding))
                                        (get proof :grounding) witness)
                     (conj evidence row) (if (= false (get entry :known?)) true pending)
                     (if (if normal (if (get entry :known?) (= false compatible) false) false)
                       row conflict))
              proof))))
      {:status :accepted})))

(defn sh08-lsi-solve [core types source]
  (if (= 0 (count (get core :loop-bindings)))
    {:status :accepted :invariants {}}
    (if (if (map? (get source :forms)) (map? (get source :bindings)) false)
      (let [alias-result (sh08-lsi-index (get core :lexical-bindings []) :binding-id)
            call-result (sh08-lsi-index (get core :calls []) :core-node-id)
            edge-result (sh08-lsi-index (get core :call-edges []) :call-core-node-id)
            target-result (sh08-lsi-index (get core :recur-targets []) :owner-core-node-id)
            aliases (get alias-result :index) calls (get call-result :index)
            edges (get edge-result :index) targets (get target-result :index)
            entries (sh08-lsi-entry-index (get core :recur-transfers []) types)
            env {:core core :types types :nodes (get source :nodes) :forms (get source :forms)
                 :bindings (get source :bindings) :aliases aliases :calls calls :edges edges}]
        (if (if (= :accepted (get alias-result :status))
              (if (= :accepted (get call-result :status))
                (if (= :accepted (get edge-result :status))
                  (if (= :accepted (get target-result :status)) (= :accepted (get entries :status)) false)
                  false) false) false)
          (loop [remaining (get core :loop-bindings) out {}]
            (if (= 0 (count remaining))
              (if (if (= true (get source :warm?)) (> (count out) 0) false)
                (let [reads (sh08-lsi-reads core types out)]
                  (if (= :accepted (get reads :status)) reads reads))
                {:status :accepted :invariants out})
              (let [record (first remaining) type (get types (get record :initializer-node-id))
                    target (get (get targets :index) (get record :loop-core-node-id))
                    checked (if (sh08-lsi-empty? type)
                              (sh08-lsi-slot record target
                                             (get (get entries :index) (get target :target-id) []) env)
                              {:status :accepted})]
                (if (= :accepted (get checked :status))
                  (recur (rest remaining)
                         (if (map? (get checked :invariant))
                           (assoc out (get record :binding-id) (get checked :invariant)) out))
                  checked))))
          {:status :rejected :reason :incoherent-loop-member-source}))
      {:status :accepted :invariants {}})))

(defn sh08-lsi-reads [core types invariants]
  (loop [remaining (get core :nodes)]
    (if (= 0 (count remaining)) {:status :accepted}
      (let [node (first remaining) binding (get (get node :attributes) :binding-id)
            invariant (if (= :reference (get node :core-form))
                        (if (sh08-lsi-id? binding) (get invariants binding) nil) nil)]
        (if (if (map? invariant)
              (= false (sh08-syc-type? (get types (get node :node-id)))) false)
          {:status :rejected :reason :incoherent-loop-member-reference}
          (recur (rest remaining)))))))

(defn sh08-lsi-target-bindings [target invariants]
  (loop [remaining (get target :binding-ids) out []]
    (if (= 0 (count remaining)) out
      (recur (rest remaining) (if (contains? invariants (first remaining)) (conj out (first remaining)) out)))))

(defn sh08-lsi-compatible? [actual expected]
  (if (sh08-syc-type? expected)
    (if (= :gravity.type/never actual) true
      (if (sh08-lsi-empty? actual) true (sh08-syc-type? actual))) false))

(defn sh08-ft-loop-kernel-known? [type]
  (if (= type nil) false (= false (= type :gravity.type/unknown))))

(defn sh08-ft-loop-kernel-indexes [start end]
  (loop [index start out []]
    (if (>= index end) out (recur (+ index 1) (conj out index)))))

(defn sh08-ft-loop-kernel-append [out values]
  (loop [remaining values out out]
    (if (= 0 (count remaining)) out (recur (rest remaining) (conj out (first remaining))))))

; L5 canonical-if fallback: branch evidence supplies T, never an expected return.
(defn sh08-ni-atomic? [type]
  (contains? #{:gravity.type/bool :gravity.type/character :gravity.type/string :gravity.type/symbol :gravity.type/keyword} type))

(defn sh08-ni-tagged? [type]
  (if (map? type) (= :gravity.type/nil-or (get type :kind)) false))

(defn sh08-ni-type? [type]
  (if (sh08-ni-tagged? type)
    (if (= 2 (count type))
      (if (= #{:kind :value-type} (set (keys type))) (sh08-ni-atomic? (get type :value-type)) false) false) false))

(defn sh08-ni-valid-view? [type]
  (if (sh08-ni-tagged? type) (sh08-ni-type? type) true))

(defn sh08-ni-candidate? [left right]
  (if (= :gravity.type/nil left) true
    (if (= :gravity.type/nil right) true
      (if (sh08-ni-tagged? left) true (sh08-ni-tagged? right)))))

(defn sh08-ni-branch [type]
  (if (= :gravity.type/nil type) {:relation :nil-alternative :value-type nil}
    (if (sh08-ni-atomic? type) {:relation :atomic-alternative :value-type type}
      (if (sh08-ni-type? type) {:relation :nil-or-identity :value-type (get type :value-type)} nil))))

(defn sh08-ni-type-join [left right]
  (let [a (sh08-ni-branch left) b (sh08-ni-branch right)
        x (get a :value-type) y (get b :value-type) value (if (= x nil) y x)]
    (if (if (sh08-ni-candidate? left right)
          (if (map? a) (if (map? b)
            (if (= value nil) false (if (= x nil) true (if (= y nil) true (= x y)))) false) false) false)
      {:status :accepted :join-family :nil-or :type {:kind :gravity.type/nil-or :value-type value}
       :branch-types [left right] :branch-compatibility [a b] :nil-type :gravity.type/nil :value-type value}
      {:status :not-applicable :reason :independent-nil-or-atomic-required})))

(defn sh08-ij-atomic? [type]
  (if (keyword? type)
    (sh08-hl-type? {:kind :gravity.type/list :shape :homogeneous :element-type type}) false))

(defn sh08-ij-element [type]
  (let [members (if (map? type) (get type :element-types) nil)
        finite? (if (map? type)
                  (if (= 3 (count type))
                    (if (= #{:kind :shape :element-types} (set (keys type)))
                      (= [:gravity.type/list :literal] [(get type :kind) (get type :shape)]) false) false) false)
        width (if (if finite? (vector? members) false) (count members) 0)]
    (if (if (map? type) (keyword? (get type :element-type)) false)
      (if (sh08-hl-type? type)
        {:status :accepted :element-type (get type :element-type) :relation :homogeneous-list-identity
         :checked-member-count nil}
        {:status :not-applicable :reason :independent-list-element-required})
      (if (if finite? (vector? members) false)
        (if (= width 0)
          {:status :accepted :element-type nil :relation :empty-positional-list :checked-member-count 0}
          (let [element (first members)]
            (if (sh08-ij-atomic? element)
              (if (loop [remaining members]
                    (if (= 0 (count remaining)) true
                      (if (= element (first remaining)) (recur (rest remaining)) false)))
                {:status :accepted :element-type element :relation :all-positional-elements-match
                 :checked-member-count width}
                {:status :not-applicable :reason :incompatible-list-elements})
              {:status :not-applicable :reason :independent-atomic-element-required})))
        {:status :not-applicable :reason :independent-list-element-required}))))

(defn sh08-ij-type-join [left right]
  (if (sh08-ni-candidate? left right)
    (sh08-ni-type-join left right)
  (let [a (sh08-ij-element left)
        b (if (= :accepted (get a :status)) (sh08-ij-element right) nil)]
    (if (= :rejected (get a :status)) a
      (if (= :accepted (get a :status))
        (if (= :rejected (get b :status)) b
          (if (= :accepted (get b :status))
            (let [x (get a :element-type) y (get b :element-type)
                  element (if (= x nil) y x)]
              (if (if (= element nil) false (if (= x nil) true (if (= y nil) true (= x y))))
                {:status :accepted :type {:kind :gravity.type/list :shape :homogeneous :element-type element}
                 :branch-types [left right]
                 :branch-compatibility [(sh08-bm-project a [:element-type :relation :checked-member-count])
                                        (sh08-bm-project b [:element-type :relation :checked-member-count])]
                 :element-type element}
                {:status :not-applicable :reason :incompatible-independent-list-elements}))
            {:status :not-applicable :reason (get b :reason)}))
        {:status :not-applicable :reason (get a :reason)})))))

(defn sh08-ij-normal-type [left right]
  (if (if (sh08-ni-valid-view? left) (sh08-ni-valid-view? right) false)
  (if (= left right) left
    (if (= left :gravity.type/never) right
      (if (= right :gravity.type/never) left
        (get (sh08-ij-type-join left right) :type :gravity.type/unknown)))) :gravity.type/unknown))

(defn sh08-ij-derive [core node nodes types bindings forms]
  (let [children (get node :children)]
    (if (if (= :if (get node :core-form)) (if (vector? children) (= 3 (count children)) false) false)
      (let [condition (get types (first children) :gravity.type/unknown)
            left (get types (get children 1) :gravity.type/unknown)
            right (get types (get children 2) :gravity.type/unknown)]
        (if (if (= condition :gravity.type/never) true
              (if (sh08-ft-unknown? condition) true
                (if (= left right) true
                  (if (= left :gravity.type/never) true (= right :gravity.type/never)))))
          {:status :not-applicable}
          (let [validation (sh08-ij-type-join left right)]
                (if (= :accepted (get validation :status))
                  (let [owner (get (get node :evaluation) :owner-function-syntax-id)
                        function (loop [remaining (get core :function-records)]
                                   (if (= 0 (count remaining)) nil
                                     (if (= owner (get (first remaining) :function-syntax-id))
                                       (first remaining) (recur (rest remaining)))))
                        binding (get bindings (get function :definition-binding-id))
                        form (get forms (get (get node :source) :form-id))
                        ids (get form :child-form-ids)
                        operator (get forms (get ids 0))
                        control {:core-node-id (get node :node-id) :kind :if :condition-node-id (first children)
                                 :branches [{:role :then :predicate :truthy :core-node-id (get children 1)}
                                            {:role :else :predicate :falsey :core-node-id (get children 2)}]
                                 :branch-exclusivity :exactly-one
                                 :truthiness {:false-values [:nil :false] :other-values :true}
                                 :result-policy :selected-branch}
                        controls (loop [remaining (get core :control-flow) out []]
                                   (if (= 0 (count remaining)) out
                                     (recur (rest remaining)
                                       (if (= (get node :node-id) (get (first remaining) :core-node-id))
                                         (conj out (first remaining)) out))))
                        branch-nodes (loop [remaining children out []]
                                       (if (= 0 (count remaining)) out
                                         (recur (rest remaining) (conj out (get nodes (first remaining))))))
                        branch-bindings
                        (loop [remaining branch-nodes out []]
                          (if (= 0 (count remaining))
                            out
                            (recur
                             (rest remaining)
                             (conj
                              out
                              (loop [ids (if (vector? (get (first remaining) :resolved-binding-ids))
                                           (get (first remaining) :resolved-binding-ids) [])
                                     records []]
                                (if (= 0 (count ids))
                                  records
                                  (recur
                                   (rest ids)
                                   (conj records (get bindings (first ids))))))))))]
                    (if (sh08-ft-all-true?
                          [(map? function) (= owner (get function :function-syntax-id))
                           (= (get function :definition-binding-id) (get binding :binding-id))
                           (= (get function :definition-name) (get binding :name))
                           (= [:namespace :function (get (get core :module) :namespace)]
                              [(get binding :binding-class) (get binding :kind) (get binding :namespace)])
                           (= :list (get form :kind)) (vector? ids) (= 4 (count ids))
                           (= :symbol (get operator :kind)) (= 'if (get operator :value))
                           (= (get form :form-id) (get operator :parent-form-id))
                           (= (sh08-lr-source form) (get node :source))
                           (= [] (get node :resolved-binding-ids))
                           (= {:condition-child-index 0 :then-child-index 1 :else-child-index 2 :condition-evaluation :always-first
                               :branch-evaluation :exactly-one :truthiness {:false-values [:nil :false] :other-values :true}} (get node :attributes))
                           (= :condition-then-exclusive-branch (get (get node :evaluation) :kind))
                           (= [{:index 0 :core-node-id (first children)}] (get (get node :evaluation) :order))
                           (= [control] controls)
                           (loop [i 0]
                             (if (= i 3) true
                               (let [child (get branch-nodes i) source (get forms (get ids (+ i 1)))
                                     references (get child :resolved-binding-ids) records (get branch-bindings i)]
                                 (if (sh08-ft-all-true?
                                       [(= (get child :node-id) (get children i))
                                        (= (sh08-lr-source source) (get child :source))
                                        (= (get form :form-id) (get source :parent-form-id))
                                        (= owner (get (get child :evaluation) :owner-function-syntax-id))
                                        (vector? references) (= references (loop [rows records out []]
                                                                            (if (= 0 (count rows)) out
                                                                              (recur (rest rows) (conj out (get (first rows) :binding-id))))))])
                                   (recur (+ i 1)) false))))])
                      {:status :accepted :type (get validation :type)
                       :premise (let [premise {:version :sh08-list-if-join-v1 :relation :independent-homogeneous-list-join
                                 :if-core-node-id (get node :node-id) :source-node node
                                 :function-record function :definition-binding binding
                                 :condition-type condition :branch-types [left right]
                                 :branch-node-ids [(get children 1) (get children 2)]
                                 :child-sources (loop [remaining branch-nodes out []]
                                                  (if (= 0 (count remaining)) out
                                                    (recur (rest remaining) (conj out (get (first remaining) :source)))))
                                 :child-bindings branch-bindings :source-form (sh08-lr-source form)
                                 :operator-source (sh08-lr-source operator) :control-flow control
                                 :branch-compatibility (get validation :branch-compatibility)
                                 :result-type (get validation :type)
                                 :expected-return-premise :none :runtime-conversion :none
                                 :preserves [:actual-branch-types :source :bindings :value :ownership :linearity :regions :effects]
                                 :profile (get (get core :module) :profile) :target (get (get core :module) :target)}]
                         (if (= :nil-or (get validation :join-family))
                           (assoc premise :version :sh08-nil-if-join-v1
                             :relation :independent-nil-or-atomic-join :nil-type :gravity.type/nil :value-type (get validation :value-type))
                           (assoc premise :element-type (get validation :element-type))))}
                      {:status :rejected :reason :list-if-join-source-mismatch}))
                  validation))))
      {:status :not-applicable})))

(defn sh08-ij-row [premise]
  {:constraint-id-request {:domain (if (= :sh08-nil-if-join-v1 (get premise :version))
                                     :gravity/sh08-nil-if-join-constraint-v1 :gravity/sh08-list-if-join-constraint-v1)
                            :join-compatibility premise}
   :kind :join-compatibility :producer-rule (if (= :sh08-nil-if-join-v1 (get premise :version))
                                            :sh08-nil-if-join-v1 :sh08-list-if-join-v1)
   :lhs {:core-node-id (get premise :if-core-node-id) :role :canonical-if-result}
   :rhs {:actual-branch-types (get premise :branch-types) :result-type (get premise :result-type)}
   :dependencies premise :solution {:result-type (get premise :result-type)}
   :invalidation [:source-forms :if-node :control-flow :branch-nodes :branch-types :source-bindings
                  :function-records :definition-binding :profile :target]
   :profile (get premise :profile) :target (get premise :target) :status :solved :diagnostics []})

(defn sh08-ft-loop-kernel-normal-join [types]
  (loop [remaining types chosen :gravity.type/never]
    (if (= 0 (count remaining)) chosen
      (let [type (first remaining)]
        (if (sh08-ft-loop-kernel-known? type)
          (if (= type :gravity.type/never) (recur (rest remaining) chosen)
            (if (= chosen :gravity.type/never) (recur (rest remaining) type)
              (if (= chosen type) (recur (rest remaining) chosen) :gravity.type/unknown)))
          :gravity.type/unknown)))))

(defn sh08-ft-normal-return-type [form child-types nominal]
  (if (vector? child-types)
    (if (= form :fn) nominal
      (if (= form :if)
        (if (= 3 (count child-types))
          (if (= :gravity.type/never (first child-types)) :gravity.type/never
            (sh08-ij-normal-type (get child-types 1) (get child-types 2))) :gravity.type/unknown)
        (if (contains? #{:alternatives :try} form) (if (= 0 (count child-types)) nominal (sh08-ft-loop-kernel-normal-join child-types))
          (loop [remaining child-types]
            (if (= 0 (count remaining)) nominal
              (if (= :gravity.type/never (first remaining)) :gravity.type/never
                (recur (rest remaining)))))))) :gravity.type/unknown))

(defn sh08-ft-loop-kernel-failure [reason node expected actual]
  {:status :rejected
   :issues [{:rule "C7-VERIFY" :reason reason :core-node-id node
             :expected expected :actual actual}]})

(defn sh08-ft-loop-kernel-index-records [records field]
  (if (vector? records)
    (loop [remaining records index {}]
      (if (= 0 (count remaining))
        {:status :accepted :index index}
        (let [record (first remaining) id (get record field)]
          (if (if (map? record)
                (if (= id nil) false (= false (contains? index id))) false)
            (recur (rest remaining) (assoc index id record))
            (sh08-ft-loop-kernel-failure :invalid-loop-record-index
              nil :unique-nonmissing-record-key field)))))
    (sh08-ft-loop-kernel-failure :invalid-loop-record-index nil :vector records)))

(defn sh08-ft-loop-kernel-parent-index [records nodes]
  (if (vector? records)
    (loop [remaining records pending [] owner nil ordinal 0 parents {}
           target-count 0 transfer-count 0]
      (if (if (= 0 (count remaining)) (= 0 (count pending)) false)
        {:status :accepted :index parents :target-count target-count
         :transfer-count transfer-count}
        (if (= 0 (count pending))
          (let [node (first remaining)]
            (if (vector? (get node :children))
              (recur (rest remaining) (get node :children) (get node :node-id) 0
                parents (+ target-count (if (contains? #{:fn :loop} (get node :core-form)) 1 0))
                (+ transfer-count (if (= :recur (get node :core-form)) 1 0)))
              (sh08-ft-loop-kernel-failure :invalid-loop-core-children
                (get node :node-id) :vector (get node :children))))
          (let [id (first pending)]
            (if (if (contains? nodes id) (= false (contains? parents id)) false)
              (recur remaining (rest pending) owner (+ ordinal 1)
                (assoc parents id {:owner owner :ordinal ordinal})
                target-count transfer-count)
              (sh08-ft-loop-kernel-failure :invalid-loop-parent-edge
                id :unique-existing-child owner))))))
    (sh08-ft-loop-kernel-failure :invalid-loop-core-children nil :vector records)))

(defn sh08-ft-loop-kernel-nearest-target [id nodes parents owners]
  (loop [current id seen #{}]
    (let [edge (get parents current)]
      (if (= edge nil)
        {:status :accepted :target nil}
        (if (contains? seen current)
          (sh08-ft-loop-kernel-failure :cyclic-loop-parent-edge current :acyclic-core nil)
          (let [owner (get nodes (get edge :owner))
                kind (get owner :core-form)
                body (get (get owner :attributes) :body-child-indexes)
                target (get owners (get owner :node-id))]
            (if (if (= kind :fn) true
                  (if (= kind :loop)
                    (if (vector? body)
                      (contains? (set body) (get edge :ordinal)) false)
                    false))
              (if (map? target)
                {:status :accepted :target target}
                (sh08-ft-loop-kernel-failure :missing-nearest-recur-target
                  (get owner :node-id) :original-target-record nil))
              (recur (get owner :node-id) (conj seen current)))))))))

(defn sh08-ft-loop-kernel-ordered-children? [node]
  (let [children (get node :children) order (get (get node :evaluation) :order)]
    (if (if (vector? children) (vector? order) false)
      (if (= (count children) (count order))
        (loop [index 0]
          (if (= index (count children)) true
            (if (= [(get children index) index]
                   [(get (get order index) :core-node-id)
                    (get (get order index) :index)])
              (recur (+ index 1)) false)))
        false)
      false)))

(defn sh08-ft-loop-kernel-prepare [core]
  (let [fields [:nodes :loop-bindings :recur-targets :recur-transfers :binding-table]
        key-fields [:node-id :binding-id :target-id :recur-core-node-id :binding-id]]
    (loop [fields fields key-fields key-fields indexes []]
      (if (= 0 (count fields))
        (let [nodes (get indexes 0)
              targets (get indexes 2)
              owner-records (loop [ids (keys targets) out []]
                              (if (= 0 (count ids)) out
                                (recur (rest ids)
                                  (conj out (get targets (first ids))))))
              owners (sh08-ft-loop-kernel-index-records owner-records :owner-core-node-id)
              parents (if (= :accepted (get owners :status))
                        (sh08-ft-loop-kernel-parent-index (get core :nodes) nodes)
                        owners)]
          (if (= :accepted (get parents :status))
            (if (= [(count targets) (count (get indexes 3))]
                   [(get parents :target-count) (get parents :transfer-count)])
              {:status :accepted :nodes nodes :bindings (get indexes 1)
               :source-bindings (get indexes 4) :targets targets
               :owners (get owners :index) :transfers (get indexes 3)
               :parents (get parents :index)}
              (sh08-ft-loop-kernel-failure :incomplete-loop-control-coverage
                nil :all-target-and-transfer-nodes nil))
            parents))
        (let [records (get core (first fields))
              indexed (sh08-ft-loop-kernel-index-records records (first key-fields))]
          (if (= :accepted (get indexed :status))
            (recur (rest fields) (rest key-fields)
              (conj indexes (get indexed :index)))
            indexed))))))

(defn sh08-ft-loop-kernel-target-shape? [target node]
  (if (if (map? target) (if (vector? (get target :binding-ids)) (map? node) false) false)
    (let [kind (get target :target-kind) attrs (get node :attributes) children (get node :children)]
      (if (vector? children)
        (if (= [(get target :owner-form-id) (get target :owner-syntax-id) (get target :binding-ids) (get target :type-compatibility)]
               [(get (get node :source) :form-id) (get (get node :source) :syntax-id) (get node :resolved-binding-ids) :pending-sh08])
          (if (= (get target :arity) (count (get target :binding-ids)))
            (if (= kind :function) (= [:fn (get target :target-id) nil] [(get node :core-form) (get attrs :recur-target-id) (get target :parent-target-id)])
              (if (= kind :loop)
                (if (if (integer? (get target :arity))
                      (if (vector? (get attrs :initializer-child-indexes)) (vector? (get attrs :body-child-indexes)) false) false)
                  (if (> (count children) (get target :arity))
                    (if (sh08-ft-loop-kernel-ordered-children? node)
                      (= [:loop (get target :target-id) (get target :arity) (sh08-ft-loop-kernel-indexes 0 (get target :arity))
                          (sh08-ft-loop-kernel-indexes (get target :arity) (count children)) (- (count children) (get target :arity))
                          {:kind :last-body :child-index (- (count children) 1)} :initializers-then-body-left-to-right]
                         [(get node :core-form) (get attrs :target-id) (get attrs :binding-count) (get attrs :initializer-child-indexes)
                          (get attrs :body-child-indexes) (get attrs :body-count) (get attrs :result-policy)
                          (get (get node :evaluation) :kind)]) false) false) false) false)) false) false) false)) false))

(defn sh08-ft-loop-kernel-initializer-visible? [root nodes all-slots prior]
  (loop [pending [root] seen #{}]
    (if (= 0 (count pending))
      {:status :accepted}
      (let [id (first pending) node (get nodes id)
            binding (get (get node :attributes) :binding-id)]
        (if (contains? seen id)
          (sh08-ft-loop-kernel-failure :cyclic-loop-initializer id :tree nil)
          (if (if (= :reference (get node :core-form))
                (if (contains? all-slots binding)
                  (= false (contains? prior binding)) false)
                false)
            (sh08-ft-loop-kernel-failure :loop-initializer-binding-visibility
              id :prior-loop-bindings binding)
            (recur (sh08-ft-loop-kernel-append
                     (vec (rest pending)) (get node :children))
              (conj seen id))))))))

(defn sh08-ft-loop-kernel-loop-slots
  [target node records nodes source-bindings types bindings]
  (loop [ids (get target :binding-ids) ordinal 0 prior [] out bindings
         slots [] constraints []]
    (if (= 0 (count ids))
      {:status :accepted :bindings out :slots slots :constraints constraints}
      (let [id (first ids)
            record (get records id)
            binding (get source-bindings id)
            initializer (get nodes (get record :initializer-node-id))
            type (get types (get initializer :node-id) :gravity.type/unknown)]
        (if (if (map? record)
              (= [(get node :node-id) ordinal id prior :immutable
                  (get (get node :children) ordinal)
                  (get (get initializer :source) :form-id)
                  (get (get initializer :source) :syntax-id)
                  (get initializer :binding-context)
                  (get binding :binding-id) (get binding :name)
                  (get binding :scope-id) (get binding :definition-syntax-id)]
                 [(get record :loop-core-node-id) (get record :ordinal)
                  (get record :binding-id)
                  (get record :visible-prior-binding-ids)
                  (get record :mutability) (get record :initializer-node-id)
                  (get record :initializer-form-id)
                  (get record :initializer-syntax-id)
                  (get record :initializer-scope-id) id
                  (get record :name) (get record :binding-scope-id)
                  (get record :definition-syntax-id)])
              false)
          (let [visible (sh08-ft-loop-kernel-initializer-visible?
                         (get initializer :node-id) nodes
                         (set (get target :binding-ids)) (set prior))]
            (if (= :accepted (get visible :status))
              (recur (rest ids) (+ ordinal 1) (conj prior id)
                (assoc out id type) (conj slots type)
                (conj constraints
                  {:kind :loop-slot-type :binding-id id
                   :initializer-node-id (get initializer :node-id) :type type
                   :source-loop-binding record :source-target target
                   :status (if (sh08-ft-loop-kernel-known? type) :solved :pending)}))
              visible))
          (sh08-ft-loop-kernel-failure :incoherent-loop-slot
            (get node :node-id) :original-sequential-initializer record))))))

(defn sh08-ft-loop-kernel-collect-slots [core prepared types bindings]
  (loop [targets (get core :recur-targets) out bindings slots {}
         constraints [] slot-count 0]
    (if (= 0 (count targets))
      (if (= slot-count (count (get core :loop-bindings)))
        {:status :accepted :bindings out :slots slots :constraints constraints}
        (sh08-ft-loop-kernel-failure :incomplete-loop-slot-coverage
          nil :all-original-loop-bindings slot-count))
      (let [target (first targets)
            node (get (get prepared :nodes) (get target :owner-core-node-id))
            nearest (if (= :function (get target :target-kind))
                      {:status :accepted :target nil}
                      (sh08-ft-loop-kernel-nearest-target
                        (get node :node-id) (get prepared :nodes)
                        (get prepared :parents) (get prepared :owners)))]
        (if (= :accepted (get nearest :status))
          (if (if (sh08-ft-loop-kernel-target-shape? target node)
                (if (= (get target :parent-target-id)
                       (get (get nearest :target) :target-id))
                  (= (get target :body-scope-id)
                     (get (get (get prepared :nodes)
                               (get (get node :children)
                                 (if (= :loop (get target :target-kind))
                                   (get target :arity) 0)))
                       :binding-context))
                  false)
                false)
            (if (= :function (get target :target-kind))
              (recur (rest targets) out slots constraints slot-count)
              (let [result (sh08-ft-loop-kernel-loop-slots
                             target node (get prepared :bindings)
                             (get prepared :nodes) (get prepared :source-bindings)
                             types out)]
                (if (= :accepted (get result :status))
                  (recur (rest targets) (get result :bindings)
                    (assoc slots (get target :target-id) (get result :slots))
                    (sh08-ft-loop-kernel-append constraints (get result :constraints))
                    (+ slot-count (count (get result :slots))))
                  result)))
            (sh08-ft-loop-kernel-failure :incoherent-loop-target
              (get node :node-id) :original-nearest-target target))
          nearest)))))

(defn sh08-ft-loop-kernel-transfer-types
  [transfer target nodes types slots invariants]
  (if (if (vector? slots)
        (= (count (get transfer :argument-node-ids)) (count slots)) false)
    (loop [args (get transfer :argument-node-ids) slots slots coordinate 0
           values [] resolved true normal true]
      (if (= 0 (count args))
        {:status :accepted :argument-types values :resolved? resolved
         :normal-transfer? normal}
        (let [id (first args) actual (get types id :gravity.type/unknown)
              expected (first slots)]
          (if (if (= actual :gravity.type/never) false
                (if (sh08-ft-loop-kernel-known? actual)
                  (if (sh08-ft-loop-kernel-known? expected)
                    (if (map? (get invariants
                                    (get (get target :binding-ids) coordinate)))
                      (= false (sh08-lsi-compatible? actual expected))
                      (= false (= actual expected)))
                    false)
                  false))
            {:status :rejected
             :issues [{:rule "C7-TYPE-MISMATCH"
                       :reason (if (= :function (get target :target-kind))
                                 :function-recur-slot-type-mismatch
                                 :loop-recur-slot-type-mismatch)
                       :core-node-id id
                       :parameter-binding-id (get (get target :binding-ids) coordinate)
                       :expected expected :actual actual}]}
            (recur (rest args) (rest slots) (+ coordinate 1)
              (conj values actual)
              (if (if (sh08-ft-loop-kernel-known? actual)
                    (sh08-ft-loop-kernel-known? expected) false)
                resolved false)
              (if (= actual :gravity.type/never) false normal))))))
    (sh08-ft-loop-kernel-failure :loop-transfer-slot-count
      (get transfer :recur-core-node-id) (count slots)
      (count (get transfer :argument-node-ids)))))

(defn sh08-ft-loop-kernel-transfer-shape? [transfer target nearest node slots]
  (if (if (vector? (get transfer :argument-node-ids))
        (if (map? target) (vector? (get node :children)) false) false)
    (if (= (count (get transfer :argument-node-ids)) (get target :arity))
      (if (if (= :loop (get target :target-kind))
            (if (vector? slots) (= (count slots) (get target :arity)) false) true)
        (if (sh08-ft-loop-kernel-ordered-children? node)
          (= [:recur target (get target :target-id) (get target :target-kind)
              (get target :arity) (get target :binding-ids) (get node :children)
              true :arguments-left-to-right :nearest-lexical-recur-target
              :pending-sh08 (get target :target-id) (get target :target-kind)
              (get target :arity) :pending-sh08
              :arguments-left-to-right-then-transfer (get (get node :source) :form-id)
              (get (get node :source) :syntax-id)]
             [(get node :core-form) (get nearest :target)
              (get transfer :target-id) (get transfer :target-kind)
              (get transfer :arity) (get node :resolved-binding-ids)
              (get transfer :argument-node-ids) (get transfer :tail-position)
              (get transfer :evaluation-order) (get transfer :transfer-policy)
              (get transfer :type-compatibility)
              (get (get node :attributes) :target-id)
              (get (get node :attributes) :target-kind)
              (get (get node :attributes) :arity)
              (get (get node :attributes) :type-compatibility)
              (get (get node :evaluation) :kind)
              (get transfer :recur-form-id) (get transfer :recur-syntax-id)])
          false)
        false)
      false)
    false))

(defn sh08-ft-function-recur-slots [target node bindings]
  (let [names (get (get node :attributes) :parameters)
        declarations (get (get (get node :attributes) :signature) :parameters)]
    (loop [ids (get target :binding-ids) ordinal 0 slots []]
      (if (= 0 (count ids))
        {:status :accepted :slots slots}
        (let [id (first ids) binding (get bindings id)]
          (if (if (map? binding)
                (if (vector? names)
                  (= [id (get names ordinal)]
                     [(get binding :binding-id) (get binding :name)]) false)
                false)
            (recur (rest ids) (+ ordinal 1)
              (conj slots (get (get declarations ordinal) :type-id :gravity.type/unknown)))
            (sh08-ft-loop-kernel-failure :incoherent-function-recur-parameter
              (get node :node-id) :original-parameter-binding id)))))))

(defn sh08-ft-loop-kernel-collect-transfers [core prepared types result]
  (loop [transfers (get core :recur-transfers)
         constraints (get result :constraints)]
    (if (= 0 (count transfers))
      {:status :accepted :bindings (get result :bindings)
       :constraints constraints :issues []
       :member-invariants (get result :member-invariants {})}
      (let [transfer (first transfers)
            id (get transfer :recur-core-node-id)
            node (get (get prepared :nodes) id)
            target (get (get prepared :targets) (get transfer :target-id))
            nearest (sh08-ft-loop-kernel-nearest-target id
                       (get prepared :nodes) (get prepared :parents)
                       (get prepared :owners))
            function? (= :function (get target :target-kind))
            slot-result (if function?
                          (sh08-ft-function-recur-slots target
                            (get (get prepared :nodes)
                                 (get target :owner-core-node-id))
                            (get prepared :source-bindings))
                          {:status :accepted
                           :slots (get (get result :slots) (get target :target-id))})
            slots (get slot-result :slots)
            invariants (get result :member-invariants {})]
        (if (= :accepted (get nearest :status))
          (if (sh08-ft-loop-kernel-transfer-shape? transfer target nearest node slots)
            (if (= :accepted (get slot-result :status))
              (if (if function?
                    (if (contains? (set slots) :gravity.type/unknown)
                      true (contains? (set slots) nil)) false)
                (assoc (sh08-ft-loop-kernel-failure
                         :function-recur-parameter-types-required id
                         :declared-parameter-types slots)
                  :issues [{:rule "C7-ANNOTATION"
                            :reason :function-recur-parameter-types-required
                            :core-node-id id :expected :declared-parameter-types
                            :actual slots}])
                (let [member-bindings (if (= 0 (count invariants)) []
                                       (sh08-lsi-target-bindings target invariants))
                      checked (sh08-ft-loop-kernel-transfer-types
                               transfer target (get prepared :nodes) types slots invariants)]
                  (if (= :accepted (get checked :status))
                    (recur (rest transfers)
                      (conj constraints
                        (let [premise
                              {:kind :loop-recur-type :source-transfer transfer
                               :source-target target
                               :argument-types (get checked :argument-types)
                               :slot-types slots :result-type :gravity.type/never
                               :normal-transfer? (get checked :normal-transfer?)
                               :status (if (get checked :resolved?) :solved :pending)}]
                          (if (= 0 (count member-bindings))
                            premise
                            (assoc premise :member-invariant-bindings
                              member-bindings)))))
                    checked)))
              slot-result)
            (sh08-ft-loop-kernel-failure :incoherent-loop-transfer
              id :original-nearest-tail-transfer transfer))
          nearest)))))

(defn sh08-lsi-promote [result invariants]
  (loop [remaining (get result :constraints) rows []
         bindings (get result :bindings) slots (get result :slots)]
    (if (= 0 (count remaining))
      (assoc result :constraints rows :bindings bindings :slots slots
        :member-invariants invariants)
      (let [premise (first remaining)
            binding (get premise :binding-id)
            invariant (get invariants binding)
            record (get premise :source-loop-binding)
            target (get premise :source-target)]
        (if (map? invariant)
          (recur (rest remaining)
            (conj rows (assoc premise :type (get invariant :invariant-type)
              :initializer-type (get invariant :initializer-type)
              :member-invariant invariant))
            (assoc bindings binding (get invariant :invariant-type))
            (assoc slots (get target :target-id)
              (assoc (get slots (get target :target-id))
                (get record :ordinal) (get invariant :invariant-type))))
          (recur (rest remaining) (conj rows premise) bindings slots))))))

(defn sh08-lsi-control-transfers [core prepared result]
  (loop [remaining (get core :recur-transfers)]
    (if (= 0 (count remaining))
      {:status :accepted}
      (let [transfer (first remaining)
            id (get transfer :recur-core-node-id)
            node (get (get prepared :nodes) id)
            target (get (get prepared :targets) (get transfer :target-id))
            nearest (sh08-ft-loop-kernel-nearest-target id
                       (get prepared :nodes) (get prepared :parents)
                       (get prepared :owners))
            function? (= :function (get target :target-kind))
            slots (if function?
                    (sh08-ft-function-recur-slots target
                      (get (get prepared :nodes)
                           (get target :owner-core-node-id))
                      (get prepared :source-bindings))
                    {:status :accepted
                     :slots (get (get result :slots) (get target :target-id))})]
        (if (= :accepted (get nearest :status))
          (if (sh08-ft-loop-kernel-transfer-shape? transfer target nearest node
                (get slots :slots))
            (if (= :accepted (get slots :status))
              (if (if function?
                    (loop [types (get slots :slots)]
                      (if (= 0 (count types)) false
                        (if (= nil (first types)) true
                          (if (= :gravity.type/unknown (first types)) true
                            (recur (rest types))))))
                    false)
                (assoc (sh08-ft-loop-kernel-failure
                         :function-recur-parameter-types-required id
                         :declared-parameter-types (get slots :slots))
                  :issues [{:rule "C7-ANNOTATION"
                            :reason :function-recur-parameter-types-required
                            :core-node-id id
                            :expected :declared-parameter-types
                            :actual (get slots :slots)}])
                (recur (rest remaining)))
              slots)
            (sh08-ft-loop-kernel-failure :incoherent-loop-transfer
              id :original-nearest-tail-transfer transfer))
          nearest)))))

(defn sh08-ft-loop-type-step [core type-table binding-types]
  (if (if (map? type-table) (map? binding-types) false)
    (let [prepared (sh08-ft-loop-kernel-prepare core)]
      (if (= :accepted (get prepared :status))
        (let [slots (sh08-ft-loop-kernel-collect-slots core prepared
                      type-table binding-types)]
          (if (= :accepted (get slots :status))
            (let [controls (if (map? (get core :loop-member-source))
                             (sh08-lsi-control-transfers core prepared slots)
                             {:status :accepted})]
              (if (= :accepted (get controls :status))
                (let [source (assoc (get core :loop-member-source {})
                                    :nodes (get prepared :nodes))
                      members (if (map? (get core :loop-member-source))
                                (sh08-lsi-solve core type-table source)
                                {:status :accepted :invariants {}})]
                  (if (= :accepted (get members :status))
                    (let [promoted (if (= 0 (count (get members :invariants)))
                                     (assoc slots :member-invariants {})
                                     (sh08-lsi-promote slots
                                       (get members :invariants)))]
                      (if (= :accepted (get promoted :status))
                        (sh08-ft-loop-kernel-collect-transfers core prepared
                          type-table promoted)
                        promoted))
                    (assoc members :issues
                      [{:rule "C7-TYPE-MISMATCH"
                        :reason (get members :reason)
                        :core-node-id (get members :core-node-id)
                        :parameter-binding-id (get members :parameter-binding-id)
                        :expected (get members :expected)
                        :actual (get members :actual)}])))
                controls))
            slots))
        prepared))
    (sh08-ft-loop-kernel-failure :invalid-loop-type-tables nil :maps nil)))
(defn sh08-ft-ordered-child-types [children type-table]
  (loop [remaining children out []]
    (if (= 0 (count remaining)) out
      (recur (rest remaining) (conj out (get type-table (first remaining) :gravity.type/unknown))))))

(defn sh08-ft-has-loop-control? [core]
  (loop [nodes (get core :nodes)]
    (if (= 0 (count nodes)) false
      (if (contains? #{:loop :recur} (get (first nodes) :core-form)) true (recur (rest nodes))))))

(defn sh08-ft-loop-working-core [core bindings]
  (if (sh08-ft-has-loop-control? core)
    (assoc core :binding-table bindings)
    nil))

(defn sh08-ft-loop-diagnostics [issues nodes]
  (loop [remaining issues out []]
    (if (= 0 (count remaining)) out
      (recur (rest remaining) (conj out (assoc (first remaining) :node (get nodes (get (first remaining) :core-node-id) {})))))))

(defn sh08-lsi-row [premise node module]
  (let [slot? (= :loop-slot-type (get premise :kind)) id (get node :node-id)
        target (get premise :source-target) lhs (if slot? (get premise :binding-id) id)
        rhs (if slot? (get premise :type) :gravity.type/never)
        selected (if (map? (get premise :member-invariant)) true
                   (if (vector? (get premise :member-invariant-bindings)) (> (count (get premise :member-invariant-bindings)) 0) false))
        solution {:type rhs :slot-types (get premise :slot-types) :argument-types (get premise :argument-types)
                  :normal-transfer? (get premise :normal-transfer?)}]
    {:constraint-id-request {:domain (if selected :gravity/sh08-loop-type-constraint-v2 :gravity/sh08-loop-type-constraint-v1)
       :core-node-id id :binding-or-transfer lhs :target-id (get target :target-id) :premise premise}
     :kind :equality :producer-rule (if selected :sh08-loop-target-types-v2 :sh08-loop-target-types-v1) :lhs lhs :rhs rhs
     :origin (get (get node :source) :origin-chain) :profile (get module :profile) :target (get module :target)
     :dependencies {:loop-premise premise :core-node-id id :target-owner-core-node-id (get target :owner-core-node-id)}
     :solution (if selected
                 (if slot? (assoc solution :initializer-type (get premise :initializer-type) :member-invariant (get premise :member-invariant))
                   (assoc solution :member-invariant-bindings (get premise :member-invariant-bindings))) solution)
     :invalidation (if selected
       [:loop-bindings :recur-targets :recur-transfers :type-table :binding-table :calls :call-edges :source-forms :lexical-bindings :loop-member-grounding]
       [:loop-bindings :recur-targets :recur-transfers :type-table :binding-table])
     :status :solved :diagnostics []}))

(defn sh08-ft-loop-constraints [premises nodes module]
  (loop [remaining premises out []]
    (if (= 0 (count remaining)) out
      (let [premise (first remaining) slot? (= :loop-slot-type (get premise :kind))
            id (if slot? (get premise :initializer-node-id) (get (get premise :source-transfer) :recur-core-node-id))]
        (recur (rest remaining) (if (= :solved (get premise :status))
          (conj out (sh08-lsi-row premise (get nodes id) module)) out))))))

(defn sh08-ft-every-known? [values]
  (if (= (count values) 0)
    true
    (if (sh08-ft-known? (first values))
      (sh08-ft-every-known? (rest values))
      false)))

(defn sh08-ft-last-type [children type-table]
  (if (= (count children) 0)
    :gravity.type/unknown
    (get type-table
         (get children (- (count children) 1))
         :gravity.type/unknown)))

(defn sh08-ft-collection-type [node type-table]
  (let [kind (get (get node :attributes) :literal-kind)
        children (get node :children)
        child-types
        (loop [remaining children result []]
          (if (= (count remaining) 0)
            result
            (recur
             (rest remaining)
             (conj result
                   (get type-table (first remaining)
                        :gravity.type/unknown)))))]
    (if (sh08-ft-every-known? child-types)
      (if (= kind :vector)
        {:kind :gravity.type/vector
         :element-types child-types
         :shape :literal}
        (if (= kind :set)
          {:kind :gravity.type/set
           :element-types child-types
           :shape :literal}
          (if (= kind :map)
            (if (sh08-even-count? children)
              {:kind :gravity.type/map
               :member-types child-types
               :shape :literal}
              :gravity.type/unknown)
            :gravity.type/unknown)))
      :gravity.type/unknown)))

(defn sh08-ft-function-type-skeleton-base [record module]
  {:artifact :gravity/c7-function-type
   :function-id (get record :function-syntax-id)
   :function-core-node-id (get record :function-core-node-id)
   :body-core-node-id (get record :body-core-node-id)
   :definition-name (get record :definition-name)
   :parameter-binding-ids (get record :parameter-binding-ids)
   :parameters
   (loop [remaining (get record :parameter-binding-ids)
          values []]
     (if (= (count remaining) 0)
       values
       (recur
        (rest remaining)
        (conj values
              {:binding-id (first remaining)
               :type :gravity.type/unknown}))))
   :return :gravity.type/unknown
   :return-conflict nil
   :fixed-arity (get record :fixed-arity)
   :latent-effects (get module :effects)
   :capabilities (get module :capabilities)
   :ownership-constraints :pending-sh10
   :profile-constraints [(get module :profile)]
   :thrown-error-effects [:pending-sh09]
   :source-span nil
   :status :inferred})

(defn sh08-ft-apply-declarations [function signature]
      (assoc (assoc (assoc (assoc function :signature signature)
        :declaration-rule-version :sh08-atomic-function-signature-v1)
        :return (get (get signature :return) :type-id (get function :return)))
        :parameters
        (loop [parameters (get function :parameters) declarations (get signature :parameters) result []]
          (if (= (count parameters) 0) result
            (recur (rest parameters) (rest declarations)
              (conj result (assoc (first parameters) :type
                (get (first declarations) :type-id (get (first parameters) :type)))))))))

(defn sh08-ft-function-type-skeleton [record module]
  (let [base (sh08-ft-function-type-skeleton-base record module)]
    (if (contains? record :signature)
      (sh08-ft-apply-declarations base (get record :signature)) base)))

(defn sh08-ft-restore-declarations [completed base]
  (loop [ids (keys base) result completed]
    (if (= (count ids) 0) result
      (let [id (first ids) function (get base id)]
        (recur (rest ids)
          (if (contains? function :signature)
            (assoc result id (sh08-ft-apply-declarations (get result id) (get function :signature))) result))))))

(defn sh08-ft-declaration-seeds [functions initial]
  (loop [ids (keys functions) result initial]
    (if (= (count ids) 0) result
      (let [function (get functions (first ids))]
        (recur (rest ids)
          (loop [parameters (get function :parameters) declarations (get (get function :signature) :parameters)
                 values result]
            (if (= (count parameters) 0) values
              (recur (rest parameters) (rest declarations)
                (if (= (first declarations) nil) values
                  (assoc values (get (first parameters) :binding-id) (get (first declarations) :type-id)))))))))))

; The authoritative higher-order promotion is deliberately narrower than the
; fixture adapters: it derives one capture-free named identity function and
; one named apply-one function directly from the authenticated B47 core.  No
; HO1/HO2 result is accepted as a type premise here.
(defn sh08-ft-higher-order-reference?
  [node binding-id owner-function-syntax-id]
  (if (map? node)
    (if (= :reference (get node :core-form))
      (if (= binding-id (get (get node :attributes) :binding-id))
        (= owner-function-syntax-id
           (get (get node :evaluation) :owner-function-syntax-id))
        false)
      false)
    false))

(defn sh08-ft-authoritative-primitive-type? [value]
  (if (= value :gravity.type/integer)
    true
    (if (= value :gravity.type/bool)
      true
      (= value :gravity.type/string))))

(defn sh08-ft-authoritative-primitive-type-for-node [node]
  (if (map? node)
    (if (= :literal (get node :core-form))
      (let [candidate
            (sh08-primitive-type-from-literal-kind
             (get (get node :attributes) :literal-kind))]
        (if (sh08-ft-authoritative-primitive-type? candidate)
          candidate
          nil))
      nil)
    nil))

(defn sh08-ft-higher-order-call-node-valid?
  [call node expected-argument-count owner-function-syntax-id]
  (if (map? call)
    (if (map? node)
      (if (= :call (get node :core-form))
        (if (= expected-argument-count
               (count (get call :argument-node-ids)))
          (if (= (get call :ordered-evaluation-node-ids)
                 (get node :children))
            (if (= :operator-then-arguments
                   (get call :evaluation-order))
              (= owner-function-syntax-id
                 (get (get node :evaluation)
                      :owner-function-syntax-id))
              false)
            false)
          false)
        false)
      false)
    false))

(defn sh08-ft-higher-order-call-by-node-id
  [calls node-id]
  (if (= (count calls) 0)
    nil
    (if (= node-id (get (first calls) :core-node-id))
      (first calls)
      (sh08-ft-higher-order-call-by-node-id (rest calls) node-id))))

(defn sh08-ft-higher-order-identity-candidates
  [function-records nodes definitions]
  (loop [remaining function-records values []]
    (if (= (count remaining) 0)
      values
      (let [record (first remaining)
            function-node (get nodes (get record :function-core-node-id))
            definition
            (sh08-ft-definition-by-binding-id
             definitions (get record :definition-binding-id))
            parameter-ids (get record :parameter-binding-ids)
            body (get nodes (get record :body-core-node-id))]
        (if (if (= :named-top-level (get record :definition-kind))
              (if (= 1 (get record :fixed-arity))
                (if (= 1 (count parameter-ids))
                  (if (map? definition)
                    (if (map? function-node)
                      (if (= :fn (get function-node :core-form))
                        (sh08-ft-higher-order-reference?
                         body (first parameter-ids)
                         (get record :function-syntax-id))
                        false)
                      false)
                    false)
                  false)
                false)
              false)
          (recur (rest remaining)
                 (conj values
                       {:record record
                        :definition definition
                        :function-node function-node
                        :body body
                        :parameter-binding-id (first parameter-ids)}))
          (recur (rest remaining) values))))))

(defn sh08-ft-higher-order-outer-call
  [calls nodes apply-definition identity-definition]
  (if (= (count calls) 0)
    nil
    (let [call (first calls)
          node (get nodes (get call :core-node-id))
          argument-ids (get call :argument-node-ids)
          children (get node :children)
          function-value-node (get nodes (first argument-ids))
          value-node (get nodes (first (rest argument-ids)))]
      (if (if (= :call (get node :core-form))
            (if (= nil (get (get node :evaluation)
                            :owner-function-syntax-id))
              (if (= 2 (count argument-ids))
                (if (= (get call :operator-binding-id)
                       (get apply-definition :binding-id))
                  (if (= (get call :ordered-evaluation-node-ids)
                         children)
                    (if (= :operator-then-arguments
                           (get call :evaluation-order))
                      (if (= (get function-value-node :core-form)
                             :reference)
                        (if (= (get (get function-value-node :attributes)
                                  :binding-id)
                             (get identity-definition :binding-id))
                          (= (get value-node :core-form) :literal)
                          false)
                        false)
                      false)
                    false)
                  false)
                false)
              false)
            false)
        call
        (sh08-ft-higher-order-outer-call
         (rest calls) nodes apply-definition identity-definition)))))

(defn sh08-ft-higher-order-outer-edge-valid?
  [edge call function-record bindings]
  (let [definition-binding
        (sh08-ft-binding-by-id
         bindings (get function-record :definition-binding-id))]
  (if (map? edge)
    (if (= :local-function (get edge :classification))
      (if (= (get edge :call-core-node-id)
             (get call :core-node-id))
        (if (= (get edge :callee-binding-id)
               (get function-record :definition-binding-id))
          (if (= (get edge :callee-definition-syntax-id)
                 (get definition-binding :definition-syntax-id))
            (if (= (get edge :callee-function-syntax-id)
                   (get function-record :function-syntax-id))
              (if (= (get edge :callee-function-core-node-id)
                     (get function-record :function-core-node-id))
                (if (= (get edge :argument-core-node-ids)
                       (get call :argument-node-ids))
                  (if (= (get edge :ordered-evaluation-node-ids)
                         (get call :ordered-evaluation-node-ids))
                    (if (= (get edge :evaluation-order)
                           (get call :evaluation-order))
                      (if (= (get edge :caller-function-syntax-id) nil)
                        (= (get edge :caller-function-core-node-id) nil)
                        false)
                      false)
                    false)
                  false)
                false)
              false)
            false)
          false)
        false)
      false)
    false)))

(defn sh08-ft-higher-order-apply-candidates
  [function-records nodes definitions bindings calls edges identity-candidate]
  (let [identity-definition (get identity-candidate :definition)]
    (loop [remaining function-records values []]
      (if (= (count remaining) 0)
        values
        (let [record (first remaining)
              parameter-ids (get record :parameter-binding-ids)
              function-node (get nodes (get record :function-core-node-id))
              definition
              (sh08-ft-definition-by-binding-id
               definitions (get record :definition-binding-id))
              body (get nodes (get record :body-core-node-id))
              body-call
              (sh08-ft-higher-order-call-by-node-id
               calls (get record :body-core-node-id))
              argument-ids (if (map? body-call)
                             (get body-call :argument-node-ids)
                             [])
              inner-argument (get nodes (first argument-ids))
              inner-edge
              (sh08-ft-edge-by-call-id
               edges (get record :body-core-node-id))
              outer-call
              (if (map? definition)
                (sh08-ft-higher-order-outer-call
                 calls nodes definition identity-definition)
                nil)
              outer-edge
              (if (map? outer-call)
                (sh08-ft-edge-by-call-id
                 edges (get outer-call :core-node-id))
                nil)
              outer-node
              (if (map? outer-call)
                (get nodes (get outer-call :core-node-id))
                nil)
              callable-binding
              (sh08-ft-binding-by-id bindings (first parameter-ids))]
          (if (if (= :named-top-level (get record :definition-kind))
                (if (= 2 (get record :fixed-arity))
                  (if (= 2 (count parameter-ids))
                    (if (map? definition)
                      (if (map? function-node)
                        (if (= :fn (get function-node :core-form))
                          (if (sh08-ft-higher-order-call-node-valid?
                               body-call body 1
                               (get record :function-syntax-id))
                            (if (= (get body-call :operator-binding-id)
                                   (first parameter-ids))
                              (if (sh08-ft-higher-order-reference?
                                   inner-argument
                                   (first (rest parameter-ids))
                                   (get record :function-syntax-id))
                                (if (map? inner-edge)
                                  (if (= :nonlocal-or-nonfunction
                                         (get inner-edge :classification))
                                    (if (= (get inner-edge :callee-binding-id)
                                           (first parameter-ids))
                                      (if (map? callable-binding)
                                        (if (= (get inner-edge
                                                   :callee-definition-syntax-id)
                                               (get callable-binding
                                                   :definition-syntax-id))
                                          (if (= nil
                                                 (get inner-edge
                                                      :callee-function-syntax-id))
                                            (if (= nil
                                                 (get inner-edge
                                                      :callee-function-core-node-id))
                                              (if (sh08-ft-higher-order-outer-edge-valid?
                                                   outer-edge outer-call record
                                                   bindings)
                                                true
                                                false)
                                              false)
                                            false)
                                          false)
                                        false)
                                      false)
                                    false)
                                  false)
                                false)
                              false)
                            false)
                          false)
                        false)
                      false)
                    false)
                  false)
                false)
            (recur (rest remaining)
                   (conj values
                         {:record record
                          :definition definition
                          :function-node function-node
                          :body body
                          :inner-call body-call
                          :inner-node body
                          :inner-argument inner-argument
                          :inner-edge inner-edge
                          :outer-call outer-call
                          :outer-edge outer-edge
                          :outer-node outer-node
                          :callable-binding callable-binding
                          :callable-binding-id (first parameter-ids)
                          :value-binding-id (first (rest parameter-ids))}))
            (recur (rest remaining) values)))))))

(defn sh08-ft-higher-order-edge-projection [edge]
  (if (map? edge)
    {:ordinal (get edge :ordinal)
     :call-core-node-id (get edge :call-core-node-id)
     :caller-function-syntax-id (get edge :caller-function-syntax-id)
     :caller-function-core-node-id (get edge :caller-function-core-node-id)
     :callee-binding-id (get edge :callee-binding-id)
     :callee-definition-syntax-id (get edge :callee-definition-syntax-id)
     :callee-function-syntax-id (get edge :callee-function-syntax-id)
     :callee-function-core-node-id (get edge :callee-function-core-node-id)
     :argument-core-node-ids (get edge :argument-core-node-ids)
     :ordered-evaluation-node-ids (get edge :ordered-evaluation-node-ids)
     :evaluation-order (get edge :evaluation-order)
     :classification (get edge :classification)}
    nil))

(defn sh08-ft-higher-order-proof
  [nodes definitions bindings function-records calls edges module]
  (let [node-index (sh08-ft-node-index nodes)
        identity-candidates
        (sh08-ft-higher-order-identity-candidates
         function-records node-index definitions)]
    (if (= 1 (count identity-candidates))
      (let [identity (first identity-candidates)
            apply-candidates
            (sh08-ft-higher-order-apply-candidates
             function-records node-index definitions bindings calls edges identity)]
        (if (= 1 (count apply-candidates))
          (let [apply (first apply-candidates)
                identity-record (get identity :record)
                apply-record (get apply :record)
                identity-definition (get identity :definition)
                apply-definition (get apply :definition)
                outer-value-node
                (get node-index
                     (first
                      (rest
                       (get (get apply :outer-call)
                            :argument-node-ids))))
                value-type
                (sh08-ft-authoritative-primitive-type-for-node
                 outer-value-node)
                identity-source
                (get (get (get identity :function-node) :source) :semantic-span)
                identity-syntax-id
                (get (get (get identity :function-node) :source) :syntax-id)
                identity-origin-chain
                (get (get (get identity :function-node) :source) :origin-chain)
                identity-generated-origin
                (get (get (get identity :function-node) :source) :generated-origin)
                apply-source
                (get (get (get apply :function-node) :source) :semantic-span)
                apply-syntax-id
                (get (get (get apply :function-node) :source) :syntax-id)
                apply-origin-chain
                (get (get (get apply :function-node) :source) :origin-chain)
                apply-generated-origin
                (get (get (get apply :function-node) :source) :generated-origin)
                identity-function-type
                {:artifact :gravity/c7-function-type
                 :function-id (get identity-record :function-syntax-id)
                 :function-core-node-id
                 (get identity-record :function-core-node-id)
                 :body-core-node-id (get identity-record :body-core-node-id)
                 :definition-name (get identity-record :definition-name)
                 :parameter-binding-ids
                 (get identity-record :parameter-binding-ids)
                 :parameters
                 [{:binding-id (get identity :parameter-binding-id)
                   :type value-type}]
                 :return value-type
                 :return-conflict nil
                 :fixed-arity (get identity-record :fixed-arity)
                 :latent-effects (get module :effects)
                 :capabilities (get module :capabilities)
                 :ownership-constraints :pending-sh10
                 :profile-constraints [(get module :profile)]
                 :thrown-error-effects [:pending-sh09]
                 :source-span identity-source
                 :syntax-id identity-syntax-id
                 :origin-chain identity-origin-chain
                 :generated-origin identity-generated-origin
                 :profile (get module :profile)
                 :target (get module :target)
                 :status :inferred}
                apply-function-type
                {:artifact :gravity/c7-function-type
                 :function-id (get apply-record :function-syntax-id)
                 :function-core-node-id
                 (get apply-record :function-core-node-id)
                 :body-core-node-id (get apply-record :body-core-node-id)
                 :definition-name (get apply-record :definition-name)
                 :parameter-binding-ids
                 (get apply-record :parameter-binding-ids)
                 :parameters
                 [{:binding-id (get apply :callable-binding-id)
                   :type identity-function-type}
                  {:binding-id (get apply :value-binding-id)
                   :type value-type}]
                 :return value-type
                 :return-conflict nil
                 :fixed-arity (get apply-record :fixed-arity)
                 :latent-effects (get module :effects)
                 :capabilities (get module :capabilities)
                 :ownership-constraints :pending-sh10
                 :profile-constraints [(get module :profile)]
                 :thrown-error-effects [:pending-sh09]
                 :source-span apply-source
                 :syntax-id apply-syntax-id
                 :origin-chain apply-origin-chain
                 :generated-origin apply-generated-origin
                 :profile (get module :profile)
                 :target (get module :target)
                 :status :inferred}]
            (if (sh08-ft-authoritative-primitive-type? value-type)
              {:status :accepted
             :identity identity
             :apply apply
             :identity-function-type identity-function-type
             :apply-function-type apply-function-type
             :identity-binding-id (get identity-definition :binding-id)
             :identity-function-syntax-id
             (get identity-record :function-syntax-id)
             :apply-binding-id (get apply-definition :binding-id)
             :apply-function-syntax-id
             (get apply-record :function-syntax-id)
             :identity-parameter-binding-id
             (get identity :parameter-binding-id)
             :apply-callable-binding-id (get apply :callable-binding-id)
             :apply-value-binding-id (get apply :value-binding-id)
             :inner-call-core-node-id
             (get (get apply :inner-call) :core-node-id)
             :outer-call-core-node-id
             (get (get apply :outer-call) :core-node-id)
             :inner-edge (get apply :inner-edge)
             :outer-edge (get apply :outer-edge)
             :identity-source
             (get (get (get identity :function-node) :source)
                  :semantic-span)
             :apply-source
             (get (get (get apply :function-node) :source)
                  :semantic-span)
             :inner-source
             (get (get (get apply :inner-node) :source)
                  :semantic-span)
             :outer-source
             (get (get (get apply :outer-node) :source)
                  :semantic-span)
             :callable-definition-syntax-id
             (get (get apply :callable-binding) :definition-syntax-id)
             :initial-binding-types
             {(get identity-definition :binding-id) identity-function-type
              (get identity :parameter-binding-id) value-type
              (get apply-definition :binding-id) apply-function-type
             (get apply :callable-binding-id) identity-function-type
              (get apply :value-binding-id) value-type}
             :value-type value-type
             :outer-value-literal-kind
             (get (get outer-value-node :attributes) :literal-kind)}
              {:status :rejected
               :reason :unsupported-higher-order-primitive-type
               :node outer-value-node
               :actual (get (get outer-value-node :attributes) :literal-kind)
               :value-type value-type}))
          {:status :not-applicable :reason :no-complete-identity-apply-shape}))
      {:status :not-applicable :reason :no-complete-identity-shape})))

(defn sh08-ft-higher-order-complete-function
  [skeleton proof-type]
  (let [updated
        (assoc
         (assoc
          (assoc
           (assoc
            (assoc
             (assoc skeleton
                    :parameters (get proof-type :parameters))
             :return (get proof-type :return))
            :latent-effects (get proof-type :latent-effects))
           :capabilities (get proof-type :capabilities))
          :ownership-constraints (get proof-type :ownership-constraints))
         :thrown-error-effects (get proof-type :thrown-error-effects))]
    (assoc
     (assoc
      (assoc
       (assoc
        (assoc updated :profile (get proof-type :profile))
        :target (get proof-type :target))
       :source-span (get proof-type :source-span))
      :syntax-id (get proof-type :syntax-id))
     :origin-chain (get proof-type :origin-chain)
     :generated-origin (get proof-type :generated-origin))))

(defn sh08-ft-higher-order-proof-input [proof]
  (let [identity (get proof :identity)
        apply (get proof :apply)
        identity-record (get identity :record)
        apply-record (get apply :record)
        identity-definition (get identity :definition)
        apply-definition (get apply :definition)
        inner-call (get apply :inner-call)
        outer-call (get apply :outer-call)]
    {:domain :gravity/sh08-authoritative-higher-order-proof-v1
     :identity-function-syntax-id (get identity-record :function-syntax-id)
     :identity-function-core-node-id
     (get identity-record :function-core-node-id)
     :identity-definition-binding-id (get identity-definition :binding-id)
     :identity-parameter-binding-id
     (get proof :identity-parameter-binding-id)
     :identity-body-core-node-id (get identity-record :body-core-node-id)
     :apply-function-syntax-id (get apply-record :function-syntax-id)
     :apply-function-core-node-id (get apply-record :function-core-node-id)
     :apply-definition-binding-id (get apply-definition :binding-id)
     :apply-callable-binding-id (get proof :apply-callable-binding-id)
     :apply-value-binding-id (get proof :apply-value-binding-id)
     :apply-body-core-node-id (get apply-record :body-core-node-id)
     :inner-call-core-node-id (get inner-call :core-node-id)
     :inner-operator-binding-id (get inner-call :operator-binding-id)
     :inner-argument-node-ids (get inner-call :argument-node-ids)
     :inner-evaluation-order (get inner-call :evaluation-order)
     :inner-source-span (get proof :inner-source)
     :inner-edge
     (sh08-ft-higher-order-edge-projection (get proof :inner-edge))
     :outer-call-core-node-id (get outer-call :core-node-id)
     :outer-operator-binding-id (get outer-call :operator-binding-id)
     :outer-argument-node-ids (get outer-call :argument-node-ids)
     :outer-evaluation-order (get outer-call :evaluation-order)
     :outer-source-span (get proof :outer-source)
     :outer-edge
     (sh08-ft-higher-order-edge-projection (get proof :outer-edge))
     :outer-value-argument-node-id
     (first (rest (get outer-call :argument-node-ids)))
     :outer-value-literal-kind
     (get proof :outer-value-literal-kind)
     :identity-parameter-type (get proof :value-type)
     :apply-callable-parameter-type (get proof :identity-function-type)
     :apply-value-parameter-type (get proof :value-type)
     :identity-function-type (get proof :identity-function-type)
     :apply-function-type (get proof :apply-function-type)
     :inner-result-type (get proof :value-type)
     :outer-result-type (get proof :value-type)}))

(defn sh08-ft-higher-order-call-proof-facts [proof]
  (let [identity (get proof :identity)
        apply (get proof :apply)
        identity-record (get identity :record)
        apply-record (get apply :record)
        inner-call (get apply :inner-call)
        outer-call (get apply :outer-call)]
    [{:role :inner-indirect-call
      :call-core-node-id (get inner-call :core-node-id)
      :caller-function-syntax-id (get apply-record :function-syntax-id)
      :callee-function-syntax-id (get (get proof :inner-edge)
                                      :callee-function-syntax-id)
      :selected-identity-function-syntax-id
      (get identity-record :function-syntax-id)
      :operator-binding-id (get inner-call :operator-binding-id)
      :callable-parameter-binding-id
      (get proof :apply-callable-binding-id)
      :argument-node-ids (get inner-call :argument-node-ids)
      :argument-value-binding-id (get proof :apply-value-binding-id)
      :evaluation-order (get inner-call :evaluation-order)
      :source-span (get proof :inner-source)
      :b47-edge
      (sh08-ft-higher-order-edge-projection (get proof :inner-edge))
      :result-type (get proof :value-type)
      :dispatch :indirect-function-value}
     {:role :outer-direct-call
      :call-core-node-id (get outer-call :core-node-id)
      :caller-function-syntax-id nil
      :callee-function-syntax-id (get apply-record :function-syntax-id)
      :operator-binding-id (get outer-call :operator-binding-id)
      :argument-node-ids (get outer-call :argument-node-ids)
      :value-argument-node-id
      (first (rest (get outer-call :argument-node-ids)))
      :evaluation-order (get outer-call :evaluation-order)
      :source-span (get proof :outer-source)
      :outer-edge (get proof :outer-edge)
      :b47-edge
      (sh08-ft-higher-order-edge-projection (get proof :outer-edge))
      :selected-apply-function-syntax-id
      (get apply-record :function-syntax-id)
      :result-type (get proof :value-type)
      :dispatch :direct-local-function}]))

(defn sh08-ft-higher-order-pending [base-pending]
  (let [residuals
        [:captures :lifetimes :aliases :multi-hop :polymorphism :overloads
         :multi-arity :variadic-dispatch :protocol-dispatch :dynamic-dispatch
         :reflection]]
    (loop [remaining base-pending values []]
      (if (= (count remaining) 0)
        values
        (if (= (first remaining) :higher-order-functions)
          (recur
           (rest remaining)
           (loop [pending residuals result values]
             (if (= (count pending) 0)
               result
               (recur (rest pending) (conj result (first pending))))))
          (recur (rest remaining) (conj values (first remaining))))))))

; The recursive consumer is intentionally narrower than the B47 recursion
; product.  B47 may describe arbitrary SCCs, but C7 only admits one named,
; capture-free positive-fixed-arity self edge with direct positional parameter
; forwarding, a direct primitive-literal sibling, and an external concrete
; call that supplies every parameter slot. Everything else remains an explicit
; diagnostic rather than being silently approximated.
(defn sh08-ft-recursive-known-type? [value]
  (sh08-ft-authoritative-primitive-type? value))

(defn sh08-ft-recursive-reference-valid?
  [node binding-ids definition-binding-id function-syntax-id]
  (if (map? node)
    (if (= :reference (get node :core-form))
      (if (= function-syntax-id
             (get (get node :evaluation) :owner-function-syntax-id))
        (let [binding-id (get (get node :attributes) :binding-id)]
          (if (= binding-id definition-binding-id)
            true
            (sh08-ft-member? binding-ids binding-id)))
        false)
      true)
    false))

(defn sh08-ft-recursive-body-capture-free?
  [nodes binding-ids definition-binding-id function-syntax-id]
  (loop [remaining nodes]
    (if (= (count remaining) 0)
      true
      (if (if (= function-syntax-id
                (get (get (first remaining) :evaluation)
                     :owner-function-syntax-id))
            (sh08-ft-recursive-reference-valid?
             (first remaining) binding-ids definition-binding-id
             function-syntax-id)
            true)
        (recur (rest remaining))
        false))))

(defn sh08-ft-recursive-call-edge-valid?
  [edge call call-node function-record definition-binding binding-table
   recursive?]
  (let [function-syntax-id (get function-record :function-syntax-id)
        function-core-node-id (get function-record :function-core-node-id)
        definition-binding-id (get definition-binding :binding-id)
        definition-syntax-id
        (get (sh08-ft-binding-by-id
              binding-table definition-binding-id)
             :definition-syntax-id)]
    (if (if (map? edge) (map? call) false)
      (if (= :local-function (get edge :classification))
        (if (= (get edge :call-core-node-id)
               (get call :core-node-id))
          (if (= (get edge :callee-binding-id) definition-binding-id)
            (if (= (get edge :callee-definition-syntax-id)
                   definition-syntax-id)
              (if (= (get edge :callee-function-syntax-id)
                     function-syntax-id)
                (if (= (get edge :callee-function-core-node-id)
                       function-core-node-id)
                  (if (= (get edge :argument-core-node-ids)
                         (get call :argument-node-ids))
                    (if (= (get edge :ordered-evaluation-node-ids)
                           (get call :ordered-evaluation-node-ids))
                      (if (= (get edge :evaluation-order)
                             :operator-then-arguments)
                        (if (= (get call :evaluation-order)
                               :operator-then-arguments)
                          (if (= (get (get call-node :evaluation)
                                      :owner-function-syntax-id)
                                 (if recursive?
                                   function-syntax-id
                                   nil))
                            true
                            false)
                          false)
                        false)
                      false)
                    false)
                  false)
                false)
              false)
            false)
          false)
        false)
      false)))

(defn sh08-ft-recursive-argument-types
  [argument-node-ids node-index]
  (loop [remaining argument-node-ids values []]
    (if (= (count remaining) 0)
      values
      (let [node (get node-index (first remaining))
            literal-type
            (if (= :literal (get node :core-form))
              (sh08-primitive-type-from-literal-kind
               (get (get node :attributes) :literal-kind))
              :gravity.type/unknown)]
        (recur
         (rest remaining)
         (conj values
               (if (sh08-ft-authoritative-primitive-type? literal-type)
                 literal-type
                 :gravity.type/unknown)))))))

(defn sh08-ft-recursive-unsupported-primitive-node
  [argument-node-ids node-index]
  (if (= (count argument-node-ids) 0)
    nil
    (let [node (get node-index (first argument-node-ids))
          candidate
          (if (= :literal (get node :core-form))
            (sh08-primitive-type-from-literal-kind
             (get (get node :attributes) :literal-kind))
            nil)]
      (if (if (map? node)
            (if (= :literal (get node :core-form))
              (if (= candidate nil)
                false
                (if (sh08-ft-authoritative-primitive-type? candidate)
                  false
                  true))
              false)
            false)
        node
        (sh08-ft-recursive-unsupported-primitive-node
         (rest argument-node-ids) node-index)))))

(defn sh08-ft-recursive-parameter-evidence
  [calls edges node-index function-record definition-binding binding-table]
  (let [function-syntax-id (get function-record :function-syntax-id)
        arity (count (get function-record :parameter-binding-ids))]
    (loop [remaining calls
           remaining-edges edges
           candidates []]
      (if (= (count remaining) 0)
        (if (= (count candidates) 0)
          {:status :rejected :reason :recursive-parameter-evidence-required}
          (let [first-types (get (first candidates) :types)
                conflict
                (loop [types (rest candidates)]
                  (if (= (count types) 0)
                    nil
                    (if (= first-types (get (first types) :types))
                      (recur (rest types))
                      (get (first types) :types))))]
            (if (= conflict nil)
              {:status :accepted
               :call (get (first candidates) :call)
               :edge (get (first candidates) :edge)
               :node (get (first candidates) :node)
               :types first-types}
              {:status :rejected
               :reason :recursive-parameter-type-conflict
               :actual conflict})))
        (let [call (first remaining)
              edge (first remaining-edges)
              node (get node-index (get call :core-node-id))
              types (sh08-ft-recursive-argument-types
                     (get call :argument-node-ids) node-index)
              unsupported-node
              (sh08-ft-recursive-unsupported-primitive-node
               (get call :argument-node-ids) node-index)
              valid-edge
              (sh08-ft-recursive-call-edge-valid?
               edge call node function-record definition-binding
               binding-table false)]
          (if (map? unsupported-node)
            {:status :rejected
             :reason :unsupported-recursive-primitive-type
             :node unsupported-node}
            (if (if valid-edge
                (if (= (get edge :caller-function-syntax-id) nil)
                  (if (= (get edge :caller-function-core-node-id) nil)
                    (if (= arity (count types))
                      (sh08-ft-every-known? types)
                      false)
                    false)
                  false)
                false)
            (recur (rest remaining)
                   (rest remaining-edges)
                   (conj candidates
                         {:call call
                          :edge edge
                          :node node
                          :types types}))
            (recur (rest remaining) (rest remaining-edges) candidates))))))))

(defn sh08-ft-recursive-base-evidence
  [body node-index recursive-call-id]
  (if (= :if (get body :core-form))
    (let [children (get body :children)]
      (if (= 3 (count children))
        (let [then-id (second children)
              else-id (sh08-third children)
              then-node (get node-index then-id)
              else-node (get node-index else-id)
              then-type
              (if (= :literal (get then-node :core-form))
                (sh08-primitive-type-from-literal-kind
                 (get (get then-node :attributes) :literal-kind))
                :gravity.type/unknown)
              else-type
              (if (= :literal (get else-node :core-form))
                (sh08-primitive-type-from-literal-kind
                 (get (get else-node :attributes) :literal-kind))
                :gravity.type/unknown)]
          (if (= then-id recursive-call-id)
            (if (sh08-ft-recursive-known-type? else-type)
              {:status :accepted :node else-node :type else-type}
              {:status :rejected :reason :recursive-base-evidence-required})
            (if (= else-id recursive-call-id)
              (if (sh08-ft-recursive-known-type? then-type)
                {:status :accepted :node then-node :type then-type}
                {:status :rejected :reason :recursive-base-evidence-required})
              {:status :rejected :reason :recursive-call-must-be-direct-branch})))
        {:status :rejected :reason :recursive-base-shape-required}))
    {:status :rejected :reason :recursive-base-shape-required}))

(defn sh08-ft-recursive-pending [base-pending]
  (let [residuals [:mutual-recursion :unbounded-recursion :recursive-captures
                   :recursive-higher-order :recursive-polymorphism]]
    (loop [remaining base-pending values []]
      (if (= (count remaining) 0)
        values
        (if (= (first remaining) :recursive-type-annotations)
          (recur
           (rest remaining)
           (loop [pending residuals result values]
             (if (= (count pending) 0)
               result
               (recur (rest pending) (conj result (first pending))))))
          (recur (rest remaining) (conj values (first remaining))))))))

(defn sh08-ft-recursive-rejection-evidence [result node component]
  (if (= :accepted (get result :status))
    result
    (if (map? (get result :node))
      result
      (if (map? node)
        (assoc result :node node)
        (if (map? component)
          (assoc result :component component)
          result)))))

(defn sh08-ft-recursive-diagnostic [proof module]
  (let [node (get proof :node)
        diagnostic
        (sh08-ft-diagnostic
         "C7-ANNOTATION"
         (if (map? node) node nil)
         module
         :bounded-named-self-recursive-fixed-arity-positive-positional-literal-base
         (get proof :reason)
         (get proof :reason)
         {})]
    (if (map? (get proof :component))
      (assoc diagnostic :recursive-component (get proof :component))
      diagnostic)))

(defn sh08-ft-recursive-proof
  [nodes definitions bindings function-records calls edges recursion-components
   module]
  (if (= (count recursion-components) 0)
    {:status :not-applicable :reason :no-recursive-component}
    (if (sh08-ft-any-member?
         (loop [remaining recursion-components values []]
           (if (= (count remaining) 0)
             values
             (recur
              (rest remaining)
              (conj values (= :mutually-recursive
                              (get (first remaining) :kind))))))
         [true])
      {:status :rejected
       :reason :mutual-recursion-unsupported
       :component (first recursion-components)}
      (if (= 1 (count recursion-components))
        (let [component (first recursion-components)
              function-syntax-id (first (get component :function-syntax-ids))
              function-record
              (sh08-ft-function-by-syntax-id
               function-records function-syntax-id)
              node-index (sh08-ft-node-index nodes)
              function-node
              (if (map? function-record)
                (get node-index (get function-record :function-core-node-id))
                nil)
              definition
              (if (map? function-record)
                (sh08-ft-definition-by-binding-id
                 definitions (get function-record :definition-binding-id))
                nil)
              definition-binding
              (if (map? function-record)
                (sh08-ft-binding-by-id
                 bindings (get function-record :definition-binding-id))
                nil)
              edge-ordinals (get component :internal-call-edge-ordinals)
              recursive-edge
              (if (= 1 (count edge-ordinals))
                (get edges (first edge-ordinals))
                nil)
              recursive-call
              (if (map? recursive-edge)
                (sh08-ft-higher-order-call-by-node-id
                 calls (get recursive-edge :call-core-node-id))
                nil)
              recursive-node
              (if (map? recursive-call)
                (get node-index (get recursive-call :core-node-id))
                nil)
              body
              (if (map? function-record)
                (get node-index (get function-record :body-core-node-id))
                nil)
              edge-valid
              (sh08-ft-recursive-call-edge-valid?
               recursive-edge recursive-call recursive-node function-record
               definition bindings true)
              arity
              (if (map? function-record)
                (get function-record :fixed-arity)
                nil)
              parameter-ids
              (if (map? function-record)
                (get function-record :parameter-binding-ids)
                [])
              argument-ids
              (if (map? recursive-call)
                (get recursive-call :argument-node-ids)
                [])
              argument-nodes
              (loop [remaining argument-ids values []]
                (if (= (count remaining) 0)
                  values
                  (recur
                   (rest remaining)
                   (conj values (get node-index (first remaining))))))
              argument-shape
              (if (= arity (count parameter-ids))
                (if (= arity (count argument-ids))
                  (loop [remaining argument-nodes ids parameter-ids]
                    (if (= (count remaining) 0)
                      true
                      (if (sh08-ft-higher-order-reference?
                           (first remaining) (first ids) function-syntax-id)
                        (recur (rest remaining) (rest ids))
                        false)))
                  false)
                false)
              base-evidence
              (if (map? body)
                (sh08-ft-recursive-base-evidence
                 body node-index (get recursive-call :core-node-id))
                {:status :rejected :reason :recursive-base-shape-required})
              parameter-evidence
              (if (map? definition)
                (sh08-ft-recursive-parameter-evidence
                 calls edges node-index function-record definition bindings)
                {:status :rejected :reason :recursive-definition-required})
              capture-free
              (if (map? function-record)
                (sh08-ft-recursive-body-capture-free?
                 nodes parameter-ids (get function-record :definition-binding-id)
                 function-syntax-id)
                false)]
          (sh08-ft-recursive-rejection-evidence
           (if (= nil function-record)
            {:status :rejected :reason :recursive-function-record-required}
            (if (= :named-top-level (get function-record :definition-kind))
              (if (if (integer? arity) (> arity 0) false)
                (if (= :fn (get function-node :core-form))
                  (if (map? definition)
                    (if (map? definition-binding)
                      (if edge-valid
                        (if argument-shape
                          (if capture-free
                            (if (= :accepted (get base-evidence :status))
                            (if (= :accepted
                                     (get parameter-evidence :status))
                                (if (= (get base-evidence :type)
                                       (first (get parameter-evidence :types)))
                                  {:status :accepted
                                   :component component
                                   :function-record function-record
                                   :function-node function-node
                                   :definition definition
                                   :definition-binding definition-binding
                                   :recursive-call recursive-call
                                   :recursive-call-core-node-id
                                   (get recursive-call :core-node-id)
                                   :recursive-base-type
                                   (get base-evidence :type)
                                   :recursive-edge recursive-edge
                                   :recursive-node recursive-node
                                   :base-node (get base-evidence :node)
                                   :base-type (get base-evidence :type)
                                   :parameter-evidence parameter-evidence
                                   :parameter-types
                                   (get parameter-evidence :types)
                                   :function-syntax-id function-syntax-id
                                   :module module}
                                  {:status :rejected
                                   :reason :recursive-result-type-conflict
                                   :expected (get base-evidence :type)
                                   :actual
                                   (first (get parameter-evidence :types))})
                              {:status :rejected
                               :reason (get parameter-evidence :reason)
                               :actual (get parameter-evidence :actual)
                               :node (get parameter-evidence :node)})
                              {:status :rejected
                               :reason (get base-evidence :reason)})
                            {:status :rejected :reason :recursive-capture-unsupported})
                          {:status :rejected :reason :recursive-argument-shape})
                        {:status :rejected :reason :recursive-call-edge-lineage})
                      {:status :rejected :reason :recursive-definition-binding-required})
                    {:status :rejected :reason :recursive-definition-required})
                  {:status :rejected :reason :recursive-function-node-required})
                {:status :rejected :reason :recursive-fixed-arity-required})
              {:status :rejected :reason :recursive-function-must-be-named}))
           recursive-node
           component))
        {:status :rejected
         :reason :multiple-recursive-components
         :component recursion-components}))))

; L5/C7: declared VALUE signatures break one ordinary named self SCC.
; This structural premise grants no effect, error, termination or stack fact.
; All body nodes and all incoming arguments still pass ordinary inference.
(defn sh08-ds-type? [type]
  (if (sh08-hl-type? type) true
    (contains? #{:gravity.type/i8 :gravity.type/i16 :gravity.type/i32 :gravity.type/i64
                :gravity.type/u8 :gravity.type/u16 :gravity.type/u32 :gravity.type/u64
                :gravity.type/f32 :gravity.type/f64 :gravity.type/bool :gravity.type/string
                :gravity.type/symbol :gravity.type/keyword :gravity.type/ratio} type)))

(defn sh08-ss-type? [type]
  ; Closed inferred carrier v1: String members, no extent or presence fact.
  (if (map? type) (if (= 3 (count type))
    (if (= :gravity.type/set (get type :kind))
      (if (= :homogeneous (get type :shape)) (= :gravity.type/string (get type :element-type)) false) false) false) false))

(defn sh08-syc-type? [type]
  ; Closed inferred Symbol member carrier; no extent or presence facts.
  (if (map? type)
    (if (= 3 (count type))
      (if (loop [fields (keys type)]
            (if (= 0 (count fields)) true
              (if (keyword? (first fields)) (recur (rest fields)) false)))
        (if (= :gravity.type/set (get type :kind))
          (if (= :homogeneous (get type :shape)) (= :gravity.type/symbol (get type :element-type)) false)
          false)
        false)
      false)
    false))

(defn sh08-is-value-type? [type]
  ; Inferred values only: validate fixed fields without hashing composite data.
  (if (map? type)
    (if (= 3 (count type))
      (if (= :gravity.type/set (get type :kind)) (sh08-ss-type? type)
        (if (= :gravity.type/list (get type :kind))
          (if (= :homogeneous (get type :shape))
            (if (keyword? (get type :element-type)) (sh08-ds-type? (get type :element-type)) false) false) false)) false)
    (if (keyword? type) (sh08-ds-type? type) false)))

; L3/L5/C7: a closed private self component has one VALUE signature.
; Only complete, normally invoking non-SCC entries contribute parameter facts.
; A callee's result (including Never) is not the operand invocation guard.
(defn sh08-is? [proof]
  (contains? #{:sh08-private-self-value-v1 :sh08-indexed-private-self-value-v1} (get proof :rule-version)))

; The private-use census is separate from the PE Map-presence verdict:
; this owner explicitly checks the one allowed ordinary self component.
(defn sh08-is-private-call? [call edge uses resolutions record binding core nodes forms]
  (let [bid (get record :definition-binding-id) id (get call :core-node-id)
        node (get nodes id) children (get node :children) op (get nodes (get call :operator-node-id))
        source (get op :source) form (get forms (get source :form-id))
        owner (get forms (get (get node :source) :form-id))
        use (sh08-pe-one uses :core-node-id (get op :node-id))
        resolution (sh08-pe-one resolutions :reference-syntax-id (get source :syntax-id))
        caller-id (get edge :caller-function-syntax-id)
        caller (sh08-pe-one (get core :function-records) :function-syntax-id caller-id)]
    (sh08-ft-all-true?
      [(if (= caller-id nil) (= nil (get edge :caller-function-core-node-id)) (map? caller))
       (= :call (get node :core-form)) (= :reference (get op :core-form)) (= [] (get op :children))
       (= [bid] (get node :resolved-binding-ids) (get op :resolved-binding-ids))
       (= {:symbol (get form :value) :position :operator :binding-id bid :binding-class :namespace
           :definition-syntax-id (get binding :definition-syntax-id)} (get op :attributes))
       (= :symbol (get form :kind))
       (= {:core-node-id (get op :node-id) :form-id (get source :form-id) :syntax-id (get source :syntax-id)
           :symbol (get form :value) :position :operator :binding-id bid :binding-class :namespace
           :definition-syntax-id (get binding :definition-syntax-id)} use)
       (= {:reference-syntax-id (get source :syntax-id) :symbol (get form :value) :position :operator
           :binding-id bid :upstream-binding-id (get binding :upstream-binding-id)
           :resolution-order (get resolution :resolution-order) :source-span (get form :source-span)} resolution)
       (= {:core-node-id id :operator-node-id (first children) :operator-binding-id bid
           :argument-node-ids (vec (rest children)) :ordered-evaluation-node-ids children
           :evaluation-order :operator-then-arguments :result-policy :call-result} call)
       (= {:ordinal (get edge :ordinal) :call-core-node-id id
           :caller-function-syntax-id caller-id :caller-function-core-node-id (get caller :function-core-node-id)
           :callee-binding-id bid :callee-definition-syntax-id (get binding :definition-syntax-id)
           :callee-function-syntax-id (get record :function-syntax-id) :callee-function-core-node-id (get record :function-core-node-id)
           :argument-core-node-ids (get call :argument-node-ids) :ordered-evaluation-node-ids children
           :evaluation-order :operator-then-arguments :classification :local-function} edge)
       (= caller-id (get (get node :evaluation) :owner-function-syntax-id))
       (= :operator-then-arguments (get (get node :evaluation) :kind))
       (= (get record :fixed-arity) (count (get call :argument-node-ids)))
       (= :list (get owner :kind)) (= (count children) (count (get owner :child-form-ids)))
       (loop [i 0]
         (if (= i (count children)) true
           (let [child (get nodes (get children i)) child-form (get forms (get (get owner :child-form-ids) i))]
             (if (sh08-ft-all-true?
                   [(= (get owner :form-id) (get child-form :parent-form-id))
                    (= (get child :source) (sh08-ma-form-source child-form))
                    (= {:index i :core-node-id (get child :node-id)} (get (get (get node :evaluation) :order) i))])
               (recur (+ i 1)) false))))])))

(defn sh08-is-private-census [record core nodes bindings forms]
  (let [params (get record :parameter-binding-ids) bid (get record :definition-binding-id)
        binding (get bindings bid) definition (sh08-pe-one (get core :definitions) :binding-id bid)
        fn-node (get nodes (get record :function-core-node-id))
        def-node (get nodes (get definition :core-node-id))
        def-form (get forms (get (get def-node :source) :form-id))
        name-form (get forms (get (get def-form :child-form-ids) 1))
        fn-form (get forms (get record :function-form-id))
        exports (get (get core :module) :exports)
        uses (sh08-pe-select (get core :reference-uses) :binding-id bid)
        resolutions (sh08-pe-select (get (get core :preserved-resolution) :resolution-table) :binding-id bid)
        references (loop [remaining (get core :nodes) out []]
                     (if (= 0 (count remaining)) out
                       (let [node (first remaining)]
                         (recur (rest remaining)
                           (if (if (= :reference (get node :core-form))
                                 (if (= bid (get (get node :attributes) :binding-id)) true
                                   (contains? (set (get node :resolved-binding-ids)) bid)) false)
                             (conj out node) out)))))
        calls (sh08-pe-select (get core :calls) :operator-binding-id bid)
        edges (loop [remaining (get core :call-edges) out []]
                (if (= 0 (count remaining)) out
                  (let [edge (first remaining)]
                    (recur (rest remaining)
                      (if (if (= bid (get edge :callee-binding-id)) true
                            (= (get record :function-syntax-id) (get edge :callee-function-syntax-id)))
                        (conj out edge) out)))))
        self-edges (sh08-pe-select edges :caller-function-syntax-id (get record :function-syntax-id))
        mutated (loop [remaining (get core :mutations) out #{}]
                  (if (= 0 (count remaining)) out
                    (recur (rest remaining) (conj out (get (first remaining) :target-binding-id)))))
        component {:ordinal 0 :kind :self-recursive :function-syntax-ids [(get record :function-syntax-id)]
                   :function-core-node-ids [(get record :function-core-node-id)]
                   :internal-call-edge-ordinals [(get (first self-edges) :ordinal)]}
        parameters (loop [remaining params out []]
                     (if (= 0 (count remaining)) out
                       (recur (rest remaining) (conj out (get bindings (first remaining))))))]
    ; This must dominate the eager predicate vector's per-call joins. A valid
    ; source escape may have arbitrarily more references than direct calls.
    (if (if (> (count calls) 0)
          (= (count calls) (count edges) (count uses) (count resolutions) (count references)) false)
    (if (sh08-ft-all-true?
          [(map? record) (map? definition) (vector? params) (> (count params) 0)
           (= (count params) (count (set params)) (get record :fixed-arity))
           (= :named-top-level (get record :definition-kind))
           (= :function (get binding :kind)) (= :namespace (get binding :binding-class))
           (= :private (get binding :visibility) (get (get def-node :attributes) :visibility))
           (= (get (get core :module) :namespace) (get binding :namespace))
           (= (get binding :name) (get definition :name) (get record :definition-name) (get name-form :value))
           (= (get binding :definition-syntax-id) (get (get def-node :attributes) :name-syntax-id) (get name-form :syntax-id))
           (= :def (get def-node :core-form)) (= :fn (get fn-node :core-form))
           (= (get record :definition-core-node-id) (get definition :core-node-id) (get def-node :node-id))
           (= [(get fn-node :node-id)] (get def-node :children)) (= [bid] (get def-node :resolved-binding-ids))
           (= (get record :function-core-node-id) (get definition :value-node-id) (get fn-node :node-id))
           (= [(get record :body-core-node-id)] (get fn-node :children))
           (= params (get fn-node :resolved-binding-ids))
           (= (get record :function-syntax-id) (get fn-form :syntax-id) (get (get fn-node :source) :syntax-id))
           (= (get record :function-form-id) (get fn-form :form-id) (get (get def-form :child-form-ids) 2))
           (vector? exports)
           (loop [remaining exports]
             (if (= 0 (count remaining)) true
               (if (if (= (str (first remaining)) (str (get binding :name))) true
                     (= (str (first remaining)) (str (get binding :namespace) "/" (get binding :name))))
                 false (recur (rest remaining)))))
           (= [component] (get core :recursion-components)) (= 1 (count self-edges))
           (= false (sh08-pe-reentry? core record))
           (= 0 (count (sh08-pe-select (get core :var-references) :binding-id bid)))
           (= 0 (count (sh08-pe-select (get core :mutations) :target-binding-id bid)))
           (loop [remaining parameters ids params]
             (if (= 0 (count remaining)) true
               (let [parameter (first remaining)]
                 (if (sh08-ft-all-true?
                       [(= (first ids) (get parameter :binding-id)) (= [:lexical :local] [(get parameter :binding-class) (get parameter :kind)])
                        (contains? #{nil :immutable} (get parameter :mutability))
                        (= false (contains? mutated (first ids)))])
                   (recur (rest remaining) (rest ids)) false))))
           (> (count calls) 0) (= (count calls) (count edges) (count uses) (count resolutions) (count references))
           (loop [remaining calls seen #{}]
             (if (= 0 (count remaining)) true
               (let [call (first remaining) op-id (get call :operator-node-id)
                     edge (sh08-pe-one edges :call-core-node-id (get call :core-node-id))]
                 (if (if (= false (contains? seen op-id))
                       (sh08-is-private-call? call edge uses resolutions record binding core nodes forms) false)
                   (recur (rest remaining) (conj seen op-id)) false))))])
      {:kind :closed-private-self-use-census-v1 :function-record record :definition definition :definition-binding binding
       :parameter-bindings parameters :exports exports :reference-uses uses :resolutions resolutions
       :reference-node-ids (loop [remaining references out []]
                             (if (= 0 (count remaining)) out
                               (recur (rest remaining) (conj out (get (first remaining) :node-id)))))
       :calls calls :edges edges :component component}
      nil) nil)))

; Cut value results before ordinary cold inference. Calls to acyclic
; functions retain separate argument constraints; their tainted results do not
; become entry evidence. Transfers keep their genuine non-normal VALUE type.
(defn sh08-is-cold-cut [core record nodes mode]
  (if (contains? #{:entries :body} mode)
  (let [sequence (get core :nodes) calls (get core :calls) edges (get core :call-edges)
        id (get record :function-syntax-id)
        definitions (sh08-ft-index (get core :definitions) :binding-id)
            lexical (sh08-ft-index (get core :lexical-bindings) :binding-id)
            functions (sh08-ft-function-record-index (get core :function-records))
            edge-index (sh08-ft-index edges :call-core-node-id)
            initial (loop [remaining sequence out (set [(get record :function-core-node-id) (get record :definition-core-node-id)])]
                      (if (= 0 (count remaining)) out
                        (let [node (first remaining)]
                          (recur (rest remaining)
                            (if (if (= mode :entries) (= id (get (get node :evaluation) :owner-function-syntax-id)) false)
                              (conj out (get node :node-id)) out)))))
            initial (loop [remaining calls out initial]
                      (if (= 0 (count remaining)) out
                        (let [call (first remaining) edge (get edge-index (get call :core-node-id))]
                          (recur (rest remaining)
                            (if (= id (get edge :callee-function-syntax-id))
                              (conj (conj out (get call :core-node-id)) (get call :operator-node-id)) out)))))]
        (loop [remaining sequence excluded initial next initial]
          (if (= 0 (count remaining))
            (if (= excluded next)
              {:status :accepted :mode mode
               :excluded-node-ids
               (loop [remaining sequence out []]
                 (if (= 0 (count remaining)) out
                   (recur (rest remaining)
                     (if (contains? next (get (first remaining) :node-id)) (conj out (get (first remaining) :node-id)) out))))}
              (recur sequence next next))
            (let [node (first remaining) node-id (get node :node-id) kind (get node :core-form)
                  bid (get (get node :attributes) :binding-id)
                  initializer (if (= kind :reference)
                                (get (get lexical bid) :initializer-node-id (get (get definitions bid) :value-node-id)) nil)
                  target (if (= kind :call)
                           (get (get functions (get (get edge-index node-id) :callee-function-syntax-id)) :body-core-node-id) nil)
                  children (if (contains? #{:fn :quote :throw :recur} kind) [] (get node :children))
                  deps (if (= initializer nil) children (conj children initializer))
                  deps (if (= target nil) deps (conj deps target))]
              (recur (rest remaining) excluded
                (if (if (contains? next node-id) true
                      (loop [remaining deps]
                        (if (= 0 (count remaining)) false
                          (if (contains? next (first remaining)) true (recur (rest remaining))))))
                  (conj next node-id) next))))))
    {:status :rejected :reason :private-self-cold-mode-required}))

(defn sh08-is-entry-values [census nodes types]
  (let [record (get census :function-record) id (get record :function-syntax-id)
        arity (get record :fixed-arity) calls (get census :calls) edges (get census :edges)]
    (if (if (if (vector? calls) (vector? edges) false)
          (if (= (count calls) (count edges)) (if (integer? arity) (> arity 0) false) false) false)
      (loop [remaining calls remaining-edges edges entries [] selected nil normal-count 0]
        (if (= 0 (count remaining))
            (if (> normal-count 0)
              {:status :accepted :parameter-types selected :entries entries :normal-entry-count normal-count}
              {:status :rejected :reason :private-self-normal-entry-required})
            (let [call (first remaining) edge (first remaining-edges) args (get call :argument-node-ids)
                  self? (= id (get edge :caller-function-syntax-id))]
              (if (if (= (get call :core-node-id) (get edge :call-core-node-id))
                      (if (= id (get edge :callee-function-syntax-id))
                        (if (= :local-function (get edge :classification))
                          (if (vector? args) (= arity (count args)) false) false) false) false)
                  (if self?
                    (recur (rest remaining) (rest remaining-edges) entries selected normal-count)
                    (let [arguments (sh08-ft-ordered-child-types args types)
                          invoked? (sh08-pe-invoked? types args)
                          complete? (loop [values arguments]
                                      (if (= 0 (count values)) true
                                        (if (sh08-is-value-type? (first values)) (recur (rest values)) false)))
                          entry-node (get nodes (get call :core-node-id))
                          entry {:call-core-node-id (get call :core-node-id)
                                 :caller-function-syntax-id (get edge :caller-function-syntax-id)
                                 :source-call call :source-edge edge :source (get entry-node :source)
                                 :argument-node-ids args :argument-types arguments
                                 :normal-invocation? invoked? :invocation-guard :all-operand-types-normal
                                 :callee-result-is-not-invocation-guard true}]
                      (if (if invoked? (= false complete?) false)
                        {:status :rejected :reason :private-self-independent-entry-types-required
                         :node entry-node :entry entry}
                        (if (if invoked? (if (= selected nil) false (= false (= selected arguments))) false)
                          {:status :rejected :reason :private-self-entry-type-conflict
                           :expected selected :actual arguments :node entry-node :entry entry}
                          (recur (rest remaining) (rest remaining-edges) (conj entries entry)
                            (if invoked? arguments selected) (if invoked? (+ normal-count 1) normal-count))))))
                            {:status :rejected :reason :private-self-entry-census-mismatch}))))
      {:status :rejected :reason :private-self-entry-families-required})))

(defn sh08-ds? [proof]
  (= :sh08-declared-self-value-v1 (get proof :rule-version)))

(defn sh08-is-cold-evidence [cold]
  {:mode (get cold :mode) :cut (get cold :cut)
   :source-argument-call-node-ids (get cold :source-argument-call-node-ids)})

(defn sh08-is-parameter-premise [census entries cold]
  {:domain :gravity/sh08-private-self-entry-parameter-premise-v1
   :source-census census :entry-values entries :cold-entry-derivation (sh08-is-cold-evidence cold)
   :invalidation [:private-use-census :entry-call-sources :cold-value-dependencies
                  :parameter-bindings :mutations :function-records]})

; This consumes the owning C7 derivation's checked premise. The public owner
; overwrites this working-core field; an eventual inferred type is insufficient.
(defn sh08-is-parameter-record [core parameter index binding type]
  (let [premise (get core :sh08-private-self-parameter-premise)
        census (get premise :source-census) entries (get premise :entry-values)
        declaration (get (get (get parameter :signature) :parameters) index)]
    (if (sh08-ft-all-true?
          [(= :gravity/sh08-private-self-entry-parameter-premise-v1 (get premise :domain))
           (= :closed-private-self-use-census-v1 (get census :kind))
           (= parameter (get census :function-record)) (= :accepted (get entries :status))
           (> (get entries :normal-entry-count 0) 0)
           (= declaration nil) (integer? index) (if (integer? index) (>= index 0) false)
           (= (get parameter :function-syntax-id) (get (get census :function-record) :function-syntax-id))
           (= binding (get (get census :parameter-bindings) index))
           (= (get binding :binding-id) (get (get parameter :parameter-binding-ids) index))
           (contains? #{nil :immutable} (get binding :mutability))
           (= type (get (get entries :parameter-types) index)) (sh08-hl-type? type)])
      {:kind :gravity.type/private-self-entry-parameter :version :sh08-private-self-entry-parameter-v1
       :function-record parameter :parameter-index index :binding binding :type type
       :parameter-value-premise premise}
      nil)))

; L2/L5/C7: this separate family admits one indexed ordinary self induction.
; It does not enlarge the general declared/private recursive type whitelist.
(defn sh08-ix-types? [types]
  (= [{:kind :gravity.type/vector :shape :literal
       :element-types [:gravity.type/keyword :gravity.type/keyword :gravity.type/keyword
                       :gravity.type/keyword :gravity.type/keyword :gravity.type/keyword :gravity.type/keyword]}
      :gravity.type/keyword :gravity.type/integer] types))

(defn sh08-ix-literal? [node kind value forms]
  (let [form (get forms (get (get node :source) :form-id))]
    (sh08-ft-all-true?
      [(= :literal (get node :core-form)) (= [] (get node :children))
       (= {:literal-kind kind :value value} (get node :attributes))
       (= kind (get form :kind)) (= value (get form :value))
       (= [] (get form :child-form-ids))
       (= (get node :source) (sh08-ma-form-source form))])))

(defn sh08-ix-candidate? [record nodes census types]
  (if (if (= 3 (get record :fixed-arity))
        (let [body (get nodes (get record :body-core-node-id))]
          (if (= :if (get body :core-form))
            (let [base (get nodes (get (get body :children) 1))]
              (if (= :literal (get base :core-form))
                (= {:literal-kind :boolean :value false} (get base :attributes)) false)) false)) false)
    ; The source census is paired with the fixed-width selection. A prior
    ; Bool/String/Keyword private family keeps its own rule.
    (loop [calls (get census :calls) edges (get census :edges)]
      (if (= 0 (count calls)) false
        (let [call (first calls) edge (first edges) args (get call :argument-node-ids)]
          (if (if (= (get record :function-syntax-id) (get edge :caller-function-syntax-id)) false
                (if (= 3 (count args))
                  (sh08-ix-types? [(get types (first args)) (get types (get args 1)) (get types (get args 2))]) false))
            true (recur (rest calls) (rest edges)))))) false))

(defn sh08-ix-entry-values [census nodes types forms]
  (let [record (get census :function-record) id (get record :function-syntax-id)
        calls (get census :calls) edges (get census :edges)]
    (if (if (vector? calls) (if (vector? edges) (= (count calls) (count edges)) false) false)
      (loop [remaining calls rows edges entries [] selected nil normal-count 0]
        (if (= 0 (count remaining))
            (if (> normal-count 0)
              {:status :accepted :parameter-types selected :entries entries :normal-entry-count normal-count}
              {:status :rejected :reason :indexed-self-normal-entry-required})
            (let [call (first remaining) edge (first rows) args (get call :argument-node-ids)
                  self? (= id (get edge :caller-function-syntax-id))]
              (if (sh08-ft-all-true?
                      [(= (get call :core-node-id) (get edge :call-core-node-id))
                       (= id (get edge :callee-function-syntax-id)) (= :local-function (get edge :classification))
                       (vector? args) (= 3 (count args)) (= 3 (get record :fixed-arity))])
                  (if self?
                    (recur (rest remaining) (rest rows) entries selected normal-count)
                    (let [arguments (sh08-ft-ordered-child-types args types)
                          invoked? (sh08-pe-invoked? types args)
                          index (get nodes (get args 2))
                          zero? (sh08-ix-literal? index :integer 0 forms)
                          entry {:call-core-node-id (get call :core-node-id)
                                 :caller-function-syntax-id (get edge :caller-function-syntax-id)
                                 :source-call call :source-edge edge :source (get (get nodes (get call :core-node-id)) :source)
                                 :argument-node-ids args :argument-types arguments
                                 :normal-invocation? invoked? :invocation-guard :all-operand-types-normal
                                 :callee-result-is-not-invocation-guard true
                                 :index-entry-source (if invoked? {:node index :form (get forms (get (get index :source) :form-id))} nil)}]
                      (if (if invoked? (= false (sh08-ix-types? arguments)) false)
                        {:status :rejected :reason :indexed-self-independent-entry-types-required :entry entry}
                        (if (if invoked? (= false zero?) false)
                          {:status :rejected :reason :indexed-self-zero-source-entry-required :entry entry}
                          (if (if invoked? (if (= selected nil) false (= false (= selected arguments))) false)
                            {:status :rejected :reason :indexed-self-entry-type-conflict
                             :expected selected :actual arguments :entry entry}
                            (recur (rest remaining) (rest rows) (conj entries entry)
                              (if invoked? arguments selected) (if invoked? (+ normal-count 1) normal-count)))))))
                  {:status :rejected :reason :indexed-self-entry-census-mismatch}))))
      {:status :rejected :reason :indexed-self-entry-families-required})))

(defn sh08-ix-if-source? [core node nodes forms]
  (let [children (get node :children) form (get forms (get (get node :source) :form-id))
        ids (get form :child-form-ids) op (get forms (first ids))
        control {:core-node-id (get node :node-id) :kind :if :condition-node-id (first children)
                 :branches [{:role :then :predicate :truthy :core-node-id (get children 1)}
                            {:role :else :predicate :falsey :core-node-id (get children 2)}]
                 :branch-exclusivity :exactly-one :truthiness {:false-values [:nil :false] :other-values :true}
                 :result-policy :selected-branch}]
    (if (if (vector? children) (if (= 3 (count children)) (if (vector? ids) (= 4 (count ids)) false) false) false)
      (sh08-ft-all-true?
        [(= :if (get node :core-form)) (= :list (get form :kind)) (= [:symbol 'if] [(get op :kind) (get op :value)])
         (= (get node :source) (sh08-ma-form-source form))
         (= {:condition-child-index 0 :then-child-index 1 :else-child-index 2 :condition-evaluation :always-first
             :branch-evaluation :exactly-one :truthiness {:false-values [:nil :false] :other-values :true}} (get node :attributes))
         (= :condition-then-exclusive-branch (get (get node :evaluation) :kind))
         (= [{:index 0 :core-node-id (first children)}] (get (get node :evaluation) :order))
         (= [control] (sh08-pe-select (get core :control-flow) :core-node-id (get node :node-id)))
         (loop [i 0]
           (if (= i 3) true
             (let [child (get nodes (get children i)) child-form (get forms (get ids (+ i 1)))]
               (if (sh08-ft-all-true? [(= (get form :form-id) (get child-form :parent-form-id))
                                      (= (get child :source) (sh08-ma-form-source child-form))])
                 (recur (+ i 1)) false))))]) false)))

(defn sh08-ix-source [core census entries nodes bindings forms]
  (let [record (get census :function-record) params (get record :parameter-binding-ids)
        sequence (get core :nodes) calls (get core :calls) edges (get core :call-edges)]
    (if (= false (if (= :accepted (get entries :status)) (sh08-ix-types? (get entries :parameter-types)) false))
      {:status :rejected :reason :indexed-self-entry-premise-required}
      (let [call-index (sh08-ft-index calls :core-node-id) edge-index (sh08-ft-index edges :call-core-node-id)
              id (get record :function-syntax-id)
              body (get nodes (get record :body-core-node-id)) outer (get body :children)
              guard (get nodes (first outer)) base-node (get nodes (get outer 1)) inner (get nodes (get outer 2))
              inner-children (get inner :children) match (get nodes (first inner-children))
              true-node (get nodes (get inner-children 1)) self (get call-index (get inner-children 2))
              self-edge (get edge-index (get self :core-node-id)) self-args (get self :argument-node-ids)
              step (get nodes (get self-args 2)) step-call (get call-index (get step :node-id))
              guard-call (get call-index (get guard :node-id)) guard-args (get guard-call :argument-node-ids)
              counted (get nodes (get guard-args 1)) count-call (get call-index (get counted :node-id))
              match-call (get call-index (get match :node-id)) match-args (get match-call :argument-node-ids)
              access (get nodes (get match-args 1)) access-call (get call-index (get access :node-id))
              access-args (get access-call :argument-node-ids) step-args (get step-call :argument-node-ids)
              owned-calls (sh08-pe-select edges :caller-function-syntax-id id)
              normal-entry-ids (loop [remaining (get entries :entries) out []]
                                 (if (= 0 (count remaining)) out
                                   (recur (rest remaining)
                                     (if (= true (get (first remaining) :normal-invocation?))
                                       (conj out (get (first remaining) :call-core-node-id)) out))))
              source-ok?
              (sh08-ft-all-true?
                [(= 3 (count params)) (= record (get census :function-record))
                 (sh08-ix-if-source? core body nodes forms) (sh08-ix-if-source? core inner nodes forms)
                 (sh08-ix-literal? base-node :boolean false forms) (sh08-ix-literal? true-node :boolean true forms)
                 (= (get self-edge :caller-function-syntax-id) id (get self-edge :callee-function-syntax-id))
                 (= [self-edge] (sh08-pe-select (get census :edges) :caller-function-syntax-id id))
                 (= self (sh08-pe-one (get census :calls) :core-node-id (get self :core-node-id)))
                 (= 6 (count owned-calls))
                 (= (set [(get guard :node-id) (get counted :node-id) (get match :node-id)
                          (get access :node-id) (get step :node-id) (get self :core-node-id)])
                    (set (loop [remaining owned-calls out []]
                           (if (= 0 (count remaining)) out
                             (recur (rest remaining) (conj out (get (first remaining) :call-core-node-id)))))))
                 (= 2 (count guard-args) (count match-args) (count access-args) (count step-args))
                 (= 1 (count (get count-call :argument-node-ids)))
                 (sh08-si-ref? (get nodes (first guard-args)) (get params 2) forms bindings)
                 (sh08-si-ref? (get nodes (first (get count-call :argument-node-ids))) (first params) forms bindings)
                 (sh08-si-ref? (get nodes (first match-args)) (get params 1) forms bindings)
                 (sh08-si-ref? (get nodes (first access-args)) (first params) forms bindings)
                 (sh08-si-ref? (get nodes (get access-args 1)) (get params 2) forms bindings)
                 (sh08-si-ref? (get nodes (first self-args)) (first params) forms bindings)
                 (sh08-si-ref? (get nodes (get self-args 1)) (get params 1) forms bindings)
                 (sh08-si-ref? (get nodes (first step-args)) (get params 2) forms bindings)
                 (sh08-ix-literal? (get nodes (get step-args 1)) :integer 1 forms)
                 (sh08-si-call-forms? access nodes forms) (sh08-si-call-forms? step nodes forms)])]
          (if (= false source-ok?)
            {:status :rejected :reason :indexed-self-source-induction-required}
            (let [types (loop [remaining sequence out {}]
                          (if (= 0 (count remaining)) out
                            (let [node (first remaining) bid (get (get node :attributes) :binding-id)
                                  type (if (= :reference (get node :core-form))
                                         (if (= bid (first params)) (first (get entries :parameter-types))
                                           (if (= bid (get params 1)) :gravity.type/keyword
                                             (if (= bid (get params 2)) :gravity.type/integer :gravity.type/unknown)))
                                         (if (= :literal (get node :core-form))
                                           (sh08-primitive-type-from-literal-kind (get (get node :attributes) :literal-kind))
                                           :gravity.type/unknown))]
                              (recur (rest remaining) (assoc out (get node :node-id) type)))))
                  count-result (sh08-cq-derive core counted count-call (get edge-index (get counted :node-id))
                                 nodes bindings types forms)
                  types (assoc types (get counted :node-id) (get count-result :type :gravity.type/unknown))
                  guard-result (if (= :accepted (get count-result :status))
                                 (sh08-ie-derive core guard guard-call (get edge-index (get guard :node-id))
                                   nodes bindings types forms) count-result)
                  access-header (if (= :accepted (get guard-result :status))
                                  (sh08-vl-source core access access-call (get edge-index (get access :node-id))
                                    nodes bindings types (get core :module)) nil)
                  types (assoc types (get access :node-id) (get access-header :selected-type :gravity.type/unknown))
                  match-result (if (map? access-header)
                                 (sh08-ae-derive core match match-call (get edge-index (get match :node-id))
                                   nodes bindings types forms)
                                 {:status :rejected :reason :indexed-self-get-source-required})
                  step-header (if (= :accepted (get match-result :status))
                                (sh08-si-source core step step-call (get edge-index (get step :node-id))
                                  nodes bindings types (get core :module)) nil)]
              (if (sh08-ft-all-true?
                    [(= :accepted (get count-result :status) (get guard-result :status) (get match-result :status))
                     (= :normal (get (get count-result :descriptor) :application)
                                (get (get guard-result :descriptor) :application) (get (get match-result :descriptor) :application))
                     (= :gravity.type/bool (get guard-result :type) (get match-result :type))
                     (= 'get (get access-header :operation)) (= :gravity.type/keyword (get access-header :selected-type))
                     (= '+ (get step-header :operation)) (= [:gravity.type/integer :gravity.type/integer] (get step-header :argument-types))])
                (let [control {:owner-core-node-id (get body :node-id) :condition-core-node-id (get guard :node-id)
                               :condition-type :gravity.type/bool :condition-source (get guard :source)
                               :selected-branch-indexes [1 2] :rule :independent-normal-condition}
                      witness {:status :accepted :return-type :gravity.type/bool
                               :witnesses [{:node-id (get base-node :node-id) :source (get base-node :source) :type :gravity.type/bool
                                            :path [(get body :node-id) (get base-node :node-id)] :control-records [control]
                                            :rule :independent-normal-return-value}]
                               :pending-return-node-ids [(get inner :node-id)]}]
                  {:status :accepted :return-witness witness
                   :proof {:kind :gravity.safety/indexed-private-self-range :version :sh08-indexed-private-self-range-v1
                           :rule "SAFE9-OVERFLOW" :outcome :proven-safe :scope :ordinary-function-entry-induction
                           :function-record record :parameter-binding-ids params :parameter-types (get entries :parameter-types)
                           :entry-call-node-ids normal-entry-ids :initial-index 0 :minimum-index 0 :maximum-index 7 :vector-extent 7
                           :body-node body :inner-node inner :base-node base-node :true-node true-node
                           :guard-call guard-call :guard-edge (get edge-index (get guard :node-id))
                           :guard-descriptor (get guard-result :descriptor) :count-descriptor (get count-result :descriptor)
                           :match-descriptor (get match-result :descriptor) :access-header access-header :step-header step-header
                           :unit-node (get nodes (get step-args 1))
                           :unit-source (get forms (get (get (get nodes (get step-args 1)) :source) :form-id))
                           :source-forms (loop [ids (keys forms) out []]
                                           (if (= 0 (count ids)) out
                                             (recur (rest ids) (conj out (get forms (first ids))))))
                           :self-call self :self-edge self-edge :strict-access-edge :equality-false
                           :vector-and-needle :original-immutable-parameter-references
                           :step :binary-source-integer-literal-one :numeric-mode :proof-required :integer-type :gravity.type/integer
                           :check-elision :not-authorized :runtime-guards :retained}})
                {:status :rejected :reason :indexed-self-source-induction-required})))))))

(defn sh08-ds-proof [shape products bindings module]
  (let [nodes (get shape :nodes) records (get products :function-records)
        calls (get products :calls) edges (get products :call-edges)
        components (get products :recursion-components)
        locals (get products :lexical-bindings)]
    (if (= 1 (count components))
        (let [component (first components) id (first (get component :function-syntax-ids))
              record (sh08-ft-function-by-syntax-id records id)
              definition (sh08-ft-definition-by-binding-id (get products :definitions) (get record :definition-binding-id))
              signature (get record :signature) declarations (get signature :parameters)
              arity (get record :fixed-arity) node-table (sh08-ft-node-index nodes)
              binding-table (sh08-ft-binding-index bindings)
              ordinal (first (get component :internal-call-edge-ordinals))
              edge (if (integer? ordinal) (get edges ordinal) nil)
              call (sh08-ft-higher-order-call-by-node-id calls (get edge :call-core-node-id))
              call-node (get node-table (get call :core-node-id))
              parameter-types (loop [remaining declarations out []]
                                (if (= 0 (count remaining)) out
                                  (recur (rest remaining) (conj out (get (first remaining) :type-id)))))
              local-ids (loop [remaining locals out (set (get record :parameter-binding-ids))]
                          (if (= 0 (count remaining)) out
                            (let [local (first remaining) owner (get (get (get node-table (get local :let-core-node-id)) :evaluation) :owner-function-syntax-id)]
                              (recur (rest remaining) (if (= owner id) (conj out (get local :binding-id)) out)))))
              owned (loop [remaining nodes out []]
                      (if (= 0 (count remaining)) out
                        (let [node (first remaining)]
                          (recur (rest remaining)
                            (if (= id (get (get node :evaluation) :owner-function-syntax-id))
                              (conj out (get node :node-id)) out)))))
              incoming (loop [remaining edges out []]
                         (if (= 0 (count remaining)) out
                           (recur (rest remaining)
                             (if (= id (get (first remaining) :callee-function-syntax-id))
                               (conj out (get (first remaining) :call-core-node-id)) out))))
              references? (loop [remaining nodes]
                            (if (= 0 (count remaining)) true
                              (let [node (first remaining) bid (get (get node :attributes) :binding-id)
                                    binding (get binding-table bid)]
                                (if (if (= id (get (get node :evaluation) :owner-function-syntax-id))
                                      (if (contains? #{:try :loop :recur} (get node :core-form)) false
                                        (if (= :reference (get node :core-form))
                                          (if (contains? local-ids bid) true
                                            (if (= bid (get record :definition-binding-id))
                                              (= (get node :node-id) (first (get call-node :children)))
                                              (= [:core :var 'gravity.core]
                                                 [(get binding :binding-class) (get binding :kind) (get binding :namespace)]))) true)) true)
                                  (recur (rest remaining)) false))))
              census? (loop [remaining edges index 0 self-count 0]
                        (if (= 0 (count remaining)) (= 1 self-count)
                          (let [current (first remaining) current-call (get calls index)
                                current-node (get node-table (get current :call-core-node-id))
                                self? (= id (get current :caller-function-syntax-id) (get current :callee-function-syntax-id))]
                            (if (sh08-ft-all-true?
                                  [(= index (get current :ordinal))
                                   (= (get current :call-core-node-id) (get current-call :core-node-id))
                                   (= (get current :argument-core-node-ids) (get current-call :argument-node-ids))
                                   (= (get current :ordered-evaluation-node-ids) (get current-call :ordered-evaluation-node-ids) (get current-node :children))
                                   (= :operator-then-arguments (get current :evaluation-order) (get current-call :evaluation-order))
                                   (if (= id (get current :callee-function-syntax-id))
                                     (sh08-ft-all-true?
                                       [(= :local-function (get current :classification))
                                        (= (get record :function-core-node-id) (get current :callee-function-core-node-id))
                                        (= (get record :definition-binding-id) (get current :callee-binding-id) (get current-call :operator-binding-id))
                                        (= arity (count (get current-call :argument-node-ids)))
                                        (= (get current :caller-function-syntax-id) (get (get current-node :evaluation) :owner-function-syntax-id))]) true)])
                              (recur (rest remaining) (+ index 1) (if self? (+ self-count 1) self-count)) false))))]
          (if (sh08-ft-all-true?
                [(= (count calls) (count edges))
                 (= {:ordinal 0 :kind :self-recursive :function-syntax-ids [id]
                     :function-core-node-ids [(get record :function-core-node-id)]
                     :internal-call-edge-ordinals [ordinal]} component)
                 (= :named-top-level (get record :definition-kind))
                 (if (integer? arity) (> arity 0) false)
                 (vector? declarations) (= arity (count declarations) (count (get record :parameter-binding-ids)))
                 (map? (get signature :return))
                 (sh08-ds-type? (get (get signature :return) :type-id))
                 (loop [remaining parameter-types]
                   (if (= 0 (count remaining)) true
                     (if (sh08-ds-type? (first remaining)) (recur (rest remaining)) false)))
                 (sh08-ft-recursive-call-edge-valid? edge call call-node record definition bindings true)
                 references? census?])
            {:status :accepted :rule-version :sh08-declared-self-value-v1
             :component component :function-record record :function-syntax-id id
             :function-node (get node-table (get record :function-core-node-id))
             :definition definition :recursive-call call :recursive-edge edge :recursive-node call-node
             :self-call-core-node-id (get call :core-node-id)
             :parameter-types parameter-types :declared-return-type (get (get signature :return) :type-id)
             :owned-node-ids owned :incoming-call-node-ids incoming :module module}
            {:status :rejected :reason :declared-self-signature-census-or-capture :node call-node}))
        {:status :rejected :reason :declared-self-single-component-required})))

(defn sh08-rv? [proof]
  (if (sh08-ds? proof) true (sh08-is? proof)))

(defn sh08-is-proof-input [proof]
  (let [record (get proof :function-record)]
    {:domain (if (= :sh08-indexed-private-self-value-v1 (get proof :rule-version))
               :gravity/sh08-indexed-private-self-value-proof-v1 :gravity/sh08-private-self-value-proof-v1)
     :function-syntax-id (get record :function-syntax-id)
     :function-core-node-id (get record :function-core-node-id)
     :definition-binding-id (get record :definition-binding-id)
     :definition-syntax-id (get (get proof :definition) :syntax-id)
     :body-core-node-id (get record :body-core-node-id)
     :parameter-binding-ids (get record :parameter-binding-ids)
     :parameter-types (get proof :parameter-types) :inferred-return-type (get proof :inferred-return-type)
     :signature (get record :signature) :component (get proof :component)
     :self-call-core-node-id (get proof :self-call-core-node-id)
     :self-call (get proof :recursive-call) :self-edge (get proof :recursive-edge)
     :self-call-source (get (get proof :recursive-node) :source)
     :owned-node-ids (get proof :owned-node-ids) :incoming-call-node-ids (get proof :incoming-call-node-ids)
     :parameter-value-premise (get proof :parameter-value-premise)
     :cold-body-derivation (get proof :cold-body-derivation) :return-witness (get proof :return-witness)
     :value-inference (if (= :sh08-indexed-private-self-value-v1 (get proof :rule-version))
                        :closed-private-indexed-normal-entries-and-source-induction
                        :closed-private-monomorphic-normal-entries-and-return-witness)
     :value-check :complete-body-and-all-incoming-arguments
     :effect-error-status :pending-sh09-recursive-body
     :captures :own-parameters-and-lexical-locals-only}))

(defn sh08-ds-proof-input [proof]
  (let [record (get proof :function-record)]
    {:domain :gravity/sh08-declared-self-value-proof-v1
     :function-syntax-id (get record :function-syntax-id)
     :function-core-node-id (get record :function-core-node-id)
     :definition-binding-id (get record :definition-binding-id)
     :definition-syntax-id (get (get proof :definition) :syntax-id)
     :body-core-node-id (get record :body-core-node-id)
     :parameter-binding-ids (get record :parameter-binding-ids)
     :parameter-types (get proof :parameter-types)
     :declared-return-type (get proof :declared-return-type)
     :signature (get record :signature) :component (get proof :component)
     :self-call-core-node-id (get proof :self-call-core-node-id)
     :self-call (get proof :recursive-call) :self-edge (get proof :recursive-edge)
     :self-call-source (get (get proof :recursive-node) :source)
     :owned-node-ids (get proof :owned-node-ids)
     :incoming-call-node-ids (get proof :incoming-call-node-ids)
     :value-check :complete-body-and-all-incoming-arguments
     :effect-error-status :pending-sh09-recursive-body
     :captures :own-parameters-and-lexical-locals-only}))

(defn sh08-ds-call-facts [proof canonical]
  (let [incoming (set (get proof :incoming-call-node-ids))]
  (loop [remaining canonical out []]
    (if (= 0 (count remaining)) out
      (let [fact (first remaining) id (get fact :call-core-node-id)]
        (recur (rest remaining)
          (if (contains? incoming id)
            (conj out (assoc fact :role (if (= id (get proof :self-call-core-node-id)) :self-recursive-call
                                        (if (sh08-is? proof) :incoming-private-entry-call :incoming-declared-call))))
            out)))))))

(defn sh08-ft-recursive-complete-function
  [skeleton proof]
  (if (sh08-ds? proof) skeleton
  (let [parameter-ids (get (get proof :function-record) :parameter-binding-ids)
        parameter-types (get proof :parameter-types)
        parameters
        (loop [ids parameter-ids types parameter-types values []]
          (if (= (count ids) 0)
            values
            (recur
             (rest ids)
             (rest types)
             (conj values {:binding-id (first ids) :type (first types)}))))]
    (assoc
     (assoc
      (assoc
       skeleton
       :parameters parameters)
      :return (if (sh08-is? proof) (get proof :inferred-return-type) (get proof :base-type)))
     :source-span
     (get (get (get proof :function-node) :source) :semantic-span)))))

(defn sh08-ft-recursive-proof-input [proof]
  (if (sh08-rv? proof) (if (sh08-is? proof) (sh08-is-proof-input proof) (sh08-ds-proof-input proof))
  (let [record (get proof :function-record)
        definition (get proof :definition)
        call (get proof :recursive-call)
        edge (get proof :recursive-edge)
        recursive-node (get proof :recursive-node)
        parameter-evidence (get proof :parameter-evidence)
        evidence-call (get parameter-evidence :call)
        evidence-edge (get parameter-evidence :edge)
        evidence-node (get parameter-evidence :node)
        module (get proof :module)]
    {:domain :gravity/sh08-authoritative-recursive-proof-v1
     :function-syntax-id (get record :function-syntax-id)
     :function-core-node-id (get record :function-core-node-id)
     :definition-binding-id (get definition :binding-id)
     :definition-syntax-id (get definition :syntax-id)
     :parameter-binding-ids (get record :parameter-binding-ids)
     :fixed-arity (get record :fixed-arity)
     :recursive-call-core-node-id (get call :core-node-id)
     :recursive-argument-node-ids (get call :argument-node-ids)
     :recursive-edge (sh08-ft-higher-order-edge-projection edge)
     :recursive-call-source
     {:syntax-id (get (get recursive-node :source) :syntax-id)
      :source-span (get (get recursive-node :source) :semantic-span)
      :origin-chain (get (get recursive-node :source) :origin-chain)
      :generated-origin (get (get recursive-node :source) :generated-origin)}
     :recursive-call-profile (get module :profile)
     :recursive-call-target (get module :target)
     :recursive-call-effects (get module :effects)
     :recursive-call-capabilities (get module :capabilities)
     :base-node-id (get (get proof :base-node) :node-id)
     :base-type (get proof :base-type)
     :recursive-definition-binding-id (get definition :binding-id)
     :parameter-evidence-call-core-node-id
     (get evidence-call :core-node-id)
     :parameter-evidence-call
     {:call-core-node-id (get evidence-call :core-node-id)
      :caller-function-syntax-id (get evidence-edge :caller-function-syntax-id)
      :callee-function-syntax-id (get evidence-edge :callee-function-syntax-id)
      :argument-node-ids (get evidence-call :argument-node-ids)
      :ordered-evaluation-node-ids
      (get evidence-call :ordered-evaluation-node-ids)
      :evaluation-order (get evidence-call :evaluation-order)
      :argument-types (get parameter-evidence :types)
      :result-type (first (get parameter-evidence :types))
      :syntax-id (get (get evidence-node :source) :syntax-id)
      :source-span (get (get evidence-node :source) :semantic-span)
      :origin-chain (get (get evidence-node :source) :origin-chain)
      :generated-origin (get (get evidence-node :source) :generated-origin)
      :profile (get module :profile)
      :target (get module :target)
      :effects (get module :effects)
      :capabilities (get module :capabilities)
      :edge (sh08-ft-higher-order-edge-projection evidence-edge)}
     :parameter-types (get proof :parameter-types)
     :proof-bound
     :one-named-self-recursive-positive-fixed-arity-positional-literal-base
     :captures? false
     :higher-order? false
     :monotone-fixed-point? true})))

(defn sh08-ft-call-fact-by-id [facts call-id]
  (if (= (count facts) 0)
    nil
    (if (= call-id (get (first facts) :call-core-node-id))
      (first facts)
      (sh08-ft-call-fact-by-id (rest facts) call-id))))

(defn sh08-ft-recursive-call-proof-facts [proof canonical-call-facts]
  (if (sh08-rv? proof) (sh08-ds-call-facts proof canonical-call-facts)
  (let [record (get proof :function-record)
        call (get proof :recursive-call)
        edge (get proof :recursive-edge)
        parameter-evidence (get proof :parameter-evidence)
        evidence-call (get parameter-evidence :call)
        evidence-edge (get parameter-evidence :edge)
        recursive-fact
        (sh08-ft-call-fact-by-id
         canonical-call-facts (get call :core-node-id))
        evidence-fact
        (sh08-ft-call-fact-by-id
         canonical-call-facts (get evidence-call :core-node-id))]
    [(assoc
      (if (map? recursive-fact) recursive-fact {})
      :role :self-recursive-call
      :recursive-definition-binding-id
      (get (get proof :definition) :binding-id)
      :b47-edge (sh08-ft-higher-order-edge-projection edge)
      :result-type (get proof :base-type)
      :dispatch :direct-named-self-recursion)
     (assoc
      (if (map? evidence-fact) evidence-fact {})
      :role :external-parameter-evidence
      :parameter-evidence? true
      :external-edge (sh08-ft-higher-order-edge-projection evidence-edge)
      :argument-types (get parameter-evidence :types)
      :result-type (first (get parameter-evidence :types)))])))

(defn sh08-ft-recursive-constraint-ledger [proof]
  (if (sh08-is? proof)
    [{:constraint-id-request {:domain (if (= :sh08-indexed-private-self-value-v1 (get proof :rule-version))
                                             :gravity/sh08-indexed-private-self-value-constraint-v1
                                             :gravity/sh08-private-self-value-constraint-v1) :premise (sh08-is-proof-input proof)}
      :kind (if (= :sh08-indexed-private-self-value-v1 (get proof :rule-version)) :recursive-indexed-private-value :recursive-private-value)
      :producer-rule (get proof :rule-version)
      :lhs (get proof :function-syntax-id) :rhs (get proof :inferred-return-type)
      :dependencies (sh08-is-proof-input proof)
      :profile (get (get proof :module) :profile) :target (get (get proof :module) :target)
      :status :solved :diagnostics []}]
  (if (sh08-ds? proof)
    [{:constraint-id-request {:domain :gravity/sh08-declared-self-value-constraint-v1
                             :premise (sh08-ds-proof-input proof)}
      :kind :recursive-declared-value :producer-rule :sh08-declared-self-value-v1
      :lhs (get proof :function-syntax-id) :rhs (get proof :declared-return-type)
      :dependencies (sh08-ds-proof-input proof)
      :profile (get (get proof :module) :profile) :target (get (get proof :module) :target)
      :status :solved :diagnostics []}]
  [{:constraint-id-request
    {:domain :gravity/sh08-recursive-call-constraint-v1
     :function-syntax-id (get proof :function-syntax-id)
     :call-core-node-id (get (get proof :recursive-call) :core-node-id)
     :fixed-arity (get (get proof :function-record) :fixed-arity)}
    :kind :recursive-fixed-point
    :lhs (get proof :function-syntax-id)
    :rhs (get proof :base-type)
    :origin (get (get (get proof :recursive-node) :source) :origin-chain)
    :profile (get (get proof :module) :profile)
    :target (get (get proof :module) :target)
    :status :solved
    :diagnostics []}])))

(defn sh08-ft-update-param-types [function-types binding-types]
  (loop [remaining (keys function-types)
         result function-types]
    (if (= (count remaining) 0)
      result
      (let [function-id (first remaining)
            function (get result function-id)
            parameter-ids (get function :parameter-binding-ids)
            parameter-types
            (loop [ids parameter-ids values []]
              (if (= (count ids) 0)
                values
                (recur
                 (rest ids)
                 (conj values
                       (get binding-types (first ids)
                            :gravity.type/unknown)))))]
        (recur
         (rest remaining)
         (assoc result function-id
                (assoc function :parameters
                       (loop [types parameter-types ids parameter-ids values []]
                         (if (= (count types) 0)
                           values
                           (recur
                            (rest types)
                            (rest ids)
                            (conj values
                                  {:binding-id (first ids)
                                   :type (first types)})))))))))))

(defn sh08-ft-edge-by-call-id [edges call-id]
  (loop [remaining edges]
    (if (= (count remaining) 0)
      nil
      (if (= (get (first remaining) :call-core-node-id) call-id)
        (first remaining)
        (recur (rest remaining))))))

(defn sh08-ft-function-by-id [function-types syntax-id]
  (get function-types syntax-id))

(defn sh08-ft-function-by-core-id [function-types core-node-id]
  (loop [remaining (keys function-types)]
    (if (= (count remaining) 0)
      nil
      (let [function (get function-types (first remaining))]
        (if (= (get function :function-core-node-id) core-node-id)
          function
          (recur (rest remaining)))))))

(defn sh08-ft-if-join-with-context [children type-table context]
  (let [then-id (second children)
        else-id (sh08-third children)
        then-type (get type-table then-id :gravity.type/unknown)
        else-type (get type-table else-id :gravity.type/unknown)]
    (if (= then-type else-type)
      (if (sh08-ft-known? then-type)
        then-type
        (if (if (= :accepted (get context :status)) (contains? context :recursive-call-core-node-id) false)
          (if (if (= then-id (get context :recursive-call-core-node-id))
                true
                (= else-id (get context :recursive-call-core-node-id)))
            (get context :recursive-base-type :gravity.type/unknown)
            :gravity.type/unknown)
          :gravity.type/unknown))
      (if (if (= :accepted (get context :status)) (contains? context :recursive-call-core-node-id) false)
        (if (= then-id (get context :recursive-call-core-node-id))
          (if (sh08-ft-known? else-type)
            else-type
            (get context :recursive-base-type :gravity.type/unknown))
          (if (= else-id (get context :recursive-call-core-node-id))
            (if (sh08-ft-known? then-type)
              then-type
              (get context :recursive-base-type :gravity.type/unknown))
            :gravity.type/unknown))
        (sh08-ij-normal-type then-type else-type)))))

; L1/L2 quoted payloads are authenticated DATA, never executable core nodes.
(defn sh08-qd-failure [rule reason form expected actual]
  {:status :rejected :rule rule :reason reason :form form :expected expected :actual actual})

(defn sh08-qd-scalar-valid? [kind value]
  (if (= kind :nil) (= value nil)
    (if (= kind :boolean) (contains? #{true false} value)
      (if (= kind :integer) (integer? value)
        (if (= kind :character) (sh08-character-carrier? value)
          (if (= kind :string) (string? value)
            (if (= kind :keyword) (keyword? value)
              (if (= kind :symbol) (symbol? value) false))))))))

(defn sh08-qd-collection-value-valid? [kind value values]
  (if (contains? #{:list :vector} kind)
    (if (if (= kind :list) (seq? value) (vector? value)) (= (vec value) values) false)
    (if (= kind :set)
      (if (set? value) (if (= (count value) (count values)) (= value (set values)) false) false)
      (if (= kind :map)
        (if (if (map? value) (sh08-even-count? values) false)
          (if (= (* 2 (count value)) (count values))
            (= value (loop [remaining values out {}]
                       (if (= (count remaining) 0) out
                         (recur (rest (rest remaining)) (assoc out (first remaining) (second remaining)))))) false) false)
        false))))

(defn sh08-distinct-source-ids? [ids]
  (if (vector? ids)
    (loop [remaining ids observed #{}]
      (if (= 0 (count remaining)) true
        (let [id (first remaining)]
          (if (sh08-sha256-id? id)
            (if (contains? observed id) false
              (recur (rest remaining) (conj observed id))) false))))
    false))

(defn sh08-qd-collection [form quote-id path children]
  (let [kind (get form :kind) value (get form :value)
        parts (loop [remaining children values [] types []]
                (if (= 0 (count remaining)) {:values values :types types}
                  (let [child (first remaining)]
                    (recur (rest remaining) (conj values (get child :value))
                      (conj types (get child :type))))))]
    (if (sh08-qd-collection-value-valid? kind value (get parts :values))
      {:status :accepted
       :data {:origin {:kind :quoted-data :quote-core-node-id quote-id :form-id (get form :form-id)
                       :syntax-id (get form :syntax-id) :data-path path :child-form-ids (get form :child-form-ids)}
              :kind kind :value value :children children
              :source (get (sh08-bm-source-node {} form) :source)
              :type (if (= kind :map) {:kind :gravity.type/map :member-types (get parts :types) :shape :literal}
                      {:kind (get {:list :gravity.type/list :vector :gravity.type/vector :set :gravity.type/set} kind)
                       :element-types (get parts :types) :shape :literal})}}
      (sh08-qd-failure "C7-VERIFY" :quoted-data-value-child-mismatch form :exact-ordered-data-children value))))

(defn sh08-qd-data [forms id parent quote-id path seen]
  ; Continuations retain the original child order and ancestor IDs. Each
  ; occurrence is derived here; no prior validation or derived type is input.
  (loop [pending (list {:phase :visit :id id :parent parent :path path :seen seen}) result nil]
    (if (= 0 (count pending)) result
      (let [frame (first pending) tail (rest pending)]
        (if (= :visit (get frame :phase))
          (let [id (get frame :id) form (if (sh08-sha256-id? id) (get forms id) nil)
                kind (get form :kind) value (get form :value) ids (get form :child-form-ids)]
            (if (sh08-ft-all-true?
                  [(map? form) (sh08-sha256-id? id) (= id (get form :form-id))
                   (= (get frame :parent) (get form :parent-form-id))
                   (sh08-sha256-id? (get form :syntax-id)) (sh08-distinct-source-ids? ids)
                   (= false (contains? (get frame :seen) id))])
              (if (contains? #{:list :vector :map :set} kind)
                (recur (conj tail {:phase :children :form form :path (get frame :path)
                                   :seen (conj (get frame :seen) id) :remaining ids :ordinal 0
                                   :children [] :after-child? false}) nil)
                (let [scalar (if (contains? #{:decimal :ratio :integer} kind)
                               (if (if (= kind :integer) (integer? value) false)
                                 (sh08-qd-scalar form quote-id (get frame :path))
                                 (sh08-qd-failure "C7-ANNOTATION" :unsupported-quoted-numeric-representation
                                   form :normalized-exact-integer value))
                               (if (contains? #{:nil :boolean :character :string :keyword :symbol} kind)
                                 (sh08-qd-scalar form quote-id (get frame :path))
                                 (sh08-qd-failure "C7-ANNOTATION" :unsupported-quoted-data-kind
                                   form :first-order-immutable-data kind)))]
                  (if (= :accepted (get scalar :status)) (recur tail scalar) scalar)))
              (sh08-qd-failure "C7-VERIFY" :malformed-quoted-data-tree
                form :exact-acyclic-payload-parent-child-join id)))
          (let [form (get frame :form) remaining (get frame :remaining)
                children (if (get frame :after-child?) (conj (get frame :children) (get result :data))
                             (get frame :children))]
            (if (= 0 (count remaining))
              (let [complete (sh08-qd-collection form quote-id (get frame :path) children)]
                (if (= :accepted (get complete :status)) (recur tail complete) complete))
              (let [ordinal (get frame :ordinal)
                    resume (assoc frame :remaining (rest remaining) :ordinal (+ ordinal 1)
                                        :children children :after-child? true)
                    child {:phase :visit :id (first remaining) :parent (get form :form-id)
                           :path (conj (get frame :path) ordinal) :seen (get frame :seen)}]
                (recur (conj (conj tail resume) child) nil)))))))))

(defn sh08-qd-scalar [form quote-id path]
  (let [kind (get form :kind) value (get form :value)]
    (if (if (= [] (get form :child-form-ids)) (sh08-qd-scalar-valid? kind value) false)
      {:status :accepted
       :data {:origin {:kind :quoted-data :quote-core-node-id quote-id :form-id (get form :form-id)
                       :syntax-id (get form :syntax-id) :data-path path :child-form-ids []}
              :kind kind :value value :type (sh08-primitive-type-from-literal-kind kind)
              :source (get (sh08-bm-source-node {} form) :source) :children []}}
      (sh08-qd-failure "C7-VERIFY" :quoted-scalar-kind-value-mismatch form :exact-scalar-kind-value-and-zero-children value))))

(defn sh08-qd-node-valid-data [node forms]
  (let [owner (get forms (get (get node :source) :form-id)) ids (get owner :child-form-ids)
        operator (get forms (get ids 0)) payload (get forms (get ids 1)) attrs (get node :attributes)]
    (if (sh08-ft-all-true?
          [(= :quote (get node :core-form)) (= :list (get owner :kind)) (vector? ids) (= 2 (count ids))
           (sh08-all-unique? ids [])
           (= (get node :source) (get (sh08-bm-source-node {} owner) :source))
           (= (get ids 0) (get operator :form-id)) (= (get ids 1) (get payload :form-id))
           (sh08-sha256-id? (get operator :syntax-id))
           (= :symbol (get operator :kind)) (= 'quote (get operator :value)) (= [] (get operator :child-form-ids))
           (= (get owner :form-id) (get operator :parent-form-id) (get payload :parent-form-id))
           (seq? (get owner :value)) (= (vec (get owner :value)) ['quote (get payload :value)])
           (= [] (get node :children) (get node :resolved-binding-ids))
           (= :no-evaluation (get (get node :evaluation) :kind)) (= [] (get (get node :evaluation) :order))
           (= attrs {:quoted-form-id (get payload :form-id) :quoted-syntax-id (get payload :syntax-id)
                     :quoted-kind (get payload :kind) :quoted-value (get payload :value)})])
      (let [result (sh08-qd-data forms (get payload :form-id) (get owner :form-id) (get node :node-id) [] #{})]
        result)
      (sh08-qd-failure "C7-VERIFY" :malformed-quote-owner-payload-join owner :exact-inert-quote-source-and-payload attrs))))

(defn sh08-qd-node [node forms]
  (sh08-qd-node-valid-data node forms))

(defn sh08-qd-executable-data [data executable-forms]
  (if (contains? executable-forms (get (get data :origin) :form-id)) data
    (loop [remaining (get data :children)]
      (if (= (count remaining) 0) nil
        (let [found (sh08-qd-executable-data (first remaining) executable-forms)]
          (if (= found nil) (recur (rest remaining)) found))))))

(defn sh08-qd-products-valid-data [nodes source-forms module]
  (let [forms (loop [remaining source-forms out {}]
                (if (= (count remaining) 0) out
                  (recur (rest remaining) (assoc out (get (first remaining) :form-id) (first remaining)))))
        executable-forms (loop [remaining nodes out #{}]
                           (if (= (count remaining) 0) out
                             (recur (rest remaining) (conj out (get (get (first remaining) :source) :form-id)))))]
    (loop [remaining nodes types {} constraints [] diagnostics []]
      (if (= (count remaining) 0)
        {:type-table types :constraints constraints :diagnostics diagnostics}
        (let [node (first remaining)]
          (if (= :quote (get node :core-form))
            (let [checked (sh08-qd-node node forms)
                  executable (if (= :accepted (get checked :status))
                               (sh08-qd-executable-data (get checked :data) executable-forms) nil)
                  result (if (= executable nil) checked
                           (sh08-qd-failure "C7-VERIFY" :quoted-payload-is-executable
                             (get forms (get (get executable :origin) :form-id)) :data-without-executable-nodes
                             (get executable :origin)))]
              (if (= :accepted (get result :status))
                (let [data (get result :data) type (get data :type)
                      premise {:core-node-id (get node :node-id) :source (get node :source)
                               :attributes (get node :attributes) :children (get node :children)
                               :resolved-binding-ids (get node :resolved-binding-ids) :evaluation (get node :evaluation)}]
                  (recur (rest remaining) (assoc types (get node :node-id) type)
                    (conj constraints {:constraint-id-request {:domain :gravity/sh08-recursive-quoted-data-constraint-v1
                                                              :quote premise :data data}
                                       :kind :equality :producer-rule :sh08-recursive-quoted-data-v1 :lhs (get node :node-id) :rhs type
                                       :quoted-data data :dependencies {:quote premise :data data}
                                       :solution {:type type :evaluation :no-evaluation}
                                       :invalidation [:quote-owner :quote-operator :payload-form-syntax-ids :payload-kind-value
                                                      :payload-child-order :data-paths :no-executable-children-bindings-calls]
                                       :profile (get module :profile) :target (get module :target) :status :solved :diagnostics []})
                    diagnostics))
                (recur (rest remaining) types constraints
                  (conj diagnostics (sh08-bm-error (get result :rule) (get result :reason)
                                      (if (map? (get result :form)) (sh08-bm-source-node node (get result :form)) node)
                                      (get result :expected) (get result :actual))))))
            (recur (rest remaining) types constraints diagnostics)))))))

(defn sh08-qd-products [nodes source-forms module]
  (sh08-qd-products-valid-data nodes source-forms module))

(defn sh08-qd-shape [data node]
  (let [kind (get data :kind) children (get data :children)
        base {:status :accepted :type (get data :type) :data-origin (get data :origin)
              :source (get data :source) :binding-links []}]
    (if (contains? #{:map :vector} kind)
      (loop [remaining children ordinal 0 parts []]
        (if (= (count remaining) 0) (assoc base :shape-kind kind :parts parts :constructor-origin :quoted-data)
          (let [key (if (= kind :map) (first remaining) nil)
                value (if (= kind :map) (second remaining) (first remaining))
                child-shape (sh08-qd-shape value node)]
            (if (if (= kind :map) (= :keyword (get key :kind)) true)
              (if (= :accepted (get child-shape :status))
                (recur (if (= kind :map) (rest (rest remaining)) (rest remaining))
                       (+ ordinal (if (= kind :map) 2 1))
                       (conj parts {:key (get key :value) :coordinate (if (= kind :map) (+ ordinal 1) ordinal)
                                    :key-data-origin (get key :origin) :value-data-origin (get value :origin) :shape child-shape})) child-shape)
              (assoc (sh08-sm-failure "C7-ANNOTATION" :unsupported-structural-map-key nil :literal-keyword-key (get key :value))
                     :node (assoc node :source (get key :source)))))))
      (assoc base :shape-kind :scalar :domain {:values [(get data :value)]}))))

; L2/L5/L9: direct throws retain the original C6 transfer, including transfers
; whose payload never returns. No call or handler propagation is inferred here.
(defn sh08-th-error [rule reason node expected actual]
  {:status :rejected :constraints [] :throws {} :diagnostics
   [{:rule rule :reason reason :node node :expected expected :actual actual}]})

(defn sh08-th-owners [core]
  (let [nodes (sh08-ft-node-index (get core :nodes))]
    (loop [pending (loop [ids (get core :root-core-node-ids) out []]
                     (if (= 0 (count ids)) out
                       (recur (rest ids) (conj out {:id (first ids) :owner nil}))))
           owners {}]
      (if (= 0 (count pending)) {:status :accepted :owners owners}
        (let [entry (first pending) id (get entry :id) node (get nodes id) owner (get entry :owner)
              child-owner (if (= :fn (get node :core-form)) (get (get node :source) :syntax-id) owner)]
          (if (if (map? node) (= false (contains? owners id)) false)
            (recur (loop [ids (get node :children) out (vec (rest pending))]
                     (if (= 0 (count ids)) out
                       (recur (rest ids) (conj out {:id (first ids) :owner child-owner}))))
                   (assoc owners id owner))
            (sh08-th-error "C7-VERIFY" :typed-throw-owner-graph node :unique-rooted-node id)))))))

(defn sh08-th-transfer-valid? [transfer node payload forms owner ordinal]
  (let [source (get node :source) form (get forms (get source :form-id)) ids (get form :child-form-ids)
        operator (get forms (get ids 0)) value (get forms (get ids 1)) attrs (get node :attributes)
        shared [:construction-order :runtime-reachability :transfer-policy :result-policy :required-effect
                :authenticated-sh06-artifact-id :sh06-semantic-projection-id :type-legality :effect-registry-legality
                :effect-profile-capability-legality :profile-error-lowering-legality :ownership-legality :safety-classification]]
    (sh08-ft-all-true?
      [(map? transfer) (= ordinal (get transfer :ordinal)) (= :throw (get node :core-form))
       (= (get node :node-id) (get transfer :core-node-id))
       (= (get source :form-id) (get transfer :form-id)) (= (get source :syntax-id) (get transfer :syntax-id))
       (= source (get (sh08-bm-source-node {} form) :source))
       (= :list (get form :kind)) (vector? ids) (= 2 (count ids)) (sh08-all-unique? ids [])
       (if (seq? (get form :value)) (= ['throw (get value :value)] (vec (get form :value))) false)
       (= :symbol (get operator :kind)) (= 'throw (get operator :value)) (= [] (get operator :child-form-ids))
       (= (get form :form-id) (get operator :parent-form-id) (get value :parent-form-id))
       (= (get payload :source) (get (sh08-bm-source-node {} value) :source))
       (= [(get payload :node-id)] (get node :children) (get transfer :evaluated-children))
       (= (get payload :node-id) (get transfer :value-core-node-id)) (= [] (get node :resolved-binding-ids))
       (= :value-then-transfer (get (get node :evaluation) :kind) (get attrs :evaluation-order))
       (= [{:index 0 :core-node-id (get payload :node-id)}] (get (get node :evaluation) :order))
       (= owner (get transfer :evaluation-owner-function-syntax-id) (get (get node :evaluation) :owner-function-syntax-id))
       (= (get transfer :evaluation-region) (get (get node :evaluation) :region))
       (= [:evaluate-value :transfer-error] (get transfer :ordered-steps))
       (= 0 (get attrs :value-child-index)) (= :postorder-after-value (get attrs :construction-order))
       (= :error-transfer (get attrs :transfer-policy)) (= :never (get attrs :result-policy))
       (= :error/throw (get attrs :required-effect))
       (= :not-asserted-by-sh07-b7 (get attrs :runtime-reachability))
       (= [:pending-sh08 :pending-sh09 :pending-sh09 :pending-sh09 :pending-sh10 :pending-sh11]
          [(get attrs :type-legality) (get attrs :effect-registry-legality) (get attrs :effect-profile-capability-legality)
           (get attrs :profile-error-lowering-legality) (get attrs :ownership-legality) (get attrs :safety-classification)])
       (= (sh08-bm-project transfer shared) (sh08-bm-project attrs shared))])))

(defn sh08-th-products [core source-forms types]
  (let [nodes (get core :nodes) transfers (get core :error-transfers)
        throw-nodes (sh08-bm-select nodes :core-form :throw)]
    (if (= 0 (count throw-nodes))
      (if (if (= transfers nil) true (if (vector? transfers) (= [] transfers) false))
        {:status :accepted :constraints [] :throws {} :diagnostics []}
        (sh08-th-error "C7-VERIFY" :typed-throw-transfer-census {} :no-extra-error-transfers transfers))
      (let [indexed (sh08-ft-node-index nodes) forms (sh08-ft-index source-forms :form-id)
            owners (sh08-th-owners core)]
        (if (= :accepted (get owners :status))
          (if (sh08-ft-all-true? [(vector? transfers) (= (count throw-nodes) (count (if (vector? transfers) transfers [])))
                 (sh08-ft-unique-records? (if (vector? transfers) transfers []) :core-node-id)
                 (= (set (keys (sh08-ft-node-index throw-nodes)))
                    (set (keys (sh08-ft-index (if (vector? transfers) transfers []) :core-node-id))))])
            (loop [remaining transfers ordinal 0 rows [] thrown {}]
              (if (= 0 (count remaining))
                {:status :accepted :constraints rows :throws thrown :diagnostics []}
                (let [transfer (first remaining) node (get indexed (get transfer :core-node-id))
                      payload (get indexed (get transfer :value-core-node-id))
                      owner (get (get owners :owners) (get node :node-id))
                      type (get types (get payload :node-id) :gravity.type/unknown)
                      occurring? (= false (= type :gravity.type/never))
                      premise {:version :sh08-direct-typed-throw-v1 :source-transfer transfer :source-node node
                               :payload-node payload :payload-type type :owner-function-syntax-id owner
                               :normal-transfer? occurring? :result-type :gravity.type/never}]
                  (if (sh08-th-transfer-valid? transfer node payload forms owner ordinal)
                    (if (sh08-ft-known? type)
                      (recur (rest remaining) (+ ordinal 1)
                        (conj rows {:constraint-id-request {:domain :gravity/sh08-direct-typed-throw-v1 :premise premise}
                          :kind :equality :producer-rule :sh08-direct-typed-throw-v1
                          :lhs (get node :node-id) :rhs :gravity.type/never :dependencies premise
                          :origin (get (get node :source) :origin-chain)
                          :invalidation [:error-transfers :throw-source :payload-source :payload-type :function-owner :evaluation-order]
                          :solution {:type :gravity.type/never :payload-type type :normal-transfer? occurring?}
                          :profile (get (get core :module) :profile) :target (get (get core :module) :target)
                          :status :solved :diagnostics []})
                        (assoc thrown owner (if (if occurring? (= false (contains? (set (get thrown owner [])) type)) false)
                                              (conj (get thrown owner []) type) (get thrown owner []))))
                      (sh08-th-error "C7-ANNOTATION" :typed-throw-payload-type-required payload :concrete-error-value type))
                    (sh08-th-error "C7-VERIFY" :typed-throw-source-transfer-join node :exact-original-error-transfer transfer)))))
            (sh08-th-error "C7-VERIFY" :typed-throw-transfer-census {} :complete-unique-error-transfers transfers))
          owners)))))

(defn sh08-th-functions [functions thrown]
  (loop [remaining functions out []]
    (if (= 0 (count remaining)) out
      (let [function (first remaining) id (get function :function-id)]
        (recur (rest remaining) (conj out (if (contains? thrown id)
          (assoc function :thrown-error-effects (get thrown id)) function)))))))

(defn sh08-tc-union [left right]
  (loop [remaining right out left seen (set left)]
    (if (= 0 (count remaining)) out
      (recur (rest remaining) (if (contains? seen (first remaining)) out (conj out (first remaining)))
             (conj seen (first remaining))))))

(defn sh08-tc-invokes? [node types]
  (loop [remaining (get node :children)]
    (if (= 0 (count remaining)) true
      (if (= :gravity.type/never (get types (first remaining))) false (recur (rest remaining))))))

(defn sh08-pmk-index-forms [forms]
  (if (map? forms) {:status :accepted :forms forms}
    (if (vector? forms)
      (loop [remaining forms out {}]
        (if (= 0 (count remaining)) {:status :accepted :forms out}
          (let [form (first remaining) id (get form :form-id)]
            (if (if (map? form) (sh08-sse-ids? [id] 1) false)
              (if (contains? out id) {:status :rejected :reason :private-map-keys-source-mismatch}
                (recur (rest remaining) (assoc out id form)))
              {:status :rejected :reason :private-map-keys-source-mismatch}))))
      {:status :rejected :reason :private-map-keys-source-mismatch})))

(defn sh08-pmk-check-with-forms [core node call edge nodes bindings types forms]
  (let [indexed (sh08-pmk-index-forms forms)]
    (if (= :accepted (get indexed :status))
      (sh08-pmk-inferred-call core node call edge nodes bindings types (get indexed :forms)) indexed)))

(defn sh08-tc-scope-with-types [core thrown types]
  (let [nodes (sh08-ft-node-index (get core :nodes))
        handler-owners (loop [remaining (get core :error-handlers) out #{}]
                         (if (= 0 (count remaining)) out
                           (recur (rest remaining) (conj out (get (first remaining) :evaluation-owner-function-syntax-id)))))
        initial (sh08-ft-add-values-to-set handler-owners (set (keys thrown)))]
(loop [scope initial remaining (get core :call-edges) next initial touched handler-owners]
    (if (= 0 (count remaining))
      (if (= scope next) {:status :accepted :scope touched :active? (> (count touched) 0)}
        (recur next (get core :call-edges) next touched))
      (let [edge (first remaining) caller (get edge :caller-function-syntax-id) callee (get edge :callee-function-syntax-id)
              local? (= :local-function (get edge :classification))
              intrinsic? (if (keyword? (get (get types (first (get (get nodes (get edge :call-core-node-id)) :children))) :kind)) (contains? #{:gravity.type/applied-integral-ordering :gravity.type/applied-map-association :gravity.type/applied-map-removal :gravity.type/applied-collection-count :gravity.type/applied-vector-nth :gravity.type/applied-vector-get :gravity.type/applied-bounded-successor :gravity.type/applied-bounded-unit-addition :gravity.type/applied-vector-append :gravity.type/applied-list-prepend :gravity.type/applied-string-set-insertion :gravity.type/applied-keyword-set-insertion :gravity.type/applied-symbol-set-insertion :gravity.type/applied-atomic-equality :gravity.type/applied-vector-equality :gravity.type/applied-list-equality :gravity.type/applied-integral-equality :gravity.type/applied-not :gravity.type/applied-vector-predicate :gravity.type/applied-integer-predicate :gravity.type/applied-set-conversion :gravity.type/applied-list-set-conversion :gravity.type/applied-map-contains :gravity.type/applied-map-get :gravity.type/applied-string-concat :gravity.type/applied-nonnegative-integer-quotient :gravity.type/applied-vector-slice :gravity.type/applied-string-character-vector :gravity.type/applied-count-quotient-scaling :gravity.type/applied-list-construction :gravity.type/applied-list-query :gravity.type/applied-map-predicate  :gravity.type/applied-keyword-predicate :gravity.type/applied-string-predicate :gravity.type/applied-keyword-set-equality :gravity.type/applied-bare-keyword-anchor-set-equality :gravity.type/applied-string-set-equality  :gravity.type/applied-keyword-set-contains  :gravity.type/applied-set-predicate :gravity.type/applied-list-predicate :gravity.type/applied-symbol-predicate :gravity.type/applied-boolean-predicate :gravity.type/applied-nil-predicate :gravity.type/applied-character-predicate :gravity.type/applied-atomic-inequality :gravity.type/applied-character-set-contains :gravity.type/applied-string-set-contains :gravity.type/applied-symbol-set-contains :gravity.type/applied-integer-set-contains :gravity.type/applied-vector-first :gravity.type/applied-vector-empty :gravity.type/applied-vector-rest :gravity.type/applied-map-keys :gravity.type/applied-private-map-keys}
                            (get (get types (first (get (get nodes (get edge :call-core-node-id)) :children))) :kind)) false)
              touches? (if (contains? scope caller) true (if local? (contains? scope callee) false))]
          (if (if touches? (if local? false (= false intrinsic?)) false)
            (sh08-th-error "C7-ANNOTATION" :unsupported-throwing-call-component {} :direct-local-call edge)
            (recur scope (rest remaining) (if touches? (if local? (conj (conj next caller) callee) (conj next caller)) next)
                   (if touches? (if local? (conj (conj touched caller) callee) (conj touched caller)) touched))))))))

(defn sh08-tc-scope [core thrown]
  (sh08-tc-scope-with-types core thrown {}))

(defn sh08-eh-source-products [core source-forms bindings]
  (let [sequence (get core :nodes) records (get core :error-handlers)]
    (if (sh08-ft-all-true? [(vector? sequence) (vector? source-forms) (vector? bindings)
                            (if (= records nil) true (vector? records))])
  (let [tries (sh08-bm-select sequence :core-form :try)
        records (get core :error-handlers) count-records (if (vector? records) (count records) 0)
        shapes? (loop [remaining tries]
                  (if (= 0 (count remaining)) true
                    (let [node (first remaining) attrs (get node :attributes)]
                      (if (if (vector? (get node :children))
                            (if (map? attrs) (vector? (get attrs :handler-clauses)) false) false)
                        (recur (rest remaining)) false))))
        ]
    (if (= 0 (count tries))
      (if (if (= records nil) true (= [] records))
        {:status :accepted :groups {} :seeds {} :diagnostics []}
        (sh08-th-error "C7-VERIFY" :unexpected-error-handlers {} :no-handler-records records))
      (if (= false shapes?) (sh08-th-error "C7-VERIFY" :malformed-typed-handler-family {} :canonical-handler-vectors nil)
      (let [nodes (sh08-ft-node-index sequence) forms (sh08-ft-index source-forms :form-id)
            binding-index (sh08-ft-binding-index bindings) owners (sh08-th-owners core)]
        (if (= :accepted (get owners :status))
        (loop [remaining tries ordinal 0 groups {} seeds {}]
          (if (= 0 (count remaining))
            (if (if (= ordinal count-records)
                  (= (loop [remaining records out []]
                       (if (= 0 (count remaining)) out
                         (recur (rest remaining) (conj out (sh08-ft-semantic-authenticated-record
                           (get (get (get core :identity-preimage) :lineage) :sh06-semantic-projection-id) (first remaining))))))
                     (get (get core :identity-preimage) :error-handlers)) false)
              {:status :accepted :groups groups :seeds seeds :diagnostics []}
              (sh08-th-error "C7-VERIFY" :error-handler-census {} :exact-handler-records records))
            (let [node (first remaining) id (get node :node-id) source (get node :source)
                  form (get forms (get source :form-id)) ids (get form :child-form-ids)
                  children (get node :children) attrs (get node :attributes)
                  clauses (get attrs :handler-clauses) owner (get (get owners :owners) id)
                  tree (sh08-bm-tree nodes (first children))
                  candidates (loop [transfers (get core :error-transfers) out []]
                               (if (= 0 (count transfers)) out
                                 (let [transfer (first transfers)]
                                   (recur (rest transfers)
                                     (if (if (contains? tree (get transfer :core-node-id))
                                           (= owner (get transfer :evaluation-owner-function-syntax-id)) false)
                                       (conj out (sh08-bm-project transfer [:ordinal :core-node-id])) out)))))
                  result
                  (if (if (vector? clauses) (<= (+ ordinal (count clauses)) count-records) false)
                  (loop [index 0 values [] next-seeds seeds]
                    (if (= index (count clauses)) {:status :accepted :clauses values :seeds next-seeds}
                      (let [clause (get clauses index) record (get records (+ ordinal index))
                            catch-form (get forms (get ids (+ index 2))) catch-ids (get catch-form :child-form-ids)
                            operator (get forms (get catch-ids 0)) type-form (get forms (get catch-ids 1))
                            binder-form (get forms (get catch-ids 2)) body-form (get forms (get catch-ids 3))
                            type-binding (get binding-index (get clause :error-type-binding-id))
                            binder (get binding-index (get clause :catch-binding-id))
                            type (sh08-ft-atomic-type-id (get type-binding :name)) body (get nodes (get children (+ index 1)))
                            body-tree (sh08-bm-tree nodes (get body :node-id))
                            uses (sh08-bm-uses sequence body-tree (get binder :binding-id))
                            all-uses (sh08-bm-uses sequence (set (keys nodes)) (get binder :binding-id))
                            expected-clause {:clause-ordinal index :handler-child-index (+ index 1)
                              :catch-clause-form-id (get catch-form :form-id) :catch-clause-syntax-id (get catch-form :syntax-id)
                              :error-type-form-id (get type-form :form-id) :error-type-syntax-id (get type-form :syntax-id)
                              :error-type-binding-id (get type-binding :binding-id)
                              :catch-binding-form-id (get binder-form :form-id) :catch-binding-syntax-id (get binder-form :syntax-id)
                              :catch-binding-id (get binder :binding-id) :catch-binding-scope-id (get binder :scope-id)}
                            expected-record (assoc
                              (sh08-bm-project attrs [:construction-order :runtime-reachability :selection-policy :result-policy
                                :authenticated-sh06-artifact-id :sh06-semantic-projection-id :type-coverage-legality
                                :result-type-join-legality :effect-registry-legality :effect-profile-capability-legality
                                :profile-error-lowering-legality :ownership-legality :safety-classification])
                              :ordinal (+ ordinal index) :clause-ordinal index :clause-count (count clauses)
                              :handler-child-index (+ index 1) :core-node-id id
                              :form-id (get form :form-id) :syntax-id (get form :syntax-id)
                              :protected-core-node-id (first children) :handler-core-node-id (get body :node-id)
                              :catch-clause-form-id (get catch-form :form-id) :catch-clause-syntax-id (get catch-form :syntax-id)
                              :error-type-form-id (get type-form :form-id) :error-type-syntax-id (get type-form :syntax-id)
                              :error-type-binding-id (get type-binding :binding-id)
                              :catch-binding-form-id (get binder-form :form-id) :catch-binding-syntax-id (get binder-form :syntax-id)
                              :catch-binding-id (get binder :binding-id) :catch-binding-scope-id (get binder :scope-id)
                              :catch-binding-use-syntax-ids uses :candidate-error-transfers candidates
                              :evaluation-region (get (get node :evaluation) :region)
                              :evaluation-owner-function-syntax-id owner
                              :ordered-steps [:evaluate-protected :conditionally-select-source-ordered-typed-handler]
                              :construction-order :protected-then-handlers-source-order-then-try
                              :runtime-evaluation :protected-then-conditional-handler-chain)]
                        (if (sh08-ft-all-true?
                              [(= 4 (count catch-ids)) (= :list (get catch-form :kind))
                               (if (seq? (get catch-form :value))
                                 (= ['catch (get type-form :value) (get binder-form :value) (get body-form :value)] (vec (get catch-form :value))) false)
                               (= 'catch (get operator :value)) (= :symbol (get operator :kind))
                               (= (get form :form-id) (get catch-form :parent-form-id))
                               (= (get catch-form :form-id) (get operator :parent-form-id) (get type-form :parent-form-id)
                                  (get binder-form :parent-form-id) (get body-form :parent-form-id))
                               (= :symbol (get type-form :kind) (get binder-form :kind))
                               (= (get type-binding :name) (get type-form :value))
                               (= [:core :type 'gravity.core] [(get type-binding :binding-class) (get type-binding :kind) (get type-binding :namespace)])
                               (= [:lexical :local] [(get binder :binding-class) (get binder :kind)])
                               (= (get binder :name) (get binder-form :value))
                               (= (get binder :definition-syntax-id) (get binder-form :syntax-id))
                               (= (get binder :scope-id) (get binder-form :scope-id))
                               (= (get body :source) (get (sh08-bm-source-node {} body-form) :source))
                               (= uses all-uses) (= expected-clause clause) (= expected-record record)])
                          (if (= type nil)
                            (sh08-th-error "C7-ANNOTATION" :unsupported-atomic-catch-type node :canonical-atomic-error-type (get type-form :value))
                            (recur (+ index 1) (conj values {:record record :error-type type :handler-core-node-id (get body :node-id)})
                              (assoc next-seeds (get binder :binding-id) type)))
                          (sh08-th-error "C7-VERIFY" :typed-handler-source-join node :exact-canonical-handler record)))))
                    (sh08-th-error "C7-VERIFY" :error-handler-census node :exact-handler-records records))]
              (if (sh08-ft-all-true?
                    [(vector? records) (vector? clauses) (> (count clauses) 0)
                     (= (+ 1 (count clauses)) (count children)) (= (+ 2 (count clauses)) (count ids))
                     (= source (get (sh08-bm-source-node {} form) :source)) (= :list (get form :kind))
                     (= 'try (get (get forms (first ids)) :value))
                     (if (seq? (get form :value))
                       (= (loop [remaining (rest ids) out ['try]]
                            (if (= 0 (count remaining)) out (recur (rest remaining) (conj out (get (get forms (first remaining)) :value)))))
                          (vec (get form :value))) false)
                     (= (get (get nodes (first children)) :source) (get (sh08-bm-source-node {} (get forms (get ids 1))) :source))
                     (= 0 (get attrs :protected-child-index)) (= (count clauses) (get attrs :handler-count))
                     (= (loop [i 1 out []] (if (= i (count children)) out (recur (+ i 1) (conj out i)))) (get attrs :handler-child-indexes))
                     (= :protected-then-ordered-typed-handler-candidates (get attrs :evaluation-order) (get (get node :evaluation) :kind))
                     (= owner (get (get node :evaluation) :owner-function-syntax-id))
                     (= (loop [remaining clauses out []]
                          (if (= 0 (count remaining)) out
                            (recur (rest remaining) (conj (conj out (get (first remaining) :error-type-binding-id))
                                                          (get (first remaining) :catch-binding-id)))))
                        (get node :resolved-binding-ids))
                     (= [{:index 0 :core-node-id (first children)}] (get (get node :evaluation) :order))
                     (= :source-ordered-typed-handler-candidates (get attrs :selection-policy))
                     (= :protected-or-selected-handler-last (get attrs :result-policy))
                     (= :not-asserted-by-sh07-b9 (get attrs :runtime-reachability))
                     (= [:pending-sh08 :pending-sh08 :pending-sh09 :pending-sh09 :pending-sh09 :pending-sh10 :pending-sh11]
                        [(get attrs :type-coverage-legality) (get attrs :result-type-join-legality) (get attrs :effect-registry-legality)
                         (get attrs :effect-profile-capability-legality) (get attrs :profile-error-lowering-legality)
                         (get attrs :ownership-legality) (get attrs :safety-classification)])])
                (if (= :accepted (get result :status))
                  (recur (rest remaining) (+ ordinal (count clauses)) (assoc groups id (get result :clauses)) (get result :seeds)) result)
                (sh08-th-error "C7-VERIFY" :typed-try-source-join node :exact-canonical-try attrs))))) owners)))))
      (sh08-th-error "C7-VERIFY" :malformed-typed-handler-family {} :canonical-handler-input-vectors nil))))

; L5/L9: exact canonical atomic matches classify SOURCE error potential.
; Covered source errors do not establish profile/handler/capability authority.
(defn sh08-eh-partition [protected clauses graph]
  (loop [remaining clauses pending protected escaped [] handled []]
    (if (= 0 (count remaining))
      {:residual (sh08-tc-union pending escaped) :handled handled}
      (let [clause (first remaining) type (get clause :error-type)
            matched (loop [errors pending out []]
                      (if (= 0 (count errors)) out
                        (recur (rest errors) (if (= type (first errors)) (conj out (first errors)) out))))
            unmatched (loop [errors pending out []]
                        (if (= 0 (count errors)) out
                          (recur (rest errors) (if (= type (first errors)) out (conj out (first errors))))))
            own (if (> (count matched) 0) (get graph (get clause :handler-core-node-id) []) [])]
        (recur (rest remaining) unmatched (sh08-tc-union escaped own)
          (conj handled {:source-handler (get clause :record) :error-type type
                         :candidate-error-types pending :matched-error-types matched
                         :handler-error-types own :remaining-error-types unmatched}))))))

(defn sh08-eh-seed-bindings [initial seeds]
  (loop [remaining (keys seeds) out initial]
    (if (= 0 (count remaining)) out
      (recur (rest remaining) (assoc out (first remaining) (get seeds (first remaining)))))))

(defn sh08-eh-type-checks [groups types nodes]
  (loop [remaining (keys groups)]
    (if (= 0 (count remaining)) {:diagnostics []}
      (let [clauses (get groups (first remaining)) record (get (first clauses) :record)
            ids (loop [rest-clauses clauses out [(get record :protected-core-node-id)]]
                  (if (= 0 (count rest-clauses)) out
                    (recur (rest rest-clauses) (conj out (get (first rest-clauses) :handler-core-node-id)))))
            child-types (sh08-ft-ordered-child-types ids types)
            known? (sh08-ft-every-known? child-types)
            joined (sh08-ft-loop-kernel-normal-join child-types)]
        (if (if known? (= joined :gravity.type/unknown) false)
          {:diagnostics [{:rule "C7-TYPE-MISMATCH" :reason :try-normal-result-type-mismatch
                          :node (get nodes (first remaining)) :expected :compatible-protected-and-handler-normal-results :actual child-types}]}
          (recur (rest remaining)))))))

(defn sh08-eh-constraint [node clauses types graph]
  (let [ids (get node :children)
        source-errors (loop [remaining ids out []]
                        (if (= 0 (count remaining)) out
                          (recur (rest remaining) (conj out (get graph (first remaining) [])))))
        partition (sh08-eh-partition (first source-errors) clauses graph)
        premise {:version :sh08-atomic-typed-catch-v1 :source-node node
                 :source-handlers (loop [remaining clauses out []]
                                    (if (= 0 (count remaining)) out
                                      (recur (rest remaining) (conj out (get (first remaining) :record)))))
                 :catch-types (loop [remaining clauses out []]
                                (if (= 0 (count remaining)) out
                                  (recur (rest remaining) (conj out (get (first remaining) :error-type)))))
                 :child-types (sh08-ft-ordered-child-types ids types) :child-source-error-types source-errors
                 :partition partition :normal-result-type (get types (get node :node-id))
                 :matching :exact-canonical-atomic-type :effect-label-discharge :pending-profile-handler-capability-authority}]
    {:constraint-id-request {:domain :gravity/sh08-atomic-typed-catch-v1 :premise premise}
     :kind :equality :producer-rule :sh08-atomic-typed-catch-v1
     :lhs {:core-node-id (get node :node-id) :projection :source-error-handler-result}
     :rhs (get partition :residual) :dependencies premise :origin (get (get node :source) :origin-chain)
     :solution {:normal-result-type (get premise :normal-result-type) :thrown-error-effects (get partition :residual)
                :handled-source-errors (get partition :handled) :effect-label-discharge :pending-profile-handler-capability-authority}
     :invalidation [:error-handlers :error-transfers :catch-type-bindings :catch-lexical-bindings :type-table :source-forms :evaluation-order]
     :status :solved :diagnostics []}))

(defn sh08-eh-constraints [core groups types graph rows]
  (loop [remaining (get core :nodes) out rows]
    (if (= 0 (count remaining)) out
      (let [node (first remaining)]
        (recur (rest remaining) (if (= :try (get node :core-form))
          (conj out (assoc (sh08-eh-constraint node (get groups (get node :node-id)) types graph)
                      :profile (get (get core :module) :profile) :target (get (get core :module) :target))) out))))))

(defn sh08-eh-groups [records bindings]
  (loop [remaining records groups {}]
    (if (= 0 (count remaining)) groups
      (let [record (first remaining) id (get record :core-node-id)]
        (recur (rest remaining)
          (assoc groups id (conj (get groups id []) {:record record
            :handler-core-node-id (get record :handler-core-node-id)
            :error-type (sh08-ft-atomic-type-id (get (get bindings (get record :error-type-binding-id)) :name))})))))))

(defn sh08-tc-node-errors [node graph target types handlers]
  (let [kind (get node :core-form)]
    (if (contains? #{:fn :quote} kind) []
      (if (= :try kind)
        (get (sh08-eh-partition (get graph (first (get node :children)) []) (get handlers (get node :node-id) []) graph) :residual)
      (let [operands (loop [ids (get node :children) out []]
                       (if (= 0 (count ids)) out (recur (rest ids) (sh08-tc-union out (get graph (first ids) [])))))
            called (if (= target nil) operands (sh08-tc-union operands (get graph target [])))
            payload (get types (first (get node :children)))]
        (if (if (= kind :throw) (= false (= payload :gravity.type/never)) false)
          (sh08-tc-union called [payload]) called))))))

(defn sh08-tc-graph [core types owners scope handlers]
  (let [nodes (sh08-ft-node-index (get core :nodes)) records (sh08-ft-function-record-index (get core :function-records))
        edges (sh08-ft-index (get core :call-edges) :call-core-node-id)
        selected (loop [remaining (get core :nodes) out []]
                   (if (= 0 (count remaining)) out
                     (recur (rest remaining) (if (contains? scope (get owners (get (first remaining) :node-id)))
                                              (conj out (first remaining)) out))))]
    (loop [pending selected deferred [] graph {} progress 0]
      (if (= 0 (count pending))
        (if (= 0 (count deferred)) {:status :accepted :nodes graph}
          (if (> progress 0) (recur deferred [] graph 0)
            (sh08-th-error "C7-ANNOTATION" :throwing-call-cycle-or-missing-body {} :acyclic-complete-bodies deferred)))
        (let [node (first pending) kind (get node :core-form) id (get node :node-id) edge (get edges id)
                target (if (if (= kind :call) (sh08-tc-invokes? node types) false)
                         (get (get records (get edge :callee-function-syntax-id)) :body-core-node-id) nil)
                deps (if (= kind :fn) [] (get node :children)) deps (if (= target nil) deps (conj deps target))
                ready? (loop [ids deps]
                         (if (= 0 (count ids)) true (if (contains? graph (first ids)) (recur (rest ids)) false)))]
            ; L2/L5/L9: target/slot/transfer checking precedes this graph in C7.
            ; Both loop and function recur contribute only lexical child SOURCE
            ; errors. No transfer error or control-backedge dependency is added;
            ; this finite conservative union establishes no termination or effect legality.
            (if (contains? #{:literal :quote :reference :fn :def :do :if :let :match :loop :recur :collection-literal :keyword-map-lookup :throw :call :try} kind)
              (if ready? (recur (rest pending) deferred (assoc graph id (sh08-tc-node-errors node graph target types handlers))
                               (+ progress 1))
                (recur (rest pending) (conj deferred node) graph progress))
              (sh08-th-error "C7-ANNOTATION" :unsupported-throwing-body-operation node :acyclic-direct-local-body kind)))))))

(defn sh08-tc-constraint [core edge calls nodes records bindings types functions graph]
  (let [id (get edge :call-core-node-id) node (get nodes id)
        caller (get records (get edge :caller-function-syntax-id)) callee (get records (get edge :callee-function-syntax-id))
        invoked? (sh08-tc-invokes? node types) body (get callee :body-core-node-id)
        operand-errors (loop [ids (get node :children) out []]
                         (if (= 0 (count ids)) out (recur (rest ids) (sh08-tc-union out (get graph (first ids) [])))))
        callee-errors (if invoked? (get graph body []) [])
        premise {:version :sh08-acyclic-local-thrown-errors-v1 :analysis :conservative-source-error-potential
                 :invocation-guard :all-operand-types-normal :source-edge edge :source-call (get calls id)
                 :source-node node :operator-node (get nodes (first (get node :children)))
                 :caller-function caller :callee-function callee :callee-binding (get bindings (get edge :callee-binding-id))
                 :callee-normal-type (if (if (keyword? (get (get types (first (get node :children))) :kind)) (contains? #{:gravity.type/applied-integral-ordering :gravity.type/applied-map-association :gravity.type/applied-map-removal :gravity.type/applied-collection-count :gravity.type/applied-vector-nth :gravity.type/applied-vector-get :gravity.type/applied-bounded-successor :gravity.type/applied-bounded-unit-addition :gravity.type/applied-vector-append :gravity.type/applied-list-prepend :gravity.type/applied-string-set-insertion :gravity.type/applied-keyword-set-insertion :gravity.type/applied-symbol-set-insertion :gravity.type/applied-atomic-equality :gravity.type/applied-vector-equality :gravity.type/applied-list-equality :gravity.type/applied-integral-equality :gravity.type/applied-not :gravity.type/applied-vector-predicate :gravity.type/applied-integer-predicate :gravity.type/applied-set-conversion :gravity.type/applied-list-set-conversion :gravity.type/applied-map-contains :gravity.type/applied-map-get :gravity.type/applied-string-concat :gravity.type/applied-nonnegative-integer-quotient :gravity.type/applied-vector-slice :gravity.type/applied-string-character-vector :gravity.type/applied-count-quotient-scaling :gravity.type/applied-list-construction :gravity.type/applied-list-query :gravity.type/applied-map-predicate  :gravity.type/applied-keyword-predicate :gravity.type/applied-string-predicate :gravity.type/applied-keyword-set-equality :gravity.type/applied-bare-keyword-anchor-set-equality :gravity.type/applied-string-set-equality  :gravity.type/applied-keyword-set-contains  :gravity.type/applied-set-predicate :gravity.type/applied-list-predicate :gravity.type/applied-symbol-predicate :gravity.type/applied-boolean-predicate :gravity.type/applied-nil-predicate :gravity.type/applied-character-predicate :gravity.type/applied-atomic-inequality :gravity.type/applied-character-set-contains :gravity.type/applied-string-set-contains :gravity.type/applied-symbol-set-contains :gravity.type/applied-integer-set-contains :gravity.type/applied-vector-first :gravity.type/applied-vector-empty :gravity.type/applied-vector-rest :gravity.type/applied-map-keys :gravity.type/applied-private-map-keys}
                                                    (get (get types (first (get node :children))) :kind)) false)
                   (get types (first (get node :children)))
                   (sh08-bm-project (get functions (get edge :callee-function-syntax-id)) [:parameters :return :fixed-arity :signature :latent-effects]))
                 :operand-types (sh08-ft-ordered-child-types (get edge :argument-core-node-ids) types)
                 :callee-source-body-id body :normal-invocation? invoked?
                 :operand-error-types operand-errors :callee-error-types callee-errors
                 :error-types (sh08-tc-union operand-errors callee-errors)}]
    {:constraint-id-request {:domain :gravity/sh08-acyclic-local-thrown-errors-v1 :premise premise}
     :kind :equality :producer-rule :sh08-acyclic-local-thrown-errors-v1
     :lhs {:core-node-id id :projection :thrown-error-effects} :rhs (get premise :error-types)
     :origin (get (get node :source) :origin-chain) :dependencies premise
     :solution {:thrown-error-effects (get premise :error-types) :normal-result-type (get types id)}
     :invalidation [:call-edges :calls :binding-table :function-records :callee-body :type-table :error-transfers :evaluation-order]
     :profile (get (get core :module) :profile) :target (get (get core :module) :target) :status :solved :diagnostics []}))

(defn sh08-tc-products-with-source-forms [core types functions bindings direct source-forms]
  (if (if (= 0 (count (get direct :throws))) (= 0 (count (get core :error-handlers))) false) direct
  (let [scoped (sh08-tc-scope-with-types core (get direct :throws) types)]
    (if (= :accepted (get scoped :status))
      (if (= false (get scoped :active?))
        direct
        (let [scope (get scoped :scope)
              owners (sh08-th-owners core)
              nodes (sh08-ft-node-index (get core :nodes)) records (sh08-ft-function-record-index (get core :function-records))
              calls (sh08-ft-index (get core :calls) :core-node-id) binding-index (sh08-ft-binding-index bindings)
              definitions (sh08-ft-index (get core :definitions) :binding-id)
              expected (if (= :accepted (get owners :status))
                         (sh08-ft-index (sh08-ft-build-call-edges (get core :nodes) (get core :definitions) bindings
                                          (get core :calls) (get core :function-records)) :call-core-node-id) {})
              checked-edges (if (= :accepted (get owners :status)) (loop [edges (get core :call-edges)]
                          (if (= 0 (count edges)) {:status :accepted :edge nil}
                            (let [edge (first edges) call (get calls (get edge :call-core-node-id))
                                  node (get nodes (get edge :call-core-node-id))
                                  bare-keyword-anchor? (if (contains? scope (get edge :caller-function-syntax-id))
                                                 (sh08-bka-entry? node call nodes binding-index types (get core :module)) false)
                                  list-set? (if (contains? scope (get edge :caller-function-syntax-id))
                                                 (sh08-lset-entry? node call nodes binding-index types (get core :module)) false)
                                  private-map-keys? (if (contains? scope (get edge :caller-function-syntax-id))
                                                        (sh08-pmk-entry? node call nodes binding-index types (get core :module)) false)
                                  map-keys? (if (contains? scope (get edge :caller-function-syntax-id))
                                                 (sh08-mkeys-entry? node call nodes binding-index types (get core :module)) false)
                                  vector-rest? (if (contains? scope (get edge :caller-function-syntax-id))
                                                 (sh08-vrest-entry? node call nodes binding-index types (get core :module)) false)
                                  vector-empty? (if (contains? scope (get edge :caller-function-syntax-id))
                                                  (sh08-vemp-entry? node call nodes binding-index types (get core :module)) false)
                                  vector-query? (if private-map-keys? true (if bare-keyword-anchor? true (if list-set? true (if map-keys? true (if vector-rest? true vector-empty?)))))
                                  vector? (if vector-query? false (if (contains? scope (get edge :caller-function-syntax-id))

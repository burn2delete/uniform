        #{:rule-version :mapping-rule-version :parameters :return :parameter-source-child-indexes :body-source-child-index})
    (if (= [(get signature :rule-version) (get signature :mapping-rule-version)]
           [:sh07-atomic-function-signature-v1 :sh07-atomic-function-declaration-map-v1])

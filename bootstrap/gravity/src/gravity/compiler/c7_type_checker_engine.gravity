              (if (sh08-ft-all-true? [(map? node) (sh08-si-path-id? (get node :node-id)) (= id (get node :node-id))
                     (= :reference (get node :core-form))
                     (= bid (get (get node :attributes) :binding-id)) (= [bid] (get node :resolved-binding-ids))
                     (= expected (get types id)) (= :immutable (get record :mutability))
                     (= record (sh08-si-record (get core :lexical-bindings) :binding-id bid))])
                (recur (get record :initializer-node-id) (- index 1) (conj seen id)) false)))))) false) false)))

(defn sh08-si-step-source [operation call nodes forms]
  (let [addition? (= operation '+) unit (get nodes (get (get call :argument-node-ids) 1))]
    {:operation-core-node-id (get call :core-node-id) :operation operation
     :unit-node (if addition? unit nil)
     :unit-source (if addition? (get forms (get (get unit :source) :form-id)) nil)}))

(defn sh08-si-step-source-valid? [record header nodes]
  (if (if (map? record) (map? header) false)

                            [(= false (= :invalid-map-keys-owner caller))
                             (= :call (get node :core-form)) (= :reference (get operator :core-form))
                             (= {:operator-child-index 0 :argument-count 1 :argument-child-indexes [1]
                                 :evaluation-order :operator-then-arguments :dispatch :resolved-symbol-call} (get node :attributes))
                             (= expected-call call) (= expected-edge edge) (sh08-mkeys-binding? binding module)
                             (= 'keys (get binding :name))
                             (= [bid] (get node :resolved-binding-ids) (get operator :resolved-binding-ids))
                             (= {:symbol (get (get operator :attributes) :symbol) :position :operator :binding-id bid :binding-class :core
                                 :definition-syntax-id (get binding :definition-syntax-id)} (get operator :attributes))
                             (contains? '#{keys gravity.core/keys} (get (get operator :attributes) :symbol))
                             (= :operator-then-arguments (get (get node :evaluation) :kind))
                             (= [{:index 0 :core-node-id (first children)} {:index 1 :core-node-id (get children 1)}]
                                (get (get node :evaluation) :order))])
                        {:status :accepted
                         :descriptor {:kind :gravity.type/applied-private-map-keys :version :sh08-private-map-keys-v1
                                      :operation 'keys :semantic-owner 'gravity.collections :intrinsic :gravity.collections/private-parameter-map-keys
                                      :resolution :gravity.core-compatibility :operator-node-id (get operator :node-id) :operator-binding-id bid
                                      :call-core-node-id (get node :node-id) :source (get node :source) :operator-source (get operator :source)
                                      :source-call call :source-edge edge :source-binding binding :argument-types [receiver]
                                      :query-policy (if normal? {:input :private-bare-map-with-complete-key-domain-proof :operand-evaluation :once :operand-position :non-tail
                                                     :payload-evaluation :none :original :unchanged :order :unspecified
                                                     :provider-order :preserved :selection :each-stored-key-once :result-carrier :persistent-list :flow-refinement :none
                                                     :type-validation :all-normal-entry-maps-including-all-values}
                                                    {:operand-evaluation :once :operand-position :non-tail :invocation :not-reached})
                                      :allocation-policy {:behavior :possible-persistent-map-key-list-construction :condition :normal-operand-completion
                                                          :effect :memory/allocate :empty-result :possible}
                                      :storage-policy (if normal? {:representation :development-persistent-list :collection-construction :list-spine-copy
                                                       :copy :list-spine :stored-values :shallow-share :input-storage :not-retained :borrow :none
                                                       :lifetime :persistent-values :allocation :possible-even-empty
                                                       :provider-allocation-bound :not-established}
                                                      {:collection-construction :not-invoked})
                                      :value-origin {:kind :map-value-keys :operation 'keys :operand-node-id (first args)}
                                      :application (if normal? :normal :not-invoked) :latent-effects [:memory/allocate] :direct-effects (if normal? [:memory/allocate] []) :capabilities [] :thrown-error-effects []
                                      :parameter-types [receiver] :return result-type :result-type result-type
                                      :profile (get module :profile) :target (get module :target)
                                      :invalidation [:calls :call-edges :binding-table :source-forms :type-table :lexical-bindings :definitions :function-records
                                                     :callee-body :operand-types :query-policy :storage-policy :value-origin :allocation-policy
                                                     :private-entry-domain :caller-entries :reference-uses :preserved-resolution :exports :mutations :var-references :recur-targets :recur-transfers :recursion-components
                                                     :result-type :stored-value-lifetimes :result-storage-policy :profile :target :evaluation-order]}}
                        {:status :rejected :reason :private-map-keys-source-mismatch}))
                    {:status :rejected :reason :private-map-keys-source-mismatch}))
                      {:status :rejected :reason :private-map-keys-finite-keyword-map-type-required}))
                  {:status :rejected :reason :private-map-keys-finite-keyword-map-type-required}))
        {:status :rejected :reason :private-map-keys-source-mismatch})
    {:status :rejected :reason :private-map-keys-source-mismatch}))

(defn sh08-pmk-parameter [census core node nodes bindings forms]
  (let [record (get census :function-record) params (get record :parameter-binding-ids)
        signature (get record :signature) fn-node (get nodes (get record :function-core-node-id))
        attrs (get fn-node :attributes) parameter (get census :parameter-binding)
        index (get census :parameter-index) fn-form (get forms (get record :function-form-id))
        parameter-form (get forms (get attrs :parameter-form-id)) names (get parameter-form :child-form-ids)
        declarations (get signature :parameters) coordinates (get signature :parameter-source-child-indexes)]
    (if (if (sh08-pmk-fields? signature #{:rule-version :mapping-rule-version :parameters :return :parameter-source-child-indexes :body-source-child-index})
            (if (vector? declarations) (if (vector? coordinates) (sh08-pmk-id-vector? names) false) false) false)
        (if (sh08-ft-all-true?
              [(= [:sh07-atomic-function-signature-v1 :sh07-atomic-function-declaration-map-v1]
                  [(get signature :rule-version) (get signature :mapping-rule-version)])
               (= nil (get signature :return)) (= 2 (get signature :body-source-child-index))
               (= (count params) (count declarations) (count coordinates) (get record :fixed-arity))
               (sh08-pmk-record-ids? attrs [:parameter-form-id :parameter-syntax-id :recur-target-id] [] [])
               (= (get record :function-syntax-id) (get attrs :recur-target-id))
               (= :sh07-atomic-function-signature-v1 (get fn-node :lowering-rule-version))
               (vector? (get attrs :parameters)) (= (count params) (count (get attrs :parameters)))
               (contains? #{nil :immutable} (get parameter :mutability))
               (= :list (get fn-form :kind)) (= :vector (get parameter-form :kind))
               (let [values (get parameter-form :value)]
                 (if (vector? values) (= (count names) (count values)) false))
               (= (get parameter-form :syntax-id) (get attrs :parameter-syntax-id))
               (sh08-sse-ids? (get fn-form :child-form-ids) 3)])
          (let [fn-ids (get fn-form :child-form-ids) operator (get forms (get fn-ids 0))
                body (get nodes (get record :body-core-node-id))]
            (if (sh08-ft-all-true?
                  [(= :symbol (get operator :kind)) (= 'fn (get operator :value))
                   (= (get fn-form :form-id) (get operator :parent-form-id) (get parameter-form :parent-form-id))
                   (= (get parameter-form :form-id) (get fn-ids 1))
                   (= (get (get body :source) :form-id) (get fn-ids 2))
                   (= (get fn-node :source) (sh08-ma-form-source fn-form))])
              (loop [i 0 coordinate 0 slots []]
                (if (= i (count params))
                  (if (= coordinate (count names))
                    (if (= signature (get attrs :signature))
                      (if (let [values (get parameter-form :value)]
                          (loop [i 0]
                            (if (= i (count names)) true
                              (let [form (get forms (get names i)) value (get values i)]
                                (if (map? form)
                                  (let [kind (get form :kind) original (get form :value)]
                                    (if (if (= :symbol kind)
                                          (if (symbol? original) (if (symbol? value) (= original value) false) false)
                                          (if (= :keyword kind)
                                            (if (keyword? original) (if (keyword? value) (= original value) false) false) false))
                                      (recur (+ i 1)) false)) false)))))
                      {:status :accepted
                       :callee {:function-id (get record :function-syntax-id) :signature signature :parameters slots}
                       :source {:function-node fn-node :function-form fn-form :parameter-form parameter-form
                                :declaration (get declarations index) :parameter-index index :parameter-binding parameter}}
                        {:status :rejected :reason :private-map-keys-source-mismatch})
                      {:status :rejected :reason :private-map-keys-source-mismatch})
                    {:status :rejected :reason :private-map-keys-source-mismatch})
                  (let [binding (get bindings (get params i)) name-form (get forms (get names coordinate))
                        declaration (get declarations i) declared? (= false (= nil declaration))
                        step (if declared? 3 1)]
                    (if (if (integer? (get coordinates i)) (= coordinate (get coordinates i)) false)
                      (if (sh08-ft-all-true?
                            [(= :symbol (get name-form :kind)) (= (get binding :name) (get name-form :value) (get (get attrs :parameters) i))
                             (= (get binding :definition-syntax-id) (get name-form :syntax-id))
                             (= (get parameter-form :form-id) (get name-form :parent-form-id))
                             (if declared?
                               (if (sh08-pmk-fields? declaration #{:source-child-index :marker-form-id :marker-syntax-id :type-form-id :type-syntax-id :type-symbol :type-binding-id :type-id})
                                 (if (sh08-pmk-record-ids? declaration [:marker-form-id :marker-syntax-id :type-form-id :type-syntax-id :type-binding-id] [] [])
                                   (if (symbol? (get declaration :type-symbol)) (keyword? (get declaration :type-id)) false) false) false) true)])
                        (let [marker (if declared? (get forms (get declaration :marker-form-id)) nil)
                              type-form (if declared? (get forms (get declaration :type-form-id)) nil)
                              type-binding (if declared? (get bindings (get declaration :type-binding-id)) nil)]
                          (if (if declared?
                                (sh08-ft-all-true?
                                  [(= (+ coordinate 1) (get declaration :source-child-index))
                                   (= [(get declaration :marker-form-id) (get declaration :type-form-id)] [(get names (+ coordinate 1)) (get names (+ coordinate 2))])
                                   (= :keyword (get marker :kind)) (= :- (get marker :value))
                                   (= (get declaration :marker-syntax-id) (get marker :syntax-id))
                                   (= (get declaration :type-syntax-id) (get type-form :syntax-id))
                                   (= :symbol (get type-form :kind)) (= (get declaration :type-symbol) (get type-form :value) (get type-binding :name))
                                   (= :core (get type-binding :binding-class)) (= :type (get type-binding :kind)) (= 'gravity.core (get type-binding :namespace))
                                   (= (get parameter-form :form-id) (get marker :parent-form-id) (get type-form :parent-form-id))
                                   (if (= i index) (= ['Map :gravity.type/map] [(get declaration :type-symbol) (get declaration :type-id)]) true)])
                                (= false (= i index)))
                            (recur (+ i 1) (+ coordinate step) (conj slots {:binding-id (get params i) :type (if declared? (get declaration :type-id) :gravity.type/unknown)}))
                            {:status :rejected :reason :private-map-keys-entry-domain-required}))
                        {:status :rejected :reason :private-map-keys-source-mismatch})
                      {:status :rejected :reason :private-map-keys-source-mismatch}))))
              {:status :rejected :reason :private-map-keys-source-mismatch}))
          {:status :rejected :reason :private-map-keys-source-mismatch})
        {:status :rejected :reason :private-map-keys-entry-domain-required})))

(defn sh08-pmk-map-source [argument actual nodes forms types]
  ; The initial entry-source subset uses original finite Map constructors.
  ; All member types were validated before this source/domain walk.
  (let [children (get argument :children) members (get actual :member-types)
        source (get argument :source)
        owner (get forms (get source :form-id))]
    (if (sh08-ft-all-true?
            [(= :collection-literal (get argument :core-form)) (= :map (get (get argument :attributes) :literal-kind))
             (= (count members) (get (get argument :attributes) :element-count) (count children) (count (get owner :child-form-ids)))
             (= :map (get owner :kind)) (= source (sh08-ma-form-source owner))])
        (if (loop [i 0]
              (if (= i (count members)) true
                (let [child (get nodes (get children i)) form (get forms (get (get owner :child-form-ids) i))
                      type (get types (get children i)) key? (= i (* 2 (quot i 2)))]
                  (if (sh08-ft-all-true?
                        [(= (get owner :form-id) (get form :parent-form-id))
                         (= (get child :source) (sh08-ma-form-source form))
                         (= type (get members i))
                         (= {:index i :core-node-id (get child :node-id)} (get (get (get argument :evaluation) :order) i))
                         (if key?
                           (if (= :literal (get child :core-form))
                             (if (= :keyword (get (get child :attributes) :literal-kind))
                               (if (keyword? (get (get child :attributes) :value))
                                 (if (= :keyword (get form :kind))
                                   (if (keyword? (get form :value))
                                     (= (get form :value) (get (get child :attributes) :value)) false) false) false) false) false) true)])
                    (recur (+ i 1)) false))))
          {:status :accepted :source-node argument :source-form owner}
          {:status :rejected :reason :private-map-keys-source-mismatch})
        {:status :rejected :reason :private-map-keys-entry-domain-required})))

(defn sh08-pmk-acyclic [core root]
  (let [edges (get core :call-edges)]
    (loop [reached #{root}]
      (let [next (loop [remaining edges out reached]
                   (if (= 0 (count remaining)) out
                     (let [edge (first remaining) caller (get edge :caller-function-syntax-id) callee (get edge :callee-function-syntax-id)]
                       (if (if (= nil callee) false (contains? reached caller))
                         (if (= root callee) nil (recur (rest remaining) (conj out callee)))
                         (recur (rest remaining) out)))))]
        (if (= nil next) {:status :rejected :reason :private-map-keys-entry-domain-required}
          (if (= next reached) {:status :accepted}
            (recur next)))))))

(defn sh08-pmk-unknown? [value]
  (if (= nil value) true
    (if (keyword? value) (= :gravity.type/unknown value) false)))

(defn sh08-pmk-proof [header core node nodes bindings types forms]
  (let [physical (sh08-pmk-physical core nodes bindings forms)]
    (if (= :accepted (get physical :status))
      (let [census (sh08-pe-census header core nodes bindings forms)]
        (if (map? census)
          (let [parameter (sh08-pmk-parameter census core node nodes bindings forms)
                graph (if (= :accepted (get parameter :status))
                        (sh08-pmk-acyclic core (get (get census :function-record) :function-syntax-id))
                        parameter)]
                (if (if (= :accepted (get parameter :status)) (= :accepted (get graph :status)) false)
                  (loop [remaining (get census :calls) entries [] normal-count 0]
                    (if (= 0 (count remaining))
                      (if (< 0 normal-count)
                        {:status :accepted
                         :proof {:kind :complete-private-call-entry-key-domain :version :sh08-private-map-keys-entry-domain-v1
                                 :domain :keyword :parameter-type :gravity.type/map :result-refinement :none
                                 :parameter-binding-id (get (get census :parameter-binding) :binding-id)
                                 :parameter-index (get census :parameter-index) :function-syntax-id (get (get census :function-record) :function-syntax-id)
                                 :normal-witness-count normal-count :entries entries :census census :parameter-source (get parameter :source)
                                 :keys-use {:source (get header :source) :source-call (get header :source-call) :source-edge (get header :source-edge)}
                                 :coverage :all-resolved-private-entries :normality :all-argument-coordinates
                                 :validation :entire-normal-map-including-all-values :ground :independent-entry-types-and-original-source
                                 :no-refinement [:common-shape :key-presence :key-identity :extent :cardinality :nonempty :flow :specialization]}}
                        {:status :rejected :reason :private-map-keys-entry-domain-required})
                      (let [call (first remaining) args (get call :argument-node-ids)
                            arguments (sh08-ft-ordered-child-types args types)
                            complete? (loop [values arguments]
                                        (if (= 0 (count values)) true
                                          (if (sh08-pmk-unknown? (first values)) false (recur (rest values)))))]
                        (if (= false complete?) {:status :deferred :reason :private-map-keys-entry-domain-required :type :gravity.type/unknown}
                          (let [validation (sh08-lc-validate-types arguments)
                                normal? (sh08-pe-invoked? types args)
                                  index (get census :parameter-index) argument-id (get args index)
                                  argument (get nodes argument-id) actual (get arguments index)
                                  call-node (get nodes (get call :core-node-id)) call-source (get call-node :source)
                                  call-form (get forms (get call-source :form-id))
                                  edge (sh08-pe-one (get census :edges) :call-core-node-id (get call :core-node-id))]
                              (if (= :accepted (get validation :status))
                                (if (= call-source (sh08-ma-form-source call-form))
                                (if normal?
                                  (if (sh08-mkeys-type? actual)
                                    (let [source (sh08-pmk-map-source argument actual nodes forms types)
                                          compatibility (if (= :accepted (get source :status))
                                                          (sh08-mp-compatibility core call edge (get parameter :callee) index actual nodes bindings) source)]
                                      (if (if (= :accepted (get source :status)) (= :accepted (get compatibility :status)) false)
                                        (recur (rest remaining)
                                          (conj entries {:call-core-node-id (get call :core-node-id) :argument-node-id argument-id :argument-source (get argument :source) :call-source call-source
                                                         :argument-type actual :argument-types arguments :entry :normal :source-call call :source-edge edge
                                                         :source-node (get source :source-node) :source-form (get source :source-form)
                                                         :compatibility (get compatibility :premise)
                                                         :call-input-facts {:call-core-node-id (get call :core-node-id) :caller-function-syntax-id (get edge :caller-function-syntax-id)
                                                                            :callee-function-syntax-id (get edge :callee-function-syntax-id) :argument-types arguments
                                                                            :evaluation-order :operator-then-arguments
                                                                            :source-span (get call-source :semantic-span) :syntax-id (get call-source :syntax-id)
                                                                            :origin-chain (get call-source :origin-chain) :generated-origin (get call-source :generated-origin)
                                                                            :profile (get (get core :module) :profile) :target (get (get core :module) :target)}})
                                          (+ normal-count 1))
                                        {:status :rejected :reason :private-map-keys-source-mismatch}))
                                    {:status :rejected :reason :private-map-keys-entry-domain-required})
                                  (recur (rest remaining)
                                    (conj entries {:call-core-node-id (get call :core-node-id) :argument-node-id argument-id :argument-source (get argument :source) :call-source call-source
                                                   :argument-type actual :argument-types arguments :entry :not-invoked :source-call call :source-edge edge :compatibility nil
                                                   :call-input-facts {:call-core-node-id (get call :core-node-id) :caller-function-syntax-id (get edge :caller-function-syntax-id)
                                                                      :callee-function-syntax-id (get edge :callee-function-syntax-id) :argument-types arguments
                                                                      :evaluation-order :operator-then-arguments
                                                                            :source-span (get call-source :semantic-span) :syntax-id (get call-source :syntax-id)
                                                                            :origin-chain (get call-source :origin-chain) :generated-origin (get call-source :generated-origin)
                                                                            :profile (get (get core :module) :profile) :target (get (get core :module) :target)}})
                                    normal-count))
                                  {:status :rejected :reason :private-map-keys-source-mismatch})
                                {:status :rejected :reason :private-map-keys-entry-domain-required}))))))
                  {:status :rejected :reason (get graph :reason)}))
              {:status :rejected :reason :private-map-keys-entry-domain-required}))
      physical)))

(defn sh08-pmk-header [core node call edge nodes bindings types forms]
  (let [source (sh08-pmk-source core node call edge nodes bindings types (get core :module))]
    (if (= :accepted (get source :status))
      (let [proof (sh08-pmk-proof (get source :descriptor) core node nodes bindings types forms)]
        (if (= :accepted (get proof :status))
          {:status :accepted
           :descriptor (assoc (get source :descriptor) :key-domain-proof (get proof :proof))}
          proof))
      source)))

(defn sh08-pmk-constraint [descriptor]
  {:constraint-id-request {:domain :gravity/sh08-private-map-keys-constraint-v1 :application descriptor}
   :kind :equality :producer-rule :sh08-private-map-keys-v1
   :lhs {:core-node-id (get descriptor :call-core-node-id) :projection :private-map-keys}
   :rhs (get descriptor :result-type) :dependencies descriptor :origin (get (get descriptor :source) :origin-chain)
   :solution {:result-type (get descriptor :result-type) :application (get descriptor :application) :direct-effects (get descriptor :direct-effects)
              :allocation-policy (get descriptor :allocation-policy)
              :storage-policy (get descriptor :storage-policy) :key-domain-proof (get descriptor :key-domain-proof)}
   :invalidation (get descriptor :invalidation) :profile (get descriptor :profile) :target (get descriptor :target)
   :status :solved :diagnostics []})

(defn sh08-pmk-call-fact [descriptor module]
  (let [source (get descriptor :source) edge (get descriptor :source-edge)]
    {:artifact :gravity/c7-call-type-fact
     :fact-id-request {:domain :gravity/sh08-private-map-keys-call-type-fact-v1 :application descriptor}
     :call-core-node-id (get descriptor :call-core-node-id) :caller-function-syntax-id (get edge :caller-function-syntax-id)
     :callee-function-syntax-id nil :argument-types (get descriptor :argument-types) :result-type (get descriptor :result-type)
     :evaluation-order :operator-then-arguments :source-span (get source :semantic-span) :syntax-id (get source :syntax-id)
     :origin-chain (get source :origin-chain) :generated-origin (get source :generated-origin)
     :profile (get module :profile) :target (get module :target) :effects (get descriptor :direct-effects) :capabilities [] :status :inferred
     :dispatch :direct-private-map-keys :applied-private-map-keys descriptor :effect-facts-source :audited-private-entry-map-key-list-construction}))

(defn sh08-pmk-derive [core node call edge nodes bindings types forms]
  (let [result (sh08-pmk-header core node call edge nodes bindings types forms)]
    (if (= :deferred (get result :status)) result
    (if (= :accepted (get result :status))
      (let [owner (get forms (get (get node :source) :form-id)) ids (get owner :child-form-ids)]
        (if (if (sh08-sse-ids? ids 2)
              (if (= :list (get owner :kind))
                (if (= (get node :source) (sh08-ma-form-source owner))
                  (loop [index 0]
                    (if (= index 2) true
                      (let [form (get forms (get ids index)) child (get nodes (get (get node :children) index))]
                        (if (if (= (get owner :form-id) (get form :parent-form-id))
                              (if (= (get child :source) (sh08-ma-form-source form))
                                (if (= index 0) (if (symbol? (get form :value))
                                                 (= (get form :value) (get (get child :attributes) :symbol)) false) true) false) false)
                          (recur (+ index 1)) false)))) false) false) false)
          (assoc result :type (get (get result :descriptor) :result-type) :constraint (sh08-pmk-constraint (get result :descriptor)))
          (sh08-sm-failure "C7-VERIFY" :private-map-keys-source-mismatch nil :original-unary-map-keys-call (get node :node-id))))
      (sh08-sm-failure (if (= :private-map-keys-source-mismatch (get result :reason)) "C7-VERIFY" "C7-TYPE-MISMATCH")
               (get result :reason) nil :validated-complete-finite-keyword-key-map (get call :argument-node-ids))))))

(defn sh08-pmk-entry? [node call nodes bindings types module]
  (if (sh08-mkeys-entry? node call nodes bindings types module)
    (if (if (map? call) (vector? (get call :argument-node-ids)) false)
      (if (sh08-sse-ids? (get call :argument-node-ids) 1)
        (let [type (get types (first (get call :argument-node-ids)))]
          (if (keyword? type) (= :gravity.type/map type) false)) false) false) false))

(defn sh08-pmk-inferred-call [core node call edge nodes bindings types forms]
  (let [result (sh08-pmk-header core node call edge nodes bindings types forms)]
    (if (= :accepted (get result :status))
      (let [operator (get types (get call :operator-node-id)) actual (get types (get node :node-id))
            pending-operator? (if (sh08-pmk-unknown? operator) true
                                (if (keyword? operator)
                                  (if (= :gravity.type/core-var operator) (sh08-pmk-unknown? actual) false) false))]
        (if pending-operator?
          {:status :deferred :reason :private-map-keys-entry-domain-required}
          (if (= (get result :descriptor) operator)
            (if (sh08-pmk-unknown? actual)
              {:status :deferred :reason :private-map-keys-entry-domain-required}
              (if (= (get (get result :descriptor) :result-type) actual)
                {:status :accepted}
                {:status :rejected :reason :private-map-keys-source-mismatch}))
            {:status :rejected :reason :private-map-keys-source-mismatch}))) result)))

(defn sh08-mkeys-constraint [descriptor]
  (if (if (keyword? (get descriptor :kind)) (= :gravity.type/applied-private-map-keys (get descriptor :kind)) false)
    (sh08-pmk-constraint descriptor)
    {:constraint-id-request {:domain :gravity/sh08-map-keys-constraint-v1 :application descriptor}
   :kind :equality :producer-rule :sh08-map-keys-v1
   :lhs {:core-node-id (get descriptor :call-core-node-id) :projection :map-keys}
   :rhs (get descriptor :result-type) :dependencies descriptor :origin (get (get descriptor :source) :origin-chain)

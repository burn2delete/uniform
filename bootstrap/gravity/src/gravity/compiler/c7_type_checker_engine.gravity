                      :loop-bindings :recur-targets :recur-transfers :callee-body :constructor-or-quote-shape :profile :target :evaluation-order]} nil)) nil))


(defn sh08-vn-constraint [descriptor]
  {:constraint-id-request {:domain (if (= :sh08-vector-get-indexed-private-self-v1 (get descriptor :version))
                                      :gravity/sh08-vector-get-indexed-private-self-constraint-v1
                                    (if (= :gravity.type/applied-vector-get (get descriptor :kind))
                                      :gravity/sh08-vector-get-constraint-v1 :gravity/sh08-vector-nth-constraint-v1)) :application descriptor}
   :kind :equality :producer-rule (if (= :sh08-vector-get-indexed-private-self-v1 (get descriptor :version))
                    :sh08-vector-get-indexed-private-self-v1
                    (if (= :gravity.type/applied-vector-get (get descriptor :kind)) :sh08-vector-get-v1 :sh08-vector-nth-v1))
   :lhs {:core-node-id (get descriptor :call-core-node-id) :projection (if (= :gravity.type/applied-vector-get (get descriptor :kind)) :vector-get :vector-element)}
   :rhs (get descriptor :result-type) :dependencies descriptor :origin (get (get descriptor :source) :origin-chain)
   :solution {:result-type (get descriptor :result-type) :application (get descriptor :application)
              :direct-effects (get descriptor :direct-effects) :bounds-proof (get descriptor :bounds-proof)
              :selected-type (get descriptor :selected-type)}
   :invalidation (get descriptor :invalidation) :profile (get descriptor :profile) :target (get descriptor :target)
   :status :solved :diagnostics []})

(defn sh08-vn-call-fact [descriptor module]
  (let [source (get descriptor :source) edge (get descriptor :source-edge)]
    {:artifact :gravity/c7-call-type-fact
     :fact-id-request {:domain (if (= :sh08-vector-get-indexed-private-self-v1 (get descriptor :version))
                                 :gravity/sh08-vector-get-indexed-private-self-call-type-fact-v1
                               (if (= :gravity.type/applied-vector-get (get descriptor :kind))
                                 :gravity/sh08-vector-get-call-type-fact-v1 :gravity/sh08-vector-nth-call-type-fact-v1)) :application descriptor}
     :call-core-node-id (get descriptor :call-core-node-id) :caller-function-syntax-id (get edge :caller-function-syntax-id)
     :callee-function-syntax-id nil :argument-types (get descriptor :argument-types) :result-type (get descriptor :result-type)
     :evaluation-order :operator-then-arguments :source-span (get source :semantic-span) :syntax-id (get source :syntax-id)
     :origin-chain (get source :origin-chain) :generated-origin (get source :generated-origin)
     :profile (get module :profile) :target (get module :target) :effects (get descriptor :direct-effects) :capabilities [] :status :inferred
     :dispatch (if (= :gravity.type/applied-vector-get (get descriptor :kind)) :direct-vector-get :direct-vector-nth)
     (if (= :gravity.type/applied-vector-get (get descriptor :kind)) :applied-vector-get :applied-vector-nth) descriptor :effect-facts-source :audited-collection-intrinsic}))


(defn sh08-vn-finish [header]
  (let [type (if (= :normal (get header :application)) (get header :selected-type) :gravity.type/never)]
    (assoc header :parameter-types (get header :argument-types) :return type :result-type type)))

(defn sh08-vn-rejection [call nodes types]
  (let [args (get call :argument-node-ids) vector-type (get types (first args)) index-type (get types (get args 1))
        index-node (get nodes (get args 1)) attrs (get index-node :attributes) index (get attrs :value)
        elements (get vector-type :element-types) length (if (vector? elements) (count elements) nil)
        actual {:vector-type vector-type :index-type index-type :index-value index :vector-length length :index-source (get index-node :source)}]
    (if (= false (= 2 (count args)))
      (sh08-sm-failure "C7-TYPE-MISMATCH" :vector-nth-arity-mismatch nil :two-vector-index-operands args)
    (if (if (= vector-type :gravity.type/never) false
          (if (= :gravity.type/vector (get vector-type :kind)) (= false (vector? elements)) true))
      (sh08-sm-failure "C7-TYPE-MISMATCH" :vector-nth-vector-type-required nil :established-positional-vector actual)
    (if (if (= index-type :gravity.type/never) false (= false (= index-type :gravity.type/integer)))
      (sh08-sm-failure "C7-TYPE-MISMATCH" :vector-nth-index-type-required nil :integer-index actual)
    (if (if (= index-type :gravity.type/never) false
          (if (= :literal (get index-node :core-form)) (= false (= :integer (get attrs :literal-kind))) true))
      (sh08-sm-failure "C7-ANNOTATION" :vector-nth-literal-index-required nil :source-integer-literal actual)
    (if (if (= index-type :gravity.type/never) false (= false (integer? index)))
      (sh08-sm-failure "C7-VERIFY" :vector-nth-index-source-mismatch nil :exact-integer-literal actual)
    (if (if (= index-type :gravity.type/never) false (< index 0))
      (sh08-sm-failure "SAFE2-BOUNDS" :vector-nth-negative-index nil :nonnegative-index actual)
    (if (if (= vector-type :gravity.type/never) false
          (if (= index-type :gravity.type/never) false (>= index length)))
      (sh08-sm-failure "SAFE2-BOUNDS" :vector-nth-index-out-of-range nil :index-less-than-vector-length actual)
    (if (if (= vector-type :gravity.type/never) false
          (if (= index-type :gravity.type/never) false (contains? #{nil :gravity.type/unknown} (get elements index))))
      (sh08-sm-failure "C7-ANNOTATION" :vector-nth-selected-element-type-required nil :established-selected-member-type actual)
      (sh08-sm-failure "C7-VERIFY" :vector-nth-source-or-element-type-mismatch nil :authentic-call-and-established-selected-type actual)))))))))))

(defn sh08-vn-derive [core node call edge nodes bindings types forms]
  (let [args (get call :argument-node-ids)
        owner (get forms (get (get node :source) :form-id)) ids (get owner :child-form-ids)]
    (let [header (sh08-vn-source core node call edge nodes bindings types (get core :module))]
      (if (= header nil) (sh08-vn-rejection call nodes types)
          (if (sh08-ft-all-true?
                [(= :list (get owner :kind)) (= (get node :source) (sh08-ma-form-source owner))
                 (vector? ids) (= 3 (if (vector? ids) (count ids) 0))
                 (= {:operator-child-index 0 :argument-count 2 :argument-child-indexes [1 2]
                     :evaluation-order :operator-then-arguments :dispatch :resolved-symbol-call} (get node :attributes))
                 (loop [i 0]
                   (if (= i 3) true
                     (let [form (get forms (get ids i)) child (get nodes (get (get node :children) i))]
                       (if (sh08-ft-all-true? [(= (get owner :form-id) (get form :parent-form-id))
                             (= (get child :source) (sh08-ma-form-source form))
                             (if (= i 0) (= (get form :value) (get (get child :attributes) :symbol)) true)
                             (if (= i 2) (if (= :gravity.type/never (get types (get args 1))) true
                               (if (= :integer (get form :kind)) (= (get form :value) (get header :index-value)) false)) true)])
                         (recur (+ i 1)) false))))])
            (let [descriptor (sh08-vn-finish header)]
              {:status :accepted :descriptor descriptor :type (get descriptor :result-type)
               :constraint (sh08-vn-constraint descriptor)})
            (sh08-sm-failure "C7-VERIFY" :vector-nth-source-mismatch nil :exact-operator-vector-index-source (get node :node-id)))))))

(defn sh08-vn-node? [node context]
  (if (= :call (get node :core-form))
    (sh08-vn-binding? (get (get context :ordering-bindings) (first (get node :resolved-binding-ids)))
                     (get (get context :ordering-core) :module)) false))

(defn sh08-vn-inferred-call-valid? [core node call edge nodes bindings types]
  (let [descriptor (get types (get call :operator-node-id))]
    (if (= :sh08-vector-nth-loop-v1 (get descriptor :version))
      (sh08-vl-proof-valid? descriptor core node nodes bindings types)
      (let [header (sh08-vn-source core node call edge nodes bindings types (get core :module))]
        (if (map? header) (= descriptor (sh08-vn-finish header)) false)))))

(defn sh08-vl-index? [node nodes types]
  (let [children (get node :children) vector-id (get children 1) index-id (get children 2)]
    (if (if (= :gravity.type/never (get types vector-id)) true (= :gravity.type/never (get types index-id))) false
      (= false (= :literal (get (get nodes index-id) :core-form))))))

(defn sh08-vl-invariant [core nodes types binding-id]
  (if (= binding-id nil) nil
    (loop [remaining (get core :recur-transfers)]
      (if (= 0 (count remaining)) nil
        (let [transfer (first remaining)
              target (sh08-si-record (get core :recur-targets) :target-id (get transfer :target-id))]
          (if (= binding-id (first (get target :binding-ids)))
            (let [increment (get nodes (first (get transfer :argument-node-ids)))
                  descriptor (get types (first (get increment :children)))]
              (if (if (= :gravity.type/applied-bounded-successor (get descriptor :kind))
                    (contains? #{:sh08-bounded-successor-v1 :sh08-bounded-successor-v2} (get descriptor :version))
                    (if (= :gravity.type/applied-bounded-unit-addition (get descriptor :kind))
                      (= :sh08-bounded-unit-addition-v1 (get descriptor :version)) false)) descriptor nil))
            (recur (rest remaining))))))))

(defn sh08-vl-path-valid? [path leaf root nodes]
  (if (vector? path)
    (if (sh08-si-path-records? path nodes)
      (sh08-ft-all-true? [(= leaf (get (get (first path) :node) :node-id))
        (= root (get (get (get path (- (count path) 1)) :node) :node-id))
        (loop [i 0]
          (if (= i (count path)) true
            (let [entry (get path i)]
              (if (map? entry)
                (let [actual (get entry :node)]
                  (if (sh08-ft-all-true? [(= #{:node :child-index} (set (keys entry)))
                         (= actual (get nodes (get actual :node-id)))
                         (= false (contains? #{:loop :fn} (get actual :core-form)))
                         (if (= i 0) (= nil (get entry :child-index))
                           (= (get (get (get path (- i 1)) :node) :node-id) (get (get actual :children) (get entry :child-index))))])
                    (recur (+ i 1)) false)) false))))]) false) false))

(defn sh08-vl-bounds [header invariant origin path nodes]
  (let [args (get (get header :source-call) :argument-node-ids)]
    {:kind :gravity.safety/vector-index-bounds :rule "SAFE2-BOUNDS" :outcome :proven-safe
     :scope :index-within-loop-guard-and-vector-origin :predicate :zero-le-index-lt-length
     :access-core-node-id (get header :call-core-node-id)
     :vector-node-id (first args) :index-node-id (get args 1) :vector-type (first (get header :argument-types))
     :index-value nil :vector-length (get header :vector-length) :selected-type (get header :selected-type)
     :index-source (get (get nodes (get args 1)) :source) :slot-binding-id (get (get invariant :range-proof) :slot-binding-id)
     :loop-invariant invariant :vector-origin origin :guard-path path
     :check-elision :not-authorized :runtime-guards :retained}))

(defn sh08-vl-proof-valid? [descriptor core node nodes bindings types]
  (let [calls (sh08-ft-index (get core :calls) :core-node-id) edges (sh08-ft-index (get core :call-edges) :call-core-node-id)
        call (get calls (get node :node-id)) header (sh08-vl-source core node call (get edges (get node :node-id)) nodes bindings types (get core :module))
        proof (get descriptor :bounds-proof) invariant (get proof :loop-invariant) range (get invariant :range-proof)
        anchor (get nodes (get invariant :call-core-node-id)) anchor-call (get calls (get anchor :node-id))
        anchor-header (sh08-si-source core anchor anchor-call (get edges (get anchor :node-id)) nodes bindings types (get core :module))
        args (get call :argument-node-ids) index (get nodes (get args 1)) origin (get proof :vector-origin)
        path (get proof :guard-path) bound-origin (get range :vector-origin) bid (get range :slot-binding-id)]
    (if (if (map? header) (if (map? invariant) (map? anchor-header) false) false)
      (sh08-ft-all-true? [
        (= invariant (get types (get anchor-call :operator-node-id)))
        (= invariant (sh08-si-finish (assoc anchor-header :range-proof range)))
        (sh08-si-proof-closed? range core anchor nodes bindings types)
        (= bid (get (get index :attributes) :binding-id)) (= [bid] (get index :resolved-binding-ids))
        (= (get header :vector-length) (get range :vector-extent))
        (= (get (get origin :node) :node-id) (get (get bound-origin :node) :node-id))
        (= (get origin :type) (get bound-origin :type) (first (get header :argument-types)))
        (sh08-si-origin-closed? origin (first args) (first (get header :argument-types)) core nodes types)
        (sh08-vl-path-valid? path (get node :node-id) (get (get (get range :guard-node) :children) 1) nodes)
        (= proof (sh08-vl-bounds header invariant origin path nodes))
        (= descriptor (sh08-vn-finish (assoc header :bounds-proof proof)))]) false)))

(defn sh08-vl-derive [core node call edge nodes bindings types forms]
  (if (sh08-ix-operation? core node)
    (sh08-ix-derive core node call edge nodes bindings types forms)
  (let [args (get call :argument-node-ids) vector-type (get types (first args)) elements (get vector-type :element-types)
        get? (= 'get (get (get bindings (get call :operator-binding-id)) :name))]
    (if (if (= 2 (count args))
          (if (= :gravity.type/vector (get vector-type :kind)) (= :gravity.type/integer (get types (get args 1))) false) false)
      (if (= false (= :reference (get (get nodes (get args 1)) :core-form)))
        (sh08-sm-failure "SAFE2-BOUNDS" (if get? :vector-get-loop-slot-reference-required :vector-nth-loop-slot-reference-required) nil :original-loop-slot-reference (get args 1))
      (if (= false (sh08-vl-homogeneous? elements))
        (sh08-sm-failure "C7-ANNOTATION" (if get? :vector-get-loop-homogeneous-element-type-required :vector-nth-loop-homogeneous-element-type-required) nil :nonempty-homogeneous-established-vector vector-type)
        (let [header (sh08-vl-source core node call edge nodes bindings types (get core :module))
              index (get nodes (get args 1)) bid (get (get index :attributes) :binding-id)
              invariant (sh08-vl-invariant core nodes types bid)]
          (if (if (map? header) (sh08-si-call-forms? node nodes forms) false)
            (if (map? invariant)
              (let [prepared (sh08-ft-loop-kernel-parent-index (get core :nodes) nodes)]
                (if (= :accepted (get prepared :status))
                  (let [range (get invariant :range-proof) parents (get prepared :index)
                        origin (sh08-si-vector-origin (first args) (get (get range :target) :owner-core-node-id) vector-type
                                 core nodes types bindings forms parents #{})
                        path (sh08-si-ancestry-path (get node :node-id) (get (get (get range :guard-node) :children) 1) nodes parents)
                        descriptor (sh08-vn-finish (assoc header :bounds-proof (sh08-vl-bounds header invariant origin path nodes)))]
                    (if (if (sh08-si-ref? index bid forms bindings) (sh08-vl-proof-valid? descriptor core node nodes bindings types) false)
                      {:status :accepted :descriptor descriptor :type (get descriptor :result-type)
                       :constraint (sh08-vn-constraint descriptor)}
                      (sh08-sm-failure "SAFE2-BOUNDS" (if get? :vector-get-loop-proof-or-origin-required :vector-nth-loop-proof-or-origin-required) nil
                               :same-slot-target-vector-and-strict-true-edge (get node :node-id))))
                  (sh08-sm-failure (get (first (get prepared :issues)) :rule "C7-VERIFY")
                           (if get? :vector-get-loop-parent-source-mismatch :vector-nth-loop-parent-source-mismatch)
                           nil :canonical-parent-census nil)))
              (sh08-sm-failure "C7-ANNOTATION" (if get? :vector-get-literal-index-required :vector-nth-literal-index-required) nil
                       :literal-index-or-established-S-loop-invariant (get args 1)))
            (sh08-sm-failure "C7-VERIFY" (if get? :vector-get-loop-call-source-mismatch :vector-nth-loop-call-source-mismatch) nil :authentic-operator-vector-slot-source (get node :node-id))))))
      (if get? (sh08-sm-failure "C7-ANNOTATION" :unsupported-vector-get-loop-operands nil
                         :normal-vector-and-integer-loop-slot (get call :core-node-id))
                      (sh08-vn-rejection call nodes types)))))
  )

(defn sh08-vl-step [node types binding-types functions context]
  (let [views (loop [ids (keys (get context :prior-type-table {})) out types]
                (if (= 0 (count ids)) out
                  (recur (rest ids) (if (contains? out (first ids)) out
                    (assoc out (first ids) (get (get context :prior-type-table) (first ids)))))))
        result (sh08-vl-derive (get context :ordering-core) node
                     (get (get context :ordering-operators) (first (get node :children)))
                     (get (get context :ordering-edges) (get node :node-id))
                     (get context :lookup-nodes) (get context :ordering-bindings) views (get context :association-forms))]
    result))


(defn sh08-vn-step [node types binding-types functions context]
  (if (sh08-vl-index? node (get context :lookup-nodes) types)
    (sh08-vl-step node types binding-types functions context)
    (sh08-vn-derive (get context :ordering-core) node
    (get (get context :ordering-operators) (first (get node :children)))
    (get (get context :ordering-edges) (get node :node-id))
    (get context :lookup-nodes) (get context :ordering-bindings) types (get context :association-forms))))

(defn sh08-vn-projection-type [demand]
  (loop [current demand]
    (if (map? (get current :next)) (recur (get current :next)) (get current :selected-type))))

(defn sh08-vn-projected? [shape demand]
  (if (= (get shape :type) (sh08-vn-projection-type demand))
    (loop [remaining (get shape :vector-projection-links [])]
      (if (= 0 (count remaining)) false
        (let [link (first remaining)]
          (if (sh08-ft-all-true? [(= (get demand :query-core-node-id) (get link :query-core-node-id))
                 (= (get demand :coordinate) (get link :coordinate)) (= (get demand :vector-type) (get link :vector-type))])
            true (recur (rest remaining)))))) false))

(defn sh08-vn-project-close [shape demand link]
  (if (= :accepted (get shape :status))
    (if (= (get shape :type) (sh08-vn-projection-type demand))
      (assoc shape :vector-projection-links
        (conj (get shape :vector-projection-links [])
          (assoc link :query-core-node-id (get demand :query-core-node-id)
                 :coordinate (get demand :coordinate)
                 :vector-type (get demand :vector-type)
                 :selected-type (get demand :selected-type)
                 :application (get demand :application))))
      (sh08-sm-failure "C7-VERIFY" :vector-nth-selected-shape-type-mismatch nil
        :selected-type (get demand :selected-type)))
    shape))

(defn sh08-vn-project-existing [shape demand]
  (let [cases (sh08-sm-shape-cases shape) index (get demand :coordinate)
        expected (get demand :vector-type) next (get demand :next)]
    (loop [remaining cases out []]
      (if (= 0 (count remaining))
        (let [selected (if (= 1 (count out)) (first out)
                         {:status :accepted :shape-kind :alternatives
                          :type (sh08-vn-projection-type demand)
                          :source (get shape :source) :binding-links [] :alternatives out})]
          (if (> (count out) 0)
            (sh08-vn-project-close selected demand
              {:kind :established-vector-coordinate :input-evidence shape})
            (sh08-sm-failure "C7-ANNOTATION" :vector-nth-selected-shape-required nil
              :established-vector-coordinate nil)))
        (let [case (first remaining) parts (get case :parts)
              part (if (vector? parts) (get parts index) nil)
              item (get part :shape)]
          (if (sh08-ft-all-true?
                [(= :vector (get case :shape-kind)) (= expected (get case :type))
                 (vector? parts)
                 (= (count (get expected :element-types)) (count parts))
                 (= index (get part :coordinate)) (= :accepted (get item :status))
                 (= (get demand :selected-type) (get item :type))])
            (let [projected (if (map? next) (sh08-vn-project-existing item next) item)]
              (if (= :accepted (get projected :status))
                (let [values (sh08-sm-shape-cases-with-origins projected (get case :case-origins {}))]
                  (recur (rest remaining) (sh08-ft-add-values-to-set values out)))
                projected))
            (sh08-sm-failure "C7-ANNOTATION" :vector-nth-selected-shape-required nil
              :source-linked-vector-coordinate (get case :shape-kind))))))))

(defn sh08-vn-project-data [data demand node]
  (let [children (get data :children) child-count (if (vector? children) (count children) 0)
        index (get demand :coordinate) expected (get demand :vector-type)]
    (if (sh08-ft-all-true?
          [(= :vector (get data :kind)) (= expected (get data :type)) (vector? children)
           (= child-count (count (get expected :element-types)))
           (if (integer? index) (if (<= 0 index) (< index child-count) false) false)
           (= (get demand :selected-type) (get (get children index) :type))])
      (let [selected-data (get children index)
            selected (if (map? (get demand :next))
                       (sh08-vn-project-data selected-data (get demand :next) node)
                       (sh08-qd-shape selected-data node))]
        (if (= :accepted (get selected :status))
          (sh08-vn-project-close selected demand
            {:kind :quoted-vector-coordinate :quote-node-id (get node :node-id)
             :quote-source (get node :source) :vector-data-origin (get data :origin)
             :selected-data-origin (get selected-data :origin)})
          selected))
      (sh08-sm-failure "C7-VERIFY" :vector-nth-vector-source-mismatch nil
        :exact-quoted-vector-coordinate (get data :origin)))))

(defn sh08-va-shape [node nodes types binding-types functions lexical bindings forms seen depth binding-shapes context]
  (let [id (get node :node-id) core (get context :source-core)
        call (get (get context :calls) id) edge (get (get context :edges) id)
        args (get call :argument-node-ids)
        views (loop [ids args out types]
                (if (= 0 (count ids)) out
                  (recur (rest ids) (if (contains? out (first ids)) out
                    (assoc out (first ids) (get (get context :prior-types) (first ids) :gravity.type/unknown))))))
        result (if (if (= :gravity.type/set (get views (get args 0))) true
                    (if (map? (get views (get args 0)))
                      (= :gravity.type/set (get (get views (get args 0)) :kind)) false))
                 (sh08-pl-derive core node call edge nodes bindings views forms)
                 (sh08-va-derive core node call edge nodes bindings views forms))
        descriptor (get result :descriptor)
        demand (get context :vector-coordinate-demand)]
    (if (= :accepted (get result :status))
      (if (contains? #{:sh08-string-set-insertion-v2 :sh08-keyword-set-insertion-v1
                       :sh08-symbol-set-insertion-v2} (get descriptor :version))
        (if (map? demand)
          (sh08-sm-failure "C7-ANNOTATION"
            (if (= :sh08-symbol-set-insertion-v2 (get descriptor :version))
              :symbol-set-insertion-positional-evidence-unsupported
              (if (= :sh08-keyword-set-insertion-v1 (get descriptor :version))
                :keyword-set-insertion-positional-evidence-unsupported
                :string-set-insertion-positional-evidence-unsupported))
            nil :bare-set-result (get descriptor :result-type))
          {:status :accepted :shape-kind :scalar :type (get descriptor :result-type)
           :node-id id :source (get node :source) :binding-links []
           :domain {:excluded-values []}})
        (if (= :not-invoked (get descriptor :application))
          {:status :accepted :shape-kind :scalar :type :gravity.type/never
           :node-id id :source (get node :source) :binding-links []
           :vector-append-links [{:application descriptor}]}
          (if (map? demand)
            (let [index (get demand :coordinate) extent (get descriptor :input-extent)
                  appended? (= index extent)
                  selected-id (get args (if appended? 1 0))
                  child-context (if appended?
                                 (assoc context :vector-coordinate-demand (get demand :next))
                                 (assoc context :vector-coordinate-demand
                                   (assoc demand :vector-type (first (get descriptor :argument-types)))))
                  valid? (sh08-ft-all-true?
                           [(= (get demand :vector-type) (get descriptor :result-type))
                            (if (integer? index) (<= 0 index extent) false)
                            (= (get demand :selected-type)
                               (get (get (get descriptor :result-type) :element-types) index))])]
              (if valid?
                (let [selected (sh08-sm-shape-with-bindings selected-id nodes views binding-types functions lexical bindings forms
                                (conj seen id) (+ depth 1) binding-shapes child-context)]
                  (sh08-vn-project-close selected demand
                    {:kind :persistent-vector-append-coordinate :append-application descriptor
                     :selection (if appended? :appended-value :original-prefix)
                     :selected-node-id selected-id
                     :selected-source (get (get nodes selected-id) :source)}))
                (sh08-sm-failure "C7-VERIFY" :vector-append-projection-mismatch nil
                  :exact-append-coordinate demand)))
            (let [input (sh08-sm-shape-with-bindings (get args 0) nodes views binding-types functions lexical bindings forms
                           (conj seen id) (+ depth 1) binding-shapes context)
                  value (if (= :accepted (get input :status))
                          (sh08-sm-shape-with-bindings (get args 1) nodes views binding-types functions lexical bindings forms
                            (conj seen id) (+ depth 1) binding-shapes context)
                          input)
                  shape {:status :accepted :shape-kind :vector :node-id id :source (get node :source)
                         :type (get descriptor :result-type) :binding-links []
                         :vector-append-links [{:application descriptor
                                                :input-shape input :value-shape value}]}]
              (if (= :accepted (get input :status))
                (if (= :accepted (get value :status))
                  (if (if (= :vector (get input :shape-kind))
                        (= (count (get input :parts)) (get descriptor :input-extent)) false)
                    (let [finished (sh08-sm-construct-cases
                                    (assoc shape :parts (conj (get input :parts)
                                      {:coordinate (get descriptor :input-extent) :value-node-id (get args 1) :shape value})))]
                      finished)
                    (sh08-sm-failure "C7-ANNOTATION" :vector-append-prefix-shape-required nil
                      :established-vector-prefix input))
                  value)
                input)))))
      result)))
(defn sh08-vn-project-input [id nodes types binding-types functions lexical bindings forms seen depth binding-shapes context]
  (let [demand (get context :vector-coordinate-demand)
        expected (get demand :vector-type) index (get demand :coordinate)
        node (get nodes id) kind (get node :core-form)
        form (get forms (get (get node :source) :form-id))
        type (get types id (get (get context :prior-types) id :gravity.type/unknown))
        child-context (if (map? (get demand :next))
                        (assoc context :vector-coordinate-demand (get demand :next))
                        (assoc context :vector-coordinate-demand nil))]
    (if (contains? seen id)
      (sh08-sm-failure "C7-VERIFY" :cyclic-constructor-evidence nil :acyclic-projection-origin id)
      (if (= false (= expected type))
        (sh08-sm-failure "C7-VERIFY" :vector-nth-projection-type-mismatch nil expected type)
        (if (if (= kind :call)
              (sh08-va-binding? (get bindings (get (get (get context :calls) id) :operator-binding-id))
                                (get (get context :source-core) :module)) false)
          (sh08-va-shape node nodes types binding-types functions lexical bindings forms seen depth binding-shapes context)
          (if (if (= kind :collection-literal)
                (= :vector (get (get node :attributes) :literal-kind)) false)
            (let [children (get node :children) ids (get form :child-form-ids)
                  child-count (if (vector? children) (count children) 0)
                  selected-id (get children index)
                  selected-node (get nodes selected-id)]
              (if (sh08-ft-all-true?
                    [(vector? children) (vector? ids) (= :vector (get form :kind))
                     (= (get node :source) (sh08-ma-form-source form))
                     (= child-count (get (get node :attributes) :element-count)
                        (count (get expected :element-types))
                        (if (vector? ids) (count ids) nil))
                     (if (integer? index) (if (<= 0 index) (< index child-count) false) false)
                     (= (get demand :selected-type) (get (get expected :element-types) index))
                     (= :left-to-right (get (get node :evaluation) :kind))
                     (= (loop [i 0 out []]
                          (if (= i child-count) out
                            (recur (+ i 1) (conj out {:index i :core-node-id (get children i)}))))
                        (get (get node :evaluation) :order))
                     (loop [i 0]
                       (if (= i child-count) true
                         (let [child (get nodes (get children i))
                               source (get forms (get ids i))]
                           (if (sh08-ft-all-true?
                                 [(= (get form :form-id) (get source :parent-form-id))
                                  (= (get child :source) (sh08-ma-form-source source))
                                  (= (get (get expected :element-types) i)
                                     (get types (get children i)
                                       (get (get context :prior-types) (get children i)
                                         :gravity.type/unknown)))])
                             (recur (+ i 1)) false))))])
                (let [selected (sh08-sm-shape-with-bindings selected-id nodes types binding-types functions lexical bindings forms
                                 (conj seen id) (+ depth 1) binding-shapes child-context)]
                  (sh08-vn-project-close selected demand
                    {:kind :evaluated-vector-coordinate :vector-node node
                     :source-child-form-ids ids :selected-node-id selected-id
                     :selected-source (get selected-node :source)}))
                (sh08-sm-failure "C7-VERIFY" :vector-nth-vector-source-mismatch nil
                  :exact-vector-coordinate-source id)))
            (if (= kind :quote)
              (let [quoted (sh08-qd-node node forms)]
                (if (= :accepted (get quoted :status))
                  (sh08-vn-project-data (get quoted :data) demand node)
                  quoted))
              (let [base-context (if (= kind :keyword-map-lookup)
                                   (assoc context :vector-coordinate-demand nil) context)
                    recovered (sh08-sm-shape-with-bindings-base id nodes types binding-types functions lexical bindings forms
                               seen depth binding-shapes base-context)]
                (if (= :accepted (get recovered :status))
                  (if (sh08-vn-projected? recovered demand)
                    recovered
                    (sh08-vn-project-existing recovered demand))
                  recovered)))))))))

(defn sh08-vn-shape [node nodes types binding-types functions lexical bindings forms seen depth binding-shapes context]
  (if (= :sh08-vector-nth-loop-v1 (get (get types (first (get node :children))) :version))
    (sh08-sm-failure "C7-ANNOTATION" :vector-nth-loop-selected-shape-unsupported nil :ordinary-homogeneous-element-type (get node :node-id))

  (let [id (get node :node-id) call (get (get context :calls) id) edge (get (get context :edges) id)
        views (loop [ids (get call :argument-node-ids) out types]
                (if (= 0 (count ids)) out
                  (recur (rest ids) (if (contains? out (first ids)) out
                    (assoc out (first ids) (get (get context :prior-types) (first ids) :gravity.type/unknown))))))
        result (sh08-vn-derive (get context :source-core) node call edge nodes bindings views forms)
        descriptor (get result :descriptor)]
    (if (= :accepted (get result :status))
      (if (= :not-invoked (get descriptor :application))
        {:status :accepted :shape-kind :scalar :type :gravity.type/never :node-id id :source (get node :source)
         :binding-links [] :vector-nth-selection {:application descriptor :projection-links []}}
        (let [demand {:query-core-node-id id :coordinate (get descriptor :index-value) :vector-type (first (get descriptor :argument-types))
                      :selected-type (get descriptor :selected-type) :application descriptor :next (get context :vector-coordinate-demand)}
              selected (sh08-sm-shape-with-bindings (first (get call :argument-node-ids)) nodes views binding-types functions lexical bindings forms
                         (conj seen id) (+ depth 1) binding-shapes
                         (assoc context :vector-coordinate-demand demand))]
          (assoc selected
            :vector-nth-selection {:application descriptor :projection-links (get selected :vector-projection-links)})))
      result))))

(defn sh08-sm-root-keyword-call-shape [node nodes types bindings forms context]
  ; A root scalar demand uses the independently established result type.
  ; It carries no selected constructor or callee-body ancestry.
  (let [id (get node :node-id) children (get node :children)
        sources (get (get context :source-core) :calls [])]
    (let [call (if (contains? (get context :calls {}) id) (get (get context :calls) id)
                   (sh08-si-record sources :core-node-id id))
            operator (get nodes (first children)) bid (get call :operator-binding-id)
            expected {:core-node-id id :operator-node-id (first children) :operator-binding-id (get call :operator-binding-id)
                      :argument-node-ids (vec (rest children)) :ordered-evaluation-node-ids children
                      :evaluation-order :operator-then-arguments :result-policy :call-result}]
      (if (if (= :gravity.type/keyword (get types id))
            (if (= call expected) (sh08-ft-call-valid? call nodes bindings) false) false)
        (if (sh08-ft-all-true? [(= :reference (get operator :core-form))
              (= bid (get (get operator :attributes) :binding-id)) (= [bid] (get operator :resolved-binding-ids))
              (sh08-si-call-forms? node nodes forms)])
          {:status :accepted :shape-kind :scalar :type :gravity.type/keyword
           :node-id id :source (get node :source) :binding-links []
           :domain {:excluded-values []}}
          (sh08-sm-failure "C7-VERIFY" :root-scalar-match-source-mismatch nil :original-scalar-call-source id))
        (sh08-sm-failure "C7-VERIFY" :root-scalar-match-type-or-call-mismatch nil :independently-established-keyword-call id)))))

(defn sh08-sm-shape-with-bindings [id nodes types binding-types functions lexical bindings forms seen depth binding-shapes call-context]
  (if (map? (get call-context :vector-coordinate-demand))
    (sh08-vn-project-input id nodes types binding-types functions lexical bindings forms seen depth binding-shapes call-context)
    (let [node (get nodes id) kind (get node :core-form)
          root? (= :gravity.type/keyword (get call-context :root-scalar-match-demand))
          keyword? (= :gravity.type/keyword (get types id))
          literal-selection? (= :sh08-vector-nth-v1 (get (get types (first (get node :children))) :version))
          form (get forms (get (get node :source) :form-id))
          source-valid? (if (if root? keyword? false)
                          (if (= (get node :source) (sh08-ma-form-source form))
                            (if (= :reference kind) (sh08-si-ref? node (get (get node :attributes) :binding-id) forms bindings) true) false) true)
          context (if (if root? (if keyword? (contains? #{:reference :let :call} kind) false) false)
                    call-context (assoc call-context :root-scalar-match-demand nil))]
      (if source-valid?
      (if (if root? (if keyword? (if (= :call kind)
              (if (= false literal-selection?) (= false (contains? seen id)) false) false) false) false)
          (sh08-sm-root-keyword-call-shape node nodes types bindings forms context)
          (sh08-sm-shape-with-bindings-base id nodes types binding-types functions lexical bindings forms seen depth binding-shapes
            (if literal-selection? (assoc context :root-scalar-match-demand nil) context)))
        (sh08-sm-failure "C7-VERIFY" :root-scalar-match-source-mismatch nil :original-scalar-source id)))))

(defn sh08-sm-shape-with-bindings-base [id nodes types binding-types functions lexical bindings forms seen depth binding-shapes call-context]
  (if (contains? seen id)
      (sh08-sm-failure "C7-VERIFY" :cyclic-constructor-evidence nil :acyclic-immutable-initializer id)
      (let [node (get nodes id) kind (get node :core-form) attrs (get node :attributes)
            form (get forms (get (get node :source) :form-id))
            established (get types id (get (get call-context :prior-types) id :gravity.type/unknown))
            type (if (sh08-ft-known? established) established
                   (sh08-ft-infer-node-with-context node types binding-types functions [] {}))
            base {:node-id id :type type :source (get node :source) :binding-links []}
            records (sh08-bm-select lexical :binding-id (get attrs :binding-id))]
        (if (if (= kind :reference) (contains? binding-shapes (get attrs :binding-id)) false)
          (let [evidence (get binding-shapes (get attrs :binding-id))
                alternatives (get evidence :alternatives)
                binding (get bindings (get attrs :binding-id))]
            (if (= :rejected (get evidence :status))
              (assoc evidence :node node)
            (if (sh08-ft-all-true?
                  [(= (get attrs :binding-id) (get evidence :binding-id))
                   (= :lexical (get binding :binding-class))
                   (= (get binding :scope-id) (get evidence :scope-id))
                   (contains? (set (get evidence :use-syntax-ids)) (get (get node :source) :syntax-id))
                   (> (count alternatives) 0)])
              (assoc base :status :accepted :shape-kind :alternatives :alternatives alternatives
                          :type (get evidence :type) :pattern-binding-evidence evidence)
              (sh08-sm-failure "C7-VERIFY" :invalid-pattern-shape-link nil :exact-pattern-binding-ancestry evidence))))
        (if (if (= kind :reference) (> (count records) 0) false)
          (if (if (= (count records) 1)
                (sh08-sm-let-link-valid? (first records) node nodes bindings forms) false)
            (let [record (first records)
                  shape (sh08-sm-shape-with-bindings (get record :initializer-node-id) nodes types binding-types functions
                                      lexical bindings forms (conj seen id) (+ depth 1) binding-shapes call-context)]
              (if (= :accepted (get shape :status))
                (assoc (assoc shape :reference-node-id id)
                       :binding-links (conj (get shape :binding-links) record)) shape))
            (sh08-sm-failure "C7-VERIFY" :invalid-immutable-shape-link nil :exact-let-initializer (first records)))
          (if (if (= kind :call) (sh08-va-binding? (get bindings (get (get (get call-context :calls) id) :operator-binding-id))
                                                        (get (get call-context :source-core) :module)) false)
            (sh08-va-shape node nodes types binding-types functions lexical bindings forms seen depth binding-shapes call-context)
          (if (if (= kind :call) (sh08-vn-binding? (get bindings (get (get (get call-context :calls) id) :operator-binding-id))
                                                        (get call-context :module)) false)
            (sh08-vn-shape node nodes types binding-types functions lexical bindings forms seen depth binding-shapes call-context)
          (if (if (= kind :call)
                (if (sh08-mr-binding? (get bindings (get (get (get call-context :calls) id) :operator-binding-id)) (get call-context :module)) true
                  (sh08-ma-binding? (get bindings (get (get (get call-context :calls) id) :operator-binding-id)) (get call-context :module))) false)
            (let [result (if (sh08-mr-binding? (get bindings (get (get (get call-context :calls) id) :operator-binding-id)) (get call-context :module))
                           (sh08-mr-derive node nodes types binding-types functions lexical bindings forms seen depth binding-shapes call-context)
                           (sh08-ma-derive node nodes types binding-types functions lexical bindings forms seen depth binding-shapes call-context))]
              (if (= :accepted (get result :status))
                (if (= nil (get result :shape))
                  (sh08-sm-failure "C7-ANNOTATION" :map-removal-map-shape-required nil
                           :independently-established-member-and-presence-evidence type)
                  (get result :shape)) result))
          (if (if (= kind :call) (contains? #{:gravity.type/map :gravity.type/vector} (if (map? type) (get type :kind) type)) false)
            (sh08-sm-call-shape node nodes types binding-types functions lexical bindings forms seen depth binding-shapes call-context)
          (if (= kind :let)
            (let [children (get node :children) index (get (get attrs :result-policy) :child-index)
                  body (get nodes (get children index))
                  body-form (get forms (get (get form :child-form-ids) (+ 1 (get attrs :body-count))))]
              (if (sh08-ft-all-true? [(= :last-body (get (get attrs :result-policy) :kind))
                     (= index (- (count children) 1)) (= :initializers-then-body-left-to-right (get (get node :evaluation) :kind))
                     (= (get form :form-id) (get body-form :parent-form-id))
                     (= (get body-form :form-id) (get (get body :source) :form-id))
                     (= (get body-form :syntax-id) (get (get body :source) :syntax-id))])
                (sh08-sm-shape-with-bindings (get body :node-id) nodes types binding-types functions lexical bindings forms
                                            (conj seen id) (+ depth 1) binding-shapes call-context)
                (sh08-sm-failure "C7-VERIFY" :structural-let-result-source-mismatch nil :exact-last-body-source id)))
          (if (= kind :keyword-map-lookup)
            (let [lookup (sh08-kl-shape node nodes types binding-types functions lexical bindings forms seen depth binding-shapes call-context)]
              (if (= :accepted (get lookup :status))
                (if (= :no-normal-result (get lookup :presence))
                  (assoc base :status :accepted :shape-kind :scalar :type :gravity.type/never)
                  (get lookup :shape)) lookup))
          (if (= kind :quote)
            (let [quoted (sh08-qd-node node forms)]
              (if (= :accepted (get quoted :status))
                (assoc (sh08-qd-shape (get quoted :data) node) :node-id id)
                (assoc quoted :node (if (map? (get quoted :form)) (sh08-bm-source-node node (get quoted :form)) node))))
          (if (= kind :collection-literal)
            (let [collection-kind (get attrs :literal-kind) children (get node :children)]
              (if (contains? #{:map :vector} collection-kind)
                (if (sh08-ft-all-true?
                      [(= collection-kind (get form :kind))
                       (= (count children) (get attrs :element-count) (count (get form :child-form-ids)))
                       (if (= collection-kind :map) (sh08-even-count? children) true)])
                  (loop [remaining children ordinal 0 parts [] child-types [] seen-keys #{} call-links []]
                    (if (= (count remaining) 0)
                      (assoc (sh08-sm-construct-cases (assoc (assoc base :status :accepted) :shape-kind collection-kind
                             :constructor-node-id id :parts parts :call-links call-links
                             :type (if (= collection-kind :map)
                                     {:kind :gravity.type/map :member-types child-types :shape :literal}
                                     {:kind :gravity.type/vector :element-types child-types :shape :literal}))) :call-links call-links)
                      (let [key-id (if (= collection-kind :map) (first remaining) nil)
                            value-id (if (= collection-kind :map) (second remaining) (first remaining))
                            key-node (get nodes key-id) key-form (get forms (get (get key-node :source) :form-id))
                            key (get (get key-node :attributes) :value)
                            value-node (get nodes value-id)
                            coordinate (if (= collection-kind :map) (+ ordinal 1) ordinal)
                            shape (sh08-sm-shape-with-bindings value-id nodes types binding-types functions lexical bindings forms (conj seen id) (+ depth 1) binding-shapes
                                    call-context)
                            key-valid (if (= collection-kind :map)
                                        (sh08-ft-all-true?
                                          [(= :literal (get key-node :core-form))
                                           (= :keyword (get (get key-node :attributes) :literal-kind) (get key-form :kind))
                                           (keyword? key) (= key (get key-form :value))
                                           (= (get (get key-node :source) :syntax-id) (get key-form :syntax-id))
                                           (= key-id (get children ordinal))
                                           (= (get (get key-node :source) :form-id) (get (get form :child-form-ids) ordinal))
                                           (= false (contains? seen-keys key))]) true)]
                        (if key-valid
                          (if (if (= (get (get value-node :source) :form-id) (get (get form :child-form-ids) coordinate))
                                (= (get (get value-node :source) :syntax-id)
                                   (get (get forms (get (get value-node :source) :form-id)) :syntax-id)) false)
                            (if (= :accepted (get shape :status))
                            (recur (if (= collection-kind :map) (rest (rest remaining)) (rest remaining))
                                     (+ ordinal (if (= collection-kind :map) 2 1))
                                     (conj parts {:coordinate coordinate :key key :key-node-id key-id
                                                  :value-node-id value-id :shape shape})
                                     (if (= collection-kind :map)
                                       (conj (conj child-types :gravity.type/keyword) (get shape :type))
                                       (conj child-types (get shape :type)))
                                     (conj seen-keys key)
                                     (sh08-ft-add-values-to-set (get shape :call-links []) call-links))
                              shape)
                            (sh08-sm-failure "C7-VERIFY" :constructor-child-source-mismatch nil :exact-constructor-child value-id))
                          (assoc (sh08-sm-failure
                            (if (= :keyword (get key-form :kind)) "C7-VERIFY" "C7-ANNOTATION")
                            (if (= :keyword (get key-form :kind)) :forged-structural-map-key :unsupported-structural-map-key)
                            nil :unique-literal-keyword-key key) :node key-node)))))
                  (sh08-sm-failure "C7-VERIFY" :malformed-structural-constructor nil :exact-constructor-children id))
                (sh08-sm-failure "C7-ANNOTATION" :unsupported-structural-constructor nil :literal-map-or-vector collection-kind)))
            (if (sh08-ft-known? type)
              (if (= kind :literal)
                (if (sh08-ft-all-true? [(= (get attrs :literal-kind) (get form :kind))
                                        (= type (sh08-primitive-type-from-literal-kind (get attrs :literal-kind)))
                                        (= (get attrs :value) (get form :value))])
                  (assoc base :status :accepted :shape-kind :scalar :domain {:values [(get attrs :value)]})
                  (sh08-sm-failure "C7-VERIFY" :literal-shape-source-mismatch nil :exact-literal-node id))
                (assoc base :status :accepted :shape-kind :scalar
                       :domain (if (= type :gravity.type/bool) {:values [true false]}
                                 (if (= type :gravity.type/nil) {:values [nil]} {:excluded-values []}))))
              (sh08-sm-failure "C7-ANNOTATION" :unestablished-structural-value-type nil :established-value-type type)))))))))))))))

(defn sh08-sm-part-index [shape key coordinate]
  (loop [parts (get shape :parts) index 0]
    (if (= (count parts) 0) nil
      (if (if (= :map (get shape :shape-kind)) (= key (get (first parts) :key))
            (= coordinate (get (first parts) :coordinate))) index
        (recur (rest parts) (+ index 1))))))

(defn sh08-sm-replace-part [shape index value]
  (assoc shape :parts (assoc (get shape :parts) index (assoc (get (get shape :parts) index) :shape value))))

(defn sh08-sm-applicable? [group type]
  (if (= true (get group :structural?)) true
    (if (= :gravity.type/keyword type) true
      (if (map? type) (contains? #{:gravity.type/map :gravity.type/vector} (get type :kind)) false))))

(defn sh08-sm-extractions [shape tree constructor-path]
  (sh08-sm-extractions-with-origins shape tree constructor-path (get shape :case-origins {})))

(defn sh08-sm-extractions-with-origins [shape tree constructor-path origins]
  (let [record (get tree :record)]
    (if (= :binding (get record :pattern-kind))
      [{:binding-id (get record :pattern-binding-id) :scope-id (get record :pattern-binding-scope-id)
        :type (get shape :type) :domain (get shape :domain)
        :shape (if (= (count origins) 0) shape (assoc shape :case-origins origins))
        :case-origins origins :data-origin (get shape :data-origin)
        :pattern-path (get record :path) :constructor-path constructor-path
        :pattern-form-id (get record :pattern-form-id) :pattern-syntax-id (get record :pattern-syntax-id)
        :value-node-id (get shape :node-id) :source-form (get tree :form)}]
      (loop [children (get tree :children) result []]
        (if (= (count children) 0) result
          (let [child (first children) index (sh08-sm-part-index shape (get child :key) (get child :coordinate))
                part (get (get shape :parts) index)]
            (recur (rest children)
              (sh08-ft-add-values-to-set
                (sh08-sm-extractions-with-origins (get part :shape) (get child :tree) (conj constructor-path (get part :coordinate))
                  (sh08-sm-merge-origins origins (get (get part :shape) :case-origins {}))) result))))))))

(defn sh08-gd-truth [group branch types]
  (if (contains? branch :guard)
    (let [id (get (get branch :guard) :node-id) type (get types id :gravity.type/unknown)
          node (get (get group :nodes) id) attrs (get node :attributes)
          value (if (= :quote (get node :core-form)) (get attrs :quoted-value) (get attrs :value))]
      (if (= type :gravity.type/never) :never
        (if (= type :gravity.type/bool)
          (if (if (= :literal (get node :core-form)) (= :boolean (get attrs :literal-kind))
                (if (= :quote (get node :core-form)) (= :boolean (get attrs :quoted-kind)) false))
            (if (boolean? value) (if value :true :false) :unknown) :unknown) :unknown))) :true))

(defn sh08-gd-match-result-type [node types context]
  (let [group (loop [remaining (get context :boolean-matches)]
                (if (= 0 (count remaining)) nil
                  (if (= (get node :node-id) (get (get (first remaining) :node) :node-id)) (first remaining)
                    (recur (rest remaining)))))]
    (if (= group nil) (sh08-bm-join (sh08-gd-branch-ids node) types)
      (loop [remaining (get group :branches) result []]
        (if (= 0 (count remaining)) (sh08-ft-normal-return-type :alternatives result :gravity.type/unknown)
          (let [branch (first remaining) truth (sh08-gd-truth group branch types)
                type (if (contains? #{:false :never} truth) :gravity.type/never
                       (get types (get branch :branch-core-node-id) :gravity.type/unknown))]
            (recur (rest remaining) (conj result type))))))))

(defn sh08-gd-result [group branch types validate?]
  (if (contains? branch :guard)
    (let [guard (get branch :guard) id (get guard :node-id) node (get (get group :nodes) id)
          type (get types id :gravity.type/unknown) tree (sh08-bm-tree (get group :nodes) id)
          truth (sh08-gd-truth group branch types)]
        (if (if validate? (= false (contains? #{:gravity.type/bool :gravity.type/never} type)) false)
          (assoc (sh08-sm-failure "L7-GUARD-TYPE" :guard-result-not-boolean nil :gravity.type/bool type) :node node)
          {:status :accepted :truth truth
           :guard {:rule-version :sh08-bool-root-map-guard-v1 :core-node-id id :type type :truth truth
                   :source (sh08-gd-source guard) :conditional-region (get guard :conditional-region)
                   :effects (get (get node :preserved-declarations) :effects)
                   :capabilities (get (get node :preserved-declarations) :capabilities)
                   :evaluation :once-after-structural-success :on-pattern-failure :next-candidate
                   :on-true :branch-body :on-false :next-candidate
                   :binding-ids (get branch :pattern-binding-ids)
                   :call-node-ids (sh08-gd-call-ids (get group :node-sequence) tree)
                   :call-membership (loop [remaining (get group :node-sequence) result []]
                                      (if (= (count remaining) 0) result
                                        (let [call-node (first remaining)]
                                          (recur (rest remaining)
                                            (if (if (= :call (get call-node :core-form))
                                                  (contains? tree (get call-node :node-id)) false)
                                              (conj result {:core-node-id (get call-node :node-id)
                                                            :evaluation (get call-node :evaluation)
                                                            :call-record (first (sh08-bm-select (get group :calls) :core-node-id (get call-node :node-id)))}) result)))))
                   :dependencies {:guard guard :binding-ids (get branch :pattern-binding-ids)}
                   :invalidation [:guard-source :guard-node-type :guard-region :binding-scopes :guard-call-facts :guard-effects :guard-capabilities]}}))
    {:status :accepted :truth :true}))

(defn sh08-sm-partition-with-guards [group shape types validate?]
  (loop [trees (get group :pattern-trees) branches (get group :branches)
         domains (sh08-sm-shape-cases shape) facts []]
    (if (= (count trees) 0) {:status :accepted :branches facts :remaining domains}
      (let [tree (first trees)
            split (loop [remaining domains selected [] residual []]
                    (if (= (count remaining) 0) {:status :accepted :selected selected :residual residual}
                      (let [result (sh08-sm-split (first remaining) tree)]
                        (if (= :accepted (get result :status))
                          (recur (rest remaining) (sh08-ft-add-values-to-set (get result :selected) selected)
                                 (sh08-ft-add-values-to-set (get result :residual) residual)) result))))]
        (if (= :accepted (get split :status))
          (if (= (count (get split :selected)) 0)
            (sh08-sm-failure "L7-UNREACHABLE" :unreachable-structural-match-clause (get tree :record) :remaining-constructor-case (get (get tree :record) :pattern-value))
            (let [guard-result (sh08-gd-result group (first branches) types validate?)
                  extractions (loop [selected (get split :selected) result [] case-index 0]
                                (if (= (count selected) 0) result
                                  (let [selected-shape (first selected)
                                        origins (assoc (get selected-shape :case-origins {}) (get (get group :node) :node-id)
                                                       {:clause-ordinal (get (first branches) :clause-ordinal) :case-index case-index})]
                                    (recur (rest selected) (sh08-ft-add-values-to-set
                                      (sh08-sm-extractions-with-origins selected-shape tree [] origins) result) (+ case-index 1)))))]
              (if (= :accepted (get guard-result :status))
                (let [after (if (contains? #{:true :never} (get guard-result :truth)) (get split :residual) domains)
                      selected (if (contains? #{:false :never} (get guard-result :truth)) [] (get split :selected))
                      fact {:branch (first branches) :tree tree :remaining-before domains
                            :selected selected :remaining-after after :extractions extractions}]
                  (recur (rest trees) (rest branches) after
                    (conj facts (if (contains? guard-result :guard)
                                  (assoc fact :guard (get guard-result :guard) :structural-selected (get split :selected)) fact))))
                guard-result))) split)))))

(defn sh08-sm-partition [group shape]
  (sh08-sm-partition-with-guards group shape {} false))

(defn sh08-sm-group-shape [group types binding-types functions]
  (sh08-sm-shape-with-bindings (first (get (get group :node) :children)) (get group :nodes) types binding-types functions
                 (get group :lexical-bindings) (get group :binding-index) (get group :forms) #{} 0 (get group :binding-shapes {})
                 (assoc (get group :shape-call-context {}) :root-scalar-match-demand :gravity.type/keyword)))

(defn sh08-sm-extraction-type [values]
  (let [type (get (first values) :type)]
    (loop [remaining values]
      (if (= (count remaining) 0) type
        (if (= type (get (first remaining) :type)) (recur (rest remaining)) :gravity.type/unknown)))))

; Alternatives remain whole constructor cases. Never join their fields separately.
(defn sh08-sm-seed-shapes [group types binding-types functions prior]
  (let [shape (sh08-sm-group-shape (assoc group :binding-shapes prior) types binding-types functions)
        partition (if (= :accepted (get shape :status)) (sh08-sm-partition group shape) shape)]
    (if (= :accepted (get partition :status))
      (loop [branches (get partition :branches) result prior]
        (if (= (count branches) 0) result
          (let [fact (first branches)
                grouped (loop [values (get fact :extractions) out {}]
                          (if (= (count values) 0) out
                            (let [value (first values) id (get value :binding-id)]
                              (recur (rest values) (assoc out id (conj (get out id []) value))))))]
            (recur (rest branches)
              (loop [ids (keys grouped) out result]
                (if (= (count ids) 0) out
                  (let [id (first ids) values (get grouped id) value (first values)
                        record (get (get fact :tree) :record)
                        source-record (first (sh08-bm-select (get group :patterns) :pattern-binding-id id))
                        alternatives (loop [remaining values shapes []]
                                       (if (= (count remaining) 0) shapes
                                         (let [extraction (first remaining) extracted (get extraction :shape)]
                                           (recur (rest remaining) (conj shapes extracted)))))]
                    (recur (rest ids)
                      (assoc out id {:binding-id id :scope-id (get value :scope-id) :type (sh08-sm-extraction-type values)
                                     :use-syntax-ids (get source-record :pattern-binding-use-syntax-ids)
                                     :match-core-node-id (get (get group :node) :node-id)
                                     :clause-ordinal (get record :clause-ordinal)
                                     :pattern-path (get value :pattern-path) :extractions values
                                     :scrutinee-shape shape
                                     :structural-premises (get fact :remaining-before)
                                     :structurally-matched-shapes (if (contains? fact :structural-selected)
                                                                    (get fact :structural-selected) (get fact :selected))
                                     :alternatives alternatives}))))))))) prior)))

(defn sh08-sm-seed-all-shapes [groups types bindings functions prior]
  (loop [remaining groups result prior]
    (if (= (count remaining) 0) result
      (recur (rest remaining) (sh08-sm-seed-shapes (first remaining) types bindings functions result)))))

(defn sh08-sm-groups-with-shapes [groups shapes]
  (loop [remaining groups result []]
    (if (= (count remaining) 0) result
      (recur (rest remaining) (conj result (assoc (first remaining) :binding-shapes shapes))))))

(defn sh08-sm-groups-with-call-context [groups context]
  (loop [remaining groups result []]
    (if (= 0 (count remaining)) result
      (recur (rest remaining) (conj result (assoc (first remaining) :shape-call-context context))))))

(defn sh08-sm-seed [group types binding-types functions]
  (let [shape (sh08-sm-group-shape group types binding-types functions)]
    (if (= :accepted (get shape :status))
      (let [partition (sh08-sm-partition group shape)]
        (if (= :accepted (get partition :status))
          (loop [branches (get partition :branches) result binding-types]
            (if (= (count branches) 0) result
              (recur (rest branches)
                (loop [values (get (first branches) :extractions) out result]
                  (if (= (count values) 0) out
                    (let [id (get (first values) :binding-id) evidence (get (get group :binding-shapes) id)]
                      (recur (rest values) (assoc out id (if (map? evidence) (get evidence :type) (get (first values) :type))))))))))
          binding-types)) binding-types)))

(defn sh08-sm-diagnostic [group failure]
  (let [node (get group :node) record (get failure :record)
        source-node (if (map? (get failure :node)) (get failure :node)
                     (if (map? record)
                      (sh08-bm-source-node node (get (get group :forms) (get record :pattern-form-id))) node))]
    (sh08-bm-error (get failure :rule) (get failure :reason) source-node (get failure :expected) (get failure :actual))))

(defn sh08-sm-expected-return [group functions]
  (let [node (get group :node)
        owner (get functions (get (get node :evaluation) :owner-function-syntax-id))
        expected (if (= :sh07-list-return-declaration-v1 (get (get (get owner :signature) :return) :rule-version)) nil
                   (get (get (get owner :signature) :return) :type-id))]
    (loop [id (get owner :body-core-node-id) seen #{}]
      (if (= id (get node :node-id)) expected
        (if (contains? seen id) nil
          (let [parent (get (get group :nodes) id) attrs (get parent :attributes)
                children (get parent :children) final-index (- (count children) 1)]
            (if (if (= :let (get parent :core-form))
                  (if (integer? (get attrs :body-count))
                    (if (> (get attrs :body-count) 0)
                      (if (= :last-body (get (get attrs :result-policy) :kind))
                        (if (= final-index (get (get attrs :result-policy) :child-index))
                          (contains? (set (get attrs :body-child-indexes)) final-index) false) false) false) false) false)
              (recur (get children final-index) (conj seen id)) nil)))))))

(defn sh08-sm-check [group types functions module]
  (let [node (get group :node) shape (sh08-sm-group-shape group types {} functions)
        partition (if (= :accepted (get shape :status)) (sh08-sm-partition-with-guards group shape types true) shape)
        declared (sh08-sm-expected-return group functions)
        result
    (if (= :accepted (get partition :status))
      (if (= 0 (count (get partition :remaining)))
        (loop [branches (get partition :branches) result-type :gravity.type/unknown facts []]
          (if (= (count branches) 0)
            {:constraints facts :type result-type}
            (let [fact (first branches) branch (get fact :branch) body-id (get branch :branch-core-node-id)
                  body (get (get group :nodes) body-id) type (get types body-id :gravity.type/unknown)
                  effective (if (contains? #{:false :never} (get (get fact :guard) :truth)) :gravity.type/never type)
                  expected (if (= declared nil) result-type declared)]
              (if (sh08-ft-known? type)
                (if (if (sh08-ft-known? expected)
                      (if (= effective :gravity.type/never) true
                        (if (if (= declared nil) (= expected :gravity.type/never) false) true (= expected type))) true)
                  (recur (rest branches)
                    (if (= result-type :gravity.type/unknown) effective
                      (sh08-ft-normal-return-type :alternatives [result-type effective] :gravity.type/unknown))
                    (conj facts (sh08-gd-constraint fact {:constraint-id-request
                                  {:domain :gravity/sh08-structural-match-constraint-v1 :match-core-node-id (get node :node-id)
                                   :clause-ordinal (get branch :clause-ordinal) :branch branch
                                   :pattern-tree (get fact :tree) :skeleton (get group :skeleton)}
                                 :kind :equality :producer-rule :sh08-structural-match-v1 :lhs body-id :rhs type
                                 :constructor-shape shape :remaining-before (get fact :remaining-before)
                                 :matched-shapes (get fact :selected) :remaining-after (get fact :remaining-after)
                                 :extractions (get fact :extractions)
                                 :exhaustive-after? (= 0 (count (get fact :remaining-after)))
                                 :source (get (sh08-bm-source-node node (get (get fact :tree) :form)) :source)
                                 :branch-source (get body :source)
                                 :dependencies {:scrutinee-node-id (first (get node :children)) :constructor-shape shape
                                                :pattern-tree (get fact :tree) :branch-node-id body-id :extractions (get fact :extractions)}
                                 :solution {:result-type type :selected-shapes (get fact :selected) :binding-extractions (get fact :extractions)}
                                 :invalidation [:constructor-children :key-nodes :value-node-types :immutable-initializers :pattern-paths :binding-scopes :branch-types
                                                :pattern-binding-shapes :case-origins :correlated-constructor-products
                                                :calls :call-edges :definitions :function-records :callee-body :binding-table]
                                 :profile (get module :profile) :target (get module :target) :status :solved :diagnostics []})))
                  {:diagnostic (sh08-bm-error (if (= declared nil) "C7-ANNOTATION" "C7-TYPE-MISMATCH")
                                   (if (= declared nil) :unsupported-heterogeneous-structural-match-join :structural-match-branch-type-mismatch)
                                   body expected type)})
                {:diagnostic (sh08-bm-error "C7-ANNOTATION" :unknown-structural-match-branch-type body :established-branch-type type)}))))
        {:diagnostic (if (= :gravity.type/keyword (get shape :type))
                       (sh08-bm-error "C7-ANNOTATION" :unsupported-partial-keyword-match node
                         :keyword-fallback-or-partiality-evidence (get partition :remaining))
                       (sh08-bm-error (if (= :formal (get module :profile)) "L7-NONEXHAUSTIVE" "C7-ANNOTATION")
                         (if (= :formal (get module :profile)) :nonexhaustive-structural-match :unsupported-partial-structural-match)
                         node :exhaustive-constructor-match (get partition :remaining)))})
      {:diagnostic (sh08-sm-diagnostic group partition)})]
    result))

(defn sh08-gd-constraint [fact constraint]
  (if (contains? fact :guard)
    (assoc constraint :guard (get fact :guard) :guard-rule-version :sh08-bool-root-map-guard-v1
                      :structurally-matched-shapes (get fact :structural-selected)
                      :dependencies (assoc (get constraint :dependencies) :guard (get fact :guard))
                      :solution (assoc (get constraint :solution) :guard-truth (get (get fact :guard) :truth)
                                       :guard-body-shapes (get fact :selected) :guard-fallthrough-shapes (get fact :remaining-after)
                                       :body-completion (if (contains? #{:false :never} (get (get fact :guard) :truth)) :not-executed :potential)
                                       :effective-result-type (if (contains? #{:false :never} (get (get fact :guard) :truth))
                                                                :gravity.type/never (get constraint :rhs)))
                      :invalidation (sh08-ft-add-values-to-set
                                      [:guard-source :guard-node-type :guard-region :guard-call-facts :guard-truth :guard-evaluation-order :guard-effects :guard-capabilities]
                                      (get constraint :invalidation))
                      :constraint-id-request (assoc (get constraint :constraint-id-request)
                                               :domain :gravity/sh08-guarded-structural-match-constraint-v1
                                               :guard (get fact :guard))) constraint))

(defn sh08-sm-split-children [shape children]
  (loop [remaining children selected [shape] residual []]
    (if (= (count remaining) 0) {:status :accepted :selected selected :residual residual}
      (let [child (first remaining)
              split (loop [domains selected matches [] rest-domains residual]
                      (if (= (count domains) 0) {:status :accepted :selected matches :residual rest-domains}
                        (let [domain (first domains)
                              index (sh08-sm-part-index domain (get child :key) (get child :coordinate))]
                          (if (= index nil)
                            (recur (rest domains) matches (conj rest-domains domain))
                            (let [part (get (get domain :parts) index)
                                  result (sh08-sm-split (get part :shape) (get child :tree))]
                              (if (= :accepted (get result :status))
                                (recur (rest domains)
                                  (loop [values (get result :selected) out matches]
                                    (if (= (count values) 0) out
                                      (recur (rest values) (conj out (sh08-sm-replace-part domain index (first values))))))
                                  (loop [values (get result :residual) out rest-domains]
                                    (if (= (count values) 0) out
                                      (recur (rest values) (conj out (sh08-sm-replace-part domain index (first values))))))) result))))))]
        (if (= :accepted (get split :status))
          (recur (rest remaining) (get split :selected) (get split :residual)) split)))))

(defn sh08-sm-split [shape tree]
  (if (= :alternatives (get shape :shape-kind))
    (loop [remaining (get shape :alternatives) selected [] residual []]
      (if (= (count remaining) 0) {:status :accepted :selected selected :residual residual}
        (let [split (sh08-sm-split (first remaining) tree)]
          (if (= :accepted (get split :status))
            (recur (rest remaining) (sh08-ft-add-values-to-set (get split :selected) selected)
                   (sh08-ft-add-values-to-set (get split :residual) residual)) split))))
  (let [record (get tree :record) kind (get record :pattern-kind)
        shape-kind (get shape :shape-kind) type (get shape :type) value (get record :pattern-value)]
    (if (contains? #{:wildcard :binding} kind)
      {:status :accepted :selected [shape] :residual []}
      (if (contains? #{:map :vector} kind)
        (if (= kind shape-kind)
          (if (if (= kind :vector) (= (get record :vector-width) (count (get shape :parts))) true)
            (sh08-sm-split-children shape (get tree :children))
            {:status :accepted :selected [] :residual [shape]})
          (if (if (map? type) (contains? #{:gravity.type/map :gravity.type/vector} (get type :kind)) false)
            (if (= shape-kind :scalar)
              (sh08-sm-failure "C7-ANNOTATION" :unestablished-structural-shape record :constructor-linked-shape type)
              (sh08-sm-failure "L7-PATTERN-TYPE" :structural-pattern-type-mismatch record kind shape-kind))
            (sh08-sm-failure "L7-PATTERN-TYPE" :structural-pattern-type-mismatch record kind type)))
        (let [form (get tree :form)
              literal-type (if (= :list (get form :kind)) :gravity.type/symbol
                             (sh08-primitive-type-from-literal-kind (get form :kind)))
              domain (get shape :domain)]
          (if (if (sh08-sm-numeric-type? literal-type)
                (if (sh08-sm-numeric-type? type)
                  (if (= literal-type type) (= literal-type :gravity.type/decimal) true) false) false)
            (sh08-sm-failure "C7-ANNOTATION" :unsupported-numeric-pattern-elaboration record :established-numeric-pattern-elaboration type)
          (if (= literal-type type)
            (if (contains? domain :values)
              (let [selected (if (contains? (set (get domain :values)) value) [value] [])
                    residual (loop [values (get domain :values) result []]
                               (if (= (count values) 0) result
                                 (recur (rest values) (if (= value (first values)) result (conj result (first values))))))]
                {:status :accepted
                 :selected (if (= (count selected) 0) [] [(assoc shape :domain {:values selected})])
                 :residual (if (= (count residual) 0) [] [(assoc shape :domain {:values residual})])})
              (if (contains? (set (get domain :excluded-values)) value)
                {:status :accepted :selected [] :residual [shape]}
                {:status :accepted :selected [(assoc shape :domain {:values [value]})]
                 :residual [(assoc shape :domain {:excluded-values (conj (get domain :excluded-values) value)})]}))
            (sh08-sm-failure "L7-PATTERN-TYPE" :structural-leaf-pattern-type-mismatch record type literal-type)))))))))

(defn sh08-sm-numeric-type? [type]
  (contains? #{:gravity.type/integer :gravity.type/decimal :gravity.type/ratio
               :gravity.type/i8 :gravity.type/i16 :gravity.type/i32 :gravity.type/i64
               :gravity.type/u8 :gravity.type/u16 :gravity.type/u32 :gravity.type/u64
               :gravity.type/f32 :gravity.type/f64} type))

(defn sh08-ft-infer-node
  [node type-table binding-types function-types edges]
  (sh08-ft-infer-node-with-context
   node type-table binding-types function-types edges {}))

(defn sh08-ft-bind-lexical-types
  [lexical-bindings type-table binding-types]
  (loop [remaining lexical-bindings result binding-types]
    (if (= (count remaining) 0)
      result
      (let [record (first remaining)
            inferred
            (get type-table (get record :initializer-node-id)
                 :gravity.type/unknown)]
        (recur
         (rest remaining)
         (assoc result (get record :binding-id) inferred))))))

(defn sh08-ft-bind-definition-types
  [definitions type-table binding-types function-types]
  (loop [remaining definitions result binding-types]
    (if (= (count remaining) 0)
      result
      (let [definition (first remaining)
            value-type
            (get type-table (get definition :value-node-id)
                 :gravity.type/unknown)
            value
            (if (sh08-ft-unknown? value-type)
              (let [function
                    (sh08-ft-function-by-core-id
                     function-types (get definition :value-node-id))]
                (if (map? function)
                  function
                  value-type))
              value-type)]
        (recur
         (rest remaining)
         (assoc result (get definition :binding-id) value))))))

; L5: a Map parameter forgets only independently checked member refinements.
(defn sh08-mp-compatibility [core call edge callee index actual nodes bindings]
  (let [parameter (get (get callee :parameters) index)]
    (if (if (= :gravity.type/map (get parameter :type))
          (if (map? actual) (= :gravity.type/map (get actual :kind)) false) false)
      (let [records (get core :function-records)
            validation (sh08-lc-validate-types [actual])
            record (loop [remaining records]
                     (if (= 0 (count remaining)) nil
                       (if (= (get callee :function-id) (get (first remaining) :function-syntax-id))
                         (first remaining) (recur (rest remaining)))))
            declaration (get (get (get record :signature) :parameters) index)
            bid (get parameter :binding-id) binding (get bindings bid)
            type-binding (get bindings (get declaration :type-binding-id))
            argument-id (get (get call :argument-node-ids) index) argument (get nodes argument-id)
            node (get nodes (get call :core-node-id))]
        (if (sh08-ft-all-true?
                [(= :accepted (get validation :status))
                 (sh08-ft-declaration-valid? declaration bindings)
                 (= ['Map :gravity.type/map] [(get declaration :type-symbol) (get declaration :type-id)])
                 (= :local-function (get edge :classification))
                 (= (get callee :function-id) (get edge :callee-function-syntax-id) (get record :function-syntax-id))
                 (= (get record :signature) (get callee :signature))
                 (= (get record :function-core-node-id) (get edge :callee-function-core-node-id))
                 (= bid (get (get record :parameter-binding-ids) index) (get binding :binding-id))
                 (= [:lexical :local] [(get binding :binding-class) (get binding :kind)])
                 (= [:core :type 'gravity.core 'Map] [(get type-binding :binding-class) (get type-binding :kind)
                                                      (get type-binding :namespace) (get type-binding :name)])
                 (= (get declaration :source-child-index) (+ 1 (get (get (get record :signature) :parameter-source-child-indexes) index -100)))
                 (= (get call :core-node-id) (get edge :call-core-node-id) (get node :node-id))
                 (= (get call :argument-node-ids) (get edge :argument-core-node-ids) (vec (rest (get node :children))))
                 (= argument-id (get argument :node-id))])
            {:status :accepted
             :premise {:version :sh08-bare-map-parameter-v1 :relation :forget-map-member-refinement
                       :call-core-node-id (get call :core-node-id) :argument-node-id argument-id :argument-index index
                       :actual-type actual :declared-type :gravity.type/map
                       :callee-function-syntax-id (get record :function-syntax-id)
                       :parameter-binding-id bid :parameter-binding binding :declaration declaration :type-binding type-binding
                       :argument-source (get argument :source) :call-source (get node :source)
                       :source-call call :source-edge edge
                       :forgets [:key-value-member-types :static-entry-count]
                       :preserves [:value :provenance :schema :ownership :linearity :regions :profile :memory-obligations]
                       :profile (get (get core :module) :profile) :target (get (get core :module) :target)}}
            {:status :rejected :reason :map-parameter-declaration-or-type-required}))
      {:status :not-applicable})))

; L5: only an authenticated explicit bare List parameter can forget position.
(defn sh08-lp-compatibility [core call edge callee index actual nodes bindings]
  (if (= :gravity.type/map (get (get (get callee :parameters) index) :type))
    (sh08-mp-compatibility core call edge callee index actual nodes bindings)
  (let [parameter (get (get callee :parameters) index) expected (get parameter :type)
        homogeneous? (sh08-hl-type? expected)]
    (if (if (if homogeneous? true (= :gravity.type/list expected))
          (if (map? actual)
            (= [:gravity.type/list :literal #{:kind :shape :element-types}]
               [(get actual :kind) (get actual :shape) (set (keys actual))]) false) false)
      (let [records (get core :function-records)
            validation (sh08-lc-validate-types [actual])
            record (loop [remaining records]
                     (if (= 0 (count remaining)) nil
                       (if (= (get callee :function-id) (get (first remaining) :function-syntax-id))
                         (first remaining) (recur (rest remaining)))))
            declaration (get (get (get record :signature) :parameters) index)
            bid (get parameter :binding-id) binding (get bindings bid)
            type-binding (get bindings (get declaration :type-binding-id))
            argument-id (get (get call :argument-node-ids) index) argument (get nodes argument-id)
            node (get nodes (get call :core-node-id))]
        (if (sh08-ft-all-true?
                [(= :accepted (get validation :status))
                 (= :local-function (get edge :classification))
                 (= (get callee :function-id) (get edge :callee-function-syntax-id) (get record :function-syntax-id))
                 (= (get record :signature) (get callee :signature))
                 (= (get record :function-core-node-id) (get edge :callee-function-core-node-id))
                 (= bid (get (get record :parameter-binding-ids) index) (get binding :binding-id))
                 (= [:lexical :local] [(get binding :binding-class) (get binding :kind)])
                 (= [:core :type 'gravity.core 'List] [(get type-binding :binding-class) (get type-binding :kind)
                                                       (get type-binding :namespace) (get type-binding :name)])
                 (if homogeneous?
                   (sh08-ft-all-true? [(sh08-hl-declaration? declaration bindings) (= expected (get declaration :type-id))
                     (if (if (= :accepted (get validation :status)) (vector? (get actual :element-types)) false)
                       (loop [members (get actual :element-types)]
                         (if (= 0 (count members)) true
                           (if (= (first members) (get expected :element-type)) (recur (rest members)) false))) false)])
                   (= ['List :gravity.type/list] [(get declaration :type-symbol) (get declaration :type-id)]))
                 (= (get declaration :source-child-index) (+ 1 (get (get (get record :signature) :parameter-source-child-indexes) index -100)))
                 (= (get call :core-node-id) (get edge :call-core-node-id) (get node :node-id))
                 (= (get call :argument-node-ids) (get edge :argument-core-node-ids) (vec (rest (get node :children))))
                 (= argument-id (get argument :node-id))])
            {:status :accepted
             :premise (let [premise {:version :sh08-bare-list-parameter-v1 :relation :forget-positional-list-refinement
                       :call-core-node-id (get call :core-node-id) :argument-node-id argument-id :argument-index index
                       :actual-type actual :declared-type expected
                       :callee-function-syntax-id (get record :function-syntax-id)
                       :parameter-binding-id bid :parameter-binding binding :declaration declaration :type-binding type-binding
                       :argument-source (get argument :source) :call-source (get node :source)
                       :source-call call :source-edge edge
                       :forgets [:positional-element-types :static-length]
                       :preserves [:value :provenance :schema :ownership :linearity :regions :profile :memory-obligations]
                       :profile (get (get core :module) :profile) :target (get (get core :module) :target)}]
                        (if homogeneous?
                          (assoc premise :version :sh08-homogeneous-list-parameter-v1 :relation :all-positional-elements-match
                            :forgets [:static-length] :element-binding (get bindings (get declaration :element-binding-id))
                            :checked-element-type (get expected :element-type) :checked-element-count (count (get actual :element-types))) premise))}
            {:status :rejected :reason (if homogeneous? :homogeneous-list-parameter-incompatible :list-parameter-declaration-required)}))
      {:status :not-applicable}))))

(defn sh08-lp-pairs-adapted? [pairs]
  (loop [remaining pairs]
    (if (= 0 (count remaining)) false
      (if (contains? (first remaining) :compatibility) true (recur (rest remaining))))))

(defn sh08-lp-call-row [row]
  (if (sh08-lp-pairs-adapted? (get row :rhs))
    (assoc row :kind :argument-compatibility :compatibility-rule-version
      (loop [pairs (get row :rhs) map? false homogeneous? false]
        (if (= 0 (count pairs))
          (if map? :sh08-map-list-parameter-compatibility-v1
            (if homogeneous? :sh08-list-parameter-compatibility-v2 :sh08-bare-list-parameter-v1))
          (let [version (get (get (first pairs) :compatibility) :version)]
            (recur (rest pairs) (if map? true (= version :sh08-bare-map-parameter-v1))
                               (if homogeneous? true (= version :sh08-homogeneous-list-parameter-v1))))))) row))

(defn sh08-ft-first-type-mismatch [pairs]
  (if (= (count pairs) 0)
    nil
    (let [pair (first pairs)
          argument (get pair :argument)
          chosen (get pair :chosen)]
      (if (if (if (= argument :gravity.type/never) false (sh08-ft-known? argument))
            (if (sh08-ft-known? chosen)
              (if (contains? pair :compatibility) false (if (= argument chosen) false true))
              false)
            false)
        pair
        (sh08-ft-first-type-mismatch (rest pairs))))))

(defn sh08-ft-call-constraints-with-context
  [calls edges nodes type-table binding-types function-types context]
  (loop [remaining calls remaining-edges edges next-bindings binding-types
         constraints [] diagnostics []]
    (if (= 0 (count remaining))
      {:binding-types next-bindings :constraints constraints
       :diagnostics diagnostics}
      (let [call (first remaining)
            edge (first remaining-edges)
            node (if (sh08-sse-ids? [(get call :core-node-id)] 1)
                   (get nodes (get call :core-node-id)) nil)
            operator-binding (get (get context :ordering-bindings)
                                  (get call :operator-binding-id))
            module (get (get context :ordering-core) :module)]
        (if (sh08-bka-entry? node call nodes (get context :ordering-bindings)
              type-table module)
          (let [checked (sh08-bka-inferred-call
                          (get context :ordering-core) node call edge nodes
                          (get context :ordering-bindings) type-table)]
            (if (= :accepted (get checked :status))
              (recur (rest remaining) (rest remaining-edges) next-bindings
                constraints diagnostics)
              {:binding-types next-bindings :constraints constraints
               :diagnostics
               (conj diagnostics {:call call :rule "C7-VERIFY"
                                  :reason (get checked :reason)
                                  :expected :fresh-bare-keyword-anchor-set-equality-application
                                  :actual :mismatched-application})}))
          (if (sh08-lset-entry? node call nodes (get context :ordering-bindings)
                type-table module)
            (let [checked (sh08-lset-inferred-call
                            (get context :ordering-core) node call edge nodes
                            (get context :ordering-bindings) type-table)]
              (if (= :accepted (get checked :status))
                (recur (rest remaining) (rest remaining-edges) next-bindings
                  constraints diagnostics)
                {:binding-types next-bindings :constraints constraints
                 :diagnostics
                 (conj diagnostics {:call call :rule "C7-VERIFY"
                                    :reason (get checked :reason)
                                    :expected :fresh-list-set-conversion-application
                                    :actual :mismatched-application})}))
            (if (sh08-pmk-entry? node call nodes (get context :ordering-bindings)
                  type-table module)
              (let [checked (sh08-pmk-check-with-forms
                              (get context :ordering-core) node call edge nodes
                              (get context :ordering-bindings) type-table
                              (get context :association-forms))]
                (if (if (= :accepted (get checked :status))
                      true (= :deferred (get checked :status)))
                  (recur (rest remaining) (rest remaining-edges) next-bindings
                    constraints diagnostics)
                  {:binding-types next-bindings :constraints constraints
                   :diagnostics
                   (conj diagnostics {:call call :rule "C7-VERIFY"
                                      :reason (get checked :reason)
                                      :expected :fresh-private-map-key-domain-application
                                      :actual :mismatched-application})}))
              (if (sh08-mkeys-entry? node call nodes (get context :ordering-bindings)
                    type-table module)
                (let [checked (sh08-mkeys-inferred-call
                                (get context :ordering-core) node call edge nodes
                                (get context :ordering-bindings) type-table)]
                  (if (= :accepted (get checked :status))
                    (recur (rest remaining) (rest remaining-edges) next-bindings
                      constraints diagnostics)
                    {:binding-types next-bindings :constraints constraints
                     :diagnostics
                     (conj diagnostics {:call call :rule "C7-VERIFY"
                                        :reason (get checked :reason)
                                        :expected :fresh-map-keys-application
                                        :actual :mismatched-application})}))
                (let [imported (sh08-im-callee edge context)
                      callee (if (map? edge)
                               (get function-types (get edge :callee-function-syntax-id)) nil)
                      args (loop [ids (get call :argument-node-ids) values []]
                             (if (= 0 (count ids)) values
                               (recur (rest ids)
                                 (conj values (get type-table (first ids)
                                                    :gravity.type/unknown)))))
                      higher-order-call? (if (= :accepted (get context :status))
                                           (= (get call :core-node-id)
                                              (get context :inner-call-core-node-id))
                                           false)
                      parameters (if higher-order-call?
                                   [{:binding-id (get context :apply-value-binding-id)
                                     :type (get context :value-type
                                                :gravity.type/unknown)}]
                                   (if (map? callee) (get callee :parameters) []))
                      arity-ok (= (count args) (count parameters))
                      intrinsic (if (sh08-ane-binding? operator-binding module) nil
                                  (sh08-io-descriptor
                                    (get context :ordering-core) node call edge nodes
                                    (sh08-ft-binding-index (get context :lookup-bindings))
                                    type-table module))]
                  (if (if (sh08-lq-binding? operator-binding module) true
                        (if (sh08-lc-binding? operator-binding module) true
                          (if (sh08-vsl-binding? operator-binding module) true
                            (if (sh08-scv-binding? operator-binding module) true
                              (if (sh08-cqs-binding? operator-binding module) true
                                (if (sh08-nq-binding? operator-binding module) true
                                  (if (sh08-sc-binding? operator-binding module) true
                                    (if (sh08-mg-binding? operator-binding module) true
                                      (if (sh08-mc-binding? operator-binding module) true
                                        (if (sh08-st-binding? operator-binding module) true
                                          (if (sh08-ane-binding? operator-binding module) true
                                            (if (sh08-chp-binding? operator-binding module) true
                                              (if (sh08-nilp-binding? operator-binding module) true
                                                (if (sh08-boolp-binding? operator-binding module) true
                                                  (if (sh08-symp-binding? operator-binding module) true
                                                    (if (sh08-listp-binding? operator-binding module) true
                                                      (if (sh08-setp-binding? operator-binding module) true
                                                        (if (sh08-mapp-binding? operator-binding module) true
                                                          (if (sh08-kp-binding? operator-binding module) true
                                                            (if (sh08-strp-binding? operator-binding module) true
                                                              (if (sh08-ip-binding? operator-binding module) true
                                                                (if (sh08-vp-binding? operator-binding module) true
                                                                  (if (sh08-nt-binding? operator-binding module) true
                                                                    (if (sh08-ae-binding? operator-binding module) true
                                                                      (if (sh08-va-binding? operator-binding module) true
                                                                        (if (sh08-si-binding? operator-binding module) true
                                                                          (if (sh08-mr-binding? operator-binding module) true
                                                                            (if (sh08-ma-binding? operator-binding module) true
                                                                              (if (sh08-cq-binding? operator-binding module) true
                                                                                (if (sh08-vn-binding? operator-binding module) true false))))))))))))))))))))))))))))))
                    (recur (rest remaining) (rest remaining-edges) next-bindings
                      constraints diagnostics)
                    (if (map? intrinsic)
                      (recur (rest remaining) (rest remaining-edges) next-bindings
                        (conj constraints (sh08-io-constraint intrinsic)) diagnostics)
                      (if (sh08-io-binding? operator-binding module)
                        (let [issue {:call call :rule "C7-TYPE-MISMATCH"
                                     :reason (if (= 2 (count args))
                                               :integral-ordering-operand-type-mismatch
                                               :integral-ordering-arity-mismatch)
                                     :expected :two-operands-of-one-established-integral-type
                                     :actual args}]
                          (if (= 2 (count args))
                            (let [left (first args) right (second args)
                                  atomic? (if (if (= left nil) true (keyword? left))
                                            (if (= right nil) true (keyword? right)) false)
                                  unresolved? (if atomic?
                                                (if (sh08-ft-unknown? left) true
                                                  (sh08-ft-unknown? right)) false)
                                  possible #{nil :gravity.type/unknown :gravity.type/never
                                             :gravity.type/integer :gravity.type/i8
                                             :gravity.type/i16 :gravity.type/i32
                                             :gravity.type/i64 :gravity.type/u8
                                             :gravity.type/u16 :gravity.type/u32
                                             :gravity.type/u64}]
                              (if (if unresolved?
                                    (if (contains? possible left)
                                      (contains? possible right) false) false)
                                (recur (rest remaining) (rest remaining-edges)
                                  next-bindings constraints (conj diagnostics issue))
                                {:binding-types next-bindings :constraints constraints
                                 :diagnostics (conj diagnostics issue)}))
                            {:binding-types next-bindings :constraints constraints
                             :diagnostics (conj diagnostics issue)}))
                        (if (map? imported)
                          (let [checked (sh08-im-call-constraint call edge args imported nodes)]
                            (recur (rest remaining) (rest remaining-edges) next-bindings
                              (conj constraints (get checked :constraint))
                              (sh08-ft-add-values-to-set
                                (get checked :diagnostics) diagnostics)))
                          (if (if (= :local-function (get edge :classification))
                                true higher-order-call?)
                            (if arity-ok
                              (let [joined
                                    (loop [ps parameters as args result next-bindings
                                           values [] index 0]
                                      (if (= 0 (count ps))
                                        {:bindings result :pairs values}
                                        (let [parameter (first ps)
                                              argument (first as)
                                              prior (get result
                                                        (get parameter :binding-id)
                                                        :gravity.type/unknown)
                                              chosen (if (if (= argument :gravity.type/never)
                                                           false (sh08-ft-known? argument))
                                                       (if (sh08-ft-known? prior) prior argument)
                                                       prior)
                                              compatible (sh08-lp-compatibility
                                                           (get context :ordering-core) call edge
                                                           callee index argument nodes
                                                           (get context :ordering-bindings))]
                                          (recur (rest ps) (rest as)
                                            (assoc result (get parameter :binding-id) chosen)
                                            (conj values
                                              (let [pair {:parameter (get parameter :binding-id)
                                                          :argument argument :chosen chosen}]
                                                (if (= :accepted (get compatible :status))
                                                  (assoc pair :compatibility
                                                    (get compatible :premise))
                                                  pair)))
                                            (+ index 1)))))]
                                (let [mismatch (sh08-ft-first-type-mismatch
                                                  (get joined :pairs))]
                                  (if (= mismatch nil)
                                    (let [constraint-id-request
                                          {:domain :gravity/sh08-function-call-constraint-v1
                                           :call-core-node-id (get call :core-node-id)
                                           :callee-function-syntax-id
                                           (get edge :callee-function-syntax-id)}
                                          base-constraint
                                          {:constraint-id-request constraint-id-request
                                           :kind :equality
                                           :lhs (get edge :callee-function-syntax-id)
                                           :rhs (get joined :pairs)
                                           :origin (get (get (get nodes
                                                                  (get call :core-node-id))
                                                             :source) :origin-chain)
                                           :profile :meta :target :jvm
                                           :status :solved :diagnostics []}
                                          constraint (if higher-order-call?
                                                       (assoc
                                                         (assoc
                                                           (assoc
                                                             (assoc base-constraint
                                                               :constraint-id-request
                                                               (assoc constraint-id-request
                                                                 :higher-order-call? true))
                                                             :kind :higher-order-function-call)
                                                           :lhs (get context :apply-callable-binding-id))
                                                         :higher-order-call? true)
                                                       (sh08-lp-call-row base-constraint))]
                                      (recur (rest remaining) (rest remaining-edges)
                                        (get joined :bindings)
                                        (conj constraints constraint) diagnostics))
                                    {:binding-types next-bindings :constraints constraints
                                     :diagnostics
                                     (conj diagnostics {:call call
                                                        :rule "C7-TYPE-MISMATCH"
                                                        :reason :call-argument-type-mismatch
                                                        :parameter-binding-id
                                                        (get mismatch :parameter)
                                                        :expected (get mismatch :chosen)
                                                        :actual (get mismatch :argument)})})))
                              {:binding-types next-bindings :constraints constraints
                               :diagnostics
                               (conj diagnostics {:call call :rule "C7-TYPE-MISMATCH"
                                                  :reason :call-arity-mismatch
                                                  :expected (count parameters)
                                                  :actual (count args)})})
                            {:binding-types next-bindings :constraints constraints
                             :diagnostics
                             (conj diagnostics {:call call :rule "C7-ANNOTATION"
                                                :reason :unsupported-nonlocal-call
                                                :expected :supported-local-first-order-call
                                                :actual (get edge :classification)})}))))))))))))))

(defn sh08-ft-call-constraints
  [calls edges nodes type-table binding-types function-types]
  (sh08-ft-call-constraints-with-context
   calls edges nodes type-table binding-types function-types {}))

(defn sh08-ij-step [node types context]
  (let [children (get node :children)]
    (if (sh08-ft-unknown? (get types (first children)))
      (let [legacy (if (if (vector? children) (= 3 (count children)) false)
                     (sh08-ft-loop-kernel-normal-join
                       [(get types (get children 1) :gravity.type/unknown)
                        (get types (get children 2) :gravity.type/unknown)]) :gravity.type/unknown)]
        (if (= legacy :gravity.type/unknown) {:status :deferred}
          {:status :deferred :type legacy}))
      (let [result (sh08-ij-derive (get context :ordering-core) node
                     (get context :lookup-nodes) types (get context :ordering-bindings)
                     (get context :association-forms))]
        result))))

(defn sh08-ft-source-join-context [context]
  (assoc context :ordering-operators (sh08-ft-index (get (get context :ordering-core) :calls) :operator-node-id)
                  :ordering-edges (sh08-ft-index (get (get context :ordering-core) :call-edges) :call-core-node-id)
                  :ordering-bindings (sh08-ft-binding-index (get context :lookup-bindings))
                  :association-forms (if (map? (get context :lookup-forms)) (get context :lookup-forms)
                                       (sh08-ft-index (get context :lookup-forms) :form-id))))

(defn sh08-ft-infer-pass-products-prepared
  [nodes lexical-bindings definitions calls edges function-types
   initial-binding-types context initial-private-products]
  (let [association? (loop [remaining calls]
                       (if (= 0 (count remaining)) false
                         (let [call (first remaining)
                               binding (get (get context :ordering-bindings) (get call :operator-binding-id))
                               module (get (get context :ordering-core) :module)]
                           (if (if (sh08-mr-binding? binding module) true
                                 (if (sh08-ma-binding? binding module) true
                                   (if (= 2 (count (get call :argument-node-ids))) (sh08-mg-binding? binding module) false)))
                             true (recur (rest remaining))))))
        demand? (if association? true (if (map? (get context :lookup-core)) true
                 (loop [groups (get context :boolean-matches)]
                   (if (= 0 (count groups)) false (if (= true (get (first groups) :structural?)) true (recur (rest groups)))))))
        call-products (get context :shape-call-products)
        prepared (if (if demand? (> (count (get call-products :calls)) 0) false)
                   (sh08-sm-call-context call-products (get context :prior-type-table {}))
                   {:status :accepted :prior-types (get context :prior-type-table {})})
        prepared (assoc prepared :source-core (get context :ordering-core))
        context (assoc context :shape-call-context prepared)
        groups (sh08-sm-groups-with-call-context (get context :boolean-matches) prepared)
        binding-shapes (sh08-sm-seed-all-shapes groups
                        (get context :prior-type-table {}) initial-binding-types function-types
                        (get context :prior-binding-shapes {}))
        match-groups (sh08-sm-groups-with-shapes groups binding-shapes)]
  (loop [remaining nodes
         type-table {}
         binding-types (sh08-bm-seed-bindings match-groups
                         (sh08-ft-node-index nodes) (get context :prior-type-table {})
                         initial-binding-types function-types edges context)
         function-result function-types
         lookup-rows [] lookup-issues (if (= :rejected (get prepared :status)) [(assoc prepared :node {})] [])
         private-products initial-private-products]
    (if (= (count remaining) 0)
      (let [node-index
            (if (map? (get context :source-node-table))
              (get context :source-node-table) (sh08-ft-node-index nodes))
            lexical-types
            (sh08-ft-bind-lexical-types
             lexical-bindings type-table binding-types)
            definition-types
            (sh08-ft-bind-definition-types
             definitions type-table lexical-types function-result)
            function-with-params
            (sh08-ft-update-param-types
             function-result definition-types)
            call-result
            (sh08-ft-call-constraints-with-context
             calls edges node-index type-table definition-types
             function-with-params context)
            loop-result (if (map? (get context :loop-core))
                          (sh08-ft-loop-type-step (assoc (get context :loop-core) :loop-member-source
                            {:forms (get context :association-forms) :bindings (get context :ordering-bindings) :nodes node-index}) type-table (get call-result :binding-types))
                          {:bindings (get call-result :binding-types) :constraints [] :issues []})]
        {:pass {:type-table type-table
         :binding-shapes binding-shapes :shape-call-context prepared
         :binding-types (get loop-result :bindings (get call-result :binding-types))
         :loop-member-products (get loop-result :member-invariants {})
         :function-types function-with-params
         :constraints (sh08-ft-add-values-to-set
                        (sh08-ft-loop-constraints (get loop-result :constraints) node-index (get (get context :loop-core) :module))
                        (sh08-ft-add-values-to-set lookup-rows (get call-result :constraints)))
         :diagnostics (sh08-ft-add-values-to-set (sh08-ft-loop-diagnostics (get loop-result :issues) node-index)
                                                (sh08-ft-add-values-to-set lookup-issues (get call-result :diagnostics)))} :products private-products})
      (let [context (assoc context :private-first-entry-products private-products)
            node (first remaining)
            conditional? (= :if (get node :core-form))
            if-result (if conditional? (sh08-ij-step node type-table context) {})
            lookup? (= :keyword-map-lookup (get node :core-form))
            association? (if (if (sh08-lq-node? node context) true (sh08-lc-node? node context)) true (if (if (if (if (if (sh08-vsl-node? node context) (sh08-vsl-node? node context) (sh08-scv-node? node context)) true (sh08-cqs-node? node context)) true (sh08-nq-node? node context)) true (sh08-sc-node? node context)) true (if (sh08-mg-node? node context) true (if (sh08-mc-node? node context) true (if (if (if (if (sh08-st-node? node context) true (if (sh08-ane-node? node context) true (if (if (sh08-chp-node? node context) true (sh08-nilp-node? node context)) true (if (sh08-boolp-node? node context) true (if (sh08-symp-node? node context) true (if (if (sh08-listp-node? node context) true (sh08-setp-node? node context)) true (if (sh08-mapp-node? node context) true (if (sh08-kp-node? node context) true (if (sh08-strp-node? node context) true (sh08-ip-node? node context)))))))))) true (sh08-vp-node? node context)) true (sh08-nt-node? node context)) true (if (sh08-ae-node? node context) true (if (sh08-va-node? node context) true (if (sh08-si-node? node context) true (if (if (sh08-mr-node? node context) true (sh08-ma-node? node context)) true (if (sh08-cq-node? node context) true (sh08-vn-node? node context)))))))))))
            lookup (if association?
                     (if (if (if (sh08-lq-node? node context) true (sh08-lc-node? node context)) true (if (if (if (if (sh08-vsl-node? node context) (sh08-vsl-node? node context) (sh08-scv-node? node context)) true (sh08-cqs-node? node context)) true (sh08-nq-node? node context)) true (sh08-sc-node? node context)))
                       (if (if (sh08-lq-node? node context) true (sh08-lc-node? node context))
                         (if (sh08-lq-node? node context)
                           (sh08-lq-step node type-table binding-types function-result context)
                           (sh08-lc-step node type-table binding-types function-result context))
                         (if (if (if (if (sh08-vsl-node? node context) (sh08-vsl-node? node context) (sh08-scv-node? node context)) true (sh08-cqs-node? node context)) true (sh08-nq-node? node context))
                           (if (if (if (sh08-vsl-node? node context) (sh08-vsl-node? node context) (sh08-scv-node? node context)) true (sh08-cqs-node? node context)) (if (if (sh08-vsl-node? node context) (sh08-vsl-node? node context) (sh08-scv-node? node context)) (if (sh08-vsl-node? node context) (sh08-vsl-step node type-table binding-types function-result context) (sh08-scv-step node type-table binding-types function-result context)) (sh08-cqs-step node type-table binding-types function-result context)) (sh08-nq-step node type-table binding-types function-result context))
                           (sh08-sc-step node type-table binding-types function-result context)))
                     (if (sh08-mg-node? node context)
                       (sh08-mg-step node type-table binding-types function-result context)
                     (if (sh08-mc-node? node context)
                       (sh08-mc-step node type-table binding-types function-result context)
                     (if (if (if (if (sh08-st-node? node context) true (if (sh08-ane-node? node context) true (if (if (sh08-chp-node? node context) true (sh08-nilp-node? node context)) true (if (sh08-boolp-node? node context) true (if (sh08-symp-node? node context) true (if (if (sh08-listp-node? node context) true (sh08-setp-node? node context)) true (if (sh08-mapp-node? node context) true (if (sh08-kp-node? node context) true (if (sh08-strp-node? node context) true (sh08-ip-node? node context)))))))))) true (sh08-vp-node? node context)) true (sh08-nt-node? node context))
                       (if (if (if (sh08-st-node? node context) true (if (sh08-ane-node? node context) true (if (if (sh08-chp-node? node context) true (sh08-nilp-node? node context)) true (if (sh08-boolp-node? node context) true (if (sh08-symp-node? node context) true (if (if (sh08-listp-node? node context) true (sh08-setp-node? node context)) true (if (sh08-mapp-node? node context) true (if (sh08-kp-node? node context) true (if (sh08-strp-node? node context) true (sh08-ip-node? node context)))))))))) true (sh08-vp-node? node context))
                         (if (if (sh08-st-node? node context) true (if (sh08-ane-node? node context) true (if (if (sh08-chp-node? node context) true (sh08-nilp-node? node context)) true (if (sh08-boolp-node? node context) true (if (sh08-symp-node? node context) true (if (if (sh08-listp-node? node context) true (sh08-setp-node? node context)) true (if (sh08-mapp-node? node context) true (if (sh08-kp-node? node context) true (if (sh08-strp-node? node context) true (sh08-ip-node? node context))))))))))
                           (if (sh08-st-node? node context)
                             (sh08-st-step node type-table binding-types function-result context)
                             (if (sh08-ane-node? node context) (sh08-ane-step node type-table binding-types function-result context) (if (if (sh08-chp-node? node context) true (sh08-nilp-node? node context)) (if (sh08-chp-node? node context) (sh08-chp-step node type-table binding-types function-result context) (sh08-nilp-step node type-table binding-types function-result context)) (if (sh08-boolp-node? node context) (sh08-boolp-step node type-table binding-types function-result context) (if (sh08-symp-node? node context) (sh08-symp-step node type-table binding-types function-result context) (if (if (sh08-listp-node? node context) true (sh08-setp-node? node context)) (if (sh08-listp-node? node context) (sh08-listp-step node type-table binding-types function-result context) (sh08-setp-step node type-table binding-types function-result context)) (if (sh08-mapp-node? node context) (sh08-mapp-step node type-table binding-types function-result context) (if (sh08-kp-node? node context) (sh08-kp-step node type-table binding-types function-result context) (if (sh08-strp-node? node context) (sh08-strp-step node type-table binding-types function-result context) (sh08-ip-step node type-table binding-types function-result context))))))))))
                           (sh08-vp-step node type-table binding-types function-result context))
                         (sh08-nt-step node type-table binding-types function-result context))
                     (if (sh08-ae-node? node context)
                       (sh08-ae-step node type-table binding-types function-result context)
                     (if (sh08-va-node? node context)
                       (sh08-va-step node type-table binding-types function-result context)
                     (if (sh08-si-node? node context)
                       (sh08-si-step node type-table binding-types function-result context)
                     (if (sh08-vn-node? node context)
                       (sh08-vn-step node type-table binding-types function-result context)
                     (if (sh08-cq-node? node context)
                       (sh08-cq-step node type-table binding-types function-result context)
                       (if (sh08-mr-node? node context)
                         (sh08-mr-step node type-table binding-types function-result context)
                         (sh08-ma-step node type-table binding-types function-result context)))))))))))
                     (if lookup?
                     (sh08-kl-step node type-table binding-types function-result context) {}))
            node-type
            (if conditional?
              (if (= :accepted (get if-result :status)) (get if-result :type)
                (if (= :deferred (get if-result :status)) (get if-result :type :gravity.type/unknown)
                (if (= :rejected (get if-result :status)) :gravity.type/unknown
                  (if (= :gravity.type/never (get type-table (first (get node :children)))) :gravity.type/never
                    (sh08-ft-infer-node-with-context node type-table binding-types function-result edges context)))))
            (if (if lookup? true association?) (get lookup :type :gravity.type/unknown)
              (sh08-ft-infer-node-with-context
               node type-table binding-types function-result edges context)))
            ; Cold VALUE evidence cannot borrow a declared call result while
            ; one of its evaluated operands is still independently unresolved.
            ; The mode is semantic cold-value inference, not a work allowance.
            node-type (if (if (= true (get context :cold-value-inference))
                              (= false (contains? #{:fn :quote} (get node :core-form))) false)
                        (if (= node-type :gravity.type/never) node-type
                          (if (loop [children (get node :children)]
                                (if (= 0 (count children)) true
                                  (if (sh08-ft-known?
                                        (if (if association? (if (= :accepted (get lookup :status))
                                                              (= (first children) (first (get node :children))) false) false)
                                          (get lookup :descriptor) (get type-table (first children))))
                                    (recur (rest children)) false))) node-type :gravity.type/unknown)) node-type)
            ; Only this already-derived normal v2 access may advance its exact
            ; immutable initializer bindings.
            lexical-now? (if (= :accepted (get lookup :status))
                           (if (contains? #{:gravity.type/applied-vector-nth :gravity.type/applied-vector-get}
                                 (get (get lookup :descriptor) :kind))
                             (if (= :sh08-bounded-unit-step-v2
                                   (get (get (get (get (get lookup :descriptor) :bounds-proof) :loop-invariant) :range-proof) :version))
                               (if (sh08-ft-known? node-type) (= false (= :gravity.type/never node-type)) false) false) false) false)
            next-binding-types
            (if lexical-now?
              (let [selected (loop [records lexical-bindings out []]
                               (if (= 0 (count records)) out
                                 (let [record (first records)]
                                   (recur (rest records)
                                     (if (if (= :immutable (get record :mutability))
                                           (= (get node :node-id) (get record :initializer-node-id)) false)
                                       (conj out record) out)))))]
                (sh08-ft-bind-lexical-types selected {(get node :node-id) node-type} binding-types))
              binding-types)]
        (recur
         (rest remaining)
         (let [table (assoc type-table (get node :node-id) node-type)]
           (if (if association? (= :accepted (get lookup :status)) false)
             (assoc table (first (get node :children)) (get lookup :descriptor)) table))
         next-binding-types
                    (if (= (get (get node :core-form) :none) :none)
           function-result
           function-result)
         (if (= :accepted (get if-result :status)) (conj lookup-rows (sh08-ij-row (get if-result :premise)))
           (if (= :accepted (get lookup :status)) (conj lookup-rows (get lookup :constraint)) lookup-rows))
         (if (if (if lookup? true association?) (= :rejected (get lookup :status)) false)
           (conj lookup-issues (assoc lookup :node node))
           (if (= :rejected (get if-result :status))
             (conj lookup-issues (assoc if-result :node node
               :rule "C7-VERIFY"
               :expected :source-bound-independent-list-if-join :actual (get node :node-id))) lookup-issues))
         (if (if (= :accepted (get lookup :status)) (map? (get lookup :local-private-product)) false)
           (assoc private-products (get node :node-id) (get lookup :local-private-product)) private-products)))))))

(defn sh08-ft-infer-pass-products
  [nodes lexical-bindings definitions calls edges function-types
   initial-binding-types context initial-private-products]
  (sh08-ft-infer-pass-products-prepared
    nodes lexical-bindings definitions calls edges function-types
    initial-binding-types (sh08-ft-source-join-context context) initial-private-products))

(defn sh08-ft-infer-pass-with-context
  [nodes lexical-bindings definitions calls edges function-types initial-binding-types context]
  ; Standalone entry starts with local DATA empty, regardless of caller context.
  (get (sh08-ft-infer-pass-products nodes lexical-bindings definitions calls edges
         function-types initial-binding-types context {}) :pass))

(defn sh08-ft-infer-pass
  [nodes lexical-bindings definitions calls edges function-types
   initial-binding-types]
  (sh08-ft-infer-pass-with-context
   nodes lexical-bindings definitions calls edges function-types
   initial-binding-types {}))

(defn sh08-lr-declaration? [declaration bindings]
  (if (map? declaration)
    (let [constructor (get bindings (get declaration :type-binding-id))
          member (get bindings (get declaration :element-binding-id))]
      (sh08-ft-all-true?
        [(symbol? (get declaration :constructor-reference-symbol)) (symbol? (get declaration :element-reference-symbol))
         (= #{:rule-version :source-child-index :marker-form-id :marker-syntax-id :type-form-id :type-syntax-id
               :type-symbol :type-binding-id :type-id :constructor-form-id :constructor-syntax-id
               :element-form-id :element-syntax-id :element-symbol :element-binding-id
               :constructor-reference-symbol :element-reference-symbol} (set (keys declaration)))
         (= :sh07-list-return-declaration-v1 (get declaration :rule-version))
         (= ['List :core :type 'gravity.core] [(get constructor :name) (get constructor :binding-class)
                                             (get constructor :kind) (get constructor :namespace)])
         (= [:core :type 'gravity.core] [(get member :binding-class) (get member :kind) (get member :namespace)])
         (= ['List (get member :name)] [(get declaration :type-symbol) (get declaration :element-symbol)])
         (sh08-hl-type? (get declaration :type-id))
         (= (get (get declaration :type-id) :element-type) (sh08-ft-atomic-type-id (get member :name)))
         (if (integer? (get declaration :source-child-index)) (>= (get declaration :source-child-index) 0) false)
         (sh08-sha256-id-vector? [(get declaration :marker-form-id) (get declaration :marker-syntax-id)
           (get declaration :type-form-id) (get declaration :type-syntax-id) (get declaration :type-binding-id)
           (get declaration :constructor-form-id) (get declaration :constructor-syntax-id)
           (get declaration :element-form-id) (get declaration :element-syntax-id) (get declaration :element-binding-id)])])) false))

(defn sh08-lr-source [form]
  {:form-id (get form :form-id) :syntax-id (get form :syntax-id) :semantic-span (get form :source-span)
   :origin-chain (get form :origin-chain) :generated-origin (get form :generated-origin)})

(defn sh08-lr-validate-types [declared actual]
  (let [declaration (sh08-lc-validate-types [declared])]
    (if (= :accepted (get declaration :status))
      (if (sh08-hl-type? declared)
        (let [validation (sh08-lc-validate-types [actual])]
          (if (= :accepted (get validation :status))
            (let [members (if (map? actual) (get actual :element-types) nil)
                  finite? (if (map? actual) (= [:gravity.type/list :literal] [(get actual :kind) (get actual :shape)]) false)
                  relation (if (= actual :gravity.type/never) :non-returning-bottom
                             (if (= actual declared) :homogeneous-list-identity
                               (if finite?
                                 (if (loop [remaining members]
                                       (if (= 0 (count remaining)) true
                                         (if (= (first remaining) (get declared :element-type))
                                           (recur (rest remaining)) false))) :all-positional-elements-match nil) nil)))]
              (if (= relation nil)
                {:status :rejected :reason :homogeneous-list-return-incompatible}
                {:status :accepted :relation relation
                 :checked-member-count (if finite? (count members) nil)}))
            {:status :rejected :reason :homogeneous-list-return-incompatible
             :type-check-reason (get validation :reason)}))
        {:status :rejected :reason :list-return-declaration-required})
      {:status :rejected :reason :list-return-declaration-required})))

(defn sh08-lr-derive [core record function nodes types bindings forms]
  (let [signature (get record :signature) declaration (get signature :return)
        declared (get declaration :type-id) body-id (get record :body-core-node-id)
        actual (get types body-id :gravity.type/unknown)]
      (let [validation (sh08-lr-validate-types declared actual)]
        (if (= :accepted (get validation :status))
          (let [fn-node (get nodes (get record :function-core-node-id)) body (get nodes body-id)
                fn-form (get forms (get (get fn-node :source) :form-id))
                body-form (get forms (get (get body :source) :form-id))
                ids (get fn-form :child-form-ids) parameter-form (get forms (get ids 1))
                marker (get forms (get declaration :marker-form-id)) application (get forms (get declaration :type-form-id))
                constructor (get forms (get declaration :constructor-form-id)) member (get forms (get declaration :element-form-id))
                type-binding (get bindings (get declaration :type-binding-id))
                element-binding (get bindings (get declaration :element-binding-id))
                definition-binding (get bindings (get record :definition-binding-id))]
            (if (sh08-ft-all-true?
                  [(sh08-lr-declaration? declaration bindings)
                   (= :fn (get fn-node :core-form)) (= [body-id] (get fn-node :children))
                   (= :list (get fn-form :kind)) (vector? ids) (= 5 (if (vector? ids) (count ids) 0))
                   (= (get record :function-syntax-id) (get function :function-id) (get (get fn-node :source) :syntax-id))
                   (= (get record :function-core-node-id) (get function :function-core-node-id))
                   (= body-id (get function :body-core-node-id) (get body :node-id))
                   (= (get record :function-form-id) (get fn-form :form-id))
                   (= signature (get function :signature) (get (get fn-node :attributes) :signature))
                   (= declared (get function :return))
                   (= [2 4] [(get declaration :source-child-index) (get signature :body-source-child-index)])
                   (= [(get marker :form-id) (get application :form-id) (get body-form :form-id)]
                      [(get ids 2) (get ids 3) (get ids 4)])
                   (= [(get marker :kind) (get marker :value)] [:keyword ':-])
                   (= (get marker :syntax-id) (get declaration :marker-syntax-id))
                   (= :list (get application :kind))
                   (= [(get constructor :form-id) (get member :form-id)] (get application :child-form-ids))
                   (= (get application :syntax-id) (get declaration :type-syntax-id))
                   (= (get constructor :syntax-id) (get declaration :constructor-syntax-id))
                   (= (get member :syntax-id) (get declaration :element-syntax-id))
                   (= (get fn-form :form-id) (get marker :parent-form-id) (get application :parent-form-id) (get body-form :parent-form-id))
                   (= (get application :form-id) (get constructor :parent-form-id) (get member :parent-form-id))
                   (= (get application :scope-id) (get constructor :scope-id) (get member :scope-id) (get parameter-form :scope-id))
                   (= :symbol (get constructor :kind) (get member :kind))
                   (= [(get constructor :value) (get member :value)]
                      [(get declaration :constructor-reference-symbol) (get declaration :element-reference-symbol)])
                   (= (get fn-node :source) (sh08-lr-source fn-form))
                   (= (get body :source) (sh08-lr-source body-form))
                   (= (get record :definition-binding-id) (get definition-binding :binding-id))
                   (= (get record :definition-name) (get definition-binding :name))])
              {:status :accepted
               :premise {:version :sh08-homogeneous-list-return-v2 :relation (get validation :relation)
                         :function-id (get function :function-id) :function-core-node-id (get record :function-core-node-id)
                         :body-core-node-id body-id :actual-body-type actual :declared-return-type declared
                         :declaration declaration :function-record record :definition-binding definition-binding
                         :type-binding type-binding :element-binding element-binding
                         :function-source (get fn-node :source) :body-source (get body :source)
                         :return-source (sh08-lr-source application) :constructor-source (sh08-lr-source constructor)
                         :element-source (sh08-lr-source member)
                         :checked-element-type (get declared :element-type) :checked-element-count (get validation :checked-member-count)
                         :normal-completion? (= false (= actual :gravity.type/never))
                         :forgets (if (= :all-positional-elements-match (get validation :relation)) [:static-length] [])
                         :preserves [:value :actual-body-type :provenance :schema :ownership :linearity :regions :effects :allocation-obligations]
                         :profile (get (get core :module) :profile) :target (get (get core :module) :target)}}
              {:status :rejected :reason :list-return-source-mismatch}))
          validation))))

(defn sh08-lr-row [premise]
  {:constraint-id-request {:domain :gravity/sh08-homogeneous-list-return-constraint-v2 :return-compatibility premise}
   :kind :return-compatibility :producer-rule :sh08-homogeneous-list-return-v2
   :lhs {:function-id (get premise :function-id) :body-core-node-id (get premise :body-core-node-id) :role :return}
   :rhs {:actual-body-type (get premise :actual-body-type) :declared-return-type (get premise :declared-return-type)}
   :dependencies premise
   :solution {:return-type (get premise :declared-return-type) :actual-body-type (get premise :actual-body-type)
              :normal-completion? (get premise :normal-completion?)}
   :invalidation [:function-records :function-signature :body-core-node :body-type :return-declaration :source-forms
                  :type-bindings :definition-binding :profile :target]
   :profile (get premise :profile) :target (get premise :target) :status :solved :diagnostics []})

(defn sh08-ft-update-function-returns
  [function-types nodes type-table]
  (loop [remaining (keys function-types) result function-types]
    (if (= (count remaining) 0)
      result
      (let [function-id (first remaining)
            function (get result function-id)
            body-id (get function :body-core-node-id)
            body-type (get type-table body-id :gravity.type/unknown)
            prior-type (get function :return :gravity.type/unknown)
            conflict
            (if (sh08-ft-known? prior-type)
              (if (sh08-ft-known? body-type)
                (if (if (= body-type :gravity.type/never) true (= prior-type body-type))
                  nil
                  {:function-id function-id
                   :body-core-node-id body-id
                   :expected prior-type
                   :actual body-type})
                nil)
              nil)
            next-type
            (if (sh08-ft-known? prior-type)
              prior-type
              body-type)]
        (recur
         (rest remaining)
         (assoc result function-id
                (assoc
                 (assoc function :return next-type)
                 :return-conflict conflict)))))))

(defn sh08-ft-update-function-returns-with-context [functions nodes types context]
  (let [updated (sh08-ft-update-function-returns functions nodes types)
        active? (loop [ids (keys functions)]
                  (if (= 0 (count ids)) false
                    (if (= :sh07-list-return-declaration-v1 (get (get (get (get functions (first ids)) :signature) :return) :rule-version))
                      true (recur (rest ids)))))]
    (if (= false active?) {:status :accepted :function-types updated :constraints [] :diagnostics []}
      (let [core (get context :ordering-core) source-forms (get context :lookup-forms)
            source-bindings (get context :lookup-bindings)
            forms (if (map? source-forms) source-forms (sh08-ft-index source-forms :form-id))
            bindings (if (map? source-bindings) source-bindings (sh08-ft-binding-index source-bindings))]
        (loop [remaining (get core :function-records) out updated rows []]
          (if (= 0 (count remaining))
            {:status :accepted :function-types out :constraints rows :diagnostics []}
            (let [record (first remaining) id (get record :function-syntax-id) function (get out id)
                  declaration (get (get function :signature) :return)]
              (if (= :sh07-list-return-declaration-v1 (get declaration :rule-version))
                (let [body-id (get function :body-core-node-id) actual (get types body-id :gravity.type/unknown)
                      checked (if (sh08-ft-unknown? actual)
                                {:status :deferred}
                                (sh08-lr-derive core record function nodes types bindings forms))
                      premise (get checked :premise)]
                  (if (contains? #{:accepted :deferred :homogeneous-list-return-incompatible}
                        (if (= :rejected (get checked :status)) (get checked :reason) (get checked :status)))
                    (recur (rest remaining)
                      (assoc out id (assoc function :return-actual-type actual :return-compatibility premise
                        :return-conflict (if (= :homogeneous-list-return-incompatible (get checked :reason))
                                           {:function-id id :body-core-node-id body-id :expected (get declaration :type-id) :actual actual} nil)))
                      (if (= :accepted (get checked :status)) (conj rows (sh08-lr-row premise)) rows))
                    {:status :rejected :function-types out :constraints rows
                     :diagnostics [{:node (get nodes body-id) :rule "C7-VERIFY"
                                    :reason (get checked :reason) :expected :authenticated-homogeneous-list-return :actual actual}]}))
                (recur (rest remaining) out rows)))))))))

(defn sh08-ft-first-return-conflict [function-types node-table]
  (loop [remaining (keys function-types)]
    (if (= (count remaining) 0)
      nil
      (let [function (get function-types (first remaining))
            conflict (get function :return-conflict)]
        (if (= conflict nil)
          (recur (rest remaining))
          (assoc conflict
                 :node
                 (get node-table (get conflict :body-core-node-id))))))))

(defn sh08-ft-infer-acyclic-with-context
  [node-sequence node-table lexical-bindings definitions calls edges
   function-types binding-types context]
  (loop [
         current-functions function-types
         current-bindings binding-types
         current-types {}
         current-shapes {}
         current-private-products {}
         current-loop-products {}
         source-context nil]
    (let [source-context (if (= source-context nil) (sh08-ft-source-join-context context) source-context)
            local-pass
            (sh08-ft-infer-pass-products-prepared
             node-sequence lexical-bindings definitions calls edges
             current-functions current-bindings
             (assoc source-context :prior-type-table current-types :prior-binding-shapes current-shapes)
             current-private-products)
            raw-pass (get local-pass :pass)
            next-bindings (get raw-pass :binding-types)
            returns (sh08-ft-update-function-returns-with-context
                      (sh08-ft-update-param-types (get raw-pass :function-types) next-bindings)
                      node-table (get raw-pass :type-table) context)
            pass (assoc raw-pass
                   :constraints (sh08-ft-add-values-to-set (get returns :constraints) (get raw-pass :constraints))
                   :diagnostics (sh08-ft-add-values-to-set (get returns :diagnostics) (get raw-pass :diagnostics)))
            next-functions (get returns :function-types (get raw-pass :function-types))
            return-conflict (if (= :rejected (get returns :status)) nil
                              (sh08-ft-first-return-conflict next-functions node-table))
            stable? (if (= next-functions current-functions)
                      (if (= next-bindings current-bindings)
                        (if (= current-types (get pass :type-table))
                          (if (= current-shapes (get pass :binding-shapes))
                            (= current-loop-products (get pass :loop-member-products)) false) false) false) false)]
      (if (= :rejected (get returns :status))
        (assoc pass :function-types next-functions :binding-types next-bindings :convergence-status :type-conflict)
        (if (map? return-conflict)
          (assoc pass :function-types next-functions :binding-types next-bindings :convergence-status :type-conflict
            :diagnostics (conj (get pass :diagnostics)
              {:node (get return-conflict :node) :rule "C7-TYPE-MISMATCH"
               :reason :function-result-type-mismatch :expected (get return-conflict :expected)
               :actual (get return-conflict :actual)}))
          (if stable?
            (assoc pass :function-types next-functions :binding-types next-bindings :convergence-status :converged)
            (recur next-functions next-bindings (get pass :type-table) (get pass :binding-shapes)
              (get local-pass :products) (get pass :loop-member-products) source-context)))))))

(defn sh08-ft-infer-acyclic
  [node-sequence node-table lexical-bindings definitions calls edges
   function-types binding-types]
  (sh08-ft-infer-acyclic-with-context
   node-sequence node-table lexical-bindings definitions calls edges
   function-types binding-types {}))

(defn sh08-ft-first-unknown-node [nodes type-table]
  (if (= (count nodes) 0)
    nil
    (let [node (first nodes)
          node-type
          (get type-table (get node :node-id) :gravity.type/unknown)]
      (if (sh08-ft-known? node-type)
        (sh08-ft-first-unknown-node (rest nodes) type-table)
        node))))

(defn sh08-ft-function-facts
  [function-types nodes module]
  (loop [remaining (keys function-types) values []]
    (if (= (count remaining) 0)
      values
      (let [function (get function-types (first remaining))
            node (get nodes (get function :function-core-node-id))]
        (recur
         (rest remaining)
         (conj values
               (assoc function
                      :source-span (get (get node :source) :semantic-span)
                      :syntax-id (get (get node :source) :syntax-id)
                      :origin-chain (get (get node :source) :origin-chain)
                      :generated-origin
                      (get (get node :source) :generated-origin)
                      :profile (get module :profile)
                      :target (get module :target))))))))

(defn sh08-ft-local-facts
  [lexical-bindings type-table binding-types nodes module]
  (loop [remaining lexical-bindings values []]
    (if (= (count remaining) 0)
      values
      (let [record (first remaining)
            node (get nodes (get record :initializer-node-id))]
        (recur
         (rest remaining)
         (conj values
               {:artifact :gravity/c7-local-binding-fact
                :fact-id-request
                {:domain :gravity/sh08-local-binding-fact-v1
                 :binding-id (get record :binding-id)
                 :initializer-node-id
                 (get record :initializer-node-id)
                 :type
                 (get binding-types (get record :binding-id)
                      :gravity.type/unknown)
                 :profile (get module :profile)
                 :target (get module :target)}
                :binding-id (get record :binding-id)
                :name (get record :name)
                :type
                (get binding-types (get record :binding-id)
                     :gravity.type/unknown)
                :initializer-node-id (get record :initializer-node-id)
                :let-core-node-id (get record :let-core-node-id)
                :source-span (get (get node :source) :semantic-span)
                :syntax-id (get (get node :source) :syntax-id)
                :origin-chain (get (get node :source) :origin-chain)
                :generated-origin
                (get (get node :source) :generated-origin)
                :profile (get module :profile)
                :target (get module :target)
                :effects (get module :effects)
                :capabilities (get module :capabilities)
                :status :inferred}))))))

(defn sh08-ft-call-facts-with-context
  [calls edges nodes type-table function-types module context]
  (loop [remaining calls
         remaining-edges edges
         values []]
    (if (= (count remaining) 0)
      values
      (let [call (first remaining)
            edge (first remaining-edges)
            node (get nodes (get call :core-node-id))
            imported (sh08-im-callee edge context)
            intrinsic (get type-table (get call :operator-node-id))
            callee
            (if (map? imported) (get imported :function-type)
              (get function-types (get edge :callee-function-syntax-id)))
            higher-order-call?
            (if (= :accepted (get context :status))
              (= (get call :core-node-id)
                 (get context :inner-call-core-node-id))
              false)
            higher-order-outer-call?
            (if (= :accepted (get context :status))
              (= (get call :core-node-id)
                 (get context :outer-call-core-node-id))
              false)
            result-type
            (if (= :gravity.type/never (get type-table (get call :core-node-id))) :gravity.type/never
            (if higher-order-call?
              (get context :value-type :gravity.type/unknown)
              (if (map? callee)
                (get callee :return)
                :gravity.type/unknown)))
            argument-types
            (loop [ids (get call :argument-node-ids) result []]
              (if (= (count ids) 0)
                result
                (recur
                 (rest ids)
                 (conj result
                       (get type-table (first ids)
                            :gravity.type/unknown)))))
            base-fact
            {:artifact :gravity/c7-call-type-fact
             :fact-id-request
             {:domain :gravity/sh08-call-type-fact-v1
              :call-core-node-id (get call :core-node-id)
              :callee-function-syntax-id
              (get edge :callee-function-syntax-id)
              :argument-types argument-types
              :result-type result-type}
             :call-core-node-id (get call :core-node-id)
             :caller-function-syntax-id
             (get edge :caller-function-syntax-id)
             :callee-function-syntax-id
             (get edge :callee-function-syntax-id)
             :argument-types argument-types
             :result-type result-type
             :evaluation-order (get call :evaluation-order)
             :source-span (get (get node :source) :semantic-span)
             :syntax-id (get (get node :source) :syntax-id)
             :origin-chain (get (get node :source) :origin-chain)
             :generated-origin
             (get (get node :source) :generated-origin)
             :profile (get module :profile)
             :target (get module :target)
             :effects (get module :effects)
             :capabilities (get module :capabilities)
             :status :inferred}
            call-fact
            (if higher-order-call?
              (assoc
               (assoc
                (assoc
                 (assoc
                  (assoc
                   (assoc base-fact
                          :fact-id-request
                          (assoc (get base-fact :fact-id-request)
                                 :higher-order-call? true))
                   :callable-parameter-binding-id
                   (get context :apply-callable-binding-id))
                  :dispatch :indirect-function-value)
                 :higher-order-call? true)
                :selected-identity-function-syntax-id
                (get context :identity-function-syntax-id))
               :b47-edge
               (sh08-ft-higher-order-edge-projection edge))
              (if higher-order-outer-call?
                (assoc
                 (assoc
                  (assoc base-fact
                         :dispatch :direct-local-function)
                  :selected-apply-function-syntax-id
                  (get context :apply-function-syntax-id))
                 :b47-edge
                 (sh08-ft-higher-order-edge-projection edge))
                base-fact))]
        (recur
         (rest remaining)
         (rest remaining-edges)
         (conj values (if (contains? #{:gravity.type/applied-string-concat :gravity.type/applied-nonnegative-integer-quotient :gravity.type/applied-vector-slice :gravity.type/applied-string-character-vector :gravity.type/applied-count-quotient-scaling :gravity.type/applied-list-construction :gravity.type/applied-list-query :gravity.type/applied-vector-first :gravity.type/applied-vector-empty :gravity.type/applied-vector-rest :gravity.type/applied-map-keys :gravity.type/applied-private-map-keys} (get intrinsic :kind))
                       (if (contains? #{:gravity.type/applied-list-construction :gravity.type/applied-list-query :gravity.type/applied-vector-first :gravity.type/applied-vector-empty :gravity.type/applied-vector-rest :gravity.type/applied-map-keys :gravity.type/applied-private-map-keys} (get intrinsic :kind))
                         (if (contains? #{:gravity.type/applied-list-query :gravity.type/applied-vector-first :gravity.type/applied-vector-empty :gravity.type/applied-vector-rest :gravity.type/applied-map-keys :gravity.type/applied-private-map-keys} (get intrinsic :kind))
                           (sh08-lq-call-fact intrinsic module) (sh08-lc-call-fact intrinsic module)) (if (contains? #{:gravity.type/applied-nonnegative-integer-quotient :gravity.type/applied-vector-slice :gravity.type/applied-string-character-vector :gravity.type/applied-count-quotient-scaling} (get intrinsic :kind))
                           (if (if (if (= :gravity.type/applied-vector-slice (get intrinsic :kind)) true (= :gravity.type/applied-string-character-vector (get intrinsic :kind))) true (= :gravity.type/applied-count-quotient-scaling (get intrinsic :kind))) (if (if (= :gravity.type/applied-vector-slice (get intrinsic :kind)) true (= :gravity.type/applied-string-character-vector (get intrinsic :kind))) (if (= :gravity.type/applied-vector-slice (get intrinsic :kind)) (sh08-vsl-call-fact intrinsic module) (sh08-scv-call-fact intrinsic module)) (sh08-cqs-call-fact intrinsic module)) (sh08-nq-call-fact intrinsic module)) (sh08-sc-call-fact intrinsic module)))
                       (if (= :gravity.type/applied-map-get (get intrinsic :kind))
                       (sh08-mg-call-fact intrinsic module)
                       (if (contains? #{:gravity.type/applied-map-contains :gravity.type/applied-keyword-set-contains :gravity.type/applied-character-set-contains :gravity.type/applied-string-set-contains :gravity.type/applied-symbol-set-contains :gravity.type/applied-integer-set-contains} (get intrinsic :kind))
                       (if (contains? #{:gravity.type/applied-keyword-set-contains :gravity.type/applied-character-set-contains :gravity.type/applied-string-set-contains :gravity.type/applied-symbol-set-contains :gravity.type/applied-integer-set-contains} (get intrinsic :kind))
                         (sh08-ksm-call-fact intrinsic module) (sh08-mc-call-fact intrinsic module))
                       (if (contains? #{:gravity.type/applied-not :gravity.type/applied-vector-predicate :gravity.type/applied-integer-predicate :gravity.type/applied-set-conversion :gravity.type/applied-list-set-conversion :gravity.type/applied-map-predicate  :gravity.type/applied-keyword-predicate :gravity.type/applied-string-predicate :gravity.type/applied-set-predicate :gravity.type/applied-list-predicate :gravity.type/applied-symbol-predicate :gravity.type/applied-boolean-predicate :gravity.type/applied-nil-predicate :gravity.type/applied-character-predicate :gravity.type/applied-atomic-inequality} (get intrinsic :kind))
                       (if (contains? #{:gravity.type/applied-vector-predicate :gravity.type/applied-integer-predicate :gravity.type/applied-set-conversion :gravity.type/applied-list-set-conversion :gravity.type/applied-map-predicate  :gravity.type/applied-keyword-predicate :gravity.type/applied-string-predicate :gravity.type/applied-set-predicate :gravity.type/applied-list-predicate :gravity.type/applied-symbol-predicate :gravity.type/applied-boolean-predicate :gravity.type/applied-nil-predicate :gravity.type/applied-character-predicate :gravity.type/applied-atomic-inequality} (get intrinsic :kind))
                         (if (contains? #{:gravity.type/applied-integer-predicate :gravity.type/applied-set-conversion :gravity.type/applied-list-set-conversion :gravity.type/applied-map-predicate  :gravity.type/applied-keyword-predicate :gravity.type/applied-string-predicate :gravity.type/applied-set-predicate :gravity.type/applied-list-predicate :gravity.type/applied-symbol-predicate :gravity.type/applied-boolean-predicate :gravity.type/applied-nil-predicate :gravity.type/applied-character-predicate :gravity.type/applied-atomic-inequality} (get intrinsic :kind))
                           (if (contains? #{:gravity.type/applied-set-conversion :gravity.type/applied-list-set-conversion} (get intrinsic :kind))
                             (sh08-st-call-fact intrinsic module) (if (= :gravity.type/applied-atomic-inequality (get intrinsic :kind)) (sh08-ane-call-fact intrinsic module) (if (contains? #{:gravity.type/applied-nil-predicate :gravity.type/applied-character-predicate} (get intrinsic :kind)) (if (= :gravity.type/applied-character-predicate (get intrinsic :kind)) (sh08-chp-call-fact intrinsic module) (sh08-nilp-call-fact intrinsic module)) (if (= :gravity.type/applied-boolean-predicate (get intrinsic :kind)) (sh08-boolp-call-fact intrinsic module) (if (= :gravity.type/applied-symbol-predicate (get intrinsic :kind)) (sh08-symp-call-fact intrinsic module) (if (contains? #{:gravity.type/applied-set-predicate :gravity.type/applied-list-predicate} (get intrinsic :kind)) (if (= :gravity.type/applied-list-predicate (get intrinsic :kind)) (sh08-listp-call-fact intrinsic module) (sh08-setp-call-fact intrinsic module)) (if (= :gravity.type/applied-map-predicate (get intrinsic :kind)) (sh08-mapp-call-fact intrinsic module) (if (= :gravity.type/applied-keyword-predicate (get intrinsic :kind)) (sh08-kp-call-fact intrinsic module) (if (= :gravity.type/applied-string-predicate (get intrinsic :kind)) (sh08-strp-call-fact intrinsic module) (sh08-ip-call-fact intrinsic module)))))))))) (sh08-vp-call-fact intrinsic module)) (sh08-nt-call-fact intrinsic module))
                       (if (contains? #{:gravity.type/applied-atomic-equality :gravity.type/applied-vector-equality :gravity.type/applied-list-equality :gravity.type/applied-integral-equality :gravity.type/applied-keyword-set-equality :gravity.type/applied-bare-keyword-anchor-set-equality :gravity.type/applied-string-set-equality } (get intrinsic :kind))
                       (if (contains? #{:gravity.type/applied-vector-equality :gravity.type/applied-list-equality :gravity.type/applied-keyword-set-equality :gravity.type/applied-bare-keyword-anchor-set-equality :gravity.type/applied-string-set-equality} (get intrinsic :kind))
                         (if (contains? #{:gravity.type/applied-keyword-set-equality :gravity.type/applied-bare-keyword-anchor-set-equality :gravity.type/applied-string-set-equality} (get intrinsic :kind))
                         (sh08-kse-call-fact intrinsic module) (if (= :gravity.type/applied-list-equality (get intrinsic :kind))
                           (sh08-le-call-fact intrinsic module) (sh08-ve-call-fact intrinsic module)))
                         (if (= :gravity.type/applied-integral-equality (get intrinsic :kind))
                           (sh08-ie-call-fact intrinsic module) (sh08-ae-call-fact intrinsic module)))
                       (if (contains? #{:gravity.type/applied-vector-append :gravity.type/applied-list-prepend :gravity.type/applied-string-set-insertion :gravity.type/applied-keyword-set-insertion :gravity.type/applied-symbol-set-insertion} (get intrinsic :kind))
                       (if (contains? #{:gravity.type/applied-list-prepend :gravity.type/applied-string-set-insertion :gravity.type/applied-keyword-set-insertion :gravity.type/applied-symbol-set-insertion} (get intrinsic :kind))
                         (sh08-pl-call-fact intrinsic module) (sh08-va-call-fact intrinsic module))
                       (if (contains? #{:gravity.type/applied-bounded-successor :gravity.type/applied-bounded-unit-addition} (get intrinsic :kind))
                       (sh08-si-call-fact intrinsic module)
                       (if (contains? #{:gravity.type/applied-vector-nth :gravity.type/applied-vector-get} (get intrinsic :kind))
                       (sh08-vn-call-fact intrinsic module)
                       (if (= :gravity.type/applied-collection-count (get intrinsic :kind))
                       (sh08-cq-call-fact intrinsic module)
                       (if (contains? #{:gravity.type/applied-map-association :gravity.type/applied-map-removal} (get intrinsic :kind))
                       (if (= :gravity.type/applied-map-removal (get intrinsic :kind))
                         (sh08-mr-call-fact intrinsic module) (sh08-ma-call-fact intrinsic module))
                       (if (= :gravity.type/applied-integral-ordering (get intrinsic :kind))
                       (sh08-io-call-fact intrinsic module)
                       (if (map? imported)
                        (assoc call-fact :dispatch :direct-imported-function
                               :fact-id-request (assoc (get call-fact :fact-id-request) :imported-function (sh08-im-reference imported)
                                                        :effect-status :pending-sh09-imported-body :legality-status :pending-imported-effects)
                               :imported-function (sh08-im-reference imported) :effect-status :pending-sh09-imported-body
                               :effects (get (get imported :function-type) :latent-effects)
                               :capabilities (get (get imported :function-type) :capabilities)
                               :effect-facts-source :callee-module-declarations
                               :legality-status :pending-imported-effects)
                        call-fact))))))))))))))))))

(defn sh08-ft-call-facts
  [calls edges nodes type-table function-types module]
  (sh08-ft-call-facts-with-context
   calls edges nodes type-table function-types module {}))

(defn sh08-ft-first-recursive-component [components]
  (if (= (count components) 0)
    nil
    (first components)))

(defn sh08-ft-higher-order-result-fields [result proof]
  (if (= :accepted (get proof :status))
    (assoc
     (assoc result
            :higher-order-proof
            (sh08-ft-higher-order-proof-input proof))
     :higher-order-call-facts
     (sh08-ft-higher-order-call-proof-facts proof))
    result))

(defn sh08-ft-recursive-result-fields [result proof canonical-call-facts]
  (if (= :accepted (get proof :status))
    (assoc
     (assoc result
            :recursive-proof
            (sh08-ft-recursive-proof-input proof))
     :recursive-call-facts
     (sh08-ft-recursive-call-proof-facts proof canonical-call-facts))
    result))

(defn sh08-ft-function-skeletons [function-records module]
  (loop [remaining function-records
         result {}]
    (if (= (count remaining) 0)
      result
      (let [record (first remaining)]
        (recur
         (rest remaining)
         (assoc result
                (get record :function-syntax-id)
                (sh08-ft-function-type-skeleton record module)))))))

(defn sh08-ft-complete-recursive-skeletons
  [base-function-skeletons recursive-proof]
  (if (= :accepted (get recursive-proof :status))
    (loop [remaining (keys base-function-skeletons)
           result base-function-skeletons]
      (if (= (count remaining) 0)
        result
        (let [function-id (first remaining)
              function (get result function-id)]
          (if (= function-id (get recursive-proof :function-syntax-id))
            (recur
             (rest remaining)
             (assoc result function-id
                    (sh08-ft-recursive-complete-function
                     function recursive-proof)))
            (recur (rest remaining) result)))))
    base-function-skeletons))

(defn sh08-ft-complete-higher-order-skeletons
  [base-function-skeletons higher-order-proof]
  (if (= :accepted (get higher-order-proof :status))
    (loop [remaining (keys base-function-skeletons)
           result base-function-skeletons]
      (if (= (count remaining) 0)
        result
        (let [function-id (first remaining)
              function (get result function-id)]
          (if (= function-id
                 (get (get (get higher-order-proof :identity)
                           :record)
                      :function-syntax-id))
            (recur
             (rest remaining)
             (assoc result function-id
                    (sh08-ft-higher-order-complete-function
                     function
                     (get higher-order-proof :identity-function-type))))
            (if (= function-id
                   (get (get (get higher-order-proof :apply)
                             :record)
                        :function-syntax-id))
              (recur
               (rest remaining)
               (assoc result function-id
                      (sh08-ft-higher-order-complete-function
                       function
                       (get higher-order-proof
                            :apply-function-type))))
              (recur (rest remaining) result))))))
    base-function-skeletons))

(defn sh08-ft-complete-function-skeletons
  [base-function-skeletons recursive-proof higher-order-proof]
  (sh08-ft-restore-declarations
  (if (= :accepted (get recursive-proof :status))
    (sh08-ft-complete-recursive-skeletons
     base-function-skeletons recursive-proof)
    (if (= :accepted (get higher-order-proof :status))
      (sh08-ft-complete-higher-order-skeletons
       base-function-skeletons higher-order-proof)
      base-function-skeletons)) base-function-skeletons))

(defn sh08-ft-inference-context
  [recursive? higher-order? recursive-proof higher-order-proof
   function-skeletons]
  (if recursive?
    (let [initial {(get (get recursive-proof :definition) :binding-id)
                   (get function-skeletons (get recursive-proof :function-syntax-id))}]
      (if (sh08-is? recursive-proof)
        (loop [ids (get (get recursive-proof :function-record) :parameter-binding-ids)
               types (get recursive-proof :parameter-types) out initial]
          (if (= 0 (count ids)) out
            (recur (rest ids) (rest types) (assoc out (first ids) (first types))))) initial))
    (if higher-order?
      (get higher-order-proof :initial-binding-types)
      {})))

(defn sh08-ft-context-proof
  [recursive? higher-order? recursive-proof higher-order-proof]
  (if recursive?
    recursive-proof
    (if higher-order?
      higher-order-proof
      {})))

; Ordinary inference starts empty after a source dependency cut. Independent
; arguments to an acyclic local function still constrain its parameters even
; when that call's result depends on the excluded self body.
; A recursive result never witnesses its own return type. Select only normal
; return positions reachable through independently typed control and prefixes.
; Pending positions remain obligations of the later complete body check.
(defn sh08-is-return-witness [record nodes types]
  ; Each active return path carries its own canonical-ID ancestors. Shared
  ; acyclic leaves remain independent witnesses; path length is not admission.
  (let [body (get record :body-core-node-id)]
    (loop [queue [{:node-id body :path [body] :control-records [] :ancestors #{}}] offset 0
           witnesses [] pending [] selected nil]
      (if (= offset (count queue))
        (if (> (count witnesses) 0)
          {:status :accepted :return-type selected :witnesses witnesses
           :pending-return-node-ids pending}
          {:status :rejected :reason :private-self-independent-return-required
           :pending-return-node-ids pending})
        (let [frame (get queue offset) id (get frame :node-id)
              valid-id? (if (keyword? id) true (if (string? id) (> (count id) 0) false))
              node (if valid-id? (get nodes id) nil)
              kind (get node :core-form) children (get node :children)
              path (get frame :path) controls (get frame :control-records) ancestors (get frame :ancestors)
              type (if valid-id? (get types id :gravity.type/unknown) :gravity.type/unknown)]
          (if (if valid-id? (contains? ancestors id) false)
              {:status :rejected :reason :private-self-return-cycle}
              (if (= false (if (map? node)
                               (let [stored-id (get node :node-id)]
                                 (if (if (keyword? stored-id) true (if (string? stored-id) (> (count stored-id) 0) false))
                                   (= id stored-id) false)) false))
                {:status :rejected :reason :private-self-return-source-required}
                (if (= kind :if)
                  (if (= 3 (count children))
                    (let [condition-id (first children) condition (get nodes condition-id)
                          condition-type (get types condition-id :gravity.type/unknown)
                          attributes (get condition :attributes)
                          literal? (= :literal (get condition :core-form))
                          branches (if (= condition-type :gravity.type/nil) [2]
                                     (if (= condition-type :gravity.type/bool)
                                       (if (if literal? (contains? attributes :value) false)
                                         (if (= true (get attributes :value)) [1] [2]) [1 2])
                                       (if (sh08-ni-type? condition-type) [1 2] [1])))
                          control {:owner-core-node-id id :condition-core-node-id condition-id
                                   :condition-type condition-type :condition-source (get condition :source)
                                   :selected-branch-indexes branches :rule :independent-normal-condition}]
                      (if (= condition-type :gravity.type/never)
                        (recur queue (+ offset 1) witnesses pending selected)
                        (if (sh08-ft-known? condition-type)
                          (recur
                            (loop [remaining branches out queue]
                              (if (= 0 (count remaining)) out
                                (let [child (get children (first remaining))]
                                  (recur (rest remaining)
                                    (conj out {:node-id child :path (conj path child) :ancestors (conj ancestors id)
                                               :control-records (conj controls control)})))))
                            (+ offset 1) witnesses pending selected)
                          (recur queue (+ offset 1) witnesses (conj pending id) selected))))
                    {:status :rejected :reason :private-self-return-source-required})
                  (if (contains? #{:do :let} kind)
                    (if (> (count children) 0)
                      (let [prefix (loop [i 0 out [] normal? true abort? false]
                                     (if (= i (- (count children) 1))
                                       {:rows out :normal? normal? :abort? abort?}
                                       (let [child (get children i) child-type (get types child :gravity.type/unknown)]
                                         (recur (+ i 1) (conj out {:node-id child :type child-type})
                                           (if (sh08-ft-known? child-type) normal? false)
                                           (if (= child-type :gravity.type/never) true abort?)))))
                            last-id (get children (- (count children) 1))]
                        (if (get prefix :abort?)
                          (recur queue (+ offset 1) witnesses pending selected)
                          (if (get prefix :normal?)
                            (recur (conj queue {:node-id last-id :path (conj path last-id) :ancestors (conj ancestors id)
                                                :control-records (conj controls {:owner-core-node-id id
                                                                                 :rule :independent-normal-prefix
                                                                                 :prefix (get prefix :rows)})})
                              (+ offset 1) witnesses pending selected)
                            (recur queue (+ offset 1) witnesses (conj pending id) selected))))
                      {:status :rejected :reason :private-self-independent-return-required})
                    (if (if (contains? #{:throw :recur} kind) true (= type :gravity.type/never))
                      (recur queue (+ offset 1) witnesses pending selected)
                      (if (contains? #{:try :alternatives :loop :match} kind)
                        {:status :rejected :reason :private-self-return-shape-required}
                        (if (sh08-is-value-type? type)
                          (if (if (= selected nil) false (= false (= selected type)))
                            {:status :rejected :reason :private-self-return-type-conflict
                             :expected selected :actual type :node-id id}
                            (recur queue (+ offset 1)
                              (conj witnesses {:node-id id :source (get node :source) :type type
                                               :path path :control-records controls
                                               :rule :independent-normal-return-value})
                              pending type))
                          (if (sh08-ft-unknown? type)
                            (recur queue (+ offset 1) witnesses (conj pending id) selected)
                            {:status :rejected :reason :private-self-return-value-type-required
                             :actual type :node-id id})))))))))))))

(defn sh08-is-cold-infer [core products record nodes bindings forms imports mode parameter-types]
  (let [cut (sh08-is-cold-cut core record nodes mode)
        sequence (get core :nodes) records (get core :function-records)
        calls (get core :calls) edges (get core :call-edges)
        locals (get core :lexical-bindings) definitions (get core :definitions)]
    (if (= :rejected (get cut :status)) cut
      (let [excluded (set (get cut :excluded-node-ids))
              id (get record :function-syntax-id)
              selected-nodes (loop [remaining sequence out []]
                               (if (= 0 (count remaining)) out
                                 (recur (rest remaining)
                                   (if (contains? excluded (get (first remaining) :node-id)) out (conj out (first remaining))))))
              selected-records (loop [remaining records out []]
                                 (if (= 0 (count remaining)) out
                                   (recur (rest remaining)
                                     (if (= id (get (first remaining) :function-syntax-id)) out (conj out (first remaining))))))
              selected-locals (loop [remaining locals out []]
                                (if (= 0 (count remaining)) out
                                  (recur (rest remaining)
                                    (if (contains? excluded (get (first remaining) :initializer-node-id)) out (conj out (first remaining))))))
              selected-definitions (loop [remaining definitions out []]
                                     (if (= 0 (count remaining)) out
                                       (recur (rest remaining)
                                         (if (contains? excluded (get (first remaining) :value-node-id)) out (conj out (first remaining))))))
              selected-calls
              (loop [remaining calls rows edges out [] selected-edges []]
                (if (= 0 (count remaining)) {:calls out :edges selected-edges}
                  (let [call (first remaining) edge (first rows)
                        keep? (if (= id (get edge :callee-function-syntax-id)) false
                                (if (if (= mode :entries) (= id (get edge :caller-function-syntax-id)) false) false
                                  (if (= :local-function (get edge :classification)) true
                                    (= false (contains? excluded (get call :core-node-id))))))]
                    (recur (rest remaining) (rest rows)
                      (if keep? (conj out call) out) (if keep? (conj selected-edges edge) selected-edges)))))
              selected-products (assoc products :calls (get selected-calls :calls) :call-edges (get selected-calls :edges)
                                   :function-records selected-records :module (get core :module))
              skeletons (sh08-ft-function-skeletons selected-records (get core :module))
              seeds (sh08-ft-declaration-seeds skeletons (sh08-im-seeds imports {}))
              seeds (if (= mode :body)
                      (loop [ids (get record :parameter-binding-ids) types parameter-types out seeds]
                        (if (= 0 (count ids)) out
                          (recur (rest ids) (rest types) (assoc out (first ids) (first types))))) seeds)
              quotes (sh08-qd-products selected-nodes forms (get core :module))]
          (if (if (= :rejected (get quotes :status)) true (> (count (get quotes :diagnostics)) 0))
            {:status :rejected :reason :private-self-quoted-data-required
             :quoted-products quotes :cut cut}
          (let [inferred (sh08-ft-infer-acyclic-with-context
                         selected-nodes nodes selected-locals selected-definitions
                         (get selected-calls :calls) (get selected-calls :edges) skeletons seeds
                         {:source-node-table nodes :cold-value-inference true
                          :boolean-matches (get products :boolean-matches) :quote-types (get quotes :type-table)
                          :imported-functions imports :loop-core (sh08-ft-loop-working-core core bindings)
                          :lookup-core (if (> (count (get core :keyword-lookups)) 0) core nil)
                          :lookup-nodes nodes :lookup-forms forms :lookup-bindings bindings :ordering-core core
                          :shape-call-products selected-products})]
          (if (if (= :converged (get inferred :convergence-status)) (= [] (get inferred :diagnostics)) false)
            {:status :accepted :mode mode :cut cut :quoted-products quotes
             :inference inferred
             :source-argument-call-node-ids (loop [remaining (get selected-calls :calls) out []]
                                              (if (= 0 (count remaining)) out
                                                (recur (rest remaining) (conj out (get (first remaining) :core-node-id)))))}
            {:status :rejected :reason :private-self-cold-inference-required
             :mode mode :cut cut :quoted-products quotes
             :inference inferred})))))))

(defn sh08-is-proof [shape products bindings module]
  (let [core (get shape :analysis-core) source-forms (get shape :analysis-source-forms)
        nodes (get products :node-table) records (get products :function-records)
        calls (get products :calls) edges (get products :call-edges)
        components (get products :recursion-components)]
    (if (if (= 1 (count components)) (map? core) false)
        (let [component (first components) id (first (get component :function-syntax-ids))
              record (sh08-ft-function-by-syntax-id records id) arity (get record :fixed-arity)
              binding-table (sh08-ft-binding-index bindings)
              forms (sh08-ft-index source-forms :form-id)]
            (if (= false (if (integer? arity) (> arity 0) false))
              {:status :rejected :reason :private-self-fixed-arity-required}
            (let [census (sh08-is-private-census record core nodes binding-table forms)
                  self (first (sh08-pe-select (get census :edges) :caller-function-syntax-id id))
                  self-call (sh08-pe-one (get census :calls) :core-node-id (get self :call-core-node-id))
                  locals (loop [remaining (get core :lexical-bindings) out (set (get record :parameter-binding-ids))]
                           (if (= 0 (count remaining)) out
                             (recur (rest remaining)
                               (if (= id (get (get (get nodes (get (first remaining) :let-core-node-id)) :evaluation) :owner-function-syntax-id))
                                 (conj out (get (first remaining) :binding-id)) out))))
                  captures? (loop [remaining (get core :nodes)]
                              (if (= 0 (count remaining)) true
                                (let [node (first remaining) bid (get (get node :attributes) :binding-id)
                                      binding (get binding-table bid)]
                                  (if (if (= id (get (get node :evaluation) :owner-function-syntax-id))
                                        (if (contains? #{:try :loop :recur :match} (get node :core-form)) false
                                          (if (= :reference (get node :core-form))
                                            (if (contains? locals bid) true
                                              (if (= bid (get record :definition-binding-id))
                                                (= (get node :node-id) (get self-call :operator-node-id))
                                                (= [:core :var 'gravity.core]
                                                   [(get binding :binding-class) (get binding :kind) (get binding :namespace)]))) true)) true)
                                    (recur (rest remaining)) false))))]
              (if (if (map? census) captures? false)
                (let [cold (sh08-is-cold-infer core products record nodes bindings source-forms
                             (get shape :analysis-imports) :entries [])]
                  (if (= :accepted (get cold :status))
                    (let [indexed? (sh08-ix-candidate? record nodes census (get (get cold :inference) :type-table))
                          entries (if indexed?
                                    (sh08-ix-entry-values census nodes (get (get cold :inference) :type-table) forms)
                                    (sh08-is-entry-values census nodes (get (get cold :inference) :type-table)))
                          declarations (get (get record :signature) :parameters)
                          declared? (loop [types (get entries :parameter-types) declarations declarations]
                                      (if (= 0 (count types)) true
                                        (if (if (= nil (first declarations)) true
                                              (= (first types) (get (first declarations) :type-id)))
                                          (recur (rest types) (rest declarations)) false)))]
                      (if (if (= :accepted (get entries :status)) declared? false)
                        (let [induction (if indexed?
                                          (sh08-ix-source core census entries nodes binding-table forms)
                                          {:status :not-applicable})
                              premise (if indexed?
                                        {:domain :gravity/sh08-indexed-private-self-entry-premise-v1
                                         :source-census census :entry-values entries
                                         :cold-entry-derivation (sh08-is-cold-evidence cold)
                                         :source-induction (get induction :proof)
                                         :invalidation [:private-use-census :entry-call-sources :cold-value-dependencies
                                                        :parameter-bindings :mutations :function-records :source-induction]}
                                        (sh08-is-parameter-premise census entries cold))
                              working (assoc core :sh08-private-self-parameter-premise premise)
                              body-cold (if (= :rejected (get induction :status)) induction
                                          (sh08-is-cold-infer working products record nodes bindings source-forms
                                            (get shape :analysis-imports) :body (get entries :parameter-types)))]
                          (if (= :accepted (get body-cold :status))
                            (let [witness (if indexed? (get induction :return-witness)
                                            (sh08-is-return-witness record nodes (get (get body-cold :inference) :type-table)))
                                  return-declaration (get (get record :signature) :return)]
                              (if (if (= :accepted (get witness :status))
                                    (if (= return-declaration nil) true
                                      (= (get witness :return-type) (get return-declaration :type-id))) false)
                                {:status :accepted :rule-version (if indexed? :sh08-indexed-private-self-value-v1 :sh08-private-self-value-v1)
                                 :function-record record :function-syntax-id id :function-node (get nodes (get record :function-core-node-id))
                                 :definition (get census :definition) :component component
                                 :recursive-call self-call :recursive-edge self :recursive-node (get nodes (get self-call :core-node-id))
                                 :self-call-core-node-id (get self-call :core-node-id)
                                 :parameter-types (get entries :parameter-types) :inferred-return-type (get witness :return-type)
                                 :parameter-value-premise premise :cold-body-derivation (sh08-is-cold-evidence body-cold)
                                 :return-witness witness :module module
                                 :owned-node-ids (loop [remaining (get core :nodes) out []]
                                                   (if (= 0 (count remaining)) out
                                                     (recur (rest remaining)
                                                       (if (= id (get (get (first remaining) :evaluation) :owner-function-syntax-id))
                                                         (conj out (get (first remaining) :node-id)) out))))
                                 :incoming-call-node-ids (loop [remaining edges out []]
                                                          (if (= 0 (count remaining)) out
                                                            (recur (rest remaining)
                                                              (if (= id (get (first remaining) :callee-function-syntax-id))
                                                                (conj out (get (first remaining) :call-core-node-id)) out))))}
                                 {:status :rejected :reason (if (= :rejected (get witness :status)) (get witness :reason)
                                                            :private-self-return-declaration-conflict)
                                 :return-witness witness}))
                            body-cold))
                        (if (= :rejected (get entries :status)) entries
                          {:status :rejected :reason :private-self-parameter-declaration-conflict})))
                    cold))
                {:status :rejected :reason :private-self-source-census-or-capture}))))
        {:status :rejected :reason :private-self-source-single-component-required})))

(defn sh08-ft-proof-results [shape products bindings module]
  (let [legacy-recursive-proof
        (if (> (count (get products :recursion-components)) 0)
          (sh08-ft-recursive-proof
           (get shape :nodes)
           (get products :definitions)
           bindings
           (get products :function-records)
           (get products :calls)
           (get products :call-edges)
           (get products :recursion-components)
           module)
          {:status :not-applicable :reason :no-recursive-component})
        recursive-proof
        (if (= :rejected (get legacy-recursive-proof :status))
          (let [declared (sh08-ds-proof shape products bindings module)]
            (if (= :accepted (get declared :status)) declared
              (let [inferred (sh08-is-proof shape products bindings module)]
                (if (if (= :accepted (get inferred :status)) true
                      (= false (contains? #{:private-self-source-single-component-required
                                            :private-self-source-census-or-capture :private-self-fixed-arity-required}
                                 (get inferred :reason)))) inferred legacy-recursive-proof))))
          legacy-recursive-proof)
        higher-order-proof
        (sh08-ft-higher-order-proof
         (get shape :nodes)
         (get products :definitions)
         bindings
         (get products :function-records)
         (get products :calls)
         (get products :call-edges)
         module)]
    {:recursive-proof recursive-proof
     :higher-order-proof higher-order-proof}))

(defn sh08-ft-final-functions [functions]
  (loop [remaining functions
         values []]
    (if (= (count remaining) 0)
      values
      (let [known?
            (if (sh08-ft-every-known?
                 (loop [params (get (first remaining) :parameters)
                        result []]
                   (if (= (count params) 0)
                     (conj result (get (first remaining) :return))
                     (recur
                      (rest params)
                      (conj result (get (first params) :type))))))
              true
              false)]
        (if known?
          (recur (rest remaining) (conj values (first remaining)))
          (recur
           (rest remaining)
           (conj values (assoc (first remaining) :status :unresolved))))))))

(defn sh08-ft-signature-constraints [records module]
  (loop [remaining records result []]
    (if (= (count remaining) 0) result
      (let [record (first remaining) signature (get record :signature)
            parameter-ids (get record :parameter-binding-ids)]
        (recur (rest remaining)
          (if (contains? record :signature)
            (loop [declarations (conj (get signature :parameters) (get signature :return)) ordinal 0 values result]
              (if (= (count declarations) 0) values
                (let [declaration (first declarations) result? (= ordinal (count parameter-ids))]
                  (recur (rest declarations) (+ ordinal 1)
                    (if (if (= declaration nil) true
                          (if result? (= :sh07-list-return-declaration-v1 (get declaration :rule-version)) false)) values
                      (conj values
                        {:constraint-id-request
                         {:domain :gravity/sh08-atomic-function-declaration-constraint-v1
                          :function-core-node-id (get record :function-core-node-id)
                          :role (if result? :return :parameter) :ordinal ordinal :declaration declaration}
                         :kind :equality :producer-rule :sh08-atomic-function-signature-v1
                         :lhs (if result? (get record :body-core-node-id) (get parameter-ids ordinal))
                         :rhs (get declaration :type-id) :source-syntax-id (get declaration :type-syntax-id)
                         :profile (get module :profile) :target (get module :target)
                         :status :solved :diagnostics []})))))) result))))))

(defn sh08-ft-any-signature? [records]
  (if (= (count records) 0) false
    (if (contains? (first records) :signature) true (sh08-ft-any-signature? (rest records)))))

(defn sh08-ft-finish-function-type-core
  [core-artifact imports products module recursive-proof higher-order-proof nodes recursive? higher-order? inference quoted-products match-checks throw-products final-functions]
            (if (> (count (get inference :diagnostics)) 0)
              {:artifact :gravity/sh08-function-typed-core-template
               :schema-version 3
               :status :rejected
               :scope :first-order-fixed-arity-functions-locals-calls
               :authentication-status
               :host-resolved-b47-verification-boundary
               :module module
               :sh07-shaped-artifact-id (get core-artifact :artifact-id)
               :diagnostics
               (sh08-ft-render-inference-diagnostics
                (get inference :diagnostics) nodes module)
               :pending [:recursive-type-annotations
                         :higher-order-functions :records :unions
                         :protocols :generics :casts :dynamic-boundaries]}
              (if (loop [remaining final-functions]
                    (if (= (count remaining) 0)
                      true
                      (if (= (get (first remaining) :status) :inferred)
                        (recur (rest remaining))
                        false)))
                (let [local-facts
                      (sh08-ft-local-facts
                       (get products :lexical-bindings)
                       (get inference :type-table)
                       (get inference :binding-types)
                       nodes module)
                      call-facts
                      (sh08-ft-call-facts-with-context
                       (get products :calls)
                       (get products :call-edges)
                       nodes
                       (get inference :type-table)
                       (get inference :function-types)
                       module
                       (assoc higher-order-proof :imported-functions imports))
                      base-constraints
                      (sh08-ft-add-values-to-set (get quoted-products :constraints)
                      (sh08-ft-add-values-to-set (get match-checks :constraints) (sh08-ft-add-values-to-set
                        (sh08-ft-signature-constraints (get products :function-records) module)
                      (if recursive?
                        (sh08-ft-add-values-to-set
                         (sh08-ft-recursive-constraint-ledger recursive-proof)
                         (get inference :constraints))
                        (get inference :constraints)))))
                      combined-constraints (sh08-ft-add-values-to-set (get throw-products :constraints) base-constraints)
                      convergence
                      {:status (get inference :convergence-status)
                       :proof
                       :monotone-finite-type-fact-propagation}
                      identity-input-base
                      {:domain (if recursive?
                                (if (sh08-is? recursive-proof)
                                  (if (= :sh08-indexed-private-self-value-v1 (get recursive-proof :rule-version))
                                    :gravity/sh08-indexed-private-self-value-typed-core-v1 :gravity/sh08-private-self-value-typed-core-v1)
                                  (if (sh08-ds? recursive-proof) :gravity/sh08-declared-self-value-typed-core-v1
                                    :gravity/sh08-recursive-function-typed-core-v1))
                                (if (sh08-ft-any-signature? (get products :function-records))
                                  :gravity/sh08-atomic-function-signature-typed-core-v1 :gravity/sh08-function-typed-core-v3))
                       :sh07-shaped-artifact-id
                       (get core-artifact :artifact-id)
                       :module module
                       :function-records
                       (get products :function-records)
                       :call-edges (get products :call-edges)
                       :recursion-components
                       (get products :recursion-components)
                       :lexical-bindings
                       (get products :lexical-bindings)
                       :function-type-table final-functions
                       :local-binding-facts local-facts
                       :call-type-facts call-facts
                       :constraint-ledger combined-constraints
                       :type-table (get inference :type-table)
                       :convergence convergence
                       :pending [:recursive-type-annotations
                                 :higher-order-functions :records :unions
                                 :protocols :generics :casts
                                 :dynamic-boundaries]}
                      identity-input
                      (if recursive?
                        (assoc
                         (assoc identity-input-base
                                :pending
                                (sh08-ft-recursive-pending
                                 (get identity-input-base :pending)))
                         :recursive-proof
                         (sh08-ft-recursive-proof-input recursive-proof))
                        (if higher-order?
                          (assoc
                           (assoc
                            (assoc identity-input-base
                                   :domain
                                   :gravity/sh08-authoritative-higher-order-type-v1)
                             :pending
                             (sh08-ft-higher-order-pending
                              (get identity-input-base :pending)))
                           :higher-order-proof
                           (sh08-ft-higher-order-proof-input
                            higher-order-proof))
                          identity-input-base))
                      typed-core-base
                      {:artifact :gravity/typed-core
                       :core-input (get core-artifact :artifact-id)
                       :module module
                       :types (get inference :type-table)
                       :constraints combined-constraints
                       :function-types final-functions
                       :local-bindings local-facts
                       :calls call-facts
                       :diagnostics []}
                      typed-core
                      (if recursive?
                        (assoc
                         (assoc typed-core-base
                                :recursive-proof
                                (sh08-ft-recursive-proof-input
                                 recursive-proof))
                         :recursive-call-facts
                         (sh08-ft-recursive-call-proof-facts
                          recursive-proof call-facts))
                        (if higher-order?
                          (assoc
                           (assoc typed-core-base
                                  :higher-order-proof
                                  (sh08-ft-higher-order-proof-input
                                   higher-order-proof))
                           :higher-order-call-facts
                           (sh08-ft-higher-order-call-proof-facts
                            higher-order-proof))
                          typed-core-base))]
                  (sh08-ft-recursive-result-fields
                   (sh08-ft-higher-order-result-fields
                   {:artifact :gravity/sh08-function-typed-core-template
                   :schema-version 3
                   :status :accepted
                   :scope (if recursive?
                            (if (sh08-is? recursive-proof) :private-inferred-monomorphic-named-self-value
                              (if (sh08-ds? recursive-proof) :declared-monomorphic-named-self-value
                                :bounded-named-self-recursive-positive-fixed-arity-positional-literal-base))
                            (if higher-order?
                              :capture-free-higher-order-fixed-arity-one-hop
                              :first-order-fixed-arity-functions-locals-calls))
                   :authentication-status
                   :host-resolved-b47-verification-boundary
                   :module module
                   :sh07-shaped-artifact-id
                   (get core-artifact :artifact-id)
                   :function-products
                   {:function-records (get products :function-records)
                    :call-edges (get products :call-edges)
                    :recursion-components
                    (get products :recursion-components)
                    :lexical-bindings
                    (get products :lexical-bindings)}
                   :function-type-table final-functions
                   :local-binding-facts local-facts
                   :call-type-facts call-facts
                   :constraint-ledger combined-constraints
                   :type-table (get inference :type-table)
                   :convergence convergence
                   :typed-core typed-core
                   :diagnostics []
                   :artifact-id-request identity-input
                   :identity-input identity-input
                   :identity-resolution :coordinator-digest-required
                   :provenance (get core-artifact :provenance)
                   :pending (get identity-input :pending)}
                   higher-order-proof)
                   recursive-proof
                   call-facts))
                {:artifact :gravity/sh08-function-typed-core-template
                 :schema-version 3
                 :status :rejected
                 :scope :first-order-fixed-arity-functions-locals-calls
                 :authentication-status
                 :host-resolved-b47-verification-boundary
                 :module module
                 :sh07-shaped-artifact-id (get core-artifact :artifact-id)
                 :diagnostics
                 [(sh08-ft-diagnostic
                   "C7-GENERIC" {}
                   module :fully-inferred-function-types
                   final-functions
                   :unresolved-function-type {})]
                 :pending [:recursive-type-annotations
                           :higher-order-functions :records :unions
                           :protocols :generics :casts :dynamic-boundaries]})))

(defn sh08-ft-function-type-core-artifact-with-imports [core-artifact bindings source-forms imports]
  (if (map? core-artifact)
    (let [shape (sh08-validate-core-shape core-artifact)
          module (if (map? (get core-artifact :module))
                   (get core-artifact :module)
                   {})
          products (sh08-bm-products core-artifact
                     (sh08-ft-products-valid? core-artifact shape bindings) source-forms)]
      (if (= (get products :status) :accepted)
        (let [core-artifact (assoc core-artifact :sh08-private-self-parameter-premise nil)
              proof-results
              (sh08-ft-proof-results
                (assoc shape :analysis-core core-artifact :analysis-source-forms source-forms :analysis-imports imports)
                products bindings module)
              recursive-proof (get proof-results :recursive-proof)
              higher-order-proof (get proof-results :higher-order-proof)
              core-artifact (if (sh08-is? recursive-proof)
                              (assoc core-artifact :sh08-private-self-parameter-premise (get recursive-proof :parameter-value-premise))
                              core-artifact)]
          (let [unsupported-higher-order?
                (= :unsupported-higher-order-primitive-type
                   (get higher-order-proof :reason))]
            (if (if unsupported-higher-order?
                  true
                  (if (> (count (get products :recursion-components)) 0)
                (if (= :accepted (get recursive-proof :status)) false true)
                false))
              (if unsupported-higher-order?
                {:artifact :gravity/sh08-function-typed-core-template
                 :schema-version 3
                 :status :rejected
                 :scope :capture-free-higher-order-fixed-arity-one-hop
                 :authentication-status
                 :host-resolved-b47-verification-boundary
                 :module module
                 :sh07-shaped-artifact-id (get core-artifact :artifact-id)
                 :diagnostics
                 [(sh08-ft-diagnostic
                   "C7-ANNOTATION"
                   (get higher-order-proof :node)
                   module
                   :supported-higher-order-primitive-type
                   (get higher-order-proof :actual)
                   :unsupported-higher-order-primitive-type
                   {})]
                 :pending [:recursive-type-annotations
                           :higher-order-functions :records :unions
                           :protocols :generics :casts :dynamic-boundaries]}
                {:artifact :gravity/sh08-function-typed-core-template
                 :schema-version 3
                 :status :rejected
                 :scope :first-order-fixed-arity-functions-locals-calls
                 :authentication-status
                 :host-resolved-b47-verification-boundary
                 :module module
                 :sh07-shaped-artifact-id (get core-artifact :artifact-id)
                 :diagnostics
                 [(sh08-ft-recursive-diagnostic recursive-proof module)]
                 :pending [:recursive-type-annotations
                           :higher-order-functions :records :unions
                           :protocols :generics :casts :dynamic-boundaries]})
              (let [base-function-skeletons
                (sh08-ft-function-skeletons
                 (get products :function-records) module)
                nodes (get products :node-table)
                recursive?
                (= :accepted (get recursive-proof :status))
                higher-order?
                (= :accepted (get higher-order-proof :status))
                function-skeletons
                (sh08-ft-complete-function-skeletons
                 base-function-skeletons recursive-proof higher-order-proof)
                quoted-products (sh08-qd-products (get shape :nodes) source-forms module)
                handler-products (sh08-eh-source-products core-artifact source-forms bindings)
                unprojected-inference
                (sh08-ft-infer-acyclic-with-context
                 (get shape :nodes)
                 nodes
                 (get products :lexical-bindings)
                 (get products :definitions)
                 (get products :calls)
                 (get products :call-edges)
                 function-skeletons
                 (sh08-eh-seed-bindings (sh08-ft-declaration-seeds function-skeletons (sh08-im-seeds imports (sh08-ft-inference-context
                  recursive? higher-order? recursive-proof
                  higher-order-proof function-skeletons))) (get handler-products :seeds {}))
                 (assoc (sh08-ft-context-proof
                  recursive? higher-order? recursive-proof higher-order-proof)
                   :boolean-matches (get products :boolean-matches) :quote-types (get quoted-products :type-table)
                   :imported-functions imports :loop-core (sh08-ft-loop-working-core core-artifact bindings)
                   :lookup-core (if (> (count (get core-artifact :keyword-lookups)) 0) core-artifact nil)
                   :lookup-nodes nodes :lookup-forms source-forms :lookup-bindings bindings :ordering-core core-artifact
                   :shape-call-products (assoc products :module module)))
                handler-types (sh08-eh-type-checks (get handler-products :groups {}) (get unprojected-inference :type-table) nodes)
                direct-throws (sh08-th-products core-artifact source-forms (get unprojected-inference :type-table))
                throw-products (if (sh08-rv? recursive-proof)
                                 (assoc direct-throws :recursive-error-status :pending-sh09-recursive-body)
                                 (if (if (= :accepted (get direct-throws :status))
                                     (if (= [] (get unprojected-inference :diagnostics))
                                       (= nil (sh08-ft-first-unknown-node (get shape :nodes) (get unprojected-inference :type-table))) false) false)
                                 (sh08-tc-products-with-source-forms core-artifact (get unprojected-inference :type-table)
                                   (get unprojected-inference :function-types) bindings direct-throws source-forms) direct-throws))
                raw-inference (if (if (sh08-rv? recursive-proof) true (= 0 (count (get throw-products :throws)))) unprojected-inference
                  (assoc unprojected-inference
                    :type-table (sh08-th-type-map (get unprojected-inference :type-table) (get throw-products :throws))
                    :function-types (sh08-th-type-map (get unprojected-inference :function-types) (get throw-products :throws))))
                raw-match-checks
                (sh08-bm-checks (sh08-sm-groups-with-shapes
                                 (sh08-sm-groups-with-call-context (get products :boolean-matches)
                                   (get raw-inference :shape-call-context {}))
                                 (get raw-inference :binding-shapes)) (get raw-inference :type-table)
                                (get raw-inference :function-types) module)
                match-checks raw-match-checks
                unknown-node
                (if (= (get raw-inference :convergence-status)
                       :converged)
                  (sh08-ft-first-unknown-node
                   (get shape :nodes)
                   (get raw-inference :type-table))
                  nil)
                inference
                (if (> (count (get handler-products :diagnostics)) 0)
                  (assoc raw-inference :diagnostics (get handler-products :diagnostics))
                (if (> (count (get handler-types :diagnostics)) 0)
                  (assoc raw-inference :diagnostics (get handler-types :diagnostics))
                (if (> (count (get throw-products :diagnostics)) 0)
                  (assoc raw-inference :diagnostics (get throw-products :diagnostics))
                (if (> (count (get quoted-products :diagnostics)) 0)
                  (assoc raw-inference :diagnostics (get quoted-products :diagnostics))
                (if (> (count (get match-checks :diagnostics)) 0)
                  (assoc raw-inference :diagnostics (get match-checks :diagnostics))
                (if (map? unknown-node)
                  (assoc
                   raw-inference
                   :diagnostics
                   (conj
                    (get raw-inference :diagnostics)
                    {:node unknown-node
                     :rule "C7-ANNOTATION"
                     :reason :unsupported-or-unresolved-core-node-type
                     :expected :concrete-node-type-or-diagnostic
                     :actual :gravity.type/unknown}))
                  raw-inference))))))
                functions
                (sh08-ft-function-facts
                 (get inference :function-types)
                 nodes module)
                final-functions
                (if (sh08-rv? recursive-proof) (sh08-ft-final-functions functions)
                  (sh08-th-functions (sh08-ft-final-functions functions) (get throw-products :throws)))]
            (sh08-ft-finish-function-type-core
              core-artifact imports products module recursive-proof higher-order-proof nodes recursive? higher-order? inference quoted-products match-checks throw-products final-functions)))))
        {:artifact :gravity/sh08-function-typed-core-template
         :schema-version 3
         :status :rejected
         :scope :first-order-fixed-arity-functions-locals-calls
         :authentication-status
         :host-resolved-b47-verification-boundary
         :module module
         :sh07-shaped-artifact-id (get core-artifact :artifact-id)
         :diagnostics
         [(sh08-ft-diagnostic
           (get products :rule "C7-VERIFY") (get products :node {})
           module :coherent-b47-function-products
           (get products :reason)
           (get products :reason) {})]
         :pending [:recursive-type-annotations
                   :higher-order-functions :records :unions
                   :protocols :generics :casts :dynamic-boundaries]}))
    {:artifact :gravity/sh08-function-typed-core-template
     :schema-version 3
     :status :rejected
     :scope :first-order-fixed-arity-functions-locals-calls
     :authentication-status
     :host-resolved-b47-verification-boundary
     :module {}
     :diagnostics
     [(sh08-ft-diagnostic
       "C7-VERIFY" {} {} :sh07-canonical-core-map core-artifact
       :sh07-shaped-core-map-required {})]}));

(defn sh08-function-type-boundary-policy []
  {:verification-boundary
   :host-validated-b47-report-and-opaque-provenance-digest
   :verification-preimage-domain
   :gravity/sh08-b47-verification-binding-v1
   :independent-gravity-cryptographic-verification? false
   :host-digest-authority-retained? true
   :native-gravity-cryptographic-verification :pending})

(defn sh08-ft-function-type-core-artifact-with-origins [core-artifact bindings source-forms]
  (sh08-ft-function-type-core-artifact-with-imports core-artifact bindings source-forms {}))

(defn sh08-ft-function-type-core-artifact [core-artifact bindings]
  (sh08-ft-function-type-core-artifact-with-origins core-artifact bindings []))

; L3/L5/C7: imported signatures come from freshly derived authenticated producer
; requests. The invocation-local memo shares work, never admission authority.
(defn sh08-im-path [value fields]
  (loop [remaining fields result value]
    (if (= (count remaining) 0) result
      (recur (rest remaining) (get result (first remaining))))))

(defn sh08-im-failure [rule reason actual]
  {:status :rejected :rule rule :reason reason :actual actual})

(defn sh08-im-callee [edge context]
  (if (= :nonlocal-or-nonfunction (get edge :classification))
    (get (get context :imported-functions) (get edge :callee-binding-id)) nil))

(defn sh08-im-seeds [imports initial]
  (loop [ids (keys imports) result initial]
    (if (= (count ids) 0) result
      (recur (rest ids) (assoc result (first ids) (get (get imports (first ids)) :function-type))))))

(defn sh08-im-reference [imported]
  (assoc (sh08-bm-project imported [:binding-id :producer-sh07-artifact-id :producer-sh06-artifact-id :definition-binding-id])
         :function-id (get (get imported :function-type) :function-id)))

(defn sh08-im-call-constraint [call edge args imported nodes]
  (let [function (get imported :function-type) parameters (get function :parameters)
        arity? (= (count args) (count parameters))
        mismatch (loop [as args ps parameters]
                   (if (= (count as) 0) nil
                     (if (if (if (= (first as) :gravity.type/never) false (sh08-ft-known? (first as)))
                           (= false (= (first as) (get (first ps) :type))) false)
                       {:expected (get (first ps) :type) :actual (first as)}
                       (recur (rest as) (rest ps)))))
        diagnostic (if (= false arity?)
                     {:call call :rule "C7-TYPE-MISMATCH" :reason :call-arity-mismatch
                      :expected (count parameters) :actual (count args)}
                     (if (map? mismatch)
                       (assoc mismatch :call call :rule "C7-TYPE-MISMATCH" :reason :call-argument-type-mismatch) nil))]
    {:constraint {:constraint-id-request {:domain :gravity/sh08-imported-call-constraint-v1
                                          :call-core-node-id (get call :core-node-id) :imported-function (sh08-im-reference imported)}
                  :kind :equality :producer-rule :sh08-imported-function-call-v1 :lhs (sh08-im-reference imported) :rhs args
                  :profile (first (get (get (get imported :origin) :origin-definition) :profile-set))
                  :target (first (get (get (get imported :origin) :origin-definition) :target-set))
                  :dependencies {:imported-function (sh08-im-reference imported) :arguments (get call :argument-node-ids)}
                  :solution {:argument-types args :result-type (get function :return)
                             :arguments-complete? (sh08-ft-every-known? args)}
                  :invalidation [:producer-request :module-artifact :origin-binding :complete-signature :argument-types
                                 :producer-declared-effects :producer-declared-capabilities :imported-body-effects]
                  :status (if (map? diagnostic) :rejected :solved)
                  :origin (get (get (get nodes (get call :core-node-id)) :source) :origin-chain)
                  :effect-status :pending-sh09-imported-body :legality-status :pending-imported-effects
                  :diagnostics (if (map? diagnostic) [diagnostic] [])}
     :diagnostics (if (map? diagnostic) [diagnostic] [])}))

(defn sh08-im-scalar-type? [type]
  ; Exact union of the nine literal and fifteen atomic catalog occurrences.
  ; The family guard rejects composite/callable signatures without Vector tails.
  (if (keyword? type)
    (contains? '#{:gravity.type/nil :gravity.type/bool :gravity.type/integer
                  :gravity.type/decimal :gravity.type/ratio :gravity.type/character
                  :gravity.type/string :gravity.type/keyword :gravity.type/symbol
                  :gravity.type/i8 :gravity.type/i16 :gravity.type/i32 :gravity.type/i64
                  :gravity.type/u8 :gravity.type/u16 :gravity.type/u32 :gravity.type/u64
                  :gravity.type/f32 :gravity.type/f64} type)
    false))

(defn sh08-im-declarations-consistent? [record function]
  (if (contains? record :signature)
    (let [signature (get record :signature) declarations (get signature :parameters) parameters (get function :parameters)
          result (get signature :return)]
      (if (if (map? signature) (vector? declarations) false)
        (if (= signature (get function :signature))
          (if (= (count declarations) (count parameters))
            (if (if (= result nil) true
                  (if (map? result) (= (get result :type-id) (get function :return)) false))
              (loop [ds declarations ps parameters]
                (if (= (count ds) 0) true
                  (if (if (= (first ds) nil) true
                        (if (map? (first ds)) (= (get (first ds) :type-id) (get (first ps) :type)) false))
                    (recur (rest ds) (rest ps)) false))) false) false) false) false))
    (= false (contains? function :signature))))

(defn sh08-im-function-identities? [record function]
  (let [arity (get record :fixed-arity) ids (get record :parameter-binding-ids) parameters (get function :parameters)]
    (if (if (vector? ids) (if (vector? parameters) (integer? arity) false) false)
      (if (>= arity 0)
        (if (sh08-ft-all-true?
              [(= :gravity/c7-function-type (get function :artifact)) (= :inferred (get function :status))
               (= arity (get function :fixed-arity) (count ids) (count parameters))
               (= (get record :function-syntax-id) (get function :function-id))
               (= (get record :function-core-node-id) (get function :function-core-node-id))
               (= (get record :body-core-node-id) (get function :body-core-node-id))
               (= (get record :definition-name) (get function :definition-name))
               (= ids (get function :parameter-binding-ids))
               (sh08-sha256-id-vector? [(get record :function-syntax-id) (get record :function-core-node-id) (get record :body-core-node-id)])
               (sh08-all-unique? [(get record :function-syntax-id) (get record :function-core-node-id) (get record :body-core-node-id)] [])
               (sh08-sha256-id-vector? ids) (sh08-all-unique? ids [])])
          (loop [ps parameters remaining ids]
            (if (= (count ps) 0) (sh08-im-declarations-consistent? record function)
              (if (sh08-exact-keys? (first ps) #{:binding-id :type})
                (if (= (get (first ps) :binding-id) (first remaining)) (recur (rest ps) (rest remaining)) false) false))) false) false) false)))

(defn sh08-im-complete-signature? [record function]
  (if (sh08-im-function-identities? record function)
    (if (sh08-im-scalar-type? (get function :return))
      (loop [parameters (get function :parameters)]
        (if (= (count parameters) 0) true
          (if (sh08-im-scalar-type? (get (first parameters) :type)) (recur (rest parameters)) false))) false) false))

(defn sh08-im-origin [caller binding producer typed]
  (let [caller-c5 (sh08-im-path caller [:b47-context :authenticated-wrapper :sh06-resolution-artifact])
        callee-c5 (sh08-im-path producer [:b47-context :authenticated-wrapper :sh06-resolution-artifact])
        origin (get binding :semantic-span)
        id (get origin :ordinary-module-artifact-id)
        retained (sh08-bm-select (sh08-im-path caller-c5 [:gravity-resolution-boundary :module-inputs :module-artifacts]) :artifact-id id)
        caller-rows (sh08-bm-select (sh08-im-path caller-c5 [:binding-table :bindings]) :binding-id (get binding :upstream-binding-id))
        originals (sh08-bm-select (sh08-im-path callee-c5 [:binding-table :bindings]) :binding-id (get origin :origin-binding-id))
        original (first originals)
        projected (sh08-bm-select (sh08-im-path producer [:b47-context :authenticated-core-request :binding-table])
                                  :upstream-binding-id (get original :binding-id))
        records (sh08-bm-select (sh08-im-path producer [:canonical-core-artifact :function-records])
                                :definition-binding-id (get (first projected) :binding-id))
        record (first records)
        functions (sh08-bm-select (get typed :function-type-table) :function-id (get record :function-syntax-id))
        function (first functions)
        module (sh08-im-path callee-c5 [:gravity-resolution-boundary :resolved-analysis :module-contract])
        caller-module (sh08-im-path caller [:canonical-core-artifact :module])
        exact? (sh08-ft-all-true?
                 [(= 1 (count retained) (count caller-rows) (count originals) (count projected))
                  (= (first retained) callee-c5)
                  (= id (get callee-c5 :artifact-id)
                     (sh08-im-path producer [:b47-context :authenticated-core-request :lineage :authenticated-sh06-artifact-id]))
                  (= origin (get (first caller-rows) :semantic-span))
                  (= :import (get binding :binding-class) (get (first caller-rows) :binding-class))
                  (= (get binding :name) (get original :name))
                  (= (get binding :namespace) (get original :namespace) (get module :namespace))
                  (= :namespace (get original :binding-class))
                  (= :public (get original :visibility) (get binding :visibility))
                  (sh08-vector-contains? (get module :exports) (get original :name))
                  (= (get origin :origin-analysis-id) (sh08-im-path callee-c5 [:gravity-resolution-boundary :resolved-analysis :artifact-id]))
                  (= (get origin :origin-definition-artifact-id) (get original :definition-artifact-id))
                  (= (get origin :origin-definition-syntax-id) (get original :definition-syntax-id))
                  (= (get origin :origin-definition)
                     (sh08-bm-project original [:name :kind :namespace :package :visibility :profile-set :target-set :type-ref :effects :capabilities :safety]))])]
    (if exact?
      (if (= [(get caller-module :profile) (get caller-module :target)] [(get module :profile) (get module :target)])
        (if (if (= :function (get original :kind)) (= 1 (count records) (count functions)) false)
          (if (sh08-im-function-identities? record function)
          (if (sh08-im-complete-signature? record function)
            {:status :accepted :binding-id (get binding :binding-id) :origin origin
             :producer-sh07-artifact-id (sh08-im-path producer [:b47-context :artifact-id])
             :producer-sh06-artifact-id id :producer-identity (get typed :identity-input)
             :definition-binding-id (get (first projected) :binding-id)
             :function-type (sh08-bm-project function
                              [:artifact :function-id :function-core-node-id :body-core-node-id :definition-name :parameter-binding-ids :parameters :return :fixed-arity
                               :signature :latent-effects :capabilities :ownership-constraints :profile-constraints :thrown-error-effects :status])
             :effect-status :pending-sh09-imported-body :legality-status :pending-imported-effects}
            (sh08-im-failure "C7-ANNOTATION" :incomplete-or-unsupported-imported-scalar-signature (get binding :name)))
          (sh08-im-failure "C7-VERIFY" :imported-function-type-identity-mismatch (get binding :name)))
          (sh08-im-failure "C7-ANNOTATION" :unsupported-imported-function (get binding :name)))
        (sh08-im-failure "C7-ANNOTATION" :unsupported-cross-profile-imported-typing (get module :profile)))
      (sh08-im-failure "C7-VERIFY" :imported-function-origin-mismatch origin))))

(defn sh08-im-imports [request resolution producers]
  (let [core (get resolution :core) bindings (get resolution :binding-table)]
    (loop [nodes (get core :nodes) imports {} consumed #{}]
      (if (= (count nodes) 0)
        (if (= (count consumed) (count producers)) {:status :accepted :imports imports}
          (sh08-im-failure "C7-VERIFY" :unused-module-type-request nil))
        (let [node (first nodes) id (get (get node :attributes) :binding-id)
              binding (sh08-ft-binding-by-id bindings id)
              origin (get binding :semantic-span)
              ordinary? (if (= :reference (get node :core-form))
                          (if (= :import (get binding :binding-class)) (contains? origin :ordinary-module-artifact-id) false) false)]
          (if ordinary?
            (if (= :operator (get (get node :attributes) :position))
              (if (contains? imports id) (recur (rest nodes) imports consumed)
                (let [producer (get producers (get origin :ordinary-module-artifact-id))]
                  (if (map? producer)
                    (let [joined (sh08-im-origin request binding (get producer :request) (get producer :result))]
                      (if (= :accepted (get joined :status))
                        (recur (rest nodes) (assoc imports id joined) (conj consumed (get origin :ordinary-module-artifact-id)))
                        (assoc joined :node node :binding binding)))
                    (assoc (sh08-im-failure "C7-ANNOTATION" :missing-imported-function-typing (get binding :name)) :node node :binding binding))))
              (assoc (sh08-im-failure "C7-ANNOTATION" :unsupported-higher-order-import (get binding :name)) :node node :binding binding))
            (recur (rest nodes) imports consumed)))))))

(defn sh08-im-result [result imports]
  (if (if (= :accepted (get result :status)) (> (count imports) 0) false)
    (let [pending (conj (conj (get result :pending) :imported-body-effects) :imported-effect-legality)
          proof (loop [ids (vec (sort-by-pr-str (keys imports))) result []]
                  (if (= (count ids) 0) result
                    (recur (rest ids)
                      (conj result (sh08-bm-project (get imports (first ids))
                                     [:status :binding-id :origin :producer-sh07-artifact-id :producer-sh06-artifact-id
                                      :definition-binding-id :function-type :effect-status :legality-status])))))
          producer-map (loop [ids (keys imports) result {}]
                         (if (= (count ids) 0) result
                           (let [imported (get imports (first ids))]
                             (recur (rest ids) (assoc result (get imported :producer-sh06-artifact-id)
                                                {:producer-sh07-artifact-id (get imported :producer-sh07-artifact-id)
                                                 :producer-sh06-artifact-id (get imported :producer-sh06-artifact-id)
                                                 :identity-input (get imported :producer-identity)})))))
          producers (loop [ids (vec (sort-by-pr-str (keys producer-map))) result []]
                      (if (= (count ids) 0) result
                        (recur (rest ids) (conj result (get producer-map (first ids))))))
          identity (assoc (get result :identity-input) :domain :gravity/sh08-direct-imported-function-types-v1
                          :module-type-producers producers :imported-function-types proof :pending pending)
          core (assoc (get result :typed-core) :imported-function-types proof
                      :imported-effect-status :pending-sh09-imported-body)]
      (assoc result :scope :direct-imported-functions-types-only
             :module-type-producers producers :imported-function-types proof :typed-core core :pending pending
             :identity-input identity :artifact-id-request identity)) result))

(defn sh08-im-failure-node [request failure]
  (if (map? (get failure :node)) (get failure :node)
    (let [bindings (sh08-im-path request [:b47-context :authenticated-core-request :binding-table])]
      (loop [nodes (sh08-im-path request [:canonical-core-artifact :nodes])]
        (if (= (count nodes) 0) {}
          (let [node (first nodes) binding (sh08-ft-binding-by-id bindings (get (get node :attributes) :binding-id))
                module-id (get (get binding :semantic-span) :ordinary-module-artifact-id)]
            (if (sh08-ft-all-true? [(= :reference (get node :core-form)) (= :import (get binding :binding-class))
                                   (sh08-sha256-id? module-id)
                                   (if (contains? failure :producer-sh06-artifact-id)
                                     (= module-id (get failure :producer-sh06-artifact-id)) true)])
              node (recur (rest nodes)))))))))

(defn sh08-im-rejected-result [request failure]
  {:artifact :gravity/sh08-function-typed-core-template :schema-version 3 :status :rejected
   :scope :direct-imported-functions-types-only :authentication-status :host-resolved-b47-verification-required
   :module (get (get request :canonical-core-artifact) :module {})
   :diagnostics [(sh08-ft-diagnostic (get failure :rule "C7-VERIFY") (sh08-im-failure-node request failure) (get (get request :canonical-core-artifact) :module {})
                    :authentic-complete-imported-function-type (get failure :actual) (get failure :reason) {})]
   :pending [:imported-body-effects :imported-effect-legality :runtime-linking]})

(defn sh08-im-producers [requests memo active retained]
  (loop [remaining requests current memo producers {}]
    (if (= (count remaining) 0) {:status :accepted :memo current :producers producers}
      (let [request (first remaining)
            id (sh08-im-path request [:b47-context :authenticated-wrapper :sh06-resolution-artifact :artifact-id])]
        (if (if (sh08-sha256-id? id) (= false (contains? producers id)) false)
          (if (let [matches (sh08-bm-select retained :artifact-id id)]
                (if (= 1 (count matches))
                  (= (first matches) (sh08-im-path request [:b47-context :authenticated-wrapper :sh06-resolution-artifact])) false))
          (let [derived (sh08-im-derive request current active) result (get derived :result)]
            (if (= :accepted (get result :status))
              (recur (rest remaining) (get derived :memo) (assoc producers id {:request request :result result}))
              (assoc (sh08-im-failure
                       (if (= "C7-VERIFY" (get (first (get result :diagnostics)) :rule)) "C7-VERIFY" "C7-ANNOTATION")
                       :invalid-module-type-producer (get result :diagnostics))
                     :producer-sh06-artifact-id id :memo (get derived :memo))))
          (assoc (sh08-im-failure "C7-VERIFY" :undeclared-module-type-producer id) :memo current))
          (assoc (sh08-im-failure "C7-VERIFY" :duplicate-or-invalid-module-type-producer id) :memo current))))))

(defn sh08-im-inputs-check [inputs]
  (if (sh08-exact-keys? inputs #{:artifact :schema-version :module-requests})
    (if (= [:gravity/sh08-module-type-inputs 1] [(get inputs :artifact) (get inputs :schema-version)])
      (if (vector? (get inputs :module-requests))
        {:status :accepted}
        (sh08-im-failure "C7-VERIFY" :malformed-module-type-inputs nil))
      (sh08-im-failure "C7-VERIFY" :malformed-module-type-inputs nil))
    (sh08-im-failure "C7-VERIFY" :malformed-module-type-inputs nil)))

(defn sh08-im-derive [request memo active]
  (let [id (sh08-im-path request [:b47-context :artifact-id]) previous (get memo id)
        resolution (if (if (map? previous) true (contains? active id))
                     {} (sh08-ft-authenticated-core request))
        inputs (get request :module-type-inputs {:artifact :gravity/sh08-module-type-inputs :schema-version 1 :module-requests []})]
    (if (map? previous)
      (if (= request (get previous :request)) {:result (get previous :result) :memo memo}
        {:result (sh08-im-rejected-result request (sh08-im-failure "C7-VERIFY" :substituted-module-type-request id)) :memo memo})
      (if (contains? active id)
        {:result (sh08-im-rejected-result request (sh08-im-failure "C7-VERIFY" :cyclic-module-type-request id)) :memo memo}
      (if (= :accepted (get resolution :status))
        (let [input-check (sh08-im-inputs-check inputs)
              producers (if (= :accepted (get input-check :status))
                          (sh08-im-producers (get inputs :module-requests) memo (assoc active id true)
                            (sh08-im-path request [:b47-context :authenticated-wrapper :sh06-resolution-artifact
                                                  :gravity-resolution-boundary :module-inputs :module-artifacts])) input-check)
              imports (if (= :accepted (get producers :status))
                        (sh08-im-imports request resolution (get producers :producers)) producers)
              result (if (= :accepted (get imports :status))
                       (sh08-im-result
                         (sh08-ft-function-type-core-artifact-with-imports
                           (get resolution :core) (get resolution :binding-table)
                           (sh08-im-path request [:b47-context :authenticated-core-request :forms]) (get imports :imports))
                         (get imports :imports))
                       (sh08-im-rejected-result request imports))
              next (get producers :memo memo)]
          {:result result :memo (assoc next id {:request request :result result})})
        {:result (sh08-im-rejected-result request (sh08-im-failure "C7-VERIFY" (get resolution :reason) (get resolution :reason))) :memo memo})))))

(defn sh08-function-type-core-artifact [request]
  (let [result (get (sh08-im-derive request {} {}) :result)]
    result))

(defn sh08-ft-local-verification-checks [expected]
  (if (= :private-inferred-monomorphic-named-self-value (get expected :scope))
    [:coherent-b47-function-records :coherent-b47-call-edges :coherent-b47-recursion-components
     :coherent-b47-lexical-bindings :complete-private-use-resolution-call-census
     :independent-complete-normal-entry-value-inference :independent-normal-return-witness
     :complete-body-and-incoming-call-value-checks :single-ordinary-self-edge
     :recursive-effects-and-errors-pending-sh09 :recursive-call-facts :recursive-constraint-ledger
     :canonical-complete-function-signatures :source-syntax-origin-generated-origin-links-preserved
     :path-neutral-identity-input]
  (if (= :declared-monomorphic-named-self-value (get expected :scope))
    [:coherent-b47-function-records :coherent-b47-call-edges :coherent-b47-recursion-components
     :coherent-b47-lexical-bindings :complete-monomorphic-declared-self-value-signature
     :complete-body-and-incoming-call-value-checks :single-ordinary-self-edge
     :recursive-effects-and-errors-pending-sh09 :recursive-call-facts :recursive-constraint-ledger
     :canonical-complete-function-signatures :source-syntax-origin-generated-origin-links-preserved
     :path-neutral-identity-input]
  (if (= :bounded-named-self-recursive-positive-fixed-arity-positional-literal-base
         (get expected :scope))
    [:coherent-b47-function-records
     :coherent-b47-call-edges
     :coherent-b47-recursion-components
     :coherent-b47-lexical-bindings
     :named-self-recursive-positive-fixed-arity-positional-literal-base-proof
     :concrete-recursive-base-and-parameter-evidence
     :monotone-bounded-recursive-fixed-point
     :recursive-call-facts
     :recursive-constraint-ledger
     :canonical-complete-function-signatures
     :source-syntax-origin-generated-origin-links-preserved
     :path-neutral-identity-input]
    (if (= :capture-free-higher-order-fixed-arity-one-hop
           (get expected :scope))
    [:coherent-b47-function-records
     :coherent-b47-call-edges
     :coherent-b47-recursion-components
     :coherent-b47-lexical-bindings
     :fixed-arity-first-order-inference
     :capture-free-higher-order-one-hop-inference
     :canonical-complete-function-signatures
     :higher-order-proof
     :higher-order-inner-and-outer-call-facts
     :local-binding-facts
     :call-type-facts
     :constraint-ledger
     :source-syntax-origin-generated-origin-links-preserved
     :path-neutral-identity-input
     :recursive-inference-rejected-without-annotation]
    [:coherent-b47-function-records
     :coherent-b47-call-edges
     :coherent-b47-recursion-components
     :coherent-b47-lexical-bindings
     :fixed-arity-first-order-inference
     :local-binding-facts
     :call-type-facts
     :constraint-ledger
     :source-syntax-origin-generated-origin-links-preserved
     :path-neutral-identity-input
     :recursive-inference-rejected-without-annotation])))))

(defn sh08-ft-verification-checks [expected]
  (if (= :direct-imported-functions-types-only (get expected :scope))
    [:fresh-authenticated-module-type-producers :exact-original-upstream-projected-definition-function-join
     :complete-immutable-imported-signatures :imported-operator-and-call-types :local-inference-remains-separate
     :origin-and-signature-bound-constraint-ledger :producer-declarations-preserved-with-pending-imported-effects
     :canonical-producer-and-import-order :source-syntax-origin-links-preserved :path-neutral-identity-input]
    (sh08-ft-local-verification-checks expected)))

(defn sh08-verify-function-type-result [request candidate]
  (let [expected (sh08-function-type-core-artifact request)]
    {:artifact :gravity/sh08-function-type-verification
     :status (if (= expected candidate) :passed :rejected)
     :checks (sh08-ft-verification-checks expected)
     :expected expected
     :candidate candidate}))

; SH-08 records/unions is an early leaf over the authenticated B47 checked-core
; interface.  A named source definition carries a closed descriptor family as
; ordinary Gravity data.  The checker selects that definition from the
; authenticated core and validates bounded descriptor consistency.  It emits
; no typed-core, constructor, access, match, narrowing, or constraint facts.
; Surface defrecord/defunion and pattern lowering remain blocked on SH-07.

(defn sh08-ru-value-type [value]
  (if (= nil value)
    :gravity.type/nil
    (if (boolean? value)
      :gravity.type/bool
      (if (integer? value)
        :gravity.type/integer
        (if (string? value)
          :gravity.type/string
          (if (keyword? value)
            :gravity.type/keyword
            :gravity.type/unknown))))))

(defn sh08-ru-supported-type? [value]
  (if (keyword? value)
    (contains? #{:gravity.type/nil
                 :gravity.type/bool
                 :gravity.type/integer
                 :gravity.type/string
                 :gravity.type/keyword}
               value)
    false))

(defn sh08-ru-entry-by [entries key-name value]
  (if (= (count entries) 0)
    nil
    (if (= value (get (first entries) key-name))
      (first entries)
      (sh08-ru-entry-by (rest entries) key-name value))))

(defn sh08-ru-all-record-shapes? [entries expected]
  (if (vector? entries)
    (loop [remaining entries]
      (if (= (count remaining) 0)
        true
        (if (sh08-ft-record-shape? (first remaining) expected)
          (recur (rest remaining))
          false)))
    false))

(defn sh08-ru-all-field-schemas-valid? [fields]
  (if (sh08-ru-all-record-shapes? fields #{:name :type})
    (loop [remaining fields]
      (if (= (count remaining) 0)
        (sh08-ft-unique-records? fields :name)
        (let [field (first remaining)]
          (if (keyword? (get field :name))
            (if (sh08-ru-supported-type? (get field :type))
              (recur (rest remaining))
              false)
            false))))
    false))

(defn sh08-ru-all-field-values-valid? [fields]
  (if (sh08-ru-all-record-shapes? fields #{:name :value})
    (loop [remaining fields]
      (if (= (count remaining) 0)
        (sh08-ft-unique-records? fields :name)
        (if (keyword? (get (first remaining) :name))
          (recur (rest remaining))
          false)))
    false))

(defn sh08-ru-all-variant-schemas-valid? [variants]
  (if (sh08-ru-all-record-shapes? variants #{:tag :payload-type})
    (loop [remaining variants]
      (if (= (count remaining) 0)
        (sh08-ft-unique-records? variants :tag)
        (let [variant (first remaining)]
          (if (keyword? (get variant :tag))
            (if (sh08-ru-supported-type?
                 (get variant :payload-type))
              (recur (rest remaining))
              false)
            false))))
    false))

(defn sh08-ru-all-match-branches-valid? [branches]
  (if (sh08-ru-all-record-shapes? branches #{:variant :result})
    (loop [remaining branches]
      (if (= (count remaining) 0)
        (sh08-ft-unique-records? branches :variant)
        (if (keyword? (get (first remaining) :variant))
          (recur (rest remaining))
          false)))
    false))

(defn sh08-ru-family-shape? [family]
  (if (sh08-ft-record-shape?
       family
       #{:record-type :record-construction :record-access
         :union-type :union-construction :union-match})
    (let [record-type (get family :record-type)
          record-construction (get family :record-construction)
          record-access (get family :record-access)
          union-type (get family :union-type)
          union-construction (get family :union-construction)
          union-match (get family :union-match)]
      (if (sh08-ft-record-shape? record-type #{:name :fields})
        (if (keyword? (get record-type :name))
          (if (sh08-ru-all-field-schemas-valid?
               (get record-type :fields))
            (if (sh08-ft-record-shape?
                 record-construction #{:type :fields})
              (if (keyword? (get record-construction :type))
                (if (sh08-ru-all-field-values-valid?
                     (get record-construction :fields))
                  (if (sh08-ft-record-shape?
                       record-access #{:record-type :field})
                    (if (keyword? (get record-access :record-type))
                      (if (keyword? (get record-access :field))
                        (if (sh08-ft-record-shape?
                             union-type #{:name :variants})
                          (if (keyword? (get union-type :name))
                            (if (sh08-ru-all-variant-schemas-valid?
                                 (get union-type :variants))
                              (if (sh08-ft-record-shape?
                                   union-construction
                                   #{:type :variant :payload})
                                (if (keyword?
                                     (get union-construction :type))
                                  (if (keyword?
                                       (get union-construction :variant))
                                    (if (sh08-ft-record-shape?
                                         union-match
                                         #{:union-type :branches})
                                      (if (keyword?
                                           (get union-match :union-type))
                                        (sh08-ru-all-match-branches-valid?
                                         (get union-match :branches))
                                        false)
                                      false)
                                    false)
                                  false)
                                false)
                              false)
                            false)
                          false)
                        false)
                      false)
                    false)
                  false)
                false)
              false)
            false)
          false)
        false))
    false))

(defn sh08-ru-definition-matches [definitions definition-name]
  (loop [remaining definitions values []]
    (if (= (count remaining) 0)
      values
      (if (= definition-name (get (first remaining) :name))
        (recur (rest remaining) (conj values (first remaining)))
        (recur (rest remaining) values)))))

(defn sh08-ru-family-from-core [core definition-name]
  (if (symbol? definition-name)
    (let [matches
          (sh08-ru-definition-matches
           (get core :definitions) definition-name)]
      (if (= 1 (count matches))
        (let [definition (first matches)
              node-table (sh08-ft-node-index (get core :nodes))
              value-node
              (get node-table (get definition :value-node-id))
              source-value (get (get value-node :attributes) :source-value)]
          (if (= :collection-literal (get value-node :core-form))
            (if (= :map (get (get value-node :attributes) :literal-kind))
              (if (map? source-value)
                {:status :accepted
                 :definition definition
                 :node value-node
                 :family source-value}
                {:status :rejected :reason :family-source-map-required
                 :node value-node})
              {:status :rejected :reason :family-map-literal-required
               :node value-node})
            {:status :rejected :reason :family-map-literal-required
             :node value-node}))
        {:status :rejected
         :reason :family-definition-must-exist-exactly-once
         :node {}}))
    {:status :rejected :reason :family-definition-symbol-required :node {}}))

(defn sh08-ru-first-missing-field [schema-fields value-fields]
  (if (= (count schema-fields) 0)
    nil
    (let [schema (first schema-fields)
          value (sh08-ru-entry-by value-fields :name (get schema :name))]
      (if (= value nil)
        schema
        (sh08-ru-first-missing-field (rest schema-fields) value-fields)))))

(defn sh08-ru-first-field-type-mismatch [schema-fields value-fields]
  (if (= (count schema-fields) 0)
    nil
    (let [schema (first schema-fields)
          value (sh08-ru-entry-by value-fields :name (get schema :name))
          actual (sh08-ru-value-type (get value :value))]
      (if (= (get schema :type) actual)
        (sh08-ru-first-field-type-mismatch
         (rest schema-fields) value-fields)
        {:field (get schema :name)
         :expected (get schema :type)
         :actual actual}))))

(defn sh08-ru-first-missing-variant [variants branches]
  (if (= (count variants) 0)
    nil
    (let [variant (first variants)]
      (if (= nil
             (sh08-ru-entry-by branches :variant (get variant :tag)))
        variant
        (sh08-ru-first-missing-variant (rest variants) branches)))))

(defn sh08-ru-first-invalid-branch [variants branches]
  (if (= (count branches) 0)
    nil
    (let [branch (first branches)]
      (if (= nil
             (sh08-ru-entry-by variants :tag (get branch :variant)))
        branch
        (sh08-ru-first-invalid-branch variants (rest branches))))))

(defn sh08-ru-first-branch-type-mismatch [branches expected]
  (if (= expected :gravity.type/unknown)
    {:variant (get (first branches) :variant)
     :expected :supported-descriptor-value
     :actual expected}
    (if (= (count branches) 0)
      nil
      (let [branch (first branches)
            actual (sh08-ru-value-type (get branch :result))]
        (if (= actual expected)
          (sh08-ru-first-branch-type-mismatch (rest branches) expected)
          {:variant (get branch :variant)
           :expected expected
           :actual actual})))))

(defn sh08-ru-diagnostic
  [node module core-artifact-id definition-name expected actual reason]
  (let [identity
        {:domain :gravity/sh08-record-union-descriptor-diagnostic-v1
         :rule "C7-VERIFY"
         :stage :type-checking
         :core-artifact-id core-artifact-id
         :definition-name definition-name
         :core-node-id (get node :node-id)
         :syntax-id (get (get node :source) :syntax-id)
         :source-span (get (get node :source) :semantic-span)
         :expected expected
         :actual actual
         :profile (get module :profile)
         :target (get module :target)
         :reason reason}]
    {:artifact :gravity/c7-record-union-descriptor-diagnostic
     :diagnostic-id :coordinator-digest-required
     :diagnostic-id-request identity
     :rule "C7-VERIFY"
     :severity :error
     :stage :type-checking
     :core-artifact-id core-artifact-id
     :definition-name definition-name
     :core-node-id (get node :node-id)
     :syntax-id (get (get node :source) :syntax-id)
     :source-span (get (get node :source) :semantic-span)
     :binding-id (first (get node :resolved-binding-ids))
     :type-id nil
     :constraint-id nil
     :expected-type expected
     :actual-type actual
     :profile (get module :profile)
     :target (get module :target)
     :origin-chain (get (get node :source) :origin-chain)
     :generated-origin (get (get node :source) :generated-origin)
     :reason reason
     :remediation
     {:action :repair-authenticated-record-union-descriptor
      :requirements
      [:closed-record-fields
       :supported-descriptor-value-types
       :declared-union-variants
       :complete-descriptor-branch-set]}}))

(defn sh08-ru-name-values [records key-name]
  (loop [remaining records values []]
    (if (= (count remaining) 0)
      values
      (recur
       (rest remaining)
       (conj values (get (first remaining) key-name))))))

(defn sh08-ru-check-match [union-name variants union-match]
  (let [branches (get union-match :branches)
        invalid-branch
        (sh08-ru-first-invalid-branch variants branches)
        missing-variant
        (sh08-ru-first-missing-variant variants branches)]
    (if (= union-name (get union-match :union-type))
      (if (= invalid-branch nil)
        (if (= missing-variant nil)
          (if (= (count variants) (count branches))
            (let [result-type
                  (sh08-ru-value-type (get (first branches) :result))
                  branch-mismatch
                  (sh08-ru-first-branch-type-mismatch
                   branches result-type)]
              (if (= branch-mismatch nil)
                {:status :accepted}
                {:status :rejected
                 :reason :union-match-branch-type-mismatch
                 :expected (get branch-mismatch :expected)
                 :actual (get branch-mismatch :actual)}))
            {:status :rejected
             :reason :union-match-nonexhaustive
             :expected (count variants)
             :actual (count branches)})
          {:status :rejected
           :reason :union-match-nonexhaustive
           :expected (get missing-variant :tag)
           :actual (sh08-ru-name-values branches :variant)})
        {:status :rejected
         :reason :union-match-invalid-variant
         :expected :declared-union-variant
         :actual (get invalid-branch :variant)})
      {:status :rejected
       :reason :union-match-type-mismatch
       :expected union-name
       :actual (get union-match :union-type)})))

(defn sh08-ru-check-union [family]
  (let [union-type (get family :union-type)
        union-construction (get family :union-construction)
        variants (get union-type :variants)
        variant
        (sh08-ru-entry-by
         variants :tag (get union-construction :variant))]
    (if (= (get union-type :name) (get union-construction :type))
      (if (= variant nil)
        {:status :rejected
         :reason :union-invalid-variant
         :expected (sh08-ru-name-values variants :tag)
         :actual (get union-construction :variant)}
        (let [payload-type
              (sh08-ru-value-type (get union-construction :payload))]
          (if (= payload-type (get variant :payload-type))
            (sh08-ru-check-match
             (get union-type :name) variants (get family :union-match))
            {:status :rejected
             :reason :union-payload-type-mismatch
             :expected (get variant :payload-type)
             :actual payload-type})))
      {:status :rejected
       :reason :union-construction-type-mismatch
       :expected (get union-type :name)
       :actual (get union-construction :type)})))

(defn sh08-ru-check-record [family]
  (let [record-type (get family :record-type)
        record-construction (get family :record-construction)
        record-access (get family :record-access)
        schema-fields (get record-type :fields)
        value-fields (get record-construction :fields)
        missing-field
        (sh08-ru-first-missing-field schema-fields value-fields)]
    (if (= (get record-type :name) (get record-construction :type))
      (if (= missing-field nil)
        (if (= (count schema-fields) (count value-fields))
          (let [field-mismatch
                (sh08-ru-first-field-type-mismatch
                 schema-fields value-fields)]
            (if (= field-mismatch nil)
              (if (= (get record-type :name)
                     (get record-access :record-type))
                (if (= nil
                       (sh08-ru-entry-by
                        schema-fields :name (get record-access :field)))
                  {:status :rejected
                   :reason :record-access-invalid-field
                   :expected (sh08-ru-name-values schema-fields :name)
                   :actual (get record-access :field)}
                  (sh08-ru-check-union family))
                {:status :rejected
                 :reason :record-access-type-mismatch
                 :expected (get record-type :name)
                 :actual (get record-access :record-type)})
              {:status :rejected
               :reason :record-field-type-mismatch
               :expected (get field-mismatch :expected)
               :actual (get field-mismatch :actual)}))
          {:status :rejected
           :reason :record-field-set-mismatch
           :expected (count schema-fields)
           :actual (count value-fields)})
        {:status :rejected
         :reason :record-missing-field
         :expected (get missing-field :name)
         :actual (sh08-ru-name-values value-fields :name)})
      {:status :rejected
       :reason :record-construction-type-mismatch
       :expected (get record-type :name)
       :actual (get record-construction :type)})))

(defn sh08-ru-check-family [family]
  (if (sh08-ru-family-shape? family)
    (sh08-ru-check-record family)
    {:status :rejected
     :reason :malformed-record-union-family
     :expected :closed-record-union-family
     :actual family}))

(defn sh08-ru-accepted-result
  [core definition-name family-source]
  (let [module (get core :module)
        node (get family-source :node)
        identity-input
        {:domain :gravity/sh08-record-union-descriptor-model-v1
         :sh07-shaped-artifact-id (get core :artifact-id)
         :definition-name definition-name
         :descriptor (get family-source :family)}]
    {:artifact :gravity/sh08-record-union-preparatory-model
     :schema-version 1
     :status :accepted
     :scope :authenticated-closed-record-union-descriptor-model
     :preparatory-source-model? true
     :roadmap-credit? false
     :executable-record-union-language-behavior? false
     :nominal-sh07-carrier? false
     :authentication-status :host-resolved-b47-verification-boundary
     :module module
     :sh07-shaped-artifact-id (get core :artifact-id)
     :family-definition-name definition-name
     :descriptor-core-node-id (get node :node-id)
     :descriptor (get family-source :family)
     :descriptor-consistency-checks
     [:record-field-set-and-value-model
      :record-access-model
      :union-variant-and-payload-model
      :closed-branch-set-and-result-model]
     :diagnostics []
     :artifact-id-request identity-input
     :identity-input identity-input
     :identity-resolution :coordinator-digest-required
     :provenance (get core :provenance)
     :pending [:general-record-and-union-surface-syntax
               :constructor-pattern-lowering
               :open-records-and-unions
               :general-match-guard-effects
               :ownership-layout-schema-links
               :native-gravity-cryptographic-verification
               :record-construction-typing
               :record-access-typing
               :union-construction-typing
               :union-match-typing-and-narrowing
               :uniform-gravity-and-qst-execution-gates
               :sh07-completion :sh08-completion]}))

(defn sh08-record-union-type-boundary-policy []
  {:verification-boundary
   :host-validated-b47-report-and-opaque-provenance-digest
   :verification-preimage-domain
   :gravity/sh08-b47-verification-binding-v1
   :descriptor-source
   :named-map-definition-in-authenticated-checked-core
   :closed-family-only? true
   :preparatory-source-model? true
   :roadmap-credit? false
   :executable-record-union-language-behavior? false
   :nominal-sh07-carrier? false
   :independent-gravity-cryptographic-verification? false
   :host-digest-authority-retained? true
   :native-gravity-cryptographic-verification :pending})

(defn sh08-record-union-type-core-artifact [request definition-name]
  (let [resolution (sh08-ft-authenticated-core request)]
    (if (= :accepted (get resolution :status))
      (let [core (get resolution :core)
            module (get core :module)
            family-source
            (sh08-ru-family-from-core core definition-name)]
        (if (= :accepted (get family-source :status))
          (let [checked
                (sh08-ru-check-family (get family-source :family))]
            (if (= :accepted (get checked :status))
              (sh08-ru-accepted-result
               core definition-name family-source)
              {:artifact :gravity/sh08-record-union-preparatory-model
               :schema-version 1
               :status :rejected
               :scope :authenticated-closed-record-union-descriptor-model
               :preparatory-source-model? true
               :roadmap-credit? false
               :executable-record-union-language-behavior? false
               :nominal-sh07-carrier? false
               :authentication-status
               :host-resolved-b47-verification-boundary
               :module module
               :sh07-shaped-artifact-id (get core :artifact-id)
               :family-definition-name definition-name
               :diagnostics
               [(sh08-ru-diagnostic
                 (get family-source :node) module
                 (get core :artifact-id) definition-name
                 (get checked :expected)
                 (get checked :actual)
                 (get checked :reason))]
               :pending [:general-record-and-union-surface-syntax
                         :constructor-pattern-lowering
                         :record-construction-typing
                         :record-access-typing
                         :union-construction-typing
                         :union-match-typing-and-narrowing
                         :uniform-gravity-and-qst-execution-gates
                         :sh07-completion :sh08-completion]}))
          {:artifact :gravity/sh08-record-union-preparatory-model
           :schema-version 1
           :status :rejected
           :scope :authenticated-closed-record-union-descriptor-model
           :preparatory-source-model? true
           :roadmap-credit? false
           :executable-record-union-language-behavior? false
           :nominal-sh07-carrier? false
           :authentication-status :host-resolved-b47-verification-boundary
           :module module
           :sh07-shaped-artifact-id (get core :artifact-id)
           :family-definition-name definition-name
           :diagnostics
           [(sh08-ru-diagnostic
             (get family-source :node) module
             (get core :artifact-id) definition-name
             :named-record-union-family definition-name
             (get family-source :reason))]
           :pending [:general-record-and-union-surface-syntax
                     :constructor-pattern-lowering
                     :record-construction-typing
                     :record-access-typing
                     :union-construction-typing
                     :union-match-typing-and-narrowing
                     :uniform-gravity-and-qst-execution-gates
                     :sh07-completion :sh08-completion]}))
      {:artifact :gravity/sh08-record-union-preparatory-model
       :schema-version 1
       :status :rejected
       :scope :authenticated-closed-record-union-descriptor-model
       :preparatory-source-model? true
       :roadmap-credit? false
       :executable-record-union-language-behavior? false
       :nominal-sh07-carrier? false
       :authentication-status :host-resolved-b47-verification-required
       :module {}
       :family-definition-name definition-name
       :diagnostics
       [(sh08-ru-diagnostic
         {} {} nil definition-name
         :host-resolved-authentic-b47-context
         (get resolution :reason)
         (get resolution :reason))]
       :pending [:native-gravity-cryptographic-verification
                 :record-construction-typing
                 :record-access-typing
                 :union-construction-typing
                 :union-match-typing-and-narrowing
                 :uniform-gravity-and-qst-execution-gates
                 :sh07-completion :sh08-completion]})))

(defn sh08-verify-record-union-type-result
  [request definition-name candidate]
  (let [expected
        (sh08-record-union-type-core-artifact request definition-name)]
    {:artifact :gravity/sh08-record-union-descriptor-model-verification
     :status (if (= expected candidate) :passed :rejected)
     :checks [:authenticated-b47-core-boundary
              :named-family-source-bound
              :closed-descriptor-schema-valid
              :descriptor-consistency-result-recomputed
              :supported-descriptor-value-types-only
              :path-neutral-descriptor-identity-input
              :preparatory-no-credit-boundary]
     :expected expected
     :candidate candidate}))

; SH-08 record/access/match typing v1 consumes the integrated closed
; descriptor without changing that descriptor invariant.  Each construction,
; access, scrutinee, match, and branch is a separate named map definition in
; the authenticated B47 core.  Narrowed payload types are derived from the
; descriptor and checked against pattern annotations; callers do not supply
; emitted type facts.  This remains a bounded typed-core leaf, not lowering,
; general pattern compilation, ownership, safety, layout, or runtime behavior.

(defn sh08-ram-node-link [definition-name source]
  (let [node (get source :node)
        source-record (get node :source)]
    {:definition definition-name
     :core-node-id (get node :node-id)
     :syntax-id (get source-record :syntax-id)
     :source-span (get source-record :semantic-span)
     :origin-chain (get source-record :origin-chain)
     :generated-origin (get source-record :generated-origin)
     :binding-id (get (get source :definition) :binding-id)}))

(defn sh08-ram-suffix-match? [value suffix index]
  (if (= index (count suffix))
    true
    (if (> (count suffix) (count value))
      false
      (if (= (get value (- (count value) (+ index 1)))
             (get suffix (- (count suffix) (+ index 1))))
        (sh08-ram-suffix-match? value suffix (+ index 1))
        false))))

(defn sh08-ram-path-extension-valid? [source-path source-extension]
  (if (string? source-path)
    (if (contains? #{".gravity" ".qst"} source-extension)
      (sh08-ram-suffix-match? source-path source-extension 0)
      false)
    false))

(defn sh08-ram-best-evidence [request resolution]
  (let [context (get request :b47-context)
        wrapper (get context :authenticated-wrapper)
        boundary (get wrapper :gravity-core-boundary)
        wrapper-core (get boundary :canonical-core-artifact)
        context-core (get context :canonical-core-artifact)
        coordinator (get request :coordinator-verification)]
    (if (= :accepted (get resolution :status))
      (let [core (get resolution :core)
            provenance (get context :provenance)]
        {:core core
         :provenance provenance
         :actual-source-path (get provenance :source-path)
         :source-extension (get coordinator :verified-source-extension)
         :provenance-status :authenticated-b47-core-provenance})
      (if (map? wrapper-core)
        (let [provenance (get wrapper :provenance)]
          {:core wrapper-core
           :provenance provenance
           :actual-source-path (get provenance :source-path)
           :source-extension (get coordinator :verified-source-extension)
           :provenance-status :retained-b47-wrapper-provenance})
        (if (map? context-core)
          (let [provenance (get context :provenance)]
            {:core context-core
             :provenance provenance
             :actual-source-path (get provenance :source-path)
             :source-extension (get coordinator :verified-source-extension)
             :provenance-status :retained-b47-context-provenance})
          {:core {}
           :provenance {}
           :actual-source-path nil
           :source-extension nil
           :provenance-status :no-authenticated-provenance-available})))))

(defn sh08-ram-symbol-vector? [values]
  (if (vector? values)
    (if (> (count values) 0)
      (loop [remaining values seen #{}]
        (if (= 0 (count remaining))
          true
          (let [value (first remaining)]
            (if (symbol? value)
              (if (contains? seen value)
                false
                (recur (rest remaining) (conj seen value)))
              false))))
      false)
    false))

(defn sh08-ram-program-shape? [program]
  (if (sh08-ft-record-shape?
       program
       #{:record-construction-definition :record-access-definition
         :union-construction-definition :union-match-definition})
    (if (symbol? (get program :record-construction-definition))
      (if (symbol? (get program :record-access-definition))
        (if (symbol? (get program :union-construction-definition))
          (symbol? (get program :union-match-definition))
          false)
        false)
      false)
    false))

(defn sh08-ram-record-construction-shape? [construction]
  (if (sh08-ft-record-shape? construction #{:type :fields})
    (if (keyword? (get construction :type))
      (sh08-ru-all-field-values-valid? (get construction :fields))
      false)
    false))

(defn sh08-ram-record-access-shape? [access]
  (if (sh08-ft-record-shape? access #{:record-definition :field})
    (if (symbol? (get access :record-definition))
      (keyword? (get access :field))
      false)
    false))

(defn sh08-ram-union-construction-shape? [construction]
  (if (sh08-ft-record-shape?
       construction #{:type :variant :payload})
    (if (keyword? (get construction :type))
      (if (keyword? (get construction :variant))
        (if (= :gravity.type/unknown
               (sh08-ru-value-type (get construction :payload)))
          false
          true)
        false)
      false)
    false))

(defn sh08-ram-match-shape? [match-source]
  (if (sh08-ft-record-shape?
       match-source
       #{:union-type :scrutinee-definition :branch-definitions})
    (if (keyword? (get match-source :union-type))
      (if (symbol? (get match-source :scrutinee-definition))
        (sh08-ram-symbol-vector?
         (get match-source :branch-definitions))
        false)
      false)
    false))

(defn sh08-ram-branch-shape? [branch]
  (if (sh08-ft-record-shape?
       branch
       #{:variant :binding :pattern-payload-type :result})
    (if (keyword? (get branch :variant))
      (if (keyword? (get branch :binding))
        (if (sh08-ru-supported-type?
             (get branch :pattern-payload-type))
          (if (= :gravity.type/unknown
                 (sh08-ru-value-type (get branch :result)))
            false
            true)
          false)
        false)
      false)
    false))

(defn sh08-ram-resolve-branches [core names]
  (loop [remaining names sources []]
    (if (= 0 (count remaining))
      {:status :accepted :sources sources}
      (let [name (first remaining)
            source (sh08-ru-family-from-core core name)]
        (if (= :accepted (get source :status))
          (recur (rest remaining) (conj sources source))
          {:status :rejected
           :rule "C7-VERIFY"
           :reason :match-branch-definition-required
           :expected :named-map-definition
           :actual name
           :node (get source :node)})))))

(defn sh08-ram-program-error [program-source reason expected actual node]
  {:status :rejected
   :rule "C7-VERIFY"
   :reason reason
   :expected expected
   :actual actual
   :node (if (= node nil) (get program-source :node) node)})

(defn sh08-ram-resolve-program [core input-definition]
  (let [program-source
        (sh08-ru-family-from-core core input-definition)]
    (if (= :accepted (get program-source :status))
      (let [program (get program-source :family)]
        (if (sh08-ram-program-shape? program)
          (let [record-name
                (get program :record-construction-definition)
                access-name (get program :record-access-definition)
                union-name (get program :union-construction-definition)
                match-name (get program :union-match-definition)
                record-source (sh08-ru-family-from-core core record-name)
                access-source (sh08-ru-family-from-core core access-name)
                union-source (sh08-ru-family-from-core core union-name)
                match-source (sh08-ru-family-from-core core match-name)]
            (if (= :accepted (get record-source :status))
              (if (= :accepted (get access-source :status))
                (if (= :accepted (get union-source :status))
                  (if (= :accepted (get match-source :status))
                    (if (sh08-ram-match-shape?
                         (get match-source :family))
                      (let [branches
                            (sh08-ram-resolve-branches
                             core
                             (get (get match-source :family)
                                  :branch-definitions))]
                        (if (= :accepted (get branches :status))
                          {:status :accepted
                           :program-source program-source
                           :program program
                           :record-source record-source
                           :record-name record-name
                           :access-source access-source
                           :access-name access-name
                           :union-source union-source
                           :union-name union-name
                           :match-source match-source
                           :match-name match-name
                           :branch-sources (get branches :sources)}
                          branches))
                      (sh08-ram-program-error
                       program-source :union-match-shape-invalid
                       :closed-node-linked-union-match
                       (get match-source :family)
                       (get match-source :node)))
                    (sh08-ram-program-error
                     program-source :union-match-definition-required
                     :named-map-definition match-name
                     (get match-source :node)))
                  (sh08-ram-program-error
                   program-source :union-construction-definition-required
                   :named-map-definition union-name
                   (get union-source :node)))
                (sh08-ram-program-error
                 program-source :record-access-definition-required
                 :named-map-definition access-name
                 (get access-source :node)))
              (sh08-ram-program-error
               program-source :record-construction-definition-required
               :named-map-definition record-name
               (get record-source :node))))
          (sh08-ram-program-error
           program-source :typing-program-shape-invalid
           :closed-node-linked-typing-program program
           (get program-source :node))))
      {:status :rejected
       :rule "C7-VERIFY"
       :reason :authenticated-typing-program-required
       :expected :named-map-definition
       :actual (get program-source :reason)
       :node (get program-source :node)})))

(defn sh08-ram-first-extra-field [schema-fields value-fields]
  (if (= 0 (count value-fields))
    nil
    (let [value-field (first value-fields)]
      (if (= nil
             (sh08-ru-entry-by
              schema-fields :name (get value-field :name)))
        value-field
        (sh08-ram-first-extra-field
         schema-fields (rest value-fields))))))

(defn sh08-ram-first-invalid-branch-source [branch-sources]
  (if (= 0 (count branch-sources))
    nil
    (let [source (first branch-sources)]
      (if (sh08-ram-branch-shape? (get source :family))
        (sh08-ram-first-invalid-branch-source (rest branch-sources))
        source))))

(defn sh08-ram-first-duplicate-branch [branch-sources seen]
  (if (= 0 (count branch-sources))
    nil
    (let [source (first branch-sources)
          variant (get (get source :family) :variant)]
      (if (contains? seen variant)
        source
        (sh08-ram-first-duplicate-branch
         (rest branch-sources) (conj seen variant))))))

(defn sh08-ram-branch-values [branch-sources]
  (loop [remaining branch-sources values []]
    (if (= 0 (count remaining))
      values
      (recur
       (rest remaining)
       (conj values (get (first remaining) :family))))))

(defn sh08-ram-check-record [descriptor sources]
  (let [record-type (get descriptor :record-type)
        construction-source (get sources :record-source)
        construction (get construction-source :family)
        access-source (get sources :access-source)
        access (get access-source :family)
        program (get sources :program)
        schema-fields (get record-type :fields)]
    (if (sh08-ram-record-construction-shape? construction)
      (let [value-fields (get construction :fields)
            missing
            (sh08-ru-first-missing-field schema-fields value-fields)
            extra (sh08-ram-first-extra-field schema-fields value-fields)]
        (if (= (get record-type :name) (get construction :type))
          (if (= nil missing)
            (if (= nil extra)
              (let [mismatch
                    (sh08-ru-first-field-type-mismatch
                     schema-fields value-fields)]
                (if (= nil mismatch)
                  (if (sh08-ram-record-access-shape? access)
                    (if (= (get access :record-definition)
                           (get program :record-construction-definition))
                      (if (= nil
                             (sh08-ru-entry-by
                              schema-fields :name (get access :field)))
                        {:status :rejected
                         :rule "C7-TYPE-MISMATCH"
                         :reason :record-access-invalid-field
                         :expected
                         (sh08-ru-name-values schema-fields :name)
                         :actual (get access :field)
                         :node (get access-source :node)}
                        {:status :accepted})
                      {:status :rejected
                       :rule "C7-VERIFY"
                       :reason :record-access-definition-substitution
                       :expected
                       (get program :record-construction-definition)
                       :actual (get access :record-definition)
                       :node (get access-source :node)})
                    {:status :rejected
                     :rule "C7-VERIFY"
                     :reason :record-access-shape-invalid
                     :expected :node-linked-record-access
                     :actual access
                     :node (get access-source :node)})
                  {:status :rejected
                   :rule "C7-TYPE-MISMATCH"
                   :reason :record-field-type-mismatch
                   :expected (get mismatch :expected)
                   :actual (get mismatch :actual)
                   :node (get construction-source :node)}))
              {:status :rejected
               :rule "C7-TYPE-MISMATCH"
               :reason :record-extra-field
               :expected (sh08-ru-name-values schema-fields :name)
               :actual (get extra :name)
               :node (get construction-source :node)})
            {:status :rejected
             :rule "C7-TYPE-MISMATCH"
             :reason :record-missing-field
             :expected (get missing :name)
             :actual (sh08-ru-name-values value-fields :name)
             :node (get construction-source :node)})
          {:status :rejected
           :rule "C7-TYPE-MISMATCH"
           :reason :record-construction-type-mismatch
           :expected (get record-type :name)
           :actual (get construction :type)
           :node (get construction-source :node)}))
      {:status :rejected
       :rule "C7-VERIFY"
       :reason :record-construction-shape-invalid
       :expected :closed-record-construction
       :actual construction
       :node (get construction-source :node)})))

(defn sh08-ram-first-pattern-mismatch [variants branch-sources]
  (if (= 0 (count branch-sources))
    nil
    (let [source (first branch-sources)
          branch (get source :family)
          variant
          (sh08-ru-entry-by variants :tag (get branch :variant))]
      (if (= variant nil)
        (sh08-ram-first-pattern-mismatch
         variants (rest branch-sources))
        (if (= (get variant :payload-type)
               (get branch :pattern-payload-type))
          (sh08-ram-first-pattern-mismatch
           variants (rest branch-sources))
          {:source source
           :expected (get variant :payload-type)
           :actual (get branch :pattern-payload-type)})))))

(defn sh08-ram-check-union [descriptor sources]
  (let [union-type (get descriptor :union-type)
        construction-source (get sources :union-source)
        construction (get construction-source :family)
        match-source (get sources :match-source)
        match-value (get match-source :family)
        program (get sources :program)
        variants (get union-type :variants)
        branch-sources (get sources :branch-sources)]
    (if (sh08-ram-union-construction-shape? construction)
      (if (sh08-ram-match-shape? match-value)
        (if (= (get match-value :scrutinee-definition)
               (get program :union-construction-definition))
          (if (= (get union-type :name) (get construction :type))
            (let [variant
                  (sh08-ru-entry-by
                   variants :tag (get construction :variant))]
              (if (= variant nil)
                {:status :rejected
                 :rule "C7-TYPE-MISMATCH"
                 :reason :union-invalid-variant
                 :expected (sh08-ru-name-values variants :tag)
                 :actual (get construction :variant)
                 :node (get construction-source :node)}
                (if (= (get variant :payload-type)
                       (sh08-ru-value-type (get construction :payload)))
                  (if (= (get union-type :name)
                         (get match-value :union-type))
                    (let [invalid-shape
                          (sh08-ram-first-invalid-branch-source
                           branch-sources)]
                      (if (= nil invalid-shape)
                        (let [branches
                              (sh08-ram-branch-values branch-sources)
                              duplicate
                              (sh08-ram-first-duplicate-branch
                               branch-sources #{})
                              invalid
                              (sh08-ru-first-invalid-branch
                               variants branches)
                              missing
                              (sh08-ru-first-missing-variant
                               variants branches)]
                          (if (= nil duplicate)
                            (if (= nil invalid)
                              (if (= nil missing)
                                (if (= (count variants) (count branches))
                                  (let [pattern-mismatch
                                        (sh08-ram-first-pattern-mismatch
                                         variants branch-sources)
                                        result-type
                                        (sh08-ru-value-type
                                         (get (first branches) :result))
                                        result-mismatch
                                        (sh08-ru-first-branch-type-mismatch
                                         branches result-type)]
                                    (if (= nil pattern-mismatch)
                                      (if (= nil result-mismatch)
                                        {:status :accepted
                                         :match-expression-type result-type}
                                        {:status :rejected
                                         :rule "C7-TYPE-MISMATCH"
                                         :reason
                                         :union-match-branch-type-mismatch
                                         :expected
                                         (get result-mismatch :expected)
                                         :actual
                                         (get result-mismatch :actual)
                                         :node (get match-source :node)})
                                      {:status :rejected
                                       :rule "C7-TYPE-MISMATCH"
                                       :reason
                                       :union-match-contradictory-narrowing
                                       :expected
                                       (get pattern-mismatch :expected)
                                       :actual
                                       (get pattern-mismatch :actual)
                                       :node
                                       (get
                                        (get pattern-mismatch :source)
                                        :node)}))
                                  {:status :rejected
                                   :rule "C7-TYPE-MISMATCH"
                                   :reason :union-match-nonexhaustive
                                   :expected (count variants)
                                   :actual (count branches)
                                   :node (get match-source :node)})
                                {:status :rejected
                                 :rule "C7-TYPE-MISMATCH"
                                 :reason :union-match-nonexhaustive
                                 :expected (get missing :tag)
                                 :actual
                                 (sh08-ru-name-values branches :variant)
                                 :node (get match-source :node)})
                              {:status :rejected
                               :rule "C7-TYPE-MISMATCH"
                               :reason :union-match-invalid-variant
                               :expected :declared-union-variant
                               :actual (get invalid :variant)
                               :node (get match-source :node)})
                            {:status :rejected
                             :rule "C7-TYPE-MISMATCH"
                             :reason :union-match-unreachable-duplicate-variant
                             :expected :unique-closed-union-variants
                             :actual
                             (get (get duplicate :family) :variant)
                             :node (get duplicate :node)}))
                        {:status :rejected
                         :rule "C7-VERIFY"
                         :reason :union-match-branch-shape-invalid
                         :expected :node-linked-union-pattern-branch
                         :actual (get invalid-shape :family)
                         :node (get invalid-shape :node)}))
                    {:status :rejected
                     :rule "C7-TYPE-MISMATCH"
                     :reason :union-match-type-mismatch
                     :expected (get union-type :name)
                     :actual (get match-value :union-type)
                     :node (get match-source :node)})
                  {:status :rejected
                   :rule "C7-TYPE-MISMATCH"
                   :reason :union-payload-type-mismatch
                   :expected (get variant :payload-type)
                   :actual
                   (sh08-ru-value-type (get construction :payload))
                   :node (get construction-source :node)})))
            {:status :rejected
             :rule "C7-TYPE-MISMATCH"
             :reason :union-construction-type-mismatch
             :expected (get union-type :name)
             :actual (get construction :type)
             :node (get construction-source :node)})
          {:status :rejected
           :rule "C7-VERIFY"
           :reason :union-match-scrutinee-substitution
           :expected (get program :union-construction-definition)
           :actual (get match-value :scrutinee-definition)
           :node (get match-source :node)})
        {:status :rejected
         :rule "C7-VERIFY"
         :reason :union-match-shape-invalid
         :expected :closed-node-linked-union-match
         :actual match-value
         :node (get match-source :node)})
      {:status :rejected
       :rule "C7-VERIFY"
       :reason :union-construction-shape-invalid
       :expected :closed-union-construction
       :actual construction
       :node (get construction-source :node)})))

(defn sh08-ram-constraint [kind definition source expected actual]
  (let [node (get source :node)
        source-record (get node :source)
        request
        {:domain :gravity/sh08-record-access-match-constraint-v1
         :kind kind
         :definition definition
         :core-node-id (get node :node-id)
         :syntax-id (get source-record :syntax-id)
         :expected expected
         :actual actual}]
    {:constraint-id :coordinator-digest-required
     :constraint-id-request request
     :kind kind
     :definition definition
     :core-node-id (get node :node-id)
     :syntax-id (get source-record :syntax-id)
     :source-span (get source-record :semantic-span)
     :expected expected
     :actual actual
     :status :solved
     :solution :satisfied
     :invalidation [:core-node-change :descriptor-change :source-change]}))

(defn sh08-ram-record-facts [record-type definition source]
  (let [node (get source :node)
        source-record (get node :source)
        construction (get source :family)
        schema-fields (get record-type :fields)
        value-fields (get construction :fields)]
    (loop [remaining schema-fields facts []]
      (if (= 0 (count remaining))
        facts
        (let [schema (first remaining)
              value
              (sh08-ru-entry-by
               value-fields :name (get schema :name))]
          (recur
           (rest remaining)
           (conj facts
                 {:artifact :gravity/c7-record-field-type-fact
                  :definition definition
                  :core-node-id (get node :node-id)
                  :syntax-id (get source-record :syntax-id)
                  :source-span (get source-record :semantic-span)
                  :origin-chain (get source-record :origin-chain)
                  :generated-origin (get source-record :generated-origin)
                  :record-type (get record-type :name)
                  :field (get schema :name)
                  :declared-type (get schema :type)
                  :actual-type
                  (sh08-ru-value-type (get value :value))
                  :value (get value :value)})))))))

(defn sh08-ram-record-constraints [record-type definition source]
  (let [schema-fields (get record-type :fields)
        value-fields (get (get source :family) :fields)]
    (loop [remaining schema-fields constraints []]
      (if (= 0 (count remaining))
        constraints
        (let [schema (first remaining)
              value
              (sh08-ru-entry-by
               value-fields :name (get schema :name))]
          (recur
           (rest remaining)
           (conj constraints
                 (sh08-ram-constraint
                  :record-field-equality definition source
                  (get schema :type)
                  (sh08-ru-value-type (get value :value))))))))))

(defn sh08-ram-branch-facts [union-type sources selected-variant]
  (let [variants (get union-type :variants)]
    (loop [remaining (get sources :branch-sources) facts []]
      (if (= 0 (count remaining))
        facts
        (let [source (first remaining)
              node (get source :node)
              source-record (get node :source)
              branch (get source :family)
              variant
              (sh08-ru-entry-by variants :tag (get branch :variant))
              binding-request
              {:domain :gravity/sh08-pattern-binding-v1
               :branch-core-node-id (get node :node-id)
               :branch-syntax-id (get source-record :syntax-id)
               :binding-name (get branch :binding)
               :narrowed-type (get variant :payload-type)}]
          (recur
           (rest remaining)
           (conj facts
                 {:artifact :gravity/c7-union-match-narrowing-fact
                 :branch-definition
                  (get (get source :definition) :name)
                  :core-node-id (get node :node-id)
                  :syntax-id (get source-record :syntax-id)
                  :source-span (get source-record :semantic-span)
                  :branch-core-node-id (get node :node-id)
                  :branch-syntax-id (get source-record :syntax-id)
                  :branch-source-span (get source-record :semantic-span)
                  :origin-chain (get source-record :origin-chain)
                  :generated-origin (get source-record :generated-origin)
                  :union-type (get union-type :name)
                  :variant (get branch :variant)
                  :pattern-payload-type
                  (get branch :pattern-payload-type)
                  :narrowed-payload-type (get variant :payload-type)
                  :pattern-binding-environment
                  {:scope-core-node-id (get node :node-id)
                   :bindings
                   [{:name (get branch :binding)
                     :type (get variant :payload-type)
                     :binding-id :coordinator-digest-required
                     :binding-id-request binding-request}]}
                  :guard :absent
                  :guard-effects #{}
                  :branch-result-type
                  (sh08-ru-value-type (get branch :result))
                  :selected?
                  (= selected-variant (get branch :variant))})))))))

(defn sh08-ram-branch-constraints [union-type sources]
  (let [variants (get union-type :variants)]
    (loop [remaining (get sources :branch-sources) constraints []]
      (if (= 0 (count remaining))
        constraints
        (let [source (first remaining)
              branch (get source :family)
              variant
              (sh08-ru-entry-by variants :tag (get branch :variant))]
          (recur
           (rest remaining)
           (conj constraints
                 (sh08-ram-constraint
                  :union-pattern-narrowing
                  (get (get source :definition) :name)
                  source
                  (get variant :payload-type)
                  (get branch :pattern-payload-type)))))))))

(defn sh08-ram-append [left right]
  (loop [remaining right result left]
    (if (= 0 (count remaining))
      result
      (recur (rest remaining) (conj result (first remaining))))))

(defn sh08-ram-type-table [descriptor sources match-type]
  (let [record-node (get (get sources :record-source) :node)
        access-node (get (get sources :access-source) :node)
        union-node (get (get sources :union-source) :node)
        match-node (get (get sources :match-source) :node)
        record-type
        {:kind :closed-record
         :name (get (get descriptor :record-type) :name)}
        union-type
        {:kind :closed-union
         :name (get (get descriptor :union-type) :name)}]
    (loop [remaining (get sources :branch-sources)
           table
           {(get record-node :node-id) record-type
            (get access-node :node-id)
            (get
             (sh08-ru-entry-by
              (get (get descriptor :record-type) :fields)
              :name
              (get (get (get sources :access-source) :family) :field))
             :type)
            (get union-node :node-id) union-type
            (get match-node :node-id) match-type}]
      (if (= 0 (count remaining))
        table
        (let [source (first remaining)
              node (get source :node)
              branch (get source :family)]
          (recur
           (rest remaining)
           (assoc table
                  (get node :node-id)
                  (sh08-ru-value-type (get branch :result)))))))))

(defn sh08-ram-diagnostic
  [evidence node descriptor-definition input-definition
   rule expected actual reason]
  (let [core (get evidence :core)
        module (get core :module)
        source-record (get node :source)
        identity
        {:domain :gravity/sh08-record-access-match-typing-diagnostic-v2
         :rule rule
         :stage :type-checking
         :core-artifact-id (get core :artifact-id)
         :descriptor-definition descriptor-definition
         :input-definition input-definition
         :core-node-id (get node :node-id)
         :syntax-id (get source-record :syntax-id)
         :source-span (get source-record :semantic-span)
         :actual-source-path (get evidence :actual-source-path)
         :expected expected
         :actual actual
         :profile (get module :profile)
         :target (get module :target)
         :reason reason}]
    {:artifact :gravity/c7-record-access-match-typing-diagnostic
     :diagnostic-id :coordinator-digest-required
     :diagnostic-id-request identity
     :rule rule
     :severity :error
     :stage :type-checking
     :core-artifact-id (get core :artifact-id)
     :descriptor-definition descriptor-definition
     :input-definition input-definition
     :core-node-id (get node :node-id)
     :syntax-id (get source-record :syntax-id)
     :source-span (get source-record :semantic-span)
     :actual-source-path (get evidence :actual-source-path)
     :source-extension (get evidence :source-extension)
     :provenance-status (get evidence :provenance-status)
     :binding-id (first (get node :resolved-binding-ids))
     :type-id nil
     :constraint-id nil
     :expected-type expected
     :actual-type actual
     :profile (get module :profile)
     :target (get module :target)
     :origin-chain (get source-record :origin-chain)
     :generated-origin (get source-record :generated-origin)
     :reason reason
     :remediation
     {:action :repair-authenticated-node-linked-type-input
      :requirements
      [:exact-authenticated-descriptor-result
       :exact-b47-context-digest-path-and-extension
       :separate-authenticated-core-nodes
       :complete-exact-record-field-set
       :declared-field-value-types
       :declared-union-variant
       :exhaustive-noncontradictory-branch-patterns
       :consistent-match-result-type]}}))

(defn sh08-ram-rejected
  [evidence descriptor-definition input-definition node checked]
  (let [core (get evidence :core)
        source-record (get node :source)]
    {:artifact :gravity/sh08-record-access-match-typed-core
     :schema-version 2
     :status :rejected
     :scope :bounded-authenticated-node-linked-type-facts
     :module (get core :module)
     :sh07-shaped-artifact-id (get core :artifact-id)
     :descriptor-definition descriptor-definition
     :input-definition input-definition
     :core-node-id (get node :node-id)
     :syntax-id (get source-record :syntax-id)
     :source-span (get source-record :semantic-span)
     :actual-source-path (get evidence :actual-source-path)
     :source-extension (get evidence :source-extension)
     :provenance-status (get evidence :provenance-status)
     :provenance (get evidence :provenance)
     :diagnostics
     [(sh08-ram-diagnostic
       evidence node descriptor-definition input-definition
       (get checked :rule) (get checked :expected)
       (get checked :actual) (get checked :reason))]
     :pending [:surface-record-union-syntax
               :general-pattern-compiler
               :match-guards-and-effects
               :default-and-unreachable-branch-analysis
               :general-pattern-binding-environments
               :complete-branch-provenance
               :complete-constraint-ledger
               :ownership-and-linear-pattern-moves
               :safe-classification
               :generics :protocols :dynamic-dispatch
               :layout-and-allocation :runtime-behavior
               :native-gravity-cryptographic-verification
               :clojure-jvm-digest-authority-retained
               :sh07-completion :sh08-completion]}))

(defn sh08-ram-accepted
  [evidence descriptor-result descriptor-definition input-definition
   sources checked]
  (let [core (get evidence :core)
        descriptor (get descriptor-result :descriptor)
        record-type (get descriptor :record-type)
        union-type (get descriptor :union-type)
        record-source (get sources :record-source)
        access-source (get sources :access-source)
        union-source (get sources :union-source)
        match-source (get sources :match-source)
        access (get access-source :family)
        construction (get record-source :family)
        access-schema
        (sh08-ru-entry-by
         (get record-type :fields) :name (get access :field))
        access-value
        (sh08-ru-entry-by
         (get construction :fields) :name (get access :field))
        union-construction (get union-source :family)
        branch-sources (get sources :branch-sources)
        branches (sh08-ram-branch-values branch-sources)
        selected-branch
        (sh08-ru-entry-by
         branches :variant (get union-construction :variant))
        match-type (get checked :match-expression-type)
        record-facts
        (sh08-ram-record-facts
         record-type (get sources :record-name) record-source)
        branch-facts
        (sh08-ram-branch-facts
         union-type sources (get union-construction :variant))
        record-constraints
        (sh08-ram-record-constraints
         record-type (get sources :record-name) record-source)
        branch-constraints
        (sh08-ram-branch-constraints union-type sources)
        access-constraint
        (sh08-ram-constraint
         :record-field-access (get sources :access-name) access-source
         (get access-schema :type) (get access-schema :type))
        union-constraint
        (sh08-ram-constraint
         :union-construction (get sources :union-name) union-source
         (get
          (sh08-ru-entry-by
           (get union-type :variants) :tag
           (get union-construction :variant))
          :payload-type)
         (sh08-ru-value-type (get union-construction :payload)))
        match-constraint
        (sh08-ram-constraint
         :match-expression-result (get sources :match-name) match-source
         match-type match-type)
        constraints
        (conj
         (sh08-ram-append
          (conj
           (conj record-constraints access-constraint)
           union-constraint)
          branch-constraints)
         match-constraint)
        semantic-input
        {:program (get sources :program)
         :record-construction (get record-source :family)
         :record-access (get access-source :family)
         :union-construction (get union-source :family)
         :union-match (get match-source :family)
         :branches branches}
        identity-input
        {:domain :gravity/sh08-record-access-match-typing-v2
         :sh07-shaped-artifact-id (get core :artifact-id)
         :descriptor-identity-input (get descriptor-result :identity-input)
         :descriptor-definition descriptor-definition
         :input-definition input-definition
         :semantic-input semantic-input}]
    {:artifact :gravity/sh08-record-access-match-typed-core
     :schema-version 2
     :status :accepted
     :scope :bounded-authenticated-node-linked-type-facts
     :executable-gravity-type-behavior? true
     :roadmap-credit? false
     :module (get core :module)
     :sh07-shaped-artifact-id (get core :artifact-id)
     :descriptor-definition descriptor-definition
     :input-definition input-definition
     :descriptor-identity-input (get descriptor-result :identity-input)
     :typed-core
     {:artifact :gravity/bounded-typed-core
      :types (sh08-ram-type-table descriptor sources match-type)
      :diagnostics []}
     :record-construction-type-facts record-facts
     :record-access-type-fact
     {:artifact :gravity/c7-record-access-type-fact
      :definition (get sources :access-name)
      :core-node-id (get (get access-source :node) :node-id)
      :syntax-id
      (get (get (get access-source :node) :source) :syntax-id)
      :source-span
      (get (get (get access-source :node) :source) :semantic-span)
      :record-definition (get access :record-definition)
      :record-type (get record-type :name)
      :field (get access :field)
      :result-type (get access-schema :type)
      :value (get access-value :value)}
     :union-construction-type-fact
     {:artifact :gravity/c7-union-construction-type-fact
      :definition (get sources :union-name)
      :core-node-id (get (get union-source :node) :node-id)
      :syntax-id
      (get (get (get union-source :node) :source) :syntax-id)
      :source-span
      (get (get (get union-source :node) :source) :semantic-span)
      :union-type (get union-type :name)
      :variant (get union-construction :variant)
      :payload-type
      (sh08-ru-value-type (get union-construction :payload))}
     :union-match-narrowing-facts branch-facts
     :pattern-binding-environments
     (loop [remaining branch-facts environments []]
       (if (= 0 (count remaining))
         environments
         (recur
          (rest remaining)
          (conj environments
                (get (first remaining)
                     :pattern-binding-environment)))))
     :match-expression-type-fact
     {:artifact :gravity/c7-match-expression-type-fact
      :definition (get sources :match-name)
      :core-node-id (get (get match-source :node) :node-id)
      :syntax-id
      (get (get (get match-source :node) :source) :syntax-id)
      :source-span
      (get (get (get match-source :node) :source) :semantic-span)
      :scrutinee-type
      {:kind :closed-union :name (get union-type :name)}
      :expression-type match-type
      :exhaustiveness :closed-total
      :branch-count (count branch-facts)
      :guard-effects #{}
      :selected-result (get selected-branch :result)}
     :constraint-ledger
     {:artifact :gravity/c7-bounded-constraint-ledger
      :constraints constraints
      :unsolved []
      :status :solved}
     :diagnostics []
     :artifact-id-request identity-input
     :identity-input identity-input
     :identity-resolution :coordinator-digest-required
     :actual-source-path (get evidence :actual-source-path)
     :source-extension (get evidence :source-extension)
     :provenance-status (get evidence :provenance-status)
     :provenance (get evidence :provenance)
     :pending [:surface-record-union-syntax
               :general-pattern-compiler
               :match-guards-and-effects
               :default-and-unreachable-branch-analysis
               :general-pattern-binding-environments
               :complete-branch-provenance
               :complete-constraint-ledger
               :ownership-and-linear-pattern-moves
               :safe-classification
               :generics :protocols :dynamic-dispatch
               :layout-and-allocation :runtime-behavior
               :native-gravity-cryptographic-verification
               :clojure-jvm-digest-authority-retained
               :sh07-completion :sh08-completion]}))

(defn sh08-record-access-match-typing-boundary-policy []
  {:invariant-family :self-hosting/sh08-record-access-match-typing-v1
   :descriptor-invariant :self-hosting/sh08-records-unions
   :descriptor-authentication
   :exact-recomputation-from-authenticated-b47-core
   :input-authentication
   :separate-named-map-nodes-in-same-authenticated-b47-core
   :narrowing-source :derived-union-variant-payload-type
   :pattern-annotation-checking? true
   :node-linked-type-facts? true
   :branch-spans? true
   :bounded-pattern-binding-environments? true
   :bounded-constraint-ledger? true
   :overall-match-expression-type? true
   :closed-record-construction-and-access-only? true
   :closed-union-match-narrowing-only? true
   :executable-gravity-type-behavior? true
   :roadmap-credit? false
   :general-pattern-compiler? false
   :match-guards-and-effects :pending
   :defaults-and-unreachable-branches :pending
   :general-pattern-binding-environments :pending
   :complete-branch-provenance :pending
   :complete-constraint-ledger :pending
   :ownership-and-linear-pattern-moves :pending
   :safe-classification :pending
   :runtime-behavior? false
   :independent-gravity-cryptographic-verification? false
   :host-digest-authority-retained? true
   :clojure-jvm-digest-authority-retained? true
   :native-gravity-cryptographic-verification :pending})

(defn sh08-record-access-match-typed-core-artifact
  [request descriptor-definition input-definition descriptor-candidate]
  (let [resolution (sh08-ft-authenticated-core request)
        evidence (sh08-ram-best-evidence request resolution)
        core (get evidence :core)]
    (if (= :accepted (get resolution :status))
      (if (sh08-ram-path-extension-valid?
           (get evidence :actual-source-path)
           (get evidence :source-extension))
      (let [descriptor-result
            (sh08-record-union-type-core-artifact
             request descriptor-definition)
            sources (sh08-ram-resolve-program core input-definition)
            node
            (if (= :accepted (get sources :status))
              (get (get sources :program-source) :node)
              (get sources :node))]
        (if (= :accepted (get descriptor-result :status))
          (if (= descriptor-result descriptor-candidate)
            (if (= :accepted (get sources :status))
              (let [record-check
                    (sh08-ram-check-record
                     (get descriptor-result :descriptor) sources)]
                (if (= :accepted (get record-check :status))
                  (let [union-check
                        (sh08-ram-check-union
                         (get descriptor-result :descriptor) sources)]
                    (if (= :accepted (get union-check :status))
                      (sh08-ram-accepted
                       evidence descriptor-result descriptor-definition
                       input-definition sources union-check)
                      (sh08-ram-rejected
                       evidence descriptor-definition input-definition
                       (get union-check :node) union-check)))
                  (sh08-ram-rejected
                   evidence descriptor-definition input-definition
                   (get record-check :node) record-check)))
              (sh08-ram-rejected
               evidence descriptor-definition input-definition node sources))
            (sh08-ram-rejected
             evidence descriptor-definition input-definition node
             {:rule "C7-VERIFY"
              :reason
              (if (= (get descriptor-result :provenance)
                     (get descriptor-candidate :provenance))
                :descriptor-fact-substitution
                :descriptor-provenance-substitution)
              :expected :exact-recomputed-descriptor-result
              :actual :substituted-descriptor-result}))
          (sh08-ram-rejected
           evidence descriptor-definition input-definition node
           {:rule "C7-VERIFY"
            :reason :authenticated-descriptor-required
            :expected :accepted-integrated-descriptor
            :actual (get descriptor-result :status)})))
      (sh08-ram-rejected
       evidence descriptor-definition input-definition
       (get (sh08-ru-family-from-core core input-definition) :node)
       {:rule "C7-VERIFY"
        :reason :source-extension-path-mismatch
        :expected (get evidence :actual-source-path)
        :actual (get evidence :source-extension)}))
      (sh08-ram-rejected
       evidence descriptor-definition input-definition
       (get (sh08-ru-family-from-core core input-definition) :node)
       {:rule "C7-VERIFY"
        :reason (get resolution :reason)
        :expected :host-resolved-authentic-b47-context
        :actual (get resolution :reason)}))))

(defn sh08-verify-record-access-match-typing-result
  [request descriptor-definition input-definition descriptor-candidate
   candidate]
  (let [expected
        (sh08-record-access-match-typed-core-artifact
         request descriptor-definition input-definition descriptor-candidate)]
    {:artifact :gravity/sh08-record-access-match-typing-verification
     :status (if (= expected candidate) :passed :rejected)
     :checks [:authenticated-b47-core-context-digest-path-and-extension
              :integrated-descriptor-exactly-recomputed
              :typing-program-and-component-nodes-source-bound
              :record-construction-field-facts-node-linked
              :record-access-result-fact-node-linked
              :closed-union-variant-fact-node-linked
              :branch-spans-and-pattern-bindings-preserved
              :exhaustive-derived-match-narrowing
              :match-expression-type-derived
              :bounded-constraint-ledger-solved
              :result-identity-fact-and-provenance-mutation-rejected]
     :expected expected
     :candidate candidate}))
(defn verify-c7-type-checker [typed-core-artifact]
  (quote {:status :stage1-source-owned
          :typed-core-artifact typed-core-artifact
          :checks [:every-core-node-typed-or-diagnosed
                   :function-types-record-latent-effects
                   :function-types-record-capabilities
                   :function-types-record-ownership-constraints
                   :local-inference-deterministic
                   :profile-required-facts-rejected-when-missing
                   :dynamic-boundaries-explicit
                   :casts-and-conversions-checked
                   :generics-and-protocol-dispatch-artifacted
                   :schema-derived-types-preserve-schema-identity
                   :typed-core-verifier-before-effects]
          :diagnostics c7-type-diagnostic-catalog
          :preserves [:source-spans :syntax-identity
                      :binding-identity :namespace-context
                      :profile-target-metadata
                      :effect-capability-metadata
                      :core-node-identity :dynamic-boundaries
                      :schema-identity :layout-facts
                      :ownership-resource-type-facts
                      :latent-effects :thrown-error-effects
                      :artifact-provenance]}))

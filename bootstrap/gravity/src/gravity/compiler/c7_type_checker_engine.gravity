          function (if (sh08-sse-ids? [owner] 1) (get functions owner) nil)
          types (if (map? function)
                  (if (sh08-sse-ids? [(get function :function-core-node-id)] 1)
                    (assoc types (get function :function-core-node-id) function) types) types)
          derived (sh08-vsl-derive (get context :ordering-core) node
                    (get (get context :ordering-operators) (first (get node :children)))
                    (get (get context :ordering-edges) (get node :node-id))
                    (get context :lookup-nodes) (get context :ordering-bindings) types (get context :association-forms) )]
      derived))


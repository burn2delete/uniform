(defn sh08-ft-loop-kernel-prepare [core budget]
  (let [fields [:nodes :loop-bindings :recur-targets :recur-transfers :binding-table]
        key-fields [:node-id :binding-id :target-id :recur-core-node-id :binding-id]]
    (loop [fields fields key-fields key-fields indexes [] work 0]
      (if (= 0 (count fields))
        (let [nodes (get indexes 0) targets (get indexes 2)
              owners (sh08-ft-loop-kernel-index-records (loop [ids (keys targets) out []]
                                     (if (= 0 (count ids)) out
                                       (recur (rest ids) (conj out (get targets (first ids)))))) :owner-core-node-id (- budget work))
              parents (if (= :accepted (get owners :status))
                        (sh08-ft-loop-kernel-parent-index (get core :nodes) nodes (- budget work (get owners :work-count))) owners)]
          (if (= :accepted (get parents :status))
            (if (= [(count targets) (count (get indexes 3))] [(get parents :target-count) (get parents :transfer-count)])
            {:status :accepted :nodes nodes :bindings (get indexes 1) :source-bindings (get indexes 4) :targets targets :owners (get owners :index)
             :transfers (get indexes 3) :parents (get parents :index)
             :work-count (+ work (get owners :work-count) (get parents :work-count))}
             (sh08-ft-loop-kernel-failure :incomplete-loop-control-coverage nil :all-target-and-transfer-nodes nil
                      (+ work (get owners :work-count) (get parents :work-count))))
            (assoc parents :work-count (+ work (get owners :work-count) (if (= :accepted (get owners :status)) (get parents :work-count) 0)))))
        (let [records (get core (first fields))]
          (if (if (vector? records) (<= (count records) 65536) false)
            (let [indexed (sh08-ft-loop-kernel-index-records records (first key-fields) (- budget work))]
              (if (= :accepted (get indexed :status))
                (recur (rest fields) (rest key-fields) (conj indexes (get indexed :index)) (+ work (get indexed :work-count)))
                (assoc indexed :work-count (+ work (get indexed :work-count)))))
            (sh08-ft-loop-kernel-failure :invalid-loop-core-table nil :bounded-vector (first fields) work)))))))

(defn sh08-ft-loop-kernel-target-shape? [target node]
  (if (if (map? target) (if (vector? (get target :binding-ids)) (map? node) false) false)
    (let [kind (get target :target-kind) attrs (get node :attributes) children (get node :children)]
      (if (vector? children)
        (if (= [(get target :owner-form-id) (get target :owner-syntax-id) (get target :binding-ids) (get target :type-compatibility)]
               [(get (get node :source) :form-id) (get (get node :source) :syntax-id) (get node :resolved-binding-ids) :pending-sh08])
          (if (= (get target :arity) (count (get target :binding-ids)))
            (if (= kind :function) (= [:fn (get target :target-id) nil] [(get node :core-form) (get attrs :recur-target-id) (get target :parent-target-id)])
              (if (= kind :loop)
                (if (if (integer? (get target :arity))
                      (if (vector? (get attrs :initializer-child-indexes)) (vector? (get attrs :body-child-indexes)) false) false)
                  (if (> (count children) (get target :arity))

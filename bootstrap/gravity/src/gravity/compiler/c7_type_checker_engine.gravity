                  (conj constraints {:kind :loop-slot-type :binding-id id :initializer-node-id (get initializer :node-id)
                    :type type :source-loop-binding record :source-target target :status (if (sh08-ft-loop-kernel-known? type) :solved :pending)})
                  (+ work 1 (get visible :work-count)))
                (assoc visible :work-count (+ work 1 (get visible :work-count)))))
            (sh08-ft-loop-kernel-failure :incoherent-loop-slot (get node :node-id) :original-sequential-initializer record (+ work 1))))))))

(defn sh08-ft-loop-kernel-collect-slots [core prepared types bindings budget]
  (loop [targets (get core :recur-targets) out bindings slots {} constraints [] slot-count 0 work (get prepared :work-count)]
    (if (= 0 (count targets))
      (if (= slot-count (count (get core :loop-bindings)))
        {:status :accepted :bindings out :slots slots :constraints constraints :work-count work}
        (sh08-ft-loop-kernel-failure :incomplete-loop-slot-coverage nil :all-original-loop-bindings slot-count work))
      (if (>= work budget) (sh08-ft-loop-kernel-work-limit work)
        (let [target (first targets) node (get (get prepared :nodes) (get target :owner-core-node-id))
              nearest (if (= :function (get target :target-kind)) {:status :accepted :target nil :work-count 0}
                        (sh08-ft-loop-kernel-nearest-target (get node :node-id) (get prepared :nodes) (get prepared :parents) (get prepared :owners) (- budget work 1)))
              used (+ work 1 (get nearest :work-count))]
          (if (= :accepted (get nearest :status))
            (if (if (sh08-ft-loop-kernel-target-shape? target node)
                  (if (= (get target :parent-target-id) (get (get nearest :target) :target-id))
                    (= (get target :body-scope-id)
                       (get (get (get prepared :nodes)
                                 (get (get node :children) (if (= :loop (get target :target-kind)) (get target :arity) 0))) :binding-context)) false) false)
              (if (= :function (get target :target-kind)) (recur (rest targets) out slots constraints slot-count used)
                (let [result (sh08-ft-loop-kernel-loop-slots target node (get prepared :bindings) (get prepared :nodes) (get prepared :source-bindings) types out (- budget used))]
                  (if (= :accepted (get result :status))
                    (recur (rest targets) (get result :bindings) (assoc slots (get target :target-id) (get result :slots))
                           (sh08-ft-loop-kernel-append constraints (get result :constraints)) (+ slot-count (count (get result :slots))) (+ used (get result :work-count)))
                    (assoc result :work-count (+ used (get result :work-count))))))
              (sh08-ft-loop-kernel-failure :incoherent-loop-target (get node :node-id) :original-nearest-target target used))
            (assoc nearest :work-count used)))))))

(defn sh08-ft-loop-kernel-transfer-types [transfer target nodes types slots budget]
  (if (if (vector? slots) (= (count (get transfer :argument-node-ids)) (count slots)) false)
  (loop [args (get transfer :argument-node-ids) slots slots coordinate 0 values [] resolved true normal true work 0]
    (if (= 0 (count args)) {:status :accepted :argument-types values :resolved? resolved :normal-transfer? normal :work-count work}
      (if (>= work budget) (sh08-ft-loop-kernel-work-limit work)
        (let [id (first args) actual (get types id :gravity.type/unknown) expected (first slots)]
          (if (if (= actual :gravity.type/never) false
                (if (sh08-ft-loop-kernel-known? actual) (if (sh08-ft-loop-kernel-known? expected) (= false (= actual expected)) false) false))
            {:status :rejected :issues [{:rule "C7-TYPE-MISMATCH"
              :reason (if (= :function (get target :target-kind)) :function-recur-slot-type-mismatch :loop-recur-slot-type-mismatch) :core-node-id id
              :parameter-binding-id (get (get target :binding-ids) coordinate) :expected expected :actual actual}]
             :work-count (+ work 1) :work-unit :node-or-record-visit}
            (recur (rest args) (rest slots) (+ coordinate 1) (conj values actual)
                   (if (if (sh08-ft-loop-kernel-known? actual) (sh08-ft-loop-kernel-known? expected) false) resolved false)
                   (if (= actual :gravity.type/never) false normal) (+ work 1)))))))
    (sh08-ft-loop-kernel-failure :loop-transfer-slot-count (get transfer :recur-core-node-id) (count slots) (count (get transfer :argument-node-ids)) 0)))

(defn sh08-ft-loop-kernel-transfer-shape? [transfer target nearest node slots]
  (if (if (vector? (get transfer :argument-node-ids)) (if (map? target) (vector? (get node :children)) false) false)
    (if (= (count (get transfer :argument-node-ids)) (get target :arity))
      (if (if (= :loop (get target :target-kind))
            (if (vector? slots) (= (count slots) (get target :arity)) false) true)
        (if (sh08-ft-loop-kernel-ordered-children? node)
          (= [:recur target (get target :target-id) (get target :target-kind) (get target :arity)
              (get target :binding-ids) (get node :children) true :arguments-left-to-right :nearest-lexical-recur-target :pending-sh08
              (get target :target-id) (get target :target-kind) (get target :arity) :pending-sh08 :arguments-left-to-right-then-transfer
              (get (get node :source) :form-id) (get (get node :source) :syntax-id)]
             [(get node :core-form) (get nearest :target) (get transfer :target-id) (get transfer :target-kind) (get transfer :arity)
              (get node :resolved-binding-ids) (get transfer :argument-node-ids) (get transfer :tail-position) (get transfer :evaluation-order)
              (get transfer :transfer-policy) (get transfer :type-compatibility) (get (get node :attributes) :target-id)
              (get (get node :attributes) :target-kind) (get (get node :attributes) :arity) (get (get node :attributes) :type-compatibility)
              (get (get node :evaluation) :kind) (get transfer :recur-form-id) (get transfer :recur-syntax-id)]) false) false) false) false))

(defn sh08-ft-function-recur-slots [target node bindings budget]
  (let [names (get (get node :attributes) :parameters)
        declarations (get (get (get node :attributes) :signature) :parameters)]
    (loop [ids (get target :binding-ids) ordinal 0 slots [] work 0]
      (if (= 0 (count ids)) {:status :accepted :slots slots :work-count work}
        (if (>= work budget) (sh08-ft-loop-kernel-work-limit work)
          (let [id (first ids) binding (get bindings id)]
            (if (if (map? binding)
                  (if (vector? names)
                    (= [id (get names ordinal)] [(get binding :binding-id) (get binding :name)]) false) false)
              (recur (rest ids) (+ ordinal 1)
                     (conj slots (get (get declarations ordinal) :type-id :gravity.type/unknown)) (+ work 1))
              (sh08-ft-loop-kernel-failure :incoherent-function-recur-parameter
                (get node :node-id) :original-parameter-binding id (+ work 1)))))))))

(defn sh08-ft-loop-kernel-collect-transfers [core prepared types result budget]
  (loop [transfers (get core :recur-transfers) constraints (get result :constraints) work (get result :work-count)]
    (if (= 0 (count transfers)) {:status :accepted :bindings (get result :bindings) :constraints constraints :issues []
                                :work-count work :work-unit :node-or-record-visit}
      (if (>= work budget) (sh08-ft-loop-kernel-work-limit work)
        (let [transfer (first transfers) id (get transfer :recur-core-node-id) node (get (get prepared :nodes) id)
              target (get (get prepared :targets) (get transfer :target-id))
              nearest (sh08-ft-loop-kernel-nearest-target id (get prepared :nodes) (get prepared :parents) (get prepared :owners) (- budget work 1))
              function? (= :function (get target :target-kind))
              used (+ work 1 (get nearest :work-count))
              slot-result (if function?
                            (sh08-ft-function-recur-slots target
                              (get (get prepared :nodes) (get target :owner-core-node-id))
                              (get prepared :source-bindings) (- budget used))
                            {:status :accepted :slots (get (get result :slots) (get target :target-id)) :work-count 0})
              used (+ used (get slot-result :work-count)) slots (get slot-result :slots)]
          (if (= :accepted (get nearest :status))
            (if (sh08-ft-loop-kernel-transfer-shape? transfer target nearest node slots)
              (if (= :accepted (get slot-result :status))
                (if (if function? (if (contains? (set slots) :gravity.type/unknown) true (contains? (set slots) nil)) false)
                  (assoc (sh08-ft-loop-kernel-failure :function-recur-parameter-types-required id :declared-parameter-types slots used)
                         :issues [{:rule "C7-ANNOTATION" :reason :function-recur-parameter-types-required
                                   :core-node-id id :expected :declared-parameter-types :actual slots}])
                (let [checked (sh08-ft-loop-kernel-transfer-types transfer target (get prepared :nodes) types slots (- budget used))]
                  (if (= :accepted (get checked :status))
                    (recur (rest transfers) (conj constraints {:kind :loop-recur-type :source-transfer transfer :source-target target
                       :argument-types (get checked :argument-types) :slot-types slots
                       :result-type :gravity.type/never :normal-transfer? (get checked :normal-transfer?)
                       :status (if (get checked :resolved?) :solved :pending)})
                       (+ used (get checked :work-count)))
                    (assoc checked :work-count (+ used (get checked :work-count))))))
                (assoc slot-result :work-count used))
              (sh08-ft-loop-kernel-failure :incoherent-loop-transfer id :original-nearest-tail-transfer transfer used))
            (assoc nearest :work-count used)))))))

(defn sh08-ft-loop-type-step [core type-table binding-types budget]
  (if (if (integer? budget) (if (<= 0 budget) (<= budget 65536) false) false)
    (if (if (map? type-table) (map? binding-types) false)
      (let [prepared (sh08-ft-loop-kernel-prepare core budget)]
        (if (= :accepted (get prepared :status))
          (let [slots (sh08-ft-loop-kernel-collect-slots core prepared type-table binding-types budget)]
            (if (= :accepted (get slots :status)) (sh08-ft-loop-kernel-collect-transfers core prepared type-table slots budget) slots)) prepared))
      (sh08-ft-loop-kernel-failure :invalid-loop-type-tables nil :maps nil 0))
    (sh08-ft-loop-kernel-failure :invalid-loop-type-budget nil :bounded-visit-count budget 0)))

(defn sh08-ft-ordered-child-types [children type-table]
  (loop [remaining children out []]
    (if (= 0 (count remaining)) out
      (recur (rest remaining) (conj out (get type-table (first remaining) :gravity.type/unknown))))))

(defn sh08-ft-has-loop-control? [core]
  (loop [nodes (get core :nodes)]
    (if (= 0 (count nodes)) false
      (if (contains? #{:loop :recur} (get (first nodes) :core-form)) true (recur (rest nodes))))))

(defn sh08-ft-loop-working-core [core bindings]
  (if (sh08-ft-has-loop-control? core)
    (assoc core :binding-table bindings)
    nil))

(defn sh08-ft-loop-diagnostics [issues nodes]
  (loop [remaining issues out []]
    (if (= 0 (count remaining)) out
      (recur (rest remaining) (conj out (assoc (first remaining) :node (get nodes (get (first remaining) :core-node-id) {})))))))

(defn sh08-ft-loop-constraints [premises nodes module]
  (loop [remaining premises out []]
    (if (= 0 (count remaining)) out
      (let [premise (first remaining) slot? (= :loop-slot-type (get premise :kind))
            id (if slot? (get premise :initializer-node-id) (get (get premise :source-transfer) :recur-core-node-id))
            node (get nodes id) target (get premise :source-target)
            lhs (if slot? (get premise :binding-id) id)
            rhs (if slot? (get premise :type) :gravity.type/never)]
        (recur (rest remaining)
          (if (= :solved (get premise :status))
            (conj out {:constraint-id-request {:domain :gravity/sh08-loop-type-constraint-v1
                         :core-node-id id :binding-or-transfer lhs :target-id (get target :target-id) :premise premise}
              :kind :equality :producer-rule :sh08-loop-target-types-v1 :lhs lhs :rhs rhs
              :origin (get (get node :source) :origin-chain) :profile (get module :profile) :target (get module :target)
              :dependencies {:loop-premise premise :core-node-id id :target-owner-core-node-id (get target :owner-core-node-id)}
              :solution {:type rhs :slot-types (get premise :slot-types) :argument-types (get premise :argument-types)
                         :normal-transfer? (get premise :normal-transfer?)}
              :invalidation [:loop-bindings :recur-targets :recur-transfers :type-table :binding-table]
              :status :solved :diagnostics []}) out))))))

(defn sh08-ft-every-known? [values]
  (if (= (count values) 0)
    true
    (if (sh08-ft-known? (first values))
      (sh08-ft-every-known? (rest values))
      false)))

(defn sh08-ft-last-type [children type-table]
  (if (= (count children) 0)
    :gravity.type/unknown
    (get type-table
         (get children (- (count children) 1))
         :gravity.type/unknown)))

(defn sh08-ft-collection-type [node type-table]
  (let [kind (get (get node :attributes) :literal-kind)
        children (get node :children)
        child-types
        (loop [remaining children result []]
          (if (= (count remaining) 0)
            result
            (recur
             (rest remaining)
             (conj result
                   (get type-table (first remaining)
                        :gravity.type/unknown)))))]
    (if (sh08-ft-every-known? child-types)
      (if (= kind :vector)
        {:kind :gravity.type/vector
         :element-types child-types
         :shape :literal}
        (if (= kind :set)
          {:kind :gravity.type/set
           :element-types child-types
           :shape :literal}
          (if (= kind :map)
            (if (sh08-even-count? children)
              {:kind :gravity.type/map
               :member-types child-types
               :shape :literal}
              :gravity.type/unknown)
            :gravity.type/unknown)))
      :gravity.type/unknown)))

(defn sh08-ft-function-type-skeleton-base [record module]
  {:artifact :gravity/c7-function-type
   :function-id (get record :function-syntax-id)
   :function-core-node-id (get record :function-core-node-id)
   :body-core-node-id (get record :body-core-node-id)
   :definition-name (get record :definition-name)
   :parameter-binding-ids (get record :parameter-binding-ids)
   :parameters
   (loop [remaining (get record :parameter-binding-ids)
          values []]
     (if (= (count remaining) 0)
       values
       (recur
        (rest remaining)
        (conj values
              {:binding-id (first remaining)
               :type :gravity.type/unknown}))))
   :return :gravity.type/unknown
   :return-conflict nil
   :fixed-arity (get record :fixed-arity)
   :latent-effects (get module :effects)
   :capabilities (get module :capabilities)
   :ownership-constraints :pending-sh10
   :profile-constraints [(get module :profile)]
   :thrown-error-effects [:pending-sh09]
   :source-span nil
   :status :inferred})

(defn sh08-ft-apply-declarations [function signature]
      (assoc (assoc (assoc (assoc function :signature signature)
        :declaration-rule-version :sh08-atomic-function-signature-v1)
        :return (get (get signature :return) :type-id (get function :return)))
        :parameters
        (loop [parameters (get function :parameters) declarations (get signature :parameters) result []]
          (if (= (count parameters) 0) result
            (recur (rest parameters) (rest declarations)
              (conj result (assoc (first parameters) :type
                (get (first declarations) :type-id (get (first parameters) :type)))))))))

(defn sh08-ft-function-type-skeleton [record module]
  (let [base (sh08-ft-function-type-skeleton-base record module)]
    (if (contains? record :signature)
      (sh08-ft-apply-declarations base (get record :signature)) base)))

(defn sh08-ft-restore-declarations [completed base]
  (loop [ids (keys base) result completed]
    (if (= (count ids) 0) result
      (let [id (first ids) function (get base id)]
        (recur (rest ids)
          (if (contains? function :signature)
            (assoc result id (sh08-ft-apply-declarations (get result id) (get function :signature))) result))))))

(defn sh08-ft-declaration-seeds [functions initial]
  (loop [ids (keys functions) result initial]
    (if (= (count ids) 0) result
      (let [function (get functions (first ids))]
        (recur (rest ids)
          (loop [parameters (get function :parameters) declarations (get (get function :signature) :parameters)
                 values result]
            (if (= (count parameters) 0) values
              (recur (rest parameters) (rest declarations)
                (if (= (first declarations) nil) values
                  (assoc values (get (first parameters) :binding-id) (get (first declarations) :type-id)))))))))))

; The authoritative higher-order promotion is deliberately narrower than the
; fixture adapters: it derives one capture-free named identity function and
; one named apply-one function directly from the authenticated B47 core.  No
; HO1/HO2 result is accepted as a type premise here.
(defn sh08-ft-higher-order-reference?
  [node binding-id owner-function-syntax-id]
  (if (map? node)
    (if (= :reference (get node :core-form))
      (if (= binding-id (get (get node :attributes) :binding-id))
        (= owner-function-syntax-id
           (get (get node :evaluation) :owner-function-syntax-id))
        false)
      false)
    false))

(defn sh08-ft-authoritative-primitive-type? [value]
  (if (= value :gravity.type/integer)
    true
    (if (= value :gravity.type/bool)
      true
      (= value :gravity.type/string))))

(defn sh08-ft-authoritative-primitive-type-for-node [node]
  (if (map? node)
    (if (= :literal (get node :core-form))
      (let [candidate
            (sh08-primitive-type-from-literal-kind
             (get (get node :attributes) :literal-kind))]
        (if (sh08-ft-authoritative-primitive-type? candidate)
          candidate
          nil))
      nil)
    nil))

(defn sh08-ft-higher-order-call-node-valid?
  [call node expected-argument-count owner-function-syntax-id]
  (if (map? call)
    (if (map? node)
      (if (= :call (get node :core-form))
        (if (= expected-argument-count
               (count (get call :argument-node-ids)))
          (if (= (get call :ordered-evaluation-node-ids)
                 (get node :children))
            (if (= :operator-then-arguments
                   (get call :evaluation-order))
              (= owner-function-syntax-id
                 (get (get node :evaluation)
                      :owner-function-syntax-id))
              false)
            false)
          false)
        false)
      false)
    false))

(defn sh08-ft-higher-order-call-by-node-id
  [calls node-id]
  (if (= (count calls) 0)
    nil
    (if (= node-id (get (first calls) :core-node-id))
      (first calls)
      (sh08-ft-higher-order-call-by-node-id (rest calls) node-id))))

(defn sh08-ft-higher-order-identity-candidates
  [function-records nodes definitions]
  (loop [remaining function-records values []]
    (if (= (count remaining) 0)
      values
      (let [record (first remaining)
            function-node (get nodes (get record :function-core-node-id))
            definition
            (sh08-ft-definition-by-binding-id
             definitions (get record :definition-binding-id))
            parameter-ids (get record :parameter-binding-ids)
            body (get nodes (get record :body-core-node-id))]
        (if (if (= :named-top-level (get record :definition-kind))
              (if (= 1 (get record :fixed-arity))
                (if (= 1 (count parameter-ids))
                  (if (map? definition)
                    (if (map? function-node)
                      (if (= :fn (get function-node :core-form))
                        (sh08-ft-higher-order-reference?
                         body (first parameter-ids)
                         (get record :function-syntax-id))
                        false)
                      false)
                    false)
                  false)
                false)
              false)
          (recur (rest remaining)
                 (conj values
                       {:record record
                        :definition definition
                        :function-node function-node
                        :body body
                        :parameter-binding-id (first parameter-ids)}))
          (recur (rest remaining) values))))))

(defn sh08-ft-higher-order-outer-call
  [calls nodes apply-definition identity-definition]
  (if (= (count calls) 0)
    nil
    (let [call (first calls)
          node (get nodes (get call :core-node-id))
          argument-ids (get call :argument-node-ids)
          children (get node :children)
          function-value-node (get nodes (first argument-ids))
          value-node (get nodes (first (rest argument-ids)))]
      (if (if (= :call (get node :core-form))
            (if (= nil (get (get node :evaluation)
                            :owner-function-syntax-id))
              (if (= 2 (count argument-ids))
                (if (= (get call :operator-binding-id)
                       (get apply-definition :binding-id))
                  (if (= (get call :ordered-evaluation-node-ids)
                         children)
                    (if (= :operator-then-arguments
                           (get call :evaluation-order))
                      (if (= (get function-value-node :core-form)
                             :reference)
                        (if (= (get (get function-value-node :attributes)
                                  :binding-id)
                             (get identity-definition :binding-id))
                          (= (get value-node :core-form) :literal)
                          false)
                        false)
                      false)
                    false)
                  false)
                false)
              false)
            false)
        call
        (sh08-ft-higher-order-outer-call
         (rest calls) nodes apply-definition identity-definition)))))

(defn sh08-ft-higher-order-outer-edge-valid?
  [edge call function-record bindings]
  (let [definition-binding
        (sh08-ft-binding-by-id
         bindings (get function-record :definition-binding-id))]
  (if (map? edge)
    (if (= :local-function (get edge :classification))
      (if (= (get edge :call-core-node-id)
             (get call :core-node-id))
        (if (= (get edge :callee-binding-id)
               (get function-record :definition-binding-id))
          (if (= (get edge :callee-definition-syntax-id)
                 (get definition-binding :definition-syntax-id))
            (if (= (get edge :callee-function-syntax-id)
                   (get function-record :function-syntax-id))
              (if (= (get edge :callee-function-core-node-id)
                     (get function-record :function-core-node-id))
                (if (= (get edge :argument-core-node-ids)
                       (get call :argument-node-ids))
                  (if (= (get edge :ordered-evaluation-node-ids)
                         (get call :ordered-evaluation-node-ids))
                    (if (= (get edge :evaluation-order)
                           (get call :evaluation-order))
                      (if (= (get edge :caller-function-syntax-id) nil)
                        (= (get edge :caller-function-core-node-id) nil)
                        false)
                      false)
                    false)
                  false)
                false)
              false)
            false)
          false)
        false)
      false)
    false)))

(defn sh08-ft-higher-order-apply-candidates
  [function-records nodes definitions bindings calls edges identity-candidate]
  (let [identity-definition (get identity-candidate :definition)]
    (loop [remaining function-records values []]
      (if (= (count remaining) 0)
        values
        (let [record (first remaining)
              parameter-ids (get record :parameter-binding-ids)
              function-node (get nodes (get record :function-core-node-id))
              definition
              (sh08-ft-definition-by-binding-id
               definitions (get record :definition-binding-id))
              body (get nodes (get record :body-core-node-id))
              body-call
              (sh08-ft-higher-order-call-by-node-id
               calls (get record :body-core-node-id))
              argument-ids (if (map? body-call)
                             (get body-call :argument-node-ids)
                             [])
              inner-argument (get nodes (first argument-ids))
              inner-edge
              (sh08-ft-edge-by-call-id
               edges (get record :body-core-node-id))
              outer-call
              (if (map? definition)
                (sh08-ft-higher-order-outer-call
                 calls nodes definition identity-definition)
                nil)
              outer-edge
              (if (map? outer-call)
                (sh08-ft-edge-by-call-id
                 edges (get outer-call :core-node-id))
                nil)
              outer-node
              (if (map? outer-call)
                (get nodes (get outer-call :core-node-id))
                nil)
              callable-binding
              (sh08-ft-binding-by-id bindings (first parameter-ids))]
          (if (if (= :named-top-level (get record :definition-kind))
                (if (= 2 (get record :fixed-arity))
                  (if (= 2 (count parameter-ids))
                    (if (map? definition)
                      (if (map? function-node)
                        (if (= :fn (get function-node :core-form))
                          (if (sh08-ft-higher-order-call-node-valid?
                               body-call body 1
                               (get record :function-syntax-id))
                            (if (= (get body-call :operator-binding-id)
                                   (first parameter-ids))
                              (if (sh08-ft-higher-order-reference?
                                   inner-argument
                                   (first (rest parameter-ids))
                                   (get record :function-syntax-id))
                                (if (map? inner-edge)
                                  (if (= :nonlocal-or-nonfunction
                                         (get inner-edge :classification))
                                    (if (= (get inner-edge :callee-binding-id)
                                           (first parameter-ids))
                                      (if (map? callable-binding)
                                        (if (= (get inner-edge
                                                   :callee-definition-syntax-id)
                                               (get callable-binding
                                                   :definition-syntax-id))
                                          (if (= nil
                                                 (get inner-edge
                                                      :callee-function-syntax-id))
                                            (if (= nil
                                                 (get inner-edge
                                                      :callee-function-core-node-id))
                                              (if (sh08-ft-higher-order-outer-edge-valid?
                                                   outer-edge outer-call record
                                                   bindings)
                                                true
                                                false)
                                              false)
                                            false)
                                          false)
                                        false)
                                      false)
                                    false)
                                  false)
                                false)
                              false)
                            false)
                          false)
                        false)
                      false)
                    false)
                  false)
                false)
            (recur (rest remaining)
                   (conj values
                         {:record record
                          :definition definition
                          :function-node function-node
                          :body body
                          :inner-call body-call
                          :inner-node body
                          :inner-argument inner-argument
                          :inner-edge inner-edge
                          :outer-call outer-call
                          :outer-edge outer-edge
                          :outer-node outer-node
                          :callable-binding callable-binding
                          :callable-binding-id (first parameter-ids)
                          :value-binding-id (first (rest parameter-ids))}))
            (recur (rest remaining) values)))))))

(defn sh08-ft-higher-order-edge-projection [edge]
  (if (map? edge)
    {:ordinal (get edge :ordinal)
     :call-core-node-id (get edge :call-core-node-id)
     :caller-function-syntax-id (get edge :caller-function-syntax-id)
     :caller-function-core-node-id (get edge :caller-function-core-node-id)
     :callee-binding-id (get edge :callee-binding-id)
     :callee-definition-syntax-id (get edge :callee-definition-syntax-id)
     :callee-function-syntax-id (get edge :callee-function-syntax-id)
     :callee-function-core-node-id (get edge :callee-function-core-node-id)
     :argument-core-node-ids (get edge :argument-core-node-ids)
     :ordered-evaluation-node-ids (get edge :ordered-evaluation-node-ids)
     :evaluation-order (get edge :evaluation-order)
     :classification (get edge :classification)}
    nil))

(defn sh08-ft-higher-order-proof
  [nodes definitions bindings function-records calls edges module]
  (let [node-index (sh08-ft-node-index nodes)
        identity-candidates
        (sh08-ft-higher-order-identity-candidates
         function-records node-index definitions)]
    (if (= 1 (count identity-candidates))
      (let [identity (first identity-candidates)
            apply-candidates
            (sh08-ft-higher-order-apply-candidates
             function-records node-index definitions bindings calls edges identity)]
        (if (= 1 (count apply-candidates))
          (let [apply (first apply-candidates)
                identity-record (get identity :record)
                apply-record (get apply :record)
                identity-definition (get identity :definition)
                apply-definition (get apply :definition)
                outer-value-node
                (get node-index
                     (first
                      (rest
                       (get (get apply :outer-call)
                            :argument-node-ids))))
                value-type
                (sh08-ft-authoritative-primitive-type-for-node
                 outer-value-node)
                identity-source
                (get (get (get identity :function-node) :source) :semantic-span)
                identity-syntax-id
                (get (get (get identity :function-node) :source) :syntax-id)
                identity-origin-chain
                (get (get (get identity :function-node) :source) :origin-chain)
                identity-generated-origin
                (get (get (get identity :function-node) :source) :generated-origin)
                apply-source
                (get (get (get apply :function-node) :source) :semantic-span)
                apply-syntax-id
                (get (get (get apply :function-node) :source) :syntax-id)
                apply-origin-chain
                (get (get (get apply :function-node) :source) :origin-chain)
                apply-generated-origin
                (get (get (get apply :function-node) :source) :generated-origin)
                identity-function-type
                {:artifact :gravity/c7-function-type
                 :function-id (get identity-record :function-syntax-id)
                 :function-core-node-id
                 (get identity-record :function-core-node-id)
                 :body-core-node-id (get identity-record :body-core-node-id)
                 :definition-name (get identity-record :definition-name)
                 :parameter-binding-ids
                 (get identity-record :parameter-binding-ids)
                 :parameters
                 [{:binding-id (get identity :parameter-binding-id)
                   :type value-type}]
                 :return value-type
                 :return-conflict nil
                 :fixed-arity (get identity-record :fixed-arity)
                 :latent-effects (get module :effects)
                 :capabilities (get module :capabilities)
                 :ownership-constraints :pending-sh10
                 :profile-constraints [(get module :profile)]
                 :thrown-error-effects [:pending-sh09]
                 :source-span identity-source
                 :syntax-id identity-syntax-id
                 :origin-chain identity-origin-chain
                 :generated-origin identity-generated-origin
                 :profile (get module :profile)
                 :target (get module :target)
                 :status :inferred}
                apply-function-type
                {:artifact :gravity/c7-function-type
                 :function-id (get apply-record :function-syntax-id)
                 :function-core-node-id
                 (get apply-record :function-core-node-id)
                 :body-core-node-id (get apply-record :body-core-node-id)
                 :definition-name (get apply-record :definition-name)
                 :parameter-binding-ids
                 (get apply-record :parameter-binding-ids)
                 :parameters
                 [{:binding-id (get apply :callable-binding-id)
                   :type identity-function-type}
                  {:binding-id (get apply :value-binding-id)
                   :type value-type}]
                 :return value-type
                 :return-conflict nil
                 :fixed-arity (get apply-record :fixed-arity)
                 :latent-effects (get module :effects)
                 :capabilities (get module :capabilities)
                 :ownership-constraints :pending-sh10
                 :profile-constraints [(get module :profile)]
                 :thrown-error-effects [:pending-sh09]
                 :source-span apply-source
                 :syntax-id apply-syntax-id
                 :origin-chain apply-origin-chain
                 :generated-origin apply-generated-origin
                 :profile (get module :profile)
                 :target (get module :target)
                 :status :inferred}]
            (if (sh08-ft-authoritative-primitive-type? value-type)
              {:status :accepted
             :identity identity
             :apply apply
             :identity-function-type identity-function-type
             :apply-function-type apply-function-type
             :identity-binding-id (get identity-definition :binding-id)
             :identity-function-syntax-id
             (get identity-record :function-syntax-id)
             :apply-binding-id (get apply-definition :binding-id)
             :apply-function-syntax-id
             (get apply-record :function-syntax-id)
             :identity-parameter-binding-id
             (get identity :parameter-binding-id)
             :apply-callable-binding-id (get apply :callable-binding-id)
             :apply-value-binding-id (get apply :value-binding-id)
             :inner-call-core-node-id
             (get (get apply :inner-call) :core-node-id)
             :outer-call-core-node-id
             (get (get apply :outer-call) :core-node-id)
             :inner-edge (get apply :inner-edge)
             :outer-edge (get apply :outer-edge)
             :identity-source
             (get (get (get identity :function-node) :source)
                  :semantic-span)
             :apply-source
             (get (get (get apply :function-node) :source)
                  :semantic-span)
             :inner-source
             (get (get (get apply :inner-node) :source)
                  :semantic-span)
             :outer-source
             (get (get (get apply :outer-node) :source)
                  :semantic-span)
             :callable-definition-syntax-id
             (get (get apply :callable-binding) :definition-syntax-id)
             :initial-binding-types
             {(get identity-definition :binding-id) identity-function-type
              (get identity :parameter-binding-id) value-type
              (get apply-definition :binding-id) apply-function-type
             (get apply :callable-binding-id) identity-function-type
              (get apply :value-binding-id) value-type}
             :value-type value-type
             :outer-value-literal-kind
             (get (get outer-value-node :attributes) :literal-kind)}
              {:status :rejected
               :reason :unsupported-higher-order-primitive-type
               :node outer-value-node
               :actual (get (get outer-value-node :attributes) :literal-kind)
               :value-type value-type}))
          {:status :not-applicable :reason :no-complete-identity-apply-shape}))
      {:status :not-applicable :reason :no-complete-identity-shape})))

(defn sh08-ft-higher-order-complete-function
  [skeleton proof-type]
  (let [updated
        (assoc
         (assoc
          (assoc
           (assoc
            (assoc
             (assoc skeleton
                    :parameters (get proof-type :parameters))
             :return (get proof-type :return))
            :latent-effects (get proof-type :latent-effects))
           :capabilities (get proof-type :capabilities))
          :ownership-constraints (get proof-type :ownership-constraints))
         :thrown-error-effects (get proof-type :thrown-error-effects))]
    (assoc
     (assoc
      (assoc
       (assoc
        (assoc updated :profile (get proof-type :profile))
        :target (get proof-type :target))
       :source-span (get proof-type :source-span))
      :syntax-id (get proof-type :syntax-id))
     :origin-chain (get proof-type :origin-chain)
     :generated-origin (get proof-type :generated-origin))))

(defn sh08-ft-higher-order-proof-input [proof]
  (let [identity (get proof :identity)
        apply (get proof :apply)
        identity-record (get identity :record)
        apply-record (get apply :record)
        identity-definition (get identity :definition)
        apply-definition (get apply :definition)
        inner-call (get apply :inner-call)
        outer-call (get apply :outer-call)]
    {:domain :gravity/sh08-authoritative-higher-order-proof-v1
     :identity-function-syntax-id (get identity-record :function-syntax-id)
     :identity-function-core-node-id
     (get identity-record :function-core-node-id)
     :identity-definition-binding-id (get identity-definition :binding-id)
     :identity-parameter-binding-id
     (get proof :identity-parameter-binding-id)
     :identity-body-core-node-id (get identity-record :body-core-node-id)
     :apply-function-syntax-id (get apply-record :function-syntax-id)
     :apply-function-core-node-id (get apply-record :function-core-node-id)
     :apply-definition-binding-id (get apply-definition :binding-id)
     :apply-callable-binding-id (get proof :apply-callable-binding-id)
     :apply-value-binding-id (get proof :apply-value-binding-id)
     :apply-body-core-node-id (get apply-record :body-core-node-id)
     :inner-call-core-node-id (get inner-call :core-node-id)
     :inner-operator-binding-id (get inner-call :operator-binding-id)
     :inner-argument-node-ids (get inner-call :argument-node-ids)
     :inner-evaluation-order (get inner-call :evaluation-order)
     :inner-source-span (get proof :inner-source)
     :inner-edge
     (sh08-ft-higher-order-edge-projection (get proof :inner-edge))
     :outer-call-core-node-id (get outer-call :core-node-id)
     :outer-operator-binding-id (get outer-call :operator-binding-id)
     :outer-argument-node-ids (get outer-call :argument-node-ids)
     :outer-evaluation-order (get outer-call :evaluation-order)
     :outer-source-span (get proof :outer-source)
     :outer-edge
     (sh08-ft-higher-order-edge-projection (get proof :outer-edge))
     :outer-value-argument-node-id
     (first (rest (get outer-call :argument-node-ids)))
     :outer-value-literal-kind
     (get proof :outer-value-literal-kind)
     :identity-parameter-type (get proof :value-type)
     :apply-callable-parameter-type (get proof :identity-function-type)
     :apply-value-parameter-type (get proof :value-type)
     :identity-function-type (get proof :identity-function-type)
     :apply-function-type (get proof :apply-function-type)
     :inner-result-type (get proof :value-type)
     :outer-result-type (get proof :value-type)}))

(defn sh08-ft-higher-order-call-proof-facts [proof]
  (let [identity (get proof :identity)
        apply (get proof :apply)
        identity-record (get identity :record)
        apply-record (get apply :record)
        inner-call (get apply :inner-call)
        outer-call (get apply :outer-call)]
    [{:role :inner-indirect-call
      :call-core-node-id (get inner-call :core-node-id)
      :caller-function-syntax-id (get apply-record :function-syntax-id)
      :callee-function-syntax-id (get (get proof :inner-edge)
                                      :callee-function-syntax-id)
      :selected-identity-function-syntax-id
      (get identity-record :function-syntax-id)
      :operator-binding-id (get inner-call :operator-binding-id)
      :callable-parameter-binding-id
      (get proof :apply-callable-binding-id)
      :argument-node-ids (get inner-call :argument-node-ids)
      :argument-value-binding-id (get proof :apply-value-binding-id)
      :evaluation-order (get inner-call :evaluation-order)
      :source-span (get proof :inner-source)
      :b47-edge
      (sh08-ft-higher-order-edge-projection (get proof :inner-edge))
      :result-type (get proof :value-type)
      :dispatch :indirect-function-value}
     {:role :outer-direct-call
      :call-core-node-id (get outer-call :core-node-id)
      :caller-function-syntax-id nil
      :callee-function-syntax-id (get apply-record :function-syntax-id)
      :operator-binding-id (get outer-call :operator-binding-id)
      :argument-node-ids (get outer-call :argument-node-ids)
      :value-argument-node-id
      (first (rest (get outer-call :argument-node-ids)))
      :evaluation-order (get outer-call :evaluation-order)
      :source-span (get proof :outer-source)
      :outer-edge (get proof :outer-edge)
      :b47-edge
      (sh08-ft-higher-order-edge-projection (get proof :outer-edge))
      :selected-apply-function-syntax-id
      (get apply-record :function-syntax-id)
      :result-type (get proof :value-type)
      :dispatch :direct-local-function}]))

(defn sh08-ft-higher-order-pending [base-pending]
  (let [residuals
        [:captures :lifetimes :aliases :multi-hop :polymorphism :overloads
         :multi-arity :variadic-dispatch :protocol-dispatch :dynamic-dispatch
         :reflection]]
    (loop [remaining base-pending values []]
      (if (= (count remaining) 0)
        values
        (if (= (first remaining) :higher-order-functions)
          (recur
           (rest remaining)
           (loop [pending residuals result values]
             (if (= (count pending) 0)
               result
               (recur (rest pending) (conj result (first pending))))))
          (recur (rest remaining) (conj values (first remaining))))))))

; The recursive consumer is intentionally narrower than the B47 recursion
; product.  B47 may describe arbitrary SCCs, but C7 only admits one named,
; capture-free positive-fixed-arity self edge with direct positional parameter
; forwarding, a direct primitive-literal sibling, and an external concrete
; call that supplies every parameter slot. Everything else remains an explicit
; diagnostic rather than being silently approximated.
(defn sh08-ft-recursive-known-type? [value]
  (sh08-ft-authoritative-primitive-type? value))

(defn sh08-ft-recursive-reference-valid?
  [node binding-ids definition-binding-id function-syntax-id]
  (if (map? node)
    (if (= :reference (get node :core-form))
      (if (= function-syntax-id
             (get (get node :evaluation) :owner-function-syntax-id))
        (let [binding-id (get (get node :attributes) :binding-id)]
          (if (= binding-id definition-binding-id)
            true
            (sh08-ft-member? binding-ids binding-id)))
        false)
      true)
    false))

(defn sh08-ft-recursive-body-capture-free?
  [nodes binding-ids definition-binding-id function-syntax-id]
  (loop [remaining nodes]
    (if (= (count remaining) 0)
      true
      (if (if (= function-syntax-id
                (get (get (first remaining) :evaluation)
                     :owner-function-syntax-id))
            (sh08-ft-recursive-reference-valid?
             (first remaining) binding-ids definition-binding-id
             function-syntax-id)
            true)
        (recur (rest remaining))
        false))))

(defn sh08-ft-recursive-call-edge-valid?
  [edge call call-node function-record definition-binding binding-table
   recursive?]
  (let [function-syntax-id (get function-record :function-syntax-id)
        function-core-node-id (get function-record :function-core-node-id)
        definition-binding-id (get definition-binding :binding-id)
        definition-syntax-id
        (get (sh08-ft-binding-by-id
              binding-table definition-binding-id)
             :definition-syntax-id)]
    (if (if (map? edge) (map? call) false)
      (if (= :local-function (get edge :classification))
        (if (= (get edge :call-core-node-id)
               (get call :core-node-id))
          (if (= (get edge :callee-binding-id) definition-binding-id)
            (if (= (get edge :callee-definition-syntax-id)
                   definition-syntax-id)
              (if (= (get edge :callee-function-syntax-id)
                     function-syntax-id)
                (if (= (get edge :callee-function-core-node-id)
                       function-core-node-id)
                  (if (= (get edge :argument-core-node-ids)
                         (get call :argument-node-ids))
                    (if (= (get edge :ordered-evaluation-node-ids)
                           (get call :ordered-evaluation-node-ids))
                      (if (= (get edge :evaluation-order)
                             :operator-then-arguments)
                        (if (= (get call :evaluation-order)
                               :operator-then-arguments)
                          (if (= (get (get call-node :evaluation)
                                      :owner-function-syntax-id)
                                 (if recursive?
                                   function-syntax-id
                                   nil))
                            true
                            false)
                          false)
                        false)
                      false)
                    false)
                  false)
                false)
              false)
            false)
          false)
        false)
      false)))

(defn sh08-ft-recursive-argument-types
  [argument-node-ids node-index]
  (loop [remaining argument-node-ids values []]
    (if (= (count remaining) 0)
      values
      (let [node (get node-index (first remaining))
            literal-type
            (if (= :literal (get node :core-form))
              (sh08-primitive-type-from-literal-kind
               (get (get node :attributes) :literal-kind))
              :gravity.type/unknown)]
        (recur
         (rest remaining)
         (conj values
               (if (sh08-ft-authoritative-primitive-type? literal-type)
                 literal-type
                 :gravity.type/unknown)))))))

(defn sh08-ft-recursive-unsupported-primitive-node
  [argument-node-ids node-index]
  (if (= (count argument-node-ids) 0)
    nil
    (let [node (get node-index (first argument-node-ids))
          candidate
          (if (= :literal (get node :core-form))
            (sh08-primitive-type-from-literal-kind
             (get (get node :attributes) :literal-kind))
            nil)]
      (if (if (map? node)
            (if (= :literal (get node :core-form))
              (if (= candidate nil)
                false
                (if (sh08-ft-authoritative-primitive-type? candidate)
                  false
                  true))
              false)
            false)
        node
        (sh08-ft-recursive-unsupported-primitive-node
         (rest argument-node-ids) node-index)))))

(defn sh08-ft-recursive-parameter-evidence
  [calls edges node-index function-record definition-binding binding-table]
  (let [function-syntax-id (get function-record :function-syntax-id)
        arity (count (get function-record :parameter-binding-ids))]
    (loop [remaining calls
           remaining-edges edges
           candidates []]
      (if (= (count remaining) 0)
        (if (= (count candidates) 0)
          {:status :rejected :reason :recursive-parameter-evidence-required}
          (let [first-types (get (first candidates) :types)
                conflict
                (loop [types (rest candidates)]
                  (if (= (count types) 0)
                    nil
                    (if (= first-types (get (first types) :types))
                      (recur (rest types))
                      (get (first types) :types))))]
            (if (= conflict nil)
              {:status :accepted
               :call (get (first candidates) :call)
               :edge (get (first candidates) :edge)
               :node (get (first candidates) :node)
               :types first-types}
              {:status :rejected
               :reason :recursive-parameter-type-conflict
               :actual conflict})))
        (let [call (first remaining)
              edge (first remaining-edges)
              node (get node-index (get call :core-node-id))
              types (sh08-ft-recursive-argument-types
                     (get call :argument-node-ids) node-index)
              unsupported-node
              (sh08-ft-recursive-unsupported-primitive-node
               (get call :argument-node-ids) node-index)
              valid-edge
              (sh08-ft-recursive-call-edge-valid?
               edge call node function-record definition-binding
               binding-table false)]
          (if (map? unsupported-node)
            {:status :rejected
             :reason :unsupported-recursive-primitive-type
             :node unsupported-node}
            (if (if valid-edge
                (if (= (get edge :caller-function-syntax-id) nil)
                  (if (= (get edge :caller-function-core-node-id) nil)
                    (if (= arity (count types))
                      (sh08-ft-every-known? types)
                      false)
                    false)
                  false)
                false)
            (recur (rest remaining)
                   (rest remaining-edges)
                   (conj candidates
                         {:call call
                          :edge edge
                          :node node
                          :types types}))
            (recur (rest remaining) (rest remaining-edges) candidates))))))))

(defn sh08-ft-recursive-base-evidence
  [body node-index recursive-call-id]
  (if (= :if (get body :core-form))
    (let [children (get body :children)]
      (if (= 3 (count children))
        (let [then-id (second children)
              else-id (sh08-third children)
              then-node (get node-index then-id)
              else-node (get node-index else-id)
              then-type
              (if (= :literal (get then-node :core-form))
                (sh08-primitive-type-from-literal-kind
                 (get (get then-node :attributes) :literal-kind))
                :gravity.type/unknown)
              else-type
              (if (= :literal (get else-node :core-form))
                (sh08-primitive-type-from-literal-kind
                 (get (get else-node :attributes) :literal-kind))
                :gravity.type/unknown)]
          (if (= then-id recursive-call-id)
            (if (sh08-ft-recursive-known-type? else-type)
              {:status :accepted :node else-node :type else-type}
              {:status :rejected :reason :recursive-base-evidence-required})
            (if (= else-id recursive-call-id)
              (if (sh08-ft-recursive-known-type? then-type)
                {:status :accepted :node then-node :type then-type}
                {:status :rejected :reason :recursive-base-evidence-required})
              {:status :rejected :reason :recursive-call-must-be-direct-branch})))
        {:status :rejected :reason :recursive-base-shape-required}))
    {:status :rejected :reason :recursive-base-shape-required}))

(defn sh08-ft-recursive-pending [base-pending]
  (let [residuals [:mutual-recursion :unbounded-recursion :recursive-captures
                   :recursive-higher-order :recursive-polymorphism]]
    (loop [remaining base-pending values []]
      (if (= (count remaining) 0)
        values
        (if (= (first remaining) :recursive-type-annotations)
          (recur
           (rest remaining)
           (loop [pending residuals result values]
             (if (= (count pending) 0)
               result
               (recur (rest pending) (conj result (first pending))))))
          (recur (rest remaining) (conj values (first remaining))))))))

(defn sh08-ft-recursive-rejection-evidence [result node component]
  (if (= :accepted (get result :status))
    result
    (if (map? (get result :node))
      result
      (if (map? node)
        (assoc result :node node)
        (if (map? component)
          (assoc result :component component)
          result)))))

(defn sh08-ft-recursive-diagnostic [proof module]
  (let [node (get proof :node)
        diagnostic
        (sh08-ft-diagnostic
         "C7-ANNOTATION"
         (if (map? node) node nil)
         module
         :bounded-named-self-recursive-fixed-arity-positive-positional-literal-base
         (get proof :reason)
         (get proof :reason)
         {})]
    (if (map? (get proof :component))
      (assoc diagnostic :recursive-component (get proof :component))
      diagnostic)))

(defn sh08-ft-recursive-proof
  [nodes definitions bindings function-records calls edges recursion-components
   module]
  (if (= (count recursion-components) 0)
    {:status :not-applicable :reason :no-recursive-component}
    (if (sh08-ft-any-member?
         (loop [remaining recursion-components values []]
           (if (= (count remaining) 0)
             values
             (recur
              (rest remaining)
              (conj values (= :mutually-recursive
                              (get (first remaining) :kind))))))
         [true])
      {:status :rejected
       :reason :mutual-recursion-unsupported
       :component (first recursion-components)}
      (if (= 1 (count recursion-components))
        (let [component (first recursion-components)
              function-syntax-id (first (get component :function-syntax-ids))
              function-record
              (sh08-ft-function-by-syntax-id
               function-records function-syntax-id)
              node-index (sh08-ft-node-index nodes)
              function-node
              (if (map? function-record)
                (get node-index (get function-record :function-core-node-id))
                nil)
              definition
              (if (map? function-record)
                (sh08-ft-definition-by-binding-id
                 definitions (get function-record :definition-binding-id))
                nil)
              definition-binding
              (if (map? function-record)
                (sh08-ft-binding-by-id
                 bindings (get function-record :definition-binding-id))
                nil)
              edge-ordinals (get component :internal-call-edge-ordinals)
              recursive-edge
              (if (= 1 (count edge-ordinals))
                (get edges (first edge-ordinals))
                nil)
              recursive-call
              (if (map? recursive-edge)
                (sh08-ft-higher-order-call-by-node-id
                 calls (get recursive-edge :call-core-node-id))
                nil)
              recursive-node
              (if (map? recursive-call)
                (get node-index (get recursive-call :core-node-id))
                nil)
              body
              (if (map? function-record)
                (get node-index (get function-record :body-core-node-id))
                nil)
              edge-valid
              (sh08-ft-recursive-call-edge-valid?
               recursive-edge recursive-call recursive-node function-record
               definition bindings true)
              arity
              (if (map? function-record)
                (get function-record :fixed-arity)
                nil)
              parameter-ids
              (if (map? function-record)
                (get function-record :parameter-binding-ids)
                [])
              argument-ids
              (if (map? recursive-call)
                (get recursive-call :argument-node-ids)
                [])
              argument-nodes
              (loop [remaining argument-ids values []]
                (if (= (count remaining) 0)
                  values
                  (recur
                   (rest remaining)
                   (conj values (get node-index (first remaining))))))
              argument-shape
              (if (= arity (count parameter-ids))
                (if (= arity (count argument-ids))
                  (loop [remaining argument-nodes ids parameter-ids]
                    (if (= (count remaining) 0)
                      true
                      (if (sh08-ft-higher-order-reference?
                           (first remaining) (first ids) function-syntax-id)
                        (recur (rest remaining) (rest ids))
                        false)))
                  false)
                false)
              base-evidence
              (if (map? body)
                (sh08-ft-recursive-base-evidence
                 body node-index (get recursive-call :core-node-id))
                {:status :rejected :reason :recursive-base-shape-required})
              parameter-evidence
              (if (map? definition)
                (sh08-ft-recursive-parameter-evidence
                 calls edges node-index function-record definition bindings)
                {:status :rejected :reason :recursive-definition-required})
              capture-free
              (if (map? function-record)
                (sh08-ft-recursive-body-capture-free?
                 nodes parameter-ids (get function-record :definition-binding-id)
                 function-syntax-id)
                false)]
          (sh08-ft-recursive-rejection-evidence
           (if (= nil function-record)
            {:status :rejected :reason :recursive-function-record-required}
            (if (= :named-top-level (get function-record :definition-kind))
              (if (if (integer? arity) (> arity 0) false)
                (if (= :fn (get function-node :core-form))
                  (if (map? definition)
                    (if (map? definition-binding)
                      (if edge-valid
                        (if argument-shape
                          (if capture-free
                            (if (= :accepted (get base-evidence :status))
                            (if (= :accepted
                                     (get parameter-evidence :status))
                                (if (= (get base-evidence :type)
                                       (first (get parameter-evidence :types)))
                                  {:status :accepted
                                   :component component
                                   :function-record function-record
                                   :function-node function-node
                                   :definition definition
                                   :definition-binding definition-binding
                                   :recursive-call recursive-call
                                   :recursive-call-core-node-id
                                   (get recursive-call :core-node-id)
                                   :recursive-base-type
                                   (get base-evidence :type)
                                   :recursive-edge recursive-edge
                                   :recursive-node recursive-node
                                   :base-node (get base-evidence :node)
                                   :base-type (get base-evidence :type)
                                   :parameter-evidence parameter-evidence
                                   :parameter-types
                                   (get parameter-evidence :types)
                                   :function-syntax-id function-syntax-id
                                   :module module}
                                  {:status :rejected
                                   :reason :recursive-result-type-conflict
                                   :expected (get base-evidence :type)
                                   :actual
                                   (first (get parameter-evidence :types))})
                              {:status :rejected
                               :reason (get parameter-evidence :reason)
                               :actual (get parameter-evidence :actual)
                               :node (get parameter-evidence :node)})
                              {:status :rejected
                               :reason (get base-evidence :reason)})
                            {:status :rejected :reason :recursive-capture-unsupported})
                          {:status :rejected :reason :recursive-argument-shape})
                        {:status :rejected :reason :recursive-call-edge-lineage})
                      {:status :rejected :reason :recursive-definition-binding-required})
                    {:status :rejected :reason :recursive-definition-required})
                  {:status :rejected :reason :recursive-function-node-required})
                {:status :rejected :reason :recursive-fixed-arity-required})
              {:status :rejected :reason :recursive-function-must-be-named}))
           recursive-node
           component))
        {:status :rejected
         :reason :multiple-recursive-components
         :component recursion-components}))))

(defn sh08-ft-recursive-complete-function
  [skeleton proof]
  (let [parameter-ids (get (get proof :function-record) :parameter-binding-ids)
        parameter-types (get proof :parameter-types)
        parameters
        (loop [ids parameter-ids types parameter-types values []]
          (if (= (count ids) 0)
            values
            (recur
             (rest ids)
             (rest types)
             (conj values {:binding-id (first ids) :type (first types)}))))]
    (assoc
     (assoc
      (assoc
       skeleton
       :parameters parameters)
      :return (get proof :base-type))
     :source-span
     (get (get (get proof :function-node) :source) :semantic-span))))

(defn sh08-ft-recursive-proof-input [proof]
  (let [record (get proof :function-record)
        definition (get proof :definition)
        call (get proof :recursive-call)
        edge (get proof :recursive-edge)
        recursive-node (get proof :recursive-node)
        parameter-evidence (get proof :parameter-evidence)
        evidence-call (get parameter-evidence :call)
        evidence-edge (get parameter-evidence :edge)
        evidence-node (get parameter-evidence :node)
        module (get proof :module)]
    {:domain :gravity/sh08-authoritative-recursive-proof-v1
     :function-syntax-id (get record :function-syntax-id)
     :function-core-node-id (get record :function-core-node-id)
     :definition-binding-id (get definition :binding-id)
     :definition-syntax-id (get definition :syntax-id)
     :parameter-binding-ids (get record :parameter-binding-ids)
     :fixed-arity (get record :fixed-arity)
     :recursive-call-core-node-id (get call :core-node-id)
     :recursive-argument-node-ids (get call :argument-node-ids)
     :recursive-edge (sh08-ft-higher-order-edge-projection edge)
     :recursive-call-source
     {:syntax-id (get (get recursive-node :source) :syntax-id)
      :source-span (get (get recursive-node :source) :semantic-span)
      :origin-chain (get (get recursive-node :source) :origin-chain)
      :generated-origin (get (get recursive-node :source) :generated-origin)}
     :recursive-call-profile (get module :profile)
     :recursive-call-target (get module :target)
     :recursive-call-effects (get module :effects)
     :recursive-call-capabilities (get module :capabilities)
     :base-node-id (get (get proof :base-node) :node-id)
     :base-type (get proof :base-type)
     :recursive-definition-binding-id (get definition :binding-id)
     :parameter-evidence-call-core-node-id
     (get evidence-call :core-node-id)
     :parameter-evidence-call
     {:call-core-node-id (get evidence-call :core-node-id)
      :caller-function-syntax-id (get evidence-edge :caller-function-syntax-id)
      :callee-function-syntax-id (get evidence-edge :callee-function-syntax-id)
      :argument-node-ids (get evidence-call :argument-node-ids)
      :ordered-evaluation-node-ids
      (get evidence-call :ordered-evaluation-node-ids)
      :evaluation-order (get evidence-call :evaluation-order)
      :argument-types (get parameter-evidence :types)
      :result-type (first (get parameter-evidence :types))
      :syntax-id (get (get evidence-node :source) :syntax-id)
      :source-span (get (get evidence-node :source) :semantic-span)
      :origin-chain (get (get evidence-node :source) :origin-chain)
      :generated-origin (get (get evidence-node :source) :generated-origin)
      :profile (get module :profile)
      :target (get module :target)
      :effects (get module :effects)
      :capabilities (get module :capabilities)
      :edge (sh08-ft-higher-order-edge-projection evidence-edge)}
     :parameter-types (get proof :parameter-types)
     :proof-bound
     :one-named-self-recursive-positive-fixed-arity-positional-literal-base
     :captures? false
     :higher-order? false
     :monotone-fixed-point? true}))

(defn sh08-ft-call-fact-by-id [facts call-id]
  (if (= (count facts) 0)
    nil
    (if (= call-id (get (first facts) :call-core-node-id))
      (first facts)
      (sh08-ft-call-fact-by-id (rest facts) call-id))))

(defn sh08-ft-recursive-call-proof-facts [proof canonical-call-facts]
  (let [record (get proof :function-record)
        call (get proof :recursive-call)
        edge (get proof :recursive-edge)
        parameter-evidence (get proof :parameter-evidence)
        evidence-call (get parameter-evidence :call)
        evidence-edge (get parameter-evidence :edge)
        recursive-fact
        (sh08-ft-call-fact-by-id
         canonical-call-facts (get call :core-node-id))
        evidence-fact
        (sh08-ft-call-fact-by-id
         canonical-call-facts (get evidence-call :core-node-id))]
    [(assoc
      (if (map? recursive-fact) recursive-fact {})
      :role :self-recursive-call
      :recursive-definition-binding-id
      (get (get proof :definition) :binding-id)
      :b47-edge (sh08-ft-higher-order-edge-projection edge)
      :result-type (get proof :base-type)
      :dispatch :direct-named-self-recursion)
     (assoc
      (if (map? evidence-fact) evidence-fact {})
      :role :external-parameter-evidence
      :parameter-evidence? true
      :external-edge (sh08-ft-higher-order-edge-projection evidence-edge)
      :argument-types (get parameter-evidence :types)
      :result-type (first (get parameter-evidence :types)))]))

(defn sh08-ft-recursive-constraint-ledger [proof]
  [{:constraint-id-request
    {:domain :gravity/sh08-recursive-call-constraint-v1
     :function-syntax-id (get proof :function-syntax-id)
     :call-core-node-id (get (get proof :recursive-call) :core-node-id)
     :fixed-arity (get (get proof :function-record) :fixed-arity)}
    :kind :recursive-fixed-point
    :lhs (get proof :function-syntax-id)
    :rhs (get proof :base-type)
    :origin (get (get (get proof :recursive-node) :source) :origin-chain)
    :profile (get (get proof :module) :profile)
    :target (get (get proof :module) :target)
    :status :solved
    :diagnostics []}])

(defn sh08-ft-update-param-types [function-types binding-types]
  (loop [remaining (keys function-types)
         result function-types]
    (if (= (count remaining) 0)
      result
      (let [function-id (first remaining)
            function (get result function-id)
            parameter-ids (get function :parameter-binding-ids)
            parameter-types
            (loop [ids parameter-ids values []]
              (if (= (count ids) 0)
                values
                (recur
                 (rest ids)
                 (conj values
                       (get binding-types (first ids)
                            :gravity.type/unknown)))))]
        (recur
         (rest remaining)
         (assoc result function-id
                (assoc function :parameters
                       (loop [types parameter-types ids parameter-ids values []]
                         (if (= (count types) 0)
                           values
                           (recur
                            (rest types)
                            (rest ids)
                            (conj values
                                  {:binding-id (first ids)
                                   :type (first types)})))))))))))

(defn sh08-ft-edge-by-call-id [edges call-id]
  (loop [remaining edges]
    (if (= (count remaining) 0)
      nil
      (if (= (get (first remaining) :call-core-node-id) call-id)
        (first remaining)
        (recur (rest remaining))))))

(defn sh08-ft-function-by-id [function-types syntax-id]
  (get function-types syntax-id))

(defn sh08-ft-function-by-core-id [function-types core-node-id]
  (loop [remaining (keys function-types)]
    (if (= (count remaining) 0)
      nil
      (let [function (get function-types (first remaining))]
        (if (= (get function :function-core-node-id) core-node-id)
          function
          (recur (rest remaining)))))))

(defn sh08-ft-if-join-with-context [children type-table context]
  (let [then-id (second children)
        else-id (sh08-third children)
        then-type (get type-table then-id :gravity.type/unknown)
        else-type (get type-table else-id :gravity.type/unknown)]
    (if (= then-type else-type)
      (if (sh08-ft-known? then-type)
        then-type
        (if (= :accepted (get context :status))
          (if (if (= then-id (get context :recursive-call-core-node-id))
                true
                (= else-id (get context :recursive-call-core-node-id)))
            (get context :recursive-base-type :gravity.type/unknown)
            :gravity.type/unknown)
          :gravity.type/unknown))
      (if (= :accepted (get context :status))
        (if (= then-id (get context :recursive-call-core-node-id))
          (if (sh08-ft-known? else-type)
            else-type
            (get context :recursive-base-type :gravity.type/unknown))
          (if (= else-id (get context :recursive-call-core-node-id))
            (if (sh08-ft-known? then-type)
              then-type
              (get context :recursive-base-type :gravity.type/unknown))
            :gravity.type/unknown))
        :gravity.type/unknown))))

; L1/L2 quoted payloads are authenticated DATA, never executable core nodes.
(defn sh08-qd-failure [rule reason form expected actual]
  {:status :rejected :rule rule :reason reason :form form :expected expected :actual actual :work-count 1})

(defn sh08-qd-scalar-valid? [kind value]
  (if (= kind :nil) (= value nil)
    (if (= kind :boolean) (contains? #{true false} value)
      (if (= kind :integer) (integer? value)
        (if (= kind :character) (char? value)
          (if (= kind :string) (string? value)
            (if (= kind :keyword) (keyword? value)
              (if (= kind :symbol) (symbol? value) false))))))))

(defn sh08-qd-collection-value-valid? [kind value values]
  (if (contains? #{:list :vector} kind)
    (if (if (= kind :list) (seq? value) (vector? value)) (= (vec value) values) false)
    (if (= kind :set)
      (if (set? value) (if (= (count value) (count values)) (= value (set values)) false) false)
      (if (= kind :map)
        (if (if (map? value) (sh08-even-count? values) false)
          (if (= (* 2 (count value)) (count values))
            (= value (loop [remaining values out {}]
                       (if (= (count remaining) 0) out
                         (recur (rest (rest remaining)) (assoc out (first remaining) (second remaining)))))) false) false)
        false))))

(defn sh08-qd-data [forms id parent quote-id path seen depth budget]
  (let [form (get forms id) kind (get form :kind) value (get form :value) ids (get form :child-form-ids)]
    (if (if (> depth (get (sh08-local-bounds-value) :maximum-carrier-depth)) true
          (if (<= budget 0) true (> (count ids) (get (sh08-local-bounds-value) :maximum-node-children))))
      (assoc (sh08-qd-failure "C7-ANNOTATION" :quoted-data-work-limit form :bounded-quoted-data-tree
                       {:depth depth :width (count ids) :remaining-work budget}) :work-count (if (<= budget 0) 0 1))
      (if (sh08-ft-all-true?
            [(map? form) (sh08-sha256-id? id) (= id (get form :form-id)) (= parent (get form :parent-form-id))
             (sh08-sha256-id? (get form :syntax-id)) (vector? ids)
             (<= (count ids) (get (sh08-local-bounds-value) :maximum-node-children))
             (sh08-all-unique? ids []) (= false (contains? seen id))])
        (if (contains? #{:list :vector :map :set} kind)
          (loop [remaining ids ordinal 0 children [] values [] types [] used 1]
            (if (= (count remaining) 0)
              (if (sh08-qd-collection-value-valid? kind value values)
                {:status :accepted :work-count used
                 :data {:origin {:kind :quoted-data :quote-core-node-id quote-id :form-id id
                                 :syntax-id (get form :syntax-id) :data-path path :child-form-ids ids}
                        :kind kind :value value :children children :shape-size used
                        :source (get (sh08-bm-source-node {} form) :source)
                        :type (if (= kind :map) {:kind :gravity.type/map :member-types types :shape :literal}
                                {:kind (get {:list :gravity.type/list :vector :gravity.type/vector :set :gravity.type/set} kind)
                                 :element-types types :shape :literal})}}
                (assoc (sh08-qd-failure "C7-VERIFY" :quoted-data-value-child-mismatch form :exact-ordered-data-children value) :work-count used))
              (let [child (sh08-qd-data forms (first remaining) id quote-id (conj path ordinal) (conj seen id) (+ depth 1) (- budget used))]
                (if (= :accepted (get child :status))
                  (recur (rest remaining) (+ ordinal 1) (conj children (get child :data))
                         (conj values (get (get child :data) :value)) (conj types (get (get child :data) :type))
                         (+ used (get child :work-count))) (assoc child :work-count (+ used (get child :work-count 0)))))))
          (if (contains? #{:decimal :ratio :integer} kind)
            (if (if (= kind :integer) (integer? value) false)
              (sh08-qd-scalar form quote-id path)
              (sh08-qd-failure "C7-ANNOTATION" :unsupported-quoted-numeric-representation form :normalized-exact-integer value))
            (if (contains? #{:nil :boolean :character :string :keyword :symbol} kind)
              (sh08-qd-scalar form quote-id path)
              (sh08-qd-failure "C7-ANNOTATION" :unsupported-quoted-data-kind form :first-order-immutable-data kind))))
        (sh08-qd-failure "C7-VERIFY" :malformed-quoted-data-tree form :exact-acyclic-payload-parent-child-join id)))))

(defn sh08-qd-scalar [form quote-id path]
  (let [kind (get form :kind) value (get form :value)]
    (if (if (= [] (get form :child-form-ids)) (sh08-qd-scalar-valid? kind value) false)
      {:status :accepted :work-count 1
       :data {:origin {:kind :quoted-data :quote-core-node-id quote-id :form-id (get form :form-id)
                       :syntax-id (get form :syntax-id) :data-path path :child-form-ids []}
              :kind kind :value value :type (sh08-primitive-type-from-literal-kind kind)
              :source (get (sh08-bm-source-node {} form) :source) :children [] :shape-size 1}}
      (sh08-qd-failure "C7-VERIFY" :quoted-scalar-kind-value-mismatch form :exact-scalar-kind-value-and-zero-children value))))

(defn sh08-qd-node-with-budget [node forms budget]
  (let [owner (get forms (get (get node :source) :form-id)) ids (get owner :child-form-ids)
        operator (get forms (get ids 0)) payload (get forms (get ids 1)) attrs (get node :attributes)]
    (if (sh08-ft-all-true?
          [(= :quote (get node :core-form)) (= :list (get owner :kind)) (vector? ids) (= 2 (count ids))
           (sh08-all-unique? ids [])
           (= (get node :source) (get (sh08-bm-source-node {} owner) :source))
           (= (get ids 0) (get operator :form-id)) (= (get ids 1) (get payload :form-id))
           (sh08-sha256-id? (get operator :syntax-id))
           (= :symbol (get operator :kind)) (= 'quote (get operator :value)) (= [] (get operator :child-form-ids))
           (= (get owner :form-id) (get operator :parent-form-id) (get payload :parent-form-id))
           (seq? (get owner :value)) (= (vec (get owner :value)) ['quote (get payload :value)])
           (= [] (get node :children) (get node :resolved-binding-ids))
           (= :no-evaluation (get (get node :evaluation) :kind)) (= [] (get (get node :evaluation) :order))
           (= attrs {:quoted-form-id (get payload :form-id) :quoted-syntax-id (get payload :syntax-id)
                     :quoted-kind (get payload :kind) :quoted-value (get payload :value)})])
      (let [result (sh08-qd-data forms (get payload :form-id) (get owner :form-id) (get node :node-id) [] #{} 0 budget)]
        (if (if (= :accepted (get result :status))
              (= false (= :accepted (get (sh08-carrier-preflight (get result :data)) :status))) false)
          (assoc (sh08-qd-failure "C7-ANNOTATION" :quoted-data-evidence-limit payload :bounded-quoted-data-evidence nil)
                 :work-count (get result :work-count)) result))
      (assoc (sh08-qd-failure "C7-VERIFY" :malformed-quote-owner-payload-join owner :exact-inert-quote-source-and-payload attrs)
             :work-count 0))))

(defn sh08-qd-node [node forms]
  (sh08-qd-node-with-budget node forms (get (sh08-local-bounds-value) :maximum-core-nodes)))

(defn sh08-qd-executable-data [data executable-forms]
  (if (contains? executable-forms (get (get data :origin) :form-id)) data
    (loop [remaining (get data :children)]
      (if (= (count remaining) 0) nil
        (let [found (sh08-qd-executable-data (first remaining) executable-forms)]
          (if (= found nil) (recur (rest remaining)) found))))))

(defn sh08-qd-products [nodes source-forms module]
  (sh08-qd-products-with-budget nodes source-forms module (get (sh08-local-bounds-value) :maximum-core-nodes)))

(defn sh08-qd-products-with-budget [nodes source-forms module budget]
  (let [forms (loop [remaining source-forms out {}]
                (if (= (count remaining) 0) out
                  (recur (rest remaining) (assoc out (get (first remaining) :form-id) (first remaining)))))
        executable-forms (loop [remaining nodes out #{}]
                           (if (= (count remaining) 0) out
                             (recur (rest remaining) (conj out (get (get (first remaining) :source) :form-id)))))]
    (loop [remaining nodes types {} constraints [] diagnostics [] used 0]
      (if (= (count remaining) 0)
        {:type-table types :constraints constraints :work-count used
         :diagnostics (if (= :accepted (get (sh08-carrier-preflight constraints) :status)) diagnostics
                        (conj diagnostics (sh08-bm-error "C7-ANNOTATION" :quoted-data-evidence-limit
                                           (first (sh08-bm-select nodes :core-form :quote)) :bounded-quoted-data-ledger nil)))}
        (let [node (first remaining)]
          (if (= :quote (get node :core-form))
            (let [checked (sh08-qd-node-with-budget node forms (- budget used))
                  executable (if (= :accepted (get checked :status))
                               (sh08-qd-executable-data (get checked :data) executable-forms) nil)
                  result (if (= executable nil) checked
                           (assoc (sh08-qd-failure "C7-VERIFY" :quoted-payload-is-executable
                             (get forms (get (get executable :origin) :form-id)) :data-without-executable-nodes
                             (get executable :origin)) :work-count (get checked :work-count)))]
              (if (= :accepted (get result :status))
                (let [data (get result :data) type (get data :type)
                      premise {:core-node-id (get node :node-id) :source (get node :source)
                               :attributes (get node :attributes) :children (get node :children)
                               :resolved-binding-ids (get node :resolved-binding-ids) :evaluation (get node :evaluation)}]
                  (recur (rest remaining) (assoc types (get node :node-id) type)
                    (conj constraints {:constraint-id-request {:domain :gravity/sh08-recursive-quoted-data-constraint-v1
                                                              :quote premise :data data}
                                       :kind :equality :producer-rule :sh08-recursive-quoted-data-v1 :lhs (get node :node-id) :rhs type
                                       :quoted-data data :dependencies {:quote premise :data data}
                                       :solution {:type type :evaluation :no-evaluation}
                                       :invalidation [:quote-owner :quote-operator :payload-form-syntax-ids :payload-kind-value
                                                      :payload-child-order :data-paths :no-executable-children-bindings-calls]
                                       :profile (get module :profile) :target (get module :target) :status :solved :diagnostics []})
                    diagnostics (+ used (get result :work-count))))
                (recur (rest remaining) types constraints
                  (conj diagnostics (sh08-bm-error (get result :rule) (get result :reason)
                                      (if (map? (get result :form)) (sh08-bm-source-node node (get result :form)) node)
                                      (get result :expected) (get result :actual))) (+ used (get result :work-count 0)))))
            (recur (rest remaining) types constraints diagnostics used)))))))

(defn sh08-qd-shape [data node]
  (let [kind (get data :kind) children (get data :children)
        base {:status :accepted :type (get data :type) :data-origin (get data :origin)
              :source (get data :source) :binding-links [] :shape-size (get data :shape-size)}]
    (if (contains? #{:map :vector} kind)
      (loop [remaining children ordinal 0 parts []]
        (if (= (count remaining) 0) (assoc base :shape-kind kind :parts parts :constructor-origin :quoted-data)
          (let [key (if (= kind :map) (first remaining) nil)
                value (if (= kind :map) (second remaining) (first remaining))
                child-shape (sh08-qd-shape value node)]
            (if (if (= kind :map) (= :keyword (get key :kind)) true)
              (if (= :accepted (get child-shape :status))
                (recur (if (= kind :map) (rest (rest remaining)) (rest remaining))
                       (+ ordinal (if (= kind :map) 2 1))
                       (conj parts {:key (get key :value) :coordinate (if (= kind :map) (+ ordinal 1) ordinal)
                                    :key-data-origin (get key :origin) :value-data-origin (get value :origin) :shape child-shape})) child-shape)
              (assoc (sh08-sm-failure "C7-ANNOTATION" :unsupported-structural-map-key nil :literal-keyword-key (get key :value))
                     :node (assoc node :source (get key :source)))))))
      (assoc base :shape-kind :scalar :domain {:values [(get data :value)]}))))

; L2/L5/L9: direct throws retain the original C6 transfer, including transfers
; whose payload never returns. No call or handler propagation is inferred here.
(defn sh08-th-error [rule reason node expected actual]
  {:status :rejected :constraints [] :throws {} :diagnostics
   [{:rule rule :reason reason :node node :expected expected :actual actual}]})

(defn sh08-th-owners [core budget]
  (let [nodes (sh08-ft-node-index (get core :nodes))]
    (loop [pending (loop [ids (get core :root-core-node-ids) out []]
                     (if (= 0 (count ids)) out
                       (recur (rest ids) (conj out {:id (first ids) :owner nil}))))
           owners {} work 0]
      (if (= 0 (count pending)) {:status :accepted :owners owners :work-count work}
        (if (>= work budget) (sh08-th-error "C7-GENERIC" :typed-throw-work-limit {} :bounded-source-visits work)
          (let [entry (first pending) id (get entry :id) node (get nodes id) owner (get entry :owner)
                child-owner (if (= :fn (get node :core-form)) (get (get node :source) :syntax-id) owner)]
            (if (if (map? node) (= false (contains? owners id)) false)
              (recur (loop [ids (get node :children) out (vec (rest pending))]
                       (if (= 0 (count ids)) out
                         (recur (rest ids) (conj out {:id (first ids) :owner child-owner}))))
                     (assoc owners id owner) (+ work 1))
              (sh08-th-error "C7-VERIFY" :typed-throw-owner-graph node :unique-rooted-node id))))))))

(defn sh08-th-transfer-valid? [transfer node payload forms owner ordinal]
  (let [source (get node :source) form (get forms (get source :form-id)) ids (get form :child-form-ids)
        operator (get forms (get ids 0)) value (get forms (get ids 1)) attrs (get node :attributes)
        shared [:construction-order :runtime-reachability :transfer-policy :result-policy :required-effect
                :authenticated-sh06-artifact-id :sh06-semantic-projection-id :type-legality :effect-registry-legality
                :effect-profile-capability-legality :profile-error-lowering-legality :ownership-legality :safety-classification]]
    (sh08-ft-all-true?
      [(map? transfer) (= ordinal (get transfer :ordinal)) (= :throw (get node :core-form))
       (= (get node :node-id) (get transfer :core-node-id))
       (= (get source :form-id) (get transfer :form-id)) (= (get source :syntax-id) (get transfer :syntax-id))
       (= source (get (sh08-bm-source-node {} form) :source))
       (= :list (get form :kind)) (vector? ids) (= 2 (count ids)) (sh08-all-unique? ids [])
       (if (seq? (get form :value)) (= ['throw (get value :value)] (vec (get form :value))) false)
       (= :symbol (get operator :kind)) (= 'throw (get operator :value)) (= [] (get operator :child-form-ids))
       (= (get form :form-id) (get operator :parent-form-id) (get value :parent-form-id))
       (= (get payload :source) (get (sh08-bm-source-node {} value) :source))
       (= [(get payload :node-id)] (get node :children) (get transfer :evaluated-children))
       (= (get payload :node-id) (get transfer :value-core-node-id)) (= [] (get node :resolved-binding-ids))
       (= :value-then-transfer (get (get node :evaluation) :kind) (get attrs :evaluation-order))
       (= [{:index 0 :core-node-id (get payload :node-id)}] (get (get node :evaluation) :order))
       (= owner (get transfer :evaluation-owner-function-syntax-id) (get (get node :evaluation) :owner-function-syntax-id))
       (= (get transfer :evaluation-region) (get (get node :evaluation) :region))
       (= [:evaluate-value :transfer-error] (get transfer :ordered-steps))
       (= 0 (get attrs :value-child-index)) (= :postorder-after-value (get attrs :construction-order))
       (= :error-transfer (get attrs :transfer-policy)) (= :never (get attrs :result-policy))
       (= :error/throw (get attrs :required-effect))
       (= :not-asserted-by-sh07-b7 (get attrs :runtime-reachability))
       (= [:pending-sh08 :pending-sh09 :pending-sh09 :pending-sh09 :pending-sh10 :pending-sh11]
          [(get attrs :type-legality) (get attrs :effect-registry-legality) (get attrs :effect-profile-capability-legality)
           (get attrs :profile-error-lowering-legality) (get attrs :ownership-legality) (get attrs :safety-classification)])
       (= (sh08-bm-project transfer shared) (sh08-bm-project attrs shared))])))

(defn sh08-th-products [core source-forms types budget]
  (let [nodes (get core :nodes) transfers (get core :error-transfers)
        throw-nodes (sh08-bm-select nodes :core-form :throw)]
    (if (= 0 (count throw-nodes))
      (if (if (= transfers nil) true (if (vector? transfers) (= [] transfers) false))
        {:status :accepted :constraints [] :throws {} :diagnostics [] :work-count 0}
        (sh08-th-error "C7-VERIFY" :typed-throw-transfer-census {} :no-extra-error-transfers transfers))
      ; Precharge bounded indexing, census, projection and fixed-width joins.
      ; The rooted walk and each transfer then consume their own visit.
      (let [work (+ (* 6 (count nodes)) (count source-forms) (* 70 (count throw-nodes))
                    (count (get core :call-edges)) (* 2 (count (get core :function-records))))
            indexed (sh08-ft-node-index nodes) forms (sh08-ft-index source-forms :form-id)
            owners (sh08-th-owners core (- budget work))]
        (if (if (<= work budget) (= :accepted (get owners :status)) false)
          (if (sh08-ft-all-true? [(vector? transfers) (= (count throw-nodes) (count (if (vector? transfers) transfers [])))
                 (sh08-ft-unique-records? (if (vector? transfers) transfers []) :core-node-id)
                 (= (set (keys (sh08-ft-node-index throw-nodes)))
                    (set (keys (sh08-ft-index (if (vector? transfers) transfers []) :core-node-id))))])
            (loop [remaining transfers ordinal 0 rows [] thrown {} used (+ work (get owners :work-count))]
              (if (= 0 (count remaining))
                {:status :accepted :constraints rows :throws thrown :diagnostics [] :work-count used}
                (if (>= used budget) (sh08-th-error "C7-GENERIC" :typed-throw-work-limit {} :bounded-source-visits used)
                  (let [transfer (first remaining) node (get indexed (get transfer :core-node-id))
                        payload (get indexed (get transfer :value-core-node-id))
                        owner (get (get owners :owners) (get node :node-id))
                        type (get types (get payload :node-id) :gravity.type/unknown)
                        occurring? (= false (= type :gravity.type/never))
                        premise {:version :sh08-direct-typed-throw-v1 :source-transfer transfer :source-node node
                                 :payload-node payload :payload-type type :owner-function-syntax-id owner
                                 :normal-transfer? occurring? :result-type :gravity.type/never}]
                    (if (sh08-th-transfer-valid? transfer node payload forms owner ordinal)
                      (if (sh08-ft-known? type)
                        (recur (rest remaining) (+ ordinal 1)
                          (conj rows {:constraint-id-request {:domain :gravity/sh08-direct-typed-throw-v1 :premise premise}
                            :kind :equality :producer-rule :sh08-direct-typed-throw-v1
                            :lhs (get node :node-id) :rhs :gravity.type/never :dependencies premise
                            :origin (get (get node :source) :origin-chain)
                            :invalidation [:error-transfers :throw-source :payload-source :payload-type :function-owner :evaluation-order]
                            :solution {:type :gravity.type/never :payload-type type :normal-transfer? occurring?}
                            :profile (get (get core :module) :profile) :target (get (get core :module) :target)
                            :status :solved :diagnostics []})
                          (assoc thrown owner (if (if occurring? (= false (contains? (set (get thrown owner [])) type)) false)
                                                (conj (get thrown owner []) type) (get thrown owner [])))
                          (+ used 1))
                        (sh08-th-error "C7-ANNOTATION" :typed-throw-payload-type-required payload :concrete-error-value type))
                      (sh08-th-error "C7-VERIFY" :typed-throw-source-transfer-join node :exact-original-error-transfer transfer))))))
            (sh08-th-error "C7-VERIFY" :typed-throw-transfer-census {} :complete-unique-error-transfers transfers))
          (if (= :rejected (get owners :status)) owners
            (sh08-th-error "C7-GENERIC" :typed-throw-work-limit {} :bounded-source-visits work)))))))

(defn sh08-th-functions [functions thrown]
  (loop [remaining functions out []]
    (if (= 0 (count remaining)) out
      (let [function (first remaining) id (get function :function-id)]
        (recur (rest remaining) (conj out (if (contains? thrown id)
          (assoc function :thrown-error-effects (get thrown id)) function)))))))

(defn sh08-th-call-fence [core thrown]
  (loop [remaining (get core :call-edges)]
    (if (= 0 (count remaining)) nil
      (let [edge (first remaining)]
        (if (if (contains? thrown (get edge :callee-function-syntax-id)) true
              (contains? thrown (get edge :caller-function-syntax-id)))
          (first (get (sh08-th-error "C7-ANNOTATION" :typed-throw-call-propagation-pending
            (get (sh08-ft-node-index (get core :nodes)) (get edge :call-core-node-id))
            :proved-thrown-error-call-propagation (get edge :callee-function-syntax-id)) :diagnostics))
          (recur (rest remaining)))))))

(defn sh08-th-type-map [table thrown]
  (loop [ids (keys table) out table]
    (if (= 0 (count ids)) out
      (let [id (first ids) type (get table id) owner (get type :function-id)]
        (recur (rest ids) (if (if (map? type) (contains? thrown owner) false)
          (assoc out id (assoc type :thrown-error-effects (get thrown owner))) out))))))

(defn sh08-ft-infer-node-nominal
  [node type-table binding-types function-types edges context]
  (let [core-form (get node :core-form)
        children (get node :children)]
    (if (= core-form :throw) :gravity.type/never
    (if (= core-form :loop) (sh08-ft-last-type children type-table)
    (if (= core-form :recur)
      (if (contains? #{:loop :function} (get (get node :attributes) :target-kind)) :gravity.type/never :gravity.type/unknown)
    (if (= core-form :literal)
      (let [literal-type
            (sh08-primitive-type-from-literal-kind
             (get (get node :attributes) :literal-kind))]
        (if (= literal-type nil)
          :gravity.type/unknown
          literal-type))
      (if (= core-form :quote)
        (get (get context :quote-types) (get node :node-id) :gravity.type/unknown)
      (if (= core-form :collection-literal)
        (sh08-ft-collection-type node type-table)
        (if (= core-form :reference)
          (get binding-types
               (get (get node :attributes) :binding-id)
               :gravity.type/unknown)
          (if (= core-form :def)
            (get type-table (first children) :gravity.type/unknown)
            (if (= core-form :fn)
              (get function-types
                   (get (get node :source) :syntax-id)
                   :gravity.type/unknown)
              (if (= core-form :if)
                (sh08-ft-if-join-with-context children type-table context)
                (if (= core-form :do)
                  (sh08-ft-last-type children type-table)
                  (if (= core-form :let)
                    (sh08-ft-last-type children type-table)
                    (if (= core-form :call)
                    (let [edge
                          (sh08-ft-edge-by-call-id
                           edges (get node :node-id))]
                      (if (if (map? edge)
                            (= (get edge :classification) :local-function)
                            false)
                        (get
                         (sh08-ft-function-by-id
                          function-types
                          (get edge :callee-function-syntax-id))
                         :return
                         :gravity.type/unknown)
                        (if (if (= :accepted (get context :status))
                              (= (get node :node-id)
                                 (get context :inner-call-core-node-id))
                              false)
                          (get context :value-type :gravity.type/unknown)
                          (get (get (sh08-im-callee edge context) :function-type) :return :gravity.type/unknown))))
                    (if (= core-form :match)
                      (sh08-bm-join (sh08-gd-branch-ids node) type-table)
                      :gravity.type/unknown))))))))))))))))

(defn sh08-ft-infer-node-with-context
  [node type-table binding-types function-types edges context]
  (let [nominal (sh08-ft-infer-node-nominal node type-table binding-types function-types edges context)
        form (get node :core-form) children (sh08-ft-ordered-child-types (get node :children) type-table)]
    (if (= form :match)
      (if (= :gravity.type/never (first children)) :gravity.type/never nominal)
      (let [joined (sh08-ft-normal-return-type form children nominal)]
        (if (if (= form :if) (if (= joined :gravity.type/unknown) (= :accepted (get context :status)) false) false)
          nominal joined)))))

; L7/C7: finite Boolean matches consume the authenticated C6 decision products.
; Match premises and solutions live in the existing identity-bound ledger.
(defn sh08-bm-project [record fields]
  (loop [remaining fields result {}]
    (if (= (count remaining) 0) result
      (recur (rest remaining) (assoc result (first remaining) (get record (first remaining)))))))

(defn sh08-bm-select [records field value]
  (if (vector? records)
    (loop [remaining records result []]
      (if (= (count remaining) 0) result
        (recur (rest remaining)
               (if (= value (get (first remaining) field)) (conj result (first remaining)) result))))
    []))

(defn sh08-bm-join [children types]
  (sh08-ft-normal-return-type :alternatives (sh08-ft-ordered-child-types children types) :gravity.type/unknown))

(defn sh08-bm-tree [nodes root]
  (loop [pending [root] seen #{}]
    (if (= (count pending) 0) seen
      (let [id (first pending)]
        (if (contains? seen id) (recur (rest pending) seen)
          (recur (sh08-ft-add-values-to-set (get (get nodes id) :children) (rest pending))
                 (conj seen id)))))))

(defn sh08-bm-uses [nodes tree binding-id]
  (loop [remaining nodes result []]
    (if (= (count remaining) 0) result
      (let [node (first remaining)]
        (recur (rest remaining)
          (if (if (= :reference (get node :core-form))
                (if (= binding-id (get (get node :attributes) :binding-id))
                  (contains? tree (get node :node-id)) false) false)
            (conj result (get (get node :source) :syntax-id)) result))))))

(defn sh08-bm-pattern-value [form]
  (let [value (get form :value)]
    (if (= :list (get form :kind))
      (if (seq? value)
        (if (= 2 (count value))
          (if (= 'quote (first value))
            (if (symbol? (second value)) (second value) value) value) value) value) value)))

(defn sh08-bm-source-kind-valid? [branch form]
  (let [kind (get branch :pattern-kind) value (get form :value)
        binding (get branch :pattern-binding-id) scope (get branch :pattern-binding-scope-id)]
    (if (= :binding kind)
      (if (= :symbol (get form :kind))
        (if (symbol? value) (if (= '_ value) false
          (if (sh08-sha256-id? binding) (sh08-sha256-id? scope) false)) false) false)
      (if (= binding nil)
        (if (= scope nil)
          (if (= :wildcard kind)
            (if (= :symbol (get form :kind)) (= '_ value) false)
            (if (= :literal kind)
              (if (contains? #{:nil :boolean :integer :decimal :ratio :character :string :keyword} (get form :kind)) true
                (if (= :list (get form :kind))
                  (if (seq? value) (if (= 2 (count value))
                    (if (= 'quote (first value)) (symbol? (second value)) false) false) false) false)) false))
          false) false))))

(defn sh08-bm-branch-valid? [node branch pattern ordinal nodes bindings forms sequence]
  (let [attributes (get node :attributes)
        clause (get (get attributes :branch-clauses) ordinal)
        body (get nodes (get branch :branch-core-node-id))
        form (get forms (get branch :pattern-form-id))
        owner (get forms (get (get node :source) :form-id))
        body-form (get forms (get branch :branch-form-id))
        binding-id (get branch :pattern-binding-id)
        binding (get bindings binding-id)
        uses (if (= binding-id nil) []
               (sh08-bm-uses sequence (sh08-bm-tree nodes (get body :node-id)) binding-id))
        clause-fields [:clause-ordinal :branch-child-index :pattern-kind :pattern-form-id
                       :pattern-syntax-id :pattern-value :branch-form-id :branch-syntax-id
                       :pattern-binding-id :pattern-binding-scope-id :pattern-binding-ids]]
    (sh08-ft-all-true?
      [(map? branch) (map? pattern) (map? form) (map? owner) (map? body-form)
       (= (sh08-bm-project branch clause-fields) clause)
       (= ordinal (get branch :clause-ordinal)) (= ordinal (get pattern :clause-ordinal))
       (= (count (get attributes :branch-clauses)) (get branch :clause-count))
       (= (+ ordinal 1) (get branch :branch-child-index))
       (= (get branch :core-node-id) (get node :node-id) (get pattern :core-node-id))
       (= (get branch :scrutinee-core-node-id) (first (get node :children)))
       (= (get branch :branch-core-node-id) (get (get node :children) (+ ordinal 1)))
       (= (get branch :pattern-form-id) (get form :form-id) (get pattern :pattern-form-id)
          (get (get owner :child-form-ids) (+ 2 (* 2 ordinal))))
       (= (get branch :pattern-syntax-id) (get form :syntax-id) (get pattern :pattern-syntax-id))
       (= (get branch :branch-form-id) (get (get body :source) :form-id)
          (get (get owner :child-form-ids) (+ 3 (* 2 ordinal))))
       (= (get branch :branch-syntax-id) (get (get body :source) :syntax-id) (get body-form :syntax-id))
       (= (get branch :pattern-kind) (get pattern :pattern-kind))
       (sh08-bm-source-kind-valid? branch form)
       (= (get branch :pattern-value) (get pattern :pattern-value)
          (sh08-bm-pattern-value form))
       (= 0 (get pattern :depth) (get pattern :local-ordinal) (get pattern :root-local-ordinal))
       (= [] (get pattern :path)) (= nil (get pattern :parent-ordinal) (get pattern :parent-local-ordinal))
       (= (get pattern :ordinal) (get pattern :root-ordinal))
       (= (get branch :pattern-binding-id) (get pattern :pattern-binding-id))
       (= (get branch :pattern-binding-scope-id) (get pattern :pattern-binding-scope-id))
       (= uses (get branch :pattern-binding-use-syntax-ids) (get pattern :pattern-binding-use-syntax-ids))
       (if (= binding-id nil) true
         (= uses (sh08-bm-uses sequence (set (keys nodes)) binding-id)))
       (= (get branch :pattern-binding-ids) (if (= binding-id nil) [] [binding-id]))
       (if (= binding-id nil) true
         (sh08-ft-all-true?
           [(= :binding (get branch :pattern-kind)) (= :lexical (get binding :binding-class))
            (= (get binding :definition-syntax-id) (get form :syntax-id))
            (= (get binding :name) (get form :value))
            (= (get binding :scope-id) (get form :scope-id) (get branch :pattern-binding-scope-id))]))
       (= (get branch :conditional-region)
          {:kind :match-branch :match-syntax-id (get (get node :source) :syntax-id) :clause-ordinal ordinal})
       (= (get branch :conditional-region) (get (get body :evaluation) :region))
       (= :evaluate-scrutinee-once (get branch :scrutinee-evaluation))
       (= :conditionally-evaluate-selected-branch (get branch :branch-evaluation))
       (= (get attributes :authenticated-sh06-artifact-id)
          (get branch :authenticated-sh06-artifact-id) (get pattern :authenticated-sh06-artifact-id))
       (= (get attributes :sh06-semantic-projection-id)
          (get branch :sh06-semantic-projection-id) (get pattern :sh06-semantic-projection-id))])))

(defn sh08-bm-group-valid? [node branches patterns skeleton nodes bindings forms sequence]
  (let [attributes (get node :attributes) count-branches (count branches)]
    (if (if (map? skeleton)
          (if (vector? (get skeleton :branch-core-node-ids))
          (if (> count-branches 0)
          (if (vector? (get attributes :branch-clauses))
            (= count-branches (count patterns) (count (get attributes :branch-clauses))
               (get attributes :branch-count) (- (count (get node :children)) 1)) false) false) false) false)
      (sh08-ft-all-true?
        [(= 0 (get attributes :scrutinee-child-index))
         (= (get node :children) (sh08-ft-add-values-to-set
                                  (get skeleton :branch-core-node-ids) [(first (get node :children))]))
         (= (get skeleton :scrutinee-core-node-id) (first (get node :children)))
         (= (get skeleton :core-node-id) (get node :node-id))
         (loop [remaining branches ordinal 0 ids [] indexes []]
           (if (= (count remaining) 0)
             (= [ids indexes] [(get node :resolved-binding-ids) (get attributes :branch-child-indexes)])
             (if (sh08-bm-branch-valid? node (first remaining) (get patterns ordinal) ordinal
                                       nodes bindings forms sequence)
               (recur (rest remaining) (+ ordinal 1)
                      (sh08-ft-add-values-to-set (get (first remaining) :pattern-binding-ids) ids)
                      (conj indexes (+ ordinal 1))) false)))
         (= :source-ordered-pattern-candidates (get skeleton :selection-policy) (get attributes :selection-policy))
         (= :not-asserted-by-sh07-b11 (get skeleton :runtime-reachability) (get attributes :runtime-reachability))
         (= :pending-sh08 (get skeleton :result-type-join) (get attributes :result-type-join)
            (get skeleton :exhaustiveness) (get attributes :exhaustiveness))
         (= (get skeleton :authenticated-sh06-artifact-id) (get attributes :authenticated-sh06-artifact-id))
         (= (get skeleton :sh06-semantic-projection-id) (get attributes :sh06-semantic-projection-id))]) false)))

(defn sh08-bm-source-node [node form]
  (assoc node :source
    {:form-id (get form :form-id) :syntax-id (get form :syntax-id)
     :semantic-span (get form :source-span) :origin-chain (get form :origin-chain)
     :generated-origin (get form :generated-origin)}))

(defn sh08-bm-products [core products source-forms]
  (if (= :accepted (get products :status))
    (let [sequence (get core :nodes) nodes (get products :node-table)
          matches (sh08-bm-select sequence :core-form :match)
          branches (get core :match-branch-records)
          patterns (get core :match-pattern-records)
          skeletons (get core :match-decision-skeletons)
          forms (loop [remaining source-forms result {}]
                  (if (= (count remaining) 0) result
                    (recur (rest remaining) (assoc result (get (first remaining) :form-id) (first remaining)))))]
      (if (sh08-ft-all-true? [(vector? branches) (vector? patterns) (vector? skeletons)])
      (if (sh08-ft-all-true?
            [(loop [rows branches ordinal 0]
               (if (= (count rows) 0) true
                 (if (= ordinal (get (first rows) :ordinal)) (recur (rest rows) (+ ordinal 1)) false)))
             (loop [rows patterns ordinal 0]
               (if (= (count rows) 0) true
                 (if (= ordinal (get (first rows) :ordinal)) (recur (rest rows) (+ ordinal 1)) false)))])
      (if (= (count matches) 0)
        (if (sh08-ft-all-true? [(= 0 (count branches)) (= 0 (count patterns)) (= 0 (count skeletons))])
          products {:status :rejected :reason :orphan-match-products})
        (if (sh08-ft-all-true? [(vector? branches) (vector? patterns) (vector? skeletons)
                                (= (count matches) (count skeletons))])
          (loop [remaining matches consumed-branches 0 consumed-patterns 0 groups []]
            (if (= (count remaining) 0)
              (if (= [consumed-branches consumed-patterns] [(count branches) (count patterns)])
                (assoc products :boolean-matches groups)
                {:status :rejected :reason :orphan-match-products})
              (let [node (first remaining) id (get node :node-id)
                    bs (sh08-bm-select branches :core-node-id id)
                    ps (sh08-bm-select patterns :core-node-id id)
                    roots (sh08-bm-select ps :depth 0)
                    ss (sh08-bm-select skeletons :core-node-id id)
                    unsupported (loop [rs roots]
                                  (if (= (count rs) 0) nil
                                    (if (contains? #{:literal :wildcard :binding} (get (first rs) :pattern-kind))
                                      (recur (rest rs)) (first rs))))]
                (if (= unsupported nil)
                  (if (if (= (count ss) 1)
                        (if (= (count ps) (count roots))
                          (sh08-bm-group-valid? node bs ps (first ss) nodes (get products :binding-index) forms sequence)
                          false) false)
                    (recur (rest remaining) (+ consumed-branches (count bs)) (+ consumed-patterns (count ps))
                           (conj groups {:node node :branches bs :patterns ps :skeleton (first ss) :forms forms :nodes nodes
                             :lexical-bindings (get products :lexical-bindings) :binding-index (get products :binding-index)
                             :pattern-trees (loop [rows ps values []]
                                              (if (= (count rows) 0) values
                                                (recur (rest rows) (conj values {:record (first rows)
                                                  :form (get forms (get (first rows) :pattern-form-id)) :children []}))))}))
                    {:status :rejected :reason :malformed-boolean-match-products :node node})
                  (let [result (sh08-sm-group node bs ps (first ss) nodes (get products :binding-index)
                                             forms sequence (get products :lexical-bindings) (get products :calls))]
                    (if (= :accepted (get result :status))
                      (recur (rest remaining) (+ consumed-branches (count bs)) (+ consumed-patterns (count ps))
                             (conj groups result))
                      (assoc result :node (sh08-bm-source-node node (get forms (get (get result :record) :pattern-form-id))))))))))
          {:status :rejected :reason :malformed-match-product-families}))
        {:status :rejected :reason :malformed-match-product-ordinals})
        {:status :rejected :reason :malformed-match-product-families})) products))

(defn sh08-bm-seed-bindings [groups nodes prior-types bindings functions edges context]
  (loop [remaining groups result bindings]
    (if (= (count remaining) 0) result
      (let [group (first remaining)
            scrutinee (get nodes (first (get (get group :node) :children)))
            type (sh08-ft-infer-node-with-context scrutinee prior-types bindings functions edges context)]
        (recur (rest remaining)
          (if (sh08-sm-applicable? group type)
            (sh08-sm-seed group prior-types result functions)
          (if (if (= :gravity.type/bool type) (= false (contains? group :unsupported-pattern)) false)
            (loop [branches (get group :branches) values result]
              (if (= (count branches) 0) values
                (let [id (get (first branches) :pattern-binding-id)]
                  (recur (rest branches) (if (= id nil) values (assoc values id :gravity.type/bool)))))) result)))))))

(defn sh08-bm-error [rule reason node expected actual]
  {:rule rule :reason reason :node node :expected expected :actual actual})

(defn sh08-bm-check [group types functions module]
  (let [node (get group :node) branches (get group :branches)
        scrutinee-id (first (get node :children)) type (get types scrutinee-id :gravity.type/unknown)
        owner (get functions (get (get node :evaluation) :owner-function-syntax-id))
        declared (if (= (get owner :body-core-node-id) (get node :node-id))
                   (get (get (get owner :signature) :return) :type-id) nil)]
    (if (= type :gravity.type/bool)
      (if (contains? group :unsupported-pattern)
        (let [pattern (get group :unsupported-pattern)]
          {:diagnostic (sh08-bm-error (if (contains? pattern :guard) "C7-ANNOTATION" "L7-PATTERN-TYPE")
                         :unsupported-boolean-pattern
                         (sh08-bm-source-node node (get (get group :forms) (get pattern :pattern-form-id)))
                         :boolean-root-pattern (get pattern :pattern-kind))})
      (loop [remaining branches domain [true false] result-type :gravity.type/unknown facts []]
        (if (= (count remaining) 0)
          (if (= (count domain) 0) {:constraints facts :type result-type}
            {:diagnostic (sh08-bm-error (if (= :formal (get module :profile)) "L7-NONEXHAUSTIVE" "C7-ANNOTATION")
                           (if (= :formal (get module :profile)) :nonexhaustive-boolean-match :unsupported-partial-boolean-match)
                           node :exhaustive-boolean-match domain)})
          (let [branch (first remaining) kind (get branch :pattern-kind) value (get branch :pattern-value)
                pattern-node (sh08-bm-source-node node (get (get group :forms) (get branch :pattern-form-id)))
                allowed (if (= kind :literal) (if (contains? #{true false} value) [value] []) domain)
                selected (loop [ds domain values []]
                           (if (= (count ds) 0) values
                             (recur (rest ds) (if (contains? (set allowed) (first ds)) (conj values (first ds)) values))))
                residual (loop [ds domain values []]
                           (if (= (count ds) 0) values
                             (recur (rest ds) (if (contains? (set selected) (first ds)) values (conj values (first ds))))))
                body-id (get branch :branch-core-node-id) body-type (get types body-id :gravity.type/unknown)
                expected (if (= declared nil) result-type declared)]
            (if (if (= kind :literal) (= (count allowed) 0) false)
              {:diagnostic (sh08-bm-error "L7-PATTERN-TYPE" :boolean-pattern-type-mismatch pattern-node :gravity.type/bool value)}
              (if (= (count selected) 0)
                {:diagnostic (sh08-bm-error "L7-UNREACHABLE" :unreachable-boolean-match-clause pattern-node :remaining-boolean-case value)}
                (if (sh08-ft-known? body-type)
                  (if (if (sh08-ft-known? expected)
                        (if (= body-type :gravity.type/never) true
                          (if (if (= declared nil) (= expected :gravity.type/never) false) true (= expected body-type))) true)
                    (recur (rest remaining) residual
                      (if (= result-type :gravity.type/unknown) body-type
                        (sh08-ft-normal-return-type :alternatives [result-type body-type] :gravity.type/unknown))
                      (conj facts
                        {:constraint-id-request {:domain :gravity/sh08-boolean-match-constraint-v1
                           :match-core-node-id (get node :node-id) :clause-ordinal (get branch :clause-ordinal)
                           :branch branch :pattern (get (get group :patterns) (get branch :clause-ordinal)) :skeleton (get group :skeleton)}
                         :kind :equality :producer-rule :sh08-boolean-match-v1
                         :lhs body-id :rhs body-type :scrutinee-type type
                         :remaining-before domain :matched-values selected :remaining-after residual
                         :pattern-binding-id (get branch :pattern-binding-id)
                         :pattern-binding-scope-id (get branch :pattern-binding-scope-id)
                         :binding-type (if (= kind :binding) :gravity.type/bool nil)
                         :exhaustive-after? (= (count residual) 0)
                         :source (get pattern-node :source)
                         :branch-source (get (get (get group :nodes) body-id) :source)
                         :dependencies [scrutinee-id body-id] :invalidation [:c6-match-products :scrutinee-type :branch-types :binding-scopes]
                         :profile (get module :profile) :target (get module :target)
                         :status :solved :diagnostics []}))
                    {:diagnostic (sh08-bm-error (if (= declared nil) "C7-ANNOTATION" "C7-TYPE-MISMATCH")
                                     (if (= declared nil) :unsupported-heterogeneous-boolean-match-join :boolean-match-branch-type-mismatch)
                                     (get (get group :nodes) body-id) expected body-type)})
                  {:diagnostic (sh08-bm-error "C7-ANNOTATION" :unknown-boolean-match-branch-type pattern-node :established-branch-type body-type)})))))))
      {:diagnostic (sh08-bm-error "C7-ANNOTATION" :unsupported-boolean-match-scrutinee node :gravity.type/bool type)})))

(defn sh08-bm-checks [groups types functions module]
  (loop [remaining groups constraints [] diagnostics []]
    (if (= (count remaining) 0) {:constraints constraints :diagnostics diagnostics}
      (let [group (first remaining)
            type (get types (first (get (get group :node) :children)) :gravity.type/unknown)
            checked (if (sh08-sm-applicable? group type)
                      (sh08-sm-check group types functions module)
                      (sh08-bm-check group types functions module))]
        (recur (rest remaining) (sh08-ft-add-values-to-set (get checked :constraints) constraints)
               (if (contains? checked :diagnostic) (conj diagnostics (get checked :diagnostic)) diagnostics))))))

; L7/C7 constructor-linked structural evidence. Collection source-value is
; syntax data, never a value evaluator or evidence for an extracted field.
(defn sh08-sm-failure [rule reason record expected actual]
  {:status :rejected :rule rule :reason reason :record record :expected expected :actual actual})

(defn sh08-gd-branch-ids [node]
  (let [indexes (get (get node :attributes) :branch-child-indexes) children (get node :children)]
    (if (vector? indexes)
      (loop [remaining indexes ids []]
        (if (= (count remaining) 0) ids
          (let [index (first remaining)]
            (if (integer? index)
              (if (if (> index 0) (< index (count children)) false)
                (recur (rest remaining) (conj ids (get children index))) []) [])))) [])))

(defn sh08-gd-source [guard]
  (sh08-bm-project guard [:rule-version :source-child-index :form-id :syntax-id]))

(defn sh08-gd-clause [source index region]
  (assoc source :child-index index :conditional-region region :evaluation :once-after-structural-success
                :on-pattern-failure :next-candidate :on-true :branch-body :on-false :next-candidate
                :non-boolean-type-effect-legality :pending-later-legality))

(defn sh08-gd-values [branches field]
  (loop [remaining branches result []]
    (if (= (count remaining) 0) result
      (recur (rest remaining)
        (if (contains? (first remaining) :guard) (conj result (get (get (first remaining) :guard) field)) result)))))

(defn sh08-gd-source-valid? [record form forms]
  (if (contains? record :guard)
    (let [guard (get record :guard) index (get guard :source-child-index)]
      (if (integer? index)
        (if (if (> index 0) (< index (count (get form :child-form-ids))) false)
          (let [key (get forms (get (get form :child-form-ids) (- index 1)))
                expression (get forms (get (get form :child-form-ids) index))]
            (sh08-ft-all-true?
              [(sh08-ft-record-shape? guard #{:rule-version :source-child-index :form-id :syntax-id})
               (= :sh07-root-map-guard-v1 (get guard :rule-version))
               (= :map (get record :pattern-kind) (get form :kind))
               (= 0 (get record :depth)) (= nil (get record :parent-ordinal))
               (= :keyword (get key :kind)) (= :when (get key :value))
               (integer? (/ (- index 1) 2))
               (= (get key :parent-form-id) (get form :form-id) (get expression :parent-form-id))
               (= (get guard :form-id) (get expression :form-id))
               (= (get guard :syntax-id) (get expression :syntax-id))])) false) false))
    (if (= :map (get form :kind)) (= false (contains? (get form :value) :when)) true)))

(defn sh08-gd-own-tree [nodes body guard]
  (let [tree (sh08-bm-tree nodes body)]
    (if (= guard nil) tree (sh08-ft-add-values-to-set (sh08-bm-tree nodes guard) tree))))

(defn sh08-gd-call-ids [nodes tree]
  (loop [remaining nodes result []]
    (if (= (count remaining) 0) result
      (let [node (first remaining)]
        (recur (rest remaining)
          (if (if (= :call (get node :core-form)) (contains? tree (get node :node-id)) false)
            (conj result (get node :node-id)) result))))))

(defn sh08-gd-branch-valid? [node branch root clause index nodes forms sequence calls]
  (if (contains? branch :guard)
    (let [guard (get branch :guard) source (sh08-gd-source guard)
          expression (get nodes (get guard :node-id))
          source-form (get forms (get source :form-id))
          region {:kind :match-guard :match-syntax-id (get (get node :source) :syntax-id)
                  :clause-ordinal (get branch :clause-ordinal)}
          expected (sh08-gd-clause source index region)
          tree (sh08-bm-tree nodes (get guard :node-id))
          actual-calls (sh08-gd-call-ids sequence tree)
          listed-calls (loop [remaining calls ids []]
                         (if (= (count remaining) 0) ids
                           (recur (rest remaining)
                             (if (contains? tree (get (first remaining) :core-node-id))
                               (conj ids (get (first remaining) :core-node-id)) ids))))]
      (sh08-ft-all-true?
        [(sh08-gd-source-valid? root (get forms (get root :pattern-form-id)) forms)
         (= source (get root :guard)) (= expected (get clause :guard))
         (= guard (assoc expected :node-id (get guard :node-id)))
         (= (get guard :node-id) (get (get node :children) index))
         (= (get expression :node-id) (get guard :node-id))
         (= (get (get expression :source) :form-id) (get source :form-id))
         (= (get (get expression :source) :syntax-id) (get source :syntax-id))
         (if (= :literal (get expression :core-form))
           (if (= (get (get expression :attributes) :literal-kind) (get source-form :kind))
             (= (get (get expression :attributes) :value) (get source-form :value)) false) true)
         (= (get (get expression :evaluation) :region) region)
         (= actual-calls listed-calls)]))
    (if (contains? root :guard) false (= false (contains? clause :guard)))))

(defn sh08-sm-source-children [form forms]
  (let [kind (get form :kind) ids (get form :child-form-ids)]
    (if (contains? #{:map :vector} kind)
      (if (vector? ids)
        (if (if (= kind :map) (sh08-even-count? ids) true)
          (loop [remaining ids coordinate 0 seen #{} result []]
            (if (= (count remaining) 0) {:status :accepted :children result}
              (let [key-form (if (= kind :map) (get forms (first remaining)) nil)
                    child-id (if (= kind :map) (second remaining) (first remaining))
                    child (get forms child-id) key (get key-form :value)]
                (if (if (= kind :map)
                      (sh08-ft-all-true? [(= :keyword (get key-form :kind)) (keyword? key)
                                          (= false (contains? seen key))
                                          (map? (get form :value)) (contains? (get form :value) key)
                                          (= (get child :value) (get (get form :value) key))
                                          (= (get form :form-id) (get key-form :parent-form-id))]) true)
                  (if (if (= (get child :parent-form-id) (get form :form-id))
                        (if (= kind :vector) (= (get child :value) (get (get form :value) coordinate)) true) false)
                    (if (= key :when)
                      (recur (rest (rest remaining)) (+ coordinate 2) (conj seen key) result)
                      (recur (if (= kind :map) (rest (rest remaining)) (rest remaining))
                             (+ coordinate (if (= kind :map) 2 1)) (conj seen key)
                             (conj result {:form-id child-id :coordinate (if (= kind :map) (+ coordinate 1) coordinate)
                                           :key key :key-form-id (get key-form :form-id)})))
                    (sh08-sm-failure "C7-VERIFY" :pattern-child-source-parent nil :exact-parent child-id))
                  (sh08-sm-failure "C7-VERIFY" :pattern-key-source-mismatch nil :unique-source-keyword key)))))
          (sh08-sm-failure "C7-VERIFY" :odd-pattern-map-children nil :even-key-value-children ids))
        (sh08-sm-failure "C7-VERIFY" :malformed-pattern-source-children nil :source-child-vector ids))
      {:status :accepted :children []})))

(defn sh08-sm-pattern-kind-valid? [record form]
  (if (= :map (get record :pattern-kind))
    (sh08-ft-all-true? [(= :map (get form :kind)) (= (get record :pattern-value) (get form :value))
                        (= nil (get record :vector-width) (get record :pattern-binding-id) (get record :pattern-binding-scope-id))])
    (if (= :vector (get record :pattern-kind))
      (if (vector? (get form :child-form-ids))
        (sh08-ft-all-true? [(= :vector (get form :kind)) (= (get record :vector-width) (count (get form :child-form-ids)))
                            (= nil (get record :pattern-value) (get record :pattern-binding-id) (get record :pattern-binding-scope-id))]) false)
      (if (= nil (get record :vector-width))
        (if (= (get record :pattern-value) (sh08-bm-pattern-value form))
          (sh08-bm-source-kind-valid? record form) false) false))))

(defn sh08-sm-pattern-tree [records index root-index parent-index path form-id group bindings sequence]
  (let [record (get records index) root (get records root-index)
        form (get (get group :forms) form-id) node (get group :node)
        binding-id (get record :pattern-binding-id) binding (get bindings binding-id)
        body-id (get group :branch-id) nodes (get group :nodes)
        uses (if (= binding-id nil) [] (sh08-bm-uses sequence (sh08-gd-own-tree nodes body-id (get group :guard-id)) binding-id))
        children (sh08-sm-source-children form (get group :forms))]
    (if (sh08-ft-all-true?
          [(sh08-ft-record-shape? record
             (if (contains? record :guard)
               (conj #{:ordinal :clause-ordinal :local-ordinal :parent-local-ordinal :root-local-ordinal :parent-ordinal :root-ordinal
                       :core-node-id :depth :path :pattern-kind :pattern-form-id :pattern-syntax-id :pattern-value :vector-width
                       :pattern-binding-id :pattern-binding-scope-id :pattern-binding-use-syntax-ids
                       :authenticated-sh06-artifact-id :sh06-semantic-projection-id} :guard)
             #{:ordinal :clause-ordinal :local-ordinal :parent-local-ordinal :root-local-ordinal :parent-ordinal :root-ordinal
               :core-node-id :depth :path :pattern-kind :pattern-form-id :pattern-syntax-id :pattern-value :vector-width
               :pattern-binding-id :pattern-binding-scope-id :pattern-binding-use-syntax-ids
               :authenticated-sh06-artifact-id :sh06-semantic-projection-id}))
           (map? form) (= (get record :pattern-form-id) form-id)
           (= (get record :pattern-syntax-id) (get form :syntax-id))
           (= (get record :core-node-id) (get node :node-id))
           (= (get record :clause-ordinal) (get root :clause-ordinal))
           (= (get record :local-ordinal) (- index root-index)) (= 0 (get record :root-local-ordinal))
           (= (get record :root-ordinal) (get root :ordinal))
           (= (get record :parent-local-ordinal) (if (= parent-index nil) nil (- parent-index root-index)))
           (= (get record :parent-ordinal) (if (= parent-index nil) nil (get (get records parent-index) :ordinal)))
           (= path (get record :path)) (= (count path) (get record :depth))
           (sh08-sm-pattern-kind-valid? record form)
           (sh08-gd-source-valid? record form (get group :forms))
           (= (get record :pattern-binding-use-syntax-ids) uses)
           (if (= binding-id nil) true
             (sh08-ft-all-true?
               [(= uses (sh08-bm-uses sequence (set (keys nodes)) binding-id))
                (= :lexical (get binding :binding-class))
                (= (get binding :definition-syntax-id) (get form :syntax-id))
                (= (get binding :name) (get form :value))
                (= (get binding :scope-id) (get form :scope-id) (get record :pattern-binding-scope-id))]))
           (= (get record :authenticated-sh06-artifact-id) (get (get node :attributes) :authenticated-sh06-artifact-id))
           (= (get record :sh06-semantic-projection-id) (get (get node :attributes) :sh06-semantic-projection-id))])
      (if (= :accepted (get children :status))
        (loop [remaining (get children :children) next-index (+ index 1) trees [] ids (if (= binding-id nil) [] [binding-id])]
          (if (= (count remaining) 0)
            {:status :accepted :next-index next-index :binding-ids ids
             :tree {:record record :form form :children trees}}
            (let [child (first remaining)
                  result (sh08-sm-pattern-tree records next-index root-index index
                           (conj path (get child :coordinate)) (get child :form-id) group bindings sequence)]
              (if (= :accepted (get result :status))
                (recur (rest remaining) (get result :next-index)
                       (conj trees (assoc child :tree (get result :tree)))
                       (sh08-ft-add-values-to-set (get result :binding-ids) ids)) result))))
        (assoc children :record record))
      (sh08-sm-failure "C7-VERIFY" :malformed-structural-pattern-tree record :exact-source-coordinate-binding-join form-id))))

(defn sh08-sm-group [node branches patterns skeleton nodes bindings forms sequence lexical calls]
  (let [attrs (get node :attributes) clauses (get attrs :branch-clauses)
        owner (get forms (get (get node :source) :form-id))
        guard-ids (sh08-gd-values branches :node-id)
        base {:node node :branches branches :patterns patterns :skeleton skeleton :nodes nodes :forms forms :calls calls :node-sequence sequence
              :lexical-bindings lexical :binding-index bindings :structural? true}
        clause-fields [:clause-ordinal :branch-child-index :pattern-kind :pattern-form-id :pattern-syntax-id
                       :pattern-value :branch-form-id :branch-syntax-id :pattern-binding-id :pattern-binding-scope-id :pattern-binding-ids]]
    (if (if (vector? clauses)
          (if (vector? (get skeleton :branch-core-node-ids))
            (sh08-ft-all-true? [(sh08-ft-record-shape? skeleton
                                 #{:core-node-id :scrutinee-core-node-id :branch-core-node-ids :selection-policy :runtime-reachability
                                   :result-type-join :exhaustiveness :authenticated-sh06-artifact-id :sh06-semantic-projection-id})
                               (sh08-ft-record-shape? attrs
                                 (if (> (count guard-ids) 0)
                                   #{:scrutinee-child-index :branch-count :branch-child-indexes :branch-clauses :evaluation-order
                                     :selection-policy :runtime-reachability :result-type-join :exhaustiveness
                                     :authenticated-sh06-artifact-id :sh06-semantic-projection-id :guard-rule-version :guard-child-indexes}
                                 #{:scrutinee-child-index :branch-count :branch-child-indexes :branch-clauses :evaluation-order
                                   :selection-policy :runtime-reachability :result-type-join :exhaustiveness
                                   :authenticated-sh06-artifact-id :sh06-semantic-projection-id}))
                               (> (count branches) 0) (= (count branches) (count clauses) (get attrs :branch-count))
                                (= (get node :children) (sh08-ft-add-values-to-set guard-ids
                                   (sh08-ft-add-values-to-set (get skeleton :branch-core-node-ids) [(first (get node :children))])))
                                (sh08-all-unique? (get node :children) [])
                                (if (> (count guard-ids) 0)
                                  (if (= :sh07-root-map-guard-v1 (get attrs :guard-rule-version) (get node :lowering-rule-version))
                                    (= (get attrs :guard-child-indexes) (sh08-gd-values branches :child-index)) false) true)
                                (= (get skeleton :core-node-id) (get node :node-id))
                                (= (get skeleton :scrutinee-core-node-id) (first (get node :children)))
                                (= (get skeleton :authenticated-sh06-artifact-id) (get attrs :authenticated-sh06-artifact-id))
                                (= (get skeleton :sh06-semantic-projection-id) (get attrs :sh06-semantic-projection-id))
                                (= 0 (get attrs :scrutinee-child-index))
                                (= :source-ordered-pattern-candidates (get attrs :selection-policy) (get skeleton :selection-policy))
                                (= :not-asserted-by-sh07-b11 (get attrs :runtime-reachability) (get skeleton :runtime-reachability))
                                (= :pending-sh08 (get attrs :exhaustiveness) (get skeleton :exhaustiveness)
                                   (get attrs :result-type-join) (get skeleton :result-type-join))
                                (= :scrutinee-then-source-ordered-pattern-candidates (get attrs :evaluation-order)
                                   (get (get node :evaluation) :kind))
                                (= [{:index 0 :core-node-id (first (get node :children))}] (get (get node :evaluation) :order))]) false) false)
      (loop [remaining branches ordinal 0 pattern-index 0 trees [] ids [] indexes [] guard-index (+ (count branches) 1)]
        (if (= (count remaining) 0)
          (if (sh08-ft-all-true? [(= pattern-index (count patterns))
                                  (= ids (get node :resolved-binding-ids)) (= indexes (get attrs :branch-child-indexes))])
            (assoc base :status :accepted :pattern-trees trees)
            (sh08-sm-failure "C7-VERIFY" :incomplete-structural-pattern-products nil :complete-ordered-pattern-tree pattern-index))
          (let [branch (first remaining) root (get patterns pattern-index)
                body (get nodes (get branch :branch-core-node-id))
                region {:kind :match-branch :match-syntax-id (get (get node :source) :syntax-id) :clause-ordinal ordinal}
                result (sh08-sm-pattern-tree patterns pattern-index pattern-index nil [] (get branch :pattern-form-id)
                                             (assoc base :branch-id (get body :node-id) :guard-id (get (get branch :guard) :node-id)) bindings sequence)]
            (if (= :accepted (get result :status))
              (if (sh08-ft-all-true?
                    [(sh08-ft-record-shape? branch
                       (if (contains? branch :guard)
                         #{:ordinal :clause-ordinal :clause-count :core-node-id :scrutinee-core-node-id :branch-core-node-id
                           :branch-child-index :pattern-kind :pattern-form-id :pattern-syntax-id :pattern-value :branch-form-id
                           :branch-syntax-id :pattern-binding-id :pattern-binding-scope-id :pattern-binding-ids
                           :pattern-binding-use-syntax-ids :conditional-region :scrutinee-evaluation :branch-evaluation
                           :authenticated-sh06-artifact-id :sh06-semantic-projection-id :guard}
                       #{:ordinal :clause-ordinal :clause-count :core-node-id :scrutinee-core-node-id :branch-core-node-id
                         :branch-child-index :pattern-kind :pattern-form-id :pattern-syntax-id :pattern-value :branch-form-id
                         :branch-syntax-id :pattern-binding-id :pattern-binding-scope-id :pattern-binding-ids
                         :pattern-binding-use-syntax-ids :conditional-region :scrutinee-evaluation :branch-evaluation
                         :authenticated-sh06-artifact-id :sh06-semantic-projection-id}))
                     (= (if (contains? branch :guard)
                          (assoc (sh08-bm-project branch clause-fields) :guard (get (get clauses ordinal) :guard))
                          (sh08-bm-project branch clause-fields)) (get clauses ordinal))
                     (sh08-gd-branch-valid? node branch root (get clauses ordinal) guard-index nodes forms sequence calls)
                     (= (get branch :clause-ordinal) ordinal (get root :clause-ordinal))
                     (= (get branch :clause-count) (count branches)) (= (get branch :branch-child-index) (+ ordinal 1))
                     (= (get branch :core-node-id) (get node :node-id))
                     (= (get branch :scrutinee-core-node-id) (first (get node :children)))
                     (= (get branch :branch-core-node-id) (get (get node :children) (+ ordinal 1)))
                     (= (get branch :pattern-form-id) (get (get owner :child-form-ids) (+ 2 (* 2 ordinal))))
                     (= (get branch :branch-form-id) (get (get owner :child-form-ids) (+ 3 (* 2 ordinal))) (get (get body :source) :form-id))
                     (= (get branch :branch-syntax-id) (get (get body :source) :syntax-id))
                     (= (get branch :pattern-syntax-id) (get root :pattern-syntax-id))
                     (= (get branch :pattern-kind) (get root :pattern-kind))
                     (= (get branch :pattern-value)
                        (sh08-bm-pattern-value (get forms (get root :pattern-form-id))))
                     (= (get branch :pattern-binding-id) (get root :pattern-binding-id))
                     (= (get branch :pattern-binding-scope-id) (get root :pattern-binding-scope-id))
                     (= (get branch :pattern-binding-use-syntax-ids) (get root :pattern-binding-use-syntax-ids))
                     (= (get branch :pattern-binding-ids) (get result :binding-ids))
                     (= region (get branch :conditional-region) (get (get body :evaluation) :region))
                     (= :evaluate-scrutinee-once (get branch :scrutinee-evaluation))
                     (= :conditionally-evaluate-selected-branch (get branch :branch-evaluation))
                     (= (get branch :authenticated-sh06-artifact-id) (get attrs :authenticated-sh06-artifact-id))
                     (= (get branch :sh06-semantic-projection-id) (get attrs :sh06-semantic-projection-id))])
                (recur (rest remaining) (+ ordinal 1) (get result :next-index) (conj trees (get result :tree))
                       (sh08-ft-add-values-to-set (get result :binding-ids) ids) (conj indexes (+ ordinal 1))
                       (if (contains? branch :guard) (+ guard-index 1) guard-index))
                (sh08-sm-failure "C7-VERIFY" :malformed-structural-branch-products root :exact-clause-branch-join branch)) result))))
      (sh08-sm-failure "C7-VERIFY" :malformed-structural-decision-products nil :exact-match-skeleton skeleton))))

(defn sh08-sm-let-link-valid? [record node nodes bindings forms]
  (let [owner (get nodes (get record :let-core-node-id))
        initializer (get nodes (get record :initializer-node-id))
        binding (get bindings (get record :binding-id))
        binding-form (get forms (get record :definition-form-id))
        initializer-form (get forms (get record :initializer-form-id))
        vector-form (get forms (get (get owner :attributes) :binding-vector-form-id))
        owner-form (get forms (get (get owner :source) :form-id))
        index (get record :ordinal)]
    (if (integer? index)
      (sh08-ft-all-true?
        [(= :immutable (get record :mutability)) (= :let (get owner :core-form))
         (= (get node :resolved-binding-ids) [(get record :binding-id)])
         (= (get (get node :attributes) :binding-id) (get record :binding-id))
         (= (get (get owner :children) index) (get record :initializer-node-id))
         (= (get (get owner :resolved-binding-ids) index) (get record :binding-id))
         (= :vector (get vector-form :kind))
         (= (get vector-form :form-id) (get (get owner-form :child-form-ids) 1))
         (= (get vector-form :parent-form-id) (get owner-form :form-id))
         (= (get vector-form :syntax-id) (get (get owner :attributes) :binding-vector-syntax-id))
         (= (get (get vector-form :child-form-ids) (* 2 index)) (get record :definition-form-id))
         (= (get (get vector-form :child-form-ids) (+ 1 (* 2 index))) (get record :initializer-form-id))
         (= (get record :initializer-form-id) (get (get initializer :source) :form-id) (get initializer-form :form-id))
         (= (get record :initializer-syntax-id) (get (get initializer :source) :syntax-id) (get initializer-form :syntax-id))
         (= (get record :initializer-scope-id) (get initializer-form :scope-id))
         (= (get record :definition-syntax-id) (get binding :definition-syntax-id) (get binding-form :syntax-id))
         (= (get record :name) (get binding :name) (get binding-form :value))
         (= (get record :binding-scope-id) (get binding :scope-id) (get binding-form :scope-id))
         (= :lexical (get binding :binding-class))]) false)))

(defn sh08-sm-shape [id nodes types binding-types functions lexical bindings forms seen depth]
  (sh08-sm-shape-with-bindings id nodes types binding-types functions lexical bindings forms seen depth {}))

(defn sh08-sm-merge-origins [left right]
  (loop [ids (keys right) result left]
    (if (= (count ids) 0) result
      (let [id (first ids)]
        (if (if (contains? result id) (= (get result id) (get right id)) true)
          (recur (rest ids) (assoc result id (get right id))) nil)))))

(defn sh08-sm-shape-cases [shape]
  (sh08-sm-shape-cases-with-origins shape {}))

(defn sh08-sm-shape-cases-with-origins [shape inherited]
  (let [origins (sh08-sm-merge-origins inherited (get shape :case-origins {}))]
  (if (= origins nil) []
  (if (= :alternatives (get shape :shape-kind))
    (loop [remaining (get shape :alternatives) result []]
      (if (= (count remaining) 0) result
        (recur (rest remaining) (sh08-ft-add-values-to-set (sh08-sm-shape-cases-with-origins (first remaining) origins) result))))
    [(if (= (count origins) 0) shape (assoc shape :case-origins origins))]))))

(defn sh08-sm-construct-cases [shape]
  (loop [parts (get shape :parts) cases [(assoc shape :parts [] :case-origins {})] expanded? false]
    (if (= (count parts) 0)
      (if expanded?
        (assoc shape :shape-kind :alternatives :alternatives cases)
        shape)
      (let [part (first parts) values (sh08-sm-shape-cases (get part :shape))
            product (loop [remaining cases result []]
                      (if (= (count remaining) 0) {:status :accepted :cases result}
                        (let [case (first remaining)
                              joined (loop [choices values out result]
                                       (if (> (count out) (get (sh08-local-bounds-value) :maximum-node-children))
                                         (sh08-sm-failure "C7-ANNOTATION" :structural-match-residual-limit nil :bounded-correlated-constructor-product (count out))
                                         (if (= (count choices) 0) {:status :accepted :cases out}
                                           (let [value (first choices)
                                                 origins (sh08-sm-merge-origins (get case :case-origins {}) (get value :case-origins {}))]
                                             (recur (rest choices)
                                               (if (map? origins)
                                                 (conj out (assoc case :parts (conj (get case :parts) (assoc part :shape value))
                                                                      :case-origins origins)) out))))))]
                          (if (= :accepted (get joined :status))
                            (recur (rest remaining) (get joined :cases)) joined))))]
        (if (= :accepted (get product :status))
          (recur (rest parts) (get product :cases)
                 (if (= :alternatives (get (get part :shape) :shape-kind)) true expanded?)) product)))))

(defn sh08-sm-shape-with-bindings [id nodes types binding-types functions lexical bindings forms seen depth binding-shapes]
  (if (> depth (get (sh08-local-bounds-value) :maximum-carrier-depth))
    (sh08-sm-failure "C7-ANNOTATION" :structural-shape-depth-limit nil :bounded-constructor-depth depth)
    (if (contains? seen id)
      (sh08-sm-failure "C7-VERIFY" :cyclic-constructor-evidence nil :acyclic-immutable-initializer id)
      (let [node (get nodes id) kind (get node :core-form) attrs (get node :attributes)
            form (get forms (get (get node :source) :form-id))
            established (get types id :gravity.type/unknown)
            type (if (sh08-ft-known? established) established
                   (sh08-ft-infer-node-with-context node types binding-types functions [] {}))
            base {:node-id id :type type :source (get node :source) :binding-links [] :shape-size 1}
            records (sh08-bm-select lexical :binding-id (get attrs :binding-id))]
        (if (if (= kind :reference) (contains? binding-shapes (get attrs :binding-id)) false)
          (let [evidence (get binding-shapes (get attrs :binding-id))
                alternatives (get evidence :alternatives)
                binding (get bindings (get attrs :binding-id))]
            (if (= :rejected (get evidence :status))
              (assoc evidence :node node)
            (if (sh08-ft-all-true?
                  [(= (get attrs :binding-id) (get evidence :binding-id))
                   (= :lexical (get binding :binding-class))
                   (= (get binding :scope-id) (get evidence :scope-id))
                   (contains? (set (get evidence :use-syntax-ids)) (get (get node :source) :syntax-id))
                   (> (count alternatives) 0)])
              (if (= :accepted (get (sh08-carrier-preflight evidence) :status))
              (assoc base :status :accepted :shape-kind :alternatives :alternatives alternatives
                          :type (get evidence :type) :pattern-binding-evidence evidence
                          :shape-size (get evidence :shape-size))
                (sh08-sm-failure "C7-ANNOTATION" :structural-match-evidence-limit nil :bounded-pattern-ancestry nil))
              (sh08-sm-failure "C7-VERIFY" :invalid-pattern-shape-link nil :exact-pattern-binding-ancestry evidence))))
        (if (if (= kind :reference) (> (count records) 0) false)
          (if (if (= (count records) 1)
                (sh08-sm-let-link-valid? (first records) node nodes bindings forms) false)
            (let [record (first records)
                  shape (sh08-sm-shape-with-bindings (get record :initializer-node-id) nodes types binding-types functions
                                      lexical bindings forms (conj seen id) (+ depth 1) binding-shapes)]
              (if (= :accepted (get shape :status))
                (if (< (get shape :shape-size) (get (sh08-local-bounds-value) :maximum-core-nodes))
                  (assoc (assoc shape :reference-node-id id)
                         :binding-links (conj (get shape :binding-links) record) :shape-size (+ 1 (get shape :shape-size)))
                  (sh08-sm-failure "C7-ANNOTATION" :structural-shape-node-limit nil :bounded-expanded-shape (get shape :shape-size))) shape))
            (sh08-sm-failure "C7-VERIFY" :invalid-immutable-shape-link nil :exact-let-initializer (first records)))
          (if (= kind :quote)
            (let [quoted (sh08-qd-node node forms)]
              (if (= :accepted (get quoted :status))
                (assoc (sh08-qd-shape (get quoted :data) node) :node-id id)
                (assoc quoted :node (if (map? (get quoted :form)) (sh08-bm-source-node node (get quoted :form)) node))))
          (if (= kind :collection-literal)
            (let [collection-kind (get attrs :literal-kind) children (get node :children)]
              (if (contains? #{:map :vector} collection-kind)
                (if (sh08-ft-all-true?
                      [(= collection-kind (get form :kind))
                       (= (count children) (get attrs :element-count) (count (get form :child-form-ids)))
                       (if (= collection-kind :map) (sh08-even-count? children) true)])
                  (loop [remaining children ordinal 0 parts [] child-types [] seen-keys #{} size 1]
                    (if (= (count remaining) 0)
                      (sh08-sm-construct-cases (assoc (assoc base :status :accepted) :shape-kind collection-kind
                             :constructor-node-id id :parts parts :shape-size size
                             :type (if (= collection-kind :map)
                                     {:kind :gravity.type/map :member-types child-types :shape :literal}
                                     {:kind :gravity.type/vector :element-types child-types :shape :literal})))
                      (let [key-id (if (= collection-kind :map) (first remaining) nil)
                            value-id (if (= collection-kind :map) (second remaining) (first remaining))
                            key-node (get nodes key-id) key-form (get forms (get (get key-node :source) :form-id))
                            key (get (get key-node :attributes) :value)
                            value-node (get nodes value-id)
                            coordinate (if (= collection-kind :map) (+ ordinal 1) ordinal)
                            shape (sh08-sm-shape-with-bindings value-id nodes types binding-types functions lexical bindings forms (conj seen id) (+ depth 1) binding-shapes)
                            key-valid (if (= collection-kind :map)
                                        (sh08-ft-all-true?
                                          [(= :literal (get key-node :core-form))
                                           (= :keyword (get (get key-node :attributes) :literal-kind) (get key-form :kind))
                                           (keyword? key) (= key (get key-form :value))
                                           (= (get (get key-node :source) :syntax-id) (get key-form :syntax-id))
                                           (= key-id (get children ordinal))
                                           (= (get (get key-node :source) :form-id) (get (get form :child-form-ids) ordinal))
                                           (= false (contains? seen-keys key))]) true)]
                        (if key-valid
                          (if (if (= (get (get value-node :source) :form-id) (get (get form :child-form-ids) coordinate))
                                (= (get (get value-node :source) :syntax-id)
                                   (get (get forms (get (get value-node :source) :form-id)) :syntax-id)) false)
                            (if (= :accepted (get shape :status))
                              (if (<= (+ size (get shape :shape-size) (if (= collection-kind :map) 1 0))
                                      (get (sh08-local-bounds-value) :maximum-core-nodes))
                              (recur (if (= collection-kind :map) (rest (rest remaining)) (rest remaining))
                                     (+ ordinal (if (= collection-kind :map) 2 1))
                                     (conj parts {:coordinate coordinate :key key :key-node-id key-id
                                                  :value-node-id value-id :shape shape})
                                     (if (= collection-kind :map)
                                       (conj (conj child-types :gravity.type/keyword) (get shape :type))
                                       (conj child-types (get shape :type)))
                                     (conj seen-keys key) (+ size (get shape :shape-size) (if (= collection-kind :map) 1 0)))
                                (sh08-sm-failure "C7-ANNOTATION" :structural-shape-node-limit nil :bounded-expanded-shape size)) shape)
                            (sh08-sm-failure "C7-VERIFY" :constructor-child-source-mismatch nil :exact-constructor-child value-id))
                          (assoc (sh08-sm-failure
                            (if (= :keyword (get key-form :kind)) "C7-VERIFY" "C7-ANNOTATION")
                            (if (= :keyword (get key-form :kind)) :forged-structural-map-key :unsupported-structural-map-key)
                            nil :unique-literal-keyword-key key) :node key-node)))))
                  (sh08-sm-failure "C7-VERIFY" :malformed-structural-constructor nil :exact-constructor-children id))
                (sh08-sm-failure "C7-ANNOTATION" :unsupported-structural-constructor nil :literal-map-or-vector collection-kind)))
            (if (sh08-ft-known? type)
              (if (= kind :literal)
                (if (sh08-ft-all-true? [(= (get attrs :literal-kind) (get form :kind))
                                        (= type (sh08-primitive-type-from-literal-kind (get attrs :literal-kind)))
                                        (= (get attrs :value) (get form :value))])
                  (assoc base :status :accepted :shape-kind :scalar :domain {:values [(get attrs :value)]})
                  (sh08-sm-failure "C7-VERIFY" :literal-shape-source-mismatch nil :exact-literal-node id))
                (assoc base :status :accepted :shape-kind :scalar
                       :domain (if (= type :gravity.type/bool) {:values [true false]}
                                 (if (= type :gravity.type/nil) {:values [nil]} {:excluded-values []}))))
              (sh08-sm-failure "C7-ANNOTATION" :unestablished-structural-value-type nil :established-value-type type))))))))))

(defn sh08-sm-part-index [shape key coordinate]
  (loop [parts (get shape :parts) index 0]
    (if (= (count parts) 0) nil
      (if (if (= :map (get shape :shape-kind)) (= key (get (first parts) :key))
            (= coordinate (get (first parts) :coordinate))) index
        (recur (rest parts) (+ index 1))))))

(defn sh08-sm-replace-part [shape index value]
  (assoc shape :parts (assoc (get shape :parts) index (assoc (get (get shape :parts) index) :shape value))))

(defn sh08-sm-applicable? [group type]
  (if (= true (get group :structural?)) true
    (if (map? type) (contains? #{:gravity.type/map :gravity.type/vector} (get type :kind)) false)))

(defn sh08-sm-extractions [shape tree constructor-path]
  (sh08-sm-extractions-with-origins shape tree constructor-path (get shape :case-origins {})))

(defn sh08-sm-extractions-with-origins [shape tree constructor-path origins]
  (let [record (get tree :record)]
    (if (= :binding (get record :pattern-kind))
      [{:binding-id (get record :pattern-binding-id) :scope-id (get record :pattern-binding-scope-id)
        :type (get shape :type) :domain (get shape :domain)
        :shape (if (= (count origins) 0) shape (assoc shape :case-origins origins))
        :case-origins origins :data-origin (get shape :data-origin)
        :pattern-path (get record :path) :constructor-path constructor-path
        :pattern-form-id (get record :pattern-form-id) :pattern-syntax-id (get record :pattern-syntax-id)
        :value-node-id (get shape :node-id) :source-form (get tree :form)}]
      (loop [children (get tree :children) result []]
        (if (= (count children) 0) result
          (let [child (first children) index (sh08-sm-part-index shape (get child :key) (get child :coordinate))
                part (get (get shape :parts) index)]
            (recur (rest children)
              (sh08-ft-add-values-to-set
                (sh08-sm-extractions-with-origins (get part :shape) (get child :tree) (conj constructor-path (get part :coordinate))
                  (sh08-sm-merge-origins origins (get (get part :shape) :case-origins {}))) result))))))))

(defn sh08-gd-result [group branch types validate?]
  (if (contains? branch :guard)
    (let [guard (get branch :guard) id (get guard :node-id) node (get (get group :nodes) id)
          type (get types id :gravity.type/unknown) tree (sh08-bm-tree (get group :nodes) id)
          control (loop [remaining (get group :node-sequence)]
                    (if (= (count remaining) 0) nil
                      (let [candidate (first remaining)]
                        (if (if (contains? tree (get candidate :node-id))
                              (contains? #{:throw :try :recur} (get candidate :core-form)) false)
                          candidate (recur (rest remaining))))))
          quote (if (= :quote (get node :core-form)) (sh08-qd-node node (get group :forms)) {})
          truth (if (= :boolean (get (get quote :data) :kind))
                  (if (= true (get (get quote :data) :value)) :true :false)
                  (if (= :literal (get node :core-form))
                  (if (= :boolean (get (get node :attributes) :literal-kind))
                    (if (= true (get (get node :attributes) :value)) :true :false) :unknown) :unknown))]
      (if (if validate? (map? control) false)
        (assoc (sh08-sm-failure "C7-ANNOTATION" :unsupported-guard-control-transfer nil :normally-returning-guard (get control :core-form)) :node control)
        (if (if validate? (= false (= type :gravity.type/bool)) false)
          (assoc (sh08-sm-failure "L7-GUARD-TYPE" :guard-result-not-boolean nil :gravity.type/bool type) :node node)
          {:status :accepted :truth truth
           :guard {:rule-version :sh08-bool-root-map-guard-v1 :core-node-id id :type type :truth truth
                   :source (sh08-gd-source guard) :conditional-region (get guard :conditional-region)
                   :effects (get (get node :preserved-declarations) :effects)
                   :capabilities (get (get node :preserved-declarations) :capabilities)
                   :evaluation :once-after-structural-success :on-pattern-failure :next-candidate
                   :on-true :branch-body :on-false :next-candidate
                   :binding-ids (get branch :pattern-binding-ids)
                   :call-node-ids (sh08-gd-call-ids (get group :node-sequence) tree)
                   :call-membership (loop [remaining (get group :node-sequence) result []]
                                      (if (= (count remaining) 0) result
                                        (let [call-node (first remaining)]
                                          (recur (rest remaining)
                                            (if (if (= :call (get call-node :core-form))
                                                  (contains? tree (get call-node :node-id)) false)
                                              (conj result {:core-node-id (get call-node :node-id)
                                                            :evaluation (get call-node :evaluation)
                                                            :call-record (first (sh08-bm-select (get group :calls) :core-node-id (get call-node :node-id)))}) result)))))
                   :dependencies {:guard guard :binding-ids (get branch :pattern-binding-ids)}
                   :invalidation [:guard-source :guard-node-type :guard-region :binding-scopes :guard-call-facts :guard-effects :guard-capabilities]}})))
    {:status :accepted :truth :true}))

(defn sh08-sm-partition-with-guards [group shape types validate?]
  (loop [trees (get group :pattern-trees) branches (get group :branches)
         domains (sh08-sm-shape-cases shape) facts []]
    (if (= (count trees) 0) {:status :accepted :branches facts :remaining domains}
      (let [tree (first trees)
            split (loop [remaining domains selected [] residual []]
                    (if (> (+ (count selected) (count residual)) (get (sh08-local-bounds-value) :maximum-node-children))
                      (sh08-sm-failure "C7-ANNOTATION" :structural-match-residual-limit (get tree :record) :bounded-residual-partition (count residual))
                      (if (= (count remaining) 0) {:status :accepted :selected selected :residual residual}
                        (let [result (sh08-sm-split (first remaining) tree)]
                          (if (= :accepted (get result :status))
                            (recur (rest remaining) (sh08-ft-add-values-to-set (get result :selected) selected)
                                   (sh08-ft-add-values-to-set (get result :residual) residual)) result)))))]
        (if (= :accepted (get split :status))
          (if (= (count (get split :selected)) 0)
            (sh08-sm-failure "L7-UNREACHABLE" :unreachable-structural-match-clause (get tree :record) :remaining-constructor-case (get (get tree :record) :pattern-value))
            (let [guard-result (sh08-gd-result group (first branches) types validate?)
                  extractions (loop [selected (get split :selected) result [] case-index 0]
                                (if (= (count selected) 0) result
                                  (let [selected-shape (first selected)
                                        origins (assoc (get selected-shape :case-origins {}) (get (get group :node) :node-id)
                                                       {:clause-ordinal (get (first branches) :clause-ordinal) :case-index case-index})]
                                    (recur (rest selected) (sh08-ft-add-values-to-set
                                      (sh08-sm-extractions-with-origins selected-shape tree [] origins) result) (+ case-index 1)))))]
              (if (= :accepted (get guard-result :status))
                (let [after (if (= :true (get guard-result :truth)) (get split :residual) domains)
                      selected (if (= :false (get guard-result :truth)) [] (get split :selected))
                      fact {:branch (first branches) :tree tree :remaining-before domains
                            :selected selected :remaining-after after :extractions extractions}]
                  (recur (rest trees) (rest branches) after
                    (conj facts (if (contains? guard-result :guard)
                                  (assoc fact :guard (get guard-result :guard) :structural-selected (get split :selected)) fact))))
                guard-result))) split)))))

(defn sh08-sm-partition [group shape]
  (sh08-sm-partition-with-guards group shape {} false))

(defn sh08-sm-group-shape [group types binding-types functions]
  (sh08-sm-shape-with-bindings (first (get (get group :node) :children)) (get group :nodes) types binding-types functions
                 (get group :lexical-bindings) (get group :binding-index) (get group :forms) #{} 0 (get group :binding-shapes {})))

(defn sh08-sm-extraction-type [values]
  (let [type (get (first values) :type)]
    (loop [remaining values]
      (if (= (count remaining) 0) type
        (if (= type (get (first remaining) :type)) (recur (rest remaining)) :gravity.type/unknown)))))

; Alternatives remain whole constructor cases. Never join their fields separately.
(defn sh08-sm-seed-shapes [group types binding-types functions prior]
  (let [shape (sh08-sm-group-shape (assoc group :binding-shapes prior) types binding-types functions)
        partition (if (= :accepted (get shape :status)) (sh08-sm-partition group shape) shape)]
    (if (= :accepted (get partition :status))
      (loop [branches (get partition :branches) result prior]
        (if (= (count branches) 0) result
          (let [fact (first branches)
                grouped (loop [values (get fact :extractions) out {}]
                          (if (= (count values) 0) out
                            (let [value (first values) id (get value :binding-id)]
                              (recur (rest values) (assoc out id (conj (get out id []) value))))))]
            (recur (rest branches)
              (loop [ids (keys grouped) out result]
                (if (= (count ids) 0) out
                  (let [id (first ids) values (get grouped id) value (first values)
                        record (get (get fact :tree) :record)
                        source-record (first (sh08-bm-select (get group :patterns) :pattern-binding-id id))
                        alternatives (loop [remaining values shapes [] size 0]
                                       (if (= (count remaining) 0) {:shapes shapes :size size}
                                         (let [extraction (first remaining) extracted (get extraction :shape)]
                                           (recur (rest remaining) (conj shapes extracted) (+ size (get extracted :shape-size))))))]
                    (recur (rest ids)
                      (if (if (<= (get alternatives :size) (get (sh08-local-bounds-value) :maximum-core-nodes))
                            (<= (count values) (get (sh08-local-bounds-value) :maximum-node-children)) false)
                        (assoc out id {:binding-id id :scope-id (get value :scope-id) :type (sh08-sm-extraction-type values)
                                       :use-syntax-ids (get source-record :pattern-binding-use-syntax-ids)
                                       :match-core-node-id (get (get group :node) :node-id)
                                       :clause-ordinal (get record :clause-ordinal)
                                       :pattern-path (get value :pattern-path) :extractions values
                                       :scrutinee-shape shape
                                       :structural-premises (get fact :remaining-before)
                                       :structurally-matched-shapes (if (contains? fact :structural-selected)
                                                                      (get fact :structural-selected) (get fact :selected))
                                       :alternatives (get alternatives :shapes) :shape-size (+ 1 (get alternatives :size))})
                        (assoc out id (assoc (sh08-sm-failure "C7-ANNOTATION" :structural-alias-evidence-limit
                                              nil :bounded-pattern-binding-alternatives
                                              {:shape-size (get alternatives :size) :alternative-count (count values)})
                                            :binding-id id :type (sh08-sm-extraction-type values)))))))))))) prior)))

(defn sh08-sm-seed-all-shapes [groups types bindings functions prior]
  (loop [remaining groups result prior]
    (if (= (count remaining) 0) result
      (recur (rest remaining) (sh08-sm-seed-shapes (first remaining) types bindings functions result)))))

(defn sh08-sm-groups-with-shapes [groups shapes]
  (loop [remaining groups result []]
    (if (= (count remaining) 0) result
      (recur (rest remaining) (conj result (assoc (first remaining) :binding-shapes shapes))))))

(defn sh08-sm-seed [group types binding-types functions]
  (let [shape (sh08-sm-group-shape group types binding-types functions)]
    (if (= :accepted (get shape :status))
      (let [partition (sh08-sm-partition group shape)]
        (if (= :accepted (get partition :status))
          (loop [branches (get partition :branches) result binding-types]
            (if (= (count branches) 0) result
              (recur (rest branches)
                (loop [values (get (first branches) :extractions) out result]
                  (if (= (count values) 0) out
                    (let [id (get (first values) :binding-id) evidence (get (get group :binding-shapes) id)]
                      (recur (rest values) (assoc out id (if (map? evidence) (get evidence :type) (get (first values) :type))))))))))
          binding-types)) binding-types)))

(defn sh08-sm-diagnostic [group failure]
  (let [node (get group :node) record (get failure :record)
        source-node (if (map? (get failure :node)) (get failure :node)
                     (if (map? record)
                      (sh08-bm-source-node node (get (get group :forms) (get record :pattern-form-id))) node))]
    (sh08-bm-error (get failure :rule) (get failure :reason) source-node (get failure :expected) (get failure :actual))))

(defn sh08-sm-expected-return [group functions]
  (let [node (get group :node)
        owner (get functions (get (get node :evaluation) :owner-function-syntax-id))
        expected (get (get (get owner :signature) :return) :type-id)]
    (loop [id (get owner :body-core-node-id) seen #{}]
      (if (= id (get node :node-id)) expected
        (if (contains? seen id) nil
          (let [parent (get (get group :nodes) id) attrs (get parent :attributes)
                children (get parent :children) final-index (- (count children) 1)]
            (if (if (= :let (get parent :core-form))
                  (if (integer? (get attrs :body-count))
                    (if (> (get attrs :body-count) 0)
                      (if (= :last-body (get (get attrs :result-policy) :kind))
                        (if (= final-index (get (get attrs :result-policy) :child-index))
                          (contains? (set (get attrs :body-child-indexes)) final-index) false) false) false) false) false)
              (recur (get children final-index) (conj seen id)) nil)))))))

(defn sh08-sm-check [group types functions module]
  (let [node (get group :node) shape (sh08-sm-group-shape group types {} functions)
        partition (if (= :accepted (get shape :status)) (sh08-sm-partition-with-guards group shape types true) shape)
        declared (sh08-sm-expected-return group functions)]
    (if (= :accepted (get partition :status))
      (if (= 0 (count (get partition :remaining)))
        (loop [branches (get partition :branches) result-type :gravity.type/unknown facts []]
          (if (= (count branches) 0)
            (if (= :accepted (get (sh08-carrier-preflight facts) :status)) {:constraints facts :type result-type}
              {:diagnostic (sh08-bm-error "C7-ANNOTATION" :structural-match-evidence-limit node :bounded-evidence-ledger nil)})
            (let [fact (first branches) branch (get fact :branch) body-id (get branch :branch-core-node-id)
                  body (get (get group :nodes) body-id) type (get types body-id :gravity.type/unknown)
                  expected (if (= declared nil) result-type declared)]
              (if (sh08-ft-known? type)
                (if (if (sh08-ft-known? expected)
                      (if (= type :gravity.type/never) true
                        (if (if (= declared nil) (= expected :gravity.type/never) false) true (= expected type))) true)
                  (recur (rest branches)
                    (if (= result-type :gravity.type/unknown) type
                      (sh08-ft-normal-return-type :alternatives [result-type type] :gravity.type/unknown))
                    (conj facts (sh08-gd-constraint fact {:constraint-id-request
                                  {:domain :gravity/sh08-structural-match-constraint-v1 :match-core-node-id (get node :node-id)
                                   :clause-ordinal (get branch :clause-ordinal) :branch branch
                                   :pattern-tree (get fact :tree) :skeleton (get group :skeleton)}
                                 :kind :equality :producer-rule :sh08-structural-match-v1 :lhs body-id :rhs type
                                 :constructor-shape shape :remaining-before (get fact :remaining-before)
                                 :matched-shapes (get fact :selected) :remaining-after (get fact :remaining-after)
                                 :extractions (get fact :extractions)
                                 :exhaustive-after? (= 0 (count (get fact :remaining-after)))
                                 :source (get (sh08-bm-source-node node (get (get fact :tree) :form)) :source)
                                 :branch-source (get body :source)
                                 :dependencies {:scrutinee-node-id (first (get node :children)) :constructor-shape shape
                                                :pattern-tree (get fact :tree) :branch-node-id body-id :extractions (get fact :extractions)}
                                 :solution {:result-type type :selected-shapes (get fact :selected) :binding-extractions (get fact :extractions)}
                                 :invalidation [:constructor-children :key-nodes :value-node-types :immutable-initializers :pattern-paths :binding-scopes :branch-types
                                                :pattern-binding-shapes :case-origins :correlated-constructor-products]
                                 :profile (get module :profile) :target (get module :target) :status :solved :diagnostics []})))
                  {:diagnostic (sh08-bm-error (if (= declared nil) "C7-ANNOTATION" "C7-TYPE-MISMATCH")
                                   (if (= declared nil) :unsupported-heterogeneous-structural-match-join :structural-match-branch-type-mismatch)
                                   body expected type)})
                {:diagnostic (sh08-bm-error "C7-ANNOTATION" :unknown-structural-match-branch-type body :established-branch-type type)}))))
        {:diagnostic (sh08-bm-error (if (= :formal (get module :profile)) "L7-NONEXHAUSTIVE" "C7-ANNOTATION")
                         (if (= :formal (get module :profile)) :nonexhaustive-structural-match :unsupported-partial-structural-match)
                         node :exhaustive-constructor-match (get partition :remaining))})
      {:diagnostic (sh08-sm-diagnostic group partition)})))

(defn sh08-gd-constraint [fact constraint]
  (if (contains? fact :guard)
    (assoc constraint :guard (get fact :guard) :guard-rule-version :sh08-bool-root-map-guard-v1
                      :structurally-matched-shapes (get fact :structural-selected)
                      :dependencies (assoc (get constraint :dependencies) :guard (get fact :guard))
                      :solution (assoc (get constraint :solution) :guard-truth (get (get fact :guard) :truth)
                                       :guard-body-shapes (get fact :selected) :guard-fallthrough-shapes (get fact :remaining-after))
                      :invalidation (sh08-ft-add-values-to-set
                                      [:guard-source :guard-node-type :guard-region :guard-call-facts :guard-truth :guard-evaluation-order :guard-effects :guard-capabilities]
                                      (get constraint :invalidation))
                      :constraint-id-request (assoc (get constraint :constraint-id-request)
                                               :domain :gravity/sh08-guarded-structural-match-constraint-v1
                                               :guard (get fact :guard))) constraint))

(defn sh08-sm-split-children [shape children]
  (loop [remaining children selected [shape] residual []]
    (if (> (+ (count selected) (count residual)) (get (sh08-local-bounds-value) :maximum-node-children))
      (sh08-sm-failure "C7-ANNOTATION" :structural-match-residual-limit nil :bounded-residual-partition (count residual))
      (if (= (count remaining) 0) {:status :accepted :selected selected :residual residual}
        (let [child (first remaining)
              split (loop [domains selected matches [] rest-domains residual]
                      (if (= (count domains) 0) {:status :accepted :selected matches :residual rest-domains}
                        (let [domain (first domains)
                              index (sh08-sm-part-index domain (get child :key) (get child :coordinate))]
                          (if (= index nil)
                            (recur (rest domains) matches (conj rest-domains domain))
                            (let [part (get (get domain :parts) index)
                                  result (sh08-sm-split (get part :shape) (get child :tree))]
                              (if (= :accepted (get result :status))
                                (recur (rest domains)
                                  (loop [values (get result :selected) out matches]
                                    (if (= (count values) 0) out
                                      (recur (rest values) (conj out (sh08-sm-replace-part domain index (first values))))))
                                  (loop [values (get result :residual) out rest-domains]
                                    (if (= (count values) 0) out
                                      (recur (rest values) (conj out (sh08-sm-replace-part domain index (first values))))))) result))))))]
          (if (= :accepted (get split :status))
            (recur (rest remaining) (get split :selected) (get split :residual)) split))))))

(defn sh08-sm-split [shape tree]
  (if (= :alternatives (get shape :shape-kind))
    (loop [remaining (get shape :alternatives) selected [] residual []]
      (if (= (count remaining) 0) {:status :accepted :selected selected :residual residual}
        (let [split (sh08-sm-split (first remaining) tree)]
          (if (= :accepted (get split :status))
            (recur (rest remaining) (sh08-ft-add-values-to-set (get split :selected) selected)
                   (sh08-ft-add-values-to-set (get split :residual) residual)) split))))
  (let [record (get tree :record) kind (get record :pattern-kind)
        shape-kind (get shape :shape-kind) type (get shape :type) value (get record :pattern-value)]
    (if (contains? #{:wildcard :binding} kind)
      {:status :accepted :selected [shape] :residual []}
      (if (contains? #{:map :vector} kind)
        (if (= kind shape-kind)
          (if (if (= kind :vector) (= (get record :vector-width) (count (get shape :parts))) true)
            (sh08-sm-split-children shape (get tree :children))
            {:status :accepted :selected [] :residual [shape]})
          (if (if (map? type) (contains? #{:gravity.type/map :gravity.type/vector} (get type :kind)) false)
            (if (= shape-kind :scalar)
              (sh08-sm-failure "C7-ANNOTATION" :unestablished-structural-shape record :constructor-linked-shape type)
              (sh08-sm-failure "L7-PATTERN-TYPE" :structural-pattern-type-mismatch record kind shape-kind))
            (sh08-sm-failure "L7-PATTERN-TYPE" :structural-pattern-type-mismatch record kind type)))
        (let [form (get tree :form)
              literal-type (if (= :list (get form :kind)) :gravity.type/symbol
                             (sh08-primitive-type-from-literal-kind (get form :kind)))
              domain (get shape :domain)]
          (if (if (sh08-sm-numeric-type? literal-type)
                (if (sh08-sm-numeric-type? type)
                  (if (= literal-type type) (= literal-type :gravity.type/decimal) true) false) false)
            (sh08-sm-failure "C7-ANNOTATION" :unsupported-numeric-pattern-elaboration record :established-numeric-pattern-elaboration type)
          (if (= literal-type type)
            (if (contains? domain :values)
              (let [selected (if (contains? (set (get domain :values)) value) [value] [])
                    residual (loop [values (get domain :values) result []]
                               (if (= (count values) 0) result
                                 (recur (rest values) (if (= value (first values)) result (conj result (first values))))))]
                {:status :accepted
                 :selected (if (= (count selected) 0) [] [(assoc shape :domain {:values selected})])
                 :residual (if (= (count residual) 0) [] [(assoc shape :domain {:values residual})])})
              (if (contains? (set (get domain :excluded-values)) value)
                {:status :accepted :selected [] :residual [shape]}
                {:status :accepted :selected [(assoc shape :domain {:values [value]})]
                 :residual [(assoc shape :domain {:excluded-values (conj (get domain :excluded-values) value)})]}))
            (sh08-sm-failure "L7-PATTERN-TYPE" :structural-leaf-pattern-type-mismatch record type literal-type)))))))))

(defn sh08-sm-numeric-type? [type]
  (contains? #{:gravity.type/integer :gravity.type/decimal :gravity.type/ratio
               :gravity.type/i8 :gravity.type/i16 :gravity.type/i32 :gravity.type/i64
               :gravity.type/u8 :gravity.type/u16 :gravity.type/u32 :gravity.type/u64
               :gravity.type/f32 :gravity.type/f64} type))

(defn sh08-ft-infer-node
  [node type-table binding-types function-types edges]
  (sh08-ft-infer-node-with-context
   node type-table binding-types function-types edges {}))

(defn sh08-ft-bind-lexical-types
  [lexical-bindings type-table binding-types]
  (loop [remaining lexical-bindings result binding-types]
    (if (= (count remaining) 0)
      result
      (let [record (first remaining)
            inferred
            (get type-table (get record :initializer-node-id)
                 :gravity.type/unknown)]
        (recur
         (rest remaining)
         (assoc result (get record :binding-id) inferred))))))

(defn sh08-ft-bind-definition-types
  [definitions type-table binding-types function-types]
  (loop [remaining definitions result binding-types]
    (if (= (count remaining) 0)
      result
      (let [definition (first remaining)
            value-type
            (get type-table (get definition :value-node-id)
                 :gravity.type/unknown)
            value
            (if (sh08-ft-unknown? value-type)
              (let [function
                    (sh08-ft-function-by-core-id
                     function-types (get definition :value-node-id))]
                (if (map? function)
                  function
                  value-type))
              value-type)]
        (recur
         (rest remaining)
         (assoc result (get definition :binding-id) value))))))

(defn sh08-ft-first-type-mismatch [pairs]
  (if (= (count pairs) 0)
    nil
    (let [pair (first pairs)
          argument (get pair :argument)
          chosen (get pair :chosen)]
      (if (if (if (= argument :gravity.type/never) false (sh08-ft-known? argument))
            (if (sh08-ft-known? chosen)
              (if (= argument chosen) false true)
              false)
            false)
        pair
        (sh08-ft-first-type-mismatch (rest pairs))))))

(defn sh08-ft-call-constraints-with-context
  [calls edges nodes type-table binding-types function-types context]
  (loop [remaining calls
         remaining-edges edges
         next-bindings binding-types
         constraints []
         diagnostics []]
    (if (= (count remaining) 0)
      {:binding-types next-bindings
       :constraints constraints
       :diagnostics diagnostics}
      (let [call (first remaining)
            edge (first remaining-edges)
            imported (sh08-im-callee edge context)
            callee
            (if (map? edge)
              (get function-types (get edge :callee-function-syntax-id))
              nil)
            args
            (loop [ids (get call :argument-node-ids) values []]
              (if (= (count ids) 0)
                values
                (recur
                 (rest ids)
                       (conj values
                       (get type-table (first ids)
                            :gravity.type/unknown)))))
            higher-order-call?
            (if (= :accepted (get context :status))
              (= (get call :core-node-id)
                 (get context :inner-call-core-node-id))
              false)
            parameters
            (if higher-order-call?
              [{:binding-id (get context :apply-value-binding-id)
                :type (get context :value-type
                           :gravity.type/unknown)}]
              (if (map? callee) (get callee :parameters) []))
            arity-ok (= (count args) (count parameters))]
        (if (map? imported)
          (let [checked (sh08-im-call-constraint call edge args imported nodes)]
            (recur (rest remaining) (rest remaining-edges) next-bindings
                   (conj constraints (get checked :constraint))
                   (sh08-ft-add-values-to-set (get checked :diagnostics) diagnostics)))
        (if (if (= (get edge :classification) :local-function)
              true
              higher-order-call?)
          (if arity-ok
            (let [joined
                  (loop [ps parameters
                         as args
                         result next-bindings
                         values []]
                    (if (= (count ps) 0)
                      {:bindings result :pairs values}
                      (let [parameter (first ps)
                            argument (first as)
                            prior (get result (get parameter :binding-id)
                                       :gravity.type/unknown)
                            chosen
                            (if (if (= argument :gravity.type/never) false (sh08-ft-known? argument))
                              (if (sh08-ft-known? prior)
                                prior
                                argument)
                              prior)]
                        (recur
                         (rest ps)
                         (rest as)
                         (assoc result
                                (get parameter :binding-id)
                                chosen)
                         (conj values
                               {:parameter (get parameter :binding-id)
                                :argument argument
                                :chosen chosen})))))]
              (let [mismatch
                    (sh08-ft-first-type-mismatch
                     (get joined :pairs))]
              (if (= mismatch nil)
                (let [constraint-id-request
                      {:domain :gravity/sh08-function-call-constraint-v1
                       :call-core-node-id (get call :core-node-id)
                       :callee-function-syntax-id
                       (get edge :callee-function-syntax-id)}
                      base-constraint
                      {:constraint-id-request constraint-id-request
                       :kind :equality
                       :lhs (get edge :callee-function-syntax-id)
                       :rhs (get joined :pairs)
                       :origin (get (get (get nodes (get call :core-node-id))
                                        :source)
                                    :origin-chain)
                       :profile :meta
                       :target :jvm
                       :status :solved
                       :diagnostics []}
                      constraint
                      (if higher-order-call?
                        (assoc
                         (assoc
                          (assoc
                           (assoc base-constraint
                                  :constraint-id-request
                                  (assoc constraint-id-request
                                         :higher-order-call? true))
                           :kind :higher-order-function-call)
                          :lhs (get context :apply-callable-binding-id))
                         :higher-order-call? true)
                        base-constraint)]
                  (recur
                   (rest remaining)
                   (rest remaining-edges)
                   (get joined :bindings)
                   (conj constraints constraint)
                   diagnostics))
                {:binding-types next-bindings
                 :constraints constraints
                 :diagnostics
                 (conj diagnostics
                       {:call call
                        :rule "C7-TYPE-MISMATCH"
                        :reason :call-argument-type-mismatch
                        :parameter-binding-id
                        (get mismatch :parameter)
                        :expected (get mismatch :chosen)
                        :actual (get mismatch :argument)})})))
            {:binding-types next-bindings
             :constraints constraints
             :diagnostics
             (conj diagnostics
                   {:call call
                    :rule "C7-TYPE-MISMATCH"
                    :reason :call-arity-mismatch
                    :expected (count parameters)
                    :actual (count args)})})
          {:binding-types next-bindings
           :constraints constraints
           :diagnostics
           (conj diagnostics
                 {:call call
                  :rule "C7-ANNOTATION"
                  :reason :unsupported-nonlocal-call
                  :expected :supported-local-first-order-call
                  :actual (get edge :classification)})}))))))

(defn sh08-ft-call-constraints
  [calls edges nodes type-table binding-types function-types]
  (sh08-ft-call-constraints-with-context
   calls edges nodes type-table binding-types function-types {}))

(defn sh08-ft-infer-pass-with-context
  [nodes lexical-bindings definitions calls edges function-types
   initial-binding-types context]
  (let [binding-shapes (sh08-sm-seed-all-shapes (get context :boolean-matches)
                        (get context :prior-type-table {}) initial-binding-types function-types
                        (get context :prior-binding-shapes {}))
        match-groups (sh08-sm-groups-with-shapes (get context :boolean-matches) binding-shapes)]
  (loop [remaining nodes
         type-table {}
         binding-types (sh08-bm-seed-bindings match-groups
                         (sh08-ft-node-index nodes) (get context :prior-type-table {})
                         initial-binding-types function-types edges context)
         function-result function-types]
    (if (= (count remaining) 0)
      (let [node-index
            (sh08-ft-node-index nodes)
            lexical-types
            (sh08-ft-bind-lexical-types
             lexical-bindings type-table binding-types)
            definition-types
            (sh08-ft-bind-definition-types
             definitions type-table lexical-types function-result)
            function-with-params
            (sh08-ft-update-param-types
             function-result definition-types)
            call-result
            (sh08-ft-call-constraints-with-context
             calls edges node-index type-table definition-types
             function-with-params context)
            loop-result (if (map? (get context :loop-core))
                          (sh08-ft-loop-type-step (get context :loop-core) type-table (get call-result :binding-types)
                            (get context :loop-work-left 65536))
                          {:bindings (get call-result :binding-types) :constraints [] :issues [] :work-count 0})]
        {:type-table type-table
         :binding-shapes binding-shapes
         :binding-types (get loop-result :bindings (get call-result :binding-types))
         :function-types function-with-params
         :constraints (sh08-ft-add-values-to-set
                        (sh08-ft-loop-constraints (get loop-result :constraints) node-index (get (get context :loop-core) :module))
                        (get call-result :constraints))
         :loop-work-count (get loop-result :work-count)
         :diagnostics (sh08-ft-add-values-to-set (sh08-ft-loop-diagnostics (get loop-result :issues) node-index)
                                                (get call-result :diagnostics))})
      (let [node (first remaining)
            node-type
            (sh08-ft-infer-node-with-context
             node type-table binding-types function-result edges context)]
        (recur
         (rest remaining)
         (assoc type-table (get node :node-id) node-type)
         binding-types
                    (if (= (get (get node :core-form) :none) :none)
           function-result
           function-result)))))))

(defn sh08-ft-infer-pass
  [nodes lexical-bindings definitions calls edges function-types
   initial-binding-types]
  (sh08-ft-infer-pass-with-context
   nodes lexical-bindings definitions calls edges function-types
   initial-binding-types {}))

(defn sh08-ft-update-function-returns
  [function-types nodes type-table]
  (loop [remaining (keys function-types) result function-types]
    (if (= (count remaining) 0)
      result
      (let [function-id (first remaining)
            function (get result function-id)
            body-id (get function :body-core-node-id)
            body-type (get type-table body-id :gravity.type/unknown)
            prior-type (get function :return :gravity.type/unknown)
            conflict
            (if (sh08-ft-known? prior-type)
              (if (sh08-ft-known? body-type)
                (if (if (= body-type :gravity.type/never) true (= prior-type body-type))
                  nil
                  {:function-id function-id
                   :body-core-node-id body-id
                   :expected prior-type
                   :actual body-type})
                nil)
              nil)
            next-type
            (if (sh08-ft-known? prior-type)
              prior-type
              body-type)]
        (recur
         (rest remaining)
         (assoc result function-id
                (assoc
                 (assoc function :return next-type)
                 :return-conflict conflict)))))))

(defn sh08-ft-first-return-conflict [function-types node-table]
  (loop [remaining (keys function-types)]
    (if (= (count remaining) 0)
      nil
      (let [function (get function-types (first remaining))
            conflict (get function :return-conflict)]
        (if (= conflict nil)
          (recur (rest remaining))
          (assoc conflict
                 :node
                 (get node-table (get conflict :body-core-node-id))))))))

(defn sh08-ft-parameter-slot-count [function-records]
  (loop [remaining function-records total 0]
    (if (= (count remaining) 0)
      total
      (recur
       (rest remaining)
       (+ total (count (get (first remaining) :parameter-binding-ids)))))))

(defn sh08-ft-inference-round-bound
  [node-sequence function-records calls lexical-bindings]
  (+ 2
     (count node-sequence)
     (count function-records)
     (sh08-ft-parameter-slot-count function-records)
     (count calls)
     (count lexical-bindings)))

(defn sh08-ft-infer-acyclic-with-context
  [node-sequence node-table lexical-bindings definitions calls edges
   function-types binding-types maximum-rounds context]
  (loop [rounds-left maximum-rounds
         round 1
         current-functions function-types
         current-bindings binding-types
         current-types {}
         current-shapes {}
         loop-work-left 65536]
    (if (<= rounds-left 0)
      {:convergence-status :nonconverged
       :round-count (- round 1)
       :round-bound maximum-rounds
       :function-types current-functions
       :binding-types current-bindings
       :type-table {}
       :constraints []
       :diagnostics
       [{:node {}
         :rule "C7-GENERIC"
         :reason :bounded-function-type-inference-nonconvergence
         :expected :fixed-point-within-declared-round-bound
         :actual maximum-rounds}]}
      (let [pass
            (sh08-ft-infer-pass-with-context
             node-sequence lexical-bindings definitions calls edges
             current-functions current-bindings (assoc context :prior-type-table current-types :prior-binding-shapes current-shapes
                                                               :loop-work-left loop-work-left))
            next-bindings (get pass :binding-types)
            next-functions
            (sh08-ft-update-function-returns
             (sh08-ft-update-param-types
              (get pass :function-types)
              next-bindings)
             node-table
             (get pass :type-table))
            return-conflict
            (sh08-ft-first-return-conflict next-functions node-table)]
        (if (= return-conflict nil)
          (if (if (= next-functions current-functions)
                (if (= next-bindings current-bindings)
                  (if (if (> (count (get context :boolean-matches)) 0) true (map? (get context :loop-core)))
                    (if (= current-types (get pass :type-table))
                      (= current-shapes (get pass :binding-shapes)) false) true) false)
                false)
            (assoc pass
                   :function-types next-functions
                   :binding-types next-bindings
                   :convergence-status :converged
                   :round-count round
                   :round-bound maximum-rounds)
            (recur
             (- rounds-left 1)
             (+ round 1)
             next-functions
             next-bindings
             (get pass :type-table)
             (get pass :binding-shapes)
             (- loop-work-left (get pass :loop-work-count 0))))
          (assoc pass
                 :function-types next-functions
                 :binding-types next-bindings
                 :convergence-status :type-conflict
                 :round-count round
                 :round-bound maximum-rounds
                  :diagnostics
                 (conj
                  (get pass :diagnostics)
                  {:node (get return-conflict :node)
                   :rule "C7-TYPE-MISMATCH"
                   :reason :function-result-type-mismatch
                   :expected (get return-conflict :expected)
                   :actual (get return-conflict :actual)})))))))

(defn sh08-ft-infer-acyclic
  [node-sequence node-table lexical-bindings definitions calls edges
   function-types binding-types maximum-rounds]
  (sh08-ft-infer-acyclic-with-context
   node-sequence node-table lexical-bindings definitions calls edges
   function-types binding-types maximum-rounds {}))

(defn sh08-ft-first-unknown-node [nodes type-table]
  (if (= (count nodes) 0)
    nil
    (let [node (first nodes)
          node-type
          (get type-table (get node :node-id) :gravity.type/unknown)]
      (if (sh08-ft-known? node-type)
        (sh08-ft-first-unknown-node (rest nodes) type-table)
        node))))

(defn sh08-ft-function-facts
  [function-types nodes module]
  (loop [remaining (keys function-types) values []]
    (if (= (count remaining) 0)
      values
      (let [function (get function-types (first remaining))
            node (get nodes (get function :function-core-node-id))]
        (recur
         (rest remaining)
         (conj values
               (assoc function
                      :source-span (get (get node :source) :semantic-span)
                      :syntax-id (get (get node :source) :syntax-id)
                      :origin-chain (get (get node :source) :origin-chain)
                      :generated-origin
                      (get (get node :source) :generated-origin)
                      :profile (get module :profile)
                      :target (get module :target))))))))

(defn sh08-ft-local-facts
  [lexical-bindings type-table binding-types nodes module]
  (loop [remaining lexical-bindings values []]
    (if (= (count remaining) 0)
      values
      (let [record (first remaining)
            node (get nodes (get record :initializer-node-id))]
        (recur
         (rest remaining)
         (conj values
               {:artifact :gravity/c7-local-binding-fact
                :fact-id-request
                {:domain :gravity/sh08-local-binding-fact-v1
                 :binding-id (get record :binding-id)
                 :initializer-node-id
                 (get record :initializer-node-id)
                 :type
                 (get binding-types (get record :binding-id)
                      :gravity.type/unknown)
                 :profile (get module :profile)
                 :target (get module :target)}
                :binding-id (get record :binding-id)
                :name (get record :name)
                :type
                (get binding-types (get record :binding-id)
                     :gravity.type/unknown)
                :initializer-node-id (get record :initializer-node-id)
                :let-core-node-id (get record :let-core-node-id)
                :source-span (get (get node :source) :semantic-span)
                :syntax-id (get (get node :source) :syntax-id)
                :origin-chain (get (get node :source) :origin-chain)
                :generated-origin
                (get (get node :source) :generated-origin)
                :profile (get module :profile)
                :target (get module :target)
                :effects (get module :effects)
                :capabilities (get module :capabilities)
                :status :inferred}))))))

(defn sh08-ft-call-facts-with-context
  [calls edges nodes type-table function-types module context]
  (loop [remaining calls
         remaining-edges edges
         values []]
    (if (= (count remaining) 0)
      values
      (let [call (first remaining)
            edge (first remaining-edges)
            node (get nodes (get call :core-node-id))
            imported (sh08-im-callee edge context)
            callee
            (if (map? imported) (get imported :function-type)
              (get function-types (get edge :callee-function-syntax-id)))
            higher-order-call?
            (if (= :accepted (get context :status))
              (= (get call :core-node-id)
                 (get context :inner-call-core-node-id))
              false)
            higher-order-outer-call?
            (if (= :accepted (get context :status))
              (= (get call :core-node-id)
                 (get context :outer-call-core-node-id))
              false)
            result-type
            (if (= :gravity.type/never (get type-table (get call :core-node-id))) :gravity.type/never
            (if higher-order-call?
              (get context :value-type :gravity.type/unknown)
              (if (map? callee)
                (get callee :return)
                :gravity.type/unknown)))
            argument-types
            (loop [ids (get call :argument-node-ids) result []]
              (if (= (count ids) 0)
                result
                (recur
                 (rest ids)
                 (conj result
                       (get type-table (first ids)
                            :gravity.type/unknown)))))
            base-fact
            {:artifact :gravity/c7-call-type-fact
             :fact-id-request
             {:domain :gravity/sh08-call-type-fact-v1
              :call-core-node-id (get call :core-node-id)
              :callee-function-syntax-id
              (get edge :callee-function-syntax-id)
              :argument-types argument-types
              :result-type result-type}
             :call-core-node-id (get call :core-node-id)
             :caller-function-syntax-id
             (get edge :caller-function-syntax-id)
             :callee-function-syntax-id
             (get edge :callee-function-syntax-id)
             :argument-types argument-types
             :result-type result-type
             :evaluation-order (get call :evaluation-order)
             :source-span (get (get node :source) :semantic-span)
             :syntax-id (get (get node :source) :syntax-id)
             :origin-chain (get (get node :source) :origin-chain)
             :generated-origin
             (get (get node :source) :generated-origin)
             :profile (get module :profile)
             :target (get module :target)
             :effects (get module :effects)
             :capabilities (get module :capabilities)
             :status :inferred}
            call-fact
            (if higher-order-call?
              (assoc
               (assoc
                (assoc
                 (assoc
                  (assoc
                   (assoc base-fact
                          :fact-id-request
                          (assoc (get base-fact :fact-id-request)
                                 :higher-order-call? true))
                   :callable-parameter-binding-id
                   (get context :apply-callable-binding-id))
                  :dispatch :indirect-function-value)
                 :higher-order-call? true)
                :selected-identity-function-syntax-id
                (get context :identity-function-syntax-id))
               :b47-edge
               (sh08-ft-higher-order-edge-projection edge))
              (if higher-order-outer-call?
                (assoc
                 (assoc
                  (assoc base-fact
                         :dispatch :direct-local-function)
                  :selected-apply-function-syntax-id
                  (get context :apply-function-syntax-id))
                 :b47-edge
                 (sh08-ft-higher-order-edge-projection edge))
                base-fact))]
        (recur
         (rest remaining)
         (rest remaining-edges)
         (conj values (if (map? imported)
                        (assoc call-fact :dispatch :direct-imported-function
                               :fact-id-request (assoc (get call-fact :fact-id-request) :imported-function (sh08-im-reference imported)
                                                        :effect-status :pending-sh09-imported-body :legality-status :pending-imported-effects)
                               :imported-function (sh08-im-reference imported) :effect-status :pending-sh09-imported-body
                               :effects (get (get imported :function-type) :latent-effects)
                               :capabilities (get (get imported :function-type) :capabilities)
                               :effect-facts-source :callee-module-declarations
                               :legality-status :pending-imported-effects)
                        call-fact)))))))

(defn sh08-ft-call-facts
  [calls edges nodes type-table function-types module]
  (sh08-ft-call-facts-with-context
   calls edges nodes type-table function-types module {}))

(defn sh08-ft-first-recursive-component [components]
  (if (= (count components) 0)
    nil
    (first components)))

(defn sh08-ft-higher-order-result-fields [result proof]
  (if (= :accepted (get proof :status))
    (assoc
     (assoc result
            :higher-order-proof
            (sh08-ft-higher-order-proof-input proof))
     :higher-order-call-facts
     (sh08-ft-higher-order-call-proof-facts proof))
    result))

(defn sh08-ft-recursive-result-fields [result proof canonical-call-facts]
  (if (= :accepted (get proof :status))
    (assoc
     (assoc result
            :recursive-proof
            (sh08-ft-recursive-proof-input proof))
     :recursive-call-facts
     (sh08-ft-recursive-call-proof-facts proof canonical-call-facts))
    result))

(defn sh08-ft-function-skeletons [function-records module]
  (loop [remaining function-records
         result {}]
    (if (= (count remaining) 0)
      result
      (let [record (first remaining)]
        (recur
         (rest remaining)
         (assoc result
                (get record :function-syntax-id)
                (sh08-ft-function-type-skeleton record module)))))))

(defn sh08-ft-complete-recursive-skeletons
  [base-function-skeletons recursive-proof]
  (if (= :accepted (get recursive-proof :status))
    (loop [remaining (keys base-function-skeletons)
           result base-function-skeletons]
      (if (= (count remaining) 0)
        result
        (let [function-id (first remaining)
              function (get result function-id)]
          (if (= function-id (get recursive-proof :function-syntax-id))
            (recur
             (rest remaining)
             (assoc result function-id
                    (sh08-ft-recursive-complete-function
                     function recursive-proof)))
            (recur (rest remaining) result)))))
    base-function-skeletons))

(defn sh08-ft-complete-higher-order-skeletons
  [base-function-skeletons higher-order-proof]
  (if (= :accepted (get higher-order-proof :status))
    (loop [remaining (keys base-function-skeletons)
           result base-function-skeletons]
      (if (= (count remaining) 0)
        result
        (let [function-id (first remaining)
              function (get result function-id)]
          (if (= function-id
                 (get (get (get higher-order-proof :identity)
                           :record)
                      :function-syntax-id))
            (recur
             (rest remaining)
             (assoc result function-id
                    (sh08-ft-higher-order-complete-function
                     function
                     (get higher-order-proof :identity-function-type))))
            (if (= function-id
                   (get (get (get higher-order-proof :apply)
                             :record)
                        :function-syntax-id))
              (recur
               (rest remaining)
               (assoc result function-id
                      (sh08-ft-higher-order-complete-function
                       function
                       (get higher-order-proof
                            :apply-function-type))))
              (recur (rest remaining) result))))))
    base-function-skeletons))

(defn sh08-ft-complete-function-skeletons
  [base-function-skeletons recursive-proof higher-order-proof]
  (sh08-ft-restore-declarations
  (if (= :accepted (get recursive-proof :status))
    (sh08-ft-complete-recursive-skeletons
     base-function-skeletons recursive-proof)
    (if (= :accepted (get higher-order-proof :status))
      (sh08-ft-complete-higher-order-skeletons
       base-function-skeletons higher-order-proof)
      base-function-skeletons)) base-function-skeletons))

(defn sh08-ft-inference-context
  [recursive? higher-order? recursive-proof higher-order-proof
   function-skeletons]
  (if recursive?
    {(get (get recursive-proof :definition) :binding-id)
     (get function-skeletons
          (get recursive-proof :function-syntax-id))}
    (if higher-order?
      (get higher-order-proof :initial-binding-types)
      {})))

(defn sh08-ft-context-proof
  [recursive? higher-order? recursive-proof higher-order-proof]
  (if recursive?
    recursive-proof
    (if higher-order?
      higher-order-proof
      {})))

(defn sh08-ft-proof-results [shape products bindings module]
  (let [recursive-proof
        (if (> (count (get products :recursion-components)) 0)
          (sh08-ft-recursive-proof
           (get shape :nodes)
           (get products :definitions)
           bindings
           (get products :function-records)
           (get products :calls)
           (get products :call-edges)
           (get products :recursion-components)
           module)
          {:status :not-applicable :reason :no-recursive-component})
        higher-order-proof
        (sh08-ft-higher-order-proof
         (get shape :nodes)
         (get products :definitions)
         bindings
         (get products :function-records)
         (get products :calls)
         (get products :call-edges)
         module)]
    {:recursive-proof recursive-proof
     :higher-order-proof higher-order-proof}))

(defn sh08-ft-final-functions [functions]
  (loop [remaining functions
         values []]
    (if (= (count remaining) 0)
      values
      (let [known?
            (if (sh08-ft-every-known?
                 (loop [params (get (first remaining) :parameters)
                        result []]
                   (if (= (count params) 0)
                     (conj result (get (first remaining) :return))
                     (recur
                      (rest params)
                      (conj result (get (first params) :type))))))
              true
              false)]
        (if known?
          (recur (rest remaining) (conj values (first remaining)))
          (recur
           (rest remaining)
           (conj values (assoc (first remaining) :status :unresolved))))))))

(defn sh08-ft-signature-constraints [records module]
  (loop [remaining records result []]
    (if (= (count remaining) 0) result
      (let [record (first remaining) signature (get record :signature)
            parameter-ids (get record :parameter-binding-ids)]
        (recur (rest remaining)
          (if (contains? record :signature)
            (loop [declarations (conj (get signature :parameters) (get signature :return)) ordinal 0 values result]
              (if (= (count declarations) 0) values
                (let [declaration (first declarations) result? (= ordinal (count parameter-ids))]
                  (recur (rest declarations) (+ ordinal 1)
                    (if (= declaration nil) values
                      (conj values
                        {:constraint-id-request
                         {:domain :gravity/sh08-atomic-function-declaration-constraint-v1
                          :function-core-node-id (get record :function-core-node-id)
                          :role (if result? :return :parameter) :ordinal ordinal :declaration declaration}
                         :kind :equality :producer-rule :sh08-atomic-function-signature-v1
                         :lhs (if result? (get record :body-core-node-id) (get parameter-ids ordinal))
                         :rhs (get declaration :type-id) :source-syntax-id (get declaration :type-syntax-id)
                         :profile (get module :profile) :target (get module :target)
                         :status :solved :diagnostics []})))))) result))))))

(defn sh08-ft-any-signature? [records]
  (if (= (count records) 0) false
    (if (contains? (first records) :signature) true (sh08-ft-any-signature? (rest records)))))

(defn sh08-ft-function-type-core-artifact-with-imports [core-artifact bindings source-forms imports]
  (if (map? core-artifact)
    (let [shape (sh08-validate-core-shape core-artifact)
          module (if (map? (get core-artifact :module))
                   (get core-artifact :module)
                   {})
          products (sh08-bm-products core-artifact
                     (sh08-ft-products-valid? core-artifact shape bindings) source-forms)]
      (if (= (get products :status) :accepted)
        (let [proof-results
              (sh08-ft-proof-results shape products bindings module)
              recursive-proof (get proof-results :recursive-proof)
              higher-order-proof (get proof-results :higher-order-proof)]
          (let [unsupported-higher-order?
                (= :unsupported-higher-order-primitive-type
                   (get higher-order-proof :reason))]
            (if (if unsupported-higher-order?
                  true
                  (if (> (count (get products :recursion-components)) 0)
                (if (= :accepted (get recursive-proof :status)) false true)
                false))
              (if unsupported-higher-order?
                {:artifact :gravity/sh08-function-typed-core-template
                 :schema-version 3
                 :status :rejected
                 :scope :capture-free-higher-order-fixed-arity-one-hop
                 :authentication-status
                 :host-resolved-b47-verification-boundary
                 :module module
                 :sh07-shaped-artifact-id (get core-artifact :artifact-id)
                 :diagnostics
                 [(sh08-ft-diagnostic
                   "C7-ANNOTATION"
                   (get higher-order-proof :node)
                   module
                   :supported-higher-order-primitive-type
                   (get higher-order-proof :actual)
                   :unsupported-higher-order-primitive-type
                   {})]
                 :pending [:recursive-type-annotations
                           :higher-order-functions :records :unions
                           :protocols :generics :casts :dynamic-boundaries]}
                {:artifact :gravity/sh08-function-typed-core-template
                 :schema-version 3
                 :status :rejected
                 :scope :first-order-fixed-arity-functions-locals-calls
                 :authentication-status
                 :host-resolved-b47-verification-boundary
                 :module module
                 :sh07-shaped-artifact-id (get core-artifact :artifact-id)
                 :diagnostics
                 [(sh08-ft-recursive-diagnostic recursive-proof module)]
                 :pending [:recursive-type-annotations
                           :higher-order-functions :records :unions
                           :protocols :generics :casts :dynamic-boundaries]})
              (let [base-function-skeletons
                (sh08-ft-function-skeletons
                 (get products :function-records) module)
                nodes (get products :node-table)
                recursive?
                (= :accepted (get recursive-proof :status))
                higher-order?
                (= :accepted (get higher-order-proof :status))
                function-skeletons
                (sh08-ft-complete-function-skeletons
                 base-function-skeletons recursive-proof higher-order-proof)
                quoted-products (sh08-qd-products (get shape :nodes) source-forms module)
                unprojected-inference
                (sh08-ft-infer-acyclic-with-context
                 (get shape :nodes)
                 nodes
                 (get products :lexical-bindings)
                 (get products :definitions)
                 (get products :calls)
                 (get products :call-edges)
                 function-skeletons
                 (sh08-ft-declaration-seeds function-skeletons (sh08-im-seeds imports (sh08-ft-inference-context
                  recursive? higher-order? recursive-proof
                  higher-order-proof function-skeletons)))
                 (+ (count (get core-artifact :match-pattern-records)) (sh08-ft-inference-round-bound
                  (get shape :nodes)
                  (get products :function-records)
                  (get products :calls)
                  (get products :lexical-bindings))
                  (if (vector? (get core-artifact :loop-bindings)) (count (get core-artifact :loop-bindings)) 0))
                 (assoc (sh08-ft-context-proof
                  recursive? higher-order? recursive-proof higher-order-proof)
                   :boolean-matches (get products :boolean-matches) :quote-types (get quoted-products :type-table)
                   :imported-functions imports :loop-core (sh08-ft-loop-working-core core-artifact bindings)))
                throw-products (sh08-th-products core-artifact source-forms (get unprojected-inference :type-table) 65536)
                throw-call (sh08-th-call-fence core-artifact (get throw-products :throws))
                raw-inference (if (= 0 (count (get throw-products :throws))) unprojected-inference
                  (assoc unprojected-inference
                    :type-table (sh08-th-type-map (get unprojected-inference :type-table) (get throw-products :throws))
                    :function-types (sh08-th-type-map (get unprojected-inference :function-types) (get throw-products :throws))))
                match-checks
                (sh08-bm-checks (sh08-sm-groups-with-shapes (get products :boolean-matches) (get raw-inference :binding-shapes)) (get raw-inference :type-table)
                                (get raw-inference :function-types) module)
                unknown-node
                (if (= (get raw-inference :convergence-status)
                       :converged)
                  (sh08-ft-first-unknown-node
                   (get shape :nodes)
                   (get raw-inference :type-table))
                  nil)
                inference
                (if (> (count (get throw-products :diagnostics)) 0)
                  (assoc raw-inference :diagnostics (get throw-products :diagnostics))
                (if (map? throw-call) (assoc raw-inference :diagnostics [throw-call])
                (if (> (count (get quoted-products :diagnostics)) 0)
                  (assoc raw-inference :diagnostics (get quoted-products :diagnostics))
                (if (> (count (get match-checks :diagnostics)) 0)
                  (assoc raw-inference :diagnostics (get match-checks :diagnostics))
                (if (map? unknown-node)
                  (assoc
                   raw-inference
                   :diagnostics
                   (conj
                    (get raw-inference :diagnostics)
                    {:node unknown-node
                     :rule "C7-ANNOTATION"
                     :reason :unsupported-or-unresolved-core-node-type
                     :expected :concrete-node-type-or-diagnostic
                     :actual :gravity.type/unknown}))
                  raw-inference)))))
                functions
                (sh08-ft-function-facts
                 (get inference :function-types)
                 nodes module)
                final-functions
                (sh08-th-functions (sh08-ft-final-functions functions) (get throw-products :throws))]
            (if (> (count (get inference :diagnostics)) 0)
              {:artifact :gravity/sh08-function-typed-core-template
               :schema-version 3
               :status :rejected
               :scope :first-order-fixed-arity-functions-locals-calls
               :authentication-status
               :host-resolved-b47-verification-boundary
               :module module
               :sh07-shaped-artifact-id (get core-artifact :artifact-id)
               :diagnostics
               (sh08-ft-render-inference-diagnostics
                (get inference :diagnostics) nodes module)
               :pending [:recursive-type-annotations
                         :higher-order-functions :records :unions
                         :protocols :generics :casts :dynamic-boundaries]}
              (if (loop [remaining final-functions]
                    (if (= (count remaining) 0)
                      true
                      (if (= (get (first remaining) :status) :inferred)
                        (recur (rest remaining))
                        false)))
                (let [local-facts
                      (sh08-ft-local-facts
                       (get products :lexical-bindings)
                       (get inference :type-table)
                       (get inference :binding-types)
                       nodes module)
                      call-facts
                      (sh08-ft-call-facts-with-context
                       (get products :calls)
                       (get products :call-edges)
                       nodes
                       (get inference :type-table)
                       (get inference :function-types)
                       module
                       (assoc higher-order-proof :imported-functions imports))
                      base-constraints
                      (sh08-ft-add-values-to-set (get quoted-products :constraints)
                      (sh08-ft-add-values-to-set (get match-checks :constraints) (sh08-ft-add-values-to-set
                        (sh08-ft-signature-constraints (get products :function-records) module)
                      (if recursive?
                        (sh08-ft-add-values-to-set
                         (sh08-ft-recursive-constraint-ledger recursive-proof)
                         (get inference :constraints))
                        (get inference :constraints)))))
                      combined-constraints (sh08-ft-add-values-to-set (get throw-products :constraints) base-constraints)
                      convergence
                      {:status (get inference :convergence-status)
                       :round-count (get inference :round-count)
                       :round-bound (get inference :round-bound)
                       :proof
                       :monotone-finite-type-fact-propagation}
                      identity-input-base
                      {:domain (if recursive?
                                :gravity/sh08-recursive-function-typed-core-v1
                                (if (sh08-ft-any-signature? (get products :function-records))
                                  :gravity/sh08-atomic-function-signature-typed-core-v1 :gravity/sh08-function-typed-core-v3))
                       :sh07-shaped-artifact-id
                       (get core-artifact :artifact-id)
                       :module module
                       :function-records
                       (get products :function-records)
                       :call-edges (get products :call-edges)
                       :recursion-components
                       (get products :recursion-components)
                       :lexical-bindings
                       (get products :lexical-bindings)
                       :function-type-table final-functions
                       :local-binding-facts local-facts
                       :call-type-facts call-facts
                       :constraint-ledger combined-constraints
                       :type-table (get inference :type-table)
                       :convergence convergence
                       :pending [:recursive-type-annotations
                                 :higher-order-functions :records :unions
                                 :protocols :generics :casts
                                 :dynamic-boundaries]}
                      identity-input
                      (if recursive?
                        (assoc
                         (assoc identity-input-base
                                :pending
                                (sh08-ft-recursive-pending
                                 (get identity-input-base :pending)))
                         :recursive-proof
                         (sh08-ft-recursive-proof-input recursive-proof))
                        (if higher-order?
                          (assoc
                           (assoc
                            (assoc identity-input-base
                                   :domain
                                   :gravity/sh08-authoritative-higher-order-type-v1)
                             :pending
                             (sh08-ft-higher-order-pending
                              (get identity-input-base :pending)))
                           :higher-order-proof
                           (sh08-ft-higher-order-proof-input
                            higher-order-proof))
                          identity-input-base))
                      typed-core-base
                      {:artifact :gravity/typed-core
                       :core-input (get core-artifact :artifact-id)
                       :module module
                       :types (get inference :type-table)
                       :constraints combined-constraints
                       :function-types final-functions
                       :local-bindings local-facts
                       :calls call-facts
                       :diagnostics []}
                      typed-core
                      (if recursive?
                        (assoc
                         (assoc typed-core-base
                                :recursive-proof
                                (sh08-ft-recursive-proof-input
                                 recursive-proof))
                         :recursive-call-facts
                         (sh08-ft-recursive-call-proof-facts
                          recursive-proof call-facts))
                        (if higher-order?
                          (assoc
                           (assoc typed-core-base
                                  :higher-order-proof
                                  (sh08-ft-higher-order-proof-input
                                   higher-order-proof))
                           :higher-order-call-facts
                           (sh08-ft-higher-order-call-proof-facts
                            higher-order-proof))
                          typed-core-base))]
                  (sh08-ft-recursive-result-fields
                   (sh08-ft-higher-order-result-fields
                   {:artifact :gravity/sh08-function-typed-core-template
                   :schema-version 3
                   :status :accepted
                   :scope (if recursive?
                            :bounded-named-self-recursive-positive-fixed-arity-positional-literal-base
                            (if higher-order?
                              :capture-free-higher-order-fixed-arity-one-hop
                              :first-order-fixed-arity-functions-locals-calls))
                   :authentication-status
                   :host-resolved-b47-verification-boundary
                   :module module
                   :sh07-shaped-artifact-id
                   (get core-artifact :artifact-id)
                   :function-products
                   {:function-records (get products :function-records)
                    :call-edges (get products :call-edges)
                    :recursion-components
                    (get products :recursion-components)
                    :lexical-bindings
                    (get products :lexical-bindings)}
                   :function-type-table final-functions
                   :local-binding-facts local-facts
                   :call-type-facts call-facts
                   :constraint-ledger combined-constraints
                   :type-table (get inference :type-table)
                   :convergence convergence
                   :typed-core typed-core
                   :diagnostics []
                   :artifact-id-request identity-input
                   :identity-input identity-input
                   :identity-resolution :coordinator-digest-required
                   :provenance (get core-artifact :provenance)
                   :pending (get identity-input :pending)}
                   higher-order-proof)
                   recursive-proof
                   call-facts))
                {:artifact :gravity/sh08-function-typed-core-template
                 :schema-version 3
                 :status :rejected
                 :scope :first-order-fixed-arity-functions-locals-calls
                 :authentication-status
                 :host-resolved-b47-verification-boundary
                 :module module
                 :sh07-shaped-artifact-id (get core-artifact :artifact-id)
                 :diagnostics
                 [(sh08-ft-diagnostic
                   "C7-GENERIC" {}
                   module :fully-inferred-function-types
                   final-functions
                   :unresolved-function-type {})]
                 :pending [:recursive-type-annotations
                           :higher-order-functions :records :unions
                           :protocols :generics :casts :dynamic-boundaries]}))))))
        {:artifact :gravity/sh08-function-typed-core-template
         :schema-version 3
         :status :rejected
         :scope :first-order-fixed-arity-functions-locals-calls
         :authentication-status
         :host-resolved-b47-verification-boundary
         :module module
         :sh07-shaped-artifact-id (get core-artifact :artifact-id)
         :diagnostics
         [(sh08-ft-diagnostic
           (get products :rule "C7-VERIFY") (get products :node {})
           module :coherent-b47-function-products
           (get products :reason)
           (get products :reason) {})]
         :pending [:recursive-type-annotations
                   :higher-order-functions :records :unions
                   :protocols :generics :casts :dynamic-boundaries]}))
    {:artifact :gravity/sh08-function-typed-core-template
     :schema-version 3
     :status :rejected
     :scope :first-order-fixed-arity-functions-locals-calls
     :authentication-status
     :host-resolved-b47-verification-boundary
     :module {}
     :diagnostics
     [(sh08-ft-diagnostic
       "C7-VERIFY" {} {} :sh07-canonical-core-map core-artifact
       :sh07-shaped-core-map-required {})]}));

(defn sh08-function-type-boundary-policy []
  {:verification-boundary
   :host-validated-b47-report-and-opaque-provenance-digest
   :verification-preimage-domain
   :gravity/sh08-b47-verification-binding-v1
   :independent-gravity-cryptographic-verification? false
   :host-digest-authority-retained? true
   :native-gravity-cryptographic-verification :pending})

(defn sh08-ft-function-type-core-artifact-with-origins [core-artifact bindings source-forms]
  (sh08-ft-function-type-core-artifact-with-imports core-artifact bindings source-forms {}))

(defn sh08-ft-function-type-core-artifact [core-artifact bindings]
  (sh08-ft-function-type-core-artifact-with-origins core-artifact bindings []))

; L3/L5/C7: imported signatures come from freshly derived authenticated producer
; requests. The invocation-local memo shares work, never admission authority.
(defn sh08-im-path [value fields]
  (loop [remaining fields result value]
    (if (= (count remaining) 0) result
      (recur (rest remaining) (get result (first remaining))))))

(defn sh08-im-failure [rule reason actual]
  {:status :rejected :rule rule :reason reason :actual actual})

(defn sh08-im-callee [edge context]
  (if (= :nonlocal-or-nonfunction (get edge :classification))
    (get (get context :imported-functions) (get edge :callee-binding-id)) nil))

(defn sh08-im-seeds [imports initial]
  (loop [ids (keys imports) result initial]
    (if (= (count ids) 0) result
      (recur (rest ids) (assoc result (first ids) (get (get imports (first ids)) :function-type))))))

(defn sh08-im-reference [imported]
  (assoc (sh08-bm-project imported [:binding-id :producer-sh07-artifact-id :producer-sh06-artifact-id :definition-binding-id])
         :function-id (get (get imported :function-type) :function-id)))

(defn sh08-im-call-constraint [call edge args imported nodes]
  (let [function (get imported :function-type) parameters (get function :parameters)
        arity? (= (count args) (count parameters))
        mismatch (loop [as args ps parameters]
                   (if (= (count as) 0) nil
                     (if (if (if (= (first as) :gravity.type/never) false (sh08-ft-known? (first as)))
                           (= false (= (first as) (get (first ps) :type))) false)
                       {:expected (get (first ps) :type) :actual (first as)}
                       (recur (rest as) (rest ps)))))
        diagnostic (if (= false arity?)
                     {:call call :rule "C7-TYPE-MISMATCH" :reason :call-arity-mismatch
                      :expected (count parameters) :actual (count args)}
                     (if (map? mismatch)
                       (assoc mismatch :call call :rule "C7-TYPE-MISMATCH" :reason :call-argument-type-mismatch) nil))]
    {:constraint {:constraint-id-request {:domain :gravity/sh08-imported-call-constraint-v1
                                          :call-core-node-id (get call :core-node-id) :imported-function (sh08-im-reference imported)}
                  :kind :equality :producer-rule :sh08-imported-function-call-v1 :lhs (sh08-im-reference imported) :rhs args
                  :profile (first (get (get (get imported :origin) :origin-definition) :profile-set))
                  :target (first (get (get (get imported :origin) :origin-definition) :target-set))
                  :dependencies {:imported-function (sh08-im-reference imported) :arguments (get call :argument-node-ids)}
                  :solution {:argument-types args :result-type (get function :return)
                             :arguments-complete? (sh08-ft-every-known? args)}
                  :invalidation [:producer-request :module-artifact :origin-binding :complete-signature :argument-types
                                 :producer-declared-effects :producer-declared-capabilities :imported-body-effects]
                  :status (if (map? diagnostic) :rejected :solved)
                  :origin (get (get (get nodes (get call :core-node-id)) :source) :origin-chain)
                  :effect-status :pending-sh09-imported-body :legality-status :pending-imported-effects
                  :diagnostics (if (map? diagnostic) [diagnostic] [])}
     :diagnostics (if (map? diagnostic) [diagnostic] [])}))

(defn sh08-im-scalar-type? [type]
  ; Reuse the existing literal/atomic catalogs. Composite and callable import
  ; signatures remain outside this first-order scalar boundary.
  (loop [names [:nil :boolean :integer :decimal :ratio :character :string :keyword :symbol]]
    (if (= (count names) 0)
      (loop [atoms '[I8 I16 I32 I64 U8 U16 U32 U64 F32 F64 Bool String Symbol Keyword Ratio]]
        (if (= (count atoms) 0) false
          (if (= type (sh08-ft-atomic-type-id (first atoms))) true (recur (rest atoms)))))
      (if (= type (sh08-primitive-type-from-literal-kind (first names))) true (recur (rest names))))))

(defn sh08-im-declarations-consistent? [record function]
  (if (contains? record :signature)
    (let [signature (get record :signature) declarations (get signature :parameters) parameters (get function :parameters)
          result (get signature :return)]
      (if (if (map? signature) (vector? declarations) false)
        (if (= signature (get function :signature))
          (if (= (count declarations) (count parameters))
            (if (if (= result nil) true
                  (if (map? result) (= (get result :type-id) (get function :return)) false))
              (loop [ds declarations ps parameters]
                (if (= (count ds) 0) true
                  (if (if (= (first ds) nil) true
                        (if (map? (first ds)) (= (get (first ds) :type-id) (get (first ps) :type)) false))
                    (recur (rest ds) (rest ps)) false))) false) false) false) false))
    (= false (contains? function :signature))))

(defn sh08-im-function-identities? [record function]
  (let [arity (get record :fixed-arity) ids (get record :parameter-binding-ids) parameters (get function :parameters)]
    (if (if (vector? ids) (if (vector? parameters) (integer? arity) false) false)
      (if (>= arity 0)
        (if (sh08-ft-all-true?
              [(= :gravity/c7-function-type (get function :artifact)) (= :inferred (get function :status))
               (= arity (get function :fixed-arity) (count ids) (count parameters))
               (= (get record :function-syntax-id) (get function :function-id))
               (= (get record :function-core-node-id) (get function :function-core-node-id))
               (= (get record :body-core-node-id) (get function :body-core-node-id))
               (= (get record :definition-name) (get function :definition-name))
               (= ids (get function :parameter-binding-ids))
               (sh08-sha256-id-vector? [(get record :function-syntax-id) (get record :function-core-node-id) (get record :body-core-node-id)])
               (sh08-all-unique? [(get record :function-syntax-id) (get record :function-core-node-id) (get record :body-core-node-id)] [])
               (sh08-sha256-id-vector? ids) (sh08-all-unique? ids [])])
          (loop [ps parameters remaining ids]
            (if (= (count ps) 0) (sh08-im-declarations-consistent? record function)
              (if (sh08-exact-keys? (first ps) #{:binding-id :type})
                (if (= (get (first ps) :binding-id) (first remaining)) (recur (rest ps) (rest remaining)) false) false))) false) false) false)))

(defn sh08-im-complete-signature? [record function]
  (if (sh08-im-function-identities? record function)
    (if (sh08-im-scalar-type? (get function :return))
      (loop [parameters (get function :parameters)]
        (if (= (count parameters) 0) true
          (if (sh08-im-scalar-type? (get (first parameters) :type)) (recur (rest parameters)) false))) false) false))

(defn sh08-im-origin [caller binding producer typed]
  (let [caller-c5 (sh08-im-path caller [:b47-context :authenticated-wrapper :sh06-resolution-artifact])
        callee-c5 (sh08-im-path producer [:b47-context :authenticated-wrapper :sh06-resolution-artifact])
        origin (get binding :semantic-span)
        id (get origin :ordinary-module-artifact-id)
        retained (sh08-bm-select (sh08-im-path caller-c5 [:gravity-resolution-boundary :module-inputs :module-artifacts]) :artifact-id id)
        caller-rows (sh08-bm-select (sh08-im-path caller-c5 [:binding-table :bindings]) :binding-id (get binding :upstream-binding-id))
        originals (sh08-bm-select (sh08-im-path callee-c5 [:binding-table :bindings]) :binding-id (get origin :origin-binding-id))
        original (first originals)
        projected (sh08-bm-select (sh08-im-path producer [:b47-context :authenticated-core-request :binding-table])
                                  :upstream-binding-id (get original :binding-id))
        records (sh08-bm-select (sh08-im-path producer [:canonical-core-artifact :function-records])
                                :definition-binding-id (get (first projected) :binding-id))
        record (first records)
        functions (sh08-bm-select (get typed :function-type-table) :function-id (get record :function-syntax-id))
        function (first functions)
        module (sh08-im-path callee-c5 [:gravity-resolution-boundary :resolved-analysis :module-contract])
        caller-module (sh08-im-path caller [:canonical-core-artifact :module])
        exact? (sh08-ft-all-true?
                 [(= 1 (count retained) (count caller-rows) (count originals) (count projected))
                  (= (first retained) callee-c5)
                  (= id (get callee-c5 :artifact-id)
                     (sh08-im-path producer [:b47-context :authenticated-core-request :lineage :authenticated-sh06-artifact-id]))
                  (= origin (get (first caller-rows) :semantic-span))
                  (= :import (get binding :binding-class) (get (first caller-rows) :binding-class))
                  (= (get binding :name) (get original :name))
                  (= (get binding :namespace) (get original :namespace) (get module :namespace))
                  (= :namespace (get original :binding-class))
                  (= :public (get original :visibility) (get binding :visibility))
                  (sh08-vector-contains? (get module :exports) (get original :name))
                  (= (get origin :origin-analysis-id) (sh08-im-path callee-c5 [:gravity-resolution-boundary :resolved-analysis :artifact-id]))
                  (= (get origin :origin-definition-artifact-id) (get original :definition-artifact-id))
                  (= (get origin :origin-definition-syntax-id) (get original :definition-syntax-id))
                  (= (get origin :origin-definition)
                     (sh08-bm-project original [:name :kind :namespace :package :visibility :profile-set :target-set :type-ref :effects :capabilities :safety]))])]
    (if exact?
      (if (= [(get caller-module :profile) (get caller-module :target)] [(get module :profile) (get module :target)])
        (if (if (= :function (get original :kind)) (= 1 (count records) (count functions)) false)
          (if (sh08-im-function-identities? record function)
          (if (sh08-im-complete-signature? record function)
            {:status :accepted :binding-id (get binding :binding-id) :origin origin
             :producer-sh07-artifact-id (sh08-im-path producer [:b47-context :artifact-id])
             :producer-sh06-artifact-id id :producer-identity (get typed :identity-input)
             :definition-binding-id (get (first projected) :binding-id)
             :function-type (sh08-bm-project function
                              [:artifact :function-id :function-core-node-id :body-core-node-id :definition-name :parameter-binding-ids :parameters :return :fixed-arity
                               :signature :latent-effects :capabilities :ownership-constraints :profile-constraints :thrown-error-effects :status])
             :effect-status :pending-sh09-imported-body :legality-status :pending-imported-effects}
            (sh08-im-failure "C7-ANNOTATION" :incomplete-or-unsupported-imported-scalar-signature (get binding :name)))
          (sh08-im-failure "C7-VERIFY" :imported-function-type-identity-mismatch (get binding :name)))
          (sh08-im-failure "C7-ANNOTATION" :unsupported-imported-function (get binding :name)))
        (sh08-im-failure "C7-ANNOTATION" :unsupported-cross-profile-imported-typing (get module :profile)))
      (sh08-im-failure "C7-VERIFY" :imported-function-origin-mismatch origin))))

(defn sh08-im-imports [request resolution producers]
  (let [core (get resolution :core) bindings (get resolution :binding-table)]
    (loop [nodes (get core :nodes) imports {} consumed #{}]
      (if (= (count nodes) 0)
        (if (= (count consumed) (count producers)) {:status :accepted :imports imports}
          (sh08-im-failure "C7-VERIFY" :unused-module-type-request nil))
        (let [node (first nodes) id (get (get node :attributes) :binding-id)
              binding (sh08-ft-binding-by-id bindings id)
              origin (get binding :semantic-span)
              ordinary? (if (= :reference (get node :core-form))
                          (if (= :import (get binding :binding-class)) (contains? origin :ordinary-module-artifact-id) false) false)]
          (if ordinary?
            (if (= :operator (get (get node :attributes) :position))
              (if (contains? imports id) (recur (rest nodes) imports consumed)
                (let [producer (get producers (get origin :ordinary-module-artifact-id))]
                  (if (map? producer)
                    (let [joined (sh08-im-origin request binding (get producer :request) (get producer :result))]
                      (if (= :accepted (get joined :status))
                        (recur (rest nodes) (assoc imports id joined) (conj consumed (get origin :ordinary-module-artifact-id)))
                        (assoc joined :node node :binding binding)))
                    (assoc (sh08-im-failure "C7-ANNOTATION" :missing-imported-function-typing (get binding :name)) :node node :binding binding))))
              (assoc (sh08-im-failure "C7-ANNOTATION" :unsupported-higher-order-import (get binding :name)) :node node :binding binding))
            (recur (rest nodes) imports consumed)))))))

(defn sh08-im-result [result imports]
  (if (if (= :accepted (get result :status)) (> (count imports) 0) false)
    (let [pending (conj (conj (get result :pending) :imported-body-effects) :imported-effect-legality)
          proof (loop [ids (vec (sort-by-pr-str (keys imports))) result []]
                  (if (= (count ids) 0) result
                    (recur (rest ids)
                      (conj result (sh08-bm-project (get imports (first ids))
                                     [:status :binding-id :origin :producer-sh07-artifact-id :producer-sh06-artifact-id
                                      :definition-binding-id :function-type :effect-status :legality-status])))))
          producer-map (loop [ids (keys imports) result {}]
                         (if (= (count ids) 0) result
                           (let [imported (get imports (first ids))]
                             (recur (rest ids) (assoc result (get imported :producer-sh06-artifact-id)
                                                {:producer-sh07-artifact-id (get imported :producer-sh07-artifact-id)
                                                 :producer-sh06-artifact-id (get imported :producer-sh06-artifact-id)
                                                 :identity-input (get imported :producer-identity)})))))
          producers (loop [ids (vec (sort-by-pr-str (keys producer-map))) result []]
                      (if (= (count ids) 0) result
                        (recur (rest ids) (conj result (get producer-map (first ids))))))
          identity (assoc (get result :identity-input) :domain :gravity/sh08-direct-imported-function-types-v1
                          :module-type-producers producers :imported-function-types proof :pending pending)
          core (assoc (get result :typed-core) :imported-function-types proof
                      :imported-effect-status :pending-sh09-imported-body)]
      (assoc result :scope :direct-imported-functions-types-only
             :module-type-producers producers :imported-function-types proof :typed-core core :pending pending
             :identity-input identity :artifact-id-request identity)) result))

(defn sh08-im-failure-node [request failure]
  (if (map? (get failure :node)) (get failure :node)
    (let [bindings (sh08-im-path request [:b47-context :authenticated-core-request :binding-table])]
      (loop [nodes (sh08-im-path request [:canonical-core-artifact :nodes])]
        (if (= (count nodes) 0) {}
          (let [node (first nodes) binding (sh08-ft-binding-by-id bindings (get (get node :attributes) :binding-id))
                module-id (get (get binding :semantic-span) :ordinary-module-artifact-id)]
            (if (sh08-ft-all-true? [(= :reference (get node :core-form)) (= :import (get binding :binding-class))
                                   (sh08-sha256-id? module-id)
                                   (if (contains? failure :producer-sh06-artifact-id)
                                     (= module-id (get failure :producer-sh06-artifact-id)) true)])
              node (recur (rest nodes)))))))))

(defn sh08-im-rejected-result [request failure]
  {:artifact :gravity/sh08-function-typed-core-template :schema-version 3 :status :rejected
   :scope :direct-imported-functions-types-only :authentication-status :host-resolved-b47-verification-required
   :module (get (get request :canonical-core-artifact) :module {})
   :diagnostics [(sh08-ft-diagnostic (get failure :rule "C7-VERIFY") (sh08-im-failure-node request failure) (get (get request :canonical-core-artifact) :module {})
                    :authentic-complete-imported-function-type (get failure :actual) (get failure :reason) {})]
   :pending [:imported-body-effects :imported-effect-legality :runtime-linking]})

(defn sh08-im-producers [requests memo active retained]
  (loop [remaining requests current memo producers {}]
    (if (= (count remaining) 0) {:status :accepted :memo current :producers producers}
      (let [request (first remaining)
            id (sh08-im-path request [:b47-context :authenticated-wrapper :sh06-resolution-artifact :artifact-id])]
        (if (if (sh08-sha256-id? id) (= false (contains? producers id)) false)
          (if (let [matches (sh08-bm-select retained :artifact-id id)]
                (if (= 1 (count matches))
                  (= (first matches) (sh08-im-path request [:b47-context :authenticated-wrapper :sh06-resolution-artifact])) false))
          (let [derived (sh08-im-derive request current active) result (get derived :result)]
            (if (= :accepted (get result :status))
              (recur (rest remaining) (get derived :memo) (assoc producers id {:request request :result result}))
              (assoc (sh08-im-failure
                       (if (= "C7-VERIFY" (get (first (get result :diagnostics)) :rule)) "C7-VERIFY" "C7-ANNOTATION")
                       :invalid-module-type-producer (get result :diagnostics))
                     :producer-sh06-artifact-id id :memo (get derived :memo))))
          (assoc (sh08-im-failure "C7-VERIFY" :undeclared-module-type-producer id) :memo current))
          (assoc (sh08-im-failure "C7-VERIFY" :duplicate-or-invalid-module-type-producer id) :memo current))))))

(defn sh08-im-inputs-check [inputs]
  (if (sh08-exact-keys? inputs #{:artifact :schema-version :module-requests})
    (if (= [:gravity/sh08-module-type-inputs 1] [(get inputs :artifact) (get inputs :schema-version)])
      (if (vector? (get inputs :module-requests))
        (if (<= (count (get inputs :module-requests)) (get (sh08-local-bounds-value) :maximum-root-nodes))
          {:status :accepted}
          (sh08-im-failure "C7-VERIFY" :module-type-input-count-limit nil))
        (sh08-im-failure "C7-VERIFY" :malformed-module-type-inputs nil))
      (sh08-im-failure "C7-VERIFY" :malformed-module-type-inputs nil))
    (sh08-im-failure "C7-VERIFY" :malformed-module-type-inputs nil)))

(defn sh08-im-usage [entries pending?]
  (loop [ids (keys entries) result {:nodes 0 :scalar-units 0}]
    (if (= (count ids) 0) result
      (let [entry (get entries (first ids)) usage (if pending? entry (get entry :usage))]
        (recur (rest ids) {:nodes (+ (get result :nodes) (get usage :nodes 0))
                          :scalar-units (+ (get result :scalar-units) (get usage :scalar-units 0))})))))

(defn sh08-im-work-check [memo active usage]
  ; Units are distinct authenticated producers and their canonical-core DATA
  ; visits, not raw repeated proof bytes, VM operations, or a CPU guarantee.
  (let [bounds (sh08-local-bounds-value) complete (sh08-im-usage memo false) pending (sh08-im-usage active true)
        total {:producers (+ (count memo) (count active) 1) :dependency-depth (+ (count active) 1)
               :nodes (+ (get complete :nodes) (get pending :nodes) (get usage :nodes 0))
               :scalar-units (+ (get complete :scalar-units) (get pending :scalar-units) (get usage :scalar-units 0))}]
    (if (= :accepted (get usage :status))
      (if (<= (get total :producers) (get bounds :maximum-root-nodes))
        (if (<= (get total :dependency-depth) (get bounds :maximum-carrier-depth))
          (if (<= (get total :nodes) (get bounds :maximum-carrier-nodes))
            (if (<= (get total :scalar-units) (get bounds :maximum-scalar-units)) {:status :accepted :usage total}
              (sh08-im-failure "C7-VERIFY" :module-type-total-scalar-work-limit total))
            (sh08-im-failure "C7-VERIFY" :module-type-total-core-work-limit total))
          (sh08-im-failure "C7-VERIFY" :module-type-dependency-depth-limit total))
        (sh08-im-failure "C7-VERIFY" :module-type-distinct-producer-limit total))
      (sh08-im-failure "C7-VERIFY" :module-type-producer-core-bound usage))))

(defn sh08-im-derive [request memo active]
  (let [id (sh08-im-path request [:b47-context :artifact-id]) previous (get memo id)
        preliminary (sh08-im-work-check memo active {:status :accepted :nodes 0 :scalar-units 0})
        resolution (if (if (map? previous) true (if (contains? active id) true (= :rejected (get preliminary :status))))
                     {} (sh08-ft-authenticated-core request))
        inputs (get request :module-type-inputs {:artifact :gravity/sh08-module-type-inputs :schema-version 1 :module-requests []})]
    (if (map? previous)
      (if (= request (get previous :request)) {:result (get previous :result) :memo memo}
        {:result (sh08-im-rejected-result request (sh08-im-failure "C7-VERIFY" :substituted-module-type-request id)) :memo memo})
      (if (contains? active id)
        {:result (sh08-im-rejected-result request (sh08-im-failure "C7-VERIFY" :cyclic-module-type-request id)) :memo memo}
      (if (= :rejected (get preliminary :status))
        {:result (sh08-im-rejected-result request preliminary) :memo memo}
      (if (= :accepted (get resolution :status))
        (let [usage (sh08-carrier-preflight (get resolution :core))
              work (sh08-im-work-check memo active usage)
              input-check (if (= :accepted (get work :status)) (sh08-im-inputs-check inputs) work)
              producers (if (= :accepted (get input-check :status))
                          (sh08-im-producers (get inputs :module-requests) memo (assoc active id usage)
                            (sh08-im-path request [:b47-context :authenticated-wrapper :sh06-resolution-artifact
                                                  :gravity-resolution-boundary :module-inputs :module-artifacts])) input-check)
              imports (if (= :accepted (get producers :status))
                        (sh08-im-imports request resolution (get producers :producers)) producers)
              result (if (= :accepted (get imports :status))
                       (sh08-im-result
                         (sh08-ft-function-type-core-artifact-with-imports
                           (get resolution :core) (get resolution :binding-table)
                           (sh08-im-path request [:b47-context :authenticated-core-request :forms]) (get imports :imports))
                         (get imports :imports))
                       (sh08-im-rejected-result request imports))
              next (get producers :memo memo)]
          {:result result :memo (assoc next id {:request request :result result :usage usage})})
        {:result (sh08-im-rejected-result request (sh08-im-failure "C7-VERIFY" (get resolution :reason) (get resolution :reason))) :memo memo}))))))

(defn sh08-function-type-core-artifact [request]
  (let [result (get (sh08-im-derive request {} {}) :result)]
    (if (if (= :accepted (get result :status)) (= :direct-imported-functions-types-only (get result :scope)) false)
      (if (= :accepted (get (sh08-carrier-preflight result) :status)) result
        (sh08-im-rejected-result request (sh08-im-failure "C7-VERIFY" :imported-type-result-carrier-limit nil))) result)))

(defn sh08-ft-local-verification-checks [expected]
  (if (= :bounded-named-self-recursive-positive-fixed-arity-positional-literal-base
         (get expected :scope))
    [:coherent-b47-function-records
     :coherent-b47-call-edges
     :coherent-b47-recursion-components
     :coherent-b47-lexical-bindings
     :named-self-recursive-positive-fixed-arity-positional-literal-base-proof
     :concrete-recursive-base-and-parameter-evidence
     :monotone-bounded-recursive-fixed-point
     :recursive-call-facts
     :recursive-constraint-ledger
     :canonical-complete-function-signatures
     :source-syntax-origin-generated-origin-links-preserved
     :path-neutral-identity-input]
    (if (= :capture-free-higher-order-fixed-arity-one-hop
           (get expected :scope))
    [:coherent-b47-function-records
     :coherent-b47-call-edges
     :coherent-b47-recursion-components
     :coherent-b47-lexical-bindings
     :fixed-arity-first-order-inference
     :capture-free-higher-order-one-hop-inference
     :canonical-complete-function-signatures
     :higher-order-proof
     :higher-order-inner-and-outer-call-facts
     :local-binding-facts
     :call-type-facts
     :constraint-ledger
     :source-syntax-origin-generated-origin-links-preserved
     :path-neutral-identity-input
     :recursive-inference-rejected-without-annotation]
    [:coherent-b47-function-records
     :coherent-b47-call-edges
     :coherent-b47-recursion-components
     :coherent-b47-lexical-bindings
     :fixed-arity-first-order-inference
     :local-binding-facts
     :call-type-facts
     :constraint-ledger
     :source-syntax-origin-generated-origin-links-preserved
     :path-neutral-identity-input
     :recursive-inference-rejected-without-annotation])))

(defn sh08-ft-verification-checks [expected]
  (if (= :direct-imported-functions-types-only (get expected :scope))
    [:fresh-authenticated-module-type-producers :exact-original-upstream-projected-definition-function-join
     :complete-immutable-imported-signatures :imported-operator-and-call-types :local-inference-remains-separate
     :origin-and-signature-bound-constraint-ledger :producer-declarations-preserved-with-pending-imported-effects
     :canonical-producer-and-import-order :source-syntax-origin-links-preserved :path-neutral-identity-input]
    (sh08-ft-local-verification-checks expected)))

(defn sh08-verify-function-type-result [request candidate]
  (let [expected (sh08-function-type-core-artifact request)]
    {:artifact :gravity/sh08-function-type-verification
     :status (if (= expected candidate) :passed :rejected)
     :checks (sh08-ft-verification-checks expected)
     :expected expected
     :candidate candidate}))

; SH-08 records/unions is an early leaf over the authenticated B47 checked-core
; interface.  A named source definition carries a closed descriptor family as
; ordinary Gravity data.  The checker selects that definition from the
; authenticated core and validates bounded descriptor consistency.  It emits
; no typed-core, constructor, access, match, narrowing, or constraint facts.
; Surface defrecord/defunion and pattern lowering remain blocked on SH-07.

(defn sh08-ru-value-type [value]
  (if (= value nil)
    :gravity.type/nil
    (if (contains? #{true false} value)
      :gravity.type/bool
      (if (integer? value)
        :gravity.type/integer
        (if (string? value)
          :gravity.type/string
          (if (keyword? value)
            :gravity.type/keyword
            :gravity.type/unknown))))))

(defn sh08-ru-supported-type? [value]
  (contains? #{:gravity.type/nil
               :gravity.type/bool
               :gravity.type/integer
               :gravity.type/string
               :gravity.type/keyword}
             value))

(defn sh08-ru-entry-by [entries key-name value]
  (if (= (count entries) 0)
    nil
    (if (= value (get (first entries) key-name))
      (first entries)
      (sh08-ru-entry-by (rest entries) key-name value))))

(defn sh08-ru-all-record-shapes? [entries expected]
  (if (vector? entries)
    (if (<= (count entries) 64)
      (loop [remaining entries]
        (if (= (count remaining) 0)
          true
          (if (sh08-ft-record-shape? (first remaining) expected)
            (recur (rest remaining))
            false)))
      false)
    false))

(defn sh08-ru-all-field-schemas-valid? [fields]
  (if (sh08-ru-all-record-shapes? fields #{:name :type})
    (if (sh08-ft-unique-records? fields :name)
      (loop [remaining fields]
        (if (= (count remaining) 0)
          true
          (let [field (first remaining)]
            (if (keyword? (get field :name))
              (if (sh08-ru-supported-type? (get field :type))
                (recur (rest remaining))
                false)
              false))))
      false)
    false))

(defn sh08-ru-all-field-values-valid? [fields]
  (if (sh08-ru-all-record-shapes? fields #{:name :value})
    (if (sh08-ft-unique-records? fields :name)
      (loop [remaining fields]
        (if (= (count remaining) 0)
          true
          (if (keyword? (get (first remaining) :name))
            (recur (rest remaining))
            false)))
      false)
    false))

(defn sh08-ru-all-variant-schemas-valid? [variants]
  (if (sh08-ru-all-record-shapes? variants #{:tag :payload-type})
    (if (sh08-ft-unique-records? variants :tag)
      (loop [remaining variants]
        (if (= (count remaining) 0)
          true
          (let [variant (first remaining)]
            (if (keyword? (get variant :tag))
              (if (sh08-ru-supported-type?
                   (get variant :payload-type))
                (recur (rest remaining))
                false)
              false))))
      false)
    false))

(defn sh08-ru-all-match-branches-valid? [branches]
  (if (sh08-ru-all-record-shapes? branches #{:variant :result})
    (if (sh08-ft-unique-records? branches :variant)
      (loop [remaining branches]
        (if (= (count remaining) 0)
          true
          (if (keyword? (get (first remaining) :variant))
            (recur (rest remaining))
            false)))
      false)
    false))

(defn sh08-ru-family-shape? [family]
  (if (sh08-ft-record-shape?
       family
       #{:record-type :record-construction :record-access
         :union-type :union-construction :union-match})
    (let [record-type (get family :record-type)
          record-construction (get family :record-construction)
          record-access (get family :record-access)
          union-type (get family :union-type)
          union-construction (get family :union-construction)
          union-match (get family :union-match)]
      (if (sh08-ft-record-shape? record-type #{:name :fields})
        (if (keyword? (get record-type :name))
          (if (sh08-ru-all-field-schemas-valid?
               (get record-type :fields))
            (if (sh08-ft-record-shape?
                 record-construction #{:type :fields})
              (if (keyword? (get record-construction :type))
                (if (sh08-ru-all-field-values-valid?
                     (get record-construction :fields))
                  (if (sh08-ft-record-shape?
                       record-access #{:record-type :field})
                    (if (keyword? (get record-access :record-type))
                      (if (keyword? (get record-access :field))
                        (if (sh08-ft-record-shape?
                             union-type #{:name :variants})
                          (if (keyword? (get union-type :name))
                            (if (sh08-ru-all-variant-schemas-valid?
                                 (get union-type :variants))
                              (if (sh08-ft-record-shape?
                                   union-construction
                                   #{:type :variant :payload})
                                (if (keyword?
                                     (get union-construction :type))
                                  (if (keyword?
                                       (get union-construction :variant))
                                    (if (sh08-ft-record-shape?
                                         union-match
                                         #{:union-type :branches})
                                      (if (keyword?
                                           (get union-match :union-type))
                                        (sh08-ru-all-match-branches-valid?
                                         (get union-match :branches))
                                        false)
                                      false)
                                    false)
                                  false)
                                false)
                              false)
                            false)
                          false)
                        false)
                      false)
                    false)
                  false)
                false)
              false)
            false)
          false)
        false))
    false))

(defn sh08-ru-definition-matches [definitions definition-name]
  (loop [remaining definitions values []]
    (if (= (count remaining) 0)
      values
      (if (= definition-name (get (first remaining) :name))
        (recur (rest remaining) (conj values (first remaining)))
        (recur (rest remaining) values)))))

(defn sh08-ru-family-from-core [core definition-name]
  (if (symbol? definition-name)
    (let [matches
          (sh08-ru-definition-matches
           (get core :definitions) definition-name)]
      (if (= 1 (count matches))
        (let [definition (first matches)
              node-table (sh08-ft-node-index (get core :nodes))
              value-node
              (get node-table (get definition :value-node-id))
              source-value (get (get value-node :attributes) :source-value)]
          (if (= :collection-literal (get value-node :core-form))
            (if (= :map (get (get value-node :attributes) :literal-kind))
              (if (map? source-value)
                {:status :accepted
                 :definition definition
                 :node value-node
                 :family source-value}
                {:status :rejected :reason :family-source-map-required
                 :node value-node})
              {:status :rejected :reason :family-map-literal-required
               :node value-node})
            {:status :rejected :reason :family-map-literal-required
             :node value-node}))
        {:status :rejected
         :reason :family-definition-must-exist-exactly-once
         :node {}}))
    {:status :rejected :reason :family-definition-symbol-required :node {}}))

(defn sh08-ru-first-missing-field [schema-fields value-fields]
  (if (= (count schema-fields) 0)
    nil
    (let [schema (first schema-fields)
          value (sh08-ru-entry-by value-fields :name (get schema :name))]
      (if (= value nil)
        schema
        (sh08-ru-first-missing-field (rest schema-fields) value-fields)))))

(defn sh08-ru-first-field-type-mismatch [schema-fields value-fields]
  (if (= (count schema-fields) 0)
    nil
    (let [schema (first schema-fields)
          value (sh08-ru-entry-by value-fields :name (get schema :name))
          actual (sh08-ru-value-type (get value :value))]
      (if (= (get schema :type) actual)
        (sh08-ru-first-field-type-mismatch
         (rest schema-fields) value-fields)
        {:field (get schema :name)
         :expected (get schema :type)
         :actual actual}))))

(defn sh08-ru-first-missing-variant [variants branches]
  (if (= (count variants) 0)
    nil
    (let [variant (first variants)]
      (if (= nil
             (sh08-ru-entry-by branches :variant (get variant :tag)))
        variant
        (sh08-ru-first-missing-variant (rest variants) branches)))))

(defn sh08-ru-first-invalid-branch [variants branches]
  (if (= (count branches) 0)
    nil
    (let [branch (first branches)]
      (if (= nil
             (sh08-ru-entry-by variants :tag (get branch :variant)))
        branch
        (sh08-ru-first-invalid-branch variants (rest branches))))))

(defn sh08-ru-first-branch-type-mismatch [branches expected]
  (if (= expected :gravity.type/unknown)
    {:variant (get (first branches) :variant)
     :expected :supported-descriptor-value
     :actual expected}
    (if (= (count branches) 0)
      nil
      (let [branch (first branches)
            actual (sh08-ru-value-type (get branch :result))]
        (if (= actual expected)
          (sh08-ru-first-branch-type-mismatch (rest branches) expected)
          {:variant (get branch :variant)
           :expected expected
           :actual actual})))))

(defn sh08-ru-diagnostic
  [node module core-artifact-id definition-name expected actual reason]
  (let [identity
        {:domain :gravity/sh08-record-union-descriptor-diagnostic-v1
         :rule "C7-VERIFY"
         :stage :type-checking
         :core-artifact-id core-artifact-id
         :definition-name definition-name
         :core-node-id (get node :node-id)
         :syntax-id (get (get node :source) :syntax-id)
         :source-span (get (get node :source) :semantic-span)
         :expected expected
         :actual actual
         :profile (get module :profile)
         :target (get module :target)
         :reason reason}]
    {:artifact :gravity/c7-record-union-descriptor-diagnostic
     :diagnostic-id :coordinator-digest-required
     :diagnostic-id-request identity
     :rule "C7-VERIFY"
     :severity :error
     :stage :type-checking
     :core-artifact-id core-artifact-id
     :definition-name definition-name
     :core-node-id (get node :node-id)
     :syntax-id (get (get node :source) :syntax-id)
     :source-span (get (get node :source) :semantic-span)
     :binding-id (first (get node :resolved-binding-ids))
     :type-id nil
     :constraint-id nil
     :expected-type expected
     :actual-type actual
     :profile (get module :profile)
     :target (get module :target)
     :origin-chain (get (get node :source) :origin-chain)
     :generated-origin (get (get node :source) :generated-origin)
     :reason reason
     :remediation
     {:action :repair-authenticated-record-union-descriptor
      :requirements
      [:closed-record-fields
       :supported-descriptor-value-types
       :declared-union-variants
       :complete-descriptor-branch-set]}}))

(defn sh08-ru-name-values [records key-name]
  (loop [remaining records values []]
    (if (= (count remaining) 0)
      values
      (recur
       (rest remaining)
       (conj values (get (first remaining) key-name))))))

(defn sh08-ru-check-match [union-name variants union-match]
  (let [branches (get union-match :branches)
        invalid-branch
        (sh08-ru-first-invalid-branch variants branches)
        missing-variant
        (sh08-ru-first-missing-variant variants branches)]
    (if (= union-name (get union-match :union-type))
      (if (= invalid-branch nil)
        (if (= missing-variant nil)
          (if (= (count variants) (count branches))
            (let [result-type
                  (sh08-ru-value-type (get (first branches) :result))
                  branch-mismatch
                  (sh08-ru-first-branch-type-mismatch
                   branches result-type)]
              (if (= branch-mismatch nil)
                {:status :accepted}
                {:status :rejected
                 :reason :union-match-branch-type-mismatch
                 :expected (get branch-mismatch :expected)
                 :actual (get branch-mismatch :actual)}))
            {:status :rejected
             :reason :union-match-nonexhaustive
             :expected (count variants)
             :actual (count branches)})
          {:status :rejected
           :reason :union-match-nonexhaustive
           :expected (get missing-variant :tag)
           :actual (sh08-ru-name-values branches :variant)})
        {:status :rejected
         :reason :union-match-invalid-variant
         :expected :declared-union-variant
         :actual (get invalid-branch :variant)})
      {:status :rejected
       :reason :union-match-type-mismatch
       :expected union-name
       :actual (get union-match :union-type)})))

(defn sh08-ru-check-union [family]
  (let [union-type (get family :union-type)
        union-construction (get family :union-construction)
        variants (get union-type :variants)
        variant
        (sh08-ru-entry-by
         variants :tag (get union-construction :variant))]
    (if (= (get union-type :name) (get union-construction :type))
      (if (= variant nil)
        {:status :rejected
         :reason :union-invalid-variant
         :expected (sh08-ru-name-values variants :tag)
         :actual (get union-construction :variant)}
        (let [payload-type
              (sh08-ru-value-type (get union-construction :payload))]
          (if (= payload-type (get variant :payload-type))
            (sh08-ru-check-match
             (get union-type :name) variants (get family :union-match))
            {:status :rejected
             :reason :union-payload-type-mismatch
             :expected (get variant :payload-type)
             :actual payload-type})))
      {:status :rejected
       :reason :union-construction-type-mismatch
       :expected (get union-type :name)
       :actual (get union-construction :type)})))

(defn sh08-ru-check-record [family]
  (let [record-type (get family :record-type)
        record-construction (get family :record-construction)
        record-access (get family :record-access)
        schema-fields (get record-type :fields)
        value-fields (get record-construction :fields)
        missing-field
        (sh08-ru-first-missing-field schema-fields value-fields)]
    (if (= (get record-type :name) (get record-construction :type))
      (if (= missing-field nil)
        (if (= (count schema-fields) (count value-fields))
          (let [field-mismatch
                (sh08-ru-first-field-type-mismatch
                 schema-fields value-fields)]
            (if (= field-mismatch nil)
              (if (= (get record-type :name)
                     (get record-access :record-type))
                (if (= nil
                       (sh08-ru-entry-by
                        schema-fields :name (get record-access :field)))
                  {:status :rejected
                   :reason :record-access-invalid-field
                   :expected (sh08-ru-name-values schema-fields :name)
                   :actual (get record-access :field)}
                  (sh08-ru-check-union family))
                {:status :rejected
                 :reason :record-access-type-mismatch
                 :expected (get record-type :name)
                 :actual (get record-access :record-type)})
              {:status :rejected
               :reason :record-field-type-mismatch
               :expected (get field-mismatch :expected)
               :actual (get field-mismatch :actual)}))
          {:status :rejected
           :reason :record-field-set-mismatch
           :expected (count schema-fields)
           :actual (count value-fields)})
        {:status :rejected
         :reason :record-missing-field
         :expected (get missing-field :name)
         :actual (sh08-ru-name-values value-fields :name)})
      {:status :rejected
       :reason :record-construction-type-mismatch
       :expected (get record-type :name)
       :actual (get record-construction :type)})))

(defn sh08-ru-check-family [family]
  (if (sh08-ru-family-shape? family)
    (sh08-ru-check-record family)
    {:status :rejected
     :reason :malformed-record-union-family
     :expected :closed-record-union-family
     :actual family}))

(defn sh08-ru-accepted-result
  [core definition-name family-source]
  (let [module (get core :module)
        node (get family-source :node)
        identity-input
        {:domain :gravity/sh08-record-union-descriptor-model-v1
         :sh07-shaped-artifact-id (get core :artifact-id)
         :definition-name definition-name
         :descriptor (get family-source :family)}]
    {:artifact :gravity/sh08-record-union-preparatory-model
     :schema-version 1
     :status :accepted
     :scope :authenticated-closed-record-union-descriptor-model
     :preparatory-source-model? true
     :roadmap-credit? false
     :executable-record-union-language-behavior? false
     :nominal-sh07-carrier? false
     :authentication-status :host-resolved-b47-verification-boundary
     :module module
     :sh07-shaped-artifact-id (get core :artifact-id)
     :family-definition-name definition-name
     :descriptor-core-node-id (get node :node-id)
     :descriptor (get family-source :family)
     :descriptor-consistency-checks
     [:record-field-set-and-value-model
      :record-access-model
      :union-variant-and-payload-model
      :closed-branch-set-and-result-model]
     :diagnostics []
     :artifact-id-request identity-input
     :identity-input identity-input
     :identity-resolution :coordinator-digest-required
     :provenance (get core :provenance)
     :pending [:general-record-and-union-surface-syntax
               :constructor-pattern-lowering
               :open-records-and-unions
               :general-match-guard-effects
               :ownership-layout-schema-links
               :native-gravity-cryptographic-verification
               :record-construction-typing
               :record-access-typing
               :union-construction-typing
               :union-match-typing-and-narrowing
               :uniform-gravity-and-qst-execution-gates
               :sh07-completion :sh08-completion]}))

(defn sh08-record-union-type-boundary-policy []
  {:verification-boundary
   :host-validated-b47-report-and-opaque-provenance-digest
   :verification-preimage-domain
   :gravity/sh08-b47-verification-binding-v1
   :descriptor-source
   :named-map-definition-in-authenticated-checked-core
   :closed-family-only? true
   :preparatory-source-model? true
   :roadmap-credit? false
   :executable-record-union-language-behavior? false
   :nominal-sh07-carrier? false
   :independent-gravity-cryptographic-verification? false
   :host-digest-authority-retained? true
   :native-gravity-cryptographic-verification :pending})

(defn sh08-record-union-type-core-artifact [request definition-name]
  (let [resolution (sh08-ft-authenticated-core request)]
    (if (= :accepted (get resolution :status))
      (let [core (get resolution :core)
            module (get core :module)
            family-source
            (sh08-ru-family-from-core core definition-name)]
        (if (= :accepted (get family-source :status))
          (let [checked
                (sh08-ru-check-family (get family-source :family))]
            (if (= :accepted (get checked :status))
              (sh08-ru-accepted-result
               core definition-name family-source)
              {:artifact :gravity/sh08-record-union-preparatory-model
               :schema-version 1
               :status :rejected
               :scope :authenticated-closed-record-union-descriptor-model
               :preparatory-source-model? true
               :roadmap-credit? false
               :executable-record-union-language-behavior? false
               :nominal-sh07-carrier? false
               :authentication-status
               :host-resolved-b47-verification-boundary
               :module module
               :sh07-shaped-artifact-id (get core :artifact-id)
               :family-definition-name definition-name
               :diagnostics
               [(sh08-ru-diagnostic
                 (get family-source :node) module
                 (get core :artifact-id) definition-name
                 (get checked :expected)
                 (get checked :actual)
                 (get checked :reason))]
               :pending [:general-record-and-union-surface-syntax
                         :constructor-pattern-lowering
                         :record-construction-typing
                         :record-access-typing
                         :union-construction-typing
                         :union-match-typing-and-narrowing
                         :uniform-gravity-and-qst-execution-gates
                         :sh07-completion :sh08-completion]}))
          {:artifact :gravity/sh08-record-union-preparatory-model
           :schema-version 1
           :status :rejected
           :scope :authenticated-closed-record-union-descriptor-model
           :preparatory-source-model? true
           :roadmap-credit? false
           :executable-record-union-language-behavior? false
           :nominal-sh07-carrier? false
           :authentication-status :host-resolved-b47-verification-boundary
           :module module
           :sh07-shaped-artifact-id (get core :artifact-id)
           :family-definition-name definition-name
           :diagnostics
           [(sh08-ru-diagnostic
             (get family-source :node) module
             (get core :artifact-id) definition-name
             :named-record-union-family definition-name
             (get family-source :reason))]
           :pending [:general-record-and-union-surface-syntax
                     :constructor-pattern-lowering
                     :record-construction-typing
                     :record-access-typing
                     :union-construction-typing
                     :union-match-typing-and-narrowing
                     :uniform-gravity-and-qst-execution-gates
                     :sh07-completion :sh08-completion]}))
      {:artifact :gravity/sh08-record-union-preparatory-model
       :schema-version 1
       :status :rejected
       :scope :authenticated-closed-record-union-descriptor-model
       :preparatory-source-model? true
       :roadmap-credit? false
       :executable-record-union-language-behavior? false
       :nominal-sh07-carrier? false
       :authentication-status :host-resolved-b47-verification-required
       :module {}
       :family-definition-name definition-name
       :diagnostics
       [(sh08-ru-diagnostic
         {} {} nil definition-name
         :host-resolved-authentic-b47-context
         (get resolution :reason)
         (get resolution :reason))]
       :pending [:native-gravity-cryptographic-verification
                 :record-construction-typing
                 :record-access-typing
                 :union-construction-typing
                 :union-match-typing-and-narrowing
                 :uniform-gravity-and-qst-execution-gates
                 :sh07-completion :sh08-completion]})))

(defn sh08-verify-record-union-type-result
  [request definition-name candidate]
  (let [expected
        (sh08-record-union-type-core-artifact request definition-name)]
    {:artifact :gravity/sh08-record-union-descriptor-model-verification
     :status (if (= expected candidate) :passed :rejected)
     :checks [:authenticated-b47-core-boundary
              :named-family-source-bound
              :closed-descriptor-schema-bounded
              :descriptor-consistency-result-recomputed
              :supported-descriptor-value-types-only
              :path-neutral-descriptor-identity-input
              :preparatory-no-credit-boundary]
     :expected expected
     :candidate candidate}))

; SH-08 record/access/match typing v1 consumes the integrated closed
; descriptor without changing that descriptor invariant.  Each construction,
; access, scrutinee, match, and branch is a separate named map definition in
; the authenticated B47 core.  Narrowed payload types are derived from the
; descriptor and checked against pattern annotations; callers do not supply
; emitted type facts.  This remains a bounded typed-core leaf, not lowering,
; general pattern compilation, ownership, safety, layout, or runtime behavior.

(defn sh08-ram-node-link [definition-name source]
  (let [node (get source :node)
        source-record (get node :source)]
    {:definition definition-name
     :core-node-id (get node :node-id)
     :syntax-id (get source-record :syntax-id)
     :source-span (get source-record :semantic-span)
     :origin-chain (get source-record :origin-chain)
     :generated-origin (get source-record :generated-origin)
     :binding-id (get (get source :definition) :binding-id)}))

(defn sh08-ram-suffix-match? [value suffix index]
  (if (= index (count suffix))
    true
    (if (> (count suffix) (count value))
      false
      (if (= (get value (- (count value) (+ index 1)))
             (get suffix (- (count suffix) (+ index 1))))
        (sh08-ram-suffix-match? value suffix (+ index 1))
        false))))

(defn sh08-ram-path-extension-valid? [source-path source-extension]
  (if (string? source-path)
    (if (contains? #{".gravity" ".qst"} source-extension)
      (sh08-ram-suffix-match? source-path source-extension 0)
      false)
    false))

(defn sh08-ram-best-evidence [request resolution]
  (let [context (get request :b47-context)
        wrapper (get context :authenticated-wrapper)
        boundary (get wrapper :gravity-core-boundary)
        wrapper-core (get boundary :canonical-core-artifact)
        context-core (get context :canonical-core-artifact)
        coordinator (get request :coordinator-verification)]
    (if (= :accepted (get resolution :status))
      (let [core (get resolution :core)
            provenance (get context :provenance)]
        {:core core
         :provenance provenance
         :actual-source-path (get provenance :source-path)
         :source-extension (get coordinator :verified-source-extension)
         :provenance-status :authenticated-b47-core-provenance})
      (if (map? wrapper-core)
        (let [provenance (get wrapper :provenance)]
          {:core wrapper-core
           :provenance provenance
           :actual-source-path (get provenance :source-path)
           :source-extension (get coordinator :verified-source-extension)
           :provenance-status :retained-b47-wrapper-provenance})
        (if (map? context-core)
          (let [provenance (get context :provenance)]
            {:core context-core
             :provenance provenance
             :actual-source-path (get provenance :source-path)
             :source-extension (get coordinator :verified-source-extension)
             :provenance-status :retained-b47-context-provenance})
          {:core {}
           :provenance {}
           :actual-source-path nil
           :source-extension nil
           :provenance-status :no-authenticated-provenance-available})))))

(defn sh08-ram-symbol-vector? [values]
  (if (vector? values)
    (if (> (count values) 0)
      (if (<= (count values) 64)
        (loop [remaining values seen #{}]
          (if (= 0 (count remaining))
            true
            (let [value (first remaining)]
              (if (symbol? value)
                (if (contains? seen value)
                  false
                  (recur (rest remaining) (conj seen value)))
                false))))
        false)
      false)
    false))

(defn sh08-ram-program-shape? [program]
  (if (sh08-ft-record-shape?
       program
       #{:record-construction-definition :record-access-definition
         :union-construction-definition :union-match-definition})
    (if (symbol? (get program :record-construction-definition))
      (if (symbol? (get program :record-access-definition))
        (if (symbol? (get program :union-construction-definition))
          (symbol? (get program :union-match-definition))
          false)
        false)
      false)
    false))

(defn sh08-ram-record-construction-shape? [construction]
  (if (sh08-ft-record-shape? construction #{:type :fields})
    (if (keyword? (get construction :type))
      (sh08-ru-all-field-values-valid? (get construction :fields))
      false)
    false))

(defn sh08-ram-record-access-shape? [access]
  (if (sh08-ft-record-shape? access #{:record-definition :field})
    (if (symbol? (get access :record-definition))
      (keyword? (get access :field))
      false)
    false))

(defn sh08-ram-union-construction-shape? [construction]
  (if (sh08-ft-record-shape?
       construction #{:type :variant :payload})
    (if (keyword? (get construction :type))
      (if (keyword? (get construction :variant))
        (if (= :gravity.type/unknown
               (sh08-ru-value-type (get construction :payload)))
          false
          true)
        false)
      false)
    false))

(defn sh08-ram-match-shape? [match-source]
  (if (sh08-ft-record-shape?
       match-source
       #{:union-type :scrutinee-definition :branch-definitions})
    (if (keyword? (get match-source :union-type))
      (if (symbol? (get match-source :scrutinee-definition))
        (sh08-ram-symbol-vector?
         (get match-source :branch-definitions))
        false)
      false)
    false))

(defn sh08-ram-branch-shape? [branch]
  (if (sh08-ft-record-shape?
       branch
       #{:variant :binding :pattern-payload-type :result})
    (if (keyword? (get branch :variant))
      (if (keyword? (get branch :binding))
        (if (sh08-ru-supported-type?
             (get branch :pattern-payload-type))
          (if (= :gravity.type/unknown
                 (sh08-ru-value-type (get branch :result)))
            false
            true)
          false)
        false)
      false)
    false))

(defn sh08-ram-resolve-branches [core names]
  (loop [remaining names sources []]
    (if (= 0 (count remaining))
      {:status :accepted :sources sources}
      (let [name (first remaining)
            source (sh08-ru-family-from-core core name)]
        (if (= :accepted (get source :status))
          (recur (rest remaining) (conj sources source))
          {:status :rejected
           :rule "C7-VERIFY"
           :reason :match-branch-definition-required
           :expected :named-map-definition
           :actual name
           :node (get source :node)})))))

(defn sh08-ram-program-error [program-source reason expected actual node]
  {:status :rejected
   :rule "C7-VERIFY"
   :reason reason
   :expected expected
   :actual actual
   :node (if (= node nil) (get program-source :node) node)})

(defn sh08-ram-resolve-program [core input-definition]
  (let [program-source
        (sh08-ru-family-from-core core input-definition)]
    (if (= :accepted (get program-source :status))
      (let [program (get program-source :family)]
        (if (sh08-ram-program-shape? program)
          (let [record-name
                (get program :record-construction-definition)
                access-name (get program :record-access-definition)
                union-name (get program :union-construction-definition)
                match-name (get program :union-match-definition)
                record-source (sh08-ru-family-from-core core record-name)
                access-source (sh08-ru-family-from-core core access-name)
                union-source (sh08-ru-family-from-core core union-name)
                match-source (sh08-ru-family-from-core core match-name)]
            (if (= :accepted (get record-source :status))
              (if (= :accepted (get access-source :status))
                (if (= :accepted (get union-source :status))
                  (if (= :accepted (get match-source :status))
                    (if (sh08-ram-match-shape?
                         (get match-source :family))
                      (let [branches
                            (sh08-ram-resolve-branches
                             core
                             (get (get match-source :family)
                                  :branch-definitions))]
                        (if (= :accepted (get branches :status))
                          {:status :accepted
                           :program-source program-source
                           :program program
                           :record-source record-source
                           :record-name record-name
                           :access-source access-source
                           :access-name access-name
                           :union-source union-source
                           :union-name union-name
                           :match-source match-source
                           :match-name match-name
                           :branch-sources (get branches :sources)}
                          branches))
                      (sh08-ram-program-error
                       program-source :union-match-shape-invalid
                       :closed-node-linked-union-match
                       (get match-source :family)
                       (get match-source :node)))
                    (sh08-ram-program-error
                     program-source :union-match-definition-required
                     :named-map-definition match-name
                     (get match-source :node)))
                  (sh08-ram-program-error
                   program-source :union-construction-definition-required
                   :named-map-definition union-name
                   (get union-source :node)))
                (sh08-ram-program-error
                 program-source :record-access-definition-required
                 :named-map-definition access-name
                 (get access-source :node)))
              (sh08-ram-program-error
               program-source :record-construction-definition-required
               :named-map-definition record-name
               (get record-source :node))))
          (sh08-ram-program-error
           program-source :typing-program-shape-invalid
           :closed-node-linked-typing-program program
           (get program-source :node))))
      {:status :rejected
       :rule "C7-VERIFY"
       :reason :authenticated-typing-program-required
       :expected :named-map-definition
       :actual (get program-source :reason)
       :node (get program-source :node)})))

(defn sh08-ram-first-extra-field [schema-fields value-fields]
  (if (= 0 (count value-fields))
    nil
    (let [value-field (first value-fields)]
      (if (= nil
             (sh08-ru-entry-by
              schema-fields :name (get value-field :name)))
        value-field
        (sh08-ram-first-extra-field
         schema-fields (rest value-fields))))))

(defn sh08-ram-first-invalid-branch-source [branch-sources]
  (if (= 0 (count branch-sources))
    nil
    (let [source (first branch-sources)]
      (if (sh08-ram-branch-shape? (get source :family))
        (sh08-ram-first-invalid-branch-source (rest branch-sources))
        source))))

(defn sh08-ram-first-duplicate-branch [branch-sources seen]
  (if (= 0 (count branch-sources))
    nil
    (let [source (first branch-sources)
          variant (get (get source :family) :variant)]
      (if (contains? seen variant)
        source
        (sh08-ram-first-duplicate-branch
         (rest branch-sources) (conj seen variant))))))

(defn sh08-ram-branch-values [branch-sources]
  (loop [remaining branch-sources values []]
    (if (= 0 (count remaining))
      values
      (recur
       (rest remaining)
       (conj values (get (first remaining) :family))))))

(defn sh08-ram-check-record [descriptor sources]
  (let [record-type (get descriptor :record-type)
        construction-source (get sources :record-source)
        construction (get construction-source :family)
        access-source (get sources :access-source)
        access (get access-source :family)
        program (get sources :program)
        schema-fields (get record-type :fields)]
    (if (sh08-ram-record-construction-shape? construction)
      (let [value-fields (get construction :fields)
            missing
            (sh08-ru-first-missing-field schema-fields value-fields)
            extra (sh08-ram-first-extra-field schema-fields value-fields)]
        (if (= (get record-type :name) (get construction :type))
          (if (= nil missing)
            (if (= nil extra)
              (let [mismatch
                    (sh08-ru-first-field-type-mismatch
                     schema-fields value-fields)]
                (if (= nil mismatch)
                  (if (sh08-ram-record-access-shape? access)
                    (if (= (get access :record-definition)
                           (get program :record-construction-definition))
                      (if (= nil
                             (sh08-ru-entry-by
                              schema-fields :name (get access :field)))
                        {:status :rejected
                         :rule "C7-TYPE-MISMATCH"
                         :reason :record-access-invalid-field
                         :expected
                         (sh08-ru-name-values schema-fields :name)
                         :actual (get access :field)
                         :node (get access-source :node)}
                        {:status :accepted})
                      {:status :rejected
                       :rule "C7-VERIFY"
                       :reason :record-access-definition-substitution
                       :expected
                       (get program :record-construction-definition)
                       :actual (get access :record-definition)
                       :node (get access-source :node)})
                    {:status :rejected
                     :rule "C7-VERIFY"
                     :reason :record-access-shape-invalid
                     :expected :node-linked-record-access
                     :actual access
                     :node (get access-source :node)})
                  {:status :rejected
                   :rule "C7-TYPE-MISMATCH"
                   :reason :record-field-type-mismatch
                   :expected (get mismatch :expected)
                   :actual (get mismatch :actual)
                   :node (get construction-source :node)}))
              {:status :rejected
               :rule "C7-TYPE-MISMATCH"
               :reason :record-extra-field
               :expected (sh08-ru-name-values schema-fields :name)
               :actual (get extra :name)
               :node (get construction-source :node)})
            {:status :rejected
             :rule "C7-TYPE-MISMATCH"
             :reason :record-missing-field
             :expected (get missing :name)
             :actual (sh08-ru-name-values value-fields :name)
             :node (get construction-source :node)})
          {:status :rejected
           :rule "C7-TYPE-MISMATCH"
           :reason :record-construction-type-mismatch
           :expected (get record-type :name)
           :actual (get construction :type)
           :node (get construction-source :node)}))
      {:status :rejected
       :rule "C7-VERIFY"
       :reason :record-construction-shape-invalid
       :expected :closed-record-construction
       :actual construction
       :node (get construction-source :node)})))

(defn sh08-ram-first-pattern-mismatch [variants branch-sources]
  (if (= 0 (count branch-sources))
    nil
    (let [source (first branch-sources)
          branch (get source :family)
          variant
          (sh08-ru-entry-by variants :tag (get branch :variant))]
      (if (= variant nil)
        (sh08-ram-first-pattern-mismatch
         variants (rest branch-sources))
        (if (= (get variant :payload-type)
               (get branch :pattern-payload-type))
          (sh08-ram-first-pattern-mismatch
           variants (rest branch-sources))
          {:source source
           :expected (get variant :payload-type)
           :actual (get branch :pattern-payload-type)})))))

(defn sh08-ram-check-union [descriptor sources]
  (let [union-type (get descriptor :union-type)
        construction-source (get sources :union-source)
        construction (get construction-source :family)
        match-source (get sources :match-source)
        match-value (get match-source :family)
        program (get sources :program)
        variants (get union-type :variants)
        branch-sources (get sources :branch-sources)]
    (if (sh08-ram-union-construction-shape? construction)
      (if (sh08-ram-match-shape? match-value)
        (if (= (get match-value :scrutinee-definition)
               (get program :union-construction-definition))
          (if (= (get union-type :name) (get construction :type))
            (let [variant
                  (sh08-ru-entry-by
                   variants :tag (get construction :variant))]
              (if (= variant nil)
                {:status :rejected
                 :rule "C7-TYPE-MISMATCH"
                 :reason :union-invalid-variant
                 :expected (sh08-ru-name-values variants :tag)
                 :actual (get construction :variant)
                 :node (get construction-source :node)}
                (if (= (get variant :payload-type)
                       (sh08-ru-value-type (get construction :payload)))
                  (if (= (get union-type :name)
                         (get match-value :union-type))
                    (let [invalid-shape
                          (sh08-ram-first-invalid-branch-source
                           branch-sources)]
                      (if (= nil invalid-shape)
                        (let [branches
                              (sh08-ram-branch-values branch-sources)
                              duplicate
                              (sh08-ram-first-duplicate-branch
                               branch-sources #{})
                              invalid
                              (sh08-ru-first-invalid-branch
                               variants branches)
                              missing
                              (sh08-ru-first-missing-variant
                               variants branches)]
                          (if (= nil duplicate)
                            (if (= nil invalid)
                              (if (= nil missing)
                                (if (= (count variants) (count branches))
                                  (let [pattern-mismatch
                                        (sh08-ram-first-pattern-mismatch
                                         variants branch-sources)
                                        result-type
                                        (sh08-ru-value-type
                                         (get (first branches) :result))
                                        result-mismatch
                                        (sh08-ru-first-branch-type-mismatch
                                         branches result-type)]
                                    (if (= nil pattern-mismatch)
                                      (if (= nil result-mismatch)
                                        {:status :accepted
                                         :match-expression-type result-type}
                                        {:status :rejected
                                         :rule "C7-TYPE-MISMATCH"
                                         :reason
                                         :union-match-branch-type-mismatch
                                         :expected
                                         (get result-mismatch :expected)
                                         :actual
                                         (get result-mismatch :actual)
                                         :node (get match-source :node)})
                                      {:status :rejected
                                       :rule "C7-TYPE-MISMATCH"
                                       :reason
                                       :union-match-contradictory-narrowing
                                       :expected
                                       (get pattern-mismatch :expected)
                                       :actual
                                       (get pattern-mismatch :actual)
                                       :node
                                       (get
                                        (get pattern-mismatch :source)
                                        :node)}))
                                  {:status :rejected
                                   :rule "C7-TYPE-MISMATCH"
                                   :reason :union-match-nonexhaustive
                                   :expected (count variants)
                                   :actual (count branches)
                                   :node (get match-source :node)})
                                {:status :rejected
                                 :rule "C7-TYPE-MISMATCH"
                                 :reason :union-match-nonexhaustive
                                 :expected (get missing :tag)
                                 :actual
                                 (sh08-ru-name-values branches :variant)
                                 :node (get match-source :node)})
                              {:status :rejected
                               :rule "C7-TYPE-MISMATCH"
                               :reason :union-match-invalid-variant
                               :expected :declared-union-variant
                               :actual (get invalid :variant)
                               :node (get match-source :node)})
                            {:status :rejected
                             :rule "C7-TYPE-MISMATCH"
                             :reason :union-match-unreachable-duplicate-variant
                             :expected :unique-closed-union-variants
                             :actual
                             (get (get duplicate :family) :variant)
                             :node (get duplicate :node)}))
                        {:status :rejected
                         :rule "C7-VERIFY"
                         :reason :union-match-branch-shape-invalid
                         :expected :node-linked-union-pattern-branch
                         :actual (get invalid-shape :family)
                         :node (get invalid-shape :node)}))
                    {:status :rejected
                     :rule "C7-TYPE-MISMATCH"
                     :reason :union-match-type-mismatch
                     :expected (get union-type :name)
                     :actual (get match-value :union-type)
                     :node (get match-source :node)})
                  {:status :rejected
                   :rule "C7-TYPE-MISMATCH"
                   :reason :union-payload-type-mismatch
                   :expected (get variant :payload-type)
                   :actual
                   (sh08-ru-value-type (get construction :payload))
                   :node (get construction-source :node)})))
            {:status :rejected
             :rule "C7-TYPE-MISMATCH"
             :reason :union-construction-type-mismatch
             :expected (get union-type :name)
             :actual (get construction :type)
             :node (get construction-source :node)})
          {:status :rejected
           :rule "C7-VERIFY"
           :reason :union-match-scrutinee-substitution
           :expected (get program :union-construction-definition)
           :actual (get match-value :scrutinee-definition)
           :node (get match-source :node)})
        {:status :rejected
         :rule "C7-VERIFY"
         :reason :union-match-shape-invalid
         :expected :closed-node-linked-union-match
         :actual match-value
         :node (get match-source :node)})
      {:status :rejected
       :rule "C7-VERIFY"
       :reason :union-construction-shape-invalid
       :expected :closed-union-construction
       :actual construction
       :node (get construction-source :node)})))

(defn sh08-ram-constraint [kind definition source expected actual]
  (let [node (get source :node)
        source-record (get node :source)
        request
        {:domain :gravity/sh08-record-access-match-constraint-v1
         :kind kind
         :definition definition
         :core-node-id (get node :node-id)
         :syntax-id (get source-record :syntax-id)
         :expected expected
         :actual actual}]
    {:constraint-id :coordinator-digest-required
     :constraint-id-request request
     :kind kind
     :definition definition
     :core-node-id (get node :node-id)
     :syntax-id (get source-record :syntax-id)
     :source-span (get source-record :semantic-span)
     :expected expected
     :actual actual
     :status :solved
     :solution :satisfied
     :invalidation [:core-node-change :descriptor-change :source-change]}))

(defn sh08-ram-record-facts [record-type definition source]
  (let [node (get source :node)
        source-record (get node :source)
        construction (get source :family)
        schema-fields (get record-type :fields)
        value-fields (get construction :fields)]
    (loop [remaining schema-fields facts []]
      (if (= 0 (count remaining))
        facts
        (let [schema (first remaining)
              value
              (sh08-ru-entry-by
               value-fields :name (get schema :name))]
          (recur
           (rest remaining)
           (conj facts
                 {:artifact :gravity/c7-record-field-type-fact
                  :definition definition
                  :core-node-id (get node :node-id)
                  :syntax-id (get source-record :syntax-id)
                  :source-span (get source-record :semantic-span)
                  :origin-chain (get source-record :origin-chain)
                  :generated-origin (get source-record :generated-origin)
                  :record-type (get record-type :name)
                  :field (get schema :name)
                  :declared-type (get schema :type)
                  :actual-type
                  (sh08-ru-value-type (get value :value))
                  :value (get value :value)})))))))

(defn sh08-ram-record-constraints [record-type definition source]
  (let [schema-fields (get record-type :fields)
        value-fields (get (get source :family) :fields)]
    (loop [remaining schema-fields constraints []]
      (if (= 0 (count remaining))
        constraints
        (let [schema (first remaining)
              value
              (sh08-ru-entry-by
               value-fields :name (get schema :name))]
          (recur
           (rest remaining)
           (conj constraints
                 (sh08-ram-constraint
                  :record-field-equality definition source
                  (get schema :type)
                  (sh08-ru-value-type (get value :value))))))))))

(defn sh08-ram-branch-facts [union-type sources selected-variant]
  (let [variants (get union-type :variants)]
    (loop [remaining (get sources :branch-sources) facts []]
      (if (= 0 (count remaining))
        facts
        (let [source (first remaining)
              node (get source :node)
              source-record (get node :source)
              branch (get source :family)
              variant
              (sh08-ru-entry-by variants :tag (get branch :variant))
              binding-request
              {:domain :gravity/sh08-pattern-binding-v1
               :branch-core-node-id (get node :node-id)
               :branch-syntax-id (get source-record :syntax-id)
               :binding-name (get branch :binding)
               :narrowed-type (get variant :payload-type)}]
          (recur
           (rest remaining)
           (conj facts
                 {:artifact :gravity/c7-union-match-narrowing-fact
                 :branch-definition
                  (get (get source :definition) :name)
                  :core-node-id (get node :node-id)
                  :syntax-id (get source-record :syntax-id)
                  :source-span (get source-record :semantic-span)
                  :branch-core-node-id (get node :node-id)
                  :branch-syntax-id (get source-record :syntax-id)
                  :branch-source-span (get source-record :semantic-span)
                  :origin-chain (get source-record :origin-chain)
                  :generated-origin (get source-record :generated-origin)
                  :union-type (get union-type :name)
                  :variant (get branch :variant)
                  :pattern-payload-type
                  (get branch :pattern-payload-type)
                  :narrowed-payload-type (get variant :payload-type)
                  :pattern-binding-environment
                  {:scope-core-node-id (get node :node-id)
                   :bindings
                   [{:name (get branch :binding)
                     :type (get variant :payload-type)
                     :binding-id :coordinator-digest-required
                     :binding-id-request binding-request}]}
                  :guard :absent
                  :guard-effects #{}
                  :branch-result-type
                  (sh08-ru-value-type (get branch :result))
                  :selected?
                  (= selected-variant (get branch :variant))})))))))

(defn sh08-ram-branch-constraints [union-type sources]
  (let [variants (get union-type :variants)]
    (loop [remaining (get sources :branch-sources) constraints []]
      (if (= 0 (count remaining))
        constraints
        (let [source (first remaining)
              branch (get source :family)
              variant
              (sh08-ru-entry-by variants :tag (get branch :variant))]
          (recur
           (rest remaining)
           (conj constraints
                 (sh08-ram-constraint
                  :union-pattern-narrowing
                  (get (get source :definition) :name)
                  source
                  (get variant :payload-type)
                  (get branch :pattern-payload-type)))))))))

(defn sh08-ram-append [left right]
  (loop [remaining right result left]
    (if (= 0 (count remaining))
      result
      (recur (rest remaining) (conj result (first remaining))))))

(defn sh08-ram-type-table [descriptor sources match-type]
  (let [record-node (get (get sources :record-source) :node)
        access-node (get (get sources :access-source) :node)
        union-node (get (get sources :union-source) :node)
        match-node (get (get sources :match-source) :node)
        record-type
        {:kind :closed-record
         :name (get (get descriptor :record-type) :name)}
        union-type
        {:kind :closed-union
         :name (get (get descriptor :union-type) :name)}]
    (loop [remaining (get sources :branch-sources)
           table
           {(get record-node :node-id) record-type
            (get access-node :node-id)
            (get
             (sh08-ru-entry-by
              (get (get descriptor :record-type) :fields)
              :name
              (get (get (get sources :access-source) :family) :field))
             :type)
            (get union-node :node-id) union-type
            (get match-node :node-id) match-type}]
      (if (= 0 (count remaining))
        table
        (let [source (first remaining)
              node (get source :node)
              branch (get source :family)]
          (recur
           (rest remaining)
           (assoc table
                  (get node :node-id)
                  (sh08-ru-value-type (get branch :result)))))))))

(defn sh08-ram-diagnostic
  [evidence node descriptor-definition input-definition
   rule expected actual reason]
  (let [core (get evidence :core)
        module (get core :module)
        source-record (get node :source)
        identity
        {:domain :gravity/sh08-record-access-match-typing-diagnostic-v2
         :rule rule
         :stage :type-checking
         :core-artifact-id (get core :artifact-id)
         :descriptor-definition descriptor-definition
         :input-definition input-definition
         :core-node-id (get node :node-id)
         :syntax-id (get source-record :syntax-id)
         :source-span (get source-record :semantic-span)
         :actual-source-path (get evidence :actual-source-path)
         :expected expected
         :actual actual
         :profile (get module :profile)
         :target (get module :target)
         :reason reason}]
    {:artifact :gravity/c7-record-access-match-typing-diagnostic
     :diagnostic-id :coordinator-digest-required
     :diagnostic-id-request identity
     :rule rule
     :severity :error
     :stage :type-checking
     :core-artifact-id (get core :artifact-id)
     :descriptor-definition descriptor-definition
     :input-definition input-definition
     :core-node-id (get node :node-id)
     :syntax-id (get source-record :syntax-id)
     :source-span (get source-record :semantic-span)
     :actual-source-path (get evidence :actual-source-path)
     :source-extension (get evidence :source-extension)
     :provenance-status (get evidence :provenance-status)
     :binding-id (first (get node :resolved-binding-ids))
     :type-id nil
     :constraint-id nil
     :expected-type expected
     :actual-type actual
     :profile (get module :profile)
     :target (get module :target)
     :origin-chain (get source-record :origin-chain)
     :generated-origin (get source-record :generated-origin)
     :reason reason
     :remediation
     {:action :repair-authenticated-node-linked-type-input
      :requirements
      [:exact-authenticated-descriptor-result
       :exact-b47-context-digest-path-and-extension
       :separate-authenticated-core-nodes
       :complete-exact-record-field-set
       :declared-field-value-types
       :declared-union-variant
       :exhaustive-noncontradictory-branch-patterns
       :consistent-match-result-type]}}))

(defn sh08-ram-rejected
  [evidence descriptor-definition input-definition node checked]
  (let [core (get evidence :core)
        source-record (get node :source)]
    {:artifact :gravity/sh08-record-access-match-typed-core
     :schema-version 2
     :status :rejected
     :scope :bounded-authenticated-node-linked-type-facts
     :module (get core :module)
     :sh07-shaped-artifact-id (get core :artifact-id)
     :descriptor-definition descriptor-definition
     :input-definition input-definition
     :core-node-id (get node :node-id)
     :syntax-id (get source-record :syntax-id)
     :source-span (get source-record :semantic-span)
     :actual-source-path (get evidence :actual-source-path)
     :source-extension (get evidence :source-extension)
     :provenance-status (get evidence :provenance-status)
     :provenance (get evidence :provenance)
     :diagnostics
     [(sh08-ram-diagnostic
       evidence node descriptor-definition input-definition
       (get checked :rule) (get checked :expected)
       (get checked :actual) (get checked :reason))]
     :pending [:surface-record-union-syntax
               :general-pattern-compiler
               :match-guards-and-effects
               :default-and-unreachable-branch-analysis
               :general-pattern-binding-environments
               :complete-branch-provenance
               :complete-constraint-ledger
               :ownership-and-linear-pattern-moves
               :safe-classification
               :generics :protocols :dynamic-dispatch
               :layout-and-allocation :runtime-behavior
               :native-gravity-cryptographic-verification
               :clojure-jvm-digest-authority-retained
               :sh07-completion :sh08-completion]}))

(defn sh08-ram-accepted
  [evidence descriptor-result descriptor-definition input-definition
   sources checked]
  (let [core (get evidence :core)
        descriptor (get descriptor-result :descriptor)
        record-type (get descriptor :record-type)
        union-type (get descriptor :union-type)
        record-source (get sources :record-source)
        access-source (get sources :access-source)
        union-source (get sources :union-source)
        match-source (get sources :match-source)
        access (get access-source :family)
        construction (get record-source :family)
        access-schema
        (sh08-ru-entry-by
         (get record-type :fields) :name (get access :field))
        access-value
        (sh08-ru-entry-by
         (get construction :fields) :name (get access :field))
        union-construction (get union-source :family)
        branch-sources (get sources :branch-sources)
        branches (sh08-ram-branch-values branch-sources)
        selected-branch
        (sh08-ru-entry-by
         branches :variant (get union-construction :variant))
        match-type (get checked :match-expression-type)
        record-facts
        (sh08-ram-record-facts
         record-type (get sources :record-name) record-source)
        branch-facts
        (sh08-ram-branch-facts
         union-type sources (get union-construction :variant))
        record-constraints
        (sh08-ram-record-constraints
         record-type (get sources :record-name) record-source)
        branch-constraints
        (sh08-ram-branch-constraints union-type sources)
        access-constraint
        (sh08-ram-constraint
         :record-field-access (get sources :access-name) access-source
         (get access-schema :type) (get access-schema :type))
        union-constraint
        (sh08-ram-constraint
         :union-construction (get sources :union-name) union-source
         (get
          (sh08-ru-entry-by
           (get union-type :variants) :tag
           (get union-construction :variant))
          :payload-type)
         (sh08-ru-value-type (get union-construction :payload)))
        match-constraint
        (sh08-ram-constraint
         :match-expression-result (get sources :match-name) match-source
         match-type match-type)
        constraints
        (conj
         (sh08-ram-append
          (conj
           (conj record-constraints access-constraint)
           union-constraint)
          branch-constraints)
         match-constraint)
        semantic-input
        {:program (get sources :program)
         :record-construction (get record-source :family)
         :record-access (get access-source :family)
         :union-construction (get union-source :family)
         :union-match (get match-source :family)
         :branches branches}
        identity-input
        {:domain :gravity/sh08-record-access-match-typing-v2
         :sh07-shaped-artifact-id (get core :artifact-id)
         :descriptor-identity-input (get descriptor-result :identity-input)
         :descriptor-definition descriptor-definition
         :input-definition input-definition
         :semantic-input semantic-input}]
    {:artifact :gravity/sh08-record-access-match-typed-core
     :schema-version 2
     :status :accepted
     :scope :bounded-authenticated-node-linked-type-facts
     :executable-gravity-type-behavior? true
     :roadmap-credit? false
     :module (get core :module)
     :sh07-shaped-artifact-id (get core :artifact-id)
     :descriptor-definition descriptor-definition
     :input-definition input-definition
     :descriptor-identity-input (get descriptor-result :identity-input)
     :typed-core
     {:artifact :gravity/bounded-typed-core
      :types (sh08-ram-type-table descriptor sources match-type)
      :diagnostics []}
     :record-construction-type-facts record-facts
     :record-access-type-fact
     {:artifact :gravity/c7-record-access-type-fact
      :definition (get sources :access-name)
      :core-node-id (get (get access-source :node) :node-id)
      :syntax-id
      (get (get (get access-source :node) :source) :syntax-id)
      :source-span
      (get (get (get access-source :node) :source) :semantic-span)
      :record-definition (get access :record-definition)
      :record-type (get record-type :name)
      :field (get access :field)
      :result-type (get access-schema :type)
      :value (get access-value :value)}
     :union-construction-type-fact
     {:artifact :gravity/c7-union-construction-type-fact
      :definition (get sources :union-name)
      :core-node-id (get (get union-source :node) :node-id)
      :syntax-id
      (get (get (get union-source :node) :source) :syntax-id)
      :source-span
      (get (get (get union-source :node) :source) :semantic-span)
      :union-type (get union-type :name)
      :variant (get union-construction :variant)
      :payload-type
      (sh08-ru-value-type (get union-construction :payload))}
     :union-match-narrowing-facts branch-facts
     :pattern-binding-environments
     (loop [remaining branch-facts environments []]
       (if (= 0 (count remaining))
         environments
         (recur
          (rest remaining)
          (conj environments
                (get (first remaining)
                     :pattern-binding-environment)))))
     :match-expression-type-fact
     {:artifact :gravity/c7-match-expression-type-fact
      :definition (get sources :match-name)
      :core-node-id (get (get match-source :node) :node-id)
      :syntax-id
      (get (get (get match-source :node) :source) :syntax-id)
      :source-span
      (get (get (get match-source :node) :source) :semantic-span)
      :scrutinee-type
      {:kind :closed-union :name (get union-type :name)}
      :expression-type match-type
      :exhaustiveness :closed-total
      :branch-count (count branch-facts)
      :guard-effects #{}
      :selected-result (get selected-branch :result)}
     :constraint-ledger
     {:artifact :gravity/c7-bounded-constraint-ledger
      :constraints constraints
      :unsolved []
      :status :solved}
     :diagnostics []
     :artifact-id-request identity-input
     :identity-input identity-input
     :identity-resolution :coordinator-digest-required
     :actual-source-path (get evidence :actual-source-path)
     :source-extension (get evidence :source-extension)
     :provenance-status (get evidence :provenance-status)
     :provenance (get evidence :provenance)
     :pending [:surface-record-union-syntax
               :general-pattern-compiler
               :match-guards-and-effects
               :default-and-unreachable-branch-analysis
               :general-pattern-binding-environments
               :complete-branch-provenance
               :complete-constraint-ledger
               :ownership-and-linear-pattern-moves
               :safe-classification
               :generics :protocols :dynamic-dispatch
               :layout-and-allocation :runtime-behavior
               :native-gravity-cryptographic-verification
               :clojure-jvm-digest-authority-retained
               :sh07-completion :sh08-completion]}))

(defn sh08-record-access-match-typing-boundary-policy []
  {:invariant-family :self-hosting/sh08-record-access-match-typing-v1
   :descriptor-invariant :self-hosting/sh08-records-unions
   :descriptor-authentication
   :exact-recomputation-from-authenticated-b47-core
   :input-authentication
   :separate-named-map-nodes-in-same-authenticated-b47-core
   :narrowing-source :derived-union-variant-payload-type
   :pattern-annotation-checking? true
   :node-linked-type-facts? true
   :branch-spans? true
   :bounded-pattern-binding-environments? true
   :bounded-constraint-ledger? true
   :overall-match-expression-type? true
   :closed-record-construction-and-access-only? true
   :closed-union-match-narrowing-only? true
   :executable-gravity-type-behavior? true
   :roadmap-credit? false
   :general-pattern-compiler? false
   :match-guards-and-effects :pending
   :defaults-and-unreachable-branches :pending
   :general-pattern-binding-environments :pending
   :complete-branch-provenance :pending
   :complete-constraint-ledger :pending
   :ownership-and-linear-pattern-moves :pending
   :safe-classification :pending
   :runtime-behavior? false
   :independent-gravity-cryptographic-verification? false
   :host-digest-authority-retained? true
   :clojure-jvm-digest-authority-retained? true
   :native-gravity-cryptographic-verification :pending})

(defn sh08-record-access-match-typed-core-artifact
  [request descriptor-definition input-definition descriptor-candidate]
  (let [resolution (sh08-ft-authenticated-core request)
        evidence (sh08-ram-best-evidence request resolution)
        core (get evidence :core)]
    (if (= :accepted (get resolution :status))
      (if (sh08-ram-path-extension-valid?
           (get evidence :actual-source-path)
           (get evidence :source-extension))
      (let [descriptor-result
            (sh08-record-union-type-core-artifact
             request descriptor-definition)
            sources (sh08-ram-resolve-program core input-definition)
            node
            (if (= :accepted (get sources :status))
              (get (get sources :program-source) :node)
              (get sources :node))]
        (if (= :accepted (get descriptor-result :status))
          (if (= descriptor-result descriptor-candidate)
            (if (= :accepted (get sources :status))
              (let [record-check
                    (sh08-ram-check-record
                     (get descriptor-result :descriptor) sources)]
                (if (= :accepted (get record-check :status))
                  (let [union-check
                        (sh08-ram-check-union
                         (get descriptor-result :descriptor) sources)]
                    (if (= :accepted (get union-check :status))
                      (sh08-ram-accepted
                       evidence descriptor-result descriptor-definition
                       input-definition sources union-check)
                      (sh08-ram-rejected
                       evidence descriptor-definition input-definition
                       (get union-check :node) union-check)))
                  (sh08-ram-rejected
                   evidence descriptor-definition input-definition
                   (get record-check :node) record-check)))
              (sh08-ram-rejected
               evidence descriptor-definition input-definition node sources))
            (sh08-ram-rejected
             evidence descriptor-definition input-definition node
             {:rule "C7-VERIFY"
              :reason
              (if (= (get descriptor-result :provenance)
                     (get descriptor-candidate :provenance))
                :descriptor-fact-substitution
                :descriptor-provenance-substitution)
              :expected :exact-recomputed-descriptor-result
              :actual :substituted-descriptor-result}))
          (sh08-ram-rejected
           evidence descriptor-definition input-definition node
           {:rule "C7-VERIFY"
            :reason :authenticated-descriptor-required
            :expected :accepted-integrated-descriptor
            :actual (get descriptor-result :status)})))
      (sh08-ram-rejected
       evidence descriptor-definition input-definition
       (get (sh08-ru-family-from-core core input-definition) :node)
       {:rule "C7-VERIFY"
        :reason :source-extension-path-mismatch
        :expected (get evidence :actual-source-path)
        :actual (get evidence :source-extension)}))
      (sh08-ram-rejected
       evidence descriptor-definition input-definition
       (get (sh08-ru-family-from-core core input-definition) :node)
       {:rule "C7-VERIFY"
        :reason (get resolution :reason)
        :expected :host-resolved-authentic-b47-context
        :actual (get resolution :reason)}))))

(defn sh08-verify-record-access-match-typing-result
  [request descriptor-definition input-definition descriptor-candidate
   candidate]
  (let [expected
        (sh08-record-access-match-typed-core-artifact
         request descriptor-definition input-definition descriptor-candidate)]
    {:artifact :gravity/sh08-record-access-match-typing-verification
     :status (if (= expected candidate) :passed :rejected)
     :checks [:authenticated-b47-core-context-digest-path-and-extension
              :integrated-descriptor-exactly-recomputed
              :typing-program-and-component-nodes-source-bound
              :record-construction-field-facts-node-linked
              :record-access-result-fact-node-linked
              :closed-union-variant-fact-node-linked
              :branch-spans-and-pattern-bindings-preserved
              :exhaustive-derived-match-narrowing
              :match-expression-type-derived
              :bounded-constraint-ledger-solved
              :result-identity-fact-and-provenance-mutation-rejected]
     :expected expected
     :candidate candidate}))
(defn verify-c7-type-checker [typed-core-artifact]
  (quote {:status :stage1-source-owned
          :typed-core-artifact typed-core-artifact
          :checks [:every-core-node-typed-or-diagnosed
                   :function-types-record-latent-effects
                   :function-types-record-capabilities
                   :function-types-record-ownership-constraints
                   :local-inference-deterministic
                   :profile-required-facts-rejected-when-missing
                   :dynamic-boundaries-explicit
                   :casts-and-conversions-checked
                   :generics-and-protocol-dispatch-artifacted
                   :schema-derived-types-preserve-schema-identity
                   :typed-core-verifier-before-effects]
          :diagnostics c7-type-diagnostic-catalog
          :preserves [:source-spans :syntax-identity
                      :binding-identity :namespace-context
                      :profile-target-metadata
                      :effect-capability-metadata
                      :core-node-identity :dynamic-boundaries
                      :schema-identity :layout-facts
                      :ownership-resource-type-facts
                      :latent-effects :thrown-error-effects
                      :artifact-provenance]}))

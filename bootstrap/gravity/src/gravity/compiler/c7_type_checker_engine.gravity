    (if (= false (if (vector? args) (if (= 1 (count args))
                    (if (vector? children) (= 2 (count children)) false) false) false))
        (sh08-sm-failure "C7-TYPE-MISMATCH" :nil-predicate-arity-mismatch nil :one-ordinary-operand nil)
        (if (loop [remaining (conj (conj (conj (conj (conj (get call :argument-node-ids) (get call :operator-node-id)) (get call :operator-binding-id)) (get node :node-id)) (get (get node :source) :form-id)) (get (get node :source) :syntax-id))] (if (= 0 (count remaining)) (loop [remaining (get node :children)] (if (= 0 (count remaining)) true (if (if (keyword? (first remaining)) true (if (string? (first remaining)) (= 71 (count (first remaining))) false)) (recur (rest remaining)) false))) (if (if (keyword? (first remaining)) true (if (string? (first remaining)) (= 71 (count (first remaining))) false)) (recur (rest remaining)) false))) (let [arguments [(get types (first args) :gravity.type/unknown)]
              validation (sh08-lc-validate-types arguments)
              owner (if (if (keyword? (get (get node :source) :form-id)) true (if (string? (get (get node :source) :form-id)) (= 71 (count (get (get node :source) :form-id))) false)) (get forms (get (get node :source) :form-id)) nil) ids (get owner :child-form-ids)]
          (if (= false (= :accepted (get validation :status)))
            (assoc (sh08-sm-failure "C7-TYPE-MISMATCH"
                     :nil-predicate-operand-type-required
                     nil :independently-established-closed-value arguments) :type-check-reason (get validation :reason))
            (let [header (sh08-nilp-source core node call edge nodes bindings types (get core :module) validation)]
              (if (if (if (map? header) (if (vector? ids) (if (= 2 (count ids)) (loop [remaining ids] (if (= 0 (count remaining)) true (if (if (keyword? (first remaining)) true (if (string? (first remaining)) (= 71 (count (first remaining))) false)) (recur (rest remaining)) false))) false) false) false)
                    (sh08-ft-all-true?
                      [(= :list (get owner :kind)) (= (get node :source) (sh08-ma-form-source owner))
                       (vector? ids) (= 2 (if (vector? ids) (count ids) 0))
                       (= {:operator-child-index 0 :argument-count 1 :argument-child-indexes [1]
                           :evaluation-order :operator-then-arguments :dispatch :resolved-symbol-call} (get node :attributes))
                       (loop [i 0]
                         (if (= i 2) true
                           (let [form (get forms (get ids i)) child (get nodes (get children i))]
                             (if (sh08-ft-all-true? [(= (get owner :form-id) (get form :parent-form-id))
                                   (= (get child :source) (sh08-ma-form-source form))
                                   (if (= i 0) (= (get form :value) (get (get child :attributes) :symbol)) true)])
                               (recur (+ i 1)) false))))]) false)
                (let [descriptor (sh08-nilp-finish header)]
                  {:status :accepted :descriptor descriptor :type (get descriptor :result-type)
                   :constraint (sh08-nilp-constraint descriptor)})
                (sh08-sm-failure "C7-VERIFY" :nil-predicate-source-mismatch nil :exact-operator-operand-source (get node :node-id)))))) (sh08-sm-failure "C7-VERIFY" :nil-predicate-source-mismatch nil :exact-operator-operand-source (get node :node-id))))))

(defn sh08-nilp-node? [node context]
  (if (if (= :call (get node :core-form)) (if (vector? (get node :resolved-binding-ids)) (if (= 1 (count (get node :resolved-binding-ids))) (if (keyword? (first (get node :resolved-binding-ids))) true (if (string? (first (get node :resolved-binding-ids))) (= 71 (count (first (get node :resolved-binding-ids)))) false)) false) false) false)
    (sh08-nilp-binding? (get (get context :ordering-bindings) (first (get node :resolved-binding-ids)))
                     (get (get context :ordering-core) :module)) false))

(defn sh08-nilp-inferred-call [core node call edge nodes bindings types]
  (let [args (get call :argument-node-ids) children (get node :children)]
    (if (if (vector? args) (if (= 1 (count args))
            (if (vector? children) (= 2 (count children)) false) false) false)
        (if (loop [remaining (conj (conj (conj (conj (conj (get call :argument-node-ids) (get call :operator-node-id)) (get call :operator-binding-id)) (get node :node-id)) (get (get node :source) :form-id)) (get (get node :source) :syntax-id))] (if (= 0 (count remaining)) (loop [remaining (get node :children)] (if (= 0 (count remaining)) true (if (if (keyword? (first remaining)) true (if (string? (first remaining)) (= 71 (count (first remaining))) false)) (recur (rest remaining)) false))) (if (if (keyword? (first remaining)) true (if (string? (first remaining)) (= 71 (count (first remaining))) false)) (recur (rest remaining)) false))) (let [validation (sh08-lc-validate-types [(get types (first args) :gravity.type/unknown)])]
          (if (= :accepted (get validation :status))
            (let [header (sh08-nilp-source core node call edge nodes bindings types (get core :module) validation)
                  descriptor (if (map? header) (sh08-nilp-finish header) nil)]
              (if (if (map? descriptor)
                    (if (= descriptor (get types (get call :operator-node-id)))
                      (= (get descriptor :result-type) (get types (get node :node-id))) false) false)
                {:status :accepted}
                {:status :rejected :reason :nil-predicate-source-mismatch}))
            {:status :rejected :reason :nil-predicate-operand-type-required
             :type-check-reason (get validation :reason)})) {:status :rejected :reason :nil-predicate-source-mismatch})
        {:status :rejected :reason :nil-predicate-arity-mismatch})))

(defn sh08-nilp-step [node types binding-types functions context]
  (sh08-nilp-derive (get context :ordering-core) node
    (get (get context :ordering-operators) (first (get node :children)))
    (get (get context :ordering-edges) (get node :node-id))
    (get context :lookup-nodes) (get context :ordering-bindings) types (get context :association-forms)))

(defn sh08-ane-domain [arguments]
  (if (if (vector? arguments) (= 2 (count arguments)) false)
    (loop [index 0 integral-type nil atomic-seen? false]
      (if (= index 2)
        (if (if (= nil integral-type) false atomic-seen?)
          {:status :rejected :reason :unsupported-inequality-type-pair}
          (if (= nil integral-type)
            {:status :accepted}
            (if (= :gravity.type/integer integral-type)
              {:status :accepted :comparison-domain :integer}
              {:status :accepted :comparison-domain :fixed-integral :integer-type integral-type})))
        (let [type (get arguments index)]
          (if (keyword? type)
            (if (contains? #{:gravity.type/integer :gravity.type/i8 :gravity.type/i16 :gravity.type/i32 :gravity.type/i64
                             :gravity.type/u8 :gravity.type/u16 :gravity.type/u32 :gravity.type/u64} type)
              (if (if (= nil integral-type) true (= integral-type type))
                (recur (+ index 1) type atomic-seen?)
                {:status :rejected :reason :unsupported-inequality-type-pair})
              (if (contains? #{:gravity.type/nil :gravity.type/bool :gravity.type/character :gravity.type/string
                               :gravity.type/symbol :gravity.type/keyword :gravity.type/never} type)
                (recur (+ index 1) integral-type (if (= :gravity.type/never type) atomic-seen? true))
                {:status :rejected :reason :nonnumeric-atomic-type-required}))
            (if (map? type)
              (if (= 3 (count type))
                (let [kind (get type :kind)]
                  (if (= :gravity.type/list kind)
                    (let [domain (sh08-le-domain arguments)]
                      (if (= :accepted (get domain :status))
                        {:status :accepted :comparison-domain :list :list-domain domain}
                        {:status :rejected :reason (get domain :reason)}))
                    (if (= :gravity.type/vector kind)
                      (let [domain (sh08-ve-domain arguments)]
                        (if (= :accepted (get domain :status))
                          (assoc {:status :accepted :comparison-domain :vector
                                  :vector-comparison-domain (get domain :comparison-domain)}
                            :vector-integer-leaves? (get domain :integer-leaves?))
                          {:status :rejected :reason (get domain :reason)}))
                      (if (= :gravity.type/set kind)
                        (let [domain (sh08-sse-domain arguments)]
                          (if (= :accepted (get domain :status))
                            (if (= :string-set-carrier (get domain :comparison-domain))
                              {:status :accepted :comparison-domain :string-set-carrier
                               :operand-domains (get domain :operand-domains)}
                              (if (= :string-set (get domain :comparison-domain))
                                {:status :accepted :comparison-domain :string-set
                                 :operand-counts (get domain :operand-counts)}
                                {:status :accepted :comparison-domain :keyword-set
                                 :operand-counts (get domain :operand-counts)}))
                            {:status :rejected :reason (get domain :reason)}))
                        {:status :rejected :reason :nonnumeric-atomic-type-required}))))
                (if (if (= 2 (count type)) (= :gravity.type/nil-or (get type :kind)) false)
                  (let [value (get type :value-type)]
                    (if (if (keyword? value)
                          (contains? #{:gravity.type/bool :gravity.type/character :gravity.type/string
                                       :gravity.type/symbol :gravity.type/keyword} value) false)
                      (recur (+ index 1) integral-type true)
                      {:status :rejected :reason :nonnumeric-atomic-type-required}))
                  {:status :rejected :reason :nonnumeric-atomic-type-required}))
              {:status :rejected :reason :nonnumeric-atomic-type-required})))))
    {:status :rejected :reason :binary-type-input-required}))

(defn sh08-ane-binding? [binding module]
  (if (if (vector? (get binding :profile-set)) (vector? (get binding :target-set)) false)
  (sh08-ft-all-true?
    [(= ['not= :core :var 'gravity.core {:name 'gravity/core :version "bootstrap-contract-v1"} :gravity.type/core-var :safe]
        [(get binding :name) (get binding :binding-class) (get binding :kind) (get binding :namespace)
         (get binding :package) (get binding :type-ref) (get binding :safety)])
     (= [] (get binding :effects) (get binding :capabilities))
     (= :jvm (get module :target))
     (contains? (set (get binding :profile-set)) (get module :profile))
     (contains? (set (get binding :target-set)) :all)]) false))

(defn sh08-ane-list-source-ids? [node call nodes bindings module]
  (if (sh08-sse-call-ids? node call)
    (let [operator (get nodes (get call :operator-node-id)) binding (get bindings (get call :operator-binding-id))]
      (if (sh08-sse-ids? [(get operator :node-id) (get (get operator :source) :form-id)
                         (get (get operator :source) :syntax-id) (get binding :binding-id)] 4)
        (if (if (vector? (get binding :profile-set)) (vector? (get binding :target-set)) false)
          (if (loop [items (get binding :profile-set)]
                (if (= 0 (count items)) true (if (keyword? (first items)) (recur (rest items)) false)))
            (if (loop [items (get binding :target-set)]
                  (if (= 0 (count items)) true (if (keyword? (first items)) (recur (rest items)) false)))
              (if (if (symbol? (get (get operator :attributes) :symbol)) (keyword? (get module :profile)) false)
                (sh08-ft-all-true?
                  [(= (get node :node-id) (get call :core-node-id))
                   (= (get operator :node-id) (get call :operator-node-id) (first (get node :children)))
                   (= (get binding :binding-id) (get call :operator-binding-id))
                   (= (get call :argument-node-ids) (vec (rest (get node :children))))
                   (= [(get call :operator-binding-id)] (get node :resolved-binding-ids) (get operator :resolved-binding-ids))
                   (contains? '#{not= gravity.core/not=} (get (get operator :attributes) :symbol))
                   (= :jvm (get module :target)) (sh08-ane-binding? binding module)]) false)
              false) false) false) false)) false))

(defn sh08-ane-source [core node call edge nodes bindings types module validation]
  ; Owning analysis supplies this invocation's validated ANE type domain.
  (if (if (= :list (get validation :comparison-domain))
        (sh08-ane-list-source-ids? node call nodes bindings module) true)
(if (if (vector? (get call :argument-node-ids))
        (if (= 2 (count (get call :argument-node-ids)))
          (if (vector? (get node :children)) (= 3 (count (get node :children))) false) false) false)
  (if (loop [remaining (conj (conj (conj (conj (conj (get call :argument-node-ids) (get call :operator-node-id)) (get call :operator-binding-id)) (get node :node-id)) (get (get node :source) :form-id)) (get (get node :source) :syntax-id))] (if (= 0 (count remaining)) (loop [remaining (get node :children)] (if (= 0 (count remaining)) true (if (if (keyword? (first remaining)) true (if (string? (first remaining)) (= 71 (count (first remaining))) false)) (recur (rest remaining)) false))) (if (if (keyword? (first remaining)) true (if (string? (first remaining)) (= 71 (count (first remaining))) false)) (recur (rest remaining)) false)))
(let [children (get node :children) operator (get nodes (get call :operator-node-id))
        bid (get call :operator-binding-id) binding (get bindings bid) args (get call :argument-node-ids)
        arguments (sh08-ft-ordered-child-types args types)

        invoked? (loop [remaining arguments]
                   (if (= 0 (count remaining)) true
                     (if (= :gravity.type/never (first remaining)) false (recur (rest remaining)))))
        caller (loop [remaining (get core :function-records)]
                 (if (= 0 (count remaining)) nil
                   (if (= (get (first remaining) :function-syntax-id) (get (get node :evaluation) :owner-function-syntax-id))
                     (first remaining) (recur (rest remaining)))))
        expected-call {:core-node-id (get node :node-id) :operator-node-id (first children) :operator-binding-id bid
                       :argument-node-ids (vec (rest children)) :ordered-evaluation-node-ids children
                       :evaluation-order :operator-then-arguments :result-policy :call-result}
        expected-edge {:ordinal (get edge :ordinal) :call-core-node-id (get node :node-id)
                       :caller-function-syntax-id (get caller :function-syntax-id) :caller-function-core-node-id (get caller :function-core-node-id)
                       :callee-binding-id bid :callee-definition-syntax-id (get binding :definition-syntax-id)
                       :callee-function-syntax-id nil :callee-function-core-node-id nil :argument-core-node-ids args
                       :ordered-evaluation-node-ids children :evaluation-order :operator-then-arguments :classification :nonlocal-or-nonfunction}]
    (if (sh08-ft-all-true?
          [(= :accepted (get validation :status))
           (if (= :flat-keyword-set-vector (get validation :vector-comparison-domain)) (= :jvm (get module :target)) true)  (= :call (get node :core-form)) (= :reference (get operator :core-form))
           (= 2 (count args)) (= expected-call call) (= expected-edge edge) (sh08-ane-binding? binding module)
           (= [bid] (get node :resolved-binding-ids) (get operator :resolved-binding-ids))
           (= {:symbol (get (get operator :attributes) :symbol) :position :operator :binding-id bid :binding-class :core
               :definition-syntax-id (get binding :definition-syntax-id)} (get operator :attributes))
           (contains? '#{not= gravity.core/not=} (get (get operator :attributes) :symbol))
           (= :operator-then-arguments (get (get node :evaluation) :kind))
           (= (loop [i 0 out []] (if (= i (count children)) out
                (recur (+ i 1) (conj out {:index i :core-node-id (get children i)})))) (get (get node :evaluation) :order))
           (loop [remaining arguments]
             (if (= 0 (count remaining)) true
               (if (if (= nil (first remaining)) true (= :gravity.type/unknown (first remaining))) false (recur (rest remaining)))))] )
      (let [header {:kind :gravity.type/applied-atomic-inequality :version :sh08-atomic-inequality-v1
       :operation 'not= :semantic-owner 'gravity.core :intrinsic :gravity.core/atomic-value-inequality
       :resolution :gravity.core-compatibility :operator-node-id (get operator :node-id) :operator-binding-id bid
       :call-core-node-id (get node :node-id) :source (get node :source) :operator-source (get operator :source)
       :source-call call :source-edge edge :source-binding binding :argument-types arguments

       :inequality-policy {:operation :complement-of-binary-atomic-value-equality
                         :domain [:nil :boolean :character :string :symbol :keyword]
                         :operand-evaluation :left-to-right-once :operand-position :non-tail
                         :nil-bearing :compare-original-values :cross-family :actual-value-families
                         :identity :unobserved :coercion :none :normalization :none :locale :none
                         :numeric :unsupported :collections :unsupported :construction :none
                         :lowering :owned-equality-branch-complement :entry-contract :type-conforming-typed-calls}
       :application (if invoked? :normal :not-invoked)
       :latent-effects [] :direct-effects [] :capabilities [] :thrown-error-effects []
       :profile (get module :profile) :target (get module :target)
       :invalidation [:calls :call-edges :binding-table :source-forms :type-table :lexical-bindings :definitions :function-records
                      :callee-body :inequality-policy  :operand-type :profile :target :evaluation-order]}]
        (if (= :list (get validation :comparison-domain))
          (if (= arguments (get (get validation :list-domain) :argument-types))
            (assoc header :intrinsic :gravity.core/list-value-inequality
              :list-equality {:version :sh08-list-inequality-v1 :semantic-owner 'gravity.collections
                             :equality-version :sh08-list-equality-v1
                             :equality-policy {:domain :finite-persistent-lists :members :recursive-list-and-supported-atomic
                         :count :equal :order :corresponding-values :leaves :original-values
                         :nil-bearing :unsupported :cross-family :unsupported
                         :nested-list-versus-atomic :unsupported
                         :identity :unobserved :payload-evaluation :none :mutation :none :numeric :unsupported}
              :inequality-policy {:operation :complement-of-binary-list-value-equality :domain :finite-persistent-lists
                                  :operand-evaluation :left-to-right-once :operand-position :non-tail
                                  :nil-bearing :unsupported :cross-family :unsupported :identity :unobserved
                                  :coercion :none :normalization :none :locale :none :numeric :unsupported
                                  :collections :finite-persistent-lists :construction :none
                                  :lowering :owned-equality-branch-complement :entry-contract :type-conforming-typed-calls}
              :invalidation (conj (conj (conj (get header :invalidation) :list-equality) :list-domain) :value-policy)} ) nil)
(if (= :integer (get validation :comparison-domain))
          (assoc header :numeric-equality {:version :sh08-integer-inequality-v1
                           :semantic-owner 'gravity.math :layer0-owner 'gravity.math.core
                           :integer-type :gravity.type/integer :numeric-mode :proof-required :safety :proven-safe
                           :safety-rule :same-integral-value-equality-no-conversion-overflow-or-rounding
                           :equality-policy {:domain :same-integral-type :comparison :original-integer-values
                                             :conversion :none :arithmetic :none :overflow :impossible
                                             :rounding :none :cross-type :unsupported}}
                 :inequality-policy {:operation :complement-of-binary-atomic-value-equality
                           :domain [:integer] :operand-evaluation :left-to-right-once :operand-position :non-tail
                           :nil-bearing :unsupported :cross-family :unsupported :identity :unobserved
                           :coercion :none :normalization :none :locale :none :numeric :same-established-integer
                           :collections :unsupported :construction :none :lowering :owned-equality-branch-complement
                           :entry-contract :type-conforming-typed-calls}
                 :invalidation (conj (conj (conj (conj (get header :invalidation) :numeric-equality) :integral-type) :numeric-mode) :value-policy))
          (if (= :fixed-integral (get validation :comparison-domain))
            (assoc header :numeric-equality {:version :sh08-fixed-integral-inequality-v1
                           :semantic-owner 'gravity.math :layer0-owner 'gravity.math.core
                           :integer-type (get validation :integer-type) :numeric-mode :proof-required :safety :proven-safe
                           :safety-rule :same-integral-value-equality-no-conversion-overflow-or-rounding
                           :equality-policy {:domain :same-integral-type :comparison :original-integer-values
                                             :conversion :none :arithmetic :none :overflow :impossible
                                             :rounding :none :cross-type :unsupported}}
                   :inequality-policy {:operation :complement-of-binary-atomic-value-equality
                           :domain :same-integral-type :integer-type (get validation :integer-type)
                           :operand-evaluation :left-to-right-once :operand-position :non-tail
                           :nil-bearing :unsupported :cross-family :unsupported :identity :unobserved
                           :coercion :none :normalization :none :locale :none :numeric :same-established-fixed-integral-type
                           :collections :unsupported :construction :none :lowering :owned-equality-branch-complement
                           :entry-contract :type-conforming-typed-calls}
                   :invalidation (conj (conj (conj (conj (get header :invalidation) :numeric-equality) :integral-type) :numeric-mode) :value-policy))
            (if (= :vector (get validation :comparison-domain))
              (let [result (let [result (assoc header :intrinsic :gravity.core/vector-value-inequality
                     :vector-equality {:version :sh08-vector-inequality-v1 :semantic-owner 'gravity.collections
                            :equality-version :sh08-vector-equality-v1
                            :equality-policy {:domain :finite-persistent-vectors :members :recursive-vector-and-supported-atomic
                         :count :equal :order :corresponding-values :leaves :original-values
                         :nil-bearing :compare-original-values :cross-family :actual-value-families
                         :nested-vector-versus-atomic :false
                         :identity :unobserved :payload-evaluation :none :mutation :none :numeric :unsupported}
                     :inequality-policy {:operation :complement-of-binary-vector-value-equality
                            :domain :finite-persistent-vectors :members :recursive-vector-and-supported-atomic
                            :operand-evaluation :left-to-right-once :operand-position :non-tail
                            :nil-bearing :compare-original-values :cross-family :actual-value-families
                            :cross-collection :unsupported :identity :unobserved :coercion :none :normalization :none :locale :none
                            :numeric :unsupported :collections :finite-persistent-vectors :construction :none
                            :payload-evaluation :none :mutation :none :lowering :owned-equality-branch-complement
                            :entry-contract :type-conforming-typed-calls}
                     :invalidation (conj (conj (conj (get header :invalidation) :vector-equality) :equality-domain) :value-policy)})]
                (if (= :flat-integer-vector (get validation :vector-comparison-domain))
                  (assoc result
                    :vector-equality (assoc (get result :vector-equality)
                      :version :sh08-flat-integer-vector-inequality-v1
                      :equality-version :sh08-flat-integer-vector-equality-v1
                      :equality-policy {:domain :finite-flat-persistent-vectors :members :supported-atomic-and-generic-integer
                         :count :equal :order :corresponding-values :leaves :original-values
                         :nil-bearing :compare-original-nonnumeric-values :cross-family :actual-nonnumeric-value-families
                         :integer-cross-family :unsupported :nested-vectors :unsupported
                         :identity :unobserved :payload-evaluation :none :mutation :none
                         :numeric :same-established-generic-integer-leaves
                         :entry-contract :type-conforming-typed-calls}
                      :numeric-equality {:version :sh08-flat-integer-vector-leaf-equality-v1
                          :semantic-owner 'gravity.math :layer0-owner 'gravity.math.core
                          :integer-type :gravity.type/integer :numeric-mode :proof-required :safety :proven-safe
                          :safety-rule :same-integral-value-equality-no-conversion-overflow-or-rounding
                          :equality-policy {:domain :same-integral-type :comparison :original-integer-values
                                            :conversion :none :arithmetic :none :overflow :impossible
                                            :rounding :none :cross-type :unsupported}}
                    :inequality-policy (assoc (get result :inequality-policy)
                      :domain :finite-flat-persistent-vectors :members :supported-atomic-and-generic-integer
                      :numeric :same-established-generic-integer-leaves
                      :integer-cross-family :unsupported :nested-vectors :unsupported
                      :nil-bearing :compare-original-nonnumeric-values :cross-family :actual-nonnumeric-value-families)
                    :invalidation (conj (conj (conj (get result :invalidation) :numeric-equality) :integral-type) :numeric-mode)))
                  result))]
                (if (= :flat-keyword-set-vector (get validation :vector-comparison-domain))
                  (let [policy (assoc (get result :vector-equality)
                                 :version :sh08-flat-keyword-set-vector-inequality-v1
                                 :equality-version :sh08-flat-keyword-set-vector-equality-v1
                                 :equality-policy {:domain :finite-flat-persistent-vectors :members :supported-atomic-generic-integer-and-finite-keyword-set
                         :count :equal :order :corresponding-values :leaves :original-values
                         :nil-bearing :compare-original-nonnumeric-values :cross-family :actual-nonnumeric-value-families
                         :integer-cross-family :unsupported :keyword-set-cross-family :unsupported :nested-vectors :unsupported
                         :identity :unobserved :payload-evaluation :none :mutation :none
                         :numeric (if (get validation :vector-integer-leaves?) :same-established-generic-integer-leaves :unsupported)
                         :keyword-sets :independently-finite-keyword-only
                         :entry-contract :type-conforming-typed-calls}
                                 :keyword-set-leaf-equality {:version :sh08-vector-keyword-set-leaf-equality-v1
                            :semantic-owner 'gravity.collections :equality-version :sh08-keyword-set-equality-v1
                            :domain :independently-finite-persistent-keyword-sets :members :keyword-only
                            :comparison :guarded-atomic-keyword-leaf :order :unobserved
                            :domain-validation :owned-self-equality-before-any-vector-result
                            :member-uniqueness :validated-before-any-vector-result

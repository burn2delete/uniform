                      :callee-body :map-type :key-domain :membership-policy :profile :target :evaluation-order]} nil)) nil))

(defn sh08-mc-constraint [descriptor]
  {:constraint-id-request {:domain :gravity/sh08-map-contains-constraint-v1 :application descriptor}
   :kind :equality :producer-rule :sh08-map-contains-v1
   :lhs {:core-node-id (get descriptor :call-core-node-id) :projection :map-contains}

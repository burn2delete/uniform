(defn sh08-mc-derive [core node call edge nodes bindings types forms budget]
  ; STD3 membership queries a known Map with an independently established
  ; String or Keyword key, without inspecting stored values or map shape.
  (let [args (get call :argument-node-ids) work (+ 64 (count args) (count (get core :function-records)))
        owner (get forms (get (get node :source) :form-id)) ids (get owner :child-form-ids)]
    (if (> work budget)
      (assoc (sh08-sm-failure "C7-GENERIC" :map-contains-work-limit nil :remaining-type-join-units budget) :work-count work)
      (let [header (sh08-mc-source core node call edge nodes bindings types (get core :module))]
        (if (= header nil)
          (assoc (sh08-sm-failure "C7-TYPE-MISMATCH"
                   (if (= 2 (count args)) :map-contains-operand-type-required :map-contains-arity-mismatch)
                   nil :established-map-and-string-or-keyword-key (sh08-ft-ordered-child-types args types)) :work-count work)
          (if (sh08-ft-all-true?
                [(= :list (get owner :kind)) (= (get node :source) (sh08-ma-form-source owner)) (vector? ids) (= 3 (if (vector? ids) (count ids) 0))
                 (= {:operator-child-index 0 :argument-count 2 :argument-child-indexes [1 2]
                     :evaluation-order :operator-then-arguments :dispatch :resolved-symbol-call} (get node :attributes))
                 (loop [i 0]
                   (if (= i 3) true
                     (let [form (get forms (get ids i)) child (get nodes (get (get node :children) i))]
                       (if (sh08-ft-all-true? [(= (get owner :form-id) (get form :parent-form-id))
                             (= (get child :source) (sh08-ma-form-source form))
                             (if (= i 0) (= (get form :value) (get (get child :attributes) :symbol)) true)])
                         (recur (+ i 1)) false))))])
            (let [descriptor (sh08-mc-finish header)]
              {:status :accepted :descriptor descriptor :type (get descriptor :result-type)
               :constraint (sh08-mc-constraint descriptor) :work-count work})
            (assoc (sh08-sm-failure "C7-VERIFY" :map-contains-source-mismatch nil :exact-operator-map-key-source (get node :node-id)) :work-count work)))))))

(defn sh08-mc-node? [node context]
  (if (= :call (get node :core-form))
    (sh08-mc-binding? (get (get context :ordering-bindings) (first (get node :resolved-binding-ids)))
                     (get (get context :ordering-core) :module)) false))

(defn sh08-mc-inferred-call-valid? [core node call edge nodes bindings types]
  (let [header (sh08-mc-source core node call edge nodes bindings types (get core :module))]

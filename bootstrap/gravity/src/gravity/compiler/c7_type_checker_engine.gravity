    {:artifact :gravity/c7-call-type-fact
     :fact-id-request {:domain (if (= :sh08-indexed-private-self-unit-addition-v1 (get descriptor :version))
                     :gravity/sh08-indexed-private-self-unit-addition-call-type-fact-v1
                   (if (= :sh08-bounded-unit-addition-v1 (get descriptor :version))
                   :gravity/sh08-bounded-unit-addition-call-type-fact-v1
                   (if (= :sh08-bounded-successor-v2 (get descriptor :version))
                     :gravity/sh08-bounded-successor-call-type-fact-v2 :gravity/sh08-bounded-successor-call-type-fact-v1))) :application descriptor}
     :call-core-node-id (get descriptor :call-core-node-id) :caller-function-syntax-id (get edge :caller-function-syntax-id)
     :callee-function-syntax-id nil :argument-types (get descriptor :argument-types) :result-type (get descriptor :result-type)

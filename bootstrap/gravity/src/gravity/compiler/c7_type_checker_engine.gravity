(defn sh08-vsl-if-container [core let-node node nodes bindings forms local-call?]
  ; Exactly one original if container; no parent walk or branch-result inference.
  (let [controls (get core :control-flow) children (get node :children)]
    (if (if (if (boolean? local-call?) (vector? controls) false)
            (if (sh08-sse-ids? children 3)
              (if (sh08-sse-ids? [(get node :node-id) (get (get node :source) :form-id) (get (get node :source) :syntax-id)
                         (get let-node :node-id) (get (get let-node :source) :form-id) (get (get let-node :attributes) :body-scope-id)] 6)
                (loop [remaining controls] (if (= 0 (count remaining)) true
                  (if (sh08-sse-ids? [(get (first remaining) :core-node-id)] 1) (recur (rest remaining)) false))) false) false) false)
        (let [form (get forms (get (get node :source) :form-id)) ids (get form :child-form-ids)
              branch-nodes [(get nodes (get children 0)) (get nodes (get children 1)) (get nodes (get children 2))]
              control (sh08-nq-one controls :core-node-id (get node :node-id))
              scope (get (get let-node :attributes) :body-scope-id)
              owner (get (get node :evaluation) :owner-function-syntax-id) region (get (get node :evaluation) :region)]
          (if (if (sh08-sse-ids? ids 4)
                (if (sh08-sse-ids? [(get form :form-id) (get form :syntax-id) (get form :scope-id)] 3)
                  (if (if (= nil owner) true (sh08-sse-ids? [owner] 1))
                    (loop [remaining branch-nodes] (if (= 0 (count remaining)) true
                      (let [child (first remaining) child-owner (get (get child :evaluation) :owner-function-syntax-id)]
                        (if (sh08-sse-ids? [(get child :node-id) (get (get child :source) :form-id) (get (get child :source) :syntax-id)] 3)
                          (if (if (= nil child-owner) true (sh08-sse-ids? [child-owner] 1)) (recur (rest remaining)) false) false)))) false) false) false)
            (let [operator (get forms (get ids 0)) condition-form (get forms (get ids 1))
                  then-form (get forms (get ids 2)) else-form (get forms (get ids 3))
                  selected-forms [form operator condition-form then-form else-form]
                  region-fields? (if (map? region) (if (= 8 (count region))
                                   (loop [remaining (keys region)] (if (= 0 (count remaining)) true
                                     (if (keyword? (first remaining)) (recur (rest remaining)) false))) false) false)
                  region-valid? (if (keyword? region) (contains? #{:module-initialization :function-body} region)
                                  (if region-fields?
                                    (if (if (sh08-sse-ids? [(get region :if-syntax-id) (get region :if-form-id)] 2)
                                          (if (if (= nil (get region :parent-if-syntax-id)) true (sh08-sse-ids? [(get region :parent-if-syntax-id)] 1))
                                            (if (keyword? (get region :role))
                                              (if (keyword? (get region :parent-region-kind))
                                                (if (= nil (get region :parent-branch-role)) true (keyword? (get region :parent-branch-role))) false) false) false) false)
                                      (sh08-ft-all-true? [(= #{:kind :if-syntax-id :if-form-id :role :execution :parent-region-kind :parent-if-syntax-id :parent-branch-role} (set (keys region)))
                                            (= :conditional-branch (get region :kind)) (= :selected-exactly-once (get region :execution))
                                            (contains? #{:then :else} (get region :role))
                                            (contains? #{:module-initialization :function-body :conditional-branch :match-guard} (get region :parent-region-kind))
                                            (if (= :conditional-branch (get region :parent-region-kind))
                                              (if (sh08-sse-ids? [(get region :parent-if-syntax-id)] 1)
                                                (contains? #{:then :else} (get region :parent-branch-role)) false)
                                              (if (= nil (get region :parent-if-syntax-id)) (= nil (get region :parent-branch-role)) false))]) false) false))]
              (if (if region-valid?
                    (if (symbol? (get operator :value))
                      (if (sh08-sse-ids? [(get control :condition-node-id) (get (get (get control :branches) 0) :core-node-id)
                                 (get (get (get control :branches) 1) :core-node-id)] 3)
                        (loop [remaining selected-forms] (if (= 0 (count remaining)) true
                          (let [item (first remaining)]
                            (if (sh08-sse-ids? [(get item :form-id) (get item :syntax-id) (get item :scope-id)] 3) (recur (rest remaining)) false)))) false) false) false)
                (if (sh08-ft-all-true? [
                      (= :if (get node :core-form)) (= :let (get let-node :core-form)) (= [] (get node :resolved-binding-ids))
                      (= (get node :node-id) (get (get let-node :children) 1))
                      (= :list (get form :kind)) (= :symbol (get operator :kind)) (= 'if (get operator :value)) (= [] (get operator :child-form-ids))
                      (= (get node :source) (sh08-ma-form-source form))
                      (= [(get operator :form-id) (get (get (get branch-nodes 0) :source) :form-id)
                          (get (get (get branch-nodes 1) :source) :form-id) (get (get (get branch-nodes 2) :source) :form-id)] ids)
                      (= (get form :form-id) (get operator :parent-form-id) (get condition-form :parent-form-id) (get then-form :parent-form-id) (get else-form :parent-form-id))
                      (= (get (get let-node :source) :form-id) (get form :parent-form-id))
                      (= scope (get node :binding-context) (get form :scope-id) (get operator :scope-id))
                      (= {:condition-child-index 0 :then-child-index 1 :else-child-index 2 :condition-evaluation :always-first
                          :branch-evaluation :exactly-one :truthiness {:false-values [:nil :false] :other-values :true}} (get node :attributes))
                      (= :condition-then-exclusive-branch (get (get node :evaluation) :kind))
                      (= [{:index 0 :core-node-id (get children 0)}] (get (get node :evaluation) :order))
                      (= {:core-node-id (get node :node-id) :kind :if :condition-node-id (get children 0)
                          :branches [{:role :then :predicate :truthy :core-node-id (get children 1)} {:role :else :predicate :falsey :core-node-id (get children 2)}]
                          :branch-exclusivity :exactly-one :truthiness {:false-values [:nil :false] :other-values :true} :result-policy :selected-branch} control)])
                  (let [then-node (get branch-nodes 1) then-ids (get then-node :children)
                        branch-call (if local-call?
                                      (if (sh08-sse-ids? then-ids 2)
                                        (sh08-vsl-call-body core let-node node then-node (get nodes (get then-ids 1)) nodes bindings forms )
                                        {:status :rejected :reason :vector-slice-source-mismatch})
                                      {:status :accepted})]
                    (if (= :accepted (get branch-call :status))
                      (let [witness (if local-call?
                                      (loop [remaining (rest (get branch-call :source-forms))
                                             out [form operator then-form else-form (get forms (get (get (get nodes (get then-ids 1)) :source) :form-id))]]
                                        (if (= 0 (count remaining)) out (recur (rest remaining) (conj out (first remaining)))))
                                      [form operator then-form else-form])]
                        (loop [i 0]
                    (if (= i 3)
                      {:status :accepted :root node :condition (get branch-nodes 0) :form form
                       :source-forms witness
                       :proof (let [proof {:kind :prefix-gate-if :node node :condition (get branch-nodes 0) :then (get branch-nodes 1) :else (get branch-nodes 2)
                               :control control :source-forms witness}]
                                 (if local-call? (assoc proof :kind :prefix-gate-call-if :then-call (get branch-call :proof)) proof))}
                      (let [child (get branch-nodes i) child-form (get selected-forms (+ i 2))
                            value (get (get child :attributes) :value)
                            expected-region (if (= i 0) region
                                              {:kind :conditional-branch :if-syntax-id (get form :syntax-id) :if-form-id (get form :form-id)
                                               :role (if (= i 1) :then :else) :execution :selected-exactly-once
                                               :parent-region-kind (if (map? region) (get region :kind) region)
                                               :parent-if-syntax-id (if (map? region) (get region :if-syntax-id) nil)
                                               :parent-branch-role (if (map? region) (get region :role) nil)})]
                        (if (if (if local-call? (= i 2) false) (if (boolean? value) (= false value) false) (if (if local-call? (= i 1) false) true (if (= i 0) true (if (boolean? value) (boolean? (get child-form :value)) false))))
                          (if (sh08-ft-all-true? [(= (get children i) (get child :node-id)) (= (get child :source) (sh08-ma-form-source child-form))
                                    (= scope (get child :binding-context) (get child-form :scope-id))
                                    (= owner (get (get child :evaluation) :owner-function-syntax-id))
                                    (= expected-region (get (get child :evaluation) :region))
                                    (if (if local-call? (= i 1) false) true (if (= i 0) true
                                      (sh08-ft-all-true? [(= :literal (get child :core-form)) (= :boolean (get child-form :kind))
                                            (= {:literal-kind :boolean :value value} (get child :attributes)) (= value (get child-form :value))
                                            (= [] (get child :children) (get child :resolved-binding-ids) (get child-form :child-form-ids))
                                            (= :value (get (get child :evaluation) :kind)) (= [] (get (get child :evaluation) :order))])))])
                            (recur (+ i 1)) {:status :rejected :reason :vector-slice-source-mismatch})
                            {:status :rejected :reason :vector-slice-source-mismatch})))))
                      branch-call))
                  {:status :rejected :reason :vector-slice-source-mismatch})
                {:status :rejected :reason :vector-slice-source-mismatch}))
                {:status :rejected :reason :vector-slice-source-mismatch}))
            {:status :rejected :reason :vector-slice-source-mismatch})))

(defn sh08-vsl-prefix-if [core let-node node nodes forms]
  ; Existing both-literal branch subset and its proof remains unchanged.
  (sh08-vsl-if-container core let-node node nodes {} forms false ))

(defn sh08-vsl-prefix-call-body [core let-node slice-node nodes bindings types forms]
  ; Exactly if -> then call -> this argument; its condition keeps its own slice proof.
  (let [ids (get let-node :children)]
    (if (sh08-sse-ids? ids 2)
        (let [root (get nodes (get ids 1))
              container (sh08-vsl-if-container core let-node root nodes bindings forms true )]
          (if (= :accepted (get container :status))
            (let [condition (get container :condition) condition-ids (get condition :children)]
              (if (sh08-sse-ids? condition-ids 3)
                (let [prefix (get nodes (get condition-ids 1)) prefix-ids (get prefix :children) tail-ids (get slice-node :children)
                      local-ids (get let-node :resolved-binding-ids)]
                  (if (if (sh08-sse-ids? prefix-ids 4) (if (sh08-sse-ids? tail-ids 4)
                        (if (sh08-sse-ids? local-ids 1)
                          (sh08-sse-ids? [(get prefix :node-id) (get (get prefix :source) :form-id) (get (get prefix :source) :syntax-id)
                                         (get slice-node :node-id) (get (get slice-node :source) :form-id)] 5) false) false) false)
                    (let [prefix-op (get nodes (get prefix-ids 0)) prefix-ref (get nodes (get prefix-ids 1))
                          tail-op (get nodes (get tail-ids 0)) tail-ref (get nodes (get tail-ids 1))]
                      (if (if (sh08-sse-ids? [(get (get prefix-op :attributes) :binding-id) (get (get tail-op :attributes) :binding-id)
                                            (get (get prefix-ref :attributes) :binding-id) (get (get tail-ref :attributes) :binding-id)] 4)
                            (symbol? (get (get prefix-op :attributes) :symbol)) false)
                        (if (sh08-ft-all-true?
                              [(= :call (get prefix :core-form)) (= false (= (get prefix :node-id) (get slice-node :node-id)))
                               (= (get slice-node :node-id) (get (get (get (get (get container :proof) :then-call) :call) :argument-node-ids) 0))
                               (contains? '#{subvec gravity.core/subvec} (get (get prefix-op :attributes) :symbol))
                               (= (get (get prefix-op :attributes) :binding-id) (get (get tail-op :attributes) :binding-id))
                               (= (get local-ids 0) (get (get prefix-ref :attributes) :binding-id) (get (get tail-ref :attributes) :binding-id))])
                          (let [comparison (sh08-vsl-let-equality-body core let-node prefix nodes bindings types forms )]
                            (if (= :accepted (get comparison :status))
                              {:status :accepted :node root :form (get container :form)
                               :source-forms (loop [remaining (get comparison :source-forms) out []]
                                               (if (= 0 (count remaining)) out
                                                 (let [form (first remaining)]
                                                   (recur (rest remaining) (if (= (get (get slice-node :source) :form-id) (get form :form-id)) out (conj out form))))))
                               :proof (assoc (get (get container :proof) :then-call)
                                             :kind :prefix-gated-local-function-slice-argument
                                             :condition-container (get container :proof) :prefix-comparison (get comparison :proof))}
                              comparison))
                          {:status :rejected :reason :vector-slice-source-mismatch})
                        {:status :rejected :reason :vector-slice-source-mismatch}))
                    {:status :rejected :reason :vector-slice-source-mismatch}))
                {:status :rejected :reason :vector-slice-source-mismatch}))
            container))
        {:status :rejected :reason :vector-slice-source-mismatch})))

(defn sh08-vsl-first-parent [core let-node node expected-id slice-node nodes bindings forms]
  ; Fixed original first edge; caller/root identity remains source-authenticated.
  (let [ids (get node :children)]
    (if (if (sh08-sse-ids? ids 2)
            (sh08-sse-ids? [(get node :node-id) expected-id (get (get node :source) :form-id)
                            (get (get node :source) :syntax-id)] 4)
            false)
      (let [operator (get nodes (get ids 0))
            bid (get (get operator :attributes) :binding-id)
            scope (get (get let-node :attributes) :body-scope-id)]
        (if (if (sh08-sse-ids? [(get operator :node-id) bid scope (get slice-node :node-id)] 4)
              (if (sh08-sse-ids? [(get (get operator :source) :form-id)
                                  (get (get operator :source) :syntax-id)
                                  (get (get slice-node :source) :form-id)
                                  (get (get slice-node :source) :syntax-id)] 4)
                (symbol? (get (get operator :attributes) :symbol))
                false)
              false)
          (let [binding (get bindings bid)
                owner (get forms (get (get node :source) :form-id))
                op-form (get forms (get (get operator :source) :form-id))
                profiles (get binding :profile-set)
                targets (get binding :target-set)
                region (get (get node :evaluation) :region)
                caller (get (get node :evaluation) :owner-function-syntax-id)]
            (if (if (sh08-sse-ids? [(get owner :form-id) (get owner :syntax-id)
                                    (get op-form :form-id) (get op-form :syntax-id)
                                    (get binding :definition-syntax-id)] 5)
                  (if (sh08-sse-ids? (get owner :child-form-ids) 2)
                    (if (if (symbol? (get binding :name)) (symbol? (get op-form :value)) false)
                      (if (if (vector? profiles) (vector? targets) false)
                        (if (loop [remaining profiles]
                              (if (= 0 (count remaining)) true
                                (if (keyword? (first remaining))
                                  (recur (rest remaining))
                                  false)))
                          (if (loop [remaining targets]
                                (if (= 0 (count remaining)) true
                                  (if (keyword? (first remaining))
                                    (recur (rest remaining))
                                    false)))
                            (if (keyword? region)
                              (if (= nil caller) true (sh08-sse-ids? [caller] 1))
                              false)
                            false)
                          false)
                        false)
                      false)
                    false)
                  false)
              (if (sh08-ft-all-true?
                    [(= :call (get node :core-form))
                     (= :reference (get operator :core-form))
                     (= [(get operator :node-id) (get slice-node :node-id)] ids)
                     (= (get node :node-id) expected-id)
                     (= [] (get operator :children))
                     (= [bid] (get node :resolved-binding-ids) (get operator :resolved-binding-ids))
                     (= {:symbol (get (get operator :attributes) :symbol) :position :operator :binding-id bid
                         :binding-class :core :definition-syntax-id (get binding :definition-syntax-id)}
                        (get operator :attributes))
                     (contains? '#{first gravity.core/first} (get (get operator :attributes) :symbol))
                     (= 'first (get binding :name))
                     (sh08-lq-binding? binding (get core :module))
                     (= {:operator-child-index 0 :argument-count 1 :argument-child-indexes [1]
                         :evaluation-order :operator-then-arguments :dispatch :resolved-symbol-call}
                        (get node :attributes))
                     (= :operator-then-arguments (get (get node :evaluation) :kind))
                     (= [{:index 0 :core-node-id (get operator :node-id)}
                         {:index 1 :core-node-id (get slice-node :node-id)}]
                        (get (get node :evaluation) :order))
                     (= [] (get (get operator :evaluation) :order))
                     (contains? #{:module-initialization :function-body} region)
                     (= region (get (get let-node :evaluation) :region)
                        (get (get slice-node :evaluation) :region))
                     (= caller (get (get slice-node :evaluation) :owner-function-syntax-id)
                              (get (get let-node :evaluation) :owner-function-syntax-id))
                     (= :list (get owner :kind))
                     (= :symbol (get op-form :kind))
                     (= [] (get op-form :child-form-ids))
                     (= (get (get operator :attributes) :symbol) (get op-form :value))
                     (= [(get op-form :form-id) (get (get slice-node :source) :form-id)]
                        (get owner :child-form-ids))
                     (= (get owner :form-id) (get op-form :parent-form-id))
                     (= (get node :source) (sh08-ma-form-source owner))
                     (= (get operator :source) (sh08-ma-form-source op-form))
                     (= scope (get node :binding-context) (get operator :binding-context)
                        (get owner :scope-id) (get op-form :scope-id))])
                {:status :accepted :node node :form owner :source-forms [owner op-form]
                 :proof {:kind :direct-vector-first :node node :operator operator :binding binding
                         :source-forms [owner op-form]}}
                {:status :rejected :reason :vector-slice-source-mismatch})
              {:status :rejected :reason :vector-slice-source-mismatch}))
          {:status :rejected :reason :vector-slice-source-mismatch}))
        {:status :rejected :reason :vector-slice-source-mismatch}))
      {:status :rejected :reason :vector-slice-source-mismatch})

(defn sh08-vsl-let-first-body [core let-node slice-node nodes bindings forms]
  ; The original direct-first entry retains its inputs and proof.
  (let [children (get let-node :children)]
    (if (sh08-sse-ids? children 2)
        (sh08-vsl-first-parent core let-node (get nodes (get children 1)) (get children 1) slice-node nodes bindings forms )
        {:status :rejected :reason :vector-slice-source-mismatch})))

(defn sh08-vsl-character-set [node parent scope region caller nodes forms]
  ; Original flat Character Set source only; this emits no member-type fact.
  (let [ids (get node :children) n (if (vector? ids) (count ids) 0)]
    (if (if (sh08-sse-ids? [(get node :node-id) (get (get node :source) :form-id) (get (get node :source) :syntax-id) parent scope] 5)
              (if (keyword? region) (if (if (= nil caller) true (sh08-sse-ids? [caller] 1))
                (if (vector? ids) (loop [remaining ids] (if (= 0 (count remaining)) true
                  (if (sh08-sse-ids? [(first remaining)] 1) (recur (rest remaining)) false))) false) false) false) false)
          (let [form (get forms (get (get node :source) :form-id)) attrs (get node :attributes)
                values (get form :value) source-values (get attrs :source-value) source-ids (get form :child-form-ids)
                node-caller (get (get node :evaluation) :owner-function-syntax-id)]
            (if (if (sh08-sse-ids? [(get form :form-id) (get form :syntax-id) (get form :parent-form-id) (get form :scope-id)] 4)
                  (if (if (= nil node-caller) true (sh08-sse-ids? [node-caller] 1))
                    (if (if (vector? source-ids) (= n (count source-ids)) false)
                      (if (loop [remaining source-ids] (if (= 0 (count remaining)) true
                            (if (sh08-sse-ids? [(first remaining)] 1) (recur (rest remaining)) false)))
                        (if (if (set? values) (set? source-values) false)
                          (if (if (<= (count values) n) (<= (count source-values) n) false)
                            (if (loop [members (vec values) i 0] (if (= i (count members)) true
                                  (if (char? (get members i)) (recur members (+ i 1)) false)))
                              (loop [members (vec source-values) i 0] (if (= i (count members)) true
                                (if (char? (get members i)) (recur members (+ i 1)) false))) false) false) false) false) false) false) false)
              (if (sh08-ft-all-true? [
                    (contains? #{:module-initialization :function-body} region)
                    (= :collection-literal (get node :core-form)) (= [] (get node :resolved-binding-ids))
                    (= {:literal-kind :set :element-count n :source-value source-values} attrs)
                    (= :left-to-right (get (get node :evaluation) :kind))
                    (= (loop [i 0 out []] (if (= i n) out (recur (+ i 1) (conj out {:index i :core-node-id (get ids i)}))))
                       (get (get node :evaluation) :order))
                    (= scope (get node :binding-context) (get form :scope-id))
                    (= region (get (get node :evaluation) :region)) (= caller node-caller)
                    (= :set (get form :kind)) (= parent (get form :parent-form-id))
                    (= (get node :source) (sh08-ma-form-source form))])
                (loop [i 0 selected [form] members [] seen #{} seen-forms #{(get form :form-id)}]
                  (if (= i n)
                    ; L1/C2 uniqueness is checked after the complete physical Character census.
                    (if (if (= n (count values) (count source-values)) (= (set members) values source-values) false)
                      {:status :accepted :node node :form form :source-forms selected}
                      {:status :rejected :reason :vector-slice-source-mismatch})
                    (let [id (get ids i) child (get nodes id) source (get child :source)]
                      (if (if (sh08-sse-ids? [id (get child :node-id) (get source :form-id) (get source :syntax-id)] 4)
                            (if (= false (contains? seen id)) (= false (contains? seen-forms (get source :form-id))) false) false)
                        (let [original (get forms (get source :form-id)) value (get (get child :attributes) :value)
                              child-caller (get (get child :evaluation) :owner-function-syntax-id)]
                          (if (if (sh08-sse-ids? [(get original :form-id) (get original :syntax-id) (get original :parent-form-id) (get original :scope-id)] 4)
                                (if (if (= nil child-caller) true (sh08-sse-ids? [child-caller] 1))
                                  (if (char? value) (char? (get original :value)) false) false) false)
                            (if (sh08-ft-all-true? [
                                  (= id (get child :node-id)) (= (get source-ids i) (get original :form-id))
                                  (= :literal (get child :core-form)) (= {:literal-kind :character :value value} (get child :attributes))
                                  (= [] (get child :children) (get child :resolved-binding-ids) (get original :child-form-ids))
                                  (= :character (get original :kind)) (= value (get original :value))
                                  (= source (sh08-ma-form-source original)) (= (get form :form-id) (get original :parent-form-id))
                                  (= scope (get child :binding-context) (get original :scope-id))
                                  (= :value (get (get child :evaluation) :kind)) (= [] (get (get child :evaluation) :order))
                                  (= region (get (get child :evaluation) :region)) (= caller child-caller)])
                              (recur (+ i 1) (conj selected original) (conj members value) (conj seen id) (conj seen-forms (get source :form-id)))
                              {:status :rejected :reason :vector-slice-source-mismatch})
                            {:status :rejected :reason :vector-slice-source-mismatch}))
                        {:status :rejected :reason :vector-slice-source-mismatch}))))
                {:status :rejected :reason :vector-slice-source-mismatch})
              {:status :rejected :reason :vector-slice-source-mismatch}))
          {:status :rejected :reason :vector-slice-source-mismatch})))

(defn sh08-vsl-let-first-membership-body [core let-node slice-node nodes bindings forms]
  ; Exactly contains?(original Character Set, first(actual slice)); no ancestry walk.
  (let [root-ids (get let-node :children)]
    (if (sh08-sse-ids? root-ids 2)
        (let [node (get nodes (get root-ids 1)) children (get node :children)]
          (if (if (sh08-sse-ids? children 3)
                (sh08-sse-ids? [(get node :node-id) (get (get node :source) :form-id) (get (get node :source) :syntax-id)] 3) false)
            (let [operator (get nodes (get children 0)) items (get nodes (get children 1)) first-node (get nodes (get children 2))
                  bid (get (get operator :attributes) :binding-id) scope (get (get let-node :attributes) :body-scope-id)]
              (if (if (sh08-sse-ids? [(get operator :node-id) bid (get items :node-id) (get first-node :node-id) scope] 5)
                    (if (sh08-sse-ids? [(get (get operator :source) :form-id) (get (get operator :source) :syntax-id)
                               (get (get items :source) :form-id) (get (get items :source) :syntax-id)
                               (get (get first-node :source) :form-id) (get (get first-node :source) :syntax-id)] 6)
                      (symbol? (get (get operator :attributes) :symbol)) false) false)
                (let [binding (get bindings bid) owner (get forms (get (get node :source) :form-id))
                      op-form (get forms (get (get operator :source) :form-id)) first-form (get forms (get (get first-node :source) :form-id))
                      profiles (get binding :profile-set) targets (get binding :target-set)
                      region (get (get node :evaluation) :region) caller (get (get node :evaluation) :owner-function-syntax-id)
                      first-caller (get (get first-node :evaluation) :owner-function-syntax-id)]
                  (if (if (sh08-sse-ids? [(get owner :form-id) (get owner :syntax-id) (get op-form :form-id) (get op-form :syntax-id)
                                   (get first-form :form-id) (get first-form :syntax-id)] 6)
                          (if (sh08-sse-ids? [(get binding :definition-syntax-id) (get first-form :parent-form-id) (get first-form :scope-id)
                                     (get owner :scope-id) (get op-form :scope-id)] 5)
                            (if (sh08-sse-ids? (get owner :child-form-ids) 3)
                              (if (if (symbol? (get binding :name)) (symbol? (get op-form :value)) false)
                                (if (if (vector? profiles) (vector? targets) false)
                                  (if (loop [remaining profiles] (if (= 0 (count remaining)) true
                                        (if (keyword? (first remaining)) (recur (rest remaining)) false)))
                                    (if (loop [remaining targets] (if (= 0 (count remaining)) true
                                          (if (keyword? (first remaining)) (recur (rest remaining)) false)))
                                      (if (keyword? region) (if (if (= nil caller) true (sh08-sse-ids? [caller] 1))
                                        (if (= nil first-caller) true (sh08-sse-ids? [first-caller] 1)) false) false) false) false) false) false) false) false) false)
                      (if (sh08-ft-all-true? [
                            (= :call (get node :core-form)) (= :reference (get operator :core-form))
                            (= (get node :node-id) (get root-ids 1))
                            (= [(get operator :node-id) (get items :node-id) (get first-node :node-id)] children)
                            (= [] (get operator :children)) (= [bid] (get node :resolved-binding-ids) (get operator :resolved-binding-ids))
                            (= {:symbol (get (get operator :attributes) :symbol) :position :operator :binding-id bid :binding-class :core
                                :definition-syntax-id (get binding :definition-syntax-id)} (get operator :attributes))
                            (contains? '#{contains? gravity.core/contains?} (get (get operator :attributes) :symbol))
                            (= 'contains? (get binding :name)) (sh08-mc-binding? binding (get core :module))
                            (= {:operator-child-index 0 :argument-count 2 :argument-child-indexes [1 2]
                                :evaluation-order :operator-then-arguments :dispatch :resolved-symbol-call} (get node :attributes))
                            (= :operator-then-arguments (get (get node :evaluation) :kind))
                            (= [{:index 0 :core-node-id (get operator :node-id)} {:index 1 :core-node-id (get items :node-id)}
                                {:index 2 :core-node-id (get first-node :node-id)}] (get (get node :evaluation) :order))
                            (= [] (get (get operator :evaluation) :order))
                            (contains? #{:module-initialization :function-body} region)
                            (= region (get (get first-node :evaluation) :region)) (= caller first-caller)
                            (= :list (get owner :kind)) (= :symbol (get op-form :kind)) (= [] (get op-form :child-form-ids))
                            (= (get (get operator :attributes) :symbol) (get op-form :value))
                            (= [(get op-form :form-id) (get (get items :source) :form-id) (get first-form :form-id)] (get owner :child-form-ids))
                            (= (get owner :form-id) (get op-form :parent-form-id) (get first-form :parent-form-id))
                            (= (get node :source) (sh08-ma-form-source owner)) (= (get operator :source) (sh08-ma-form-source op-form))
                            (= (get first-node :source) (sh08-ma-form-source first-form))
                            (= scope (get node :binding-context) (get operator :binding-context) (get first-node :binding-context)
                                     (get owner :scope-id) (get op-form :scope-id) (get first-form :scope-id))])
                        (let [literal (sh08-vsl-character-set items (get owner :form-id) scope region caller nodes forms )]
                          (if (= :accepted (get literal :status))
                            (let [first-parent (sh08-vsl-first-parent core let-node first-node (get children 2) slice-node nodes bindings forms )]
                              (if (= :accepted (get first-parent :status))
                                (let [container-forms (loop [remaining (get literal :source-forms) out [owner op-form]]
                                                        (if (= 0 (count remaining)) out (recur (rest remaining) (conj out (first remaining)))))
                                      selected (loop [remaining (get first-parent :source-forms) out container-forms]
                                                 (if (= 0 (count remaining)) out (recur (rest remaining) (conj out (first remaining)))))]
                                  {:status :accepted :node node :form owner :source-forms selected
                                   :proof (assoc (get first-parent :proof) :kind :direct-character-set-first-membership :source-forms selected
                                            :membership-container {:kind :character-set-membership :node node :operator operator :binding binding
                                                                   :set-node items :source-forms container-forms})})
                                first-parent))
                            literal))
                        {:status :rejected :reason :vector-slice-source-mismatch})
                      {:status :rejected :reason :vector-slice-source-mismatch}))
                {:status :rejected :reason :vector-slice-source-mismatch}))
            {:status :rejected :reason :vector-slice-source-mismatch}))
        {:status :rejected :reason :vector-slice-source-mismatch})))

(defn sh08-vsl-let-call-body [core let-node slice-node nodes bindings forms]
  ; Retain the original direct let/body proof.
  (let [ids (get let-node :children)]
    (if (sh08-sse-ids? ids 2)
        (sh08-vsl-call-body core let-node let-node (get nodes (get ids 1)) slice-node nodes bindings forms )
        {:status :rejected :reason :vector-slice-source-mismatch})))

(defn sh08-vsl-let-equality-body [core let-node slice-node nodes bindings types forms]
  ; One fixed parent edge. The enclosing VE still proves its own operand domain.
  (let [children (get let-node :children)]
    (if (sh08-sse-ids? children 2)
        (let [root (get nodes (get children 1)) first-consumer? (if (vector? (get root :children)) (= 2 (count (get root :children))) false)
              membership-consumer? (if (sh08-sse-ids? (get root :children) 3)
                                     (let [left (get nodes (get (get root :children) 1))]
                                       (if (= :collection-literal (get left :core-form)) (= :set (get (get left :attributes) :literal-kind)) false)) false)
              local-call-consumer? (if (sh08-sse-ids? (get root :children) 2)
                                  (let [operator (get nodes (get (get root :children) 0))
                                        bid (get (get operator :attributes) :binding-id)]
                                    (if (sh08-sse-ids? [bid] 1)
                                      (= [:namespace :function] [(get (get bindings bid) :binding-class) (get (get bindings bid) :kind)]) false)) false)
              conditional? (= :if (get root :core-form))
              then-node (if (if conditional? (sh08-sse-ids? (get root :children) 3) false)
                          (get nodes (get (get root :children) 1)) nil)
              then-ids (get then-node :children)
              call-branch? (if (sh08-sse-ids? then-ids 2) (= :call (get then-node :core-form)) false)
              conditional-call-consumer? (if call-branch? (if (sh08-sse-ids? [(get slice-node :node-id)] 1)
                                            (= (get slice-node :node-id) (get then-ids 1)) false) false)
              container (if conditional? (if conditional-call-consumer? nil
                          (if call-branch? (sh08-vsl-if-container core let-node root nodes bindings forms true )
                            (sh08-vsl-prefix-if core let-node root nodes forms ))) nil)
              node (if conditional? (get container :condition) root) children (get node :children)]
          (if conditional-call-consumer?
            (sh08-vsl-prefix-call-body core let-node slice-node nodes bindings types forms )
            (if local-call-consumer?
            (sh08-vsl-let-call-body core let-node slice-node nodes bindings forms )
            (if first-consumer?
            (sh08-vsl-let-first-body core let-node slice-node nodes bindings forms )
            (if membership-consumer?
              (sh08-vsl-let-first-membership-body core let-node slice-node nodes bindings forms )
              (if (if conditional? (= :accepted (get container :status)) true)
            (if (if (sh08-sse-ids? children 3)
                (sh08-sse-ids? [(get node :node-id) (get (get node :source) :form-id) (get (get node :source) :syntax-id)] 3) false)
            (let [operator (get nodes (get children 0)) right (get nodes (get children 2))
                  ids (get right :children) n (if (vector? ids) (count ids) 0)
                  bid (get (get operator :attributes) :binding-id)]
              (if (if (if (vector? ids)
                              (loop [remaining ids] (if (= 0 (count remaining)) true
                                (if (sh08-sse-ids? [(first remaining)] 1) (recur (rest remaining)) false))) false)
                        (if (sh08-sse-ids? [(get operator :node-id) (get right :node-id) bid] 3)
                          (if (sh08-sse-ids? [(get (get operator :source) :form-id) (get (get operator :source) :syntax-id)
                                     (get (get right :source) :form-id) (get (get right :source) :syntax-id)] 4)
                            (symbol? (get (get operator :attributes) :symbol)) false) false) false)
                    (let [owner (get forms (get (get node :source) :form-id))
                          op-form (get forms (get (get operator :source) :form-id))
                          right-form (get forms (get (get right :source) :form-id)) binding (get bindings bid)
                          values (get right-form :value) attrs (get right :attributes) source-values (get attrs :source-value)
                          scope (get (get let-node :attributes) :body-scope-id)
                          profiles (get binding :profile-set) targets (get binding :target-set)]
                      (if (if (sh08-sse-ids? [(get owner :form-id) (get owner :syntax-id) (get op-form :form-id) (get op-form :syntax-id)
                                     (get right-form :form-id) (get right-form :syntax-id)] 6)
                            (if (sh08-sse-ids? (get owner :child-form-ids) 3)
                              (if (if (vector? (get right-form :child-form-ids))
                                    (if (= n (count (get right-form :child-form-ids)))
                                      (loop [remaining (get right-form :child-form-ids)] (if (= 0 (count remaining)) true
                                        (if (sh08-sse-ids? [(first remaining)] 1) (recur (rest remaining)) false))) false) false)
                                (if (if (vector? values) (vector? source-values) false)
                                  (if (sh08-sse-ids? [scope (get binding :definition-syntax-id)] 2)
                                    (if (if (symbol? (get op-form :value)) (symbol? (get binding :name)) false)
                                      (if (if (vector? profiles) (vector? targets) false)
                                        (if (loop [remaining profiles] (if (= 0 (count remaining)) true
                                              (if (keyword? (first remaining)) (recur (rest remaining)) false)))
                                          (if (loop [remaining targets] (if (= 0 (count remaining)) true
                                                (if (keyword? (first remaining)) (recur (rest remaining)) false)))
                                            (= n (count values) (count source-values)) false) false) false) false) false) false) false) false) false)
                        (if (sh08-ft-all-true? [
                              (= :call (get node :core-form)) (= :reference (get operator :core-form))
                              (= [(get operator :node-id) (get slice-node :node-id) (get right :node-id)] children)
                              (= [bid] (get node :resolved-binding-ids) (get operator :resolved-binding-ids))
                              (= [] (get operator :children))
                              (= {:symbol (get (get operator :attributes) :symbol) :position :operator :binding-id bid :binding-class :core
                                  :definition-syntax-id (get binding :definition-syntax-id)} (get operator :attributes))
                              (contains? '#{= gravity.core/=} (get (get operator :attributes) :symbol))
                              (sh08-ae-binding? binding (get core :module))
                              (= {:operator-child-index 0 :argument-count 2 :argument-child-indexes [1 2]
                                  :evaluation-order :operator-then-arguments :dispatch :resolved-symbol-call} (get node :attributes))
                              (= :operator-then-arguments (get (get node :evaluation) :kind))
                              (= [{:index 0 :core-node-id (get operator :node-id)} {:index 1 :core-node-id (get slice-node :node-id)}
                                  {:index 2 :core-node-id (get right :node-id)}] (get (get node :evaluation) :order))
                              (= (get (get node :evaluation) :owner-function-syntax-id) (get (get slice-node :evaluation) :owner-function-syntax-id))
                              (= :list (get owner :kind)) (= :symbol (get op-form :kind))
                              (symbol? (get op-form :value)) (= (get (get operator :attributes) :symbol) (get op-form :value))
                              (= [] (get op-form :child-form-ids))
                              (= [(get op-form :form-id) (get (get slice-node :source) :form-id) (get right-form :form-id)] (get owner :child-form-ids))
                              (= (get owner :form-id) (get op-form :parent-form-id) (get right-form :parent-form-id))
                              (= (get node :source) (sh08-ma-form-source owner)) (= (get operator :source) (sh08-ma-form-source op-form))
                              (= (get right :source) (sh08-ma-form-source right-form))
                              (= scope (get node :binding-context) (get operator :binding-context) (get right :binding-context)
                                       (get owner :scope-id) (get op-form :scope-id) (get right-form :scope-id))
                              (= :collection-literal (get right :core-form)) (= [] (get right :resolved-binding-ids))
                              (= :vector (get right-form :kind))
                              (= {:literal-kind :vector :element-count n :source-value source-values} attrs)
                              (= :left-to-right (get (get right :evaluation) :kind))
                              (= (loop [i 0 out []] (if (= i n) out (recur (+ i 1) (conj out {:index i :core-node-id (get ids i)}))))
                                 (get (get right :evaluation) :order))])
                          (loop [i 0 selected (loop [remaining (if conditional? (get container :source-forms) []) out [owner op-form right-form]]
                                               (if (= 0 (count remaining)) out (recur (rest remaining) (conj out (first remaining))))) members [] seen #{} seen-forms #{(get right-form :form-id)}]
                            (if (= i n)
                              (let [expected {:kind :gravity.type/vector :shape :literal :element-types members}
                                    actual (get types (get right :node-id) :gravity.type/unknown)]
                                ; A cold left operand cannot borrow a future RHS type. VE must establish it later.
                                (if (if (= :gravity.type/unknown actual) true (= expected actual))
                                  {:status :accepted :node (if conditional? root node) :form (if conditional? (get container :form) owner) :source-forms selected
                                   :proof (let [proof {:kind :direct-left-vector-equality :node node :operator operator :binding binding :right right
                                           :literal-type expected :source-forms selected}] (if conditional? (assoc proof :condition-container (get container :proof)) proof))}
                                  {:status :rejected :reason :vector-slice-source-mismatch}))
                              (let [id (get ids i) child (get nodes id) source (get child :source)]
                                (if (if (sh08-sse-ids? [id (get source :form-id) (get source :syntax-id)] 3)
                                      (if (= false (contains? seen id)) (= false (contains? seen-forms (get source :form-id))) false) false)
                                  (let [form (get forms (get source :form-id)) value (get (get child :attributes) :value)
                                        kind (get (get child :attributes) :literal-kind)
                                        valid? (if (sh08-sse-ids? [(get form :form-id) (get form :syntax-id) (get form :parent-form-id) (get form :scope-id)] 4)
                                                 (if (= :integer kind)
                                                 (if (integer? value) (if (integer? (get form :value))
                                                   (if (integer? (get values i)) (integer? (get source-values i)) false) false) false)
                                                 (if (= :character kind) (if (char? value) (if (char? (get form :value))
                                                   (if (char? (get values i)) (char? (get source-values i)) false) false) false) false)) false)]
                                    (if (if valid? (sh08-ft-all-true? [
                                          (= id (get child :node-id)) (= (get (get right-form :child-form-ids) i) (get form :form-id))
                                          (= :literal (get child :core-form)) (= {:literal-kind kind :value value} (get child :attributes))
                                          (= [] (get child :children) (get child :resolved-binding-ids) (get form :child-form-ids))
                                          (= kind (get form :kind)) (= source (sh08-ma-form-source form))
                                          (= value (get form :value) (get values i) (get source-values i))
                                          (= (get right-form :form-id) (get form :parent-form-id)) (= scope (get form :scope-id))
                                          (= :value (get (get child :evaluation) :kind)) (= [] (get (get child :evaluation) :order))]) false)
                                      (recur (+ i 1) (conj selected form) (conj members (if (= :integer kind) :gravity.type/integer :gravity.type/character))
                                             (conj seen id) (conj seen-forms (get source :form-id)))
                                      {:status :rejected :reason :vector-slice-source-mismatch}))
                                  {:status :rejected :reason :vector-slice-source-mismatch}))))
                        {:status :rejected :reason :vector-slice-source-mismatch})
                    {:status :rejected :reason :vector-slice-source-mismatch}))
            {:status :rejected :reason :vector-slice-source-mismatch}))
            {:status :rejected :reason :vector-slice-source-mismatch})
            container))))))
        {:status :rejected :reason :vector-slice-source-mismatch})))

(defn sh08-vsl-parameter [core slice-node reference nodes bindings types forms]
  ; The owning function slot is an existing typing premise. Whole-product C7
  ; verification dominates the cold C8/lowering consumers of this local rule.
  (let [records (get core :function-records) mutations (get core :mutations [])
        owner (get (get reference :evaluation) :owner-function-syntax-id)
        bid (get (get reference :attributes) :binding-id)]
    (if (= nil owner) {:status :not-applicable}
        (if (if (if (vector? records) (vector? mutations) false)
              (sh08-sse-ids? [owner bid (get reference :node-id)] 3) false)
          (if (loop [rows records]
                (if (= 0 (count rows)) true
                  (if (sh08-sse-ids? [(get (first rows) :function-syntax-id) (get (first rows) :function-core-node-id)] 2)
                    (recur (rest rows)) false)))
            (let [record (sh08-nq-one records :function-syntax-id owner)
                  params (get record :parameter-binding-ids)]
              (if (if (sh08-sse-ids? params 1) (= [bid] params) false)
                (let [fn-node (get nodes (get record :function-core-node-id))
                      function (get types (get record :function-core-node-id))
                      parameters (get function :parameters)
                      slot (if (vector? parameters) (if (= 1 (count parameters)) (get parameters 0) nil) nil)
                      binding (get bindings bid) type (get types (get reference :node-id))
                      members (if (map? type) (get type :element-types) nil)
                      n (if (vector? members) (count members) 0)]
                    (let [validation (sh08-lc-validate-types [type (get slot :type)])]
                        (if (= false (= :accepted (get validation :status)))
                          {:status :rejected :reason :vector-slice-receiver-proof-required}
                          (if (if (sh08-sse-ids? [(get (get fn-node :source) :form-id) (get (get fn-node :source) :syntax-id)
                                      (get (get fn-node :attributes) :parameter-form-id) (get binding :definition-syntax-id)
                                      (get binding :scope-id) (get reference :binding-context)] 6)
                                (sh08-sse-ids? [(get (get reference :source) :form-id) (get (get reference :source) :syntax-id)
                                      (get (get slice-node :source) :form-id) (get slice-node :node-id)] 4) false)
                            (let [fn-form (get forms (get (get fn-node :source) :form-id))
                                  ids (get fn-form :child-form-ids)
                                  parameter-form (get forms (get (get fn-node :attributes) :parameter-form-id))
                                  names (get parameter-form :child-form-ids)]
                              (if (if (sh08-sse-ids? ids 3) (sh08-sse-ids? names 1) false)
                                (let [operator (get forms (get ids 0)) name-form (get forms (get names 0))
                                      ref-form (get forms (get (get reference :source) :form-id))
                                      scope (get binding :scope-id)]
                                  (if (if (symbol? (get binding :name))
                                        (if (= nil (get binding :mutability)) true (keyword? (get binding :mutability))) false)
                                  (if (sh08-ft-all-true?
                                        [(= :accepted (get validation :status))
                                         (= {:kind :gravity.type/vector :shape :literal :element-types members} type)
                                         (= :gravity/c7-function-type (get function :artifact))
                                         (= :inferred (get function :status))
                                         (= owner (get function :function-id) (get record :function-syntax-id) (get fn-form :syntax-id))
                                         (= (get record :function-core-node-id) (get fn-node :node-id) (get function :function-core-node-id))
                                         (sh08-sse-ids? (get function :parameter-binding-ids) 1)
                                         (sh08-sse-ids? (get fn-node :resolved-binding-ids) 1)
                                         (= params (get function :parameter-binding-ids) (get fn-node :resolved-binding-ids))
                                         (= 1 (get function :fixed-arity) (get record :fixed-arity))
                                         (= nil (get record :signature) (get function :signature) (get (get fn-node :attributes) :signature))
                                         (= :fn (get fn-node :core-form)) (sh08-sse-ids? (get fn-node :children) 1)
                                         (= [(get slice-node :node-id)] (get fn-node :children))
                                         (= :call (get (get nodes (get (get slice-node :children) 3)) :core-form))
                                         (= (get slice-node :node-id) (get record :body-core-node-id) (get function :body-core-node-id))
                                         (= :list (get fn-form :kind)) (= :symbol (get operator :kind)) (= 'fn (get operator :value))
                                         (= [] (get operator :child-form-ids))
                                         (= [(get operator :form-id) (get parameter-form :form-id) (get (get slice-node :source) :form-id)] ids)
                                         (= (get fn-form :form-id) (get record :function-form-id) (get operator :parent-form-id)
                                              (get parameter-form :parent-form-id) (get (get forms (get (get slice-node :source) :form-id)) :parent-form-id))
                                         (= :vector (get parameter-form :kind))
                                         (= (get parameter-form :syntax-id) (get (get fn-node :attributes) :parameter-syntax-id))
                                         (= (get parameter-form :form-id) (get name-form :parent-form-id))
                                         (= :symbol (get name-form :kind) (get ref-form :kind))
                                         (= [] (get name-form :child-form-ids) (get ref-form :child-form-ids))
                                         (symbol? (get binding :name))
                                         (if (vector? (get parameter-form :value)) (= 1 (count (get parameter-form :value))) false)
                                         (if (vector? (get (get fn-node :attributes) :parameters)) (= 1 (count (get (get fn-node :attributes) :parameters))) false)
                                         (= [(get binding :name)] (get parameter-form :value) (get (get fn-node :attributes) :parameters))
                                         (= (get binding :name) (get name-form :value) (get ref-form :value))
                                         (= (get binding :definition-syntax-id) (get name-form :syntax-id))
                                         (= [:lexical :local] [(get binding :binding-class) (get binding :kind)])
                                         (= bid (get binding :binding-id) (get slot :binding-id))
                                         (if (vector? (get function :parameters)) (= 1 (count (get function :parameters))) false)
                                         (if (map? slot) (if (= 2 (count slot))
                                           (if (loop [fields (keys slot)] (if (= 0 (count fields)) true
                                                 (if (keyword? (first fields)) (recur (rest fields)) false)))
                                             (= #{:binding-id :type} (set (keys slot))) false) false) false)
                                         (= type (get slot :type))
                                         (contains? #{nil :immutable} (get binding :mutability))
                                         (= :reference (get reference :core-form)) (= [] (get reference :children))
                                         (= [bid] (get reference :resolved-binding-ids))
                                         (= {:symbol (get binding :name) :position :expression :binding-id bid :binding-class :lexical
                                             :definition-syntax-id (get binding :definition-syntax-id)} (get reference :attributes))
                                         (= (get reference :source) (sh08-ma-form-source ref-form))
                                         (= (get fn-node :source) (sh08-ma-form-source fn-form))
                                         (= scope (get name-form :scope-id) (get ref-form :scope-id) (get reference :binding-context)
                                                  (get slice-node :binding-context))
                                         (= :function-body (get (get reference :evaluation) :region) (get (get slice-node :evaluation) :region))
                                         (= owner (get (get slice-node :evaluation) :owner-function-syntax-id))
                                         (= :value (get (get reference :evaluation) :kind)) (= [] (get (get reference :evaluation) :order))
                                         (loop [rows mutations]
                                           (if (= 0 (count rows)) true
                                             (if (= bid (get (first rows) :target-binding-id)) false (recur (rest rows)))))])
                                    {:status :accepted :type type
                                     :source-forms [fn-form operator parameter-form name-form]
                                     :receiver {:kind :immutable-parameter-vector :reference reference :binding binding :record record
                                                :owner fn-node :parameter-index 0 :parameter-type type}}
                                    {:status :rejected :reason :vector-slice-source-mismatch})
                                  {:status :rejected :reason :vector-slice-source-mismatch}))
                                {:status :rejected :reason :vector-slice-source-mismatch}))
                            {:status :rejected :reason :vector-slice-source-mismatch}))))
                {:status :not-applicable}))
            {:status :rejected :reason :vector-slice-source-mismatch})
          {:status :rejected :reason :vector-slice-source-mismatch}))))

(defn sh08-vsl-let [core slice-node reference nodes bindings types forms]
  ; One immutable binding, a direct slice or fixed left equality consumer; no parameter origin.
  (let [records (get core :lexical-bindings []) mutations (get core :mutations [])
      bid (get (get reference :attributes) :binding-id)]
    (if (if (if (vector? records) (vector? mutations) false)
          (if (sh08-sse-ids? [(get reference :node-id) (get (get reference :source) :form-id) (get (get reference :source) :syntax-id) bid (get slice-node :node-id)] 5)
            (sh08-sse-ids? [(get (get slice-node :source) :form-id) (get (get slice-node :source) :syntax-id)] 2) false) false)
        (if (if (loop [rows records] (if (= 0 (count rows)) true
                (if (sh08-sse-ids? [(get (first rows) :binding-id) (get (first rows) :let-core-node-id)] 2) (recur (rest rows)) false)))
            (loop [rows mutations] (if (= 0 (count rows)) true
                (if (= nil (get (first rows) :target-binding-id)) (recur (rest rows))
                  (if (sh08-sse-ids? [(get (first rows) :target-binding-id)] 1) (recur (rest rows)) false)))) false)
          (let [record (sh08-nq-one records :binding-id bid) ]
            (if (map? record)
              (if (if (sh08-sse-ids? [(get record :let-core-node-id) (get record :initializer-node-id) (get record :definition-form-id) (get record :definition-syntax-id) (get record :initializer-form-id) (get record :initializer-syntax-id)] 6)
                  (sh08-sse-ids? [(get record :binding-scope-id) (get record :initializer-scope-id)] 2) false)
                (let [let-node (get nodes (get record :let-core-node-id)) initializer (get nodes (get record :initializer-node-id))
                    binding (get bindings bid) ref-form (get forms (get (get reference :source) :form-id))
                    slice-form (get forms (get (get slice-node :source) :form-id))
                    name-form (get forms (get record :definition-form-id)) init-form (get forms (get record :initializer-form-id)) ]
                  (if (if (sh08-sse-ids? [(get (get let-node :source) :form-id) (get (get let-node :source) :syntax-id)
                          (get (get let-node :attributes) :binding-vector-form-id) (get (get let-node :attributes) :binding-vector-syntax-id) (get binding :definition-syntax-id)] 5)
                      (if (sh08-sse-ids? [(get let-node :node-id) (get initializer :node-id) (get binding :binding-id)] 3)
                        (symbol? (get binding :name)) false) false)
                    (let [let-form (get forms (get (get let-node :source) :form-id))
                        vector-form (get forms (get (get let-node :attributes) :binding-vector-form-id))
                        bridge (if (= (get slice-node :node-id) (get (get let-node :children) 1))
                                 {:status :accepted :node slice-node :form slice-form :source-forms []}
                                 (sh08-vsl-let-equality-body core let-node slice-node nodes bindings types forms ))
                        root-node (get bridge :node) root-form (get bridge :form)]
                      (if (= :accepted (get bridge :status))
                        (if (sh08-ft-all-true? [(sh08-sse-ids? [(get ref-form :form-id) (get ref-form :syntax-id) (get name-form :form-id) (get name-form :syntax-id) (get init-form :form-id) (get init-form :syntax-id)] 6)
                            (sh08-sse-ids? [(get slice-form :form-id) (get slice-form :syntax-id) (get let-form :form-id) (get let-form :syntax-id) (get vector-form :form-id) (get vector-form :syntax-id)] 6)])
                        (if (if (sh08-sse-ids? (get let-form :child-form-ids) 3)
                            (if (sh08-sse-ids? (get vector-form :child-form-ids) 2)
                              (if (sh08-sse-ids? [(get ref-form :scope-id) (get name-form :scope-id) (get slice-form :scope-id) (get init-form :scope-id) (get let-form :scope-id) (get binding :scope-id)] 6)
                                (sh08-sse-ids? [(get (get let-node :attributes) :outer-scope-id) (get (get let-node :attributes) :body-scope-id) (get reference :binding-context) (get initializer :binding-context) (get let-node :binding-context) (get slice-node :binding-context)] 6) false) false) false)
                          (let [op-form (get forms (get (get let-form :child-form-ids) 0))
                              body (get record :binding-scope-id) outer (get record :initializer-scope-id)
                        bound-forms (loop [remaining (get bridge :source-forms) out [ref-form let-form op-form vector-form name-form]]
                                      (if (= 0 (count remaining)) out (recur (rest remaining) (conj out (first remaining)))))  ]
                            (if (sh08-ft-all-true? [(sh08-sse-ids? [(get op-form :form-id) (get op-form :syntax-id)] 2)
                                  (symbol? (get op-form :value)) (symbol? (get ref-form :value)) (symbol? (get name-form :value))
                                  (symbol? (get record :name)) (symbol? (get (get reference :attributes) :symbol))])
                              (if (sh08-ft-all-true? [
                                    (= [:lexical :local] [(get binding :binding-class) (get binding :kind)])
                                    (= bid (get binding :binding-id))
                                    (if (= nil (get binding :mutability)) true (= :immutable (get binding :mutability)))
                                    (= :reference (get reference :core-form))
                                    (= [] (get reference :children))
                                    (= [bid] (get reference :resolved-binding-ids))
                                    (= {:symbol (get binding :name) :position :expression :binding-id bid :binding-class :lexical :definition-syntax-id (get binding :definition-syntax-id)} (get reference :attributes))
                                    (= :symbol (get ref-form :kind) (get name-form :kind))
                                    (= (get binding :name) (get ref-form :value) (get name-form :value) (get record :name))
                                    (= [] (get ref-form :child-form-ids) (get name-form :child-form-ids))
                                    (= (get reference :source) (sh08-ma-form-source ref-form))
                                    (= (get slice-node :source) (sh08-ma-form-source slice-form))
                                    (= (get let-node :source) (sh08-ma-form-source let-form))
                                    (= (get initializer :source) (sh08-ma-form-source init-form))
                                    (= (get root-node :node-id) (get (get let-node :children) 1))
                                    (= [(get initializer :node-id) (get root-node :node-id)] (get let-node :children))
                                    (= [bid] (get let-node :resolved-binding-ids))
                                    (= :let (get let-node :core-form))
                                    (= {:binding-vector-form-id (get vector-form :form-id) :binding-vector-syntax-id (get vector-form :syntax-id) :outer-scope-id outer :body-scope-id body :binding-count 1 :body-count 1 :initializer-child-indexes [0] :body-child-indexes [1] :evaluation-order :initializers-then-body-left-to-right :result-policy {:kind :last-body :child-index 1}} (get let-node :attributes))
                                    (= :initializers-then-body-left-to-right (get (get let-node :evaluation) :kind))
                                    (= [{:index 0 :core-node-id (get initializer :node-id)} {:index 1 :core-node-id (get root-node :node-id)}] (get (get let-node :evaluation) :order))
                                    (= :list (get let-form :kind))
                                    (= [(get op-form :form-id) (get vector-form :form-id) (get root-form :form-id)] (get let-form :child-form-ids))
                                    (= :symbol (get op-form :kind))
                                    (= 'let (get op-form :value))
                                    (= [] (get op-form :child-form-ids))
                                    (= (get let-form :form-id) (get op-form :parent-form-id) (get vector-form :parent-form-id) (get root-form :parent-form-id))
                                    (= (if (= (get root-node :node-id) (get slice-node :node-id)) (get let-form :form-id)
                                      (get (get (get (get bridge :proof) :node) :source) :form-id)) (get slice-form :parent-form-id))
                                    (= :vector (get vector-form :kind))
                                    (= [(get name-form :form-id) (get init-form :form-id)] (get vector-form :child-form-ids))
                                    (= (get vector-form :form-id) (get name-form :parent-form-id) (get init-form :parent-form-id))
                                    (= (get slice-form :form-id) (get ref-form :parent-form-id))
                                    (= outer (get let-form :scope-id) (get init-form :scope-id) (get (get let-node :attributes) :outer-scope-id) (get let-node :binding-context) (get initializer :binding-context))
                                    (= body (get binding :scope-id) (get ref-form :scope-id) (get name-form :scope-id) (get slice-form :scope-id) (get reference :binding-context) (get slice-node :binding-context) (get (get let-node :attributes) :body-scope-id))
                                    (= (get binding :definition-syntax-id) (get record :definition-syntax-id) (get name-form :syntax-id))
                                    (= {:let-core-node-id (get let-node :node-id) :ordinal 0 :name (get binding :name) :binding-id bid :definition-form-id (get name-form :form-id) :definition-syntax-id (get name-form :syntax-id) :binding-scope-id body :initializer-form-id (get init-form :form-id) :initializer-syntax-id (get init-form :syntax-id) :initializer-scope-id outer :initializer-node-id (get initializer :node-id) :visible-prior-binding-ids [] :mutability :immutable} record)
                                    (= record (sh08-nq-one records :let-core-node-id (get let-node :node-id)))
                                    (loop [rows mutations] (if (= 0 (count rows)) true (if (= bid (get (first rows) :target-binding-id)) false (recur (rest rows)))))])
                                (let [origin (sh08-vsl-receiver core initializer nodes bindings types forms )
                                    members (get (get origin :type) :element-types)]
                                    (if (= :accepted (get origin :status))
                                      (if (if (vector? members) (= (get origin :type) (get types (get reference :node-id))) false)
                                        {:status :accepted :type (get origin :type)
                                          :source-forms (loop [remaining (get origin :source-forms) out bound-forms]
                                            (if (= 0 (count remaining)) out (recur (rest remaining) (conj out (first remaining)))))
                                          :receiver (if (contains? bridge :proof) (assoc {:kind :immutable-let-vector :reference reference :binding binding :record record :owner let-node
                                            :source-forms bound-forms :origin (get origin :receiver)} :body-consumer (get bridge :proof)) {:kind :immutable-let-vector :reference reference :binding binding :record record :owner let-node
                                            :source-forms bound-forms :origin (get origin :receiver)})}
                                        {:status :rejected :reason :vector-slice-receiver-proof-required})
                                      origin))
                                {:status :rejected :reason :vector-slice-source-mismatch})
                              {:status :rejected :reason :vector-slice-source-mismatch}))
                          {:status :rejected :reason :vector-slice-source-mismatch})
                        {:status :rejected :reason :vector-slice-source-mismatch})
                        bridge))
                    {:status :rejected :reason :vector-slice-source-mismatch}))
                {:status :rejected :reason :vector-slice-source-mismatch})
              {:status :rejected :reason :vector-slice-receiver-proof-required}))
          {:status :rejected :reason :vector-slice-source-mismatch})
        {:status :rejected :reason :vector-slice-source-mismatch})))

(defn sh08-vsl-count-end [core slice-node node receiver nodes bindings types forms]
  ; The caller independently checked the immutable local or parameter Vector.
  ; Validate table/type coordinates before the physical membership scan.
  (let [calls (get core :calls) edges (get core :call-edges) functions (get core :function-records)
        members (get (get receiver :type) :element-types)
        body-consumer (get (get receiver :receiver) :body-consumer)
        first-body? (= :direct-vector-first (get body-consumer :kind))
        parameter? (= :immutable-parameter-vector (get (get receiver :receiver) :kind))]
    (if (if (if (vector? calls) (vector? edges) false) (vector? functions) false)
        (if (sh08-ft-all-true?
              [(sh08-sse-ids? [(get node :node-id) (get (get node :source) :form-id) (get (get node :source) :syntax-id)] 3)
               (loop [rows calls] (if (= 0 (count rows)) true
                 (if (sh08-sse-ids? [(get (first rows) :core-node-id)] 1) (recur (rest rows)) false)))
               (loop [rows edges] (if (= 0 (count rows)) true
                 (if (sh08-sse-ids? [(get (first rows) :call-core-node-id)] 1) (recur (rest rows)) false)))
               (loop [rows functions] (if (= 0 (count rows)) true
                 (if (sh08-sse-ids? [(get (first rows) :function-syntax-id) (get (first rows) :function-core-node-id)] 2)
                   (recur (rest rows)) false)))])
          (let [call (sh08-nq-one calls :core-node-id (get node :node-id))
                edge (sh08-nq-one edges :call-core-node-id (get node :node-id))
                lexical (get receiver :receiver) original (get lexical :reference)
                local-binding (get lexical :binding) record (get lexical :record)]
            (if (if (if (map? call) (map? edge) false)
                  (if (sh08-ft-all-true? [(sh08-sse-ids? [(get call :operator-node-id) (get call :operator-binding-id)] 2)
                                      (sh08-sse-ids? (get node :children) 2)
                                      (sh08-sse-ids? (get call :argument-node-ids) 1)])
                    (if (integer? (get edge :ordinal)) (>= (get edge :ordinal) 0) false) false) false)
              (let [operator (get nodes (get call :operator-node-id)) binding (get bindings (get call :operator-binding-id))
                    children (get node :children) argument (get nodes (get children 1))
                    profiles (get binding :profile-set) targets (get binding :target-set)]
                (if (sh08-nq-ids? node call nodes bindings (get core :module))
                    (if (if (sh08-ft-all-true? [(sh08-sse-ids? [(get argument :node-id) (get (get argument :source) :form-id) (get (get argument :source) :syntax-id)
                                        (get (get argument :attributes) :binding-id) (get (get argument :attributes) :definition-syntax-id)
                                        (get argument :binding-context)] 6)
                                        (sh08-sse-ids? [(get node :binding-context) (get operator :binding-context)
                                        (get binding :definition-syntax-id) (get (get operator :attributes) :definition-syntax-id)] 4)])
                        (if (keyword? (get (get core :module) :target))
                          (if (loop [rows profiles] (if (= 0 (count rows)) true (if (keyword? (first rows)) (recur (rest rows)) false)))
                            (loop [rows targets] (if (= 0 (count rows)) true (if (keyword? (first rows)) (recur (rest rows)) false))) false) false) false)
                    (let [owner (get forms (get (get node :source) :form-id))
                          op-form (get forms (get (get operator :source) :form-id))
                          arg-form (get forms (get (get argument :source) :form-id))
                          slice-form (get forms (get (get slice-node :source) :form-id))
                          scope (if parameter? (get local-binding :scope-id) (get record :binding-scope-id)) region (get (get slice-node :evaluation) :region)
                          caller (get (get slice-node :evaluation) :owner-function-syntax-id)]
                      (if (if (sh08-ft-all-true? [(sh08-sse-ids? [(get owner :form-id) (get owner :syntax-id) (get op-form :form-id) (get op-form :syntax-id)
                                            (get arg-form :form-id) (get arg-form :syntax-id)] 6)
                                            (sh08-sse-ids? [(get owner :scope-id) (get op-form :scope-id) (get arg-form :scope-id)] 3)])
                            (if (symbol? (get op-form :value)) (if (symbol? (get arg-form :value))
                              (if (symbol? (get (get argument :attributes) :symbol))
                                (if (= nil caller) true (sh08-sse-ids? [caller] 1)) false) false) false) false)
                        (if (sh08-ft-all-true?
                              [(if parameter? true (= :immutable-let-vector (get lexical :kind)))
                               (if parameter? true (= :authenticated-string-character-vector (get (get lexical :origin) :kind)))
                               (if (= nil body-consumer)
                                 (= (get slice-node :node-id) (get (get (get lexical :owner) :children) (if parameter? 0 1)))
                                 (if first-body?
                                   (let [head-node (get body-consumer :node) head-op (get body-consumer :operator)]
                                     (if (if (sh08-sse-ids? [(get head-node :node-id) (get head-op :node-id)] 2)
                                           (sh08-sse-ids? (get head-node :children) 2) false)
                                       (sh08-ft-all-true? [(= head-node (get nodes (get head-node :node-id)))
                                                (= head-op (get nodes (get head-op :node-id)))
                                                (= (get head-node :node-id) (get (get (get lexical :owner) :children) 1))
                                                (= [(get head-op :node-id) (get slice-node :node-id)] (get head-node :children))]) false))
                                   false))
                               (= node (get nodes (get node :node-id)))
                               (= :call (get node :core-form)) (= 2 (count children))
                               (= :reference (get argument :core-form))
                               (= false (= (get argument :node-id) (get original :node-id)))
                               (= false (= (get (get argument :source) :form-id) (get (get original :source) :form-id)))
                               (= [] (get argument :children))
                               (= [(get local-binding :binding-id)] (get argument :resolved-binding-ids))
                               (= {:symbol (get local-binding :name) :position :expression :binding-id (get local-binding :binding-id)
                                   :binding-class :lexical :definition-syntax-id (get local-binding :definition-syntax-id)} (get argument :attributes))
                               (= (get local-binding :name) (get arg-form :value))
                               (= :symbol (get arg-form :kind)) (= [] (get arg-form :child-form-ids))
                               (= :value (get (get argument :evaluation) :kind)) (= [] (get (get argument :evaluation) :order))
                               (= (get (get argument :source) :form-id) (get (get owner :child-form-ids) 1))
                               (= (get owner :form-id) (get arg-form :parent-form-id) (get op-form :parent-form-id))
                               (= (get slice-form :form-id) (get owner :parent-form-id))
                               (= scope (get node :binding-context) (get operator :binding-context) (get argument :binding-context)
                                        (get owner :scope-id) (get op-form :scope-id) (get arg-form :scope-id))
                               (if (keyword? region) (contains? #{:module-initialization :function-body} region) false)
                               (= region (get (get node :evaluation) :region) (get (get operator :evaluation) :region) (get (get argument :evaluation) :region))
                               (= caller (get (get node :evaluation) :owner-function-syntax-id)
                                         (get (get operator :evaluation) :owner-function-syntax-id) (get (get argument :evaluation) :owner-function-syntax-id))
                               (= (get receiver :type) (get types (get argument :node-id)))])
                          (let [count-proof (sh08-nq-count core node nodes bindings types forms)]
                            (if (map? count-proof)
                              {:status :accepted :source-forms [op-form arg-form]
                               :proof {:kind :same-immutable-vector-count :node node :source-form owner
                                       :operator operator :reference argument :binding local-binding :record record
                                       :cardinality-proof count-proof :value (count members)
                                       :relation :nonnegative :law :same-immutable-vector-cardinality}}
                              {:status :rejected :reason :vector-slice-source-mismatch}))
                          {:status :rejected :reason :vector-slice-source-mismatch})
                        {:status :rejected :reason :vector-slice-source-mismatch}))
                    {:status :rejected :reason :vector-slice-source-mismatch})
                    {:status :rejected :reason :vector-slice-source-mismatch}))
              {:status :rejected :reason :vector-slice-source-mismatch}))
          {:status :rejected :reason :vector-slice-source-mismatch})
        {:status :rejected :reason :vector-slice-source-mismatch})))

(defn sh08-vsl-proof [core node call nodes bindings types forms]
  ; STD3 bounds apply only to a normal invocation. Each normal operand still
  ; requires its own proof; a child proof is reconstructed independently.
  (if (if (vector? (get call :argument-node-ids)) (= 3 (count (get call :argument-node-ids))) false)
        (if (sh08-vsl-ids? node call nodes bindings (get core :module))
          (let [args (get call :argument-node-ids) children (get node :children)
                receiver-node (get nodes (get args 0)) start-node (get nodes (get args 1)) end-node (get nodes (get args 2))
                arguments (sh08-ft-ordered-child-types args types)
                owner (get forms (get (get node :source) :form-id)) ids (get owner :child-form-ids)]
            (if (if (sh08-sse-ids? ids 4)
                  (loop [remaining args]
                    (if (= 0 (count remaining)) true
                      (let [operand (get nodes (first remaining))]
                        (if (sh08-sse-ids? [(get operand :node-id) (get (get operand :source) :form-id)
                                            (get (get operand :source) :syntax-id)] 3)
                          (recur (rest remaining)) false)))) false)
              (let [operator (get nodes (first children))
                    selected (loop [remaining children out [owner]]
                               (if (= 0 (count remaining)) out
                                 (recur (rest remaining) (conj out (get forms (get (get (get nodes (first remaining)) :source) :form-id))))))
                    valid-source? (if (symbol? (get (get selected 1) :value))
                                    (sh08-ft-all-true?
                                      [(= :list (get owner :kind)) (= (get node :source) (sh08-ma-form-source owner))
                                       (loop [i 0]
                                         (if (= i 4) true
                                           (let [form (get selected (+ i 1)) child (get nodes (get children i))]
                                             (if (sh08-ft-all-true? [(= (get ids i) (get form :form-id))
                                                   (= (get owner :form-id) (get form :parent-form-id))
                                                   (= (get child :source) (sh08-ma-form-source form))
                                                   (if (= i 0) (if (= :symbol (get form :kind))
                                                     (if (= [] (get form :child-form-ids)) (= (get form :value) (get (get child :attributes) :symbol)) false) false) true)])
                                               (recur (+ i 1)) false))))]) false)]
                (if valid-source?
                  (let [receiver (if (if (= :reference (get receiver-node :core-form))
                                  (= false (= :gravity.type/never (get types (get receiver-node :node-id)))) false)
                             (let [parameter (sh08-vsl-parameter core node receiver-node nodes bindings types forms )]
                               (if (= :not-applicable (get parameter :status))
                                 (sh08-vsl-let core node receiver-node nodes bindings types forms ) parameter))
                             (sh08-vsl-receiver core receiver-node nodes bindings types forms ))]
                    (if (= :accepted (get receiver :status))
                      (let [start-type (get arguments 1) end-type (get arguments 2)
                            start (if (= :gravity.type/never start-type) {:kind :non-invoked-operand}
                                    (sh08-nq-literal start-node start-type forms false))
                            end-check (if (= :gravity.type/never end-type) {:status :accepted :proof {:kind :non-invoked-operand}}
                                        (if (= :call (get end-node :core-form))
                                          (sh08-vsl-count-end core node end-node receiver nodes bindings types forms )
                                          {:status :accepted :proof (sh08-nq-literal end-node end-type forms false)}))
                            end (get end-check :proof)
                            normal? (loop [remaining arguments]
                                      (if (= 0 (count remaining)) true
                                        (if (= :gravity.type/never (first remaining)) false (recur (rest remaining)))))
                            members (get (get receiver :type) :element-types)
                            n (if (vector? members) (count members) 0)]
                        (if (= :rejected (get end-check :status)) end-check
                          (if (if (keyword? start-type) (contains? #{:gravity.type/integer :gravity.type/never} start-type) false)
                            (if (if (keyword? end-type) (contains? #{:gravity.type/integer :gravity.type/never} end-type) false)
                              (if (if (map? start) (map? end) false)
                                (if (if normal? (<= 0 (get start :value) (get end :value) n) true)
                                  {:status :accepted
                                   :proof {:schema :gravity/vector-slice-proof-v1 :call-core-node-id (get node :node-id)
                                           :source-forms (loop [remaining (get receiver :source-forms) out (loop [remaining (get end-check :source-forms []) out selected]
                                                     (if (= 0 (count remaining)) out (recur (rest remaining) (conj out (first remaining)))))]
                                                           (if (= 0 (count remaining)) out
                                                             (let [form (first remaining)]
                                                               (recur (rest remaining)
                                                                 (if (= (get form :form-id) (get (get receiver-node :source) :form-id)) out (conj out form))))))
                                           :receiver (get receiver :receiver) :start start :end end
                                           :application (if normal? :normal :not-invoked)
                                           :law :start-inclusive-end-exclusive
                                           :input-count (if normal? n nil) :result-count (if normal? (- (get end :value) (get start :value)) nil)
                                           :selected-types (if normal?
                                                             (loop [i (get start :value) out []]
                                                               (if (= i (get end :value)) out
                                                                 (recur (+ i 1) (conj out (get members i))))) nil)
                                           :index-conversion :exact-in-bounded-range :check-elision :not-authorized :runtime-guards :retained}}
                                  {:status :rejected :reason :vector-slice-bounds-required})
                                {:status :rejected :reason :vector-slice-bounds-required})
                              {:status :rejected :reason :vector-slice-index-type-required})
                            {:status :rejected :reason :vector-slice-index-type-required})))
                      receiver))
                  {:status :rejected :reason :vector-slice-source-mismatch}))
              {:status :rejected :reason :vector-slice-source-mismatch}))
          {:status :rejected :reason :vector-slice-source-mismatch})
        {:status :rejected :reason :vector-slice-arity-mismatch}))


(defn sh08-vsl-source [core node call edge nodes bindings types module proof]
  (if (if (map? edge) (if (integer? (get edge :ordinal)) (>= (get edge :ordinal) 0) false) false)
    (if (if (vector? (get call :argument-node-ids))
        (if (= 3 (count (get call :argument-node-ids)))
          (if (vector? (get node :children)) (= 4 (count (get node :children))) false) false) false)
  (let [children (get node :children) operator (get nodes (get call :operator-node-id))
        bid (get call :operator-binding-id) binding (get bindings bid) args (get call :argument-node-ids)
        arguments (sh08-ft-ordered-child-types args types)
        invoked? (loop [remaining arguments]
                   (if (= 0 (count remaining)) true
                     (if (= :gravity.type/never (first remaining)) false (recur (rest remaining)))))
        caller (loop [remaining (get core :function-records)]
                 (if (= 0 (count remaining)) nil
                   (if (= (get (first remaining) :function-syntax-id) (get (get node :evaluation) :owner-function-syntax-id))
                     (first remaining) (recur (rest remaining)))))
        expected-call {:core-node-id (get node :node-id) :operator-node-id (first children) :operator-binding-id bid
                       :argument-node-ids (vec (rest children)) :ordered-evaluation-node-ids children
                       :evaluation-order :operator-then-arguments :result-policy :call-result}
        expected-edge {:ordinal (get edge :ordinal) :call-core-node-id (get node :node-id)
                       :caller-function-syntax-id (get caller :function-syntax-id) :caller-function-core-node-id (get caller :function-core-node-id)
                       :callee-binding-id bid :callee-definition-syntax-id (get binding :definition-syntax-id)
                       :callee-function-syntax-id nil :callee-function-core-node-id nil :argument-core-node-ids args
                       :ordered-evaluation-node-ids children :evaluation-order :operator-then-arguments :classification :nonlocal-or-nonfunction}]
    (if (sh08-ft-all-true?
          [(= :call (get node :core-form)) (= :reference (get operator :core-form))
           (= 3 (count args)) (= expected-call call) (= expected-edge edge)
           (= expected-call (sh08-nq-one (get core :calls) :core-node-id (get node :node-id)))
           (= expected-edge (sh08-nq-one (get core :call-edges) :call-core-node-id (get node :node-id))) (sh08-vsl-binding? binding module)
           (= [bid] (get node :resolved-binding-ids) (get operator :resolved-binding-ids))
           (= {:symbol (get (get operator :attributes) :symbol) :position :operator :binding-id bid :binding-class :core
               :definition-syntax-id (get binding :definition-syntax-id)} (get operator :attributes))
           (contains? '#{subvec gravity.core/subvec} (get (get operator :attributes) :symbol))
           (= :operator-then-arguments (get (get node :evaluation) :kind))
           (= (loop [i 0 out []] (if (= i (count children)) out
                (recur (+ i 1) (conj out {:index i :core-node-id (get children i)})))) (get (get node :evaluation) :order))
           (= :jvm (get module :target))
           (if (map? proof) (= :gravity/vector-slice-proof-v1 (get proof :schema)) false)
           (if (= :gravity.type/never (first arguments)) true
             (let [type (first arguments)]
               (if (map? type) (if (= 3 (count type))
                 (if (= :gravity.type/vector (get type :kind))
                   (if (= :literal (get type :shape)) (vector? (get type :element-types)) false) false) false) false)))
           (loop [remaining (rest arguments)]
             (if (= 0 (count remaining)) true
               (if (keyword? (first remaining))
                 (if (contains? #{:gravity.type/integer :gravity.type/never} (first remaining))
                   (recur (rest remaining)) false) false)))
           (= (if invoked? :normal :not-invoked) (get proof :application))
           (if (= nil (first arguments)) false (= false (= :gravity.type/unknown (first arguments))))] )
      {:kind :gravity.type/applied-vector-slice :version :sh08-vector-slice-v1
       :operation 'subvec :semantic-owner 'gravity.collections :intrinsic :gravity.collections/proven-vector-slice
       :resolution :gravity.core-compatibility :operator-node-id (get operator :node-id) :operator-binding-id bid
       :call-core-node-id (get node :node-id) :source (get node :source) :operator-source (get operator :source)
       :source-call call :source-edge edge :source-binding binding :argument-types arguments
       :slice-policy {:range :start-inclusive-end-exclusive
                      :receiver (if (= :immutable-parameter-vector (get (get proof :receiver) :kind)) :immutable-parameter-vector
                                  (if (= :immutable-let-vector (get (get proof :receiver) :kind)) :immutable-let-vector
                                  (if (= :original-integer-vector-literal (get (get proof :receiver) :kind))
                                    :original-integer-vector-literal :authenticated-string-character-vector)))
                      :indexes (if (= :same-immutable-vector-count (get (get proof :end) :kind))
                                 :source-proven-literal-start-and-same-vector-count-end :source-proven-nonnegative-integer-literals)
                      :bounds :zero-le-start-le-end-le-count :operand-evaluation :receiver-then-start-then-end-once
                      :input-preserved? true :payloads :inert :allocation :normal-invocation-even-empty-or-full
                      :index-conversion :exact-in-bounded-range :check-elision :not-authorized :runtime-guards :retained
                      :provider-cpu-bound :not-established :provider-heap-bound :not-established}

       :bounds-proof proof :safety :proven-safe
       :storage-policy {:allocation :may-allocate-vector-slice :condition :normal-invocation
                        :representation :pending-profile-representation :provider :pending-runtime-provider
                        :ownership :pending-ownership-analysis}

       :application (if invoked? :normal :not-invoked)
       :latent-effects [:memory/allocate] :direct-effects (if invoked? [:memory/allocate] []) :capabilities [] :thrown-error-effects []
       :profile (get module :profile) :target (get module :target)
       :invalidation (let [fields [:calls :call-edges :binding-table :source-forms :type-table :lexical-bindings :definitions :function-records
                      :callee-body :receiver-conversion-proof :index-literal-proofs :slice-policy :source-bounds-proof :selected-positional-types :result-storage-policy :allocation-condition :profile :target :evaluation-order]
                           fields (if (= :same-immutable-vector-count (get (get proof :end) :kind))
                                    (conj (conj fields :same-local-reference-proof) :count-cardinality-proof) fields)]
                       (if (= :immutable-parameter-vector (get (get proof :receiver) :kind))
                         (conj (conj (conj fields :mutations) :parameter-bindings) :function-type-table)
                         (if (= :immutable-let-vector (get (get proof :receiver) :kind))
                         (let [fields (conj fields :mutations)]
                           (if (if (= :prefix-gate-if (get (get (get (get proof :receiver) :body-consumer) :condition-container) :kind)) true (= :prefix-gate-call-if (get (get (get (get proof :receiver) :body-consumer) :condition-container) :kind)))
                             (conj fields :control-flow) fields)) fields)))} nil)) nil) nil))

(defn sh08-vsl-finish [header]
  (let [type (if (= :normal (get header :application))
               {:kind :gravity.type/vector :shape :literal :element-types (get (get header :bounds-proof) :selected-types)}
               :gravity.type/never)]
    (assoc header :parameter-types (get header :argument-types) :return type :result-type type)))


(defn sh08-vsl-constraint [descriptor]
  {:constraint-id-request {:domain :gravity/sh08-vector-slice-constraint-v1 :application descriptor}
   :kind :equality :producer-rule :sh08-vector-slice-v1
   :lhs {:core-node-id (get descriptor :call-core-node-id) :projection :vector-slice}
   :rhs (get descriptor :result-type) :dependencies descriptor :origin (get (get descriptor :source) :origin-chain)
   :solution {:result-type (get descriptor :result-type) :application (get descriptor :application)
              :direct-effects (get descriptor :direct-effects) :bounds-proof (get descriptor :bounds-proof)
              :storage-policy (get descriptor :storage-policy)}
   :invalidation (get descriptor :invalidation) :profile (get descriptor :profile) :target (get descriptor :target)
   :status :solved :diagnostics []})

(defn sh08-vsl-call-fact [descriptor module]
  (let [source (get descriptor :source) edge (get descriptor :source-edge)]
    {:artifact :gravity/c7-call-type-fact
     :fact-id-request {:domain :gravity/sh08-vector-slice-call-type-fact-v1 :application descriptor}
     :call-core-node-id (get descriptor :call-core-node-id) :caller-function-syntax-id (get edge :caller-function-syntax-id)
     :callee-function-syntax-id nil :argument-types (get descriptor :argument-types) :result-type (get descriptor :result-type)
     :evaluation-order :operator-then-arguments :source-span (get source :semantic-span) :syntax-id (get source :syntax-id)
     :origin-chain (get source :origin-chain) :generated-origin (get source :generated-origin)
     :profile (get module :profile) :target (get module :target) :effects (get descriptor :direct-effects) :capabilities [] :status :inferred
     :dispatch :direct-vector-slice :applied-vector-slice descriptor :effect-facts-source :audited-collection-intrinsic}))

(defn sh08-vsl-derive [core node call edge nodes bindings types forms]
  (let [proved (sh08-vsl-proof core node call nodes bindings types forms )]
    (if (= :accepted (get proved :status))
      (let [header (sh08-vsl-source core node call edge nodes bindings types (get core :module) (get proved :proof))]
        (if (if (map? header)
              (= {:operator-child-index 0 :argument-count 3 :argument-child-indexes [1 2 3]
                  :evaluation-order :operator-then-arguments :dispatch :resolved-symbol-call} (get node :attributes)) false)
          (let [descriptor (sh08-vsl-finish header)]
            {:status :accepted :descriptor descriptor :type (get descriptor :result-type)
             :constraint (sh08-vsl-constraint descriptor)})
          (sh08-sm-failure "C7-VERIFY" :vector-slice-source-mismatch nil :original-ordered-vector-slice-call (get node :node-id))))
      (let [reason (get proved :reason)
            child? (contains? #{:string-character-vector-unsupported-text :string-character-vector-literal-required
                                :string-character-vector-arity-mismatch} reason)
            rule (if (contains? #{:vector-slice-source-mismatch :string-character-vector-source-mismatch} reason) "C7-VERIFY"
                     (if child? "C7-ANNOTATION"
                       (if (contains? #{:vector-slice-arity-mismatch :vector-slice-index-type-required :vector-slice-receiver-type-required} reason)
                         "C7-TYPE-MISMATCH" "STD3002")))]
        (sh08-sm-failure rule reason nil
                 (if child? :original-finite-supported-scalar-string-literal
                   {:operation 'subvec :receiver [:authenticated-string-character-vector :original-integer-vector-literal :immutable-let-vector]
                    :indexes :source-proven-nonnegative-integer-literals :bounds :zero-le-start-le-end-le-count})
                 (if (sh08-sse-ids? (get call :argument-node-ids) 3)
                   (sh08-ft-ordered-child-types (get call :argument-node-ids) types) []))))))


(defn sh08-vsl-node? [node context]
  (if (= :call (get node :core-form))
    (if (sh08-sse-ids? (get node :resolved-binding-ids) 1)
      (sh08-vsl-binding? (get (get context :ordering-bindings) (first (get node :resolved-binding-ids)))
                         (get (get context :ordering-core) :module)) false) false))

(defn sh08-vsl-inferred-call [core node call edge nodes bindings types]
  (if (sh08-vsl-ids? node call nodes bindings (get core :module))
    (let [descriptor (get types (get call :operator-node-id))
          source-forms (get (get descriptor :bounds-proof) :source-forms)
          parameter? (= :immutable-parameter-vector (get (get (get descriptor :bounds-proof) :receiver) :kind))
          alias? (= :immutable-let-vector (get (get (get descriptor :bounds-proof) :receiver) :kind))
          literal? (= :original-integer-vector-literal (get (get (get descriptor :bounds-proof) :receiver) :kind))
          wrapped? (if alias? (= :direct-left-vector-equality (get (get (get (get descriptor :bounds-proof) :receiver) :body-consumer) :kind)) false)
          first-consumer? (if alias? (= :direct-vector-first (get (get (get (get descriptor :bounds-proof) :receiver) :body-consumer) :kind)) false)
          membership-consumer? (if alias? (= :direct-character-set-first-membership (get (get (get (get descriptor :bounds-proof) :receiver) :body-consumer) :kind)) false)
          local-call-consumer? (if alias? (= :direct-local-function-slice-argument (get (get (get (get descriptor :bounds-proof) :receiver) :body-consumer) :kind)) false)
          conditional-call-consumer? (if alias? (= :prefix-gated-local-function-slice-argument (get (get (get (get descriptor :bounds-proof) :receiver) :body-consumer) :kind)) false)
          prefix-call-container? (if wrapped? (= :prefix-gate-call-if (get (get (get (get (get descriptor :bounds-proof) :receiver) :body-consumer) :condition-container) :kind)) false)
          count-end? (= :same-immutable-vector-count (get (get (get descriptor :bounds-proof) :end) :kind))
          width (if (vector? source-forms) (count source-forms) 0)]
      (if (if (map? descriptor)
            (if (keyword? (get descriptor :kind))
              (if (= :gravity.type/applied-vector-slice (get descriptor :kind))
                (if (vector? source-forms)
                  (if parameter?
                    (= 11 width)
                    (if alias?
                      (if count-end?
                        (if first-consumer? (= 16 width) (= 14 width))
                        (if conditional-call-consumer? (<= 25 width)
                          (if prefix-call-container? (<= 26 width)
                            (if local-call-consumer? (<= 19 width)
                              (if membership-consumer? (<= 15 width)
                                (if first-consumer? (<= 12 width)
                                  (if wrapped? (<= 13 width) (<= 10 width))))))))
                      (if literal? (<= 5 width) (contains? #{5 7} width))))
                  false)
                false)
              false)
            false)
        (let [forms (loop [remaining source-forms out {}]
                      (if (= 0 (count remaining)) out
                        (let [form (first remaining) id (get form :form-id)]
                          (if (sh08-sse-ids? [id] 1)
                            (if (contains? out id) nil (recur (rest remaining) (assoc out id form)))
                            nil))))]
          (if (map? forms)
            (let [derived (sh08-vsl-derive core node call edge nodes bindings types forms)]
              (if (= :accepted (get derived :status))
                (if (= (get derived :descriptor) descriptor)
                  {:status :accepted}
                  {:status :rejected :reason :vector-slice-source-mismatch})
                derived))
            {:status :rejected :reason :vector-slice-source-mismatch}))
        {:status :rejected :reason :vector-slice-source-mismatch}))

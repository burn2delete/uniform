              (if (if (= result nil) (= (get signature :body-source-child-index) 2)
                    (if (if (= :sh07-list-return-declaration-v1 (get result :rule-version))
                          (sh08-lr-declaration? result bindings) (sh08-ft-declaration-valid? result bindings))
                      (= [(get result :source-child-index) (get signature :body-source-child-index)] [2 4]) false))
                (loop [declarations parameters positions coordinates coordinate 0 annotated? (if (= result nil) false true)]
                  (if (= (count declarations) 0) annotated?
                    (let [declaration (first declarations)]

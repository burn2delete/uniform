       record
       (if (if (map? record) (contains? record :signature) false)
        #{:ordinal :function-core-node-id :function-form-id :function-syntax-id :body-core-node-id
          :parameter-binding-ids :fixed-arity :definition-kind :definition-binding-id
          :definition-core-node-id :definition-name :signature}
       #{:ordinal :function-core-node-id :function-form-id
         :function-syntax-id :body-core-node-id :parameter-binding-ids
         :fixed-arity :definition-kind :definition-binding-id
         :definition-core-node-id :definition-name}))
    (let [function-node (get nodes (get record :function-core-node-id))
          definition
          (loop [remaining definitions]
            (if (= (count remaining) 0)
              nil

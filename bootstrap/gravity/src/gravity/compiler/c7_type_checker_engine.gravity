         :evaluation-order :classification})
    (let [call-node (get nodes (get call :core-node-id))]
    (if (= (get edge :call-core-node-id) (get call :core-node-id))
      (if (= (get edge :callee-binding-id)
             (get call :operator-binding-id))
        (if (= (get edge :argument-core-node-ids)
               (get call :argument-node-ids))
          (if (= (get edge :ordered-evaluation-node-ids)
                 (get call :ordered-evaluation-node-ids))
            (if (= (get edge :evaluation-order)
                   (get call :evaluation-order))
              (if (contains?
                   #{:local-function :nonlocal-or-nonfunction}
                   (get edge :classification))
                (if (sh08-ft-caller-edge-valid?
                     edge functions call-node)
                  (if (= (get edge :classification) :local-function)
                    (sh08-ft-local-callee-edge-valid?
                     edge functions definitions nodes)
                    (sh08-ft-nonlocal-callee-edge-valid?
                     edge functions definitions))
                  false)
                false)
              false)
            false)
          false)
        false)
      false))
    false))

(defn sh08-ft-recursion-valid?
  [component functions edges]
  (if (sh08-ft-record-shape?
       component
       #{:ordinal :kind :function-syntax-ids :function-core-node-ids
         :internal-call-edge-ordinals})
    (if (contains? #{:self-recursive :mutually-recursive}
                   (get component :kind))
      (if (sh08-sha256-id-vector?
           (get component :function-syntax-ids))
        (if (sh08-sha256-id-vector?
             (get component :function-core-node-ids))
          (if (= (count (get component :function-syntax-ids))
                 (count (get component :function-core-node-ids)))
            (if (if (= (get component :kind) :self-recursive)
                  (= (count (get component :function-syntax-ids)) 1)
                  (> (count (get component :function-syntax-ids)) 1))
              (loop [remaining (get component :internal-call-edge-ordinals)]
                (if (= (count remaining) 0)
                  true
                  (if (integer? (first remaining))
                    (if (< (first remaining) (count edges))
                      (let [edge (get edges (first remaining))]
                        (if (if (map? edge)
                              (if (= (get edge :classification)
                                     :local-function)
                                (if (sh08-ft-member?
                                     (get component :function-syntax-ids)
                                     (get edge :caller-function-syntax-id))
                                  (sh08-ft-member?
                                   (get component :function-syntax-ids)
                                   (get edge :callee-function-syntax-id))
                                  false)
                                false)
                              false)
                          (recur (rest remaining))
                          false))
                      false)
                    false)))
              false)
            false)
          false)
        false)
      false)
    false))

(defn sh08-ft-recursion-components-valid?
  [components functions edges]
  (loop [remaining components seen #{}]
    (if (= (count remaining) 0)
      true
      (let [component (first remaining)
            ids (get component :function-syntax-ids)]
        (if (sh08-ft-recursion-valid? component functions edges)
          (if (sh08-all-unique? ids [])
            (if (sh08-ft-any-member? ids (vec seen))
              false
              (recur
               (rest remaining)
               (loop [ids-left ids result seen]
                 (if (= (count ids-left) 0)
                   result
                   (recur
                    (rest ids-left)
                    (conj result (first ids-left)))))))
            false)
          false)))))

; These reconstruction helpers intentionally mirror the bounded B47 owning
; verifier.  Shape validation alone is insufficient: every supplied product
; must be the unique product derived from the authenticated core carrier.

(defn sh08-ft-definition-by-value-node-id [definitions node-id]
  (loop [remaining definitions]
    (if (= (count remaining) 0)
      nil
      (if (= (get (first remaining) :value-node-id) node-id)
        (first remaining)
        (recur (rest remaining))))))

(defn sh08-ft-function-by-node-id [records node-id]
  (loop [remaining records]
    (if (= (count remaining) 0)
      nil
      (if (= (get (first remaining) :function-core-node-id) node-id)
        (first remaining)
        (recur (rest remaining))))))

(defn sh08-ft-function-by-syntax-id [records syntax-id]
  (loop [remaining records]
    (if (= (count remaining) 0)
      nil
      (if (= (get (first remaining) :function-syntax-id) syntax-id)
        (first remaining)
        (recur (rest remaining))))))

(defn sh08-ft-binding-by-id [bindings binding-id]
  (loop [remaining bindings]
    (if (= (count remaining) 0)
      nil
      (if (= (get (first remaining) :binding-id) binding-id)
        (first remaining)
        (recur (rest remaining))))))

(defn sh08-ft-build-function-records [nodes definitions]
  (loop [remaining nodes ordinal 0 values []]
    (if (= (count remaining) 0)
      values
      (let [node (first remaining)]
        (if (= (get node :core-form) :fn)
          (let [source (get node :source)
                definition
                (sh08-ft-definition-by-value-node-id
                 definitions (get node :node-id))]
            (recur
             (rest remaining)
             (+ ordinal 1)
             (conj
              values
              (sh08-ft-record-signature {:ordinal ordinal
               :function-core-node-id (get node :node-id)
               :function-form-id (get source :form-id)
               :function-syntax-id (get source :syntax-id)
               :body-core-node-id (first (get node :children))
               :parameter-binding-ids (get node :resolved-binding-ids)
               :fixed-arity (get (get node :attributes) :fixed-arity)
               :definition-kind
               (if (map? definition) :named-top-level :anonymous)
               :definition-binding-id
               (if (map? definition) (get definition :binding-id) nil)
               :definition-core-node-id
               (if (map? definition) (get definition :core-node-id) nil)
               :definition-name
               (if (map? definition) (get definition :name) nil)} node))))
          (recur (rest remaining) ordinal values))))))

(defn sh08-ft-call-node-ids [nodes]
  (loop [remaining nodes values []]
    (if (= (count remaining) 0)
      values
      (if (= (get (first remaining) :core-form) :call)
        (recur
         (rest remaining)
         (conj values (get (first remaining) :node-id)))
        (recur (rest remaining) values)))))

(defn sh08-ft-call-record-node-ids [calls]
  (loop [remaining calls values []]
    (if (= (count remaining) 0)
      values
      (recur
       (rest remaining)
       (conj values (get (first remaining) :core-node-id))))))

(defn sh08-ft-build-call-edges
  [nodes definitions bindings calls function-records]
  (let [node-index (sh08-ft-node-index nodes)]
    (loop [remaining calls ordinal 0 values []]
      (if (= (count remaining) 0)
        values
        (let [call (first remaining)
              call-node (get node-index (get call :core-node-id))
              caller
              (sh08-ft-function-by-syntax-id
               function-records
               (get (get call-node :evaluation)
                    :owner-function-syntax-id))
              binding
              (sh08-ft-binding-by-id
               bindings (get call :operator-binding-id))
              definition
              (sh08-ft-definition-by-binding-id
               definitions (get call :operator-binding-id))
              callee
              (if (map? definition)
                (sh08-ft-function-by-node-id
                 function-records (get definition :value-node-id))
                nil)]
          (recur
           (rest remaining)
           (+ ordinal 1)
           (conj
            values
            {:ordinal ordinal
             :call-core-node-id (get call :core-node-id)
             :caller-function-syntax-id
             (if (map? caller) (get caller :function-syntax-id) nil)
             :caller-function-core-node-id
             (if (map? caller) (get caller :function-core-node-id) nil)
             :callee-binding-id (get call :operator-binding-id)
             :callee-definition-syntax-id
             (if (map? binding)
               (get binding :definition-syntax-id)
               nil)
             :callee-function-syntax-id
             (if (map? callee) (get callee :function-syntax-id) nil)
             :callee-function-core-node-id
             (if (map? callee) (get callee :function-core-node-id) nil)
             :argument-core-node-ids (get call :argument-node-ids)
             :ordered-evaluation-node-ids
             (get call :ordered-evaluation-node-ids)
             :evaluation-order :operator-then-arguments
             :classification
             (if (map? callee)
               :local-function
               :nonlocal-or-nonfunction)})))))))

(defn sh08-ft-call-edge-adjacency [edges direction]
  (loop [remaining edges result {}]
    (if (= (count remaining) 0)
      result
      (let [edge (first remaining)]
        (if (= (get edge :classification) :local-function)
          (let [source
                (if (= direction :forward)
                  (get edge :caller-function-syntax-id)
                  (get edge :callee-function-syntax-id))
                target
                (if (= direction :forward)
                  (get edge :callee-function-syntax-id)
                  (get edge :caller-function-syntax-id))
                targets (get result source [])]
            (if (contains? (set targets) target)
              (recur (rest remaining) result)
              (recur
               (rest remaining)
               (assoc result source (conj targets target)))))
          (recur (rest remaining) result))))))

(defn sh08-ft-add-unvisited-call-targets [targets frontier visited]
  (loop [remaining targets
         next-frontier frontier
         next-visited visited]
    (if (= (count remaining) 0)
      {:frontier next-frontier :visited next-visited}
      (let [target (first remaining)]
        (if (contains? next-visited target)
          (recur (rest remaining) next-frontier next-visited)
          (recur
           (rest remaining)
           (conj next-frontier target)
           (conj next-visited target)))))))

(defn sh08-ft-reachable-function-syntax-ids [adjacency start]
  (loop [frontier [start] visited #{start}]
    (if (= (count frontier) 0)
      visited
      (let [current (first frontier)
            added
            (sh08-ft-add-unvisited-call-targets
             (get adjacency current [])
             (vec (rest frontier))
             visited)]
        (recur (get added :frontier) (get added :visited))))))

(defn sh08-ft-self-call-edge? [edges function-syntax-id]
  (loop [remaining edges]
    (if (= (count remaining) 0)
      false
      (let [edge (first remaining)]
        (if (if (= (get edge :classification) :local-function)
              (if (= (get edge :caller-function-syntax-id)
                     function-syntax-id)
                (= (get edge :callee-function-syntax-id)
                   function-syntax-id)
                false)
              false)
          true
          (recur (rest remaining)))))))

(defn sh08-ft-mutually-reachable-functions
  [function-records outgoing incoming start-syntax-id]
  (let [forward
        (sh08-ft-reachable-function-syntax-ids outgoing start-syntax-id)
        backward
        (sh08-ft-reachable-function-syntax-ids incoming start-syntax-id)]
    (loop [remaining function-records values []]
      (if (= (count remaining) 0)
        values
        (let [record (first remaining)
              candidate (get record :function-syntax-id)]
          (if (if (= (get record :definition-kind) :named-top-level)
                (if (contains? forward candidate)
                  (contains? backward candidate)
                  false)
                false)
            (recur (rest remaining) (conj values record))
            (recur (rest remaining) values)))))))

(defn sh08-ft-component-edge-ordinals [edges syntax-ids]
  (let [members (set syntax-ids)]
    (loop [remaining edges values []]
      (if (= (count remaining) 0)
        values
        (let [edge (first remaining)]
          (if (if (= (get edge :classification) :local-function)
                (if (contains?
                     members (get edge :caller-function-syntax-id))
                  (contains?
                   members (get edge :callee-function-syntax-id))
                  false)
                false)
            (recur
             (rest remaining)
             (conj values (get edge :ordinal)))
            (recur (rest remaining) values)))))))

(defn sh08-ft-add-values-to-set [values target]
  (loop [remaining values result target]
    (if (= (count remaining) 0)
      result
      (recur (rest remaining) (conj result (first remaining))))))

(defn sh08-ft-build-recursion-components [function-records edges]
  (let [outgoing (sh08-ft-call-edge-adjacency edges :forward)
        incoming (sh08-ft-call-edge-adjacency edges :reverse)]
    (loop [remaining function-records
           assigned #{}
           ordinal 0
           values []]
      (if (= (count remaining) 0)
        values
        (let [record (first remaining)
              syntax-id (get record :function-syntax-id)]
          (if (if (= (get record :definition-kind) :named-top-level)
                (if (contains? assigned syntax-id) false true)
                false)
            (let [component
                  (sh08-ft-mutually-reachable-functions
                   function-records outgoing incoming syntax-id)
                  cyclic?
                  (if (> (count component) 1)
                    true
                    (sh08-ft-self-call-edge? edges syntax-id))]
              (if cyclic?
                (let [syntax-ids
                      (loop [members component result []]
                        (if (= (count members) 0)
                          result
                          (recur
                           (rest members)
                           (conj
                            result
                            (get (first members)
                                 :function-syntax-id)))))
                      node-ids
                      (loop [members component result []]
                        (if (= (count members) 0)
                          result
                          (recur
                           (rest members)
                           (conj
                            result
                            (get (first members)
                                 :function-core-node-id)))))]
                  (recur
                   (rest remaining)
                   (sh08-ft-add-values-to-set syntax-ids assigned)
                   (+ ordinal 1)
                   (conj
                    values
                    {:ordinal ordinal
                     :kind
                     (if (= (count component) 1)
                       :self-recursive
                       :mutually-recursive)
                     :function-syntax-ids syntax-ids
                     :function-core-node-ids node-ids
                     :internal-call-edge-ordinals
                     (sh08-ft-component-edge-ordinals
                      edges syntax-ids)})))
                (recur
                 (rest remaining) assigned ordinal values)))
            (recur (rest remaining) assigned ordinal values)))))))

(defn sh08-ft-all-true? [values]
  (if (= (count values) 0)
    true
    (if (= (first values) true)
      (sh08-ft-all-true? (rest values))
      false)))

(defn sh08-ft-products-valid? [core validation bindings]
  (if (= (get validation :status) :accepted)
    (let [nodes (sh08-ft-node-index (get validation :nodes))
          definitions (get core :definitions)
          function-records (get core :function-records)
          call-records (get core :calls)
          call-edges (get core :call-edges)
          recursion-components (get core :recursion-components)
          lexical-bindings (get core :lexical-bindings)
          binding-index (sh08-ft-binding-index bindings)
          function-index (sh08-ft-function-record-index function-records)
          identity-shape
          (sh08-ft-b47-identity-preimage-valid? core bindings)
          expected-functions
          (if (vector? definitions)
            (sh08-ft-build-function-records
             (get validation :nodes) definitions)
            [])
          expected-edges
          (if (if (vector? bindings)
                (if (vector? call-records)
                  (vector? definitions)
                  false)
                false)
            (sh08-ft-build-call-edges
             (get validation :nodes) definitions bindings
             call-records expected-functions)
            [])
          expected-components
          (sh08-ft-build-recursion-components
           expected-functions expected-edges)
          binding-shape
          (if (vector? bindings)
            (if (sh08-ft-unique-records? bindings :binding-id)
              (loop [remaining bindings]
                (if (= (count remaining) 0)
                  true
                  (if (sh08-ft-binding-valid? (first remaining))
                    (recur (rest remaining))
                    false)))
              false)
            false)
          definition-shape
          (if (vector? definitions)
            (if (sh08-ft-unique-records? definitions :binding-id)
              (if (sh08-ft-unique-records? definitions :core-node-id)
                (if (sh08-ft-unique-records? definitions :syntax-id)
                  (loop [remaining definitions]
                    (if (= (count remaining) 0)
                      true
                      (if (sh08-ft-definition-valid?
                           (first remaining) nodes binding-index)
                        (recur (rest remaining))
                        false)))
                  false)
                false)
              false)
            false)
          function-shape
          (if (vector? function-records)
            (if (= function-records expected-functions)
              (loop [remaining function-records]
                (if (= (count remaining) 0) true
                  (let [record (first remaining)]
                    (if (sh08-ft-function-signature-valid? record
                          (get nodes (get record :function-core-node-id)) binding-index)
                      (recur (rest remaining)) false)))) false)
            false)
          lexical-shape
          (if (vector? lexical-bindings)
            (if (sh08-ft-unique-records?
                 lexical-bindings :binding-id)
              (loop [remaining lexical-bindings]
                (if (= (count remaining) 0)
                  true
                  (if (sh08-ft-lexical-valid?
                       (first remaining) nodes binding-index)
                    (recur (rest remaining))
                    false)))
              false)
            false)
          call-shape
          (if (vector? call-records)
            (if (= (sh08-ft-call-record-node-ids call-records)
                   (sh08-ft-call-node-ids (get validation :nodes)))
              (if (sh08-ft-unique-records?
                   call-records :core-node-id)
                (loop [remaining call-records]
                  (if (= (count remaining) 0)
                    true
                    (if (sh08-ft-call-valid?
                         (first remaining) nodes binding-index)
                      (recur (rest remaining))
                      false)))
                false)
              false)
            false)
          edge-shape
          (if (vector? call-edges)
            (= call-edges expected-edges)
            false)
          recursion-shape
          (if (vector? recursion-components)
            (= recursion-components expected-components)
            false)]
      (if (sh08-ft-all-true?
           [identity-shape binding-shape definition-shape
            function-shape lexical-shape
            call-shape edge-shape recursion-shape])
        {:status :accepted
         :node-table nodes
         :binding-index binding-index
         :function-index function-index
         :definitions definitions
         :function-records function-records
         :calls call-records
         :call-edges call-edges
         :recursion-components recursion-components
         :lexical-bindings lexical-bindings}
        {:status :rejected
         :reason
         (if (= identity-shape false)
           :stale-b47-identity-preimage
           (if (= binding-shape false)
             :malformed-binding-table
             (if (= definition-shape false)
               :malformed-definitions
               (if (= function-shape false)
                 :malformed-function-products
                 (if (= lexical-shape false)
                   :malformed-lexical-products
                   (if (= call-shape false)
                     :malformed-calls
                     (if (= edge-shape false)
                       :malformed-call-edges
                       :malformed-recursion-components)))))))}))
    {:status :rejected :reason :malformed-sh07-core-shape}))

(defn sh08-ft-diagnostic
  [rule node module expected actual reason details]
  (let [parameter-binding-id (get details :parameter-binding-id)
        constraint-id (get details :constraint-id)
        identity
        {:domain :gravity/sh08-function-type-diagnostic-v1
         :rule rule
         :core-node-id (get node :node-id)
         :syntax-id (get (get node :source) :syntax-id)
         :source-span (get (get node :source) :semantic-span)
         :binding-id (first (get node :resolved-binding-ids))
         :expected-type expected
         :actual-type actual
         :profile (get module :profile)
         :target (get module :target)
         :origin-chain (get (get node :source) :origin-chain)
         :generated-origin (get (get node :source) :generated-origin)
         :parameter-binding-id parameter-binding-id
         :constraint-id constraint-id
         :reason reason}]
    {:artifact :gravity/c7-function-type-diagnostic
     :diagnostic-id
     (str "SH08-C7:" rule ":" (get node :node-id) ":" reason)
     :diagnostic-id-request identity
     :rule rule
     :severity :error
     :stage :type-checking
     :core-node-id (get node :node-id)
     :syntax-id (get (get node :source) :syntax-id)
     :source-span (get (get node :source) :semantic-span)
     :binding-id (first (get node :resolved-binding-ids))
     :parameter-binding-id parameter-binding-id
     :type-id actual
     :constraint-id constraint-id
     :expected-type expected
     :actual-type actual
     :profile (get module :profile)
     :target (get module :target)
     :origin-chain (get (get node :source) :origin-chain)
     :generated-origin (get (get node :source) :generated-origin)
     :reason reason
     :remediation
     "Provide coherent B47 function, call, recursion, definition, binding, and lexical products with bounded first-order primitive types."}))

(defn sh08-ft-render-inference-diagnostics [diagnostics nodes module]
  (loop [remaining diagnostics values []]
    (if (= (count remaining) 0)
      values
      (let [diagnostic (first remaining)
            node
            (if (map? (get diagnostic :call))
              (get nodes (get (get diagnostic :call) :core-node-id))
              (get diagnostic :node))]
        (recur
         (rest remaining)
         (conj values
               (sh08-ft-diagnostic
                (get diagnostic :rule)
                node
                module
                (get diagnostic :expected)
                (get diagnostic :actual)
                (get diagnostic :reason)
                {:parameter-binding-id
                 (get diagnostic :parameter-binding-id)
                 :constraint-id
                 (if (= (get diagnostic :rule) "C7-TYPE-MISMATCH")
                   {:domain :gravity/sh08-function-type-constraint-v1
                    :core-node-id (get node :node-id)
                    :parameter-binding-id
                    (get diagnostic :parameter-binding-id)
                    :expected (get diagnostic :expected)
                    :actual (get diagnostic :actual)}
                   nil)})))))))

(defn sh08-ft-unknown? [value]
  (if (= value nil)
    true
    (= value :gravity.type/unknown)))

(defn sh08-ft-known? [value]
  (if (sh08-ft-unknown? value) false true))

; L2/L5/C7: bounded loop typing over original canonical-core DATA.
; Each index, parent-edge, target, slot, argument and ancestor visit consumes
; one work unit, carried across inference rounds. Unknown stays unresolved;
; Never means no normal return and contributes no payload return type.
(defn sh08-ft-loop-kernel-known? [type]
  (if (= type nil) false (= false (= type :gravity.type/unknown))))

(defn sh08-ft-loop-kernel-indexes [start end]
  (loop [index start out []]
    (if (>= index end) out (recur (+ index 1) (conj out index)))))

(defn sh08-ft-loop-kernel-append [out values]
  (loop [remaining values out out]
    (if (= 0 (count remaining)) out (recur (rest remaining) (conj out (first remaining))))))

(defn sh08-ft-loop-kernel-normal-join [types]
  (loop [remaining types chosen :gravity.type/never]
    (if (= 0 (count remaining)) chosen
      (let [type (first remaining)]
        (if (sh08-ft-loop-kernel-known? type)
          (if (= type :gravity.type/never) (recur (rest remaining) chosen)
            (if (= chosen :gravity.type/never) (recur (rest remaining) type)
              (if (= chosen type) (recur (rest remaining) chosen) :gravity.type/unknown)))
          :gravity.type/unknown)))))

(defn sh08-ft-normal-return-type [form child-types nominal]
  (if (vector? child-types)
    (if (= form :fn) nominal
      (if (= form :if)
        (if (= 3 (count child-types))
          (if (= :gravity.type/never (first child-types)) :gravity.type/never
            (sh08-ft-loop-kernel-normal-join (subvec child-types 1 3))) :gravity.type/unknown)
        (if (contains? #{:alternatives :try} form) (if (= 0 (count child-types)) nominal (sh08-ft-loop-kernel-normal-join child-types))
          (loop [remaining child-types]
            (if (= 0 (count remaining)) nominal
              (if (= :gravity.type/never (first remaining)) :gravity.type/never
                (recur (rest remaining)))))))) :gravity.type/unknown))

(defn sh08-ft-loop-kernel-failure [reason node expected actual work]
  {:status :rejected :issues [{:rule "C7-VERIFY" :reason reason :core-node-id node :expected expected :actual actual}]
   :work-count work :work-unit :node-or-record-visit})

(defn sh08-ft-loop-kernel-work-limit [work]
  {:status :rejected :issues [{:rule "C7-GENERIC" :reason :loop-type-work-limit :core-node-id nil
                              :expected :remaining-loop-type-visits :actual 0}]
   :work-count work :work-unit :node-or-record-visit})

(defn sh08-ft-loop-kernel-index-records [records field budget]
  (loop [remaining records index {} work 0]
    (if (= 0 (count remaining)) {:status :accepted :index index :work-count work}
      (if (>= work budget) (sh08-ft-loop-kernel-work-limit work)
        (let [record (first remaining) id (get record field)]
          (if (if (map? record) (if (= id nil) false (= false (contains? index id))) false)
            (recur (rest remaining) (assoc index id record) (+ work 1))
            (sh08-ft-loop-kernel-failure :invalid-loop-record-index nil :unique-nonmissing-record-key field (+ work 1))))))))

(defn sh08-ft-loop-kernel-parent-index [records nodes budget]

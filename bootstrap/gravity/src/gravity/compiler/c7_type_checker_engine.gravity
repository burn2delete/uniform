(defn sh08-cqs-quotient [core node nodes bindings types forms]
  ; Reconstruct the existing quotient and its exact source.
  (if (sh08-sse-ids? [(get node :node-id)] 1)
    (let [call (sh08-nq-one (get core :calls) :core-node-id (get node :node-id))
          edge (sh08-nq-one (get core :call-edges) :call-core-node-id (get node :node-id))]

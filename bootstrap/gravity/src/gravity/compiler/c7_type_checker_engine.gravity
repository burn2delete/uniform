     :call-core-node-id (get descriptor :call-core-node-id) :caller-function-syntax-id (get edge :caller-function-syntax-id)
     :callee-function-syntax-id nil :argument-types (get descriptor :argument-types) :result-type (get descriptor :result-type)
     :evaluation-order :operator-then-arguments :source-span (get source :semantic-span) :syntax-id (get source :syntax-id)
     :origin-chain (get source :origin-chain) :generated-origin (get source :generated-origin)
     :profile (get module :profile) :target (get module :target) :effects (get descriptor :direct-effects) :capabilities [] :status :inferred
     :dispatch :direct-atomic-equality :applied-atomic-equality descriptor :effect-facts-source :audited-atomic-value-intrinsic}))


(defn sh08-ae-finish [header]
  (let [type (if (= :normal (get header :application)) :gravity.type/bool :gravity.type/never)]
    (assoc header :parameter-types (get header :argument-types) :return type :result-type type)))

(defn sh08-ae-derive [core node call edge nodes bindings types forms]
  ; STD2 value equality is closed here over six independently established
  ; atomic families. Never does not excuse the other operand's legality.
  (let [args (get call :argument-node-ids)
        owner (get forms (get (get node :source) :form-id)) ids (get owner :child-form-ids)]
    (let [header (sh08-ae-source core node call edge nodes bindings types (get core :module))]
      (if (= header nil)
        (sh08-sm-failure "C7-TYPE-MISMATCH"
          (if (= 2 (count args)) :atomic-equality-operand-type-required :atomic-equality-arity-mismatch)
          nil :two-established-supported-atomic-values (sh08-ft-ordered-child-types args types))
        (if (sh08-ft-all-true?
              [(= :list (get owner :kind)) (= (get node :source) (sh08-ma-form-source owner)) (vector? ids) (= 3 (if (vector? ids) (count ids) 0))
               (= {:operator-child-index 0 :argument-count 2 :argument-child-indexes [1 2]
                   :evaluation-order :operator-then-arguments :dispatch :resolved-symbol-call} (get node :attributes))
               (loop [i 0]
                 (if (= i 3) true
                   (let [form (get forms (get ids i)) child (get nodes (get (get node :children) i))]
                     (if (sh08-ft-all-true? [(= (get owner :form-id) (get form :parent-form-id))
                           (= (get child :source) (sh08-ma-form-source form))
                           (if (= i 0) (= (get form :value) (get (get child :attributes) :symbol)) true)])
                       (recur (+ i 1)) false))))])
          (let [descriptor (sh08-ae-finish header)]
            {:status :accepted :descriptor descriptor :type (get descriptor :result-type)
             :constraint (sh08-ae-constraint descriptor)})
          (sh08-sm-failure "C7-VERIFY" :atomic-equality-source-mismatch nil :exact-operator-left-right-source
            (get node :node-id)))))))

(defn sh08-ae-node? [node context]
  (if (= :call (get node :core-form))
    (if (sh08-sse-ids? (get node :resolved-binding-ids) 1)
      (let [binding (get (get context :ordering-bindings) (first (get node :resolved-binding-ids)))]
        (if (map? binding)
          (if (symbol? (get binding :name))
            (if (= '= (get binding :name))
              (if (keyword? (get binding :binding-class))
                (if (contains? #{:lexical :namespace :import} (get binding :binding-class)) false true) true) false) false) false)) false) false))

(defn sh08-ae-inferred-call-valid? [core node call edge nodes bindings types]
  (if (sh08-bka-entry? node call nodes bindings types (get core :module))
    (= :accepted (get (sh08-bka-inferred-call core node call edge nodes bindings types) :status))
    (if (sh08-sse-call-ids? node call)
  (if (= :gravity.type/applied-list-equality (get (get types (get call :operator-node-id)) :kind))
    (= :accepted (get (sh08-le-inferred-call core node call edge nodes bindings types) :status))
(if (contains? #{:gravity.type/applied-keyword-set-equality :gravity.type/applied-bare-keyword-anchor-set-equality :gravity.type/applied-string-set-equality} (get (get types (get call :operator-node-id)) :kind))
    (= :accepted (get (sh08-kse-inferred-call core node call edge nodes bindings types) :status))
      (if (= :gravity.type/applied-vector-equality (get (get types (get call :operator-node-id)) :kind))
    (= :accepted (get (sh08-ve-inferred-call core node call edge nodes bindings types) :status))
    (if (= :gravity.type/applied-integral-equality (get (get types (get call :operator-node-id)) :kind))
      (let [header (sh08-ie-source core node call edge nodes bindings types (get core :module))]
        (if (map? header) (= header (get types (get call :operator-node-id))) false))
    (let [header (sh08-ae-source core node call edge nodes bindings types (get core :module))]
      (if (map? header) (= (get types (get call :operator-node-id)) (sh08-ae-finish header)) false))))))
    false)))

(defn sh08-ie-type? [type]
  (if (keyword? type)
    (contains? #{:gravity.type/integer :gravity.type/i8 :gravity.type/i16 :gravity.type/i32 :gravity.type/i64
                 :gravity.type/u8 :gravity.type/u16 :gravity.type/u32 :gravity.type/u64} type) false))

(defn sh08-ie-family [arguments]
  (if (if (vector? arguments) (= 2 (count arguments)) false)
    (let [left (get arguments 0) right (get arguments 1)]
      (if (= :gravity.type/never left)
        (if (sh08-ie-type? right) right nil)
        (if (sh08-ie-type? left)
          (if (= left right) left (if (= :gravity.type/never right) left nil)) nil))) nil))

(defn sh08-ie-source [core node call edge nodes bindings types module]
  (if (if (vector? (get call :argument-node-ids))
        (if (= 2 (count (get call :argument-node-ids)))
          (if (vector? (get node :children)) (= 3 (count (get node :children))) false) false) false)
  (let [children (get node :children) operator (get nodes (get call :operator-node-id))
        bid (get call :operator-binding-id) binding (get bindings bid) args (get call :argument-node-ids)
        arguments (sh08-ft-ordered-child-types args types) family (sh08-ie-family arguments)
        invoked? (loop [remaining arguments]
                   (if (= 0 (count remaining)) true
                     (if (= :gravity.type/never (first remaining)) false (recur (rest remaining)))))
        caller (loop [remaining (get core :function-records)]
                 (if (= 0 (count remaining)) nil
                   (if (= (get (first remaining) :function-syntax-id) (get (get node :evaluation) :owner-function-syntax-id))
                     (first remaining) (recur (rest remaining)))))
        expected-call {:core-node-id (get node :node-id) :operator-node-id (first children) :operator-binding-id bid
                       :argument-node-ids (vec (rest children)) :ordered-evaluation-node-ids children
                       :evaluation-order :operator-then-arguments :result-policy :call-result}
        expected-edge {:ordinal (get edge :ordinal) :call-core-node-id (get node :node-id)
                       :caller-function-syntax-id (get caller :function-syntax-id) :caller-function-core-node-id (get caller :function-core-node-id)
                       :callee-binding-id bid :callee-definition-syntax-id (get binding :definition-syntax-id)
                       :callee-function-syntax-id nil :callee-function-core-node-id nil :argument-core-node-ids args
                       :ordered-evaluation-node-ids children :evaluation-order :operator-then-arguments :classification :nonlocal-or-nonfunction}]
    (if (sh08-ft-all-true?
          [(sh08-ie-type? family) (= :call (get node :core-form)) (= :reference (get operator :core-form))
           (= 2 (count args)) (= expected-call call) (= expected-edge edge) (sh08-ae-binding? binding module)
           (= [bid] (get node :resolved-binding-ids) (get operator :resolved-binding-ids))
           (= {:symbol (get (get operator :attributes) :symbol) :position :operator :binding-id bid :binding-class :core
               :definition-syntax-id (get binding :definition-syntax-id)} (get operator :attributes))
           (contains? '#{= gravity.core/=} (get (get operator :attributes) :symbol))
           (= :operator-then-arguments (get (get node :evaluation) :kind))
           (= (loop [i 0 out []] (if (= i (count children)) out
                (recur (+ i 1) (conj out {:index i :core-node-id (get children i)})))) (get (get node :evaluation) :order))
          ])
      {:kind :gravity.type/applied-integral-equality :version :sh08-integral-equality-v1
       :operation '= :semantic-owner 'gravity.math :layer0-owner 'gravity.math.core
       :intrinsic :gravity.math.core/integral-value-equality :resolution :gravity.core-compatibility
       :operator-node-id (get operator :node-id) :operator-binding-id bid :call-core-node-id (get node :node-id)
       :source (get node :source) :operator-source (get operator :source)
       :source-call call :source-edge edge :source-binding binding
       :argument-types arguments :parameter-types [family family] :integer-type family
       :return :gravity.type/bool :result-type (if invoked? :gravity.type/bool :gravity.type/never)
       :numeric-mode :proof-required :safety :proven-safe
       :safety-rule :same-integral-value-equality-no-conversion-overflow-or-rounding
       :equality-policy {:domain :same-integral-type :comparison :original-integer-values
                         :conversion :none :arithmetic :none :overflow :impossible :rounding :none :cross-type :unsupported}
       :application (if invoked? :normal :not-invoked)
       :latent-effects [] :direct-effects [] :capabilities [] :thrown-error-effects []
       :profile (get module :profile) :target (get module :target)
       :invalidation [:calls :call-edges :binding-table :source-forms :type-table :lexical-bindings :definitions :function-records
                      :callee-body :integral-type :numeric-mode :value-policy :profile :target :evaluation-order]} nil)) nil))

(defn sh08-ie-constraint [descriptor]
  {:constraint-id-request {:domain :gravity/sh08-integral-equality-constraint-v1 :application descriptor}
   :kind :numeric-mode :producer-rule :sh08-integral-equality-v1
   :lhs {:core-node-id (get descriptor :call-core-node-id) :projection :integral-equality}
   :rhs (get descriptor :result-type) :dependencies descriptor :origin (get (get descriptor :source) :origin-chain)
   :solution {:numeric-mode :proof-required :safety :proven-safe
              :safety-rule :same-integral-value-equality-no-conversion-overflow-or-rounding
              :result-type (get descriptor :result-type) :application (get descriptor :application)}
   :invalidation (get descriptor :invalidation) :profile (get descriptor :profile) :target (get descriptor :target)
   :status :solved :diagnostics []})

(defn sh08-ie-call-fact [descriptor module]
  (let [source (get descriptor :source) edge (get descriptor :source-edge)]
    {:artifact :gravity/c7-call-type-fact
     :fact-id-request {:domain :gravity/sh08-integral-equality-call-type-fact-v1 :application descriptor}
     :call-core-node-id (get descriptor :call-core-node-id) :caller-function-syntax-id (get edge :caller-function-syntax-id)
     :callee-function-syntax-id nil :argument-types (get descriptor :argument-types) :result-type (get descriptor :result-type)
     :evaluation-order :operator-then-arguments :source-span (get source :semantic-span) :syntax-id (get source :syntax-id)
     :origin-chain (get source :origin-chain) :generated-origin (get source :generated-origin)
     :profile (get module :profile) :target (get module :target) :effects [] :capabilities [] :status :inferred
     :dispatch :direct-integral-equality :applied-integral-equality descriptor :effect-facts-source :audited-numeric-intrinsic}))

(defn sh08-ie-derive [core node call edge nodes bindings types forms]
  (let [args (get call :argument-node-ids)]
    (if (if (vector? args) (= 2 (count args)) false)
        (let [arguments (sh08-ft-ordered-child-types args types) family (sh08-ie-family arguments)]
          (if (= family nil)
            (sh08-sm-failure "C7-TYPE-MISMATCH" :integral-equality-same-type-required nil
                     :two-independently-established-same-integral-values arguments)
            (let [header (sh08-ie-source core node call edge nodes bindings types (get core :module))
                  owner (get forms (get (get node :source) :form-id)) ids (get owner :child-form-ids)]
              (if (if (map? header)
                    (sh08-ft-all-true?
                      [(= :list (get owner :kind)) (= (get node :source) (sh08-ma-form-source owner))
                       (vector? ids) (= 3 (if (vector? ids) (count ids) 0))
                       (= {:operator-child-index 0 :argument-count 2 :argument-child-indexes [1 2]
                           :evaluation-order :operator-then-arguments :dispatch :resolved-symbol-call} (get node :attributes))
                       (loop [i 0]
                         (if (= i 3) true
                           (let [form (get forms (get ids i)) child (get nodes (get (get node :children) i))]
                             (if (sh08-ft-all-true? [(= (get owner :form-id) (get form :parent-form-id))
                                   (= (get child :source) (sh08-ma-form-source form))
                                   (if (= i 0) (= (get form :value) (get (get child :attributes) :symbol)) true)])
                               (recur (+ i 1)) false))))]) false)
                {:status :accepted :descriptor header :type (get header :result-type)
                 :constraint (sh08-ie-constraint header)}
                (sh08-sm-failure "C7-VERIFY" :integral-equality-source-mismatch nil :exact-operator-left-right-source
                         (get node :node-id))))))
        (sh08-sm-failure "C7-TYPE-MISMATCH" :integral-equality-arity-mismatch nil :binary-equality-call nil))))

(defn sh08-kse-domain [arguments]
  ; Independent finite literal Set types establish one Keyword or String member family.
  (if (if (vector? arguments) (= 2 (count arguments)) false)
    (loop [side 0 counts [] member-type nil]
      (if (= side 2)
        (let [result {:status :accepted :argument-types arguments :operand-counts counts}]
          (if (= :gravity.type/string member-type) (assoc result :comparison-domain :string-set) result))
        (let [type (get arguments side) strings? (= :gravity.type/string member-type)]
          (if (= :gravity.type/never type)
            (recur (+ side 1) (conj counts nil) member-type)
            (if (if (map? type) (if (= 3 (count type))
                  (if (= :gravity.type/set (get type :kind))
                    (if (= :literal (get type :shape)) (vector? (get type :element-types)) false) false) false) false)
              (let [members (get type :element-types)
                    checked (loop [i 0 family member-type]
                              (if (= i (count members)) {:status :accepted :member-type family}
                                (let [member (get members i)]
                                  (if (if (= :gravity.type/keyword member) true (= :gravity.type/string member))
                                    (if (if (= nil family) true (= family member))
                                      (recur (+ i 1) member)
                                      {:status :rejected :member-type family})
                                    {:status :rejected :member-type family}))))]
                (if (= :accepted (get checked :status))
                  (recur (+ side 1) (conj counts (count members)) (get checked :member-type))
                  {:status :rejected :reason (if (= :gravity.type/string (get checked :member-type))
                                              :string-set-equality-operand-type-required :keyword-set-equality-operand-type-required)}))
              {:status :rejected :reason (if strings? :string-set-equality-operand-type-required :keyword-set-equality-operand-type-required)})))))
    {:status :rejected :reason :keyword-set-equality-arity-mismatch}))

(defn sh08-sse-ids? [ids width]
  (if (vector? ids) (if (<= (count ids) 6) (if (= (count ids) width)
    (loop [remaining ids]
      (if (= 0 (count remaining)) true
        (if (if (keyword? (first remaining)) true
              (if (string? (first remaining)) (= 71 (count (first remaining))) false))
          (recur (rest remaining)) false))) false) false) false))

(defn sh08-sse-call-ids? [node call]
  (if (if (map? node) (map? call) false)
    (if (sh08-sse-ids? (get node :children) 3)
      (if (sh08-sse-ids? (get call :argument-node-ids) 2)
        (sh08-sse-ids? [(get node :node-id) (get call :core-node-id)
                      (get call :operator-node-id) (get call :operator-binding-id)
                      (get (get node :source) :form-id) (get (get node :source) :syntax-id)] 6) false) false) false))

(defn sh08-sse-domain [arguments]
  ; Standalone carrier equality only. Vector Set leaves retain kse-domain.
  (if (if (vector? arguments) (= 2 (count arguments)) false)
    (if (if (sh08-ss-type? (get arguments 0)) true (sh08-ss-type? (get arguments 1)))
      (loop [side 0 domains []]
        (if (= side 2)
          {:status :accepted :comparison-domain :string-set-carrier :argument-types arguments
           :operand-domains domains :carrier-schema :gravity/homogeneous-string-set-type-v1}
          (let [type (get arguments side)]
            (if (= :gravity.type/never type)
              (recur (+ side 1) (conj domains :never))
              (if (sh08-ss-type? type)
                (recur (+ side 1) (conj domains :homogeneous-string-set))
                (if (if (map? type) (if (= 3 (count type))
                      (if (= :gravity.type/set (get type :kind))
                        (if (= :literal (get type :shape)) (vector? (get type :element-types)) false) false) false) false)
                  (let [members (get type :element-types)]
                    (if (loop [i 0]
                          (if (= i (count members)) true
                            (if (= :gravity.type/string (get members i)) (recur (+ i 1)) false)))
                      (recur (+ side 1) (conj domains :finite-string-set))
                      {:status :rejected :comparison-domain :string-set-carrier :reason :string-set-carrier-equality-operand-type-required}))
                  {:status :rejected :comparison-domain :string-set-carrier :reason :string-set-carrier-equality-operand-type-required}))))))
      (sh08-kse-domain arguments))
    (sh08-kse-domain arguments)))

(defn sh08-kse-source [core node call edge nodes bindings types module validation]
  (if (sh08-sse-call-ids? node call)
  (if (if (vector? (get call :argument-node-ids))
        (if (= 2 (count (get call :argument-node-ids)))
          (if (vector? (get node :children)) (= 3 (count (get node :children))) false) false) false)
  (let [children (get node :children) operator (get nodes (get call :operator-node-id))
        bid (get call :operator-binding-id) binding (get bindings bid) args (get call :argument-node-ids)
        arguments (sh08-ft-ordered-child-types args types)
        invoked? (loop [remaining arguments]
                   (if (= 0 (count remaining)) true
                     (if (= :gravity.type/never (first remaining)) false (recur (rest remaining)))))
        caller (loop [remaining (get core :function-records)]
                 (if (= 0 (count remaining)) nil
                   (if (= (get (first remaining) :function-syntax-id) (get (get node :evaluation) :owner-function-syntax-id))
                     (first remaining) (recur (rest remaining)))))
        expected-call {:core-node-id (get node :node-id) :operator-node-id (first children) :operator-binding-id bid
                       :argument-node-ids (vec (rest children)) :ordered-evaluation-node-ids children
                       :evaluation-order :operator-then-arguments :result-policy :call-result}
        expected-edge {:ordinal (get edge :ordinal) :call-core-node-id (get node :node-id)
                       :caller-function-syntax-id (get caller :function-syntax-id) :caller-function-core-node-id (get caller :function-core-node-id)
                       :callee-binding-id bid :callee-definition-syntax-id (get binding :definition-syntax-id)
                       :callee-function-syntax-id nil :callee-function-core-node-id nil :argument-core-node-ids args
                       :ordered-evaluation-node-ids children :evaluation-order :operator-then-arguments :classification :nonlocal-or-nonfunction}]
    (if (sh08-ft-all-true?
          [(= :accepted (get validation :status)) (= arguments (get validation :argument-types))
           (= :call (get node :core-form)) (= :reference (get operator :core-form))
           (= :jvm (get module :target))
           (= 2 (count args)) (= expected-call call) (= expected-edge edge) (sh08-ae-binding? binding module)
           (= [bid] (get node :resolved-binding-ids) (get operator :resolved-binding-ids))
           (= {:symbol (get (get operator :attributes) :symbol) :position :operator :binding-id bid :binding-class :core
               :definition-syntax-id (get binding :definition-syntax-id)} (get operator :attributes))
           (contains? '#{= gravity.core/=} (get (get operator :attributes) :symbol))
           (= :operator-then-arguments (get (get node :evaluation) :kind))
           (= (loop [i 0 out []] (if (= i (count children)) out
                (recur (+ i 1) (conj out {:index i :core-node-id (get children i)})))) (get (get node :evaluation) :order))
          ])
      (if (= :string-set-carrier (get validation :comparison-domain))
        {:kind :gravity.type/applied-string-set-equality :version :sh08-string-set-carrier-equality-v1
       :operation '= :semantic-owner 'gravity.collections :intrinsic :gravity.collections/string-set-value-equality
       :resolution :gravity.core-compatibility :operator-node-id (get operator :node-id) :operator-binding-id bid
       :call-core-node-id (get node :node-id) :source (get node :source) :operator-source (get operator :source)
       :source-call call :source-edge edge :source-binding binding :argument-types arguments
       :operand-domains (get validation :operand-domains) :carrier-schema :gravity/homogeneous-string-set-type-v1
       :equality-policy {:domain :independently-established-string-sets :members :string-only
                         :static-cardinality :not-established :operand-extent :not-established
                         :comparison :guarded-atomic-string-leaf :strings :exact-valid-scalar-sequence
                         :normalization :none :locale :none :conversion :none :numeric :unsupported
                         :entry-contract :type-conforming-typed-calls :order :unobserved
                         :domain-validation :both-complete-before-result
                         :member-uniqueness :validated-before-cardinality
                         :identity :unobserved :payload-evaluation :none :mutation :none
                         :collection-construction :none :provider-cpu-bound :not-established}
       :application (if invoked? :normal :not-invoked)
       :latent-effects [] :direct-effects [] :capabilities [] :thrown-error-effects []
       :profile (get module :profile) :target (get module :target)
       :invalidation [:calls :call-edges :binding-table :source-forms :type-table :lexical-bindings :definitions :function-records
                      :callee-body :equality-domain :inferred-member-carrier :carrier-schema :finite-member-types
                      :string-equality-policy :value-policy :profile :target :evaluation-order]}
      (let [header {:kind :gravity.type/applied-keyword-set-equality :version :sh08-keyword-set-equality-v1
       :operation '= :semantic-owner 'gravity.collections :intrinsic :gravity.collections/keyword-set-value-equality
       :resolution :gravity.core-compatibility :operator-node-id (get operator :node-id) :operator-binding-id bid
       :call-core-node-id (get node :node-id) :source (get node :source) :operator-source (get operator :source)
       :source-call call :source-edge edge :source-binding binding :argument-types arguments
       :operand-counts (get validation :operand-counts)
       :equality-policy {:domain :finite-persistent-keyword-sets :members :keyword-only
                         :comparison :guarded-atomic-keyword-leaf :order :unobserved
                         :domain-validation :both-complete-before-result
                         :member-uniqueness :validated-before-cardinality
                         :identity :unobserved :payload-evaluation :none :mutation :none
                         :collection-construction :none :provider-cpu-bound :not-established}
       :application (if invoked? :normal :not-invoked)
       :latent-effects [] :direct-effects [] :capabilities [] :thrown-error-effects []
       :profile (get module :profile) :target (get module :target)
       :invalidation [:calls :call-edges :binding-table :source-forms :type-table :lexical-bindings :definitions :function-records
                      :callee-body :equality-domain :value-policy :profile :target :evaluation-order]}]
        (if (= :string-set (get validation :comparison-domain))
          (assoc header :kind :gravity.type/applied-string-set-equality :version :sh08-string-set-equality-v1
            :intrinsic :gravity.collections/string-set-value-equality
            :equality-policy (assoc (get header :equality-policy) :domain :finite-persistent-string-sets :members :string-only
                            :comparison :guarded-atomic-string-leaf :strings :exact-valid-scalar-sequence
                            :normalization :none :locale :none :conversion :none :numeric :unsupported
                            :entry-contract :type-conforming-typed-calls)
            :invalidation (conj (get header :invalidation) :string-equality-policy))
          header))) nil)) nil)
    nil))

(defn sh08-kse-constraint [descriptor]
  (if (= :gravity.type/applied-bare-keyword-anchor-set-equality (get descriptor :kind))
    (sh08-bka-constraint descriptor)
    (if (= :sh08-string-set-carrier-equality-v1 (get descriptor :version))
    {:constraint-id-request {:domain :gravity/sh08-string-set-carrier-equality-constraint-v1 :application descriptor}
   :kind :equality :producer-rule :sh08-string-set-carrier-equality-v1
   :lhs {:core-node-id (get descriptor :call-core-node-id) :projection :string-set-carrier-equality}
   :rhs (get descriptor :result-type) :dependencies descriptor :origin (get (get descriptor :source) :origin-chain)
   :solution {:result-type (get descriptor :result-type) :application (get descriptor :application)
              :direct-effects (get descriptor :direct-effects) :equality-policy (get descriptor :equality-policy)
              :operand-domains (get descriptor :operand-domains) :carrier-schema (get descriptor :carrier-schema)}

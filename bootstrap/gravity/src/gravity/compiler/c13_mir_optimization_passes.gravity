                      :conformance-fixture-acceptance]
   :rules [:domain-ir-is-not-separate-language
           :semantic-anchor-preserved-or-rebuilt
           :domain-verifier-before-exit
           :domain-optimized-result-reenters-through-evidence
           :fallback-or-rejection-recorded

                            :decision-id :pass-id
                            :source-span :artifact-node
                            :assumptions :method :provider
                            :profile :target :trust-status
                            :invalidated-by :result]
   :high-risk-pass-families [:check-retention-or-elision
                             :effect-aware-scheduling
                             :dispatch-specialization
                             :allocation-sinking
                             :region-arena-optimization
                             :loop-unrolling
                             :vectorization-preparation
                             :domain-ir-entry
                             :domain-ir-exit
                             :efir-fusion
                             :math-provider-selection]
   :rules [:high-risk-pass-has-evidence
           :proof-assumptions-checked-after-transform
           :imported-certificate-trust-verified
           :check-elision-records-dominating-proof
           :invalidated-certificate-rechecked-or-rejected]
   :forbidden [:benchmark-as-correctness-evidence
               :eml-tree-identity-as-equality-proof
               :manual-review-as-general-check-elision-proof
               :opaque-certificate-assumptions
               :proof-mapping-discarded-without-invalidation]})

(def c13-safety-preservation-contract
  {:artifact :gravity/c13-safety-preservation-contract
   :safety-outcomes [:proven-safe :runtime-checked
                     :rejected :unsafe-island]
   :check-classes [:bounds :integer-overflow :division-by-zero
                   :shift-count :null-or-option-access
                   :initialization :region-lifetime
                   :borrow-alias :linear-resource
                   :data-race :taint-sink
                   :capability-effect :unsafe-audit
                   :workflow-replay :ai-human-review]
   :elision-fields [:check-id :check-class :operation-id
                    :pass-id :decision-id :source-span
                    :dominating-proof :proof-dominates-use
                    :certificate :invalidated-by
                    :residual-checks :profile :target]
   :effect-rules [:preserve-effect-set
                  :preserve-required-capabilities
                  :preserve-ordering-constraints
                  :do-not-duplicate-noncommutative-effect
                  :do-not-eliminate-observable-effect
                  :reorder-only-with-effect-proof]
   :rules [:exactly-one-safety-outcome-survives
           :unsafe-island-metadata-preserved
           :runtime-check-retained-unless-perf10-safe15-proves-elision
           :policy-check-discharged-only-by-equivalent-policy-artifact
           :effect-preservation-before-scheduling-change]
   :forbidden [:implicit-fifth-safety-outcome
               :check-elision-by-assertion
               :capability-or-effect-check-removed-for-speed
               :unsafe-audit-record-dropped
               :effect-reordered-without-proof]})

(def c13-nondeterminism-contract
  {:artifact :gravity/c13-nondeterminism-contract
   :determinism-inputs [:source-hashes :compiler-id
                       :compiler-version :profile
                       :target :target-feature-set
                       :provider-set :package-graph
                       :build-inputs :optimization-level]
   :recorded-choice-fields [:choice-id :pass-id :decision-id
                            :candidate-set :selection-objective
                            :seed :autotune-inputs
                            :benchmark-inputs :target-fingerprint
                            :selected :fallback
                            :replay-record :hermetic-policy]
   :nondeterministic-sources [:random-search
                              :parallel-work-queue
                              :autotuning
                              :profile-guided-ranking
                              :provider-probing
                              :benchmark-measurement
                              :external-tool-or-model]
   :rules [:pass-order-stable
           :candidate-order-stable
           :random-seed-recorded
           :autotune-selection-replayable
           :hermetic-build-rejects-unreplayable-choice
           :benchmarks-rank-only-legal-candidates]
   :forbidden [:hidden-random-choice
               :filesystem-or-network-probe-without-build-effect
               :unrecorded-autotune-result
               :parallel-race-affecting-output
               :benchmark-used-as-correctness-evidence]})


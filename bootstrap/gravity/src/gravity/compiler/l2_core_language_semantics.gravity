  {:artifact :gravity/l2-set-mutation-execution-contract
   :schema-version 1
   :input :gravity/sh07-c6-verified-set-mutation-execution
   :scope :same-namespace-top-level-var
   :supported-value-forms [:literal :set!]
   :supported-literal-kinds [:nil :integer]
   :state-model :explicit-bounded-store
   :semantics [:evaluate-value-exactly-once
               :do-not-evaluate-target

; W5-owned executable C17 plugin/pass leaf.
; This is a bounded, deterministic :meta component.  It validates a complete
; plugin request and emits a path-neutral execution record; it is not a global
; plugin loader and it does not claim self-hosting or release completion.
(ns gravity.compiler.w5-c17-plugin-executor
  (:profile :meta)
  (:target :jvm)
  (:exports [w5-c17-policy
             w5-c17-plugin-manifest
             w5-c17-pass-contract
             w5-c17-sandbox-grant
             w5-c17-domain-registration
             w5-c17-facet-registration
             w5-c17-cache-key-inputs
             w5-c17-identity-input
             w5-c17-diagnostic
             w5-c17-diagnostic-catalog
             w5-c17-plugin-execute
             w5-c17-execute
             w5-c17-run
             w5-c17-verify
             w5-c17-verify-result
             w5-c17-recompute
             w5-c17-target-policy
             w5-c17-target-valid?
             w5-c17-request-target-valid?])
  (:effects #{})
  (:capabilities #{})
  (:safety :safe)
  (:metadata {:bootstrap
              {:stage :stage2
               :component :w5-c17-plugin-executor
               :owner :w5
               :source-language :gravity
               :seed :clojure-stage0
               :status :executable-leaf
               :scope :stage-owned-nonauthority
               :retirement-objective :replace-clojure-seed
               :ambient-authority-denied true
               :clojure-seed-boundary? true
               :stage2-target :jvm
               :candidate-target :llvm-x86_64-linux
               :candidate-platform {:os :linux :arch :x86_64 :backend :llvm
                                    :artifact-format :elf :abi :sysv-amd64}
               :unsupported-targets
               [:darwin :darwin-arm64 :darwin-x86_64 :windows]
               :unsupported-target-policies
               [{:target :darwin :support :unsupported
                 :invokes-clojure? false :links-jvm? false :fallback? false}
                {:target :darwin-arm64 :support :unsupported
                 :invokes-clojure? false :links-jvm? false :fallback? false}
                {:target :darwin-x86_64 :support :unsupported
                 :invokes-clojure? false :links-jvm? false :fallback? false}
                {:target :windows :support :unsupported
                 :invokes-clojure? false :links-jvm? false :fallback? false}]
               :cross-target-inference? false
               :fallback? false
               :self-hosted? false
               :release? false
               :full-language-credit? false
               :matrix-240-credit? false
               :public-authority? false
               :jvm-execution? false
               :authority :non-authority
               :non-authoritative? true
               :residual-boundaries #{:clojure-stage2-compiler-plan
                                      :jvm-stage2-runtime}
               :governing-document-ids ["C17" "C1" "C12" "C13"
                                        "C15" "C16" "C18" "L12"
                                        "L14" "L15" "D0" "D1"
                                        "D3" "D8" "D9"]
               :implements [:manifest-before-code
                             :api-compatibility
                             :package-trust-and-signature
                             :scoped-compiler-capabilities
                             :hermetic-build-effects
                             :sandbox-restrictions
                             :pass-contract-validation
                             :domain-registration
                             :facet-registration
                             :output-verifier-report
                             :plugin-execution-trace
                             :c16-compatible-cache-key
                             :stable-c17-diagnostics]
               :does-not-claim [:global-plugin-system
                                :global-pass-registry
                                :production-plugin-loading
                                :self-host-completion
                                :release-readiness
                                :authority-from-interface]
              :conformance {:accepted-fixtures
                             ["self-hosting/w5-c17/accepted/plugin-execution.gravity"
                              "self-hosting/w5-c17/accepted/plugin-execution.qst"]
                             :rejected-fixtures
                             ["self-hosting/w5-c17/rejected/invalid-plugin-execution.gravity"
                              "self-hosting/w5-c17/rejected/invalid-plugin-execution.qst"]}}}))

(def w5-c17-stage2-target :jvm)
(def w5-c17-candidate-target :llvm-x86_64-linux)
(def w5-c17-candidate-platform
  {:os :linux :arch :x86_64 :backend :llvm
   :artifact-format :elf :abi :sysv-amd64})
(def w5-c17-unsupported-targets
  [:darwin :darwin-arm64 :darwin-x86_64 :windows])
(def w5-c17-unsupported-target-policies
  [{:target :darwin :support :unsupported
    :invokes-clojure? false :links-jvm? false :fallback? false}
   {:target :darwin-arm64 :support :unsupported
    :invokes-clojure? false :links-jvm? false :fallback? false}
   {:target :darwin-x86_64 :support :unsupported
    :invokes-clojure? false :links-jvm? false :fallback? false}
   {:target :windows :support :unsupported
    :invokes-clojure? false :links-jvm? false :fallback? false}])
(def w5-c17-target-scope
  {:candidate-target w5-c17-candidate-target
   :candidate-platform w5-c17-candidate-platform
   :unsupported-targets w5-c17-unsupported-targets
   :unsupported-target-policies w5-c17-unsupported-target-policies
   :cross-target-inference? false
   :fallback? false})

(defn w5-c17-target-policy []
  w5-c17-target-scope)

(defn w5-c17-target-valid? [target]
  (= target w5-c17-target-scope))

(def w5-c17-policy
  {:artifact :gravity/w5-c17-plugin-execution-policy
   :schema-version 1
   :scope :w5-c17-executable-leaf
   :plugin-profile :meta
   :stage2-target w5-c17-stage2-target
   :target w5-c17-candidate-target
   :candidate-target w5-c17-candidate-target
   :candidate-platform w5-c17-candidate-platform
   :target-scope w5-c17-target-scope
   :unsupported-targets w5-c17-unsupported-targets
   :unsupported-target-policies w5-c17-unsupported-target-policies
   :cross-target-inference? false
   :fallback? false
   :compiler-api-version "1"
   :compiler-version "0.1.0"
   :allowed-trust-levels #{:sandboxed :trusted-package}
   :allowed-capabilities #{:compiler/ir-transform}
   :required-scopes #{:read-mir :write-mir :register-pass
                      :emit-diagnostics :emit-artifacts}
   :allowed-scopes #{:read-mir :write-mir :register-pass
                     :emit-diagnostics :emit-artifacts}
   :denied-authority #{:filesystem :network :process :environment
                       :clock :random :model-call :tool-call
                       :registry-access :compiler-private-state}
   :hermetic-build-effects #{:filesystem-read}
   :forbidden-build-effects #{:filesystem-write :environment-read
                              :network-fetch :process-spawn
                              :registry-query :model-call :tool-call
                              :clock-read :random-read}
   :required-pass-facts #{:source-spans :origin-chain :type-facts
                          :effect-facts :capability-facts}
   :required-trace-fields #{:plugin :pass :input :output :grants
                            :grant-hash :build-effects :decisions
                            :diagnostics :verifier-result :replay-record
                            :cache-key :provenance}
   :cache-key-inputs [:plugin-package :plugin-version :manifest-hash
                     :grants :dependencies :compiler-api-version
                     :build-effects :replay-records :input-artifacts]
   :diagnostics ["C17-MANIFEST" "C17-API" "C17-CAPABILITY"
                 "C17-BUILD-EFFECT" "C17-SANDBOX" "C17-PASS-CONTRACT"
                 "C17-OUTPUT" "C17-DOMAIN" "C17-FACET" "C17-TRUST"]
   :flags {:clojure-seed-boundary? true
           :self-hosted? false
           :release? false
           :production-execution? false
           :public-authority? false
           :full-language-credit? false
           :matrix-240-credit? false
           :authority :non-authority
           :non-authoritative? true}})


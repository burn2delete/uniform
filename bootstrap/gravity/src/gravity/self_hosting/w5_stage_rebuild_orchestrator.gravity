   [{:ordinal 0 :source-unit-id :compiler-source-a
     :logical-source-id "gravity/compiler/stage1"
     :content-id w5-stage-rebuild-source-a :byte-count 1200
     :dependencies []
     :source-span {:source-id :gravity.self-hosting/w5-stage-rebuild
                   :start-byte 0 :end-byte 32}}
    {:ordinal 1 :source-unit-id :compiler-source-b
     :logical-source-id "gravity/compiler/stage2"
     :content-id w5-stage-rebuild-source-b :byte-count 1500
     :dependencies [:compiler-source-a]
     :source-span {:source-id :gravity.self-hosting/w5-stage-rebuild
                   :start-byte 33 :end-byte 65}}
    {:ordinal 2 :source-unit-id :compiler-source-c
     :logical-source-id "gravity/compiler/stage3"
     :content-id w5-stage-rebuild-source-c :byte-count 1800
     :dependencies [:compiler-source-a :compiler-source-b]
     :source-span {:source-id :gravity.self-hosting/w5-stage-rebuild
                   :start-byte 66 :end-byte 98}}]})

(defn w5-stage-rebuild-present? [value]
  (if (= nil value) false true))

(defn w5-stage-rebuild-id? [value]
  (if (string? value) (> (count value) 0) false))

(defn w5-stage-rebuild-nonempty-string? [value]
  (if (string? value) (> (count value) 0) false))

(defn w5-stage-rebuild-exact-keys? [value expected]
  (if (map? value) (= (set (keys value)) expected) false))

(defn w5-stage-rebuild-member? [values value]
  (if (vector? values)
    (loop [index 0]
      (if (= index (count values))
        false
        (if (= value (get values index))
          true
          (recur (+ index 1)))))
    false))

(defn w5-stage-rebuild-span-valid? [span]
  (if (w5-stage-rebuild-exact-keys?
       span #{:source-id :start-byte :end-byte})
    (if (= :gravity.self-hosting/w5-stage-rebuild
           (get span :source-id))
      (if (integer? (get span :start-byte))
        (if (integer? (get span :end-byte))
          (if (>= (get span :start-byte) 0)
            (<= (get span :start-byte) (get span :end-byte))
              false)
          false)
        false)
      false)
    false))

(def w5-stage-rebuild-diagnostic-source-span-value
  {:source-id :gravity.self-hosting/w5-stage-rebuild
   :start-byte 0
   :end-byte 0})

(defn w5-stage-rebuild-diagnostic-source-span [request]
  (let [span (get request :source-span)]
    (if (w5-stage-rebuild-span-valid? span)
      span
      w5-stage-rebuild-diagnostic-source-span-value)))

(defn w5-stage-rebuild-platform-valid? [platform]
  (if (w5-stage-rebuild-exact-keys?
       platform #{:os :arch :backend :object-format :abi})
    (= platform (get w5-stage-rebuild-target-contract-value
                     :candidate-platform))
    false))

(defn w5-stage-rebuild-target-policy-valid? [target]
  (if (= false (get target :fallback?))
    (if (= true (get target :no-fallback?))
      (if (= false (get target :candidate-invokes-clojure?))
        (if (= false (get target :candidate-links-jvm?))
          (if (= [:darwin :darwin-arm64 :darwin-x86_64 :windows]
                 (get target :unsupported-targets))
            (= [{:target :darwin :invokes-clojure? false
                 :links-jvm? false :fallback? false}
                {:target :darwin-arm64 :invokes-clojure? false
                 :links-jvm? false :fallback? false}
                {:target :darwin-x86_64 :invokes-clojure? false
                 :links-jvm? false :fallback? false}
                {:target :windows :invokes-clojure? false
                 :links-jvm? false :fallback? false}]
               (get target :unsupported-target-policies))
            false)
          false)
        false)
      false)
    false))

(defn w5-stage-rebuild-target-valid? [target]
  (if (w5-stage-rebuild-exact-keys?
       target #{:target :os :arch :backend :object-format :abi
                :cross-target-inference? :darwin-fallback? :fallback?
                :unsupported-targets :unsupported-target-policies
                :candidate-invokes-clojure? :candidate-links-jvm?
                :no-fallback?})
    (if (= :llvm-x86_64-linux (get target :target))
      (if (= :linux (get target :os))
        (if (= :x86_64 (get target :arch))
          (if (= :llvm (get target :backend))
            (if (= :elf (get target :object-format))
              (if (= :sysv-amd64 (get target :abi))
                (if (= false (get target :cross-target-inference?))
                  (if (= false (get target :darwin-fallback?))
                    (w5-stage-rebuild-target-policy-valid? target)
                    false)
                  false)
                false)
              false)
            false)
          false)
        false)
      false)
    false))

(defn w5-stage-rebuild-provenance-valid? [provenance]
  (if (w5-stage-rebuild-exact-keys?
       provenance #{:source-id :logical-source-id :actual-source-path
                    :orchestrator-source-path})
    (if (= :gravity.self-hosting/w5-stage-rebuild
           (get provenance :source-id))
      (if (= "fixtures/w5-stage-rebuild/stage-rebuild"
             (get provenance :logical-source-id))
        (if (w5-stage-rebuild-nonempty-string?
             (get provenance :actual-source-path))
          (w5-stage-rebuild-nonempty-string?
           (get provenance :orchestrator-source-path))
          false)
        false)
      false)
    false))

(defn w5-stage-rebuild-stage-provenance-valid? [provenance stage]
  (if (w5-stage-rebuild-exact-keys?
       provenance #{:logical-source-id :actual-source-path})
    (if (= (str "gravity/compiler/" (str stage))
           (get provenance :logical-source-id))
      (w5-stage-rebuild-nonempty-string?
       (get provenance :actual-source-path))
      false)
    false))

(defn w5-stage-rebuild-artifact-provenance-valid? [provenance]
  (if (w5-stage-rebuild-exact-keys?
       provenance #{:actual-artifact-path})
    (w5-stage-rebuild-nonempty-string?
     (get provenance :actual-artifact-path))
    false))

(defn w5-stage-rebuild-source-entry-valid? [entry ordinal]
  (if (w5-stage-rebuild-exact-keys?
       entry #{:ordinal :source-unit-id :logical-source-id :content-id
               :byte-count :dependencies :source-span})
    (if (= ordinal (get entry :ordinal))
      (if (keyword? (get entry :source-unit-id))
        (if (w5-stage-rebuild-id? (get entry :logical-source-id))
          (if (w5-stage-rebuild-id? (get entry :content-id))
            (if (integer? (get entry :byte-count))
            (if (> (get entry :byte-count) 0)
              (if (vector? (get entry :dependencies))
                (w5-stage-rebuild-span-valid? (get entry :source-span))
                false)
                false)
              false)
            false)
          false)
        false)
      false)
    false))

(defn w5-stage-rebuild-source-inventory-valid? [inventory]
  (if (w5-stage-rebuild-exact-keys?
       inventory #{:inventory-id :catalog-id :schema-version
                   :source-language :source-count :entries})
    (if (= 1 (get inventory :schema-version))
      (if (= w5-stage-rebuild-inventory-id (get inventory :inventory-id))
        (if (= w5-stage-rebuild-catalog-id (get inventory :catalog-id))
          (if (= 3 (get inventory :source-count))
      (if (= :gravity (get inventory :source-language))
        (if (vector? (get inventory :entries))
          (if (= 3 (count (get inventory :entries)))
            (if (w5-stage-rebuild-id?
                 (get inventory :inventory-id))
              (if (w5-stage-rebuild-id?
                   (get inventory :catalog-id))
                (if (w5-stage-rebuild-source-entry-valid?
                     (get (get inventory :entries) 0) 0)
                  (if (w5-stage-rebuild-source-entry-valid?
                       (get (get inventory :entries) 1) 1)
                    (w5-stage-rebuild-source-entry-valid?
                     (get (get inventory :entries) 2) 2)
                    false)
                  false)
                false)
              false)
            false)
          false)
        false)
      false)
          false)
        false)
      false)
    false))

(defn w5-stage-rebuild-catalog-valid? [inventory]
  (= w5-stage-rebuild-catalog-id (get inventory :catalog-id)))

(defn w5-stage-rebuild-source-identity-valid? [request]
  (let [inventory (get request :source-inventory)
        entries (get inventory :entries)
        a (get entries 0) b (get entries 1) c (get entries 2)
        compiler (get request :compiler)
        stages (get request :stages)
        stage1 (get stages :stage1)
        stage2 (get stages :stage2)
        stage3 (get stages :stage3)]
    (if (= [:compiler-source-a :compiler-source-b :compiler-source-c]
           [(get a :source-unit-id)
            (get b :source-unit-id)
            (get c :source-unit-id)])
      (if (= [[] [:compiler-source-a]
              [:compiler-source-a :compiler-source-b]]
             [(get a :dependencies)
              (get b :dependencies)
              (get c :dependencies)])
        (if (= ["gravity/compiler/stage1"
                "gravity/compiler/stage2"
                "gravity/compiler/stage3"]
               [(get a :logical-source-id)
                (get b :logical-source-id)
                (get c :logical-source-id)])
          (if (= [w5-stage-rebuild-source-a
                  w5-stage-rebuild-source-b
                  w5-stage-rebuild-source-c]
                 [(get a :content-id)
                  (get b :content-id)
                  (get c :content-id)])
            (if (= [(get inventory :inventory-id)
                    (get inventory :inventory-id)]
                   [(get compiler :source-inventory-id)

                          (if (= false
                                 (get authority :cross-target-inference?))
                            (if (= false (get authority :darwin-fallback?))
                              (= true (get authority :no-fallback?))
                              false)
                            false)
                          false)
                        false)
                      false)
                    false)
                  false)
                false)
              false)
            false)
          false)
        false)
      false)))

(defn w5-stage-rebuild-target-coherent? [request]
  (let [candidate (get request :candidate-target)
        stages (get request :stages)
        sets (get request :artifact-sets)
        conformance (get request :conformance)]
    (if (w5-stage-rebuild-target-valid? candidate)
      (if (= :llvm-x86_64-linux (get (get stages :stage1) :target))
        (if (= :llvm-x86_64-linux (get (get stages :stage2) :target))
          (if (= :llvm-x86_64-linux (get (get stages :stage3) :target))
            (if (= :llvm-x86_64-linux (get (get sets :stage1) :target))
              (if (= :llvm-x86_64-linux (get (get sets :stage2) :target))
                (if (= :llvm-x86_64-linux (get (get sets :stage3) :target))
                  (= :llvm-x86_64-linux (get conformance :target))
                  false)
                false)
              false)
            false)
          false)
        false)
      false)))

(defn w5-stage-rebuild-top-level-valid? [request]
  (if (w5-stage-rebuild-exact-keys?
       request #{:artifact :schema-version :orchestrator-id
                 :stage2-harness :stage-order :source-inventory
                 :compiler :stages :artifact-sets :build-recipe
                 :environment :lock :toolchain :candidate-target
                 :conformance :boot5-matrix :boot7-equivalence-input
                 :boot7-equivalence-report :evidence :authority :provenance
                 :profile :source-span})
    (if (= :gravity/w5-stage-rebuild-request (get request :artifact))
      (if (= 1 (get request :schema-version))
      (if (= :gravity/w5-stage-rebuild-orchestrator
               (get request :orchestrator-id))
          (if (= :meta (get request :profile))
            (if (w5-stage-rebuild-exact-keys?
                 (get request :stage2-harness)
                 #{:target :authority :execution-status})
              (if (= :jvm (get (get request :stage2-harness) :target))
                (if (= :clojure-stage0
                       (get (get request :stage2-harness) :authority))
                  (if (= :harness-only
                         (get (get request :stage2-harness)
                              :execution-status))
                    (if (w5-stage-rebuild-span-valid? (get request :source-span))
                      (w5-stage-rebuild-provenance-valid?
                       (get request :provenance))
                      false)
                    false)
                  false)
                false)
              false)
            false)
          false)
        false)
      false)
    false))

(defn w5-stage-rebuild-diagnostic
  [rule request reason]
  {:artifact :gravity/diagnostic
   :schema-version 1
   :diagnostic-id rule
   :rule rule
   :severity :error
   :stage :stage-rebuild
   :profile :meta
   :target :llvm-x86_64-linux
   :reason reason
   :source-span (w5-stage-rebuild-diagnostic-source-span request)
   :provenance (get request :provenance)
   :facts {:source-span-preserved? true
           :actual-path-in-provenance-only true
           :candidate-target :llvm-x86_64-linux
           :candidate-abi :sysv-amd64
           :unsupported-targets [:darwin :darwin-arm64 :darwin-x86_64 :windows]
           :unsupported-target-policies
           [{:target :darwin :invokes-clojure? false :links-jvm? false
             :fallback? false}
            {:target :darwin-arm64 :invokes-clojure? false :links-jvm? false
             :fallback? false}
            {:target :darwin-x86_64 :invokes-clojure? false :links-jvm? false
             :fallback? false}
            {:target :windows :invokes-clojure? false :links-jvm? false
             :fallback? false}]
           :cross-target-inference? false
           :darwin-fallback? false
           :no-fallback? true
           :clojure-seed-boundary? true
           :self-hosted? false
           :release? false
           :public-authority? false
           :authority :non-authority}
   :remediation (get w5-stage-rebuild-remediations reason)
   :clojure-seed-boundary? true
   :self-hosted? false
   :release? false
   :public-authority? false
   :authority :non-authority})

(defn w5-stage-rebuild-rejected [request rule reason]
  {:artifact :gravity/w5-stage-rebuild-result
   :schema-version 1
   :status :rejected
   :completion :incomplete
   :diagnostics [(w5-stage-rebuild-diagnostic rule request reason)]
   :identity-input nil
   :provenance (get request :provenance)
   :stage-order (get request :stage-order)
   :candidate-target :llvm-x86_64-linux
   :verifier-gate {:decision :blocked :release-eligible? false}
   :clojure-seed-boundary? true
   :self-hosted? false
   :release? false
   :public-authority? false
   :authority :non-authority})

(defn w5-stage-rebuild-normalized-stage [stage]
  {:stage-id (get stage :stage-id)
   :stage-ordinal (get stage :stage-ordinal)
   :compiler-source-inventory-id
   (get stage :compiler-source-inventory-id)
   :compiler-source-id (get stage :compiler-source-id)
   :compiler-executable-id (get stage :compiler-executable-id)
   :verifier-executable-id (get stage :verifier-executable-id)
   :artifact-executable-id (get stage :artifact-executable-id)
   :artifact-set-id (get stage :artifact-set-id)
   :compiled-by-parent-executable-id
   (get stage :compiled-by-parent-executable-id)
   :compiled-by-executable-id
   (get stage :compiled-by-executable-id)
   :parent-artifact-set-id (get stage :parent-artifact-set-id)
   :build-recipe-id (get stage :build-recipe-id)
   :environment-id (get stage :environment-id)
   :lock-id (get stage :lock-id)
   :toolchain-id (get stage :toolchain-id)
   :conformance-id (get stage :conformance-id)
   :target (get stage :target)
   :evidence-class (get stage :evidence-class)
   :actual-execution-status (get stage :actual-execution-status)
   :independent-evidence-status
   (get stage :independent-evidence-status)})

(defn w5-stage-rebuild-normalized-stages [stages]
  [(w5-stage-rebuild-normalized-stage (get stages :stage1))
   (w5-stage-rebuild-normalized-stage (get stages :stage2))
   (w5-stage-rebuild-normalized-stage (get stages :stage3))])

(defn w5-stage-rebuild-normalized-artifact-set [artifact-set]
  {:artifact-set-id (get artifact-set :artifact-set-id)
   :stage-id (get artifact-set :stage-id)
   :target (get artifact-set :target)
   :status (get artifact-set :status)
   :artifact-ids (get artifact-set :artifact-ids)
   :compiled-by-executable-id
   (get artifact-set :compiled-by-executable-id)})

(defn w5-stage-rebuild-identity-input [request]
  {:artifact :gravity/w5-stage-rebuild-identity-input
   :schema-version 1
   :orchestrator-id (get request :orchestrator-id)
   :stage-order (get request :stage-order)
   :source-inventory (get request :source-inventory)
   :compiler
   {:compiler-source-inventory-id
    (get (get request :compiler) :compiler-source-inventory-id)
    :source-inventory-id
    (get (get request :compiler) :source-inventory-id)
    :compiler-source-id
    (get (get request :compiler) :compiler-source-id)
    :compiler-executable-id
    (get (get request :compiler) :compiler-executable-id)
    :verifier-executable-id
    (get (get request :compiler) :verifier-executable-id)
    :artifact-executable-id
    (get (get request :compiler) :artifact-executable-id)}
   :stages (w5-stage-rebuild-normalized-stages (get request :stages))
   :artifact-sets
   [(w5-stage-rebuild-normalized-artifact-set
     (get (get request :artifact-sets) :stage1))
    (w5-stage-rebuild-normalized-artifact-set
     (get (get request :artifact-sets) :stage2))
    (w5-stage-rebuild-normalized-artifact-set
   (get (get request :artifact-sets) :stage3))]
   :boot5-matrix (get request :boot5-matrix)
   :boot7-equivalence-input (get request :boot7-equivalence-input)
   :boot7-equivalence-report
   {:report-id (get (get request :boot7-equivalence-report) :report-id)
    :input-id (get (get request :boot7-equivalence-report) :input-id)
    :compiler-a-id (get (get request :boot7-equivalence-report)
                        :compiler-a-id)
    :compiler-b-id (get (get request :boot7-equivalence-report)
                        :compiler-b-id)
    :artifact-a-id (get (get request :boot7-equivalence-report)
                        :artifact-a-id)
    :artifact-b-id (get (get request :boot7-equivalence-report)
                        :artifact-b-id)
    :modes (get (get request :boot7-equivalence-report) :modes)
    :artifact-hash-status
    (get (get request :boot7-equivalence-report) :artifact-hash-status)
    :manifest-status (get (get request :boot7-equivalence-report)
                          :manifest-status)
    :diagnostic-status (get (get request :boot7-equivalence-report)
                            :diagnostic-status)
    :conformance-status (get (get request :boot7-equivalence-report)
                             :conformance-status)
    :runtime-output-status (get (get request :boot7-equivalence-report)
                               :runtime-output-status)
    :ir-status (get (get request :boot7-equivalence-report) :ir-status)
    :performance-status (get (get request :boot7-equivalence-report)
                             :performance-status)
    :accepted-delta-status (get (get request :boot7-equivalence-report)
                                :accepted-delta-status)
    :status (get (get request :boot7-equivalence-report) :status)}
   :build-recipe-id (get (get request :build-recipe) :recipe-id)
   :environment-id (get (get request :environment) :environment-id)
   :lock-id (get (get request :lock) :lock-id)
   :toolchain-id (get (get request :toolchain) :toolchain-id)
   :conformance-id (get (get request :conformance) :conformance-id)
   :boot5-matrix (get request :boot5-matrix)
   :boot7-equivalence-input (get request :boot7-equivalence-input)
   :boot7-equivalence-report-id
   (get (get request :boot7-equivalence-report) :report-id)
   :candidate-target (get request :candidate-target)
   :evidence-class (get (get request :evidence) :evidence-class)
   :authority :non-authority
   :clojure-seed-boundary? true
   :self-hosted? false
   :release? false
   :public-authority? false})

(defn w5-stage-rebuild-pending-record [request]
  {:stage-order w5-stage-rebuild-stage-order-value
   :stages (get request :stages)
   :artifact-sets (get request :artifact-sets)
   :compiler (get request :compiler)
   :build-recipe-id (get (get request :build-recipe) :recipe-id)
   :environment-id (get (get request :environment) :environment-id)
   :lock-id (get (get request :lock) :lock-id)
   :toolchain-id (get (get request :toolchain) :toolchain-id)
   :conformance-id (get (get request :conformance) :conformance-id)
   :candidate-target (get request :candidate-target)
   :boot5-matrix (get request :boot5-matrix)
   :boot7-equivalence-report-id
   (get (get request :boot7-equivalence-report) :report-id)
   :recomputation-mode :structural-only
   :raw-byte-hashes :pending
   :canonical-byte-hashes :pending
   :pending [:actual-stage1-execution :actual-stage2-execution
             :actual-stage3-execution :independent-artifact-evidence
             :independent-conformance-evidence]
   :status :incomplete})

(defn w5-stage-rebuild-result [request]
  {:artifact :gravity/w5-stage-rebuild-result
   :schema-version 1
   :status :accepted
   :completion :incomplete
   :stage-order (get request :stage-order)
   :harness-target :jvm
   :target :llvm-x86_64-linux
   :candidate-target (get request :candidate-target)
   :candidate-platform (get w5-stage-rebuild-target-contract-value
                            :candidate-platform)
   :unsupported-targets (get w5-stage-rebuild-target-contract-value
                             :unsupported-targets)
   :unsupported-target-policies
   (get w5-stage-rebuild-target-contract-value
        :unsupported-target-policies)
   :compiler (get request :compiler)
   :stages (get request :stages)
   :artifact-sets (get request :artifact-sets)
   :boot5-matrix (get request :boot5-matrix)
   :boot7-equivalence-input (get request :boot7-equivalence-input)
   :boot7-equivalence-report (get request :boot7-equivalence-report)
   :recomputation-mode :structural-only
   :hash-validation
   {:status :pending :raw-byte-hashes :pending
    :canonical-byte-hashes :pending}
   :pending-record (w5-stage-rebuild-pending-record request)
   :identity-input (w5-stage-rebuild-identity-input request)
   :provenance (get request :provenance)
   :verifier-gate
   {:decision :blocked
    :completion :incomplete
    :candidate-execution :pending
    :independent-evidence :pending
    :self-hosting-comparison :pending
    :boot5-matrix :pending
    :boot7-equivalence :pending
    :recomputation-mode :structural-only
    :hash-validation :pending
    :no-fallback? true
    :release-eligible? false
    :self-hosted? false
    :authority :non-authority}
   :residual-boundaries
   [:clojure-stage2-compiler-plan :jvm-stage2-runtime
    :candidate-execution :independent-rebuild-evidence
    :independent-conformance-evidence :full-language-coverage
    :seed-retirement]
   :diagnostics []
   :clojure-seed-boundary? true
   :self-hosted? false
   :release? false
   :public-authority? false
   :authority :non-authority})

(defn w5-stage-rebuild-validate [request]
  (if (not (w5-stage-rebuild-top-level-valid? request))
    [:W5-SR-SOURCE-CATALOG :catalog]
    (if (not (w5-stage-rebuild-source-inventory-valid?
              (get request :source-inventory)))
      [:W5-SR-SOURCE-CATALOG :catalog]
      (if (not (w5-stage-rebuild-catalog-valid?
                (get request :source-inventory)))
        [:W5-SR-SOURCE-CATALOG :catalog]
        (if (not (w5-stage-rebuild-source-identity-valid? request))
          [:W5-SR-SOURCE-IDENTITY :source-identity]
          (if (not (= :gravity/w5-stage-rebuild-orchestrator
                      (get request :orchestrator-id)))
            [:W5-SR-SOURCE-IDENTITY :source-identity]
            (if (not (w5-stage-rebuild-stage-order-valid? request))
          [:W5-SR-STAGE-ORDER :stage-order]
          (if (not (w5-stage-rebuild-lineage-valid? request))
            [:W5-SR-STAGE-LINEAGE :lineage]
            (if (not (w5-stage-rebuild-executable-valid? request))
              [:W5-SR-EXECUTABLE :executable]
              (if (not (w5-stage-rebuild-artifact-set-valid? request))
                [:W5-SR-ARTIFACT-SET :artifact-set]
                (if (not (w5-stage-rebuild-recipe-valid?
                          (get request :build-recipe)))
                  [:W5-SR-RECIPE :recipe]
                  (if (not (w5-stage-rebuild-environment-valid?
                            (get request :environment)))
                    [:W5-SR-ENVIRONMENT :environment]
                    (if (not (w5-stage-rebuild-lock-valid?
                              (get request :lock)))
                      [:W5-SR-LOCK :lock]
                      (if (not (w5-stage-rebuild-toolchain-valid?
                                (get request :toolchain)))
                        [:W5-SR-TOOLCHAIN :toolchain]
                        (if (not (w5-stage-rebuild-target-coherent?
                                  request))
                          [:W5-SR-TARGET :target]
                          (if (not (w5-stage-rebuild-conformance-valid?
                                    (get request :conformance)))
                            [:W5-SR-CONFORMANCE :conformance]
                            (if (not (w5-stage-rebuild-boot5-matrix-valid?
                                      (get request :boot5-matrix)))
                              [:W5-SR-MATRIX :boot5-matrix]
                              (if (not (w5-stage-rebuild-boot7-equivalence-valid?
                                        request))
                                [:W5-SR-EQUIVALENCE :boot7-equivalence-report]
                                (if (not (w5-stage-rebuild-evidence-valid?
                                          request))
                                  [:W5-SR-EVIDENCE :evidence]
                                  (if (not (w5-stage-rebuild-authority-valid?
                                            request))
                                    [:W5-SR-AUTHORITY :authority]
                                    (if (not (w5-stage-rebuild-stage-valid?
                                              (get (get request :stages) :stage1)
                                              :stage1 0))
                                      [:W5-SR-STAGE-LINEAGE :lineage]
                                      (if (not (w5-stage-rebuild-stage-valid?
                                                (get (get request :stages) :stage2)
                                                :stage2 1))
                                        [:W5-SR-STAGE-LINEAGE :lineage]
                                        (if (not (w5-stage-rebuild-stage-valid?
                                                  (get (get request :stages) :stage3)
                                                  :stage3 2))
                                          [:W5-SR-STAGE-LINEAGE :lineage]
                                          nil)))))))))))))))))))))))

(defn w5-stage-rebuild-orchestrate [request]
  (let [failure (w5-stage-rebuild-validate request)]
    (if (= nil failure)
      (w5-stage-rebuild-result request)
      (w5-stage-rebuild-rejected
       request (first failure) (second failure)))))

(defn w5-stage-rebuild-rebuild [request]
  (w5-stage-rebuild-orchestrate request))

(defn w5-stage-rebuild-run [request]
  (w5-stage-rebuild-orchestrate request))

(defn w5-stage-rebuild-execute [request]
  (w5-stage-rebuild-orchestrate request))

(defn w5-stage-rebuild-verify [request]
  (w5-stage-rebuild-orchestrate request))

(defn w5-stage-rebuild-recompute [request]
  (w5-stage-rebuild-orchestrate request))

(defn w5-stage-rebuild-structural-recompute [request]
  (w5-stage-rebuild-orchestrate request))

(defn w5-stage-rebuild-verify-result [request result]
  (let [recomputed (w5-stage-rebuild-orchestrate request)]
    (if (= recomputed result)
      {:artifact :gravity/w5-stage-rebuild-verification
       :schema-version 1
       :status :passed
       :recomputed true
       :verification-mode :structural-only
       :completion :blocked
       :hash-validation :pending
       :request-status (:status recomputed)
       :clojure-seed-boundary? true
       :self-hosted? false
       :release? false
       :public-authority? false
       :authority :non-authority}
      {:artifact :gravity/w5-stage-rebuild-verification
       :schema-version 1
       :status :rejected
       :recomputed true
       :verification-mode :structural-only
       :completion :blocked
       :hash-validation :pending
       :diagnostics
       [(w5-stage-rebuild-diagnostic
         "W5-SR-SUBSTITUTION" request :substitution)]
       :clojure-seed-boundary? true
       :self-hosted? false
       :release? false
       :public-authority? false
       :authority :non-authority})))

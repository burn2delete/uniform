; W5 Wave3 executable stage-rebuild orchestrator.
; This leaf validates supplied stage A -> B -> C records as data.  It never
; invokes a compiler, verifier, linker, toolchain, process, or host service.
; The :jvm declaration is only the current stage2 compiler-plan harness.
(ns gravity.self-hosting.w5-stage-rebuild-orchestrator
  (:profile :meta)
  (:target :jvm)
  (:exports [w5-stage-rebuild-policy
             w5-stage-rebuild-stage-order
             w5-stage-rebuild-target-contract
             w5-stage-rebuild-diagnostic-catalog
             w5-stage-rebuild-diagnostic
             w5-stage-rebuild-span-valid?
             w5-stage-rebuild-diagnostic-source-span
             w5-stage-rebuild-source-inventory
             w5-stage-rebuild-boot5-matrix
             w5-stage-rebuild-boot5-matrix-valid?
             w5-stage-rebuild-boot7-equivalence-valid?
             w5-stage-rebuild-identity-input
             w5-stage-rebuild-orchestrate
             w5-stage-rebuild-rebuild
             w5-stage-rebuild-run
             w5-stage-rebuild-execute
             w5-stage-rebuild-verify
             w5-stage-rebuild-recompute
             w5-stage-rebuild-structural-recompute
             w5-stage-rebuild-verify-result])
  (:effects #{})
  (:capabilities #{})
  (:safety :safe)
  (:metadata
   {:bootstrap
    {:stage :stage2
     :component :w5-stage-rebuild-orchestrator
     :owner :w5
     :source-language :gravity
     :seed :clojure-stage0
     :status :executable-leaf
     :scope :stage-owned-nonauthority
     :static-only? true
     :clojure-seed-boundary? true
     :self-hosted? false
     :release? false
     :public-authority? false
     :authority :non-authority
     :candidate-target :llvm-x86_64-linux
     :candidate-platform {:os :linux :arch :x86_64 :backend :llvm
                          :object-format :elf :abi :sysv-amd64}
     :unsupported-platforms [:darwin :darwin-arm64 :darwin-x86_64 :windows]
     :unsupported-targets [:darwin :darwin-arm64 :darwin-x86_64 :windows]
     :unsupported-target-policies
     [{:target :darwin :invokes-clojure? false :links-jvm? false
       :fallback? false}
      {:target :darwin-arm64 :invokes-clojure? false :links-jvm? false
       :fallback? false}
      {:target :darwin-x86_64 :invokes-clojure? false :links-jvm? false
       :fallback? false}
      {:target :windows :invokes-clojure? false :links-jvm? false
       :fallback? false}]
     :cross-target-inference? false
     :darwin-fallback? false
     :no-fallback? true
     :residual-boundaries {:stage2-compiler-plan :clojure-bootstrap
                           :stage2-runtime :jvm
                           :candidate-execution :pending
                           :independent-evidence :pending
                           :full-language-coverage :incomplete}
     :governing-document-ids ["D0" "D1" "D2" "D3" "D8" "D9"
                              "BOOT3" "BOOT4" "BOOT5" "BOOT7"]
     :does-not-claim [:stage-execution
                      :independent-rebuild
                      :self-hosting-completion
                      :release-readiness
                      :public-authority
                      :seed-retirement]}}))

(def w5-stage-rebuild-stage-order-value
  [:stage1 :stage2 :stage3])

(def w5-stage-rebuild-target-contract-value
  {:target :llvm-x86_64-linux
   :os :linux
   :arch :x86_64
   :backend :llvm
   :object-format :elf
   :abi :sysv-amd64
   :candidate-platform {:os :linux :arch :x86_64 :backend :llvm
                        :object-format :elf :abi :sysv-amd64}
   :unsupported-targets [:darwin :darwin-arm64 :darwin-x86_64 :windows]
   :unsupported-target-policies
   [{:target :darwin :invokes-clojure? false :links-jvm? false
     :fallback? false}
    {:target :darwin-arm64 :invokes-clojure? false :links-jvm? false
     :fallback? false}
    {:target :darwin-x86_64 :invokes-clojure? false :links-jvm? false
     :fallback? false}
    {:target :windows :invokes-clojure? false :links-jvm? false
     :fallback? false}]
   :cross-target-inference? false
   :darwin-fallback? false
   :no-fallback? true
   :jvm-harness-target :jvm})

(def w5-stage-rebuild-diagnostic-rules
  ["W5-SR-SOURCE-CATALOG" "W5-SR-SOURCE-IDENTITY"
   "W5-SR-STAGE-ORDER" "W5-SR-STAGE-LINEAGE"
   "W5-SR-EXECUTABLE" "W5-SR-ARTIFACT-SET"
   "W5-SR-RECIPE" "W5-SR-ENVIRONMENT" "W5-SR-LOCK"
   "W5-SR-TOOLCHAIN" "W5-SR-TARGET" "W5-SR-CONFORMANCE"
   "W5-SR-MATRIX" "W5-SR-EQUIVALENCE" "W5-SR-EVIDENCE"
   "W5-SR-AUTHORITY" "W5-SR-SUBSTITUTION"])

(def w5-stage-rebuild-remediations
  {:catalog :restore-source-catalog
   :source-identity :bind-source-content-and-ordinal
   :stage-order :restore-stage1-stage2-stage3-order
   :lineage :bind-parent-output-to-child-compiler
   :executable :bind-compiler-verifier-and-artifact-executables
   :artifact-set :bind-complete-stage-artifact-set
   :recipe :pin-build-recipe
   :environment :pin-hermetic-build-environment
   :lock :pin-dependency-lock
   :toolchain :pin-target-toolchain
   :target :use-exact-llvm-linux-target
   :conformance :attach-conformance-record
   :matrix :attach-boot5-compatibility-matrix
   :equivalence :attach-pending-boot7-equivalence-report
   :evidence :use-executable-record-with-pending-proof
   :authority :deny-fallback-and-authority
   :substitution :recompute-result-from-request})


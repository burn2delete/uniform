(defn w5-stage-rebuild-artifact-parent-executable-id [stage]
  (if (= :stage1 stage)
    w5-stage-rebuild-compiler-executable-id
    (if (= :stage2 stage)
      w5-stage-rebuild-stage1-executable-id
      w5-stage-rebuild-stage2-executable-id)))

(defn w5-stage-rebuild-policy []
  {:artifact :gravity/w5-stage-rebuild-orchestrator-policy
   :schema-version 1
   :scope :stage-owned-nonauthority
   :stage :stage2
   :profile :meta
   :harness-target :jvm
   :candidate-target :llvm-x86_64-linux
   :candidate-platform {:os :linux :arch :x86_64 :backend :llvm
                        :object-format :elf :abi :sysv-amd64}
   :stage-order w5-stage-rebuild-stage-order-value
   :required-stage-count 3
   :required-identities [:compiler-source-inventory-id
                         :compiler-executable-id
                         :verifier-executable-id
                         :artifact-executable-id
                         :artifact-set-id
                         :compiled-by-parent-executable-id
                         :build-recipe-id :environment-id :lock-id
                         :toolchain-id :conformance-id]
   :required-evidence-class :executable-record
   :diagnostics w5-stage-rebuild-diagnostic-rules
   :pending [:stage1-actual-execution :stage2-actual-execution
             :stage3-actual-execution :independent-rebuild-evidence
             :independent-conformance-evidence :self-hosting-comparison
             :seed-retirement]
   :unsupported-platforms [:darwin :darwin-arm64 :darwin-x86_64 :windows]
   :unsupported-targets [:darwin :darwin-arm64 :darwin-x86_64 :windows]
   :unsupported-target-policies
   [{:target :darwin :invokes-clojure? false :links-jvm? false
     :fallback? false}
    {:target :darwin-arm64 :invokes-clojure? false :links-jvm? false
     :fallback? false}
    {:target :darwin-x86_64 :invokes-clojure? false :links-jvm? false
     :fallback? false}
    {:target :windows :invokes-clojure? false :links-jvm? false
     :fallback? false}]
   :cross-target-inference? false
   :darwin-fallback? false
   :no-fallback? true
   :static-only? true
   :release-eligible? false
   :clojure-seed-boundary? true
   :self-hosted? false
   :release? false
   :public-authority? false
   :authority :non-authority

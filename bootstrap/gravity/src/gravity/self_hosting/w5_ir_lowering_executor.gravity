  {"W5-IR-SCHEMA" :repair-request-schema
   "W5-IR-TARGET" :use-frozen-linux-target
   "C11-MODULE" :repair-mir-module
   "C11-BLOCK" :terminate-every-block
   "C11-DOMINANCE" :repair-def-use-dominance
   "C11-TYPE" :restore-operation-types
   "C11-EFFECT" :restore-effect-ordering
   "C11-SAFETY" :restore-safety-outcome
   "C11-ORIGIN" :restore-source-origin
   "C11-DOMAIN" :restore-domain-anchor
   "C11-TARGET-LEAK" :remove-target-opcode
   "C11-VERIFY" :rerun-mir-verifier
   "C12-REGISTRATION" :register-domain-ir
   "C12-ANCHOR" :restore-semantic-anchor
   "C12-SCHEMA" :repair-domain-payload
   "C12-FACTS" :restore-domain-facts
   "C12-VERIFY" :rerun-domain-verifier

   "C13-PRESERVE" :restore-preserved-facts
   "C13-INVALIDATE" :regenerate-invalidated-facts
   "C13-PROOF" :attach-fresh-optimization-proof
   "C13-CHECK-ELISION" :retain-or-prove-check
   "C13-EFFECT" :restore-effect-order
   "C13-SAFETY" :refresh-safety-facts

; W5 Slice C executable MIR/domain-IR/optimization/lowering leaf.
; The leaf consumes supplied C11-C15 records, validates their contracts, and
; emits only a bounded stage2 orchestration record.  It does not run LLVM,
; native code, a JVM candidate, or the Stage10a C14 evidence carrier.
(ns gravity.self-hosting.w5-ir-lowering-executor
  (:profile :meta)
  (:target :jvm)
  (:exports [w5-ir-lowering-policy
             w5-ir-c11-mir-schema
             w5-ir-c12-domain-schema
             w5-ir-c13-pass-contract
             w5-ir-c14-lowering-policy
             w5-ir-c15-diagnostic-catalog
             w5-ir-source-span
             w5-ir-path-ends-with?
             w5-ir-diagnostic
             w5-ir-mir-valid?
             w5-ir-domain-valid?
             w5-ir-pass-valid?
             w5-ir-optimization-valid?
             w5-ir-lowering-valid?
             w5-ir-stage10a-valid?
             w5-ir-diagnostics-valid?
             w5-ir-request-valid?
             w5-ir-identity-input
             w5-ir-provenance
             w5-ir-lowering-execute
             w5-ir-execute
             w5-ir-run
             w5-ir-verify
             w5-ir-verify-result
             w5-ir-recompute])
  (:effects #{})
  (:capabilities #{})
  (:safety :safe)
  (:metadata
   {:bootstrap
    {:stage :stage2
     :component :w5-ir-lowering-executor
     :owner :w5-wave5-slice-c
     :source-language :gravity
     :seed :clojure-stage0
     :status :executable-leaf
     :scope :stage-owned-nonauthority
     :static-only? true
     :clojure-seed-boundary? true
     :self-hosted? false
     :release? false
     :public-authority? false
     :authority :non-authority
     :candidate-target :llvm-x86_64-linux
     :candidate-platform {:os :linux
                          :arch :x86_64
                          :backend :llvm
                          :artifact-format :elf
                          :abi :sysv-amd64}
     :unsupported-platforms [:darwin :darwin-arm64 :darwin-x86_64 :windows]
     :unsupported-target-policies
     [{:target :darwin :support :unsupported :invokes-clojure? false :links-jvm? false :fallback? false}
      {:target :darwin-arm64 :support :unsupported :invokes-clojure? false :links-jvm? false :fallback? false}
      {:target :darwin-x86_64 :support :unsupported :invokes-clojure? false :links-jvm? false :fallback? false}
      {:target :windows :support :unsupported :invokes-clojure? false :links-jvm? false :fallback? false}]
     :candidate-invokes-clojure? false
     :candidate-links-jvm? false
     :candidate-fallback? false
     :stage10a-executable-continuity? false
     :residual-boundaries {:stage2-compiler-plan :clojure-bootstrap
                           :stage2-runtime :jvm
                           :native-llvm-execution :pending
                           :independent-c14-replay :pending
                           :independent-proof-check :pending
                           :filesystem-authority false
                           :network-authority false
                           :process-authority false}
     :governing-documents ["C11" "C12" "C13" "C14" "C15"
                           "D6" "D8" "D9" "BOOT5" "BOOT6"
                           "BOOT7" "BOOT8" "TEST11" "TEST13"]
     :non-goals [:full-language-completion
                 :native-execution
                 :llvm-execution
                 :stage10a-executable-continuity
                 :public-release
                 :seed-retirement]}}))

(def w5-ir-candidate-target
  {:backend :llvm
   :os :linux
   :arch :x86_64
   :artifact-format :elf
   :abi :sysv-amd64
   :triple "x86_64-unknown-linux-gnu"})

(def w5-ir-unsupported-targets
  [:darwin :darwin-arm64 :darwin-x86_64 :windows])

(def w5-ir-unsupported-target-policies
  [{:target :darwin :support :unsupported :invokes-clojure? false :links-jvm? false :fallback? false}
   {:target :darwin-arm64 :support :unsupported :invokes-clojure? false :links-jvm? false :fallback? false}
   {:target :darwin-x86_64 :support :unsupported :invokes-clojure? false :links-jvm? false :fallback? false}
   {:target :windows :support :unsupported :invokes-clojure? false :links-jvm? false :fallback? false}])

(def w5-ir-mir-facts
  #{:types :effects :ownership :capabilities :safety :proofs
    :source-origins :profile :target})

(def w5-ir-operation-opcodes #{:const :add :domain-anchor})

(def w5-ir-diagnostic-ids
  ["W5-IR-SCHEMA" "W5-IR-TARGET" "C11-MODULE" "C11-BLOCK"
   "C11-DOMINANCE" "C11-TYPE" "C11-EFFECT" "C11-SAFETY"
   "C11-ORIGIN" "C11-DOMAIN" "C11-TARGET-LEAK" "C11-VERIFY"
   "C12-REGISTRATION" "C12-ANCHOR" "C12-SCHEMA" "C12-FACTS"
   "C12-VERIFY" "C12-PROOF" "C12-LOWERING" "C12-FALLBACK"
   "C13-CONTRACT" "C13-PRESERVE" "C13-INVALIDATE" "C13-PROOF"
   "C13-CHECK-ELISION" "C13-EFFECT" "C13-SAFETY"
   "C13-DOMAIN" "C13-NONDETERMINISM" "C13-VERIFY"
   "C14-INPUT" "C14-PROFILE" "C14-TARGET" "C14-ABI"
   "C14-RUNTIME" "C14-PROVIDER" "C14-PROOF-METADATA"
   "C14-CAPABILITY" "C14-UNSUPPORTED" "C14-MANIFEST"
   "C15-SCHEMA" "C15-ID" "C15-SPAN" "C15-ORIGIN"
   "C15-FACTS" "C15-REMEDIATION" "C15-REDACTION"
   "C15-ORDER" "C15-GOLDEN"])


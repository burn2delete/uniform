; Wave4 full-language evidence consumer.
; This is a static, fail-closed :meta consumer for the coordinator-owned
; 240-document inventory.  It does not generate or attest the inventory, run
; a compiler, execute a fixture, or grant completion authority.
(ns gravity.self-hosting.w5-full-language-evidence-verifier
  (:profile :meta)
  (:target :jvm)
  (:exports [w5-full-language-evidence-policy
             w5-full-language-evidence-diagnostic-catalog
             w5-full-target-valid?
             w5-full-source-fixture-path?
             w5-full-inventory-valid?
             w5-full-coverage-matrix-valid?
             w5-full-gap-report-valid?
             w5-full-task-list-valid?
             w5-full-attestations-valid?
             w5-full-reporting-valid?
             w5-full-evidence-valid?
             w5-full-claims-valid?
             w5-full-authority-valid?
             w5-full-request-valid?
             w5-full-identity-input
             w5-full-provenance
             w5-full-language-evidence-verify
             w5-full-language-evidence-execute
             w5-full-language-evidence-run
             w5-full-language-evidence-recompute
             w5-full-language-evidence-verify-result])
  (:effects #{})
  (:capabilities #{})
  (:safety :safe)
  (:metadata
   {:bootstrap
    {:stage :stage2
     :component :w5-full-language-evidence-verifier
     :owner :workstream-5
     :source-language :gravity
     :seed :clojure-stage0
     :status :executable-consumer
     :scope :wave4-full-language-evidence
     :static-only? true
     :authority :non-authority
     :provisional? true
     :inventory-count 240
     :named-gap-task-count 38
     :attestation-count 0
     :full-language-complete-count 0
     :candidate-target :llvm-x86_64-linux
     :candidate-platform {:os :linux :arch :x86_64 :backend :llvm
                          :artifact-format :elf :abi :sysv-amd64}
     :unsupported-targets [:darwin :darwin-arm64 :darwin-x86_64 :windows]
     :unsupported-target-policies
     [{:target :darwin :support :unsupported :invokes-clojure? false :links-jvm? false :fallback? false}
      {:target :darwin-arm64 :support :unsupported :invokes-clojure? false :links-jvm? false :fallback? false}
      {:target :darwin-x86_64 :support :unsupported :invokes-clojure? false :links-jvm? false :fallback? false}
      {:target :windows :support :unsupported :invokes-clojure? false :links-jvm? false :fallback? false}]
     :cross-target-inference? false
     :fallback? false
     :clojure-seed-boundary? true
     :self-hosted? false
     :release? false
     :public-authority? false
     :full-language-completion-authority? false
     :governing-inputs [:document-inventory :coverage-matrix :gap-report
                        :completion-attestations :full-language-roadmap]
     :non-goals [:inventory-generation :attestation-generation
                 :full-language-completion :public-authority]}}))


(defn w5-full-exact-keys? [value expected]
  (if (map? value) (= (set (keys value)) expected) false))

(defn w5-full-nonempty-string? [value]
  (if (string? value) (> (count value) 0) false))

(defn w5-full-lower-hex? [value]
  (if (or (= value "0") (= value "1") (= value "2") (= value "3")
          (= value "4") (= value "5") (= value "6") (= value "7")
          (= value "8") (= value "9") (= value "a") (= value "b")
          (= value "c") (= value "d") (= value "e") (= value "f"))
    true false))

(defn w5-full-sha-prefix? [value index]
  (if (= index 7)
    true
    (if (= (get value index) (get "sha256:" index))
      (w5-full-sha-prefix? value (+ index 1)) false)))

(defn w5-full-sha-tail? [value index]
  (if (= index 71)
    true
    (if (w5-full-lower-hex? (str (get value index)))
      (w5-full-sha-tail? value (+ index 1)) false)))

(defn w5-full-sha256-id? [value]
  (if (string? value)
    (if (= 71 (count value))
      (if (w5-full-sha-prefix? value 0)
        (w5-full-sha-tail? value 7) false)
      false)
    false))

(defn w5-full-member-from? [values value index]
  (if (= index (count values)) false
    (if (= value (get values index)) true
      (w5-full-member-from? values value (+ index 1)))))

(defn w5-full-member? [values value]
  (if (vector? values) (w5-full-member-from? values value 0) false))

(defn w5-full-position? [value]
  (if (w5-full-exact-keys? value #{:byte :line :column})
    (if (integer? (get value :byte))
      (if (>= (get value :byte) 0)
        (if (integer? (get value :line))
          (if (>= (get value :line) 1)
            (if (integer? (get value :column))
              (>= (get value :column) 1) false)
            false)
          false)
        false)
      false)
    false))

(defn w5-full-position-order-valid? [start end]
  (if (<= (get start :byte) (get end :byte))
    (if (<= (get start :line) (get end :line))
      (if (= (get start :line) (get end :line))
        (<= (get start :column) (get end :column))
        true)
      false)
    false))

(defn w5-full-suffix-match? [value suffix index]
  (if (= index (count suffix)) true
    (if (> (count suffix) (count value)) false
      (if (= (get value (- (count value) (+ index 1)))
             (get suffix (- (count suffix) (+ index 1))))
        (w5-full-suffix-match? value suffix (+ index 1)) false))))

(defn w5-full-path-ends-with? [value suffix]
  (if (and (string? value) (string? suffix))
    (w5-full-suffix-match? value suffix 0) false))

(defn w5-full-source-fixture-path? [value]
  (if (w5-full-path-ends-with? value ".gravity") true
    (w5-full-path-ends-with? value ".qst")))

(defn w5-full-span? [value]
  (if (w5-full-exact-keys?
       value #{:source-id :actual-source-path :start :end})
    (if (keyword? (get value :source-id))
      (if (w5-full-nonempty-string? (get value :actual-source-path))
        (if (w5-full-position? (get value :start))
          (if (w5-full-position? (get value :end))
            (w5-full-position-order-valid?
             (get value :start) (get value :end))
            false)
          false)
        false)
      false)
    false))

(defn w5-full-document-span-valid?
  [span source-id path sequence]
  (if (w5-full-span? span)
    (if (= source-id (get span :source-id))
      (if (w5-full-path-ends-with?
           (get span :actual-source-path) path)
        (if (= {:byte 0 :line (+ sequence 1) :column 1}
               (get span :start))
          (= {:byte 128 :line (+ sequence 1) :column 1}
             (get span :end))
          false)
        false)
      false)
    false))


(defn w5-full-request-valid? [request]
  (if (w5-full-request-shape-valid? request)
    (if (= :gravity/w5-full-language-evidence-request (get request :artifact))
      (if (= 1 (get request :schema-version))
        (if (= :incomplete (get request :claimed-status))
          (if (= :meta (get request :profile))
            (if (w5-full-target-valid? (get request :target-scope))

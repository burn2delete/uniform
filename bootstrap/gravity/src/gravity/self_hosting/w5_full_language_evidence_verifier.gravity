                      (if (w5-full-evidence-valid? request)
                        (if (w5-full-attestations-valid?
                             (get request :attestations))
                          (if (w5-full-claims-valid? (get request :claims))
                            (if (w5-full-authority-valid?
                                 (get request :authority))
                              (if (w5-full-request-source-span-valid?
                                   (get request :source-span))
                                (w5-full-source-fixture-path?
                                 (get (get request :source-span)
                                      :actual-source-path))
                                false)
                              false)
                            false)
                          false)
                        false)
                      false)
                    false)
                  false)
                false)
              false)
            false)
          false)
        false)
      false)
    false))

(defn w5-full-id-vector [rows field]
  (loop [remaining rows result []]
    (if (= 0 (count remaining)) result
      (recur (rest remaining)
             (conj result (get (first remaining) field))))))

(defn w5-full-span-semantic-input [span]
  {:source-id (get span :source-id)
   :start (get span :start)
   :end (get span :end)})

(defn w5-full-matrix-semantic-row [row]
  (let [positive (get row :positive)
        rejected (get row :rejected)
        provenance (get row :provenance)
        diagnostic (get row :diagnostic)]
    {:sequence (get row :sequence)
     :document-id (get row :document-id)
     :title (get row :title)
     :path (get row :path)
     :phase (get row :phase)
     :phaseName (get row :phaseName)
     :category (get row :category)
     :content-id (get row :content-id)
     :positive
     {:evidence-id (get positive :evidence-id)
      :status (get positive :status)
      :executable? (get positive :executable?)
      :content-id (get positive :content-id)
      :provenance-id (get positive :provenance-id)
      :source-span (w5-full-span-semantic-input (get positive :source-span))}
     :rejected
     {:evidence-id (get rejected :evidence-id)
      :status (get rejected :status)
      :specific? (get rejected :specific?)
      :diagnostic-id (get rejected :diagnostic-id)
      :content-id (get rejected :content-id)
      :provenance-id (get rejected :provenance-id)
      :source-span (w5-full-span-semantic-input (get rejected :source-span))}
     :provenance
     {:provenance-id (get provenance :provenance-id)
      :content-id (get provenance :content-id)
      :stage (get provenance :stage)
      :consumer-status (get provenance :consumer-status)}
     :source-span (w5-full-span-semantic-input (get row :source-span))
     :diagnostic
     {:diagnostic-id (get diagnostic :diagnostic-id)
      :reason (get diagnostic :reason)
      :severity (get diagnostic :severity)
      :source-span
      (w5-full-span-semantic-input (get diagnostic :source-span))}}))

(defn w5-full-matrix-semantic-input [rows]
  (loop [remaining rows result []]
    (if (= 0 (count remaining)) result
      (recur (rest remaining)
             (conj result
                   (w5-full-matrix-semantic-row (first remaining)))))))

(defn w5-full-gap-semantic-row [row]
  {:sequence (get row :sequence)
   :document-id (get row :document-id)
   :title (get row :title)
   :path (get row :path)
   :phase (get row :phase)
   :phaseName (get row :phaseName)
   :category (get row :category)
   :gaps (get row :gaps)
   :status (get row :status)
   :content-id (get row :content-id)
   :provenance-id (get row :provenance-id)
   :source-span (w5-full-span-semantic-input (get row :source-span))})

(defn w5-full-gap-semantic-input [rows]
  (loop [remaining rows result []]
    (if (= 0 (count remaining)) result
      (recur (rest remaining)
             (conj result (w5-full-gap-semantic-row (first remaining)))))))

(defn w5-full-identity-input [request]
  {:artifact (get request :artifact)
   :schema-version (get request :schema-version)
   :claimed-status (get request :claimed-status)
   :profile (get request :profile)
   :target-scope (get request :target-scope)
   :inventory-records (get request :inventory)
   :inventory-ids (w5-full-id-vector (get request :inventory) :id)
   :inventory-content-ids (w5-full-id-vector (get request :inventory)
                                             :content-id)
   :matrix-content-ids (w5-full-id-vector (get request :coverage-matrix)
                                          :content-id)
   :matrix-evidence-diagnostic-records
   (w5-full-matrix-semantic-input (get request :coverage-matrix))
   :gap-report-semantic-entries
   (w5-full-gap-semantic-input (get (get request :gap-report) :entries))
   :gap-task-ids (w5-full-id-vector (get request :gap-tasks) :task-id)
   :reporting-contract-sha256
   (get (get (get request :reporting) :contract) :raw-sha256)
   :reporting-inventory-sha256
   (get (get (get request :reporting) :inventory) :raw-sha256)
   :reporting-matrix-semantic-id
   (get (get (get request :reporting) :matrix) :semantic-id)
   :reporting-gap-semantic-id
   (get (get (get request :reporting) :gap-report) :semantic-id)
   :coverage (get request :coverage)
   :claims (get request :claims)
   :authority (get request :authority)})

(defn w5-full-path-vector [rows field]
  (loop [remaining rows result []]
    (if (= 0 (count remaining)) result
      (recur (rest remaining)
             (conj result (get (first remaining) field))))))

(defn w5-full-provenance [request]
  {:repository-root (get (get request :repository) :actual-root)
   :manifest-path (get (get request :repository) :actual-manifest-path)
   :source-span-path (get (get request :source-span) :actual-source-path)
   :inventory-paths (w5-full-path-vector (get request :inventory) :path)
   :matrix-span-paths
   (w5-full-path-vector (get request :coverage-matrix) :source-span)
   :gap-task-span-paths
   (w5-full-path-vector (get request :gap-tasks) :source-span)})

(defn w5-full-diagnostic-source-span [request]
  (if (w5-full-request-source-span-valid? (get request :source-span))
    (get request :source-span)
    {:source-id :gravity/w5-full-language-evidence
     :actual-source-path "<unavailable>"
     :start {:byte 0 :line 1 :column 1}
     :end {:byte 0 :line 1 :column 1}}))

(defn w5-full-diagnostic [request rule reason field remediation]
  {:artifact :gravity/w5-full-language-evidence-diagnostic
   :rule rule :diagnostic-id rule :severity :error
   :stage :w5-wave4-full-language-evidence
   :reason reason :field field :remediation remediation
   :source-span (w5-full-diagnostic-source-span request)
   :profile :meta :target :llvm-x86_64-linux
   :authority :non-authority :clojure-seed-boundary? true
   :self-hosted? false :release? false :public-authority? false})

(defn w5-full-first-failure [request]
  (if (not (w5-full-request-shape-valid? request))
    [(w5-full-diagnostic request "W5-FULL-SCHEMA"
                          :invalid-versioned-request-shape :request
                          :provide-exact-versioned-request)]
    (if (not (and (= :gravity/w5-full-language-evidence-request
                     (get request :artifact))
                   (= 1 (get request :schema-version))
                   (= :incomplete (get request :claimed-status))
                   (= :meta (get request :profile))))
      [(w5-full-diagnostic request "W5-FULL-SCHEMA"
                            :invalid-versioned-request-header :request
                            :provide-exact-versioned-request)]
      (if (not (w5-full-span? (get request :source-span)))
        [(w5-full-diagnostic request "W5-FULL-SCHEMA"
                              :source-span-missing :source-span
                              :provide-stable-source-span)]
      (if (not (w5-full-request-source-span-valid?
                (get request :source-span)))
        [(w5-full-diagnostic
          request "W5-FULL-SCHEMA"
          :source-span-origin-or-coordinate-mismatch
          :source-span
          :bind-exact-source-id-start-and-end)]
      (if (not (w5-full-source-fixture-path?
                (get (get request :source-span) :actual-source-path)))
        [(w5-full-diagnostic
          request "W5-FULL-PROVENANCE"
          :source-fixture-path-extension-mismatch
          :source-span
          :bind-actual-gravity-or-qst-source-path)]
      (if (not (w5-full-target-valid? (get request :target-scope)))
      [(w5-full-diagnostic request "W5-FULL-TARGET"
                            :candidate-target-incoherent :target-scope
                            :use-exact-linux-x86-64-llvm-elf-sysv-scope)]
      (if (not (w5-full-reporting-valid? (get request :reporting)))
        [(w5-full-diagnostic request "W5-FULL-REPORTING"
                              :reporting-identity-keyset-counter-or-admission-mismatch
                              :reporting :bind-frozen-reporting-v1-observation)]
      (if (not (w5-full-inventory-valid? (get request :inventory)))
        [(w5-full-diagnostic request "W5-FULL-INVENTORY"
                              :inventory-sequence-or-substitution :inventory
                              :bind-exact-240-document-inventory)]
        (if (not (w5-full-coverage-shape-valid? (get request :coverage)))
          [(w5-full-diagnostic request "W5-FULL-MATRIX"
                                :global-advancement-or-coverage-count-mismatch
                                :coverage :keep-zero-completion-blocked)]
          (if (not (w5-full-coverage-matrix-valid? request))
          [(w5-full-diagnostic request "W5-FULL-MATRIX"
                                :per-document-executable-evidence-incomplete
                                :coverage-matrix
                                :bind-positive-and-rejected-specific-evidence)]
          (if (not (w5-full-gap-report-valid? request))
            [(w5-full-diagnostic request "W5-FULL-GAPS"
                                  :gap-report-sequence-or-provenance-mismatch
                                  :gap-report :bind-current-gap-report)]
            (if (not (w5-full-task-list-valid? (get request :gap-tasks)))
              [(w5-full-diagnostic request "W5-FULL-TASKS"
                                    :named-gap-task-list-mismatch :gap-tasks
                                    :bind-all-38-named-gap-task-ids)]
              (if (not (w5-full-attestations-valid?
                        (get request :attestations)))
                [(w5-full-diagnostic request "W5-FULL-ATTESTATION"
                                      :completion-attestation-present-or-mismatch
                                      :attestations
                                      :keep-zero-current-attestations)]
                (if (not (w5-full-claims-valid? (get request :claims)))
                  [(w5-full-diagnostic request "W5-FULL-CLAIMS"
                                        :forbidden-evidence-claim
                                        :claims
                                        :reject-narrative-producer-owner-check-replay-claims)]
                  (if (not (w5-full-authority-valid?
                            (get request :authority)))
                    [(w5-full-diagnostic request "W5-FULL-AUTHORITY"
                                          :authority-or-seed-boundary-forgery
                                          :authority
                                          :keep-provisional-nonauthority-boundary)]
                    (if (not (w5-full-repository-valid?
                              (get request :repository)))
                      [(w5-full-diagnostic request "W5-FULL-PROVENANCE"
                                            :consumer-provenance-missing
                                            :repository
                                            :bind-path-bearing-consumer-provenance)]
                      [])))))))))))))))))

(def w5-full-gaps
  [:inventory-incomplete :positive-evidence-pending
   :rejected-specific-evidence-pending :provenance-pending
   :attestations-zero :all-38-gap-tasks-open :global-advancement-blocked
   :clojure-seed-boundary :independent-review-pending])

(defn w5-full-accepted-result [request]
  {:status :accepted
   :artifact :gravity/w5-full-language-evidence-verification
   :schema-version 1
   :trust-status :incomplete
   :closure-status :blocked
   :inventory-count 240
   :full-language-complete-count 0
   :attestation-count 0
   :named-gap-task-count 38
   :named-task-satisfied-count 0
   :identity-input (w5-full-identity-input request)
   :provenance (w5-full-provenance request)
   :gaps w5-full-gaps
   :diagnostics []
   :authority :non-authority
   :public-authority? false
   :full-language-completion-authority? false
   :reporting-observation (get request :reporting)
   :completion-admission
   "disabled-pending-target-coherent-public-native-evidence-v2"
   :clojure-seed-boundary? true
   :self-hosted? false
   :release? false
   :attestations-current? false
   :all-named-gap-tasks-satisfied? false
   :actual-stage2-harness :jvm})

(defn w5-full-language-evidence-verify [request]
  (let [diagnostics (w5-full-first-failure request)]
    (if (= 0 (count diagnostics))
      (w5-full-accepted-result request)
      {:status :rejected
       :artifact :gravity/w5-full-language-evidence-verification
       :schema-version 1
       :trust-status :incomplete
       :closure-status :blocked
       :inventory-count 0
       :full-language-complete-count 0
       :attestation-count 0
       :named-gap-task-count 38
       :named-task-satisfied-count 0
       :identity-input nil
       :provenance nil
       :gaps w5-full-gaps
       :diagnostics diagnostics
       :authority :non-authority
       :public-authority? false
       :full-language-completion-authority? false
       :clojure-seed-boundary? true
       :self-hosted? false
       :release? false})))

(defn w5-full-language-evidence-execute [request]
  (w5-full-language-evidence-verify request))

(defn w5-full-language-evidence-run [request]
  (w5-full-language-evidence-verify request))

(defn w5-full-language-evidence-recompute [request]
  (w5-full-language-evidence-verify request))

(defn w5-full-language-evidence-verify-result [request candidate]
  (let [expected (w5-full-language-evidence-verify request)]
    (if (= expected candidate)
      {:status :passed :artifact :gravity/w5-full-language-evidence-result
       :schema-version 1 :trust-status (get expected :trust-status)
       :closure-status (get expected :closure-status) :diagnostics []
       :authority :non-authority :clojure-seed-boundary? true
       :self-hosted? false :release? false}
      {:status :rejected :artifact :gravity/w5-full-language-evidence-result
       :schema-version 1 :trust-status :incomplete
       :closure-status :blocked
       :diagnostics
       [(w5-full-diagnostic request "W5-FULL-SUBSTITUTION"
                             :verification-result-substitution :result
                             :recompute-consumer-result)]
       :authority :non-authority :clojure-seed-boundary? true
       :self-hosted? false :release? false})))

(defn w5-full-language-evidence-policy []
  {:artifact :gravity/w5-full-language-evidence-policy
   :schema-version 1 :scope :wave4-full-language-evidence-consumer
   :profile :meta :target :jvm :inventory-count 240
   :named-gap-task-count 38 :named-gap-task-ids w5-full-gap-task-ids
   :attestation-count 0 :full-language-complete-count 0
   :candidate-target :llvm-x86_64-linux
   :candidate-platform {:os :linux :arch :x86_64 :backend :llvm
                        :artifact-format :elf :abi :sysv-amd64}
   :unsupported-targets [:darwin :darwin-arm64 :darwin-x86_64 :windows]
   :unsupported-target-policies w5-full-unsupported-target-policies
   :cross-target-inference? false :fallback? false
   :required-document-evidence [:executable-positive :rejected-specific
                                :provenance :source-span :diagnostic :content-id]
   :forbidden-completion-evidence
   [:narrative :producer-boolean :source-ownership :check-only :replay-only
    :global-advancement]
   :completion-status :blocked :interface-status :provisional-nonauthority
   :authority :non-authority :public-authority? false
   :reporting-observation w5-full-reporting-observation
   :completion-admission
   "disabled-pending-target-coherent-public-native-evidence-v2"
   :clojure-seed-boundary? true :self-hosted? false :release? false
   :full-language-completion-authority? false
   :pending [:gravity-authored-240-document-coverage
             :per-document-executable-positive-evidence
             :per-document-rejected-specific-evidence
             :completion-attestations :independent-review]})

(defn w5-full-language-evidence-diagnostic-catalog []
  {:artifact :gravity/w5-full-language-evidence-diagnostic-catalog
   :schema-version 1 :diagnostics w5-full-diagnostic-ids
   :remediation
   {"W5-FULL-SCHEMA" :provide-exact-versioned-request
    "W5-FULL-TARGET" :use-exact-linux-x86-64-llvm-elf-sysv-scope
    "W5-FULL-INVENTORY" :bind-exact-240-document-inventory
    "W5-FULL-MATRIX" :bind-positive-and-rejected-specific-evidence
    "W5-FULL-GAPS" :bind-current-gap-report
    "W5-FULL-TASKS" :bind-all-38-named-gap-task-ids
    "W5-FULL-ATTESTATION" :keep-zero-current-attestations
    "W5-FULL-EVIDENCE" :provide-executable-evidence
    "W5-FULL-CLAIMS" :reject-narrative-producer-owner-check-replay-claims
    "W5-FULL-AUTHORITY" :keep-provisional-nonauthority-boundary
    "W5-FULL-PROVENANCE" :bind-path-bearing-consumer-provenance
    "W5-FULL-REPORTING" :bind-frozen-reporting-v1-observation
    "W5-FULL-SUBSTITUTION" :recompute-consumer-result}})

; W5 Wave3 trust, provenance, and TCB verifier.
; This source is an executable, static-only audit leaf.  It consumes supplied
; records; it never reads the host, runs a toolchain, signs, or promotes trust.
(ns gravity.self-hosting.w5-trust-provenance-verifier
  (:profile :meta)
  ; :jvm is only the explicit stage2 seed-plan harness.  Candidate evidence
  ; below is always exact LLVM/ELF/SysV on Linux x86_64.
  (:target :jvm)
  (:exports [w5-trust-provenance-policy
             w5-trust-provenance-diagnostic-catalog
             w5-trust-span?
             w5-trust-diagnostic-source-span
             w5-trust-target-valid?
             w5-trust-upstream-valid?
             w5-trust-lineage-valid?
             w5-trust-dependency-graphs-valid?
             w5-trust-locks-valid?
             w5-trust-environments-valid?
             w5-trust-toolchains-valid?
             w5-trust-build-recipes-valid?
             w5-trust-r3-recipe-cross-binding-valid?
             w5-trust-diverse-rebuilds-valid?
             w5-trust-anchors-valid?
             w5-trust-attestations-valid?
             w5-trust-sbom-valid?
             w5-trust-signatures-valid?
             w5-trust-revocations-valid?
             w5-trust-revocation-subjects-valid?
             w5-trust-unsafe-audits-valid?
             w5-trust-tcb-delta-valid?
             w5-trust-equivalence-valid?
             w5-trust-replay-valid?
             w5-trust-authority-valid?
             w5-trust-review-valid?
             w5-trust-claims-valid?
             w5-trust-request-valid?
             w5-trust-identity-input
             w5-trust-provenance
             w5-trust-provenance-verify
             w5-trust-provenance-execute
             w5-trust-provenance-run
             w5-trust-provenance-recompute
             w5-trust-structural-recompute
             w5-trust-verify-result])
  (:effects #{})
  (:capabilities #{})
  (:safety :safe)
  (:metadata
   {:bootstrap
    {:stage :stage2
     :component :w5-trust-provenance-verifier
     :owner :workstream-5
     :source-language :gravity
     :seed :clojure-stage0
     :status :executable-leaf
     :scope :wave3-static-audit
     :static-only? true
     :authority :non-authority
     :clojure-seed-boundary? true
     :self-hosted? false
     :release? false
     :public-authority? false
     :candidate-target :llvm-x86_64-linux
     :candidate-platform {:os :linux :arch :x86_64 :backend :llvm
                          :artifact-format :elf :abi :sysv-amd64}
     :unsupported-platforms [:darwin :darwin-arm64 :darwin-x86_64 :windows]
     :unsupported-target-policies
     [{:target :darwin :invokes-clojure? false :links-jvm? false :fallback? false}
      {:target :darwin-arm64 :invokes-clojure? false :links-jvm? false :fallback? false}
      {:target :darwin-x86_64 :invokes-clojure? false :links-jvm? false :fallback? false}
      {:target :windows :invokes-clojure? false :links-jvm? false :fallback? false}]
     :cross-target-inference? false
     :darwin-fallback? false
     :residual-boundaries #{:clojure-stage2-compiler-plan
                            :jvm-stage2-runtime
                            :native-linux-replay
                            :independent-trust-anchors
                            :independent-sol-review
                            :external-signing}
     :governing-documents [:D9 :PKG7 :PKG10 :PKG12 :BOOT6 :BOOT8]
     :non-goals [:native-execution :signing :release-promotion
                 :seed-retirement :cross-target-inference :darwin-support]}}))

(def w5-trust-equivalence-modes
  [:artifact :manifest :diagnostic :conformance :runtime-output
   :ir-modulo-id :reviewed-delta])

(def w5-trust-target-scope
  {:candidate-target :llvm-x86_64-linux
   :os :linux
   :arch :x86_64
   :backend :llvm
   :artifact-format :elf
   :abi :sysv-amd64
   :unsupported-targets [:darwin :darwin-arm64 :darwin-x86_64 :windows]
   :unsupported-target-policies
   [{:target :darwin :invokes-clojure? false :links-jvm? false :fallback? false}
    {:target :darwin-arm64 :invokes-clojure? false :links-jvm? false :fallback? false}
    {:target :darwin-x86_64 :invokes-clojure? false :links-jvm? false :fallback? false}
    {:target :windows :invokes-clojure? false :links-jvm? false :fallback? false}]
   :cross-target-inference? false
   :darwin-fallback? false})

(def w5-trust-diagnostic-ids
  ["W5-TRUST-SCHEMA" "W5-TRUST-TARGET" "W5-TRUST-UPSTREAM"
   "W5-TRUST-LINEAGE" "W5-TRUST-DEPENDENCY" "W5-TRUST-LOCK"
   "W5-TRUST-ENVIRONMENT" "W5-TRUST-TOOLCHAIN" "W5-TRUST-RECIPE"
   "W5-TRUST-DIVERSITY" "W5-TRUST-ANCHOR" "W5-TRUST-ATTESTATION"
   "W5-TRUST-SBOM" "W5-TRUST-SIGNATURE" "W5-TRUST-REVOCATION"
   "W5-TRUST-UNSAFE-AUDIT" "W5-TRUST-TCB" "W5-TRUST-EQUIVALENCE"
   "W5-TRUST-REPLAY" "W5-TRUST-AUTHORITY" "W5-TRUST-REVIEW"
   "W5-TRUST-SUBSTITUTION"])

(defn w5-trust-provenance-policy []
  {:artifact :gravity/w5-trust-provenance-policy
   :schema-version 1
   :scope :wave3-static-only
   :profile :meta
   :target :jvm
   :candidate-target :llvm-x86_64-linux
   :candidate-platform {:os :linux :arch :x86_64 :backend :llvm
                        :artifact-format :elf :abi :sysv-amd64}
   :unsupported-platforms [:darwin :darwin-arm64 :darwin-x86_64 :windows]
   :unsupported-target-policies
   [{:target :darwin :invokes-clojure? false :links-jvm? false :fallback? false}
    {:target :darwin-arm64 :invokes-clojure? false :links-jvm? false :fallback? false}
    {:target :darwin-x86_64 :invokes-clojure? false :links-jvm? false :fallback? false}
    {:target :windows :invokes-clojure? false :links-jvm? false :fallback? false}]
   :cross-target-inference? false
   :darwin-fallback? false
   :no-fallback? true
   :required-evidence [:exact-lineage :dependency-graphs :locks :environments
                        :toolchains :build-recipes :diverse-rebuilds
                        :trust-anchors :attestations :sbom :signatures
                        :revocations :unsafe-island-audits :tcb-delta
                        :stage-equivalence :native-replay :upstream-identities]
   :required-sbom-fields [:dependencies :capabilities :generated-sources
                          :binary-blobs :unsafe-audit-ids]
   :required-equivalence-modes w5-trust-equivalence-modes
   :pending [:native-linux-replay :independent-trust-anchors
             :independent-sol-review :actual-stage-equivalence
             :external-signing :attestation-verification]
   :static-only? true
   :release-eligible? false
   :authority :non-authority
   :clojure-seed-boundary? true
   :self-hosted? false
   :release? false
   :public-authority? false
   :residual-trusted-components
   [:clojure-stage0-seed :jvm-stage2-runtime :native-linux-replay
    :independent-trust-anchors :independent-sol-review :stage-equivalence
    :external-signing]})

(defn w5-trust-provenance-diagnostic-catalog []
  {:artifact :gravity/w5-trust-provenance-diagnostic-catalog
   :schema-version 1
   :diagnostics w5-trust-diagnostic-ids
   :remediation
   {"W5-TRUST-SCHEMA" :provide-exact-versioned-request
    "W5-TRUST-TARGET" :use-exact-linux-x86-64-llvm-elf-sysv-scope
    "W5-TRUST-UPSTREAM" :bind-each-upstream-artifact-by-content-id
    "W5-TRUST-LINEAGE" :repair-acyclic-reachable-compiler-lineage
    "W5-TRUST-DEPENDENCY" :bind-locked-complete-dependency-graph
    "W5-TRUST-LOCK" :record-complete-offline-lock-content
    "W5-TRUST-ENVIRONMENT" :declare-hermetic-build-environment
    "W5-TRUST-TOOLCHAIN" :bind-independent-toolchain-files-and-target
    "W5-TRUST-RECIPE" :bind-recipe-to-source-lock-environment-toolchain
    "W5-TRUST-DIVERSITY" :provide-independent-diverse-rebuilds
    "W5-TRUST-ANCHOR" :verify-distinct-trust-anchors-and-roots
    "W5-TRUST-ATTESTATION" :bind-signed-attestation-to-exact-subject
    "W5-TRUST-SBOM" :include-dependencies-capabilities-generated-and-blobs
    "W5-TRUST-SIGNATURE" :sign-canonical-manifest-provenance-and-sbom
    "W5-TRUST-REVOCATION" :record-current-release-blocking-revocations
    "W5-TRUST-UNSAFE-AUDIT" :attach-reviewed-unsafe-island-audit
    "W5-TRUST-TCB" :derive-and-list-every-residual-trusted-component
    "W5-TRUST-EQUIVALENCE" :bind-independent-stage-equivalence-report
    "W5-TRUST-REPLAY" :bind-native-linux-replay-not-container-evidence
    "W5-TRUST-AUTHORITY" :keep-seed-boundary-and-nonauthority-explicit
    "W5-TRUST-REVIEW" :obtain-independent-sol-review
    "W5-TRUST-SUBSTITUTION" :recompute-verification-result
    :non-authority {:authority :non-authority
                    :clojure-seed-boundary? true
                    :self-hosted? false
                    :release? false
                    :public-authority? false}}})

(defn w5-trust-exact-keys? [value expected]
  (if (map? value) (= (set (keys value)) expected) false))

(defn w5-trust-nonempty-string? [value]
  (if (string? value) (> (count value) 0) false))

(defn w5-trust-lower-hex? [value]
  (if (string? value)
    (if (> (count value) 0)
      (if (= value "0") true
        (if (= value "1") true
          (if (= value "2") true
            (if (= value "3") true
              (if (= value "4") true
                (if (= value "5") true
                  (if (= value "6") true
                    (if (= value "7") true
                      (if (= value "8") true
                        (if (= value "9") true
                          (if (= value "a") true
                            (if (= value "b") true
                              (if (= value "c") true
                                (if (= value "d") true
                                  (if (= value "e") true
                                    (= value "f")))))))))))))))
      false)
    false)))

(defn w5-trust-sha-prefix? [value index]
  (if (= index 7)
    true
    (if (= (get value index) (get "sha256:" index))
      (w5-trust-sha-prefix? value (+ index 1))
      false)))

(defn w5-trust-sha-tail? [value index]
  (if (= index 71)
    true
    (if (w5-trust-lower-hex? (str (get value index)))
      (w5-trust-sha-tail? value (+ index 1))
      false)))

(defn w5-trust-sha256-id? [value]
  (if (string? value)
    (if (= 71 (count value))
      (if (w5-trust-sha-prefix? value 0)
        (w5-trust-sha-tail? value 7)
        false)
      false)
    false))

(defn w5-trust-git-tail? [value index]
  (if (= index 40)
    true
    (if (w5-trust-lower-hex? (str (get value index)))
      (w5-trust-git-tail? value (+ index 1))
      false)))

(defn w5-trust-git-id? [value]
  (if (string? value)
    (if (= 40 (count value)) (w5-trust-git-tail? value 0) false)
    false))

(defn w5-trust-keyword-vector? [values]
  (if (vector? values)
    (loop [remaining values]
      (if (= (count remaining) 0)
        true
        (if (keyword? (first remaining))
          (recur (rest remaining))
          false)))
    false))

(defn w5-trust-sha-vector? [values]
  (if (vector? values)
    (loop [remaining values]
      (if (= (count remaining) 0)
        true
        (if (w5-trust-sha256-id? (first remaining))
          (recur (rest remaining))
          false)))
    false))

(defn w5-trust-unique? [values]
  (if (vector? values)
    (loop [remaining values seen #{}]
      (if (= (count remaining) 0)
        true
        (if (contains? seen (first remaining))
          false
          (recur (rest remaining) (conj seen (first remaining))))))
    false))

(defn w5-trust-find [records field value]
  (if (= (count records) 0)
    nil
    (if (= value (get (first records) field))
      (first records)
      (w5-trust-find (rest records) field value))))

(defn w5-trust-all-records? [records field]
  (if (vector? records)
    (if (> (count records) 0)
      (if (w5-trust-unique? (loop [remaining records result []]
                              (if (= (count remaining) 0)
                                result
                                (recur (rest remaining)
                                       (conj result (get (first remaining) field))))))
        true false)
      false)
    false))

(defn w5-trust-source-position? [position]
  (if (w5-trust-exact-keys? position #{:byte :line :column})
    (if (integer? (get position :byte))
      (if (integer? (get position :line))
        (if (integer? (get position :column))
          (if (>= (get position :byte) 0)
            (if (>= (get position :line) 0)
              (>= (get position :column) 0)
              false)
            false)
          false)
        false)
      false)
    false))

(defn w5-trust-span? [span]
  (if (w5-trust-exact-keys? span #{:source-id :actual-source-path :start :end})
    (if (keyword? (get span :source-id))
      (if (w5-trust-nonempty-string? (get span :actual-source-path))
        (if (w5-trust-source-position? (get span :start))
          (if (w5-trust-source-position? (get span :end))
            (if (<= (get (get span :start) :byte)
                    (get (get span :end) :byte))
              (if (<= (get (get span :start) :line)
                      (get (get span :end) :line))
                (if (= (get (get span :start) :line)
                       (get (get span :end) :line))
                  (<= (get (get span :start) :column)
                      (get (get span :end) :column))
                  true)
                false)
              false)
            false)
          false)
        false)
      false)
    false))

(defn w5-trust-target-valid? [target]
  (= target w5-trust-target-scope))

(defn w5-trust-upstream-record-valid? [record]
  (if (w5-trust-exact-keys?
       record #{:artifact-id :content-hash :independent-verifier-id
                :independent-verification-id :status :producer-commit
                :producer-tree :actual-artifact-path})
    (if (w5-trust-sha256-id? (get record :artifact-id))
      (if (w5-trust-sha256-id? (get record :content-hash))
        (if (w5-trust-sha256-id? (get record :independent-verifier-id))
          (if (w5-trust-sha256-id?
               (get record :independent-verification-id))
            (if (w5-trust-git-id? (get record :producer-commit))
              (if (w5-trust-git-id? (get record :producer-tree))
                (if (w5-trust-nonempty-string?
                     (get record :actual-artifact-path))
                  (or (= :pending (get record :status))
                      (= :passed (get record :status)))
                  false)
                false)
              false)
            false)
          false)
        false)
      false)
    false))

(defn w5-trust-upstream-valid? [upstream]
  (if (w5-trust-exact-keys? upstream #{:w1 :w2 :w3 :w4})
    (if (w5-trust-upstream-record-valid? (get upstream :w1))
      (if (w5-trust-upstream-record-valid? (get upstream :w2))
        (if (w5-trust-upstream-record-valid? (get upstream :w3))
          (if (w5-trust-upstream-record-valid? (get upstream :w4))
            (if (w5-trust-unique?
                 [(get (get upstream :w1) :content-hash)
                  (get (get upstream :w2) :content-hash)
                  (get (get upstream :w3) :content-hash)
                  (get (get upstream :w4) :content-hash)])
              (w5-trust-unique?
               [(get (get upstream :w1) :artifact-id)
                (get (get upstream :w2) :artifact-id)
                (get (get upstream :w3) :artifact-id)
                (get (get upstream :w4) :artifact-id)])
              false)
            false)
          false)
        false)
      false)
    false))

(defn w5-trust-source-graph-valid? [record]
  (if (w5-trust-exact-keys?
       record #{:source-graph-id :root-content-hash :component-ids
                :component-content-hashes :generator-input-ids :canonical?
                :verification-status :actual-source-root})
    (if (w5-trust-sha256-id? (get record :source-graph-id))
      (if (w5-trust-sha256-id? (get record :root-content-hash))
        (if (w5-trust-sha-vector? (get record :component-ids))
          (if (> (count (get record :component-ids)) 0)
            (if (w5-trust-sha-vector? (get record :component-content-hashes))
              (if (= (count (get record :component-ids))
                     (count (get record :component-content-hashes)))
                (if (w5-trust-unique? (get record :component-ids))
                  (if (w5-trust-sha-vector?
                       (get record :generator-input-ids))
                    (if (= true (get record :canonical?))
                      (if (= :descriptor-only
                             (get record :verification-status))
                        (w5-trust-nonempty-string?
                         (get record :actual-source-root))
                        false)
                      false)
                    false)
                  false)
                false)
              false)
            false)
          false)
        false)
      false)
    false))

(defn w5-trust-source-graphs-valid? [records]
  (if (vector? records)
    (if (= 4 (count records))
      (if (w5-trust-unique?
           (loop [remaining records result []]
             (if (= (count remaining) 0)
               result
               (recur (rest remaining)
                      (conj result (get (first remaining) :source-graph-id))))))
        (loop [remaining records]
          (if (= (count remaining) 0)
            true
            (if (w5-trust-source-graph-valid? (first remaining))
              (recur (rest remaining)) false)))
        false)
      false)
    false))

(defn w5-trust-dependency-valid? [record]
  (if (w5-trust-exact-keys?
       record #{:dependency-id :version :content-hash :provenance-id
                :license-id :advisory-status :revocation-status})
    (if (w5-trust-sha256-id? (get record :dependency-id))
      (if (w5-trust-nonempty-string? (get record :version))
        (if (w5-trust-sha256-id? (get record :content-hash))
          (if (w5-trust-sha256-id? (get record :provenance-id))
            (if (w5-trust-sha256-id? (get record :license-id))
              (if (= :clear (get record :advisory-status))
                (= :current (get record :revocation-status)) false)
              false)
            false)
          false)
        false)
      false)
    false))

(defn w5-trust-dependency-graphs-valid? [request]
  (let [graphs (get request :dependency-graphs)
        deps (get request :dependencies)]
    (if (and (vector? graphs) (= 1 (count graphs)))
      (if (and (vector? deps) (= 1 (count deps)))
        (let [graph (first graphs) dep (first deps)]
          (if (w5-trust-exact-keys?
               graph #{:dependency-graph-id :dependency-ids
                       :dependency-content-hashes :dependency-provenance-ids
                       :graph-content-hash :topological? :complete?
                       :verification-status :actual-graph-path})
            (if (w5-trust-sha256-id? (get graph :dependency-graph-id))
            (if (w5-trust-sha-vector? (get graph :dependency-ids))
              (if (= 1 (count (get graph :dependency-ids)))
                (if (= (get graph :dependency-ids)
                       [(get dep :dependency-id)])
                    (if (w5-trust-sha-vector?
                         (get graph :dependency-content-hashes))
                      (if (w5-trust-sha-vector?
                           (get graph :dependency-provenance-ids))
                    (if (= (get graph :dependency-content-hashes)
                       [(get dep :content-hash)])
                      (if (= (get graph :dependency-provenance-ids)
                             [(get dep :provenance-id)])
                        (if (w5-trust-sha256-id?
                             (get graph :graph-content-hash))
                          (if (= true (get graph :topological?))
                            (if (= true (get graph :complete?))
                              (if (= :descriptor-only
                                     (get graph :verification-status))
                                (if (w5-trust-nonempty-string?
                                     (get graph :actual-graph-path))
                                  (w5-trust-dependency-valid? dep)
                                  false)
                                false)
                              false)
                            false)
                          false)
                        false)
                      false)
                    false)
                      false)
                    false)
                  false)
                false)
              false)
            false))
        false)
      false)))

(defn w5-trust-lock-valid? [record request]
  (if (w5-trust-exact-keys?
       record #{:lock-id :dependency-graph-id :dependency-ids
                :dependency-content-hashes :complete? :offline?
                :content-hash :verification-status :actual-lock-path})
    (if (w5-trust-sha256-id? (get record :lock-id))
      (if (= (get record :dependency-graph-id)
             (get (first (get request :dependency-graphs))
                  :dependency-graph-id))
        (if (w5-trust-sha-vector? (get record :dependency-ids))
          (if (= (get record :dependency-ids)
               (get (first (get request :dependency-graphs))
                    :dependency-ids))
            (if (w5-trust-sha-vector?
                 (get record :dependency-content-hashes))
          (if (= (get record :dependency-content-hashes)
                 (get (first (get request :dependency-graphs))
                      :dependency-content-hashes))
            (if (= true (get record :complete?))
              (if (= true (get record :offline?))
                (if (w5-trust-sha256-id? (get record :content-hash))
                  (if (= :descriptor-only
                         (get record :verification-status))
                    (w5-trust-nonempty-string? (get record :actual-lock-path))
                    false)
                  false)
                false)
              false)
            false)
          false)
            false)
          false)
        false)
      false)
    false))

(defn w5-trust-locks-valid? [request]
  (let [locks (get request :locks)]
    (if (and (vector? locks) (= 1 (count locks)))
      (w5-trust-lock-valid? (first locks) request)
      false)))

(defn w5-trust-environment-valid? [record]
  (if (w5-trust-exact-keys?
       record #{:environment-id :manifest-id :locale :timezone
                :filesystem-order :timestamp-policy :random-seed
                :network-policy :allowed-environment :content-hash
                :verification-status :actual-build-root})
    (if (w5-trust-sha256-id? (get record :environment-id))
      (if (w5-trust-sha256-id? (get record :manifest-id))
        (if (= "C" (get record :locale))
          (if (= "UTC" (get record :timezone))
            (if (= :sorted (get record :filesystem-order))
              (if (= :fixed (get record :timestamp-policy))
                (if (integer? (get record :random-seed))
                  (if (>= (get record :random-seed) 0)
                    (if (= :disabled (get record :network-policy))
                    (if (= [] (get record :allowed-environment))
                      (if (w5-trust-sha256-id? (get record :content-hash))
                        (if (= :descriptor-only
                               (get record :verification-status))
                          (w5-trust-nonempty-string?
                           (get record :actual-build-root))
                          false)
                        false)
                      false)
                    false)
                    false)
                  false)
                false)
              false)
            false)
          false)
        false)
      false)
    false))

(defn w5-trust-environments-valid? [records]
  (if (and (vector? records) (= 2 (count records)))
    (if (w5-trust-unique?
         [(get (first records) :environment-id)
          (get (second records) :environment-id)])
      (if (w5-trust-environment-valid? (first records))
        (if (w5-trust-environment-valid? (second records)) true false)
        false)
      false)
    false))

(defn w5-trust-toolchain-valid? [record]
  (if (w5-trust-exact-keys?
       record #{:toolchain-id :family :version :target :files-id
                :content-hash :identity-status :actual-toolchain-path})
    (if (w5-trust-sha256-id? (get record :toolchain-id))
      (if (keyword? (get record :family))
        (if (w5-trust-nonempty-string? (get record :version))
          (if (= :llvm-x86_64-linux (get record :target))

(defn w5-trust-diverse-rebuild-cross-bindings-valid?
  [record request recipe-index expected-role]
  (let [recipe (get (get request :build-recipes) recipe-index)
        source (w5-trust-find (get request :source-graphs)
                              :source-graph-id
                              (get record :source-graph-id))
        lock (w5-trust-find (get request :locks)
                            :lock-id
                            (get record :lock-id))
        graph (w5-trust-find (get request :dependency-graphs)
                             :dependency-graph-id
                             (get record :dependency-graph-id))
        tool (w5-trust-find (get request :toolchains)
                            :toolchain-id
                            (get record :toolchain-id))
        env (w5-trust-find (get request :environments)
                           :environment-id
                           (get record :environment-id))
        anchor (w5-trust-find (get request :trust-anchors)
                              :anchor-id
                              (get record :trust-anchor-id))
        release (get (get request :lineage) 3)]
    (if (and recipe source lock graph tool env anchor release)
      (if (= expected-role (get record :builder-role))
        (if (= (get recipe :build-recipe-id)
               (get record :build-recipe-id))
          (if (= (get recipe :source-graph-id)
                 (get record :source-graph-id))
            (if (= (get recipe :compiler-executable-id)
                   (get record :compiler-executable-id))
              (if (= (get recipe :lock-id) (get record :lock-id))
                (if (= (get recipe :dependency-graph-id)
                       (get record :dependency-graph-id))
                  (if (= (get recipe :toolchain-id)
                         (get record :toolchain-id))
                    (if (= (get recipe :environment-id)
                           (get record :environment-id))
                      (if (= (get release :artifact-id)
                             (get record :artifact-id))
                        (if (= (get release :content-hash)
                               (get record :content-hash))
                          (if (= (get release :source-graph-id)
                                 (get record :source-graph-id))
                            (if (= (get release :compiler-executable-id)
                                   (get record :compiler-executable-id))
                              (if (= (get source :source-graph-id)
                                     (get record :source-graph-id))
                                (if (= (get lock :lock-id)
                                       (get record :lock-id))
                                  (if (= (get graph :dependency-graph-id)
                                         (get record :dependency-graph-id))
                                    (if (= (get tool :toolchain-id)
                                           (get record :toolchain-id))
                                      (if (= (get env :environment-id)
                                             (get record :environment-id))
                                        (= (get anchor :anchor-id)
                                           (get record :trust-anchor-id))

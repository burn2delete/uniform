(defn w5-trust-lineage-order-valid? [request]
  (let [nodes (get request :lineage)
        sources (get request :source-graphs)
        expected [:stage1 :stage2 :stage3 :release]]
    (if (and (vector? nodes)
             (vector? sources)
             (= 4 (count nodes))
             (= 4 (count sources)))
      (loop [index 0]
        (if (= index 4)
          true
          (if (= (get expected index)
                 (get (get nodes index) :stage-id))
            (if (= (get (get sources index) :source-graph-id)
                   (get (get nodes index) :source-graph-id))
              (recur (+ index 1))
              false)
            false)))
      false)))

(defn w5-trust-lineage-valid? [request]
  (let [nodes (get request :lineage)
        root-id (get request :root-artifact-id)
        seed-id (get request :seed-compiler-id)]
    (if (and (vector? nodes) (= 4 (count nodes)))
      (if (w5-trust-sha256-id? root-id)
        (if (= root-id (get (get nodes (- (count nodes) 1)) :artifact-id))
          (if (w5-trust-sha256-id? seed-id)
            (if (w5-trust-unique?
                 (loop [remaining nodes result []]
                   (if (= (count remaining) 0)
                     result
                     (recur (rest remaining)
                            (conj result (get (first remaining) :artifact-id))))))
              (if (w5-trust-lineage-order-valid? request)
                (loop [remaining nodes index 0 previous nil]
                  (if (= (count remaining) 0)
                    true
                    (let [node (first remaining)]
                      (if (w5-trust-stage-valid? node)
                        (if (if (= index 0)
                              (= seed-id
                                 (get node :compiled-by-executable-id))
                              (= previous
                                 (get node :compiled-by-executable-id)))
                          (if (if (= index 0)
                                (= [] (get node :rebuild-parent-ids))
                                (= [(get (get nodes (- index 1)) :artifact-id)]
                                   (get node :rebuild-parent-ids)))
                            (recur (rest remaining) (+ index 1)
                                   (get node :compiler-executable-id))
                            false)
                          false)
                        false))))
                false)
              false)
            false)
          false)
        false)
      false)))


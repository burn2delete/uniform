(defn w5-domain-schema-ai-effects-valid? [effects capabilities]
  (if (= w5-domain-schema-ai-effects effects)
    (if (set? capabilities)
      (= w5-domain-schema-ai-scoped-capabilities capabilities)
      false)
    false))

(defn w5-domain-schema-ai-claims-valid? [claims]
  (if (w5-domain-schema-ai-exact-keys?
       claims #{:producer-boolean? :narrative? :source-ownership-only?
                :check-only? :replay-only? :global-advancement?
                :authority-claim?})
    (if (= false (get claims :producer-boolean?))
      (if (= false (get claims :narrative?))
        (if (= false (get claims :source-ownership-only?))
          (if (= false (get claims :check-only?))
            (if (= false (get claims :replay-only?))
              (if (= false (get claims :global-advancement?))
                (= false (get claims :authority-claim?))
                false)
              false)
            false)
          false)
        false)
      false)
    false))

(defn w5-domain-schema-ai-authority-valid? [authority]
  (if (w5-domain-schema-ai-exact-keys?
       authority #{:authority :seed :self-hosted? :public? :release?
                   :closure-status :execution-status :executable?
                   :full-language-credit?})
    (if (= :non-authority (get authority :authority))
      (if (= true (get authority :seed))
        (if (= false (get authority :self-hosted?))
          (if (= false (get authority :public?))
            (if (= false (get authority :release?))
              (if (= :blocked (get authority :closure-status))
                (if (= :incomplete (get authority :execution-status))
                  (if (= false (get authority :executable?))
                    (= false (get authority :full-language-credit?))
                    false)
                  false)
                false)
              false)
            false)
          false)
        false)
      false)
    false))

(defn w5-domain-schema-ai-provenance-valid? [provenance]
  (if (w5-domain-schema-ai-exact-keys?
       provenance #{:actual-source-path :actual-manifest-path :source-id
                    :compiler-id :compiler-version :origin-chain
                    :source-extension :source-kind})
    (if (w5-domain-schema-ai-nonempty? (get provenance :actual-source-path))
      (if (w5-domain-schema-ai-nonempty? (get provenance :actual-manifest-path))
        (if (keyword? (get provenance :source-id))
          (if (w5-domain-schema-ai-nonempty? (get provenance :compiler-id))
            (if (w5-domain-schema-ai-nonempty? (get provenance :compiler-version))
              (if (= ".gravity" (get provenance :source-extension))
                (if (= :gravity (get provenance :source-kind))
                  (if (w5-domain-schema-ai-path-ends-with?
                       (get provenance :actual-source-path) ".gravity")
                    (w5-domain-schema-ai-origin?
                     (get provenance :origin-chain))
                    false)
                  false)
                (if (= ".qst" (get provenance :source-extension))
                  (if (= :qst (get provenance :source-kind))
                    (if (w5-domain-schema-ai-path-ends-with?
                         (get provenance :actual-source-path) ".qst")
                      (w5-domain-schema-ai-origin?
                       (get provenance :origin-chain))
                      false)
                    false)
                  false))
              false)
            false)
          false)
        false)
      false)
    false))

(defn w5-domain-schema-ai-vector-unique? [values]
  (if (vector? values)
    (= (count values) (count (set values)))
    false))

(defn w5-domain-schema-ai-nested-authority-crosslinks-valid?
  [migration tool agent memory policy]
  (if (and
       (= w5-domain-schema-ai-migration-effects (get migration :effects))
       (= w5-domain-schema-ai-migration-capabilities
          (get migration :capabilities))
       (= w5-domain-schema-ai-tool-effects (get tool :effects))
       (= w5-domain-schema-ai-tool-capabilities
          (get tool :capabilities))
       (= w5-domain-schema-ai-agent-effects (get agent :effects))
       (= w5-domain-schema-ai-agent-capabilities
          (get agent :capabilities))
       (= w5-domain-schema-ai-memory-effects (get memory :effects))
       (= w5-domain-schema-ai-memory-capabilities
          (get memory :capabilities))
       (= w5-domain-schema-ai-policy-allow (get policy :allow))
       (= w5-domain-schema-ai-policy-deny (get policy :deny)))
    true false))

(defn w5-domain-schema-ai-crosslinks-valid? [request]
  (let [provider (get request :provider)
        model (get request :model)
        prompt (get request :prompt)
        tool (get request :tool)
        agent (get request :agent)
        workflow (get request :workflow)
        memory (get request :memory)
        migration (get request :migration)
        policy (get request :policy)
        evaluation (get request :evaluation)
        capabilities (get request :capabilities)]
    (if (= (get provider :model-id) (get model :model-id))
      (if (= (get provider :provider-id) (get model :provider-id))
        (if (= (get agent :model) (get model :model-id))
          (if (= (get agent :prompts)
                 (conj [] (get prompt :prompt-id)))
          (if (= (get agent :tools)
                 (conj [] (get tool :tool-id)))
            (if (= (get prompt :visible-tools)
                   (conj [] (get tool :tool-id)))
              (if (= (get (get agent :memory) :memory-id)
                     (get memory :memory-id))
                (if (= (get agent :policy) (get policy :policy-id))
                  (if (= (get agent :evals)
                         (conj [] (get evaluation :eval-id)))
                    (if (= (get workflow :model-id) (get model :model-id))
                      (if (= (get workflow :prompt-id) (get prompt :prompt-id))
                        (if (= (get workflow :tool-id) (get tool :tool-id))
                          (if (= (get workflow :agent-id) (get agent :agent-id))
                            (if (= (get workflow :memory-id)
                                   (get memory :memory-id))
                            (if (and (w5-domain-schema-ai-vector-unique?
                                        (get agent :prompts))
                                       (w5-domain-schema-ai-vector-unique?
                                        (get agent :tools))
                                       (w5-domain-schema-ai-vector-unique?
                                        (get agent :evals)))
                                (if (w5-domain-schema-ai-nested-authority-crosslinks-valid?
                                     migration tool agent memory policy)
                                  (if (= #{:ticket/read} (get tool :capabilities))
                                  (if (= #{:db/migrate} (get migration :capabilities))
                                    (if (= #{:provider/model :tool/read :memory/read}
                                           (get agent :capabilities))
                                      (if (= #{:memory/read :memory/write}
                                             (get memory :capabilities))
                                        (if (w5-domain-schema-ai-subset?
                                             (get tool :capabilities) capabilities)
                                          (if (w5-domain-schema-ai-subset?
                                               (get migration :capabilities) capabilities)
                                            (if (w5-domain-schema-ai-subset?
                                                 (get agent :capabilities) capabilities)
                                              (if (w5-domain-schema-ai-subset?
                                                   (get memory :capabilities) capabilities)
                                                true false)
                                              false)
                                            false)
                                          false)
                                        false)
                                      false)
                                    false)
                                  false)
                                false)
                              false)
                            false)
                          false)
                        false)
                      false)
                    false)
                  false)
                false)
              false)
            false)
          false)
          false)
        false)
      false))))

(defn w5-domain-schema-ai-diagnostics-valid? [diagnostics]
  (if (vector? diagnostics)
    (= 0 (count diagnostics))
    false))

(defn w5-domain-schema-ai-request-valid? [request]
  (if (w5-domain-schema-ai-exact-keys?
       request #{:artifact :schema-version :profile :stage2-target
                 :candidate-target :unsupported-targets
                 :unsupported-target-policies :domain-manifest
                 :schema-manifest :serializer :migration :provider :model
                 :prompt :tool :agent :workflow :memory :policy :evaluation
                 :human-review :defense :effects :capabilities :diagnostics
                 :provenance :claims :authority :source-span})
    (if (and (= :gravity/w5-domain-schema-ai-request (get request :artifact))
             (= 1 (get request :schema-version))
             (= :meta (get request :profile))
             (w5-domain-schema-ai-targets-valid? request)
             (w5-domain-schema-ai-span? (get request :source-span))
             (w5-domain-schema-ai-domain-valid? (get request :domain-manifest))
             (w5-domain-schema-ai-schema-valid? (get request :schema-manifest))
             (w5-domain-schema-ai-serializer-valid?
              (get request :serializer) (get request :schema-manifest))
             (w5-domain-schema-ai-migration-valid?
              (get request :migration) (get request :schema-manifest))
             (w5-domain-schema-ai-provider-valid? (get request :provider))
             (w5-domain-schema-ai-model-budget-valid?
              (get (get request :model) :budget))
             (w5-domain-schema-ai-model-valid?
              (get request :model) (get request :provider)
              (get request :schema-manifest))
             (w5-domain-schema-ai-provider-identity-valid?
              (get request :provider) (get request :model)
              (get request :schema-manifest))
             (w5-domain-schema-ai-prompt-valid?
              (get request :prompt) (get request :schema-manifest))
             (w5-domain-schema-ai-tool-valid?
              (get request :tool) (get request :schema-manifest))
             (w5-domain-schema-ai-agent-budget-valid?
              (get (get request :agent) :budget))
             (w5-domain-schema-ai-agent-valid?
              (get request :agent) (get request :schema-manifest))
             (w5-domain-schema-ai-budget-relations-valid? request)
             (w5-domain-schema-ai-workflow-valid?
              (get request :workflow) (get request :schema-manifest))
             (w5-domain-schema-ai-memory-valid?
              (get request :memory) (get request :schema-manifest))
             (w5-domain-schema-ai-policy-valid? (get request :policy))
             (w5-domain-schema-ai-evaluation-valid?
              (get request :evaluation) (get request :schema-manifest))
             (w5-domain-schema-ai-human-review-valid?
              (get request :human-review))
             (w5-domain-schema-ai-defense-valid? (get request :defense))
             (w5-domain-schema-ai-effects-valid?
              (get request :effects) (get request :capabilities))
             (w5-domain-schema-ai-diagnostics-valid?
              (get request :diagnostics))
             (w5-domain-schema-ai-provenance-valid?
              (get request :provenance))
             (w5-domain-schema-ai-claims-valid? (get request :claims))
             (w5-domain-schema-ai-authority-valid? (get request :authority))
             (w5-domain-schema-ai-crosslinks-valid? request))
      true false)
    false))

(defn w5-domain-schema-ai-policy []
  {:artifact :gravity/w5-domain-schema-ai-policy :schema-version 1
   :profile :meta :stage2-target :jvm
   :candidate-target w5-domain-schema-ai-target
   :unsupported-targets w5-domain-schema-ai-unsupported-targets
   :unsupported-target-policies w5-domain-schema-ai-unsupported-policies
   :effects w5-domain-schema-ai-effects
   :authority :non-authority :clojure-seed-boundary? true
   :self-hosted? false :public-authority? false :release? false
   :full-language-credit? false
   :denied-authority #{:filesystem :network :process :environment :clock
                       :random :secret :provider-credentials :database-write
                       :tool-execution :model-execution}
   :residual-boundaries #{:provider-execution :database-execution
                          :workflow-replay :independent-policy-review}})

(defn w5-domain-schema-ai-source-span []
  {:source-id :gravity.self-hosting/w5-domain-schema-ai
   :start-byte 0 :end-byte 1 :line 1 :column 1})

(defn w5-domain-schema-ai-domain-manifest []
  {:domain :ai-agentic :profiles #{:ai :distributed :hosted}
   :backends #{:workflow-graph :javascript-typescript :jvm}
   :artifacts #{:agent-manifest :tool-policy :prompt-hashes :eval-report
                :replay-log}
   :examples #{:support-agent :data-extractor :code-reviewer
               :human-review-workflow}
   :rejects #{:tool-without-human-review :schema-less-output
              :prompt-policy-escalation :unvalidated-generated-code}
   :source-span (w5-domain-schema-ai-source-span)
   :provenance [{:kind :source :source-id :DOM18}]})

(defn w5-domain-schema-ai-schema-manifest []
  {:schema-id :TicketClassification :version 2 :compatibility :additive
   :fields {:priority #{:low :medium :high} :category :String
            :confidence :F64}
   :derives #{:validator :json-schema :graphql :openapi :ai-output}
   :boundaries #{:api-input :database-row :model-output :workflow-state}
   :schema-hash "sha256:1111111111111111111111111111111111111111111111111111111111111111"
   :source-span (w5-domain-schema-ai-source-span)
   :provenance [{:kind :source :source-id :S1}]})

(defn w5-domain-schema-ai-diagnostic [request rule stage field]
  {:diagnostic-id rule :rule rule :severity :error :stage stage
   :message-key :gravity.w5-domain-schema-ai/contract
   :primary {:span (if (w5-domain-schema-ai-span? (get request :source-span))
                     (get request :source-span)
                     (w5-domain-schema-ai-source-span))
             :syntax-id "sha256:1111111111111111111111111111111111111111111111111111111111111111"
             :artifact :gravity/w5-domain-schema-ai-request}
   :related [{:role :schema :span (w5-domain-schema-ai-source-span)
              :artifact :gravity/schema}
             {:role :policy :span (w5-domain-schema-ai-source-span)
              :artifact :gravity/ai-policy}]
   :origin-chain [{:kind :source :source-id :gravity.self-hosting/w5-domain-schema-ai}]
   :profile :meta :target w5-domain-schema-ai-target
   :facts {:field field :fail-closed true :ambient-authority false}
   :remediation [(get w5-domain-schema-ai-remediations rule)]
   :redactions []})

(defn w5-domain-schema-ai-diagnostic-catalog []
  {:artifact :gravity/w5-domain-schema-ai-diagnostic-catalog
   :schema-version 1 :diagnostics w5-domain-schema-ai-diagnostic-ids
   :remediations w5-domain-schema-ai-remediations
   :stable-fields [:diagnostic-id :rule :severity :stage :primary :related
                   :origin-chain :profile :target :facts :remediation :redactions]})

(defn w5-domain-schema-ai-first-failure [request]
  (if (not (w5-domain-schema-ai-exact-keys?
            request #{:artifact :schema-version :profile :stage2-target
                      :candidate-target :unsupported-targets
                      :unsupported-target-policies :domain-manifest
                      :schema-manifest :serializer :migration :provider :model
                      :prompt :tool :agent :workflow :memory :policy :evaluation
                      :human-review :defense :effects :capabilities :diagnostics
                      :provenance :claims :authority :source-span}))
    (w5-domain-schema-ai-diagnostic request "W5-DSAI-SCHEMA" :schema :request)
    (if (not (and (= :gravity/w5-domain-schema-ai-request (get request :artifact))
                  (= 1 (get request :schema-version))
                  (= :meta (get request :profile))))
      (w5-domain-schema-ai-diagnostic request "W5-DSAI-SCHEMA" :schema :request)
      (if (not (w5-domain-schema-ai-targets-valid? request))
        (w5-domain-schema-ai-diagnostic request "W5-DSAI-TARGET" :target :target)
        (if (not (w5-domain-schema-ai-span? (get request :source-span)))
          (w5-domain-schema-ai-diagnostic request "W5-DSAI-SCHEMA"
                                          :schema :source-span)
        (if (not (w5-domain-schema-ai-domain-valid? (get request :domain-manifest)))
        (w5-domain-schema-ai-diagnostic request "DOM18-SCHEMA" :domain :domain-manifest)
        (if (not (w5-domain-schema-ai-schema-valid? (get request :schema-manifest)))
          (w5-domain-schema-ai-diagnostic request "S1-MANIFEST" :schema :schema-manifest)
          (if (not (w5-domain-schema-ai-serializer-valid?
                    (get request :serializer) (get request :schema-manifest)))
            (w5-domain-schema-ai-diagnostic request "S2-MANIFEST" :serialization :serializer)
            (if (not (w5-domain-schema-ai-migration-valid?
                      (get request :migration) (get request :schema-manifest)))
              (w5-domain-schema-ai-diagnostic request "S6-MIGRATION" :migration :migration)
              (if (not (w5-domain-schema-ai-provider-valid? (get request :provider)))
                (w5-domain-schema-ai-diagnostic request "A2001" :provider :provider)
                (if (not (w5-domain-schema-ai-model-budget-valid?
                          (get (get request :model) :budget)))
                  (w5-domain-schema-ai-diagnostic request "A2005" :budget :model-budget)
                  (if (not (w5-domain-schema-ai-model-valid?
                          (get request :model) (get request :provider)
                          (get request :schema-manifest)))
                    (w5-domain-schema-ai-diagnostic request "DOM18-MODEL" :model :model)
                    (if (not (w5-domain-schema-ai-provider-identity-valid?
                              (get request :provider) (get request :model)
                              (get request :schema-manifest)))
                      (w5-domain-schema-ai-diagnostic request "A2007" :provider :identity)
                      (if (not (w5-domain-schema-ai-prompt-valid?
                          (get request :prompt) (get request :schema-manifest)))
                      (w5-domain-schema-ai-diagnostic request "A3003" :prompt :prompt)
                      (if (not (w5-domain-schema-ai-tool-valid?
                            (get request :tool) (get request :schema-manifest)))
                        (w5-domain-schema-ai-diagnostic request "A4005" :tool :tool)
                        (if (not (w5-domain-schema-ai-agent-budget-valid?
                                  (get (get request :agent) :budget)))
                          (w5-domain-schema-ai-diagnostic request "A5006" :budget :agent-budget)
                          (if (not (w5-domain-schema-ai-agent-valid?
                              (get request :agent) (get request :schema-manifest)))
                            (w5-domain-schema-ai-diagnostic request "A5002" :agent :agent)
                            (if (not (w5-domain-schema-ai-budget-relations-valid? request))
                              (w5-domain-schema-ai-diagnostic request "A5006" :budget :budget-relation)
                              (if (not (w5-domain-schema-ai-workflow-valid?
                                (get request :workflow)
                                (get request :schema-manifest)))
                                (w5-domain-schema-ai-diagnostic request "A6001" :workflow :workflow)
                                (if (not (w5-domain-schema-ai-memory-valid?
                                  (get request :memory)
                                  (get request :schema-manifest)))
                                  (w5-domain-schema-ai-diagnostic request "A7001" :memory :memory)
                                  (if (not (w5-domain-schema-ai-policy-valid? (get request :policy)))
                                    (w5-domain-schema-ai-diagnostic request "A8001" :policy :policy)
                                    (if (not (w5-domain-schema-ai-evaluation-valid?
                                      (get request :evaluation)
                                      (get request :schema-manifest)))
                                      (w5-domain-schema-ai-diagnostic request "A9001" :evaluation :evaluation)
                                      (if (not (w5-domain-schema-ai-human-review-valid?
                                        (get request :human-review)))
                                        (w5-domain-schema-ai-diagnostic request "A10001" :human-review :human-review)
                                        (if (not (w5-domain-schema-ai-defense-valid?
                                          (get request :defense)))
                                          (w5-domain-schema-ai-diagnostic request "A11001" :defense :defense)
                                          (if (not (w5-domain-schema-ai-effects-valid?
                                            (get request :effects)
                                            (get request :capabilities)))
                                            (w5-domain-schema-ai-diagnostic request "W5-DSAI-AUTHORITY" :authority :effects)
                                            (if (not (w5-domain-schema-ai-diagnostics-valid?
                                              (get request :diagnostics)))
                                              (w5-domain-schema-ai-diagnostic request "W5-DSAI-SCHEMA" :schema :diagnostics)
                                              (if (not (w5-domain-schema-ai-provenance-valid?
                                              (get request :provenance)))
                                                (w5-domain-schema-ai-diagnostic request "DOM17-DIAGNOSTIC" :provenance :provenance)
                                                (if (not (w5-domain-schema-ai-authority-valid?
                                                  (get request :authority)))
                                                  (w5-domain-schema-ai-diagnostic request "W5-DSAI-AUTHORITY" :authority :authority)
                                                  (if (not (w5-domain-schema-ai-crosslinks-valid? request))
                                                    (w5-domain-schema-ai-diagnostic request "W5-DSAI-AUTHORITY" :authority :crosslinks)
                                                    (if (not (w5-domain-schema-ai-claims-valid?
                                                (get request :claims)))
                                                      (w5-domain-schema-ai-diagnostic request "W5-DSAI-AUTHORITY" :authority :claims)
                                                      (if (w5-domain-schema-ai-request-valid? request)
                                                        nil
                                                        (w5-domain-schema-ai-diagnostic request "W5-DSAI-SCHEMA" :schema :request))))))))))))))))))))))))))))))))

(defn w5-domain-schema-ai-identity-input [request]
  {:artifact :gravity/w5-domain-schema-ai-identity :schema-version 1
   :profile (get request :profile) :stage2-target (get request :stage2-target)
   :candidate-target (get request :candidate-target)
   :domain (get (get request :domain-manifest) :domain)
   :schema-id (get (get request :schema-manifest) :schema-id)
   :schema-version (get (get request :schema-manifest) :version)
   :provider-id (get (get request :provider) :provider-id)
   :model-id (get (get request :provider) :model-id)
   :prompt-id (get (get request :prompt) :prompt-id)
   :tool-id (get (get request :tool) :tool-id)
   :agent-id (get (get request :agent) :agent-id)
   :workflow-id (get (get request :workflow) :workflow-id)
   :memory-id (get (get request :memory) :memory-id)
   :policy-id (get (get request :policy) :policy-id)
   :evaluation-id (get (get request :evaluation) :eval-id)
   :claims (get request :claims)
   :authority {:authority (get (get request :authority) :authority)
               :seed (get (get request :authority) :seed)
               :self-hosted? (get (get request :authority) :self-hosted?)
               :public? (get (get request :authority) :public?)
               :release? (get (get request :authority) :release?)}})

(defn w5-domain-schema-ai-provenance [request]
  {:actual-source-path (get (get request :provenance) :actual-source-path)
   :actual-manifest-path (get (get request :provenance) :actual-manifest-path)
   :source-id (get (get request :provenance) :source-id)
   :compiler-id (get (get request :provenance) :compiler-id)
   :compiler-version (get (get request :provenance) :compiler-version)
   :origin-chain (get (get request :provenance) :origin-chain)
   :source-extension (get (get request :provenance) :source-extension)
   :source-kind (get (get request :provenance) :source-kind)
   :schema-source-span (get (get request :schema-manifest) :source-span)
   :prompt-source-span (get (get request :prompt) :source-span)
   :tool-source-span (get (get request :tool) :source-span)
   :policy-source-span (get (get request :policy) :source-span)})

(defn w5-domain-schema-ai-accepted-result [request]
  {:artifact :gravity/w5-domain-schema-ai-result :schema-version 1
   :status :accepted :execution-status :incomplete :closure-status :blocked
   :diagnostics [] :identity-input (w5-domain-schema-ai-identity-input request)
   :provenance (w5-domain-schema-ai-provenance request)
   :authority :non-authority :clojure-seed-boundary? true
   :self-hosted? false :public? false :release? false
   :full-language-credit? false :provider-executed? false
   :tool-executed? false :database-written? false :workflow-replayed? false
   :ambient-authority? false
   :candidate-target (get request :candidate-target)
   :residual-boundaries #{:provider-execution :database-execution
                          :workflow-replay :independent-policy-review}})

(defn w5-domain-schema-ai-rejected-result [request diagnostic]
  {:artifact :gravity/w5-domain-schema-ai-result :schema-version 1
   :status :rejected :execution-status :blocked :closure-status :blocked
   :diagnostics [diagnostic] :identity-input nil
   :provenance (if (map? (get request :provenance))
                 (w5-domain-schema-ai-provenance request) nil)
   :authority :non-authority :clojure-seed-boundary? true
   :self-hosted? false :public? false :release? false
   :full-language-credit? false :provider-executed? false
   :tool-executed? false :database-written? false :workflow-replayed? false
   :ambient-authority? false})

(defn w5-domain-schema-ai-execute [request]
  (let [failure (w5-domain-schema-ai-first-failure request)]
    (if (and (= nil failure) (w5-domain-schema-ai-request-valid? request))
      (w5-domain-schema-ai-accepted-result request)
      (w5-domain-schema-ai-rejected-result
       request
       (if (= nil failure)
         (w5-domain-schema-ai-diagnostic request "W5-DSAI-SCHEMA" :schema :request)
         failure)))))
(defn w5-domain-schema-ai-run [request]
  (w5-domain-schema-ai-execute request))
(defn w5-domain-schema-ai-verify [request]
  (w5-domain-schema-ai-execute request))
(defn w5-domain-schema-ai-recompute [request]
  (w5-domain-schema-ai-execute request))
(defn w5-domain-schema-ai-verify-result [request result]
  (let [expected (w5-domain-schema-ai-execute request)]
    (if (= expected result)
      {:artifact :gravity/w5-domain-schema-ai-result-verification
       :schema-version 1 :status :passed :expected expected
       :candidate result :diagnostics []}
      {:artifact :gravity/w5-domain-schema-ai-result-verification
       :schema-version 1 :status :rejected :expected expected
       :candidate result
       :diagnostics [(w5-domain-schema-ai-diagnostic
                      request "A9002" :verification :result)]})))

(defn w5-domain-schema-ai-present? [value]
  (if (= nil value) false true))
(defn w5-domain-schema-ai-nonempty? [value]
  (if (string? value) (> (count value) 0) false))
(defn w5-domain-schema-ai-suffix-match? [value suffix index]
  (if (= index (count suffix))
    true
    (if (= (get value (- (count value) (+ index 1)))
           (get suffix (- (count suffix) (+ index 1))))
      (w5-domain-schema-ai-suffix-match? value suffix (+ index 1))
      false)))
(defn w5-domain-schema-ai-path-ends-with? [value suffix]
  (if (and (string? value) (string? suffix))
    (if (<= (count suffix) (count value))
      (w5-domain-schema-ai-suffix-match? value suffix 0)
      false)
    false))
(defn w5-domain-schema-ai-exact-keys? [value expected]
  (if (map? value) (= (set (keys value)) expected) false))
(defn w5-domain-schema-ai-member-from? [values value index]
  (if (= index (count values)) false
      (if (= value (get values index)) true
          (w5-domain-schema-ai-member-from? values value (+ index 1)))))
(defn w5-domain-schema-ai-member? [values value]
  (if (vector? values)
    (w5-domain-schema-ai-member-from? values value 0)
    false))
(defn w5-domain-schema-ai-subset? [required available]
  (if (= (count required) 0) true
      (if (contains? available (first required))
        (w5-domain-schema-ai-subset? (rest required) available)
        false)))
(defn w5-domain-schema-ai-sha? [value]
  (if (string? value)
    (if (= 71 (count value))
      (if (= (get value 0) \s)
        (if (= (get value 1) \h)
          (if (= (get value 2) \a)
            (if (= (get value 3) \2)
              (if (= (get value 4) \5)
                (if (= (get value 5) \6)
                  (= (get value 6) \:)
                  false)
                false)
              false)
            false)
          false)
        false)
      false)
    false))
(defn w5-domain-schema-ai-span? [span]
  (if (w5-domain-schema-ai-exact-keys?
       span #{:source-id :start-byte :end-byte :line :column})
    (if (keyword? (get span :source-id))
      (if (integer? (get span :start-byte))
        (if (integer? (get span :end-byte))
          (if (<= 0 (get span :start-byte))
            (if (<= 0 (get span :end-byte))
              (if (<= (get span :start-byte) (get span :end-byte))
                (if (integer? (get span :line))
                  (if (>= (get span :line) 1)
                    (if (integer? (get span :column))
                      (>= (get span :column) 1)
                      false)
                    false)
                  false)
                false)
              false)
            false)
          false)
        false)
      false)
    false))
(defn w5-domain-schema-ai-origin? [origin]
  (if (vector? origin) (> (count origin) 0) false))
(defn w5-domain-schema-ai-id? [value]
  (if (keyword? value) true (w5-domain-schema-ai-sha? value)))

(defn w5-domain-schema-ai-domain-valid? [manifest]
  (if (w5-domain-schema-ai-exact-keys?
       manifest #{:domain :profiles :backends :artifacts :examples :rejects
                  :source-span :provenance})
    (if (= :ai-agentic (get manifest :domain))
      (if (set? (get manifest :profiles))
        (if (contains? (get manifest :profiles) :ai)
          (if (set? (get manifest :backends))
            (if (contains? (get manifest :backends) :workflow-graph)
              (if (set? (get manifest :artifacts))
                (if (contains? (get manifest :artifacts) :agent-manifest)
                  (if (set? (get manifest :examples))
                    (if (set? (get manifest :rejects))
                      (if (w5-domain-schema-ai-span? (get manifest :source-span))
                        (w5-domain-schema-ai-origin? (get manifest :provenance))
                        false)
                      false)
                    false)
                  false)
                false)
              false)
            false)
          false)
        false)
      false)
    false))

(defn w5-domain-schema-ai-schema-valid? [schema]
  (if (w5-domain-schema-ai-exact-keys?
       schema #{:schema-id :version :compatibility :fields :derives
                :boundaries :schema-hash :source-span :provenance})
    (if (w5-domain-schema-ai-id? (get schema :schema-id))
      (if (integer? (get schema :version))
        (if (= :additive (get schema :compatibility))
          (if (map? (get schema :fields))
            (if (> (count (keys (get schema :fields))) 0)
              (if (set? (get schema :derives))
                (if (contains? (get schema :derives) :validator)
                  (if (set? (get schema :boundaries))
                    (if (contains? (get schema :boundaries) :model-output)
                      (if (w5-domain-schema-ai-sha? (get schema :schema-hash))
                        (if (w5-domain-schema-ai-span? (get schema :source-span))
                          (w5-domain-schema-ai-origin? (get schema :provenance))
                          false)
                        false)
                      false)
                    false)
                  false)
                false)
              false)
            false)
          false)
        false)
      false)
    false))

(defn w5-domain-schema-ai-serializer-valid? [serializer schema]
  (if (w5-domain-schema-ai-exact-keys?
       serializer #{:artifact :schema-id :schema-version :format
                    :unknown-fields :numeric-policy :decoded-trust
                    :canonical :roundtrip-fixtures :source-span :provenance})
    (if (= :gravity/serializer (get serializer :artifact))
      (if (= (get schema :schema-id) (get serializer :schema-id))
        (if (= (get schema :version) (get serializer :schema-version))
          (if (= :json (get serializer :format))
            (if (= :reject (get serializer :unknown-fields))
              (if (= :exact-or-diagnostic (get serializer :numeric-policy))
                (if (= :untrusted (get serializer :decoded-trust))
                  (if (= false (get serializer :canonical))
                    (if (vector? (get serializer :roundtrip-fixtures))
                      (if (> (count (get serializer :roundtrip-fixtures)) 0)
                        (if (w5-domain-schema-ai-span? (get serializer :source-span))
                          (w5-domain-schema-ai-origin? (get serializer :provenance))
                          false)
                        false)
                      false)
                    false)
                  false)
                false)
              false)
            false)
          false)
        false)
      false)
    false))

(defn w5-domain-schema-ai-migration-valid? [migration schema]
  (if (and
       (w5-domain-schema-ai-exact-keys?
        migration #{:artifact :migration-id :from-schema :to-schema
                    :policy :dialect :effects :capabilities :data-loss
                    :rollback :deployment-order :review :fixtures
                    :source-span :provenance})
       (= :gravity/database-migration (get migration :artifact))
       (w5-domain-schema-ai-sha? (get migration :migration-id))
       (= (get schema :schema-id) (get migration :from-schema))
       (= (get schema :schema-id) (get migration :to-schema))
       (= :additive (get migration :policy))
       (= :postgresql (get migration :dialect))
       (= w5-domain-schema-ai-migration-effects (get migration :effects))
       (= w5-domain-schema-ai-migration-capabilities
          (get migration :capabilities))
       (= :none (get migration :data-loss))
       (contains? #{:rollback :forward-only} (get migration :rollback))
       (keyword? (get migration :deployment-order))
       (= :not-required (get migration :review))
       (vector? (get migration :fixtures))
       (> (count (get migration :fixtures)) 0)
       (w5-domain-schema-ai-span? (get migration :source-span))
       (w5-domain-schema-ai-origin? (get migration :provenance)))
    true false))

(defn w5-domain-schema-ai-provider-valid? [provider]
  (if (w5-domain-schema-ai-exact-keys?
       provider #{:provider-id :adapter :model-id :version-policy :modes
                  :credential-source :redaction :replay :identity
                  :fallback-eval-required? :source-span :provenance})
    (if (w5-domain-schema-ai-id? (get provider :provider-id))
      (if (keyword? (get provider :adapter))
        (if (w5-domain-schema-ai-nonempty? (get provider :model-id))
          (if (= :pinned (get provider :version-policy))
            (if (set? (get provider :modes))
              (if (contains? (get provider :modes) :structured-output)
                (if (= :declared-secret-source (get provider :credential-source))
                  (if (= :redact-secrets (get provider :redaction))
                    (if (= :recorded (get provider :replay))
                      (if (w5-domain-schema-ai-exact-keys?
                           (get provider :identity)
                           #{:provider-id :model-id :version :adapter-version
                             :schema-mode})
                        (if (= true (get provider :fallback-eval-required?))
                          (if (w5-domain-schema-ai-span? (get provider :source-span))
                            (w5-domain-schema-ai-origin? (get provider :provenance))
                            false)
                          false)
                        false)
                      false)
                    false)
                  false)
                false)
              false)
            false)
          false)
        false)
      false)
    false))

(defn w5-domain-schema-ai-provider-identity-valid? [provider model schema]
  (let [identity (get provider :identity)]
    (if (and
         (w5-domain-schema-ai-exact-keys?
          identity #{:provider-id :model-id :version :adapter-version
                     :schema-mode})
         (= (get identity :provider-id) (get provider :provider-id))
         (= (get identity :model-id) (get provider :model-id))
         (= (get identity :model-id) (get model :model-id))
         (= (get provider :provider-id) (get model :provider-id))
         (= :pinned (get provider :version-policy))
         (= :pinned (get model :version))
         (= "1" (get identity :version))
         (= :declared-provider (get provider :adapter))
         (= "1" (get identity :adapter-version))
         (contains? (get provider :modes) :structured-output)
         (contains? (get model :modes) :structured-output)
         (= (get schema :schema-id) (get model :input-schema))
         (= (get schema :schema-id) (get model :output-schema))
         (= :provider-and-runtime (get identity :schema-mode)))
      true false)))

(defn w5-domain-schema-ai-model-budget-valid? [budget]
  (= w5-domain-schema-ai-model-budget budget))

(defn w5-domain-schema-ai-agent-budget-valid? [budget]
  (= w5-domain-schema-ai-agent-budget budget))

(defn w5-domain-schema-ai-budget-relations-valid? [request]
  (let [model-budget (get (get request :model) :budget)
        agent-budget (get (get request :agent) :budget)]
    (if (>= (get agent-budget :max-output-tokens)
            (* (get model-budget :max-output-tokens)
               (get agent-budget :max-model-calls)))
      (if (>= (get agent-budget :max-wall-time-ms)
              (* (get model-budget :max-wall-time-ms)
                 (get agent-budget :max-model-calls)))
        (if (>= (get agent-budget :max-retries)
                (get model-budget :max-retries))
          (if (>= (get agent-budget :max-cost-usd)
                  (* (get model-budget :max-cost-usd)
                     (get agent-budget :max-model-calls)))
            (if (>= (get agent-budget :max-human-reviews) 1)
              true false)
            false)

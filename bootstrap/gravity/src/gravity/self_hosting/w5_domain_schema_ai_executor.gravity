             w5-domain-schema-ai-evaluation-valid?
             w5-domain-schema-ai-human-review-valid?
             w5-domain-schema-ai-defense-valid?
             w5-domain-schema-ai-diagnostics-valid?
             w5-domain-schema-ai-crosslinks-valid?
             w5-domain-schema-ai-model-budget-valid?
             w5-domain-schema-ai-agent-budget-valid?
             w5-domain-schema-ai-budget-relations-valid?
             w5-domain-schema-ai-request-valid?
             w5-domain-schema-ai-path-ends-with?
             w5-domain-schema-ai-identity-input
             w5-domain-schema-ai-provenance
             w5-domain-schema-ai-diagnostic
             w5-domain-schema-ai-execute
             w5-domain-schema-ai-run
             w5-domain-schema-ai-verify
             w5-domain-schema-ai-recompute
             w5-domain-schema-ai-verify-result])
  (:effects #{})
  (:capabilities #{})
  (:safety :safe)
  (:metadata
   {:bootstrap
    {:stage :stage2
     :component :w5-domain-schema-ai-executor
     :owner :w5-wave6-slice-b
     :source-language :gravity
     :seed :clojure-stage0
     :status :executable-leaf
     :scope :stage-owned-nonauthority
     :static-only? true
     :clojure-seed-boundary? true
     :self-hosted? false
     :release? false
     :public-authority? false
     :authority :non-authority
     :candidate-target :llvm-x86_64-linux
     :candidate-platform {:os :linux :arch :x86_64 :backend :llvm
                          :artifact-format :elf :abi :sysv-amd64}
     :unsupported-platforms [:darwin :darwin-arm64 :darwin-x86_64 :windows]
     :unsupported-target-policies
     [{:target :darwin :support :unsupported :invokes-clojure? false :links-jvm? false :fallback? false}
      {:target :darwin-arm64 :support :unsupported :invokes-clojure? false :links-jvm? false :fallback? false}
      {:target :darwin-x86_64 :support :unsupported :invokes-clojure? false :links-jvm? false :fallback? false}
      {:target :windows :support :unsupported :invokes-clojure? false :links-jvm? false :fallback? false}]
     :candidate-invokes-clojure? false
     :candidate-links-jvm? false
     :candidate-fallback? false
     :residual-boundaries {:stage2-compiler-plan :clojure-bootstrap
                           :stage2-runtime :jvm
                           :provider-execution :pending
                           :database-execution :pending
                           :workflow-replay :pending
                           :independent-policy-review :pending
                           :filesystem-authority false
                           :network-authority false
                           :process-authority false}
     :governing-documents ["DOM17" "DOM18" "S1" "S2" "S6"
                           "A1" "A2" "A3" "A4" "A5" "A6"
                           "A7" "A8" "A9" "A10" "A11"
                           "D8" "D9" "P10" "SAFE10" "SAFE11"
                           "SAFE13"]
     :non-goals [:provider-execution :tool-execution :database-write
                 :model-authority :production-promotion :full-language-credit
                 :seed-retirement]}}))


    :db/migrate :human-review})
(def w5-domain-schema-ai-migration-effects #{:database/write})
(def w5-domain-schema-ai-migration-capabilities #{:db/migrate})
(def w5-domain-schema-ai-tool-effects #{:database/read})
(def w5-domain-schema-ai-tool-capabilities #{:ticket/read})
(def w5-domain-schema-ai-agent-effects
  #{:ai/model-call :ai/output-validate})
(def w5-domain-schema-ai-agent-capabilities
  #{:provider/model :tool/read :memory/read})
(def w5-domain-schema-ai-memory-effects
  #{:ai/memory-read :ai/memory-write :ai/embedding})
(def w5-domain-schema-ai-memory-capabilities #{:memory/read :memory/write})
(def w5-domain-schema-ai-policy-allow
  #{:repo/read :ai/model-call :ai/memory-read})
(def w5-domain-schema-ai-policy-deny
  #{:secrets/read :shell/exec :package/publish})
(def w5-domain-schema-ai-model-budget
  {:max-output-tokens 4096 :max-retries 2
   :max-wall-time-ms 30000 :max-cost-usd 0.25})
(def w5-domain-schema-ai-agent-budget
  {:max-model-calls 3 :max-tool-calls 8 :max-retries 2
   :max-wall-time-ms 120000 :max-output-tokens 12288
   :max-cost-usd 1.0 :max-human-reviews 1})

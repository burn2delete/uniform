            (if (map? (get defense :taint-rules))
              (if (vector? (get defense :denied-escalations))
                (if (contains? (set (get defense :denied-escalations))
                               :model-text-to-tool-grant)
                  (if (= :never (get defense :secret-policy))
                    (if (= :parse-check-before-execute
                           (get defense :generated-source-policy))
                      (if (vector? (get defense :required-probes))
                        (if (w5-domain-schema-ai-member?
                             (get defense :required-probes) :prompt-injection)
                          (if (w5-domain-schema-ai-span? (get defense :source-span))

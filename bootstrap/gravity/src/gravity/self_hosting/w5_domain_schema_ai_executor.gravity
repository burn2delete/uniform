                 :denied-escalations :secret-policy :generated-source-policy
                 :required-probes :source-span :provenance})
    (if (set? (get defense :authority-levels))
      (if (contains? (get defense :authority-levels) :system-trusted)
        (if (set? (get defense :untrusted-levels))

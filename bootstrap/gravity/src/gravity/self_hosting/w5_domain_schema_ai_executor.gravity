                             (get defense :provenance))
                            false)
                          false)
                        false)
                      false)
                    false)
                  false)
                false)
              false)
            false)
          false)
        false)
      false)
    false))

(defn w5-domain-schema-ai-targets-valid? [request]
  (if (= :jvm (get request :stage2-target))

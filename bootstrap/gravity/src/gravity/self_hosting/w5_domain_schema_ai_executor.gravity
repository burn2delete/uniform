       (contains? (get (get policy :human-review) :required-for)
                  :database/write)
       (= :untrusted-until-schema-validated
          (get (get policy :taint) :ai-output))
       (= :requires-eval (get policy :fallback))
       (w5-domain-schema-ai-exact-keys?
        (get policy :generated-code) #{:must-compile :must-pass-tests})
       (= true (get (get policy :generated-code) :must-compile))
       (= true (get (get policy :generated-code) :must-pass-tests))
       (= true (get policy :eval-required))

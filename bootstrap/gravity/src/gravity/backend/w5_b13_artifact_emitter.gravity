(defn w5-b13-source-map-locations-valid? [locations source-id index]
  (if (= index (count w5-b13-provenance-phases))
    (= index (count locations))
    (let [location (get locations index)
          phase (get w5-b13-provenance-phases index)]
      (if (w5-b13-exact-keys?
           location #{:phase :source-span :origin})
        (if (= phase (get location :phase))
          (if (= phase (get location :origin))
            (if (w5-b13-source-span-valid? (get location :source-span))
              (if (= source-id
                     (get (get location :source-span) :source-id))
                (w5-b13-source-map-locations-valid?
                 locations source-id (+ index 1))
                false)
              false)
            false)
          false)
        false))))

(defn w5-b13-source-map-valid? [request]

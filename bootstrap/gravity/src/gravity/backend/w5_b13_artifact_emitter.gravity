           :public-authority? :full-language? :non-authority :status})
      (if (= :gravity/artifact-release-gate (get gate :artifact))
        (if (= :complete (get gate :status))
          (if (= :blocked-development-only
                 (get gate :release-grade-artifact-status))
            (if (= :stage2-static-development-evidence (get gate :reason))
              (if (= [:signing :packaging :deployment :release-governance]
                     (get gate :blocked-downstream))
                (if (= "B13-RELEASE"
                       (get gate :diagnostic-on-release-attempt))
                  (if (= :not-release-authority (get gate :authority))
                    (if (= true (get gate :clojure-seed-boundary?))
                      (if (= false (get gate :self-hosted?))
                        (if (= false (get gate :release?))
                          (if (= false (get gate :public-authority?))
                            (if (= false (get gate :full-language?))
                              (if (= w5-b13-non-authority
                                     (get gate :non-authority))
                                (= false (get request :release-attempt?))
                                false)
                              false)
                            false)
                          false)
                        false)
                      false)
                    false)
                  false)
                false)
              false)
            false)
          false)
        false)
      false)))

(defn w5-b13-graph-nodes-valid?
  [nodes expected-digests index]
  (if (= index (count w5-b13-provenance-phases))
    (= index (count nodes))
    (let [node (get nodes index)]
      (if (w5-b13-exact-keys? node #{:node-id :kind :digest})
        (if (= (get w5-b13-provenance-phases index)
               (get node :node-id))
          (if (= (get w5-b13-provenance-phases index)
                 (get node :kind))
            (if (= (get expected-digests index) (get node :digest))
              (if (w5-b13-sha256-id? (get node :digest))
                (w5-b13-graph-nodes-valid?
                 nodes expected-digests (+ index 1))
                false)
              false)
            false)
          false)
        false))))

(defn w5-b13-graph-edges-valid? [edges source-id index]
  (if (= index (count w5-b13-provenance-passes))
    (= index (count edges))
    (let [edge (get edges index)
          from (get w5-b13-provenance-phases index)
          to (get w5-b13-provenance-phases (+ index 1))]
      (if (w5-b13-exact-keys?
           edge #{:from :to :pass :source-span :origin})
        (if (= from (get edge :from))
          (if (= to (get edge :to))
            (if (= (get w5-b13-provenance-passes index)
                   (get edge :pass))
              (if (= to (get edge :origin))
                (if (w5-b13-source-span-valid? (get edge :source-span))
                  (if (= source-id
                         (get (get edge :source-span) :source-id))
                    (w5-b13-graph-edges-valid?
                     edges source-id (+ index 1))
                    false)
                  false)
                false)
              false)
            false)
          false)
        false))))

(defn w5-b13-graph-valid? [request]
  (let [graph (get request :artifact-graph)
        manifest (get request :manifest)
        expected-digests
        [(get (get manifest :inputs) :source)
         (get (get manifest :inputs) :source)
         (get (get manifest :inputs) :source)
         (get (get manifest :inputs) :source)
         (get (get manifest :inputs) :mir)
         (get (get manifest :inputs) :mir)
         (get (get manifest :inputs) :mir)
         (get (get manifest :inputs) :mir)
         (get (get manifest :inputs) :mir)
         (get (get manifest :inputs) :mir)
         (get (get manifest :inputs) :mir)
         (get (get manifest :inputs) :mir)
         (get (get manifest :inputs) :mir)
         (get (get manifest :inputs) :mir)
         (get (get manifest :inputs) :lowering)
         (get (get manifest :inputs) :lowering)
         (get (get manifest :inputs) :lowering)
         (get (get manifest :inputs) :lowering)
         (get request :artifact-id)
         (get (get request :conformance-evidence-reference) :evidence-id)]]
    (if (w5-b13-exact-keys?
         graph #{:artifact :artifact-id :root :nodes :edges
                 :dependency-graph-id :dependencies
                 :invalidation-rules :status})
      (if (= :gravity/artifact-graph (get graph :artifact))
        (if (= :complete (get graph :status))
          (if (= (get graph :artifact-id) (get request :artifact-id))
            (if (= w5-b13-dependency-inventory (get graph :dependencies))
              (if (= (get graph :dependency-graph-id)
                     (get (get request :dependency-provenance)
                          :dependency-graph-id))
            (if (= :source-forms (get graph :root))
            (if (vector? (get graph :nodes))
              (if (w5-b13-graph-nodes-valid?
                   (get graph :nodes) expected-digests 0)
                (if (vector? (get graph :edges))
                  (if (w5-b13-graph-edges-valid?
                       (get graph :edges)
                       (get (get manifest :inputs) :source) 0)
                    (= [:source-change :compiler-change :pass-change
                        :target-change :dependency-change :evidence-change]
                       (get graph :invalidation-rules))
                    false)
                  false)
                false)
              false)
            false)
            false)
            false)
            false)
          false)
        false)
      false)))

(defn w5-b13-identity-input [request]

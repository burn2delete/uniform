(defn w5-b13-evidence-valid? [request]
  (let [bundle (get request :safety-proof-certificate-bundle)
        summary (get request :effect-capability-summary)
        manifest (get request :manifest)
        evidence (get manifest :evidence)]
    (if (w5-b13-exact-keys?
         bundle #{:artifact :bundle-id :safety-mode :safety-outcomes
                  :proofs :certificates :unsafe-audit-records :status})
      (if (= :gravity/safety-proof-certificate-bundle
             (get bundle :artifact))
        (if (= :structural-complete (get bundle :status))
          (if (w5-b13-sha256-id? (get bundle :bundle-id))
            (if (= :safe (get bundle :safety-mode))
              (if (= [:proven-safe] (get bundle :safety-outcomes))
                (if (= ["proof:manifest-schema" "proof:target-coherence"
                        "proof:source-map-preservation"]
                       (get bundle :proofs))
                  (if (= ["certificate:content-hash"
                          "certificate:graph-closure"]
                         (get bundle :certificates))
                    (if (= [] (get bundle :unsafe-audit-records))
                  (if (w5-b13-exact-keys?
                       summary #{:artifact :effects :capabilities
                                 :unsafe-islands :status})
                    (if (= :gravity/effect-capability-summary
                           (get summary :artifact))
                      (if (= :complete (get summary :status))
                        (if (= #{} (get summary :effects))
                          (if (= #{} (get summary :capabilities))
                            (if (= #{} (get summary :unsafe-islands))
                              (if (w5-b13-exact-keys?
                                   evidence #{:safety :proofs :certificates
                                              :effects :capabilities
                                              :conformance})
                                (if (= (get summary :effects)
                                       (get manifest :effects))
                                  (if (= (get summary :capabilities)
                                         (get manifest :capabilities))
                                    (if (= (get bundle :bundle-id)
                                           (get evidence :safety))
                                      (if (= (get bundle :bundle-id)
                                             (get evidence :proofs))
                                        (if (= (get bundle :bundle-id)
                                               (get evidence :certificates))
                                          (if (= (get summary :effects)
                                                 (get evidence :effects))
                                            (if (= (get summary :capabilities)
                                                   (get evidence :capabilities))
                                              (w5-b13-sha256-id?
                                               (get evidence :conformance))
                                              false)
                                            false)
                                          false)

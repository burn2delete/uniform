                       (get source-map :actual-source-path))
                    (if (= (get source-map :actual-source-path)
                           (get provenance :actual-source-path))
                      (if (vector? (get source-map :locations))
                        (if (w5-b13-source-map-locations-valid?
                             (get source-map :locations)

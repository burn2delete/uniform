    (if (w5-b13-exact-keys?
         conformance #{:artifact :evidence-id :packs :diagnostics
                       :metadata-preservation :verification
                       :independently-verified? :status})
      (if (= :gravity/conformance-evidence-reference
             (get conformance :artifact))
        (if (= :pending-unverified (get conformance :status))
          (if (w5-b13-sha256-id? (get conformance :evidence-id))
            (if (= (get conformance :evidence-id)
                   (get (get manifest :evidence) :conformance))
              (if (= ["B13-common-manifest" "B13-static-target"
                      "B14-metadata"]
                     (get conformance :packs))
                (if (= 10 (count (get conformance :diagnostics)))
                  (if (= (set (get conformance :diagnostics))
                         (set w5-b13-diagnostic-ids))
                    (if (= :pending-unverified
                           (get conformance :metadata-preservation))
                      (if (= :structural-crosslink-only
                             (get conformance :verification))
                        (if (= false
                               (get conformance :independently-verified?))
                          (if (w5-b13-exact-keys?
                               stream #{:artifact :diagnostics :status})
                            (if (= :gravity/w5-b13-diagnostic-stream
                                   (get stream :artifact))

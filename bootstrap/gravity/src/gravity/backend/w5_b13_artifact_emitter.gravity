(defn w5-b13-reproducibility-valid? [request]
  (let [record (get request :reproducibility-record)
        manifest (get request :manifest)
        hash-record (get request :hash-record)
        hashes (get record :hashes)]
    (if (map? record)
      (if (w5-b13-exact-keys?
           record #{:artifact :hashes :timestamp-policy :environment-inputs
                    :nondeterminism :path-dependent-identity?
                    :cryptographically-verified? :reproducible? :status})
        (if (= :gravity/reproducibility-record (get record :artifact))
          (if (= :pending-unverified (get record :status))
            (if (= false (get record :cryptographically-verified?))
              (if (= false (get record :reproducible?))
                (if (= :none (get record :timestamp-policy))
                  (if (vector? (get record :environment-inputs))
                    (if (vector? (get record :nondeterminism))
                      (if (= false (get record :path-dependent-identity?))
                        (if (w5-b13-all-sha256? hashes)
                          (if (= 9 (count hashes))
                            (if (= (get hashes 0)
                                   (get (get manifest :inputs) :source))
                              (if (= (get hashes 1)
                                     (get (get manifest :inputs) :mir))
                                (if (= (get hashes 2)
                                       (get (get manifest :inputs) :lowering))
                                  (if (= (get hashes 3)
                                         (get manifest :content-hash))
                                    (if (= (get hashes 4)
                                           (get hash-record :manifest-digest))
                                      (if (= (get hashes 5)
                                             (get request :artifact-id))
                                        (if (= (get hashes 6)
                                               (get (get request
                                                         :dependency-provenance)
                                                    :dependency-graph-id))
                                          (if (= (get hashes 7)
                                                 (get (get request
                                                           :safety-proof-certificate-bundle)
                                                      :bundle-id))
                                            (= (get hashes 8)
                                               (get (get request
                                                         :conformance-evidence-reference)
                                                    :evidence-id))
                                            false)
                                          false)
                                        false)
                                      false)
                                    false)
                                  false)
                                false)
                              false)
                            false)
                          false)
                        false)
                      false)
                    false)
                  false)
                false)
              false)
            false)
          false)
        false)
      false)))

(defn w5-b13-release-gate-valid? [request]

   :schema-version (get request :schema-version)
   :source-id (w5-b13-at request [:provenance :source-id] 0)
   :manifest-digest (w5-b13-at request [:hash-record :manifest-digest] 0)
   :content-hash (w5-b13-at request [:manifest :content-hash] 0)
   :target-scope (get request :target-scope)
   :profile (get request :profile)
   :backend :llvm
   :kind (w5-b13-at request [:manifest :kind] 0)
   :compiler-id (w5-b13-at request [:compiler-provenance :compiler-id] 0)
   :pass-pipeline (w5-b13-at request [:compiler-provenance :pass-pipeline] 0)
   :dependency-graph-id (w5-b13-at request
                                    [:dependency-provenance :dependency-graph-id]
                                    0)
   :evidence-id (w5-b13-at request
                            [:conformance-evidence-reference :evidence-id]
                            0)
   :reproducibility-hashes (w5-b13-at request
                                       [:reproducibility-record :hashes]
                                       0)})

(defn w5-b13-diagnostic [rule request field remediation]
  {:artifact :gravity/diagnostic
   :diagnostic-id rule
   :rule rule
   :severity :error
   :stage :artifact-emission
   :artifact-id (get request :artifact-id)
   :artifact-kind (w5-b13-at request [:manifest :kind] 0)
   :backend :gravity.backend/llvm
   :profile (get request :profile)
   :target (get request :target)
   :missing-or-stale-field field
   :source-span (w5-b13-at request [:source-debug-map :source-span] 0)
   :generated-origin-edge (w5-b13-at request
                                      [:source-debug-map :generated-origin-chain]
                                      0)
   :remediation remediation
   :clojure-seed-boundary? true
   :self-hosted? false
   :release? false
   :public-authority? false
   :authority :non-authority
   :facts {:static-only? true
           :path-bearing-provenance? true
           :path-neutral-identity? true
           :darwin-fallback? false
           :cross-target-inference? false}})

(defn w5-b13-rejected [request diagnostic]
  {:artifact :gravity/w5-b13-artifact-emission
   :status :rejected
   :diagnostics [diagnostic]
   :artifact-id nil
   :identity-input nil
   :provenance (get request :provenance)
   :artifact-manifests []
   :content-hash-records []
   :artifact-graph nil
   :emitted-artifacts []
   :release-gate-record (get request :release-gate-record)
   :clojure-seed-boundary? true
   :self-hosted? false
   :release? false
   :public-authority? false
   :authority :non-authority
   :non-authority w5-b13-non-authority
   :static-only? true
   :target :llvm-x86_64-linux
   :residual-boundaries (:residual-boundaries (w5-b13-policy))})

(defn w5-b13-emit [request]
  (if (w5-b13-request-shape-valid? request)
    (if (w5-b13-manifest-valid? (get request :manifest))
      (if (w5-b13-hash-valid? request)
        (if (w5-b13-provenance-valid? request)
          (if (w5-b13-source-map-valid? request)
            (if (w5-b13-evidence-valid? request)
              (if (w5-b13-target-coherent? (get request :target-scope))
                (if (w5-b13-target-records-valid? request)
                  (if (w5-b13-target-record-links-valid? request)
                    (if (w5-b13-conformance-valid? request)
                      (if (w5-b13-reproducibility-valid? request)
                    (if (w5-b13-release-gate-valid? request)
                      (if (w5-b13-graph-valid? request)
                        {:artifact :gravity/w5-b13-artifact-emission
                         :status :accepted
                         :schema-version 1
                         :artifact-id (get request :artifact-id)
                         :kind (w5-b13-at request [:manifest :kind] 0)
                         :backend :gravity.backend/llvm
                         :profile (get request :profile)
                         :target :llvm-x86_64-linux
                         :candidate-target :llvm-x86_64-linux
                         :candidate-platform {:os :linux
                                              :arch :x86_64
                                              :backend :llvm
                                              :object-format :elf
                                              :abi :sysv-amd64}
                         :unsupported-platforms w5-b13-unsupported-targets
                         :unsupported-targets w5-b13-unsupported-targets
                         :unsupported-target-policies
                         w5-b13-unsupported-target-policies
                         :cross-target-inference? false
                         :darwin-fallback? false
                         :candidate-invokes-clojure? false
                         :candidate-links-jvm? false
                         :candidate-fallback? false
                         :no-fallback? true
                         :release-eligible? false
                         :static-only? true
                         :manifest (get request :manifest)
                         :artifact-manifests [(get request :manifest)]
                         :content-hash-records [(get request :hash-record)]
                         :artifact-graph (get request :artifact-graph)
                         :source-debug-map (get request :source-debug-map)
                         :compiler-provenance (get request :compiler-provenance)
                         :dependency-provenance
                         (get request :dependency-provenance)
                         :safety-proof-certificate-bundle
                         (get request :safety-proof-certificate-bundle)
                         :effect-capability-summary
                         (get request :effect-capability-summary)
                         :runtime-provider-summary
                         (get request :runtime-provider-summary)
                         :target-runtime-abi-layout-summary
                         (get request :target-runtime-abi-layout-summary)
                         :reproducibility-record
                         (get request :reproducibility-record)
                         :conformance-evidence-reference
                         (get request :conformance-evidence-reference)
                         :release-gate-record
                         (get request :release-gate-record)
                         :emitted-artifacts [(get request :emitted-artifact)]
                         :diagnostic-stream (get request :diagnostic-stream)
                         :diagnostics []
                         :artifact-emission-results
                         {:required-diagnostic-ids w5-b13-diagnostic-ids
                          :manifest-schema-status :complete
                          :content-hash-status :pending-unverified
                          :provenance-status :structural-complete
                          :source-map-status :complete
                          :evidence-status :structural-complete
                          :target-runtime-abi-status :complete
                          :reproducibility-status :pending-unverified
                          :release-gate-status :complete
                          :artifact-graph-status :complete
                          :conformance-status :pending-unverified
                          :status :incomplete}
                         :capability-based-proof
                         {:common-manifest-schema-complete? true
                          :content-hashes-complete? false
                          :content-hashes-cryptographically-verified? false
                          :provenance-complete? false
                          :provenance-structurally-complete? true
                          :source-debug-map-preserved? true
                          :evidence-bundle-complete? false
                          :evidence-bundle-structurally-complete? true
                          :target-runtime-abi-metadata-complete? true
                          :reproducibility-recorded? false
                          :reproducible? false
                          :development-release-gate-blocked? true
                          :artifact-graph-complete? true
                          :conformance-evidence-complete? false
                          :conformance-evidence-structurally-linked? true
                          :diagnostics-covered? true
                          :status :incomplete}
                         :identity-input (w5-b13-identity-input request)
                         :provenance (get request :provenance)
                         :clojure-seed-boundary? true
                         :self-hosted? false
                         :release? false
                         :public-authority? false
                         :authority :non-authority
                         :completion :incomplete
                         :blocked? true
                         :non-authority w5-b13-non-authority
                         :residual-boundaries
                         (:residual-boundaries (w5-b13-policy))}
                        (w5-b13-rejected
                         request
                         (w5-b13-diagnostic
                          "B13-GRAPH" request :artifact-graph
                          :repair-artifact-graph-nodes-and-edges)))
                      (w5-b13-rejected
                       request
                       (w5-b13-diagnostic
                        "B13-RELEASE" request :release-gate-record
                        :block-release-grade-output-until-release-evidence-is-present)))
                    (w5-b13-rejected
                     request
                     (w5-b13-diagnostic
                      "B13-REPRODUCIBILITY" request :reproducibility-record
                      :record-environment-inputs-nondeterminism-and-timestamp-policy)))
                      (w5-b13-rejected
                       request
                       (w5-b13-diagnostic
                        "B13-CONFORMANCE" request :conformance-evidence-reference
                        :attach-policy-required-conformance-evidence)))
                    (w5-b13-rejected
                     request
                     (w5-b13-diagnostic
                      "B13-TARGET" request :target-runtime-abi-layout-summary
                      :declare-coherent-target-runtime-provider-abi-and-layout)))
                (w5-b13-rejected
                 request
                 (w5-b13-diagnostic
                  "B13-TARGET" request :target-runtime-abi-layout-summary
                  :declare-coherent-target-runtime-provider-abi-and-layout)))
                (w5-b13-rejected
                 request
                 (w5-b13-diagnostic
                  "B13-TARGET" request :target-scope
                  :declare-coherent-target-runtime-provider-abi-and-layout)))
              (w5-b13-rejected
               request
               (w5-b13-diagnostic
                "B13-EVIDENCE" request :safety-proof-certificate-bundle
                :attach-safety-proof-certificate-effect-capability-and-unsafe-audit-records)))
            (w5-b13-rejected
             request
             (w5-b13-diagnostic
              "B13-SOURCEMAP" request :source-debug-map
              :preserve-source-spans-and-generated-origin-chain)))
          (w5-b13-rejected
           request
           (w5-b13-diagnostic
            "B13-PROVENANCE" request :provenance
            :attach-source-compiler-generator-pass-and-dependency-provenance)))
        (w5-b13-rejected
         request
         (w5-b13-diagnostic
          "B13-HASH" request :content-hash
          :recompute-content-hash-and-manifest-digest)))
      (w5-b13-rejected
       request
       (w5-b13-diagnostic
        "B13-SCHEMA" request :manifest
        :emit-supported-common-manifest-schema)))
    (w5-b13-rejected
     request
      (w5-b13-diagnostic
      "B13-SCHEMA" request :request
      :emit-supported-common-manifest-schema))))

(defn w5-b13-artifact-emission [request]
  (w5-b13-emit request))

(defn w5-b13-execute [request]
  (w5-b13-emit request))

(defn w5-b13-run [request]
  (w5-b13-emit request))

(defn w5-b13-recompute [request]
  (w5-b13-emit request))

(defn w5-b13-verify-result [request result]
  (let [expected (w5-b13-emit request)]
    (if (= expected result)
      {:artifact :gravity/w5-b13-verification
       :status :passed
       :recomputed true
       :diagnostics []
       :clojure-seed-boundary? true
       :self-hosted? false
       :release? false
       :public-authority? false
       :authority :non-authority
       :non-authority w5-b13-non-authority}
      {:artifact :gravity/w5-b13-verification
       :status :rejected
       :recomputed true
       :diagnostics
       [(w5-b13-diagnostic
         "B13-HASH" request :result
         :recompute-content-hash-and-manifest-digest)]
       :clojure-seed-boundary? true
       :self-hosted? false
       :release? false
       :public-authority? false
       :authority :non-authority
       :non-authority w5-b13-non-authority})))

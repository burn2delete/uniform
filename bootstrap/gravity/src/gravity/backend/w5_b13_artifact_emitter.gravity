    (if (w5-b13-exact-keys?
         provenance
         #{:artifact :source-id :actual-source-path :compiler-id
           :generator-id :pass-pipeline :dependency-graph-id :dependencies
           :status})
      (if (= :gravity/artifact-provenance-record (get provenance :artifact))
        (if (= :structural-complete (get provenance :status))
          (if (w5-b13-nonempty-string? (get provenance :actual-source-path))
            (if (w5-b13-sha256-id? (get provenance :source-id))
              (if (w5-b13-exact-keys?
                   compiler
                   #{:artifact :compiler-id :compiler-version :generator-id
                     :pass-pipeline :pass-contract :source-id :status})
                (if (= :gravity/compiler-provenance-record
                       (get compiler :artifact))
                  (if (= "gravity-w5-b13-stage2" (get compiler :compiler-id))
                    (if (= "0.1.0" (get compiler :compiler-version))
                      (if (= "gravity.backend.w5-b13-artifact-emitter"
                             (get compiler :generator-id))
                        (if (= "B13-artifact-emission-v1"
                               (get compiler :pass-contract))
                          (if (= :complete (get compiler :status))
                            (if (w5-b13-exact-keys?
                                 dependencies
                                 #{:artifact :dependency-graph-id
                                   :dependencies :generator :target-toolchain
                                   :runtime-providers :status})
                              (if (= :gravity/dependency-provenance-record
                                     (get dependencies :artifact))
                                (if (= w5-b13-dependency-inventory
                                       (get dependencies :dependencies))
                                  (if (= "gravity.backend.w5-b13-artifact-emitter"
                                         (get dependencies :generator))
                                    (if (= "llvm-x86_64-linux-static-record"
                                           (get dependencies :target-toolchain))
                                      (if (= [] (get dependencies
                                                    :runtime-providers))
                                        (if (= :complete
                                               (get dependencies :status))
                                          (if (= (get provenance
                                                      :actual-source-path)

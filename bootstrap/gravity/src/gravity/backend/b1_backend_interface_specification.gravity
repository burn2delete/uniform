             :dependency-provenance :c13-optimization-status
             :domain-ir-status :fusion-status :target-policy
             :proof-to-target-metadata :unsupported-feature-report
             :diagnostics})
      (if (= [(get request :artifact) (get request :schema-version)
              (get request :status) (get request :profile)
              (get request :profile-contract) (get request :effects)
              (get request :capabilities)
              (get request :c13-optimization-status)
              (get request :domain-ir-status) (get request :fusion-status)
              (get request :diagnostics)]
             [:gravity/c14-internal-target-lowering-request 1 :accepted

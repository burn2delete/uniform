   false)
   false))

(defn b1-build-bounded-llvm-authenticated-packet
  [lowering backend-manifest]
  (if (b1-bounded-c14-input-valid? lowering)
    (if (b1-bounded-llvm-manifest-valid? backend-manifest)
      (if (= (get backend-manifest :c14-request-id)
             (get (get lowering :request) :request-id))
       (if (= (get backend-manifest :c14-artifact-id)
              (get lowering :artifact-id))
      (let [request (get lowering :request)]
        {:artifact :gravity/b1-verified-backend-input-packet
         :schema-version 1
         :status :accepted-for-bounded-llvm
         :input (get request :input)
         :profile (get request :profile-contract)
         :target (get request :target)
         :source-target-selection (get request :source-target-selection)
         :abi (get request :abi)
         :runtime (get request :runtime)
         :providers (get request :providers)
         :effects (get request :effects)
         :capabilities (get request :capabilities)
         :safety (get request :safety)
         :proofs (get request :proofs)
         :proof-to-target-metadata
         (get request :proof-to-target-metadata)
         :source-map (get request :source-map)
         :dependencies (get request :dependency-provenance)
         :contract-bindings (get request :contract-bindings)
         :c14-eligibility (get lowering :eligibility)
         :eligibility
         {:artifact :gravity/b1-backend-eligibility-report
          :backend :gravity.backend/llvm
          :input-artifact (get (get request :input) :artifact-id)
          :profile (get request :profile)
          :target (get request :target)
          :accepted? true
          :rejections []
          :fallbacks []
          :missing-evidence []
          :unsupported-operations []
          :remediation []
          :checks [:profile-backend-compatibility
                   :target-feature-support
                   :runtime-availability-or-no-runtime-proof
                   :abi-representability :layout-representability
                   :provider-availability :effect-preservation
                   :capability-preservation
                   :safety-bundle-completeness
                   :proof-validity-for-target-assumptions
                   :source-debug-map-preservation]}
         :backend-manifest backend-manifest
         :unsupported-feature-report
         {:status :bounded-surface-only
          :policy
          (get (get request :unsupported-feature-report) :policy)
          :diagnostic "B1-UNSUPPORTED"
          :fallback-status :rejected}
         :diagnostics []
         :semantic-authority :gravity-source
         :execution-tcb :clojure-stage0-rule-runner
         :clojure-seed-boundary? true
         :self-hosted? false})
      {:artifact :gravity/b1-verified-backend-input-packet
       :schema-version 1
       :status :rejected
       :diagnostic "B1-INPUT"
       :missing-fact :c14-artifact-manifest-binding
       :diagnostics ["B1-INPUT"]})
      {:artifact :gravity/b1-verified-backend-input-packet
       :schema-version 1
       :status :rejected
       :diagnostic "B1-INPUT"
       :missing-fact :c14-request-manifest-binding
       :diagnostics ["B1-INPUT"]})
      {:artifact :gravity/b1-verified-backend-input-packet
       :schema-version 1
       :status :rejected
       :diagnostic "B1-TARGET"
       :missing-fact :exact-llvm-backend-manifest
       :diagnostics ["B1-TARGET"]})
    {:artifact :gravity/b1-verified-backend-input-packet
     :schema-version 1
     :status :rejected
     :diagnostic "B1-INPUT"
     :missing-fact :accepted-c14-lowering-record
     :diagnostics ["B1-INPUT"]}))

; Separate C17 admission prevents a C backend from accepting an LLVM/Wasm
; lowering by changing labels.  The full bounded C14 payload, including the
; genuine optimized MIR, is preserved unchanged into the B1 packet.
(defn b1-c14-c-target-valid?
  [target]
  (if (map? target)
    (if (= (set (keys target))
           #{:request :triple :data-layout :cpu :features :object-format
             :architecture :relocation-model :code-model
             :optimization-level :minimum-os-version :sanitizers
             :instrumentation :backend :tier :exposure
             :source-declaration-target :requested-lowering-target
             :selection :reason :direct-source-declared-c?
             :profile-eligibility :dialect :fingerprint})
      (if (= [(get target :request) (get target :triple)
              (get target :data-layout) (get target :cpu)
              (get target :features) (get target :object-format)
              (get target :architecture) (get target :relocation-model)
              (get target :code-model) (get target :optimization-level)
              (get target :minimum-os-version) (get target :sanitizers)
              (get target :instrumentation) (get target :backend)
              (get target :tier) (get target :exposure)
              (get target :source-declaration-target)
              (get target :requested-lowering-target)
              (get target :selection) (get target :reason)
              (get target :direct-source-declared-c?)
              (get target :profile-eligibility) (get target :dialect)]
             [:c "arm64-apple-macosx14.0.0"
              "e-m:o-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-n32:64-S128-Fn32"
              "generic" "+v8a,+fp-armv8,+neon" :mach-o :arm64 :pic
              :small :O0 "14.0" [] [] :gravity.backend/c
              :experimental :internal :jvm :c
              :explicit-bootstrap-seed-target-override
              :checked-core-seed-contract false [:hosted] :c17])
        (= (get target :fingerprint)
           "sha256:007558417ed666401204a9933843d05d93a7f481eaae3641885d854f1a7af8d0")
        false)
      false)
    false))

(defn b1-c14-c-input-valid?
  [input]
  (if (map? input)
    (if (= (set (keys input))
           #{:kind :id :artifact-id :c11-artifact-id :verified?
             :verifier-report :verifier-report-id :optimization-status
             :optimization-report :domain-status})
      (if (= [(get input :kind) (get input :verified?)
              (get input :optimization-status) (get input :domain-status)]
             [:gravity/mir true :identity-pass-complete :not-applicable])
        (if (b1-sha256-id? (get input :id))
          (if (b1-sha256-id? (get input :artifact-id))
            (if (b1-sha256-id? (get input :c11-artifact-id))
              (if (b1-sha256-id? (get input :verifier-report-id))
                (if (b1-c14-verifier-valid? (get input :verifier-report))
                  (if (map? (get input :optimization-report))
                    (if (= (set (keys (get input :optimization-report)))
                           #{:artifact-id :semantic-id :decision-id
                             :verifier-result})
                      (if (= [(get (get input :optimization-report)
                                    :artifact-id)
                              (get (get input :optimization-report)
                                   :semantic-id)
                              (get (get input :optimization-report)
                                   :verifier-result)]
                             [(get input :artifact-id)
                              (get input :id) :passed])
                        (b1-sha256-id?
                         (get (get input :optimization-report) :decision-id))
                        false)
                      false)
                    false)
                  false)
                false)
              false)
            false)
          false)
        false)
      false)
    false))

(defn b1-c14-c-contract-bindings-valid?
  [request]
  (let [bindings (get request :contract-bindings)
        safety (get request :safety)
        source-map (get request :source-map)]
    (if (map? bindings)
      (if (= (set (keys bindings))
             #{:profile :target :abi :runtime :providers :effects
               :capabilities :type :ownership :safety :proofs
               :source-map :dependencies
               :c11-verifier :c13-optimization})
        (if (= [(get (get bindings :profile) :entry-count)
                (get (get bindings :target) :entry-count)
                (get (get bindings :abi) :entry-count)
                (get (get bindings :runtime) :entry-count)
                (get (get bindings :providers) :entry-count)
                (get (get bindings :effects) :entry-count)
                (get (get bindings :capabilities) :entry-count)
                (get (get bindings :proofs) :entry-count)
                (get (get bindings :dependencies) :entry-count)
                (get (get bindings :c11-verifier) :entry-count)
                (get (get bindings :c13-optimization) :entry-count)]
               [2 24 8 4 3 2 3 2 6 1 4])
          (if (b1-content-binding-valid? (get bindings :profile))
            (if (b1-content-binding-valid? (get bindings :target))
              (if (b1-content-binding-valid? (get bindings :abi))
                (if (b1-content-binding-valid? (get bindings :runtime))
                  (if (b1-content-binding-valid? (get bindings :providers))
                    (if (b1-content-binding-valid? (get bindings :effects))
                      (if (b1-content-binding-valid?
                           (get bindings :capabilities))
                        (if (b1-content-binding-valid? (get bindings :type))
                          (if (b1-content-binding-valid?
                               (get bindings :ownership))
                            (if (= (get bindings :safety)
                                   (get safety :binding))
                              (if (b1-content-binding-valid?
                                   (get bindings :proofs))
                                (if (= (get (get bindings :source-map)
                                            :content-id)
                                       (get source-map :id))
                                  (if (b1-content-binding-valid?
                                       (get bindings :dependencies))
                                    (if (= (get (get bindings :c11-verifier)
                                                :content-id)
                                           (get (get request :input)
                                                :verifier-report-id))
                                      (if (b1-content-binding-valid?
                                           (get bindings :c11-verifier))
                                        (b1-content-binding-valid?
                                         (get bindings :c13-optimization))
                                        false)
                                      false)
                                    false)
                                  false)
                                false)
                              false)
                            false)
                          false)
                        false)
                      false)
                    false)
                  false)
                false)
              false)
            false)
          false)
        false)
      false)))

(defn b1-c14-c-dependencies-valid?
  [request]
  (let [dependencies (get request :dependency-provenance)
        input (get request :input)]
    (if (map? dependencies)
      (if (= (set (keys dependencies))
             #{:source-core :c11-source-rule :c11-pass :c13-artifact
               :c13-source-rule :b2-source})
        (if (b1-sha256-id? (get dependencies :source-core))
          (if (b1-c11-source-rule-valid?
               (get dependencies :c11-source-rule))
            (if (b1-sha256-id? (get dependencies :c11-pass))
              (if (= (get dependencies :c13-artifact)
                     (get input :artifact-id))
                (if (b1-c13-source-rule-valid?
                     (get dependencies :c13-source-rule))
                  (if (= (get dependencies :source-core)
                         (get (get (get (get input :verifier-report)
                                            :b1-preflight)
                                   :binding)
                              :checked-core-artifact-id))
                    (if (= (get dependencies :c11-pass)
                           (get (get (get (get input :verifier-report)
                                              :b1-preflight)
                                     :binding)
                                :pass-execution-record-id))
                      (b1-sha256-id? (get dependencies :b2-source))
                      false)
                    false)
                  false)
                false)
              false)
            false)
          false)
        false)
      false)))

(defn b1-bounded-c14-c-request-valid?
  [request]
  (if (map? request)
    (if (= (set (keys request))
           #{:artifact :schema-version :status :input :request-id
             :profile :profile-contract :target :source-target-selection
             :abi :runtime :providers :effects :capabilities :safety
             :proofs :contract-bindings :required-evidence :source-map
             :dependency-provenance :c13-optimization-status
             :domain-ir-status :fusion-status :target-policy
             :proof-to-target-metadata :unsupported-feature-report
             :diagnostics})
      (if (= [(get request :artifact) (get request :schema-version)
              (get request :status) (get request :profile)
              (get request :profile-contract) (get request :effects)
              (get request :capabilities)
              (get request :c13-optimization-status)
              (get request :domain-ir-status) (get request :fusion-status)
              (get request :diagnostics)]
             [:gravity/c14-internal-target-lowering-request 1 :accepted
              :hosted {:name :hosted :validated? true} #{} #{}
              :identity-pass-complete :not-applicable :not-run []])
        (if (b1-sha256-id? (get request :request-id))
          (if (b1-c14-c-input-valid? (get request :input))
            (if (b1-c14-c-target-valid? (get request :target))
              (if (= (get request :source-target-selection)
                     {:source-declaration-target :jvm
                      :requested-lowering-target :c
                      :selection :explicit-bootstrap-seed-target-override
                      :reason :checked-core-seed-contract
                      :direct-source-declared-c? false})
                (if (b1-c14-abi-valid? (get request :abi))
                  (if (b1-c14-runtime-valid? (get request :runtime))
                    (if (b1-c14-providers-valid? (get request :providers))
                      (if (b1-c14-safety-valid? (get request :safety))
                        (if (= [(get (get request :safety) :outcomes)
                                (get (get request :safety) :runtime-checks)]
                               [(get (get (get (get request :input)
                                               :verifier-report)
                                          :independent-verifier)
                                     :operation-count)
                                (get (get (get (get (get request :input)
                                                         :verifier-report)
                                                :independent-verifier)
                                           :runtime-checks)
                                     :runtime-check-count)])
                          (if (b1-c14-proofs-valid? (get request :proofs))
                            (if (b1-c14-c-contract-bindings-valid? request)
                              (if (= (get request :required-evidence)
                                     [:authenticated-c11-replay
                                      :independent-lowering-reconstruction
                                      :hosted-c17-source-and-header
                                      :mach-o-arm64-object
                                      :differential-process-result
                                      :content-hash-and-provenance])
                                (if (= (get request :source-map)
                                       {:id (get (get request :source-map) :id)
                                        :preserved? true})
                                  (if (b1-sha256-id?
                                       (get (get request :source-map) :id))
                                    (if (b1-c14-c-dependencies-valid? request)
                                      (if (= (get request :target-policy)
                                             {:scope
                                              :bounded-pure-scalar-forwarding-do-let-if-integer-comparisons
                                              :maximum-operation-count 128
                                              :dialect :c17
                                              :whole-c14? false
                                              :whole-b1? false
                                              :whole-b2? false
                                              :public? false :release? false
                                              :self-hosted? false})
                                        (if (= (get request
                                                    :proof-to-target-metadata)
                                               {:entries []
                                                :proofless-metadata-rejected?
                                                true})
                                          (= (get request
                                                  :unsupported-feature-report)
                                             {:status :bounded-surface-only
                                              :policy
                                              [:strings :quote :str :println
                                               :runtime-checks :effects
                                               :program-capabilities
                                               :domain-anchors
                                               :multiple-functions
                                               :multiple-conditionals
                                               :non-scalar-types
                                               :integer-outside-signed-i64
                                               :process-result-outside-0-to-255
                                               :pointers :ffi :mmio :volatile
                                               :atomics :inline-assembly]
                                              :diagnostic "C14-UNSUPPORTED"
                                              :fallback-status :rejected})
                                          false)
                                        false)
                                      false)
                                    false)
                                  false)
                                false)
                              false)
                            false)
                          false)
                        false)
                      false)
                    false)
                  false)
                false)
              false)
            false)
          false)
        false)
      false)
    false))

(defn b1-bounded-c14-c-eligibility-valid?
  [eligibility]
  (if (map? eligibility)
    (if (= (set (keys eligibility))
           #{:artifact :backend :profile :target :accepted? :rejections
             :fallbacks :missing-features :required-providers
             :proof-assumptions :explainability-record :checks})
      (if (= [(get eligibility :artifact) (get eligibility :backend)
              (get eligibility :profile) (get eligibility :accepted?)
              (get eligibility :rejections) (get eligibility :fallbacks)
              (get eligibility :missing-features)
              (get eligibility :proof-assumptions)
              (get eligibility :explainability-record)
              (get eligibility :checks)]
             [:gravity/c14-target-eligibility-report
              :gravity.backend/c :hosted true [] [] [] []
              {:decision :accepted
               :bounded-surface
               :pure-scalar-forwarding-do-let-if-integer-comparisons
               :dialect :c17
               :unsupported-diagnostic "C14-UNSUPPORTED"
               :no-hidden-runtime? true
               :no-hidden-effect-or-capability? true}
              [:profile-allows-backend
               :target-supports-required-mir-families
               :runtime-services-explicit :abi-represents-exports
               :effects-have-authority-preserving-providers
               :proof-assumptions-valid-for-target]])
        (if (b1-c14-c-target-valid? (get eligibility :target))
          (b1-c14-providers-valid?
           (get eligibility :required-providers))
          false)
        false)
      false)
    false))

(defn b1-c14-c-source-rule-valid?
  [rule]
  (if (map? rule)
    (if (= (set (keys rule))
           #{:artifact :owner :source-content-hash :source-byte-count
             :plan-semantic-hash :functions-semantic-hash
             :builder-function :builder-semantic-hash :function-shapes
             :semantic-authority :compiled-by :executed-by :self-hosted?})
      (= [(get rule :artifact) (get rule :owner)
          (get rule :source-byte-count) (get rule :source-content-hash)
          (get rule :plan-semantic-hash)
          (get rule :functions-semantic-hash)
          (get rule :builder-function) (get rule :builder-semantic-hash)
          (get rule :function-shapes) (get rule :semantic-authority)
          (get rule :compiled-by) (get rule :executed-by)
          (get rule :self-hosted?)]
         [:gravity/pinned-gravity-source-rule
          :gravity.compiler/c14-target-lowering 168303
          "sha256:f433e27eab7f58f50ea8c57b9a60c3046796f9f484d59f9534ec72921b33c126"
          "sha256:7ee55da35e45ae726c322dd52e739bea67c3ff3e6c9fb1644d3f1b6b38d1c94f"
          "sha256:c43facf8fc5b644209554093d1d2f23992eac5f403de8ad2c94ee92cb8809f93"
          'c14-build-bounded-c-lowering-record
          "sha256:3209bb1605d40c7a466a53eb01d6cf7a4d243210ce6a0c189ceb3b15564f09ee"
          '{c14-bounded-optimized-input-valid?
            {:arity 2 :params [optimized policy]}
            c14-c-bounded-mir-surface-valid?
            {:arity 2 :params [optimized policy]}
            c14-c-target-valid? {:arity 1 :params [target]}
            c14-c-target-envelope-valid?
            {:arity 2 :params [optimized policy]}
            c14-c-dependencies-valid?
            {:arity 2 :params [optimized dependencies]}
            c14-c-policy-core-valid?
            {:arity 2 :params [optimized policy]}
            c14-c-policy-evidence-valid?
            {:arity 2 :params [optimized policy]}
            c14-c-contract-bindings-match?
            {:arity 2 :params [optimized policy]}
            c14-c-policy-scope-valid? {:arity 1 :params [policy]}
            c14-bounded-c-policy-valid?
            {:arity 2 :params [optimized policy]}
            c14-build-bounded-c-lowering-record
            {:arity 2 :params [optimized policy]}}
          :gravity-source :clojure-stage0-seed
          :clojure-stage0-rule-runner false])
      false)
    false))

(defn b1-c14-c-operation-ids
  [instructions result]
  (if (= (count instructions) 0)
    result
    (let [operation (first instructions)]
      (if (map? operation)
        (if (string? (get operation :op-id))
          (b1-c14-c-operation-ids
           (rest instructions) (conj result (get operation :op-id)))
          nil)
        nil))))

(defn b1-c14-c-blocks-valid?
  [blocks block-order]
  (if (= (count block-order) 0)
    true
    (let [block-id (first block-order)
          block (get blocks block-id)]
      (if (map? block)
        (if (= (get block :block-id) block-id)
          (if (vector? (get block :instructions))
            (b1-c14-c-blocks-valid? blocks (rest block-order))
            false)
          false)
        false))))

(defn b1-c14-c-branch-value
  [block join-id]
  (if (map? block)
    (let [terminator (get block :terminator)]
      (if (map? terminator)
        (if (= (get terminator :kind) :branch)
          (if (= (get terminator :successors) [join-id])
            (let [operands (get terminator :operands)]
              (if (vector? operands)
                (if (= (count operands) 1)
                  (let [value-id (first operands)]
                    (if (string? value-id)
                      value-id
                      nil))
                  nil)
                nil))
            nil)
          nil)
        nil))
    nil))

(defn b1-c14-c-operation-by-id
  [instructions operation-id]
  (if (= (count instructions) 0)
    nil
    (let [operation (first instructions)]
      (if (map? operation)
        (if (= (get operation :op-id) operation-id)
          operation
          (b1-c14-c-operation-by-id (rest instructions) operation-id))
        nil))))

(defn b1-c14-c-canonical-join-valid?
  [join blocks then-id else-id join-id]
  (if (map? join)
    (if (= (set (keys join)) #{:block-id :value-id :incoming})
      (let [value-id (get join :value-id)
            incoming (get join :incoming)
            then-block (get blocks then-id)
            else-block (get blocks else-id)
            join-block (get blocks join-id)
            then-value (b1-c14-c-branch-value then-block join-id)
            else-value (b1-c14-c-branch-value else-block join-id)
            join-operation
            (if (map? join-block)
              (b1-c14-c-operation-by-id
               (get join-block :instructions) value-id)
              nil)]
        (if (= (get join :block-id) join-id)
          (if (string? value-id)
            (if (vector? incoming)
              (if (= (count incoming) 2)
                (let [then-incoming (first incoming)
                      else-incoming (first (rest incoming))]
                  (if (map? then-incoming)
                    (if (= (set (keys then-incoming))
                           #{:predecessor :value})
                      (if (map? else-incoming)
                        (if (= (set (keys else-incoming))
                               #{:predecessor :value})
                          (if (string? then-value)
                            (if (string? else-value)
                              (if (= [(get then-incoming :predecessor)
                                      (get then-incoming :value)
                                      (get else-incoming :predecessor)
                                      (get else-incoming :value)]
                                     [then-id then-value
                                      else-id else-value])
                                (if (map? join-operation)
                                  (= [(get join-operation :op-id)
                                      (get join-operation :opcode)
                                      (get join-operation :source-operation)
                                      (get join-operation :result)
                                      (get join-operation :block-id)]
                                     [value-id :conditional-join :if
                                      value-id join-id])
                                  false)
                                false)
                              false)
                            false)
                          false)
                        false)
                      false)
                    false))
                false)
              false)
            false)
          false))
      false)
    false))

(defn b1-c14-c-operation-order-from-blocks
  [blocks block-order result]
  (if (= (count block-order) 0)
    result
    (let [block (get blocks (first block-order))
          operation-ids
          (b1-c14-c-operation-ids (get block :instructions) result)]
      (if (vector? operation-ids)
        (b1-c14-c-operation-order-from-blocks
         blocks (rest block-order) operation-ids)
        nil))))

(defn b1-c14-c-bounded-operation-order
  [mir]
  (if (map? mir)
    (let [source-core (get mir :source-core)
          functions (get mir :functions)
          control-flow (get mir :control-flow-graph)]
      (if (string? source-core)
        (if (map? functions)
          (if (= (count functions) 1)
            (if (map? control-flow)
              (let [function (get functions (first (keys functions)))
                    entry-id (str source-core ":mir:entry")
                    then-id (str source-core ":mir:then")
                    else-id (str source-core ":mir:else")
                    join-id (str source-core ":mir:join")]
                (if (map? function)
                  (let [blocks (get function :blocks)
                        join (get control-flow :join)
                        conditional?
                        (b1-c14-c-canonical-join-valid?
                         join blocks then-id else-id join-id)
                        block-order
                        (if conditional?
                          [entry-id then-id else-id join-id]
                          [entry-id])]
                    (if (map? blocks)
                      (if (= (get function :entry) entry-id)
                        (if (= (get control-flow :entry) entry-id)
                          (if (if conditional?
                                true
                                (= join nil))
                            (if (= (set (keys blocks)) (set block-order))
                              (if (b1-c14-c-blocks-valid?
                                   blocks block-order)
                                (let [operation-order
                                      (b1-c14-c-operation-order-from-blocks
                                       blocks block-order [])]
                                  (if (vector? operation-order)
                                    (if (> (count operation-order) 0)
                                      (if (<= (count operation-order) 128)
                                        (if (= (count operation-order)
                                               (count
                                                (set operation-order)))
                                          operation-order
                                          [])
                                        [])
                                      [])
                                    []))
                                [])
                              [])
                            [])
                          [])
                        [])
                      []))
                  []))
              [])
            [])
          [])
        []))
    []))

(defn b1-c14-c-fact-binding-counts-valid?
  [mir facts]
  (if (map? (get mir :type-table))
    (if (map? (get mir :effect-table))
      (if (map? (get mir :ownership-table))
        (if (map? (get mir :capability-table))
          (if (map? (get mir :safety-table))
            (if (map? (get mir :runtime-check-table))
              (if (map? (get mir :proof-certificate-table))
                (if (map? (get mir :source-map))
                  (= [(get (get facts :type) :entry-count)
                      (get (get facts :effect) :entry-count)
                      (get (get facts :ownership) :entry-count)
                      (get (get facts :capability) :entry-count)
                      (get (get facts :safety) :entry-count)
                      (get (get facts :runtime-checks) :entry-count)
                      (get (get facts :proofs) :entry-count)
                      (get (get facts :source-map) :entry-count)]
                     [(count (get mir :type-table))
                      (count (get mir :effect-table))
                      (count (get mir :ownership-table))
                      (count (get mir :capability-table))
                      (count (get mir :safety-table))
                      (count (get mir :runtime-check-table))
                      (count (get mir :proof-certificate-table))
                      (count (get mir :source-map))])
                  false)
                false)
              false)
            false)
          false)
        false)
      false)
    false))

(defn b1-c14-c-fact-projections-valid?
  [mir request facts]
  (let [bindings (get request :contract-bindings)
        safety (get request :safety)
        proofs (get request :proofs)
        capability-proofs (get proofs :capability)
        certificates (get proofs :certificates)
        proof-table (get mir :proof-certificate-table)
        safety-proofs (get proof-table :safety-proofs)
        source-map (get request :source-map)]
    (if (= (get facts :type) (get bindings :type))
      (if (= (get facts :ownership) (get bindings :ownership))
        (if (= (get facts :safety) (get bindings :safety))
          (if (= (get facts :source-map) (get bindings :source-map))
            (if (= (get safety :binding) (get facts :safety))
              (if (= (get source-map :id)
                     (get (get facts :source-map) :content-id))
                (if (= [(get certificates :content-id)
                         (get certificates :entry-count)]
                       [(get (get facts :proofs) :content-id)
                        (get (get facts :proofs) :entry-count)])
                  (if (= (get capability-proofs :entry-count)
                         (count (get mir :capability-proof-table)))
                    (if (= (get capability-proofs :proof-ids)
                           (vec (sort-by-pr-str
                                 (keys (get mir
                                            :capability-proof-table)))))
                      (if (= (get certificates :safety-proof-count)
                             (count safety-proofs))
                        (= (get certificates :safety-proof-ids)
                           (vec (sort-by-pr-str (keys safety-proofs))))
                        false)
                      false)
                    false)
                  false)
                false)
              false)
            false)
          false)
        false)
      false)))

(defn b1-c14-c-contract-preimages-valid?
  [mir request]
  (let [bindings (get request :contract-bindings)
        input (get request :input)]
    (if (= (get (get bindings :profile) :entry-count)
           (count (get request :profile-contract)))
      (if (= (get (get bindings :target) :entry-count)
             (count (get request :target)))
        (if (= (get (get bindings :abi) :entry-count)
               (count (get request :abi)))
          (if (= (get (get bindings :runtime) :entry-count)
                 (count (get request :runtime)))
            (if (= (get (get bindings :providers) :entry-count)
                   (count (get request :providers)))
              (if (= (get (get bindings :effects) :entry-count) 2)
                (if (= (get (get bindings :capabilities) :entry-count) 3)
                  (if (= (get (get bindings :proofs) :entry-count) 2)
                    (if (= (get (get bindings :dependencies) :entry-count)
                           (count (get request :dependency-provenance)))
                      (if (= (get (get bindings :c11-verifier)
                                   :content-id)
                             (get input :verifier-report-id))
                        (if (= (get (get bindings :c11-verifier)
                                     :entry-count)
                               1)
                          (if (= (get (get bindings :c13-optimization)
                                       :entry-count)
                                 (count (get input
                                             :optimization-report)))
                            (if (= (get request :effects) #{})
                              (if (= (get request :capabilities) #{})
                                (if (= (get (get request :safety) :outcomes)
                                       (count (get mir :safety-table)))
                                  (= (get (get request :safety)
                                          :runtime-checks)
                                     (count (get mir
                                                 :runtime-check-table)))
                                  false)
                                false)
                              false)
                            false)
                          false)
                        false)
                      false)
                    false)
                  false)
                false)
              false)
            false)
          false)
        false)
      false)))

(defn b1-c14-c-mir-bindings-valid?
  [mir request operation-order]
  (let [input (get request :input)
        verifier (get input :verifier-report)
        independent (get verifier :independent-verifier)
        preflight (get verifier :b1-preflight)
        binding (get preflight :binding)
        dependencies (get request :dependency-provenance)
        pass (get mir :pass-execution-record)
        target (get request :target)
        selection (get request :source-target-selection)
        functions (get mir :functions)
        function (get functions (first (keys functions)))
        blocks (get function :blocks)
        runtime-table (get mir :runtime-check-table)
        data-flow (get mir :data-flow-graph)
        verifier-data-flow (get independent :data-flow)]
    (if (= [(get mir :artifact) (get mir :schema-version)
            (get mir :profile) (get mir :source-target)
            (get mir :target-request) (get mir :verification-status)
            (get mir :target-independent?)]
           [:gravity/mir-module 1 :hosted :jvm :c :passed true])
      (if (= [(get request :profile)
              (get (get request :profile-contract) :name)
              (get target :request)
              (get target :requested-lowering-target)
              (get selection :source-declaration-target)
              (get selection :requested-lowering-target)]
             [:hosted :hosted :c :c :jvm :c])
        (if (= (get mir :source-core)
               (get dependencies :source-core)
               (get binding :checked-core-artifact-id))
          (if (= (get mir :b1-preflight) preflight)
            (if (map? pass)
              (if (= (set (keys pass))
                     #{:artifact :pass-id :pass-contract-hash
                       :input-artifact-id :output-content-id
                       :verifier-report-id :verifier-report-hash
                       :diagnostics :status :record-id})
                (if (= [(get pass :artifact) (get pass :pass-id)
                        (get pass :input-artifact-id)
                        (get pass :output-content-id)
                        (get pass :verifier-report-id)
                        (get pass :verifier-report-hash)
                        (get pass :diagnostics) (get pass :status)
                        (get pass :record-id)]
                       [:gravity/build-mir-pass-execution-record
                        :c11-build-mir-bounded-slice
                        (get mir :source-core)
                        (get binding :mir-content-id)
                        (get binding :independent-verifier-report-id)
                        (get binding :independent-verifier-report-hash)
                        [] :verified-by-independent-seed
                        (get dependencies :c11-pass)])
                  (if (= (get pass :output-content-id)
                         (get binding :mir-content-id))
                    (if (= (get pass :record-id)
                           (get binding :pass-execution-record-id))
                      (if (b1-sha256-id? (get pass :pass-contract-hash))
                        (if (b1-sha256-id? (get pass :record-id))
                          (if (= (get independent :operation-count)
                                 (count operation-order))
                            (if (= (get independent :block-count)
                                   (count blocks))
                              (if (= (get independent :conditional-count)
                                     (if (= (get (get mir
                                                    :control-flow-graph)
                                                 :join)
                                            nil)
                                       0 1))
                                (if (= (get (get independent
                                                   :runtime-checks)
                                            :runtime-check-count)
                                       (count runtime-table))
                                  (if (= (get (get independent
                                                     :runtime-checks)
                                              :runtime-check-ids)
                                         (vec (sort-by-pr-str
                                               (keys runtime-table))))
                                    (= verifier-data-flow
                                       {:edge-count
                                        (count (get data-flow :edges))
                                        :terminator-use-count
                                        (count (get data-flow
                                                    :terminator-uses))
                                        :definition-count
                                        (count (get data-flow :definitions))
                                        :value-count
                                        (count (get data-flow :values))})
                                    false)
                                  false)
                                false)
                              false)
                            false)
                          false)
                        false)
                      false)
                    false)
                  false)
                false)
              false)
            false)
          false)
        false)
      false)))

(defn b1-c14-c-payload-valid?
  [lowering]
  (let [payload (get lowering :bounded-lowering-payload)
        request (get lowering :request)
        input (get request :input)
        mir (get payload :mir)
        facts (get payload :fact-bindings)
        operation-order (b1-c14-c-bounded-operation-order mir)]
    (if (map? payload)
      (if (= (set (keys payload))
             #{:artifact :c11-artifact-id :c13-artifact-id
               :c13-semantic-id :mir :operation-order :fact-bindings})
        (if (= [(get payload :artifact)
                (get payload :c11-artifact-id)
                (get payload :c13-artifact-id)
                (get payload :c13-semantic-id)]
               [:gravity/c14-bounded-c-lowering-payload
                (get input :c11-artifact-id)
                (get input :artifact-id)
                (get input :id)])
          (if (map? mir)
            (if (vector? (get payload :operation-order))
              (if (= (get payload :operation-order) operation-order)
                (if (> (count operation-order) 0)
                  (if (<= (count operation-order) 128)
                    (if (= (count operation-order)
                           (count (set operation-order)))
                    (if (map? facts)
                      (if (= (set (keys facts))
                             #{:type :effect :ownership :capability :safety
                               :runtime-checks :proofs :source-map})
                        (if (b1-content-binding-valid? (get facts :type))
                          (if (b1-content-binding-valid? (get facts :effect))
                            (if (b1-content-binding-valid?
                                 (get facts :ownership))
                              (if (b1-content-binding-valid?
                                   (get facts :capability))
                                (if (b1-content-binding-valid?
                                     (get facts :safety))
                                  (if (b1-content-binding-valid?
                                       (get facts :runtime-checks))
                                    (if (b1-content-binding-valid?
                                         (get facts :proofs))
                                      (if (b1-content-binding-valid?
                                           (get facts :source-map))
                                        (if (b1-c14-c-fact-binding-counts-valid?
                                             mir facts)
                                          (if (b1-c14-c-fact-projections-valid?
                                               mir request facts)
                                            (if (b1-c14-c-contract-preimages-valid?
                                                 mir request)
                                              (b1-c14-c-mir-bindings-valid?
                                               mir request operation-order)
                                              false)
                                            false)
                                          false)
                                        false)
                                      false)
                                    false)
                                  false)
                                false)
                              false)
                            false)
                          false)
                        false)
                      false)
                    false)
                  false)
                false)
              false)
              false)
            false)
          false)
        false)
      false)))

(defn b1-bounded-c14-c-input-valid?
  [lowering]
  (if (map? lowering)
    (if (= (set (keys lowering))
           #{:artifact :schema-version :status :request
             :bounded-lowering-payload :eligibility
             :abi-layout :runtime-provider :proof-target-metadata
             :dependency-provenance :diagnostics :semantic-authority
             :execution-tcb :clojure-seed-boundary? :whole-c14?
             :self-hosted? :source-rule :actual-path-provenance
             :semantic-id :artifact-id :actual-path-binding-id})
      (if (= [(get lowering :artifact) (get lowering :schema-version)
              (get lowering :status) (get lowering :diagnostics)
              (get lowering :semantic-authority)
              (get lowering :execution-tcb)
              (get lowering :clojure-seed-boundary?)
              (get lowering :whole-c14?)
              (get lowering :self-hosted?)]
             [:gravity/c14-bounded-c-lowering-record 1 :accepted []
              :gravity-source :clojure-stage0-rule-runner true false false])
        (if (b1-sha256-id? (get lowering :semantic-id))
          (if (b1-sha256-id? (get lowering :artifact-id))
            (if (b1-sha256-id? (get lowering :actual-path-binding-id))
              (if (b1-c14-c-source-rule-valid? (get lowering :source-rule))
                (if (map? (get lowering :actual-path-provenance))
                  (if (= (set (keys (get lowering
                                         :actual-path-provenance)))
                         #{:source :c11-source :c13-source :c14-source})
                    (if (b1-bounded-c14-c-request-valid?
                         (get lowering :request))
                      (if (b1-bounded-c14-c-eligibility-valid?
                           (get lowering :eligibility))
                        (if (= (get (get lowering :request) :target)
                               (get (get lowering :eligibility) :target))
                          (if (= (get (get lowering :request) :providers)
                                 (get (get lowering :eligibility)
                                      :required-providers))
                            (if (b1-c14-projected-records-valid? lowering)
                              (b1-c14-c-payload-valid? lowering)
                              false)
                            false)
                          false)
                        false)
                      false)
                    false)
                  false)
                false)
              false)
            false)
          false)
        false)
      false)
    false))

(defn b1-bounded-c-manifest-valid?
  [backend-manifest]
  (if (map? backend-manifest)
    (if (= (set (keys backend-manifest))
           #{:artifact :backend :version :accepts :emits :requires
             :supports-profiles :rejects :dialect :c14-request-id
             :c14-artifact-id})
      (if (= [(get backend-manifest :artifact)
              (get backend-manifest :backend)
              (get backend-manifest :version)
              (get backend-manifest :accepts)
              (get backend-manifest :emits)
              (get backend-manifest :requires)
              (get backend-manifest :supports-profiles)
              (get backend-manifest :rejects)
              (get backend-manifest :dialect)]
             [:gravity/backend-manifest
              :gravity.backend/c
              :bounded-authenticated-c17-v1
              [:gravity/mir]
              [:c-source :c-header]
              [:profile-manifest :target-manifest :c-dialect-selection
               :abi-policy :runtime-provider-selection :effect-summary
               :capability-proof-summary :safety-bundle :proof-table
               :source-map :dependency-graph]
              [:hosted]
              [:unverified-ir :unsupported-op :missing-proof
               :implicit-ub :ambient-capability :profile-violation
               :dialect-mismatch]
              :c17])
        (if (b1-sha256-id? (get backend-manifest :c14-request-id))
          (b1-sha256-id? (get backend-manifest :c14-artifact-id))
          false)
        false)
      false)
    false))

(defn b1-build-bounded-c-authenticated-packet
  [lowering backend-manifest]
  (if (b1-bounded-c14-c-input-valid? lowering)
    (if (b1-bounded-c-manifest-valid? backend-manifest)
      (if (= (get backend-manifest :c14-request-id)
             (get (get lowering :request) :request-id))
        (if (= (get backend-manifest :c14-artifact-id)
               (get lowering :artifact-id))
          (let [request (get lowering :request)]
            {:artifact :gravity/b1-verified-backend-input-packet
             :schema-version 1
             :status :accepted-for-bounded-c
             :input (get request :input)
             :bounded-lowering-payload
             (get lowering :bounded-lowering-payload)
             :profile (get request :profile-contract)
             :target (get request :target)
             :source-target-selection (get request :source-target-selection)
             :dialect :c17
             :abi (get request :abi)
             :runtime (get request :runtime)
             :providers (get request :providers)
             :effects (get request :effects)
             :capabilities (get request :capabilities)
             :safety (get request :safety)
             :proofs (get request :proofs)
             :proof-to-target-metadata
             (get request :proof-to-target-metadata)
             :source-map (get request :source-map)
             :dependencies (get request :dependency-provenance)
             :contract-bindings (get request :contract-bindings)
             :c14-eligibility (get lowering :eligibility)
             :eligibility
             {:artifact :gravity/b1-backend-eligibility-report
              :backend :gravity.backend/c
              :input-artifact (get (get request :input) :artifact-id)
              :profile (get request :profile)
              :target (get request :target)
              :accepted? true
              :rejections []
              :fallbacks []
              :missing-evidence []
              :unsupported-operations []
              :remediation []
              :checks [:profile-backend-compatibility
                       :target-feature-support
                       :runtime-availability-or-no-runtime-proof
                       :abi-representability :layout-representability
                       :provider-availability :effect-preservation
                       :capability-preservation
                       :safety-bundle-completeness
                       :proof-validity-for-target-assumptions
                       :source-debug-map-preservation
                       :c17-dialect-closure]}
             :backend-manifest backend-manifest
             :unsupported-feature-report
             {:status :bounded-surface-only
              :policy
              (get (get request :unsupported-feature-report) :policy)
              :diagnostic "B1-UNSUPPORTED"
              :fallback-status :rejected}
             :diagnostics []
             :semantic-authority :gravity-source
             :execution-tcb :clojure-stage0-rule-runner
             :clojure-seed-boundary? true
             :whole-b1? false
             :whole-b2? false
             :self-hosted? false})
          {:artifact :gravity/b1-verified-backend-input-packet
           :schema-version 1
           :status :rejected
           :diagnostic "B1-INPUT"
           :missing-fact :c14-artifact-manifest-binding
           :diagnostics ["B1-INPUT"]})
        {:artifact :gravity/b1-verified-backend-input-packet
         :schema-version 1
         :status :rejected
         :diagnostic "B1-INPUT"
         :missing-fact :c14-request-manifest-binding
         :diagnostics ["B1-INPUT"]})
      {:artifact :gravity/b1-verified-backend-input-packet
       :schema-version 1
       :status :rejected
       :diagnostic "B1-TARGET"
       :missing-fact :exact-hosted-c17-backend-manifest
       :diagnostics ["B1-TARGET"]})
    {:artifact :gravity/b1-verified-backend-input-packet
     :schema-version 1
     :status :rejected
     :diagnostic "B1-INPUT"
     :missing-fact :accepted-c14-c-lowering-record
     :diagnostics ["B1-INPUT"]}))

(defn b1-wasm-content-bindings-valid?
  [remaining bindings]
  (if (= (count remaining) 0)
    true
    (if (b1-content-binding-valid? (get bindings (first remaining)))
      (b1-wasm-content-bindings-valid? (rest remaining) bindings)
      false)))

(defn b1-c14-wasm-target-valid?
  [target]
  (= target
     {:request :wasm
      :triple "wasm32-unknown-unknown"
      :architecture :wasm32
      :object-format :webassembly
      :backend :gravity.backend/wasm
      :target-kind :core-module
      :memory-width :wasm32
      :features #{}
      :imports []
      :runtime-helpers []
      :profile-eligibility [:hosted]
      :tier :experimental
      :exposure :internal
      :source-declaration-target :jvm
      :requested-lowering-target :wasm
      :selection :explicit-bootstrap-seed-target-override
      :reason :checked-core-seed-contract
      :direct-source-declared-wasm? false}))

(defn b1-c14-wasm-contract-bindings-valid?
  [request]
  (let [bindings (get request :contract-bindings)
        safety (get request :safety)
        proofs (get request :proofs)
        source-map (get request :source-map)]
    (if (map? bindings)
      (if (= (set (keys bindings))
             #{:profile :target :abi :runtime :providers :effects
               :capabilities :type :ownership :safety :proofs
               :source-map :dependencies :c11-verifier
               :c13-optimization})
        (if (b1-wasm-content-bindings-valid?
             [:profile :target :abi :runtime :providers :effects
              :capabilities :type :ownership :safety :proofs
              :source-map :dependencies :c11-verifier :c13-optimization]
             bindings)
          (if (= [(get bindings :profile)
                  (get bindings :target)
                  (get bindings :abi)
                  (get bindings :runtime)
                  (get bindings :providers)]
                 [{:content-id
                   "sha256:9adfa444f9f2790518c7a0d55bd1ecf97f117c723a8c82e1ee37c08d2eed2082"
                   :entry-count 2}
                  {:content-id
                   "sha256:829a8b18ab8fae4be3af1d01d73c2ce602172448aa393e5093e4dd4c54dbe2c4"
                   :entry-count 18}
                  {:content-id
                   "sha256:7a0eb1c4e55c3858d7232226cf8e7603a0e21a3ae76f138c21c996a12afc6432"
                   :entry-count 8}
                  {:content-id
                   "sha256:c2e9efb295d12d298aa8a7550f2826c622d9d566fbce43f1f04e40727e74ae97"
                   :entry-count 4}
                  {:content-id
                   "sha256:4f53cda18c2baa0c0354bb5f9a3ecbe5ed12ab4d8e11ba873c2f11161202b945"
                   :entry-count 0}])
            (if (= [(get (get bindings :effects) :entry-count)
                    (get (get bindings :capabilities) :entry-count)
                    (get (get bindings :proofs) :entry-count)
                    (get (get bindings :dependencies) :entry-count)
                    (get (get bindings :c11-verifier) :entry-count)
                    (get (get bindings :c13-optimization) :entry-count)]
                   [2 3 2 6 1 4])
              (if (= (get bindings :safety) (get safety :binding))
                (if (= (get (get bindings :proofs) :entry-count)
                       (count proofs))
                  (if (= (get (get bindings :proofs) :content-id)
                         (get (get proofs :certificates) :content-id))
                    false
                    (if (= (get (get bindings :proofs) :content-id)
                           (get (get proofs :capability) :content-id))
                      false
                      (if (= (get (get bindings :source-map) :content-id)
                             (get source-map :id))
                        (= (get (get bindings :c11-verifier) :content-id)
                           (get (get request :input) :verifier-report-id))
                        false)))
                  false)
                false)
              false)
            false)
          false)
        false)
      false)))

(defn b1-c14-wasm-dependencies-valid?
  [request]
  (let [dependencies (get request :dependency-provenance)
        input (get request :input)]
    (if (map? dependencies)
      (if (= (set (keys dependencies))
             #{:source-core :c11-source-rule :c11-pass
               :c13-artifact :c13-source-rule :backend-contract})
        (if (b1-sha256-id? (get dependencies :source-core))
          (if (b1-c11-source-rule-valid?
               (get dependencies :c11-source-rule))
            (if (b1-sha256-id? (get dependencies :c11-pass))
              (if (= (get dependencies :c13-artifact)
                     (get input :artifact-id))
                (if (b1-c13-source-rule-valid?
                     (get dependencies :c13-source-rule))
                  (if (= (get dependencies :source-core)
                         (get (get (get (get input :verifier-report)
                                            :b1-preflight)
                                   :binding)
                              :checked-core-artifact-id))
                    (if (= (get dependencies :c11-pass)
                           (get (get (get (get input :verifier-report)
                                              :b1-preflight)
                                     :binding)
                                :pass-execution-record-id))
                      (= (get dependencies :backend-contract)
                         :gravity.backend/b4-bounded-wasm32-core-v1)
                      false)
                    false)
                  false)
                false)
              false)
            false)
          false)
        false)
      false)))

(defn b1-bounded-c14-wasm-request-valid?
  [request]
  (if (map? request)
    (if (= (set (keys request))
           #{:artifact :schema-version :status :input :request-id
             :profile :profile-contract :target :source-target-selection
             :abi :runtime :providers :effects :capabilities :safety
             :proofs :contract-bindings :required-evidence :source-map
             :dependency-provenance :c13-optimization-status
             :domain-ir-status :fusion-status :target-policy
             :proof-to-target-metadata :unsupported-feature-report
             :diagnostics})
      (if (= [(get request :artifact) (get request :schema-version)
              (get request :status) (get request :profile)
              (get request :profile-contract) (get request :effects)
              (get request :capabilities)
              (get request :c13-optimization-status)
              (get request :domain-ir-status) (get request :fusion-status)
              (get request :diagnostics)]
             [:gravity/c14-internal-target-lowering-request 1 :accepted
              :hosted {:name :hosted :validated? true} #{} #{}
              :identity-pass-complete :not-applicable :not-run []])
        (if (b1-sha256-id? (get request :request-id))
          (if (b1-c14-c-input-valid? (get request :input))
            (if (b1-c14-wasm-target-valid? (get request :target))
              (if (= (get request :source-target-selection)
                     {:source-declaration-target :jvm
                      :requested-lowering-target :wasm
                      :selection :explicit-bootstrap-seed-target-override
                      :reason :checked-core-seed-contract
                      :direct-source-declared-wasm? false})
                (if (= (get request :abi)
                       {:calling-convention :wasm-core
                        :parameters [] :result :i32
                        :integer-representation :signed-i32
                        :boolean-representation :i32-0-or-1
                        :nil-representation :i32-zero
                        :memory-model :none :multi-value? false})
                  (if (= (get request :runtime)
                         {:runtime :none :helpers [] :imports []
                          :hidden-services? false})
                    (if (= (get request :providers) [])
                      (if (b1-c14-safety-valid? (get request :safety))
                        (if (= [(get (get request :safety) :outcomes)
                                (get (get request :safety) :runtime-checks)]
                               [(get (get (get (get request :input)
                                               :verifier-report)
                                          :independent-verifier)
                                     :operation-count)
                                (get (get (get (get (get request :input)
                                                         :verifier-report)
                                                :independent-verifier)
                                           :runtime-checks)
                                     :runtime-check-count)])
                          (if (b1-c14-proofs-valid? (get request :proofs))
                            (if (b1-c14-wasm-contract-bindings-valid? request)
                              (if (= (get request :required-evidence)
                                     [:authenticated-c11-replay
                                      :independent-lowering-reconstruction
                                      :gravity-b4-byte-reconstruction
                                      :independent-raw-module-parser
                                      :pinned-node-differential-result
                                      :content-hash-and-provenance])
                                (if (= (get request :source-map)
                                       {:id (get (get request :source-map) :id)
                                        :preserved? true})
                                  (if (b1-sha256-id?
                                       (get (get request :source-map) :id))
                                    (if (b1-c14-wasm-dependencies-valid? request)
                                      (if (= (get request :target-policy)
                                             {:scope
                                              :bounded-pure-scalar-forwarding-do-let-if-integer-comparisons
                                              :maximum-operation-count 127
                                              :target-kind :core-module
                                              :whole-c14? false
                                              :whole-b1? false
                                              :whole-b4? false
                                              :public? false :release? false
                                              :self-hosted? false})
                                        (if (= (get request
                                                    :proof-to-target-metadata)
                                               {:entries []
                                                :proofless-metadata-rejected?
                                                true})
                                          (= (get request
                                                  :unsupported-feature-report)
                                             {:status :bounded-surface-only
                                              :policy
                                              [:strings :quote :str :println
                                               :runtime-checks :effects
                                               :program-capabilities
                                               :domain-anchors
                                               :multiple-functions
                                               :multiple-conditionals
                                               :non-scalar-types
                                               :integer-outside-signed-i32
                                               :imports :memory :tables
                                               :globals :components :wit
                                               :wasi :simd :atomics]
                                              :diagnostic "C14-UNSUPPORTED"
                                              :fallback-status :rejected})
                                          false)
                                        false)
                                      false)
                                    false)
                                  false)
                                false)
                              false)
                            false)
                          false)
                        false)
                      false)
                    false)
                  false)
                false)
              false)
            false)
          false)
        false)
      false)
    false))

(defn b1-bounded-c14-wasm-eligibility-valid?
  [eligibility]
  (if (map? eligibility)
    (if (= (set (keys eligibility))
           #{:artifact :backend :profile :target :accepted? :rejections
             :fallbacks :missing-features :required-providers
             :proof-assumptions :explainability-record :checks})
      (if (= [(get eligibility :artifact) (get eligibility :backend)
              (get eligibility :profile) (get eligibility :accepted?)
              (get eligibility :rejections) (get eligibility :fallbacks)
              (get eligibility :missing-features)
              (get eligibility :required-providers)
              (get eligibility :proof-assumptions)
              (get eligibility :explainability-record)
              (get eligibility :checks)]
             [:gravity/c14-target-eligibility-report
              :gravity.backend/wasm :hosted true [] [] [] [] []
              {:decision :accepted
               :bounded-surface
               :pure-scalar-forwarding-do-let-if-integer-comparisons
               :unsupported-diagnostic "C14-UNSUPPORTED"
               :no-hidden-runtime? true
               :no-hidden-effect-or-capability? true}
              [:profile-allows-backend
               :target-supports-required-mir-families
               :runtime-services-explicit :abi-represents-exports
               :effects-have-authority-preserving-providers
               :proof-assumptions-valid-for-target]])
        (b1-c14-wasm-target-valid? (get eligibility :target))
        false)
      false)
    false))

(defn b1-c14-wasm-source-rule-valid?
  [rule]
  (if (map? rule)
    (if (= (set (keys rule))
           #{:artifact :owner :source-content-hash :source-byte-count
             :plan-semantic-hash :functions-semantic-hash
             :builder-function :builder-semantic-hash :function-shapes
             :semantic-authority :compiled-by :executed-by :self-hosted?})
      (= [(get rule :artifact) (get rule :owner)
          (get rule :source-byte-count) (get rule :source-content-hash)
          (get rule :plan-semantic-hash)
          (get rule :functions-semantic-hash)
          (get rule :builder-function) (get rule :builder-semantic-hash)
          (get rule :function-shapes) (get rule :semantic-authority)
          (get rule :compiled-by) (get rule :executed-by)
          (get rule :self-hosted?)]
         [:gravity/pinned-gravity-source-rule
          :gravity.compiler/c14-target-lowering 168303
          "sha256:f433e27eab7f58f50ea8c57b9a60c3046796f9f484d59f9534ec72921b33c126"
          "sha256:7ee55da35e45ae726c322dd52e739bea67c3ff3e6c9fb1644d3f1b6b38d1c94f"
          "sha256:c43facf8fc5b644209554093d1d2f23992eac5f403de8ad2c94ee92cb8809f93"
          'c14-build-bounded-wasm-lowering-record
          "sha256:fe20574f102acb55063e64223715adf2e2fa40a25e9e147616ee554f9989b3fa"
          '{c14-bounded-optimized-input-valid?
            {:arity 2 :params [optimized policy]}
            c14-wasm-target-valid? {:arity 1 :params [target]}
            c14-wasm-bounded-mir-surface-valid?
            {:arity 2 :params [optimized policy]}
            c14-wasm-dependencies-valid?
            {:arity 2 :params [optimized dependencies]}
            c14-wasm-contract-bindings-match?
            {:arity 2 :params [optimized policy]}
            c14-wasm-policy-evidence-valid?
            {:arity 2 :params [optimized policy]}
            c14-wasm-policy-valid? {:arity 2 :params [optimized policy]}
            c14-wasm-first-invalid-constant
            {:arity 1 :params [operations]}
            c14-build-bounded-wasm-lowering-record
            {:arity 2 :params [optimized policy]}}
          :gravity-source :clojure-stage0-seed
          :clojure-stage0-rule-runner false])
      false)
    false))

(defn b1-c14-wasm-payload-valid?
  [lowering]
  (let [payload (get lowering :bounded-lowering-payload)
        request (get lowering :request)
        input (get request :input)
        mir (get payload :mir)
        facts (get payload :fact-bindings)
        bindings (get request :contract-bindings)
        dependencies (get request :dependency-provenance)
        operation-order (b1-c14-c-bounded-operation-order mir)]
    (if (map? payload)
      (if (= (set (keys payload))
             #{:artifact :c11-artifact-id :c13-artifact-id
               :c13-semantic-id :mir :operation-order :fact-bindings})
        (if (= [(get payload :artifact)
                (get payload :c11-artifact-id)
                (get payload :c13-artifact-id)
                (get payload :c13-semantic-id)]
               [:gravity/c14-bounded-wasm-lowering-payload
                (get input :c11-artifact-id)
                (get input :artifact-id)
                (get input :id)])
          (if (map? mir)
            (if (= [(get mir :artifact) (get mir :schema-version)
                    (get mir :profile) (get mir :source-target)
                    (get mir :target-request)
                    (get mir :verification-status)
                    (get mir :target-independent?)]
                   [:gravity/mir-module 1 :hosted :jvm :wasm :passed true])
              (if (= (get payload :operation-order) operation-order)
                (if (> (count operation-order) 0)
                  (if (<= (count operation-order) 127)
                    (if (= (count operation-order) (count (set operation-order)))
                      (if (map? facts)
                        (if (= (set (keys facts))
                               #{:type :effect :ownership :capability :safety
                                 :runtime-checks :proofs :source-map})
                          (if (b1-wasm-content-bindings-valid?
                               [:type :effect :ownership :capability :safety
                                :runtime-checks :proofs :source-map]
                               facts)
                            (if (= (get facts :runtime-checks)
                                   {:content-id
                                    "sha256:44136fa355b3678a1146ad16f7e8649e94fb4fc21fe77e8310c060f61caaff8a"
                                    :entry-count 0})
                              (if (b1-c14-c-fact-binding-counts-valid? mir facts)
                                (if (b1-c14-c-fact-projections-valid?
                                     mir request facts)
                                  (if (b1-c14-c-contract-preimages-valid?
                                       mir request)
                                    (if (= [(get facts :type)
                                            (get facts :ownership)
                                            (get facts :safety)
                                            (get facts :source-map)]
                                           [(get bindings :type)
                                            (get bindings :ownership)
                                            (get bindings :safety)
                                            (get bindings :source-map)])
                                      (if (= (get mir :source-core)
                                             (get dependencies :source-core)
                                             (get (get (get (get input
                                                                   :verifier-report)
                                                          :b1-preflight)
                                                     :binding)
                                                :checked-core-artifact-id))
                                        (if (= (get mir :b1-preflight)
                                               (get (get input :verifier-report)
                                                    :b1-preflight))
                                          (= (get (get mir
                                                       :pass-execution-record)
                                                  :record-id)
                                             (get dependencies :c11-pass))
                                          false)
                                        false)
                                      false)
                                    false)
                                  false)
                                false)
                              false)
                            false)
                          false)
                        false)
                      false)
                    false)
                  false)
                false)
              false)
            false)
          false)
        false)
      false)))

(defn b1-bounded-c14-wasm-input-valid?
  [lowering]
  (if (map? lowering)
    (if (= (set (keys lowering))
           #{:artifact :schema-version :status :request
             :bounded-lowering-payload :eligibility
             :abi-layout :runtime-provider :proof-target-metadata
             :dependency-provenance :diagnostics :semantic-authority
             :execution-tcb :clojure-seed-boundary? :self-hosted?
             :source-rule :actual-path-provenance :semantic-id
             :artifact-id :actual-path-binding-id})
      (if (= [(get lowering :artifact) (get lowering :schema-version)
              (get lowering :status) (get lowering :diagnostics)
              (get lowering :semantic-authority)
              (get lowering :execution-tcb)
              (get lowering :clojure-seed-boundary?)
              (get lowering :self-hosted?)]
             [:gravity/c14-bounded-wasm-lowering-record 1 :accepted []
              :gravity-source :clojure-stage0-rule-runner true false])
        (if (b1-sha256-id? (get lowering :semantic-id))
          (if (b1-sha256-id? (get lowering :artifact-id))
            (if (b1-sha256-id? (get lowering :actual-path-binding-id))
              (if (b1-c14-wasm-source-rule-valid?
                   (get lowering :source-rule))
                (if (map? (get lowering :actual-path-provenance))
                  (if (= (set (keys (get lowering :actual-path-provenance)))
                         #{:source :c11-source :c13-source :c14-source})
                    (if (b1-bounded-c14-wasm-request-valid?
                         (get lowering :request))
                      (if (b1-bounded-c14-wasm-eligibility-valid?
                           (get lowering :eligibility))
                        (if (= (get (get lowering :request) :target)
                               (get (get lowering :eligibility) :target))
                          (if (= (get (get lowering :request) :providers)
                                 (get (get lowering :eligibility)
                                      :required-providers))
                            (if (b1-c14-projected-records-valid? lowering)
                              (b1-c14-wasm-payload-valid? lowering)
                              false)
                            false)
                          false)
                        false)
                      false)
                    false)
                  false)
                false)
              false)
            false)
          false)
        false)
      false)
    false))

(defn b1-bounded-wasm-manifest-valid?
  [backend-manifest]
  (if (map? backend-manifest)
    (if (= (set (keys backend-manifest))
           #{:artifact :backend :version :accepts :emits :requires
             :supports-profiles :rejects :target-kind :memory-width
             :features :imports :runtime-helpers
             :c14-request-id :c14-artifact-id})
      (if (= [(get backend-manifest :artifact)
              (get backend-manifest :backend)
              (get backend-manifest :version)
              (get backend-manifest :accepts)
              (get backend-manifest :emits)
              (get backend-manifest :requires)
              (get backend-manifest :supports-profiles)
              (get backend-manifest :rejects)
              (get backend-manifest :target-kind)
              (get backend-manifest :memory-width)
              (get backend-manifest :features)
              (get backend-manifest :imports)
              (get backend-manifest :runtime-helpers)]
             [:gravity/backend-manifest
              :gravity.backend/wasm
              :bounded-authenticated-wasm32-core-v1
              [:gravity/mir]
              [:wasm-core-module]
              [:profile-manifest :target-manifest :wasm-feature-policy
               :abi-policy :runtime-provider-selection :effect-summary
               :capability-proof-summary :safety-bundle :proof-table
               :source-map :dependency-graph]
              [:hosted]
              [:unverified-ir :unsupported-op :missing-proof
               :implicit-ub :ambient-capability :profile-violation
               :unsupported-wasm-feature]
              :core-module :wasm32 #{} [] []])
        (if (b1-sha256-id? (get backend-manifest :c14-request-id))
          (b1-sha256-id? (get backend-manifest :c14-artifact-id))
          false)
        false)
      false)
    false))

(defn b1-build-bounded-wasm-authenticated-packet
  [lowering backend-manifest]
  (if (b1-bounded-c14-wasm-input-valid? lowering)
    (if (b1-bounded-wasm-manifest-valid? backend-manifest)
      (if (= (get backend-manifest :c14-request-id)
             (get (get lowering :request) :request-id))
        (if (= (get backend-manifest :c14-artifact-id)
               (get lowering :artifact-id))
          (let [request (get lowering :request)]
            {:artifact :gravity/b1-verified-backend-input-packet
             :schema-version 1
             :status :accepted-for-bounded-wasm
             :input (get request :input)
             :bounded-lowering-payload
             (get lowering :bounded-lowering-payload)
             :profile (get request :profile-contract)
             :target (get request :target)
             :source-target-selection
             (get request :source-target-selection)
             :target-kind :core-module
             :memory-width :wasm32
             :features #{}
             :abi (get request :abi)
             :runtime (get request :runtime)
             :providers (get request :providers)
             :effects (get request :effects)
             :capabilities (get request :capabilities)
             :safety (get request :safety)
             :proofs (get request :proofs)
             :proof-to-target-metadata
             (get request :proof-to-target-metadata)
             :source-map (get request :source-map)
             :dependencies (get request :dependency-provenance)
             :contract-bindings (get request :contract-bindings)
             :c14-eligibility (get lowering :eligibility)
             :eligibility
             {:artifact :gravity/b1-backend-eligibility-report
              :backend :gravity.backend/wasm
              :input-artifact (get (get request :input) :artifact-id)
              :profile (get request :profile)
              :target (get request :target)
              :accepted? true :rejections [] :fallbacks []
              :missing-evidence [] :unsupported-operations []
              :remediation []
              :checks
              [:profile-backend-compatibility
               :target-feature-support
               :runtime-availability-or-no-runtime-proof
               :abi-representability :layout-representability
               :provider-availability :effect-preservation
               :capability-preservation :safety-bundle-completeness
               :proof-validity-for-target-assumptions
               :source-debug-map-preservation
               :wasm32-core-module-closure]}
             :backend-manifest backend-manifest
             :unsupported-feature-report
             {:status :bounded-surface-only
              :policy
              (get (get request :unsupported-feature-report) :policy)
              :diagnostic "B1-UNSUPPORTED"
              :fallback-status :rejected}
             :diagnostics []
             :semantic-authority :gravity-source
             :execution-tcb :clojure-stage0-rule-runner
             :clojure-seed-boundary? true
             :whole-b1? false :whole-b4? false :self-hosted? false})
          {:artifact :gravity/b1-verified-backend-input-packet
           :schema-version 1 :status :rejected
           :diagnostic "B1-INPUT"
           :missing-fact :c14-artifact-manifest-binding
           :diagnostics ["B1-INPUT"]})
        {:artifact :gravity/b1-verified-backend-input-packet
         :schema-version 1 :status :rejected
         :diagnostic "B1-INPUT"
         :missing-fact :c14-request-manifest-binding
         :diagnostics ["B1-INPUT"]})
      {:artifact :gravity/b1-verified-backend-input-packet
       :schema-version 1 :status :rejected
       :diagnostic "B1-TARGET"
       :missing-fact :exact-hosted-wasm32-core-backend-manifest
       :diagnostics ["B1-TARGET"]})
    {:artifact :gravity/b1-verified-backend-input-packet
     :schema-version 1 :status :rejected
     :diagnostic "B1-INPUT"
     :missing-fact :accepted-c14-wasm-lowering-record
     :diagnostics ["B1-INPUT"]}))

                     (get input :artifact-id))
                (if (b1-c13-source-rule-valid?
                     (get dependencies :c13-source-rule))
                  (if (= (get dependencies :source-core)
                         (get (get (get (get input :verifier-report)
                                            :b1-preflight)
                                   :binding)
                              :checked-core-artifact-id))
                    (if (= (get dependencies :c11-pass)
                           (get (get (get (get input :verifier-report)
                                              :b1-preflight)
                                     :binding)
                                :pass-execution-record-id))
                      (= (get dependencies :b3-source)
                         "sha256:4761712a845753d23f1bac381b38b8f59515dded1b75183d1f317567d173c6b3")
                      false)
                    false)
                  false)
                false)
              false)
            false)
          false)
        false)
      false)))

(defn b1-bounded-c14-request-valid?
  [request]
  (if (map? request)

(defn b4-proof-record-valid?
  [proofs fact-bindings bindings mir]
  (if (map? proofs)
    (if (= (set (keys proofs)) #{:capability :certificates})
      (let [capability (get proofs :capability)
            certificates (get proofs :certificates)
            proof-binding (get bindings :proofs)
            capability-table (get mir :capability-proof-table)
            proof-table (get mir :proof-certificate-table)
            safety-proofs (get proof-table :safety-proofs)]
        (if (map? capability)
          (if (map? certificates)
            (if (if (map? capability-table)
                  (if (map? proof-table)
                    (if (map? safety-proofs)
                      (= (set (keys capability))
                         #{:content-id :entry-count :proof-ids})
                      false)
                    false)
                  false)
              (if (= (set (keys certificates))
                     #{:content-id :entry-count :safety-proof-count
                       :safety-proof-ids})
                (if (b4-sha256-id? (get capability :content-id))
                  (if (b4-sha256-id? (get certificates :content-id))
                    (if (= [(get capability :content-id)
                            (get capability :entry-count)
                            (get capability :proof-ids)
                            (get certificates :entry-count)
                            (get certificates :safety-proof-count)
                            (get certificates :safety-proof-ids)
                            (get proof-binding :entry-count)]
                           ["sha256:44136fa355b3678a1146ad16f7e8649e94fb4fc21fe77e8310c060f61caaff8a"
                            (count capability-table)
                            (vec (sort-by-pr-str (keys capability-table)))
                            (count proof-table)
                            (count safety-proofs)
                            (vec (sort-by-pr-str (keys safety-proofs)))
                            (count proofs)])
                      (if (= (get certificates :content-id)
                             (get (get fact-bindings :proofs) :content-id))
                        (if (= (get proof-binding :content-id)
                               (get certificates :content-id))
                          false
                          (if (= (get proof-binding :content-id)
                                 (get capability :content-id))
                            false
                            true))
                        false)
                      false)
                    false)
                  false)
                false)
              false)
            false)
          false))
      false)
    false))

(defn b4-fact-bindings-valid?
  [packet mir fact-bindings bindings]
  (if (map? fact-bindings)
    (if (= (set (keys fact-bindings))
           #{:type :effect :ownership :capability :safety
             :runtime-checks :proofs :source-map})
      (if (if (= [(map? (get mir :type-table))
                  (map? (get mir :effect-table))
                  (map? (get mir :ownership-table))
                  (map? (get mir :capability-table))
                  (map? (get mir :safety-table))
                  (map? (get mir :runtime-check-table))
                  (map? (get mir :capability-proof-table))
                  (map? (get mir :proof-certificate-table))
                  (map? (get mir :source-map))]
                 [true true true true true true true true true])
            (b4-content-bindings-valid?
             [:type :effect :ownership :capability :safety
              :runtime-checks :proofs :source-map]
             fact-bindings)
            false)
        (if (= [(get (get fact-bindings :type) :entry-count)
                (get (get fact-bindings :effect) :entry-count)
                (get (get fact-bindings :ownership) :entry-count)
                (get (get fact-bindings :capability) :entry-count)
                (get (get fact-bindings :safety) :entry-count)
                (get (get fact-bindings :runtime-checks) :entry-count)
                (get (get fact-bindings :proofs) :entry-count)
                (get (get fact-bindings :source-map) :entry-count)]
               [(count (get mir :type-table))
                (count (get mir :effect-table))
                (count (get mir :ownership-table))
                (count (get mir :capability-table))
                (count (get mir :safety-table))
                (count (get mir :runtime-check-table))
                (count (get mir :proof-certificate-table))
                (count (get mir :source-map))])
          (if (= [(get fact-bindings :type)
                  (get fact-bindings :ownership)
                  (get fact-bindings :safety)
                  (get fact-bindings :source-map)]
                 [(get bindings :type)
                  (get bindings :ownership)
                  (get bindings :safety)
                  (get bindings :source-map)])
            (if (= (get fact-bindings :runtime-checks)
                   {:content-id
                    "sha256:44136fa355b3678a1146ad16f7e8649e94fb4fc21fe77e8310c060f61caaff8a"
                    :entry-count 0})
              (if (= (get packet :source-map)
                     {:id
                      (get (get fact-bindings :source-map) :content-id)
                      :preserved? true})
                (if (= (get packet :safety)
                       {:outcomes (count (get mir :safety-table))
                        :runtime-checks 0
                        :unsafe-islands 0
                        :binding (get fact-bindings :safety)})
                  (b4-proof-record-valid?
                   (get packet :proofs) fact-bindings bindings mir)
                  false)
                false)
              false)
            false)
          false)
        false)
      false)
    false))

(defn b4-dependencies-valid?
  [dependencies input mir]
  (let [verifier (get input :verifier-report)
        preflight (get verifier :b1-preflight)
        binding (get preflight :binding)]
    (if (map? dependencies)
      (if (= (set (keys dependencies))
             #{:source-core :c11-source-rule :c11-pass
               :c13-artifact :c13-source-rule :backend-contract})
        (if (= (get dependencies :source-core)
               (get mir :source-core)
               (get binding :checked-core-artifact-id))
          (if (= (get dependencies :c11-pass)
                 (get (get mir :pass-execution-record) :record-id)
                 (get binding :pass-execution-record-id))
            (if (= (get dependencies :c13-artifact)
                   (get input :artifact-id))
              (if (b4-c11-source-rule-valid?
                   (get dependencies :c11-source-rule))
                (if (b4-c13-source-rule-valid?
                     (get dependencies :c13-source-rule))
                  (= (get dependencies :backend-contract)
                     :gravity.backend/b4-bounded-wasm32-core-v1)
                  false)
                false)
              false)
            false)
          false)
        false)
      false)))

(defn b4-b1-nested-carriers-valid?
  [packet]
  (let [input (get packet :input)
        payload (get packet :bounded-lowering-payload)]
    (if (map? input)
      (if (map? payload)
        (if (map? (get input :optimization-report))
          (if (map? (get payload :fact-bindings))
            (if (map? (get packet :contract-bindings))
              (if (map? (get packet :backend-manifest))
                (if (map? (get packet :c14-eligibility))
                  (if (map? (get packet :eligibility))
                    (if (map? (get packet :unsupported-feature-report))
                      (if (map? (get packet :dependencies)) true false)
                      false)
                    false)
                  false)
                false)
              false)
            false)
          false)
        false)
      false)))

(defn b4-b1-static-report-projections-valid?
  [packet]
  (= [(get (get packet :c14-eligibility) :explainability-record)
      (get (get packet :c14-eligibility) :checks)
      (get (get packet :eligibility) :checks)
      (get (get packet :unsupported-feature-report) :policy)]
     [{:decision :accepted
       :bounded-surface
       :pure-scalar-forwarding-do-let-if-integer-comparisons
       :unsupported-diagnostic "C14-UNSUPPORTED"
       :no-hidden-runtime? true
       :no-hidden-effect-or-capability? true}
      [:profile-allows-backend
       :target-supports-required-mir-families
       :runtime-services-explicit
       :abi-represents-exports
       :effects-have-authority-preserving-providers
       :proof-assumptions-valid-for-target]
      [:profile-backend-compatibility
       :target-feature-support
       :runtime-availability-or-no-runtime-proof
       :abi-representability
       :layout-representability
       :provider-availability
       :effect-preservation
       :capability-preservation
       :safety-bundle-completeness
       :proof-validity-for-target-assumptions
       :source-debug-map-preservation
       :wasm32-core-module-closure]
      [:strings :quote :str :println :runtime-checks :effects
       :program-capabilities :domain-anchors :multiple-functions
       :multiple-conditionals :non-scalar-types
       :integer-outside-signed-i32 :imports :memory :tables :globals
       :components :wit :wasi :simd :atomics]]))

(defn b4-b1-static-contract-valid?
  [packet]
  (if (b4-b1-nested-carriers-valid? packet)
   (if (= (get packet :profile) {:name :hosted :validated? true})
    (if (= (get packet :target)
           {:request :wasm
            :triple "wasm32-unknown-unknown"
            :architecture :wasm32
            :object-format :webassembly
            :backend :gravity.backend/wasm
            :target-kind :core-module
            :memory-width :wasm32
            :features #{}
            :imports []
            :runtime-helpers []
            :profile-eligibility [:hosted]
            :tier :experimental
            :exposure :internal
            :source-declaration-target :jvm
            :requested-lowering-target :wasm
            :selection :explicit-bootstrap-seed-target-override
            :reason :checked-core-seed-contract
            :direct-source-declared-wasm? false})
      (if (= (get packet :source-target-selection)
             {:source-declaration-target :jvm
              :requested-lowering-target :wasm
              :selection :explicit-bootstrap-seed-target-override
              :reason :checked-core-seed-contract
              :direct-source-declared-wasm? false})
        (if (= [(get packet :target-kind)
                (get packet :memory-width)
                (get packet :features)
                (get packet :abi)
                (get packet :runtime)
                (get packet :providers)
                (get packet :effects)
                (get packet :capabilities)
                (get packet :proof-to-target-metadata)]
               [:core-module
                :wasm32
                #{}
                {:calling-convention :wasm-core
                 :parameters [] :result :i32
                 :integer-representation :signed-i32
                 :boolean-representation :i32-0-or-1
                 :nil-representation :i32-zero
                 :memory-model :none :multi-value? false}
                {:runtime :none :helpers [] :imports []
                 :hidden-services? false}
                [] #{} #{}
                {:entries [] :proofless-metadata-rejected? true}])
          (if (map? (get packet :safety))
            (if (map? (get packet :proofs))
              (if (map? (get packet :source-map))
                (if (map? (get packet :dependencies))
                  (if (b4-content-bindings-valid?
                       [:profile :target :abi :runtime :providers :effects
                        :capabilities :safety :proofs :source-map :dependencies
                        :c11-verifier :type :ownership :c13-optimization]
                       (get packet :contract-bindings))
                    (if (= [(get (get packet :contract-bindings) :profile)
                            (get (get packet :contract-bindings) :target)
                            (get (get packet :contract-bindings) :abi)
                            (get (get packet :contract-bindings) :runtime)
                            (get (get packet :contract-bindings) :providers)]
                           [{:content-id
                             "sha256:9adfa444f9f2790518c7a0d55bd1ecf97f117c723a8c82e1ee37c08d2eed2082"
                             :entry-count 2}
                            {:content-id
                             "sha256:829a8b18ab8fae4be3af1d01d73c2ce602172448aa393e5093e4dd4c54dbe2c4"
                             :entry-count 18}
                            {:content-id
                             "sha256:7a0eb1c4e55c3858d7232226cf8e7603a0e21a3ae76f138c21c996a12afc6432"
                             :entry-count 8}
                            {:content-id
                             "sha256:c2e9efb295d12d298aa8a7550f2826c622d9d566fbce43f1f04e40727e74ae97"
                             :entry-count 4}
                            {:content-id
                             "sha256:4f53cda18c2baa0c0354bb5f9a3ecbe5ed12ab4d8e11ba873c2f11161202b945"
                             :entry-count 0}])
                      (if (= [(get (get (get packet :contract-bindings)
                                            :effects)
                                       :entry-count)
                              (get (get (get packet :contract-bindings)
                                            :capabilities)
                                   :entry-count)
                              (get (get (get packet :contract-bindings)
                                            :dependencies)
                                   :entry-count)
                              (get (get (get packet :contract-bindings)
                                            :c11-verifier)
                                   :entry-count)
                              (get (get (get packet :contract-bindings)
                                            :c13-optimization)
                                   :entry-count)]
                             [2 3 (count (get packet :dependencies)) 1
                              (count (get (get packet :input)
                                          :optimization-report))])
                        (if (b4-b1-mir-input-projections-valid? packet)
                          (b4-b1-static-report-projections-valid? packet)
                          false)
                        false)
                      false)
                    false)
                  false)
                false)
              false)
            false)
          false)
        false)
      false)
    false)
   false))

(defn b4-b1-seal-valid?
  [packet]
  (let [rule (get packet :source-rule)
        provenance (get packet :actual-path-provenance)]
    (if (map? rule)
     (if (map? provenance)
      (if (= (set (keys rule))
           #{:artifact :owner :source-content-hash :source-byte-count
             :plan-semantic-hash :functions-semantic-hash
             :builder-function :builder-semantic-hash :function-shapes
             :semantic-authority :compiled-by :executed-by :self-hosted?})
      (if (= rule
             {:artifact :gravity/pinned-gravity-source-rule
              :owner :gravity.backend/b1-backend-interface
              :source-content-hash
              "sha256:afd3eda966529c2193fb08c67d998286d7a289989a3ea4b91fb6c63e43fd4d6e"
              :source-byte-count 140646
              :plan-semantic-hash
              "sha256:8fb24efb351a238d0047c063949309be3912a88e75e49e0c7c0e78c77dee015f"
              :functions-semantic-hash
              "sha256:1660ab0d6314a68ccd018e73c2cfa90692e383a658c59af063189a12e9d27d49"
              :builder-function
              (quote b1-build-bounded-wasm-authenticated-packet)
              :builder-semantic-hash
              "sha256:e958c2fca6c24ef6eea840cd75b38137fe047cd06a49677175be70855f29e50d"
              :function-shapes
              {(quote b1-wasm-content-bindings-valid?)
               {:arity 2 :params [(quote remaining) (quote bindings)]}
               (quote b1-c14-wasm-target-valid?)
               {:arity 1 :params [(quote target)]}
               (quote b1-c14-wasm-contract-bindings-valid?)
               {:arity 1 :params [(quote request)]}
               (quote b1-c14-wasm-dependencies-valid?)
               {:arity 1 :params [(quote request)]}
               (quote b1-bounded-c14-wasm-request-valid?)
               {:arity 1 :params [(quote request)]}
               (quote b1-bounded-c14-wasm-eligibility-valid?)
               {:arity 1 :params [(quote eligibility)]}
               (quote b1-c14-wasm-source-rule-valid?)
               {:arity 1 :params [(quote rule)]}
               (quote b1-c14-wasm-payload-valid?)
               {:arity 1 :params [(quote lowering)]}
               (quote b1-bounded-c14-wasm-input-valid?)
               {:arity 1 :params [(quote lowering)]}
               (quote b1-bounded-wasm-manifest-valid?)
               {:arity 1 :params [(quote backend-manifest)]}
               (quote b1-build-bounded-wasm-authenticated-packet)
               {:arity 2 :params [(quote lowering)
                                  (quote backend-manifest)]}}
              :semantic-authority :gravity-source
              :compiled-by :clojure-stage0-seed
              :executed-by :clojure-stage0-rule-runner
              :self-hosted? false})
        (if (= (set (keys provenance))
               #{:source :c11-source :c13-source :c14-source :b1-source})
          (if (string? (get provenance :source))
            (if (string? (get provenance :c11-source))
              (if (string? (get provenance :c13-source))
                (if (string? (get provenance :c14-source))
                  (if (string? (get provenance :b1-source))
                    (if (b4-sha256-id? (get packet :semantic-id))
                      (if (b4-sha256-id? (get packet :artifact-id))
                        (b4-sha256-id?
                         (get packet :actual-path-binding-id))
                        false)
                      false)
                    false)
                  false)
                false)
              false)
            false)
          false)
        false)
      false)
     false)
    false)))

(defn b4-b1-packet-valid?
  [packet]
  (if (map? packet)
    (if (= (set (keys packet))
           #{:artifact :schema-version :status :input
             :bounded-lowering-payload :profile :target
             :source-target-selection :target-kind :memory-width :features
             :abi :runtime :providers :effects :capabilities :safety :proofs
             :proof-to-target-metadata :source-map :dependencies
             :contract-bindings :c14-eligibility :eligibility
             :backend-manifest :unsupported-feature-report :diagnostics
             :semantic-authority :execution-tcb :clojure-seed-boundary?
             :whole-b1? :whole-b4? :self-hosted? :source-rule
             :actual-path-provenance :semantic-id :artifact-id
             :actual-path-binding-id})
      (if (= [(get packet :artifact)
              (get packet :schema-version)
              (get packet :status)
              (get packet :diagnostics)
              (get packet :semantic-authority)
              (get packet :execution-tcb)
              (get packet :clojure-seed-boundary?)
              (get packet :whole-b1?)
              (get packet :whole-b4?)
              (get packet :self-hosted?)]
             [:gravity/b1-verified-backend-input-packet
              1 :accepted-for-bounded-wasm [] :gravity-source
              :clojure-stage0-rule-runner true false false false])
        (let [input (get packet :input)
              payload (get packet :bounded-lowering-payload)
              mir (get payload :mir)
              optimization (get input :optimization-report)
              fact-bindings (get payload :fact-bindings)
              bindings (get packet :contract-bindings)
              manifest (get packet :backend-manifest)
              c14-eligibility (get packet :c14-eligibility)
              eligibility (get packet :eligibility)
              unsupported (get packet :unsupported-feature-report)
              dependencies (get packet :dependencies)]
          (if (b4-b1-static-contract-valid? packet)
            (if (b4-b1-seal-valid? packet)
              (if (= (set (keys input))
                     #{:kind :id :artifact-id :c11-artifact-id :verified?
                       :verifier-report :verifier-report-id
                       :optimization-status :optimization-report
                       :domain-status})
                (if (= (set (keys payload))
                       #{:artifact :c11-artifact-id :c13-artifact-id
                         :c13-semantic-id :mir :operation-order
                         :fact-bindings})
                  (if (= [(get input :kind) (get input :verified?)
                          (get input :optimization-status)
                          (get input :domain-status)
                          (get payload :artifact)]
                         [:gravity/mir true :identity-pass-complete
                          :not-applicable
                          :gravity/c14-bounded-wasm-lowering-payload])
                    (if (= [(get input :artifact-id)
                            (get input :id)
                            (get input :c11-artifact-id)]
                           [(get payload :c13-artifact-id)
                            (get payload :c13-semantic-id)
                            (get payload :c11-artifact-id)])
                      (if (= (set (keys optimization))
                             #{:artifact-id :semantic-id :decision-id
                               :verifier-result})
                        (if (= [(get optimization :artifact-id)
                                (get optimization :semantic-id)
                                (get optimization :verifier-result)]
                               [(get input :artifact-id)
                                (get input :id) :passed])
                          (if (b4-sha256-id? (get input :artifact-id))
                            (if (b4-sha256-id? (get input :id))
                              (if (b4-sha256-id?
                                   (get input :c11-artifact-id))
                                (if (b4-sha256-id?
                                     (get input :verifier-report-id))
                                  (if (b4-sha256-id?
                                       (get optimization :decision-id))
                                    (if (map? (get input :verifier-report))
                                      (if (map? (get payload :mir))
                                        (if (= (set (keys fact-bindings))
                                               #{:type :effect :ownership
                                                 :capability :safety
                                                 :runtime-checks :proofs
                                                 :source-map})
                                          (if (= (set (keys bindings))
                                                 #{:profile :target :abi
                                                   :runtime :providers :effects
                                                   :capabilities :safety :proofs
                                                   :source-map :dependencies
                                                   :c11-verifier :type
                                                   :ownership
                                                   :c13-optimization})
                                            (if (= (get input
                                                        :verifier-report-id)
                                                   (get (get bindings
                                                             :c11-verifier)
                                                        :content-id))
                                              (if (= [(get fact-bindings :type)
                                                      (get fact-bindings
                                                           :ownership)
                                                      (get fact-bindings :safety)
                                                      (get fact-bindings
                                                           :source-map)]
                                                     [(get bindings :type)
                                                      (get bindings :ownership)
                                                      (get bindings :safety)
                                                      (get bindings
                                                           :source-map)])
                                                (if (= (get (get packet
                                                                  :source-map)
                                                             :id)
                                                       (get (get bindings
                                                                 :source-map)
                                                            :content-id))
                                                  (if (= (get (get packet
                                                                    :safety)
                                                               :binding)
                                                         (get bindings :safety))
                                                    (if (b4-fact-bindings-valid?
                                                         packet mir
                                                         fact-bindings bindings)
                                                      (if (b4-dependencies-valid?
                                                           dependencies input mir)
                                                        (if (= (set (keys manifest))
                                                               #{:artifact :backend
                                                                 :version :accepts
                                                                 :emits :requires
                                                                 :supports-profiles
                                                                 :rejects
                                                                 :target-kind
                                                                 :memory-width
                                                                 :features :imports
                                                                 :runtime-helpers
                                                                 :c14-request-id
                                                                 :c14-artifact-id})
                                                          (if (= [(get manifest
                                                                       :artifact)
                                                                  (get manifest
                                                                       :backend)
                                                                  (get manifest
                                                                       :version)
                                                                  (get manifest
                                                                       :accepts)
                                                                  (get manifest
                                                                       :emits)
                                                                  (get manifest
                                                                       :requires)
                                                                  (get manifest
                                                                       :supports-profiles)
                                                                  (get manifest
                                                                       :rejects)
                                                                  (get manifest
                                                                       :target-kind)
                                                                  (get manifest
                                                                       :memory-width)
                                                                  (get manifest
                                                                       :features)
                                                                  (get manifest
                                                                       :imports)
                                                                  (get manifest
                                                                       :runtime-helpers)]
                                                                 [:gravity/backend-manifest
                                                                  :gravity.backend/wasm
                                                                  :bounded-authenticated-wasm32-core-v1
                                                                  [:gravity/mir]
                                                                  [:wasm-core-module]
                                                                  [:profile-manifest
                                                                   :target-manifest
                                                                   :wasm-feature-policy
                                                                   :abi-policy
                                                                   :runtime-provider-selection
                                                                   :effect-summary
                                                                   :capability-proof-summary
                                                                   :safety-bundle
                                                                   :proof-table
                                                                   :source-map
                                                                   :dependency-graph]
                                                                  [:hosted]
                                                                  [:unverified-ir
                                                                   :unsupported-op
                                                                   :missing-proof
                                                                   :implicit-ub
                                                                   :ambient-capability
                                                                   :profile-violation
                                                                   :unsupported-wasm-feature]
                                                                  :core-module
                                                                  :wasm32 #{} [] []])
                                                            (if (b4-sha256-id?
                                                                 (get manifest
                                                                      :c14-request-id))
                                                              (if (b4-sha256-id?
                                                                   (get manifest
                                                                        :c14-artifact-id))
                                                                (if (= (set (keys c14-eligibility))
                                                                       #{:artifact :backend
                                                                         :profile :target
                                                                         :accepted? :rejections
                                                                         :fallbacks
                                                                         :missing-features
                                                                         :required-providers
                                                                         :proof-assumptions
                                                                         :explainability-record
                                                                         :checks})
                                                                  (if (= [(get c14-eligibility
                                                                               :artifact)
                                                                          (get c14-eligibility
                                                                               :backend)
                                                                          (get c14-eligibility
                                                                               :profile)
                                                                          (get c14-eligibility
                                                                               :target)
                                                                          (get c14-eligibility
                                                                               :accepted?)
                                                                          (get c14-eligibility
                                                                               :rejections)
                                                                          (get c14-eligibility
                                                                               :fallbacks)
                                                                          (get c14-eligibility
                                                                               :missing-features)
                                                                          (get c14-eligibility
                                                                               :required-providers)
                                                                          (get c14-eligibility
                                                                               :proof-assumptions)]
                                                                         [:gravity/c14-target-eligibility-report
                                                                          :gravity.backend/wasm
                                                                          :hosted
                                                                          (get packet :target)
                                                                          true [] [] [] [] []])
                                                                    (if (= (set (keys eligibility))
                                                                           #{:artifact :backend
                                                                             :input-artifact
                                                                             :profile :target
                                                                             :accepted? :rejections
                                                                             :fallbacks
                                                                             :missing-evidence
                                                                             :unsupported-operations
                                                                             :remediation :checks})
                                                                      (if (= [(get eligibility
                                                                                   :artifact)
                                                                              (get eligibility
                                                                                   :backend)
                                                                              (get eligibility
                                                                                   :input-artifact)
                                                                              (get eligibility
                                                                                   :profile)
                                                                              (get eligibility
                                                                                   :target)
                                                                              (get eligibility
                                                                                   :accepted?)
                                                                              (get eligibility
                                                                                   :rejections)
                                                                              (get eligibility
                                                                                   :fallbacks)
                                                                              (get eligibility
                                                                                   :missing-evidence)
                                                                              (get eligibility
                                                                                   :unsupported-operations)
                                                                              (get eligibility
                                                                                   :remediation)]
                                                                             [:gravity/b1-backend-eligibility-report
                                                                              :gravity.backend/wasm
                                                                              (get input
                                                                                   :artifact-id)
                                                                              :hosted
                                                                              (get packet :target)
                                                                              true [] [] [] [] []])
                                                                        (if (= (set (keys unsupported))
                                                                               #{:status :policy
                                                                                 :diagnostic
                                                                                 :fallback-status})
                                                                          (= [(get unsupported :status)
                                                                              (get unsupported :diagnostic)
                                                                              (get unsupported
                                                                                   :fallback-status)]
                                                                             [:bounded-surface-only
                                                                              "B1-UNSUPPORTED"
                                                                              :rejected])
                                                                          false)
                                                                        false)
                                                                      false)
                                                                    false)
                                                                  false)
                                                                false)
                                                              false)
                                                            false)
                                                          false)
                                                        false)
                                                      false)
                                                    false)
                                                  false)
                                                false)
                                              false)
                                            false)
                                          false)
                                        false)
                                      false)
                                    false)
                                  false)
                                false)
                              false)
                            false)
                          false)
                        false)
                      false)
                    false)
                  false)
                false)
              false)
            false))
        false)
      false)
    false))

(defn b4-build-bounded-wasm32-core
  [b1-packet]
  (let [mir (get (get b1-packet :bounded-lowering-payload) :mir)]
  (if (if (b4-b1-packet-valid? b1-packet)
        (if (= (get mir :artifact) :gravity/mir-module)
        (if (= (get mir :verification-status) :passed)
          (if (= (get mir :profile) :hosted)
            (if (= (get mir :target-request) :wasm)
              (if (= (get mir :target-independent?) true)
                (if (= (get mir :source-target) :jvm)
                  (if (= (get mir :globals) {})
                    (= (set (keys (get mir :functions))) #{(quote main)})
                    false)
                  false)
                false)
              false)
            false)
          false)
        false)
        false)
    (let [function (get (get mir :functions) (quote main))
          blocks (get function :blocks)
          block-order (b4-block-order mir function)
          operations (b4-collect-operations blocks block-order [])
          operation-index (b4-index-operations operations 0 {})
          block-labels (b4-block-labels block-order)
          function-reason
          (if (= (get function :artifact) :gravity/mir-function)
            (if (= (get function :name) (quote main))
              (if (= (get function :params) [])
                (if (= (get function :latent-effects) #{})
                  (if (= (get function :capabilities) #{})
                    (if (if (= (count blocks) 1)
                          true
                          (= (count blocks) 4))
                      nil :bounded-block-count)
                    :function-capabilities)
                  :function-effects)
                :zero-parameter-function)
              :main-function-name)
            :mir-function-envelope)
          cfg-reason
          (if (= function-reason nil)
            (b4-cfg-reason mir function block-order operations)
            nil)
          rejection
          (if (= function-reason nil)
            (if (= cfg-reason nil)
              (if (if (> (count operations) 0)
                    (if (<= (count operations) 127)
                      (= (count operations) (count operation-index))
                      false)
                    false)
                (b4-first-operation-rejection
                 operations operations operation-index block-labels)
                {:reason :bounded-unique-operation-count})
              {:reason cfg-reason})
            {:reason function-reason})]
      (if (= rejection nil)
        (let [return-block (get blocks (b4-last block-order))
              return-terminator (get return-block :terminator)
              return-id (first (get return-terminator :operands))
              local-declarations
              (b4-vector-append
               [1] (b4-vector-append
                    (b4-u32-leb (count operations)) [127]))
              instruction-bytes
              (b4-function-instructions
               function block-order operations operation-index)
              body
              (b4-vector-append
               local-declarations
               (b4-vector-append
                instruction-bytes
                [11]))
              type-section (b4-section 1 [1 96 0 1 127])
              function-section (b4-section 3 [1 0])
              export-section (b4-section 7 [1 4 109 97 105 110 0 0])
              code-entry
              (b4-vector-append (b4-u32-leb (count body)) body)
              code-section
              (b4-section 10 (b4-vector-append [1] code-entry))
              bytes
              (b4-vector-append
               [0 97 115 109 1 0 0 0]
               (b4-vector-append
                type-section
                (b4-vector-append
                 function-section
                 (b4-vector-append export-section code-section))))
              values (b4-evaluate-operations operations operations {})]
          {:artifact :gravity/b4-bounded-wasm32-core-lowering
           :status :constructed-unverified
           :source-mir-id (get mir :module-id)
           :target :wasm32-unknown-unknown
           :target-kind :core-module
           :features #{}
           :abi {:parameters [] :result :i32}
           :imports []
           :exports [{:name "main" :kind :function :index 0}]
           :memory nil
           :table nil
           :globals []
           :start nil
           :data []
           :custom-sections []
           :runtime-helpers []
           :component-model? false
           :wit? false
           :wasi? false
           :block-order block-order
           :operation-index operation-index
           :wasm-bytes bytes
           :expected-result (get values return-id)
           :diagnostics []
           :clojure-seed-boundary? true
           :self-hosted? false})
        (b4-rejected "B1-UNSUPPORTED" (get rejection :reason) rejection)))
    (b4-rejected "B1-INPUT" :verified-bounded-wasm-b1-packet {}))))

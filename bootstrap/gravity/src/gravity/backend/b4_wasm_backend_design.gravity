              (get rule :source-content-hash)
              (get rule :plan-semantic-hash)
              (get rule :functions-semantic-hash)
              (get rule :builder-function)
              (get rule :builder-semantic-hash)
              (get rule :semantic-authority)
              (get rule :compiled-by) (get rule :executed-by)
              (get rule :self-hosted?)]
             [:gravity/pinned-gravity-source-rule
              :gravity.compiler/c13-mir-optimization 98836
              "sha256:071511017d4f3f3816716cfa899ae0189e882e6be9d67dc34e794729ae105681"
              "sha256:840089668cb979b5ddceda17b6df586652655dd364d503a080d4c9d28372ea50"
              "sha256:a511673fffd4888cd1f4b826d27e50adcf5b769cd7759a5dce88ad8b370de265"

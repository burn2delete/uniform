; Stage1 Gravity-owned B4 Wasm backend source-model contract.
(ns gravity.backend.b4-wasm-backend-design
  (:profile :meta)
  (:target :jvm)
  (:exports [b4-wasm-backend-contract
             b4-target-feature-contract
             b4-component-contract
             b4-canonical-abi-contract
             b4-import-export-capability-contract
             b4-linear-memory-contract
             b4-async-component-contract
             b4-numeric-simd-atomic-contract
             b4-runtime-binding-contract
             b4-artifact-manifest-contract
             b4-diagnostic-catalog
             build-b4-wasm-backend-manifest
             build-b4-target-feature-record
             build-b4-component-contract-manifest
             build-b4-canonical-abi-manifest
             build-b4-import-capability-manifest
             build-b4-linear-memory-plan
             build-b4-async-abi-manifest
             build-b4-wasm-artifact-record
             verify-b4-wasm-backend-design
             b4-build-bounded-wasm32-core])
  (:effects #{})
  (:capabilities #{})
  (:safety :safe)
  (:metadata {:bootstrap
              {:stage :stage1
               :component :wasm-backend
               :owner :gravity-source
               :source-language :gravity
               :seed :clojure-stage0
               :retirement-objective :replace-clojure-seed
               :ambient-authority-denied true
               :accepted-source-extensions [".gravity" ".qst"]
               :governing-document-ids ["B4" "B1" "D1" "D3"
                                        "C11" "C14"
                                        "P4" "P5" "P9" "P10" "P13"
                                        "SAFE2" "SAFE8" "SAFE10"
                                        "SAFE11" "SAFE15"
                                        "PERF8" "MATH5" "MATH8"
                                        "SCHEMA" "AI" "WORKFLOW"
                                        "B13" "B14" "R1"
                                        "PKG7" "BOOT1" "BOOT3"
                                        "BOOT8" "TEST13"]
               :documents ["B4" "B1" "D1" "D3"
                           "C11" "C14"
                           "P4" "P5" "P9" "P10" "P13"
                           "SAFE2" "SAFE8" "SAFE10"
                           "SAFE11" "SAFE15"
                           "PERF8" "MATH5" "MATH8"
                           "SCHEMA" "AI" "WORKFLOW"
                           "B13" "B14" "R1"
                           "PKG7" "BOOT1" "BOOT3"
                           "BOOT8" "TEST13"]
               :implements [:wasm-backend-source-model
                             :wasm-target-feature-contract
                             :component-model-contract
                             :canonical-abi-contract
                             :import-export-capability-contract
                             :linear-memory-contract
                             :wasi-async-component-contract
                             :wasm-numeric-simd-atomic-contract
                             :runtime-binding-contract
                             :wasm-artifact-manifest-contract
                             :stable-b4-diagnostic-catalog]
               :preserves #{:source-spans :syntax-identity
                            :diagnostic-codes :artifact-provenance
                            :mir-module-identity :domain-ir-anchors
                            :profile-contracts :target-contracts
                            :wasm-target-kind :wasm-feature-record
                            :memory-width :memory-growth-policy
                            :table-strategy :reference-type-policy
                            :component-model-abi
                            :wit-package-interface-world-records
                            :canonical-abi-records
                            :import-capability-manifest
                            :export-schema-manifest
                            :host-boundary-schema-manifest
                            :async-abi-records
                            :completion-cancellation-backpressure-policy
                            :resource-ownership-facts
                            :linear-memory-plan
                            :pointer-and-handle-lifetime-facts
                            :bounds-check-proofs
                            :numeric-mode-facts
                            :math-certificate-references
                            :simd-feature-proofs
                            :atomic-ordering-facts
                            :replay-nondeterminism-records
                            :runtime-provider-records
                            :binding-provider-records
                            :effect-facts :capability-facts
                            :safety-outcomes :unsafe-audit-links
                            :proof-references :source-maps
                            :generated-origin-maps
                            :debug-maps :dependency-provenance
                            :backend-conformance-metadata}
               :authority {:ambient #{}
                           :declared-effects #{}
                           :declared-capabilities #{}
                           :denies [:filesystem :network :shell
                                    :environment :clock :random
                                    :model-call :tool-call :registry
                                    :ffi :raw-memory :dom :wasi-host]}
               :lineage {:verified-by :clojure-stage0
                         :compiled-by :clojure-stage0
                         :next-stage :stage1
                         :replaces [:clojure-b4-wasm-backend-contract-subset
                                    :clojure-b4-diagnostic-catalog]}
               :conformance {:accepted-fixture
                             "bootstrap/gravity/src/gravity/backend/b4_wasm_backend_design.gravity"
                             :accepted-source-extensions [".gravity" ".qst"]
                             :rejected-fixtures
                             ["backend-b4-target.gravity"
                              "backend-b4-component.gravity"
                              "backend-b4-canonical-abi.gravity"
                              "backend-b4-import.gravity"
                              "backend-b4-export.gravity"
                              "backend-b4-memory.gravity"
                              "backend-b4-bounds.gravity"
                              "backend-b4-nondeterminism.gravity"
                              "backend-b4-async.gravity"
                              "backend-b4-wasi-async.gravity"
                              "backend-b4-simd.gravity"
                              "backend-b4-atomic.gravity"
                              "backend-b4-host-schema.gravity"
                              "backend-b4-manifest.gravity"]}}}))

(def b4-wasm-backend-contract
  {:artifact :gravity/b4-wasm-backend-contract
   :scope :source-model-bridge
   :production-backend-status :not-claimed
   :extends :gravity/b1-backend-interface-contract
   :backend :gravity.backend/wasm
   :accepts [:verified-mir :verified-domain-ir]
   :target-kinds [:core-module
                  :component-model
                  :wasi-like-environment
                  :browser-embedder
                  :edge-embedder
                  :native-wasm-embedding]
   :emits [:wasm-backend-manifest
           :wasm-target-feature-record
           :linear-memory-and-table-plan
           :wasm-module
           :component-model-artifact
           :component-contract-manifest
           :canonical-abi-manifest
           :import-capability-manifest
           :export-schema-manifest
           :host-boundary-schema-manifest
           :async-abi-manifest
           :component-composition-plan
           :host-binding-stubs
           :runtime-helper-manifest
           :source-map
           :generated-origin-map
           :replay-nondeterminism-record
           :wasm-backend-diagnostics]
   :requires [:b1-verified-backend-input
              :mir-module
              :domain-ir-anchors
              :profile-manifest
              :target-manifest
              :linear-memory-plan
              :import-capabilities
              :export-schemas
              :host-boundary-schemas
              :component-composition-plan
              :host-provider-manifest
              :proof-table
              :source-map]
   :rules [:wasm-is-target-artifact-not-gravity-semantics
           :backend-consumes-only-verified-ir
           :host-authority-enters-only-through-declared-imports
           :component-boundaries-preserve-effects-capabilities-and-schemas
           :raw-pointers-offsets-tables-references-and-handles-never-escape-without-abi-schema
           :replay-sensitive-profiles-record-nondeterministic-imports]
   :forbidden [:source-to-wasm-shortcut
               :ambient-host-import
               :wasm-sandbox-as-capability-check
               :raw-linear-memory-offset-as-safe-api
               :unrecorded-nondeterministic-host-call
               :runtime-feature-probing-when-compile-time-eligibility-required
               :artifact-without-wasm-manifest]})

(def b4-target-feature-contract
  {:artifact :gravity/b4-target-feature-contract
   :required-fields [:wasm-version
                     :embedding-model
                     :memory-width
                     :memory-count
                     :initial-memory-pages
                     :maximum-memory-pages
                     :memory-growth-permission
                     :table-representation
                     :reference-type-support
                     :exception-handling-support
                     :gc-proposal-support
                     :simd-support
                     :relaxed-simd-support
                     :atomic-and-shared-memory-support
                     :component-model-abi-version
                     :wasi-preview-or-profile
                     :async-component-abi-version
                     :canonical-abi-adapter-support
                     :resource-handle-and-borrow-support
                     :async-func-stream-future-support
                     :completion-cancellation-backpressure-strategy
                     :import-namespace
                     :deterministic-or-replay-required-mode]
   :rules [:target-kind-is-explicit
           :wasm32-or-wasm64-is-pinned
           :feature-dependent-lowering-requires-feature-or-fallback
           :profile-forbids-runtime-feature-probing-when-compile-time-eligibility-required]
   :reject-when [:unsupported-wasm-kind
                 :unsupported-memory-width
                 :missing-feature-record
                 :feature-without-profile-valid-fallback
                 :invalid-embedding-model]})

(def b4-component-contract
  {:artifact :gravity/b4-component-contract
   :contract-items [:package :interface :world :function
                    :record :variant :flags :list
                    :option :result :stream :future :resource]
   :world-required-fields [:required-imports
                           :capability-grants
                           :exported-functions
                           :exported-resources
                           :host-boundary-schemas
                           :replay-and-nondeterminism-policy
                           :resource-construction-borrow-transfer-drop-rules
                           :async-and-streaming-policy
                           :cancellation-completion-backpressure-policy
                           :version-and-compatibility-constraints]
   :rules [:schema-names-are-not-host-authority
           :interface-items-map-to-gravity-type-effect-capability-and-origin
           :worlds-are-host-boundary-eligibility-units
           :resources-are-linear-unless-sharing-is-proven
           :component-composition-preserves-effects-capabilities-replay-and-ownership]
   :forbidden [:invalid-wit-like-interface
               :undeclared-authority-amplification
               :composition-hides-imported-capability
               :composition-weakens-host-boundary-schema
               :composition-drops-replay-metadata
               :composition-erases-resource-ownership-rule]})

(def b4-canonical-abi-contract
  {:artifact :gravity/b4-canonical-abi-contract
   :value-forms [:record :variant :list :option :result
                 :string :buffer :resource :stream :future]
   :required-fields [:lowered-form
                     :lifted-form
                     :copy-behavior
                     :borrow-behavior
                     :transfer-behavior
                     :drop-behavior
                     :allocation-function
                     :realloc-function
                     :trap-error-and-cancellation-mapping
                     :host-and-guest-ownership
                     :schema-version
                     :schema-hash
                     :conformance-fixture-id]
   :rules [:canonical-abi-records-describe-boundary-values
           :resource-handles-carry-owner-borrow-scope-destructor-and-leak-policy
           :canonical-abi-records-not-raw-offsets-are-stable-component-contracts
           :abi-record-links-source-and-generated-origin]
   :reject-when [:missing-canonical-abi-record
                 :inconsistent-lift-lower-form
                 :resource-handle-without-owner
                 :stream-or-future-without-typed-abi
                 :schema-hash-gap]})

(def b4-import-export-capability-contract
  {:artifact :gravity/b4-import-export-capability-contract
   :import-required-fields [:host-namespace
                            :host-symbol
                            :interface-world-item-name
                            :gravity-effect
                            :capability-grant
                            :parameter-schema
                            :return-schema
                            :determinism-policy
                            :replay-policy
                            :trap-and-error-behavior
                            :async-or-sync-behavior
                            :host-resource-ownership
                            :taint-policy
                            :source-and-generated-origin]
   :export-required-fields [:export-id
                            :stable-boundary-schema
                            :ownership-and-lifetime-rules
                            :effect
                            :capability
                            :replay-policy
                            :resource-ownership-record]
   :rules [:every-import-has-effect-capability-schema-determinism-replay-and-provider
           :component-imports-are-capability-imports
           :exports-publish-schema-ownership-effect-capability-and-replay-records
           :host-boundary-schemas-exist-for-import-export-and-adapter-boundaries]
   :forbidden [:ambient-host-import
               :host-function-without-capability-grant
               :export-without-stable-schema
               :internal-layout-exposed-as-safe-export
               :missing-host-provider-record]})

(def b4-linear-memory-contract
  {:artifact :gravity/b4-linear-memory-contract
   :required-fields [:allocation-provider
                     :stack-segment
                     :heap-segment
                     :static-data-segments
                     :exported-memory-policy
                     :string-representation
                     :byte-buffer-representation
                     :struct-tuple-enum-tagged-union-layout
                     :handle-and-resource-table-representation
                     :copy-borrow-transfer-rules
                     :bounds-and-lifetime-proofs
                     :memory-growth-invalidation-rules]
   :rules [:pointers-are-internal-offsets-unless-schema-converts-to-handle-or-owned-value
           :host-may-not-retain-offset-without-lifetime-record
           :component-linear-memory-is-implementation-detail-of-canonical-adapter
           :bounds-elision-requires-wasm-memory-semantics-and-gravity-proof]
   :forbidden [:pointer-escape-without-abi-schema
               :host-retains-offset-without-lifetime
               :memory-growth-invalidates-live-pointer-without-record
               :bounds-check-elision-without-proof]})

(def b4-async-component-contract
  {:artifact :gravity/b4-async-component-contract
   :async-items [:async-func :stream :future]
   :required-fields [:typed-abi-item
                     :completion-policy
                     :cancellation-policy
                     :backpressure-policy
                     :resource-ownership
                     :scheduling-metadata
                     :replay-policy
                     :drop-or-leak-policy
                     :error-and-trap-mapping]
   :rules [:async-is-part-of-component-contract
           :future-is-single-completion-typed-value
           :stream-is-typed-sequence-resource
           :async-imports-require-effect-capability-scheduling-and-cancellation-metadata
           :replay-sensitive-profiles-record-completions-stream-order-host-wakeups-cancellations-and-errors]
   :forbidden [:opaque-host-promise-as-typed-abi
               :blocking-adapter-erases-host-scheduling
               :dropped-cancellation
               :unbounded-stream-buffering
               :erased-backpressure
               :async-effect-without-capability]})

(def b4-numeric-simd-atomic-contract
  {:artifact :gravity/b4-numeric-simd-atomic-contract
   :numeric-requirements [:gravity-numeric-manifest
                          :checked-or-saturating-helper-or-instruction
                          :math8-floating-mode
                          :math5-certificate-reference]
   :simd-required-fields [:lane-record
                          :bounds-proof
                          :alignment-proof
                          :numeric-mode
                          :target-feature-record]
   :atomic-required-fields [:shared-memory-enabled
                            :memory-order-mapping
                            :host-embedding-support
                            :fallback-or-rejection-rule]
   :rules [:wrapping-integer-operations-may-use-wasm-wrapping-semantics
           :checked-and-saturating-modes-require-check-helper-or-target-instruction
           :floating-lowering-preserves-mode-and-certificate
           :simd-lowering-requires-perf8-and-target-feature-records
           :atomics-require-shared-memory-ordering-and-host-support]
   :reject-when [:missing-numeric-manifest
                 :unsupported-simd-feature
                 :uncertified-vector-lowering
                 :shared-memory-gap
                 :memory-order-gap
                 :volatile-or-mmio-without-embedding-capability]})

(def b4-runtime-binding-contract
  {:artifact :gravity/b4-runtime-binding-contract
   :helper-categories [:allocation
                       :bounds-and-numeric-checks
                       :resource-tables
                       :string-and-buffer-conversion
                       :async-host-calls
                       :futures-streams-completion-queues-cancellation-backpressure
                       :traps-and-panic-formatting
                       :math-functions
                       :debug-hooks]
   :provider-manifests [:browser :node :edge :wasi :custom-embedder]
   :rules [:runtime-helpers-are-selected-through-provider-manifest
           :binding-generators-preserve-schema-effects-capabilities-source-maps-and-replay
           :host-exceptions-and-rejected-promises-are-translated-at-binding-stubs
           :deterministic-traps-host-failures-and-recorded-events-remain-distinct]
   :forbidden [:hidden-host-runtime-service
               :binding-stub-drops-capability
               :binding-stub-drops-replay-metadata
               :untyped-host-failure-leaks-through-boundary]})

(def b4-artifact-manifest-contract
  {:artifact :gravity/b4-wasm-artifact-manifest-contract
   :required-artifacts [:wasm-backend-manifest
                        :wasm-target-feature-record
                        :linear-memory-and-table-plan
                        :wasm-module
                        :component-model-artifact
                        :component-contract-manifest
                        :canonical-abi-manifest
                        :import-capability-manifest
                        :export-schema-manifest
                        :host-boundary-schema-manifest
                        :async-abi-manifest
                        :component-composition-plan
                        :host-binding-stubs
                        :runtime-helper-manifest
                        :source-map
                        :generated-origin-map
                        :replay-nondeterminism-record
                        :wasm-backend-diagnostics]
   :required-fields [:artifact-id
                     :source-input-digest
                     :compiler-identity
                     :profile
                     :target
                     :wasm-target-kind
                     :feature-record
                     :effects
                     :capabilities
                     :safety-summary
                     :proof-summary
                     :unsafe-audit-links
                     :dependency-graph
                     :source-map
                     :generated-origin-map
                     :replay-record]
   :rules [:actual-source-path-and-extension-are-preserved
           :wasm-feature-record-is-manifested
           :schemas-capabilities-and-replay-records-are-machine-linked
           :diagnostics-reference-source-and-generated-origin]
   :forbidden [:manifest-without-source-unit-identity
               :wasm-artifact-without-artifact-record
               :generated-wasm-without-boundary-schema-record
               :diagnostic-without-stable-b4-id]})

(def b4-diagnostic-catalog
  {:artifact :gravity/b4-diagnostic-catalog
   :diagnostics
   [{:id "B4-TARGET"
     :meaning :unsupported-wasm-kind-memory-width-embedding-or-feature}
    {:id "B4-COMPONENT"
     :meaning :invalid-interface-world-resource-or-composition-plan}
    {:id "B4-CANONICAL-ABI"
     :meaning :missing-or-inconsistent-canonical-abi-record}
    {:id "B4-IMPORT"
     :meaning :host-import-without-effect-capability-schema-or-provider}
    {:id "B4-EXPORT"
     :meaning :unstable-or-incomplete-export-schema}
    {:id "B4-MEMORY"
     :meaning :invalid-linear-memory-lifetime-growth-or-pointer-escape}
    {:id "B4-BOUNDS"
     :meaning :missing-bounds-proof-or-invalid-check-elision}
    {:id "B4-NONDETERMINISM"
     :meaning :unrecorded-host-nondeterminism-in-replay-required-code}
    {:id "B4-ASYNC"
     :meaning :host-async-behavior-without-effect-or-scheduling-metadata}
    {:id "B4-WASI-ASYNC"
     :meaning :wasi-or-component-async-item-without-typed-ownership-completion-cancellation-backpressure-or-replay}
    {:id "B4-SIMD"
     :meaning :unsupported-or-uncertified-vector-lowering}
    {:id "B4-ATOMIC"
     :meaning :shared-memory-or-memory-order-violation}
    {:id "B4-HOST-SCHEMA"
     :meaning :missing-or-incompatible-host-boundary-schema}
    {:id "B4-MANIFEST"
     :meaning :incomplete-wasm-artifact-manifest}]
   :required-diagnostic-fields [:source-span
                                :mir-operation-or-domain-anchor
                                :import-or-export-id
                                :interface-item-or-world-id
                                :canonical-abi-record-id
                                :async-item-id
                                :profile
                                :embedding
                                :feature-requirement
                                :missing-evidence
                                :fallback-status
                                :remediation]})

(defn build-b4-wasm-backend-manifest
  [target feature-record emitted-artifacts required-facts]
  {:artifact :gravity/wasm-backend-manifest
   :backend :gravity.backend/wasm
   :version "source-model-v1"
   :target target
   :feature-record feature-record
   :emits emitted-artifacts
   :requires required-facts
   :rejects [:ambient-host-import
             :pointer-escape
             :unrecorded-nondeterminism
             :unsupported-wasm-feature
             :invalid-component-contract
             :missing-canonical-abi]
   :source-model-only? true})

(defn build-b4-target-feature-record
  [target-kind memory-width features embedding]
  {:artifact :gravity/b4-wasm-target-feature-record
   :target-kind target-kind
   :memory-width memory-width
   :features features
   :embedding embedding
   :required-fields
   [:wasm-version :embedding-model :memory-width :memory-count
    :initial-memory-pages :maximum-memory-pages
    :memory-growth-permission :table-representation
    :reference-type-support :exception-handling-support
    :gc-proposal-support :simd-support :relaxed-simd-support
    :atomic-and-shared-memory-support :component-model-abi-version
    :wasi-preview-or-profile :async-component-abi-version
    :canonical-abi-adapter-support :resource-handle-and-borrow-support
    :async-func-stream-future-support
    :completion-cancellation-backpressure-strategy :import-namespace
    :deterministic-or-replay-required-mode]
   :source-model-only? true})

(defn build-b4-component-contract-manifest
  [packages interfaces worlds resources]
  {:artifact :gravity/b4-component-contract-manifest
   :packages packages
   :interfaces interfaces
   :worlds worlds
   :resources resources
   :contract-items
   [:package :interface :world :function :record :variant :flags :list
    :option :result :stream :future :resource]
   :source-model-only? true})

(defn build-b4-canonical-abi-manifest
  [abi-records schema-version schema-hash]
  {:artifact :gravity/b4-canonical-abi-manifest
   :abi-records abi-records
   :schema-version schema-version
   :schema-hash schema-hash
   :required-fields
   [:lowered-form :lifted-form :copy-behavior :borrow-behavior
    :transfer-behavior :drop-behavior :allocation-function
    :realloc-function :trap-error-and-cancellation-mapping
    :host-and-guest-ownership :schema-version :schema-hash
    :conformance-fixture-id]
   :source-model-only? true})

(defn build-b4-import-capability-manifest
  [imports exports host-boundary-schemas]
  {:artifact :gravity/b4-import-capability-manifest
   :imports imports
   :exports exports
   :host-boundary-schemas host-boundary-schemas
   :import-required-fields
   [:host-namespace :host-symbol :interface-world-item-name
    :gravity-effect :capability-grant :parameter-schema :return-schema
    :determinism-policy :replay-policy :trap-and-error-behavior
    :async-or-sync-behavior :host-resource-ownership :taint-policy
    :source-and-generated-origin]
   :source-model-only? true})

(defn build-b4-linear-memory-plan
  [memory-width segments ownership]
  {:artifact :gravity/b4-linear-memory-plan
   :memory-width memory-width
   :segments segments
   :ownership ownership
   :required-fields
   [:allocation-provider :stack-segment :heap-segment
    :static-data-segments :exported-memory-policy :string-representation
    :byte-buffer-representation :struct-tuple-enum-tagged-union-layout
    :handle-and-resource-table-representation :copy-borrow-transfer-rules
    :bounds-and-lifetime-proofs :memory-growth-invalidation-rules]
   :source-model-only? true})

(defn build-b4-async-abi-manifest
  [async-items replay-policy scheduling]
  {:artifact :gravity/b4-async-abi-manifest
   :async-items async-items
   :replay-policy replay-policy
   :scheduling scheduling
   :required-fields
   [:typed-abi-item :completion-policy :cancellation-policy
    :backpressure-policy :resource-ownership :scheduling-metadata
    :replay-policy :drop-or-leak-policy :error-and-trap-mapping]
   :source-model-only? true})

(defn build-b4-wasm-artifact-record
  [artifact-kind source-path source-hash manifest-id provenance]
  {:artifact :gravity/b4-wasm-artifact-record
   :artifact-kind artifact-kind
   :source-path source-path
   :source-hash source-hash
   :manifest-id manifest-id
   :provenance provenance
   :required-fields
   [:artifact-id :source-input-digest :compiler-identity :profile
    :target :wasm-target-kind :feature-record :effects :capabilities
    :safety-summary :proof-summary :unsafe-audit-links :dependency-graph
    :source-map :generated-origin-map :replay-record]
   :source-model-only? true})

(defn verify-b4-wasm-backend-design
  [manifest]
  {:artifact :gravity/b4-wasm-backend-verification
   :manifest manifest
   :backend-consumes-only-verified-ir? true
   :target-features-pinned? true
   :component-contracts-covered? true
   :canonical-abi-covered? true
   :import-export-capabilities-covered? true
   :linear-memory-covered? true
   :async-component-abi-covered? true
   :numeric-simd-atomic-covered? true
   :runtime-binding-manifest-required? true
   :artifact-provenance-required? true
   :diagnostics-covered? true
   :production-backend-execution? false
   :source-model-only? true})

; ---------------------------------------------------------------------------
; Authenticated bounded raw Wasm32 core-module slice (FL-P07-T02).
;
; This source-owned builder is deliberately narrower than the design model
; above.  Its caller has already regenerated and independently verified C11
; MIR.  The builder still validates the lowering-relevant pure scalar surface
; and emits bytes for a core module containing exactly one () -> i32 function,
; exported only as `main`.  There are no imports, memories, tables, globals,
; start/data/custom sections, components, WIT, WASI, or runtime helpers.

(defn b4-last
  [values]
  (if (= (count values) 0)
    nil
    (if (= (count values) 1)
      (first values)
      (b4-last (rest values)))))

(defn b4-vector-append
  [left right]
  (if (= (count right) 0)
    left
    (b4-vector-append (conj left (first right)) (rest right))))

(defn b4-u32-leb
  [value]
  (let [next (quot value 128)
        byte (- value (* next 128))]
    (if (= next 0)
      [byte]
      (b4-vector-append [(+ byte 128)] (b4-u32-leb next)))))

(defn b4-s32-leb
  [value]
  (let [next (if (< value 0)
               (quot (- value 127) 128)
               (quot value 128))
        byte (- value (* next 128))
        done (if (= next 0)
               (< byte 64)
               (if (= next -1) (>= byte 64) false))]
    (if done
      [byte]
      (b4-vector-append [(+ byte 128)] (b4-s32-leb next)))))

(defn b4-section
  [section-id payload]
  (b4-vector-append
   [section-id]
   (b4-vector-append (b4-u32-leb (count payload)) payload)))

(defn b4-collect-operations
  [blocks block-order result]
  (if (= (count block-order) 0)
    result
    (b4-collect-operations
     blocks
     (rest block-order)
     (b4-vector-append
      result (get (get blocks (first block-order)) :instructions)))))

(defn b4-block-order
  [mir function]
  (let [entry (get function :entry)
        blocks (get function :blocks)
        entry-block (get blocks entry)
        successors (get entry-block :successors)]
    (if (= (count blocks) 1)
      [entry]
      [entry
       (first successors)
       (second successors)
       (get (get (get mir :control-flow-graph) :join) :block-id)])))

(defn b4-index-operations
  [operations index result]
  (if (= (count operations) 0)
    result
    (b4-index-operations
     (rest operations) (+ index 1)
     (assoc result (get (first operations) :op-id) index))))

(defn b4-find-operation
  [operations operation-id]
  (if (= (count operations) 0)
    nil
    (if (= operation-id (get (first operations) :op-id))
      (first operations)
      (b4-find-operation (rest operations) operation-id))))

(defn b4-forwarded-opcode?
  [opcode]
  (if (= opcode :local)
    true
    (if (= opcode :local-binding)
      true
      (if (= opcode :sequence)
        true
        (if (= opcode :lexical-scope)
          true
          (if (= opcode :function-boundary) true false))))))

(defn b4-scalar-type?
  [type]
  (if (= type :gravity/integer)
    true
    (if (= type :gravity/bool)
      true
      (if (= type :gravity/nil) true false))))

(defn b4-reference-before?
  [operation-index operation-id reference-id]
  (if (contains? operation-index reference-id)
    (< (get operation-index reference-id)
       (get operation-index operation-id))
    false))

(defn b4-all-references-before?
  [operation-index operation-id references]
  (if (= (count references) 0)
    true
    (if (b4-reference-before?
         operation-index operation-id (first references))
      (b4-all-references-before?
       operation-index operation-id (rest references))
      false)))

(defn b4-constant-value
  [operation]
  (let [type (get operation :type)
        payload (get operation :constant-payload)
        value (get payload :value)]
    (if (= payload {:present? true :value value})
      (if (= type :gravity/bool)
        (if (boolean? value) (if value 1 0) :unsupported)
        (if (= type :gravity/nil)
          (if (= value nil) 0 :unsupported)
          (if (= type :gravity/integer)
            (if (integer? value)
              (if (>= value -2147483648)
                (if (<= value 2147483647) value :unsupported)
                :unsupported)
              :unsupported)
            :unsupported)))
      :unsupported)))

(defn b4-operation-reason
  [operation operations operation-index]
  (let [opcode (get operation :opcode)
        operands (get operation :operands)
        operation-id (get operation :op-id)]
    (if (= (get operation :artifact) :gravity/mir-operation)
      (if (= (get operation :verifier-status) :passed)
        (if (= (get operation :effects) #{})
          (if (= (get operation :capabilities) #{})
            (if (= (get operation :domain-anchor) nil)
              (if (contains? operation-index operation-id)
                (if (= opcode :constant)
                  (if (if (= (count operands) 0)
                        (if (= (b4-constant-value operation) :unsupported)
                          false true)
                        false)
                    (if (b4-scalar-type? (get operation :type))
                      nil :constant-scalar-type)
                    :bounded-i32-constant)
                  (if (b4-forwarded-opcode? opcode)
                    (if (> (count operands) 0)
                      (if (b4-all-references-before?
                           operation-index operation-id operands)
                        (let [source-operation
                              (b4-find-operation operations (b4-last operands))]
                          (if (= opcode :function-boundary)
                            (if (b4-scalar-type?
                                 (get source-operation :type))
                              nil :function-boundary-source-type)
                            (if (if (b4-scalar-type?
                                     (get operation :type))
                                  (= (get operation :type)
                                     (get source-operation :type))
                                  false)
                              nil :forwarded-type-parity)))
                        :forwarded-definition-order)
                      :forwarded-arity)
                    (if (= opcode :truthiness)
                      (if (= (count operands) 1)
                        (if (b4-reference-before?
                             operation-index operation-id (first operands))
                          (let [source-operation
                                (b4-find-operation operations (first operands))]
                            (if (if (b4-scalar-type?
                                     (get source-operation :type))
                                  (= (get operation :type) :gravity/bool)
                                  false)
                              nil :truthiness-type-parity))
                          :truthiness-definition-order)
                        :truthiness-arity)
                      (if (= opcode :conditional-join)
                        (if (= (count operands) 3)
                          (if (b4-all-references-before?
                               operation-index operation-id operands)
                            (let [condition
                                  (b4-find-operation operations (first operands))
                                  then-value
                                  (b4-find-operation operations (second operands))
                                  else-value
                                  (b4-find-operation operations (b4-last operands))]
                              (if (if (= (get condition :type) :gravity/bool)
                                    (if (b4-scalar-type?
                                         (get operation :type))
                                      (if (= (get then-value :type)
                                             (get else-value :type))
                                        (= (get operation :type)
                                           (get then-value :type))
                                        false)
                                      false)
                                    false)
                                nil :conditional-type-parity))
                            :conditional-definition-order)
                          :conditional-arity)
                        :unsupported-opcode))))
                :operation-index-closure)
              :domain-anchor-unsupported)
            :capabilities-unsupported)
          :effects-unsupported)
        :unverified-operation)
      :operation-envelope)))

(defn b4-first-operation-rejection
  [remaining operations operation-index]
  (if (= (count remaining) 0)
    nil
    (let [operation (first remaining)
          reason (b4-operation-reason operation operations operation-index)]
      (if (= reason nil)
        (b4-first-operation-rejection
         (rest remaining) operations operation-index)
        {:reason reason
         :operation-id (get operation :op-id)
         :opcode (get operation :opcode)
         :type (get operation :type)}))))

(defn b4-count-opcode
  [operations opcode total]
  (if (= (count operations) 0)
    total
    (b4-count-opcode
     (rest operations) opcode
     (if (= (get (first operations) :opcode) opcode)
       (+ total 1) total))))

(defn b4-cfg-reason
  [mir function block-order operations]
  (let [blocks (get function :blocks)
        cfg (get mir :control-flow-graph)
        entry-id (first block-order)
        entry (get blocks entry-id)]
    (if (= (set (keys cfg)) #{:entry :edges :dominance :join})
      (if (= (get cfg :entry) entry-id)
        (if (= (set (keys blocks)) (set block-order))
          (if (= (count block-order) 1)
            (if (if (= (get entry :predecessors) [])
                  (if (= (get entry :successors) [])
                    (if (= (get (get entry :terminator) :kind) :return)
                      (if (= (get cfg :join) nil)
                        (= (b4-count-opcode operations :conditional-join 0) 0)
                        false)
                      false)
                    false)
                  false)
              nil :linear-cfg-envelope)
            (let [then-id (second block-order)
                  else-id (first (rest (rest block-order)))
                  join-id (b4-last block-order)
                  then-block (get blocks then-id)
                  else-block (get blocks else-id)
                  join-block (get blocks join-id)]
              (if (if (= (get entry :successors) [then-id else-id])
                    (if (= (get then-block :predecessors) [entry-id])
                      (if (= (get then-block :successors) [join-id])
                        (if (= (get else-block :predecessors) [entry-id])
                          (if (= (get else-block :successors) [join-id])
                            (if (= (get join-block :predecessors)
                                   [then-id else-id])
                              (if (= (get join-block :successors) [])
                                (if (= (get (get entry :terminator) :kind)
                                       :conditional-branch)
                                  (if (= (get (get then-block :terminator) :kind)
                                         :branch)
                                    (if (= (get (get else-block :terminator) :kind)
                                           :branch)
                                      (if (= (get (get join-block :terminator) :kind)
                                             :return)
                                        (if (= (get (get cfg :join) :block-id)
                                               join-id)
                                          (= (b4-count-opcode
                                              operations :conditional-join 0) 1)
                                          false)
                                        false)
                                      false)
                                    false)
                                  false)
                                false)
                              false)
                            false)
                          false)
                        false)
                      false)
                    false)
                nil :diamond-cfg-envelope)))
          :block-order-coverage)
        :cfg-entry-parity)
      :exact-cfg-envelope)))

(defn b4-local-get
  [operation-index operation-id]
  (b4-vector-append [32] (b4-u32-leb (get operation-index operation-id))))

(defn b4-local-set
  [operation-index operation-id]
  (b4-vector-append [33] (b4-u32-leb (get operation-index operation-id))))

(defn b4-operation-bytes
  [operation operations operation-index]
  (let [opcode (get operation :opcode)
        operation-id (get operation :op-id)
        operands (get operation :operands)
        value-bytes
        (if (= opcode :constant)
          (b4-vector-append
           [65] (b4-s32-leb (b4-constant-value operation)))
          (if (b4-forwarded-opcode? opcode)
            (b4-local-get operation-index (b4-last operands))
            (if (= opcode :truthiness)
              (let [operand-id (first operands)
                    operand (b4-find-operation operations operand-id)
                    operand-type (get operand :type)]
                (if (= operand-type :gravity/bool)
                  (b4-local-get operation-index operand-id)
                  (if (= operand-type :gravity/nil) [65 0] [65 1])))
              (if (= opcode :conditional-join)
                (b4-vector-append
                 (b4-local-get operation-index (first operands))
                 (b4-vector-append
                  [4 127]
                  (b4-vector-append
                   (b4-local-get operation-index (second operands))
                   (b4-vector-append
                    [5]
                    (b4-vector-append
                     (b4-local-get operation-index (b4-last operands))
                     [11])))))
                []))))]
    (b4-vector-append
     value-bytes (b4-local-set operation-index operation-id))))

(defn b4-operation-stream
  [remaining operations operation-index result]
  (if (= (count remaining) 0)
    result
    (b4-operation-stream
     (rest remaining) operations operation-index
     (b4-vector-append
      result (b4-operation-bytes
              (first remaining) operations operation-index)))))

(defn b4-without-opcode
  [operations opcode result]
  (if (= (count operations) 0)
    result
    (b4-without-opcode
     (rest operations) opcode
     (if (= (get (first operations) :opcode) opcode)
       result
       (conj result (first operations))))))

(defn b4-find-opcode
  [operations opcode]
  (if (= (count operations) 0)
    nil
    (if (= (get (first operations) :opcode) opcode)
      (first operations)
      (b4-find-opcode (rest operations) opcode))))

(defn b4-function-instructions
  [function block-order operations operation-index]
  (let [blocks (get function :blocks)]
    (if (= (count block-order) 1)
      (let [entry (get blocks (first block-order))
            return-id (first (get (get entry :terminator) :operands))]
        (b4-vector-append
         (b4-operation-stream operations operations operation-index [])
         (b4-local-get operation-index return-id)))
      (let [entry (get blocks (first block-order))
            then-block (get blocks (second block-order))
            else-block (get blocks (first (rest (rest block-order))))
            join-block (get blocks (b4-last block-order))
            entry-operations (get entry :instructions)
            then-operations (get then-block :instructions)
            else-operations (get else-block :instructions)
            join-operations (get join-block :instructions)
            join-operation (b4-find-opcode join-operations :conditional-join)
            remaining-join
            (b4-without-opcode join-operations :conditional-join [])
            condition-id (first (get (get entry :terminator) :operands))
            then-id (first (get (get then-block :terminator) :operands))
            else-id (first (get (get else-block :terminator) :operands))
            return-id (first (get (get join-block :terminator) :operands))
            entry-bytes
            (b4-operation-stream
             entry-operations operations operation-index [])
            then-bytes
            (b4-operation-stream
             then-operations operations operation-index [])
            else-bytes
            (b4-operation-stream
             else-operations operations operation-index [])
            join-bytes
            (b4-operation-stream
             remaining-join operations operation-index [])]
        (b4-vector-append
         entry-bytes
         (b4-vector-append
          (b4-local-get operation-index condition-id)
          (b4-vector-append
           [4 127]
           (b4-vector-append
            then-bytes
            (b4-vector-append
             (b4-local-get operation-index then-id)
             (b4-vector-append
              [5]
              (b4-vector-append
               else-bytes
               (b4-vector-append
                (b4-local-get operation-index else-id)
                (b4-vector-append
                 [11]
                 (b4-vector-append
                  (b4-local-set operation-index
                                (get join-operation :op-id))
                  (b4-vector-append
                   join-bytes
                   (b4-local-get operation-index return-id))))))))))))))))

(defn b4-semantic-value
  [operation operations values]
  (let [opcode (get operation :opcode)
        operands (get operation :operands)]
    (if (= opcode :constant)
      (let [value (get (get operation :constant-payload) :value)]
        (if (= value true) 1 (if (= value false) 0 (if (= value nil) 0 value))))
      (if (b4-forwarded-opcode? opcode)
        (get values (b4-last operands))
        (if (= opcode :truthiness)
          (let [operand-id (first operands)
                operand (b4-find-operation operations operand-id)]
            (if (= (get operand :type) :gravity/nil)
              0
              (if (= (get operand :type) :gravity/bool)
                (get values operand-id) 1)))
          (if (= opcode :conditional-join)
            (if (= (get values (first operands)) 0)
              (get values (b4-last operands))
              (get values (second operands)))
            nil))))))

(defn b4-evaluate-operations
  [remaining operations values]
  (if (= (count remaining) 0)
    values
    (let [operation (first remaining)]
      (b4-evaluate-operations
       (rest remaining) operations
       (assoc values (get operation :op-id)
              (b4-semantic-value operation operations values))))))

(defn b4-rejected
  [diagnostic reason subject]
  {:status :rejected
   :diagnostic diagnostic
   :missing-fact reason
   :operation-id (get subject :operation-id)
   :opcode (get subject :opcode)
   :type (get subject :type)})

(defn b4-build-bounded-wasm32-core
  [mir]
  (if (if (= (get mir :artifact) :gravity/mir-module)
        (if (= (get mir :verification-status) :passed)
          (if (= (get mir :profile) :hosted)
            (if (= (get mir :target-request) :wasm)
              (if (= (get mir :target-independent?) true)
                (if (= (get mir :source-target) :jvm)
                  (if (= (get mir :globals) {})
                    (= (set (keys (get mir :functions))) #{(quote main)})
                    false)
                  false)
                false)
              false)
            false)
          false)
        false)
    (let [function (get (get mir :functions) (quote main))
          blocks (get function :blocks)
          block-order (b4-block-order mir function)
          operations (b4-collect-operations blocks block-order [])
          operation-index (b4-index-operations operations 0 {})
          function-reason
          (if (= (get function :artifact) :gravity/mir-function)
            (if (= (get function :name) (quote main))
              (if (= (get function :params) [])
                (if (= (get function :latent-effects) #{})
                  (if (= (get function :capabilities) #{})
                    (if (if (= (count blocks) 1)
                          true
                          (= (count blocks) 4))
                      nil :bounded-block-count)
                    :function-capabilities)
                  :function-effects)
                :zero-parameter-function)
              :main-function-name)
            :mir-function-envelope)
          cfg-reason
          (if (= function-reason nil)
            (b4-cfg-reason mir function block-order operations)
            nil)
          rejection
          (if (= function-reason nil)
            (if (= cfg-reason nil)
              (if (if (> (count operations) 0)
                    (if (<= (count operations) 127)
                      (= (count operations) (count operation-index))
                      false)
                    false)
                (b4-first-operation-rejection
                 operations operations operation-index)
                {:reason :bounded-unique-operation-count})
              {:reason cfg-reason})
            {:reason function-reason})]
      (if (= rejection nil)
        (let [return-block (get blocks (b4-last block-order))
              return-terminator (get return-block :terminator)
              return-id (first (get return-terminator :operands))
              local-declarations
              (b4-vector-append
               [1] (b4-vector-append
                    (b4-u32-leb (count operations)) [127]))
              instruction-bytes
              (b4-function-instructions
               function block-order operations operation-index)
              body
              (b4-vector-append
               local-declarations
               (b4-vector-append
                instruction-bytes
                [11]))
              type-section (b4-section 1 [1 96 0 1 127])
              function-section (b4-section 3 [1 0])
              export-section (b4-section 7 [1 4 109 97 105 110 0 0])
              code-entry
              (b4-vector-append (b4-u32-leb (count body)) body)
              code-section
              (b4-section 10 (b4-vector-append [1] code-entry))
              bytes
              (b4-vector-append
               [0 97 115 109 1 0 0 0]
               (b4-vector-append
                type-section
                (b4-vector-append
                 function-section
                 (b4-vector-append export-section code-section))))
              values (b4-evaluate-operations operations operations {})]
          {:artifact :gravity/b4-bounded-wasm32-core-lowering
           :status :constructed-unverified
           :source-mir-id (get mir :module-id)
           :target :wasm32-unknown-unknown
           :target-kind :core-module
           :features #{}
           :abi {:parameters [] :result :i32}
           :imports []
           :exports [{:name "main" :kind :function :index 0}]
           :memory nil
           :table nil
           :globals []
           :start nil
           :data []
           :custom-sections []
           :runtime-helpers []
           :component-model? false
           :wit? false
           :wasi? false
           :block-order block-order
           :operation-index operation-index
           :wasm-bytes bytes
           :expected-result (get values return-id)
           :diagnostics []
           :clojure-seed-boundary? true
           :self-hosted? false})
        (b4-rejected "B1-UNSUPPORTED" (get rejection :reason) rejection)))
    (b4-rejected "B1-INPUT" :verified-bounded-wasm-mir {})))

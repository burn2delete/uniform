(defn w5-b14-suite-manifest
  []
  {:artifact :gravity/backend-conformance-suite
   :schema-version 1
   :required-backends w5-b14-required-backends
   :checks w5-b14-checks
   :inputs w5-b14-inputs
   :rejects w5-b14-rejects
   :supported-target w5-b14-supported-target
   :supported-platform w5-b14-supported-platform
   :covered-backends #{:llvm}
   :coverage-status :incomplete
   :release-ready? false
   :candidate-target-evidence w5-b14-candidate-target-evidence
   :authority :non-authority})

(defn w5-b14-fixture-entry
  [family]
  {:family family
   :fixture-id (str "w5-b14/" (str family))
   :target w5-b14-supported-target
   :backend :llvm
   :expected-artifacts w5-b14-expected-artifacts
   :expected-metadata w5-b14-expected-metadata
   :status (if (contains? w5-b14-pending-fixture-families family)
             :pending
             :covered)})

(defn w5-b14-fixture-matrix-from
  [families index result]
  (if (= index (count families))
    result
    (w5-b14-fixture-matrix-from
     families (+ index 1)
     (conj result (w5-b14-fixture-entry (get families index))))))

(defn w5-b14-fixture-matrix
  []
  (w5-b14-fixture-matrix-from w5-b14-fixture-family-values 0 []))

(defn w5-b14-target-record
  [backend]
  (if (= backend :llvm)
    {:backend :llvm
     :target :llvm-x86_64-linux
     :available? true
     :availability :available
     :evidence :exact
     :shared-manifest-tests :run
     :positive-tests :run
     :negative-tests :run
     :skip-status :none}
    {:backend backend
     :target :unsupported
     :available? false
     :availability :not-provided
     :evidence :none
     :shared-manifest-tests :run
     :positive-tests :not-run
     :negative-tests :run
     :skip-status :explicit-unavailable}))

(defn w5-b14-target-records-from
  [backends index result]
  (if (= index (count backends))
    result
    (w5-b14-target-records-from
     backends (+ index 1)
     (conj result (w5-b14-target-record (get backends index))))))

(defn w5-b14-target-availability
  []
  {:artifact :gravity/backend-target-availability-matrix
   :candidate-target w5-b14-supported-target
   :candidate-platform w5-b14-supported-platform
   :targets (w5-b14-target-records-from
             w5-b14-required-backend-values 0 [])
   :unsupported-platforms w5-b14-unsupported-platform-values
   :unsupported-targets w5-b14-unsupported-target-values
   :unsupported-target-policies w5-b14-unsupported-target-policies
   :unsupported-skips []
   :cross-target-inference? false
   :status :incomplete
   :coverage-status :incomplete})

(defn w5-b14-positive-entry
  [family]
  {:backend :llvm
   :target w5-b14-supported-target
   :fixture-id (str "w5-b14/positive/" (str family))
   :status :passed
   :lowering :passed
   :execution :not-required-static-only
   :shared-manifest :validated
   :metadata :preserved
   :artifact-id (str "sha256:w5-b14-artifact-" (str family))})

(defn w5-b14-positive-results-from
  [families index result]
  (if (= index (count families))
    result
    (w5-b14-positive-results-from
     families (+ index 1)
     (conj result (w5-b14-positive-entry (get families index))))))

(defn w5-b14-positive-results
  []
  (w5-b14-positive-results-from
   w5-b14-covered-fixture-family-values 0 []))

(defn w5-b14-negative-entry
  [diagnostic]
  {:diagnostic diagnostic
   :fixture-id diagnostic
   :expected diagnostic
   :actual diagnostic
   :status :matched
   :source-span {:source-id (str "sha256:w5-b14-negative-" diagnostic)
                 :start-byte 0
                 :end-byte 1}
   :target w5-b14-supported-target})

(defn w5-b14-negative-results-from
  [diagnostics index result]
  (if (= index (count diagnostics))
    result
    (w5-b14-negative-results-from
     diagnostics (+ index 1)
     (conj result (w5-b14-negative-entry (get diagnostics index))))))

(defn w5-b14-negative-results
  []
  (w5-b14-negative-results-from w5-b14-diagnostic-values 0 []))

(defn w5-b14-differential-entry
  [family]
  {:backend :llvm
   :target w5-b14-supported-target
   :fixture-id (str "w5-b14/differential/" (str family))
   :reference-id (str "sha256:w5-b14-semantic-" (str family))
   :observed-id (str "sha256:w5-b14-semantic-" (str family))
   :status :matched
   :execution :not-required-static-only})

(defn w5-b14-differential-results-from
  [families index result]
  (if (= index (count families))
    result
    (w5-b14-differential-results-from
     families (+ index 1)
     (conj result (w5-b14-differential-entry (get families index))))))

(defn w5-b14-differential-results
  []
  {:artifact :gravity/backend-semantic-comparison-results
   :status :passed
   :method :artifact-shape-and-semantic-identity
   :reference :mir-or-domain-reference
   :comparisons (w5-b14-differential-results-from
                 w5-b14-covered-fixture-family-values 0 [])
   :replay-id "sha256:w5-b14-differential-replay-v1"})


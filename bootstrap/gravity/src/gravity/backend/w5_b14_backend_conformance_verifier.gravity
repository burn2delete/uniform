; W5 Wave2 B14 backend conformance verifier.
; This is a bounded, deterministic, static-only stage2 leaf.  It verifies
; conformance records supplied as data; it does not run a backend, infer a
; target from the host, or claim Phase 7 completion.
(ns gravity.backend.w5-b14-backend-conformance-verifier
  (:profile :meta)
  ; The stage2 compiler-plan harness currently accepts :jvm for Gravity
  ; namespaces.  Candidate target evidence remains data-bounded to LLVM.
  (:target :jvm)
  (:exports [w5-b14-policy
             w5-b14-diagnostic-catalog
             w5-b14-suite-manifest
             w5-b14-fixture-matrix
             w5-b14-target-availability
             w5-b14-positive-results
             w5-b14-negative-results
             w5-b14-differential-results
             w5-b14-metadata-report
             w5-b14-artifact-report
             w5-b14-nondeterminism-record
             w5-b14-skip-report
             w5-b14-risk-coverage
             w5-b14-evidence-pack
             w5-b14-diagnostic-stream
             w5-b14-identity-input
             w5-b14-differential-entry-valid?
             w5-b14-differential-entries-valid?
             w5-b14-record-links-valid?
             w5-b14-conformance-execute
             w5-b14-backend-conformance
             w5-b14-conformance
             w5-b14-execute
             w5-b14-run
             w5-b14-verify
             w5-b14-recompute
             w5-b14-verify-result])
  (:effects #{})
  (:capabilities #{})
  (:safety :safe)
  (:metadata
   {:bootstrap
    {:stage :stage2
     :component :w5-b14-backend-conformance-verifier
     :owner :w5
     :source-language :gravity
     :seed :clojure-stage0
     :status :executable-leaf
     :scope :stage-owned-nonauthority
     :static-only? true
     :clojure-seed-boundary? true
     :self-hosted? false
     :release? false
     :public-authority? false
     :authority :non-authority
     :candidate-target :llvm-x86_64-linux
     :candidate-platform {:os :linux
                          :arch :x86_64
                          :backend :llvm
                          :object-format :elf
                          :abi :sysv-amd64}
     :unsupported-platforms [:darwin :darwin-arm64 :darwin-x86_64 :windows]
     :unsupported-targets [:darwin :darwin-arm64 :darwin-x86_64 :windows]
     :unsupported-target-policies
     [{:target :darwin :support :unsupported
       :invokes-clojure? false :links-jvm? false :fallback? false}
      {:target :darwin-arm64 :support :unsupported
       :invokes-clojure? false :links-jvm? false :fallback? false}
      {:target :darwin-x86_64 :support :unsupported
       :invokes-clojure? false :links-jvm? false :fallback? false}
      {:target :windows :support :unsupported
       :invokes-clojure? false :links-jvm? false :fallback? false}]
     :cross-target-inference? false
     :darwin-fallback? false
     :candidate-invokes-clojure? false
     :candidate-links-jvm? false
     :candidate-fallback? false
     :no-fallback? true
     :residual-boundaries {:stage2-compiler-plan :clojure-bootstrap
                           :stage2-runtime :jvm
                           :target-toolchain :not-executed
                           :filesystem-authority false
                           :network-authority false
                           :process-authority false}
     :target-scope {:target :llvm-x86_64-linux
                    :os :linux
                    :arch :x86_64
                    :backend :llvm
                    :object-format :elf
                    :abi :sysv-amd64
                    :runtime :none
                    :providers #{}
                    :runtime-providers #{}
                    :unsupported-targets [:darwin :darwin-arm64
                                          :darwin-x86_64 :windows]
                    :unsupported-target-policies
                    [{:target :darwin :support :unsupported
                      :invokes-clojure? false :links-jvm? false :fallback? false}
                     {:target :darwin-arm64 :support :unsupported
                      :invokes-clojure? false :links-jvm? false :fallback? false}
                     {:target :darwin-x86_64 :support :unsupported
                      :invokes-clojure? false :links-jvm? false :fallback? false}
                     {:target :windows :support :unsupported
                      :invokes-clojure? false :links-jvm? false :fallback? false}]
                    :darwin-supported? false
                    :cross-target-inference? false
                    :darwin-fallback? false
                    :candidate-invokes-clojure? false
                    :candidate-links-jvm? false
                    :candidate-fallback? false
                    :no-fallback? true}
     :governing-documents ["B14" "B13" "B1" "C11" "C12"
                           "C14" "C18" "D1" "D2" "D3"
                           "D8" "D9" "BOOT1" "BOOT3" "BOOT8"]
     :does-not-claim [:all-phase7-backends
                      :backend-execution
                      :cross-target-inference
                      :darwin-support
                      :release-readiness
                      :self-hosting-completion]}}))

(def w5-b14-required-backend-values
  [:c :llvm :wasm :jvm :js-ts :mlir :gpu :hdl
   :workflow-graph :query-relational :mobile])

(def w5-b14-required-backends
  #{:c :llvm :wasm :jvm :js-ts :mlir :gpu :hdl
    :workflow-graph :query-relational :mobile})

(def w5-b14-fixture-family-values
  [:pure-values :arithmetic :numeric-modes :records :structs :tuples
   :tagged-unions :closures :calls :pattern-matching :loops
   :runtime-checks :allocation :regions :linear-resources
   :ownership-aliasing :ffi-host-interop :atomics-synchronization
   :source-maps :efir-domain :gpu-kernels :hardware-circuits
   :workflow-graphs :relational-queries :mobile-ui-boundaries
   :artifact-manifests :provenance-graphs :errors :ai-tool-calls :schemas])

(def w5-b14-covered-fixture-family-values
  [:pure-values :arithmetic :numeric-modes :records :structs :tuples
   :tagged-unions :closures :calls :pattern-matching :loops
   :runtime-checks :allocation :regions :linear-resources
   :ownership-aliasing :ffi-host-interop :atomics-synchronization
   :source-maps :efir-domain :gpu-kernels :hardware-circuits
   :workflow-graphs :relational-queries :mobile-ui-boundaries
   :artifact-manifests :provenance-graphs])

(def w5-b14-pending-fixture-families
  #{:errors :ai-tool-calls :schemas})

(def w5-b14-required-fixture-families
  #{:pure-values :arithmetic :numeric-modes :records :structs :tuples
    :tagged-unions :closures :calls :pattern-matching :loops
    :runtime-checks :allocation :regions :linear-resources
    :ownership-aliasing :ffi-host-interop :atomics-synchronization
    :source-maps :efir-domain :gpu-kernels :hardware-circuits
    :workflow-graphs :relational-queries :mobile-ui-boundaries
    :artifact-manifests :provenance-graphs :errors :ai-tool-calls :schemas})

(def w5-b14-diagnostic-values
  ["B14-COVERAGE" "B14-TARGET" "B14-POSITIVE" "B14-NEGATIVE"
   "B14-DIFFERENTIAL" "B14-METADATA" "B14-ARTIFACT"
   "B14-NONDETERMINISM" "B14-SKIP" "B14-EVIDENCE"])

(def w5-b14-diagnostic-set
  #{"B14-COVERAGE" "B14-TARGET" "B14-POSITIVE" "B14-NEGATIVE"
    "B14-DIFFERENTIAL" "B14-METADATA" "B14-ARTIFACT"
    "B14-NONDETERMINISM" "B14-SKIP" "B14-EVIDENCE"})


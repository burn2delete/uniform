              (let [base (+ 2 (get counts 0) (get counts 1))]
                (if (> base limit)
                  {:status :rejected :reason :keyword-set-equality-work-limit :work-count base
                   :work-count-kind :logical-domain-reservation-including-failed-attempt :comparison-attempts 0}

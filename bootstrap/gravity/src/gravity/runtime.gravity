                        domain-reason (if strings? :string-set-value-domain-required :keyword-set-value-domain-required)]
                    (if (= :accepted (get validated :status))
                      (loop [side 0 used base units []]
                        (if (= side 2)
                          (let [result {:status :accepted :work-count used :operand-counts counts :representation-units units
                                        :work-count-kind :exact-logical-domain-reservation :comparison-attempts 0}]
                            (if strings? (assoc result :comparison-domain :string-set) result))
                          (let [width (get counts side)
                                measured (loop [remaining (get values side) index 0 work used content 0]
                                           (if (= index width)
                                             {:status :accepted :work-count work :representation-units content}
                                             (let [size (if strings? (count (first remaining)) (count (str (first remaining))))]

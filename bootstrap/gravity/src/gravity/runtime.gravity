              (recur (first result) (second result))
              [{:diagnostic "P15S23X002" :reason :unmatched-function-recur} (second result) :rejected]) result))))
    [{:diagnostic "P15S23X002" :reason :invalid-function-activation} output :rejected]))

(defn p15-s23-runtime-evaluate-call [instruction environment output functions path targets pool]
  (let [arguments (p15-s23-runtime-evaluate-arguments-in-context (get instruction :args) environment output [] functions path [] pool)]

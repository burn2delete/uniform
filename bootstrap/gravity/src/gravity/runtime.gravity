              (if (if (= 0 (count pending)) (= functions-seen (set (keys functions))) false)
                {:status :accepted :work-count used :definitions definitions :initializers out :module (get manifest :module)}
                {:status :rejected :reason :module-initialization-census :work-count used})
              (let [root (first remaining) id (get root :binding-id) name (get root :name)
                    def-id (get root :definition-core-node-id) value-id (get root :value-core-node-id)
                    function? (= :function (get root :kind)) initializer (first pending)
                    function (get functions name)
                    record? (if (map? root)
                              (= #{:ordinal :kind :name :visibility :binding-id :definition-core-node-id :definition-syntax-id
                                   :definition-source :value-core-node-id :value-source :type} (set (keys root))) false)]
                (if (if record?
                      (if (= ordinal (get root :ordinal))
                        (if (contains? #{:function :literal} (get root :kind))

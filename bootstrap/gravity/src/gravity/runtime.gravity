; Development evaluator implementation; namespace declarations do not grant authority.
(ns gravity.runtime
  (:profile :hosted)
  (:target :jvm)
  (:exports [p15-s23-runtime-execute-closed-plan
             p15-s23-runtime-evaluate-closed-instruction
             p15-s23-runtime-evaluate-in-context
             p15-s23-runtime-activate-function])
  (:effects #{:memory/allocate})
  (:capabilities #{:memory/allocator}))

; The local evaluator keeps private state as [value output control], where
; control is :normal, :thrown, :rejected, or :recur. The latter adds a fourth
; target-ID position and carries ordered slot values. Payloads never select control.
; This development control representation is not a target error ABI. Output is a
; Gravity string accumulator rather than a host writer, which preserves empty
; strings, embedded NULs, and Unicode bytes until a target adapter performs the
; declared :io/write operation.
(defn p15-s23-runtime-evaluate-arguments
  [arguments environment output values]
  (p15-s23-runtime-evaluate-arguments-in-context arguments environment output values {} [] []))

(defn p15-s23-runtime-evaluate-arguments-in-context
  [arguments environment output values functions path targets]
  (if (= (count arguments) 0)
    [values output :normal]
    (let [head-result
          (p15-s23-runtime-evaluate-with-targets
           (first arguments) environment output functions path targets)]
      (if (= :normal (get head-result 2))
        (p15-s23-runtime-evaluate-arguments-in-context
         (rest arguments) environment (second head-result)
         (conj values (first head-result)) functions path targets)
        head-result))))

(defn p15-s23-runtime-println-output
  [values output]
  (if (= (count values) 0)
    (str output "\n")
    (if (= (count values) 1)
      (str output (str (first values)) "\n")
      (p15-s23-runtime-println-output
       (rest values)
       (str output (str (first values)) " ")))))

(defn p15-s23-runtime-evaluate-bindings
  [bindings environment output]
  (p15-s23-runtime-evaluate-bindings-in-context bindings environment output {} [] []))

(defn p15-s23-runtime-evaluate-bindings-in-context
  [bindings environment output functions path targets]
  (if (= (count bindings) 0)
    [environment output :normal]
    (let [binding (first bindings)
          value-result
          (p15-s23-runtime-evaluate-with-targets
           (get binding :expr) environment output functions path [])]
      (if (= :normal (get value-result 2))
        (p15-s23-runtime-evaluate-bindings-in-context
         (rest bindings)
         (assoc environment (get binding :name) (first value-result))
         (second value-result) functions path targets)
        value-result))))

(defn p15-s23-runtime-evaluate-sequence
  [instructions environment output]
  (p15-s23-runtime-evaluate-sequence-in-context instructions environment output {} [] []))

(defn p15-s23-runtime-evaluate-sequence-in-context
  [instructions environment output functions path targets]
  (if (= (count instructions) 0)
    [nil output :normal]
    (let [head-result
          (p15-s23-runtime-evaluate-with-targets
           (first instructions) environment output functions path (if (= 1 (count instructions)) targets []))]
      (if (if (= :normal (get head-result 2)) (= (count instructions) 1) true)
        head-result
        (p15-s23-runtime-evaluate-sequence-in-context
         (rest instructions) environment (second head-result) functions path targets)))))

(defn p15-s23-runtime-typed-handlers-valid? [instruction]
  (if (= #{:op :protected :handlers} (set (keys instruction)))
    (if (map? (get instruction :protected))
      (if (vector? (get instruction :handlers))
        (if (if (> (count (get instruction :handlers)) 0) (<= (count (get instruction :handlers)) 65536) false)
          (loop [remaining (get instruction :handlers)]
            (if (= 0 (count remaining)) true
              (let [handler (first remaining)]
                (if (map? handler)
                  (if (= #{:type :name :body} (set (keys handler)))
                    (if (contains? #{:gravity.type/bool :gravity.type/string :gravity.type/symbol :gravity.type/keyword} (get handler :type))
                      (if (symbol? (get handler :name))
                        (if (map? (get handler :body)) (recur (rest remaining)) false) false) false) false) false)))) false) false) false) false))

(defn p15-s23-runtime-atomic-error-match? [type value]
  (if (= type :gravity.type/bool) (if (= true value) true (= false value))
    (if (= type :gravity.type/string) (string? value)
      (if (= type :gravity.type/symbol) (symbol? value)
        (if (= type :gravity.type/keyword) (keyword? value) false)))))

(defn p15-s23-runtime-select-typed-handler [handlers result environment]
  (p15-s23-runtime-select-handler-in-context handlers result environment {} [] []))

(defn p15-s23-runtime-select-handler-in-context [handlers result environment functions path targets]
  (loop [remaining handlers]
    (if (= 0 (count remaining)) result
      (let [handler (first remaining)]
        (if (p15-s23-runtime-atomic-error-match? (get handler :type) (first result))
          (p15-s23-runtime-evaluate-with-targets (get handler :body)
            (assoc environment (get handler :name) (first result)) (second result) functions path [])
          (recur (rest remaining)))))))

(defn p15-s23-runtime-evaluate-closed-instruction
  [instruction environment output]
  (p15-s23-runtime-evaluate-in-context instruction environment output {} []))

(defn p15-s23-runtime-function-valid? [function arity]
  (if (map? function)
    (let [params (get function :params []) body (get function :instructions)]
      (if (if (vector? params) (vector? body) false)
        (if (if (<= (count params) 65536)
              (if (> (count body) 0) (<= (count body) 65536) false) false)
          (if (= arity (get function :arity (count params)) (count params))
            (if (if (contains? function :recur-target)
                  (if (string? (get function :recur-target))
                    (if (> (count (get function :recur-target)) 0) (<= (count (get function :recur-target)) 256) false) false) true)
              (loop [remaining params seen #{}]
                (if (= 0 (count remaining))
                  (loop [instructions body]
                    (if (= 0 (count instructions)) true (if (map? (first instructions)) (recur (rest instructions)) false)))
                  (if (symbol? (first remaining))
                    (if (contains? seen (first remaining)) false (recur (rest remaining) (conj seen (first remaining)))) false))) false)
            false) false) false)) false))

(defn p15-s23-runtime-call-target-valid? [instruction functions path]
  (if (map? functions)
  (if (vector? path)
  (if (< (count path) 256)
  (if (symbol? (get instruction :function))
  (if (= false (contains? (set path) (get instruction :function)))
  (let [target (get functions (get instruction :function)) args (get instruction :args)]
    (if (if (map? target) (if (contains? target :params) (contains? target :arity) false) false)
      (if (vector? args) (p15-s23-runtime-function-valid? target (count args)) false) false)) false) false) false) false) false))

(defn p15-s23-runtime-activate-function [function values output functions path]
  ; A backedge restarts this activation, not an ordinary guest call. Rebuilding
  ; the environment from all collected values drops prior body locals and
  ; replaces parameters simultaneously without changing the active call path.
  (if (if (vector? values) (p15-s23-runtime-function-valid? function (count values)) false)
    (let [params (get function :params []) target (get function :recur-target)
          targets (if (= target nil) [] [{:id target :names params}])]
      (loop [arguments values stdout output]
        (let [locals (loop [index 0 out {}]
                       (if (= index (count params)) out
                         (recur (+ index 1) (assoc out (get params index) (get arguments index)))))
              result (p15-s23-runtime-evaluate-sequence-in-context (get function :instructions) locals stdout functions path targets)]
          (if (= :recur (get result 2))
            (if (if (= target (get result 3))
                  (if (vector? (first result)) (= (count params) (count (first result))) false) false)
              (recur (first result) (second result))
              [{:diagnostic "P15S23X002" :reason :unmatched-function-recur} (second result) :rejected]) result))))
    [{:diagnostic "P15S23X002" :reason :invalid-function-activation} output :rejected]))

(defn p15-s23-runtime-evaluate-call [instruction environment output functions path targets]
  (let [arguments (p15-s23-runtime-evaluate-arguments-in-context (get instruction :args) environment output [] functions path [])]
    (if (= :normal (get arguments 2))
      (p15-s23-runtime-activate-function (get functions (get instruction :function)) (first arguments) (second arguments)
        functions (conj path (get instruction :function))) arguments)))

(defn p15-s23-runtime-evaluate-in-context
  [instruction environment output functions path]
  (p15-s23-runtime-evaluate-with-targets instruction environment output functions path []))

(defn p15-s23-runtime-loop-valid? [instruction targets]
  (if (vector? targets)
  (if (< (count targets) 256)
  (if (= #{:op :target :bindings :body} (set (keys instruction)))
  (if (string? (get instruction :target))
  (if (vector? (get instruction :bindings))
  (if (vector? (get instruction :body))
  (if (if (<= (count (get instruction :bindings)) 65536)
        (if (> (count (get instruction :body)) 0) (<= (count (get instruction :body)) 65536) false) false)
    (if (loop [remaining targets]
          (if (= 0 (count remaining)) true
            (if (= (get instruction :target) (get (first remaining) :id)) false (recur (rest remaining)))))
      (loop [remaining (get instruction :bindings)]
        (if (= 0 (count remaining))
          (loop [body (get instruction :body)]
            (if (= 0 (count body)) true (if (map? (first body)) (recur (rest body)) false)))
          (let [binding (first remaining)]
            (if (map? binding)
              (if (= #{:name :expr} (set (keys binding)))
                (if (symbol? (get binding :name)) (if (map? (get binding :expr)) (recur (rest remaining)) false) false) false) false)))) false)
    false) false) false) false) false) false) false))

(defn p15-s23-runtime-recur-valid? [instruction targets]
  (if (vector? targets)
    (if (> (count targets) 0)
      (let [target (get targets (- (count targets) 1))]
        (if (= #{:op :target :args} (set (keys instruction)))
          (if (vector? (get instruction :args))
            (if (vector? (get target :names))
              (if (<= (count (get target :names)) 65536)
                (if (= (get target :id) (get instruction :target))
                  (= (count (get target :names)) (count (get instruction :args))) false) false) false) false) false)) false) false))

(defn p15-s23-runtime-evaluate-loop [instruction environment output functions path targets]
  (let [initial (p15-s23-runtime-evaluate-bindings-in-context (get instruction :bindings) environment output functions path [])
        names (loop [remaining (get instruction :bindings) out []]
                (if (= 0 (count remaining)) out (recur (rest remaining) (conj out (get (first remaining) :name)))))]
    (if (= :normal (get initial 2))
      (loop [current (first initial) stdout (second initial)]
        (let [result (p15-s23-runtime-evaluate-sequence-in-context (get instruction :body) current stdout functions path
                       (conj targets {:id (get instruction :target) :names names}))]
          (if (= :recur (get result 2))
            (if (if (= (get instruction :target) (get result 3))
                  (if (vector? (first result)) (= (count names) (count (first result))) false) false)
              (let [next (loop [index 0 out current]
                           (if (= index (count names)) out
                             (recur (+ index 1) (assoc out (get names index) (get (first result) index)))))]
                (recur next (second result)))
              [{:diagnostic "P15S23X002" :reason :unmatched-local-recur} (second result) :rejected]) result))) initial)))

(defn p15-s23-runtime-evaluate-with-targets
  [instruction environment output functions path targets]
  (let [operation (get instruction :op)
        fields (if (map? instruction) (set (keys instruction)) #{})
        arguments (get instruction :args)
        function (get instruction :function)
        comparison? (contains? '#{= < <= > >=} function)
        shape?
        (if (map? instruction)
          (if (contains? #{:literal :quote} operation) true
          (if (= operation :map-literal)
            (if (= fields #{:op :entries})
              (if (vector? (get instruction :entries))
                (if (<= (count (get instruction :entries)) 65536)
                  (loop [remaining (get instruction :entries) seen #{}]
                    (if (= 0 (count remaining)) true
                      (let [entry (first remaining) key (get entry :key)]
                        (if (if (map? entry) (= #{:key :value} (set (keys entry))) false)
                          (if (if (map? key) (= #{:op :value} (set (keys key))) false)
                            (if (if (= :literal (get key :op)) (keyword? (get key :value)) false)
                              (if (contains? seen (get key :value)) false
                                (if (map? (get entry :value)) (recur (rest remaining) (conj seen (get key :value))) false)) false) false) false)))) false) false) false)
          (if (= operation :vector-literal)
            (if (= fields #{:op :items})
              (if (vector? (get instruction :items))
                (if (<= (count (get instruction :items)) 65536)
                  (loop [remaining (get instruction :items)]
                    (if (= 0 (count remaining)) true
                      (if (map? (first remaining)) (recur (rest remaining)) false))) false) false) false)
          (if (= operation :try) (p15-s23-runtime-typed-handlers-valid? instruction)
          (if (= operation :function-call)
            (if (= fields #{:op :function :args}) (p15-s23-runtime-call-target-valid? instruction functions path) false)
          (if (= operation :loop) (p15-s23-runtime-loop-valid? instruction targets)
          (if (= operation :recur) (p15-s23-runtime-recur-valid? instruction targets)
          (if (= operation :local)
            (if (contains? fields :name)
              (if (symbol? (get instruction :name)) (contains? environment (get instruction :name)) false) false)
          (if (= operation :throw)
            (if (= fields #{:op :value}) (map? (get instruction :value)) false)
          (if (= operation :builtin-call)
            (if (contains? fields :args)
              (if (vector? arguments)
                (if comparison? (= 2 (count arguments))
                  (if (= function 'str) (contains? #{1 2} (count arguments)) false)) false) false)
          (if (= operation :println)
            (if (contains? fields :args)
              (if (vector? arguments)
                (if (= :io/write (get instruction :effect)) (= :io/stdout (get instruction :capability)) false) false) false)
          (if (= operation :do)
            (if (contains? fields :body) (vector? (get instruction :body)) false)
          (if (= operation :if)
            (if (contains? fields :test)
              (if (map? (get instruction :test))
                (if (map? (get instruction :then)) (map? (get instruction :else)) false) false) false)
          (if (= operation :let)
            (if (contains? fields :bindings)
              (if (vector? (get instruction :body))
                (if (vector? (get instruction :bindings))
                  (loop [remaining (get instruction :bindings) seen #{}]
                    (if (= 0 (count remaining)) true
                      (let [binding (first remaining) name (get binding :name)]
                        (if (map? binding)
                          (if (contains? binding :expr)
                            (if (symbol? name)
                              (if (contains? seen name) false
                                (if (map? (get binding :expr)) (recur (rest remaining) (conj seen name)) false)) false) false) false)))) false) false) false)
            false)))))))))))))) false)]
    (if (= false shape?)
      [{:diagnostic "P15S23X002" :reason :invalid-local-runtime-instruction :operation operation} output :rejected]
    (if (= operation :map-literal)
      (let [items (loop [remaining (get instruction :entries) out []]
                    (if (= 0 (count remaining)) out
                      (recur (rest remaining) (conj (conj out (get (first remaining) :key)) (get (first remaining) :value)))))
            result (p15-s23-runtime-evaluate-arguments-in-context items environment output [] functions path [])]
        (if (= :normal (get result 2))
          [(loop [index 0 out {}]
             (if (= index (count (first result))) out
               (recur (+ index 2) (assoc out (get (first result) index) (get (first result) (+ index 1))))))
           (second result) :normal] result))
    (if (= operation :vector-literal)
      (p15-s23-runtime-evaluate-arguments-in-context (get instruction :items) environment output [] functions path [])
    (if (= operation :loop) (p15-s23-runtime-evaluate-loop instruction environment output functions path targets)
    (if (= operation :recur)
      (let [arguments (p15-s23-runtime-evaluate-arguments-in-context (get instruction :args) environment output [] functions path [])]
        (if (= :normal (get arguments 2)) [(first arguments) (second arguments) :recur (get instruction :target)] arguments))
    (if (= operation :function-call) (p15-s23-runtime-evaluate-call instruction environment output functions path targets)
    (if (= operation :try)
      (let [result (p15-s23-runtime-evaluate-with-targets (get instruction :protected) environment output functions path [])]
        (if (= :thrown (get result 2))
          (p15-s23-runtime-select-handler-in-context (get instruction :handlers) result environment functions path []) result))
    (if (= operation :literal)
      [(get instruction :value) output :normal]
      (if (= operation :quote)
        [(get instruction :value) output :normal]
        (if (= operation :local)
          [(get environment (get instruction :name)) output :normal]
          (if (= operation :throw)
            (let [value-result (p15-s23-runtime-evaluate-with-targets (get instruction :value) environment output functions path [])]
              (if (= :normal (get value-result 2))
                [(first value-result) (second value-result) :thrown]
                value-result))
          (if (= operation :builtin-call)
            (let [arguments-result
                  (p15-s23-runtime-evaluate-arguments-in-context
                   arguments environment output [] functions path [])]
              (if (= :normal (get arguments-result 2))
              (let [values (first arguments-result) left (first values) right (second values)]
              (if (if comparison? (if (integer? left) (integer? right) false) true)
              [(if (= function 'str)
                 (if (= (count values) 1)
                   (str left)
                   (str left right))
                 (if (= function '=)
                   (= left right)
                   (if (= function '<)
                     (< left right)
                     (if (= function '<=)
                       (<= left right)
                       (if (= function '>)
                         (> left right)
                         (>= left right))))))
               (second arguments-result) :normal]
               [{:diagnostic "P15S23X002" :reason :invalid-integer-comparison :operation operation}
                (second arguments-result) :rejected]))
              arguments-result))
            (if (= operation :println)
              (let [arguments-result
                    (p15-s23-runtime-evaluate-arguments-in-context
                     (get instruction :args) environment output [] functions path [])]
                (if (= :normal (get arguments-result 2))
                [nil
                 (p15-s23-runtime-println-output
                  (first arguments-result) (second arguments-result)) :normal]
                arguments-result))
              (if (= operation :do)
                (p15-s23-runtime-evaluate-sequence-in-context
                 (get instruction :body) environment output functions path targets)
                (if (= operation :if)
                  (let [test-result
                        (p15-s23-runtime-evaluate-with-targets
                         (get instruction :test) environment output functions path [])]
                    (if (= :normal (get test-result 2))
                    (if (first test-result)
                      (p15-s23-runtime-evaluate-with-targets
                       (get instruction :then)
                       environment
                       (second test-result) functions path targets)
                      (p15-s23-runtime-evaluate-with-targets
                       (get instruction :else)
                       environment
                       (second test-result) functions path targets)) test-result))
                  (if (= operation :let)
                  (let [binding-result
                        (p15-s23-runtime-evaluate-bindings-in-context
                         (get instruction :bindings) environment output functions path [])]
                    (if (= :normal (get binding-result 2))
                    (p15-s23-runtime-evaluate-sequence-in-context
                     (get instruction :body)
                     (first binding-result)
                     (second binding-result) functions path targets) binding-result))
                    [{:diagnostic "P15S23X002" :reason :unsupported-local-runtime-operation :operation operation}
                     output :rejected]))))))))))))))))))

; Development entrypoint for a closed instruction plan. The result records
; normal completion, a thrown value, or rejection with accumulated output.
; This source revision is not admitted or bound to a current target runtime.
(defn p15-s23-runtime-execute-closed-plan
  [plan]
  (let [entrypoint (get plan :entrypoint)
        function (get (get plan :functions) entrypoint)
        result
        (p15-s23-runtime-activate-function function [] "" (get plan :functions) [entrypoint])]
    (let [record {:artifact :gravity/p15-s23-runtime-closed-plan-execution-record
     :entrypoint entrypoint
     :stdout (second result)
     :clojure-seed-boundary? true
     :self-hosted? false}]
      (if (= :normal (get result 2))
        (assoc record :entrypoint-result (first result) :status :complete)
        (if (= :thrown (get result 2))
          (assoc record :thrown-value (first result) :status :thrown)
          (assoc record :diagnostic (first result) :status :rejected))))))

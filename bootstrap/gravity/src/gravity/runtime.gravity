                                                      (if (= index width)
                                                        (if (= 0 (count remaining)) {:status :accepted :strings? family}
                                                          {:status :rejected :strings? family})
                                                        (let [value (first remaining)]
                                                          (if (if (= nil family) (if (keyword? value) true (string? value))
                                                                (if family (string? value) (keyword? value)))
                                                            (recur (rest remaining) (+ index 1) (if (= nil family) (string? value) family))
                                                            {:status :rejected :strings? family}))))]
                                        (if (= :accepted (get checked :status))
                                          (recur (+ side 1) (get checked :strings?)) checked))))
                        strings? (get validated :strings?)

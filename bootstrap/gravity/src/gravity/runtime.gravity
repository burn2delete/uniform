        (let [locals (loop [index 0 out {}]
                       (if (= index (count params)) out
                         (recur (+ index 1) (assoc out (get params index) (get arguments index)))))
              indexed? (if (map? (get function :type-input))
                         (contains? (get function :type-input) :indexed-private-self) false)
              clean-pool (if (map? pool) (p15-s23-runtime-remove-map-key pool :gravity.runtime/private-indexed-activation) {})

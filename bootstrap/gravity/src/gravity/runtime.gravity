          {:status :rejected :reason :keyword-set-value-domain-required :work-count 0 :comparison-attempts 0})
        {:status :rejected :reason :keyword-set-value-domain-required :work-count 0 :comparison-attempts 0}))
    {:status :rejected :reason :keyword-set-equality-work-limit :work-count 0 :comparison-attempts 0}))

(defn runtime-scalar-set-contains [items needle]
  ; Native representation and complete domains precede comparison or construction.
  (let [native (hosted-native-data-preflight [items needle])]
    (if (= :passed (get native :status))
      (let [strings? (string? needle) symbols? (symbol? needle) integers? (integer? needle)
            reason (if integers? :integer-set-contains-value-domain-required
                     (if strings? :string-set-contains-value-domain-required
                       (if symbols? :symbol-set-contains-value-domain-required :keyword-set-contains-value-domain-required)))]
        (if (if (set? items) (if strings? true (if symbols? true (if integers? true (keyword? needle)))) false)
          (let [n (count items)
                checked (loop [remaining items i 0 values []]
                          (if (= i n)
                            (if (= 0 (count remaining)) {:status :accepted :values values}
                              {:status :rejected :reason reason})
                            (let [value (first remaining)]
                              (if (if strings? (string? value)
                                    (if symbols? (symbol? value) (if integers? (integer? value) (keyword? value))))
                                (recur (rest remaining) (+ i 1) (conj values value))
                                {:status :rejected :reason reason}))))]
            (if (= :accepted (get checked :status))
              (let [values (get checked :values)
                    distinct (loop [i 0 attempts 0]
                               (if (= i n) {:status :accepted :comparison-attempts attempts}
                                 (let [pair (loop [j (+ i 1) used attempts]
                                              (if (= j n) {:status :accepted :comparison-attempts used}
                                                (if (= false (p15-s23-runtime-atomic-equality (get values i) (get values j)))
                                                  (recur (+ j 1) (+ used 1))
                                                  {:status :rejected :reason reason
                                                   :domain-failure (if integers? :duplicate-integer-class
                                                                     (if strings? :duplicate-string-class
                                                                       (if symbols? :duplicate-symbol-class :duplicate-keyword-class)))
                                                   :comparison-attempts (+ used 1)})))]
                                   (if (= :accepted (get pair :status))
                                     (recur (+ i 1) (get pair :comparison-attempts)) pair))))]
                (if (= :accepted (get distinct :status))
                  (loop [i 0 attempts (get distinct :comparison-attempts)]
                    (if (= i n)
                      {:status :accepted :value false :comparison-attempts attempts
                       :input-element-count n :validated-values values}
                      (let [equal (p15-s23-runtime-atomic-equality (get values i) needle)]
                        (if (= true equal)
                          {:status :accepted :value true :comparison-attempts (+ attempts 1)
                           :input-element-count n :validated-values values}
                          (if (= false equal) (recur (+ i 1) (+ attempts 1))
                            {:status :rejected :reason reason :comparison-attempts (+ attempts 1)})))))
                  distinct))
              (assoc checked :comparison-attempts 0)))
          {:status :rejected :reason reason :comparison-attempts 0}))
      {:status :rejected :reason :set-membership-native-data-required
       :native-reason (get native :reason) :comparison-attempts 0})))

(defn runtime-insert-scalar-set [items value]
  ; Keep the insertion domain at String, Symbol and Keyword.
  (let [native (hosted-native-data-preflight [items value])
        reason (if (symbol? value) :symbol-set-insertion-value-domain-required
                 (if (keyword? value) :keyword-set-insertion-value-domain-required :string-set-insertion-value-domain-required))]
    (if (= :passed (get native :status))
      (if (if (string? value) true (if (symbol? value) true (keyword? value)))
        (let [checked (runtime-scalar-set-contains items value)]
          (if (= :accepted (get checked :status))
            (let [present? (= true (get checked :value)) values (get checked :validated-values)
                  n (get checked :input-element-count)]
              {:status :accepted
               :value (if present? items
                        (loop [i 0 out #{}]
                          (if (= i n) (conj out value)
                            (recur (+ i 1) (conj out (get values i))))))
               :member-present? present? :input-element-count n
               :comparison-attempts (get checked :comparison-attempts) :insertions (if present? 0 (+ n 1))})
            {:status :rejected :reason reason :member-reason (get checked :reason)
             :native-reason (get checked :native-reason) :domain-failure (get checked :domain-failure)
             :comparison-attempts (get checked :comparison-attempts) :insertions 0}))
        {:status :rejected :reason reason :comparison-attempts 0 :insertions 0})
      {:status :rejected :reason reason :member-reason :set-membership-native-data-required
       :native-reason (get native :reason) :comparison-attempts 0 :insertions 0})))

(defn p15-s23-runtime-character-set-contains-work [items needle budget]
  ; Existing atomic Character IR values, not Unicode source decoding.
  ; Reserve complete validation, distinctness and membership before comparing.
  (if (if (integer? budget) (>= budget 0) false)
    (let [limit (if (< budget 65536) budget 65536)]
      (if (< limit 2)
        {:status :rejected :reason :character-set-contains-work-limit :work-count 2 :comparison-attempts 0}
        (if (set? items)
          (let [n (count items)]
            (if (if (< n 0) true (> n 1024))
              {:status :rejected :reason :character-set-contains-value-width :work-count 2 :comparison-attempts 0}
              (let [base (+ 2 (* 2 n))]
                (if (> base limit)
                  {:status :rejected :reason :character-set-contains-work-limit :work-count base
                   :work-count-kind :validation-reservation :comparison-attempts 0}
                  (let [checked
                        (loop [remaining items i 0 values [] units 0]
                          (if (> i n) {:status :accepted :values values :units units}
                            (let [value (if (= i n) needle (first remaining))
                                  valid? (if (char? value) true
                                           (if (map? value)
                                             (if (if (= 4 (count value))
                                                   (loop [fields (keys value)]
                                                     (if (= 0 (count fields)) true
                                                       (if (keyword? (first fields)) (recur (rest fields)) false))) false)
                                               (if (= #{:artifact :schema-version :codepoint :text} (set (keys value)))
                                                 (if (= :gravity/unicode-scalar-character (get value :artifact))
                                                   (if (= 1 (get value :schema-version))
                                                     (if (integer? (get value :codepoint))
                                                       (if (<= 65536 (get value :codepoint) 1114111)
                                                         (if (string? (get value :text)) (= 2 (count (get value :text))) false)
                                                         false) false) false) false) false) false) false))]
                              (if (if (= i n) (if (= 0 (count remaining)) valid? false) valid?)
                                (recur (if (= i n) remaining (rest remaining)) (+ i 1)
                                  (if (= i n) values (conj values value)) (+ units (if (char? value) 1 2)))
                                {:status :rejected :reason :character-set-contains-value-domain-required}))))]
                    (if (= false (= :accepted (get checked :status)))
                      (assoc checked :work-count base :work-count-kind :validation-reservation :comparison-attempts 0)
                      (let [values (get checked :values) units (get checked :units)
                            half (quot n 2) previous (if (> n 0) (- n 1) 0)
                            a (if (= n (+ half half)) half n) b (if (= n (+ half half)) previous (quot previous 2))]
                        (if (= false (if (= b 0) true (<= a (quot (- limit base) b))))
                          {:status :rejected :reason :character-set-contains-work-limit :work-count (+ limit 1)
                           :work-count-kind :exceeded-allowance-lower-bound :comparison-attempts 0}
                          (let [pairs (* a b) remaining (- limit base pairs)]
                            (if (> units (quot remaining (+ n 1)))
                              {:status :rejected :reason :character-set-contains-work-limit :work-count (+ limit 1)
                               :work-count-kind :exceeded-allowance-lower-bound :comparison-attempts 0}
                              (let [work (+ base pairs (* (+ n 1) units))
                                    distinct (loop [i 0 attempts 0]
                                               (if (= i n) {:status :accepted :comparison-attempts attempts}
                                                 (let [checked (loop [j (+ i 1) used attempts]
                                                                 (if (= j n) {:status :accepted :comparison-attempts used}
                                                                   (let [equal (p15-s23-runtime-atomic-equality (get values i) (get values j))
                                                                         next-attempt (+ used 1)]
                                                                     (if (= false equal) (recur (+ j 1) next-attempt)
                                                                       {:status :rejected :reason :character-set-contains-value-domain-required
                                                                        :domain-failure :duplicate-or-unsupported-character-class
                                                                        :comparison-attempts next-attempt}))))]
                                                   (if (= :accepted (get checked :status))
                                                     (recur (+ i 1) (get checked :comparison-attempts)) checked))))
                                    result (if (= :accepted (get distinct :status))
                                             (loop [i 0 attempts (get distinct :comparison-attempts)]
                                               (if (= i n) {:status :accepted :value false :comparison-attempts attempts}
                                                 (let [equal (p15-s23-runtime-atomic-equality (get values i) needle)
                                                       next-attempt (+ attempts 1)]
                                                   (if (= true equal) {:status :accepted :value true :comparison-attempts next-attempt}
                                                     (if (= false equal) (recur (+ i 1) next-attempt)
                                                       {:status :rejected :reason :character-set-contains-value-domain-required
                                                        :comparison-attempts next-attempt}))))) distinct)]
                                (assoc result :work-count work :work-count-kind :exact-logical-membership-reservation
                                  :input-element-count n :representation-units units :representation :jvm-utf16-code-units
                                  :value-work-model :gravity/character-set-membership-logical-content-work-v1
                                  :character-premise :existing-atomic-character-ir-values :source-decoding :c2-owned
                                  :provider-cpu-bound :not-established))))))))))))
          {:status :rejected :reason :character-set-contains-value-domain-required :work-count 2 :comparison-attempts 0})))
    {:status :rejected :reason :character-set-contains-work-limit :work-count 0 :comparison-attempts 0}))

(defn p15-s23-runtime-keyword-set-equality-work [left right budget]
  ; Prepay all cross-membership and within-operand distinctness comparisons.
  ; Representation units measure cost only; the guarded native member family decides equality.
  (let [domain (p15-s23-runtime-keyword-set-domain [left right] budget)]
    (if (= :accepted (get domain :status))
      (let [limit (if (< budget 65536) budget 65536) strings? (= :string-set (get domain :comparison-domain))
            work-reason (if strings? :string-set-equality-work-limit :keyword-set-equality-work-limit)
            domain-reason (if strings? :string-set-value-domain-required :keyword-set-value-domain-required)
            n (get (get domain :operand-counts) 0) m (get (get domain :operand-counts) 1)
            cl (get (get domain :representation-units) 0) cr (get (get domain :representation-units) 1)
            initial (+ 1 (get domain :work-count))
            nl (if (> n 0) (- n 1) 0) mr (if (> m 0) (- m 1) 0)
            nh (quot n 2) mh (quot m 2)
            left-pair (if (= n (+ nh nh)) [nh nl] [n (quot nl 2)])
            right-pair (if (= m (+ mh mh)) [mh mr] [m (quot mr 2)])
            factors [[n m] [m cl] [n cr] left-pair right-pair [nl cl] [mr cr]]
            reservation
            (if (> initial limit)
              {:status :rejected :reason work-reason :work-count initial
               :work-count-kind :logical-reservation-including-failed-attempt :comparison-attempts 0}
              (loop [i 0 used initial]
                (if (= i 7) {:status :accepted :work-count used}
                  (let [pair (get factors i) a (get pair 0) b (get pair 1)]
                    (if (if (= 0 b) true (<= a (quot (- limit used) b)))
                      (recur (+ i 1) (+ used (* a b)))
                      {:status :rejected :reason work-reason :work-count (+ limit 1)
                       :work-count-kind :exceeded-allowance-lower-bound :comparison-attempts 0})))))]
        (if (= :accepted (get reservation :status))
          (let [values [left right] counts [n m]
                distinct
                (loop [side 0 attempts 0]
                  (if (= side 2) {:status :accepted :comparison-attempts attempts}
                    (let [width (get counts side)
                          checked
                          (loop [remaining (get values side) index 0 used attempts]
                            (if (= index width) {:status :accepted :comparison-attempts used}
                              (let [a (first remaining)
                                    pairs
                                    (loop [others (rest remaining) offset (+ index 1) attempted used]
                                      (if (= offset width) {:status :accepted :comparison-attempts attempted}
                                        (let [b (first others)]
                                          (if (if (if strings? (string? a) (keyword? a)) (if strings? (string? b) (keyword? b)) false)
                                            (let [equal (p15-s23-runtime-atomic-equality a b) next-attempt (+ attempted 1)]
                                              (if (= false equal)
                                                (recur (rest others) (+ offset 1) next-attempt)
                                                {:status :rejected :reason domain-reason
                                                 :domain-failure (if strings? :duplicate-or-unsupported-string-class :duplicate-or-unsupported-keyword-class)
                                                 :comparison-attempts next-attempt}))
                                            {:status :rejected :reason domain-reason :comparison-attempts attempted}))))]
                                (if (= :accepted (get pairs :status))
                                  (recur (rest remaining) (+ index 1) (get pairs :comparison-attempts)) pairs))))]
                      (if (= :accepted (get checked :status))
                        (recur (+ side 1) (get checked :comparison-attempts)) checked))))
                compared
                (if (= :accepted (get distinct :status))
                  (if (= false (= n m))
                    {:status :accepted :value false :comparison-attempts (get distinct :comparison-attempts)}
                    (loop [remaining-left left index 0 attempts (get distinct :comparison-attempts)]
                      (if (= index n) {:status :accepted :value true :comparison-attempts attempts}
                        (let [a (first remaining-left)
                              found
                              (if (if strings? (string? a) (keyword? a))
                                (loop [remaining-right right offset 0 used attempts]
                                  (if (= offset m) {:status :accepted :value false :comparison-attempts used}
                                    (let [b (first remaining-right)]
                                      (if (if strings? (string? b) (keyword? b))
                                        (let [equal (p15-s23-runtime-atomic-equality a b) next-attempt (+ used 1)]
                                          (if (= true equal)
                                            {:status :accepted :value true :comparison-attempts next-attempt}
                                            (if (= false equal)
                                              (recur (rest remaining-right) (+ offset 1) next-attempt)
                                              {:status :rejected :reason domain-reason :comparison-attempts next-attempt})))
                                        {:status :rejected :reason domain-reason :comparison-attempts used}))))
                                {:status :rejected :reason domain-reason :comparison-attempts attempts})]
                          (if (= :accepted (get found :status))
                            (if (= true (get found :value))
                              (recur (rest remaining-left) (+ index 1) (get found :comparison-attempts)) found) found)))))
                  distinct)]
            (let [result (assoc compared :work-count (get reservation :work-count) :work-count-kind :exact-logical-comparison-reservation
              :operand-counts counts :representation-units (get domain :representation-units)
              :provider-cpu-bound :not-established)]
              (if strings? (assoc result :comparison-domain :string-set) result)))
          (if strings? (assoc reservation :provider-cpu-bound :not-established :comparison-domain :string-set)
            (assoc reservation :provider-cpu-bound :not-established))))
      domain)))

(defn p15-s23-runtime-vector-domain [values budget]
  ; Integer leaves use the existing scalar original-value equality premise.
  ; Typed calls establish Generic Integer, immutable finite Vectors, and coherent positional storage.
  ; Set leaves use full owned self-equality validation with this Vector's remaining allowance.
  ; Immutable finite providers have coherent cardinality/enumeration; arbitrary host impostors are outside this premise.
  ; These are logical reservations, not digit-size, CPU, peak-memory, or executed-step bounds.
  (let [limit (if (< budget 65536) budget 65536)]
  (if (if (vector? values) (= 2 (count values)) false)
    (if (if (vector? (get values 0)) (vector? (get values 1)) false)
      (if (< limit 2) {:status :rejected :reason :vector-equality-work-limit :work-count 2}
        (loop [pending [[(get values 1) 0] [(get values 0) 0]] work 2 integers? false nested? false sets? false]
          (if (= 0 (count pending)) (if (if sets? true integers?)
              (if nested?
                {:status :rejected :reason :vector-value-equality-domain-required :work-count work}
                (let [left (get values 0) right (get values 1)
                      n (if (< (count left) (count right)) (count left) (count right))
                      total (+ work (* 2 n))]
                  (if (> total limit)
                    {:status :rejected :reason :vector-equality-work-limit :work-count total}
                    (loop [i 0]
                      (if (= i n)
                        (if sets?
                          {:status :accepted :comparison-domain :flat-keyword-set-vector :work-count total}
                          {:status :accepted :comparison-domain :flat-integer-vector :work-count total})
                        (let [a (get left i) b (get right i)]
                          (if (if (= (integer? a) (integer? b))
                                (if sets? (= (set? a) (set? b)) true) false)
                            (recur (+ i 1))
                            {:status :rejected :reason :vector-value-equality-domain-required :work-count total})))))))
              {:status :accepted :work-count work})
            (let [frame (get pending (- (count pending) 1)) tail (subvec pending 0 (- (count pending) 1))
                  value (get frame 0) depth (get frame 1)]
              (if (> depth 128) {:status :rejected :reason :vector-equality-value-depth :work-count work}
                (if (vector? value)
                  (let [width (count value) total (+ work width)]
                    (if (> width 1024) {:status :rejected :reason :vector-equality-value-width :work-count work}
                    (if (> total limit) {:status :rejected :reason :vector-equality-work-limit :work-count total}
                      (if (if (= depth 128) (> width 0) false)
                        {:status :rejected :reason :vector-equality-value-depth :work-count total}
                        (let [children (loop [i (- width 1) out tail]
                                         (if (< i 0) out
                                           (recur (- i 1) (conj out [(get value i) (+ depth 1)]))))]
                          (recur children total integers? (if (> depth 0) true nested?) sets?))))))
                  (if (if (= depth 1) (set? value) false)
                    (let [raw-leaf (p15-s23-runtime-keyword-set-equality-work value value (- limit work))
                          leaf (if (= :string-set (get raw-leaf :comparison-domain))
                                 (assoc raw-leaf :status :rejected :reason :keyword-set-value-domain-required) raw-leaf)
                          total (+ work (get leaf :work-count))]
                      (if (= :accepted (get leaf :status))
                        (if (= true (get leaf :value))
                          (recur tail total integers? nested? true)
                          {:status :rejected :reason :vector-value-equality-domain-required
                           :leaf-reason :nonreflexive-keyword-set-domain :work-count total
                           :work-count-kind :logical-reservation-including-failed-attempt :provider-cpu-bound :not-established})
                        {:status :rejected
                         :reason (if (contains? #{:keyword-set-equality-work-limit :string-set-equality-work-limit} (get leaf :reason)) :vector-equality-work-limit
                                   (if (contains? #{:keyword-set-equality-value-width :string-set-equality-value-width} (get leaf :reason)) :vector-equality-value-width
                                     :vector-value-equality-domain-required))
                         :leaf-reason (get leaf :reason) :leaf-work-count-kind (get leaf :work-count-kind)
                         :leaf-comparison-attempts (get leaf :comparison-attempts)
                         :work-count total
                         :work-count-kind (if (= :exceeded-allowance-lower-bound (get leaf :work-count-kind))
                                            :exceeded-allowance-lower-bound :logical-reservation-including-failed-attempt)
                         :provider-cpu-bound :not-established}))
                    (if (if (integer? value) (= depth 1) (= true (p15-s23-runtime-atomic-equality value value)))
                    (recur tail work (if (integer? value) true integers?) nested? sets?)
                    {:status :rejected :reason :vector-value-equality-domain-required :work-count work}))))))))
      {:status :rejected :reason :vector-value-equality-domain-required :work-count 0})
    {:status :rejected :reason :vector-value-equality-domain-required :work-count 0})))

(defn p15-s23-runtime-list-equality-work [left right budget]
  (let [limit (if (< budget 65536) budget 65536)
        domain
        (loop [pending [[right 0 true] [left 0 true]] work 0]
          (if (= 0 (count pending)) {:status :accepted :work-count work}
            (if (>= work limit) {:status :rejected :reason :list-equality-work-limit :work-count work}
              (let [frame (get pending (- (count pending) 1)) value (get frame 0) depth (get frame 1) outer? (get frame 2)
                    tail (subvec pending 0 (- (count pending) 1)) used (+ work 1)]
                (if (> depth 128) {:status :rejected :reason :list-equality-value-depth :work-count used}
                  (if (list? value)
                    (let [n (count value)]
                      (if (> n 1024) {:status :rejected :reason :list-equality-value-width :work-count used}
                        (if (> (+ used (count tail) n) limit)
                          {:status :rejected :reason :list-equality-work-limit :work-count used}
                          (recur (loop [remaining value out tail]
                                   (if (= 0 (count remaining)) out
                                     (recur (rest remaining) (conj out [(first remaining) (+ depth 1) false])))) used))))
                    (if outer? {:status :rejected :reason :list-value-equality-domain-required :work-count used}
                      (if (if (integer? value) false
                            (if (if (= nil value) true (if (boolean? value) true (if (char? value) true
                                  (if (string? value) true (if (symbol? value) true (if (keyword? value) true (map? value)))))))
                              (= true (p15-s23-runtime-atomic-equality value value)) false))
                        (recur tail used)
                        {:status :rejected :reason :list-value-equality-domain-required :work-count used}))))))))]
    ; Full domains precede comparison. False never skips later paired-domain checks.
    (if (= :accepted (get domain :status))
      (loop [pending [[left right]] work (get domain :work-count) equal? true]
        (if (= 0 (count pending)) {:status :accepted :value equal? :work-count work}
          (if (>= work limit) {:status :rejected :reason :list-equality-work-limit :work-count work}
            (let [pair (get pending (- (count pending) 1)) a (get pair 0) b (get pair 1)
                  tail (subvec pending 0 (- (count pending) 1)) used (+ work 1)]
              (if (list? a)
                (if (list? b)
                  (let [n (if (< (count a) (count b)) (count a) (count b))]
                    (if (> (+ used (count tail) n) limit)
                      {:status :rejected :reason :list-equality-work-limit :work-count used}
                      (recur (loop [xs a ys b i 0 out tail]
                               (if (= i n) out
                                 (recur (rest xs) (rest ys) (+ i 1) (conj out [(first xs) (first ys)]))))
                             used (if (= (count a) (count b)) equal? false))))
                  {:status :rejected :reason :list-pair-value-domain-required :work-count used})
                (if (list? b) {:status :rejected :reason :list-pair-value-domain-required :work-count used}
                  (let [same (p15-s23-runtime-atomic-equality a b)]
                    (if (boolean? same) (recur tail used (if same equal? false))
                      {:status :rejected :reason :list-value-equality-domain-required :work-count used})))))))) domain)))

(defn p15-s23-runtime-vector-equality-work [left right budget]
  (let [limit (if (< budget 65536) budget 65536)]
  ; Validate BOTH complete value domains before any early mismatch can return.
  (let [domain (p15-s23-runtime-vector-domain [left right] limit)]
    (if (= :accepted (get domain :status))
      (let [initial (+ 1 (get domain :work-count))]
        (if (> initial limit) {:status :rejected :reason :vector-equality-work-limit :work-count initial}
          (loop [pending [[left right]] work initial]
            (if (= 0 (count pending)) {:status :accepted :value true :work-count work}
              (let [pair (get pending (- (count pending) 1)) tail (subvec pending 0 (- (count pending) 1))
                    a (get pair 0) b (get pair 1)]
                (if (vector? a)
                  (if (vector? b)
                    (if (= (count a) (count b))
                      (let [total (+ work (count a))]
                        (if (> total limit) {:status :rejected :reason :vector-equality-work-limit :work-count total}
                          (let [children (loop [i (- (count a) 1) out tail]
                                           (if (< i 0) out
                                             (recur (- i 1) (conj out [(get a i) (get b i)]))))]
                            (recur children total))))
                      {:status :accepted :value false :work-count work})
                    {:status :accepted :value false :work-count work})
                  (if (vector? b) {:status :accepted :value false :work-count work}
                    (if (set? a)
                      (let [raw-leaf (p15-s23-runtime-keyword-set-equality-work a b (- limit work))
                            leaf (if (= :string-set (get raw-leaf :comparison-domain))
                                 (assoc raw-leaf :status :rejected :reason :keyword-set-value-domain-required) raw-leaf)
                          total (+ work (get leaf :work-count))]
                        (if (= :accepted (get leaf :status))
                          (if (= true (get leaf :value)) (recur tail total)
                            {:status :accepted :value false :work-count total})
                          {:status :rejected
                         :reason (if (contains? #{:keyword-set-equality-work-limit :string-set-equality-work-limit} (get leaf :reason)) :vector-equality-work-limit
                                   (if (contains? #{:keyword-set-equality-value-width :string-set-equality-value-width} (get leaf :reason)) :vector-equality-value-width
                                     :vector-value-equality-domain-required))
                         :leaf-reason (get leaf :reason) :leaf-work-count-kind (get leaf :work-count-kind)
                         :leaf-comparison-attempts (get leaf :comparison-attempts)
                         :work-count total
                         :work-count-kind (if (= :exceeded-allowance-lower-bound (get leaf :work-count-kind))
                                            :exceeded-allowance-lower-bound :logical-reservation-including-failed-attempt)
                         :provider-cpu-bound :not-established}))
                      (let [equal (p15-s23-runtime-atomic-equality a b)]
                      (if (= true equal) (recur tail work)
                        (if (= false equal) {:status :accepted :value false :work-count work}
                          {:status :rejected :reason :vector-value-equality-domain-required :work-count work}))))))))))) domain))))

(defn p15-s23-runtime-vector-equality [left right]
  (let [result (p15-s23-runtime-vector-equality-work left right 65536)]
    (if (= :accepted (get result :status)) (get result :value) :unsupported)))

(defn runtime-construct-scalar-set [input]
  ; Validate original native DATA and every member before equality or insertion.
  (let [native (hosted-native-data-preflight input)]
    (if (= :passed (get native :status))
      (if (vector? input)
        (let [n (count input) strings? (string? (get input 0)) integers? (integer? (get input 0))
              reason (if integers? :set-literal-integer-domain-required
                       (if strings? :set-literal-string-domain-required :set-literal-keyword-domain-required))
              checked (loop [i 0]
                        (if (= i n) true
                          (if (if integers? (integer? (get input i))
                                (if strings? (string? (get input i)) (keyword? (get input i))))
                            (recur (+ i 1)) false)))]
          (if checked
            (let [distinct (loop [i 0 attempts 0]
                             (if (= i n) {:status :accepted :comparison-attempts attempts}
                               (let [pair (loop [j (+ i 1) used attempts]
                                            (if (= j n) {:status :accepted :comparison-attempts used}
                                              (if (= false (p15-s23-runtime-atomic-equality (get input i) (get input j)))
                                                (recur (+ j 1) (+ used 1))
                                                {:status :rejected :reason (if integers? :duplicate-set-literal-integer
                                                                            (if strings? :duplicate-set-literal-string :duplicate-set-literal-keyword))
                                                 :comparison-attempts (+ used 1)})))]
                                 (if (= :accepted (get pair :status))
                                   (recur (+ i 1) (get pair :comparison-attempts)) pair))))]
              (if (= :accepted (get distinct :status))
                {:status :accepted :value (loop [i 0 out #{}]
                                           (if (= i n) out (recur (+ i 1) (conj out (get input i)))))
                 :input-element-count n :comparison-attempts (get distinct :comparison-attempts) :insertions n}
                (assoc distinct :insertions 0)))
            {:status :rejected :reason reason :comparison-attempts 0 :insertions 0}))
        {:status :rejected :reason :set-literal-keyword-domain-required :comparison-attempts 0 :insertions 0})
      {:status :rejected :reason :set-literal-native-data-required :native-reason (get native :reason)
       :comparison-attempts 0 :insertions 0})))

(defn runtime-construct-character-set [input]
  (let [native (hosted-native-data-preflight input)]
    (if (= :passed (get native :status))
      (if (vector? input)
        (let [n (count input)
              checked (loop [i 0]
                        (if (= i n) true
                          (let [value (get input i)]
                            (if (if (char? value) true
                                  (if (map? value)
                                    (if (if (= 4 (count value))

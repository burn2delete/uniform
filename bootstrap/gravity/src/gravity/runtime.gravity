; Development evaluator implementation; namespace declarations do not grant authority.
(ns gravity.runtime
  (:profile :hosted)
  (:target :jvm)
  (:exports [p15-s23-runtime-execute-closed-plan
             p15-s23-runtime-evaluate-closed-instruction
             p15-s23-runtime-evaluate-in-context
             p15-s23-runtime-activate-function])
  (:effects #{:memory/allocate})
  (:capabilities #{:memory/allocator}))

; The local evaluator keeps private state as [value output control], where
; control is :normal, :thrown, :rejected, or :recur. The latter adds a fourth
; target-ID position and carries ordered slot values. Payloads never select control.
; This development control representation is not a target error ABI. Output is a
; Gravity string accumulator rather than a host writer, which preserves empty
; strings, embedded NULs, and Unicode bytes until a target adapter performs the
; declared :io/write operation.
(defn p15-s23-runtime-evaluate-arguments
  [arguments environment output values]
  (p15-s23-runtime-evaluate-arguments-in-context arguments environment output values {} [] [] nil))

(defn p15-s23-runtime-evaluate-arguments-in-context
  [arguments environment output values functions path targets pool]
  (loop [remaining arguments stdout output collected values]
    (if (= (count remaining) 0)
      [collected stdout :normal]
      (let [head-result
            (p15-s23-runtime-evaluate-in-instance
             (first remaining) environment stdout functions path targets pool)]
        (if (= :normal (get head-result 2))
          (recur (rest remaining) (second head-result)
                 (conj collected (first head-result)))
          head-result)))))

(defn p15-s23-runtime-remove-map-key [input removed-key]
  (loop [remaining (keys input) result {}]
    (if (= 0 (count remaining)) result
      (let [key (first remaining)]
        (recur (rest remaining)
          (if (= key removed-key) result (assoc result key (get input key))))))))

(defn p15-s23-runtime-println-output
  [values output]
  (if (= (count values) 0)
    (str output "\n")
    (if (= (count values) 1)
      (str output (str (first values)) "\n")
      (p15-s23-runtime-println-output
       (rest values)
       (str output (str (first values)) " ")))))

(defn p15-s23-runtime-evaluate-bindings
  [bindings environment output]
  (p15-s23-runtime-evaluate-bindings-in-context bindings environment output {} [] [] nil))

(defn p15-s23-runtime-evaluate-bindings-in-context
  [bindings environment output functions path targets pool]
  (if (= (count bindings) 0)
    [environment output :normal]
    (let [binding (first bindings)
          value-result
          (p15-s23-runtime-evaluate-in-instance
           (get binding :expr) environment output functions path [] pool)]
      (if (= :normal (get value-result 2))
        (p15-s23-runtime-evaluate-bindings-in-context
         (rest bindings)
         (assoc environment (get binding :name) (first value-result))
         (second value-result) functions path targets pool)
        value-result))))

(defn p15-s23-runtime-evaluate-sequence
  [instructions environment output]
  (p15-s23-runtime-evaluate-sequence-in-context instructions environment output {} [] [] nil))

(defn p15-s23-runtime-evaluate-sequence-in-context
  [instructions environment output functions path targets pool]
  (if (= (count instructions) 0)
    [nil output :normal]
    (let [head-result
          (p15-s23-runtime-evaluate-in-instance
           (first instructions) environment output functions path (if (= 1 (count instructions)) targets []) pool)]
      (if (if (= :normal (get head-result 2)) (= (count instructions) 1) true)
        head-result
        (p15-s23-runtime-evaluate-sequence-in-context
         (rest instructions) environment (second head-result) functions path targets pool)))))

(defn p15-s23-runtime-typed-handlers-valid? [instruction]
  (if (= #{:op :protected :handlers} (set (keys instruction)))
    (if (map? (get instruction :protected))
      (if (vector? (get instruction :handlers))
        (if (if (> (count (get instruction :handlers)) 0) (<= (count (get instruction :handlers)) 65536) false)
          (loop [remaining (get instruction :handlers)]
            (if (= 0 (count remaining)) true
              (let [handler (first remaining)]
                (if (map? handler)
                  (if (= #{:type :name :body} (set (keys handler)))
                    (if (contains? #{:gravity.type/bool :gravity.type/string :gravity.type/symbol :gravity.type/keyword} (get handler :type))
                      (if (symbol? (get handler :name))
                        (if (map? (get handler :body)) (recur (rest remaining)) false) false) false) false) false)))) false) false) false) false))

(defn p15-s23-runtime-atomic-error-match? [type value]
  (if (= type :gravity.type/bool) (if (= true value) true (= false value))
    (if (= type :gravity.type/string) (string? value)
      (if (= type :gravity.type/symbol) (symbol? value)
        (if (= type :gravity.type/keyword) (keyword? value) false)))))

(defn p15-s23-runtime-select-typed-handler [handlers result environment]
  (p15-s23-runtime-select-handler-in-context handlers result environment {} [] [] nil))

(defn p15-s23-runtime-select-handler-in-context [handlers result environment functions path targets pool]
  (loop [remaining handlers]
    (if (= 0 (count remaining)) result
      (let [handler (first remaining)]
        (if (p15-s23-runtime-atomic-error-match? (get handler :type) (first result))
          (p15-s23-runtime-evaluate-in-instance (get handler :body)
            (assoc environment (get handler :name) (first result)) (second result) functions path [] pool)
          (recur (rest remaining)))))))

(defn p15-s23-runtime-evaluate-closed-instruction
  [instruction environment output]
  (p15-s23-runtime-evaluate-in-context instruction environment output {} []))

(defn p15-s23-runtime-activate-function [function values output functions path]
  (p15-s23-runtime-activate-function-in-instance function values output functions path nil))

(defn p15-s23-runtime-evaluate-with-targets [instruction environment output functions path targets]
  (p15-s23-runtime-evaluate-in-instance instruction environment output functions path targets nil))

(defn p15-s23-runtime-module-id? [value]
  (if (string? value) (if (< 0 (count value)) (<= (count value) 256) false) false))

(defn p15-s23-runtime-module-source? [source]
  (if (map? source)
    (if (= #{:form-id :syntax-id :semantic-span :origin-chain :generated-origin} (set (keys source)))
      (if (p15-s23-runtime-module-id? (get source :form-id))
        (p15-s23-runtime-module-id? (get source :syntax-id)) false) false) false))

(defn p15-s23-runtime-namespace-read-source? [instruction definition]
  (if (if (map? instruction) (map? definition) false)
    (if (= #{:op :version :binding-id :definition-core-node-id :definition-syntax-id :definition-source
             :value-core-node-id :value-source :type :reference-core-node-id :reference-source} (set (keys instruction)))
      (if (= [:namespace-read :p15-s23-namespace-read-v1] [(get instruction :op) (get instruction :version)])
        (if (if (p15-s23-runtime-module-id? (get instruction :reference-core-node-id))
                (p15-s23-runtime-module-source? (get instruction :reference-source)) false)
          (loop [fields [:binding-id :definition-core-node-id :definition-syntax-id :definition-source
                         :value-core-node-id :value-source :type]]
            (if (= 0 (count fields)) true
              (if (= (get instruction (first fields)) (get definition (first fields))) (recur (rest fields)) false))) false) false) false) false))

(defn p15-s23-runtime-namespace-read-valid? [instruction pool]
  (if (map? pool)
    (let [entry (get pool (get instruction :binding-id))]
      (if (if (map? entry) (= #{:definition :value} (set (keys entry))) false)
        (p15-s23-runtime-namespace-read-source? instruction (get entry :definition)) false)) false))

(defn p15-s23-runtime-initializer-work [instruction budget]
  ; This measures a closed constructor/data tree, not arbitrary guest code.
  (loop [pending [{:value instruction :mode :instruction :depth 0}] work 0 constructors {}]
    (if (= 0 (count pending)) {:status :accepted :work-count work :constructors constructors}
      (let [frame (get pending (- (count pending) 1)) value (get frame :value) mode (get frame :mode)
            depth (get frame :depth) tail (subvec pending 0 (- (count pending) 1))
            op (get value :op)
            width (if (= mode :data)
                    (if (map? value) (* 2 (count value))
                      (if (if (vector? value) true (if (seq? value) true (set? value))) (count value) 0))
                    (if (= op :quote) 1
                      (if (= op :vector-literal) (if (vector? (get value :items)) (count (get value :items)) 0)
                        (if (= op :map-literal) (if (vector? (get value :entries)) (* 2 (count (get value :entries))) 0) 0))))
            reserved (+ work 1 width)
            children
            (if (if (> reserved budget) true (> depth 128)) nil
            (if (= mode :data)
              (if (map? value)
                (loop [remaining (keys value) out []]
                  (if (= 0 (count remaining)) out
                    (recur (rest remaining) (conj (conj out (first remaining)) (get value (first remaining))))))
                (if (if (vector? value) true (if (seq? value) true (set? value))) (vec value)
                  (if (= true (p15-s23-runtime-atomic-equality value value)) [] nil)))
              (if (map? value)
                (if (contains? #{:literal :quote} op)
                  (if (= #{:op :value} (set (keys value)))
                    (if (= op :quote) [(get value :value)]
                      (if (= true (p15-s23-runtime-atomic-equality (get value :value) (get value :value))) [] nil)) nil)
                (if (= op :vector-literal)
                  (if (= #{:op :items} (set (keys value))) (get value :items) nil)
                (if (= op :map-literal)
                  (if (if (= #{:op :entries} (set (keys value))) (vector? (get value :entries)) false)
                    (loop [remaining (get value :entries) out [] seen #{}]
                      (if (= 0 (count remaining)) out
                        (let [entry (first remaining) key (get entry :key)]
                          (if (if (map? entry) (= #{:key :value} (set (keys entry))) false)
                            (if (if (map? key) (= #{:op :value} (set (keys key))) false)
                              (if (if (= :literal (get key :op)) (keyword? (get key :value)) false)
                                (if (contains? seen (get key :value)) nil
                                  (recur (rest remaining) (conj (conj out key) (get entry :value)) (conj seen (get key :value)))) nil) nil) nil)))) nil) nil))) nil)))
            next-work reserved]
        (if (> next-work budget) {:status :rejected :reason :module-initialization-work-limit :work-count next-work}
          (if (if (<= depth 128) (vector? children) false)
            (let [added (loop [remaining children out tail]
                          (if (= 0 (count remaining)) out
                            (recur (rest remaining) (conj out {:value (first remaining) :depth (+ depth 1)
                              :mode (if (if (= mode :data) true (= op :quote)) :data :instruction)}))))]
              (recur added next-work
                (if (if (= mode :instruction) (contains? #{:map-literal :vector-literal} op) false)
                  (assoc constructors op (+ 1 (get constructors op 0))) constructors)))
            {:status :rejected :reason :unsupported-module-initializer :work-count next-work}))))))

(defn p15-s23-runtime-initializer-type? [definition instruction]
  (let [type (get definition :type) kind (if (map? type) (get type :kind) type)
        op (get instruction :op) value (get instruction :value)]
    (if (= :gravity.type/vector kind) (if (= :vector-literal op) true (if (= :quote op) (vector? value) false))
    (if (= :gravity.type/map kind) (if (= :map-literal op) true (if (= :quote op) (map? value) false))
    (if (= :gravity.type/list kind) (if (= :quote op) (seq? value) false)
    (if (= :gravity.type/set kind) (if (= :quote op) (set? value) false)
      (if (contains? #{:literal :quote} op)
        (if (= :gravity.type/nil kind) (= nil value)
        (if (= :gravity.type/bool kind) (boolean? value)
        (if (= :gravity.type/integer kind) (integer? value)
        (if (= :gravity.type/string kind) (string? value)
        (if (= :gravity.type/symbol kind) (symbol? value)
        (if (= :gravity.type/keyword kind) (keyword? value)
        (if (= :gravity.type/character kind)
          (if (char? value) true
            (if (map? value) (if (= :gravity/unicode-scalar-character (get value :artifact))
                              (= true (p15-s23-runtime-atomic-equality value value)) false) false)) false))))))) false)))))))

(defn p15-s23-runtime-function-valid? [function arity]
  (if (map? function)
    (let [params (get function :params []) body (get function :instructions)]
      (if (if (vector? params) (vector? body) false)
        (if (if (<= (count params) 65536)
              (if (> (count body) 0) (<= (count body) 65536) false) false)
          (if (= arity (get function :arity (count params)) (count params))
            (if (if (contains? function :recur-target)
                  (if (string? (get function :recur-target))
                    (if (> (count (get function :recur-target)) 0) (<= (count (get function :recur-target)) 256) false) false) true)
              (loop [remaining params seen #{}]
                (if (= 0 (count remaining))
                  (loop [instructions body]
                    (if (= 0 (count instructions)) true (if (map? (first instructions)) (recur (rest instructions)) false)))
                  (if (symbol? (first remaining))
                    (if (contains? seen (first remaining)) false (recur (rest remaining) (conj seen (first remaining)))) false))) false)
            false) false) false)) false))

(defn p15-s23-runtime-call-target-valid? [instruction functions path]
  (if (map? functions)
  (if (vector? path)
  (if (< (count path) 256)
  (if (symbol? (get instruction :function))
  (if (loop [index (- (count path) 1) current? true]
        (if (< index 0) true
          (let [active (get path index)]
            (if (symbol? active)
              (if (= (get instruction :function) active)
                (if current? (recur (- index 1) true) false)
                (recur (- index 1) false)) false))))
  (let [target (get functions (get instruction :function)) args (get instruction :args)]
    (if (if (map? target) (if (contains? target :params) (contains? target :arity) false) false)
      (if (vector? args) (p15-s23-runtime-function-valid? target (count args)) false) false)) false) false) false) false) false))

(defn p15-s23-runtime-indexed-proof [function range addition?]
  (let [record (get range :function-record)]
    {:kind (if addition? :gravity.runtime/indexed-private-self-unit-addition :gravity.runtime/indexed-private-self-vector-get)
     :version :sh08-indexed-private-self-runtime-v1
     :function-id (get record :function-syntax-id) :function-core-node-id (get record :function-core-node-id)
     :parameter-binding-ids (get range :parameter-binding-ids) :parameter-names (get function :params)
     :operation-core-node-id (get (get range (if addition? :step-header :access-header)) :call-core-node-id)
     :guard-core-node-id (get (get range :body-node) :node-id)
     :condition-core-node-id (get (get range :guard-call) :core-node-id)
     :count-core-node-id (get (get range :count-descriptor) :call-core-node-id)
     :access-core-node-id (get (get range :access-header) :call-core-node-id)
     :step-core-node-id (get (get range :step-header) :call-core-node-id)
     :unit-core-node-id (get (get range :unit-node) :node-id) :unit-source (get range :unit-source)
     :self-call-core-node-id (get (get range :self-call) :core-node-id)
     :vector-extent 7 :initial-index 0 :lower 0 :step 1
     :strict-access-edge :equality-false :numeric-mode :proof-required :integer-type :gravity.type/integer}))

(defn p15-s23-runtime-indexed-frame [function values functions path previous]
  (let [input (get function :type-input) metadata (get input :indexed-private-self)
        range (get metadata :source-induction) record (get range :function-record)
        params (get range :parameter-binding-ids) names (get function :params)
        unit (get range :unit-node)
        unit-form (get range :unit-source)
        step (p15-s23-runtime-indexed-proof function range true)
        access (p15-s23-runtime-indexed-proof function range false)
        ids [:function-id :function-core-node-id :operation-core-node-id :guard-core-node-id :condition-core-node-id
             :count-core-node-id :access-core-node-id :step-core-node-id :unit-core-node-id :self-call-core-node-id]
        expected-types [{:kind :gravity.type/vector :shape :literal
                         :element-types [:gravity.type/keyword :gravity.type/keyword :gravity.type/keyword :gravity.type/keyword
                                         :gravity.type/keyword :gravity.type/keyword :gravity.type/keyword]}
                        :gravity.type/keyword :gravity.type/integer]
        selected? (if (if (map? functions) (vector? path) false)
                    (if (> (count path) 0)
                      (if (= function (get functions (get path (- (count path) 1))))
                        (= (get function :name) (get path (- (count path) 1))) false) false) false)
        previous? (if (map? previous) (= function (get previous :function)) false)]
    (if (loop [checks
               [(map? input) (map? metadata) (if (map? metadata) (= 3 (count metadata)) false)
                (map? range) (if (map? range) (<= (count range) 64) false) (map? record)
                (if (vector? names) (= 3 (count names)) false)
                (if (vector? params) (= 3 (count params)) false)
                (if (vector? values) (= 3 (count values)) false)
                (if (vector? (get input :parameters)) (= 3 (count (get input :parameters))) false)
                (if (vector? (get record :parameter-binding-ids)) (= 3 (count (get record :parameter-binding-ids))) false)
                (if (map? (get metadata :operations)) (= 2 (count (get metadata :operations))) false)
                (map? unit) (if (vector? (get unit :children)) (= 0 (count (get unit :children))) false)
                (map? unit-form) (if (vector? (get unit-form :child-form-ids)) (= 0 (count (get unit-form :child-form-ids))) false)
                (loop [items [(get range :self-call) (get range :self-edge)]]
                  (if (= 0 (count items)) true
                    (let [item (first items) call? (= 2 (count items))
                          args (get item (if call? :argument-node-ids :argument-core-node-ids))
                          order (get item :ordered-evaluation-node-ids)]
                      (if (if (map? item)
                            (if (vector? args) (if (= 3 (count args))
                              (if (vector? order) (= 4 (count order)) false) false) false) false)
                        (recur (rest items)) false))))
                (loop [headers [(get range :step-header) (get range :access-header)]]
                  (if (= 0 (count headers)) true
                    (let [header (first headers) call (get header :source-call) edge (get header :source-edge)]
                      (if (if (map? header) (if (map? call) (map? edge) false) false)
                        (if (loop [items [call edge]]
                              (if (= 0 (count items)) true
                                (let [item (first items) call? (= 2 (count items))
                                      args (get item (if call? :argument-node-ids :argument-core-node-ids))
                                      order (get item :ordered-evaluation-node-ids)]
                                  (if (if (vector? args) (if (= 2 (count args))
                                        (if (vector? order) (= 3 (count order)) false) false) false)
                                    (recur (rest items)) false))))
                          (recur (rest headers)) false) false))))]]
          (if (= 0 (count checks)) true (if (= true (first checks)) (recur (rest checks)) false)))
    (if (loop [checks
               [selected? (map? metadata) (= #{:version :source-induction :operations} (if (map? metadata) (set (keys metadata)) #{}))
                (= :sh08-indexed-private-self-activation-v1 (get metadata :version))
                (= [:gravity.safety/indexed-private-self-range :sh08-indexed-private-self-range-v1
                    :ordinary-function-entry-induction :proven-safe :proof-required :gravity.type/integer 0 0 7 7
                    :equality-false :original-immutable-parameter-references :binary-source-integer-literal-one :not-authorized :retained]
                   [(get range :kind) (get range :version) (get range :scope) (get range :outcome)
                    (get range :numeric-mode) (get range :integer-type) (get range :initial-index) (get range :minimum-index)
                    (get range :maximum-index) (get range :vector-extent) (get range :strict-access-edge)
                    (get range :vector-and-needle) (get range :step) (get range :check-elision) (get range :runtime-guards)])
                (= 3 (get record :fixed-arity)) (= names (get access :parameter-names))
                (= params (get record :parameter-binding-ids)
                   (loop [remaining (get input :parameters) out []]
                     (if (= 0 (count remaining)) out (recur (rest remaining) (conj out (get (first remaining) :binding-id))))))
                (= expected-types (get range :parameter-types)
                   (loop [remaining (get input :parameters) out []]
                     (if (= 0 (count remaining)) out (recur (rest remaining) (conj out (get (first remaining) :type))))))
                (= [(get record :function-syntax-id) (get record :function-core-node-id) (get record :body-core-node-id) (get record :definition-binding-id)]
                   [(get input :function-id) (get input :function-core-node-id) (get input :body-core-node-id) (get input :definition-binding-id)])
                (= :gravity.type/bool (get input :return))
                (= 'get (get (get range :access-header) :operation)) (= '+ (get (get range :step-header) :operation))
                (= :operator-then-arguments (get (get (get range :step-header) :source-call) :evaluation-order)
                   (get (get (get range :access-header) :source-call) :evaluation-order) (get (get range :self-call) :evaluation-order))
                (= (get record :function-syntax-id) (get (get range :self-edge) :caller-function-syntax-id)
                   (get (get range :self-edge) :callee-function-syntax-id))
                (= (get record :definition-binding-id) (get (get range :self-edge) :callee-binding-id))
                (= :local-function (get (get range :self-edge) :classification))
                (= 3 (count (get (get range :self-call) :argument-node-ids)))
                (= (get step :operation-core-node-id) (get (get (get range :self-call) :argument-node-ids) 2))
                (loop [headers [(get range :step-header) (get range :access-header)]]
                  (if (= 0 (count headers)) true
                    (let [header (first headers) call (get header :source-call) edge (get header :source-edge)]
                      (if (loop [checks [(= 2 (count (get call :argument-node-ids)))
                                         (= (get header :call-core-node-id) (get call :core-node-id) (get edge :call-core-node-id))
                                         (= (get record :function-syntax-id) (get edge :caller-function-syntax-id))
                                         (= (get record :function-core-node-id) (get edge :caller-function-core-node-id))
                                         (= (get call :argument-node-ids) (get edge :argument-core-node-ids))
                                         (= (get call :ordered-evaluation-node-ids) (get edge :ordered-evaluation-node-ids)
                                            [(get call :operator-node-id) (first (get call :argument-node-ids))
                                             (get (get call :argument-node-ids) 1)])
                                         (= :operator-then-arguments (get call :evaluation-order) (get edge :evaluation-order))]]
                            (if (= 0 (count checks)) true (if (= true (first checks)) (recur (rest checks)) false)))
                        (recur (rest headers)) false))))
                (= (get (get range :self-call) :argument-node-ids) (get (get range :self-edge) :argument-core-node-ids))
                (= (get (get range :self-call) :ordered-evaluation-node-ids) (get (get range :self-edge) :ordered-evaluation-node-ids))
                (= :literal (get unit :core-form)) (= {:literal-kind :integer :value 1} (get unit :attributes)) (= [] (get unit :children))
                (= :integer (get unit-form :kind)) (= 1 (get unit-form :value)) (= [] (get unit-form :child-form-ids))
                (= [(get (get unit :source) :form-id) (get (get unit :source) :syntax-id)]
                   [(get unit-form :form-id) (get unit-form :syntax-id)])
                (= (get unit :node-id) (get (get (get (get range :step-header) :source-call) :argument-node-ids) 1))
                (= #{(get step :operation-core-node-id) (get access :operation-core-node-id)} (set (keys (get metadata :operations))))
                (= step (get (get metadata :operations) (get step :operation-core-node-id)))
                (= access (get (get metadata :operations) (get access :operation-core-node-id)))
                (= false (= (get step :operation-core-node-id) (get access :operation-core-node-id)))
                (loop [remaining ids]
                  (if (= 0 (count remaining)) true
                    (if (p15-s23-runtime-module-id? (get step (first remaining))) (recur (rest remaining)) false)))
                (if (vector? params) (if (= 3 (count params))
                  (loop [remaining params] (if (= 0 (count remaining)) true
                    (if (p15-s23-runtime-module-id? (first remaining)) (recur (rest remaining)) false))) false) false)
                (if (vector? values) (if (= 3 (count values))
                  (if (vector? (get values 0)) (if (= 7 (count (get values 0)))
                    (if (keyword? (get values 1)) (if (integer? (get values 2))
                      (if (<= 0 (get values 2) 7)
                        (loop [remaining (get values 0)] (if (= 0 (count remaining)) true
                          (if (keyword? (first remaining)) (recur (rest remaining)) false))) false) false) false) false) false) false) false)
                (if previous?
                  (let [old (get previous :parameters)]
                    (if (= [(get old 0) (get old 1)] [(get values 0) (get values 1)])
                      (if (< (get old 2) 7) (= (+ (get old 2) 1) (get values 2)) false) false))
                  (= 0 (get values 2)))]]
          (if (= 0 (count checks)) true
            (if (= true (first checks)) (recur (rest checks)) false)))

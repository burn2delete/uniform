              [{:diagnostic "P15S23X002" :reason :indexed-private-strict-range-required} (second evaluated) :rejected])) evaluated))
      [{:diagnostic "P15S23X002" :reason :indexed-private-actual-activation-required} output :rejected])))

(defn p15-s23-runtime-activate-function-in-instance [function values output functions path pool]
  ; A backedge restarts this activation, not an ordinary guest call. Rebuilding
  ; the environment from all collected values drops prior body locals and
  ; replaces parameters simultaneously without changing the active call path.
  (if (if (vector? values) (p15-s23-runtime-function-valid? function (count values)) false)
    (let [params (get function :params []) target (get function :recur-target)
          targets (if (= target nil) [] [{:id target :names params}])]

                (if bindings? (+ (if (vector? values) (count values) 0)
                                 (if (vector? (get instruction :bindings)) (count (get instruction :bindings)) 0))
                (if (= op :if) 3
                (if (= op :throw) 1
                (if (= op :map-literal) (if (vector? entries) (* 2 (count entries)) 0)
                (if (= op :try) (+ 1 (if (vector? entries) (count entries) 0))
                (if (= op :structural-match) (+ 1 (if (vector? entries) (* 2 (count entries)) 0)) 0)))))))))]
    (if (> (+ 1 width) budget) {:status :rejected :reason :module-initialization-work-limit :work-count (+ 1 width)}
      {:status :accepted :work-count (+ 1 width)
       :children (if (if args? true (contains? #{:vector-literal :set-literal :do} op))
                   (if (vector? values) values [])
                 (if bindings?
                   (loop [remaining (if (vector? (get instruction :bindings)) (get instruction :bindings) []) out (if (vector? values) values [])]
                     (if (= 0 (count remaining)) out (recur (rest remaining) (conj out (get (first remaining) :expr)))))
                 (if (= op :if) [(get instruction :test) (get instruction :then) (get instruction :else)]
                 (if (= op :throw) [(get instruction :value)]
                 (if (contains? #{:map-literal :try :structural-match} op)
                   (loop [remaining (if (vector? entries) entries [])
                          out (if (= op :try) [(get instruction :protected)]
                                (if (= op :structural-match) [(get instruction :scrutinee)] []))]
                     (if (= 0 (count remaining)) out
                       (let [entry (first remaining)]
                         (recur (rest remaining)
                           (if (= op :map-literal) (conj (conj out (get entry :key)) (get entry :value))
                             (if (= op :try) (conj out (get entry :body))
                               (if (if (map? entry) (contains? entry :guard) false) (conj (conj out (get entry :guard)) (get entry :body))
                                 (conj out (get entry :body))))))))) [])))))})))

(defn p15-s23-runtime-module-reads-work [functions definitions budget]
  (let [count-functions (if (map? functions) (count functions) 0)]
    (if (> count-functions budget) {:status :rejected :reason :module-initialization-work-limit :work-count count-functions}
      (loop [remaining (if (map? functions) (keys functions) []) pending [] used count-functions]
        (if (= 0 (count pending))
          (if (= 0 (count remaining)) {:status :accepted :work-count used}
            (let [instructions (get (get functions (first remaining)) :instructions)
                  width (if (vector? instructions) (count instructions) 0)]
              (if (> (+ used width) budget) {:status :rejected :reason :module-initialization-work-limit :work-count (+ used width)}
                (recur (rest remaining)
                  (loop [items (if (vector? instructions) instructions []) out []]
                    (if (= 0 (count items)) out (recur (rest items) (conj out {:instruction (first items) :depth 0}))))
                  (+ used width)))))
          (let [frame (get pending (- (count pending) 1)) instruction (get frame :instruction)
                depth (get frame :depth) tail (subvec pending 0 (- (count pending) 1))
                read? (= :namespace-read (get instruction :op))]
            (if (> depth 128) {:status :rejected :reason :module-initialization-work-limit :work-count (+ used 1)}
              (if (if read? (p15-s23-runtime-namespace-read-source? instruction (get definitions (get instruction :binding-id))) true)
                (let [children (p15-s23-runtime-instruction-children instruction (- budget used)) total (+ used (get children :work-count))]
                  (if (= :accepted (get children :status))
                    (recur remaining
                      (loop [items (get children :children) out tail]
                        (if (= 0 (count items)) out
                          (recur (rest items) (conj out {:instruction (first items) :depth (+ depth 1)})))) total)
                    (assoc children :work-count total)))
                {:status :rejected :reason :namespace-read-without-initialized-definition :work-count (+ used 1)}))))))))

(defn p15-s23-runtime-initialize-module [census functions]
  (loop [remaining (get census :initializers) pool {} order [] constructors {}]
    (if (= 0 (count remaining))
      {:status :accepted :pool pool :report {:version :p15-s23-module-literals-v1 :module (get census :module)
        :instance-policy :fresh-per-closed-plan-execution :initialized-binding-ids order :validated-constructor-occurrences constructors}}
      (let [item (first remaining) definition (get item :definition) id (get definition :binding-id)
            result (p15-s23-runtime-evaluate-in-instance (get item :instruction) {} "" functions [] [] nil)]
        (if (if (= :normal (get result 2)) (= "" (second result)) false)
          (recur (rest remaining) (assoc pool id {:definition definition :value (first result)}) (conj order id)
                 (assoc constructors id (get item :constructors)))
          {:status :rejected :reason :module-initialization-evaluation :result result})))))

; Development entrypoint for a closed instruction plan. The result records
; normal completion, a thrown value, or rejection with accumulated output.
; This source revision is not admitted or bound to a current target runtime.
(defn p15-s23-runtime-execute-closed-plan [plan]
  (let [entrypoint (get plan :entrypoint) functions (get plan :functions)
        module? (contains? plan :module-initialization)
        census (if module? (p15-s23-runtime-module-census plan 65536) {:status :accepted})
        reads (if (if module? (= :accepted (get census :status)) false)
                (p15-s23-runtime-module-reads-work functions (get census :definitions) (- 65536 (get census :work-count))) census)
        initialized (if (if module? (= :accepted (get reads :status)) false) (p15-s23-runtime-initialize-module census functions) reads)
        result (if (= :accepted (get initialized :status))
                 (p15-s23-runtime-activate-function-in-instance (get functions entrypoint) [] "" functions [entrypoint] (get initialized :pool))
                 [{:diagnostic "P15S23X002" :reason (get initialized :reason)} "" :rejected])
        base {:artifact :gravity/p15-s23-runtime-closed-plan-execution-record :entrypoint entrypoint
              :stdout (second result) :clojure-seed-boundary? true :self-hosted? false}
        record (if (= false module?) base
                   (if (= :accepted (get initialized :status)) (assoc base :module-initialization (get initialized :report)) base))]
    (if (= :normal (get result 2)) (assoc record :entrypoint-result (first result) :status :complete)
      (if (= :thrown (get result 2)) (assoc record :thrown-value (first result) :status :thrown)
        (assoc record :diagnostic (first result) :status :rejected)))))

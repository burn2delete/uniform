(defn p15-s23-runtime-keyword-set-domain [values budget]
  ; Typed calls supply immutable finite Sets with coherent cardinality and enumeration.
  (if (if (integer? budget) (>= budget 0) false)
    (let [limit (if (< budget 65536) budget 65536)]
      (if (if (vector? values) (= 2 (count values)) false)

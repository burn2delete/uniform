                                      {:status :rejected :reason :set-conversion-keyword-vector-required}))))]
                  (if (= false (= :accepted (get checked :status)))
                    (assoc checked :work-count base :work-count-kind :validation-reservation :comparison-attempts 0 :insertions 0)
                    (let [values (get checked :values)
                          measured (loop [i 0 units 0]
                                     (if (= i n) {:status :accepted :units units}
                                       (let [size (count (str (get values i)))]
                                         (if (> size (- limit units))
                                           {:status :rejected :reason :set-conversion-work-limit :work-count (+ limit 1)
                                            :work-count-kind :exceeded-allowance-lower-bound :comparison-attempts 0 :insertions 0}
                                           (recur (+ i 1) (+ units size))))))]
                      (if (= false (= :accepted (get measured :status))) measured
                        (let [units (get measured :units) half (quot n 2) previous (if (> n 0) (- n 1) 0)
                              a (if (= n (+ half half)) half n) b (if (= n (+ half half)) previous (quot previous 2))]
                          (if (= false (if (= b 0) true (<= a (quot (- limit base) b))))
                            {:status :rejected :reason :set-conversion-work-limit :work-count (+ limit 1)
                             :work-count-kind :exceeded-allowance-lower-bound :comparison-attempts 0 :insertions 0}
                            (let [pairs (* a b) remaining (- limit base pairs)]
                              (if (> units (quot remaining (+ n 1)))
                                {:status :rejected :reason :set-conversion-work-limit :work-count (+ limit 1)
                                 :work-count-kind :exceeded-allowance-lower-bound :comparison-attempts 0 :insertions 0}
                                (let [work (+ base pairs (* (+ n 1) units))
                                      distinct (loop [i 0 representatives [] attempts 0]
                                                 (if (= i n) {:status :accepted :values representatives :comparison-attempts attempts}
                                                   (let [value (get values i)
                                                         checked (loop [j 0 used attempts]
                                                                   (if (= j (count representatives))
                                                                     {:status :accepted :duplicate? false :comparison-attempts used}
                                                                     (let [equal (p15-s23-runtime-atomic-equality value (get representatives j)) next-attempt (+ used 1)]
                                                                       (if (= true equal)
                                                                         {:status :accepted :duplicate? true :comparison-attempts next-attempt}
                                                                         (if (= false equal) (recur (+ j 1) next-attempt)
                                                                           {:status :rejected :reason :set-conversion-keyword-vector-required :comparison-attempts next-attempt})))))]
                                                     (if (= :accepted (get checked :status))
                                                       (recur (+ i 1) (if (get checked :duplicate?) representatives (conj representatives value))
                                                         (get checked :comparison-attempts)) checked))))
                                      result (if (= :accepted (get distinct :status))
                                               (let [representatives (get distinct :values) size (count representatives)]
                                                 {:status :accepted :value (loop [i 0 out #{}]
                                                                           (if (= i size) out (recur (+ i 1) (conj out (get representatives i)))))
                                                  :comparison-attempts (get distinct :comparison-attempts) :insertions size})
                                               (assoc distinct :insertions 0))]
                                  (assoc result :work-count work :work-count-kind :exact-logical-content-reservation
                                    :input-element-count n :representation-units units :representation :jvm-utf16-code-units
                                    :value-work-model :gravity/keyword-vector-set-logical-content-work-v1
                                    :provider-cpu-bound :not-established))))))))))))))
        {:status :rejected :reason :set-conversion-keyword-vector-required :work-count 0 :comparison-attempts 0 :insertions 0}))
    {:status :rejected :reason :set-conversion-work-limit :work-count 0 :comparison-attempts 0 :insertions 0}))

(defn p15-s23-runtime-set-conversion-work [values budget]
  ; This quota is a logical content-work reservation in the selected JVM
  ; representation, not a host hash-trie CPU, native, or realtime bound.
  (if (if (integer? budget) (>= budget 0) false)
    (let [limit (if (< budget 65536) budget 65536)]
      (if (vector? values)
        (let [n (count values)]
          (if (if (< n 0) true (> n 1024)) {:status :rejected :reason :set-conversion-value-width :work-count 1}
            (let [base (+ 1 (* 2 n))]
            (if (> base limit)
              {:status :rejected :reason :set-conversion-work-limit :work-count base :work-count-kind :validation-reservation}
              (if (if (> n 0) (keyword? (get values 0)) false)
                (p15-s23-runtime-keyword-vector-set-work values limit)
                (loop [index 0 units 0]
                (if (= index n)
                  (let [remaining (- limit base)
                        pairs-fit? (if (<= n 1) true (<= n (quot (* 2 remaining) (- n 1))))]
                    (if (= false pairs-fit?)
                      {:status :rejected :reason :set-conversion-work-limit :work-count (+ limit 1)
                       :work-count-kind :exceeded-allowance-lower-bound}
                      (let [pairs (if (<= n 1) 0 (quot (* n (- n 1)) 2))
                            content-left (- remaining pairs)
                            content-fits? (if (= n 0) true (<= units (quot content-left n)))]
                        (if (= false content-fits?)
                          {:status :rejected :reason :set-conversion-work-limit :work-count (+ limit 1)
                           :work-count-kind :exceeded-allowance-lower-bound}
                          (let [work (+ base pairs (* n units))]
                            ; Every member and the complete reservation precede
                            ; the first operation that can hash or insert a value.
                            {:status :accepted :value (set values) :work-count work
                             :work-count-kind :exact-logical-content-reservation
                             :input-element-count n :representation-units units
                             :value-work-model :gravity/string-set-logical-content-work-v1
                             :representation :jvm-utf16-code-units :provider-cpu-bound :not-established})))))
                  (let [value (get values index)]
                    (if (string? value)
                      (let [length (count value)]
                        (if (> length (- limit units))
                          {:status :rejected :reason :set-conversion-work-limit :work-count (+ limit 1)
                           :work-count-kind :exceeded-allowance-lower-bound}
                          (recur (+ index 1) (+ units length))))
                      {:status :rejected :reason :set-conversion-string-vector-required
                       :work-count base :work-count-kind :validation-reservation})))))))))
        {:status :rejected :reason :set-conversion-string-vector-required :work-count 0}))
    {:status :rejected :reason :set-conversion-work-limit :work-count 0}))

(defn p15-s23-runtime-evaluate-in-instance
  [instruction environment output functions path targets pool]
  (if (contains? #{:gravity.runtime/indexed-private-self-unit-addition :gravity.runtime/indexed-private-self-vector-get}
        (get (get instruction :proof) :kind))
    (p15-s23-runtime-evaluate-indexed-operation instruction environment output functions path pool)
  (let [operation (get instruction :op)
        fields (if (map? instruction) (set (keys instruction)) #{})
        arguments (get instruction :args)
        function (get instruction :function)
        comparison? (contains? '#{= < <= > >=} function)
        shape?
        (if (= operation :namespace-read) (p15-s23-runtime-namespace-read-valid? instruction pool)
        (if (map? instruction)
          (if (contains? #{:literal :quote} operation) true
          (if (= operation :structural-match) (p15-s23-runtime-structural-match-valid? instruction)
          (if (= operation :keyword-map-lookup)
            (if (= fields #{:op :args})
              (if (vector? arguments)
                (if (= 2 (count arguments))
                  (let [key (first arguments)]
                    (if (map? key)
                      (if (= #{:op :value} (set (keys key)))
                        (if (= :literal (get key :op))
                          (if (keyword? (get key :value)) (map? (second arguments)) false) false) false) false)) false) false) false)
          (if (= operation :map-literal)
            (if (= fields #{:op :entries})
              (if (vector? (get instruction :entries))
                (if (<= (count (get instruction :entries)) 65536)
                  (loop [remaining (get instruction :entries) seen #{}]
                    (if (= 0 (count remaining)) true
                      (let [entry (first remaining) key (get entry :key)]
                        (if (if (map? entry) (= #{:key :value} (set (keys entry))) false)
                          (if (if (map? key) (= #{:op :value} (set (keys key))) false)
                            (if (if (= :literal (get key :op)) (keyword? (get key :value)) false)
                              (if (contains? seen (get key :value)) false
                                (if (map? (get entry :value)) (recur (rest remaining) (conj seen (get key :value))) false)) false) false) false)))) false) false) false)
          (if (= operation :set-literal)
            (if (= fields #{:op :items})
              (if (vector? (get instruction :items))
                (if (<= (count (get instruction :items)) 1024)
                  (loop [remaining (get instruction :items)]
                    (if (= 0 (count remaining)) true
                      (let [item (first remaining)]
                        (if (map? item)
                          (if (if (= 2 (count item))
                                (if (= :literal (get item :op)) (keyword? (get item :value)) false) false)
                            (recur (rest remaining)) false) false)))) false) false) false)
          (if (= operation :vector-literal)
            (if (= fields #{:op :items})
              (if (vector? (get instruction :items))

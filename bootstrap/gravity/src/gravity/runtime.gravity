                      (let [values (get checked :values) units (get checked :units)
                            half (quot n 2) previous (if (> n 0) (- n 1) 0)
                            a (if (= n (+ half half)) half n) b (if (= n (+ half half)) previous (quot previous 2))]
                        (if (= false (if (= b 0) true (<= a (quot (- limit base) b))))
                          {:status :rejected :reason :character-set-contains-work-limit :work-count (+ limit 1)
                           :work-count-kind :exceeded-allowance-lower-bound :comparison-attempts 0}
                          (let [pairs (* a b) remaining (- limit base pairs)]
                            (if (> units (quot remaining (+ n 1)))
                              {:status :rejected :reason :character-set-contains-work-limit :work-count (+ limit 1)
                               :work-count-kind :exceeded-allowance-lower-bound :comparison-attempts 0}
                              (let [work (+ base pairs (* (+ n 1) units))
                                    distinct (loop [i 0 attempts 0]
                                               (if (= i n) {:status :accepted :comparison-attempts attempts}
                                                 (let [checked (loop [j (+ i 1) used attempts]
                                                                 (if (= j n) {:status :accepted :comparison-attempts used}
                                                                   (let [equal (p15-s23-runtime-atomic-equality (get values i) (get values j))
                                                                         next-attempt (+ used 1)]
                                                                     (if (= false equal) (recur (+ j 1) next-attempt)
                                                                       {:status :rejected :reason :character-set-contains-value-domain-required
                                                                        :domain-failure :duplicate-or-unsupported-character-class
                                                                        :comparison-attempts next-attempt}))))]
                                                   (if (= :accepted (get checked :status))
                                                     (recur (+ i 1) (get checked :comparison-attempts)) checked))))
                                    result (if (= :accepted (get distinct :status))
                                             (loop [i 0 attempts (get distinct :comparison-attempts)]
                                               (if (= i n) {:status :accepted :value false :comparison-attempts attempts}
                                                 (let [equal (p15-s23-runtime-atomic-equality (get values i) needle)
                                                       next-attempt (+ attempts 1)]
                                                   (if (= true equal) {:status :accepted :value true :comparison-attempts next-attempt}
                                                     (if (= false equal) (recur (+ i 1) next-attempt)
                                                       {:status :rejected :reason :character-set-contains-value-domain-required
                                                        :comparison-attempts next-attempt}))))) distinct)]
                                (assoc result :work-count work :work-count-kind :exact-logical-membership-reservation
                                  :input-element-count n :representation-units units :representation :jvm-utf16-code-units
                                  :value-work-model :gravity/character-set-membership-logical-content-work-v1
                                  :character-premise :existing-atomic-character-ir-values :source-decoding :c2-owned
                                  :provider-cpu-bound :not-established))))))))))))
          {:status :rejected :reason :character-set-contains-value-domain-required :work-count 2 :comparison-attempts 0})))
    {:status :rejected :reason :character-set-contains-work-limit :work-count 0 :comparison-attempts 0}))

(defn p15-s23-runtime-keyword-set-equality-work [left right budget]
  ; Prepay all cross-membership and within-operand distinctness comparisons.
  ; Representation units measure cost only; the guarded Keyword leaf decides equality.
  (let [domain (p15-s23-runtime-keyword-set-domain [left right] budget)]
    (if (= :accepted (get domain :status))
      (let [limit (if (< budget 65536) budget 65536)
            n (get (get domain :operand-counts) 0) m (get (get domain :operand-counts) 1)
            cl (get (get domain :representation-units) 0) cr (get (get domain :representation-units) 1)
            initial (+ 1 (get domain :work-count))
            nl (if (> n 0) (- n 1) 0) mr (if (> m 0) (- m 1) 0)
            nh (quot n 2) mh (quot m 2)
            left-pair (if (= n (+ nh nh)) [nh nl] [n (quot nl 2)])
            right-pair (if (= m (+ mh mh)) [mh mr] [m (quot mr 2)])
            factors [[n m] [m cl] [n cr] left-pair right-pair [nl cl] [mr cr]]
            reservation
            (if (> initial limit)
              {:status :rejected :reason :keyword-set-equality-work-limit :work-count initial
               :work-count-kind :logical-reservation-including-failed-attempt :comparison-attempts 0}
              (loop [i 0 used initial]
                (if (= i 7) {:status :accepted :work-count used}
                  (let [pair (get factors i) a (get pair 0) b (get pair 1)]
                    (if (if (= 0 b) true (<= a (quot (- limit used) b)))
                      (recur (+ i 1) (+ used (* a b)))
                      {:status :rejected :reason :keyword-set-equality-work-limit :work-count (+ limit 1)
                       :work-count-kind :exceeded-allowance-lower-bound :comparison-attempts 0})))))]
        (if (= :accepted (get reservation :status))
          (let [values [left right] counts [n m]
                distinct
                (loop [side 0 attempts 0]
                  (if (= side 2) {:status :accepted :comparison-attempts attempts}
                    (let [width (get counts side)
                          checked
                          (loop [remaining (get values side) index 0 used attempts]
                            (if (= index width) {:status :accepted :comparison-attempts used}
                              (let [a (first remaining)
                                    pairs
                                    (loop [others (rest remaining) offset (+ index 1) attempted used]
                                      (if (= offset width) {:status :accepted :comparison-attempts attempted}
                                        (let [b (first others)]
                                          (if (if (keyword? a) (keyword? b) false)
                                            (let [equal (p15-s23-runtime-atomic-equality a b) next-attempt (+ attempted 1)]
                                              (if (= false equal)
                                                (recur (rest others) (+ offset 1) next-attempt)
                                                {:status :rejected :reason :keyword-set-value-domain-required
                                                 :domain-failure :duplicate-or-unsupported-keyword-class
                                                 :comparison-attempts next-attempt}))
                                            {:status :rejected :reason :keyword-set-value-domain-required :comparison-attempts attempted}))))]
                                (if (= :accepted (get pairs :status))
                                  (recur (rest remaining) (+ index 1) (get pairs :comparison-attempts)) pairs))))]
                      (if (= :accepted (get checked :status))
                        (recur (+ side 1) (get checked :comparison-attempts)) checked))))
                compared
                (if (= :accepted (get distinct :status))
                  (if (= false (= n m))
                    {:status :accepted :value false :comparison-attempts (get distinct :comparison-attempts)}
                    (loop [remaining-left left index 0 attempts (get distinct :comparison-attempts)]
                      (if (= index n) {:status :accepted :value true :comparison-attempts attempts}
                        (let [a (first remaining-left)
                              found
                              (if (keyword? a)
                                (loop [remaining-right right offset 0 used attempts]
                                  (if (= offset m) {:status :accepted :value false :comparison-attempts used}
                                    (let [b (first remaining-right)]
                                      (if (keyword? b)
                                        (let [equal (p15-s23-runtime-atomic-equality a b) next-attempt (+ used 1)]
                                          (if (= true equal)
                                            {:status :accepted :value true :comparison-attempts next-attempt}
                                            (if (= false equal)
                                              (recur (rest remaining-right) (+ offset 1) next-attempt)
                                              {:status :rejected :reason :keyword-set-value-domain-required :comparison-attempts next-attempt})))
                                        {:status :rejected :reason :keyword-set-value-domain-required :comparison-attempts used}))))
                                {:status :rejected :reason :keyword-set-value-domain-required :comparison-attempts attempts})]
                          (if (= :accepted (get found :status))
                            (if (= true (get found :value))
                              (recur (rest remaining-left) (+ index 1) (get found :comparison-attempts)) found) found)))))
                  distinct)]
            (assoc compared :work-count (get reservation :work-count) :work-count-kind :exact-logical-comparison-reservation
              :operand-counts counts :representation-units (get domain :representation-units)
              :provider-cpu-bound :not-established))
          (assoc reservation :provider-cpu-bound :not-established)))
      domain)))

(defn p15-s23-runtime-vector-domain [values budget]
  (let [limit (if (< budget 65536) budget 65536)]
  (if (if (vector? values) (= 2 (count values)) false)
    (if (if (vector? (get values 0)) (vector? (get values 1)) false)
      (if (< limit 2) {:status :rejected :reason :vector-equality-work-limit :work-count 2}
        (loop [pending [[(get values 1) 0] [(get values 0) 0]] work 2]
          (if (= 0 (count pending)) {:status :accepted :work-count work}
            (let [frame (get pending (- (count pending) 1)) tail (subvec pending 0 (- (count pending) 1))
                  value (get frame 0) depth (get frame 1)]
              (if (> depth 128) {:status :rejected :reason :vector-equality-value-depth :work-count work}
                (if (vector? value)
                  (let [width (count value) total (+ work width)]
                    (if (> width 1024) {:status :rejected :reason :vector-equality-value-width :work-count work}
                    (if (> total limit) {:status :rejected :reason :vector-equality-work-limit :work-count total}
                      (if (if (= depth 128) (> width 0) false)
                        {:status :rejected :reason :vector-equality-value-depth :work-count total}
                        (let [children (loop [i (- width 1) out tail]
                                         (if (< i 0) out
                                           (recur (- i 1) (conj out [(get value i) (+ depth 1)]))))]
                          (recur children total))))))
                  (if (if (integer? value) false (= true (p15-s23-runtime-atomic-equality value value)))
                    (recur tail work)
                    {:status :rejected :reason :vector-value-equality-domain-required :work-count work})))))))
      {:status :rejected :reason :vector-value-equality-domain-required :work-count 0})
    {:status :rejected :reason :vector-value-equality-domain-required :work-count 0})))

(defn p15-s23-runtime-vector-equality-work [left right budget]
  (let [limit (if (< budget 65536) budget 65536)]
  ; Validate BOTH complete value domains before any early mismatch can return.
  (let [domain (p15-s23-runtime-vector-domain [left right] limit)]
    (if (= :accepted (get domain :status))
      (let [initial (+ 1 (get domain :work-count))]
        (if (> initial limit) {:status :rejected :reason :vector-equality-work-limit :work-count initial}
          (loop [pending [[left right]] work initial]
            (if (= 0 (count pending)) {:status :accepted :value true :work-count work}
              (let [pair (get pending (- (count pending) 1)) tail (subvec pending 0 (- (count pending) 1))
                    a (get pair 0) b (get pair 1)]
                (if (vector? a)
                  (if (vector? b)
                    (if (= (count a) (count b))
                      (let [total (+ work (count a))]
                        (if (> total limit) {:status :rejected :reason :vector-equality-work-limit :work-count total}
                          (let [children (loop [i (- (count a) 1) out tail]
                                           (if (< i 0) out
                                             (recur (- i 1) (conj out [(get a i) (get b i)]))))]
                            (recur children total))))
                      {:status :accepted :value false :work-count work})
                    {:status :accepted :value false :work-count work})
                  (if (vector? b) {:status :accepted :value false :work-count work}
                    (let [equal (p15-s23-runtime-atomic-equality a b)]
                      (if (= true equal) (recur tail work)
                        (if (= false equal) {:status :accepted :value false :work-count work}
                          {:status :rejected :reason :vector-value-equality-domain-required :work-count work})))))))))) domain))))

(defn p15-s23-runtime-vector-equality [left right]
  (let [result (p15-s23-runtime-vector-equality-work left right 65536)]
    (if (= :accepted (get result :status)) (get result :value) :unsupported)))

(defn p15-s23-runtime-keyword-set-construction-work [input budget]
  ; Logical selected-JVM content reservation, not a provider CPU bound.
  ; Freeze Keyword values before comparing them or inserting into a host Set.
  (if (if (integer? budget) (>= budget 0) false)
    (let [limit (if (< budget 65536) budget 65536)]
      (if (vector? input)
        (let [n (count input)]
          (if (if (< n 0) true (> n 1024)) {:status :rejected :reason :set-literal-value-width :work-count 1 :comparison-attempts 0 :insertions 0}
            (let [base (+ 1 (* 2 n))]
              (if (> base limit)
                {:status :rejected :reason :set-literal-work-limit :work-count base :work-count-kind :validation-reservation
                 :comparison-attempts 0 :insertions 0}
                (let [checked (loop [i 0 values []]
                                (if (= i n) {:status :accepted :values values}
                                  (let [value (get input i)]
                                    (if (keyword? value) (recur (+ i 1) (conj values value))
                                      {:status :rejected :reason :set-literal-keyword-domain-required}))))]
                  (if (= false (= :accepted (get checked :status)))
                    (assoc checked :work-count base :work-count-kind :validation-reservation :comparison-attempts 0 :insertions 0)
                    (let [values (get checked :values)
                          measured (loop [i 0 units 0]
                                     (if (= i n) {:status :accepted :units units}
                                       (let [size (count (str (get values i)))]
                                         (if (> size (- limit units))
                                           {:status :rejected :reason :set-literal-work-limit :work-count (+ limit 1)
                                            :work-count-kind :exceeded-allowance-lower-bound :comparison-attempts 0 :insertions 0}
                                           (recur (+ i 1) (+ units size))))))]
                      (if (= false (= :accepted (get measured :status))) measured
                        (let [units (get measured :units) half (quot n 2) previous (if (> n 0) (- n 1) 0)
                              a (if (= n (+ half half)) half n) b (if (= n (+ half half)) previous (quot previous 2))]
                          (if (= false (if (= b 0) true (<= a (quot (- limit base) b))))
                            {:status :rejected :reason :set-literal-work-limit :work-count (+ limit 1)
                             :work-count-kind :exceeded-allowance-lower-bound :comparison-attempts 0 :insertions 0}
                            (let [pairs (* a b) remaining (- limit base pairs)]
                              (if (> units (quot remaining (+ n 1)))
                                {:status :rejected :reason :set-literal-work-limit :work-count (+ limit 1)
                                 :work-count-kind :exceeded-allowance-lower-bound :comparison-attempts 0 :insertions 0}
                                (let [work (+ base pairs (* (+ n 1) units))
                                      distinct (loop [i 0 attempts 0]
                                                 (if (= i n) {:status :accepted :comparison-attempts attempts}
                                                   (let [checked (loop [j (+ i 1) used attempts]
                                                                   (if (= j n) {:status :accepted :comparison-attempts used}
                                                                     (let [left (get values i) right (get values j)]
                                                                       (if (if (keyword? left) (keyword? right) false)
                                                                         (let [equal (p15-s23-runtime-atomic-equality left right) next-attempt (+ used 1)]
                                                                           (if (= false equal) (recur (+ j 1) next-attempt)
                                                                             {:status :rejected :reason :duplicate-set-literal-keyword :comparison-attempts next-attempt}))
                                                                         {:status :rejected :reason :set-literal-keyword-domain-required :comparison-attempts used}))))]
                                                     (if (= :accepted (get checked :status))
                                                       (recur (+ i 1) (get checked :comparison-attempts)) checked))))
                                      result (if (= :accepted (get distinct :status))
                                               {:status :accepted :value (loop [i 0 out #{}]
                                                                         (if (= i n) out (recur (+ i 1) (conj out (get values i)))))
                                                :comparison-attempts (get distinct :comparison-attempts) :insertions n}
                                               (assoc distinct :insertions 0))]
                                  (assoc result :work-count work :work-count-kind :exact-logical-content-reservation
                                    :input-element-count n :representation-units units :representation :jvm-utf16-code-units
                                    :value-work-model :gravity/literal-keyword-set-logical-content-work-v1
                                    :provider-cpu-bound :not-established))))))))))))))
        {:status :rejected :reason :set-literal-keyword-domain-required :work-count 0 :comparison-attempts 0 :insertions 0}))
    {:status :rejected :reason :set-literal-work-limit :work-count 0 :comparison-attempts 0 :insertions 0}))

(defn p15-s23-runtime-keyword-vector-set-work [input budget]
  ; Logical selected-JVM content reservation, not a provider CPU bound.
  ; Freeze Keyword values before comparing them or inserting into a host Set.
  (if (if (integer? budget) (>= budget 0) false)
    (let [limit (if (< budget 65536) budget 65536)]
      (if (vector? input)
        (let [n (count input)]
          (if (if (< n 0) true (> n 1024)) {:status :rejected :reason :set-conversion-value-width :work-count 1 :comparison-attempts 0 :insertions 0}
            (let [base (+ 1 (* 2 n))]

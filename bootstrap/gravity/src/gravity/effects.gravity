    (if (body-all?
          [(= :call (get node :core-form)) (= :reference (get operator :core-form))
           (= 2 (count args)) (= expected-call call) (= expected-edge edge) (body-vn-binding? binding module)
           (= [bid] (get node :resolved-binding-ids) (get operator :resolved-binding-ids))
           (= {:symbol (get (get operator :attributes) :symbol) :position :operator :binding-id bid :binding-class :core
               :definition-syntax-id (get binding :definition-syntax-id)} (get operator :attributes))
           (contains? '#{nth gravity.core/nth} (get (get operator :attributes) :symbol))
           (= :operator-then-arguments (get (get node :evaluation) :kind))
           (= (loop [i 0 out []] (if (= i (count children)) out
                (recur (+ i 1) (conj out {:index i :core-node-id (get children i)})))) (get (get node :evaluation) :order))
           (= :gravity.type/vector (get vector-type :kind))
           (body-vl-homogeneous? elements)
           (= :gravity.type/integer index-type) (= :reference (get index-node :core-form))
           (loop [remaining arguments]
             (if (= 0 (count remaining)) true
               (if (contains? #{nil :gravity.type/unknown} (first remaining)) false (recur (rest remaining)))))] )
      {:kind :gravity.type/applied-vector-nth :version :sh08-vector-nth-loop-v1
       :operation 'nth :semantic-owner 'gravity.collections :intrinsic :gravity.collections/proven-vector-nth
       :resolution :gravity.core-compatibility :operator-node-id (get operator :node-id) :operator-binding-id bid
       :call-core-node-id (get node :node-id) :source (get node :source) :operator-source (get operator :source)
       :source-call call :source-edge edge :source-binding binding :argument-types arguments
       :query-semantics {:operation :vector-element-access :construction :none
                         :operand-evaluation :operator-then-vector-then-index :normal-input :homogeneous-vector-and-invariant-slot}
       :index-value nil :vector-length length :selected-type selected
       :bounds-proof nil :application :normal
       :latent-effects [] :direct-effects [] :capabilities [] :thrown-error-effects []
       :profile (get module :profile) :target (get module :target)
       :invalidation [:calls :call-edges :binding-table :source-forms :type-table :lexical-bindings :definitions :function-records
                      :loop-bindings :recur-targets :recur-transfers :callee-body :constructor-or-quote-shape :profile :target :evaluation-order]} nil)) nil))

(defn body-vl-path-valid? [path leaf root nodes]
  (if (vector? path)
    (if (if (> (count path) 0) (<= (count path) 129) false)
      (body-all? [(= leaf (get (get (first path) :node) :node-id))
        (= root (get (get (get path (- (count path) 1)) :node) :node-id))
        (loop [i 0]
          (if (= i (count path)) true
            (let [entry (get path i)]
              (if (map? entry)
                (let [actual (get entry :node)]
                  (if (body-all? [(= #{:node :child-index} (set (keys entry)))
                         (= actual (get nodes (get actual :node-id)))
                         (= false (contains? #{:loop :fn} (get actual :core-form)))
                         (if (= i 0) (= nil (get entry :child-index))
                           (= (get (get (get path (- i 1)) :node) :node-id) (get (get actual :children) (get entry :child-index))))])
                    (recur (+ i 1)) false)) false))))]) false) false))

(defn body-vl-bounds [header invariant origin path nodes]
  (let [args (get (get header :source-call) :argument-node-ids)]
    {:kind :gravity.safety/vector-index-bounds :rule "SAFE2-BOUNDS" :outcome :proven-safe
     :scope :index-within-loop-guard-and-vector-origin :predicate :zero-le-index-lt-length
     :access-core-node-id (get header :call-core-node-id)
     :vector-node-id (first args) :index-node-id (get args 1) :vector-type (first (get header :argument-types))
     :index-value nil :vector-length (get header :vector-length) :selected-type (get header :selected-type)
     :index-source (get (get nodes (get args 1)) :source) :slot-binding-id (get (get invariant :range-proof) :slot-binding-id)
     :loop-invariant invariant :vector-origin origin :guard-path path
     :check-elision :not-authorized :runtime-guards :retained}))

(defn body-vl-proof-valid? [descriptor core node nodes bindings types]
  (let [calls (body-index (get core :calls) :core-node-id) edges (body-index (get core :call-edges) :call-core-node-id)
        call (get calls (get node :node-id)) header (body-vl-source core node call (get edges (get node :node-id)) nodes bindings types (get core :module))
        proof (get descriptor :bounds-proof) invariant (get proof :loop-invariant) range (get invariant :range-proof)
        anchor (get nodes (get invariant :call-core-node-id)) anchor-call (get calls (get anchor :node-id))
        anchor-header (body-si-source core anchor anchor-call (get edges (get anchor :node-id)) nodes bindings types (get core :module))
        args (get call :argument-node-ids) index (get nodes (get args 1)) origin (get proof :vector-origin)
        path (get proof :guard-path) bound-origin (get range :vector-origin) bid (get range :slot-binding-id)]
    (if (if (map? header) (if (map? invariant) (map? anchor-header) false) false)
      (body-all? [
        (= invariant (get types (get anchor-call :operator-node-id)))
        (= invariant (body-si-finish (assoc anchor-header :range-proof range)))
        (body-si-proof-closed? range core anchor nodes bindings types)
        (= bid (get (get index :attributes) :binding-id)) (= [bid] (get index :resolved-binding-ids))
        (= (get header :vector-length) (get range :vector-extent))
        (= (get (get origin :node) :node-id) (get (get bound-origin :node) :node-id))
        (= (get origin :type) (get bound-origin :type) (first (get header :argument-types)))
        (body-si-origin-closed? origin (first args) (first (get header :argument-types)) core nodes types)
        (body-vl-path-valid? path (get node :node-id) (get (get (get range :guard-node) :children) 1) nodes)
        (= proof (body-vl-bounds header invariant origin path nodes))
        (= descriptor (body-vn-finish (assoc header :bounds-proof proof)))]) false)))

(defn body-vl-call-valid? [core facts bindings node call edge nodes]
  (let [types (get facts :type-table) descriptor (get types (get call :operator-node-id))
        forms (get (get facts :vector-nth-context) :forms)
        owner (get forms (get (get node :source) :form-id)) ids (get owner :child-form-ids)
        rows (body-select (body-select (get facts :constraint-ledger) :producer-rule :sh08-vector-nth-v1)
                          :lhs {:core-node-id (get node :node-id) :projection :vector-element})
        index-binding (get bindings (get (get descriptor :bounds-proof) :slot-binding-id))]
    (if (body-vl-proof-valid? descriptor core node nodes bindings types)
      (body-all? [(= (get descriptor :result-type) (get types (get node :node-id)))
        (= :list (get owner :kind)) (vector? ids) (= 3 (if (vector? ids) (count ids) 0) (count (get node :children)))
        (= (get node :source) (body-throw-source owner))
        (= {:operator-child-index 0 :argument-count 2 :argument-child-indexes [1 2]
            :evaluation-order :operator-then-arguments :dispatch :resolved-symbol-call} (get node :attributes))
        (loop [i 0]
          (if (= i 3) true
            (let [form (get forms (get ids i)) child (get nodes (get (get node :children) i))]
              (if (body-all? [(= (get owner :form-id) (get form :parent-form-id))
                    (= (get child :source) (body-throw-source form))
                    (if (= i 0) (= (get form :value) (get (get child :attributes) :symbol)) true)
                    (if (= i 2) (if (= :symbol (get form :kind)) (= (get form :value) (get index-binding :name)) false) true)])
                (recur (+ i 1)) false))))
        (= (body-vn-call-fact descriptor (get core :module)) (body-by (get facts :call-type-facts) :call-core-node-id (get node :node-id)))
        (= [(body-vn-constraint descriptor)] rows)]) false)))


(defn body-vn-call-valid? [core facts bindings node call edge nodes]
  (if (= :sh08-vector-nth-loop-v1 (get (get (get facts :type-table) (get call :operator-node-id)) :version))
    (body-vl-call-valid? core facts bindings node call edge nodes)

  ; Bounds and selected type follow the typed vector and source literal. This
  ; does not reimplement the C7 shape solver or authorize check elimination.
  (let [types (get facts :type-table) descriptor (get types (get call :operator-node-id))
        header (body-vn-source core node call edge nodes bindings types (get core :module))
        forms (get (get facts :vector-nth-context) :forms)
        owner (get forms (get (get node :source) :form-id)) ids (get owner :child-form-ids)
        rows (body-select (body-select (get facts :constraint-ledger) :producer-rule :sh08-vector-nth-v1)
                          :lhs {:core-node-id (get node :node-id) :projection :vector-element})]
    (if (map? header)
      (body-all?
        [(= descriptor (body-vn-finish header)) (= (get descriptor :result-type) (get types (get node :node-id)))
         (= :list (get owner :kind)) (vector? ids) (= 3 (if (vector? ids) (count ids) 0) (count (get node :children)))
         (= (get node :source) (get (body-ma-form-node {} owner) :source))
         (= {:operator-child-index 0 :argument-count 2 :argument-child-indexes [1 2]
             :evaluation-order :operator-then-arguments :dispatch :resolved-symbol-call} (get node :attributes))
         (loop [i 0]
           (if (= i 3) true
             (let [form (get forms (get ids i)) child (get nodes (get (get node :children) i))]
               (if (body-all? [(= (get owner :form-id) (get form :parent-form-id))
                     (= (get child :source) (get (body-ma-form-node {} form) :source))
                     (if (= i 0) (= (get form :value) (get (get child :attributes) :symbol)) true)
                     (if (= i 2) (if (= :gravity.type/never (get types (get (get call :argument-node-ids) 1))) true
                       (if (= :integer (get form :kind)) (= (get form :value) (get header :index-value)) false)) true)])
                 (recur (+ i 1)) false))))
         (= (body-vn-call-fact descriptor (get core :module)) (body-by (get facts :call-type-facts) :call-core-node-id (get node :node-id)))
         (= [(body-vn-constraint descriptor)] rows)]) false))) )

(defn body-vn-node? [node facts core]
  (let [context (get facts :vector-nth-context) id (get node :node-id)]
    (if (map? context)
      (body-vn-call-valid? core facts (get context :bindings) node (get (get context :calls) id)
                          (get (get context :edges) id) (get context :nodes)) false)))

(defn body-ma-context [request facts bindings budget]
  (let [core (get request :canonical-core-artifact)
        selected (loop [remaining (get core :calls) out []]
                   (if (= 0 (count remaining)) out
                     (recur (rest remaining)
                       (if (body-ma-binding? (get bindings (get (first remaining) :operator-binding-id)) (get core :module))
                         (conj out (first remaining)) out))))]
    (if (= 0 (count selected)) {:status :accepted :context nil :work-count 0}
      (let [forms (body-path request [:b47-context :authenticated-core-request :forms])]
        (if (= false (vector? forms)) (body-failure :body-map-association-source-forms-required)
        (let [work (+ (count forms) (count bindings) (count (get core :nodes)) (count (get core :calls)) (count (get core :call-edges))
                      (* (count selected) (+ 64 (count (get core :function-records)))))]
        (if (> work budget) (body-failure :body-deferred-work-limit)
          {:status :accepted :work-count work
           :context {:forms (body-index forms :form-id) :nodes (body-index (get core :nodes) :node-id)
                     :calls (body-index (get core :calls) :core-node-id) :edges (body-index (get core :call-edges) :call-core-node-id)
                     :bindings bindings}})))))))

(defn body-ma-call-valid? [core facts bindings node call edge nodes]
  ; C7 owns the deep shape and transition proof. Reconstruct C8's finite
  ; dispatch, source, type views and allocation premises; retain opaque C7
  ; evidence exactly across its three identity-bound products.
  (let [types (get facts :type-table) descriptor (get types (get call :operator-node-id))
        header (body-ma-source core node call edge nodes bindings types (get core :module))
        forms (get (get facts :association-context) :forms)
        owner (get forms (get (get node :source) :form-id)) ids (get owner :child-form-ids)
        input-type (get (get descriptor :argument-types) 0) value-type (get (get descriptor :argument-types) 2)
        result (get types (get node :node-id)) normal? (= :normal (get header :application))
        rows (body-select (body-select (get facts :constraint-ledger) :producer-rule :sh08-map-association-v1)
                          :lhs {:core-node-id (get node :node-id) :projection :persistent-map-association})]
    (if (map? header)
      (body-all?
        [(= header (body-project descriptor (vec (keys header))))
         (= (set (keys descriptor)) (set (body-add [:input-shape :value-shape :transition :result-shape :parameter-types :return :result-type]
                                                   (vec (keys header)))))
         (= (get descriptor :parameter-types) (get header :argument-types))
         (= result (get descriptor :return) (get descriptor :result-type))
         (if (= input-type :gravity.type/never) (= nil (get descriptor :input-shape))
           (if (= :gravity.type/map (get input-type :kind))
             (if (map? (get descriptor :input-shape)) (= input-type (get (get descriptor :input-shape) :type)) false) false))
         (if (map? (get descriptor :value-shape)) (= value-type (get (get descriptor :value-shape) :type)) false)
         (if normal? (if (= :gravity.type/map (get result :kind))
                       (if (map? (get descriptor :result-shape)) (= result (get (get descriptor :result-shape) :type)) false) false)
           (body-all? [(= result :gravity.type/never) (= nil (get descriptor :result-shape)) (= nil (get descriptor :transition))]))
         (= :list (get owner :kind)) (vector? ids) (= 4 (count ids) (count (get node :children)))
         (= (get node :source) (get (body-ma-form-node {} owner) :source))
         (= {:operator-child-index 0 :argument-count 3 :argument-child-indexes [1 2 3]
             :evaluation-order :operator-then-arguments :dispatch :resolved-symbol-call} (get node :attributes))
         (loop [i 0]
           (if (= i 4) true
             (let [form (get forms (get ids i)) child (get nodes (get (get node :children) i))]
               (if (body-all? [(= (get owner :form-id) (get form :parent-form-id))
                     (= (get child :source) (get (body-ma-form-node {} form) :source))
                     (if (= i 0) (= (get form :value) (get (get child :attributes) :symbol)) true)
                     (if (= i 2) (if (= :keyword (get form :kind)) (= (get form :value) (get header :key)) false) true)])
                 (recur (+ i 1)) false))))
         (= (body-ma-call-fact descriptor (get core :module))
            (body-by (get facts :call-type-facts) :call-core-node-id (get node :node-id)))
         (= [(body-ma-constraint descriptor)] rows)]) false)))

(defn body-ma-form-node [node form]
  (assoc node :source {:form-id (get form :form-id) :syntax-id (get form :syntax-id) :semantic-span (get form :source-span)
                       :origin-chain (get form :origin-chain) :generated-origin (get form :generated-origin)}))

(defn body-ma-node? [node facts core]
  (let [context (get facts :association-context) id (get node :node-id)]
    (if (map? context)
      (body-ma-call-valid? core facts (get context :bindings) node (get (get context :calls) id)
                          (get (get context :edges) id) (get context :nodes)) false)))

(defn body-mr-context [request facts bindings budget]
  (let [core (get request :canonical-core-artifact)
        selected (loop [remaining (get core :calls) out []]
                   (if (= 0 (count remaining)) out
                     (recur (rest remaining)
                       (if (body-mr-binding? (get bindings (get (first remaining) :operator-binding-id)) (get core :module))
                         (conj out (first remaining)) out))))]
    (if (= 0 (count selected)) {:status :accepted :context nil :work-count 0}
      (let [forms (body-path request [:b47-context :authenticated-core-request :forms])
            transition-work (loop [remaining selected out 0]
                              (if (= 0 (count remaining)) out
                                (let [descriptor (get (get facts :type-table) (get (first remaining) :operator-node-id))
                                      input-type (get (get facts :type-table) (get (get (first remaining) :argument-node-ids) 0))
                                      parts (get (get descriptor :input-shape) :parts)]
                                  (recur (rest remaining) (+ out (if (= :gravity.type/map input-type) 1
                                                                  (+ 2 (* 4 (if (vector? parts) (count parts) 0)))))))))
            work (+ (if (vector? forms) (count forms) 0) (count bindings) (count (get core :nodes)) (count (get core :calls)) (count (get core :call-edges))
                    (* (count selected) (+ 64 (count (get core :function-records)))) transition-work)]
        (if (= false (vector? forms)) (body-failure :body-map-removal-source-forms-required)
          (if (> work budget) (body-failure :body-deferred-work-limit)
            {:status :accepted :work-count work
             :context {:forms (body-index forms :form-id) :nodes (body-index (get core :nodes) :node-id)
                       :calls (body-index (get core :calls) :core-node-id) :edges (body-index (get core :call-edges) :call-core-node-id)
                       :bindings bindings}}))))))

(defn body-mr-call-valid? [core facts bindings node call edge nodes]
  ; C7 owns the input shape. C8 independently reconstructs removal, including
  ; original survivor sources, derived coordinates, allocation and ledger joins.
  (let [types (get facts :type-table) descriptor (get types (get call :operator-node-id))
        header (body-mr-source core node call edge nodes bindings types (get core :module))
        family? (= :gravity.type/map (get (get header :argument-types) 0))
        input (get descriptor :input-shape) input-work (if family? 0 (get input :call-join-work 0))
        transition (if family? {:status :accepted :work-count 1}
                     (if (= :normal (get header :application))
                       (body-mr-transition input (get header :key) 65536) {:status :accepted :work-count 0}))
        used (+ 64 (if (vector? (get call :argument-node-ids)) (count (get call :argument-node-ids)) 0)
                (count (get core :function-records)) (if (integer? input-work) input-work 0) (get transition :work-count))
        rows (body-select (body-select (get facts :constraint-ledger) :producer-rule :sh08-map-removal-v1)
                          :lhs {:core-node-id (get node :node-id) :projection :persistent-map-removal})]
    (if (map? header)
      (if (= :accepted (get transition :status))
        (body-all?
          [(if (integer? input-work) (<= 0 input-work) false)
           (= descriptor (if family? (get (body-mr-family-finish header nodes used) :descriptor)
                           (get (body-mr-finish header input transition used) :descriptor)))
           (body-mr-forms? node nodes (get (get facts :removal-context) :forms) header)
           (= (get descriptor :result-type) (get types (get node :node-id)))
           (if family? true (if (= :gravity.type/never (get (get header :argument-types) 0)) (= input nil)
             (if (= :accepted (get input :status))
               (if (= :map (get input :shape-kind)) (= (get input :type) (get (get header :argument-types) 0)) false) false)))
           (= (body-mr-call-fact descriptor (get core :module))
              (body-by (get facts :call-type-facts) :call-core-node-id (get node :node-id)))
           (= [(body-mr-constraint descriptor)] rows)]) false) false)))

(defn body-mr-node? [node facts core]
  (let [context (get facts :removal-context) id (get node :node-id)]
    (if (map? context)
      (body-mr-call-valid? core facts (get context :bindings) node (get (get context :calls) id)
                          (get (get context :edges) id) (get context :nodes)) false)))

(defn body-call-joins-with-foreign-valid? [core facts bindings foreign]
  (let [nodes (body-index (get core :nodes) :node-id)
        functions (body-index (get facts :function-type-table) :function-id)
        records (body-index (get core :function-records) :function-syntax-id)
        calls (body-index (get core :calls) :core-node-id)
        call-facts (body-index (get facts :call-type-facts) :call-core-node-id)]
    (loop [remaining (get core :call-edges) ordinal 0 used #{} intrinsic-rows [] association-rows [] removal-rows [] count-rows [] nth-rows [] successor-rows [] append-rows [] equality-rows [] not-rows [] contains-rows [] get-rows [] concat-rows [] list-rows [] query-rows []]
      (if (= 0 (count remaining))
        (body-all? [(= (count used) (count foreign))
                    (= intrinsic-rows (body-select (get facts :constraint-ledger) :producer-rule :sh08-integral-ordering-v1))
                    (= association-rows (body-select (get facts :constraint-ledger) :producer-rule :sh08-map-association-v1))
                    (= removal-rows (body-select (get facts :constraint-ledger) :producer-rule :sh08-map-removal-v1))
                    (= count-rows (body-select (get facts :constraint-ledger) :producer-rule :sh08-collection-count-v1))
                    (= nth-rows (body-select (get facts :constraint-ledger) :producer-rule :sh08-vector-nth-v1))
                    (= successor-rows (body-select (get facts :constraint-ledger) :producer-rule :sh08-bounded-successor-v1))
                    (= append-rows (loop [remaining (get facts :constraint-ledger) out []]
                                     (if (= 0 (count remaining)) out
                                       (let [row (first remaining)]
                                         (recur (rest remaining)
                                           (if (contains? #{:sh08-vector-append-v1 :sh08-list-prepend-v1} (get row :producer-rule))
                                             (conj out row) out))))))
                    (= equality-rows (body-select (get facts :constraint-ledger) :producer-rule :sh08-atomic-equality-v1))
                    (= not-rows (body-select (get facts :constraint-ledger) :producer-rule :sh08-not-v1))
                    (= contains-rows (body-select (get facts :constraint-ledger) :producer-rule :sh08-map-contains-v1))
                    (= get-rows (body-select (get facts :constraint-ledger) :producer-rule :sh08-map-get-v1))
                    (= concat-rows (body-select (get facts :constraint-ledger) :producer-rule :sh08-string-concat-v1))
                    (= list-rows (body-select (get facts :constraint-ledger) :producer-rule :sh08-list-construction-v1))
                    (= query-rows (body-select (get facts :constraint-ledger) :producer-rule :sh08-list-query-v1))])
        (let [edge (first remaining) id (get edge :call-core-node-id)
              imported (get foreign (get edge :callee-binding-id))
              local? (= :local-function (get edge :classification))]
          (if (if (= ordinal (get edge :ordinal))
                (if local?
                  (if (if (body-ho-outer-fact-valid? edge (get call-facts id) (get facts :higher-order-proof))
                        (body-call-valid? edge (get calls id) (get call-facts id) nodes functions records bindings (get facts :type-table)) false)
                    (body-local-arguments-valid? core facts bindings edge (get calls id) (get call-facts id)
                      (get functions (get edge :callee-function-syntax-id))) false)
                  (if (= id (get (get facts :higher-order-proof) :inner-call-core-node-id))
                    (body-ho-inner-call-valid? edge (get calls id) (get call-facts id) nodes facts)
                    (if (map? imported)
                      (body-import-call-valid? edge (get calls id) (get call-facts id) nodes records imported (get facts :type-table))
                      (if (body-si-binding? (get bindings (get edge :callee-binding-id)) (get core :module))
                        (body-si-call-valid? core facts bindings (get nodes id) (get calls id) edge nodes)
                      (if (body-vn-binding? (get bindings (get edge :callee-binding-id)) (get core :module))
                        (body-vn-call-valid? core facts bindings (get nodes id) (get calls id) edge nodes)
                      (if (body-cq-binding? (get bindings (get edge :callee-binding-id)) (get core :module))
                        (body-cq-call-valid? core facts bindings (get nodes id) (get calls id) edge nodes)
                      (if (if (body-mr-binding? (get bindings (get edge :callee-binding-id)) (get core :module)) true
                            (body-ma-binding? (get bindings (get edge :callee-binding-id)) (get core :module)))
                        (if (body-mr-binding? (get bindings (get edge :callee-binding-id)) (get core :module))
                          (body-mr-call-valid? core facts bindings (get nodes id) (get calls id) edge nodes)
                          (body-ma-call-valid? core facts bindings (get nodes id) (get calls id) edge nodes))
                        (if (body-va-binding? (get bindings (get edge :callee-binding-id)) (get core :module))
                          (body-va-node? (get nodes id) facts core)
                          (if (if (if (body-lq-binding? (get bindings (get edge :callee-binding-id)) (get core :module)) true (body-lc-binding? (get bindings (get edge :callee-binding-id)) (get core :module))) true (body-sc-binding? (get bindings (get edge :callee-binding-id)) (get core :module)))
                            (if (if (body-lq-binding? (get bindings (get edge :callee-binding-id)) (get core :module)) true (body-lc-binding? (get bindings (get edge :callee-binding-id)) (get core :module)))
                              (if (body-lq-binding? (get bindings (get edge :callee-binding-id)) (get core :module))
                                (body-lq-call-valid? core facts bindings (get nodes id) (get calls id) edge nodes)
                                (body-lc-call-valid? core facts bindings (get nodes id) (get calls id) edge nodes))
                              (body-sc-call-valid? core facts bindings (get nodes id) (get calls id) edge nodes))
                          (if (body-mg-binding? (get bindings (get edge :callee-binding-id)) (get core :module))
                            (body-mg-call-valid? core facts bindings (get nodes id) (get calls id) edge nodes)
                          (if (body-mc-binding? (get bindings (get edge :callee-binding-id)) (get core :module))
                            (body-mc-call-valid? core facts bindings (get nodes id) (get calls id) edge nodes)
                          (if (body-nt-binding? (get bindings (get edge :callee-binding-id)) (get core :module))
                            (body-nt-call-valid? core facts bindings (get nodes id) (get calls id) edge nodes)
                          (if (body-ae-binding? (get bindings (get edge :callee-binding-id)) (get core :module))
                            (body-ae-call-valid? core facts bindings (get nodes id) (get calls id) edge nodes)
                            (body-io-call-valid? core facts bindings (get nodes id) (get calls id) edge nodes)))))))))))))) false)
            (recur (rest remaining) (+ ordinal 1)
              (if (map? imported) (conj used (get edge :callee-binding-id)) used)
              (if (= :direct-integral-ordering (get (get call-facts id) :dispatch))
                (conj intrinsic-rows (body-io-constraint (get (get facts :type-table) (get (get calls id) :operator-node-id))))
                intrinsic-rows)
              (if (= :direct-map-association (get (get call-facts id) :dispatch))
                (conj association-rows (body-ma-constraint (get (get facts :type-table) (get (get calls id) :operator-node-id)))) association-rows)
              (if (= :direct-map-removal (get (get call-facts id) :dispatch))
                (conj removal-rows (body-mr-constraint (get (get facts :type-table) (get (get calls id) :operator-node-id)))) removal-rows)
              (if (= :direct-collection-count (get (get call-facts id) :dispatch))
                (conj count-rows (body-cq-constraint (get (get facts :type-table) (get (get calls id) :operator-node-id)))) count-rows)
              (if (= :direct-vector-nth (get (get call-facts id) :dispatch))
                (conj nth-rows (body-vn-constraint (get (get facts :type-table) (get (get calls id) :operator-node-id)))) nth-rows)
              (if (= :direct-bounded-successor (get (get call-facts id) :dispatch))
                (conj successor-rows (body-si-constraint (get (get facts :type-table) (get (get calls id) :operator-node-id)))) successor-rows)
              (if (= :direct-list-prepend (get (get call-facts id) :dispatch))
                (conj append-rows (body-pl-constraint (get (get facts :type-table) (get (get calls id) :operator-node-id))))
                (if (= :direct-vector-append (get (get call-facts id) :dispatch))
                  (conj append-rows (body-va-constraint (get (get facts :type-table) (get (get calls id) :operator-node-id)))) append-rows))
              (if (= :direct-atomic-equality (get (get call-facts id) :dispatch))
                (conj equality-rows (body-ae-constraint (get (get facts :type-table) (get (get calls id) :operator-node-id)))) equality-rows)
              (if (= :direct-not (get (get call-facts id) :dispatch))
                (conj not-rows (body-nt-constraint (get (get facts :type-table) (get (get calls id) :operator-node-id)))) not-rows)
              (if (= :direct-map-contains (get (get call-facts id) :dispatch))
                (conj contains-rows (body-mc-constraint (get (get facts :type-table) (get (get calls id) :operator-node-id)))) contains-rows)
              (if (= :direct-map-get (get (get call-facts id) :dispatch))
                (conj get-rows (body-mg-constraint (get (get facts :type-table) (get (get calls id) :operator-node-id)))) get-rows)
              (if (= :direct-string-concat (get (get call-facts id) :dispatch))
                (conj concat-rows (body-sc-constraint (get (get facts :type-table) (get (get calls id) :operator-node-id)))) concat-rows)
              (if (= :direct-list-construction (get (get call-facts id) :dispatch))
                (conj list-rows (body-lc-constraint (get (get facts :type-table) (get (get calls id) :operator-node-id)))) list-rows)
              (if (= :direct-list-query (get (get call-facts id) :dispatch))
                (conj query-rows (body-lq-constraint (get (get facts :type-table) (get (get calls id) :operator-node-id)))) query-rows)) false))))))

(defn body-ho-outer-fact-valid? [edge fact proof]
  (if (= (get edge :call-core-node-id) (get proof :outer-call-core-node-id))
    (body-all? [(= :direct-local-function (get fact :dispatch))
                (= (get proof :apply-function-syntax-id) (get fact :selected-apply-function-syntax-id))
                (= (body-edge-projection edge) (get fact :b47-edge))]) true))

(defn body-ho-inner-call-valid? [edge call fact nodes facts]
  (let [proof (get facts :higher-order-proof) node (get nodes (get edge :call-core-node-id)) source (get node :source)
        types (get facts :type-table) value-type (get proof :inner-result-type)]
    (if (body-all? [(map? fact) (vector? (get call :argument-node-ids)) (vector? (get node :children))])
    (body-all?
      [(= (get proof :inner-call-core-node-id) (get edge :call-core-node-id) (get call :core-node-id) (get fact :call-core-node-id))
       (= :nonlocal-or-nonfunction (get edge :classification)) (= :call (get node :core-form))
       (= (get proof :apply-function-syntax-id) (get edge :caller-function-syntax-id) (get fact :caller-function-syntax-id))
       (= (get proof :apply-function-core-node-id) (get edge :caller-function-core-node-id))
       (= nil (get edge :callee-function-syntax-id) (get edge :callee-function-core-node-id) (get fact :callee-function-syntax-id))
       (= (get proof :inner-edge) (body-edge-projection edge) (get fact :b47-edge))
       (= (get proof :apply-callable-binding-id) (get edge :callee-binding-id) (get call :operator-binding-id)
          (get fact :callable-parameter-binding-id))
       (= (get proof :identity-function-syntax-id) (get fact :selected-identity-function-syntax-id))
       (= :indirect-function-value (get fact :dispatch)) (= true (get fact :higher-order-call?))
       (= :gravity/c7-call-type-fact (get fact :artifact)) (= :inferred (get fact :status))
       (= (get proof :inner-argument-node-ids) (get call :argument-node-ids) (get edge :argument-core-node-ids)
          (vec (rest (get node :children))))
       (= (get node :children) (get call :ordered-evaluation-node-ids) (get edge :ordered-evaluation-node-ids))
       (= :operator-then-arguments (get fact :evaluation-order) (get call :evaluation-order) (get edge :evaluation-order))
       (= [value-type] (get fact :argument-types))
       (= value-type (get fact :result-type) (get types (get node :node-id))
          (get types (first (get call :argument-node-ids))))
       (= (get proof :identity-function-type) (get types (first (get node :children))))
       (= (get (get facts :module) :effects) (get fact :effects))
       (= (get (get facts :module) :capabilities) (get fact :capabilities))
       (= (get (get facts :module) :profile) (get fact :profile)) (= (get (get facts :module) :target) (get fact :target))
       (= (get source :syntax-id) (get fact :syntax-id)) (= (get source :semantic-span) (get fact :source-span))
       (= (get source :origin-chain) (get fact :origin-chain)) (= (get source :generated-origin) (get fact :generated-origin))
       (= {:domain :gravity/sh08-call-type-fact-v1 :call-core-node-id (get node :node-id)
           :callee-function-syntax-id nil :argument-types [value-type] :result-type value-type :higher-order-call? true}
          (get fact :fact-id-request))]) false)))

(defn body-select [records field value]
  (loop [remaining records result []]
    (if (= 0 (count remaining)) result
      (recur (rest remaining) (if (= value (get (first remaining) field)) (conj result (first remaining)) result)))))

(defn body-match-valid? [node core types]
  (let [branches (body-select (get core :match-branch-records) :core-node-id (get node :node-id))
        attrs (get node :attributes) children (get node :children)
        skeleton (body-by (get core :match-decision-skeletons) :core-node-id (get node :node-id))]
    (if (if (vector? (get attrs :branch-child-indexes)) (vector? (get attrs :guard-child-indexes [])) false)
    (if (body-all? [(= (count branches) (get attrs :branch-count))
                    (= (get node :node-id) (get skeleton :core-node-id))
                    (= (first children) (get skeleton :scrutinee-core-node-id))])
      (loop [remaining branches ordinal 0 bodies [] guards [] guard-index (+ 1 (count branches))]
        (if (= 0 (count remaining))
          (body-all? [(= children (body-add guards (body-add bodies [(first children)])))
                      (= bodies (get skeleton :branch-core-node-ids))
                      (= (count guards) (count (get attrs :guard-child-indexes)))])
          (let [branch (first remaining) guard (get branch :guard)]
            (if (body-all?
                  [(= ordinal (get branch :clause-ordinal))
                   (= (+ ordinal 1) (get branch :branch-child-index) (get (get attrs :branch-child-indexes) ordinal))
                   (= (get branch :branch-core-node-id) (get children (+ ordinal 1)))
                   (= (get branch :scrutinee-core-node-id) (first children))
                   (if (= guard nil) true
                     (body-all? [(= guard-index (get guard :child-index))
                                 (= (get guard :node-id) (get children guard-index))
                                 (= guard-index (get (get attrs :guard-child-indexes) (count guards)))
                                 (contains? #{:gravity.type/bool :gravity.type/never} (get types (get guard :node-id)))]))])
              (recur (rest remaining) (+ ordinal 1) (conj bodies (get branch :branch-core-node-id))
                     (if (= guard nil) guards (conj guards (get guard :node-id)))
                     (if (= guard nil) guard-index (+ guard-index 1))) false)))) false) false)))


(defn body-local-joins-valid? [core typed bindings]
  (let [facts (body-index (get typed :local-binding-facts) :binding-id)
        nodes (body-index (get core :nodes) :node-id) module (get typed :module)]
    (if (= (count (get core :lexical-bindings)) (count facts))
      (loop [remaining (get core :lexical-bindings)]
        (if (= 0 (count remaining)) true
          (let [record (first remaining) fact (get facts (get record :binding-id))
                node (get nodes (get record :initializer-node-id)) source (get node :source)
                binding (get bindings (get record :binding-id))]
            (if (body-all?
                  [(= :gravity/c7-local-binding-fact (get fact :artifact)) (= :inferred (get fact :status))
                   (= (get record :name) (get fact :name) (get binding :name))
                   (= (get record :initializer-node-id) (get fact :initializer-node-id))
                   (= (get record :let-core-node-id) (get fact :let-core-node-id))
                   (= (get fact :type) (get (get typed :type-table) (get record :initializer-node-id)))
                   (= (get fact :syntax-id) (get source :syntax-id))
                   (= (get fact :source-span) (get source :semantic-span))
                   (= (get fact :origin-chain) (get source :origin-chain))
                   (= (get fact :generated-origin) (get source :generated-origin))
                   (= (get fact :profile) (get module :profile)) (= (get fact :target) (get module :target))
                   (= (get fact :effects) (get module :effects)) (= (get fact :capabilities) (get module :capabilities))])
              (recur (rest remaining)) false)))) false)))

(defn body-ready? [ids graph]
  (loop [remaining ids]
    (if (= 0 (count remaining)) true
      (if (contains? graph (first remaining)) (recur (rest remaining)) false))))

(defn body-node-effects [ids graph]
  (loop [remaining ids result #{}]
    (if (= 0 (count remaining)) result
      (recur (rest remaining) (body-add (get (get graph (first remaining)) :transitive) result)))))

; C7 owns loop type inference. C8 joins its retained equality premises back to
; the original authenticated C6 control records and actual node types.
(defn body-loop-row [premise node module]
  (let [slot? (= :loop-slot-type (get premise :kind)) id (get node :node-id)
        target (get premise :source-target) lhs (if slot? (get premise :binding-id) id)
        rhs (if slot? (get premise :type) :gravity.type/never)]
    {:constraint-id-request {:domain :gravity/sh08-loop-type-constraint-v1
       :core-node-id id :binding-or-transfer lhs :target-id (get target :target-id) :premise premise}
     :kind :equality :producer-rule :sh08-loop-target-types-v1 :lhs lhs :rhs rhs
     :origin (get (get node :source) :origin-chain) :profile (get module :profile) :target (get module :target)
     :dependencies {:loop-premise premise :core-node-id id :target-owner-core-node-id (get target :owner-core-node-id)}
     :solution {:type rhs :slot-types (get premise :slot-types) :argument-types (get premise :argument-types)
                :normal-transfer? (get premise :normal-transfer?)}
     :invalidation [:loop-bindings :recur-targets :recur-transfers :type-table :binding-table]
     :status :solved :diagnostics []}))

(defn body-loop-slot-types [target bindings types]
  (loop [ids (get target :binding-ids) out []]
    (if (= 0 (count ids)) out
      (recur (rest ids) (conj out (get types (get (get bindings (first ids)) :initializer-node-id)))))))

(defn body-function-recur-slot-types [target owner function]
  (let [parameters (get function :parameters)
        declared (get (get (get owner :attributes) :signature) :parameters)
        declarations (if (if (= 0 (get target :arity)) (= declared nil) false) [] declared)]
    (if (if (vector? parameters) (if (vector? declarations) (vector? (get owner :children)) false) false)
    (if (body-all? [(= :fn (get owner :core-form))
                    (= (get target :owner-core-node-id) (get function :function-core-node-id) (get owner :node-id))
                    (= (get target :owner-form-id) (get (get owner :source) :form-id))
                    (= (get target :owner-syntax-id) (get function :function-id) (get (get owner :source) :syntax-id))
                    (= (get target :target-id) (get (get owner :attributes) :recur-target-id))
                    (= 1 (count (get owner :children)))
                    (= (get function :body-core-node-id) (first (get owner :children)))
                    (= (get target :binding-ids) (get function :parameter-binding-ids) (get owner :resolved-binding-ids))
                    (= (get function :signature) (get (get owner :attributes) :signature))
                    (= (get target :arity) (count parameters) (count declarations))])
      (loop [parameters parameters declarations declarations ids (get target :binding-ids) out []]
        (if (= 0 (count parameters)) out
          (let [parameter (first parameters) type (get parameter :type)]
            (if (body-all? [(= (first ids) (get parameter :binding-id))
                            (= type (get (first declarations) :type-id))
                            (= false (contains? #{nil :gravity.type/unknown} type))])
              (recur (rest parameters) (rest declarations) (rest ids) (conj out type)) nil)))) nil) nil)))

(defn body-loop-arguments-valid? [arguments slots]
  (if (= (count arguments) (count slots))
    (loop [arguments arguments slots slots]
      (if (= 0 (count arguments)) true
        (if (if (contains? #{nil :gravity.type/unknown} (first slots)) false
              (body-normal-compatible? (first arguments) (first slots)))
          (recur (rest arguments) (rest slots)) false))) false))

(defn body-loop-input-shapes? [core facts]
  (if (body-all? [(vector? (get core :loop-bindings)) (vector? (get core :recur-targets))
                  (vector? (get core :recur-transfers)) (vector? (get facts :constraint-ledger))])
    (if (body-all? [(body-maps? (get core :loop-bindings)) (body-maps? (get core :recur-targets))
                    (body-maps? (get core :recur-transfers)) (body-maps? (get facts :constraint-ledger))])
      (if (loop [remaining (get core :recur-targets)]
            (if (= 0 (count remaining)) true
              (let [target (first remaining) arity (get target :arity)]
                (if (if (integer? arity)
                      (if (vector? (get target :binding-ids))
                        (if (<= 0 arity) (<= arity 65536) false) false) false)
                  (recur (rest remaining)) false))))
        (if (loop [remaining (get core :loop-bindings)]
              (if (= 0 (count remaining)) true
                (let [ordinal (get (first remaining) :ordinal)]
                  (if (if (integer? ordinal) (if (<= 0 ordinal) (< ordinal 65536) false) false)
                    (recur (rest remaining)) false))))
          (loop [remaining (get core :recur-transfers)]
            (if (= 0 (count remaining)) true
              (if (vector? (get (first remaining) :argument-node-ids))
                (recur (rest remaining)) false))) false) false) false) false))

(defn body-loop-rows [core facts budget]
  ; Charge each slot row and each transfer/argument/slot visit before traversal.
  ; This extends the existing logical work counter, not a total CPU bound.
  (let [nodes (body-index (get core :nodes) :node-id) types (get facts :type-table)
        targets (body-index (get core :recur-targets) :target-id)
        bindings (body-index (get core :loop-bindings) :binding-id)
        functions (body-index (get facts :function-type-table) :function-core-node-id) module (get facts :module)]
    (loop [remaining (get core :loop-bindings) transfers (get core :recur-transfers) rows [] work 0]
      (if (> (count remaining) 0)
        (if (>= work budget) (body-failure :body-deferred-work-limit)
          (let [binding (first remaining) id (get binding :initializer-node-id) node (get nodes id)
                loop-node (get nodes (get binding :loop-core-node-id))
                target (get targets (get (get loop-node :attributes) :target-id)) type (get types id)
                premise {:kind :loop-slot-type :binding-id (get binding :binding-id) :initializer-node-id id
                         :type type :source-loop-binding binding :source-target target :status :solved}]
            (if (body-all? [(= :loop (get target :target-kind) (get loop-node :core-form))
                            (= (get binding :loop-core-node-id) (get target :owner-core-node-id))
                            (= (get binding :binding-id) (get (get target :binding-ids) (get binding :ordinal)))
                            (= id (get (get loop-node :children) (get binding :ordinal)))
                            (= false (contains? #{nil :gravity.type/unknown} type))])
              (recur (rest remaining) transfers (conj rows (body-loop-row premise node module)) (+ work 1))
              (body-failure :incoherent-loop-slot-type-origin-join))))
          (if (> (count transfers) 0)
            (let [transfer (first transfers) id (get transfer :recur-core-node-id) node (get nodes id)
                  target (get targets (get transfer :target-id))
                  cost (+ 1 (count (get transfer :argument-node-ids)) (count (get target :binding-ids)))]
              (if (> cost (- budget work)) (body-failure :body-deferred-work-limit)
              (let [slots (if (= :function (get target :target-kind))
                            (body-function-recur-slot-types target (get nodes (get target :owner-core-node-id))
                              (get functions (get target :owner-core-node-id)))
                            (body-loop-slot-types target bindings types))
                  arguments (loop [ids (get transfer :argument-node-ids) out []]
                              (if (= 0 (count ids)) out (recur (rest ids) (conj out (get types (first ids))))))
                  premise {:kind :loop-recur-type :source-transfer transfer :source-target target
                           :argument-types arguments :slot-types slots :result-type :gravity.type/never
                           :normal-transfer? (= false (contains? (set arguments) :gravity.type/never)) :status :solved}]
              (if (body-all? [(contains? #{:loop :function} (get transfer :target-kind))
                              (= (get transfer :target-kind) (get target :target-kind)) (vector? slots)
                              (= :recur (get node :core-form)) (= :gravity.type/never (get types id))
                              (= (get transfer :argument-node-ids) (get node :children))
                              (= (get target :binding-ids) (get node :resolved-binding-ids))
                              (= (get transfer :arity) (get target :arity) (count arguments) (count slots))
                              (= (get transfer :target-id) (get (get node :attributes) :target-id))
                              (= true (get transfer :tail-position))
                              (body-loop-arguments-valid? arguments slots)])
                (recur remaining (rest transfers) (conj rows (body-loop-row premise node module))
                       (+ work cost))
                (body-failure :incoherent-loop-transfer-type-origin-join)))))
            {:status :accepted :rows rows :work-count work})))))

(defn body-loop-joins [core facts budget]
  (if (body-loop-input-shapes? core facts)
    (if (body-all?
          [(= (body-project core [:loop-bindings :recur-targets :recur-transfers])
              (body-project (get core :identity-preimage) [:loop-bindings :recur-targets :recur-transfers]))
           (= (count (get core :loop-bindings)) (count (body-index (get core :loop-bindings) :binding-id)))
           (= (count (get core :recur-targets)) (count (body-index (get core :recur-targets) :target-id)))
           (= (count (get core :recur-transfers)) (count (body-select (get core :nodes) :core-form :recur)))
           (= (count (get core :recur-transfers)) (count (body-index (get core :recur-transfers) :recur-core-node-id)))
           (= (set (keys (body-index (get core :recur-transfers) :recur-core-node-id)))
              (set (keys (body-index (body-select (get core :nodes) :core-form :recur) :node-id))))
           (= (count (body-select (get core :recur-targets) :target-kind :loop))
              (count (body-select (get core :nodes) :core-form :loop)))])
      (let [result (body-loop-rows core facts budget)]
        (if (= :accepted (get result :status))
          (let [actual (body-select (get facts :constraint-ledger) :producer-rule :sh08-loop-target-types-v1)]
            (if (if (= (count actual) (count (get result :rows))) (= (set actual) (set (get result :rows))) false)
              result (body-failure :incoherent-loop-constraint-ledger))) result))
      (body-failure :incomplete-loop-control-coverage))
    (body-failure :incomplete-loop-control-tables)))

(defn body-loop-body-indexes-valid? [indexes arity child-count]
  (if (if (vector? indexes) (if (integer? arity) (integer? child-count) false) false)
    (if (if (<= 0 arity) (if (< arity child-count) (<= child-count 65536) false) false)
      (if (= (count indexes) (- child-count arity))
        (loop [remaining indexes expected arity]
          (if (= 0 (count remaining)) true
            (if (if (integer? (first remaining)) (= expected (first remaining)) false)
              (recur (rest remaining) (+ expected 1)) false))) false) false) false))

(defn body-loop-values-valid? [core facts]
  (let [types (get facts :type-table) targets (body-index (get core :recur-targets) :target-id)]
    (loop [remaining (get core :nodes)]
      (if (= 0 (count remaining)) true
        (let [node (first remaining) children (get node :children) attrs (get node :attributes)
              target (get targets (get attrs :target-id))]
          (if (if (= :loop (get node :core-form))
                (if (if (map? target)
                      (body-loop-body-indexes-valid? (get attrs :body-child-indexes) (get target :arity) (count children)) false)
                (body-all? [(= :loop (get target :target-kind))
                            (= (get node :node-id) (get target :owner-core-node-id))
                            (= (get node :resolved-binding-ids) (get target :binding-ids))
                            (= (get target :arity) (get attrs :binding-count))
                            (> (count children) (get target :arity))
                            (> (count (get attrs :body-child-indexes)) 0)
                            (= (get types (get node :node-id))
                               (if (body-has-never? children types) :gravity.type/never
                                 (get types (get children (- (count children) 1)))))]) false) true)
            (recur (rest remaining)) false))))))

(defn body-loop-body-ids [node core]
  (let [target (body-by (get core :recur-targets) :target-id (get (get node :attributes) :target-id))
        owner (body-by (get core :nodes) :node-id (get target :owner-core-node-id))]
    (loop [indexes (if (= :function (get target :target-kind)) [0]
                    (get (get owner :attributes) :body-child-indexes)) out []]
      (if (= 0 (count indexes)) out
        (recur (rest indexes) (conj out (get (get owner :children) (first indexes))))))))

(defn body-conditional-coverage [node]
  (let [kind (get node :core-form) children (get node :children) attrs (get node :attributes)]
    (if (contains? #{:if :match :try} kind)
      (loop [index 1 result []]
        (if (= index (count children)) result
          (recur (+ index 1)
            (conj result {:node-id (get children index) :child-index index
                          :role (if (= kind :try) :source-ordered-typed-handler
                                (if (= kind :if) (if (= index 1) :then :else)
                                  (if (contains? (set (get attrs :guard-child-indexes)) index) :guard :branch)))})))) [])))

(defn body-order-ids [order]
  (loop [remaining order ids []]
    (if (= 0 (count remaining)) ids
      (recur (rest remaining) (conj ids (get (first remaining) :core-node-id))))))

(defn body-error-type-union [left right]
  (loop [remaining right out left seen (set left)]
    (if (= 0 (count remaining)) out
      (recur (rest remaining) (if (contains? seen (first remaining)) out (conj out (first remaining)))
             (conj seen (first remaining))))))

(defn body-eh-atomic-type [name]
  (get '{I8 :gravity.type/i8 I16 :gravity.type/i16 I32 :gravity.type/i32 I64 :gravity.type/i64
         U8 :gravity.type/u8 U16 :gravity.type/u16 U32 :gravity.type/u32 U64 :gravity.type/u64
         F32 :gravity.type/f32 F64 :gravity.type/f64 Bool :gravity.type/bool
         String :gravity.type/string Symbol :gravity.type/symbol Keyword :gravity.type/keyword Ratio :gravity.type/ratio} name))

(defn body-eh-error [rule reason node expected actual]
  (assoc (body-failure reason) :node node :expected expected :actual actual))

(defn body-eh-tree [nodes root]
  (loop [pending [root] seen #{}]
    (if (= 0 (count pending)) seen
      (let [id (first pending) rest-ids (vec (rest pending))]
        (if (contains? seen id) (recur rest-ids seen)
          (recur (loop [children (get (get nodes id) :children) out rest-ids]
                   (if (= 0 (count children)) out (recur (rest children) (conj out (first children)))))
                 (conj seen id)))))))

(defn body-eh-uses [nodes tree binding-id]
  (loop [remaining nodes out []]
    (if (= 0 (count remaining)) out
      (let [node (first remaining)]
        (recur (rest remaining)
          (if (body-all? [(= :reference (get node :core-form)) (= binding-id (get (get node :attributes) :binding-id))
                          (contains? tree (get node :node-id))])
            (conj out (get (get node :source) :syntax-id)) out))))))

(defn body-eh-source-products [core source-forms bindings budget]
  (let [sequence (get core :nodes) records (get core :error-handlers)]
    (if (body-all? [(vector? sequence) (vector? source-forms) (vector? bindings)
                            (if (= records nil) true (vector? records))])
    (if (> (count sequence) budget) (body-eh-error "C7-GENERIC" :typed-handler-work-limit {} :bounded-handler-visits (count sequence))
  (let [tries (body-select sequence :core-form :try)
        records (get core :error-handlers) count-records (if (vector? records) (count records) 0)
        shapes? (loop [remaining tries]
                  (if (= 0 (count remaining)) true
                    (let [node (first remaining) attrs (get node :attributes)]
                      (if (if (vector? (get node :children))
                            (if (map? attrs) (vector? (get attrs :handler-clauses)) false) false)
                        (recur (rest remaining)) false))))
        work (+ (* 8 (count sequence)) (count source-forms) (count bindings)
                (* count-records (+ 100 (* 4 (count sequence)) (* 4 (count (get core :error-transfers))))))]
    (if (= 0 (count tries))
      (if (if (= records nil) true (= [] records))
        {:status :accepted :groups {} :seeds {} :work-count (count sequence) :diagnostics []}
        (body-eh-error "C7-VERIFY" :unexpected-error-handlers {} :no-handler-records records))
      (if (= false shapes?) (body-eh-error "C7-VERIFY" :malformed-typed-handler-family {} :canonical-handler-vectors nil)
      (if (> work budget) (body-eh-error "C7-GENERIC" :typed-handler-work-limit {} :bounded-handler-visits work)
      (let [nodes (body-index sequence :node-id) forms (body-index source-forms :form-id)
            binding-index (body-index bindings :binding-id) owners (body-throw-owners core (- budget work))]
        (if (= :accepted (get owners :status))
        (loop [remaining tries ordinal 0 groups {} seeds {}]
          (if (= 0 (count remaining))
            (if (if (= ordinal count-records)
                  (= (loop [remaining records out []]
                       (if (= 0 (count remaining)) out
                         (recur (rest remaining) (conj out (body-throw-semantic-record
                           (get (get (get core :identity-preimage) :lineage) :sh06-semantic-projection-id) (first remaining))))))
                     (get (get core :identity-preimage) :error-handlers)) false)
              {:status :accepted :groups groups :seeds seeds :work-count (+ work (get owners :work-count)) :diagnostics []}
              (body-eh-error "C7-VERIFY" :error-handler-census {} :exact-handler-records records))
            (let [node (first remaining) id (get node :node-id) source (get node :source)
                  form (get forms (get source :form-id)) ids (get form :child-form-ids)
                  children (get node :children) attrs (get node :attributes)
                  clauses (get attrs :handler-clauses) owner (get (get owners :owners) id)
                  tree (body-eh-tree nodes (first children))
                  candidates (loop [transfers (get core :error-transfers) out []]
                               (if (= 0 (count transfers)) out
                                 (let [transfer (first transfers)]
                                   (recur (rest transfers)
                                     (if (if (contains? tree (get transfer :core-node-id))
                                           (= owner (get transfer :evaluation-owner-function-syntax-id)) false)
                                       (conj out (body-project transfer [:ordinal :core-node-id])) out)))))
                  result
                  (if (if (vector? clauses) (<= (+ ordinal (count clauses)) count-records) false)
                  (loop [index 0 values [] next-seeds seeds]
                    (if (= index (count clauses)) {:status :accepted :clauses values :seeds next-seeds}
                      (let [clause (get clauses index) record (get records (+ ordinal index))
                            catch-form (get forms (get ids (+ index 2))) catch-ids (get catch-form :child-form-ids)
                            operator (get forms (get catch-ids 0)) type-form (get forms (get catch-ids 1))
                            binder-form (get forms (get catch-ids 2)) body-form (get forms (get catch-ids 3))
                            type-binding (get binding-index (get clause :error-type-binding-id))
                            binder (get binding-index (get clause :catch-binding-id))
                            type (body-eh-atomic-type (get type-binding :name)) body (get nodes (get children (+ index 1)))
                            body-tree (body-eh-tree nodes (get body :node-id))
                            uses (body-eh-uses sequence body-tree (get binder :binding-id))
                            all-uses (body-eh-uses sequence (set (keys nodes)) (get binder :binding-id))
                            expected-clause {:clause-ordinal index :handler-child-index (+ index 1)
                              :catch-clause-form-id (get catch-form :form-id) :catch-clause-syntax-id (get catch-form :syntax-id)
                              :error-type-form-id (get type-form :form-id) :error-type-syntax-id (get type-form :syntax-id)
                              :error-type-binding-id (get type-binding :binding-id)
                              :catch-binding-form-id (get binder-form :form-id) :catch-binding-syntax-id (get binder-form :syntax-id)
                              :catch-binding-id (get binder :binding-id) :catch-binding-scope-id (get binder :scope-id)}
                            expected-record (assoc
                              (body-project attrs [:construction-order :runtime-reachability :selection-policy :result-policy
                                :authenticated-sh06-artifact-id :sh06-semantic-projection-id :type-coverage-legality
                                :result-type-join-legality :effect-registry-legality :effect-profile-capability-legality
                                :profile-error-lowering-legality :ownership-legality :safety-classification])
                              :ordinal (+ ordinal index) :clause-ordinal index :clause-count (count clauses)
                              :handler-child-index (+ index 1) :core-node-id id
                              :form-id (get form :form-id) :syntax-id (get form :syntax-id)
                              :protected-core-node-id (first children) :handler-core-node-id (get body :node-id)
                              :catch-clause-form-id (get catch-form :form-id) :catch-clause-syntax-id (get catch-form :syntax-id)
                              :error-type-form-id (get type-form :form-id) :error-type-syntax-id (get type-form :syntax-id)
                              :error-type-binding-id (get type-binding :binding-id)
                              :catch-binding-form-id (get binder-form :form-id) :catch-binding-syntax-id (get binder-form :syntax-id)
                              :catch-binding-id (get binder :binding-id) :catch-binding-scope-id (get binder :scope-id)
                              :catch-binding-use-syntax-ids uses :candidate-error-transfers candidates
                              :evaluation-region (get (get node :evaluation) :region)
                              :evaluation-owner-function-syntax-id owner
                              :ordered-steps [:evaluate-protected :conditionally-select-source-ordered-typed-handler]
                              :construction-order :protected-then-handlers-source-order-then-try
                              :runtime-evaluation :protected-then-conditional-handler-chain)]
                        (if (body-all?
                              [(= 4 (count catch-ids)) (= :list (get catch-form :kind))
                               (if (seq? (get catch-form :value))
                                 (= ['catch (get type-form :value) (get binder-form :value) (get body-form :value)] (vec (get catch-form :value))) false)
                               (= 'catch (get operator :value)) (= :symbol (get operator :kind))
                               (= (get form :form-id) (get catch-form :parent-form-id))
                               (= (get catch-form :form-id) (get operator :parent-form-id) (get type-form :parent-form-id)
                                  (get binder-form :parent-form-id) (get body-form :parent-form-id))
                               (= :symbol (get type-form :kind) (get binder-form :kind))
                               (= (get type-binding :name) (get type-form :value))
                               (= [:core :type 'gravity.core] [(get type-binding :binding-class) (get type-binding :kind) (get type-binding :namespace)])
                               (= [:lexical :local] [(get binder :binding-class) (get binder :kind)])
                               (= (get binder :name) (get binder-form :value))
                               (= (get binder :definition-syntax-id) (get binder-form :syntax-id))
                               (= (get binder :scope-id) (get binder-form :scope-id))
                               (= (get body :source) (body-throw-source body-form))
                               (= uses all-uses) (= expected-clause clause) (= expected-record record)])
                          (if (= type nil)
                            (body-eh-error "C7-ANNOTATION" :unsupported-atomic-catch-type node :canonical-atomic-error-type (get type-form :value))
                            (recur (+ index 1) (conj values {:record record :error-type type :handler-core-node-id (get body :node-id)})
                              (assoc next-seeds (get binder :binding-id) type)))
                          (body-eh-error "C7-VERIFY" :typed-handler-source-join node :exact-canonical-handler record)))))
                    (body-eh-error "C7-VERIFY" :error-handler-census node :exact-handler-records records))]
              (if (body-all?
                    [(vector? records) (vector? clauses) (> (count clauses) 0)
                     (= (+ 1 (count clauses)) (count children)) (= (+ 2 (count clauses)) (count ids))
                     (= source (body-throw-source form)) (= :list (get form :kind))
                     (= 'try (get (get forms (first ids)) :value))
                     (if (seq? (get form :value))
                       (= (loop [remaining (rest ids) out ['try]]
                            (if (= 0 (count remaining)) out (recur (rest remaining) (conj out (get (get forms (first remaining)) :value)))))
                          (vec (get form :value))) false)
                     (= (get (get nodes (first children)) :source) (body-throw-source (get forms (get ids 1))))
                     (= 0 (get attrs :protected-child-index)) (= (count clauses) (get attrs :handler-count))
                     (= (loop [i 1 out []] (if (= i (count children)) out (recur (+ i 1) (conj out i)))) (get attrs :handler-child-indexes))
                     (= :protected-then-ordered-typed-handler-candidates (get attrs :evaluation-order) (get (get node :evaluation) :kind))
                     (= owner (get (get node :evaluation) :owner-function-syntax-id))
                     (= (loop [remaining clauses out []]
                          (if (= 0 (count remaining)) out
                            (recur (rest remaining) (conj (conj out (get (first remaining) :error-type-binding-id))
                                                          (get (first remaining) :catch-binding-id)))))
                        (get node :resolved-binding-ids))
                     (= [{:index 0 :core-node-id (first children)}] (get (get node :evaluation) :order))
                     (= :source-ordered-typed-handler-candidates (get attrs :selection-policy))
                     (= :protected-or-selected-handler-last (get attrs :result-policy))
                     (= :not-asserted-by-sh07-b9 (get attrs :runtime-reachability))
                     (= [:pending-sh08 :pending-sh08 :pending-sh09 :pending-sh09 :pending-sh09 :pending-sh10 :pending-sh11]
                        [(get attrs :type-coverage-legality) (get attrs :result-type-join-legality) (get attrs :effect-registry-legality)
                         (get attrs :effect-profile-capability-legality) (get attrs :profile-error-lowering-legality)
                         (get attrs :ownership-legality) (get attrs :safety-classification)])])
                (if (= :accepted (get result :status))
                  (recur (rest remaining) (+ ordinal (count clauses)) (assoc groups id (get result :clauses)) (get result :seeds)) result)
                (body-eh-error "C7-VERIFY" :typed-try-source-join node :exact-canonical-try attrs))))) owners)))))))
      (body-eh-error "C7-VERIFY" :malformed-typed-handler-family {} :canonical-handler-input-vectors nil))))

(defn body-eh-partition [protected clauses graph]
  (loop [remaining clauses candidates protected handler-errors [] handled []]
    (if (= 0 (count remaining))
      {:residual (body-error-type-union candidates handler-errors) :handled handled}
      (let [clause (first remaining) type (get clause :error-type)
            classified (loop [errors candidates matched [] residual []]
                         (if (= 0 (count errors)) {:matched matched :residual residual}
                           (if (= type (first errors))
                             (recur (rest errors) (conj matched (first errors)) residual)
                             (recur (rest errors) matched (conj residual (first errors))))))
            matched (get classified :matched)
            own (if (= 0 (count matched)) [] (body-error-types graph (get clause :handler-core-node-id)))]
        (recur (rest remaining) (get classified :residual) (body-error-type-union handler-errors own)
          (conj handled {:source-handler (get clause :record) :error-type type
                         :candidate-error-types candidates :matched-error-types matched
                         :handler-error-types own :remaining-error-types (get classified :residual)}))))))

(defn body-eh-child-types [ids types]
  (loop [remaining ids out []]
    (if (= 0 (count remaining)) out
      (recur (rest remaining) (conj out (get types (first remaining) :gravity.type/unknown))))))

(defn body-eh-normal-join [types]
  (loop [remaining types result :gravity.type/never]
    (if (= 0 (count remaining)) result
      (let [type (first remaining)]
        (if (contains? #{nil :gravity.type/unknown} type) :gravity.type/unknown
          (if (= type :gravity.type/never) (recur (rest remaining) result)
            (if (= result :gravity.type/never) (recur (rest remaining) type)
              (if (= result type) (recur (rest remaining) result) :gravity.type/unknown))))))))

(defn body-eh-constraint [node clauses types graph]
  (let [ids (get node :children)
        source-errors (loop [remaining ids out []]
                        (if (= 0 (count remaining)) out
                          (recur (rest remaining) (conj out (body-error-types graph (first remaining))))))
        partition (body-eh-partition (first source-errors) clauses graph)
        premise {:version :sh08-atomic-typed-catch-v1 :source-node node
                 :source-handlers (loop [remaining clauses out []]
                                    (if (= 0 (count remaining)) out
                                      (recur (rest remaining) (conj out (get (first remaining) :record)))))
                 :catch-types (loop [remaining clauses out []]
                                (if (= 0 (count remaining)) out
                                  (recur (rest remaining) (conj out (get (first remaining) :error-type)))))
                 :child-types (body-eh-child-types ids types) :child-source-error-types source-errors
                 :partition partition :normal-result-type (get types (get node :node-id))
                 :matching :exact-canonical-atomic-type :effect-label-discharge :pending-profile-handler-capability-authority}]
    {:constraint-id-request {:domain :gravity/sh08-atomic-typed-catch-v1 :premise premise}
     :kind :equality :producer-rule :sh08-atomic-typed-catch-v1
     :lhs {:core-node-id (get node :node-id) :projection :source-error-handler-result}
     :rhs (get partition :residual) :dependencies premise :origin (get (get node :source) :origin-chain)
     :solution {:normal-result-type (get premise :normal-result-type) :thrown-error-effects (get partition :residual)
                :handled-source-errors (get partition :handled) :effect-label-discharge :pending-profile-handler-capability-authority}
     :invalidation [:error-handlers :error-transfers :catch-type-bindings :catch-lexical-bindings :type-table :source-forms :evaluation-order]
     :status :solved :diagnostics []}))

(defn body-eh-verify [request core facts groups graph budget]
  (let [tries (body-select (get core :nodes) :core-form :try)
        records (get core :error-handlers)
        rows (body-select (get facts :constraint-ledger) :producer-rule :sh08-atomic-typed-catch-v1)
        resolutions (body-path request [:b47-context :authenticated-core-request :resolution-table])
        source-forms (body-path request [:b47-context :authenticated-core-request :forms])
        work (+ (count (get core :nodes)) (count (get facts :constraint-ledger)) (if (vector? resolutions) (count resolutions) 0)
                (count source-forms)
                (* (count records) (+ 100 (* 4 (count (get core :nodes))))))]
    (if (= 0 (count tries))
      (if (= [] rows) {:status :accepted :work-count (+ (count (get core :nodes)) (count (get facts :constraint-ledger)))}
        (body-failure :unexpected-typed-catch-constraints))
      (if (= false (body-maps? resolutions)) (body-failure :malformed-catch-resolution-table)
      (if (> work budget) (body-failure :body-deferred-work-limit)
      (let [indexed (body-index resolutions :reference-syntax-id) types (get facts :type-table)
            forms (body-index source-forms :form-id)
            syntax-nodes (loop [remaining (get core :nodes) out {}]
                           (if (= 0 (count remaining)) out
                             (let [node (first remaining)]
                               (recur (rest remaining) (assoc out (get (get node :source) :syntax-id) node)))))
            expected
            (loop [remaining tries values []]
              (if (= 0 (count remaining)) {:status :accepted :rows values}
                (let [node (first remaining) id (get node :node-id) clauses (get groups id)
                      child-types (body-eh-child-types (get node :children) types)
                      joined (body-eh-normal-join child-types)
                      binders-valid?
                      (loop [remaining-clauses clauses]
                        (if (= 0 (count remaining-clauses)) true
                          (let [clause (first remaining-clauses) record (get clause :record)
                                resolution (get indexed (get record :error-type-syntax-id))
                                uses-valid?
                                (loop [uses (get record :catch-binding-use-syntax-ids)]
                                  (if (= 0 (count uses)) true
                                    (let [use-id (first uses) resolved (get indexed use-id)
                                          reference (get syntax-nodes use-id)]
                                      (if (body-all? [(= (get record :catch-binding-id) (get resolved :binding-id))
                                              (= (get resolved :symbol) (get (get forms (get (get reference :source) :form-id)) :value))
                                              (= (get clause :error-type) (get types (get reference :node-id)))])
                                        (recur (rest uses)) false))))]
                            (if (body-all? [(map? resolution) (= :type (get resolution :position))
                                    (= (get resolution :symbol) (get (get forms (get record :error-type-form-id)) :value))
                                    (= (get record :error-type-binding-id) (get resolution :binding-id)) uses-valid?])
                              (recur (rest remaining-clauses)) false))))
                      row (assoc (body-eh-constraint node clauses types graph)
                            :profile (get (get core :module) :profile) :target (get (get core :module) :target))]
                  (if (body-all? [binders-valid? (= false (= joined :gravity.type/unknown)) (= joined (get types id))
                                  (= (get row :rhs) (body-error-types graph id))
                                  (= (get (get row :solution) :handled-source-errors) (get (get graph id) :covered-source-errors))
                                  (= :pending-profile-handler-capability-authority (get (get graph id) :effect-label-discharge))])
                    (recur (rest remaining) (conj values row))
                    (body-failure :incoherent-atomic-typed-catch-body-equation)))))]
        (if (body-all? [(map? indexed) (= :accepted (get expected :status)) (= rows (get expected :rows))])
          {:status :accepted :work-count work}
          (body-failure :incoherent-atomic-typed-catch-ledger))))))))

(defn body-call-invokes? [node types]
  (loop [remaining (get node :children)]
    (if (= 0 (count remaining)) true
      (if (= :gravity.type/never (get types (first remaining))) false (recur (rest remaining))))))

(defn body-error-types [graph id]
  (get (get graph id) :escaping-thrown-error-types (vec (get (get graph id) :escaping-thrown-errors #{}))))

(defn body-error-work [node graph target]
  (let [ids (if (= target nil) (get node :children) (conj (get node :children) target))
        size (loop [remaining ids out 0]
               (if (= 0 (count remaining)) out (recur (rest remaining) (+ out (count (body-error-types graph (first remaining)))))))]
    (+ (if (if (= :collection-literal (get node :core-form)) true
              (if (= :call (get node :core-form))
                (contains? #{:gravity.type/applied-map-association :gravity.type/applied-map-removal :gravity.type/applied-vector-append :gravity.type/applied-list-prepend :gravity.type/applied-string-concat :gravity.type/applied-list-construction}
                  (get (get (get graph (first (get node :children))) :type) :kind)) false))
         (* 2 (+ 1 (count ids))) 0)
       (if (= 0 size) 0 (* (+ 2 (count ids)) (+ 1 size))))))

; L6/STD3: static constructor behavior, not a claim about observed heap
; placement. The existing graph binds ordered child types and source identity.
; Charge the normal-completion scan and its reconstruction in body-error-work.
(defn body-constructor-allocation [node graph]
  (if (= :collection-literal (get node :core-form))
    (let [children (get node :children) kind (get (get node :attributes) :literal-kind)
          normal? (loop [remaining children]
                    (if (= 0 (count remaining)) true
                      (if (= :gravity.type/never (get (get graph (first remaining)) :type)) false (recur (rest remaining)))))]
      {:rule-version :sh09-evaluated-collection-allocation-v1 :collection-kind kind
       :behavior :static-constructor-allocation :condition :normal-operand-completion
       :normal-completion-possible? normal?
       :extent {:unit (if (= kind :map) :entries :elements) :count (if (= kind :map) (quot (count children) 2) (count children))}
       :placement :pending-profile-representation :provider :pending-runtime-provider :ownership :pending-ownership-analysis}) nil))

(defn body-association-allocation [node graph]
  (if (if (= :call (get node :core-form))
        (= :gravity.type/applied-map-association (get (get (get graph (first (get node :children))) :type) :kind)) false)
    {:rule-version :sh09-map-association-allocation-v1 :collection-kind :map :behavior :static-persistent-map-association
     :condition :normal-operand-completion
     :normal-completion-possible? (loop [remaining (get node :children)]
                                    (if (= 0 (count remaining)) true
                                      (if (= :gravity.type/never (get (get graph (first remaining)) :type)) false (recur (rest remaining)))))
     :extent {:unit :association-operands :count 3}
     :placement :pending-profile-representation :provider :pending-runtime-provider :ownership :pending-ownership-analysis} nil))

(defn body-removal-allocation [node graph]
  (let [descriptor (get (get graph (first (get node :children))) :type)]
    (if (if (= :call (get node :core-form)) (= :gravity.type/applied-map-removal (get descriptor :kind)) false)
      {:rule-version :sh09-map-removal-allocation-v1 :collection-kind :map :behavior :static-persistent-map-removal
       :condition :normal-operand-completion :normal-completion-possible? (= :normal (get descriptor :application))
       :extent {:unit :removal-operands :count 2} :allocation-policy (get descriptor :allocation-policy)
       :storage-policy (get descriptor :storage-policy)
       :placement :pending-profile-representation :provider :pending-runtime-provider :ownership :pending-ownership-analysis} nil)))

(defn body-append-allocation [node graph]
  (let [descriptor (get (get graph (first (get node :children))) :type)]
    (if (if (= :call (get node :core-form))
          (contains? #{:gravity.type/applied-vector-append :gravity.type/applied-list-prepend} (get descriptor :kind)) false)
      (if (= :gravity.type/applied-list-prepend (get descriptor :kind))
        {:rule-version :sh09-list-prepend-allocation-v1 :collection-kind :list :behavior :static-persistent-list-prepend
         :condition :normal-operand-completion :normal-completion-possible? (= :normal (get descriptor :application))
         :extent {:unit :prepend-operands :count 2} :allocation-policy (get descriptor :allocation-policy)
         :storage-policy (get descriptor :storage-policy)
         :placement :pending-profile-representation :provider :pending-runtime-provider :ownership :pending-ownership-analysis}
      {:rule-version :sh09-vector-append-allocation-v1 :collection-kind :vector :behavior :static-persistent-vector-append
       :condition :normal-operand-completion
       :normal-completion-possible? (= :normal (get descriptor :application))
       :extent {:unit :elements :count (get descriptor :result-extent)}
       :placement :pending-profile-representation :provider :pending-runtime-provider :ownership :pending-ownership-analysis}) nil)))

(defn body-list-construction-allocation [node graph]
  (let [descriptor (get (get graph (first (get node :children))) :type)]
    (if (if (= :call (get node :core-form)) (= :gravity.type/applied-list-construction (get descriptor :kind)) false)
      {:rule-version :sh09-list-construction-allocation-v1 :collection-kind :list :behavior :static-persistent-list-construction
       :condition :normal-operand-completion :normal-completion-possible? (= :normal (get descriptor :application))
       :extent {:unit :elements :count (count (get descriptor :argument-types))}
       :placement :pending-profile-representation :provider :pending-runtime-provider :ownership :pending-ownership-analysis} nil)))

(defn body-string-concat-allocation [node graph]
  (let [descriptor (get (get graph (first (get node :children))) :type)]
    (if (if (= :call (get node :core-form)) (= :gravity.type/applied-string-concat (get descriptor :kind)) false)
      {:rule-version :sh09-string-concat-allocation-v1 :value-kind :string :behavior :static-binary-string-concatenation
       :condition :normal-operand-completion :normal-completion-possible? (= :normal (get descriptor :application))
       :extent {:unit :concatenation-operands :count 2}
       :placement :pending-profile-representation :provider :pending-runtime-provider :ownership :pending-ownership-analysis} nil)))

(defn body-node-record [node target graph type]
  (let [kind (get node :core-form) children (get node :children) source (get node :source)
        construction? (= kind :fn) latent (if construction? (body-node-effects children graph) #{})
        deps (if construction? [] (if (= target nil) children (conj children target)))
        allocation (if (= kind :collection-literal) (body-constructor-allocation node graph)
                       (let [list-allocation (body-list-construction-allocation node graph)
                             concatenation (if (= list-allocation nil) (body-string-concat-allocation node graph) list-allocation)]
                         (if (= concatenation nil)
                           (let [append (body-append-allocation node graph)]
                             (if (= append nil)
                               (let [removal (body-removal-allocation node graph)]
                                 (if (= removal nil) (body-association-allocation node graph) removal)) append)) concatenation)))
        direct (if (= true (get allocation :normal-completion-possible?)) #{:memory/allocate}
                 (if (if (= kind :throw) (= false (= :gravity.type/never (get (get graph (first children)) :type))) false)
                   #{:error/throw} #{}))
        effects (body-add direct (body-node-effects deps graph))
        error-ids (if construction? children deps)
        errors (loop [ids error-ids out []]
                 (if (= 0 (count ids)) out
                   (recur (rest ids) (body-error-type-union out (body-error-types graph (first ids))))))
        direct-errors (if (= direct #{:error/throw}) #{(get (get graph (first children)) :type)} #{})
        error-evidence? (if (= kind :throw) true
                          (loop [ids error-ids]
                            (if (= 0 (count ids)) false
                              (if (contains? (get graph (first ids)) :escaping-thrown-errors) true (recur (rest ids))))))
        record {:artifact :gravity/c8-effect-node :core-node-id (get node :node-id) :operation kind
     :direct direct :latent latent :transitive effects :escaping effects :handled []
     :evaluated-children (if construction? [] (body-order-ids (get (get node :evaluation) :order)))
     :latent-children (if construction? children [])
     :call-body-dependency target :dependencies deps
     :ordering (get node :evaluation) :conditional-coverage (body-conditional-coverage node)
     :source-span (get source :semantic-span) :syntax-id (get source :syntax-id)
     :origin-chain (get source :origin-chain) :generated-origin (get source :generated-origin)
     :type type :type-fact-id {:resolution :coordinator-digest-required
                              :identity-input {:domain :gravity/sh09-body-node-type-v1
                                               :core-node-id (get node :node-id) :type type}}}
        record (if (= allocation nil) record (assoc record :allocation allocation))]
    (if error-evidence?
      (assoc record :direct-thrown-errors direct-errors
        :escaping-thrown-errors (if construction? #{} (set (body-error-type-union errors (vec direct-errors))))
        :escaping-thrown-error-types (if construction? [] (body-error-type-union errors (vec direct-errors)))
        :latent-thrown-errors (if construction? (set errors) #{})
        :latent-thrown-error-types (if construction? errors [])) record)))

(defn body-node-supported? [node]
  (let [kind (get node :core-form) children (get node :children)]
    (if (body-all? [(map? node) (vector? children) (sh09-sha256-id? (get node :node-id))
                    (map? (get node :source)) (map? (get node :evaluation))])
      (if (contains? #{:literal :quote :reference} kind) (= [] children)
        (if (contains? #{:def :fn :throw} kind) (= 1 (count children))
          (if (= :if kind) (= 3 (count children))
            (if (= :recur kind)
              (if (contains? #{:loop :function} (get (get node :attributes) :target-kind))
                (sh09-sha256-id? (get (get node :attributes) :target-id)) false)
              (if (= kind :keyword-map-lookup) (= 2 (count children))
                (if (= kind :collection-literal)
                  (body-all? [(contains? #{:vector :map :set} (get (get node :attributes) :literal-kind))
                              (= (count children) (get (get node :attributes) :element-count))
                              (if (= :map (get (get node :attributes) :literal-kind))
                                (= (count children) (* 2 (quot (count children) 2))) true)])
                  (contains? #{:let :do :call :match :loop :try} kind))))))) false)))

(defn body-order-valid? [node]
  (let [kind (get node :core-form) children (get node :children) order (get (get node :evaluation) :order)
        expected (if (contains? #{:fn :quote} kind) []
                   (if (contains? #{:if :match :try} kind) [(first children)] children))]
    (if (if (= kind :keyword-map-lookup)
          (body-all? [(= 2 (count children)) (= :keyword-then-map (get (get node :evaluation) :kind))
                      (= :keyword-then-map (get (get node :attributes) :evaluation-order))]) true)
    (if (vector? order)
      (if (= (count expected) (count order))
        (loop [index 0]
          (if (= index (count order)) true
            (let [entry (get order index)]
              (if (if (map? entry) (body-all? [(= index (get entry :index))
                                              (= (get expected index) (get entry :core-node-id))]) false)
                (recur (+ index 1)) false)))) false) false) false)))

(defn body-foreign-node-record [node imported graph type]
  (let [base (body-node-record node nil graph type)
        effects (body-add (get (get imported :summary) :inferred) (get base :transitive))]
    (assoc base :foreign-body-dependency (assoc (get imported :coordinate) :body-core-node-id (get imported :body-core-node-id))
                :transitive effects :escaping effects)))

(defn body-selected-function [edge facts functions]
  (let [proof (get facts :higher-order-proof)]
    (if (if (map? proof) (= (get edge :call-core-node-id) (get proof :inner-call-core-node-id)) false)
      (get functions (get proof :identity-function-syntax-id))
      (get functions (get edge :callee-function-syntax-id)))))

(defn body-local-node-record [node target graph type facts edge]
  (let [base (body-node-record node target graph type) proof (get facts :higher-order-proof)]
    (if (if (map? proof) (= (get node :node-id) (get proof :inner-call-core-node-id)) false)
      (assoc base :call-body-dependency nil
        :selected-body-dependency {:proof-domain (get proof :domain)
          :identity-definition-binding-id (get proof :identity-definition-binding-id)
          :function-id (get proof :identity-function-syntax-id) :body-core-node-id target
          :callable-parameter-binding-id (get proof :apply-callable-binding-id) :source-edge (body-edge-projection edge)}) base)))

(defn body-control-node-record [node target graph type facts edge core source-target]
  (let [base (body-local-node-record node target graph type facts edge)
        base (if (= :try (get node :core-form))
               (let [partition (body-eh-partition (body-error-types graph (first (get node :children)))
                                 (get (get facts :atomic-typed-handlers {}) (get node :node-id) []) graph)]
                 (assoc base :escaping-thrown-error-types (get partition :residual)
                   :escaping-thrown-errors (set (get partition :residual))
                   :covered-source-errors (get partition :handled)
                   :effect-label-discharge :pending-profile-handler-capability-authority)) base)
        invoked? (body-call-invokes? node (get facts :type-table))
        base (if (if (= :call (get node :core-form))
                   (if (= false invoked?) true (contains? base :escaping-thrown-error-types)) false)
               (assoc base :throw-call-dependency {:source-edge edge :callee-source-body-id source-target
                 :analysis :conservative-source-error-potential :invocation-guard :all-operand-types-normal
                 :normal-invocation? invoked? :callee-error-types (if invoked? (body-error-types graph source-target) [])}) base)]
    (if (= :throw (get node :core-form))
      (let [transfer (body-by (get core :error-transfers) :core-node-id (get node :node-id))
            payload-type (get (get graph (get transfer :value-core-node-id)) :type)]
        (assoc base :error-transfer {:source-transfer transfer :payload-type payload-type
          :normal-transfer? (= false (= payload-type :gravity.type/never)) :ordered-steps [:evaluate-value :transfer-error]}))
    (if (= :recur (get node :core-form))
      (let [bodies (body-loop-body-ids node core)
            transfer (body-by (get core :recur-transfers) :recur-core-node-id (get node :node-id))
            target-record (body-by (get core :recur-targets) :target-id (get transfer :target-id))
            effects (body-add (body-node-effects bodies graph) (get base :transitive))]
        (assoc base :dependencies (body-add bodies (get base :dependencies))
          :loop-backedge {:target-id (get transfer :target-id) :body-core-node-ids bodies
                          :argument-core-node-ids (get transfer :argument-node-ids)
                          :source-transfer transfer :source-target target-record}
          :transitive effects :escaping effects)) base))))

(defn body-loop-summary-graph [graph ids summaries]
  (loop [remaining ids graph graph]
    (if (= 0 (count remaining)) graph
      (recur (rest remaining) (assoc graph (first remaining) {:transitive (get summaries (first remaining))})))))

(defn body-derive-nodes-pass [core typed foreign budget recursive summary]
  (let [edges (body-index (get core :call-edges) :call-core-node-id)
        functions (body-index (get typed :function-type-table) :function-id)]
    (loop [pending (get core :nodes) deferred [] graph {} progress 0 rounds 0 work 0]
      (if (= 0 (count pending))
        (if (= 0 (count deferred))
          (if (> work budget) (body-failure :body-deferred-work-limit) {:status :accepted :nodes graph :work-count work})
          (if (if (> progress 0) (< rounds (count (get core :nodes))) false)
            (recur deferred [] graph 0 (+ rounds 1) work)
            {:status :rejected :reason :cyclic-or-missing-body-effect-dependencies}))
        (if (>= work budget) (body-failure :body-deferred-work-limit)
        (let [node (first pending) kind (get node :core-form) id (get node :node-id)
              edge (get edges id) function (body-selected-function edge typed functions)
              imported (get foreign (get edge :callee-binding-id))
              target (if (if (= kind :call) (body-call-invokes? node (get typed :type-table)) false)
                       (if (= imported nil) (get function :body-core-node-id) nil) nil)
              backedge? (= id (get recursive :recursive-call-core-node-id))
              bodies (if (= kind :recur) (body-loop-body-ids node core) [])
              loop-cut? (if (= kind :recur) (contains? recursive :loop-summaries) false)
              deps (if (if (= target nil) true backedge?) (get node :children) (conj (get node :children) target))
              deps (if loop-cut? deps (body-add bodies deps))]
          (if (if (body-node-supported? node) (body-order-valid? node) false)
            (if (if (= kind :call) (if (map? imported) true (if (map? function) true
                                           (if (body-io-node? node typed core) true
                                             (if (if (body-ma-node? node typed core) true (body-mr-node? node typed core)) true
                                               (if (body-cq-node? node typed core) true (if (body-vn-node? node typed core) true
                                                 (if (body-va-node? node typed core) true
                                                   (if (if (if (if (if (if (if (body-lq-node? node typed core) true (body-lc-node? node typed core)) true (body-sc-node? node typed core)) true (body-mg-node? node typed core)) true (body-mc-node? node typed core)) true (body-nt-node? node typed core)) true (body-ae-node? node typed core)) true (body-si-node? node typed core)))))))))
                    (if (= kind :match) (body-match-valid? node core (get typed :type-table)) true))
              (if (body-ready? deps graph)
                (recur (rest pending) deferred
                       (assoc graph id (if (= imported nil)
                                         (body-control-node-record node target
                                           (body-loop-summary-graph
                                             (if backedge? (assoc graph target {:transitive summary}) graph)
                                             (if loop-cut? bodies []) (get recursive :loop-summaries))
                                           (get (get typed :type-table) id) typed edge core
                                           (get (get functions (get edge :callee-function-syntax-id)) :body-core-node-id))
                                         (body-foreign-node-record node imported graph (get (get typed :type-table) id))))
                       (+ progress 1) rounds (+ work 1 (body-error-work node graph target)))
                (recur (rest pending) (conj deferred node) graph progress rounds (+ work 1)))
              {:status :rejected :reason :unsupported-nonlocal-or-higher-order-call :node node})
            {:status :rejected :reason :unsupported-body-operation :node node})))))))

(defn body-derive-nodes-with-foreign [core facts foreign budget]
  (body-derive-nodes-pass core facts foreign budget {} #{}))

(defn body-graph-equations-valid? [core facts foreign graph]
  (let [edges (body-index (get core :call-edges) :call-core-node-id)
        functions (body-index (get facts :function-type-table) :function-id)]
    (loop [remaining (get core :nodes)]
      (if (= 0 (count remaining)) true
        (let [node (first remaining) id (get node :node-id) edge (get edges id)
              imported (get foreign (get edge :callee-binding-id))
              target (if (if (= :call (get node :core-form)) (body-call-invokes? node (get facts :type-table)) false)
                       (if (= imported nil) (get (body-selected-function edge facts functions) :body-core-node-id) nil) nil)
              deps (if (= target nil) (get node :children) (conj (get node :children) target))
              deps (if (= :recur (get node :core-form)) (body-add (body-loop-body-ids node core) deps) deps)]
          (if (if (if (= :call (get node :core-form))
                     (if (= imported nil) (if (map? (body-selected-function edge facts functions)) true
                                            (if (body-io-node? node facts core) true
                                              (if (if (body-ma-node? node facts core) true (body-mr-node? node facts core)) true
                                                (if (body-cq-node? node facts core) true (if (body-vn-node? node facts core) true
                                                  (if (body-va-node? node facts core) true
                                                    (if (if (if (if (if (if (if (body-lq-node? node facts core) true (body-lc-node? node facts core)) true (body-sc-node? node facts core)) true (body-mg-node? node facts core)) true (body-mc-node? node facts core)) true (body-nt-node? node facts core)) true (body-ae-node? node facts core)) true (body-si-node? node facts core)))))))) true) true)
                (if (body-ready? deps graph)
                (= (get graph id)
                   (if (= imported nil) (body-control-node-record node target graph (get (get facts :type-table) id) facts edge core
                                          (get (get functions (get edge :callee-function-syntax-id)) :body-core-node-id))
                     (body-foreign-node-record node imported graph (get (get facts :type-table) id)))) false) false)
            (recur (rest remaining)) false))))))

(defn body-function-bottom [facts]
  (loop [remaining (get facts :function-type-table) result {}]
    (if (= 0 (count remaining)) result
      (recur (rest remaining) (assoc result (get (first remaining) :function-id) #{})))))

(defn body-function-summary [facts graph]
  (loop [remaining (get facts :function-type-table) result {}]
    (if (= 0 (count remaining)) result
      (let [function (first remaining)]
        (recur (rest remaining)
          (assoc result (get function :function-id) (get (get graph (get function :body-core-node-id)) :transitive)))))))

(defn body-classify-nodes [core facts]
  (loop [remaining (get core :nodes)]
    (if (= 0 (count remaining)) {:status :accepted}
      (let [node (first remaining)]
        (if (if (body-node-supported? node)
              (if (body-order-valid? node)
                (if (= :match (get node :core-form)) (body-match-valid? node core (get facts :type-table)) true) false) false)
          (recur (rest remaining))
          {:status :rejected :reason :unsupported-body-operation :node node})))))

(defn body-derive-recursive-nodes [core facts foreign budget]
  (let [proof (get facts :recursive-proof) size (count (get core :nodes))
        classified (if (<= size budget) (body-classify-nodes core facts) (body-failure :body-deferred-work-limit))]
    (if (body-recursive-proof-valid? core facts)
      (if (= :accepted (get classified :status))
        (loop [summaries (body-function-bottom facts) work size rounds 0]
          (if (if (< rounds 65536) (< work budget) false)
            (let [derived (body-derive-nodes-pass core facts foreign (- budget work) proof
                            (get summaries (get proof :function-syntax-id)))
                  used (+ work (get derived :work-count 0))
                  next (if (= :accepted (get derived :status)) (body-function-summary facts (get derived :nodes)) {})]
              (if (= :accepted (get derived :status))
                (if (= summaries next)
                  (let [final (body-derive-nodes-pass core facts foreign (- budget used) proof
                                (get next (get proof :function-syntax-id)))
                        total (+ used (get final :work-count 0) size)]
                    (if (= :accepted (get final :status))
                      (if (<= total budget)
                        (if (if (= next (body-function-summary facts (get final :nodes)))
                              (body-graph-equations-valid? core facts foreign (get final :nodes)) false)
                          (assoc final :work-count total :fixed-point-rounds (+ rounds 1))
                          (body-failure :recursive-effect-equations-mismatch))
                        (body-failure :body-deferred-work-limit)) final))
                  (recur next used (+ rounds 1))) derived))
            (body-failure :body-deferred-work-limit))) classified)
      (body-failure :untrusted-recursive-body-proof))))

(defn body-loop-summary [core graph]
  (loop [remaining (get core :recur-transfers) out {}]
    (if (= 0 (count remaining)) out
      (let [node (body-by (get core :nodes) :node-id (get (first remaining) :recur-core-node-id))
            out (loop [ids (body-loop-body-ids node core) out out]
                  (if (= 0 (count ids)) out
                    (recur (rest ids) (assoc out (first ids) (get (get graph (first ids)) :transitive #{})))))]
        (recur (rest remaining) out)))))

(defn body-derive-loop-nodes [core facts foreign budget]
  (let [size (count (get core :nodes)) proof (get facts :recursive-proof {})
        classified (if (<= size budget) (body-classify-nodes core facts) (body-failure :body-deferred-work-limit))
        joined (if (= :accepted (get classified :status))
                 (body-loop-joins core facts (- budget size)) classified)]
    (if (if (contains? facts :recursive-proof) (body-recursive-proof-valid? core facts) true)
      (if (= :accepted (get joined :status))
        (if (body-loop-values-valid? core facts)
          (loop [functions (body-function-bottom facts) summaries (body-loop-summary core {})
                 work (+ size (get joined :work-count)) rounds 0]
            (if (if (< rounds 65536) (< work budget) false)
              (let [derived (body-derive-nodes-pass core facts foreign (- budget work)
                              (assoc proof :loop-summaries summaries) (get functions (get proof :function-syntax-id)))
                    used (+ work (get derived :work-count 0))
                    next-functions (if (= :accepted (get derived :status)) (body-function-summary facts (get derived :nodes)) {})
                    next (if (= :accepted (get derived :status)) (body-loop-summary core (get derived :nodes)) {})]
                (if (= :accepted (get derived :status))
                  (if (if (= summaries next) (= functions next-functions) false)
                    (let [final (body-derive-nodes-pass core facts foreign (- budget used)
                                  (assoc proof :loop-summaries next) (get next-functions (get proof :function-syntax-id)))
                          total (+ used (get final :work-count 0) size)]
                      (if (= :accepted (get final :status))
                        (if (<= total budget)
                          (if (body-all? [(= next (body-loop-summary core (get final :nodes)))
                                          (= next-functions (body-function-summary facts (get final :nodes)))
                                          (body-graph-equations-valid? core facts foreign (get final :nodes))])
                            (assoc final :work-count total :fixed-point-rounds (+ rounds 1))
                            (body-failure :loop-effect-equations-mismatch))
                          (body-failure :body-deferred-work-limit)) final))
                    (recur next-functions next used (+ rounds 1))) derived))
              (body-failure :body-deferred-work-limit)))
          (body-failure :incoherent-loop-result-type)) joined)
      (body-failure :untrusted-recursive-body-proof))))

(defn body-derive-nodes [core facts]
  (body-derive-nodes-with-foreign core facts {} 65536))

(defn body-function-effects [functions graph]
  (loop [remaining functions result {}]
    (if (= 0 (count remaining)) result
      (let [function (first remaining) effects (get (get graph (get function :body-core-node-id)) :transitive)]
        (recur (rest remaining)
          (assoc result (get function :function-id)
            {:function-id (get function :function-id) :body-core-node-id (get function :body-core-node-id)
             :declared (set (get function :latent-effects)) :inferred effects :latent effects
             :throws (get function :thrown-error-effects) :declared-capabilities (set (get function :capabilities))
             :source-span (get function :source-span)}))))))

(defn body-build-graph [core typed nodes]
  (let [effects (body-node-effects (get core :root-core-node-ids) nodes)]
    {:artifact :gravity/c8-effect-graph :module (get typed :module) :nodes nodes
     :functions (body-function-effects (get typed :function-type-table) nodes)
     :namespace {:declared (set (get (get typed :module) :effects)) :inferred effects :escaping effects :handled []}
     :build-effects :pending-policy :replay-required :pending-policy :ordering-constraints (get core :evaluation-order)
     :residual-effects :pending-legality :diagnostics [] :pending (body-effect-pending)}))

(defn body-derive-module-nodes [core facts foreign budget]
  (let [transfers (get core :recur-transfers)
        control? (if (if (vector? transfers) (> (count transfers) 0)
                       (if (= transfers nil) false true)) true
                   (loop [remaining (get core :nodes)]
                     (if (= 0 (count remaining)) false
                       (if (contains? #{:loop :recur} (get (first remaining) :core-form)) true
                         (recur (rest remaining))))))
        derived (if control? (body-derive-loop-nodes core facts foreign budget)
                  (if (contains? facts :recursive-proof)
                    (body-derive-recursive-nodes core facts foreign budget)
                    (body-derive-nodes-with-foreign core facts foreign budget)))]
    (assoc derived :recur-control? control?)))

(defn body-throw-source [form]
  {:form-id (get form :form-id) :syntax-id (get form :syntax-id)
   :semantic-span (get form :source-span) :origin-chain (get form :origin-chain)
   :generated-origin (get form :generated-origin)})

(defn body-throw-owners [core budget]
  (let [nodes (body-index (get core :nodes) :node-id)]
    (loop [pending (loop [ids (get core :root-core-node-ids) out []]
                     (if (= 0 (count ids)) out (recur (rest ids) (conj out {:id (first ids) :owner nil}))))
           out {} work 0]
      (if (= 0 (count pending)) {:status :accepted :owners out :work-count work}
        (if (>= work budget) (body-failure :body-deferred-work-limit)
          (let [entry (first pending) id (get entry :id) node (get nodes id) owner (get entry :owner)]
            (if (if (map? node) (= false (contains? out id)) false)
              (recur (loop [ids (get node :children) stack (vec (rest pending))]
                       (if (= 0 (count ids)) stack
                         (recur (rest ids) (conj stack {:id (first ids)
                           :owner (if (= :fn (get node :core-form)) (get (get node :source) :syntax-id) owner)}))))
                     (assoc out id owner) (+ work 1))
              (body-failure :incoherent-throw-owner-graph))))))))

(defn body-throw-transfer-valid? [transfer node payload forms owner ordinal]
  (let [source (get node :source) form (get forms (get source :form-id)) ids (get form :child-form-ids)
        operator (get forms (get ids 0)) value (get forms (get ids 1)) attrs (get node :attributes)
        shared [:construction-order :runtime-reachability :transfer-policy :result-policy :required-effect
                :authenticated-sh06-artifact-id :sh06-semantic-projection-id :type-legality :effect-registry-legality
                :effect-profile-capability-legality :profile-error-lowering-legality :ownership-legality :safety-classification]]
    (body-all?
      [(= ordinal (get transfer :ordinal)) (= :throw (get node :core-form))
       (= (get node :node-id) (get transfer :core-node-id))
       (= source (body-throw-source form)) (= (get source :form-id) (get transfer :form-id))
       (= (get source :syntax-id) (get transfer :syntax-id)) (= :list (get form :kind))
       (vector? ids) (= 2 (count ids)) (= 2 (count (set ids)))
       (if (seq? (get form :value)) (= ['throw (get value :value)] (vec (get form :value))) false)
       (= :symbol (get operator :kind)) (= 'throw (get operator :value)) (= [] (get operator :child-form-ids))
       (= (get form :form-id) (get operator :parent-form-id) (get value :parent-form-id))
       (= (get payload :source) (body-throw-source value))
       (= [(get payload :node-id)] (get node :children) (get transfer :evaluated-children))
       (= (get payload :node-id) (get transfer :value-core-node-id)) (= [] (get node :resolved-binding-ids))
       (= :value-then-transfer (get (get node :evaluation) :kind) (get attrs :evaluation-order))
       (= [{:index 0 :core-node-id (get payload :node-id)}] (get (get node :evaluation) :order))
       (= owner (get transfer :evaluation-owner-function-syntax-id) (get (get node :evaluation) :owner-function-syntax-id))
       (= (get transfer :evaluation-region) (get (get node :evaluation) :region))
       (= [:evaluate-value :transfer-error] (get transfer :ordered-steps)) (= 0 (get attrs :value-child-index))
       (= :postorder-after-value (get attrs :construction-order)) (= :error-transfer (get attrs :transfer-policy))
       (= :never (get attrs :result-policy)) (= :error/throw (get attrs :required-effect))
       (= :not-asserted-by-sh07-b7 (get attrs :runtime-reachability))
       (= [:pending-sh08 :pending-sh09 :pending-sh09 :pending-sh09 :pending-sh10 :pending-sh11]
          [(get attrs :type-legality) (get attrs :effect-registry-legality) (get attrs :effect-profile-capability-legality)
           (get attrs :profile-error-lowering-legality) (get attrs :ownership-legality) (get attrs :safety-classification)])
       (= (body-project transfer shared) (body-project attrs shared))])))

(defn body-tc-scope-with-types [core direct budget facts]
  (let [nodes (body-index (get core :nodes) :node-id)
        owners (loop [remaining (get core :error-handlers) out #{}]
                 (if (= 0 (count remaining)) out
                   (recur (rest remaining) (conj out (get (first remaining) :evaluation-owner-function-syntax-id)))))
        initial (loop [remaining (keys direct) out owners]
                  (if (= 0 (count remaining)) out (recur (rest remaining) (conj out (first remaining)))))]
  (loop [scope initial next initial edges (get core :call-edges) touched owners work (count (get core :error-handlers))]
    (if (>= work budget) (body-failure :body-deferred-work-limit)
      (if (= 0 (count edges))
        (if (= scope next) {:status :accepted :scope touched :active? (> (count touched) 0) :work-count work}
          (recur next next (get core :call-edges) touched work))
        (let [edge (first edges) caller (get edge :caller-function-syntax-id) callee (get edge :callee-function-syntax-id)
              local? (= :local-function (get edge :classification))
              intrinsic? (if (body-io-node? (get nodes (get edge :call-core-node-id)) facts core) true
                             (if (if (body-ma-node? (get nodes (get edge :call-core-node-id)) facts core) true (body-mr-node? (get nodes (get edge :call-core-node-id)) facts core)) true
                               (if (body-cq-node? (get nodes (get edge :call-core-node-id)) facts core) true
                                 (if (body-vn-node? (get nodes (get edge :call-core-node-id)) facts core) true
                                   (if (body-va-node? (get nodes (get edge :call-core-node-id)) facts core) true
                                     (if (if (if (if (if (if (if (body-lq-node? (get nodes (get edge :call-core-node-id)) facts core) true (body-lc-node? (get nodes (get edge :call-core-node-id)) facts core)) true (body-sc-node? (get nodes (get edge :call-core-node-id)) facts core)) true (body-mg-node? (get nodes (get edge :call-core-node-id)) facts core)) true (body-mc-node? (get nodes (get edge :call-core-node-id)) facts core)) true (body-nt-node? (get nodes (get edge :call-core-node-id)) facts core)) true (body-ae-node? (get nodes (get edge :call-core-node-id)) facts core)) true
                                       (body-si-node? (get nodes (get edge :call-core-node-id)) facts core)))))))
              touches? (if (contains? scope caller) true (if local? (contains? scope callee) false))]
          (if (if touches? (if local? false (= false intrinsic?)) false) (body-failure :unsupported-throwing-call-component)
            (recur scope (if touches? (if local? (conj (conj next caller) callee) (conj next caller)) next) (rest edges)
                   (if touches? (if local? (conj (conj touched caller) callee) (conj touched caller)) touched) (+ work 1)))))))))

(defn body-tc-scope [core direct budget]
  (body-tc-scope-with-types core direct budget {}))

(defn body-throw-joins-checked [request facts budget]
  (let [core (get request :canonical-core-artifact) nodes (get core :nodes)
        transfers (get core :error-transfers) throwing (body-select nodes :core-form :throw)
        rows (body-select (get facts :constraint-ledger) :producer-rule :sh08-direct-typed-throw-v1)]
    (if (= 0 (count throwing))
      (if (body-all? [(if (= transfers nil) true (= [] transfers)) (= [] rows)
              (loop [functions (get facts :function-type-table)]
                (if (= 0 (count functions)) true
                  (if (if (> (count (get core :error-handlers)) 0) true (= [:pending-sh09] (get (first functions) :thrown-error-effects)))
                    (recur (rest functions)) false)))])
        (let [scoped (body-tc-scope-with-types core {} budget facts)
              owners (if (get scoped :active?) (body-throw-owners core (- budget (get scoped :work-count 0)))
                         {:status :accepted :owners {} :work-count 0})]
          (if (body-all? [(= :accepted (get scoped :status)) (= :accepted (get owners :status))])
            {:status :accepted :scope (get scoped :scope) :active? (get scoped :active?) :direct-throws {}
             :owners (get owners :owners) :work-count (+ (get scoped :work-count) (get owners :work-count))} scoped))
        (body-failure :incoherent-throw-census-or-summary))
      (let [source-forms (body-path request [:b47-context :authenticated-core-request :forms])
            work (+ (* 6 (count nodes)) (count source-forms) (count (get facts :constraint-ledger))
                    (* 70 (count throwing)) (count (get core :call-edges))
                    (count (get facts :function-type-table)))
            indexed (body-index nodes :node-id) forms (body-index source-forms :form-id)
            owners (body-throw-owners core (- budget work)) types (get facts :type-table)]
        (if (body-all? [(<= work budget) (= :accepted (get owners :status)) (map? indexed) (map? forms)
                (vector? transfers) (= (count throwing) (count (if (vector? transfers) transfers [])) (count rows))
                (map? (body-index transfers :core-node-id)) (map? (body-index rows :lhs))
                (= (set (keys (body-index throwing :node-id))) (set (keys (body-index transfers :core-node-id))))
                (= (body-throw-semantic-transfers core) (get (get core :identity-preimage) :error-transfers))])
          (loop [remaining transfers ordinal 0 thrown {} used (+ work (get owners :work-count))]
            (if (= 0 (count remaining))
              (let [scoped (body-tc-scope-with-types core thrown (- budget used) facts)]
              (if (= :accepted (get scoped :status))
              (if (if (get scoped :active?) true (loop [functions (get facts :function-type-table)]
                    (if (= 0 (count functions)) true
                      (let [function (first functions) id (get function :function-id)]
                        (if (= (get function :thrown-error-effects) (get thrown id [:pending-sh09]))
                          (recur (rest functions)) false)))))
                {:status :accepted :scope (get scoped :scope) :active? (get scoped :active?)
                 :direct-throws thrown :owners (get owners :owners) :work-count (+ used (get scoped :work-count))}
                (body-failure :incoherent-function-thrown-errors)) scoped))
              (if (>= used budget) (body-failure :body-deferred-work-limit)
                (let [transfer (first remaining) node (get indexed (get transfer :core-node-id))
                      payload (get indexed (get transfer :value-core-node-id)) type (get types (get payload :node-id))
                      owner (get (get owners :owners) (get node :node-id)) occurring? (= false (= type :gravity.type/never))
                      premise {:version :sh08-direct-typed-throw-v1 :source-transfer transfer :source-node node
                               :payload-node payload :payload-type type :owner-function-syntax-id owner
                               :normal-transfer? occurring? :result-type :gravity.type/never}
                      expected {:constraint-id-request {:domain :gravity/sh08-direct-typed-throw-v1 :premise premise}
                                :kind :equality :producer-rule :sh08-direct-typed-throw-v1
                                :lhs (get node :node-id) :rhs :gravity.type/never :dependencies premise
                                :origin (get (get node :source) :origin-chain)
                                :invalidation [:error-transfers :throw-source :payload-source :payload-type :function-owner :evaluation-order]
                                :solution {:type :gravity.type/never :payload-type type :normal-transfer? occurring?}
                                :profile (get (get core :module) :profile) :target (get (get core :module) :target)
                                :status :solved :diagnostics []}]
                  (if (body-all? [(body-throw-transfer-valid? transfer node payload forms owner ordinal)
                          (= :gravity.type/never (get types (get node :node-id)))
                          (= false (= type nil)) (= false (= type :gravity.type/unknown))
                          (= expected (get rows ordinal))])
                    (recur (rest remaining) (+ ordinal 1)
                      (assoc thrown owner (if (if occurring? (= false (contains? (set (get thrown owner [])) type)) false)
                                            (conj (get thrown owner []) type) (get thrown owner []))) (+ used 1))
                    (assoc (body-failure :incoherent-typed-throw-transfer) :node node))))))
          (body-failure :incoherent-throw-source-type-census))))))

(defn body-throw-joins [request facts budget]
  (if (body-maps? (get facts :constraint-ledger))
    (body-throw-joins-checked request facts budget)
    (body-failure :malformed-thrown-error-constraint-ledger)))

(defn body-tc-constraint [core edge calls nodes records bindings types functions graph]
  (let [id (get edge :call-core-node-id) node (get nodes id)
        caller (get records (get edge :caller-function-syntax-id)) callee (get records (get edge :callee-function-syntax-id))
        invoked? (body-call-invokes? node types) body (get callee :body-core-node-id)
        operand-errors (loop [ids (get node :children) out []]
                         (if (= 0 (count ids)) out (recur (rest ids) (body-error-type-union out (body-error-types graph (first ids))))))
        callee-errors (if invoked? (body-error-types graph body) [])
        argument-types (loop [ids (get edge :argument-core-node-ids) out []]
                         (if (= 0 (count ids)) out (recur (rest ids) (conj out (get types (first ids))))))
        premise {:version :sh08-acyclic-local-thrown-errors-v1 :analysis :conservative-source-error-potential
                 :invocation-guard :all-operand-types-normal :source-edge edge :source-call (get calls id)
                 :source-node node :operator-node (get nodes (first (get node :children)))
                 :caller-function caller :callee-function callee :callee-binding (get bindings (get edge :callee-binding-id))
                 :callee-normal-type (if (contains? #{:gravity.type/applied-integral-ordering :gravity.type/applied-map-association :gravity.type/applied-map-removal :gravity.type/applied-collection-count :gravity.type/applied-vector-nth :gravity.type/applied-bounded-successor :gravity.type/applied-vector-append :gravity.type/applied-list-prepend :gravity.type/applied-atomic-equality :gravity.type/applied-not :gravity.type/applied-map-contains :gravity.type/applied-map-get :gravity.type/applied-string-concat :gravity.type/applied-list-construction :gravity.type/applied-list-query}
                                                    (get (get types (first (get node :children))) :kind))
                   (get types (first (get node :children)))
                   (body-project (get functions (get edge :callee-function-syntax-id)) [:parameters :return :fixed-arity :signature :latent-effects]))
                 :operand-types argument-types :callee-source-body-id body :normal-invocation? invoked?
                 :operand-error-types operand-errors :callee-error-types callee-errors
                 :error-types (body-error-type-union operand-errors callee-errors)}]
    {:constraint-id-request {:domain :gravity/sh08-acyclic-local-thrown-errors-v1 :premise premise}
     :kind :equality :producer-rule :sh08-acyclic-local-thrown-errors-v1
     :lhs {:core-node-id id :projection :thrown-error-effects} :rhs (get premise :error-types)
     :origin (get (get node :source) :origin-chain) :dependencies premise
     :solution {:thrown-error-effects (get premise :error-types) :normal-result-type (get types id)}
     :invalidation [:call-edges :calls :binding-table :function-records :callee-body :type-table :error-transfers :evaluation-order]
     :profile (get (get core :module) :profile) :target (get (get core :module) :target) :status :solved :diagnostics []}))

(defn body-tc-verify [core facts bindings graph joined budget]
  (let [actual (body-select (get facts :constraint-ledger) :producer-rule :sh08-acyclic-local-thrown-errors-v1)
        scope (get joined :scope #{})
        nodes (body-index (get core :nodes) :node-id) records (body-index (get core :function-records) :function-syntax-id)
        calls (body-index (get core :calls) :core-node-id) functions (body-index (get facts :function-type-table) :function-id)
        initial (+ (* 3 (count (get core :nodes))) (* 3 (count (get core :call-edges)))
                   (count bindings) (* 2 (count (get core :function-records))))]
    (if (= true (get joined :active?))
      (if (body-all?
            [(loop [remaining (get core :nodes)]
               (if (= 0 (count remaining)) true
                 (let [node (first remaining)]
                   (if (if (contains? scope (get (get joined :owners) (get node :node-id)))
                         ; Loop joins and effect equations precede this check.
                         ; Typed errors retain the C7 lexical-child source union.
                         (contains? #{:literal :quote :reference :fn :def :do :if :let :match :loop :recur :collection-literal :keyword-map-lookup :throw :call :try} (get node :core-form)) true)
                     (recur (rest remaining)) false))))
             (loop [remaining (get core :recursion-components)]
               (if (= 0 (count remaining)) true
                 (if (loop [ids (get (first remaining) :function-syntax-ids)]
                       (if (= 0 (count ids)) false (if (contains? scope (first ids)) true (recur (rest ids))))) false
                   (recur (rest remaining)))))])
        (let [derived (loop [remaining (get core :call-edges) rows [] work initial]
                        (if (> work budget) (body-failure :body-deferred-work-limit)
                          (if (= 0 (count remaining)) {:status :accepted :rows rows :work-count work}
                            (let [edge (first remaining) id (get edge :call-core-node-id) node (get nodes id)]
                              (if (contains? scope (get edge :caller-function-syntax-id))
                                (let [row (body-tc-constraint core edge calls nodes records bindings (get facts :type-table) functions graph)]
                                  (if (= (get row :rhs) (body-error-types graph id))
                                    (recur (rest remaining) (conj rows row)
                                      (+ work 70 (* 4 (+ 1 (body-error-work node graph
                                        (get (get records (get edge :callee-function-syntax-id)) :body-core-node-id))))))
                                    (body-failure :incoherent-call-body-error-equation)))
                                (recur (rest remaining) rows (+ work 1)))))))
              summaries (loop [remaining (get core :function-records) out {} work (get derived :work-count budget)]
                          (if (> work budget) (body-failure :body-deferred-work-limit)
                            (if (= 0 (count remaining)) {:status :accepted :functions out :work-count work}
                              (let [record (first remaining) id (get record :function-syntax-id) function (get functions id)
                                    errors (if (contains? scope id) (body-error-types graph (get record :body-core-node-id))
                                             (get (get joined :direct-throws) id [:pending-sh09]))
                                    normal-types (loop [parameters (get function :parameters) out []]
                                                   (if (= 0 (count parameters)) (conj out (get function :return))
                                                     (recur (rest parameters) (conj out (get (first parameters) :type)))))]
                                (if (if (= (get function :thrown-error-effects) errors)
                                      (if (contains? scope id)
                                        (loop [types normal-types]
                                          (if (= 0 (count types)) true
                                            (if (contains? #{nil :gravity.type/unknown} (first types)) false (recur (rest types))))) true) false)
                                  (recur (rest remaining) (if (contains? scope id) (assoc out id errors) out)
                                         (+ work 1 (count errors) (count normal-types)))
                                  (body-failure :incoherent-propagated-function-errors))))))]
          (if (body-all? [(= :accepted (get derived :status)) (= actual (get derived :rows))
                          (= :accepted (get summaries :status))]) summaries
            (body-failure :incoherent-call-error-propagation-ledger)))
        (body-failure :unsupported-throwing-call-component))
      (if (= [] actual) {:status :accepted :functions {} :work-count 0}
        (body-failure :unexpected-call-error-propagation-ledger)))))

(defn body-allowance-check [core facts graph budget]
  (let [nodes (get graph :nodes) indexed (body-index (get core :nodes) :node-id)
        functions (body-index (get facts :function-type-table) :function-id)
        initial (+ (count (get core :nodes)) (count (get facts :function-type-table)))]
    (loop [functions-left (get core :function-records) work initial]
      (if (> work budget) (body-failure :body-deferred-work-limit)
      (if (= 0 (count functions-left))
        (loop [remaining (get core :nodes) work work]
          (if (> work budget) (body-failure :body-deferred-work-limit)
          (if (= 0 (count remaining)) {:status :accepted :work-count work}
            (let [node (first remaining) effects (get (get nodes (get node :node-id)) :direct)
                  missing (loop [labels (vec effects)]
                            (if (= 0 (count labels)) nil
                              (if (contains? (set (get (get facts :module) :effects)) (first labels))
                                (recur (rest labels)) (first labels))))]
              (if (= missing nil) (recur (rest remaining) (+ work 1 (count effects)))
                {:status :rejected :rule "C8-UNDECLARED" :reason :namespace-effect-outside-source-allowance
                 :node node :effect missing})))))
        (let [function (get functions (get (first functions-left) :function-syntax-id))
              effects (get (get graph :functions) (get function :function-id))
              missing (loop [labels (vec (get effects :inferred))]
                        (if (= 0 (count labels)) nil
                          (if (contains? (get effects :declared) (first labels)) (recur (rest labels)) (first labels))))]
          (if (= missing nil) (recur (rest functions-left) (+ work 1 (count (get effects :inferred))))
            {:status :rejected :rule "C8-UNDECLARED" :reason :function-effect-outside-source-allowance
             :node (get indexed (get function :function-core-node-id)) :function (get function :function-id)
             :effect missing})))))))

(defn body-analyze-module [request facts foreign budget]
  (let [core (get request :canonical-core-artifact)]
    (if (body-shape-valid? core facts)
    (let [bindings (body-index (body-path request [:b47-context :authenticated-core-request :binding-table]) :binding-id)
        associations (body-ma-context request facts bindings budget)
        appends (if (= :accepted (get associations :status))
                  (body-va-context request facts bindings (- budget (get associations :work-count 0))) associations)
        equalities (if (= :accepted (get appends :status))
                     (body-ae-context request facts bindings (- budget (get associations :work-count 0) (get appends :work-count 0))) appends)
        negations (if (= :accepted (get equalities :status))
                    (body-nt-context request facts bindings (- budget (get associations :work-count 0) (get appends :work-count 0) (get equalities :work-count 0))) equalities)
        memberships (if (= :accepted (get negations :status))
                      (body-mc-context request facts bindings (- budget (get associations :work-count 0) (get appends :work-count 0) (get equalities :work-count 0) (get negations :work-count 0))) negations)
        lookups (if (= :accepted (get memberships :status))
                  (body-mg-context request facts bindings (- budget (get associations :work-count 0) (get appends :work-count 0) (get equalities :work-count 0) (get negations :work-count 0) (get memberships :work-count 0))) memberships)
        concatenations (if (= :accepted (get lookups :status))
                         (body-sc-context request facts bindings (- budget (get associations :work-count 0) (get appends :work-count 0) (get equalities :work-count 0) (get negations :work-count 0) (get memberships :work-count 0) (get lookups :work-count 0))) lookups)
        lists (if (= :accepted (get concatenations :status))
                (body-lc-context request facts bindings (- budget (get associations :work-count 0) (get appends :work-count 0) (get equalities :work-count 0) (get negations :work-count 0) (get memberships :work-count 0) (get lookups :work-count 0) (get concatenations :work-count 0))) concatenations)
        queries (if (= :accepted (get lists :status))
                  (body-lq-context request facts bindings (- budget (get associations :work-count 0) (get appends :work-count 0) (get equalities :work-count 0) (get negations :work-count 0) (get memberships :work-count 0) (get lookups :work-count 0) (get concatenations :work-count 0) (get lists :work-count 0))) lists)
        parameters (if (= :accepted (get queries :status))
                     (body-lp-context request facts bindings (- budget (get associations :work-count 0) (get appends :work-count 0) (get equalities :work-count 0) (get negations :work-count 0) (get memberships :work-count 0) (get lookups :work-count 0) (get concatenations :work-count 0) (get lists :work-count 0) (get queries :work-count 0))) queries)
        counts (if (= :accepted (get parameters :status))
                 (body-cq-context request facts bindings (- budget (get associations :work-count 0) (get appends :work-count 0) (get equalities :work-count 0) (get negations :work-count 0) (get memberships :work-count 0) (get lookups :work-count 0) (get concatenations :work-count 0) (get lists :work-count 0) (get queries :work-count 0) (get parameters :work-count 0))) parameters)
        selections (if (= :accepted (get counts :status))
                     (body-vn-context request facts bindings (- budget (get associations :work-count 0) (get appends :work-count 0) (get equalities :work-count 0) (get negations :work-count 0) (get memberships :work-count 0) (get lookups :work-count 0) (get concatenations :work-count 0) (get lists :work-count 0) (get queries :work-count 0) (get parameters :work-count 0) (get counts :work-count 0))) counts)
        successors (if (= :accepted (get selections :status))
                     (body-si-context request facts bindings (- budget (get associations :work-count 0) (get appends :work-count 0) (get equalities :work-count 0) (get negations :work-count 0) (get memberships :work-count 0) (get lookups :work-count 0) (get concatenations :work-count 0) (get lists :work-count 0) (get queries :work-count 0) (get parameters :work-count 0) (get counts :work-count 0) (get selections :work-count 0))) selections)
        prior-source-work (+ (get successors :work-count 0) (get associations :work-count 0) (get appends :work-count 0) (get equalities :work-count 0) (get negations :work-count 0) (get memberships :work-count 0) (get lookups :work-count 0) (get concatenations :work-count 0) (get lists :work-count 0) (get queries :work-count 0) (get parameters :work-count 0) (get counts :work-count 0) (get selections :work-count 0))
        removals (if (= :accepted (get successors :status))
                   (body-mr-context request facts bindings (- budget prior-source-work)) successors)
        prior-source-work (+ prior-source-work (if (= :accepted (get successors :status)) (get removals :work-count 0) 0))
        returns (if (= :accepted (get removals :status))
                  (body-lr-context core facts bindings (body-path request [:b47-context :authenticated-core-request :forms]) (- budget prior-source-work))
                  removals)
        joins (if (= :accepted (get returns :status))
                (body-ij-context core facts bindings (body-path request [:b47-context :authenticated-core-request :forms])
                  (- budget prior-source-work (get returns :work-count 0))) returns)
        source-work (+ prior-source-work (get returns :work-count 0)
                       (if (= :accepted (get returns :status)) (get joins :work-count 0) 0))
        facts (assoc facts :removal-context (get removals :context) :if-join-context (get joins :context) :return-context (get returns :context) :association-context (get associations :context) :count-context (get counts :context) :append-context (get appends :context) :equality-context (get equalities :context)
                           :list-parameter-context (get parameters :context) :list-query-context (get queries :context) :list-construction-context (get lists :context) :string-concat-context (get concatenations :context) :map-get-context (get lookups :context) :map-contains-context (get memberships :context) :not-context (get negations :context) :vector-nth-context (get selections :context) :successor-context (get successors :context)) budget (- budget source-work)]
    (if (= :accepted (get joins :status))
      (if (if (if (contains? facts :higher-order-proof) (body-ho-proof-valid? core facts bindings) true)
            (if (body-function-joins-valid? core facts bindings)
            (if (body-call-joins-with-foreign-valid? core facts bindings foreign)
              (body-local-joins-valid? core facts bindings) false) false) false)
        (let [handlers (body-eh-source-products core
                         (body-path request [:b47-context :authenticated-core-request :forms])
                         (body-path request [:b47-context :authenticated-core-request :binding-table]) budget)
              facts (assoc facts :atomic-typed-handlers (get handlers :groups {}))
              throws (if (= :accepted (get handlers :status))
                       (body-throw-joins request facts (- budget (get handlers :work-count))) handlers)
              derived (if (= :accepted (get throws :status))
                        (body-derive-module-nodes core facts foreign (- budget (get handlers :work-count) (get throws :work-count))) throws)
              loop? (get derived :recur-control?)]
          (if (= :accepted (get derived :status))
            (let [handler-check (body-eh-verify request core facts (get handlers :groups) (get derived :nodes)
                                  (- budget (get handlers :work-count) (get throws :work-count) (get derived :work-count)))
                  propagated (if (= :accepted (get handler-check :status))
                               (body-tc-verify core facts bindings (get derived :nodes) throws
                                 (- budget (get handlers :work-count) (get throws :work-count) (get derived :work-count) (get handler-check :work-count))) handler-check)
                  graph (let [graph (body-build-graph core facts (get derived :nodes))
                          graph (if loop? (assoc graph :loop-fixed-point
                                  {:algorithm :bottom-initialized-bounded-effect-union
                                   :round-count (get derived :fixed-point-rounds) :equations :checked
                                   :recur-transfers (get core :recur-transfers)}) graph)]
                      (if (contains? facts :recursive-proof)
                        (assoc graph :recursive-fixed-point {:algorithm :bottom-initialized-bounded-effect-union
                          :round-count (get derived :fixed-point-rounds) :equations :checked
                          :recursive-call-core-node-id (get (get facts :recursive-proof) :recursive-call-core-node-id)}) graph))
                  graph (loop [ids (keys (get propagated :functions)) out graph]
                          (if (= 0 (count ids)) out
                            (recur (rest ids)
                              (assoc out :functions (assoc (get out :functions) (first ids)
                                (assoc (get (get out :functions) (first ids)) :throws (get (get propagated :functions) (first ids))))))))
                  allowed (if (= :accepted (get propagated :status))
                            (body-allowance-check core facts graph
                              (- budget (get handlers :work-count) (get throws :work-count) (get derived :work-count)
                                        (get handler-check :work-count) (get propagated :work-count))) propagated)]
              (if (= :accepted (get allowed :status))
                {:status :accepted :graph graph :work-count (+ source-work (get handlers :work-count) (get handler-check :work-count) (get throws :work-count) (get derived :work-count)
                                                             (get propagated :work-count) (get allowed :work-count))} allowed)) derived))
        (body-failure :incoherent-function-or-call-body-type-origin-join))
      (if (= :accepted (get returns :status))
        (assoc joins :work-count source-work)
        (if (= :accepted (get successors :status))
          (assoc returns :work-count (+ prior-source-work (get returns :work-count 0))) returns))))
      (body-failure :incomplete-canonical-core-coverage))))

(defn body-analyze-producers [entries]
  (loop [remaining entries bank {} work 0]
    (if (= 0 (count remaining)) {:status :accepted :bank bank :work-count work}
      (let [entry (first remaining)
            analyzed (body-analyze-module (get entry :request) (get entry :facts) {} (- 65536 work))]
        (if (= :accepted (get analyzed :status))
          (recur (rest remaining) (assoc bank (get entry :module-key) (assoc entry :graph (get analyzed :graph)))
                 (+ work (get analyzed :work-count)))
          (assoc analyzed :producer-module (get entry :module-key) :producer-facts (get entry :facts)))))))

(defn body-foreign-bindings [request facts bank]
  (let [bindings (body-index (body-path request [:b47-context :authenticated-core-request :binding-table]) :binding-id)]
    (loop [remaining (get facts :imported-function-types) foreign {} used #{}]
      (if (= 0 (count remaining))
        (if (= (count used) (count bank)) {:status :accepted :foreign foreign}
          (body-failure :unused-body-producer))
        (let [proof (first remaining) id (get proof :binding-id)
              key [(get proof :producer-sh06-artifact-id) (get proof :producer-sh07-artifact-id)]
              entry (get bank key) joined (body-import-origin request (get bindings id) entry proof)
              summary (get (get (get entry :graph) :functions) (get (get proof :function-type) :function-id))]
          (if (if (contains? foreign id) false (body-all? [(map? joined) (map? summary)
                 (= (get joined :body-core-node-id) (get summary :body-core-node-id))
                 (= (get (get joined :function) :function-id) (get summary :function-id))
                 (set? (get summary :inferred)) (= [:pending-sh09] (get summary :throws))]))
            (recur (rest remaining) (assoc foreign id (assoc joined :summary summary)) (conj used key))
            (body-failure :imported-body-origin-or-summary-mismatch)))))))

(defn body-producer-graph-identities [bank]
  (loop [keys (keys bank) result {}]
    (if (= 0 (count keys)) result
      (let [key (first keys) entry (get bank key)]
        (recur (rest keys)
          (assoc result key {:canonical-core-identity-input (body-path entry [:request :canonical-core-artifact :identity-preimage])
                             :sh08-identity-input (get entry :facts) :effect-graph (get entry :graph)}))))))

(defn body-accepted-result [typed binding core graph bank foreign]
  (let [imported? (body-imported? typed)
        scope (if imported? :direct-imported-body-effects-with-thrown-effects-pending
                (if (body-higher-order? typed) :capture-free-one-hop-body-effects-with-thrown-effects-pending
                  (if (body-recursive? typed) :bounded-self-recursive-body-effects-with-thrown-effects-pending
                    :local-first-order-body-effects-with-thrown-effects-pending)))
        producer-graphs (body-producer-graph-identities bank)
        dependencies (loop [ids (keys foreign) result {}]
                       (if (= 0 (count ids)) result
                         (let [id (first ids) target (get foreign id)]
                           (recur (rest ids) (assoc result id (assoc (get target :coordinate) :body-core-node-id (get target :body-core-node-id)))))))
        identity {:domain (if imported? :gravity/sh09-direct-imported-body-effects-v1
                            (if (body-higher-order? typed) :gravity/sh09-capture-free-one-hop-body-effects-v1
                              (if (body-recursive? typed) :gravity/sh09-bounded-self-recursive-body-effects-v1 :gravity/sh09-local-body-effects-v1)))
                  :canonical-core-identity-input (get core :identity-preimage)
                  :sh08-identity-input (get typed :identity-input) :effect-graph graph :scope scope :pending (body-effect-pending)}
        identity (if imported? (assoc identity :producer-effect-graphs producer-graphs :imported-body-dependencies dependencies) identity)
        result {:artifact :gravity/sh09-authenticated-effected-core-template :schema-version 1 :status :accepted
                :scope scope :authentication-status :host-resolved-sh08-function-binding
                :upstream-binding (body-project binding [:artifact :schema-version :boundary :status])
                :sh08-shaped-artifact-id (get typed :sh07-shaped-artifact-id) :module (get typed :module)
                :typed-core (get typed :typed-core) :type-table (get typed :type-table)
                :function-type-table (get typed :function-type-table) :local-binding-facts (get typed :local-binding-facts)
                :call-type-facts (get typed :call-type-facts) :effect-graph graph :identity-input identity
                :identity-resolution :coordinator-digest-required :diagnostics [] :pending (body-effect-pending)
                :provenance (get typed :provenance) :self-hosted? false :clojure-seed-boundary? true}]
    (if imported? (assoc result :producer-effect-graphs producer-graphs :imported-body-dependencies dependencies) result)))

(defn build-body-effect-result [typed verification binding]
  (if (body-input-valid? typed verification binding)
    (let [request (body-path binding [:digest-resolution :preimage :request])
          core (get request :canonical-core-artifact) facts (get typed :identity-input)
          producers (body-producer-entries request facts)]
      (if (= :accepted (get producers :status))
        (if (body-aggregate-valid? core facts (get producers :entries))
          (let [derived (body-analyze-producers (get producers :entries))]
            (if (= :accepted (get derived :status))
              (let [imports (body-foreign-bindings request facts (get derived :bank))]
                (if (= :accepted (get imports :status))
                  (let [caller (body-analyze-module request facts (get imports :foreign) (- 65536 (get derived :work-count)))]
                    (if (= :accepted (get caller :status))
                      (body-accepted-result typed binding core (get caller :graph) (get derived :bank) (get imports :foreign))
                      (body-error-result typed caller)))
                  (body-error typed (get imports :reason) {})))
              (assoc (body-error-result (get derived :producer-facts typed) derived)
                     :producer-module (get derived :producer-module))))
          (body-error typed :aggregate-body-node-or-function-limit {}))
        (body-error typed (get producers :reason) {})))
    (body-error typed (if (body-imported? typed) :imported-body-effects-pending :untrusted-sh08-body-effect-input) {})))

(defn verify-body-effect-result [typed verification binding candidate]
  (let [expected (build-body-effect-result typed verification binding)]
    {:artifact :gravity/sh09-authenticated-body-effect-result-verification
     :status (if (= expected candidate) :passed :rejected)
     :checks [:fresh-sh08-binding :complete-canonical-node-coverage :local-call-body-propagation
              :construction-versus-latent-effects :conditional-guard-coverage :exact-derived-graph
              :preserved-declarations-and-pending-throws :whole-core-and-graph-identity]
     :expected expected :candidate candidate}))

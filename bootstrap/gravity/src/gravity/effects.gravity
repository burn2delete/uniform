(defn body-bka-entry? [node call nodes bindings types module]
  ; Routing only. Neither the bare Set nor an empty anchor establishes a domain.
  (if (if (map? call) (if (vector? (get call :argument-node-ids)) (= 2 (count (get call :argument-node-ids))) false) false)
    (if (body-sse-ids? [(get call :operator-binding-id)] 1)

               (if (body-all? [(= (get owner :form-id) (get form :parent-form-id))
                     (= (get child :source) (get (body-ma-form-node {} form) :source))
                     (if (= i 0) (= (get form :value) (get (get child :attributes) :symbol)) true)])
                 (recur (+ i 1)) false))))
         (= (body-st-call-fact descriptor (get core :module)) (body-by (get facts :call-type-facts) :call-core-node-id (get node :node-id)))
         (= [(body-st-constraint descriptor)] rows)]) false)) false) false)))

(defn body-st-node? [node facts core]
  (let [context (get facts :set-conversion-context) id (get node :node-id)]
    (if (map? context)

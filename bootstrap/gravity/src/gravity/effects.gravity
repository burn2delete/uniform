                  {:literal-kind :vector,
                   :element-count n,
                   :source-value source-values}
                  attrs)
                 (= :left-to-right (get (get right :evaluation) :kind))
                 (=
                  (loop
                   [i 0 out []]
                   (if
                    (= i n)
                    out
                    (recur
                     (+ i 1)
                     (conj
                      out
                      {:index i, :core-node-id (get ids i)}))))
                  (get (get right :evaluation) :order))])
               (loop
                [i
                 0
                 selected
                 (loop
                  [remaining
                   (if conditional? (get container :source-forms) [])
                   out
                   [owner op-form right-form]]
                  (if
                   (= 0 (count remaining))
                   out
                   (recur
                    (rest remaining)
                    (conj out (first remaining)))))
                 members
                 []
                 seen
                 #{}
                 seen-forms
                 #{(get right-form :form-id)}]
                (if
                 (= i n)
                 (let
                  [expected
                   {:kind :gravity.type/vector,
                    :shape :literal,
                    :element-types members}
                   actual
                   (get
                    types
                    (get right :node-id)
                    :gravity.type/unknown)]
                  (if
                   (if
                    (= :gravity.type/unknown actual)
                    true
                    (= expected actual))
                   {:status :accepted,
                    :node (if conditional? root node),
                    :form
                    (if conditional? (get container :form) owner),
                    :source-forms selected,
                    :proof
                    (let
                     [proof
                      {:kind :direct-left-vector-equality,
                       :node node,
                       :operator operator,
                       :binding binding,
                       :right right,
                       :literal-type expected,
                       :source-forms selected}]
                     (if
                      conditional?
                      (assoc
                       proof
                       :condition-container
                       (get container :proof))
                      proof))}
                   {:status :rejected,
                    :reason :vector-slice-source-mismatch}))
                 (let
                  [id
                   (get ids i)
                   child
                   (get nodes id)
                   source
                   (get child :source)]
                  (if
                   (if
                    (body-sse-ids?
                     [id (get source :form-id) (get source :syntax-id)]
                     3)
                    (if
                     (= false (contains? seen id))
                     (=
                      false
                      (contains? seen-forms (get source :form-id)))
                     false)
                    false)
                   (let
                    [form
                     (get forms (get source :form-id))
                     value
                     (get (get child :attributes) :value)
                     kind
                     (get (get child :attributes) :literal-kind)
                     valid?
                     (if
                      (body-sse-ids?
                       [(get form :form-id)
                        (get form :syntax-id)
                        (get form :parent-form-id)
                        (get form :scope-id)]
                       4)
                      (if
                       (= :integer kind)
                       (if
                        (integer? value)
                        (if
                         (integer? (get form :value))
                         (if
                          (integer? (get values i))
                          (integer? (get source-values i))
                          false)
                         false)
                        false)
                       (if
                        (= :character kind)
                        (if
                         (char? value)
                         (if
                          (char? (get form :value))
                          (if
                           (char? (get values i))
                           (char? (get source-values i))
                           false)
                          false)
                         false)
                        false))
                      false)]
                    (if
                     (if
                      valid?
                      (body-all?
                       [(= id (get child :node-id))
                        (=
                         (get (get right-form :child-form-ids) i)
                         (get form :form-id))
                        (= :literal (get child :core-form))
                        (=
                         {:literal-kind kind, :value value}
                         (get child :attributes))
                        (=
                         []
                         (get child :children)
                         (get child :resolved-binding-ids)
                         (get form :child-form-ids))
                        (= kind (get form :kind))
                        (= source (body-ix-form-source form))
                        (=
                         value
                         (get form :value)
                         (get values i)
                         (get source-values i))
                        (=
                         (get right-form :form-id)
                         (get form :parent-form-id))
                        (= scope (get form :scope-id))
                        (= :value (get (get child :evaluation) :kind))
                        (= [] (get (get child :evaluation) :order))])
                      false)
                     (recur
                      (+ i 1)
                      (conj selected form)
                      (conj
                       members
                       (if
                        (= :integer kind)
                        :gravity.type/integer
                        :gravity.type/character))
                      (conj seen id)
                      (conj seen-forms (get source :form-id)))
                     {:status :rejected,
                      :reason :vector-slice-source-mismatch}))
                   {:status :rejected,
                    :reason :vector-slice-source-mismatch}))))
               {:status :rejected,
                :reason :vector-slice-source-mismatch})
              {:status :rejected,
               :reason :vector-slice-source-mismatch}))
            {:status :rejected,
             :reason :vector-slice-source-mismatch}))
          {:status :rejected, :reason :vector-slice-source-mismatch})
         container))))))
   {:status :rejected, :reason :vector-slice-source-mismatch})))

(defn
 body-vsl-let
 [core slice-node reference nodes bindings types forms]
 (let
  [records
   (get core :lexical-bindings [])
   mutations
   (get core :mutations [])
   bid
   (get (get reference :attributes) :binding-id)]
  (if
   (if
    (if (vector? records) (vector? mutations) false)
    (if
     (body-sse-ids?
      [(get reference :node-id)
       (get (get reference :source) :form-id)
       (get (get reference :source) :syntax-id)
       bid
       (get slice-node :node-id)]
      5)
     (body-sse-ids?
      [(get (get slice-node :source) :form-id)
       (get (get slice-node :source) :syntax-id)]
      2)
     false)
    false)
   (if
    (if
     (loop
      [rows records]
      (if
       (= 0 (count rows))
       true
       (if
        (body-sse-ids?
         [(get (first rows) :binding-id)
          (get (first rows) :let-core-node-id)]
         2)
        (recur (rest rows))
        false)))
     (loop
      [rows mutations]
      (if
       (= 0 (count rows))
       true
       (if
        (= nil (get (first rows) :target-binding-id))
        (recur (rest rows))
        (if
         (body-sse-ids? [(get (first rows) :target-binding-id)] 1)
         (recur (rest rows))
         false))))
     false)
    (let
     [record (body-nq-one records :binding-id bid)]
     (if
      (map? record)
      (if
       (if
        (body-sse-ids?
         [(get record :let-core-node-id)
          (get record :initializer-node-id)
          (get record :definition-form-id)
          (get record :definition-syntax-id)
          (get record :initializer-form-id)
          (get record :initializer-syntax-id)]
         6)
        (body-sse-ids?
         [(get record :binding-scope-id)
          (get record :initializer-scope-id)]
         2)
        false)
       (let
        [let-node
         (get nodes (get record :let-core-node-id))
         initializer
         (get nodes (get record :initializer-node-id))
         binding
         (get bindings bid)
         ref-form
         (get forms (get (get reference :source) :form-id))
         slice-form
         (get forms (get (get slice-node :source) :form-id))
         name-form
         (get forms (get record :definition-form-id))
         init-form
         (get forms (get record :initializer-form-id))]
        (if
         (if
          (body-sse-ids?
           [(get (get let-node :source) :form-id)
            (get (get let-node :source) :syntax-id)
            (get (get let-node :attributes) :binding-vector-form-id)
            (get (get let-node :attributes) :binding-vector-syntax-id)
            (get binding :definition-syntax-id)]
           5)
          (if
           (body-sse-ids?
            [(get let-node :node-id)
             (get initializer :node-id)
             (get binding :binding-id)]
            3)
           (symbol? (get binding :name))
           false)
          false)
         (let
          [let-form
           (get forms (get (get let-node :source) :form-id))
           vector-form
           (get
            forms
            (get (get let-node :attributes) :binding-vector-form-id))
           bridge
           (if
            (=
             (get slice-node :node-id)
             (get (get let-node :children) 1))
            {:status :accepted,
             :node slice-node,
             :form slice-form,
             :source-forms []}
            (body-vsl-let-equality-body
             core
             let-node
             slice-node
             nodes
             bindings
             types
             forms))
           root-node
           (get bridge :node)
           root-form
           (get bridge :form)]
          (if
           (= :accepted (get bridge :status))
           (if
            (body-all?
             [(body-sse-ids?
               [(get ref-form :form-id)
                (get ref-form :syntax-id)
                (get name-form :form-id)
                (get name-form :syntax-id)
                (get init-form :form-id)
                (get init-form :syntax-id)]
               6)
              (body-sse-ids?
               [(get slice-form :form-id)
                (get slice-form :syntax-id)
                (get let-form :form-id)
                (get let-form :syntax-id)
                (get vector-form :form-id)
                (get vector-form :syntax-id)]
               6)])
            (if
             (if
              (body-sse-ids? (get let-form :child-form-ids) 3)
              (if
               (body-sse-ids? (get vector-form :child-form-ids) 2)
               (if
                (body-sse-ids?
                 [(get ref-form :scope-id)
                  (get name-form :scope-id)
                  (get slice-form :scope-id)
                  (get init-form :scope-id)
                  (get let-form :scope-id)
                  (get binding :scope-id)]
                 6)
                (body-sse-ids?
                 [(get (get let-node :attributes) :outer-scope-id)
                  (get (get let-node :attributes) :body-scope-id)
                  (get reference :binding-context)
                  (get initializer :binding-context)
                  (get let-node :binding-context)
                  (get slice-node :binding-context)]
                 6)
                false)
               false)
              false)
             (let
              [op-form
               (get forms (get (get let-form :child-form-ids) 0))
               body
               (get record :binding-scope-id)
               outer
               (get record :initializer-scope-id)
               bound-forms
               (loop
                [remaining
                 (get bridge :source-forms)
                 out
                 [ref-form let-form op-form vector-form name-form]]
                (if
                 (= 0 (count remaining))
                 out
                 (recur
                  (rest remaining)
                  (conj out (first remaining)))))]
              (if
               (body-all?
                [(body-sse-ids?
                  [(get op-form :form-id) (get op-form :syntax-id)]
                  2)
                 (symbol? (get op-form :value))
                 (symbol? (get ref-form :value))
                 (symbol? (get name-form :value))
                 (symbol? (get record :name))
                 (symbol? (get (get reference :attributes) :symbol))])
               (if
                (body-all?
                 [(=
                   [:lexical :local]
                   [(get binding :binding-class) (get binding :kind)])
                  (= bid (get binding :binding-id))
                  (if
                   (= nil (get binding :mutability))
                   true
                   (= :immutable (get binding :mutability)))
                  (= :reference (get reference :core-form))
                  (= [] (get reference :children))
                  (= [bid] (get reference :resolved-binding-ids))
                  (=
                   {:symbol (get binding :name),
                    :position :expression,
                    :binding-id bid,
                    :binding-class :lexical,
                    :definition-syntax-id
                    (get binding :definition-syntax-id)}
                   (get reference :attributes))
                  (=
                   :symbol
                   (get ref-form :kind)
                   (get name-form :kind))
                  (=
                   (get binding :name)
                   (get ref-form :value)
                   (get name-form :value)
                   (get record :name))
                  (=
                   []
                   (get ref-form :child-form-ids)
                   (get name-form :child-form-ids))
                  (=
                   (get reference :source)
                   (body-ix-form-source ref-form))
                  (=
                   (get slice-node :source)
                   (body-ix-form-source slice-form))
                  (=
                   (get let-node :source)
                   (body-ix-form-source let-form))
                  (=
                   (get initializer :source)
                   (body-ix-form-source init-form))
                  (=
                   (get root-node :node-id)
                   (get (get let-node :children) 1))
                  (=
                   [(get initializer :node-id)
                    (get root-node :node-id)]
                   (get let-node :children))
                  (= [bid] (get let-node :resolved-binding-ids))
                  (= :let (get let-node :core-form))
                  (=
                   {:binding-count 1,
                    :binding-vector-syntax-id
                    (get vector-form :syntax-id),
                    :result-policy {:kind :last-body, :child-index 1},
                    :body-scope-id body,
                    :evaluation-order
                    :initializers-then-body-left-to-right,
                    :outer-scope-id outer,
                    :body-child-indexes [1],
                    :binding-vector-form-id (get vector-form :form-id),
                    :initializer-child-indexes [0],
                    :body-count 1}
                   (get let-node :attributes))
                  (=
                   :initializers-then-body-left-to-right
                   (get (get let-node :evaluation) :kind))
                  (=
                   [{:index 0,
                     :core-node-id (get initializer :node-id)}
                    {:index 1, :core-node-id (get root-node :node-id)}]
                   (get (get let-node :evaluation) :order))
                  (= :list (get let-form :kind))
                  (=
                   [(get op-form :form-id)
                    (get vector-form :form-id)
                    (get root-form :form-id)]
                   (get let-form :child-form-ids))
                  (= :symbol (get op-form :kind))
                  (= 'let (get op-form :value))
                  (= [] (get op-form :child-form-ids))
                  (=
                   (get let-form :form-id)
                   (get op-form :parent-form-id)
                   (get vector-form :parent-form-id)
                   (get root-form :parent-form-id))
                  (=
                   (if
                    (=
                     (get root-node :node-id)
                     (get slice-node :node-id))
                    (get let-form :form-id)
                    (get
                     (get (get (get bridge :proof) :node) :source)
                     :form-id))
                   (get slice-form :parent-form-id))
                  (= :vector (get vector-form :kind))
                  (=
                   [(get name-form :form-id) (get init-form :form-id)]
                   (get vector-form :child-form-ids))
                  (=
                   (get vector-form :form-id)
                   (get name-form :parent-form-id)
                   (get init-form :parent-form-id))
                  (=
                   (get slice-form :form-id)
                   (get ref-form :parent-form-id))
                  (=
                   outer
                   (get let-form :scope-id)
                   (get init-form :scope-id)
                   (get (get let-node :attributes) :outer-scope-id)
                   (get let-node :binding-context)
                   (get initializer :binding-context))
                  (=
                   body
                   (get binding :scope-id)
                   (get ref-form :scope-id)
                   (get name-form :scope-id)
                   (get slice-form :scope-id)
                   (get reference :binding-context)
                   (get slice-node :binding-context)
                   (get (get let-node :attributes) :body-scope-id))
                  (=
                   (get binding :definition-syntax-id)
                   (get record :definition-syntax-id)
                   (get name-form :syntax-id))
                  (=
                   {:mutability :immutable,
                    :let-core-node-id (get let-node :node-id),
                    :name (get binding :name),
                    :visible-prior-binding-ids [],
                    :definition-form-id (get name-form :form-id),
                    :initializer-node-id (get initializer :node-id),
                    :ordinal 0,
                    :initializer-scope-id outer,
                    :initializer-syntax-id (get init-form :syntax-id),
                    :binding-id bid,
                    :initializer-form-id (get init-form :form-id),
                    :binding-scope-id body,
                    :definition-syntax-id (get name-form :syntax-id)}
                   record)
                  (=
                   record
                   (body-nq-one
                    records
                    :let-core-node-id
                    (get let-node :node-id)))
                  (loop
                   [rows mutations]
                   (if
                    (= 0 (count rows))
                    true
                    (if
                     (= bid (get (first rows) :target-binding-id))
                     false
                     (recur (rest rows)))))])
                (let
                 [origin
                  (body-vsl-receiver
                   core
                   initializer
                   nodes
                   bindings
                   types
                   forms)
                  members
                  (get (get origin :type) :element-types)]
                 (if
                  (= :accepted (get origin :status))
                  (if
                   (if
                    (vector? members)
                    (=
                     (get origin :type)
                     (get types (get reference :node-id)))
                    false)
                   {:status :accepted,
                    :type (get origin :type),
                    :source-forms
                    (loop
                     [remaining
                      (get origin :source-forms)
                      out
                      bound-forms]
                     (if
                      (= 0 (count remaining))
                      out
                      (recur
                       (rest remaining)
                       (conj out (first remaining))))),
                    :receiver
                    (if
                     (contains? bridge :proof)
                     (assoc
                      {:kind :immutable-let-vector,
                       :reference reference,
                       :binding binding,
                       :record record,
                       :owner let-node,
                       :source-forms bound-forms,
                       :origin (get origin :receiver)}
                      :body-consumer
                      (get bridge :proof))
                     {:kind :immutable-let-vector,
                      :reference reference,
                      :binding binding,
                      :record record,
                      :owner let-node,
                      :source-forms bound-forms,
                      :origin (get origin :receiver)})}
                   {:status :rejected,
                    :reason :vector-slice-receiver-proof-required})
                  origin))
                {:status :rejected,
                 :reason :vector-slice-source-mismatch})
               {:status :rejected,
                :reason :vector-slice-source-mismatch}))
             {:status :rejected,
              :reason :vector-slice-source-mismatch})
            {:status :rejected, :reason :vector-slice-source-mismatch})
           bridge))
         {:status :rejected, :reason :vector-slice-source-mismatch}))
       {:status :rejected, :reason :vector-slice-source-mismatch})
      {:status :rejected,

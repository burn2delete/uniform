                     (= expected (get types id)) (= :immutable (get record :mutability))
                     (= record (body-si-record (get core :lexical-bindings) :binding-id bid))])
                (recur (get record :initializer-node-id) (- index 1)) false)))) false) false)))

(defn body-si-step-source-valid? [record header nodes]
  (if (if (map? record) (map? header) false)

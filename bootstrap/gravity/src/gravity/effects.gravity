(defn body-bka-originals [rows field target]
  (if (vector? rows)
    (loop [index 0 items [] table {}]
      (if (= index (count rows)) {:status :accepted :items items :index table}
        (let [row (get rows index) id (if (map? row) (get row field) nil)]
          (if (body-sse-ids? [id] 1)
            (if (contains? table id) {:status :rejected}
              (recur (+ index 1) (if (= target id) (conj items row) items) (assoc table id row)))
            {:status :rejected})))) {:status :rejected}))

(defn body-bka-row-census [core ledger nodes bindings types calls edges target descriptor]
  (loop [index 0 items [] seen #{} descriptors {}]
    (if (= index (count ledger)) {:status :accepted :items items :descriptors descriptors}
      (let [row (get ledger index) producer (if (map? row) (get row :producer-rule) nil)]
        (if (keyword? producer)
          (if (= :sh08-bare-keyword-anchor-set-equality-v1 producer)
            (let [lhs (get row :lhs) id (if (map? lhs) (get lhs :core-node-id) nil)]
              (if (body-sse-ids? [id] 1)
                (if (contains? seen id) {:status :rejected :reason :bare-keyword-anchor-set-equality-source-mismatch}
                  (let [source-call (get calls id) source-edge (get edges id) source-node (get nodes id)
                        result (if (= target id)
                                 {:status :accepted, :descriptor descriptor}
                                 (body-bka-header core source-node source-call source-edge nodes bindings types (get core :module)))
                        canonical (get result :descriptor)]
                    (if (= :accepted (get result :status))
                      (if (if (body-bka-ids? source-node source-call nodes bindings (get core :module))
                            (if (= canonical (get types (get source-call :operator-node-id)))
                              (= (body-bka-constraint canonical) row) false) false)
                        (recur (+ index 1) (if (= target id) (conj items row) items)
                               (conj seen id) (assoc descriptors id canonical))
                        {:status :rejected :reason :bare-keyword-anchor-set-equality-source-mismatch})
                      {:status :rejected :reason (get result :reason)})))
                {:status :rejected :reason :bare-keyword-anchor-set-equality-source-mismatch}))
            (recur (+ index 1) items seen descriptors))
          {:status :rejected :reason :bare-keyword-anchor-set-equality-source-mismatch})))))

(defn body-bka-fact-census [facts module descriptors target]
  (loop [remaining (if (map? facts) (keys facts) facts) index 0 items [] seen #{}]
    (if (= index (count facts))
      (if (= (set (keys descriptors)) seen) {:status :accepted :items items}
        {:status :rejected :reason :bare-keyword-anchor-set-equality-source-mismatch})
      (let [entry (first remaining) fact (if (map? facts) (if (body-sse-ids? [entry] 1) (get facts entry) nil) entry)
            id (if (map? fact) (get fact :call-core-node-id) nil)
            dispatch (if (map? fact) (get fact :dispatch) nil)]
        (if (if (body-sse-ids? [id] 1) (if (map? facts) (= entry id) true) false)
          (if (keyword? dispatch)
            (if (= :direct-bare-keyword-anchor-set-equality dispatch)
              (if (contains? seen id) {:status :rejected :reason :bare-keyword-anchor-set-equality-source-mismatch}
                (let [canonical (get descriptors id)]
                  (if (if (map? canonical) (= (body-bka-call-fact canonical module) fact) false)
                    (recur (rest remaining) (+ index 1) (if (= target id) (conj items fact) items) (conj seen id))
                    {:status :rejected :reason :bare-keyword-anchor-set-equality-source-mismatch})))
              (recur (rest remaining) (+ index 1) items seen))
            {:status :rejected :reason :bare-keyword-anchor-set-equality-source-mismatch})
          {:status :rejected :reason :bare-keyword-anchor-set-equality-source-mismatch})))))

(defn body-bka-evidence [core ledger facts node call edge nodes bindings types]
  (if (if (vector? ledger) (if (if (vector? facts) true (map? facts))
                          (if (vector? (get core :calls)) (vector? (get core :call-edges)) false) false) false)
    (let [derived (body-bka-header core node call edge nodes bindings types (get core :module))]
      (if (= :accepted (get derived :status))
        (let [id (get node :node-id) descriptor (get derived :descriptor)
              original-calls (body-bka-originals (get core :calls) :core-node-id id)
              original-edges (body-bka-originals (get core :call-edges) :call-core-node-id id)]
          (if (body-all? [(= :accepted (get original-calls :status)) (= :accepted (get original-edges :status))
                                 (= [call] (get original-calls :items)) (= [edge] (get original-edges :items))])
            (let [rows (body-bka-row-census core ledger nodes bindings types (get original-calls :index) (get original-edges :index)
                         id descriptor)]
              (if (= :accepted (get rows :status))
                (let [calls (body-bka-fact-census facts (get core :module) (get rows :descriptors) id)]
                  (if (if (= :accepted (get calls :status))

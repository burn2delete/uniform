                  (get
                   (get slice-node :evaluation)
                   :owner-function-syntax-id))
                 (= :list (get owner :kind))
                 (= :symbol (get op-form :kind))
                 (symbol? (get op-form :value))
                 (=
                  (get (get operator :attributes) :symbol)
                  (get op-form :value))
                 (= [] (get op-form :child-form-ids))
                 (=
                  [(get op-form :form-id)
                   (get (get slice-node :source) :form-id)

             (= :accepted (get edge-index :status))])
           (let
            [nodes
             (get node-index :index)
             indexed-forms
             (get form-index :index)]
            (loop
             [remaining
              (get core :calls)
              checks
              {}
              keyword-checks
              {}
              list-checks
              {}]
             (if
              (= 0 (count remaining))
              (let
               [context
                {:forms indexed-forms,
                 :nodes nodes,
                 :calls (get call-index :index),
                 :edges (get edge-index :index),
                 :bindings bindings}]
               {:status :accepted,
                :context
                (let
                 [context
                  (if
                   (= 0 (count checks))
                   context
                   (assoc context :vector-domains checks))]
                 (let
                  [context
                   (if
                    (= 0 (count keyword-checks))
                    context
                    (assoc
                     context
                     :keyword-set-domains
                     keyword-checks))]
                  (if
                   (= 0 (count list-checks))
                   context
                   (assoc context :list-domains list-checks))))})
              (let
               [call
                (first remaining)
                args
                (get call :argument-node-ids)]
               (if
                (body-bka-source-hint?
                 (get bindings (get call :operator-binding-id)))
                (let
                 [node (get nodes (get call :core-node-id))]
                 (if
                  (body-bka-entry?
                   node
                   call
                   nodes
                   bindings
                   (get facts :type-table)
                   (get core :module))
                  (let
                   [result
                    (body-bka-evidence
                     core
                     (get facts :constraint-ledger)
                     (get facts :call-type-facts)
                     node
                     call
                     (get
                      (get edge-index :index)
                      (get call :core-node-id))
                     nodes
                     bindings
                     (get facts :type-table))]
                   (if
                    (= :accepted (get result :status))
                    (recur
                     (rest remaining)
                     checks
                     (assoc
                      keyword-checks
                      (get call :core-node-id)
                      result)
                     list-checks)
                    (body-failure
                     (if
                      (body-sse-call-ids? node call)
                      :body-bare-keyword-anchor-set-equality-source-mismatch
                      :body-equality-binary-call-required))))
                  (if

(defn body-vsl-receiver [core node nodes bindings types forms]
  (let [calls (get core :calls) edges (get core :call-edges)]
    (if (if (vector? calls) (vector? edges) false)
      (let [ids-valid?
            (if (body-sse-ids? [(get node :node-id)] 1)

     :call-core-node-id (get descriptor :call-core-node-id) :caller-function-syntax-id (get edge :caller-function-syntax-id)
     :callee-function-syntax-id nil :argument-types (get descriptor :argument-types) :result-type (get descriptor :result-type)
     :evaluation-order :operator-then-arguments :source-span (get source :semantic-span) :syntax-id (get source :syntax-id)
     :origin-chain (get source :origin-chain) :generated-origin (get source :generated-origin)
     :profile (get module :profile) :target (get module :target) :effects (get descriptor :direct-effects) :capabilities [] :status :inferred
     :dispatch :direct-vector-append :applied-vector-append descriptor :effect-facts-source :audited-collection-intrinsic}))


(defn body-va-finish [header]
  (let [arguments (get header :argument-types)
        type (if (= :normal (get header :application))
               (assoc (first arguments) :element-types (conj (get (first arguments) :element-types) (get arguments 1))) :gravity.type/never)]
    (assoc header :parameter-types (get header :argument-types) :return type :result-type type)))

(defn body-pl-list? [type]
  (if (= :gravity.type/list type) true
    (if (map? type) (= :gravity.type/list (get type :kind)) false)))

(defn body-pl-type-work [arguments budget]
  (if (= 2 (count arguments))
    (let [checked (body-lc-type-work arguments budget) used (get checked :work-count)]
      (if (= :accepted (get checked :status))
        (let [receiver (first arguments) value (get arguments 1) invoked? (= false (= :gravity.type/never value))
              homogeneous? (body-hl-type? receiver) positional? (= :literal (get receiver :shape))
              elements (get receiver :element-types) width (if (vector? elements) (count elements) 0)
              construction (if (if invoked? positional? false) (+ 1 width) 0)
              work (+ used construction)]
          (if (= false (body-pl-list? receiver))
            {:status :rejected :reason :list-prepend-list-type-required :work-count used}
            (if (if homogeneous? (if invoked? (= false (= value (get receiver :element-type))) false) false)
              {:status :rejected :reason :list-prepend-element-type-mismatch :work-count used}
              (if (if positional? (if invoked? (>= width 1024) false) false)
                {:status :rejected :reason :list-prepend-type-width-limit :work-count used}
                (if (> work budget)
                  {:status :rejected :reason :list-prepend-work-limit :work-count work}
                  (let [result (if (= false invoked?) :gravity.type/never
                                 (if positional?
                                   {:kind :gravity.type/list :shape :literal
                                    :element-types (loop [remaining elements out [value]]
                                                     (if (= 0 (count remaining)) out
                                                       (recur (rest remaining) (conj out (first remaining)))))}
                                   receiver))
                        validation (body-lc-type-work [result] (- budget work))
                        total (+ work (get validation :work-count))]
                    (if (= :accepted (get validation :status))
                      {:status :accepted :work-count total :operand-work used :result-work (get validation :work-count)
                       :construction-work construction :result-type result}
                      {:status :rejected :reason (if (= :work-limit (get validation :reason)) :list-prepend-work-limit :list-prepend-result-type-required)
                       :type-check-reason (get validation :reason) :work-count total})))))))
        {:status :rejected :reason (if (= :work-limit (get checked :reason)) :list-prepend-work-limit :list-prepend-operand-type-required)
         :type-check-reason (get checked :reason) :work-count used}))
    {:status :rejected :reason :list-prepend-arity-mismatch :work-count 0}))

(defn body-pl-source [core node call edge nodes bindings types module validation]
  (if (if (vector? (get call :argument-node-ids))
        (if (= 2 (count (get call :argument-node-ids)))
          (if (vector? (get node :children)) (= 3 (count (get node :children))) false) false) false)
  (let [children (get node :children) operator (get nodes (get call :operator-node-id))
        bid (get call :operator-binding-id) binding (get bindings bid) args (get call :argument-node-ids)
        arguments (body-io-child-types args types)
        invoked? (loop [remaining arguments]
                   (if (= 0 (count remaining)) true
                     (if (= :gravity.type/never (first remaining)) false (recur (rest remaining)))))
        caller (loop [remaining (get core :function-records)]
                 (if (= 0 (count remaining)) nil
                   (if (= (get (first remaining) :function-syntax-id) (get (get node :evaluation) :owner-function-syntax-id))
                     (first remaining) (recur (rest remaining)))))
        expected-call {:core-node-id (get node :node-id) :operator-node-id (first children) :operator-binding-id bid
                       :argument-node-ids (vec (rest children)) :ordered-evaluation-node-ids children
                       :evaluation-order :operator-then-arguments :result-policy :call-result}
        expected-edge {:ordinal (get edge :ordinal) :call-core-node-id (get node :node-id)
                       :caller-function-syntax-id (get caller :function-syntax-id) :caller-function-core-node-id (get caller :function-core-node-id)
                       :callee-binding-id bid :callee-definition-syntax-id (get binding :definition-syntax-id)
                       :callee-function-syntax-id nil :callee-function-core-node-id nil :argument-core-node-ids args
                       :ordered-evaluation-node-ids children :evaluation-order :operator-then-arguments :classification :nonlocal-or-nonfunction}]
    (if (body-all?
          [(= :call (get node :core-form)) (= :reference (get operator :core-form))
           (= 2 (count args)) (= expected-call call) (= expected-edge edge) (body-va-binding? binding module)
           (= [bid] (get node :resolved-binding-ids) (get operator :resolved-binding-ids))
           (= {:symbol (get (get operator :attributes) :symbol) :position :operator :binding-id bid :binding-class :core
               :definition-syntax-id (get binding :definition-syntax-id)} (get operator :attributes))
           (contains? '#{conj gravity.core/conj} (get (get operator :attributes) :symbol))
           (= :operator-then-arguments (get (get node :evaluation) :kind))
           (= (loop [i 0 out []] (if (= i (count children)) out
                (recur (+ i 1) (conj out {:index i :core-node-id (get children i)})))) (get (get node :evaluation) :order))
           (= :accepted (get validation :status))] )
      {:kind :gravity.type/applied-list-prepend :version :sh08-list-prepend-v1
       :operation 'conj :semantic-owner 'gravity.collections :intrinsic :gravity.collections/persistent-list-prepend
       :resolution :gravity.core-compatibility :operator-node-id (get operator :node-id) :operator-binding-id bid
       :call-core-node-id (get node :node-id) :source (get node :source) :operator-source (get operator :source)
       :source-call call :source-edge edge :source-binding binding :argument-types arguments
       :prepend-semantics {:operation :persistent-list-prepend :head :second-operand :suffix :complete-ordered-input
                           :input-preserved? true :prepended-values 1 :operand-evaluation :once :payload-evaluation :none}
       :allocation-policy {:behavior :persistent-head-construction :condition :normal-operand-completion :effect :memory/allocate}
       :storage-policy {:representation :development-persistent-list :head :new-stored-value
                        :suffix :existing-list-tail :retention :may-retain-input-storage :lifetime :result-retains-tail}
       :input-extent (if (= :literal (get (first arguments) :shape)) (count (get (first arguments) :element-types)) nil)
       :result-extent (if (if invoked? (= :literal (get (first arguments) :shape)) false)
                        (+ 1 (count (get (first arguments) :element-types))) nil)
       :operand-type-work (get validation :operand-work) :result-type-work (get validation :result-work)
       :type-construction-work (get validation :construction-work) :result-type (get validation :result-type)
       :application (if invoked? :normal :not-invoked)
       :latent-effects [] :direct-effects (if invoked? [:memory/allocate] []) :capabilities [] :thrown-error-effects []
       :profile (get module :profile) :target (get module :target)
       :invalidation [:calls :call-edges :binding-table :source-forms :type-table :lexical-bindings :definitions :function-records
                      :callee-body :list-suffix :prepended-value :allocation-policy :storage-policy :profile :target :evaluation-order]} nil)) nil))

(defn body-pl-constraint [descriptor]
  {:constraint-id-request {:domain :gravity/sh08-list-prepend-constraint-v1 :application descriptor}
   :kind :equality :producer-rule :sh08-list-prepend-v1
   :lhs {:core-node-id (get descriptor :call-core-node-id) :projection :list-prepend}
   :rhs (get descriptor :result-type) :dependencies descriptor :origin (get (get descriptor :source) :origin-chain)
   :solution {:result-type (get descriptor :result-type) :application (get descriptor :application)
              :direct-effects (get descriptor :direct-effects)}
   :invalidation (get descriptor :invalidation) :profile (get descriptor :profile) :target (get descriptor :target)
   :status :solved :diagnostics []})

(defn body-pl-call-fact [descriptor module]
  (let [source (get descriptor :source) edge (get descriptor :source-edge)]
    {:artifact :gravity/c7-call-type-fact
     :fact-id-request {:domain :gravity/sh08-list-prepend-call-type-fact-v1 :application descriptor}
     :call-core-node-id (get descriptor :call-core-node-id) :caller-function-syntax-id (get edge :caller-function-syntax-id)
     :callee-function-syntax-id nil :argument-types (get descriptor :argument-types) :result-type (get descriptor :result-type)
     :evaluation-order :operator-then-arguments :source-span (get source :semantic-span) :syntax-id (get source :syntax-id)
     :origin-chain (get source :origin-chain) :generated-origin (get source :generated-origin)
     :profile (get module :profile) :target (get module :target) :effects (get descriptor :direct-effects) :capabilities [] :status :inferred
     :dispatch :direct-list-prepend :applied-list-prepend descriptor :effect-facts-source :audited-collection-intrinsic}))


(defn body-pl-finish [header]
  (assoc header :parameter-types (get header :argument-types) :return (get header :result-type)))

(defn body-pl-conj-rows [ledger families]
  (loop [remaining ledger rows {}]
    (if (= 0 (count remaining))
      (if (= (set (keys families)) (set (keys rows))) {:status :accepted :rows rows}
        (body-failure :body-conj-constraint-census))
      (let [row (first remaining) producer (get row :producer-rule)]
        (if (contains? #{:sh08-vector-append-v1 :sh08-list-prepend-v1} producer)
          (let [id (get (get row :lhs) :core-node-id) family (get families id)]
            (if (if (contains? families id) (= false (contains? rows id)) false)
              (if (= [producer (get (get row :lhs) :projection)]
                     (if (= family :list-prepend) [:sh08-list-prepend-v1 :list-prepend] [:sh08-vector-append-v1 :vector-append]))
                (recur (rest remaining) (assoc rows id row)) (body-failure :body-conj-constraint-family))
              (body-failure :body-conj-constraint-census)))
          (recur (rest remaining) rows))))))

(defn body-va-context [request facts bindings budget]
  (let [core (get request :canonical-core-artifact) calls (get core :calls) ledger (get facts :constraint-ledger)
        scan (count calls)]
    (if (> scan budget) (assoc (body-failure :body-deferred-work-limit) :work-count scan)
      (let [count-calls (loop [remaining calls out 0]
                          (if (= 0 (count remaining)) out
                            (recur (rest remaining)
                              (+ out (if (body-va-binding? (get bindings (get (first remaining) :operator-binding-id)) (get core :module)) 1 0)))))]
        (if (= 0 count-calls)
          (let [work (+ scan (count ledger))]
            (if (> work budget) (assoc (body-failure :body-deferred-work-limit) :work-count work)
              (let [rows (body-pl-conj-rows ledger {})]
                (if (= :accepted (get rows :status)) {:status :accepted :context nil :work-count work}
                  (assoc rows :work-count work)))))
          (let [forms (body-path request [:b47-context :authenticated-core-request :forms])]
            (if (= false (vector? forms)) (assoc (body-failure :body-vector-append-source-forms-required) :work-count scan)
              (let [base (+ scan (count forms) (count bindings) (count (get core :nodes)) (count calls)
                            (count (get core :call-edges)) (count (get facts :call-type-facts)) (count ledger))]
                (if (> base budget) (assoc (body-failure :body-deferred-work-limit) :work-count base)
                  (let [nodes (body-index (get core :nodes) :node-id) call-index (body-index calls :core-node-id)
                        edges (body-index (get core :call-edges) :call-core-node-id)
                        call-facts (body-index (get facts :call-type-facts) :call-core-node-id) types (get facts :type-table)]
                    (if (= false (= (count call-facts) (count (get facts :call-type-facts))))
                      (assoc (body-failure :body-conj-call-fact-census) :work-count base)
                      (loop [remaining calls used base checks {} families {}]
                        (if (= 0 (count remaining))
                          (let [rows (body-pl-conj-rows ledger families)]
                            (if (= :accepted (get rows :status))
                              {:status :accepted :work-count used
                               :context {:forms (body-index forms :form-id) :nodes nodes :calls call-index :edges edges
                                         :bindings bindings :type-checks checks :families families
                                         :conj-rows (get rows :rows) :call-facts call-facts}}
                              (assoc rows :work-count used)))
                          (let [call (first remaining) args (get call :argument-node-ids) id (get call :core-node-id)]
                            (if (body-va-binding? (get bindings (get call :operator-binding-id)) (get core :module))
                              (if (= false (vector? args))
                                (assoc (body-failure :body-conj-call-shape-required) :work-count (+ used 1))
                                (let [charge (+ 64 (count args) (count (get core :function-records))) work (+ used charge)]
                                  (if (> work budget) (assoc (body-failure :body-deferred-work-limit) :work-count work)
                                    (if (= false (= 2 (count args)))
                                      (assoc (body-failure :body-conj-arity-required) :work-count work)
                                      (if (body-pl-list? (get types (get args 0)))
                                        (if (= false (if (vector? (get (get nodes id) :children))
                                                      (= 3 (count (get (get nodes id) :children))) false))
                                          (assoc (body-failure :body-conj-call-shape-required) :work-count work)
                                        (let [validation (body-pl-type-work [(get types (get args 0) :gravity.type/unknown)
                                                                             (get types (get args 1) :gravity.type/unknown)] (- budget work))
                                              total (+ work (get validation :work-count))]
                                          (if (= :accepted (get validation :status))
                                            (recur (rest remaining) total (assoc checks id validation) (assoc families id :list-prepend))
                                            (assoc (body-failure (if (= :list-prepend-work-limit (get validation :reason))
                                                                  :body-deferred-work-limit (get validation :reason))) :work-count total))))
                                        (if (> (+ work 1024) budget)
                                          (assoc (body-failure :body-deferred-work-limit) :work-count (+ work 1024))
                                          (recur (rest remaining) (+ work 1024) checks (assoc families id :vector-append))))))))
                              (recur (rest remaining) used checks families))))))))))))))))

(defn body-pl-call-valid? [core facts bindings node call edge nodes]
  (let [types (get facts :type-table)
        validation (get (get (get facts :append-context) :type-checks) (get node :node-id))
        descriptor (get types (get call :operator-node-id))
        header (body-pl-source core node call edge nodes bindings types (get core :module) validation)
        forms (get (get facts :append-context) :forms)
        owner (get forms (get (get node :source) :form-id)) ids (get owner :child-form-ids)
        row (get (get (get facts :append-context) :conj-rows) (get node :node-id))
        rows (if (map? row) [row] [])]
    (if (map? header)
      (body-all?
        [(= descriptor (body-pl-finish header)) (= (get descriptor :result-type) (get types (get node :node-id)))
         (= :list (get owner :kind)) (vector? ids) (= 3 (if (vector? ids) (count ids) 0) (count (get node :children)))
         (= (get node :source) (get (body-ma-form-node {} owner) :source))
         (= {:operator-child-index 0 :argument-count 2 :argument-child-indexes [1 2]
             :evaluation-order :operator-then-arguments :dispatch :resolved-symbol-call} (get node :attributes))
         (loop [i 0]
           (if (= i 3) true
             (let [form (get forms (get ids i)) child (get nodes (get (get node :children) i))]
               (if (body-all? [(= (get owner :form-id) (get form :parent-form-id))
                     (= (get child :source) (get (body-ma-form-node {} form) :source))
                     (if (= i 0) (= (get form :value) (get (get child :attributes) :symbol)) true)])
                 (recur (+ i 1)) false))))
         (= (body-pl-call-fact descriptor (get core :module)) (get (get (get facts :append-context) :call-facts) (get node :node-id)))
         (= [(body-pl-constraint descriptor)] rows)]) false)))

(defn body-va-call-valid? [core facts bindings node call edge nodes]
  (let [types (get facts :type-table) descriptor (get types (get call :operator-node-id))
        header (body-va-source core node call edge nodes bindings types (get core :module))
        forms (get (get facts :append-context) :forms)
        owner (get forms (get (get node :source) :form-id)) ids (get owner :child-form-ids)
        rows (body-select (body-select (get facts :constraint-ledger) :producer-rule :sh08-vector-append-v1)
                          :lhs {:core-node-id (get node :node-id) :projection :vector-append})]
    (if (map? header)
      (body-all?
        [(= descriptor (body-va-finish header)) (= (get descriptor :result-type) (get types (get node :node-id)))
         (= :list (get owner :kind)) (vector? ids) (= 3 (if (vector? ids) (count ids) 0) (count (get node :children)))
         (= (get node :source) (get (body-ma-form-node {} owner) :source))
         (= {:operator-child-index 0 :argument-count 2 :argument-child-indexes [1 2]
             :evaluation-order :operator-then-arguments :dispatch :resolved-symbol-call} (get node :attributes))
         (loop [i 0]
           (if (= i 3) true
             (let [form (get forms (get ids i)) child (get nodes (get (get node :children) i))]
               (if (body-all? [(= (get owner :form-id) (get form :parent-form-id))
                     (= (get child :source) (get (body-ma-form-node {} form) :source))
                     (if (= i 0) (= (get form :value) (get (get child :attributes) :symbol)) true)])
                 (recur (+ i 1)) false))))
         (= (body-va-call-fact descriptor (get core :module)) (body-by (get facts :call-type-facts) :call-core-node-id (get node :node-id)))
         (= [(body-va-constraint descriptor)] rows)]) false)))

(defn body-va-node? [node facts core]
  (let [context (get facts :append-context) id (get node :node-id)]
    (if (map? context)
      (if (= :list-prepend (get (get context :families) id))
        (body-pl-call-valid? core facts (get context :bindings) node (get (get context :calls) id)
                            (get (get context :edges) id) (get context :nodes))
        (if (= :vector-append (get (get context :families) id))
          (body-va-call-valid? core facts (get context :bindings) node (get (get context :calls) id)
                              (get (get context :edges) id) (get context :nodes)) false)) false)))

; L2/L5/STD3 evaluated first-order values, not syntax or quoted-data authority.
(defn body-hl-type? [type]
  (if (map? type)
    (if (= #{:kind :shape :element-type} (set (keys type)))
      (if (= [:gravity.type/list :homogeneous] [(get type :kind) (get type :shape)])
        (contains? #{:gravity.type/i8 :gravity.type/i16 :gravity.type/i32 :gravity.type/i64
                  :gravity.type/u8 :gravity.type/u16 :gravity.type/u32 :gravity.type/u64
                  :gravity.type/f32 :gravity.type/f64 :gravity.type/bool :gravity.type/string
                  :gravity.type/symbol :gravity.type/keyword :gravity.type/ratio} (get type :element-type)) false) false) false))

(defn body-lc-type-work [arguments budget]
  (loop [pending (loop [remaining arguments out []]
                   (if (= 0 (count remaining)) out
                     (recur (rest remaining) (conj out {:type (first remaining) :depth 0 :operand? true}))))
         used 0]
    (if (= 0 (count pending)) {:status :accepted :work-count used}
      (if (if (>= used budget) true (>= used 65536))
        {:status :rejected :reason :work-limit :work-count used}
        (let [frame (get pending (- (count pending) 1)) type (get frame :type) depth (get frame :depth)
              tail (subvec pending 0 (- (count pending) 1)) next-work (+ used 1)]
          (if (> depth 128) {:status :rejected :reason :type-depth :work-count next-work}
            (if (contains? #{:gravity.type/nil :gravity.type/bool :gravity.type/integer :gravity.type/decimal :gravity.type/ratio
                            :gravity.type/i8 :gravity.type/i16 :gravity.type/i32 :gravity.type/i64
                            :gravity.type/u8 :gravity.type/u16 :gravity.type/u32 :gravity.type/u64
                            :gravity.type/f32 :gravity.type/f64 :gravity.type/character :gravity.type/string
                            :gravity.type/symbol :gravity.type/keyword :gravity.type/list :gravity.type/vector
                            :gravity.type/map :gravity.type/set} type)
              (recur tail next-work)
              (if (= :gravity.type/never type)
                (if (get frame :operand?) (recur tail next-work)
                  {:status :rejected :reason :nested-never :work-count next-work})
                (if (map? type)
                  (let [kind (get type :kind) members? (= :gravity.type/map kind) homogeneous? (body-hl-type? type)
                        children (if homogeneous? [(get type :element-type)] (get type (if members? :member-types :element-types)))
                        valid? (if homogeneous? true (if (contains? #{:gravity.type/list :gravity.type/vector :gravity.type/map :gravity.type/set} kind)
                                 (if (= (if members? #{:kind :member-types :shape} #{:kind :element-types :shape}) (set (keys type)))
                                   (if (= :literal (get type :shape))
                                     (if (vector? children)
                                       (if (<= (count children) 1024)
                                         (if members? (loop [remaining children]
                                                        (if (= 0 (count remaining)) true
                                                          (if (= 1 (count remaining)) false (recur (rest (rest remaining)))))) true)
                                         false) false) false) false) false))]
                    (if valid?
                      (if (> (+ next-work (count tail) (count children)) 65536)
                        {:status :rejected :reason :type-size :work-count next-work}
                        (recur (loop [remaining children out tail]
                                 (if (= 0 (count remaining)) out
                                   (recur (rest remaining) (conj out {:type (first remaining) :depth (+ depth 1) :operand? false}))))
                               next-work))
                      {:status :rejected :reason :malformed-type :work-count next-work}))
                  {:status :rejected :reason :unsupported-type :work-count next-work})))))))))

(defn body-lc-binding? [binding module]
  (if (if (vector? (get binding :profile-set)) (vector? (get binding :target-set)) false)
  (body-all?
    [(= ['list :core :var 'gravity.core {:name 'gravity/core :version "bootstrap-contract-v1"} :gravity.type/core-var :safe]
        [(get binding :name) (get binding :binding-class) (get binding :kind) (get binding :namespace)
         (get binding :package) (get binding :type-ref) (get binding :safety)])
     (= [] (get binding :effects) (get binding :capabilities))
     (contains? (set (get binding :profile-set)) (get module :profile))
     (contains? (set (get binding :target-set)) :all)]) false))

(defn body-lc-source [core node call edge nodes bindings types module validation]
  (if (if (vector? (get call :argument-node-ids)) (vector? (get node :children)) false)
  (let [children (get node :children) operator (get nodes (get call :operator-node-id))
        bid (get call :operator-binding-id) binding (get bindings bid) args (get call :argument-node-ids)
        arguments (body-io-child-types args types)
        invoked? (loop [remaining arguments]
                   (if (= 0 (count remaining)) true
                     (if (= :gravity.type/never (first remaining)) false (recur (rest remaining)))))
        caller (loop [remaining (get core :function-records)]
                 (if (= 0 (count remaining)) nil
                   (if (= (get (first remaining) :function-syntax-id) (get (get node :evaluation) :owner-function-syntax-id))
                     (first remaining) (recur (rest remaining)))))
        expected-call {:core-node-id (get node :node-id) :operator-node-id (first children) :operator-binding-id bid
                       :argument-node-ids (vec (rest children)) :ordered-evaluation-node-ids children
                       :evaluation-order :operator-then-arguments :result-policy :call-result}
        expected-edge {:ordinal (get edge :ordinal) :call-core-node-id (get node :node-id)
                       :caller-function-syntax-id (get caller :function-syntax-id) :caller-function-core-node-id (get caller :function-core-node-id)
                       :callee-binding-id bid :callee-definition-syntax-id (get binding :definition-syntax-id)
                       :callee-function-syntax-id nil :callee-function-core-node-id nil :argument-core-node-ids args
                       :ordered-evaluation-node-ids children :evaluation-order :operator-then-arguments :classification :nonlocal-or-nonfunction}]
    (if (body-all?
          [(= :call (get node :core-form)) (= :reference (get operator :core-form))
           (<= (count args) 1023) (= expected-call call) (= expected-edge edge) (body-lc-binding? binding module)
           (= [bid] (get node :resolved-binding-ids) (get operator :resolved-binding-ids))
           (= {:symbol (get (get operator :attributes) :symbol) :position :operator :binding-id bid :binding-class :core
               :definition-syntax-id (get binding :definition-syntax-id)} (get operator :attributes))
           (contains? '#{list gravity.core/list} (get (get operator :attributes) :symbol))
           (= :operator-then-arguments (get (get node :evaluation) :kind))
           (= (loop [i 0 out []] (if (= i (count children)) out
                (recur (+ i 1) (conj out {:index i :core-node-id (get children i)})))) (get (get node :evaluation) :order))
           (= :accepted (get validation :status))] )
      {:kind :gravity.type/applied-list-construction :version :sh08-list-construction-v1
       :operation 'list :semantic-owner 'gravity.collections :intrinsic :gravity.collections/evaluated-list
       :resolution :gravity.core-compatibility :operator-node-id (get operator :node-id) :operator-binding-id bid
       :call-core-node-id (get node :node-id) :source (get node :source) :operator-source (get operator :source)
       :source-call call :source-edge edge :source-binding binding :argument-types arguments
       :construction-policy {:value-kind :list :order :operand-order :operand-evaluation :once-left-to-right
                             :values :preserved :nesting :preserved :duplicates :preserved
                             :allocation :normal-invocation-even-empty}
       :value-origin {:kind :evaluated-list-construction :operand-node-ids args}
       :operand-type-work (get validation :work-count)
       :application (if invoked? :normal :not-invoked)
       :latent-effects [:memory/allocate] :direct-effects (if invoked? [:memory/allocate] []) :capabilities [] :thrown-error-effects []
       :profile (get module :profile) :target (get module :target)
       :invalidation [:calls :call-edges :binding-table :source-forms :type-table :lexical-bindings :definitions :function-records
                      :callee-body :operand-types :construction-policy :value-origin :allocation-condition :profile :target :evaluation-order]} nil)) nil))

(defn body-lc-constraint [descriptor]
  {:constraint-id-request {:domain :gravity/sh08-list-construction-constraint-v1 :application descriptor}
   :kind :equality :producer-rule :sh08-list-construction-v1
   :lhs {:core-node-id (get descriptor :call-core-node-id) :projection :list-construction}
   :rhs (get descriptor :result-type) :dependencies descriptor :origin (get (get descriptor :source) :origin-chain)
   :solution {:result-type (get descriptor :result-type) :application (get descriptor :application)
              :direct-effects (get descriptor :direct-effects)}

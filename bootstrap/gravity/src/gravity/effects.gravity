                             (=
                              :gravity.type/set
                              (get (get arguments 0) :kind))
                             true
                             (=
                              :gravity.type/set
                              (get (get arguments 1) :kind))))))
                         (let
                          [validation (body-sse-domain arguments)]
                          (if
                           (= :accepted (get validation :status))

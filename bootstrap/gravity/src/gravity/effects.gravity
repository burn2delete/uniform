(defn body-normal-or-never-result-finish [header]
  (let [type (if (= :normal (get header :application)) :gravity.type/bool :gravity.type/never)]
    (assoc header :parameter-types (get header :argument-types) :return type :result-type type)))

(defn body-ksm-finish [header]
  (body-normal-or-never-result-finish header))

(defn body-sysm-ledger-ids? [ledger]
  (loop [remaining ledger]
    (if (= 0 (count remaining)) true
      (let [row (first remaining) producer (get row :producer-rule)]
        (if (= nil producer) (recur (rest remaining))
        (if (keyword? producer)
          (if (contains? #{:sh08-keyword-set-contains-v1 :sh08-character-set-contains-v1 :sh08-string-set-contains-v2 :sh08-symbol-set-contains-v2 :sh08-integer-set-contains-v1} producer)
            (let [lhs (get row :lhs)]
              (if (if (map? lhs) (if (= 2 (count lhs))
                    (if (loop [fields (keys lhs)] (if (= 0 (count fields)) true
                          (if (keyword? (first fields)) (recur (rest fields)) false)))
                      (if (keyword? (get lhs :projection)) (body-sse-ids? [(get lhs :core-node-id)] 1) false) false) false) false)
                (recur (rest remaining)) false))
            (recur (rest remaining))) false))))))

(defn body-ksm-call-valid? [core facts bindings node call edge nodes]
  (if (if (body-sse-call-ids? node call)
      (if (contains? #{:gravity.type/applied-symbol-set-contains :gravity.type/applied-integer-set-contains} (get (get (get facts :type-table) (get call :operator-node-id)) :kind))
        (body-sysm-ledger-ids? (get facts :constraint-ledger)) true) false)
    (let [types (get facts :type-table) descriptor (get types (get call :operator-node-id))
        validation (get (get (get facts :map-contains-context) :keyword-set-domains) (get node :node-id))
        header (body-ksm-source core node call edge nodes bindings types (get core :module) validation)
        forms (get (get facts :map-contains-context) :forms)
        owner (get forms (get (get node :source) :form-id)) ids (get owner :child-form-ids)
        rows (body-select (body-select (get facts :constraint-ledger) :producer-rule (if (= :gravity.type/applied-integer-set-contains (get descriptor :kind)) :sh08-integer-set-contains-v1
                     (if (= :gravity.type/applied-symbol-set-contains (get descriptor :kind)) :sh08-symbol-set-contains-v2
                     (if (= :gravity.type/applied-character-set-contains (get descriptor :kind)) :sh08-character-set-contains-v1 (if (= :gravity.type/applied-string-set-contains (get descriptor :kind)) :sh08-string-set-contains-v2 :sh08-keyword-set-contains-v1)))))
                          :lhs {:core-node-id (get node :node-id) :projection (if (= :gravity.type/applied-integer-set-contains (get descriptor :kind)) :integer-set-contains
                     (if (= :gravity.type/applied-symbol-set-contains (get descriptor :kind)) :symbol-set-contains
                     (if (= :gravity.type/applied-character-set-contains (get descriptor :kind)) :character-set-contains (if (= :gravity.type/applied-string-set-contains (get descriptor :kind)) :string-set-contains :keyword-set-contains))))})]
    (if (if (map? header) (if (contains? #{:symbol :integer} (get validation :membership-family)) (body-ksin-call-forms? node nodes forms) true) false)
      (body-all?
        [(= descriptor (body-ksm-finish header)) (= (get descriptor :result-type) (get types (get node :node-id)))
         (= :list (get owner :kind)) (vector? ids) (= 3 (if (vector? ids) (count ids) 0) (count (get node :children)))
         (= (get node :source) (get (body-ma-form-node {} owner) :source))
         (= {:operator-child-index 0 :argument-count 2 :argument-child-indexes [1 2]
             :evaluation-order :operator-then-arguments :dispatch :resolved-symbol-call} (get node :attributes))
         (loop [i 0]
           (if (= i 3) true
             (let [form (get forms (get ids i)) child (get nodes (get (get node :children) i))]
               (if (body-all? [(= (get owner :form-id) (get form :parent-form-id))
                     (= (get child :source) (get (body-ma-form-node {} form) :source))
                     (if (= i 0) (= (get form :value) (get (get child :attributes) :symbol)) true)])
                 (recur (+ i 1)) false))))
         (= (body-ksm-call-fact descriptor (get core :module)) (body-by (get facts :call-type-facts) :call-core-node-id (get node :node-id)))
         (= [(body-ksm-constraint descriptor)] rows)]) false))
    false))

(defn body-mc-source [core node call edge nodes bindings types module]
  (if (if (vector? (get call :argument-node-ids)) (vector? (get node :children)) false)
  (let [children (get node :children) operator (get nodes (get call :operator-node-id))
        bid (get call :operator-binding-id) binding (get bindings bid) args (get call :argument-node-ids)
        arguments (body-io-child-types args types)
        invoked? (loop [remaining arguments]
                   (if (= 0 (count remaining)) true
                     (if (= :gravity.type/never (first remaining)) false (recur (rest remaining)))))
        caller (loop [remaining (get core :function-records)]
                 (if (= 0 (count remaining)) nil
                   (if (= (get (first remaining) :function-syntax-id) (get (get node :evaluation) :owner-function-syntax-id))
                     (first remaining) (recur (rest remaining)))))
        expected-call {:core-node-id (get node :node-id) :operator-node-id (first children) :operator-binding-id bid
                       :argument-node-ids (vec (rest children)) :ordered-evaluation-node-ids children
                       :evaluation-order :operator-then-arguments :result-policy :call-result}
        expected-edge {:ordinal (get edge :ordinal) :call-core-node-id (get node :node-id)
                       :caller-function-syntax-id (get caller :function-syntax-id) :caller-function-core-node-id (get caller :function-core-node-id)
                       :callee-binding-id bid :callee-definition-syntax-id (get binding :definition-syntax-id)
                       :callee-function-syntax-id nil :callee-function-core-node-id nil :argument-core-node-ids args
                       :ordered-evaluation-node-ids children :evaluation-order :operator-then-arguments :classification :nonlocal-or-nonfunction}]
    (if (body-all?
          [(= :call (get node :core-form)) (= :reference (get operator :core-form))
           (= 2 (count args)) (= expected-call call) (= expected-edge edge) (body-mc-binding? binding module)
           (= [bid] (get node :resolved-binding-ids) (get operator :resolved-binding-ids))
           (= {:symbol (get (get operator :attributes) :symbol) :position :operator :binding-id bid :binding-class :core
               :definition-syntax-id (get binding :definition-syntax-id)} (get operator :attributes))
           (contains? '#{contains? gravity.core/contains?} (get (get operator :attributes) :symbol))
           (= :operator-then-arguments (get (get node :evaluation) :kind))
           (= (loop [i 0 out []] (if (= i (count children)) out
                (recur (+ i 1) (conj out {:index i :core-node-id (get children i)})))) (get (get node :evaluation) :order))
           (if (= :gravity.type/never (first arguments)) true
             (= :gravity.type/map (if (map? (first arguments)) (get (first arguments) :kind) (first arguments))))
           (contains? #{:gravity.type/string :gravity.type/keyword :gravity.type/never} (get arguments 1))
           (loop [remaining arguments]
             (if (= 0 (count remaining)) true
               (if (contains? #{nil :gravity.type/unknown} (first remaining)) false (recur (rest remaining)))))] )
      {:kind :gravity.type/applied-map-contains :version :sh08-map-contains-v1
       :operation 'contains? :semantic-owner 'gravity.collections :intrinsic :gravity.collections/map-membership
       :resolution :gravity.core-compatibility :operator-node-id (get operator :node-id) :operator-binding-id bid
       :call-core-node-id (get node :node-id) :source (get node :source) :operator-source (get operator :source)
       :source-call call :source-edge edge :source-binding binding :argument-types arguments
       :membership-policy {:input :established-map :keys [:string :keyword] :key-equality :value
                           :presence :independent-of-value :normalization :none :coercion :none
                           :operand-evaluation :map-then-key-once :values :unobserved}
       :application (if invoked? :normal :not-invoked)
       :latent-effects [] :direct-effects [] :capabilities [] :thrown-error-effects []
       :profile (get module :profile) :target (get module :target)
       :invalidation [:calls :call-edges :binding-table :source-forms :type-table :lexical-bindings :definitions :function-records
                      :callee-body :map-type :key-domain :membership-policy :profile :target :evaluation-order]} nil)) nil))

(defn body-mc-constraint [descriptor]
  {:constraint-id-request {:domain :gravity/sh08-map-contains-constraint-v1 :application descriptor}
   :kind :equality :producer-rule :sh08-map-contains-v1
   :lhs {:core-node-id (get descriptor :call-core-node-id) :projection :map-contains}
   :rhs (get descriptor :result-type) :dependencies descriptor :origin (get (get descriptor :source) :origin-chain)
   :solution {:result-type (get descriptor :result-type) :application (get descriptor :application)
              :direct-effects (get descriptor :direct-effects)}
   :invalidation (get descriptor :invalidation) :profile (get descriptor :profile) :target (get descriptor :target)
   :status :solved :diagnostics []})

(defn body-mc-call-fact [descriptor module]
  (let [source (get descriptor :source) edge (get descriptor :source-edge)]
    {:artifact :gravity/c7-call-type-fact
     :fact-id-request {:domain :gravity/sh08-map-contains-call-type-fact-v1 :application descriptor}
     :call-core-node-id (get descriptor :call-core-node-id) :caller-function-syntax-id (get edge :caller-function-syntax-id)
     :callee-function-syntax-id nil :argument-types (get descriptor :argument-types) :result-type (get descriptor :result-type)
     :evaluation-order :operator-then-arguments :source-span (get source :semantic-span) :syntax-id (get source :syntax-id)
     :origin-chain (get source :origin-chain) :generated-origin (get source :generated-origin)
     :profile (get module :profile) :target (get module :target) :effects (get descriptor :direct-effects) :capabilities [] :status :inferred
     :dispatch :direct-map-contains :applied-map-contains descriptor :effect-facts-source :audited-collection-intrinsic}))


(defn body-mc-finish [header]
  (body-normal-or-never-result-finish header))

(defn body-mc-context [request facts bindings]
  (let [core (get request :canonical-core-artifact)
        count-calls (loop [remaining (get core :calls) out 0]
                      (if (= 0 (count remaining)) out
                        (recur (rest remaining)
                          (+ out (if (body-mc-binding? (get bindings (get (first remaining) :operator-binding-id)) (get core :module)) 1 0)))))]
    (if (= 0 count-calls) {:status :accepted :context nil}
      (let [forms (body-path request [:b47-context :authenticated-core-request :forms])]
        (if (= false (vector? forms)) (body-failure :body-map-contains-source-forms-required)
          (let [nodes (body-index (get core :nodes) :node-id) types (get facts :type-table)]
            (loop [remaining (get core :calls) checks {}]
              (if (= 0 (count remaining))
                (let [context {:forms (body-index forms :form-id) :nodes nodes
                               :calls (body-index (get core :calls) :core-node-id) :edges (body-index (get core :call-edges) :call-core-node-id)
                               :bindings bindings}]
                  {:status :accepted
                   :context (if (= 0 (count checks)) context (assoc context :keyword-set-domains checks))})
                (let [call (first remaining) args (get call :argument-node-ids)
                      set? (if (body-mc-binding? (get bindings (get call :operator-binding-id)) (get core :module))
                             (if (if (vector? args)
                                   (if (= 2 (count args))
                                     (let [children (get (get nodes (get call :core-node-id)) :children)]
                                       (if (vector? children) (= 3 (count children)) false)) false) false)
                               (if (contains? #{:gravity.type/applied-keyword-set-contains :gravity.type/applied-character-set-contains :gravity.type/applied-string-set-contains :gravity.type/applied-symbol-set-contains :gravity.type/applied-integer-set-contains} (get (get types (get call :operator-node-id)) :kind)) true
                                 (if (= :gravity.type/set (get types (get args 0))) true
                                   (= :gravity.type/set (get (get types (get args 0)) :kind)))) false) false)]
                  (if set?
                    (let [validation (body-ksm-domain (body-io-child-types args types))]
                      (if (= :accepted (get validation :status))
                        (recur (rest remaining) (assoc checks (get call :core-node-id) validation))
                        (assoc (body-failure (if (= :string-set-contains-operand-type-required (get validation :reason))
                                              :body-string-set-contains-operand-type-required
                                              (if (= :character-set-contains-operand-type-required (get validation :reason))
                                                :body-character-set-contains-operand-type-required :body-keyword-set-contains-operand-type-required)))
                               :type-check-reason (get validation :reason))))
                    (recur (rest remaining) checks)))))))))))

(defn body-mc-call-valid? [core facts bindings node call edge nodes]
  (if (if (contains? #{:gravity.type/applied-keyword-set-contains :gravity.type/applied-character-set-contains :gravity.type/applied-string-set-contains :gravity.type/applied-symbol-set-contains :gravity.type/applied-integer-set-contains} (get (get (get facts :type-table) (get call :operator-node-id)) :kind)) true
          (contains? (get (get facts :map-contains-context) :keyword-set-domains) (get node :node-id)))
    (body-ksm-call-valid? core facts bindings node call edge nodes)
      (let [types (get facts :type-table) descriptor (get types (get call :operator-node-id))
        header (body-mc-source core node call edge nodes bindings types (get core :module))
        forms (get (get facts :map-contains-context) :forms)
        owner (get forms (get (get node :source) :form-id)) ids (get owner :child-form-ids)
        rows (body-select (body-select (get facts :constraint-ledger) :producer-rule :sh08-map-contains-v1)
                          :lhs {:core-node-id (get node :node-id) :projection :map-contains})]
    (if (map? header)
      (body-all?
        [(= descriptor (body-mc-finish header)) (= (get descriptor :result-type) (get types (get node :node-id)))
         (= :list (get owner :kind)) (vector? ids) (= 3 (if (vector? ids) (count ids) 0) (count (get node :children)))
         (= (get node :source) (get (body-ma-form-node {} owner) :source))
         (= {:operator-child-index 0 :argument-count 2 :argument-child-indexes [1 2]
             :evaluation-order :operator-then-arguments :dispatch :resolved-symbol-call} (get node :attributes))
         (loop [i 0]
           (if (= i 3) true
             (let [form (get forms (get ids i)) child (get nodes (get (get node :children) i))]
               (if (body-all? [(= (get owner :form-id) (get form :parent-form-id))
                     (= (get child :source) (get (body-ma-form-node {} form) :source))
                     (if (= i 0) (= (get form :value) (get (get child :attributes) :symbol)) true)])
                 (recur (+ i 1)) false))))
         (= (body-mc-call-fact descriptor (get core :module)) (body-by (get facts :call-type-facts) :call-core-node-id (get node :node-id)))
         (= [(body-mc-constraint descriptor)] rows)]) false))))

(defn body-mc-node? [node facts core]
  (let [context (get facts :map-contains-context) id (get node :node-id)]
    (if (map? context)
      (body-mc-call-valid? core facts (get context :bindings) node (get (get context :calls) id)
                          (get (get context :edges) id) (get context :nodes)) false)))

; Reconstruct integer classification from current C8 inputs; type visits
; preserve the actual operand-domain and type-pair semantics.
(defn body-st-type-check [arguments]
  (if (if (vector? arguments) (= 1 (count arguments)) false)
      (let [type (first arguments)]
        (if (= :gravity.type/never type) {:status :accepted :input-element-count nil}
          (if (if (map? type) (= 3 (count type)) false)
            (if (if (= :gravity.type/vector (get type :kind))
                  (if (= :literal (get type :shape)) (vector? (get type :element-types)) false) false)
              (let [members (get type :element-types) n (count members)]
                (loop [remaining members family nil]
                  (if (= 0 (count remaining))
                    (if (= :gravity.type/keyword family)
                      {:status :accepted :input-element-count n :input-element-type :gravity.type/keyword}
                      {:status :accepted :input-element-count n})
                    (let [member (first remaining)
                          expected (if (= nil family)
                                     (if (if (keyword? member) (= :gravity.type/keyword member) false)
                                       :gravity.type/keyword :gravity.type/string) family)]
                      (if (if (keyword? member) (= expected member) false)
                        (recur (rest remaining) expected)
                        {:status :rejected :reason (if (= :gravity.type/keyword expected)
                                                    :keyword-member-type-required :string-member-type-required)})))))
              {:status :rejected :reason :finite-string-vector-required})
            {:status :rejected :reason :finite-string-vector-required})))
      {:status :rejected :reason :unary-type-input-required}))

(defn body-st-keyword-policy []
  {:version :sh08-keyword-vector-set-construction-v1
   :operation :persistent-set-from-keyword-vector :operand-evaluation :once :operand-position :non-tail
   :construction :persistent-set :payload-evaluation :none :input-preserved? true
   :duplicates :gravity-keyword-value-equality :semantic-deduplication :before-provider-insertion
   :order :unspecified :normalization :none :allocation :normal-invocation-even-empty
   :validation :all-keyword-members-before-print-compare-hash-or-insert})

(defn body-st-binding? [binding module]
  (if (if (vector? (get binding :profile-set)) (vector? (get binding :target-set)) false)
  (body-all?
    [(= ['set :core :var 'gravity.core {:name 'gravity/core :version "bootstrap-contract-v1"} :gravity.type/core-var :safe]
        [(get binding :name) (get binding :binding-class) (get binding :kind) (get binding :namespace)
         (get binding :package) (get binding :type-ref) (get binding :safety)])
     (= [] (get binding :effects) (get binding :capabilities))
     (= :jvm (get module :target))
     (contains? (set (get binding :profile-set)) (get module :profile))
     (contains? (set (get binding :target-set)) :all)]) false))

(defn body-st-source [core node call edge nodes bindings types module validation]
  (if (if (vector? (get call :argument-node-ids))
        (if (= 1 (count (get call :argument-node-ids)))
          (if (vector? (get node :children)) (= 2 (count (get node :children))) false) false) false)
  (if (loop [remaining (conj (conj (conj (conj (conj (get call :argument-node-ids) (get call :operator-node-id)) (get call :operator-binding-id)) (get node :node-id)) (get (get node :source) :form-id)) (get (get node :source) :syntax-id))] (if (= 0 (count remaining)) (loop [remaining (get node :children)] (if (= 0 (count remaining)) true (if (if (keyword? (first remaining)) true (if (string? (first remaining)) (= 71 (count (first remaining))) false)) (recur (rest remaining)) false))) (if (if (keyword? (first remaining)) true (if (string? (first remaining)) (= 71 (count (first remaining))) false)) (recur (rest remaining)) false))) (let [children (get node :children) operator (get nodes (get call :operator-node-id))
        bid (get call :operator-binding-id) binding (get bindings bid) args (get call :argument-node-ids)
        arguments (body-io-child-types args types)
        invoked? (loop [remaining arguments]
                   (if (= 0 (count remaining)) true
                     (if (= :gravity.type/never (first remaining)) false (recur (rest remaining)))))
        caller (loop [remaining (get core :function-records)]
                 (if (= 0 (count remaining)) nil
                   (if (= (get (first remaining) :function-syntax-id) (get (get node :evaluation) :owner-function-syntax-id))
                     (first remaining) (recur (rest remaining)))))
        expected-call {:core-node-id (get node :node-id) :operator-node-id (first children) :operator-binding-id bid
                       :argument-node-ids (vec (rest children)) :ordered-evaluation-node-ids children
                       :evaluation-order :operator-then-arguments :result-policy :call-result}
        expected-edge {:ordinal (get edge :ordinal) :call-core-node-id (get node :node-id)
                       :caller-function-syntax-id (get caller :function-syntax-id) :caller-function-core-node-id (get caller :function-core-node-id)
                       :callee-binding-id bid :callee-definition-syntax-id (get binding :definition-syntax-id)
                       :callee-function-syntax-id nil :callee-function-core-node-id nil :argument-core-node-ids args
                       :ordered-evaluation-node-ids children :evaluation-order :operator-then-arguments :classification :nonlocal-or-nonfunction}]
    (if (body-all?
          [(= :accepted (get validation :status)) (= :call (get node :core-form)) (= :reference (get operator :core-form))
           (= 1 (count args)) (= expected-call call) (= expected-edge edge) (body-st-binding? binding module)
           (= [bid] (get node :resolved-binding-ids) (get operator :resolved-binding-ids))
           (= {:symbol (get (get operator :attributes) :symbol) :position :operator :binding-id bid :binding-class :core
               :definition-syntax-id (get binding :definition-syntax-id)} (get operator :attributes))
           (contains? '#{set gravity.core/set} (get (get operator :attributes) :symbol))
           (= :operator-then-arguments (get (get node :evaluation) :kind))
           (= (loop [i 0 out []] (if (= i (count children)) out
                (recur (+ i 1) (conj out {:index i :core-node-id (get children i)})))) (get (get node :evaluation) :order))
           (loop [remaining arguments]
             (if (= 0 (count remaining)) true
               (if (if (= nil (first remaining)) true (if (keyword? (first remaining)) (= :gravity.type/unknown (first remaining)) false)) false (recur (rest remaining)))))] )
      (let [descriptor {:kind :gravity.type/applied-set-conversion :version :sh08-set-conversion-v1
       :operation 'set :semantic-owner 'gravity.collections :intrinsic (if invoked? :gravity.collections/persistent-set-from-string-vector :gravity.collections/persistent-set-construction)
       :resolution :gravity.core-compatibility :operator-node-id (get operator :node-id) :operator-binding-id bid
       :call-core-node-id (get node :node-id) :source (get node :source) :operator-source (get operator :source)
       :source-call call :source-edge edge :source-binding binding :argument-types arguments
       :construction-policy (if invoked? {:operation :persistent-set-from-string-vector :operand-evaluation :once :operand-position :non-tail
                         :construction :persistent-set :payload-evaluation :none :input-preserved? true
                         :duplicates :gravity-string-value-equality :order :unspecified :normalization :none
                         :allocation :normal-invocation-even-empty

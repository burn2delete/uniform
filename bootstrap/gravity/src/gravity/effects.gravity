     :coherent-b47-lexical-bindings :complete-monomorphic-declared-self-value-signature
     :complete-body-and-incoming-call-value-checks :single-ordinary-self-edge
     :recursive-effects-and-errors-pending-sh09 :recursive-call-facts :recursive-constraint-ledger
     :canonical-complete-function-signatures :source-syntax-origin-generated-origin-links-preserved

(defn body-vsl-call-body [core let-node container node slice-node nodes bindings forms]
  ; Actual call coordinates only; wrappers retain the original direct or if edge.
  (let [conditional? (= :if (get container :core-form)) calls (get core :calls) edges (get core :call-edges)
        records (get core :function-records) definitions (get core :definitions)
        children (get container :children)]
    (if (if (if (vector? calls) (vector? edges) false) (if (if (vector? records) (vector? definitions) false) (body-sse-ids? children (if conditional? 3 2)) false) false)
        (if (body-all? [(loop [rows calls] (if (= 0 (count rows)) true (if (body-sse-ids? [(get (first rows) :core-node-id)] 1) (recur (rest rows)) false))) (loop [rows edges] (if (= 0 (count rows)) true (if (body-sse-ids? [(get (first rows) :call-core-node-id)] 1) (recur (rest rows)) false))) (loop [rows records] (if (= 0 (count rows)) true (if (body-sse-ids? [(get (first rows) :function-syntax-id) (get (first rows) :function-core-node-id)] 2) (recur (rest rows)) false))) (loop [rows definitions] (if (= 0 (count rows)) true (if (body-sse-ids? [(get (first rows) :binding-id)] 1) (recur (rest rows)) false)))])
          (let [ids (get node :children)
                owner (get (get node :evaluation) :owner-function-syntax-id)
                scope (get (get let-node :attributes) :body-scope-id) region (get (get node :evaluation) :region)]
            (if (if (body-sse-ids? ids 2) (if (if (body-sse-ids? [(get node :node-id) (get slice-node :node-id) scope (get (get node :source) :form-id) (get (get node :source) :syntax-id)] 5) (body-sse-ids? [(get container :node-id) (get (get container :source) :form-id) (get (get container :source) :syntax-id) (get (get slice-node :source) :form-id) (get (get slice-node :source) :syntax-id)] 5) false) (if (if conditional? (body-vsl-prefix-call-region? container region) (keyword? region)) (if (if (= nil owner) true (body-sse-ids? [owner] 1)) (if conditional? (if (body-sse-ids? (get slice-node :children) 4)
                         (loop [remaining (get slice-node :children)]
                           (if (= 0 (count remaining)) true
                             (let [id (first remaining) child (get nodes id) child-owner (get (get child :evaluation) :owner-function-syntax-id)]
                               (if (body-sse-ids? [(get child :node-id) (get child :binding-context)] 2)
                                 (if (if (= nil child-owner) true (body-sse-ids? [child-owner] 1))
                                   (if (body-all? [(= id (get child :node-id)) (= scope (get child :binding-context))
                                         (= owner child-owner) (body-vsl-prefix-call-region? container (get (get child :evaluation) :region))])
                                     (recur (rest remaining)) false) false) false)))) false) true) false) false) false) false)
              (let [operator (get nodes (get ids 0)) bid (get (get operator :attributes) :binding-id)
                    call (body-nq-one calls :core-node-id (get node :node-id))
                    edge (body-nq-one edges :call-core-node-id (get node :node-id))]
                (if (if (body-all? [(body-sse-ids? (get call :argument-node-ids) 1) (body-sse-ids? (get call :ordered-evaluation-node-ids) 2) (body-sse-ids? (get edge :argument-core-node-ids) 1) (body-sse-ids? (get edge :ordered-evaluation-node-ids) 2)]) (if (body-sse-ids? [(get operator :node-id) bid (get (get operator :source) :form-id) (get (get operator :source) :syntax-id) (get edge :callee-function-syntax-id) (get edge :callee-function-core-node-id)] 6) (if (integer? (get edge :ordinal)) (>= (get edge :ordinal) 0) false) false) false)
                  (let [binding (get bindings bid) callee (body-nq-one records :function-syntax-id (get edge :callee-function-syntax-id))
                        definition (body-nq-one definitions :binding-id bid)
                        caller (if (= nil owner) nil (body-nq-one records :function-syntax-id owner))
                        local-ids (get let-node :resolved-binding-ids)]
                    (if (if (body-sse-ids? [(get callee :function-core-node-id) (get callee :definition-core-node-id) (get callee :definition-binding-id) (get callee :function-form-id) (get binding :definition-syntax-id) (get callee :body-core-node-id)] 6) (if (body-sse-ids? local-ids 1) (body-sse-ids? (get callee :parameter-binding-ids) 1) false) false)
                      (let [fn-node (get nodes (get callee :function-core-node-id)) def-node (get nodes (get callee :definition-core-node-id))
                            callee-body (get nodes (get callee :body-core-node-id))
                            local (get bindings (get local-ids 0))]
                        (if (body-sse-ids? [(get (get def-node :source) :form-id) (get (get fn-node :source) :form-id) (get (get def-node :source) :syntax-id) (get (get fn-node :source) :syntax-id)] 4)
                          (let [call-form (get forms (get (get node :source) :form-id)) op-form (get forms (get (get operator :source) :form-id))
                            def-form (get forms (get (get def-node :source) :form-id)) fn-form (get forms (get (get fn-node :source) :form-id))
                            def-ids (get def-form :child-form-ids) fn-ids (get fn-form :child-form-ids)]
                        (if (if (body-all? [(body-sse-ids? (get fn-node :children) 1) (body-sse-ids? (get def-node :children) 1)]) (if (body-sse-ids? def-ids 3) (if (body-sse-ids? fn-ids 3) (if (body-sse-ids? (get call-form :child-form-ids) 2) (if (body-sse-ids? [(get def-form :form-id) (get def-form :syntax-id) (get fn-form :form-id) (get fn-form :syntax-id) (get op-form :form-id) (get op-form :syntax-id)] 6) (if (body-sse-ids? (get fn-node :resolved-binding-ids) 1) (body-sse-ids? (get def-node :resolved-binding-ids) 1) false) false) false) false) false) false)
                          (let [def-op (get forms (get def-ids 0)) name-form (get forms (get def-ids 1))
                                fn-op (get forms (get fn-ids 0)) parameters (get forms (get fn-ids 1))
                                parameter-ids (get parameters :child-form-ids)]
                            (if (if (body-sse-ids? parameter-ids 1) (if (vector? (get parameters :value)) (if (= 1 (count (get parameters :value))) (if (vector? (get (get fn-node :attributes) :parameters)) (= 1 (count (get (get fn-node :attributes) :parameters))) false) false) false) false)
                                (let [parameter-name (get forms (get parameter-ids 0))
 scalar? (body-all? [(symbol? (get binding :name)) (symbol? (get binding :namespace))
                        (symbol? (get (get core :module) :namespace)) (symbol? (get (get operator :attributes) :symbol))
                        (symbol? (get op-form :value)) (symbol? (get name-form :value))
                        (symbol? (get definition :name)) (symbol? (get callee :definition-name))
                        (symbol? (get (get def-node :attributes) :name)) (symbol? (get local :name))
                        (symbol? (get parameter-name :value)) (symbol? (get (get parameters :value) 0))
                        (symbol? (get (get (get fn-node :attributes) :parameters) 0))
                        (if (= nil (get local :mutability)) true (keyword? (get local :mutability)))])]
                                  (if (if scalar?
       (if (body-sse-ids? [(get callee-body :node-id) (get (get callee-body :source) :form-id)] 2)
         (loop [rows [call-form op-form def-form def-op name-form fn-form fn-op parameters parameter-name]]
           (if (= 0 (count rows)) true
             (if (map? (first rows))
               (if (body-sse-ids? [(get (first rows) :form-id) (get (first rows) :syntax-id)] 2)
                 (recur (rest rows)) false) false))) false) false)
                                    (if (body-all?
                                          [(= :call (get node :core-form)) (= :reference (get operator :core-form))
                                           (= [(get operator :node-id) (get slice-node :node-id)] ids)
                                           (= (get node :node-id) (get children 1)) (= [] (get operator :children))
                                           (= [bid] (get node :resolved-binding-ids) (get operator :resolved-binding-ids))
                                           (= [:namespace :function] [(get binding :binding-class) (get binding :kind)])
                                           (= (get (get core :module) :namespace) (get binding :namespace))
                                           (= (get binding :name) (get definition :name) (get callee :definition-name) (get name-form :value) (get (get def-node :attributes) :name))
                                           (= {:symbol (get binding :name) :position :operator :binding-id bid :binding-class :namespace
                                               :definition-syntax-id (get binding :definition-syntax-id)} (get operator :attributes))
                                           (= (get binding :name) (get op-form :value))
                                           (= {:operator-child-index 0 :argument-count 1 :argument-child-indexes [1]
                                               :evaluation-order :operator-then-arguments :dispatch :resolved-symbol-call} (get node :attributes))
                                           (= {:core-node-id (get node :node-id) :operator-node-id (get operator :node-id) :operator-binding-id bid
                                               :argument-node-ids [(get slice-node :node-id)] :ordered-evaluation-node-ids ids
                                               :evaluation-order :operator-then-arguments :result-policy :call-result} call)
                                           (= {:ordinal (get edge :ordinal) :call-core-node-id (get node :node-id)
                                               :caller-function-syntax-id owner :caller-function-core-node-id (get caller :function-core-node-id)
                                               :callee-binding-id bid :callee-definition-syntax-id (get binding :definition-syntax-id)
                                               :callee-function-syntax-id (get callee :function-syntax-id) :callee-function-core-node-id (get callee :function-core-node-id)
                                               :argument-core-node-ids [(get slice-node :node-id)] :ordered-evaluation-node-ids ids
                                               :evaluation-order :operator-then-arguments :classification :local-function} edge)
                                           (if (= nil owner) (= :module-initialization (get (get container :evaluation) :region)) (map? caller))
                                           (= :named-top-level (get callee :definition-kind)) (= 1 (get callee :fixed-arity))
                                           (= nil (get callee :signature) (get (get fn-node :attributes) :signature))
                                           (= bid (get callee :definition-binding-id) (get definition :binding-id))
                                           (= (get callee :definition-core-node-id) (get definition :core-node-id) (get def-node :node-id))
                                           (= (get callee :function-core-node-id) (get definition :value-node-id) (get fn-node :node-id))
                                           (= :def (get def-node :core-form)) (= [(get fn-node :node-id)] (get def-node :children))
                                           (= [bid] (get def-node :resolved-binding-ids))
                                           (= (get binding :definition-syntax-id) (get (get def-node :attributes) :name-syntax-id) (get name-form :syntax-id))
                                           (= (get callee :function-syntax-id) (get (get fn-node :source) :syntax-id) (get fn-form :syntax-id))
                                           (= :fn (get fn-node :core-form))
                                           (= [(get callee :body-core-node-id)] (get fn-node :children))
                                           (= (get callee :parameter-binding-ids) (get fn-node :resolved-binding-ids))
                                           (= 1 (count (get fn-node :resolved-binding-ids)) (get (get fn-node :attributes) :fixed-arity))
                                           (= :list (get def-form :kind) (get fn-form :kind) (get call-form :kind))
                                           (= :symbol (get def-op :kind) (get fn-op :kind) (get name-form :kind) (get parameter-name :kind) (get op-form :kind))
                                           (= 'def (get def-op :value)) (= 'fn (get fn-op :value))
                                           (= :vector (get parameters :kind))
                                           (= [(get def-op :form-id) (get name-form :form-id) (get fn-form :form-id)] def-ids)
                                           (= [(get fn-op :form-id) (get parameters :form-id) (get (get callee-body :source) :form-id)] fn-ids)
                                           (= (get parameter-name :form-id) (get parameter-ids 0))
                                           (= (get callee-body :node-id) (get callee :body-core-node-id))
                                           (= [(get parameter-name :value)] (get parameters :value) (get (get fn-node :attributes) :parameters))
                                           (= (get parameters :form-id) (get (get fn-node :attributes) :parameter-form-id) (get parameter-name :parent-form-id))
                                           (= (get parameters :syntax-id) (get (get fn-node :attributes) :parameter-syntax-id))
                                           (= (get fn-form :form-id) (get callee :function-form-id) (get (get fn-node :source) :form-id)
                                                (get def-ids 2) (get parameters :parent-form-id) (get fn-op :parent-form-id))
                                           (= (get def-form :form-id) (get fn-form :parent-form-id) (get def-op :parent-form-id) (get name-form :parent-form-id))
                                           (= (get node :source) (body-ix-form-source call-form))
                                           (= (get operator :source) (body-ix-form-source op-form))
                                           (= (get fn-node :source) (body-ix-form-source fn-form))
                                           (= (get def-node :source) (body-ix-form-source def-form))
                                           (= [(get op-form :form-id) (get (get slice-node :source) :form-id)] (get call-form :child-form-ids))
                                           (= (get call-form :form-id) (get op-form :parent-form-id) (get (get forms (get (get slice-node :source) :form-id)) :parent-form-id))
                                           (= (get (get container :source) :form-id) (get call-form :parent-form-id))
                                           (= scope (get node :binding-context) (get operator :binding-context) (get slice-node :binding-context)
                                                    (get call-form :scope-id) (get op-form :scope-id))
                                           (if conditional? true (contains? #{:module-initialization :function-body} region))
                                           (if conditional?
                                             (= region (get (get operator :evaluation) :region) (get (get slice-node :evaluation) :region))
                                             (= region (get (get let-node :evaluation) :region) (get (get operator :evaluation) :region) (get (get slice-node :evaluation) :region)))
                                           (= owner (get (get let-node :evaluation) :owner-function-syntax-id)
                                                    (get (get operator :evaluation) :owner-function-syntax-id) (get (get slice-node :evaluation) :owner-function-syntax-id))
                                           (= :operator-then-arguments (get (get node :evaluation) :kind))
                                           (= [{:index 0 :core-node-id (get operator :node-id)} {:index 1 :core-node-id (get slice-node :node-id)}]
                                              (get (get node :evaluation) :order))
                                           (= :value (get (get operator :evaluation) :kind)) (= [] (get (get operator :evaluation) :order))
                                           (contains? #{nil :immutable} (get local :mutability))])
                                      {:status :accepted :node node :form call-form
                                       :source-forms [call-form op-form def-form def-op name-form fn-form fn-op parameters parameter-name]
                                       :proof {:kind :direct-local-function-slice-argument :node node :operator operator :call call :edge edge
                                               :callee-record callee :definition definition :binding binding :parameter-index 0}}
                                      {:status :rejected :reason :vector-slice-source-mismatch})
                                    {:status :rejected :reason :vector-slice-source-mismatch}))
                                {:status :rejected :reason :vector-slice-source-mismatch}))
                          {:status :rejected :reason :vector-slice-source-mismatch}))
                          {:status :rejected :reason :vector-slice-source-mismatch}))
                      {:status :rejected :reason :vector-slice-source-mismatch}))
                  {:status :rejected :reason :vector-slice-source-mismatch}))
          {:status :rejected :reason :vector-slice-source-mismatch}))
        {:status :rejected :reason :vector-slice-source-mismatch})
      {:status :rejected :reason :vector-slice-source-mismatch})))

(defn body-vsl-if-container [core let-node node nodes bindings forms local-call?]
  ; Exactly one original if container; no parent walk or branch-result inference.
  (let [controls (get core :control-flow) children (get node :children)]
    (if (if (if (boolean? local-call?) (vector? controls) false)
            (if (body-sse-ids? children 3)
              (if (body-sse-ids? [(get node :node-id) (get (get node :source) :form-id) (get (get node :source) :syntax-id)
                         (get let-node :node-id) (get (get let-node :source) :form-id) (get (get let-node :attributes) :body-scope-id)] 6)
                (loop [remaining controls] (if (= 0 (count remaining)) true
                  (if (body-sse-ids? [(get (first remaining) :core-node-id)] 1) (recur (rest remaining)) false))) false) false) false)
        (let [form (get forms (get (get node :source) :form-id)) ids (get form :child-form-ids)
              branch-nodes [(get nodes (get children 0)) (get nodes (get children 1)) (get nodes (get children 2))]
              control (body-nq-one controls :core-node-id (get node :node-id))
              scope (get (get let-node :attributes) :body-scope-id)
              owner (get (get node :evaluation) :owner-function-syntax-id) region (get (get node :evaluation) :region)]
          (if (if (body-sse-ids? ids 4)
                (if (body-sse-ids? [(get form :form-id) (get form :syntax-id) (get form :scope-id)] 3)
                  (if (if (= nil owner) true (body-sse-ids? [owner] 1))
                    (loop [remaining branch-nodes] (if (= 0 (count remaining)) true
                      (let [child (first remaining) child-owner (get (get child :evaluation) :owner-function-syntax-id)]
                        (if (body-sse-ids? [(get child :node-id) (get (get child :source) :form-id) (get (get child :source) :syntax-id)] 3)
                          (if (if (= nil child-owner) true (body-sse-ids? [child-owner] 1)) (recur (rest remaining)) false) false)))) false) false) false)
            (let [operator (get forms (get ids 0)) condition-form (get forms (get ids 1))
                  then-form (get forms (get ids 2)) else-form (get forms (get ids 3))
                  selected-forms [form operator condition-form then-form else-form]
                  region-fields? (if (map? region) (if (= 8 (count region))
                                   (loop [remaining (keys region)] (if (= 0 (count remaining)) true
                                     (if (keyword? (first remaining)) (recur (rest remaining)) false))) false) false)
                  region-valid? (if (keyword? region) (contains? #{:module-initialization :function-body} region)
                                  (if region-fields?
                                    (if (if (body-sse-ids? [(get region :if-syntax-id) (get region :if-form-id)] 2)
                                          (if (if (= nil (get region :parent-if-syntax-id)) true (body-sse-ids? [(get region :parent-if-syntax-id)] 1))
                                            (if (keyword? (get region :role))
                                              (if (keyword? (get region :parent-region-kind))
                                                (if (= nil (get region :parent-branch-role)) true (keyword? (get region :parent-branch-role))) false) false) false) false)
                                      (body-all? [(= #{:kind :if-syntax-id :if-form-id :role :execution :parent-region-kind :parent-if-syntax-id :parent-branch-role} (set (keys region)))
                                            (= :conditional-branch (get region :kind)) (= :selected-exactly-once (get region :execution))
                                            (contains? #{:then :else} (get region :role))
                                            (contains? #{:module-initialization :function-body :conditional-branch :match-guard} (get region :parent-region-kind))
                                            (if (= :conditional-branch (get region :parent-region-kind))
                                              (if (body-sse-ids? [(get region :parent-if-syntax-id)] 1)
                                                (contains? #{:then :else} (get region :parent-branch-role)) false)
                                              (if (= nil (get region :parent-if-syntax-id)) (= nil (get region :parent-branch-role)) false))]) false) false))]
              (if (if region-valid?
                    (if (symbol? (get operator :value))
                      (if (body-sse-ids? [(get control :condition-node-id) (get (get (get control :branches) 0) :core-node-id)
                                 (get (get (get control :branches) 1) :core-node-id)] 3)
                        (loop [remaining selected-forms] (if (= 0 (count remaining)) true
                          (let [item (first remaining)]
                            (if (body-sse-ids? [(get item :form-id) (get item :syntax-id) (get item :scope-id)] 3) (recur (rest remaining)) false)))) false) false) false)
                (if (body-all? [
                      (= :if (get node :core-form)) (= :let (get let-node :core-form)) (= [] (get node :resolved-binding-ids))
                      (= (get node :node-id) (get (get let-node :children) 1))
                      (= :list (get form :kind)) (= :symbol (get operator :kind)) (= 'if (get operator :value)) (= [] (get operator :child-form-ids))
                      (= (get node :source) (body-ix-form-source form))
                      (= [(get operator :form-id) (get (get (get branch-nodes 0) :source) :form-id)
                          (get (get (get branch-nodes 1) :source) :form-id) (get (get (get branch-nodes 2) :source) :form-id)] ids)
                      (= (get form :form-id) (get operator :parent-form-id) (get condition-form :parent-form-id) (get then-form :parent-form-id) (get else-form :parent-form-id))
                      (= (get (get let-node :source) :form-id) (get form :parent-form-id))
                      (= scope (get node :binding-context) (get form :scope-id) (get operator :scope-id))
                      (= {:condition-child-index 0 :then-child-index 1 :else-child-index 2 :condition-evaluation :always-first
                          :branch-evaluation :exactly-one :truthiness {:false-values [:nil :false] :other-values :true}} (get node :attributes))
                      (= :condition-then-exclusive-branch (get (get node :evaluation) :kind))
                      (= [{:index 0 :core-node-id (get children 0)}] (get (get node :evaluation) :order))
                      (= {:core-node-id (get node :node-id) :kind :if :condition-node-id (get children 0)
                          :branches [{:role :then :predicate :truthy :core-node-id (get children 1)} {:role :else :predicate :falsey :core-node-id (get children 2)}]
                          :branch-exclusivity :exactly-one :truthiness {:false-values [:nil :false] :other-values :true} :result-policy :selected-branch} control)])
                  (let [then-node (get branch-nodes 1) then-ids (get then-node :children)
                        branch-call (if local-call?
                                      (if (body-sse-ids? then-ids 2)
                                        (body-vsl-call-body core let-node node then-node (get nodes (get then-ids 1)) nodes bindings forms)
                                        {:status :rejected :reason :vector-slice-source-mismatch})
                                      {:status :accepted})]
                    (if (= :accepted (get branch-call :status))
                      (let [witness (if local-call?
                                      (loop [remaining (rest (get branch-call :source-forms))
                                             out [form operator then-form else-form (get forms (get (get (get nodes (get then-ids 1)) :source) :form-id))]]
                                        (if (= 0 (count remaining)) out (recur (rest remaining) (conj out (first remaining)))))
                                      [form operator then-form else-form])]
                        (loop [i 0]
                    (if (= i 3)
                      {:status :accepted :root node :condition (get branch-nodes 0) :form form
                       :source-forms witness
                       :proof (let [proof {:kind :prefix-gate-if :node node :condition (get branch-nodes 0) :then (get branch-nodes 1) :else (get branch-nodes 2)
                               :control control :source-forms witness}]
                                 (if local-call? (assoc proof :kind :prefix-gate-call-if :then-call (get branch-call :proof)) proof))}
                      (let [child (get branch-nodes i) child-form (get selected-forms (+ i 2))
                            value (get (get child :attributes) :value)
                            expected-region (if (= i 0) region
                                              {:kind :conditional-branch :if-syntax-id (get form :syntax-id) :if-form-id (get form :form-id)
                                               :role (if (= i 1) :then :else) :execution :selected-exactly-once
                                               :parent-region-kind (if (map? region) (get region :kind) region)
                                               :parent-if-syntax-id (if (map? region) (get region :if-syntax-id) nil)
                                               :parent-branch-role (if (map? region) (get region :role) nil)})]
                        (if (if (if local-call? (= i 2) false) (if (boolean? value) (= false value) false) (if (if local-call? (= i 1) false) true (if (= i 0) true (if (boolean? value) (boolean? (get child-form :value)) false))))
                          (if (body-all? [(= (get children i) (get child :node-id)) (= (get child :source) (body-ix-form-source child-form))
                                    (= scope (get child :binding-context) (get child-form :scope-id))
                                    (= owner (get (get child :evaluation) :owner-function-syntax-id))
                                    (= expected-region (get (get child :evaluation) :region))
                                    (if (if local-call? (= i 1) false) true (if (= i 0) true
                                      (body-all? [(= :literal (get child :core-form)) (= :boolean (get child-form :kind))
                                            (= {:literal-kind :boolean :value value} (get child :attributes)) (= value (get child-form :value))
                                            (= [] (get child :children) (get child :resolved-binding-ids) (get child-form :child-form-ids))
                                            (= :value (get (get child :evaluation) :kind)) (= [] (get (get child :evaluation) :order))])))])
                            (recur (+ i 1)) {:status :rejected :reason :vector-slice-source-mismatch})
                          {:status :rejected :reason :vector-slice-source-mismatch})))))
                      branch-call))
                  {:status :rejected :reason :vector-slice-source-mismatch})
                {:status :rejected :reason :vector-slice-source-mismatch}))
            {:status :rejected :reason :vector-slice-source-mismatch}))
        {:status :rejected :reason :vector-slice-source-mismatch})))

(defn body-vsl-prefix-if [core let-node node nodes forms]
  ; Existing both-literal branch subset and its proof remains unchanged.
  (body-vsl-if-container core let-node node nodes {} forms false))

(defn body-vsl-prefix-call-body [core let-node slice-node nodes bindings types forms]
  ; Exactly if -> then call -> this argument; its condition keeps its own slice proof.
  (let [ids (get let-node :children)]
    (if (body-sse-ids? ids 2)
        (let [root (get nodes (get ids 1))
              container (body-vsl-if-container core let-node root nodes bindings forms true)]
          (if (= :accepted (get container :status))
            (let [condition (get container :condition) condition-ids (get condition :children)]
              (if (body-sse-ids? condition-ids 3)
                (let [prefix (get nodes (get condition-ids 1)) prefix-ids (get prefix :children) tail-ids (get slice-node :children)
                      local-ids (get let-node :resolved-binding-ids)]
                  (if (if (body-sse-ids? prefix-ids 4) (if (body-sse-ids? tail-ids 4)
                        (if (body-sse-ids? local-ids 1)
                          (body-sse-ids? [(get prefix :node-id) (get (get prefix :source) :form-id) (get (get prefix :source) :syntax-id)
                                         (get slice-node :node-id) (get (get slice-node :source) :form-id)] 5) false) false) false)
                    (let [prefix-op (get nodes (get prefix-ids 0)) prefix-ref (get nodes (get prefix-ids 1))
                          tail-op (get nodes (get tail-ids 0)) tail-ref (get nodes (get tail-ids 1))]
                      (if (if (body-sse-ids? [(get (get prefix-op :attributes) :binding-id) (get (get tail-op :attributes) :binding-id)
                                            (get (get prefix-ref :attributes) :binding-id) (get (get tail-ref :attributes) :binding-id)] 4)
                            (symbol? (get (get prefix-op :attributes) :symbol)) false)
                        (if (body-all?
                              [(= :call (get prefix :core-form)) (= false (= (get prefix :node-id) (get slice-node :node-id)))
                               (= (get slice-node :node-id) (get (get (get (get (get container :proof) :then-call) :call) :argument-node-ids) 0))
                               (contains? '#{subvec gravity.core/subvec} (get (get prefix-op :attributes) :symbol))
                               (= (get (get prefix-op :attributes) :binding-id) (get (get tail-op :attributes) :binding-id))
                               (= (get local-ids 0) (get (get prefix-ref :attributes) :binding-id) (get (get tail-ref :attributes) :binding-id))])
                          (let [comparison (body-vsl-let-equality-body core let-node prefix nodes bindings types forms)]
                            (if (= :accepted (get comparison :status))
                              {:status :accepted :node root :form (get container :form)
                               :source-forms (loop [remaining (get comparison :source-forms) out []]
                                               (if (= 0 (count remaining)) out
                                                 (let [form (first remaining)]
                                                   (recur (rest remaining) (if (= (get (get slice-node :source) :form-id) (get form :form-id)) out (conj out form))))))
                               :proof (assoc (get (get container :proof) :then-call)
                                             :kind :prefix-gated-local-function-slice-argument
                                             :condition-container (get container :proof) :prefix-comparison (get comparison :proof))}
                              comparison))
                          {:status :rejected :reason :vector-slice-source-mismatch})
                        {:status :rejected :reason :vector-slice-source-mismatch}))
                    {:status :rejected :reason :vector-slice-source-mismatch}))
                {:status :rejected :reason :vector-slice-source-mismatch}))
            container))
        {:status :rejected :reason :vector-slice-source-mismatch})))

(defn body-vsl-first-parent [core let-node node expected-id slice-node nodes bindings forms]
  ; Fixed original first edge; caller root selection remains source-authenticated.
  (let [ids (get node :children)]
    (if (if (body-sse-ids? ids 2)
                (body-sse-ids? [(get node :node-id) expected-id (get (get node :source) :form-id) (get (get node :source) :syntax-id)] 4) false)
            (let [operator (get nodes (get ids 0)) bid (get (get operator :attributes) :binding-id)
                  scope (get (get let-node :attributes) :body-scope-id)]
              (if (if (body-sse-ids? [(get operator :node-id) bid scope (get slice-node :node-id)] 4)
                    (if (body-sse-ids? [(get (get operator :source) :form-id) (get (get operator :source) :syntax-id)
                               (get (get slice-node :source) :form-id) (get (get slice-node :source) :syntax-id)] 4)
                      (symbol? (get (get operator :attributes) :symbol)) false) false)
                (let [binding (get bindings bid) owner (get forms (get (get node :source) :form-id))
                      op-form (get forms (get (get operator :source) :form-id))
                      profiles (get binding :profile-set) targets (get binding :target-set)
                      region (get (get node :evaluation) :region)
                      caller (get (get node :evaluation) :owner-function-syntax-id)]
                  (if (if (body-sse-ids? [(get owner :form-id) (get owner :syntax-id) (get op-form :form-id) (get op-form :syntax-id)
                                   (get binding :definition-syntax-id)] 5)
                          (if (body-sse-ids? (get owner :child-form-ids) 2)
                            (if (if (symbol? (get binding :name)) (symbol? (get op-form :value)) false)
                              (if (if (vector? profiles) (vector? targets) false)
                                (if (loop [remaining profiles] (if (= 0 (count remaining)) true
                                      (if (keyword? (first remaining)) (recur (rest remaining)) false)))
                                  (if (loop [remaining targets] (if (= 0 (count remaining)) true
                                        (if (keyword? (first remaining)) (recur (rest remaining)) false)))
                                    (if (keyword? region) (if (= nil caller) true (body-sse-ids? [caller] 1)) false) false) false) false) false) false) false)
                      (if (body-all? [
                            (= :call (get node :core-form)) (= :reference (get operator :core-form))
                            (= [(get operator :node-id) (get slice-node :node-id)] ids)
                            (= (get node :node-id) expected-id)
                            (= [] (get operator :children)) (= [bid] (get node :resolved-binding-ids) (get operator :resolved-binding-ids))
                            (= {:symbol (get (get operator :attributes) :symbol) :position :operator :binding-id bid :binding-class :core
                                :definition-syntax-id (get binding :definition-syntax-id)} (get operator :attributes))
                            (contains? '#{first gravity.core/first} (get (get operator :attributes) :symbol))
                            (= 'first (get binding :name)) (body-lq-binding? binding (get core :module))
                            (= {:operator-child-index 0 :argument-count 1 :argument-child-indexes [1]
                                :evaluation-order :operator-then-arguments :dispatch :resolved-symbol-call} (get node :attributes))
                            (= :operator-then-arguments (get (get node :evaluation) :kind))
                            (= [{:index 0 :core-node-id (get operator :node-id)} {:index 1 :core-node-id (get slice-node :node-id)}]
                               (get (get node :evaluation) :order))
                            (= [] (get (get operator :evaluation) :order))
                            (contains? #{:module-initialization :function-body} region)
                            (= region (get (get let-node :evaluation) :region) (get (get slice-node :evaluation) :region))
                            (= caller (get (get slice-node :evaluation) :owner-function-syntax-id) (get (get let-node :evaluation) :owner-function-syntax-id))
                            (= :list (get owner :kind)) (= :symbol (get op-form :kind)) (= [] (get op-form :child-form-ids))
                            (= (get (get operator :attributes) :symbol) (get op-form :value))
                            (= [(get op-form :form-id) (get (get slice-node :source) :form-id)] (get owner :child-form-ids))
                            (= (get owner :form-id) (get op-form :parent-form-id))
                            (= (get node :source) (body-ix-form-source owner)) (= (get operator :source) (body-ix-form-source op-form))
                            (= scope (get node :binding-context) (get operator :binding-context) (get owner :scope-id) (get op-form :scope-id))])
                        {:status :accepted :node node :form owner :source-forms [owner op-form]
                         :proof {:kind :direct-vector-first :node node :operator operator :binding binding :source-forms [owner op-form]}}
                        {:status :rejected :reason :vector-slice-source-mismatch})
                      {:status :rejected :reason :vector-slice-source-mismatch}))
                {:status :rejected :reason :vector-slice-source-mismatch}))
            {:status :rejected :reason :vector-slice-source-mismatch})))

(defn body-vsl-let-first-body [core let-node slice-node nodes bindings forms]
  ; The original direct-first entry retains its inputs and proof.
  (let [children (get let-node :children)]
    (if (body-sse-ids? children 2)
      (body-vsl-first-parent core let-node (get nodes (get children 1)) (get children 1) slice-node nodes bindings forms)
      {:status :rejected :reason :vector-slice-source-mismatch})))

(defn body-vsl-character-set [node parent scope region caller nodes forms]
  ; Original flat Character Set source only; this emits no member-type fact.
  (let [ids (get node :children) n (if (vector? ids) (count ids) 0)]
    (if (if (body-sse-ids? [(get node :node-id) (get (get node :source) :form-id) (get (get node :source) :syntax-id) parent scope] 5)
              (if (keyword? region) (if (if (= nil caller) true (body-sse-ids? [caller] 1))
                (if (vector? ids) (loop [remaining ids] (if (= 0 (count remaining)) true
                  (if (body-sse-ids? [(first remaining)] 1) (recur (rest remaining)) false))) false) false) false) false)
          (let [form (get forms (get (get node :source) :form-id)) attrs (get node :attributes)
                values (get form :value) source-values (get attrs :source-value) source-ids (get form :child-form-ids)
                node-caller (get (get node :evaluation) :owner-function-syntax-id)]
            (if (if (body-sse-ids? [(get form :form-id) (get form :syntax-id) (get form :parent-form-id) (get form :scope-id)] 4)
                  (if (if (= nil node-caller) true (body-sse-ids? [node-caller] 1))
                    (if (if (vector? source-ids) (= n (count source-ids)) false)
                      (if (loop [remaining source-ids] (if (= 0 (count remaining)) true
                            (if (body-sse-ids? [(first remaining)] 1) (recur (rest remaining)) false)))
                        (if (if (set? values) (set? source-values) false)
                          (if (if (<= (count values) n) (<= (count source-values) n) false)
                            (if (loop [members (vec values) i 0] (if (= i (count members)) true
                                  (if (char? (get members i)) (recur members (+ i 1)) false)))
                              (loop [members (vec source-values) i 0] (if (= i (count members)) true
                                (if (char? (get members i)) (recur members (+ i 1)) false))) false) false) false) false) false) false) false)
              (if (body-all? [
                    (contains? #{:module-initialization :function-body} region)
                    (= :collection-literal (get node :core-form)) (= [] (get node :resolved-binding-ids))
                    (= {:literal-kind :set :element-count n :source-value source-values} attrs)
                    (= :left-to-right (get (get node :evaluation) :kind))
                    (= (loop [i 0 out []] (if (= i n) out (recur (+ i 1) (conj out {:index i :core-node-id (get ids i)}))))
                       (get (get node :evaluation) :order))
                    (= scope (get node :binding-context) (get form :scope-id))
                    (= region (get (get node :evaluation) :region)) (= caller node-caller)
                    (= :set (get form :kind)) (= parent (get form :parent-form-id))
                    (= (get node :source) (body-ix-form-source form))])
                (loop [i 0 selected [form] members [] seen #{} seen-forms #{(get form :form-id)}]
                  (if (= i n)
                    ; L1/C2 uniqueness is checked after the complete physical Character census.
                    (if (if (= n (count values) (count source-values)) (= (set members) values source-values) false)
                      {:status :accepted :node node :form form :source-forms selected}
                      {:status :rejected :reason :vector-slice-source-mismatch})
                    (let [id (get ids i) child (get nodes id) source (get child :source)]
                      (if (if (body-sse-ids? [id (get child :node-id) (get source :form-id) (get source :syntax-id)] 4)
                            (if (= false (contains? seen id)) (= false (contains? seen-forms (get source :form-id))) false) false)
                        (let [original (get forms (get source :form-id)) value (get (get child :attributes) :value)
                              child-caller (get (get child :evaluation) :owner-function-syntax-id)]
                          (if (if (body-sse-ids? [(get original :form-id) (get original :syntax-id) (get original :parent-form-id) (get original :scope-id)] 4)
                                (if (if (= nil child-caller) true (body-sse-ids? [child-caller] 1))
                                  (if (char? value) (char? (get original :value)) false) false) false)
                            (if (body-all? [
                                  (= id (get child :node-id)) (= (get source-ids i) (get original :form-id))
                                  (= :literal (get child :core-form)) (= {:literal-kind :character :value value} (get child :attributes))
                                  (= [] (get child :children) (get child :resolved-binding-ids) (get original :child-form-ids))
                                  (= :character (get original :kind)) (= value (get original :value))
                                  (= source (body-ix-form-source original)) (= (get form :form-id) (get original :parent-form-id))
                                  (= scope (get child :binding-context) (get original :scope-id))
                                  (= :value (get (get child :evaluation) :kind)) (= [] (get (get child :evaluation) :order))
                                  (= region (get (get child :evaluation) :region)) (= caller child-caller)])
                              (recur (+ i 1) (conj selected original) (conj members value) (conj seen id) (conj seen-forms (get source :form-id)))
                              {:status :rejected :reason :vector-slice-source-mismatch})
                            {:status :rejected :reason :vector-slice-source-mismatch}))
                        {:status :rejected :reason :vector-slice-source-mismatch}))))
                {:status :rejected :reason :vector-slice-source-mismatch})
              {:status :rejected :reason :vector-slice-source-mismatch}))
          {:status :rejected :reason :vector-slice-source-mismatch})))

(defn body-vsl-let-first-membership-body [core let-node slice-node nodes bindings forms]
  ; Exactly contains?(original Character Set, first(actual slice)); no ancestry walk.
  (let [root-ids (get let-node :children)]
    (if (body-sse-ids? root-ids 2)
        (let [node (get nodes (get root-ids 1)) children (get node :children)]
          (if (if (body-sse-ids? children 3)
                (body-sse-ids? [(get node :node-id) (get (get node :source) :form-id) (get (get node :source) :syntax-id)] 3) false)
            (let [operator (get nodes (get children 0)) items (get nodes (get children 1)) first-node (get nodes (get children 2))
                  bid (get (get operator :attributes) :binding-id) scope (get (get let-node :attributes) :body-scope-id)]
              (if (if (body-sse-ids? [(get operator :node-id) bid (get items :node-id) (get first-node :node-id) scope] 5)
                    (if (body-sse-ids? [(get (get operator :source) :form-id) (get (get operator :source) :syntax-id)
                               (get (get items :source) :form-id) (get (get items :source) :syntax-id)
                               (get (get first-node :source) :form-id) (get (get first-node :source) :syntax-id)] 6)
                      (symbol? (get (get operator :attributes) :symbol)) false) false)
                (let [binding (get bindings bid) owner (get forms (get (get node :source) :form-id))
                      op-form (get forms (get (get operator :source) :form-id)) first-form (get forms (get (get first-node :source) :form-id))
                      profiles (get binding :profile-set) targets (get binding :target-set)
                      region (get (get node :evaluation) :region) caller (get (get node :evaluation) :owner-function-syntax-id)
                      first-caller (get (get first-node :evaluation) :owner-function-syntax-id)]
                  (if (if (body-sse-ids? [(get owner :form-id) (get owner :syntax-id) (get op-form :form-id) (get op-form :syntax-id)
                                   (get first-form :form-id) (get first-form :syntax-id)] 6)
                          (if (body-sse-ids? [(get binding :definition-syntax-id) (get first-form :parent-form-id) (get first-form :scope-id)
                                     (get owner :scope-id) (get op-form :scope-id)] 5)
                            (if (body-sse-ids? (get owner :child-form-ids) 3)
                              (if (if (symbol? (get binding :name)) (symbol? (get op-form :value)) false)
                                (if (if (vector? profiles) (vector? targets) false)
                                  (if (loop [remaining profiles] (if (= 0 (count remaining)) true
                                        (if (keyword? (first remaining)) (recur (rest remaining)) false)))
                                    (if (loop [remaining targets] (if (= 0 (count remaining)) true
                                          (if (keyword? (first remaining)) (recur (rest remaining)) false)))
                                      (if (keyword? region) (if (if (= nil caller) true (body-sse-ids? [caller] 1))
                                        (if (= nil first-caller) true (body-sse-ids? [first-caller] 1)) false) false) false) false) false) false) false) false) false)
                      (if (body-all? [
                            (= :call (get node :core-form)) (= :reference (get operator :core-form))
                            (= (get node :node-id) (get root-ids 1))
                            (= [(get operator :node-id) (get items :node-id) (get first-node :node-id)] children)
                            (= [] (get operator :children)) (= [bid] (get node :resolved-binding-ids) (get operator :resolved-binding-ids))
                            (= {:symbol (get (get operator :attributes) :symbol) :position :operator :binding-id bid :binding-class :core
                                :definition-syntax-id (get binding :definition-syntax-id)} (get operator :attributes))
                            (contains? '#{contains? gravity.core/contains?} (get (get operator :attributes) :symbol))
                            (= 'contains? (get binding :name)) (body-mc-binding? binding (get core :module))
                            (= {:operator-child-index 0 :argument-count 2 :argument-child-indexes [1 2]
                                :evaluation-order :operator-then-arguments :dispatch :resolved-symbol-call} (get node :attributes))
                            (= :operator-then-arguments (get (get node :evaluation) :kind))
                            (= [{:index 0 :core-node-id (get operator :node-id)} {:index 1 :core-node-id (get items :node-id)}
                                {:index 2 :core-node-id (get first-node :node-id)}] (get (get node :evaluation) :order))
                            (= [] (get (get operator :evaluation) :order))
                            (contains? #{:module-initialization :function-body} region)
                            (= region (get (get first-node :evaluation) :region)) (= caller first-caller)
                            (= :list (get owner :kind)) (= :symbol (get op-form :kind)) (= [] (get op-form :child-form-ids))
                            (= (get (get operator :attributes) :symbol) (get op-form :value))
                            (= [(get op-form :form-id) (get (get items :source) :form-id) (get first-form :form-id)] (get owner :child-form-ids))
                            (= (get owner :form-id) (get op-form :parent-form-id) (get first-form :parent-form-id))
                            (= (get node :source) (body-ix-form-source owner)) (= (get operator :source) (body-ix-form-source op-form))
                            (= (get first-node :source) (body-ix-form-source first-form))
                            (= scope (get node :binding-context) (get operator :binding-context) (get first-node :binding-context)
                                     (get owner :scope-id) (get op-form :scope-id) (get first-form :scope-id))])
                        (let [literal (body-vsl-character-set items (get owner :form-id) scope region caller nodes forms)]
                          (if (= :accepted (get literal :status))
                            (let [first-parent (body-vsl-first-parent core let-node first-node (get children 2) slice-node nodes bindings forms)]
                              (if (= :accepted (get first-parent :status))
                                (let [container-forms (loop [remaining (get literal :source-forms) out [owner op-form]]
                                                        (if (= 0 (count remaining)) out (recur (rest remaining) (conj out (first remaining)))))
                                      selected (loop [remaining (get first-parent :source-forms) out container-forms]
                                                 (if (= 0 (count remaining)) out (recur (rest remaining) (conj out (first remaining)))))]
                                  {:status :accepted :node node :form owner :source-forms selected
                                   :proof (assoc (get first-parent :proof) :kind :direct-character-set-first-membership :source-forms selected
                                            :membership-container {:kind :character-set-membership :node node :operator operator :binding binding
                                                                   :set-node items :source-forms container-forms})})
                                first-parent))
                            literal))
                        {:status :rejected :reason :vector-slice-source-mismatch})
                      {:status :rejected :reason :vector-slice-source-mismatch}))
                {:status :rejected :reason :vector-slice-source-mismatch}))
            {:status :rejected :reason :vector-slice-source-mismatch}))
        {:status :rejected :reason :vector-slice-source-mismatch})))

(defn body-vsl-let-call-body [core let-node slice-node nodes bindings forms]
  ; Retain the original direct let/body proof.
  (let [ids (get let-node :children)]
    (if (body-sse-ids? ids 2)
      (body-vsl-call-body core let-node let-node (get nodes (get ids 1)) slice-node nodes bindings forms)
      {:status :rejected :reason :vector-slice-source-mismatch})))

(defn
 body-vsl-let-equality-body
 [core let-node slice-node nodes bindings types forms]
 (let
  [children (get let-node :children)]
  (if
   (body-sse-ids? children 2)
   (let
    [root
     (get nodes (get children 1))
     first-consumer?
     (if
      (vector? (get root :children))
      (= 2 (count (get root :children)))
      false)
     membership-consumer?
     (if
      (body-sse-ids? (get root :children) 3)
      (let
       [left (get nodes (get (get root :children) 1))]
       (if
        (= :collection-literal (get left :core-form))
        (= :set (get (get left :attributes) :literal-kind))
        false))
      false)
     local-call-consumer?
     (if
      (body-sse-ids? (get root :children) 2)
      (let
       [operator
        (get nodes (get (get root :children) 0))
        bid
        (get (get operator :attributes) :binding-id)]
       (if
        (body-sse-ids? [bid] 1)
        (=
         [:namespace :function]
         [(get (get bindings bid) :binding-class)
          (get (get bindings bid) :kind)])
        false))
      false)
     conditional?
     (= :if (get root :core-form))
     then-node
     (if
      (if conditional? (body-sse-ids? (get root :children) 3) false)
      (get nodes (get (get root :children) 1))
      nil)
     then-ids
     (get then-node :children)
     call-branch?
     (if
      (body-sse-ids? then-ids 2)
      (= :call (get then-node :core-form))
      false)
     conditional-call-consumer?
     (if
      call-branch?
      (if
       (body-sse-ids? [(get slice-node :node-id)] 1)
       (= (get slice-node :node-id) (get then-ids 1))
       false)
      false)
     container
     (if
      conditional?
      (if
       conditional-call-consumer?
       nil
       (if
        call-branch?
        (body-vsl-if-container
         core
         let-node
         root
         nodes
         bindings
         forms
         true)
        (body-vsl-prefix-if core let-node root nodes forms)))
      nil)
     node
     (if conditional? (get container :condition) root)
     children
     (get node :children)]
    (if
     conditional-call-consumer?
     (let
      [selected
       (body-vsl-prefix-call-body
        core
        let-node
        slice-node
        nodes
        bindings
        types
        forms)]
      selected)
     (if
      local-call-consumer?
      (let
       [selected
        (body-vsl-let-call-body
         core
         let-node
         slice-node
         nodes
         bindings
         forms)]
       selected)
      (if
       first-consumer?
       (let
        [selected
         (body-vsl-let-first-body
          core
          let-node
          slice-node
          nodes
          bindings
          forms)]
        selected)
       (if
        membership-consumer?
        (let
         [selected
          (body-vsl-let-first-membership-body
           core
           let-node
           slice-node
           nodes
           bindings
           forms)]
         selected)
        (if
         (if conditional? (= :accepted (get container :status)) true)
         (if
          (if
           (body-sse-ids? children 3)
           (body-sse-ids?
            [(get node :node-id)
             (get (get node :source) :form-id)
             (get (get node :source) :syntax-id)]
            3)
           false)
          (let
           [operator
            (get nodes (get children 0))
            right
            (get nodes (get children 2))
            ids
            (get right :children)
            n
            (if (vector? ids) (count ids) 0)
            bid
            (get (get operator :attributes) :binding-id)]
           (if
            (if
             (if
              (vector? ids)
              (loop
               [remaining ids]
               (if
                (= 0 (count remaining))
                true
                (if
                 (body-sse-ids? [(first remaining)] 1)
                 (recur (rest remaining))

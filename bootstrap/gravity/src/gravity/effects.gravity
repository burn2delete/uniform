                   (loop
                    [remaining
                     (get end-check :source-forms [])
                     out
                     selected]
                    (if
                     (= 0 (count remaining))
                     out
                     (recur
                      (rest remaining)
                      (conj out (first remaining)))))]
                  (if
                   (= 0 (count remaining))
                   out

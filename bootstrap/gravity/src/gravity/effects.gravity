; STD3: a removal has new logical coordinates and unchanged survivor sources.
(defn body-mr-result-type [parts]
  {:kind :gravity.type/map :shape :literal
   :member-types (loop [remaining parts out []]
                   (if (= 0 (count remaining)) out
                     (recur (rest remaining)
                       (conj (conj out :gravity.type/keyword) (get (get (first remaining) :shape) :type)))))})

(defn body-mr-transition [input key budget]
  (let [parts (get input :parts) type (get input :type) members (get type :member-types)
        width (if (vector? parts) (count parts) 0) work (+ 2 (* 4 width))]
    (if (> work budget) {:status :rejected :reason :map-removal-work-limit :work-count work}
      (if (if (keyword? key)
            (if (= :map (get input :shape-kind))
              (if (vector? parts)
                (if (map? type)
                  (if (= 3 (count type))
                    (if (= #{:kind :shape :member-types} (set (keys type)))
                      (if (= [:gravity.type/map :literal] [(get type :kind) (get type :shape)])
                        (if (vector? members) (if (<= (count members) 1024) (= (count members) (* 2 width)) false) false)
                        false) false) false) false) false) false) false)
        (loop [remaining parts ordinal 0 output [] survivors [] seen #{} removed nil removed-index nil]
          (if (= 0 (count remaining))
            {:status :accepted :work-count work :type (body-mr-result-type output)
             :transition {:kind (if (= removed-index nil) :absent :remove) :key key
                          :input-entry-count width :output-entry-count (count output)
                          :removed-entry-index removed-index :removed-part removed
                          :survivors survivors :parts output}}
            (let [part (first remaining) part-key (get part :key) value (get part :shape)
                  coordinate (+ 1 (* 2 ordinal))]
              (if (if (keyword? part-key)
                    (if (= false (contains? seen part-key))
                      (if (= coordinate (get part :coordinate))
                        (if (map? value)
                          (if (= :gravity.type/keyword (get members (* 2 ordinal)))
                            (= (get value :type) (get members (+ 1 (* 2 ordinal)))) false) false) false) false) false)
                (if (= key part-key)
                  (recur (rest remaining) (+ ordinal 1) output survivors (conj seen part-key) part ordinal)
                  (let [next-index (count output) derived-coordinate (+ 1 (* 2 next-index))
                        derived (assoc part :coordinate derived-coordinate)]
                    (recur (rest remaining) (+ ordinal 1) (conj output derived)
                      (conj survivors {:input-entry-index ordinal :input-coordinate coordinate
                                       :output-entry-index next-index :output-coordinate derived-coordinate
                                       :source-part part}) (conj seen part-key) removed removed-index)))
                {:status :rejected :reason :map-removal-input-shape-required :work-count work}))))
        {:status :rejected :reason :map-removal-input-shape-required :work-count work}))))

(defn body-mr-finish [header input transition used]
  (let [call (get header :source-call) args (get call :argument-node-ids)
        normal? (= :normal (get header :application)) id (get header :call-core-node-id)
        change (if normal? (get transition :transition) nil)
        type (if normal? (get transition :type) :gravity.type/never)
        ancestry {:source-call call :source-edge (get header :source-edge) :source-binding (get header :source-binding)
                  :input-node-id (get args 0) :key-node-id (get args 1) :input-shape input :transition change}
        size (+ 1 (get input :shape-size 0))
        shape (if normal?
                {:status :accepted :shape-kind :map :type type :node-id id :source (get header :source)
                 :constructor-origin :persistent-map-removal :coordinate-system :ordered-map-entry-value-slots
                 :binding-links [] :parts (get change :parts) :removal ancestry :shape-size size
                 :call-join-work used :call-links (get input :call-links [])}
                {:status :accepted :shape-kind :scalar :type :gravity.type/never :node-id id :source (get header :source)
                 :binding-links [] :removal ancestry :shape-size size :call-join-work used})]
    {:descriptor (assoc header :input-shape input :transition change :result-shape (if normal? shape nil)
                   :parameter-types (get header :argument-types) :return type :result-type type)
     :shape shape :type type :shape-size size}))


(defn body-st-selected-context [selected request facts bindings core node-index call-index edge-index]
  (let [forms (body-path request [:b47-context :authenticated-core-request :forms])
        form-index (if (vector? forms)
                     (body-vemp-index forms :form-id)
                     {:status :rejected})]
    (if (vector? forms)
      (if (= :accepted (get form-index :status))
        (let [nodes (get node-index :index)]
          (loop [remaining selected checks {}]
            (if (= 0 (count remaining))
              {:status :accepted
               :context {:forms (get form-index :index)
                         :nodes nodes
                         :calls (get call-index :index)
                         :edges (get edge-index :index)
                         :bindings bindings
                         :checks checks}}
              (let [call (first remaining)
                    node (get nodes (get call :core-node-id))
                    lset? (body-lset-entry? node call nodes bindings (get facts :type-table) (get core :module))]
                (if lset?
                  (let [result (body-lset-evidence core (get facts :constraint-ledger)
                                                 (get facts :call-type-facts) node call
                                                 (get (get edge-index :index) (get call :core-node-id))
                                                 nodes bindings (get facts :type-table))]
                    (if (= :accepted (get result :status))
                      (let [next-checks (assoc checks (get call :core-node-id) result)]
                        (recur (rest remaining) next-checks))
                      (body-failure :body-list-set-conversion-source-mismatch)))
                  (if (body-vemp-ids? node call nodes bindings (get core :module))
                    (let [args (get call :argument-node-ids)
                          binding (get bindings (get call :operator-binding-id))
                          source-valid? (if (body-nq-ids? node call nodes bindings (get core :module))
                                          (body-st-binding? binding (get core :module))
                                          false)]
                      (if source-valid?
                        (let [type (get (get facts :type-table) (first args) :gravity.type/unknown)
                              validation (body-st-type-check [type])]
                          (if (= :accepted (get validation :status))
                            (let [next-checks (assoc checks (get call :core-node-id)
                                                     {:argument-type type :validation validation})]
                              (recur (rest remaining) next-checks))
                            (body-failure :body-set-conversion-operand-type-required)))
                        (body-failure :body-set-conversion-source-mismatch)))
                    (body-failure :body-set-conversion-arity-mismatch)))))))
        (body-failure :body-set-conversion-source-forms-required))
      (body-failure :body-set-conversion-source-forms-required))))

(defn body-st-context [request facts bindings]
  (let [request-valid? (if (map? request)

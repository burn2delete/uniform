            (if (contains? table id) {:status :rejected}
              (recur (+ index 1) (if (= target id) (conj items row) items) (assoc table id row)))
            {:status :rejected})))) {:status :rejected}))

(defn body-pmk-row-census [core ledger nodes bindings types forms calls edges target descriptor]
  (loop [index 0 items [] seen #{} descriptors {}]
    (if (= index (count ledger))
      {:status :accepted :items items :descriptors descriptors}
      (let [row (get ledger index) producer (if (map? row) (get row :producer-rule) nil)]
        (if (if (map? row)
              (let [request (get row :constraint-id-request) domain (get request :domain)]
                (if (if (map? request) (keyword? domain) false)
                  (if (keyword? producer)
                    (if (= :gravity/sh08-private-map-keys-constraint-v1 domain) (= :sh08-private-map-keys-v1 producer) true)
                    (if (= nil producer) (= false (= :gravity/sh08-private-map-keys-constraint-v1 domain)) false)) false)) false)
          (if (if (keyword? producer) (= :sh08-private-map-keys-v1 producer) false)
            (let [lhs (get row :lhs) id (if (map? lhs) (get lhs :core-node-id) nil)]
              (if (body-sse-ids? [id] 1)
                (if (contains? seen id)
                  {:status :rejected :reason :private-map-keys-source-mismatch}
                  (let [source-call (get calls id) source-edge (get edges id) source-node (get nodes id)
                        result (if (= target id) {:status :accepted :descriptor descriptor}
                                 (body-pmk-header core source-node source-call source-edge nodes bindings types forms))
                        canonical (get result :descriptor)]
                    (if (= :accepted (get result :status))
                      (if (if (body-mkeys-ids? source-node source-call nodes bindings (get core :module))
                            (if (= canonical (get types (get source-call :operator-node-id)))
                              (= (body-pmk-constraint canonical) row) false) false)
                        (recur (+ index 1) (if (= target id) (conj items row) items)
                               (conj seen id) (assoc descriptors id canonical))
                        {:status :rejected :reason :private-map-keys-source-mismatch})
                      {:status :rejected :reason (get result :reason)})))
                {:status :rejected :reason :private-map-keys-source-mismatch}))
            (recur (+ index 1) items seen descriptors))
          {:status :rejected :reason :private-map-keys-source-mismatch})))))

(defn body-pmk-fact-census [facts module descriptors target]
  (loop [remaining (if (map? facts) (keys facts) facts) index 0 items [] seen #{}]
    (if (= index (count facts))
      (if (= (set (keys descriptors)) seen) {:status :accepted :items items}
        {:status :rejected :reason :private-map-keys-source-mismatch})
      (let [entry (first remaining) fact (if (map? facts) (if (body-sse-ids? [entry] 1) (get facts entry) nil) entry)
            id (if (map? fact) (get fact :call-core-node-id) nil)
            dispatch (if (map? fact) (get fact :dispatch) nil)]
        (if (if (body-sse-ids? [id] 1) (if (map? facts) (= entry id) true) false)
          (if (let [request (get fact :fact-id-request) domain (get request :domain)]
                (if (if (map? request) (keyword? domain) false)
                  (if (keyword? dispatch)
                    (if (= :gravity/sh08-private-map-keys-call-type-fact-v1 domain) (= :direct-private-map-keys dispatch) true)
                    (if (= nil dispatch)
                      (if (= false (= :gravity/sh08-private-map-keys-call-type-fact-v1 domain))
                        (body-sse-ids? [(get fact :callee-function-syntax-id)] 1) false) false)) false))
            (if (if (keyword? dispatch) (= :direct-private-map-keys dispatch) false)
              (if (contains? seen id) {:status :rejected :reason :private-map-keys-source-mismatch}
                (let [canonical (get descriptors id)]
                  (if (if (map? canonical) (= (body-pmk-call-fact canonical module) fact) false)
                    (recur (rest remaining) (+ index 1) (if (= target id) (conj items fact) items) (conj seen id))
                    {:status :rejected :reason :private-map-keys-source-mismatch})))
              (recur (rest remaining) (+ index 1) items seen))
            {:status :rejected :reason :private-map-keys-source-mismatch})
          {:status :rejected :reason :private-map-keys-source-mismatch})))))

(defn body-pmk-evidence [core ledger facts node call edge nodes bindings types forms]
  (if (if (vector? ledger) (if (if (vector? facts) true (map? facts))
                          (if (vector? (get core :calls)) (vector? (get core :call-edges)) false) false) false)
    (let [derived (body-pmk-header core node call edge nodes bindings types forms)]
      (if (= :accepted (get derived :status))
        (let [id (get node :node-id) descriptor (get derived :descriptor)
              original-calls (body-pmk-originals (get core :calls) :core-node-id id)
              original-edges (body-pmk-originals (get core :call-edges) :call-core-node-id id)]
          (if (body-all? [(= :accepted (get original-calls :status)) (= :accepted (get original-edges :status))
                          (= [call] (get original-calls :items)) (= [edge] (get original-edges :items))])
            (let [rows (body-pmk-row-census core ledger nodes bindings types forms (get original-calls :index) (get original-edges :index)
                                            id descriptor)]
              (if (= :accepted (get rows :status))
                (let [calls (body-pmk-fact-census facts (get core :module) (get rows :descriptors) id)]
                  (if (if (= :accepted (get calls :status))
                        (if (= [(body-pmk-constraint descriptor)] (get rows :items))
                          (= [(body-pmk-call-fact descriptor (get core :module))] (get calls :items)) false) false)
                    (let [entries (body-pmk-entry-evidence core ledger facts descriptor nodes bindings types)]
                      (if (= :accepted (get entries :status))
                        {:status :accepted :descriptor descriptor}
                        {:status :rejected :reason (get entries :reason)}))
                    {:status :rejected :reason :private-map-keys-source-mismatch}))
                {:status :rejected :reason (get rows :reason)}))
            {:status :rejected :reason :private-map-keys-source-mismatch}))
        derived))
    {:status :rejected :reason :private-map-keys-source-mismatch}))

(defn body-pmk-forms? [node call nodes forms]
  (let [owner (get forms (get (get node :source) :form-id)) ids (get owner :child-form-ids)]
    (if (body-sse-ids? ids 2)

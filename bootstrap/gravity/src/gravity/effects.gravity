              (get binding :target-set)]
             (if
              (if
               (body-sse-ids?
                [(get owner :form-id)
                 (get owner :syntax-id)
                 (get op-form :form-id)
                 (get op-form :syntax-id)
                 (get right-form :form-id)
                 (get right-form :syntax-id)]
                6)
               (if
                (body-sse-ids? (get owner :child-form-ids) 3)

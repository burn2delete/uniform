     :complete-immutable-imported-signatures :imported-operator-and-call-types :local-inference-remains-separate
     :origin-and-signature-bound-constraint-ledger :producer-declarations-preserved-with-pending-imported-effects
     :canonical-producer-and-import-order :source-syntax-origin-links-preserved :path-neutral-identity-input]
    (if (body-higher-order? typed)
    [:coherent-b47-function-records :coherent-b47-call-edges :coherent-b47-recursion-components :coherent-b47-lexical-bindings
     :fixed-arity-first-order-inference :capture-free-higher-order-one-hop-inference :canonical-complete-function-signatures
     :higher-order-proof :higher-order-inner-and-outer-call-facts :local-binding-facts :call-type-facts :constraint-ledger
     :source-syntax-origin-generated-origin-links-preserved :path-neutral-identity-input :recursive-inference-rejected-without-annotation]
    (if (body-recursive? typed)
    [:coherent-b47-function-records :coherent-b47-call-edges :coherent-b47-recursion-components :coherent-b47-lexical-bindings
     :named-self-recursive-positive-fixed-arity-positional-literal-base-proof :concrete-recursive-base-and-parameter-evidence
     :monotone-bounded-recursive-fixed-point :recursive-call-facts :recursive-constraint-ledger :canonical-complete-function-signatures
     :source-syntax-origin-generated-origin-links-preserved :path-neutral-identity-input]
    [:coherent-b47-function-records :coherent-b47-call-edges :coherent-b47-recursion-components
     :coherent-b47-lexical-bindings :fixed-arity-first-order-inference :local-binding-facts
     :call-type-facts :constraint-ledger :source-syntax-origin-generated-origin-links-preserved
     :path-neutral-identity-input :recursive-inference-rejected-without-annotation]))))))

(defn body-import-tables-valid? [typed]
  (loop [tables [(get typed :module-type-producers) (get typed :imported-function-types)]]
    (if (= 0 (count tables)) true
      (let [table (first tables)]
        (if (vector? table)
          (if (loop [entries table]
                (if (= 0 (count entries)) true
                  (if (map? (first entries)) (recur (rest entries)) false)))
            (recur (rest tables)) false) false)))))

(defn body-input-valid? [typed verification binding]
  (if (sh09-exact-keys? typed (body-top-level-keys typed))
    (if (body-all?
          [(= :gravity/sh08-function-typed-core-template (get typed :artifact))
           (= 3 (get typed :schema-version)) (= :accepted (get typed :status))
           (contains? #{:first-order-fixed-arity-functions-locals-calls :direct-imported-functions-types-only
                        :bounded-named-self-recursive-positive-fixed-arity-positional-literal-base
                        :declared-monomorphic-named-self-value :private-inferred-monomorphic-named-self-value
                        :capture-free-higher-order-fixed-arity-one-hop} (get typed :scope))
           (= :host-resolved-b47-verification-boundary (get typed :authentication-status))
           (= [] (get typed :diagnostics))
           (= (get typed :artifact-id-request) (get typed :identity-input))
           (= (body-caller-identity typed) (get typed :identity-input))
           (= (body-caller-typed-core typed) (get typed :typed-core))
           (= :gravity/sh08-function-type-verification (get verification :artifact))
           (= :passed (get verification :status))
           (= typed (get verification :expected) (get verification :candidate))
           (= (body-caller-checks typed) (get verification :checks))
           (= :meta (get (get typed :module) :profile)) (= :jvm (get (get typed :module) :target))
           (vector? (get (get typed :module) :effects)) (vector? (get (get typed :module) :capabilities))])
      (if (if (body-imported? typed)
            (body-import-tables-valid? typed) true)
      (if (if (body-higher-order? typed)
            (if (body-ho-proof-shape? (get typed :higher-order-proof))
              (= (get typed :higher-order-call-facts) (body-ho-call-proof-facts (get typed :higher-order-proof))) false) true)
      (if (if (body-recursive? typed)
            (if (map? (get typed :recursive-proof))
              (= (get typed :recursive-call-facts) (body-recursive-call-facts (get typed :identity-input))) false) true)
      (if (body-binding-envelope-valid? typed verification binding)
        (body-caller-request-valid? (body-path binding [:digest-resolution :preimage :request]) typed) false) false) false) false) false) false))

(defn body-reachable [roots nodes]
  (loop [pending roots seen #{}]
    (if (= 0 (count pending)) seen
      (let [id (first pending) node (get nodes id)]
        (if (contains? seen id) (recur (rest pending) seen)
          (if (map? node) (recur (body-add (get node :children) (vec (rest pending))) (conj seen id)) nil))))))

(defn body-node-shapes? [nodes]
  (loop [remaining nodes]
    (if (= 0 (count remaining)) true
      (if (if (map? (first remaining))
            (body-all? [(vector? (get (first remaining) :children)) (map? (get (first remaining) :source))
                        (map? (get (first remaining) :evaluation))
                        (vector? (get (get (first remaining) :evaluation) :order))]) false)
        (recur (rest remaining)) false))))

(defn body-maps? [records]
  (if (vector? records)
    (loop [remaining records]
      (if (= 0 (count remaining)) true
        (if (map? (first remaining)) (recur (rest remaining)) false))) false))

(defn body-first-order-value-type? [type]
  (loop [pending [[type []]]]
    (if (= 0 (count pending)) true
      (let [index (- (count pending) 1)
            frame (get pending index)
            item (get frame 0)
            ancestors (get frame 1)
            next (subvec pending 0 index)]
        (if (if (body-ni-valid-view? item)
              (if (map? item) (= :gravity/c7-function-type (get item :artifact)) false)
              true)
          false
          (if (if (map? item)
                (body-lc-ancestor? item ancestors)
                (if (if (vector? item) true (if (set? item) true (seq? item)))
                  (body-lc-ancestor? item ancestors)
                  false))
            false
            (recur
              (if (map? item)
                (loop [fields (keys item) result next]
                  (if (= 0 (count fields)) result
                    (recur (rest fields)
                      (conj result [(get item (first fields)) (conj ancestors item)]))))
                (if (if (vector? item) true (if (set? item) true (seq? item)))
                  (loop [remaining item result next]
                    (if (= 0 (count remaining)) result
                      (recur (rest remaining)
                        (conj result [(first remaining) (conj ancestors item)]))))
                  next)))))))))

(defn body-first-order-parameters? [parameters]
  (loop [remaining parameters]
    (if (= 0 (count remaining)) true
      (if (body-first-order-value-type? (get (first remaining) :type))
        (recur (rest remaining)) false))))

(defn body-failure [reason]
  {:status :rejected :reason reason})

(defn body-producer-entries [request facts]
  (let [requests (body-path request [:module-type-inputs :module-requests])
        identities (get facts :module-type-producers)
        retained (body-path request [:b47-context :authenticated-wrapper :sh06-resolution-artifact
                                     :gravity-resolution-boundary :module-inputs :module-artifacts])]
    (loop [remaining requests entries []]
      (if (= 0 (count remaining))
        (if (= (count entries) (count identities)) {:status :accepted :entries entries}
          (body-failure :producer-request-identity-coverage))
        (let [producer (first remaining)
              c5 (body-path producer [:b47-context :authenticated-wrapper :sh06-resolution-artifact])
              c5-id (get c5 :artifact-id) core (get producer :canonical-core-artifact)
              identity (body-by identities :producer-sh06-artifact-id c5-id)
              producer-facts (get identity :identity-input)
              prior (body-by entries :producer-sh06-artifact-id c5-id)]
          (if (map? prior)
            (if (= producer (get prior :request)) (recur (rest remaining) entries)
              (body-failure :conflicting-producer-requests))
            (if (contains? #{:gravity/sh08-private-self-value-typed-core-v1 :gravity/sh08-indexed-private-self-value-typed-core-v1} (get producer-facts :domain))
              (body-failure :private-self-imported-producer-pending)
            (if (body-all?
                  [(sh09-sha256-id? c5-id) (map? identity) (map? producer-facts)
                   (sh09-exact-keys? identity #{:producer-sh06-artifact-id :producer-sh07-artifact-id :identity-input})
                   (sh09-exact-keys? producer-facts
                     (let [keys #{:domain :sh07-shaped-artifact-id :module :function-records :call-edges :recursion-components
                       :lexical-bindings :function-type-table :local-binding-facts :call-type-facts :constraint-ledger
                       :type-table :convergence :pending}]
                       (if (contains? producer-facts :recursive-proof) (conj keys :recursive-proof)
                         (if (contains? producer-facts :higher-order-proof) (conj keys :higher-order-proof) keys))))
                   (sh09-exact-keys? producer #{:canonical-core-artifact :b47-context :coordinator-verification})
                   (contains? #{:gravity/sh08-function-typed-core-v3 :gravity/sh08-atomic-function-signature-typed-core-v1
                                :gravity/sh08-declared-self-value-typed-core-v1
                                :gravity/sh08-recursive-function-typed-core-v1 :gravity/sh08-authoritative-higher-order-type-v1}
                              (get producer-facts :domain))
                   (= (contains? producer-facts :recursive-proof)
                      (contains? #{:gravity/sh08-recursive-function-typed-core-v1 :gravity/sh08-declared-self-value-typed-core-v1} (get producer-facts :domain)))
                   (= (contains? producer-facts :higher-order-proof) (= :gravity/sh08-authoritative-higher-order-type-v1 (get producer-facts :domain)))
                   (= (get identity :producer-sh07-artifact-id) (get core :artifact-id)
                      (get producer-facts :sh07-shaped-artifact-id))
                   (= c5 (body-by retained :artifact-id c5-id))
                   (= [] (body-path c5 [:gravity-resolution-boundary :module-inputs :module-artifacts]))
                   (= c5-id (body-path producer [:b47-context :authenticated-core-request :lineage :authenticated-sh06-artifact-id]))
                   (body-request-envelope-valid? producer (get identity :producer-sh07-artifact-id) (get core :provenance))])
              (recur (rest remaining)
                (conj entries {:producer-sh06-artifact-id c5-id :producer-sh07-artifact-id (get core :artifact-id)
                               :module-key [c5-id (get core :artifact-id)] :request producer :facts producer-facts}))
              (body-failure :untrusted-or-transitive-body-producer)))))))))

(defn body-module-vectors-valid? [core facts entries]
  (loop [remaining (conj entries {:request {:canonical-core-artifact core} :facts facts})]
    (if (= 0 (count remaining)) true
      (let [entry (first remaining) ns (body-path entry [:request :canonical-core-artifact :nodes])
            fs (body-path entry [:facts :function-type-table])]
        (if (if (vector? ns) (vector? fs) false)
          (recur (rest remaining)) false)))))

(defn body-import-coordinate [proof]
  {:binding-id (get proof :binding-id) :producer-sh06-artifact-id (get proof :producer-sh06-artifact-id)
   :producer-sh07-artifact-id (get proof :producer-sh07-artifact-id)
   :definition-binding-id (get proof :definition-binding-id)
   :function-id (get (get proof :function-type) :function-id)})

(defn body-import-origin [request binding entry proof]
  (let [producer (get entry :request) facts (get entry :facts)
        caller-c5 (body-path request [:b47-context :authenticated-wrapper :sh06-resolution-artifact])
        callee-c5 (body-path producer [:b47-context :authenticated-wrapper :sh06-resolution-artifact])
        origin (get binding :semantic-span)
        caller-row (body-by (body-path caller-c5 [:binding-table :bindings]) :binding-id (get binding :upstream-binding-id))
        original (body-by (body-path callee-c5 [:binding-table :bindings]) :binding-id (get origin :origin-binding-id))
        projected (body-by (body-path producer [:b47-context :authenticated-core-request :binding-table]) :upstream-binding-id (get original :binding-id))
        record (body-by (body-path producer [:canonical-core-artifact :function-records]) :definition-binding-id (get projected :binding-id))
        function (body-by (get facts :function-type-table) :function-id (get record :function-syntax-id))
        module (body-path callee-c5 [:gravity-resolution-boundary :resolved-analysis :module-contract])
        caller-module (body-path request [:canonical-core-artifact :module])]
    (if (body-all?
          [(map? caller-row) (map? original) (map? projected) (map? record) (map? function)
           (body-function-shapes? [function])
           (sh09-exact-keys? proof #{:status :binding-id :origin :producer-sh07-artifact-id :producer-sh06-artifact-id
                                    :definition-binding-id :function-type :effect-status :legality-status})
           (= :accepted (get proof :status))
           (= (get entry :producer-sh06-artifact-id) (get origin :ordinary-module-artifact-id) (get callee-c5 :artifact-id))
           (= origin (get caller-row :semantic-span) (get proof :origin))
           (= :import (get binding :binding-class) (get caller-row :binding-class))
           (= :namespace (get original :binding-class)) (= :function (get original :kind))
           (= :public (get original :visibility) (get binding :visibility))
           (= (get binding :name) (get original :name))
           (= (get binding :namespace) (get original :namespace) (get module :namespace))
           (= (get binding :package) (get original :package) (get module :package))
           (contains? (set (get module :exports)) (get original :name))
           (= (get origin :origin-analysis-id) (body-path callee-c5 [:gravity-resolution-boundary :resolved-analysis :artifact-id]))
           (= (get origin :origin-definition-artifact-id) (get original :definition-artifact-id))
           (= (get origin :origin-definition-syntax-id) (get original :definition-syntax-id))
           (= (get origin :origin-definition)
              (body-project original [:name :kind :namespace :package :visibility :profile-set :target-set :type-ref :effects :capabilities :safety]))
           (= [(get caller-module :profile) (get caller-module :target)] [(get module :profile) (get module :target)])
           (= (get proof :binding-id) (get binding :binding-id))
           (= (get proof :producer-sh06-artifact-id) (get entry :producer-sh06-artifact-id))
           (= (get proof :producer-sh07-artifact-id) (get entry :producer-sh07-artifact-id))
           (= (get proof :definition-binding-id) (get projected :binding-id))
           (= (get proof :function-type)
              (body-project function [:artifact :function-id :function-core-node-id :body-core-node-id :definition-name
                                      :parameter-binding-ids :parameters :return :fixed-arity :signature :latent-effects
                                      :capabilities :ownership-constraints :profile-constraints :thrown-error-effects :status]))
           (= :pending-sh09-imported-body (get proof :effect-status)) (= :pending-imported-effects (get proof :legality-status))])
      {:coordinate (body-import-coordinate proof) :module-key (get entry :module-key) :binding binding
       :function function :body-core-node-id (get function :body-core-node-id)} nil)))

(defn body-function-shapes? [functions]
  (if (body-maps? functions)
    (loop [remaining functions]
      (if (= 0 (count remaining)) true
        (let [function (first remaining)]
          (if (body-all? [(vector? (get function :parameters)) (vector? (get function :parameter-binding-ids))
                          (vector? (get function :latent-effects)) (vector? (get function :capabilities))])
            (if (if (body-first-order-value-type? (get function :return))
                  (body-first-order-parameters? (get function :parameters)) false)
              (recur (rest remaining)) false) false)))) false))

(defn body-ho-proof-shape? [proof]
  (if (map? proof)
    (body-all? [(map? (get proof :inner-edge)) (map? (get proof :outer-edge))
                (map? (get proof :identity-function-type)) (map? (get proof :apply-function-type))
                (vector? (get proof :inner-argument-node-ids)) (vector? (get proof :outer-argument-node-ids))
                (sh09-sha256-id? (get proof :inner-call-core-node-id))
                (sh09-sha256-id? (get proof :outer-call-core-node-id))
                (sh09-sha256-id? (get proof :identity-function-syntax-id))
                (sh09-sha256-id? (get proof :apply-function-syntax-id))]) false))

(defn body-ho-call-proof-facts [proof]
  [{:role :inner-indirect-call :call-core-node-id (get proof :inner-call-core-node-id)
    :caller-function-syntax-id (get proof :apply-function-syntax-id)
    :callee-function-syntax-id (get (get proof :inner-edge) :callee-function-syntax-id)
    :selected-identity-function-syntax-id (get proof :identity-function-syntax-id)
    :operator-binding-id (get proof :inner-operator-binding-id)
    :callable-parameter-binding-id (get proof :apply-callable-binding-id)
    :argument-node-ids (get proof :inner-argument-node-ids) :argument-value-binding-id (get proof :apply-value-binding-id)
    :evaluation-order (get proof :inner-evaluation-order) :source-span (get proof :inner-source-span)
    :b47-edge (get proof :inner-edge) :result-type (get proof :inner-result-type) :dispatch :indirect-function-value}
   {:role :outer-direct-call :call-core-node-id (get proof :outer-call-core-node-id) :caller-function-syntax-id nil
    :callee-function-syntax-id (get proof :apply-function-syntax-id) :operator-binding-id (get proof :outer-operator-binding-id)
    :argument-node-ids (get proof :outer-argument-node-ids) :value-argument-node-id (get proof :outer-value-argument-node-id)
    :evaluation-order (get proof :outer-evaluation-order) :source-span (get proof :outer-source-span)
    :outer-edge (get proof :outer-edge) :b47-edge (get proof :outer-edge)
    :selected-apply-function-syntax-id (get proof :apply-function-syntax-id)
    :result-type (get proof :outer-result-type) :dispatch :direct-local-function}])

(defn body-ho-function-type [function]
  (body-project function [:artifact :function-id :function-core-node-id :body-core-node-id :definition-name
                         :parameter-binding-ids :parameters :return :return-conflict :fixed-arity :latent-effects
                         :capabilities :ownership-constraints :profile-constraints :thrown-error-effects :source-span
                         :syntax-id :origin-chain :generated-origin :profile :target :status]))

(defn body-ho-input-shapes? [core facts]
  (if (body-all? [(body-ho-proof-shape? (get facts :higher-order-proof))
                  (body-maps? (get core :nodes)) (body-maps? (get core :function-records))
                  (body-maps? (get core :definitions)) (body-maps? (get core :calls))
                  (body-maps? (get core :call-edges)) (body-maps? (get facts :function-type-table))])
    (body-all?
      [(body-node-shapes? (get core :nodes))
       (loop [records (get core :function-records)]
         (if (= 0 (count records)) true
           (if (vector? (get (first records) :parameter-binding-ids)) (recur (rest records)) false)))
       (loop [calls (get core :calls)]
         (if (= 0 (count calls)) true
           (if (vector? (get (first calls) :argument-node-ids)) (recur (rest calls)) false)))]) false))

(defn body-function-shapes-with-proof? [facts]
  (let [proof (get facts :higher-order-proof) functions (get facts :function-type-table)]
    (if (contains? facts :higher-order-proof)
      (if (if (body-ho-proof-shape? proof) (body-maps? functions) false)
        (loop [remaining functions]
          (if (= 0 (count remaining)) true
            (let [function (first remaining)]
              (if (= (get function :function-id) (get proof :apply-function-syntax-id))
                (if (if (vector? (get function :parameters)) (= 2 (count (get function :parameters))) false)
                  (if (body-all? [(body-first-order-value-type? (get function :return))
                                  (vector? (get function :latent-effects)) (vector? (get function :capabilities))
                                  (= (get proof :apply-callable-binding-id) (get (first (get function :parameters)) :binding-id))
                                  (= (get proof :identity-function-type) (get (first (get function :parameters)) :type))
                                  (body-first-order-value-type? (get (get (get function :parameters) 1) :type))])
                    (recur (rest remaining)) false) false)
                (if (body-function-shapes? [function]) (recur (rest remaining)) false))))) false)
      (body-function-shapes? functions))))

(defn body-ho-proof-valid? [core facts bindings]
  (let [proof (get facts :higher-order-proof)]
    (if (body-ho-input-shapes? core facts)
      (let [nodes (body-index (get core :nodes) :node-id)
            identity (body-by (get core :function-records) :function-syntax-id (get proof :identity-function-syntax-id))
            apply (body-by (get core :function-records) :function-syntax-id (get proof :apply-function-syntax-id))
            identity-type (body-by (get facts :function-type-table) :function-id (get identity :function-syntax-id))
            apply-type (body-by (get facts :function-type-table) :function-id (get apply :function-syntax-id))
            inner (body-by (get core :calls) :core-node-id (get proof :inner-call-core-node-id))
            outer (body-by (get core :calls) :core-node-id (get proof :outer-call-core-node-id))
            inner-node (get nodes (get inner :core-node-id)) outer-node (get nodes (get outer :core-node-id))
            inner-edge (body-by (get core :call-edges) :call-core-node-id (get inner :core-node-id))
            outer-edge (body-by (get core :call-edges) :call-core-node-id (get outer :core-node-id))
            identity-body (get nodes (get identity :body-core-node-id))
            inner-operator (get nodes (first (get inner-node :children)))
            inner-argument (get nodes (first (get inner :argument-node-ids)))
            selected-node (get nodes (first (get outer :argument-node-ids)))
            value-node (get nodes (get (get outer :argument-node-ids) 1))
            value-type (body-primitive-literal-type value-node)
            expected {:domain :gravity/sh08-authoritative-higher-order-proof-v1
              :identity-function-syntax-id (get identity :function-syntax-id) :identity-function-core-node-id (get identity :function-core-node-id)
              :identity-definition-binding-id (get identity :definition-binding-id)
              :identity-parameter-binding-id (first (get identity :parameter-binding-ids)) :identity-body-core-node-id (get identity :body-core-node-id)
              :apply-function-syntax-id (get apply :function-syntax-id) :apply-function-core-node-id (get apply :function-core-node-id)
              :apply-definition-binding-id (get apply :definition-binding-id)
              :apply-callable-binding-id (first (get apply :parameter-binding-ids))
              :apply-value-binding-id (get (get apply :parameter-binding-ids) 1) :apply-body-core-node-id (get apply :body-core-node-id)
              :inner-call-core-node-id (get inner :core-node-id) :inner-operator-binding-id (get inner :operator-binding-id)
              :inner-argument-node-ids (get inner :argument-node-ids) :inner-evaluation-order (get inner :evaluation-order)
              :inner-source-span (get (get inner-node :source) :semantic-span) :inner-edge (body-edge-projection inner-edge)
              :outer-call-core-node-id (get outer :core-node-id) :outer-operator-binding-id (get outer :operator-binding-id)
              :outer-argument-node-ids (get outer :argument-node-ids) :outer-evaluation-order (get outer :evaluation-order)
              :outer-source-span (get (get outer-node :source) :semantic-span) :outer-edge (body-edge-projection outer-edge)
              :outer-value-argument-node-id (get value-node :node-id) :outer-value-literal-kind (get (get value-node :attributes) :literal-kind)
              :identity-parameter-type value-type :apply-callable-parameter-type (body-ho-function-type identity-type)
              :apply-value-parameter-type value-type :identity-function-type (body-ho-function-type identity-type)
              :apply-function-type (body-ho-function-type apply-type) :inner-result-type value-type :outer-result-type value-type}]
        (if (body-all? [(vector? (get identity :parameter-binding-ids)) (vector? (get apply :parameter-binding-ids))
                        (vector? (get inner :argument-node-ids)) (vector? (get outer :argument-node-ids))])
          (body-all?
            [(= expected proof) (= [] (get core :recursion-components))
             (= :named-top-level (get identity :definition-kind) (get apply :definition-kind))
             (= 1 (get identity :fixed-arity) (count (get identity :parameter-binding-ids)) (count (get inner :argument-node-ids)))
             (= 2 (get apply :fixed-arity) (count (get apply :parameter-binding-ids)) (count (get outer :argument-node-ids)))
             (contains? #{:gravity.type/integer :gravity.type/bool :gravity.type/string} value-type)
             (= (get identity-type :parameters) [{:binding-id (get proof :identity-parameter-binding-id) :type value-type}])
             (= value-type (get identity-type :return) (get apply-type :return))
             (= (get apply-type :parameters) [{:binding-id (get proof :apply-callable-binding-id) :type (get proof :identity-function-type)}
                                             {:binding-id (get proof :apply-value-binding-id) :type value-type}])
             (= (get apply :body-core-node-id) (get inner-node :node-id))
             (= :reference (get identity-body :core-form) (get inner-operator :core-form) (get inner-argument :core-form) (get selected-node :core-form))
             (= (get proof :identity-parameter-binding-id) (get (get identity-body :attributes) :binding-id))
             (= (get identity :function-syntax-id) (get (get identity-body :evaluation) :owner-function-syntax-id))
             (= (get proof :apply-callable-binding-id) (get inner :operator-binding-id) (get inner-edge :callee-binding-id)
                (get (get inner-operator :attributes) :binding-id))
             (= (get proof :apply-value-binding-id) (get (get inner-argument :attributes) :binding-id))
             (= (get apply :function-syntax-id) (get (get inner-node :evaluation) :owner-function-syntax-id)
                (get (get inner-operator :evaluation) :owner-function-syntax-id) (get (get inner-argument :evaluation) :owner-function-syntax-id)
                (get inner-edge :caller-function-syntax-id))
             (= :nonlocal-or-nonfunction (get inner-edge :classification))
             (= nil (get inner-edge :callee-function-syntax-id) (get inner-edge :callee-function-core-node-id))
             (= (get inner-edge :callee-definition-syntax-id) (get (get bindings (get proof :apply-callable-binding-id)) :definition-syntax-id))
             (= (get proof :identity-definition-binding-id) (get (get selected-node :attributes) :binding-id))
             (= (get proof :apply-definition-binding-id) (get outer :operator-binding-id))
             (= nil (get (get outer-node :evaluation) :owner-function-syntax-id) (get outer-edge :caller-function-syntax-id))]) false)) false)))

(defn body-edge-projection [edge]
  (if (map? edge)
    (body-project edge [:ordinal :call-core-node-id :caller-function-syntax-id :caller-function-core-node-id
                       :callee-binding-id :callee-definition-syntax-id :callee-function-syntax-id :callee-function-core-node-id
                       :argument-core-node-ids :ordered-evaluation-node-ids :evaluation-order :classification]) nil))

(defn body-recursive-call-facts [facts]
  (if (body-rv? facts) (body-ds-call-facts facts)
  (let [proof (get facts :recursive-proof) calls (get facts :call-type-facts)
        recursive-id (get proof :recursive-call-core-node-id)
        external-id (get proof :parameter-evidence-call-core-node-id)]
    (if (if (body-maps? calls)
          (body-all? [(vector? (get proof :parameter-types)) (sh09-sha256-id? recursive-id) (sh09-sha256-id? external-id)]) false)
      (let [recursive (body-by calls :call-core-node-id recursive-id)
            external (body-by calls :call-core-node-id external-id)]
      (if (body-all? [(map? recursive) (map? external)
                      (= recursive-id (get recursive :call-core-node-id)) (= external-id (get external :call-core-node-id))])
      [(assoc recursive
         :role :self-recursive-call :recursive-definition-binding-id (get proof :definition-binding-id)
         :b47-edge (get proof :recursive-edge) :result-type (get proof :base-type) :dispatch :direct-named-self-recursion)
       (assoc external
         :role :external-parameter-evidence :parameter-evidence? true
         :external-edge (get (get proof :parameter-evidence-call) :edge)
         :argument-types (get proof :parameter-types) :result-type (first (get proof :parameter-types)))] nil)) nil))))

(defn body-primitive-literal-type [node]
  (if (= :literal (get node :core-form))
    (get {:nil :gravity.type/nil :boolean :gravity.type/bool :integer :gravity.type/integer
          :string :gravity.type/string :keyword :gravity.type/keyword :symbol :gravity.type/symbol}
         (get (get node :attributes) :literal-kind)) nil))

(defn body-recursive-input-shapes? [core facts]
  (let [proof (get facts :recursive-proof) components (get core :recursion-components)]
    (if (if (map? proof) (if (vector? components) (= 1 (count components)) false) false)
      (let [component (first components)]
        (if (body-all? [(map? component) (vector? (get component :function-syntax-ids))
                        (vector? (get component :function-core-node-ids))
                        (vector? (get component :internal-call-edge-ordinals))
                        (vector? (get proof :parameter-types)) (vector? (get core :calls))])
          (body-all?
            [(= 1 (count (get component :function-syntax-ids)) (count (get component :function-core-node-ids))
                  (count (get component :internal-call-edge-ordinals)))
             (integer? (first (get component :internal-call-edge-ordinals)))
             (loop [calls (get core :calls)]
               (if (= 0 (count calls)) true
                 (if (vector? (get (first calls) :argument-node-ids)) (recur (rest calls)) false)))]) false)) false)))

(defn body-recursive-positional? [ids parameters nodes owner]
  (if (if (vector? ids) (vector? parameters) false)
    (if (= (count ids) (count parameters))
      (loop [ids ids parameters parameters]
        (if (= 0 (count ids)) true
          (let [node (get nodes (first ids))]
            (if (body-all? [(= :reference (get node :core-form))
                            (= owner (get (get node :evaluation) :owner-function-syntax-id))
                            (= (first parameters) (get (get node :attributes) :binding-id))])
              (recur (rest ids) (rest parameters)) false)))) false) false))

(defn body-recursive-proof-valid? [core facts]
  (if (body-is? facts) (body-is-proof-valid? core facts)
  (if (body-ds? facts) (body-ds-proof-valid? core facts)
  (let [proof (get facts :recursive-proof) components (get core :recursion-components)]
    (if (body-recursive-input-shapes? core facts)
      (let [component (first components) id (first (get component :function-syntax-ids))
            record (body-by (get core :function-records) :function-syntax-id id)
            function (body-by (get facts :function-type-table) :function-id id)
            definition (body-by (get core :definitions) :binding-id (get record :definition-binding-id))
            nodes (body-index (get core :nodes) :node-id) module (get core :module)
            edge (get (get core :call-edges) (first (get component :internal-call-edge-ordinals)))
            call (body-by (get core :calls) :core-node-id (get edge :call-core-node-id))
            recursive-node (get nodes (get call :core-node-id)) source (get recursive-node :source)
            body (get nodes (get record :body-core-node-id)) base (get nodes (get proof :base-node-id))
            evidence-call (body-by (get core :calls) :core-node-id (get proof :parameter-evidence-call-core-node-id))
            evidence-edge (body-by (get core :call-edges) :call-core-node-id (get evidence-call :core-node-id))
            evidence-node (get nodes (get evidence-call :core-node-id)) evidence-source (get evidence-node :source)
            types (loop [ids (get evidence-call :argument-node-ids) result []]
                    (if (= 0 (count ids)) result
                      (recur (rest ids) (conj result (body-primitive-literal-type (get nodes (first ids)))))))
            expected {:domain :gravity/sh08-authoritative-recursive-proof-v1
                      :function-syntax-id id :function-core-node-id (get record :function-core-node-id)
                      :definition-binding-id (get definition :binding-id) :definition-syntax-id (get definition :syntax-id)
                      :parameter-binding-ids (get record :parameter-binding-ids) :fixed-arity (get record :fixed-arity)
                      :recursive-call-core-node-id (get call :core-node-id) :recursive-argument-node-ids (get call :argument-node-ids)
                      :recursive-edge (body-edge-projection edge)
                      :recursive-call-source {:syntax-id (get source :syntax-id) :source-span (get source :semantic-span)
                                              :origin-chain (get source :origin-chain) :generated-origin (get source :generated-origin)}
                      :recursive-call-profile (get module :profile) :recursive-call-target (get module :target)
                      :recursive-call-effects (get module :effects) :recursive-call-capabilities (get module :capabilities)
                      :base-node-id (get base :node-id) :base-type (body-primitive-literal-type base)
                      :recursive-definition-binding-id (get definition :binding-id)
                      :parameter-evidence-call-core-node-id (get evidence-call :core-node-id)
                      :parameter-evidence-call {:call-core-node-id (get evidence-call :core-node-id)
                        :caller-function-syntax-id (get evidence-edge :caller-function-syntax-id)
                        :callee-function-syntax-id (get evidence-edge :callee-function-syntax-id)
                        :argument-node-ids (get evidence-call :argument-node-ids)
                        :ordered-evaluation-node-ids (get evidence-call :ordered-evaluation-node-ids)
                        :evaluation-order (get evidence-call :evaluation-order) :argument-types types :result-type (first types)
                        :syntax-id (get evidence-source :syntax-id) :source-span (get evidence-source :semantic-span)
                        :origin-chain (get evidence-source :origin-chain) :generated-origin (get evidence-source :generated-origin)
                        :profile (get module :profile) :target (get module :target) :effects (get module :effects)
                        :capabilities (get module :capabilities) :edge (body-edge-projection evidence-edge)}
                      :parameter-types types :proof-bound :one-named-self-recursive-positive-fixed-arity-positional-literal-base
                      :captures? false :higher-order? false :monotone-fixed-point? true}]
        (if (if (integer? (get record :fixed-arity)) (> (get record :fixed-arity) 0) false)
          (body-all?
            [(= expected proof)
             (= {:ordinal 0 :kind :self-recursive :function-syntax-ids [id]
                 :function-core-node-ids [(get record :function-core-node-id)]
                 :internal-call-edge-ordinals [(get edge :ordinal)]} component)
             (= :named-top-level (get record :definition-kind))
             (= id (get edge :caller-function-syntax-id) (get edge :callee-function-syntax-id)
                (get (get recursive-node :evaluation) :owner-function-syntax-id))
             (= :local-function (get edge :classification) (get evidence-edge :classification))
             (= id (get evidence-edge :callee-function-syntax-id))
             (= nil (get evidence-edge :caller-function-syntax-id) (get evidence-edge :caller-function-core-node-id)
                (get (get evidence-node :evaluation) :owner-function-syntax-id))
             (= :if (get body :core-form))
             (= 3 (count (get body :children)))
             (= #{(get recursive-node :node-id) (get base :node-id)} (set (rest (get body :children))))
             (contains? #{:gravity.type/bool :gravity.type/integer :gravity.type/string} (get proof :base-type))
             (= (get proof :base-type) (get function :return) (first types))
             (= (get record :fixed-arity) (count types) (count (get record :parameter-binding-ids)))
             (loop [remaining types]
               (if (= 0 (count remaining)) true
                 (if (contains? #{:gravity.type/bool :gravity.type/integer :gravity.type/string} (first remaining))
                   (recur (rest remaining)) false)))
             (= types (loop [parameters (get function :parameters) result []]
                        (if (= 0 (count parameters)) result
                          (recur (rest parameters) (conj result (get (first parameters) :type))))))
             (body-recursive-positional? (get call :argument-node-ids) (get record :parameter-binding-ids) nodes id)
             (loop [remaining (get core :nodes)]
               (if (= 0 (count remaining)) true
                 (let [node (first remaining) binding (get (get node :attributes) :binding-id)]
                   (if (if (= id (get (get node :evaluation) :owner-function-syntax-id))
                         (if (= :reference (get node :core-form))
                           (contains? (conj (set (get record :parameter-binding-ids)) (get record :definition-binding-id)) binding) true) true)
              (recur (rest remaining)) false))))]) false)) false)))))

; C6 semantic identity replaces the authenticated SH06 occurrence id with its
; existing semantic projection id. All other throw fields remain exact.
(defn body-throw-semantic-record [projection record]
  (let [id (if (= projection nil) (get record :sh06-semantic-projection-id) projection)]
    (if (if (= id nil) false (= false (= nil (get record :authenticated-sh06-artifact-id))))
      (assoc record :authenticated-sh06-artifact-id id) record)))

(defn body-throw-source-record-valid? [core projection record]
  (let [lineage (get core :lineage) authenticated (get lineage :authenticated-sh06-artifact-id)]
    (body-all? [(if (= authenticated nil) true (= authenticated (get record :authenticated-sh06-artifact-id)))
                (if (= projection nil) true (= projection (get record :sh06-semantic-projection-id)))])))

(defn body-throw-semantic-nodes [core]
  (let [projection (get (get (get core :identity-preimage) :lineage) :sh06-semantic-projection-id)]
    (loop [remaining (get core :nodes) out []]
      (if (= 0 (count remaining)) out
        (let [node (first remaining)]
              (if (if (contains? #{:throw :try} (get node :core-form)) (body-throw-source-record-valid? core projection (get node :attributes)) true)
            (recur (rest remaining) (conj out (if (contains? #{:throw :try} (get node :core-form))
              (assoc node :attributes (body-throw-semantic-record projection (get node :attributes))) node))) nil))))))

(defn body-throw-semantic-transfers [core]
  (let [projection (get (get (get core :identity-preimage) :lineage) :sh06-semantic-projection-id)]
    (if (vector? (get core :error-transfers))
    (loop [remaining (get core :error-transfers) out []]
      (if (= 0 (count remaining)) out
        (if (body-throw-source-record-valid? core projection (first remaining))
          (recur (rest remaining) (conj out (body-throw-semantic-record projection (first remaining)))) nil))) nil)))

(defn body-shape-valid? [core typed]
  (let [nodes (get core :nodes) functions (get typed :function-type-table)
        records (get core :function-records) edges (get core :call-edges)
        calls (get core :calls) locals (get core :lexical-bindings)]
    (if (body-all? [(vector? nodes) (vector? functions) (vector? records) (vector? edges)
                    (vector? calls) (vector? locals) (map? (get typed :type-table))
                    (vector? (get typed :local-binding-facts)) (vector? (get typed :call-type-facts))
                    (vector? (get core :root-core-node-ids)) (vector? (get core :definitions))
                    (vector? (get core :match-branch-records)) (vector? (get core :evaluation-order))])
      (if (body-all? [(body-node-shapes? nodes) (body-function-shapes-with-proof? typed)
                      (body-maps? records) (body-maps? edges) (body-maps? calls)
                      (body-maps? locals) (body-maps? (get core :definitions))
                      (body-maps? (get core :match-branch-records))])
      (body-all?
        [(> (count nodes) 0)
         (= (count nodes) (count (body-index nodes :node-id)) (count (get typed :type-table)))
         (= (set (keys (body-index nodes :node-id))) (set (keys (get typed :type-table))))
         (= (count records) (count functions) (count (body-index functions :function-id)))
         (= (count records) (count (body-index records :function-syntax-id))
            (count (body-index records :function-core-node-id)))
         (= (set (keys (body-index records :function-syntax-id))) (set (keys (body-index functions :function-id))))
         (= (set (keys (body-index (body-select nodes :core-form :fn) :node-id)))
            (set (keys (body-index records :function-core-node-id))))
         (= (count (get core :root-core-node-ids)) (count (set (get core :root-core-node-ids))))
         (= (set (keys (body-index nodes :node-id)))
            (body-reachable (get core :root-core-node-ids) (body-index nodes :node-id)))
         (= (count calls) (count edges) (count (get typed :call-type-facts))
            (count (body-index calls :core-node-id)) (count (body-index edges :call-core-node-id))
            (count (body-index (get typed :call-type-facts) :call-core-node-id)))
         (if (contains? typed :recursive-proof) (body-recursive-proof-valid? core typed)
           (= [] (get core :recursion-components)))
         (= (body-project typed [:function-records :call-edges :recursion-components :lexical-bindings])
            {:function-records records :call-edges edges :recursion-components (get core :recursion-components) :lexical-bindings locals})
         (= (get core :artifact-id) (get typed :sh07-shaped-artifact-id))
         (= (get (get core :identity-preimage) :nodes) (body-throw-semantic-nodes core))
         (= (get (get core :identity-preimage) :root-core-node-ids) (get core :root-core-node-ids))
         (= (get (get core :identity-preimage) :definitions) (get core :definitions))
         (= (get (get core :identity-preimage) :function-records) records)
         (= (get (get core :identity-preimage) :call-edges) edges)
         (= (get (get core :identity-preimage) :calls) calls)
         (= (get (get core :identity-preimage) :evaluation-order) (get core :evaluation-order))
         (= (get (get core :identity-preimage) :lexical-bindings) locals)
         (= (get (get core :identity-preimage) :match-branch-records) (get core :match-branch-records))
         (= (get (get core :identity-preimage) :match-decision-skeletons) (get core :match-decision-skeletons))
         (= (get (get core :identity-preimage) :match-pattern-records) (get core :match-pattern-records))
         (= (get core :module) (get typed :module))]) false) false)))

(defn body-function-valid? [record function nodes definitions bindings module]
  (let [node (get nodes (get record :function-core-node-id)) source (get node :source)
        definition (body-by definitions :binding-id (get record :definition-binding-id))
        def-node (get nodes (get record :definition-core-node-id))
        binding (get bindings (get record :definition-binding-id))]
    (body-all?
      [(= :named-top-level (get record :definition-kind)) (= :fn (get node :core-form))
       (= :gravity/c7-function-type (get function :artifact)) (= :inferred (get function :status))
       (= (get record :function-syntax-id) (get function :function-id) (get source :syntax-id))
       (= (get record :function-core-node-id) (get function :function-core-node-id))
       (= (get record :body-core-node-id) (get function :body-core-node-id) (first (get node :children)))
       (= 1 (count (get node :children)))
       (= (get record :function-form-id) (get source :form-id))
       (= (get record :definition-name) (get function :definition-name) (get definition :name) (get binding :name))
       (= (get record :parameter-binding-ids) (get function :parameter-binding-ids) (get node :resolved-binding-ids))
       (= (get record :fixed-arity) (get function :fixed-arity) (count (get function :parameters)))
       (if (contains? record :signature) (= (get record :signature) (get function :signature))
         (= false (contains? function :signature)))
       (= (get record :definition-core-node-id) (get definition :core-node-id))
       (= (get definition :value-node-id) (get record :function-core-node-id))
       (= :def (get def-node :core-form))
       (= (get binding :definition-syntax-id) (get (get def-node :attributes) :name-syntax-id))
       (= (get function :syntax-id) (get source :syntax-id))
       (= (get function :source-span) (get source :semantic-span))
       (= (get function :origin-chain) (get source :origin-chain))
       (= (get function :generated-origin) (get source :generated-origin))
       (= (get function :profile) (get module :profile)) (= (get function :target) (get module :target))
       (= (get function :latent-effects) (get module :effects))
       (= (get function :capabilities) (get module :capabilities))
       (vector? (get function :thrown-error-effects))])))

(defn body-normal-compatible? [actual expected]
  (if (if (body-ni-valid-view? actual) (body-ni-valid-view? expected) false)
    (if (= actual :gravity.type/never) true (= actual expected)) false))

(defn body-has-never? [ids types]
  (loop [remaining ids]
    (if (= 0 (count remaining)) false
      (if (= :gravity.type/never (get types (first remaining))) true (recur (rest remaining))))))

(defn body-call-result-valid? [node fact nominal types]
  (let [actual (get types (get node :node-id))]
    (if (= (get fact :result-type) actual)
      (= actual (if (body-has-never? (get node :children) types) :gravity.type/never nominal)) false)))

(defn body-lr-declaration? [declaration bindings]
  (if (map? declaration)
    (let [constructor (get bindings (get declaration :type-binding-id))
          member (get bindings (get declaration :element-binding-id))]
      (body-all?
        [(symbol? (get declaration :constructor-reference-symbol)) (symbol? (get declaration :element-reference-symbol))
         (= #{:rule-version :source-child-index :marker-form-id :marker-syntax-id :type-form-id :type-syntax-id
               :type-symbol :type-binding-id :type-id :constructor-form-id :constructor-syntax-id
               :element-form-id :element-syntax-id :element-symbol :element-binding-id
               :constructor-reference-symbol :element-reference-symbol} (set (keys declaration)))
         (= :sh07-list-return-declaration-v1 (get declaration :rule-version))
         (= ['List :core :type 'gravity.core] [(get constructor :name) (get constructor :binding-class)
                                             (get constructor :kind) (get constructor :namespace)])
         (= [:core :type 'gravity.core] [(get member :binding-class) (get member :kind) (get member :namespace)])
         (= ['List (get member :name)] [(get declaration :type-symbol) (get declaration :element-symbol)])
         (body-hl-type? (get declaration :type-id))
         (= (get (get declaration :type-id) :element-type) (get '{I8 :gravity.type/i8 I16 :gravity.type/i16 I32 :gravity.type/i32 I64 :gravity.type/i64
         U8 :gravity.type/u8 U16 :gravity.type/u16 U32 :gravity.type/u32 U64 :gravity.type/u64
         F32 :gravity.type/f32 F64 :gravity.type/f64 Bool :gravity.type/bool
         String :gravity.type/string Symbol :gravity.type/symbol Keyword :gravity.type/keyword Ratio :gravity.type/ratio} (get member :name)))
         (if (integer? (get declaration :source-child-index)) (>= (get declaration :source-child-index) 0) false)
         (loop [ids [(get declaration :marker-form-id) (get declaration :marker-syntax-id)
           (get declaration :type-form-id) (get declaration :type-syntax-id) (get declaration :type-binding-id)
           (get declaration :constructor-form-id) (get declaration :constructor-syntax-id)
           (get declaration :element-form-id) (get declaration :element-syntax-id) (get declaration :element-binding-id)]]
           (if (= 0 (count ids)) true (if (sh09-sha256-id? (first ids)) (recur (rest ids)) false)))])) false))

(defn body-lr-source [form]
  {:form-id (get form :form-id) :syntax-id (get form :syntax-id) :semantic-span (get form :source-span)
   :origin-chain (get form :origin-chain) :generated-origin (get form :generated-origin)})

(defn body-lr-validate-types [declared actual]
  (let [declaration (body-lc-validate-types [declared])]
    (if (= :accepted (get declaration :status))
      (if (body-hl-type? declared)
        (let [validation (body-lc-validate-types [actual])]
          (if (= :accepted (get validation :status))
            (let [members (if (map? actual) (get actual :element-types) nil)
                  finite? (if (map? actual) (= [:gravity.type/list :literal] [(get actual :kind) (get actual :shape)]) false)
                  relation (if (= actual :gravity.type/never) :non-returning-bottom
                             (if (= actual declared) :homogeneous-list-identity
                               (if finite?
                                 (if (loop [remaining members]
                                       (if (= 0 (count remaining)) true
                                         (if (= (first remaining) (get declared :element-type))
                                           (recur (rest remaining)) false))) :all-positional-elements-match nil) nil)))]
              (if (= relation nil)
                {:status :rejected :reason :homogeneous-list-return-incompatible}
                {:status :accepted :relation relation
                 :checked-member-count (if finite? (count members) nil)}))
            {:status :rejected :reason :homogeneous-list-return-incompatible
             :type-check-reason (get validation :reason)}))
        {:status :rejected :reason :list-return-declaration-required})
      {:status :rejected :reason :list-return-declaration-required})))

(defn body-lr-derive [core record function nodes types bindings forms]
  (let [signature (get record :signature)
        declaration (get signature :return)
        declared (get declaration :type-id)
        body-id (get record :body-core-node-id)
        actual (get types body-id :gravity.type/unknown)]
    (let [validation (body-lr-validate-types declared actual)]
      (if (= :accepted (get validation :status))
        (let [fn-node (get nodes (get record :function-core-node-id))
              body (get nodes body-id)
              fn-form (get forms (get (get fn-node :source) :form-id))
              body-form (get forms (get (get body :source) :form-id))
              ids (get fn-form :child-form-ids)
              parameter-form (get forms (get ids 1))
              marker (get forms (get declaration :marker-form-id))
              application (get forms (get declaration :type-form-id))
              constructor (get forms (get declaration :constructor-form-id))
              member (get forms (get declaration :element-form-id))
              type-binding (get bindings (get declaration :type-binding-id))
              element-binding (get bindings (get declaration :element-binding-id))
              definition-binding (get bindings (get record :definition-binding-id))]
          (if (body-all?
                [(body-lr-declaration? declaration bindings)
                 (= :fn (get fn-node :core-form))
                 (= [body-id] (get fn-node :children))
                 (= :list (get fn-form :kind))
                 (vector? ids)
                 (= 5 (if (vector? ids) (count ids) 0))
                 (=
                   (get record :function-syntax-id)
                   (get function :function-id)
                   (get (get fn-node :source) :syntax-id))
                 (= (get record :function-core-node-id) (get function :function-core-node-id))
                 (= body-id (get function :body-core-node-id) (get body :node-id))
                 (= (get record :function-form-id) (get fn-form :form-id))
                 (= signature (get function :signature) (get (get fn-node :attributes) :signature))
                 (= declared (get function :return))
                 (= [2 4] [(get declaration :source-child-index) (get signature :body-source-child-index)])
                 (=
                   [(get marker :form-id) (get application :form-id) (get body-form :form-id)]
                   [(get ids 2) (get ids 3) (get ids 4)])
                 (= [(get marker :kind) (get marker :value)] [:keyword ':-])
                 (= (get marker :syntax-id) (get declaration :marker-syntax-id))
                 (= :list (get application :kind))
                 (= [(get constructor :form-id) (get member :form-id)] (get application :child-form-ids))
                 (= (get application :syntax-id) (get declaration :type-syntax-id))
                 (= (get constructor :syntax-id) (get declaration :constructor-syntax-id))
                 (= (get member :syntax-id) (get declaration :element-syntax-id))
                 (=
                   (get fn-form :form-id)
                   (get marker :parent-form-id)
                   (get application :parent-form-id)
                   (get body-form :parent-form-id))
                 (= (get application :form-id) (get constructor :parent-form-id) (get member :parent-form-id))
                 (=
                   (get application :scope-id)
                   (get constructor :scope-id)
                   (get member :scope-id)
                   (get parameter-form :scope-id))
                 (= :symbol (get constructor :kind) (get member :kind))
                 (=
                   [(get constructor :value) (get member :value)]
                   [(get declaration :constructor-reference-symbol)
                    (get declaration :element-reference-symbol)])
                 (= (get fn-node :source) (body-lr-source fn-form))
                 (= (get body :source) (body-lr-source body-form))
                 (= (get record :definition-binding-id) (get definition-binding :binding-id))
                 (= (get record :definition-name) (get definition-binding :name))])
            {:status :accepted
             :premise
             {:checked-element-count (get validation :checked-member-count)
              :definition-binding definition-binding
              :function-source (get fn-node :source)
              :constructor-source (body-lr-source constructor)
              :checked-element-type (get declared :element-type)
              :body-core-node-id body-id
              :function-record record
              :normal-completion? (= false (= actual :gravity.type/never))
              :element-source (body-lr-source member)
              :element-binding element-binding
              :type-binding type-binding
              :preserves
              [:value
               :actual-body-type
               :provenance
               :schema
               :ownership
               :linearity
               :regions
               :effects
               :allocation-obligations]
              :function-core-node-id (get record :function-core-node-id)
              :declaration declaration
              :body-source (get body :source)
              :declared-return-type declared
              :target (get (get core :module) :target)
              :version :sh08-homogeneous-list-return-v2
              :relation (get validation :relation)
              :function-id (get function :function-id)
              :profile (get (get core :module) :profile)
              :actual-body-type actual
              :return-source (body-lr-source application)
              :forgets (if (= :all-positional-elements-match (get validation :relation)) [:static-length] [])}}
            {:status :rejected :reason :list-return-source-mismatch}))
        validation))))

(defn body-lr-row [premise]
  {:constraint-id-request {:domain :gravity/sh08-homogeneous-list-return-constraint-v2 :return-compatibility premise}
   :kind :return-compatibility :producer-rule :sh08-homogeneous-list-return-v2
   :lhs {:function-id (get premise :function-id) :body-core-node-id (get premise :body-core-node-id) :role :return}
   :rhs {:actual-body-type (get premise :actual-body-type) :declared-return-type (get premise :declared-return-type)}
   :dependencies premise
   :solution {:return-type (get premise :declared-return-type) :actual-body-type (get premise :actual-body-type)
              :normal-completion? (get premise :normal-completion?)}
   :invalidation [:function-records :function-signature :body-core-node :body-type :return-declaration :source-forms
                  :type-bindings :definition-binding :profile :target]
   :profile (get premise :profile) :target (get premise :target) :status :solved :diagnostics []})

(defn body-lr-context [core facts bindings source-forms]
  (let [records (get core :function-records) ledger (get facts :constraint-ledger)]
    (let [rows (loop [remaining ledger out []]
                 (if (= 0 (count remaining))
                   out
                   (let [row (first remaining)]
                     (recur
                       (rest remaining)
                       (if (if (= :sh08-homogeneous-list-return-v2 (get row :producer-rule))
                             true
                             (if (= :sh08-homogeneous-list-return-v1 (get row :producer-rule))
                               true
                               (if (=
                                     :gravity/sh08-homogeneous-list-return-constraint-v2
                                     (get (get row :constraint-id-request) :domain))
                                 true
                                 (if (=
                                       :gravity/sh08-homogeneous-list-return-constraint-v1
                                       (get (get row :constraint-id-request) :domain))
                                   true
                                   (= :return-compatibility (get row :kind))))))
                         (conj out row)
                         out)))))
          active? (loop [remaining records]
                    (if (= 0 (count remaining))
                      false
                      (if (=
                            :sh07-list-return-declaration-v1
                            (get (get (get (first remaining) :signature) :return) :rule-version))
                        true
                        (recur (rest remaining)))))]
      (if (= false active?)
        (if (= [] rows)
          {:status :accepted :context {:premises {}}}
          {:status :rejected :reason :list-return-constraint-census})
        (let []
          (let [nodes (body-index (get core :nodes) :node-id)
                functions (body-index (get facts :function-type-table) :function-id)
                forms (if (map? source-forms) source-forms (body-index source-forms :form-id))
                types (get facts :type-table)]
            (if (= false (= (count functions) (count records) (count (get facts :function-type-table))))
              {:status :rejected :reason :list-return-function-census}
              (loop [remaining records expected [] premises {}]
                (if (= 0 (count remaining))
                  (if (= expected rows)
                    {:status :accepted :context {:premises premises}}
                    {:status :rejected :reason :list-return-constraint-census})
                  (let [record (first remaining)
                        id (get record :function-syntax-id)
                        function (get functions id)]
                    (if (=
                          :sh07-list-return-declaration-v1
                          (get (get (get record :signature) :return) :rule-version))
                      (let [checked (body-lr-derive core record function nodes types bindings forms)
                            premise (get checked :premise)]
                        (if (= :accepted (get checked :status))
                          (if (if (=
                                    (get function :return-actual-type)
                                    (get types (get record :body-core-node-id)))
                                (= premise (get function :return-compatibility))
                                false)
                            (recur
                              (rest remaining)
                              (conj expected (body-lr-row premise))
                              (assoc premises id premise))
                            {:status :rejected :reason :list-return-function-evidence})
                          checked))
                      (if (if (contains? function :return-compatibility)
                            true
                            (contains? function :return-actual-type))
                        {:status :rejected :reason :list-return-function-evidence}
                        (recur (rest remaining) expected premises)))))))))))))

(defn body-ij-unknown? [type]
  (if (= type nil) true (= type :gravity.type/unknown)))

; L5 canonical-if fallback: branch evidence supplies T, never an expected return.
(defn body-ni-atomic? [type]
  (contains? #{:gravity.type/bool :gravity.type/character :gravity.type/string :gravity.type/symbol :gravity.type/keyword} type))

(defn body-ni-tagged? [type]
  (if (map? type) (= :gravity.type/nil-or (get type :kind)) false))

(defn body-ni-type? [type]
  (if (body-ni-tagged? type)
    (if (= 2 (count type))
      (if (= #{:kind :value-type} (set (keys type))) (body-ni-atomic? (get type :value-type)) false) false) false))

(defn body-ni-valid-view? [type]
  (if (body-ni-tagged? type) (body-ni-type? type) true))

(defn body-ni-candidate? [left right]
  (if (= :gravity.type/nil left) true
    (if (= :gravity.type/nil right) true
      (if (body-ni-tagged? left) true (body-ni-tagged? right)))))

(defn body-ni-branch [type]
  (if (= :gravity.type/nil type) {:relation :nil-alternative :value-type nil}
    (if (body-ni-atomic? type) {:relation :atomic-alternative :value-type type}
      (if (body-ni-type? type) {:relation :nil-or-identity :value-type (get type :value-type)} nil))))

(defn body-ni-type-work [left right]
  (let [a (body-ni-branch left) b (body-ni-branch right)
        x (get a :value-type) y (get b :value-type) value (if (= x nil) y x)]
    (if (if (body-ni-candidate? left right)
          (if (map? a) (if (map? b)
            (if (= value nil) false (if (= x nil) true (if (= y nil) true (= x y)))) false) false) false)
      {:status :accepted :join-family :nil-or :type {:kind :gravity.type/nil-or :value-type value}
       :branch-types [left right] :branch-compatibility [a b] :nil-type :gravity.type/nil :value-type value}
      {:status :not-applicable :reason :independent-nil-or-atomic-required})))

(defn body-ij-atomic? [type]
  (if (keyword? type)
    (body-hl-type? {:kind :gravity.type/list :shape :homogeneous :element-type type}) false))

(defn body-ij-element [type]
  (let [members (if (map? type) (get type :element-types) nil)
        finite? (if (map? type)
                  (if (= 3 (count type))
                    (if (= #{:kind :shape :element-types} (set (keys type)))
                      (= [:gravity.type/list :literal] [(get type :kind) (get type :shape)]) false) false) false)
        width (if (if finite? (vector? members) false) (count members) 0)]
    (if (if (map? type) (keyword? (get type :element-type)) false)
      (if (body-hl-type? type)
        {:status :accepted :element-type (get type :element-type) :relation :homogeneous-list-identity
         :checked-member-count nil}
        {:status :not-applicable :reason :independent-list-element-required})
      (if (if finite? (vector? members) false)
        (if (= width 0)
          {:status :accepted :element-type nil :relation :empty-positional-list :checked-member-count 0}
          (let [element (first members)]
            (if (body-ij-atomic? element)
              (if (loop [remaining members]
                    (if (= 0 (count remaining)) true
                      (if (= element (first remaining)) (recur (rest remaining)) false)))
                {:status :accepted :element-type element :relation :all-positional-elements-match
                 :checked-member-count width}
                {:status :not-applicable :reason :incompatible-list-elements})
              {:status :not-applicable :reason :independent-atomic-element-required})))
        {:status :not-applicable :reason :independent-list-element-required}))))

(defn body-ij-type-work [left right]
  (if (body-ni-candidate? left right)
    (body-ni-type-work left right)
  (let [a (body-ij-element left)
        b (if (= :accepted (get a :status)) (body-ij-element right) nil)]
    (if (= :rejected (get a :status)) a
      (if (= :accepted (get a :status))
        (if (= :rejected (get b :status)) b
          (if (= :accepted (get b :status))
            (let [x (get a :element-type) y (get b :element-type)
                  element (if (= x nil) y x)]
              (if (if (= element nil) false (if (= x nil) true (if (= y nil) true (= x y))))
                {:status :accepted :type {:kind :gravity.type/list :shape :homogeneous :element-type element}
                 :branch-types [left right]
                 :branch-compatibility [(body-project a [:element-type :relation :checked-member-count])
                                        (body-project b [:element-type :relation :checked-member-count])]
                 :element-type element}
                {:status :not-applicable :reason :incompatible-independent-list-elements}))
            {:status :not-applicable :reason (get b :reason)}))
        {:status :not-applicable :reason (get a :reason)})))))

(defn body-ij-normal-type [left right]
  (if (if (body-ni-valid-view? left) (body-ni-valid-view? right) false)
  (if (= left right) left
    (if (= left :gravity.type/never) right
      (if (= right :gravity.type/never) left
        (get (body-ij-type-work left right) :type :gravity.type/unknown)))) :gravity.type/unknown))

(defn body-ij-derive [core node nodes types bindings forms]
  (let [children (get node :children)]
    (if (if (= :if (get node :core-form)) (if (vector? children) (= 3 (count children)) false) false)
      (let [condition (get types (first children) :gravity.type/unknown)
            left (get types (get children 1) :gravity.type/unknown)
            right (get types (get children 2) :gravity.type/unknown)]
        (if (if (= condition :gravity.type/never) true
              (if (body-ij-unknown? condition) true
                (if (= left right) true
                  (if (= left :gravity.type/never) true (= right :gravity.type/never)))))
          {:status :not-applicable}
          (let [validation (body-ij-type-work left right)]
                (if (= :accepted (get validation :status))
                  (let [owner (get (get node :evaluation) :owner-function-syntax-id)
                        function (loop [remaining (get core :function-records)]
                                   (if (= 0 (count remaining)) nil
                                     (if (= owner (get (first remaining) :function-syntax-id))
                                       (first remaining) (recur (rest remaining)))))
                        binding (get bindings (get function :definition-binding-id))
                        form (get forms (get (get node :source) :form-id))
                        ids (get form :child-form-ids)
                        operator (get forms (get ids 0))
                        control {:core-node-id (get node :node-id) :kind :if :condition-node-id (first children)
                                 :branches [{:role :then :predicate :truthy :core-node-id (get children 1)}
                                            {:role :else :predicate :falsey :core-node-id (get children 2)}]
                                 :branch-exclusivity :exactly-one
                                 :truthiness {:false-values [:nil :false] :other-values :true}
                                 :result-policy :selected-branch}
                        controls (loop [remaining (get core :control-flow) out []]
                                   (if (= 0 (count remaining)) out
                                     (recur (rest remaining)
                                       (if (= (get node :node-id) (get (first remaining) :core-node-id))
                                         (conj out (first remaining)) out))))
                        branch-nodes (loop [remaining children out []]
                                       (if (= 0 (count remaining)) out
                                         (recur (rest remaining) (conj out (get nodes (first remaining))))))
                        branch-bindings (loop [remaining branch-nodes out []]
                                          (if (= 0 (count remaining)) out
                                            (recur (rest remaining)
                                              (conj out (loop [ids (if (vector? (get (first remaining) :resolved-binding-ids))
                                                                    (get (first remaining) :resolved-binding-ids) []) records []]
                                                          (if (= 0 (count ids)) records
                                                            (recur (rest ids) (conj records (get bindings (first ids))))))))))]
                    (if (body-all?
                          [(map? function) (= owner (get function :function-syntax-id))
                           (= (get function :definition-binding-id) (get binding :binding-id))
                           (= (get function :definition-name) (get binding :name))
                           (= [:namespace :function (get (get core :module) :namespace)]
                              [(get binding :binding-class) (get binding :kind) (get binding :namespace)])
                           (= :list (get form :kind)) (vector? ids) (= 4 (count ids))
                           (= :symbol (get operator :kind)) (= 'if (get operator :value))
                           (= (get form :form-id) (get operator :parent-form-id))
                           (= (body-lr-source form) (get node :source))
                           (= [] (get node :resolved-binding-ids))
                           (= {:condition-child-index 0 :then-child-index 1 :else-child-index 2 :condition-evaluation :always-first
                               :branch-evaluation :exactly-one :truthiness {:false-values [:nil :false] :other-values :true}} (get node :attributes))
                           (= :condition-then-exclusive-branch (get (get node :evaluation) :kind))
                           (= [{:index 0 :core-node-id (first children)}] (get (get node :evaluation) :order))
                           (= [control] controls)
                           (loop [i 0]
                             (if (= i 3) true
                               (let [child (get branch-nodes i) source (get forms (get ids (+ i 1)))
                                     references (get child :resolved-binding-ids) records (get branch-bindings i)]
                                 (if (body-all?
                                       [(= (get child :node-id) (get children i))
                                        (= (body-lr-source source) (get child :source))
                                        (= (get form :form-id) (get source :parent-form-id))
                                        (= owner (get (get child :evaluation) :owner-function-syntax-id))
                                        (vector? references) (= references (loop [rows records out []]
                                                                            (if (= 0 (count rows)) out
                                                                              (recur (rest rows) (conj out (get (first rows) :binding-id))))))])
                                   (recur (+ i 1)) false))))])
                      {:status :accepted :type (get validation :type)
                       :premise (let [premise {:version :sh08-list-if-join-v1 :relation :independent-homogeneous-list-join
                                 :if-core-node-id (get node :node-id) :source-node node
                                 :function-record function :definition-binding binding
                                 :condition-type condition :branch-types [left right]
                                 :branch-node-ids [(get children 1) (get children 2)]
                                 :child-sources (loop [remaining branch-nodes out []]
                                                  (if (= 0 (count remaining)) out
                                                    (recur (rest remaining) (conj out (get (first remaining) :source)))))
                                 :child-bindings branch-bindings :source-form (body-lr-source form)
                                 :operator-source (body-lr-source operator) :control-flow control
                                 :branch-compatibility (get validation :branch-compatibility)
                                 :result-type (get validation :type)
                                 :expected-return-premise :none :runtime-conversion :none
                                 :preserves [:actual-branch-types :source :bindings :value :ownership :linearity :regions :effects]
                                 :profile (get (get core :module) :profile) :target (get (get core :module) :target)}]
                         (if (= :nil-or (get validation :join-family))
                           (assoc premise :version :sh08-nil-if-join-v1
                             :relation :independent-nil-or-atomic-join :nil-type :gravity.type/nil :value-type (get validation :value-type))
                           (assoc premise :element-type (get validation :element-type))))}
                      {:status :rejected :reason :list-if-join-source-mismatch}))
                  validation))))
      {:status :not-applicable})))

(defn body-ij-row [premise]
  {:constraint-id-request {:domain (if (= :sh08-nil-if-join-v1 (get premise :version))
                                     :gravity/sh08-nil-if-join-constraint-v1 :gravity/sh08-list-if-join-constraint-v1)
                            :join-compatibility premise}
   :kind :join-compatibility :producer-rule (if (= :sh08-nil-if-join-v1 (get premise :version))
                                            :sh08-nil-if-join-v1 :sh08-list-if-join-v1)
   :lhs {:core-node-id (get premise :if-core-node-id) :role :canonical-if-result}
   :rhs {:actual-branch-types (get premise :branch-types) :result-type (get premise :result-type)}
   :dependencies premise :solution {:result-type (get premise :result-type)}
   :invalidation [:source-forms :if-node :control-flow :branch-nodes :branch-types :source-bindings
                  :function-records :definition-binding :profile :target]
   :profile (get premise :profile) :target (get premise :target) :status :solved :diagnostics []})

(defn body-ij-context [core facts bindings source-forms]
  (let [sequence (get core :nodes) ledger (get facts :constraint-ledger []) types (get facts :type-table)
        nodes (body-index sequence :node-id)
            forms (if (map? source-forms) source-forms (body-index source-forms :form-id))
            rows (loop [remaining ledger out []]
                   (if (= 0 (count remaining)) out
                     (recur (rest remaining)
                       (if (if (contains? #{:sh08-list-if-join-v1 :sh08-nil-if-join-v1} (get (first remaining) :producer-rule)) true
                             (= :join-compatibility (get (first remaining) :kind)))
                         (conj out (first remaining)) out))))]
        (loop [remaining sequence expected [] premises {}]
          (if (= 0 (count remaining))
            (if (= expected rows)
              {:status :accepted :context {:premises premises}}
              {:status :rejected :reason :list-if-join-constraint-census})
            (let [node (first remaining) id (get node :node-id)]
              (if (= :if (get node :core-form))
                (let [checked (body-ij-derive core node nodes types bindings forms) children (get node :children)
                      condition (get types (first children) :gravity.type/unknown)
                      left (get types (get children 1) :gravity.type/unknown)
                      right (get types (get children 2) :gravity.type/unknown)
                      result (if (= condition :gravity.type/never) :gravity.type/never
                               (if (body-ij-unknown? condition) :gravity.type/unknown
                                 (if (= :accepted (get checked :status)) (get checked :type)
                                   (body-ij-normal-type left right))))]
                  (if (= :rejected (get checked :status))
                    checked
                    (if (if (= result :gravity.type/unknown) false (= result (get types id)))
                      (recur (rest remaining)
                        (if (= :accepted (get checked :status)) (conj expected (body-ij-row (get checked :premise))) expected)
                        (if (= :accepted (get checked :status)) (assoc premises id (get checked :premise)) premises))
                      {:status :rejected :reason :list-if-join-result-type-mismatch})))
                (recur (rest remaining) expected premises)))))))

(defn body-function-joins-valid? [core typed bindings]
  (let [nodes (body-index (get core :nodes) :node-id) types (get typed :type-table)
        functions (body-index (get typed :function-type-table) :function-id)]
    (loop [remaining (get core :function-records) ordinal 0]
      (if (= 0 (count remaining)) true
        (let [record (first remaining) function (get functions (get record :function-syntax-id))]
          (if (map? (get types (get record :function-core-node-id)))
          (if (body-all?
                [(= ordinal (get record :ordinal))
                 (body-function-valid? record function nodes (get core :definitions) bindings (get typed :module))
                 (= function (assoc (get types (get record :function-core-node-id))
                                     :source-span (get function :source-span) :syntax-id (get function :syntax-id)
                                     :origin-chain (get function :origin-chain) :generated-origin (get function :generated-origin)
                                     :profile (get function :profile) :target (get function :target)))
                 (if (= :sh07-list-return-declaration-v1 (get (get (get record :signature) :return) :rule-version))
                   (let [premise (get (get (get typed :return-context) :premises) (get record :function-syntax-id))]
                     (if (map? premise) (= premise (get function :return-compatibility)) false))
                   (body-normal-compatible? (get types (get record :body-core-node-id)) (get function :return)))])
            (recur (rest remaining) (+ ordinal 1)) false) false))))))

(defn body-call-valid? [edge call fact nodes functions records bindings types]
  (let [node (get nodes (get edge :call-core-node-id)) source (get node :source)
        target (get functions (get edge :callee-function-syntax-id))
        record (get records (get edge :callee-function-syntax-id))
        binding (get bindings (get edge :callee-binding-id))
        caller (get records (get edge :caller-function-syntax-id))
        operator (get nodes (first (get node :children)))]
    (if (vector? (get fact :argument-types))
    (body-all?
      [(= :local-function (get edge :classification)) (= :call (get node :core-form))
       (= :gravity/c7-call-type-fact (get fact :artifact)) (= :inferred (get fact :status))
       (= (get edge :call-core-node-id) (get call :core-node-id) (get fact :call-core-node-id))
       (= (get edge :callee-binding-id) (get call :operator-binding-id)
          (get record :definition-binding-id) (get (get operator :attributes) :binding-id))
       (= :reference (get operator :core-form))
       (= (get edge :callee-definition-syntax-id) (get binding :definition-syntax-id))
       (= (get edge :callee-function-syntax-id) (get fact :callee-function-syntax-id) (get target :function-id))
       (= (get edge :callee-function-core-node-id) (get record :function-core-node-id))
       (= (get edge :caller-function-syntax-id) (get fact :caller-function-syntax-id))
       (= (get edge :caller-function-core-node-id) (get caller :function-core-node-id))
       (= (get edge :argument-core-node-ids) (get call :argument-node-ids) (vec (rest (get node :children))))
       (= (get edge :ordered-evaluation-node-ids) (get call :ordered-evaluation-node-ids) (get node :children))
       (= :operator-then-arguments (get edge :evaluation-order) (get call :evaluation-order) (get fact :evaluation-order))
       (= (get source :syntax-id) (get fact :syntax-id))
       (= (get source :semantic-span) (get fact :source-span))
       (= (get source :origin-chain) (get fact :origin-chain))
       (= (get source :generated-origin) (get fact :generated-origin))
       (body-call-result-valid? node fact (get target :return) types)
       (= (get fact :effects) (get target :latent-effects))
       (= (get fact :capabilities) (get target :capabilities))
       (= (get fact :profile) (get target :profile))
       (= (get fact :target) (get target :target))
       (= (count (get fact :argument-types)) (count (get target :parameters)))
       (= {:domain :gravity/sh08-call-type-fact-v1 :call-core-node-id (get node :node-id)
           :callee-function-syntax-id (get target :function-id)
           :argument-types (get fact :argument-types) :result-type (get fact :result-type)}
          (get fact :fact-id-request))]) false)))

(defn body-arguments-valid? [ids arguments parameters types]
  (if (= (count ids) (count arguments) (count parameters))
    (loop [ids ids arguments arguments parameters parameters]
      (if (= 0 (count ids)) true
        (if (if (= (get types (first ids)) (first arguments))
              (body-normal-compatible? (first arguments) (get (first parameters) :type)) false)
          (recur (rest ids) (rest arguments) (rest parameters)) false))) false))

; L5: only an authenticated explicit bare List parameter can forget position.
(defn body-hl-declaration? [declaration bindings]
  (if (map? declaration)
    (let [constructor (get bindings (get declaration :type-binding-id))
          member (get bindings (get declaration :element-binding-id))]
      (body-all?
        [(= #{:rule-version :source-child-index :marker-form-id :marker-syntax-id :type-form-id :type-syntax-id
               :type-symbol :type-binding-id :type-id :constructor-form-id :constructor-syntax-id
               :element-form-id :element-syntax-id :element-symbol :element-binding-id} (set (keys declaration)))
         (= :sh07-list-parameter-declaration-v1 (get declaration :rule-version))
         (= ['List :core :type 'gravity.core] [(get constructor :name) (get constructor :binding-class)
                                             (get constructor :kind) (get constructor :namespace)])
         (= [:core :type 'gravity.core] [(get member :binding-class) (get member :kind) (get member :namespace)])
         (= ['List (get member :name)] [(get declaration :type-symbol) (get declaration :element-symbol)])
         (body-hl-type? (get declaration :type-id))
         (= (get (get declaration :type-id) :element-type) (get '{I8 :gravity.type/i8 I16 :gravity.type/i16 I32 :gravity.type/i32 I64 :gravity.type/i64
         U8 :gravity.type/u8 U16 :gravity.type/u16 U32 :gravity.type/u32 U64 :gravity.type/u64
         F32 :gravity.type/f32 F64 :gravity.type/f64 Bool :gravity.type/bool
         String :gravity.type/string Symbol :gravity.type/symbol Keyword :gravity.type/keyword Ratio :gravity.type/ratio} (get member :name)))
         (if (integer? (get declaration :source-child-index)) (>= (get declaration :source-child-index) 0) false)
         (loop [ids [(get declaration :marker-form-id) (get declaration :marker-syntax-id)
           (get declaration :type-form-id) (get declaration :type-syntax-id) (get declaration :type-binding-id)
           (get declaration :constructor-form-id) (get declaration :constructor-syntax-id)
           (get declaration :element-form-id) (get declaration :element-syntax-id) (get declaration :element-binding-id)]]
           (if (= 0 (count ids)) true (if (sh09-sha256-id? (first ids)) (recur (rest ids)) false)))])) false))

(defn body-mp-declaration? [declaration bindings]
  (if (map? declaration)
    (let [binding (get bindings (get declaration :type-binding-id))]
      (body-all?
        [(= #{:source-child-index :marker-form-id :marker-syntax-id :type-form-id
               :type-syntax-id :type-symbol :type-binding-id :type-id} (set (keys declaration)))
         (= ['Map :gravity.type/map] [(get declaration :type-symbol) (get declaration :type-id)])
         (= [:core :type 'gravity.core 'Map] [(get binding :binding-class) (get binding :kind)
                                               (get binding :namespace) (get binding :name)])
         (if (integer? (get declaration :source-child-index)) (<= 0 (get declaration :source-child-index)) false)
         (loop [ids [(get declaration :marker-form-id) (get declaration :marker-syntax-id)
                     (get declaration :type-form-id) (get declaration :type-syntax-id) (get declaration :type-binding-id)]]
           (if (= 0 (count ids)) true
             (if (sh09-sha256-id? (first ids)) (recur (rest ids)) false)))])) false))

; L5: a Map parameter forgets only independently checked member refinements.
(defn body-mp-compatibility [core call edge callee index actual nodes bindings]
  (let [parameter (get (get callee :parameters) index)]
    (if (if (= :gravity.type/map (get parameter :type))
          (if (map? actual) (= :gravity.type/map (get actual :kind)) false) false)
      (let [records (get core :function-records)
            validation (body-lc-validate-types [actual])
            record (loop [remaining records]
                       (if (= 0 (count remaining)) nil
                         (if (= (get callee :function-id) (get (first remaining) :function-syntax-id))
                           (first remaining) (recur (rest remaining)))))
            declaration (get (get (get record :signature) :parameters) index)
            bid (get parameter :binding-id) binding (get bindings bid)
            type-binding (get bindings (get declaration :type-binding-id))
            argument-id (get (get call :argument-node-ids) index) argument (get nodes argument-id)
            node (get nodes (get call :core-node-id))]
          (if (body-all?
                [(= :accepted (get validation :status))
                 (body-mp-declaration? declaration bindings)
                 (= ['Map :gravity.type/map] [(get declaration :type-symbol) (get declaration :type-id)])
                 (= :local-function (get edge :classification))
                 (= (get callee :function-id) (get edge :callee-function-syntax-id) (get record :function-syntax-id))
                 (= (get record :signature) (get callee :signature))
                 (= (get record :function-core-node-id) (get edge :callee-function-core-node-id))
                 (= bid (get (get record :parameter-binding-ids) index) (get binding :binding-id))
                 (= [:lexical :local] [(get binding :binding-class) (get binding :kind)])
                 (= [:core :type 'gravity.core 'Map] [(get type-binding :binding-class) (get type-binding :kind)
                                                      (get type-binding :namespace) (get type-binding :name)])
                 (= (get declaration :source-child-index) (+ 1 (get (get (get record :signature) :parameter-source-child-indexes) index -100)))
                 (= (get call :core-node-id) (get edge :call-core-node-id) (get node :node-id))
                 (= (get call :argument-node-ids) (get edge :argument-core-node-ids) (vec (rest (get node :children))))
                 (= argument-id (get argument :node-id))])
            {:status :accepted
             :premise {:version :sh08-bare-map-parameter-v1 :relation :forget-map-member-refinement
                       :call-core-node-id (get call :core-node-id) :argument-node-id argument-id :argument-index index
                       :actual-type actual :declared-type :gravity.type/map
                       :callee-function-syntax-id (get record :function-syntax-id)
                       :parameter-binding-id bid :parameter-binding binding :declaration declaration :type-binding type-binding
                       :argument-source (get argument :source) :call-source (get node :source)
                       :source-call call :source-edge edge
                       :forgets [:key-value-member-types :static-entry-count]
                       :preserves [:value :provenance :schema :ownership :linearity :regions :profile :memory-obligations]
                       :profile (get (get core :module) :profile) :target (get (get core :module) :target)}}
            {:status :rejected :reason :map-parameter-declaration-or-type-required}))
      {:status :not-applicable})))

(defn body-lp-compatibility [core call edge callee index actual nodes bindings]
  (let [parameter (get (get callee :parameters) index) expected (get parameter :type)
        homogeneous? (body-hl-type? expected)]
    (if (if (if homogeneous? true (= :gravity.type/list expected))
          (if (map? actual)
            (= [:gravity.type/list :literal #{:kind :shape :element-types}]
               [(get actual :kind) (get actual :shape) (set (keys actual))]) false) false)
      (let [records (get core :function-records)
            validation (body-lc-validate-types [actual])
            record (loop [remaining records]
                     (if (= 0 (count remaining)) nil
                       (if (= (get callee :function-id) (get (first remaining) :function-syntax-id))
                         (first remaining) (recur (rest remaining)))))
            declaration (get (get (get record :signature) :parameters) index)
            bid (get parameter :binding-id) binding (get bindings bid)
            type-binding (get bindings (get declaration :type-binding-id))
            argument-id (get (get call :argument-node-ids) index) argument (get nodes argument-id)
            node (get nodes (get call :core-node-id))]
          (if (body-all?
                [(= :accepted (get validation :status))
                 (= :local-function (get edge :classification))
                 (= (get callee :function-id) (get edge :callee-function-syntax-id) (get record :function-syntax-id))
                 (= (get record :signature) (get callee :signature))
                 (= (get record :function-core-node-id) (get edge :callee-function-core-node-id))
                 (= bid (get (get record :parameter-binding-ids) index) (get binding :binding-id))
                 (= [:lexical :local] [(get binding :binding-class) (get binding :kind)])
                 (= [:core :type 'gravity.core 'List] [(get type-binding :binding-class) (get type-binding :kind)
                                                       (get type-binding :namespace) (get type-binding :name)])
                 (if homogeneous?
                   (body-all? [(body-hl-declaration? declaration bindings) (= expected (get declaration :type-id))
                     (if (if (= :accepted (get validation :status)) (vector? (get actual :element-types)) false)
                       (loop [members (get actual :element-types)]
                         (if (= 0 (count members)) true
                           (if (= (first members) (get expected :element-type)) (recur (rest members)) false))) false)])
                   (= ['List :gravity.type/list] [(get declaration :type-symbol) (get declaration :type-id)]))
                 (= (get declaration :source-child-index) (+ 1 (get (get (get record :signature) :parameter-source-child-indexes) index -100)))
                 (= (get call :core-node-id) (get edge :call-core-node-id) (get node :node-id))
                 (= (get call :argument-node-ids) (get edge :argument-core-node-ids) (vec (rest (get node :children))))
                 (= argument-id (get argument :node-id))])
            {:status :accepted
             :premise (let [premise {:version :sh08-bare-list-parameter-v1 :relation :forget-positional-list-refinement
                       :call-core-node-id (get call :core-node-id) :argument-node-id argument-id :argument-index index
                       :actual-type actual :declared-type expected
                       :callee-function-syntax-id (get record :function-syntax-id)
                       :parameter-binding-id bid :parameter-binding binding :declaration declaration :type-binding type-binding
                       :argument-source (get argument :source) :call-source (get node :source)
                       :source-call call :source-edge edge
                       :forgets [:positional-element-types :static-length]
                       :preserves [:value :provenance :schema :ownership :linearity :regions :profile :memory-obligations]
                       :profile (get (get core :module) :profile) :target (get (get core :module) :target)}]
                        (if homogeneous?
                          (assoc premise :version :sh08-homogeneous-list-parameter-v1 :relation :all-positional-elements-match
                            :forgets [:static-length] :element-binding (get bindings (get declaration :element-binding-id))
                            :checked-element-type (get expected :element-type) :checked-element-count (count (get actual :element-types))) premise))}
            {:status :rejected :reason (if homogeneous? :homogeneous-list-parameter-incompatible :list-parameter-declaration-required)}))
      {:status :not-applicable})))

(defn body-lp-pairs-adapted? [pairs]
  (loop [remaining pairs]
    (if (= 0 (count remaining)) false
      (if (contains? (first remaining) :compatibility) true (recur (rest remaining))))))

(defn body-lp-call-row [row]
  (if (body-lp-pairs-adapted? (get row :rhs))
    (assoc row :kind :argument-compatibility :compatibility-rule-version
      (loop [pairs (get row :rhs) map? false homogeneous? false]
        (if (= 0 (count pairs))
          (if map? :sh08-map-list-parameter-compatibility-v1
            (if homogeneous? :sh08-list-parameter-compatibility-v2 :sh08-bare-list-parameter-v1))
          (let [version (get (get (first pairs) :compatibility) :version)]
            (recur (rest pairs) (if map? true (= version :sh08-bare-map-parameter-v1))
                               (if homogeneous? true (= version :sh08-homogeneous-list-parameter-v1))))))) row))

(defn body-lp-context [request facts bindings]
  (let [rows (body-select (get facts :constraint-ledger) :kind :argument-compatibility)
        core (get request :canonical-core-artifact)]
    (if (= 0 (count rows)) {:status :accepted :context nil}
      (let [nodes (body-index (get core :nodes) :node-id) calls (body-index (get core :calls) :core-node-id)
            edges (body-index (get core :call-edges) :call-core-node-id)
            functions (body-index (get facts :function-type-table) :function-id) types (get facts :type-table)]
        (loop [remaining rows expected {}]
          (if (= 0 (count remaining)) {:status :accepted :context {:rows expected}}
            (let [row (first remaining) id (get (get row :constraint-id-request) :call-core-node-id)
                  call (get calls id) edge (get edges id) callee (get functions (get edge :callee-function-syntax-id))
                  args (get call :argument-node-ids) parameters (get callee :parameters)]
              (if (if (contains? expected id) true (= false (= (count args) (count parameters))))
                (body-failure :body-list-parameter-context)
                (let [joined (loop [index 0 pairs []]
                               (if (= index (count args)) {:status :accepted :pairs pairs}
                                 (let [actual (get types (get args index)) chosen (get (get parameters index) :type)
                                       checked (if (= :gravity.type/map chosen)
                                                 (body-mp-compatibility core call edge callee index actual nodes bindings)
                                                 (body-lp-compatibility core call edge callee index actual nodes bindings))
                                       pair {:parameter (get (get parameters index) :binding-id) :argument actual :chosen chosen}]
                                   (if (= :accepted (get checked :status))
                                     (recur (+ index 1) (conj pairs (assoc pair :compatibility (get checked :premise))))
                                     (if (if (= :not-applicable (get checked :status)) (body-normal-compatible? actual chosen) false)
                                       (recur (+ index 1) (conj pairs pair))
                                       {:status :rejected :reason (get checked :reason :incompatible-argument)})))))
                      expected-row (body-lp-call-row
                                     {:constraint-id-request {:domain :gravity/sh08-function-call-constraint-v1 :call-core-node-id id
                                                              :callee-function-syntax-id (get edge :callee-function-syntax-id)}
                                      :kind :equality :lhs (get edge :callee-function-syntax-id) :rhs (get joined :pairs)
                                      :origin (get (get (get nodes id) :source) :origin-chain)
                                      :profile :meta :target :jvm :status :solved :diagnostics []})]
                  (if (= :accepted (get joined :status))
                    (if (= row expected-row)
                      (recur (rest remaining) (assoc expected id expected-row))
                      (body-failure :body-list-parameter-compatibility-mismatch))
                    (body-failure (get joined :reason))))))))))))

(defn body-local-arguments-valid? [core facts bindings edge call fact target]
  (let [id (get call :core-node-id) row (get (get (get facts :list-parameter-context) :rows) id)
        types (get facts :type-table)]
    (if (map? row)
      (body-all? [(= (get row :kind) :argument-compatibility)
                  (= (get fact :argument-types)
                     (loop [remaining (get call :argument-node-ids) out []]
                       (if (= 0 (count remaining)) out
                         (recur (rest remaining) (conj out (get types (first remaining)))))))
                  (= (get edge :callee-function-syntax-id) (get row :lhs))
                  (= [row] (body-select (get facts :constraint-ledger) :constraint-id-request (get row :constraint-id-request)))])
      (body-arguments-valid? (get edge :argument-core-node-ids) (get fact :argument-types) (get target :parameters) types))))

(defn body-call-joins-valid? [core typed bindings]
  (let [nodes (body-index (get core :nodes) :node-id) functions (body-index (get typed :function-type-table) :function-id)
        records (body-index (get core :function-records) :function-syntax-id)
        calls (body-index (get core :calls) :core-node-id) facts (body-index (get typed :call-type-facts) :call-core-node-id)]
    (loop [remaining (get core :call-edges) ordinal 0]
      (if (= 0 (count remaining)) true
        (let [edge (first remaining) id (get edge :call-core-node-id)]
          (if (if (= ordinal (get edge :ordinal))
                (if (body-call-valid? edge (get calls id) (get facts id) nodes functions records bindings (get typed :type-table))
                  (body-local-arguments-valid? core typed bindings edge (get calls id) (get facts id)
                    (get functions (get edge :callee-function-syntax-id))) false) false)
            (recur (rest remaining) (+ ordinal 1)) false))))))

(defn body-import-call-valid? [edge call fact nodes records foreign types]
  (let [node (get nodes (get edge :call-core-node-id)) source (get node :source)
        target (get foreign :function) coordinate (get foreign :coordinate)
        operator (get nodes (first (get node :children)))
        caller (get records (get edge :caller-function-syntax-id))
        expected-request {:domain :gravity/sh08-call-type-fact-v1 :call-core-node-id (get node :node-id)
                          :callee-function-syntax-id nil
                          :argument-types (get fact :argument-types) :result-type (get fact :result-type)
                          :imported-function coordinate :effect-status :pending-sh09-imported-body
                          :legality-status :pending-imported-effects}]
    (if (vector? (get fact :argument-types))
      (body-all?
        [(= :nonlocal-or-nonfunction (get edge :classification)) (= :call (get node :core-form))
         (= :direct-imported-function (get fact :dispatch)) (= :inferred (get fact :status))
         (= :gravity/c7-call-type-fact (get fact :artifact))
         (= (get edge :call-core-node-id) (get call :core-node-id) (get fact :call-core-node-id))
         (= (get coordinate :binding-id) (get edge :callee-binding-id) (get call :operator-binding-id)
            (get (get operator :attributes) :binding-id))
         (= :reference (get operator :core-form))
         (= nil (get edge :callee-function-syntax-id) (get edge :callee-function-core-node-id) (get fact :callee-function-syntax-id))
         (= (get edge :callee-definition-syntax-id) (get (get foreign :binding) :definition-syntax-id))
         (= (get coordinate :function-id) (get target :function-id) (get (get foreign :summary) :function-id))
         (= (get foreign :body-core-node-id) (get target :body-core-node-id) (get (get foreign :summary) :body-core-node-id))
         (set? (get (get foreign :summary) :inferred))
         (= [:pending-sh09] (get (get foreign :summary) :throws))
         (= coordinate (get fact :imported-function)) (= expected-request (get fact :fact-id-request))
         (= (get edge :caller-function-syntax-id) (get fact :caller-function-syntax-id))
         (= (get edge :caller-function-core-node-id) (get caller :function-core-node-id))
         (= (get edge :argument-core-node-ids) (get call :argument-node-ids) (vec (rest (get node :children))))
         (= (get edge :ordered-evaluation-node-ids) (get call :ordered-evaluation-node-ids) (get node :children))
         (= :operator-then-arguments (get edge :evaluation-order) (get call :evaluation-order) (get fact :evaluation-order))
         (= (get source :syntax-id) (get fact :syntax-id)) (= (get source :semantic-span) (get fact :source-span))
         (= (get source :origin-chain) (get fact :origin-chain)) (= (get source :generated-origin) (get fact :generated-origin))
         (body-call-result-valid? node fact (get target :return) types)
         (= (get fact :effects) (get target :latent-effects)) (= (get fact :capabilities) (get target :capabilities))
         (= (get fact :profile) (get target :profile)) (= (get fact :target) (get target :target))
         (= :pending-sh09-imported-body (get fact :effect-status)) (= :pending-imported-effects (get fact :legality-status))
         (= :callee-module-declarations (get fact :effect-facts-source))
         (body-arguments-valid? (get edge :argument-core-node-ids) (get fact :argument-types)
                              (get target :parameters) types)]) false)))

(defn body-io-child-types [ids types]
  (loop [remaining ids out []]
    (if (= 0 (count remaining)) out
      (recur (rest remaining) (conj out (get types (first remaining) :gravity.type/unknown))))))

; L5/L13/STD5/SAFE9: an applied intrinsic is evidence at one direct
; operator occurrence, never a callable type on a binding or a math import.
(defn body-io-binding? [binding module]
  (body-all?
    [(contains? '#{< <= > >=} (get binding :name))
     (= [:core :var 'gravity.core {:name 'gravity/core :version "bootstrap-contract-v1"} :gravity.type/core-var :safe]
        [(get binding :binding-class) (get binding :kind) (get binding :namespace)
         (get binding :package) (get binding :type-ref) (get binding :safety)])
     (= [] (get binding :effects) (get binding :capabilities))
     (contains? (set (get binding :profile-set)) (get module :profile))
     (contains? (set (get binding :target-set)) :all)]))

(defn body-io-descriptor [core node call edge nodes bindings types module]
  (let [children (get node :children) operator (get nodes (get call :operator-node-id))
        binding-id (get call :operator-binding-id) binding (get bindings binding-id)
        arguments (get call :argument-node-ids)
        args (body-io-child-types arguments types)
        normal (loop [remaining args out []]
                 (if (= 0 (count remaining)) out
                   (recur (rest remaining) (if (= :gravity.type/never (first remaining)) out (conj out (first remaining))))))
        family (first normal) invoked? (= (count normal) (count args))
        integral? (contains? #{:gravity.type/integer :gravity.type/i8 :gravity.type/i16 :gravity.type/i32 :gravity.type/i64
                              :gravity.type/u8 :gravity.type/u16 :gravity.type/u32 :gravity.type/u64} family)
        caller (loop [remaining (get core :function-records)]
                 (if (= 0 (count remaining)) nil
                   (if (= (get (first remaining) :function-syntax-id) (get (get node :evaluation) :owner-function-syntax-id))
                     (first remaining) (recur (rest remaining)))))
        expected-call {:core-node-id (get node :node-id) :operator-node-id (first children) :operator-binding-id binding-id
                       :argument-node-ids (vec (rest children)) :ordered-evaluation-node-ids children
                       :evaluation-order :operator-then-arguments :result-policy :call-result}
        expected-edge {:ordinal (get edge :ordinal) :call-core-node-id (get node :node-id)
                       :caller-function-syntax-id (get caller :function-syntax-id) :caller-function-core-node-id (get caller :function-core-node-id)
                       :callee-binding-id binding-id :callee-definition-syntax-id (get binding :definition-syntax-id)
                       :callee-function-syntax-id nil :callee-function-core-node-id nil
                       :argument-core-node-ids arguments :ordered-evaluation-node-ids children
                       :evaluation-order :operator-then-arguments :classification :nonlocal-or-nonfunction}
        operation (get binding :name)]
    (if (body-all?
          [(= :call (get node :core-form)) (= :reference (get operator :core-form))
           (= 2 (count args)) (= expected-call call) (= expected-edge edge)
           (body-io-binding? binding module)
           (= [binding-id] (get operator :resolved-binding-ids) (get node :resolved-binding-ids))
           (= {:symbol (get (get operator :attributes) :symbol) :position :operator :binding-id binding-id
               :binding-class :core :definition-syntax-id (get binding :definition-syntax-id)} (get operator :attributes))
           (if (= operation (get (get operator :attributes) :symbol)) true
             (= (str "gravity.core/" operation) (str (get (get operator :attributes) :symbol))))
           (= :operator-then-arguments (get (get node :evaluation) :kind))
           (= (loop [i 0 out []] (if (= i (count children)) out
                (recur (+ i 1) (conj out {:index i :core-node-id (get children i)})))) (get (get node :evaluation) :order))
           (if (= 0 (count normal)) true
             (if integral? (loop [remaining normal]
                            (if (= 0 (count remaining)) true
                              (if (= family (first remaining)) (recur (rest remaining)) false))) false))])
      {:kind :gravity.type/applied-integral-ordering :version :sh08-integral-ordering-v1
       :operation operation :intrinsic (get '{< :gravity.math.core/integral-less-than <= :gravity.math.core/integral-less-or-equal
                                             > :gravity.math.core/integral-greater-than >= :gravity.math.core/integral-greater-or-equal} operation)
       :semantic-owner 'gravity.math :layer0-owner 'gravity.math.core :resolution :gravity.core-compatibility
       :operator-node-id (get operator :node-id) :operator-binding-id binding-id :call-core-node-id (get node :node-id)
       :source (get node :source) :operator-source (get operator :source) :source-call call :source-edge edge :source-binding binding
       :argument-types args :parameter-types (if (= 0 (count normal)) nil [family family])
       :return :gravity.type/bool :result-type (if invoked? :gravity.type/bool :gravity.type/never)
       :profile (get module :profile) :target (get module :target)
       :numeric-mode :proof-required :safety :proven-safe
       :safety-rule :same-integral-total-order-no-conversion-overflow-or-rounding
       :latent-effects [] :capabilities [] :thrown-error-effects [] :application (if invoked? :normal :not-invoked)
       :invalidation [:calls :call-edges :binding-table :source-forms :type-table :profile :target :evaluation-order]}
      nil)))

(defn body-io-constraint [descriptor]
  {:constraint-id-request {:domain :gravity/sh08-integral-ordering-constraint-v1 :application descriptor}
   :kind :numeric-mode :producer-rule :sh08-integral-ordering-v1
   :lhs {:core-node-id (get descriptor :call-core-node-id) :projection :integral-ordering}
   :rhs (get descriptor :result-type) :dependencies descriptor :origin (get (get descriptor :source) :origin-chain)
   :solution {:numeric-mode :proof-required :safety :proven-safe
              :safety-rule :same-integral-total-order-no-conversion-overflow-or-rounding
              :result-type (get descriptor :result-type) :application (get descriptor :application)}
   :invalidation (get descriptor :invalidation) :profile (get descriptor :profile) :target (get descriptor :target)
   :status :solved :diagnostics []})

(defn body-io-call-fact [descriptor module]
  (let [source (get descriptor :source) edge (get descriptor :source-edge)]
    {:artifact :gravity/c7-call-type-fact
     :fact-id-request {:domain :gravity/sh08-integral-ordering-call-type-fact-v1 :application descriptor}
     :call-core-node-id (get descriptor :call-core-node-id) :caller-function-syntax-id (get edge :caller-function-syntax-id)
     :callee-function-syntax-id nil :argument-types (get descriptor :argument-types) :result-type (get descriptor :result-type)
     :evaluation-order :operator-then-arguments :source-span (get source :semantic-span) :syntax-id (get source :syntax-id)
     :origin-chain (get source :origin-chain) :generated-origin (get source :generated-origin)
     :profile (get module :profile) :target (get module :target) :effects [] :capabilities [] :status :inferred
     :dispatch :direct-integral-ordering :applied-integral-ordering descriptor :effect-facts-source :audited-numeric-intrinsic}))

(defn body-io-call-valid? [core facts bindings node call edge nodes]
  (let [types (get facts :type-table)
        descriptor (body-io-descriptor core node call edge nodes bindings types (get core :module))
        rows (body-select (get facts :constraint-ledger) :producer-rule :sh08-integral-ordering-v1)
        selected (body-select rows :lhs {:core-node-id (get node :node-id) :projection :integral-ordering})]
    (if (map? descriptor)
      (body-all? [(= descriptor (get types (get call :operator-node-id)))
                  (= (get descriptor :result-type) (get types (get node :node-id)))
                  (= (body-io-call-fact descriptor (get core :module))
                     (body-by (get facts :call-type-facts) :call-core-node-id (get node :node-id)))
                  (= [(body-io-constraint descriptor)] selected)]) false)))

(defn body-io-node? [node facts core]
  (let [descriptor (get (get facts :type-table) (first (get node :children)))
        id (get node :node-id) call (body-by (get core :calls) :core-node-id id)
        edge (body-by (get core :call-edges) :call-core-node-id id)]
    (if (= :gravity.type/applied-integral-ordering (get descriptor :kind))
      (= descriptor (body-io-descriptor core node call edge (body-index (get core :nodes) :node-id)
        {(get descriptor :operator-binding-id) (get descriptor :source-binding)} (get facts :type-table) (get core :module))) false)))

(defn body-ma-binding? [binding module]
  (if (if (vector? (get binding :profile-set)) (vector? (get binding :target-set)) false)
  (body-all?
    [(= ['assoc :core :var 'gravity.core {:name 'gravity/core :version "bootstrap-contract-v1"} :gravity.type/core-var :safe]
        [(get binding :name) (get binding :binding-class) (get binding :kind) (get binding :namespace)
         (get binding :package) (get binding :type-ref) (get binding :safety)])
     (= [] (get binding :effects) (get binding :capabilities))
     (contains? (set (get binding :profile-set)) (get module :profile))
     (contains? (set (get binding :target-set)) :all)]) false))

(defn body-ma-source [core node call edge nodes bindings types module]
  (if (if (vector? (get call :argument-node-ids)) (vector? (get node :children)) false)
  (let [children (get node :children) operator (get nodes (get call :operator-node-id))
        bid (get call :operator-binding-id) binding (get bindings bid) args (get call :argument-node-ids)
        arguments (body-io-child-types args types)
        key-node (get nodes (get args 1))
        invoked? (loop [remaining arguments]
                   (if (= 0 (count remaining)) true
                     (if (= :gravity.type/never (first remaining)) false (recur (rest remaining)))))
        caller (loop [remaining (get core :function-records)]
                 (if (= 0 (count remaining)) nil
                   (if (= (get (first remaining) :function-syntax-id) (get (get node :evaluation) :owner-function-syntax-id))
                     (first remaining) (recur (rest remaining)))))
        expected-call {:core-node-id (get node :node-id) :operator-node-id (first children) :operator-binding-id bid
                       :argument-node-ids (vec (rest children)) :ordered-evaluation-node-ids children
                       :evaluation-order :operator-then-arguments :result-policy :call-result}
        expected-edge {:ordinal (get edge :ordinal) :call-core-node-id (get node :node-id)
                       :caller-function-syntax-id (get caller :function-syntax-id) :caller-function-core-node-id (get caller :function-core-node-id)
                       :callee-binding-id bid :callee-definition-syntax-id (get binding :definition-syntax-id)
                       :callee-function-syntax-id nil :callee-function-core-node-id nil :argument-core-node-ids args
                       :ordered-evaluation-node-ids children :evaluation-order :operator-then-arguments :classification :nonlocal-or-nonfunction}]
    (if (body-all?
          [(= :call (get node :core-form)) (= :reference (get operator :core-form))
           (= 3 (count args)) (= expected-call call) (= expected-edge edge) (body-ma-binding? binding module)
           (= [bid] (get node :resolved-binding-ids) (get operator :resolved-binding-ids))
           (= {:symbol (get (get operator :attributes) :symbol) :position :operator :binding-id bid :binding-class :core
               :definition-syntax-id (get binding :definition-syntax-id)} (get operator :attributes))
           (contains? '#{assoc gravity.core/assoc} (get (get operator :attributes) :symbol))
           (= :operator-then-arguments (get (get node :evaluation) :kind))
           (= (loop [i 0 out []] (if (= i (count children)) out
                (recur (+ i 1) (conj out {:index i :core-node-id (get children i)})))) (get (get node :evaluation) :order))
           (= :literal (get key-node :core-form)) (= [] (get key-node :children))
           (= :keyword (get (get key-node :attributes) :literal-kind)) (keyword? (get (get key-node :attributes) :value))
           (= :gravity.type/keyword (get arguments 1))
           (loop [remaining arguments]
             (if (= 0 (count remaining)) true
               (if (contains? #{nil :gravity.type/unknown} (first remaining)) false (recur (rest remaining)))))] )
      {:kind :gravity.type/applied-map-association :version :sh08-map-association-v1
       :operation 'assoc :semantic-owner 'gravity.collections :intrinsic :gravity.collections/persistent-map-assoc
       :resolution :gravity.core-compatibility :operator-node-id (get operator :node-id) :operator-binding-id bid
       :call-core-node-id (get node :node-id) :source (get node :source) :operator-source (get operator :source)
       :source-call call :source-edge edge :source-binding binding :argument-types arguments
       :key (get (get key-node :attributes) :value) :application (if invoked? :normal :not-invoked)
       :latent-effects [:memory/allocate] :direct-effects (if invoked? [:memory/allocate] []) :capabilities [] :thrown-error-effects []
       :profile (get module :profile) :target (get module :target)
       :invalidation [:calls :call-edges :binding-table :source-forms :type-table :lexical-bindings :definitions :function-records
                      :callee-body :constructor-or-quote-shape :profile :target :evaluation-order]} nil)) nil))


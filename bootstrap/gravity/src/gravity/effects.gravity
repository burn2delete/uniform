(defn body-ksm-constraint [descriptor]
  (if (= :gravity.type/applied-integer-set-contains (get descriptor :kind))
    {:constraint-id-request {:domain :gravity/sh08-integer-set-contains-constraint-v1 :application descriptor}
   :kind :equality :producer-rule :sh08-integer-set-contains-v1
   :lhs {:core-node-id (get descriptor :call-core-node-id) :projection :integer-set-contains}
   :rhs (get descriptor :result-type) :dependencies descriptor :origin (get (get descriptor :source) :origin-chain)
   :solution {:result-type (get descriptor :result-type) :application (get descriptor :application)
              :direct-effects (get descriptor :direct-effects) :membership-policy (get descriptor :membership-policy)}
   :invalidation (get descriptor :invalidation) :profile (get descriptor :profile) :target (get descriptor :target)
   :status :solved :diagnostics []}
    (if (= :gravity.type/applied-symbol-set-contains (get descriptor :kind))
    {:constraint-id-request {:domain :gravity/sh08-symbol-set-contains-constraint-v2 :application descriptor}
   :kind :equality :producer-rule :sh08-symbol-set-contains-v2
   :lhs {:core-node-id (get descriptor :call-core-node-id) :projection :symbol-set-contains}
   :rhs (get descriptor :result-type) :dependencies descriptor :origin (get (get descriptor :source) :origin-chain)
   :solution {:result-type (get descriptor :result-type) :application (get descriptor :application)
              :direct-effects (get descriptor :direct-effects) :membership-policy (get descriptor :membership-policy)}
   :invalidation (get descriptor :invalidation) :profile (get descriptor :profile) :target (get descriptor :target)
   :status :solved :diagnostics []}
    {:constraint-id-request {:domain (if (= :gravity.type/applied-character-set-contains (get descriptor :kind))
                                            :gravity/sh08-character-set-contains-constraint-v1 (if (= :gravity.type/applied-string-set-contains (get descriptor :kind)) :gravity/sh08-string-set-contains-constraint-v2 :gravity/sh08-keyword-set-contains-constraint-v1)) :application descriptor}
   :kind :equality :producer-rule (if (= :gravity.type/applied-character-set-contains (get descriptor :kind))
                                  :sh08-character-set-contains-v1 (if (= :gravity.type/applied-string-set-contains (get descriptor :kind)) :sh08-string-set-contains-v2 :sh08-keyword-set-contains-v1))
   :lhs {:core-node-id (get descriptor :call-core-node-id) :projection (if (= :gravity.type/applied-character-set-contains (get descriptor :kind)) :character-set-contains (if (= :gravity.type/applied-string-set-contains (get descriptor :kind)) :string-set-contains :keyword-set-contains))}
   :rhs (get descriptor :result-type) :dependencies descriptor :origin (get (get descriptor :source) :origin-chain)
   :solution (let [solution {:result-type (get descriptor :result-type) :application (get descriptor :application)
                             :direct-effects (get descriptor :direct-effects)}]
               (if (contains? #{:gravity.type/applied-character-set-contains :gravity.type/applied-string-set-contains :gravity.type/applied-symbol-set-contains :gravity.type/applied-integer-set-contains} (get descriptor :kind))
                 (assoc solution :membership-policy (get descriptor :membership-policy)) solution))
   :invalidation (get descriptor :invalidation) :profile (get descriptor :profile) :target (get descriptor :target)
   :status :solved :diagnostics []})))


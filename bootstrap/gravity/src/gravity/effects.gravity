  (if (if (vector? (get binding :profile-set)) (vector? (get binding :target-set)) false)
  (body-all?
    [(= ['= :core :var 'gravity.core {:name 'gravity/core :version "bootstrap-contract-v1"} :gravity.type/core-var :safe]
        [(get binding :name) (get binding :binding-class) (get binding :kind) (get binding :namespace)
         (get binding :package) (get binding :type-ref) (get binding :safety)])
     (= [] (get binding :effects) (get binding :capabilities))
     (contains? (set (get binding :profile-set)) (get module :profile))
     (contains? (set (get binding :target-set)) :all)]) false))

(defn body-ae-source [core node call edge nodes bindings types module]
  (if (if (vector? (get call :argument-node-ids)) (vector? (get node :children)) false)
  (let [children (get node :children) operator (get nodes (get call :operator-node-id))
        bid (get call :operator-binding-id) binding (get bindings bid) args (get call :argument-node-ids)
        arguments (body-io-child-types args types)
        invoked? (loop [remaining arguments]
                   (if (= 0 (count remaining)) true
                     (if (= :gravity.type/never (first remaining)) false (recur (rest remaining)))))
        caller (loop [remaining (get core :function-records)]
                 (if (= 0 (count remaining)) nil
                   (if (= (get (first remaining) :function-syntax-id) (get (get node :evaluation) :owner-function-syntax-id))
                     (first remaining) (recur (rest remaining)))))
        expected-call {:core-node-id (get node :node-id) :operator-node-id (first children) :operator-binding-id bid
                       :argument-node-ids (vec (rest children)) :ordered-evaluation-node-ids children
                       :evaluation-order :operator-then-arguments :result-policy :call-result}
        expected-edge {:ordinal (get edge :ordinal) :call-core-node-id (get node :node-id)
                       :caller-function-syntax-id (get caller :function-syntax-id) :caller-function-core-node-id (get caller :function-core-node-id)
                       :callee-binding-id bid :callee-definition-syntax-id (get binding :definition-syntax-id)
                       :callee-function-syntax-id nil :callee-function-core-node-id nil :argument-core-node-ids args
                       :ordered-evaluation-node-ids children :evaluation-order :operator-then-arguments :classification :nonlocal-or-nonfunction}]
    (if (body-all?
          [(= :call (get node :core-form)) (= :reference (get operator :core-form))
           (= 2 (count args)) (= expected-call call) (= expected-edge edge) (body-ae-binding? binding module)
           (= [bid] (get node :resolved-binding-ids) (get operator :resolved-binding-ids))
           (= {:symbol (get (get operator :attributes) :symbol) :position :operator :binding-id bid :binding-class :core
               :definition-syntax-id (get binding :definition-syntax-id)} (get operator :attributes))
           (contains? '#{= gravity.core/=} (get (get operator :attributes) :symbol))
           (= :operator-then-arguments (get (get node :evaluation) :kind))
           (= (loop [i 0 out []] (if (= i (count children)) out
                (recur (+ i 1) (conj out {:index i :core-node-id (get children i)})))) (get (get node :evaluation) :order))
           (loop [remaining arguments]
             (if (= 0 (count remaining)) true
               (if (contains? #{:gravity.type/nil :gravity.type/bool :gravity.type/character :gravity.type/string
                                :gravity.type/symbol :gravity.type/keyword :gravity.type/never} (first remaining))
                 (recur (rest remaining)) false)))
           (loop [remaining arguments]
             (if (= 0 (count remaining)) true
               (if (contains? #{nil :gravity.type/unknown} (first remaining)) false (recur (rest remaining)))))] )
      {:kind :gravity.type/applied-atomic-equality :version :sh08-atomic-equality-v1
       :operation '= :semantic-owner 'gravity.core :intrinsic :gravity.core/atomic-value-equality
       :resolution :gravity.core-compatibility :operator-node-id (get operator :node-id) :operator-binding-id bid
       :call-core-node-id (get node :node-id) :source (get node :source) :operator-source (get operator :source)
       :source-call call :source-edge edge :source-binding binding :argument-types arguments
       :equality-policy {:domain [:nil :boolean :character :string :symbol :keyword]
                         :same-family :value :cross-family :false :identity :unobserved
                         :strings :exact-valid-scalar-sequence :normalization :none :locale :none :numeric :unsupported}
       :application (if invoked? :normal :not-invoked)
       :latent-effects [] :direct-effects [] :capabilities [] :thrown-error-effects []
       :profile (get module :profile) :target (get module :target)
       :invalidation [:calls :call-edges :binding-table :source-forms :type-table :lexical-bindings :definitions :function-records
                      :callee-body :equality-domain :value-policy :profile :target :evaluation-order]} nil)) nil))

(defn body-ae-constraint [descriptor]
  {:constraint-id-request {:domain :gravity/sh08-atomic-equality-constraint-v1 :application descriptor}
   :kind :equality :producer-rule :sh08-atomic-equality-v1
   :lhs {:core-node-id (get descriptor :call-core-node-id) :projection :atomic-equality}
   :rhs (get descriptor :result-type) :dependencies descriptor :origin (get (get descriptor :source) :origin-chain)
   :solution {:result-type (get descriptor :result-type) :application (get descriptor :application)
              :direct-effects (get descriptor :direct-effects)}
   :invalidation (get descriptor :invalidation) :profile (get descriptor :profile) :target (get descriptor :target)
   :status :solved :diagnostics []})

(defn body-ae-call-fact [descriptor module]
  (let [source (get descriptor :source) edge (get descriptor :source-edge)]
    {:artifact :gravity/c7-call-type-fact
     :fact-id-request {:domain :gravity/sh08-atomic-equality-call-type-fact-v1 :application descriptor}
     :call-core-node-id (get descriptor :call-core-node-id) :caller-function-syntax-id (get edge :caller-function-syntax-id)
     :callee-function-syntax-id nil :argument-types (get descriptor :argument-types) :result-type (get descriptor :result-type)
     :evaluation-order :operator-then-arguments :source-span (get source :semantic-span) :syntax-id (get source :syntax-id)
     :origin-chain (get source :origin-chain) :generated-origin (get source :generated-origin)
     :profile (get module :profile) :target (get module :target) :effects (get descriptor :direct-effects) :capabilities [] :status :inferred
     :dispatch :direct-atomic-equality :applied-atomic-equality descriptor :effect-facts-source :audited-atomic-value-intrinsic}))


(defn body-ae-finish [header]
  (let [type (if (= :normal (get header :application)) :gravity.type/bool :gravity.type/never)]
    (assoc header :parameter-types (get header :argument-types) :return type :result-type type)))

(defn body-ae-context [request facts bindings budget]
  (let [core (get request :canonical-core-artifact)
        count-calls (loop [remaining (get core :calls) out 0]
                      (if (= 0 (count remaining)) out
                        (recur (rest remaining)
                          (+ out (if (body-ae-binding? (get bindings (get (first remaining) :operator-binding-id)) (get core :module)) 1 0)))))]
    (if (= 0 count-calls) {:status :accepted :context nil :work-count 0}
      (let [forms (body-path request [:b47-context :authenticated-core-request :forms])]
        (if (= false (vector? forms)) (body-failure :body-atomic-equality-source-forms-required)
          (let [work (+ (count forms) (count bindings) (count (get core :nodes)) (count (get core :calls)) (count (get core :call-edges))
                        (* count-calls (+ 66 (count (get core :function-records)))))]
            (if (> work budget) (body-failure :body-deferred-work-limit)
              {:status :accepted :work-count work
               :context {:forms (body-index forms :form-id) :nodes (body-index (get core :nodes) :node-id)
                         :calls (body-index (get core :calls) :core-node-id) :edges (body-index (get core :call-edges) :call-core-node-id)
                         :bindings bindings}})))))))

(defn body-ae-call-valid? [core facts bindings node call edge nodes]
  (let [types (get facts :type-table) descriptor (get types (get call :operator-node-id))
        header (body-ae-source core node call edge nodes bindings types (get core :module))
        forms (get (get facts :equality-context) :forms)
        owner (get forms (get (get node :source) :form-id)) ids (get owner :child-form-ids)
        rows (body-select (body-select (get facts :constraint-ledger) :producer-rule :sh08-atomic-equality-v1)
                          :lhs {:core-node-id (get node :node-id) :projection :atomic-equality})]
    (if (map? header)
      (body-all?
        [(= descriptor (body-ae-finish header)) (= (get descriptor :result-type) (get types (get node :node-id)))
         (= :list (get owner :kind)) (vector? ids) (= 3 (if (vector? ids) (count ids) 0) (count (get node :children)))
         (= (get node :source) (get (body-ma-form-node {} owner) :source))
         (= {:operator-child-index 0 :argument-count 2 :argument-child-indexes [1 2]
             :evaluation-order :operator-then-arguments :dispatch :resolved-symbol-call} (get node :attributes))
         (loop [i 0]
           (if (= i 3) true
             (let [form (get forms (get ids i)) child (get nodes (get (get node :children) i))]
               (if (body-all? [(= (get owner :form-id) (get form :parent-form-id))
                     (= (get child :source) (get (body-ma-form-node {} form) :source))
                     (if (= i 0) (= (get form :value) (get (get child :attributes) :symbol)) true)])
                 (recur (+ i 1)) false))))
         (= (body-ae-call-fact descriptor (get core :module)) (body-by (get facts :call-type-facts) :call-core-node-id (get node :node-id)))
         (= [(body-ae-constraint descriptor)] rows)]) false)))

(defn body-ae-node? [node facts core]
  (let [context (get facts :equality-context) id (get node :node-id)]
    (if (map? context)
      (body-ae-call-valid? core facts (get context :bindings) node (get (get context :calls) id)
                          (get (get context :edges) id) (get context :nodes)) false)))

(defn body-cq-binding? [binding module]
  (if (if (vector? (get binding :profile-set)) (vector? (get binding :target-set)) false)
  (body-all?
    [(= ['count :core :var 'gravity.core {:name 'gravity/core :version "bootstrap-contract-v1"} :gravity.type/core-var :safe]
        [(get binding :name) (get binding :binding-class) (get binding :kind) (get binding :namespace)
         (get binding :package) (get binding :type-ref) (get binding :safety)])
     (= [] (get binding :effects) (get binding :capabilities))
     (contains? (set (get binding :profile-set)) (get module :profile))
     (contains? (set (get binding :target-set)) :all)]) false))

(defn body-cq-list? [type]
  (if (= :gravity.type/list type) true
    (if (if (map? type) (= 3 (count type)) false)
      (if (= [:gravity.type/list :homogeneous] [(get type :kind) (get type :shape)])
        (if (keyword? (get type :element-type)) (body-hl-type? type) false)
        (if (= #{:kind :shape :element-types} (set (keys type)))
          (if (= [:gravity.type/list :literal] [(get type :kind) (get type :shape)])
            (vector? (get type :element-types)) false) false)) false)))

(defn body-cq-source [core node call edge nodes bindings types module]
  (if (if (vector? (get call :argument-node-ids))
        (if (= 1 (count (get call :argument-node-ids)))
          (if (vector? (get node :children)) (= 2 (count (get node :children))) false) false) false)
  (let [children (get node :children) operator (get nodes (get call :operator-node-id))
        bid (get call :operator-binding-id) binding (get bindings bid) args (get call :argument-node-ids)
        arguments [(get types (get args 0) :gravity.type/unknown)]
        list-input? (body-cq-list? (first arguments))
        invoked? (loop [remaining arguments]
                   (if (= 0 (count remaining)) true
                     (if (= :gravity.type/never (first remaining)) false (recur (rest remaining)))))
        caller (loop [remaining (get core :function-records)]
                 (if (= 0 (count remaining)) nil
                   (if (= (get (first remaining) :function-syntax-id) (get (get node :evaluation) :owner-function-syntax-id))
                     (first remaining) (recur (rest remaining)))))
        expected-call {:core-node-id (get node :node-id) :operator-node-id (first children) :operator-binding-id bid
                       :argument-node-ids (vec (rest children)) :ordered-evaluation-node-ids children
                       :evaluation-order :operator-then-arguments :result-policy :call-result}
        expected-edge {:ordinal (get edge :ordinal) :call-core-node-id (get node :node-id)
                       :caller-function-syntax-id (get caller :function-syntax-id) :caller-function-core-node-id (get caller :function-core-node-id)
                       :callee-binding-id bid :callee-definition-syntax-id (get binding :definition-syntax-id)
                       :callee-function-syntax-id nil :callee-function-core-node-id nil :argument-core-node-ids args
                       :ordered-evaluation-node-ids children :evaluation-order :operator-then-arguments :classification :nonlocal-or-nonfunction}]
    (if (body-all?
          [(= :call (get node :core-form)) (= :reference (get operator :core-form))
           (= 1 (count args)) (= expected-call call) (= expected-edge edge) (body-cq-binding? binding module)
           (= [bid] (get node :resolved-binding-ids) (get operator :resolved-binding-ids))
           (= {:symbol (get (get operator :attributes) :symbol) :position :operator :binding-id bid :binding-class :core
               :definition-syntax-id (get binding :definition-syntax-id)} (get operator :attributes))
           (contains? '#{count gravity.core/count} (get (get operator :attributes) :symbol))
           (= :operator-then-arguments (get (get node :evaluation) :kind))
           (= (loop [i 0 out []] (if (= i (count children)) out
                (recur (+ i 1) (conj out {:index i :core-node-id (get children i)})))) (get (get node :evaluation) :order))
           (if (= :gravity.type/never (first arguments)) true
             (if list-input? true
               (if (= :gravity.type/map (first arguments)) true
                 (if (keyword? (get (first arguments) :kind))
                   (contains? #{:gravity.type/map :gravity.type/vector} (get (first arguments) :kind)) false))))
           (if (= nil (first arguments)) false (= false (= :gravity.type/unknown (first arguments))))] )
      {:kind :gravity.type/applied-collection-count :version :sh08-collection-count-v1
       :operation 'count :semantic-owner 'gravity.collections :intrinsic :gravity.collections/finite-collection-count
       :resolution :gravity.core-compatibility :operator-node-id (get operator :node-id) :operator-binding-id bid
       :call-core-node-id (get node :node-id) :source (get node :source) :operator-source (get operator :source)
       :source-call call :source-edge edge :source-binding binding :argument-types arguments
       :query-semantics (if list-input?
                          {:operation :top-level-cardinality :construction :none :operand-evaluation :once
                           :normal-input :established-persistent-list :payload-evaluation :none :input-preserved? true
                           :result-domain :nonnegative-integer}
                          {:operation :top-level-cardinality :construction :none :operand-evaluation :once
                           :normal-input :established-map-or-vector})
       :application (if invoked? :normal :not-invoked)
       :latent-effects [] :direct-effects [] :capabilities [] :thrown-error-effects []
       :profile (get module :profile) :target (get module :target)
       :invalidation [:calls :call-edges :binding-table :source-forms :type-table :lexical-bindings :definitions :function-records
                      :callee-body :constructor-or-quote-shape :profile :target :evaluation-order]} nil)) nil))


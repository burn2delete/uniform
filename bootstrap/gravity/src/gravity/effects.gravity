          descriptor)) nil)) nil) nil))

(defn body-st-constraint [descriptor]
  (if (= :gravity.type/applied-list-set-conversion (get descriptor :kind))
    (body-lset-constraint descriptor)
    {:constraint-id-request {:domain :gravity/sh08-set-conversion-constraint-v1 :application descriptor}
   :kind :equality :producer-rule :sh08-set-conversion-v1
   :lhs {:core-node-id (get descriptor :call-core-node-id) :projection :set-conversion}
   :rhs (get descriptor :result-type) :dependencies descriptor :origin (get (get descriptor :source) :origin-chain)

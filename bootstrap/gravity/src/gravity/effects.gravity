                   :definition-syntax-id
                   (get binding :definition-syntax-id)}
                  (get operator :attributes))
                 (contains?
                  '#{gravity.core/= =}
                  (get (get operator :attributes) :symbol))
                 (body-ae-binding? binding (get core :module))
                 (=
                  {:operator-child-index 0,
                   :argument-count 2,
                   :argument-child-indexes [1 2],
                   :evaluation-order :operator-then-arguments,
                   :dispatch :resolved-symbol-call}
                  (get node :attributes))
                 (=
                  :operator-then-arguments
                  (get (get node :evaluation) :kind))
                 (=
                  [{:index 0, :core-node-id (get operator :node-id)}
                   {:index 1, :core-node-id (get slice-node :node-id)}

     :dispatch :direct-collection-count :applied-collection-count descriptor :effect-facts-source :audited-collection-intrinsic}))


(defn body-cq-finish [header]
  (let [type (if (= :normal (get header :application)) :gravity.type/integer :gravity.type/never)]
    (assoc header :parameter-types (get header :argument-types) :return type :result-type type)))

(defn body-cq-context [request facts bindings budget]
  (let [core (get request :canonical-core-artifact)
        count-calls (loop [remaining (get core :calls) out 0]
                      (if (= 0 (count remaining)) out
                        (recur (rest remaining)
                          (+ out (if (body-cq-binding? (get bindings (get (first remaining) :operator-binding-id)) (get core :module)) 1 0)))))]
    (if (= 0 count-calls) {:status :accepted :context nil :work-count 0}
      (let [forms (body-path request [:b47-context :authenticated-core-request :forms])]
        (if (= false (vector? forms)) (body-failure :body-collection-count-source-forms-required)
          (let [work (+ (count forms) (count bindings) (count (get core :nodes)) (count (get core :calls)) (count (get core :call-edges))
                        (* count-calls (+ 64 (count (get core :function-records)))))]
            (if (> work budget) (body-failure :body-deferred-work-limit)
              {:status :accepted :work-count work
               :context {:forms (body-index forms :form-id) :nodes (body-index (get core :nodes) :node-id)
                         :calls (body-index (get core :calls) :core-node-id) :edges (body-index (get core :call-edges) :call-core-node-id)
                         :bindings bindings}})))))))

(defn body-cq-call-valid? [core facts bindings node call edge nodes]
  ; This observational query depends on the authenticated operand type, not
  ; structural member selection. Its own no-construction semantics are finite.
  (let [types (get facts :type-table) descriptor (get types (get call :operator-node-id))
        header (body-cq-source core node call edge nodes bindings types (get core :module))
        forms (get (get facts :count-context) :forms)
        owner (get forms (get (get node :source) :form-id)) ids (get owner :child-form-ids)
        rows (body-select (body-select (get facts :constraint-ledger) :producer-rule :sh08-collection-count-v1)
                          :lhs {:core-node-id (get node :node-id) :projection :collection-cardinality})]
    (if (map? header)
      (body-all?
        [(= descriptor (body-cq-finish header)) (= (get descriptor :result-type) (get types (get node :node-id)))
         (= :list (get owner :kind)) (vector? ids) (= 2 (if (vector? ids) (count ids) 0) (count (get node :children)))
         (= (get node :source) (get (body-ma-form-node {} owner) :source))
         (= {:operator-child-index 0 :argument-count 1 :argument-child-indexes [1]
             :evaluation-order :operator-then-arguments :dispatch :resolved-symbol-call} (get node :attributes))
         (loop [i 0]
           (if (= i 2) true
             (let [form (get forms (get ids i)) child (get nodes (get (get node :children) i))]
               (if (body-all? [(= (get owner :form-id) (get form :parent-form-id))
                     (= (get child :source) (get (body-ma-form-node {} form) :source))
                     (if (= i 0) (= (get form :value) (get (get child :attributes) :symbol)) true)])
                 (recur (+ i 1)) false))))
         (= (body-cq-call-fact descriptor (get core :module)) (body-by (get facts :call-type-facts) :call-core-node-id (get node :node-id)))
         (= [(body-cq-constraint descriptor)] rows)]) false)))

(defn body-cq-node? [node facts core]
  (let [context (get facts :count-context) id (get node :node-id)]
    (if (map? context)
      (body-cq-call-valid? core facts (get context :bindings) node (get (get context :calls) id)
                          (get (get context :edges) id) (get context :nodes)) false)))

(defn body-si-binding? [binding module]
  (if (if (vector? (get binding :profile-set)) (vector? (get binding :target-set)) false)
  (body-all?
    [(= ['inc :core :var 'gravity.core {:name 'gravity/core :version "bootstrap-contract-v1"} :gravity.type/core-var :safe]
        [(get binding :name) (get binding :binding-class) (get binding :kind) (get binding :namespace)
         (get binding :package) (get binding :type-ref) (get binding :safety)])
     (= [] (get binding :effects) (get binding :capabilities))
     (contains? (set (get binding :profile-set)) (get module :profile))
     (contains? (set (get binding :target-set)) :all)]) false))

(defn body-si-source [core node call edge nodes bindings types module]
  (if (if (vector? (get call :argument-node-ids)) (vector? (get node :children)) false)
  (let [children (get node :children) operator (get nodes (get call :operator-node-id))
        bid (get call :operator-binding-id) binding (get bindings bid) args (get call :argument-node-ids)
        arguments (body-io-child-types args types)
        invoked? (loop [remaining arguments]
                   (if (= 0 (count remaining)) true
                     (if (= :gravity.type/never (first remaining)) false (recur (rest remaining)))))
        caller (loop [remaining (get core :function-records)]
                 (if (= 0 (count remaining)) nil
                   (if (= (get (first remaining) :function-syntax-id) (get (get node :evaluation) :owner-function-syntax-id))
                     (first remaining) (recur (rest remaining)))))
        expected-call {:core-node-id (get node :node-id) :operator-node-id (first children) :operator-binding-id bid
                       :argument-node-ids (vec (rest children)) :ordered-evaluation-node-ids children
                       :evaluation-order :operator-then-arguments :result-policy :call-result}
        expected-edge {:ordinal (get edge :ordinal) :call-core-node-id (get node :node-id)
                       :caller-function-syntax-id (get caller :function-syntax-id) :caller-function-core-node-id (get caller :function-core-node-id)
                       :callee-binding-id bid :callee-definition-syntax-id (get binding :definition-syntax-id)
                       :callee-function-syntax-id nil :callee-function-core-node-id nil :argument-core-node-ids args
                       :ordered-evaluation-node-ids children :evaluation-order :operator-then-arguments :classification :nonlocal-or-nonfunction}]
    (if (body-all?
          [(= :call (get node :core-form)) (= :reference (get operator :core-form))
           (= 1 (count args)) (= expected-call call) (= expected-edge edge) (body-si-binding? binding module)
           (= [bid] (get node :resolved-binding-ids) (get operator :resolved-binding-ids))
           (= {:symbol (get (get operator :attributes) :symbol) :position :operator :binding-id bid :binding-class :core
               :definition-syntax-id (get binding :definition-syntax-id)} (get operator :attributes))
           (contains? '#{inc gravity.core/inc} (get (get operator :attributes) :symbol))
           (= :operator-then-arguments (get (get node :evaluation) :kind))
           (= (loop [i 0 out []] (if (= i (count children)) out
                (recur (+ i 1) (conj out {:index i :core-node-id (get children i)})))) (get (get node :evaluation) :order))
           (= :gravity.type/integer (first arguments))
           (loop [remaining arguments]
             (if (= 0 (count remaining)) true
               (if (contains? #{nil :gravity.type/unknown} (first remaining)) false (recur (rest remaining)))))] )
      {:kind :gravity.type/applied-bounded-successor :version :sh08-bounded-successor-v1
       :operation 'inc :semantic-owner 'gravity.math :intrinsic :gravity.math.core/bounded-successor
       :resolution :gravity.core-compatibility :operator-node-id (get operator :node-id) :operator-binding-id bid
       :call-core-node-id (get node :node-id) :source (get node :source) :operator-source (get operator :source)
       :source-call call :source-edge edge :source-binding binding :argument-types arguments
       :numeric-mode :proof-required :layer0-owner 'gravity.math.core
       :successor-semantics {:operation :integer-unit-successor :construction :none :operand-evaluation :once
                             :normal-input :invariant-bounded-integer}
       :application :normal
       :latent-effects [] :direct-effects [] :capabilities [] :thrown-error-effects []
       :profile (get module :profile) :target (get module :target)
       :invalidation [:calls :call-edges :binding-table :source-forms :type-table :lexical-bindings :definitions :function-records
                      :loop-bindings :recur-targets :recur-transfers :callee-body :profile :target :evaluation-order]} nil)) nil))

(defn body-si-constraint [descriptor]
  {:constraint-id-request {:domain :gravity/sh08-bounded-successor-constraint-v1 :application descriptor}
   :kind :numeric-mode :producer-rule :sh08-bounded-successor-v1
   :lhs {:core-node-id (get descriptor :call-core-node-id) :projection :numeric-successor}

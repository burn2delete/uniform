                             (if (body-all? [(= (get owner :form-id) (get form :parent-form-id))
                                   (= (get child :source) (body-throw-source form))
                                   (if (= i 0) (= (get form :value) (get (get child :attributes) :symbol)) true)])
                               (recur (+ i 1)) false))))])
                  (recur (rest remaining)) false) false))))
        false))
    (= :sh08-bounded-successor-v1 (get proof :version))))

(defn body-si-proof-closed? [proof core node nodes bindings types]
  ; Finite consumers check the canonical premise links and arithmetic clause,
  ; not a caller-provided acceptance flag or a second range-analysis worklist.
  (let [target (body-si-record (get core :recur-targets) :target-id (get (get proof :target) :target-id))
        bid (first (get target :binding-ids)) slot (body-si-record (get core :loop-bindings) :binding-id bid)
        owner (get nodes (get target :owner-core-node-id)) initializer (get nodes (get slot :initializer-node-id))
        branch (get nodes (get (get owner :children) 1)) test (get nodes (first (get branch :children)))
        calls (body-index (get core :calls) :core-node-id) edges (body-index (get core :call-edges) :call-core-node-id)
        guard-call (get calls (get test :node-id)) guard-args (get guard-call :argument-node-ids)
        count-node (get nodes (get guard-args 1)) count-call (get calls (get count-node :node-id))
        count-header (body-cq-source core count-node count-call (get edges (get count-node :node-id)) nodes bindings types (get core :module))
        guard (body-io-descriptor core test guard-call (get edges (get test :node-id)) nodes bindings types (get core :module))
        expected (first (get count-header :argument-types)) extent (if (vector? (get expected :element-types)) (count (get expected :element-types)) nil)
        incoming (loop [remaining (get core :recur-transfers) out []]
                   (if (= 0 (count remaining)) out
                     (recur (rest remaining) (if (= (get target :target-id) (get (first remaining) :target-id)) (conj out (first remaining)) out))))
        extended? (loop [remaining incoming]
                    (if (= 0 (count remaining)) false
                      (let [call (get calls (first (get (first remaining) :argument-node-ids)))]
                        (if (= '+ (get (get bindings (get call :operator-binding-id)) :name)) true (recur (rest remaining))))))
        steps (get proof :step-sources)
        paths (get proof :backedge-paths) origin (get proof :vector-origin)
        true-id (get (get branch :children) 1) exit-id (get (get branch :children) 2)
        initial-source (get proof :initializer-source)]
    (if (if (map? count-header) (if (map? guard) (if (integer? extent) (vector? paths) false) false) false)
      (body-all? [(= :loop (get target :target-kind)) (= 1 (get target :arity)) (= 2 (count (get owner :children)))
        (= 0 (get (get initializer :attributes) :value) (get initial-source :value))
        (= :literal (get initializer :core-form)) (= :integer (get (get initializer :attributes) :literal-kind) (get initial-source :kind))
        (= (get initializer :source) (body-throw-source initial-source))
        (= :if (get branch :core-form)) (= 3 (count (get branch :children))) (= '< (get guard :operation))
        (= :normal (get count-header :application) (get guard :application))
        (= :reference (get (get nodes (first guard-args)) :core-form) (get (get nodes exit-id) :core-form))
        (= bid (get (get (get nodes (first guard-args)) :attributes) :binding-id) (get (get (get nodes exit-id) :attributes) :binding-id))
        (= :gravity.type/integer (get types (first guard-args)) (get types exit-id))
        (= :vector (get (get (get origin :node) :attributes) :literal-kind :vector))
        (body-si-origin-closed? origin (first (get count-call :argument-node-ids)) expected core nodes types)
        (> (count incoming) 0) (= (count incoming) (count paths))
        (if extended? (if (vector? steps) (= (count incoming) (count steps)) false) (= nil steps))
        (loop [index 0 found false]
          (if (= index (count incoming)) found
            (let [transfer (get incoming index) increment-id (first (get transfer :argument-node-ids))
                  increment (get nodes increment-id) call (get calls increment-id)
                  header (body-si-source core increment call (get edges increment-id) nodes bindings types (get core :module))
                  path (get paths index)]
              (if (if (vector? path)
                    (if (> (count path) 0)
                      (body-all? [(map? header) (if extended? (body-si-step-source-valid? (get steps index) header nodes) true)
                     (= 1 (count (get transfer :argument-node-ids)))
                     (= (get transfer :recur-core-node-id) (get (get (first path) :node) :node-id))
                     (= true-id (get (get (get path (- (count path) 1)) :node) :node-id))
                     (= increment-id (get (get (get (first path) :node) :children) 0))
                     (= bid (get (get (get nodes (first (get call :argument-node-ids))) :attributes) :binding-id))
                     (loop [i 0]
                       (if (= i (count path)) true
                         (let [entry (get path i) actual (get entry :node)]
                           (if (if (= actual (get nodes (get actual :node-id)))
                                 (if (= i 0) (= nil (get entry :child-index))
                                   (= (get (get (get path (- i 1)) :node) :node-id)
                                      (get (get actual :children) (get entry :child-index)))) false)
                             (recur (+ i 1)) false))))]) false) false)
                (recur (+ index 1) (if (= increment-id (get node :node-id)) true found)) false))))
        (= proof (let [expected {:kind :gravity.safety/bounded-integer-successor
          :version (if extended? :sh08-bounded-unit-step-v2 :sh08-bounded-successor-v1)
          :rule "SAFE9-OVERFLOW" :outcome :proven-safe :scope :unit-step-loop-invariant
          :numeric-mode :proof-required :integer-type :gravity.type/integer
          :target target :slot slot :initializer initializer :initializer-source initial-source :loop-node owner :guard-node branch
          :condition guard :count-query (body-cq-finish count-header) :vector-origin origin
          :vector-extent extent :incoming-transfers incoming :backedge-paths paths :transfer-census :complete
          :slot-binding-id bid :operation-core-node-id (get node :node-id)
          :invariant {:lower 0 :upper extent :relation :zero-le-counter-le-extent}
          :guarded-edge {:relation :zero-le-counter-lt-extent :satisfiable (> extent 0) :consequence :zero-lt-successor-le-extent}
          :normal-exit {:core-node-id exit-id :relation :counter-equals-extent}
          :check-elision :not-authorized :runtime-guards :retained :termination :not-claimed}]
          (if extended? (assoc expected :step-sources steps) expected)))]) false)))

(defn body-ix-finish [header range node call nodes]
  (if (= :gravity.type/applied-bounded-unit-addition (get header :kind))
    (body-si-finish (assoc header :range-proof range))
    (body-vn-finish
      (assoc header :version :sh08-vector-get-indexed-private-self-v1
        :query-semantics (assoc (get header :query-semantics) :normal-input :indexed-private-self-vector-and-index)
        :bounds-proof {:kind :gravity.safety/vector-index-bounds :rule "SAFE2-BOUNDS" :outcome :proven-safe
                       :scope :indexed-private-self-equality-false-edge :predicate :zero-le-index-lt-length
                       :access-core-node-id (get node :node-id) :vector-node-id (first (get call :argument-node-ids))
                       :index-node-id (get (get call :argument-node-ids) 1)
                       :vector-type (first (get header :argument-types)) :index-value nil :vector-length 7
                       :selected-type :gravity.type/keyword
                       :index-source (get (get nodes (get (get call :argument-node-ids) 1)) :source)
                       :source-induction range :check-elision :not-authorized :runtime-guards :retained}))))

(defn body-ix-call-valid? [core facts bindings node call edge nodes]
  (let [types (get facts :type-table) descriptor (get types (get call :operator-node-id))
        addition? (= :sh08-indexed-private-self-unit-addition-v1 (get descriptor :version))
        premise (get core :sh08-private-self-parameter-premise) range (get premise :source-induction)
        forms (get (get facts (if addition? :successor-context :map-get-context)) :forms)
        header (if addition? (body-si-source core node call edge nodes bindings types (get core :module))
                             (body-vl-source core node call edge nodes bindings types (get core :module)))
        expected (if (map? header) (body-ix-finish header range node call nodes) nil)
        row (if addition? (body-si-constraint expected) (body-vn-constraint expected))
        rows (body-select (body-select (get facts :constraint-ledger) :producer-rule (get row :producer-rule))
                          :lhs (get row :lhs))]
    (if (map? expected)
      (body-all?
        [(= :gravity/sh08-indexed-private-self-entry-premise-v1 (get premise :domain))
         (= header (get range (if addition? :step-header :access-header)))
         (= expected descriptor) (= (get expected :result-type) (get types (get node :node-id)))
         (body-ix-call-forms? node nodes forms)
         (= (if addition? (body-si-call-fact expected (get core :module)) (body-vn-call-fact expected (get core :module)))
            (body-by (get facts :call-type-facts) :call-core-node-id (get node :node-id)))
         (= [row] rows)]) false)))

(defn body-si-context [request facts bindings]
  (let [core (get request :canonical-core-artifact)
        addition? (loop [remaining (get core :calls)]
                    (if (= 0 (count remaining)) false
                      (let [binding (get bindings (get (first remaining) :operator-binding-id))]

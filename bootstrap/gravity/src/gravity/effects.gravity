(defn body-pl-conj-rows [ledger families]
  (loop [remaining ledger rows {}]
    (if (= 0 (count remaining))
      (if (= (set (keys families)) (set (keys rows))) {:status :accepted :rows rows}
        (body-failure :body-conj-constraint-census))
      (let [row (first remaining) producer (get row :producer-rule)]
        (if (if (keyword? producer) (contains? #{:sh08-vector-append-v1 :sh08-list-prepend-v1 :sh08-string-set-insertion-v2 :sh08-keyword-set-insertion-v1 :sh08-symbol-set-insertion-v2} producer) false)
          (let [lhs (get row :lhs) id (if (map? lhs) (get lhs :core-node-id) nil)
                closed? (if (map? lhs) (if (= 2 (count lhs))
                            (if (keyword? (get lhs :projection))
                              (if (keyword? id) true (if (string? id) (= 71 (count id)) false)) false) false) false)
                family (if closed? (get families id) nil)]
            (if (if closed? (if (contains? families id) (= false (contains? rows id)) false) false)
              (if (= [producer (get (get row :lhs) :projection)]
                     (if (= family :symbol-set-insertion)
            [:sh08-symbol-set-insertion-v2 :symbol-set-insertion]
            (if (= family :keyword-set-insertion) [:sh08-keyword-set-insertion-v1 :keyword-set-insertion]
                       (if (= family :string-set-insertion) [:sh08-string-set-insertion-v2 :string-set-insertion]
                       (if (= family :list-prepend) [:sh08-list-prepend-v1 :list-prepend]
                         (if (= family :vector-append) [:sh08-vector-append-v1 :vector-append] nil))))))
                (recur (rest remaining) (assoc rows id row)) (body-failure :body-conj-constraint-family))
              (body-failure :body-conj-constraint-census)))
          (recur (rest remaining) rows))))))

(defn body-va-context [request facts bindings]
  (let [core (get request :canonical-core-artifact) calls (get core :calls) ledger (get facts :constraint-ledger)
        count-calls (loop [remaining calls out 0]
                      (if (= 0 (count remaining)) out
                        (recur (rest remaining)
                          (+ out (if (body-va-binding? (get bindings (get (first remaining) :operator-binding-id)) (get core :module)) 1 0)))))]
    (if (= 0 count-calls)
      (let [rows (body-pl-conj-rows ledger {})]
        (if (= :accepted (get rows :status)) {:status :accepted :context nil} rows))
      (let [forms (body-path request [:b47-context :authenticated-core-request :forms])]
        (if (= false (vector? forms))
          (body-failure :body-vector-append-source-forms-required)
          (let [nodes (body-index (get core :nodes) :node-id)
                call-index (body-index calls :core-node-id)
                edges (body-index (get core :call-edges) :call-core-node-id)
                call-facts (body-index (get facts :call-type-facts) :call-core-node-id)
                types (get facts :type-table)]
            (if (= false (= (count call-facts) (count (get facts :call-type-facts))))
              (body-failure :body-conj-call-fact-census)
              (loop [remaining calls checks {} families {}]
                (if (= 0 (count remaining))
                  (let [rows (body-pl-conj-rows ledger families)]
                    (if (= :accepted (get rows :status))
                      {:status :accepted
                       :context {:forms (body-index forms :form-id) :nodes nodes :calls call-index :edges edges
                                 :bindings bindings :type-checks checks :families families
                                 :conj-rows (get rows :rows) :call-facts call-facts}}
                      rows))
                  (let [call (first remaining)
                        args (get call :argument-node-ids)
                        id (get call :core-node-id)
                        bound? (body-va-binding? (get bindings (get call :operator-binding-id)) (get core :module))
                        receiver (get types (get args 0))
                        receiver-valid? (if (body-pl-list? receiver) true
                                         (if (= :gravity.type/set receiver) true
                                           (if (body-lc-native-map? receiver)
                                             (= :gravity.type/set (get receiver :kind)) false)))
                        child-shape? (if (vector? (get (get nodes id) :children))
                                       (= 3 (count (get (get nodes id) :children))) false)]
                    (if (= false bound?)
                      (recur (rest remaining) checks families)
                      (if (= false (vector? args))
                        (body-failure :body-conj-call-shape-required)
                        (if (= false (= 2 (count args)))
                          (body-failure :body-conj-arity-required)
                          (if (= false receiver-valid?)
                            (recur (rest remaining) checks (assoc families id :vector-append))
                            (if (= false child-shape?)
                              (body-failure :body-conj-call-shape-required)
                              (let [validation (body-pl-validate-types
                                                 [(get types (get args 0) :gravity.type/unknown)
                                                  (get types (get args 1) :gravity.type/unknown)])]
                                (if (= :accepted (get validation :status))
                                  (recur (rest remaining) (assoc checks id validation)
                                    (assoc families id
                                      (if (= :symbol-set-insertion (get validation :collection-family))
                                        :symbol-set-insertion
                                        (if (= :keyword-set-insertion (get validation :collection-family))
                                          :keyword-set-insertion
                                          (if (= :string-set-insertion (get validation :collection-family))
                                            :string-set-insertion :list-prepend)))))
                                  (body-failure (get validation :reason)))))))))))))))))))

(defn body-pl-call-valid? [core facts bindings node call edge nodes]
  (if (body-sse-call-ids? node call)
    (let [types (get facts :type-table)
        validation (get (get (get facts :append-context) :type-checks) (get node :node-id))
        descriptor (get types (get call :operator-node-id))
        header (if (body-pl-validation? validation) (if (= validation (body-pl-validate-types (body-io-child-types (get call :argument-node-ids) types))) (body-pl-source core node call edge nodes bindings types (get core :module) validation) nil) nil)
        forms (get (get facts :append-context) :forms)
        owner (get forms (get (get node :source) :form-id)) ids (get owner :child-form-ids)
        row (get (get (get facts :append-context) :conj-rows) (get node :node-id))
        rows (if (map? row) [row] [])]
    (if (if (map? header)
          (if (= :symbol-set-insertion (get validation :collection-family))
            (body-ksin-call-forms? node nodes forms)
            (if (= :keyword-set-insertion (get validation :collection-family)) (body-ksin-call-forms? node nodes forms) true)) false)
      (body-all?
        [(= descriptor (body-pl-finish header)) (= (get descriptor :result-type) (get types (get node :node-id)))
         (= :list (get owner :kind)) (vector? ids) (= 3 (if (vector? ids) (count ids) 0) (count (get node :children)))
         (= (get node :source) (get (body-ma-form-node {} owner) :source))
         (= {:operator-child-index 0 :argument-count 2 :argument-child-indexes [1 2]
             :evaluation-order :operator-then-arguments :dispatch :resolved-symbol-call} (get node :attributes))
         (loop [i 0]
           (if (= i 3) true
             (let [form (get forms (get ids i)) child (get nodes (get (get node :children) i))]
               (if (body-all? [(= (get owner :form-id) (get form :parent-form-id))
                     (= (get child :source) (get (body-ma-form-node {} form) :source))
                     (if (= i 0) (= (get form :value) (get (get child :attributes) :symbol)) true)])
                 (recur (+ i 1)) false))))
         (= (body-pl-call-fact descriptor (get core :module)) (get (get (get facts :append-context) :call-facts) (get node :node-id)))
         (= [(body-pl-constraint descriptor)] rows)]) false))
    false))

(defn body-va-call-valid? [core facts bindings node call edge nodes]
  (let [types (get facts :type-table) descriptor (get types (get call :operator-node-id))
        header (body-va-source core node call edge nodes bindings types (get core :module))
        forms (get (get facts :append-context) :forms)
        owner (get forms (get (get node :source) :form-id)) ids (get owner :child-form-ids)
        rows (body-select (body-select (get facts :constraint-ledger) :producer-rule :sh08-vector-append-v1)
                          :lhs {:core-node-id (get node :node-id) :projection :vector-append})]
    (if (map? header)
      (body-all?
        [(= descriptor (body-va-finish header)) (= (get descriptor :result-type) (get types (get node :node-id)))
         (= :list (get owner :kind)) (vector? ids) (= 3 (if (vector? ids) (count ids) 0) (count (get node :children)))
         (= (get node :source) (get (body-ma-form-node {} owner) :source))
         (= {:operator-child-index 0 :argument-count 2 :argument-child-indexes [1 2]
             :evaluation-order :operator-then-arguments :dispatch :resolved-symbol-call} (get node :attributes))
         (loop [i 0]
           (if (= i 3) true
             (let [form (get forms (get ids i)) child (get nodes (get (get node :children) i))]
               (if (body-all? [(= (get owner :form-id) (get form :parent-form-id))
                     (= (get child :source) (get (body-ma-form-node {} form) :source))
                     (if (= i 0) (= (get form :value) (get (get child :attributes) :symbol)) true)])
                 (recur (+ i 1)) false))))
         (= (body-va-call-fact descriptor (get core :module)) (body-by (get facts :call-type-facts) :call-core-node-id (get node :node-id)))
         (= [(body-va-constraint descriptor)] rows)]) false)))

(defn body-va-node? [node facts core]
  (let [context (get facts :append-context) id (get node :node-id)]
    (if (map? context)
      (if (contains? #{:list-prepend :string-set-insertion :keyword-set-insertion :symbol-set-insertion} (get (get context :families) id))
        (body-pl-call-valid? core facts (get context :bindings) node (get (get context :calls) id)
                            (get (get context :edges) id) (get context :nodes))
        (if (= :vector-append (get (get context :families) id))
          (body-va-call-valid? core facts (get context :bindings) node (get (get context :calls) id)
                              (get (get context :edges) id) (get context :nodes)) false)) false)))

; L2/L5/STD3 evaluated first-order values, not syntax or quoted-data authority.
(defn body-hl-type? [type]
  (if (map? type)
    (if (= #{:kind :shape :element-type} (set (keys type)))
      (if (= [:gravity.type/list :homogeneous] [(get type :kind) (get type :shape)])
        (contains? #{:gravity.type/i8 :gravity.type/i16 :gravity.type/i32 :gravity.type/i64
                  :gravity.type/u8 :gravity.type/u16 :gravity.type/u32 :gravity.type/u64
                  :gravity.type/f32 :gravity.type/f64 :gravity.type/bool :gravity.type/string
                  :gravity.type/symbol :gravity.type/keyword :gravity.type/ratio} (get type :element-type)) false) false) false))

(defn body-lc-ancestor? [value ancestors]
  (loop [index 0]
    (if (= index (count ancestors)) false
      (if (bootstrap-native-identical? value (get ancestors index)) true
        (recur (+ index 1))))))

(defn body-lc-native-view? [value]
  ; Inspect raw native headers before count/indexing. Only visible view DATA
  ; is subsequently traversed; metadata and unused backing slots stay inert.
  (loop [current value ancestors []]
    (if (body-lc-ancestor? current ancestors) false
      (let [header (bootstrap-native-carrier-header current) kind (get header 0)]
        (if (= :vector kind) (>= (get header 2) 0)
          (if (= :subvector kind)
            (let [extent (get header 2) start (get header 5)
                  backing (get header 4) backing-header (bootstrap-native-carrier-header backing)]
              (if (contains? #{:vector :subvector} (get backing-header 0))
                (if (if (>= start 0) (if (>= extent 0)
                      (if (>= (get backing-header 2) 0)
                        (<= (+ start extent) (get backing-header 2)) false) false) false)
                  (recur backing (conj ancestors current)) false) false)) false))))))

(defn body-lc-native-map? [value]
  (let [header (bootstrap-native-carrier-header value) kind (get header 0)]
    (if (if (= :map kind) true
          (if (= :tree-map kind) (= :default-comparator (get header 4)) false))
      (if (>= (get header 2) 0)
        ; These type schemas have at most three named fields. This is their
        ; closed grammar, not an allowance on nested members.
        (if (<= (get header 2) 3)
          (loop [fields (keys value)]
            (if (= 0 (count fields)) true
              (if (keyword? (first fields)) (recur (rest fields)) false))) false) false) false)))

(defn body-lc-native-arguments [arguments]
  (let [header (bootstrap-native-carrier-header arguments) kind (get header 0)]
    (if (contains? #{:nil :empty-list} kind)
      {:status :accepted :arguments []}
      (if (contains? #{:vector :subvector} kind)
        (if (body-lc-native-view? arguments)
          {:status :accepted :arguments arguments}
          {:status :rejected :reason :unsupported-arguments})
        (if (= :list-node kind)
          ; Follow the existing header's logical native List/Cons spine.
          ; PersistentList.next hides its raw tail at count one; that hidden
          ; DATA stays inert. Visible native counts must agree with the spine.
          (loop [current arguments ancestors [] out []]
            (if (body-lc-ancestor? current ancestors)
              {:status :rejected :reason :cyclic-arguments}
              (let [node (bootstrap-native-carrier-header current) tag (get node 0)]
                (if (contains? #{:nil :empty-list} tag)
                  {:status :accepted :arguments out}
                  (if (= :list-node tag)
                    (let [next (get node 5) extent (get node 2)
                          next-ancestors (conj ancestors current)]
                      (if (body-lc-ancestor? next next-ancestors)
                        {:status :rejected :reason :cyclic-arguments}
                        (let [next-header (bootstrap-native-carrier-header next)
                              coherent? (if (= extent nil) true
                                          (if (> extent 0)
                                            (if (= extent 1)
                                              (contains? #{:nil :empty-list} (get next-header 0))
                                              (if (= :list-node (get next-header 0))
                                                (= (- extent 1) (get next-header 2)) false)) false))]
                          (if coherent? (recur next next-ancestors (conj out (get node 4)))
                            {:status :rejected :reason :unsupported-arguments}))))
                    {:status :rejected :reason :unsupported-arguments})))))
          {:status :rejected :reason :unsupported-arguments})))))

(defn body-lc-validate-types [arguments]
  (let [ingress (body-lc-native-arguments arguments)]
    (if (= :accepted (get ingress :status))
      (let [arguments (get ingress :arguments)]
        (loop [pending (loop [remaining arguments out []]
                         (if (= 0 (count remaining)) out
                           (recur (rest remaining)
                                  (conj out {:type (first remaining) :ancestors [] :operand? true}))))]
          (if (= 0 (count pending)) {:status :accepted}
            (let [frame (get pending (- (count pending) 1)) type (get frame :type)
                  ancestors (get frame :ancestors)
                  tail (subvec pending 0 (- (count pending) 1))]
              (if (if (keyword? type)
                    (contains? #{:gravity.type/nil :gravity.type/bool :gravity.type/integer :gravity.type/decimal :gravity.type/ratio
                                 :gravity.type/i8 :gravity.type/i16 :gravity.type/i32 :gravity.type/i64
                                 :gravity.type/u8 :gravity.type/u16 :gravity.type/u32 :gravity.type/u64
                                 :gravity.type/f32 :gravity.type/f64 :gravity.type/character :gravity.type/string
                                 :gravity.type/symbol :gravity.type/keyword :gravity.type/list :gravity.type/vector
                                 :gravity.type/map :gravity.type/set} type) false)
                (recur tail)
                (if (= :gravity.type/never type)
                  (if (get frame :operand?) (recur tail)
                    {:status :rejected :reason :nested-never})
                  (if (body-lc-native-map? type)
                    (if (body-lc-ancestor? type ancestors)
                      {:status :rejected :reason :cyclic-type}
                      (let [kind (get type :kind) members? (= :gravity.type/map kind)
                            homogeneous? (if (body-ss-type? type) true
                                           (if (body-syc-type? type) true
                                             (if (keyword? (get type :element-type)) (body-hl-type? type) false)))
                            nil-bearing? (if (keyword? (get type :value-type)) (body-ni-type? type) false)
                            children (if nil-bearing? [(get type :value-type)]
                                       (if homogeneous? [(get type :element-type)]
                                         (get type (if members? :member-types :element-types))))
                            valid? (if nil-bearing? true
                                     (if homogeneous? true
                                       (if (if (keyword? kind)
                                             (contains? #{:gravity.type/list :gravity.type/vector :gravity.type/map :gravity.type/set} kind) false)
                                         (if (= (if members? #{:kind :member-types :shape} #{:kind :element-types :shape}) (set (keys type)))
                                           (if (= :literal (get type :shape))
                                             (if (body-lc-native-view? children)
                                               (if members?
                                                 (loop [remaining children]
                                                   (if (= 0 (count remaining)) true
                                                     (if (= 1 (count remaining)) false
                                                       (recur (rest (rest remaining)))))) true) false) false) false) false)))
                            next-ancestors (conj ancestors type)]
                        (if valid?
                          (recur (loop [remaining children out tail]
                                   (if (= 0 (count remaining)) out
                                     (recur (rest remaining)
                                            (conj out {:type (first remaining) :ancestors next-ancestors :operand? false})))))
                          {:status :rejected :reason :malformed-type})))
                    {:status :rejected :reason :unsupported-type})))))))
      ingress)))

(defn body-lc-binding? [binding module]
  (if (if (vector? (get binding :profile-set)) (vector? (get binding :target-set)) false)
  (body-all?
    [(= ['list :core :var 'gravity.core {:name 'gravity/core :version "bootstrap-contract-v1"} :gravity.type/core-var :safe]
        [(get binding :name) (get binding :binding-class) (get binding :kind) (get binding :namespace)
         (get binding :package) (get binding :type-ref) (get binding :safety)])
     (= [] (get binding :effects) (get binding :capabilities))
     (contains? (set (get binding :profile-set)) (get module :profile))
     (contains? (set (get binding :target-set)) :all)]) false))

(defn body-lc-source [core node call edge nodes bindings types module validation]
  (if (body-lc-native-map? validation)
    (if (= {:status :accepted} validation)
      (if (if (vector? (get call :argument-node-ids)) (vector? (get node :children)) false)
  (let [children (get node :children) operator (get nodes (get call :operator-node-id))
        bid (get call :operator-binding-id) binding (get bindings bid) args (get call :argument-node-ids)
        arguments (body-io-child-types args types)
        invoked? (loop [remaining arguments]
                   (if (= 0 (count remaining)) true
                     (if (= :gravity.type/never (first remaining)) false (recur (rest remaining)))))
        caller (loop [remaining (get core :function-records)]
                 (if (= 0 (count remaining)) nil
                   (if (= (get (first remaining) :function-syntax-id) (get (get node :evaluation) :owner-function-syntax-id))
                     (first remaining) (recur (rest remaining)))))
        expected-call {:core-node-id (get node :node-id) :operator-node-id (first children) :operator-binding-id bid
                       :argument-node-ids (vec (rest children)) :ordered-evaluation-node-ids children
                       :evaluation-order :operator-then-arguments :result-policy :call-result}
        expected-edge {:ordinal (get edge :ordinal) :call-core-node-id (get node :node-id)
                       :caller-function-syntax-id (get caller :function-syntax-id) :caller-function-core-node-id (get caller :function-core-node-id)
                       :callee-binding-id bid :callee-definition-syntax-id (get binding :definition-syntax-id)
                       :callee-function-syntax-id nil :callee-function-core-node-id nil :argument-core-node-ids args
                       :ordered-evaluation-node-ids children :evaluation-order :operator-then-arguments :classification :nonlocal-or-nonfunction}]
    (if (body-all?
          [(= :call (get node :core-form)) (= :reference (get operator :core-form))
           (= expected-call call) (= expected-edge edge) (body-lc-binding? binding module)
           (= [bid] (get node :resolved-binding-ids) (get operator :resolved-binding-ids))
           (= {:symbol (get (get operator :attributes) :symbol) :position :operator :binding-id bid :binding-class :core
               :definition-syntax-id (get binding :definition-syntax-id)} (get operator :attributes))
           (contains? '#{list gravity.core/list} (get (get operator :attributes) :symbol))
           (= :operator-then-arguments (get (get node :evaluation) :kind))
           (= (loop [i 0 out []] (if (= i (count children)) out
                (recur (+ i 1) (conj out {:index i :core-node-id (get children i)})))) (get (get node :evaluation) :order))
           (= :accepted (get validation :status))] )
      {:kind :gravity.type/applied-list-construction :version :sh08-list-construction-v1
       :operation 'list :semantic-owner 'gravity.collections :intrinsic :gravity.collections/evaluated-list
       :resolution :gravity.core-compatibility :operator-node-id (get operator :node-id) :operator-binding-id bid
       :call-core-node-id (get node :node-id) :source (get node :source) :operator-source (get operator :source)
       :source-call call :source-edge edge :source-binding binding :argument-types arguments
       :construction-policy {:value-kind :list :order :operand-order :operand-evaluation :once-left-to-right
                             :values :preserved :nesting :preserved :duplicates :preserved
                             :allocation :normal-invocation-even-empty}
       :value-origin {:kind :evaluated-list-construction :operand-node-ids args}

       :application (if invoked? :normal :not-invoked)
       :latent-effects [:memory/allocate] :direct-effects (if invoked? [:memory/allocate] []) :capabilities [] :thrown-error-effects []
       :profile (get module :profile) :target (get module :target)
       :invalidation [:calls :call-edges :binding-table :source-forms :type-table :lexical-bindings :definitions :function-records
                      :callee-body :operand-types :construction-policy :value-origin :allocation-condition :profile :target :evaluation-order]} nil)) nil) nil) nil))

(defn body-lc-constraint [descriptor]
  {:constraint-id-request {:domain :gravity/sh08-list-construction-constraint-v1 :application descriptor}
   :kind :equality :producer-rule :sh08-list-construction-v1
   :lhs {:core-node-id (get descriptor :call-core-node-id) :projection :list-construction}
   :rhs (get descriptor :result-type) :dependencies descriptor :origin (get (get descriptor :source) :origin-chain)
   :solution {:result-type (get descriptor :result-type) :application (get descriptor :application)
              :direct-effects (get descriptor :direct-effects)}
   :invalidation (get descriptor :invalidation) :profile (get descriptor :profile) :target (get descriptor :target)
   :status :solved :diagnostics []})

(defn body-lc-call-fact [descriptor module]
  (let [source (get descriptor :source) edge (get descriptor :source-edge)]
    {:artifact :gravity/c7-call-type-fact
     :fact-id-request {:domain :gravity/sh08-list-construction-call-type-fact-v1 :application descriptor}
     :call-core-node-id (get descriptor :call-core-node-id) :caller-function-syntax-id (get edge :caller-function-syntax-id)
     :callee-function-syntax-id nil :argument-types (get descriptor :argument-types) :result-type (get descriptor :result-type)
     :evaluation-order :operator-then-arguments :source-span (get source :semantic-span) :syntax-id (get source :syntax-id)
     :origin-chain (get source :origin-chain) :generated-origin (get source :generated-origin)
     :profile (get module :profile) :target (get module :target) :effects (get descriptor :direct-effects) :capabilities [] :status :inferred
     :dispatch :direct-list-construction :applied-list-construction descriptor :effect-facts-source :audited-collection-constructor}))


(defn body-lc-finish [header]
  (let [type (if (= :normal (get header :application))
               {:kind :gravity.type/list :element-types (get header :argument-types) :shape :literal} :gravity.type/never)]
    (assoc header :parameter-types (get header :argument-types) :return type :result-type type)))

(defn body-lc-context [request facts bindings]
  (let [core (get request :canonical-core-artifact)
        present? (loop [remaining (get core :calls)]
                   (if (= 0 (count remaining)) false
                     (if (body-lc-binding? (get bindings (get (first remaining) :operator-binding-id)) (get core :module))
                       true (recur (rest remaining)))))]
    (if (= false present?) {:status :accepted :context nil}
      (let [forms (body-path request [:b47-context :authenticated-core-request :forms])]
        (if (= false (vector? forms)) (body-failure :body-list-construction-source-forms-required)
          (loop [remaining (get core :calls) checks {}]
              (if (= 0 (count remaining))
                {:status :accepted
                 :context {:forms (body-index forms :form-id) :nodes (body-index (get core :nodes) :node-id)
                           :calls (body-index (get core :calls) :core-node-id) :edges (body-index (get core :call-edges) :call-core-node-id)
                           :bindings bindings :type-checks checks}}
                (let [call (first remaining) args (get call :argument-node-ids)]
                  (if (body-lc-binding? (get bindings (get call :operator-binding-id)) (get core :module))
                    (let [validation (body-lc-validate-types (body-io-child-types args (get facts :type-table)))]
                      (if (= :accepted (get validation :status))
                        (recur (rest remaining) (assoc checks (get call :core-node-id) validation))
                        (body-failure :body-list-construction-operand-type-required)))
                    (recur (rest remaining) checks))))))))))

(defn body-lc-call-valid? [core facts bindings node call edge nodes]
  (let [types (get facts :type-table) descriptor (get types (get call :operator-node-id))
        validation (get (get (get facts :list-construction-context) :type-checks) (get node :node-id))
        header (body-lc-source core node call edge nodes bindings types (get core :module) validation)
        forms (get (get facts :list-construction-context) :forms)
        owner (get forms (get (get node :source) :form-id)) ids (get owner :child-form-ids)
        rows (body-select (body-select (get facts :constraint-ledger) :producer-rule :sh08-list-construction-v1)
                          :lhs {:core-node-id (get node :node-id) :projection :list-construction})]
    (if (map? header)
      (body-all?
        [(= descriptor (body-lc-finish header)) (= (get descriptor :result-type) (get types (get node :node-id)))
         (= :list (get owner :kind)) (vector? ids) (= (+ 1 (count (get call :argument-node-ids))) (if (vector? ids) (count ids) 0) (count (get node :children)))
         (= (get node :source) (get (body-ma-form-node {} owner) :source))
         (= {:operator-child-index 0 :argument-count (count (get call :argument-node-ids)) :argument-child-indexes (loop [index 1 out []] (if (= index (count (get node :children))) out (recur (+ index 1) (conj out index))))
             :evaluation-order :operator-then-arguments :dispatch :resolved-symbol-call} (get node :attributes))
         (loop [i 0]
           (if (= i (count (get node :children))) true
             (let [form (get forms (get ids i)) child (get nodes (get (get node :children) i))]
               (if (body-all? [(= (get owner :form-id) (get form :parent-form-id))
                     (= (get child :source) (get (body-ma-form-node {} form) :source))
                     (if (= i 0) (= (get form :value) (get (get child :attributes) :symbol)) true)])
                 (recur (+ i 1)) false))))
         (= (body-lc-call-fact descriptor (get core :module)) (body-by (get facts :call-type-facts) :call-core-node-id (get node :node-id)))
         (= [(body-lc-constraint descriptor)] rows)]) false)))

(defn body-lc-node? [node facts core]

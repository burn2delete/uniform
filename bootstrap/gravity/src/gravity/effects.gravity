(defn body-nilp-context [request facts bindings]
  (let [core (get request :canonical-core-artifact) calls (get core :calls)
        forms (body-path request [:b47-context :authenticated-core-request :forms])]
    (if (= false (body-all? [(vector? calls) (vector? (get core :nodes)) (vector? (get core :call-edges))]))
      (body-failure :body-nil-predicate-families-required)
      (let [selected (loop [remaining calls out []]
                       (if (= 0 (count remaining)) out
                         (let [call (first remaining)]
                           (recur (rest remaining)
                             (if (body-nilp-binding? (if (if (keyword? (get call :operator-binding-id)) true (if (string? (get call :operator-binding-id)) (= 71 (count (get call :operator-binding-id))) false)) (get bindings (get call :operator-binding-id)) nil) (get core :module))
                               (conj out call) out)))))]
        (if (= 0 (count selected)) {:status :accepted :context nil}
          (if (= false (vector? forms)) (body-failure :body-nil-predicate-source-forms-required)
            (let [nodes (body-index (get core :nodes) :node-id)]
              (loop [remaining selected checks {}]
                (if (= 0 (count remaining))
                  {:status :accepted
                   :context {:forms (body-index forms :form-id) :nodes nodes :calls (body-index calls :core-node-id)
                             :edges (body-index (get core :call-edges) :call-core-node-id) :bindings bindings :checks checks}}
                  (let [call (first remaining) args (get call :argument-node-ids)
                        children (get (if (if (keyword? (get call :core-node-id)) true (if (string? (get call :core-node-id)) (= 71 (count (get call :core-node-id))) false)) (get nodes (get call :core-node-id)) nil) :children)]
                    (if (if (vector? args) (if (= 1 (count args))
                          (if (vector? children) (= 2 (count children)) false) false) false)
                      (let [type (if (if (keyword? (first args)) true (if (string? (first args)) (= 71 (count (first args))) false)) (get (get facts :type-table) (first args) :gravity.type/unknown) :gravity.type/unknown)
                            validation (body-lc-validate-types [type])]
                        (if (= :accepted (get validation :status))
                          (recur (rest remaining)
                            (assoc checks (get call :core-node-id) {:argument-type type :validation validation}))
                          (body-failure :body-nil-predicate-operand-type-required)))
                      (body-failure :body-nil-predicate-arity-mismatch))))))))))))

(defn body-nilp-call-valid? [core facts bindings node call edge nodes]
  (if (if (vector? (get call :argument-node-ids)) (if (= 1 (count (get call :argument-node-ids))) (if (vector? (get node :children)) (= 2 (count (get node :children))) false) false) false)
(if (loop [remaining (conj (conj (conj (conj (conj (get call :argument-node-ids) (get call :operator-node-id)) (get call :operator-binding-id)) (get node :node-id)) (get (get node :source) :form-id)) (get (get node :source) :syntax-id))] (if (= 0 (count remaining)) (loop [remaining (get node :children)] (if (= 0 (count remaining)) true (if (if (keyword? (first remaining)) true (if (string? (first remaining)) (= 71 (count (first remaining))) false)) (recur (rest remaining)) false))) (if (if (keyword? (first remaining)) true (if (string? (first remaining)) (= 71 (count (first remaining))) false)) (recur (rest remaining)) false))) (let [types (get facts :type-table) descriptor (get types (get call :operator-node-id))
        check (get (get (get facts :nil-predicate-context) :checks) (get node :node-id))
        args (get call :argument-node-ids)
        argument (if (vector? args) (if (= 1 (count args)) (get types (first args) :gravity.type/unknown) :gravity.type/unknown) :gravity.type/unknown)
        header (if (= argument (get check :argument-type))
                 (body-nilp-source core node call edge nodes bindings types (get core :module) (get check :validation)) nil)
        forms (get (get facts :nil-predicate-context) :forms)
        owner (if (if (keyword? (get (get node :source) :form-id)) true (if (string? (get (get node :source) :form-id)) (= 71 (count (get (get node :source) :form-id))) false)) (get forms (get (get node :source) :form-id)) nil) ids (get owner :child-form-ids)
        producer-rows (body-select (get facts :constraint-ledger) :producer-rule :sh08-nil-predicate-v1)
        producer-ids? (loop [remaining producer-rows] (if (= 0 (count remaining)) true (let [lhs (get (first remaining) :lhs) row-id (get lhs :core-node-id)] (if (if (map? lhs) (if (= 2 (count lhs)) (if (= :nil-predicate (get lhs :projection)) (if (keyword? row-id) true (if (string? row-id) (= 71 (count row-id)) false)) false) false) false) (recur (rest remaining)) false))))
        rows (if producer-ids? (body-select producer-rows :lhs {:core-node-id (get node :node-id) :projection :nil-predicate}) [])]
    (if (if producer-ids? (if (map? header) (if (vector? ids) (if (= 2 (count ids)) (loop [remaining ids] (if (= 0 (count remaining)) true (if (if (keyword? (first remaining)) true (if (string? (first remaining)) (= 71 (count (first remaining))) false)) (recur (rest remaining)) false))) false) false) false) false)
      (body-all?
        [(= descriptor (body-nilp-finish header)) (= (get descriptor :result-type) (get types (get node :node-id)))
         (= :list (get owner :kind)) (vector? ids) (= 2 (if (vector? ids) (count ids) 0) (count (get node :children)))
         (= (get node :source) (get (body-ma-form-node {} owner) :source))
         (= {:operator-child-index 0 :argument-count 1 :argument-child-indexes [1]
             :evaluation-order :operator-then-arguments :dispatch :resolved-symbol-call} (get node :attributes))
         (loop [i 0]
           (if (= i 2) true
             (let [form (get forms (get ids i)) child (get nodes (get (get node :children) i))]
               (if (body-all? [(= (get owner :form-id) (get form :parent-form-id))
                     (= (get child :source) (get (body-ma-form-node {} form) :source))
                     (if (= i 0) (= (get form :value) (get (get child :attributes) :symbol)) true)])
                 (recur (+ i 1)) false))))
         (= (body-nilp-call-fact descriptor (get core :module)) (body-by (get facts :call-type-facts) :call-core-node-id (get node :node-id)))
         (= [(body-nilp-constraint descriptor)] rows)]) false)) false) false))

(defn body-nilp-node? [node facts core]
  (let [context (get facts :nil-predicate-context) id (get node :node-id)]
    (if (if (map? context) (if (keyword? id) true (if (string? id) (= 71 (count id)) false)) false)
      (body-nilp-call-valid? core facts (get context :bindings) node (get (get context :calls) id)
                          (get (get context :edges) id) (get context :nodes)) false)))

(defn body-ane-map-type-check [arguments type]
  (let [size (count type)]
    (if (= 3 size)
      (let [kind (get type :kind)]
        (if (= :gravity.type/list kind)
          (let [domain (body-le-domain arguments)]
            (if (= :accepted (get domain :status))
              {:status :accepted :comparison-domain :list :list-domain domain}
              {:status :rejected :reason (get domain :reason)}))
          (if (= :gravity.type/vector kind)
            (let [domain (body-ve-domain arguments)]
              (if (= :accepted (get domain :status))
                (if (= :flat-keyword-set-vector (get domain :comparison-domain))
                  (assoc {:status :accepted
                          :comparison-domain :vector
                          :vector-integer-leaves? (get domain :integer-leaves?)}
                    :vector-comparison-domain :flat-keyword-set-vector)
                  (if (= :flat-integer-vector (get domain :comparison-domain))
                    {:status :accepted :comparison-domain :vector
                     :vector-comparison-domain :flat-integer-vector}
                    {:status :accepted :comparison-domain :vector}))
                {:status :rejected :reason (get domain :reason)}))
            (if (= :gravity.type/set kind)
              (let [domain (body-sse-domain arguments)]
                (if (= :accepted (get domain :status))
                  (if (= :string-set-carrier (get domain :comparison-domain))
                    {:status :accepted :comparison-domain :string-set-carrier
                     :operand-domains (get domain :operand-domains)}
                    (if (= :string-set (get domain :comparison-domain))
                      {:status :accepted :comparison-domain :string-set
                       :operand-counts (get domain :operand-counts)}
                      {:status :accepted :comparison-domain :keyword-set
                       :operand-counts (get domain :operand-counts)}))
                  {:status :rejected :reason (get domain :reason)}))
              {:status :rejected :reason :nonnumeric-atomic-type-required}))))
      (if (if (= 2 size)
            (if (= :gravity.type/nil-or (get type :kind))
              (let [value (get type :value-type)]
                (if (keyword? value)
                  (contains? #{:gravity.type/bool :gravity.type/character :gravity.type/string
                               :gravity.type/symbol :gravity.type/keyword} value)
                  false))
              false)
            false)
        {:status :continue}
        {:status :rejected :reason :nonnumeric-atomic-type-required}))))

(defn body-ane-type-check [arguments]
  (if (if (vector? arguments) (= 2 (count arguments)) false)
    (loop [index 0 integral-type nil atomic-seen? false]
      (if (= index 2)
        (if (if (= false (= nil integral-type)) atomic-seen? false)
          {:status :rejected :reason :unsupported-inequality-type-pair}
          (if (= false (= nil integral-type))
            (if (= :gravity.type/integer integral-type)
              {:status :accepted :comparison-domain :integer}
              {:status :accepted :comparison-domain :fixed-integral :integer-type integral-type})
            {:status :accepted}))
        (let [type (get arguments index)]
          (if (keyword? type)
            (if (contains? #{:gravity.type/integer :gravity.type/i8 :gravity.type/i16 :gravity.type/i32 :gravity.type/i64
                             :gravity.type/u8 :gravity.type/u16 :gravity.type/u32 :gravity.type/u64} type)
              (if (if (= false (= nil integral-type)) (= integral-type type) true)
                (recur (+ index 1) type atomic-seen?)
                {:status :rejected :reason :unsupported-inequality-type-pair})
              (if (contains? #{:gravity.type/nil :gravity.type/bool :gravity.type/character :gravity.type/string
                               :gravity.type/symbol :gravity.type/keyword :gravity.type/never} type)
                (recur (+ index 1) integral-type (if (= :gravity.type/never type) atomic-seen? true))
                {:status :rejected :reason :nonnumeric-atomic-type-required}))
            (if (map? type)
              (let [checked (body-ane-map-type-check arguments type)]
                (if (= :continue (get checked :status))
                  (recur (+ index 1) integral-type true)
                  checked))
              {:status :rejected :reason :nonnumeric-atomic-type-required})))))
    {:status :rejected :reason :binary-type-input-required}))

(defn body-ane-binding? [binding module]
  (if (if (vector? (get binding :profile-set)) (vector? (get binding :target-set)) false)
  (body-all?
    [(= ['not= :core :var 'gravity.core {:name 'gravity/core :version "bootstrap-contract-v1"} :gravity.type/core-var :safe]

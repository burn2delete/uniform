       :operation '* :semantic-owner 'gravity.math :intrinsic :gravity.math.core/count-quotient-scaling
       :resolution :gravity.core-compatibility :operator-node-id (get operator :node-id) :operator-binding-id bid
       :call-core-node-id (get node :node-id) :source (get node :source) :operator-source (get operator :source)
       :source-call call :source-edge edge :source-binding binding :argument-types arguments
       :scaling-policy {:operation :count-quotient-scaling :operands :generic-integer-only
                        :law :scaled-quotient-bounded-by-original-count
                        :premise :divisor-times-quotient-at-most-count
                        :coefficient :original-nonnegative-integer-literal-bounded-by-divisor

     :dispatch :direct-list-construction :applied-list-construction descriptor :effect-facts-source :audited-collection-constructor}))


(defn body-lc-finish [header]
  (let [type (if (= :normal (get header :application))
               {:kind :gravity.type/list :element-types (get header :argument-types) :shape :literal} :gravity.type/never)]
    (assoc header :parameter-types (get header :argument-types) :return type :result-type type)))

(defn body-lc-context [request facts bindings budget]
  (let [core (get request :canonical-core-artifact)
        present? (loop [remaining (get core :calls)]
                   (if (= 0 (count remaining)) false
                     (if (body-lc-binding? (get bindings (get (first remaining) :operator-binding-id)) (get core :module))
                       true (recur (rest remaining)))))]
    (if (= false present?) {:status :accepted :context nil :work-count 0}
      (let [forms (body-path request [:b47-context :authenticated-core-request :forms])]
        (if (= false (vector? forms)) (body-failure :body-list-construction-source-forms-required)
          (let [base (+ (count forms) (count bindings) (count (get core :nodes)) (count (get core :calls)) (count (get core :call-edges)))]
          (if (> base budget) (assoc (body-failure :body-deferred-work-limit) :work-count base)
            (loop [remaining (get core :calls) used base checks {}]
              (if (= 0 (count remaining))
                {:status :accepted :work-count used
                 :context {:forms (body-index forms :form-id) :nodes (body-index (get core :nodes) :node-id)
                           :calls (body-index (get core :calls) :core-node-id) :edges (body-index (get core :call-edges) :call-core-node-id)
                           :bindings bindings :type-checks checks}}
                (let [call (first remaining) args (get call :argument-node-ids)]
                  (if (body-lc-binding? (get bindings (get call :operator-binding-id)) (get core :module))
                    (let [charge (+ 64 (count args) (count (get core :function-records)))
                          validation (body-lc-type-work (body-io-child-types args (get facts :type-table))
                                       (if (> (+ used charge) budget) 0 (- budget used charge)))
                          work (+ used charge (get validation :work-count))]
                      (if (if (> work budget) true (= :work-limit (get validation :reason)))
                        (assoc (body-failure :body-deferred-work-limit) :work-count work)
                        (if (= :accepted (get validation :status))
                          (recur (rest remaining) work (assoc checks (get call :core-node-id) validation))
                          (assoc (body-failure :body-list-construction-operand-type-required) :work-count work))))
                    (recur (rest remaining) used checks))))))))))))

(defn body-lc-call-valid? [core facts bindings node call edge nodes]
  (let [types (get facts :type-table) descriptor (get types (get call :operator-node-id))
        validation (get (get (get facts :list-construction-context) :type-checks) (get node :node-id))
        header (body-lc-source core node call edge nodes bindings types (get core :module) validation)
        forms (get (get facts :list-construction-context) :forms)
        owner (get forms (get (get node :source) :form-id)) ids (get owner :child-form-ids)
        rows (body-select (body-select (get facts :constraint-ledger) :producer-rule :sh08-list-construction-v1)
                          :lhs {:core-node-id (get node :node-id) :projection :list-construction})]
    (if (map? header)
      (body-all?
        [(= descriptor (body-lc-finish header)) (= (get descriptor :result-type) (get types (get node :node-id)))
         (= :list (get owner :kind)) (vector? ids) (= (+ 1 (count (get call :argument-node-ids))) (if (vector? ids) (count ids) 0) (count (get node :children)))
         (= (get node :source) (get (body-ma-form-node {} owner) :source))
         (= {:operator-child-index 0 :argument-count (count (get call :argument-node-ids)) :argument-child-indexes (loop [index 1 out []] (if (= index (count (get node :children))) out (recur (+ index 1) (conj out index))))
             :evaluation-order :operator-then-arguments :dispatch :resolved-symbol-call} (get node :attributes))
         (loop [i 0]
           (if (= i (count (get node :children))) true
             (let [form (get forms (get ids i)) child (get nodes (get (get node :children) i))]
               (if (body-all? [(= (get owner :form-id) (get form :parent-form-id))
                     (= (get child :source) (get (body-ma-form-node {} form) :source))
                     (if (= i 0) (= (get form :value) (get (get child :attributes) :symbol)) true)])
                 (recur (+ i 1)) false))))
         (= (body-lc-call-fact descriptor (get core :module)) (body-by (get facts :call-type-facts) :call-core-node-id (get node :node-id)))
         (= [(body-lc-constraint descriptor)] rows)]) false)))

(defn body-lc-node? [node facts core]
  (let [context (get facts :list-construction-context) id (get node :node-id)]
    (if (map? context)
      (body-lc-call-valid? core facts (get context :bindings) node (get (get context :calls) id)
                          (get (get context :edges) id) (get context :nodes)) false)))

(defn body-lq-binding? [binding module]
  (if (if (vector? (get binding :profile-set)) (vector? (get binding :target-set)) false)
  (body-all?
    [(contains? '#{first rest empty?} (get binding :name))
     (= [(get binding :name) :core :var 'gravity.core {:name 'gravity/core :version "bootstrap-contract-v1"} :gravity.type/core-var :safe]
        [(get binding :name) (get binding :binding-class) (get binding :kind) (get binding :namespace)
         (get binding :package) (get binding :type-ref) (get binding :safety)])
     (= [] (get binding :effects) (get binding :capabilities))
     (contains? (set (get binding :profile-set)) (get module :profile))
     (contains? (set (get binding :target-set)) :all)]) false))

(defn body-lq-source [core node call edge nodes bindings types module validation]
  (if (if (vector? (get call :argument-node-ids)) (vector? (get node :children)) false)
  (let [children (get node :children) operator (get nodes (get call :operator-node-id))
        bid (get call :operator-binding-id) binding (get bindings bid) args (get call :argument-node-ids)
        arguments (body-io-child-types args types)
        invoked? (loop [remaining arguments]
                   (if (= 0 (count remaining)) true
                     (if (= :gravity.type/never (first remaining)) false (recur (rest remaining)))))
        caller (loop [remaining (get core :function-records)]
                 (if (= 0 (count remaining)) nil
                   (if (= (get (first remaining) :function-syntax-id) (get (get node :evaluation) :owner-function-syntax-id))
                     (first remaining) (recur (rest remaining)))))
        expected-call {:core-node-id (get node :node-id) :operator-node-id (first children) :operator-binding-id bid
                       :argument-node-ids (vec (rest children)) :ordered-evaluation-node-ids children
                       :evaluation-order :operator-then-arguments :result-policy :call-result}
        expected-edge {:ordinal (get edge :ordinal) :call-core-node-id (get node :node-id)
                       :caller-function-syntax-id (get caller :function-syntax-id) :caller-function-core-node-id (get caller :function-core-node-id)
                       :callee-binding-id bid :callee-definition-syntax-id (get binding :definition-syntax-id)
                       :callee-function-syntax-id nil :callee-function-core-node-id nil :argument-core-node-ids args
                       :ordered-evaluation-node-ids children :evaluation-order :operator-then-arguments :classification :nonlocal-or-nonfunction}]
    (if (body-all?
          [(= :call (get node :core-form)) (= :reference (get operator :core-form))
           (= (count args) 1) (= expected-call call) (= expected-edge edge) (body-lq-binding? binding module)
           (= [bid] (get node :resolved-binding-ids) (get operator :resolved-binding-ids))
           (= {:symbol (get (get operator :attributes) :symbol) :position :operator :binding-id bid :binding-class :core
               :definition-syntax-id (get binding :definition-syntax-id)} (get operator :attributes))
           (if (= 'first (get binding :name))
             (contains? '#{first gravity.core/first} (get (get operator :attributes) :symbol))
             (if (= 'rest (get binding :name))
               (contains? '#{rest gravity.core/rest} (get (get operator :attributes) :symbol))
               (contains? '#{empty? gravity.core/empty?} (get (get operator :attributes) :symbol))))
           (= :operator-then-arguments (get (get node :evaluation) :kind))
           (= (loop [i 0 out []] (if (= i (count children)) out
                (recur (+ i 1) (conj out {:index i :core-node-id (get children i)})))) (get (get node :evaluation) :order))
           (= :accepted (get validation :status))
           (let [input (first arguments)]
             (if (= input :gravity.type/never) true
               (if (= input :gravity.type/list) (= false (= 'first (get binding :name)))
                 (if (body-hl-type? input) (if (= 'first (get binding :name)) (map? (get validation :head-proof)) true)
                   (if (map? input) (= :gravity.type/list (get input :kind)) false)))))] )
      (let [header {:kind :gravity.type/applied-list-query :version :sh08-list-query-v1
       :operation (get binding :name) :semantic-owner 'gravity.collections :intrinsic :gravity.collections/persistent-list-query
       :resolution :gravity.core-compatibility :operator-node-id (get operator :node-id) :operator-binding-id bid
       :call-core-node-id (get node :node-id) :source (get node :source) :operator-source (get operator :source)
       :source-call call :source-edge edge :source-binding binding :argument-types arguments
       :query-policy (if (= 'empty? (get binding :name))
                       {:input :persistent-list :operand-evaluation :once :payload-evaluation :none
                        :original :unchanged :test :zero-elements :static-length :not-required}
                     {:input :persistent-list :operand-evaluation :once :payload-evaluation :none
                      :original :unchanged :order :stored-order
                      :head-knowledge (if (body-hl-type? (first arguments)) :homogeneous-requires-nonempty :finite-positional)
                      :suffix-knowledge (if (body-hl-type? (first arguments)) :homogeneous-preserved :available-positional-or-bare)})
       :storage-policy (if (= 'empty? (get binding :name))
                         {:representation :development-persistent-list :empty? :stored-emptiness-test :copy :none}
                       {:representation :development-persistent-list :first :stored-head-value
                        :rest :existing-immutable-tail :retention :may-retain-input-storage :copy :none})
       :value-origin {:kind :list-value-query :operation (get binding :name) :operand-node-id (first args)}
       :operand-type-work (get validation :work-count)
       :application (if invoked? :normal :not-invoked)
       :latent-effects [] :direct-effects [] :capabilities [] :thrown-error-effects []
       :profile (get module :profile) :target (get module :target)
       :invalidation [:calls :call-edges :binding-table :source-forms :type-table :lexical-bindings :definitions :function-records
                      :callee-body :operand-types :query-policy :storage-policy :value-origin :profile :target :evaluation-order]}]
        (if (contains? validation :head-proof)
          (assoc header :version :sh08-list-query-v2 :head-proof (get validation :head-proof)
            :invalidation (conj (get header :invalidation) :control-flow :mutations :branch-facts)) header)) nil)) nil))

(defn body-lq-constraint [descriptor]
  {:constraint-id-request {:domain :gravity/sh08-list-query-constraint-v1 :application descriptor}
   :kind :equality :producer-rule :sh08-list-query-v1
   :lhs {:core-node-id (get descriptor :call-core-node-id) :projection :list-query}
   :rhs (get descriptor :result-type) :dependencies descriptor :origin (get (get descriptor :source) :origin-chain)
   :solution {:result-type (get descriptor :result-type) :application (get descriptor :application)
              :direct-effects (get descriptor :direct-effects)}
   :invalidation (get descriptor :invalidation) :profile (get descriptor :profile) :target (get descriptor :target)
   :status :solved :diagnostics []})

(defn body-lq-call-fact [descriptor module]
  (let [source (get descriptor :source) edge (get descriptor :source-edge)]
    {:artifact :gravity/c7-call-type-fact
     :fact-id-request {:domain :gravity/sh08-list-query-call-type-fact-v1 :application descriptor}
     :call-core-node-id (get descriptor :call-core-node-id) :caller-function-syntax-id (get edge :caller-function-syntax-id)
     :callee-function-syntax-id nil :argument-types (get descriptor :argument-types) :result-type (get descriptor :result-type)
     :evaluation-order :operator-then-arguments :source-span (get source :semantic-span) :syntax-id (get source :syntax-id)
     :origin-chain (get source :origin-chain) :generated-origin (get source :generated-origin)
     :profile (get module :profile) :target (get module :target) :effects (get descriptor :direct-effects) :capabilities [] :status :inferred
     :dispatch :direct-list-query :applied-list-query descriptor :effect-facts-source :audited-list-value-query}))


(defn body-lq-finish [header]
  (let [input (first (get header :argument-types))
        type (if (= :not-invoked (get header :application)) :gravity.type/never
               (if (= 'empty? (get header :operation)) :gravity.type/bool
                 (if (= 'first (get header :operation))
                   (if (body-hl-type? input) (get (get header :head-proof) :result-type)
                     (if (= 0 (count (get input :element-types))) :gravity.type/nil
                       (first (get input :element-types))))
                   (if (if (= input :gravity.type/list) true (body-hl-type? input)) input
                     (assoc input :element-types
                       (if (= 0 (count (get input :element-types))) []
                         (subvec (get input :element-types) 1 (count (get input :element-types)))))))))]
    (assoc header :parameter-types (get header :argument-types) :return type :result-type type)))

(defn body-hl-parent-index [records nodes budget]
  (loop [remaining records pending [] owner nil ordinal 0 parents {} work 0]
    (if (if (= 0 (count remaining)) (= 0 (count pending)) false)
      {:status :accepted :index parents :work-count work}
      (if (>= work budget) {:status :rejected :reason :list-head-work-limit :work-count work}
        (if (= 0 (count pending))
          (let [node (first remaining)]
            (if (vector? (get node :children))
              (recur (rest remaining) (get node :children) (get node :node-id) 0 parents (+ work 1))
              {:status :rejected :reason :list-head-parent-index-required :work-count (+ work 1)}))
          (let [id (first pending)]
            (if (if (contains? nodes id) (= false (contains? parents id)) false)
              (recur remaining (rest pending) owner (+ ordinal 1) (assoc parents id {:owner owner :ordinal ordinal}) (+ work 1))
              {:status :rejected :reason :list-head-parent-index-required :work-count (+ work 1)})))))))

(defn body-hl-reference? [node bid bindings]
  (let [binding (get bindings bid)]
    (body-all? [(= :reference (get node :core-form)) (= [] (get node :children))
          (= [:lexical :local] [(get binding :binding-class) (get binding :kind)])
          (= [bid] (get node :resolved-binding-ids))
          (= {:symbol (get binding :name) :position :expression :binding-id bid :binding-class :lexical
              :definition-syntax-id (get binding :definition-syntax-id)} (get node :attributes))])))

(defn body-hl-path [id nodes parents types budget]
  (loop [current id path [] seen #{} work 0]
    (let [edge (get parents current) owner (get nodes (get edge :owner))]
      (if (= edge nil) {:status :accepted :path path :work-count work}
        (if (if (>= work budget) true (>= work 128))
          {:status :rejected :reason :list-head-work-limit :work-count work}
          (if (contains? seen current)
            {:status :rejected :reason :list-head-cyclic-path :work-count work}
            (if (if (= :if (get owner :core-form)) (= :gravity.type/never (get types (first (get owner :children)))) false)
              {:status :rejected :reason :list-head-unreachable-branch :work-count (+ work 1)}
              (let [next-path (conj path {:owner-core-node-id (get owner :node-id) :child-core-node-id current :child-index (get edge :ordinal)})]
                (if (= :fn (get owner :core-form))
                  {:status :accepted :path next-path :work-count (+ work 1)}
                  (recur (get owner :node-id) next-path (conj seen current) (+ work 1)))))))))))

(defn body-lq-head-proof [core node call nodes bindings types budget]
  (let [input (get types (first (get call :argument-node-ids)))
        operator (get bindings (get call :operator-binding-id))]
    (if (if (= 'first (get operator :name)) (body-hl-type? input) false)
      (let [base (+ 128 (count (get core :calls)) (count (get core :call-edges))
                    (count (get core :control-flow)) (* 2 (count (get core :function-records)))
                    (count (get core :lexical-bindings)) (count (get core :mutations)))]
        (if (> base budget) {:status :rejected :reason :list-head-work-limit :work-count base}
          (let [prepared (body-hl-parent-index (get core :nodes) nodes (- budget base))
                work (+ base (get prepared :work-count 0))]
            (if (= :accepted (get prepared :status))
              (let [path (body-hl-path (get node :node-id) nodes (get prepared :index) types (- budget work))
                    used (+ work (get path :work-count))
                    selected (loop [entries (get path :path)]
                               (if (= 0 (count entries)) nil
                                 (if (= :if (get (get nodes (get (first entries) :owner-core-node-id)) :core-form))
                                   (first entries) (recur (rest entries)))))
                    branch (get nodes (get selected :owner-core-node-id)) ordinal (get selected :child-index)
                    condition (get nodes (first (get branch :children)))
                    calls (body-index (get core :calls) :core-node-id) edges (body-index (get core :call-edges) :call-core-node-id)
                    predicate (get calls (get condition :node-id))
                    receiver (get nodes (first (get call :argument-node-ids)))
                    tested (get nodes (first (get predicate :argument-node-ids)))
                    bid (get (get receiver :attributes) :binding-id) binding (get bindings bid)
                    owner-id (get (get node :evaluation) :owner-function-syntax-id)
                    parameter (loop [records (get core :function-records)]
                                (if (= 0 (count records)) nil
                                  (let [record (first records)]
                                    (if (= owner-id (get record :function-syntax-id))
                                      record (recur (rest records))))))
                    lexical (loop [records (get core :lexical-bindings)]
                              (if (= 0 (count records)) nil
                                (if (= bid (get (first records) :binding-id)) (first records) (recur (rest records)))))
                    parameter-ids (get parameter :parameter-binding-ids)
                    parameter-work (if (vector? parameter-ids) (count parameter-ids) 0)
                    used (+ used parameter-work)
                    parameter-index (if (if (<= used budget) (vector? parameter-ids) false)
                                      (loop [i 0] (if (= i (count parameter-ids)) nil
                                                    (if (= bid (get parameter-ids i)) i (recur (+ i 1))))) nil)
                    declaration (get (get (get parameter :signature) :parameters) parameter-index)
                    immutable? (if (= :immutable (get lexical :mutability))
                                 (= input (get types (get lexical :initializer-node-id)))
                                 (if (= parameter-index nil) false
                                   (if (body-hl-declaration? declaration bindings) (= input (get declaration :type-id)) false)))
                    mutations? (loop [records (get core :mutations)]
                                 (if (= 0 (count records)) false
                                   (if (= bid (get (first records) :target-binding-id)) true (recur (rest records)))))
                    header (if (if (= :accepted (get path :status))
                                 (if (<= used budget)
                                   (if (vector? (get predicate :argument-node-ids))
                                     (if (= 1 (count (get predicate :argument-node-ids)))
                                       (if (vector? (get condition :children))
                                         (if (= 2 (count (get condition :children)))
                                           (let [binding (get bindings (get predicate :operator-binding-id))]
                                             (if (= 'empty? (get binding :name)) (body-lq-binding? binding (get core :module)) false)) false) false) false) false) false) false)
                             (body-lq-source core condition predicate (get edges (get condition :node-id))
                               nodes bindings types (get core :module) (body-lc-type-work [input] 2)) nil)
                    control {:core-node-id (get branch :node-id) :kind :if :condition-node-id (get condition :node-id)
                             :branches [{:role :then :predicate :truthy :core-node-id (get (get branch :children) 1)}
                                        {:role :else :predicate :falsey :core-node-id (get (get branch :children) 2)}]
                             :branch-exclusivity :exactly-one :truthiness {:false-values [:nil :false] :other-values :true}
                             :result-policy :selected-branch}
                    controls (loop [records (get core :control-flow) found []]
                               (if (= 0 (count records)) found
                                 (recur (rest records) (if (= (get branch :node-id) (get (first records) :core-node-id)) (conj found (first records)) found))))]
                (if (> used budget) {:status :rejected :reason :list-head-work-limit :work-count used}
                (if (= :accepted (get path :status))
                  (if (body-all?
                        [(map? selected) (contains? #{1 2} ordinal) (= :if (get branch :core-form)) (= 3 (count (get branch :children)))
                         (= {:condition-child-index 0 :then-child-index 1 :else-child-index 2 :condition-evaluation :always-first
                             :branch-evaluation :exactly-one :truthiness {:false-values [:nil :false] :other-values :true}} (get branch :attributes))
                         (= :condition-then-exclusive-branch (get (get branch :evaluation) :kind))
                         (= [{:index 0 :core-node-id (get condition :node-id)}] (get (get branch :evaluation) :order))
                         (= [control] controls) immutable? (= false mutations?)
                         (contains? #{nil :immutable} (get binding :mutability))
                         (body-hl-reference? receiver bid bindings) (body-hl-reference? tested bid bindings)
                         (= input (get types (get tested :node-id)))
                         (= owner-id (get (get receiver :evaluation) :owner-function-syntax-id)
                                     (get (get tested :evaluation) :owner-function-syntax-id)
                                     (get (get condition :evaluation) :owner-function-syntax-id)
                                     (get (get branch :evaluation) :owner-function-syntax-id))
                         (map? header) (= 'empty? (get header :operation)) (= :normal (get header :application))
                         (= :gravity.type/bool (get types (get condition :node-id)))
                         (= (body-lq-finish header) (get types (get predicate :operator-node-id)))])
                    {:status :accepted :work-count used
                     :proof {:kind :gravity.type/list-head-branch :version :sh08-list-head-branch-v1
                             :head-call-core-node-id (get node :node-id) :receiver-core-node-id (get receiver :node-id)
                             :receiver-source (get receiver :source) :receiver-type input
                             :binding-id bid :binding binding :immutable-binding-record (if (map? lexical) lexical parameter)
                             :condition-core-node-id (get condition :node-id) :condition (body-lq-finish header)
                             :predicate-receiver-core-node-id (get tested :node-id) :predicate-receiver-source (get tested :source)
                             :branch-core-node-id (get branch :node-id) :branch-source (get branch :source) :control-flow control
                             :branch-child-index ordinal :branch-root-core-node-id (get (get branch :children) ordinal)
                             :ancestry (get path :path) :knowledge (if (= ordinal 1) :empty :nonempty)
                             :result-type (if (= ordinal 1) :gravity.type/nil (get input :element-type))}}
                    {:status :rejected :reason :list-head-branch-proof-required :work-count used})
                  (assoc path :work-count used))))
              {:status :rejected :reason (if (contains? #{:loop-work-limit :list-head-work-limit} (get prepared :reason)) :list-head-work-limit :list-head-parent-index-required)
               :work-count work}))))
      {:status :not-applicable :work-count 0})))

(defn body-lq-context [request facts bindings budget]
  (let [core (get request :canonical-core-artifact)
        present? (loop [remaining (get core :calls)]
                   (if (= 0 (count remaining)) false
                     (if (body-lq-binding? (get bindings (get (first remaining) :operator-binding-id)) (get core :module))
                       true (recur (rest remaining)))))]
    (if (= false present?) {:status :accepted :context nil :work-count 0}
      (let [forms (body-path request [:b47-context :authenticated-core-request :forms])]
        (if (= false (vector? forms)) (body-failure :body-list-query-source-forms-required)
          (let [base (+ (count forms) (count bindings) (count (get core :nodes)) (count (get core :calls)) (count (get core :call-edges)))
                nodes (body-index (get core :nodes) :node-id)]
          (if (> base budget) (assoc (body-failure :body-deferred-work-limit) :work-count base)
            (loop [remaining (get core :calls) used base checks {}]
              (if (= 0 (count remaining))
                {:status :accepted :work-count used
                 :context {:forms (body-index forms :form-id) :nodes nodes
                           :calls (body-index (get core :calls) :core-node-id) :edges (body-index (get core :call-edges) :call-core-node-id)
                           :bindings bindings :type-checks checks}}
                (let [call (first remaining) args (get call :argument-node-ids)]
                  (if (body-lq-binding? (get bindings (get call :operator-binding-id)) (get core :module))
                    (let [charge (+ 64 (count args) (count (get core :function-records)))
                          validation (body-lc-type-work (body-io-child-types args (get facts :type-table))
                                       (if (> (+ used charge) budget) 0 (- budget used charge)))
                          work (+ used charge (get validation :work-count))
                          head (if (if (<= work budget) (= :accepted (get validation :status)) false)
                                 (body-lq-head-proof core (get nodes (get call :core-node-id)) call nodes bindings (get facts :type-table) (- budget work))
                                 {:status :not-applicable :work-count 0})
                          work (+ work (get head :work-count))
                          validation (if (= :accepted (get head :status)) (assoc validation :head-proof (get head :proof)) validation)]
                      (if (if (> work budget) true (= :work-limit (get validation :reason)))
                        (assoc (body-failure :body-deferred-work-limit) :work-count work)
                        (if (= :rejected (get head :status))
                          (assoc (body-failure (get head :reason)) :work-count work)
                        (if (= :accepted (get validation :status))
                          (recur (rest remaining) work (assoc checks (get call :core-node-id) validation))
                          (assoc (body-failure :body-list-query-operand-type-required) :work-count work)))))
                    (recur (rest remaining) used checks))))))))))))

(defn body-lq-call-valid? [core facts bindings node call edge nodes]
  (let [types (get facts :type-table) descriptor (get types (get call :operator-node-id))
        validation (get (get (get facts :list-query-context) :type-checks) (get node :node-id))
        header (body-lq-source core node call edge nodes bindings types (get core :module) validation)
        forms (get (get facts :list-query-context) :forms)
        owner (get forms (get (get node :source) :form-id)) ids (get owner :child-form-ids)
        rows (body-select (body-select (get facts :constraint-ledger) :producer-rule :sh08-list-query-v1)
                          :lhs {:core-node-id (get node :node-id) :projection :list-query})]
    (if (map? header)
      (body-all?
        [(= descriptor (body-lq-finish header)) (= (get descriptor :result-type) (get types (get node :node-id)))
         (= :list (get owner :kind)) (vector? ids) (= (+ 1 (count (get call :argument-node-ids))) (if (vector? ids) (count ids) 0) (count (get node :children)))
         (= (get node :source) (get (body-ma-form-node {} owner) :source))
         (= {:operator-child-index 0 :argument-count (count (get call :argument-node-ids)) :argument-child-indexes (loop [index 1 out []] (if (= index (count (get node :children))) out (recur (+ index 1) (conj out index))))
             :evaluation-order :operator-then-arguments :dispatch :resolved-symbol-call} (get node :attributes))
         (loop [i 0]
           (if (= i (count (get node :children))) true
             (let [form (get forms (get ids i)) child (get nodes (get (get node :children) i))]
               (if (body-all? [(= (get owner :form-id) (get form :parent-form-id))
                     (= (get child :source) (get (body-ma-form-node {} form) :source))
                     (if (= i 0) (= (get form :value) (get (get child :attributes) :symbol)) true)])
                 (recur (+ i 1)) false))))
         (= (body-lq-call-fact descriptor (get core :module)) (body-by (get facts :call-type-facts) :call-core-node-id (get node :node-id)))
         (= [(body-lq-constraint descriptor)] rows)]) false)))

(defn body-lq-node? [node facts core]
  (let [context (get facts :list-query-context) id (get node :node-id)]
    (if (map? context)
      (body-lq-call-valid? core facts (get context :bindings) node (get (get context :calls) id)
                          (get (get context :edges) id) (get context :nodes)) false)))

(defn body-sc-binding? [binding module]
  (if (if (vector? (get binding :profile-set)) (vector? (get binding :target-set)) false)
  (body-all?
    [(= ['str :core :var 'gravity.core {:name 'gravity/core :version "bootstrap-contract-v1"} :gravity.type/core-var :safe]
        [(get binding :name) (get binding :binding-class) (get binding :kind) (get binding :namespace)
         (get binding :package) (get binding :type-ref) (get binding :safety)])
     (= [] (get binding :effects) (get binding :capabilities))
     (contains? (set (get binding :profile-set)) (get module :profile))
     (contains? (set (get binding :target-set)) :all)]) false))

(defn body-sc-source [core node call edge nodes bindings types module]
  (if (if (vector? (get call :argument-node-ids)) (vector? (get node :children)) false)
  (let [children (get node :children) operator (get nodes (get call :operator-node-id))
        bid (get call :operator-binding-id) binding (get bindings bid) args (get call :argument-node-ids)
        arguments (body-io-child-types args types)
        invoked? (loop [remaining arguments]
                   (if (= 0 (count remaining)) true
                     (if (= :gravity.type/never (first remaining)) false (recur (rest remaining)))))
        caller (loop [remaining (get core :function-records)]
                 (if (= 0 (count remaining)) nil
                   (if (= (get (first remaining) :function-syntax-id) (get (get node :evaluation) :owner-function-syntax-id))
                     (first remaining) (recur (rest remaining)))))
        expected-call {:core-node-id (get node :node-id) :operator-node-id (first children) :operator-binding-id bid
                       :argument-node-ids (vec (rest children)) :ordered-evaluation-node-ids children
                       :evaluation-order :operator-then-arguments :result-policy :call-result}
        expected-edge {:ordinal (get edge :ordinal) :call-core-node-id (get node :node-id)
                       :caller-function-syntax-id (get caller :function-syntax-id) :caller-function-core-node-id (get caller :function-core-node-id)
                       :callee-binding-id bid :callee-definition-syntax-id (get binding :definition-syntax-id)
                       :callee-function-syntax-id nil :callee-function-core-node-id nil :argument-core-node-ids args
                       :ordered-evaluation-node-ids children :evaluation-order :operator-then-arguments :classification :nonlocal-or-nonfunction}]
    (if (body-all?
          [(= :call (get node :core-form)) (= :reference (get operator :core-form))
           (= 2 (count args)) (= expected-call call) (= expected-edge edge) (body-sc-binding? binding module)
           (= [bid] (get node :resolved-binding-ids) (get operator :resolved-binding-ids))
           (= {:symbol (get (get operator :attributes) :symbol) :position :operator :binding-id bid :binding-class :core
               :definition-syntax-id (get binding :definition-syntax-id)} (get operator :attributes))
           (contains? '#{str gravity.core/str} (get (get operator :attributes) :symbol))
           (= :operator-then-arguments (get (get node :evaluation) :kind))
           (= (loop [i 0 out []] (if (= i (count children)) out
                (recur (+ i 1) (conj out {:index i :core-node-id (get children i)})))) (get (get node :evaluation) :order))
           (loop [remaining arguments]
             (if (= 0 (count remaining)) true
               (if (contains? #{:gravity.type/string :gravity.type/never} (first remaining))
                 (recur (rest remaining)) false)))
           (loop [remaining arguments]
             (if (= 0 (count remaining)) true
               (if (contains? #{nil :gravity.type/unknown} (first remaining)) false (recur (rest remaining)))))] )
      {:kind :gravity.type/applied-string-concat :version :sh08-string-concat-v1
       :operation 'str :semantic-owner 'gravity.text :intrinsic :gravity.text/binary-string-concat
       :resolution :gravity.core-compatibility :operator-node-id (get operator :node-id) :operator-binding-id bid
       :call-core-node-id (get node :node-id) :source (get node :source) :operator-source (get operator :source)
       :source-call call :source-edge edge :source-binding binding :argument-types arguments
       :concatenation-policy {:domain :binary-strings :order :left-then-right
                              :scalars :exact-sequence-concatenation :normalization :none :coercion :none
                              :formatting :none :operand-evaluation :once :allocation :normal-invocation-even-empty}
       :application (if invoked? :normal :not-invoked)
       :latent-effects [:memory/allocate] :direct-effects (if invoked? [:memory/allocate] []) :capabilities [] :thrown-error-effects []
       :profile (get module :profile) :target (get module :target)
       :invalidation [:calls :call-edges :binding-table :source-forms :type-table :lexical-bindings :definitions :function-records
                      :callee-body :string-operand-types :concatenation-policy :allocation-condition :profile :target :evaluation-order]} nil)) nil))

(defn body-sc-constraint [descriptor]
  {:constraint-id-request {:domain :gravity/sh08-string-concat-constraint-v1 :application descriptor}
   :kind :equality :producer-rule :sh08-string-concat-v1
   :lhs {:core-node-id (get descriptor :call-core-node-id) :projection :string-concat}
   :rhs (get descriptor :result-type) :dependencies descriptor :origin (get (get descriptor :source) :origin-chain)
   :solution {:result-type (get descriptor :result-type) :application (get descriptor :application)
              :direct-effects (get descriptor :direct-effects)}
   :invalidation (get descriptor :invalidation) :profile (get descriptor :profile) :target (get descriptor :target)
   :status :solved :diagnostics []})

(defn body-sc-call-fact [descriptor module]
  (let [source (get descriptor :source) edge (get descriptor :source-edge)]
    {:artifact :gravity/c7-call-type-fact
     :fact-id-request {:domain :gravity/sh08-string-concat-call-type-fact-v1 :application descriptor}
     :call-core-node-id (get descriptor :call-core-node-id) :caller-function-syntax-id (get edge :caller-function-syntax-id)
     :callee-function-syntax-id nil :argument-types (get descriptor :argument-types) :result-type (get descriptor :result-type)
     :evaluation-order :operator-then-arguments :source-span (get source :semantic-span) :syntax-id (get source :syntax-id)
     :origin-chain (get source :origin-chain) :generated-origin (get source :generated-origin)
     :profile (get module :profile) :target (get module :target) :effects (get descriptor :direct-effects) :capabilities [] :status :inferred
     :dispatch :direct-string-concat :applied-string-concat descriptor :effect-facts-source :audited-text-intrinsic}))


(defn body-sc-finish [header]
  (let [type (if (= :normal (get header :application)) :gravity.type/string :gravity.type/never)]
    (assoc header :parameter-types (get header :argument-types) :return type :result-type type)))

(defn body-sc-context [request facts bindings budget]
  (let [core (get request :canonical-core-artifact)
        count-calls (loop [remaining (get core :calls) out 0]
                      (if (= 0 (count remaining)) out
                        (recur (rest remaining)
                          (+ out (if (body-sc-binding? (get bindings (get (first remaining) :operator-binding-id)) (get core :module)) 1 0)))))]
    (if (= 0 count-calls) {:status :accepted :context nil :work-count 0}
      (let [forms (body-path request [:b47-context :authenticated-core-request :forms])]
        (if (= false (vector? forms)) (body-failure :body-string-concat-source-forms-required)
          (let [work (+ (count forms) (count bindings) (count (get core :nodes)) (count (get core :calls)) (count (get core :call-edges))
                        (* count-calls (+ 66 (count (get core :function-records)))))]
            (if (> work budget) (body-failure :body-deferred-work-limit)
              {:status :accepted :work-count work
               :context {:forms (body-index forms :form-id) :nodes (body-index (get core :nodes) :node-id)
                         :calls (body-index (get core :calls) :core-node-id) :edges (body-index (get core :call-edges) :call-core-node-id)
                         :bindings bindings}})))))))

(defn body-sc-call-valid? [core facts bindings node call edge nodes]
  (let [types (get facts :type-table) descriptor (get types (get call :operator-node-id))
        header (body-sc-source core node call edge nodes bindings types (get core :module))
        forms (get (get facts :string-concat-context) :forms)
        owner (get forms (get (get node :source) :form-id)) ids (get owner :child-form-ids)
        rows (body-select (body-select (get facts :constraint-ledger) :producer-rule :sh08-string-concat-v1)
                          :lhs {:core-node-id (get node :node-id) :projection :string-concat})]
    (if (map? header)
      (body-all?
        [(= descriptor (body-sc-finish header)) (= (get descriptor :result-type) (get types (get node :node-id)))
         (= :list (get owner :kind)) (vector? ids) (= 3 (if (vector? ids) (count ids) 0) (count (get node :children)))
         (= (get node :source) (get (body-ma-form-node {} owner) :source))
         (= {:operator-child-index 0 :argument-count 2 :argument-child-indexes [1 2]
             :evaluation-order :operator-then-arguments :dispatch :resolved-symbol-call} (get node :attributes))
         (loop [i 0]
           (if (= i 3) true
             (let [form (get forms (get ids i)) child (get nodes (get (get node :children) i))]
               (if (body-all? [(= (get owner :form-id) (get form :parent-form-id))
                     (= (get child :source) (get (body-ma-form-node {} form) :source))
                     (if (= i 0) (= (get form :value) (get (get child :attributes) :symbol)) true)])
                 (recur (+ i 1)) false))))
         (= (body-sc-call-fact descriptor (get core :module)) (body-by (get facts :call-type-facts) :call-core-node-id (get node :node-id)))
         (= [(body-sc-constraint descriptor)] rows)]) false)))

(defn body-sc-node? [node facts core]
  (let [context (get facts :string-concat-context) id (get node :node-id)]
    (if (map? context)
      (body-sc-call-valid? core facts (get context :bindings) node (get (get context :calls) id)
                          (get (get context :edges) id) (get context :nodes)) false)))

(defn body-mg-member-count [type]
  (if (if (map? type) (vector? (get type :member-types)) false) (count (get type :member-types)) 0))

(defn body-mg-normal-known? [type]
  (if (if (keyword? type) true (if (map? type) (keyword? (get type :kind)) false))
    (if (contains? #{:gravity.type/unknown :gravity.type/never} type) false true) false))

(defn body-mg-map-valid? [type]
  (if (= :gravity.type/map type) true
    (if (if (map? type) (= :gravity.type/map (get type :kind)) false)
      (let [members (get type :member-types)]
        (if (if (vector? members) (<= (count members) 1024) false)
          (loop [i 0]
            (if (= i (count members)) true
              (if (< (+ i 1) (count members))
                (if (if (contains? #{:gravity.type/nil :gravity.type/bool :gravity.type/integer :gravity.type/decimal :gravity.type/ratio
                                    :gravity.type/character :gravity.type/string :gravity.type/symbol :gravity.type/keyword
                                    :gravity.type/i8 :gravity.type/i16 :gravity.type/i32 :gravity.type/i64
                                    :gravity.type/u8 :gravity.type/u16 :gravity.type/u32 :gravity.type/u64 :gravity.type/f32 :gravity.type/f64}
                                  (get members i))
                        (body-mg-normal-known? (get members (+ i 1))) false)
                  (recur (+ i 2)) false) false))) false)) false)))

(defn body-mg-operands? [arguments invoked?]
  (let [map-type (get arguments 0) key-type (get arguments 1) default-type (get arguments 2)]
    (if (if (if (= :gravity.type/never map-type) true (body-mg-map-valid? map-type))
          (if (contains? #{:gravity.type/string :gravity.type/keyword :gravity.type/never} key-type)
            (if (= :gravity.type/never default-type) true (body-mg-normal-known? default-type)) false) false)
      (if invoked?
        (if (map? map-type)
          (let [members (get map-type :member-types)]
            (loop [i 0]
              (if (= i (count members)) true
                (if (if (= key-type (get members i)) (= default-type (get members (+ i 1))) true)
                  (recur (+ i 2)) false)))) false)
        true) false)))

(defn body-mg-binding? [binding module]
  (if (if (vector? (get binding :profile-set)) (vector? (get binding :target-set)) false)
  (body-all?
    [(= ['get :core :var 'gravity.core {:name 'gravity/core :version "bootstrap-contract-v1"} :gravity.type/core-var :safe]
        [(get binding :name) (get binding :binding-class) (get binding :kind) (get binding :namespace)
         (get binding :package) (get binding :type-ref) (get binding :safety)])
     (= [] (get binding :effects) (get binding :capabilities))
     (contains? (set (get binding :profile-set)) (get module :profile))
     (contains? (set (get binding :target-set)) :all)]) false))

(defn body-mg-source [core node call edge nodes bindings types module]
  (if (if (vector? (get call :argument-node-ids)) (vector? (get node :children)) false)
  (let [children (get node :children) operator (get nodes (get call :operator-node-id))
        bid (get call :operator-binding-id) binding (get bindings bid) args (get call :argument-node-ids)
        arguments (body-io-child-types args types)
        invoked? (loop [remaining arguments]
                   (if (= 0 (count remaining)) true
                     (if (= :gravity.type/never (first remaining)) false (recur (rest remaining)))))
        caller (loop [remaining (get core :function-records)]
                 (if (= 0 (count remaining)) nil
                   (if (= (get (first remaining) :function-syntax-id) (get (get node :evaluation) :owner-function-syntax-id))
                     (first remaining) (recur (rest remaining)))))
        expected-call {:core-node-id (get node :node-id) :operator-node-id (first children) :operator-binding-id bid
                       :argument-node-ids (vec (rest children)) :ordered-evaluation-node-ids children
                       :evaluation-order :operator-then-arguments :result-policy :call-result}
        expected-edge {:ordinal (get edge :ordinal) :call-core-node-id (get node :node-id)
                       :caller-function-syntax-id (get caller :function-syntax-id) :caller-function-core-node-id (get caller :function-core-node-id)
                       :callee-binding-id bid :callee-definition-syntax-id (get binding :definition-syntax-id)
                       :callee-function-syntax-id nil :callee-function-core-node-id nil :argument-core-node-ids args
                       :ordered-evaluation-node-ids children :evaluation-order :operator-then-arguments :classification :nonlocal-or-nonfunction}]
    (if (body-all?
          [(= :call (get node :core-form)) (= :reference (get operator :core-form))
           (= 3 (count args)) (= expected-call call) (= expected-edge edge) (body-mg-binding? binding module)
           (= [bid] (get node :resolved-binding-ids) (get operator :resolved-binding-ids))
           (= {:symbol (get (get operator :attributes) :symbol) :position :operator :binding-id bid :binding-class :core
               :definition-syntax-id (get binding :definition-syntax-id)} (get operator :attributes))
           (contains? '#{get gravity.core/get} (get (get operator :attributes) :symbol))
           (= :operator-then-arguments (get (get node :evaluation) :kind))
           (= (loop [i 0 out []] (if (= i (count children)) out
                (recur (+ i 1) (conj out {:index i :core-node-id (get children i)})))) (get (get node :evaluation) :order))
           (body-mg-operands? arguments invoked?)
           (loop [remaining arguments]
             (if (= 0 (count remaining)) true
               (if (contains? #{nil :gravity.type/unknown} (first remaining)) false (recur (rest remaining)))))] )
      {:kind :gravity.type/applied-map-get :version :sh08-map-get-v1
       :operation 'get :semantic-owner 'gravity.collections :intrinsic :gravity.collections/map-lookup-default
       :resolution :gravity.core-compatibility :operator-node-id (get operator :node-id) :operator-binding-id bid
       :call-core-node-id (get node :node-id) :source (get node :source) :operator-source (get operator :source)
       :source-call call :source-edge edge :source-binding binding :argument-types arguments
       :lookup-policy {:input :established-member-map :keys [:string :keyword] :key-equality :value
                       :presence :independent-of-value :default :eager :normalization :none :coercion :none
                       :operand-evaluation :map-then-key-then-default-once :result :one-established-type}
       :application (if invoked? :normal :not-invoked)
       :latent-effects [] :direct-effects [] :capabilities [] :thrown-error-effects []
       :profile (get module :profile) :target (get module :target)
       :invalidation [:calls :call-edges :binding-table :source-forms :type-table :lexical-bindings :definitions :function-records
                      :callee-body :member-types :key-domain :default-type :lookup-policy :profile :target :evaluation-order]} nil)) nil))


                                                        (if (keyword? (get binding :binding-class))
                                                          (if (contains? #{:lexical :namespace :import}
                                                                         (get binding :binding-class))
                                                            false
                                                            true)
                                                          true)
                                                        false)
                                                      false)]
                                     (recur (rest remaining)
                                            (if candidate? (conj out call) out)))
                                   :invalid-set-source))))]
              (if (= :invalid-set-source selected)
                (body-failure :body-set-conversion-families-required)
                (if (= 0 (count selected))
                  {:status :accepted :context nil}
                  (body-st-selected-context selected request facts bindings core

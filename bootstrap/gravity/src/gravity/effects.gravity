                (let
                 [source-binding
                  (get (get env :bindings) bid)
                  initializer
                  (get
                   (get env :nodes)
                   (get record :initializer-node-id))]
                 (if
                  (=
                   (get record :definition-syntax-id)
                   (get source-binding :definition-syntax-id))
                  (if
                   (=
                    (get record :binding-scope-id)
                    (get source-binding :scope-id))
                   (if
                    (=
                     (get record :initializer-form-id)
                     (get (get initializer :source) :form-id))
                    (=
                     (get record :initializer-syntax-id)
                     (get (get initializer :source) :syntax-id))
                    false)
                   false)
                  false))
                false)
               false)
              false)
             (recur
              (get record :initializer-node-id)
              next-path
              (conj seen id))
             {:status :rejected,
              :reason :ungrounded-loop-member-reference}))
           {:status :rejected,
            :reason :incoherent-loop-member-reference})
          (if
           (if
            (= mode :result)
            false
            (if
             (= mode :literal-head)
             (body-lsi-first-head? node (get env :forms))
             (body-lsi-leaf? node (get env :forms) mode)))
           {:status :accepted, :path next-path, :leaf id}
           {:status :rejected,
            :reason :unsupported-loop-member-grounding}))))
       {:status :rejected, :reason :incoherent-loop-member-source})
      {:status :rejected, :reason :unknown-loop-member-grounding})))
   {:status :rejected, :reason :incoherent-loop-member-source})))


(defn
 body-lsi-path
 [start mode binding env]
 (body-lsi-path-from-seen start mode binding env #{}))


(defn
 body-lsi-insertion
 [env node call edge types]
 (let
  [core (get env :core) args (get call :argument-node-ids)]
  (if
   (if
    (body-sse-call-ids? node call)
    (if
     (vector? args)
     (if
      (= 2 (count args))
      (if
       (vector? (get node :children))
       (= 3 (count (get node :children)))
       false)
      false)
     false)
    false)
   (let
    [validation
     (body-syin-validate-types
      [(get types (get args 0) :gravity.type/unknown)
       (get types (get args 1) :gravity.type/unknown)])]
    (if
     (= :accepted (get validation :status))
     (let
      [header
       (body-pl-source
        core
        node
        call
        edge
        (get env :nodes)
        (get env :bindings)
        types
        (get core :module)
        validation)]
      (if
       (if
        (map? header)
        (if
         (body-ksin-call-forms? node (get env :nodes) (get env :forms))
         (=
          {:operator-child-index 0,
           :argument-count 2,
           :argument-child-indexes [1 2],
           :evaluation-order :operator-then-arguments,
           :dispatch :resolved-symbol-call}
          (get node :attributes))
         false)
        false)
       (let
        [descriptor (body-pl-finish header)]
        {:status :accepted,
         :type (get descriptor :result-type),
         :descriptor descriptor})
       {:status :rejected,
        :reason :unsupported-loop-member-grounding}))
     {:status :rejected, :reason :unsupported-loop-member-grounding}))
   {:status :rejected, :reason :unsupported-loop-member-grounding})))

(defn
 body-lsi-ground
 [transfer coordinate binding env]
 (let
  [argument
   (get (get transfer :argument-node-ids) coordinate)
   result
   (body-lsi-path argument :result binding env)
   node
   (get (get env :nodes) (get result :leaf))
   call
   (get (get env :calls) (get result :leaf))
   edge
   (get (get env :edges) (get result :leaf))
   args
   (get call :argument-node-ids)]
  (if
   (= :accepted (get result :status))
   (if
    (if (vector? args) (= 2 (count args)) false)
    (let
     [receiver (body-lsi-path (get args 0) :receiver binding env)]
     (if
      (= :accepted (get receiver :status))
      (let
       [member (body-lsi-path (get args 1) :member binding env)]
       (if
        (= :accepted (get member :status))
        (let
         [warm
          (body-lsi-insertion env node call edge (get env :types))
          descriptor
          (get warm :descriptor)
          comparison
          (+ 2 (if (map? descriptor) (count descriptor) 0))]
         (if
          (= :accepted (get warm :status))
          (let
           [actual
            (get (get env :types) (get call :operator-node-id))
            coherent
            (if
             (map? actual)
             (if
              (= (count descriptor) (count actual))
              (if
               (loop
                [fields (keys actual)]
                (if
                 (= 0 (count fields))
                 true
                 (if
                  (keyword? (first fields))
                  (recur (rest fields))
                  false)))
               (if
                (= :sh08-symbol-set-insertion-v2 (get actual :version))
                (if
                 (= descriptor actual)
                 (body-syc-type? (get warm :type))
                 false)
                false)
               false)
              false)
             false)]
           (if
            coherent
            (let
             [empty-type
              {:kind :gravity.type/set,
               :shape :literal,
               :element-types []}
              cold-types
              (assoc
               (assoc (get env :types) (get args 0) empty-type)
               (get args 1)
               :gravity.type/symbol)
              cold
              (body-lsi-insertion env node call edge cold-types)
              cold-descriptor
              (get cold :descriptor)]
             (if
              (if
               (= :accepted (get cold :status))
               (if
                (=
                 :sh08-symbol-set-insertion-v2
                 (get cold-descriptor :version))
                (= :normal (get cold-descriptor :application))
                false)
               false)
              {:status :accepted,
               :grounding
               {:schema :gravity/sh08-loop-symbol-set-grounding-v2,
                :receiver-type empty-type,
                :transfer-node-id (get transfer :recur-core-node-id),
                :producer-node-id (get node :node-id),
                :member-path (get member :path),
                :result-path (get result :path),
                :receiver-path (get receiver :path),
                :argument-node-id argument,
                :member-type :gravity.type/symbol,
                :result-type (get cold-descriptor :result-type)}}
              {:status :rejected,
               :reason :unsupported-loop-member-grounding}))
            {:status :rejected,
             :reason :unsupported-loop-member-grounding}))
          {:status :rejected,
           :reason :unsupported-loop-member-grounding}))
        member))
      receiver))
    {:status :rejected, :reason :unsupported-loop-member-grounding})
   result)))

(defn body-lsi-entry-index [transfers types]
  (loop [remaining transfers out {}]
    (if (= 0 (count remaining)) {:status :accepted :index out}
      (let [transfer (first remaining) args (get transfer :argument-node-ids) target (get transfer :target-id)]
        (if (if (vector? args) (body-lsi-id? target) false)
            (let [actual (loop [ids args values []]
                           (if (= 0 (count ids)) values
                             (recur (rest ids) (conj values (if (body-lsi-id? (first ids))
                               (get types (first ids) :gravity.type/unknown) :gravity.type/unknown)))))
                  normal (loop [values actual] (if (= 0 (count values)) true
                           (if (= :gravity.type/never (first values)) false (recur (rest values)))))
                  known (loop [values actual] (if (= 0 (count values)) true
                          (if (= :gravity.type/unknown (first values)) false
                            (if (= nil (first values)) false (recur (rest values))))))]
              (recur (rest remaining) (assoc out target (conj (get out target [])
                {:transfer transfer :types actual :normal? normal :known? known}))))
            {:status :rejected :reason :incoherent-loop-member-source})))))

(defn
 body-lsi-slot
 [record target entries env]
 (let
  [binding
   (get record :binding-id)
   coordinate
   (get record :ordinal)
   empty-type
   (get (get env :types) (get record :initializer-node-id))
   carrier
   {:kind :gravity.type/set,
    :shape :homogeneous,
    :element-type :gravity.type/symbol}
   initializer
   (body-lsi-path
    (get record :initializer-node-id)
    :initializer
    binding
    env)]
  (if
   (if
    (= :accepted (get initializer :status))
    (= false (= :slot (get initializer :origin)))
    false)
   (loop
    [remaining
     entries
     witness
     nil
     evidence
     []
     pending
     false
     conflict
     nil]
    (if
     (= 0 (count remaining))
     (if
      (if (map? witness) (= false pending) false)
      (if
       (= conflict nil)
       (let
        [invariant
         {:schema :gravity/sh08-loop-symbol-set-invariant-v2,
          :target-id (get target :target-id),
          :binding-id binding,
          :initializer-node-id (get record :initializer-node-id),
          :initializer-type empty-type,
          :invariant-type carrier,
          :grounding witness,
          :entries evidence}
         measured
         (body-pc-evidence-work invariant)]
        (if (= :accepted (get measured :status))
          {:status :accepted, :invariant invariant}
          measured))
       {:status :rejected,
        :reason :loop-recur-slot-type-mismatch,
        :core-node-id (get conflict :argument-node-id),
        :parameter-binding-id binding,
        :expected carrier,
        :actual (get conflict :argument-type)})
      {:status :accepted})
     (let
      [entry
       (first remaining)
       transfer
       (get entry :transfer)
       actual
       (get (get entry :types) coordinate)
       normal
       (get entry :normal?)
       compatible
       (if
        (= actual :gravity.type/never)
        true
        (if (body-lsi-empty? actual) true (body-syc-type? actual)))
       proof
       (if
        (if
         (= witness nil)
         (if
          normal
          (if (get entry :known?) (body-syc-type? actual) false)
          false)
         false)
        (body-lsi-ground transfer coordinate binding env)
        {:status :accepted})
       row
       {:transfer-node-id (get transfer :recur-core-node-id),
        :argument-node-id
        (get (get transfer :argument-node-ids) coordinate),
        :argument-type actual,
        :normal-transfer? normal,
        :compatibility
        (if
         (= false normal)
         :existing-noninvoked-transfer-rules
         (if
          (body-lsi-empty? actual)
          :empty-set-to-symbol-carrier
          :exact-carrier))}]
      (recur
       (rest remaining)
       (if
        (map? (get proof :grounding))
        (get proof :grounding)
        witness)
       (conj evidence row)
       (if (= false (get entry :known?)) true pending)
       (if
        (if
         normal
         (if (get entry :known?) (= false compatible) false)
         false)
        row
        conflict)))))
   {:status :accepted})))

(defn body-lsi-solve [core types source]
  (if (= 0 (count (get core :loop-bindings)))
    {:status :accepted :invariants {}}
    (if (if (map? (get source :forms)) (map? (get source :bindings)) false)
      (let [aliases (body-lsi-index (get core :lexical-bindings []) :binding-id)
            calls (body-lsi-index (get core :calls []) :core-node-id)
            edges (body-lsi-index (get core :call-edges []) :call-core-node-id)
            targets (body-lsi-index (get core :recur-targets []) :owner-core-node-id)
            entries (body-lsi-entry-index (get core :recur-transfers []) types)
            env {:core core :types types :nodes (get source :nodes) :forms (get source :forms) :bindings (get source :bindings)
                 :aliases (get aliases :index) :calls (get calls :index) :edges (get edges :index)}]
        (if (if (= :accepted (get aliases :status)) (if (= :accepted (get calls :status))
              (if (= :accepted (get edges :status)) (if (= :accepted (get targets :status)) (= :accepted (get entries :status)) false) false) false) false)
          (loop [remaining (get core :loop-bindings) out {}]
            (if (= 0 (count remaining))
              (let [reads (if (if (= true (get source :warm?)) (> (count out) 0) false)
                            (body-lsi-reads core types out) {:status :accepted})]
                (if (= :accepted (get reads :status)) {:status :accepted :invariants out} reads))
              (let [record (first remaining) type (get types (get record :initializer-node-id))
                    target (get (get targets :index) (get record :loop-core-node-id))
                    checked (if (body-lsi-empty? type)
                              (body-lsi-slot record target (get (get entries :index) (get target :target-id) []) env)
                              {:status :accepted})]
                (if (= :accepted (get checked :status))
                  (recur (rest remaining) (if (map? (get checked :invariant))
                    (assoc out (get record :binding-id) (get checked :invariant)) out))
                  checked))))
          {:status :rejected :reason :incoherent-loop-member-source}))
      {:status :accepted :invariants {}})))

(defn body-lsi-reads [core types invariants]
  (loop [remaining (get core :nodes)]
    (if (= 0 (count remaining)) {:status :accepted}
      (let [node (first remaining) binding (get (get node :attributes) :binding-id)
            invariant (if (= :reference (get node :core-form))
                        (if (body-lsi-id? binding) (get invariants binding) nil) nil)]
        (if (if (map? invariant)
              (= false (body-syc-type? (get types (get node :node-id)))) false)
          {:status :rejected :reason :incoherent-loop-member-reference}
          (recur (rest remaining)))))))

(defn body-lsi-row-index [rows]
  (loop [remaining rows out {}]
    (if (= 0 (count remaining)) {:status :accepted :index out}
      (let [row (first remaining) measured (body-pc-evidence-work row)]
        (if (= :rejected (get measured :status))
          {:status :rejected :reason :incoherent-loop-member-ledger}
          (let [premise (get (get row :dependencies) :loop-premise) id (get row :lhs)
                kind (get premise :kind) key [kind id]]
            (if (if (body-lsi-id? id)
                  (if (if (= :loop-slot-type kind) true (= :loop-recur-type kind))
                    (= false (contains? out key)) false) false)
              (recur (rest remaining) (assoc out key row))
              {:status :rejected :reason :incoherent-loop-member-ledger})))))))

(defn body-lsi-target-rows [core target rows]
  (let [slots (loop [ids (get target :binding-ids) out []]
                (if (= 0 (count ids)) out
                  (recur (rest ids) (conj out (get rows [:loop-slot-type (first ids)])))))
        all (loop [transfers (get core :recur-transfers) out slots]
              (if (= 0 (count transfers)) out
                (let [transfer (first transfers)]
                  (recur (rest transfers) (if (= (get target :target-id) (get transfer :target-id))
                    (conj out (get rows [:loop-recur-type (get transfer :recur-core-node-id)])) out)))))]
    (body-lsi-row-index all)))

(defn body-lsi-target-bindings [target invariants]
  (loop [remaining (get target :binding-ids) out []]
    (if (= 0 (count remaining)) out
      (recur (rest remaining) (if (contains? invariants (first remaining)) (conj out (first remaining)) out)))))

(defn body-lsi-compatible? [actual expected]
  (if (body-syc-type? expected)
    (if (= :gravity.type/never actual) true
      (if (body-lsi-empty? actual) true (body-syc-type? actual))) false))

(defn body-loop-row [premise node module]
  (let [slot? (= :loop-slot-type (get premise :kind)) id (get node :node-id)
        target (get premise :source-target) lhs (if slot? (get premise :binding-id) id)
        rhs (if slot? (get premise :type) :gravity.type/never)
        selected (if (map? (get premise :member-invariant)) true
                   (if (vector? (get premise :member-invariant-bindings)) (> (count (get premise :member-invariant-bindings)) 0) false))
        solution {:type rhs :slot-types (get premise :slot-types) :argument-types (get premise :argument-types)
                  :normal-transfer? (get premise :normal-transfer?)}]
    {:constraint-id-request {:domain (if selected :gravity/sh08-loop-type-constraint-v2 :gravity/sh08-loop-type-constraint-v1)
       :core-node-id id :binding-or-transfer lhs :target-id (get target :target-id) :premise premise}
     :kind :equality :producer-rule (if selected :sh08-loop-target-types-v2 :sh08-loop-target-types-v1) :lhs lhs :rhs rhs
     :origin (get (get node :source) :origin-chain) :profile (get module :profile) :target (get module :target)
     :dependencies {:loop-premise premise :core-node-id id :target-owner-core-node-id (get target :owner-core-node-id)}
     :solution (if selected
                 (if slot? (assoc solution :initializer-type (get premise :initializer-type) :member-invariant (get premise :member-invariant))
                   (assoc solution :member-invariant-bindings (get premise :member-invariant-bindings))) solution)
     :invalidation (if selected
       [:loop-bindings :recur-targets :recur-transfers :type-table :binding-table :calls :call-edges :source-forms :lexical-bindings :loop-member-grounding]
       [:loop-bindings :recur-targets :recur-transfers :type-table :binding-table])
     :status :solved :diagnostics []}))

(defn body-loop-slot-types [target bindings types]
  (loop [ids (get target :binding-ids) out []]
    (if (= 0 (count ids)) out
      (recur (rest ids) (conj out (get types (get (get bindings (first ids)) :initializer-node-id)))))))

(defn body-function-recur-slot-types [target owner function]
  (let [parameters (get function :parameters)
        declared (get (get (get owner :attributes) :signature) :parameters)
        declarations (if (if (= 0 (get target :arity)) (= declared nil) false) [] declared)]
    (if (if (vector? parameters) (if (vector? declarations) (vector? (get owner :children)) false) false)
    (if (body-all? [(= :fn (get owner :core-form))
                    (= (get target :owner-core-node-id) (get function :function-core-node-id) (get owner :node-id))
                    (= (get target :owner-form-id) (get (get owner :source) :form-id))
                    (= (get target :owner-syntax-id) (get function :function-id) (get (get owner :source) :syntax-id))
                    (= (get target :target-id) (get (get owner :attributes) :recur-target-id))
                    (= 1 (count (get owner :children)))
                    (= (get function :body-core-node-id) (first (get owner :children)))
                    (= (get target :binding-ids) (get function :parameter-binding-ids) (get owner :resolved-binding-ids))
                    (= (get function :signature) (get (get owner :attributes) :signature))
                    (= (get target :arity) (count parameters) (count declarations))])
      (loop [parameters parameters declarations declarations ids (get target :binding-ids) out []]
        (if (= 0 (count parameters)) out
          (let [parameter (first parameters) type (get parameter :type)]
            (if (body-all? [(= (first ids) (get parameter :binding-id))
                            (= type (get (first declarations) :type-id))
                            (= false (contains? #{nil :gravity.type/unknown} type))])
              (recur (rest parameters) (rest declarations) (rest ids) (conj out type)) nil)))) nil) nil)))

(defn body-loop-arguments-valid? [arguments slots]
  (if (= (count arguments) (count slots))
    (loop [arguments arguments slots slots]
      (if (= 0 (count arguments)) true
        (if (if (contains? #{nil :gravity.type/unknown} (first slots)) false
              (body-normal-compatible? (first arguments) (first slots)))
          (recur (rest arguments) (rest slots)) false))) false))

(defn body-loop-input-shapes? [core facts]
  (if (body-all? [(vector? (get core :loop-bindings)) (vector? (get core :recur-targets))
                  (vector? (get core :recur-transfers)) (vector? (get facts :constraint-ledger))])
    (if (body-all? [(body-maps? (get core :loop-bindings)) (body-maps? (get core :recur-targets))
                    (body-maps? (get core :recur-transfers)) (body-maps? (get facts :constraint-ledger))])
      (if (loop [remaining (get core :recur-targets)]
            (if (= 0 (count remaining)) true
              (let [target (first remaining) arity (get target :arity)]
                (if (if (integer? arity)
                      (if (vector? (get target :binding-ids))
                        (<= 0 arity) false) false)
                  (recur (rest remaining)) false))))
        (if (loop [remaining (get core :loop-bindings)]
              (if (= 0 (count remaining)) true
                (let [ordinal (get (first remaining) :ordinal)]
                  (if (if (integer? ordinal) (<= 0 ordinal) false)
                    (recur (rest remaining)) false))))
          (loop [remaining (get core :recur-transfers)]
            (if (= 0 (count remaining)) true
              (if (vector? (get (first remaining) :argument-node-ids))
                (recur (rest remaining)) false))) false) false) false) false))

(defn body-lsi-controls [core nodes targets bindings types functions]
  (loop [records (get core :loop-bindings) transfers (get core :recur-transfers)]
    (if (> (count records) 0)
      (let [record (first records) node (get nodes (get record :loop-core-node-id))
            target (get targets (get (get node :attributes) :target-id)) id (get record :initializer-node-id)]
        (if (body-all? [(= :loop (get target :target-kind) (get node :core-form))
                        (= (get record :loop-core-node-id) (get target :owner-core-node-id))
                        (= (get record :binding-id) (get (get target :binding-ids) (get record :ordinal)))
                        (= id (get (get node :children) (get record :ordinal)))
                        (= false (contains? #{nil :gravity.type/unknown} (get types id)))])
          (recur (rest records) transfers)
          (body-failure :incoherent-loop-slot-type-origin-join)))
      (if (= 0 (count transfers)) {:status :accepted}
        (let [transfer (first transfers) id (get transfer :recur-core-node-id) node (get nodes id) target (get targets (get transfer :target-id))]
          (if (body-all? [(contains? #{:loop :function} (get transfer :target-kind))
                          (= (get transfer :target-kind) (get target :target-kind))
                          (= :recur (get node :core-form)) (= :gravity.type/never (get types id))
                          (= (get transfer :argument-node-ids) (get node :children))
                          (= (get target :binding-ids) (get node :resolved-binding-ids))
                          (= (get transfer :arity) (get target :arity) (count (get transfer :argument-node-ids)) (count (get target :binding-ids)))
                          (= (get transfer :target-id) (get (get node :attributes) :target-id)) (= true (get transfer :tail-position))
                          (if (= :function (get target :target-kind))
                            (vector? (body-function-recur-slot-types target (get nodes (get target :owner-core-node-id))
                              (get functions (get target :owner-core-node-id)))) true)])
            (recur records (rest transfers))
            (body-failure :incoherent-loop-transfer-type-origin-join)))))))

(defn body-loop-rows [core facts]
  (let [nodes (body-index (get core :nodes) :node-id) types (get facts :type-table)
        targets (body-index (get core :recur-targets) :target-id)
        bindings (body-index (get core :loop-bindings) :binding-id)
        functions (body-index (get facts :function-type-table) :function-core-node-id) module (get facts :module)
        controls (body-lsi-controls core nodes targets bindings types functions)
        members (if (= :accepted (get controls :status))
                  (body-lsi-solve core types (assoc (get facts :append-context {}) :nodes nodes :warm? true)) controls)
        invariants (get members :invariants {})]
    (if (= :accepted (get members :status))
      (loop [remaining (get core :loop-bindings) transfers (get core :recur-transfers) rows []]
        (if (> (count remaining) 0)
          (let [binding (first remaining) id (get binding :initializer-node-id) node (get nodes id)
                loop-node (get nodes (get binding :loop-core-node-id))
                target (get targets (get (get loop-node :attributes) :target-id)) actual (get types id)
                invariant (get invariants (get binding :binding-id)) type (if (map? invariant) (get invariant :invariant-type) actual)
                premise {:kind :loop-slot-type :binding-id (get binding :binding-id) :initializer-node-id id
                         :type type :source-loop-binding binding :source-target target :status :solved}
                premise (if (map? invariant) (assoc premise :initializer-type actual :member-invariant invariant) premise)]
            (if (body-all? [(= :loop (get target :target-kind) (get loop-node :core-form))
                            (= (get binding :loop-core-node-id) (get target :owner-core-node-id))
                            (= (get binding :binding-id) (get (get target :binding-ids) (get binding :ordinal)))
                            (= id (get (get loop-node :children) (get binding :ordinal)))
                            (= false (contains? #{nil :gravity.type/unknown} type))])
              (recur (rest remaining) transfers (conj rows (body-loop-row premise node module)))
              (body-failure :incoherent-loop-slot-type-origin-join)))
          (if (> (count transfers) 0)
            (let [transfer (first transfers) id (get transfer :recur-core-node-id) node (get nodes id)
                  target (get targets (get transfer :target-id))
                  slots (if (= :function (get target :target-kind))
                          (body-function-recur-slot-types target (get nodes (get target :owner-core-node-id))
                            (get functions (get target :owner-core-node-id)))
                          (loop [ids (get target :binding-ids) out []]
                            (if (= 0 (count ids)) out
                              (let [invariant (get invariants (first ids))]
                                (recur (rest ids) (conj out (if (map? invariant) (get invariant :invariant-type)
                                  (get types (get (get bindings (first ids)) :initializer-node-id)))))))))
                  arguments (loop [ids (get transfer :argument-node-ids) out []]
                              (if (= 0 (count ids)) out (recur (rest ids) (conj out (get types (first ids))))))
                  premise {:kind :loop-recur-type :source-transfer transfer :source-target target
                           :argument-types arguments :slot-types slots :result-type :gravity.type/never
                           :normal-transfer? (= false (contains? (set arguments) :gravity.type/never)) :status :solved}
                  member-bindings (if (= :loop (get target :target-kind)) (body-lsi-target-bindings target invariants) [])
                  premise (if (= 0 (count member-bindings)) premise (assoc premise :member-invariant-bindings member-bindings))]
              (if (body-all? [(contains? #{:loop :function} (get transfer :target-kind))
                              (= (get transfer :target-kind) (get target :target-kind)) (vector? slots)
                              (= :recur (get node :core-form)) (= :gravity.type/never (get types id))
                              (= (get transfer :argument-node-ids) (get node :children))
                              (= (get target :binding-ids) (get node :resolved-binding-ids))
                              (= (get transfer :arity) (get target :arity) (count arguments) (count slots))
                              (= (get transfer :target-id) (get (get node :attributes) :target-id))
                              (= true (get transfer :tail-position))
                              (if (= 0 (count member-bindings)) (body-loop-arguments-valid? arguments slots)
                                (loop [i 0]
                                  (if (= i (count arguments)) true
                                    (if (if (map? (get invariants (get (get target :binding-ids) i)))
                                          (body-lsi-compatible? (get arguments i) (get slots i))
                                          (body-normal-compatible? (get arguments i) (get slots i)))
                                      (recur (+ i 1)) false))))])
                (recur remaining (rest transfers) (conj rows (body-loop-row premise node module)))
                (body-failure :incoherent-loop-transfer-type-origin-join)))
            {:status :accepted :rows rows})))
      (body-failure (get members :reason)))))

(defn body-loop-joins [core facts]
  (if (body-loop-input-shapes? core facts)
    (if (body-all?
          [(= (body-project core [:loop-bindings :recur-targets :recur-transfers])
              (body-project (get core :identity-preimage) [:loop-bindings :recur-targets :recur-transfers]))
           (= (count (get core :loop-bindings)) (count (body-index (get core :loop-bindings) :binding-id)))
           (= (count (get core :recur-targets)) (count (body-index (get core :recur-targets) :target-id)))
           (= (count (get core :recur-transfers)) (count (body-select (get core :nodes) :core-form :recur)))
           (= (count (get core :recur-transfers)) (count (body-index (get core :recur-transfers) :recur-core-node-id)))
           (= (set (keys (body-index (get core :recur-transfers) :recur-core-node-id)))
              (set (keys (body-index (body-select (get core :nodes) :core-form :recur) :node-id))))
           (= (count (body-select (get core :recur-targets) :target-kind :loop))
              (count (body-select (get core :nodes) :core-form :loop)))])
      (let [result (body-loop-rows core facts)]
        (if (= :accepted (get result :status))
          (let [ledger (get facts :constraint-ledger)
                actual (loop [remaining ledger out []]
                        (if (= 0 (count remaining)) out
                          (let [row (first remaining) producer (get row :producer-rule)]
                            (recur (rest remaining) (if (if (= :sh08-loop-target-types-v1 producer) true (= :sh08-loop-target-types-v2 producer))
                              (conj out row) out)))))
                indexed (body-lsi-row-index actual)]
            (if (= :accepted (get indexed :status))
              (if (if (= (count actual) (count (get result :rows)))
                    (loop [expected (get result :rows)]
                      (if (= 0 (count expected)) true
                        (let [row (first expected) premise (get (get row :dependencies) :loop-premise)]
                          (if (= row (get (get indexed :index) [(get premise :kind) (get row :lhs)]))
                            (recur (rest expected)) false)))) false)
                result (body-failure :incoherent-loop-constraint-ledger))
              (body-failure :incoherent-loop-constraint-ledger)))
          result))
      (body-failure :incomplete-loop-control-coverage))
    (body-failure :incomplete-loop-control-tables)))

(defn body-loop-body-indexes-valid? [indexes arity child-count]
  (if (if (vector? indexes) (if (integer? arity) (integer? child-count) false) false)
    (if (if (<= 0 arity) (< arity child-count) false)
      (if (= (count indexes) (- child-count arity))
        (loop [remaining indexes expected arity]
          (if (= 0 (count remaining)) true
            (if (if (integer? (first remaining)) (= expected (first remaining)) false)
              (recur (rest remaining) (+ expected 1)) false))) false) false) false))

(defn body-loop-values-valid? [core facts]
  (let [types (get facts :type-table) targets (body-index (get core :recur-targets) :target-id)]
    (loop [remaining (get core :nodes)]
      (if (= 0 (count remaining)) true
        (let [node (first remaining) children (get node :children) attrs (get node :attributes)
              target (get targets (get attrs :target-id))]
          (if (if (= :loop (get node :core-form))
                (if (if (map? target)
                      (body-loop-body-indexes-valid? (get attrs :body-child-indexes) (get target :arity) (count children)) false)
                (body-all? [(= :loop (get target :target-kind))
                            (= (get node :node-id) (get target :owner-core-node-id))
                            (= (get node :resolved-binding-ids) (get target :binding-ids))
                            (= (get target :arity) (get attrs :binding-count))
                            (> (count children) (get target :arity))
                            (> (count (get attrs :body-child-indexes)) 0)
                            (= (get types (get node :node-id))
                               (if (body-has-never? children types) :gravity.type/never
                                 (get types (get children (- (count children) 1)))))]) false) true)
            (recur (rest remaining)) false))))))

(defn body-loop-body-ids [node core]
  (let [target (body-by (get core :recur-targets) :target-id (get (get node :attributes) :target-id))
        owner (body-by (get core :nodes) :node-id (get target :owner-core-node-id))]
    (loop [indexes (if (= :function (get target :target-kind)) [0]
                    (get (get owner :attributes) :body-child-indexes)) out []]
      (if (= 0 (count indexes)) out
        (recur (rest indexes) (conj out (get (get owner :children) (first indexes))))))))

(defn body-conditional-coverage [node]
  (let [kind (get node :core-form) children (get node :children) attrs (get node :attributes)]
    (if (contains? #{:if :match :try} kind)
      (loop [index 1 result []]
        (if (= index (count children)) result
          (recur (+ index 1)
            (conj result {:node-id (get children index) :child-index index
                          :role (if (= kind :try) :source-ordered-typed-handler
                                (if (= kind :if) (if (= index 1) :then :else)
                                  (if (contains? (set (get attrs :guard-child-indexes)) index) :guard :branch)))})))) [])))

(defn body-order-ids [order]
  (loop [remaining order ids []]
    (if (= 0 (count remaining)) ids
      (recur (rest remaining) (conj ids (get (first remaining) :core-node-id))))))

(defn body-error-type-union [left right]
  (loop [remaining right out left seen (set left)]
    (if (= 0 (count remaining)) out
      (recur (rest remaining) (if (contains? seen (first remaining)) out (conj out (first remaining)))
             (conj seen (first remaining))))))

(defn body-eh-atomic-type [name]
  (get '{I8 :gravity.type/i8 I16 :gravity.type/i16 I32 :gravity.type/i32 I64 :gravity.type/i64
         U8 :gravity.type/u8 U16 :gravity.type/u16 U32 :gravity.type/u32 U64 :gravity.type/u64
         F32 :gravity.type/f32 F64 :gravity.type/f64 Bool :gravity.type/bool
         String :gravity.type/string Symbol :gravity.type/symbol Keyword :gravity.type/keyword Ratio :gravity.type/ratio} name))

(defn body-eh-error [rule reason node expected actual]
  (assoc (body-failure reason) :node node :expected expected :actual actual))

(defn body-eh-tree [nodes root]
  (loop [pending [root] seen #{}]
    (if (= 0 (count pending)) seen
      (let [id (first pending) rest-ids (vec (rest pending))]
        (if (contains? seen id) (recur rest-ids seen)
          (recur (loop [children (get (get nodes id) :children) out rest-ids]
                   (if (= 0 (count children)) out (recur (rest children) (conj out (first children)))))
                 (conj seen id)))))))

(defn body-eh-uses [nodes tree binding-id]
  (loop [remaining nodes out []]
    (if (= 0 (count remaining)) out
      (let [node (first remaining)]
        (recur (rest remaining)
          (if (body-all? [(= :reference (get node :core-form)) (= binding-id (get (get node :attributes) :binding-id))
                          (contains? tree (get node :node-id))])
            (conj out (get (get node :source) :syntax-id)) out))))))

(defn
 body-eh-source-products
 [core source-forms bindings]
 (let
  [sequence (get core :nodes) records (get core :error-handlers)]
  (if
   (body-all?
    [(vector? sequence)
     (vector? source-forms)
     (vector? bindings)
     (if (= records nil) true (vector? records))])
   (let
    [tries
     (body-select sequence :core-form :try)
     records
     (get core :error-handlers)
     count-records
     (if (vector? records) (count records) 0)
     shapes?
     (loop
      [remaining tries]
      (if
       (= 0 (count remaining))
       true
       (let
        [node (first remaining) attrs (get node :attributes)]
        (if
         (if
          (vector? (get node :children))
          (if
           (map? attrs)
           (vector? (get attrs :handler-clauses))
           false)
          false)
         (recur (rest remaining))
         false))))]
    (if
     (= 0 (count tries))
     (if
      (if (= records nil) true (= [] records))
      {:status :accepted, :groups {}, :seeds {}, :diagnostics []}
      (body-eh-error
       "C7-VERIFY"
       :unexpected-error-handlers
       {}
       :no-handler-records
       records))
     (if
      (= false shapes?)
      (body-eh-error
       "C7-VERIFY"
       :malformed-typed-handler-family
       {}
       :canonical-handler-vectors
       nil)
      (let
       [nodes
        (body-index sequence :node-id)
        forms
        (body-index source-forms :form-id)
        binding-index
        (body-index bindings :binding-id)
        owners
        (body-throw-owners core)]
       (if
        (= :accepted (get owners :status))
        (loop
         [remaining tries ordinal 0 groups {} seeds {}]
         (if
          (= 0 (count remaining))
          (if
           (if
            (= ordinal count-records)
            (=
             (loop
              [remaining records out []]
              (if
               (= 0 (count remaining))
               out
               (recur
                (rest remaining)
                (conj
                 out
                 (body-throw-semantic-record
                  (get
                   (get (get core :identity-preimage) :lineage)
                   :sh06-semantic-projection-id)
                  (first remaining))))))
             (get (get core :identity-preimage) :error-handlers))
            false)
           {:status :accepted,
            :groups groups,
            :seeds seeds,
            :diagnostics []}
           (body-eh-error
            "C7-VERIFY"
            :error-handler-census
            {}
            :exact-handler-records
            records))
          (let
           [node
            (first remaining)
            id
            (get node :node-id)
            source
            (get node :source)
            form
            (get forms (get source :form-id))
            ids
            (get form :child-form-ids)
            children
            (get node :children)
            attrs
            (get node :attributes)
            clauses
            (get attrs :handler-clauses)
            owner
            (get (get owners :owners) id)
            tree
            (body-eh-tree nodes (first children))
            candidates
            (loop
             [transfers (get core :error-transfers) out []]
             (if
              (= 0 (count transfers))
              out
              (let
               [transfer (first transfers)]
               (recur
                (rest transfers)
                (if
                 (if
                  (contains? tree (get transfer :core-node-id))
                  (=
                   owner
                   (get transfer :evaluation-owner-function-syntax-id))
                  false)
                 (conj
                  out
                  (body-project transfer [:ordinal :core-node-id]))
                 out)))))
            result
            (if
             (if
              (vector? clauses)
              (<= (+ ordinal (count clauses)) count-records)
              false)
             (loop
              [index 0 values [] next-seeds seeds]
              (if
               (= index (count clauses))
               {:status :accepted, :clauses values, :seeds next-seeds}
               (let
                [clause
                 (get clauses index)
                 record
                 (get records (+ ordinal index))
                 catch-form
                 (get forms (get ids (+ index 2)))
                 catch-ids
                 (get catch-form :child-form-ids)
                 operator
                 (get forms (get catch-ids 0))
                 type-form
                 (get forms (get catch-ids 1))
                 binder-form
                 (get forms (get catch-ids 2))
                 body-form
                 (get forms (get catch-ids 3))
                 type-binding
                 (get
                  binding-index
                  (get clause :error-type-binding-id))
                 binder
                 (get binding-index (get clause :catch-binding-id))
                 type
                 (body-eh-atomic-type (get type-binding :name))
                 body
                 (get nodes (get children (+ index 1)))
                 body-tree
                 (body-eh-tree nodes (get body :node-id))
                 uses
                 (body-eh-uses
                  sequence
                  body-tree
                  (get binder :binding-id))
                 all-uses
                 (body-eh-uses
                  sequence
                  (set (keys nodes))
                  (get binder :binding-id))
                 expected-clause
                 {:handler-child-index (+ index 1),
                  :catch-clause-form-id (get catch-form :form-id),
                  :catch-binding-id (get binder :binding-id),
                  :catch-binding-syntax-id
                  (get binder-form :syntax-id),
                  :clause-ordinal index,
                  :error-type-binding-id
                  (get type-binding :binding-id),
                  :catch-clause-syntax-id (get catch-form :syntax-id),
                  :catch-binding-form-id (get binder-form :form-id),
                  :error-type-form-id (get type-form :form-id),
                  :catch-binding-scope-id (get binder :scope-id),
                  :error-type-syntax-id (get type-form :syntax-id)}
                 expected-record
                 (assoc
                  (body-project
                   attrs
                   [:construction-order
                    :runtime-reachability
                    :selection-policy
                    :result-policy
                    :authenticated-sh06-artifact-id
                    :sh06-semantic-projection-id
                    :type-coverage-legality
                    :result-type-join-legality
                    :effect-registry-legality
                    :effect-profile-capability-legality
                    :profile-error-lowering-legality
                    :ownership-legality
                    :safety-classification])
                  :ordinal
                  (+ ordinal index)
                  :clause-ordinal
                  index
                  :clause-count
                  (count clauses)
                  :handler-child-index
                  (+ index 1)
                  :core-node-id
                  id
                  :form-id
                  (get form :form-id)
                  :syntax-id
                  (get form :syntax-id)
                  :protected-core-node-id
                  (first children)
                  :handler-core-node-id
                  (get body :node-id)
                  :catch-clause-form-id
                  (get catch-form :form-id)
                  :catch-clause-syntax-id
                  (get catch-form :syntax-id)
                  :error-type-form-id
                  (get type-form :form-id)
                  :error-type-syntax-id
                  (get type-form :syntax-id)
                  :error-type-binding-id
                  (get type-binding :binding-id)
                  :catch-binding-form-id
                  (get binder-form :form-id)
                  :catch-binding-syntax-id
                  (get binder-form :syntax-id)
                  :catch-binding-id
                  (get binder :binding-id)
                  :catch-binding-scope-id
                  (get binder :scope-id)
                  :catch-binding-use-syntax-ids
                  uses
                  :candidate-error-transfers
                  candidates
                  :evaluation-region
                  (get (get node :evaluation) :region)
                  :evaluation-owner-function-syntax-id
                  owner
                  :ordered-steps
                  [:evaluate-protected
                   :conditionally-select-source-ordered-typed-handler]
                  :construction-order
                  :protected-then-handlers-source-order-then-try
                  :runtime-evaluation
                  :protected-then-conditional-handler-chain)]
                (if
                 (body-all?
                  [(= 4 (count catch-ids))
                   (= :list (get catch-form :kind))
                   (if
                    (seq? (get catch-form :value))
                    (=
                     ['catch
                      (get type-form :value)
                      (get binder-form :value)
                      (get body-form :value)]
                     (vec (get catch-form :value)))
                    false)
                   (= 'catch (get operator :value))
                   (= :symbol (get operator :kind))
                   (=
                    (get form :form-id)
                    (get catch-form :parent-form-id))
                   (=
                    (get catch-form :form-id)
                    (get operator :parent-form-id)
                    (get type-form :parent-form-id)
                    (get binder-form :parent-form-id)
                    (get body-form :parent-form-id))
                   (=
                    :symbol
                    (get type-form :kind)
                    (get binder-form :kind))
                   (= (get type-binding :name) (get type-form :value))
                   (=
                    [:core :type 'gravity.core]
                    [(get type-binding :binding-class)
                     (get type-binding :kind)
                     (get type-binding :namespace)])
                   (=
                    [:lexical :local]
                    [(get binder :binding-class) (get binder :kind)])
                   (= (get binder :name) (get binder-form :value))
                   (=
                    (get binder :definition-syntax-id)
                    (get binder-form :syntax-id))
                   (=
                    (get binder :scope-id)
                    (get binder-form :scope-id))
                   (= (get body :source) (body-throw-source body-form))
                   (= uses all-uses)
                   (= expected-clause clause)
                   (= expected-record record)])
                 (if
                  (= type nil)
                  (body-eh-error
                   "C7-ANNOTATION"
                   :unsupported-atomic-catch-type
                   node
                   :canonical-atomic-error-type
                   (get type-form :value))
                  (recur
                   (+ index 1)
                   (conj
                    values
                    {:record record,
                     :error-type type,
                     :handler-core-node-id (get body :node-id)})
                   (assoc next-seeds (get binder :binding-id) type)))
                 (body-eh-error
                  "C7-VERIFY"
                  :typed-handler-source-join
                  node
                  :exact-canonical-handler
                  record)))))
             (body-eh-error
              "C7-VERIFY"
              :error-handler-census
              node
              :exact-handler-records
              records))]
           (if
            (body-all?
             [(vector? records)
              (vector? clauses)
              (> (count clauses) 0)
              (= (+ 1 (count clauses)) (count children))
              (= (+ 2 (count clauses)) (count ids))
              (= source (body-throw-source form))
              (= :list (get form :kind))
              (= 'try (get (get forms (first ids)) :value))
              (if
               (seq? (get form :value))
               (=
                (loop
                 [remaining (rest ids) out ['try]]
                 (if
                  (= 0 (count remaining))
                  out
                  (recur
                   (rest remaining)
                   (conj
                    out
                    (get (get forms (first remaining)) :value)))))
                (vec (get form :value)))
               false)
              (=
               (get (get nodes (first children)) :source)
               (body-throw-source (get forms (get ids 1))))
              (= 0 (get attrs :protected-child-index))
              (= (count clauses) (get attrs :handler-count))
              (=
               (loop
                [i 1 out []]
                (if
                 (= i (count children))
                 out
                 (recur (+ i 1) (conj out i))))
               (get attrs :handler-child-indexes))
              (=
               :protected-then-ordered-typed-handler-candidates
               (get attrs :evaluation-order)
               (get (get node :evaluation) :kind))
              (=
               owner
               (get (get node :evaluation) :owner-function-syntax-id))
              (=
               (loop
                [remaining clauses out []]
                (if
                 (= 0 (count remaining))
                 out
                 (recur
                  (rest remaining)
                  (conj
                   (conj
                    out
                    (get (first remaining) :error-type-binding-id))
                   (get (first remaining) :catch-binding-id)))))
               (get node :resolved-binding-ids))
              (=
               [{:index 0, :core-node-id (first children)}]
               (get (get node :evaluation) :order))
              (=
               :source-ordered-typed-handler-candidates
               (get attrs :selection-policy))
              (=
               :protected-or-selected-handler-last
               (get attrs :result-policy))
              (=
               :not-asserted-by-sh07-b9
               (get attrs :runtime-reachability))
              (=
               [:pending-sh08
                :pending-sh08
                :pending-sh09
                :pending-sh09
                :pending-sh09
                :pending-sh10
                :pending-sh11]
               [(get attrs :type-coverage-legality)
                (get attrs :result-type-join-legality)
                (get attrs :effect-registry-legality)
                (get attrs :effect-profile-capability-legality)
                (get attrs :profile-error-lowering-legality)
                (get attrs :ownership-legality)
                (get attrs :safety-classification)])])
            (if
             (= :accepted (get result :status))
             (recur
              (rest remaining)
              (+ ordinal (count clauses))
              (assoc groups id (get result :clauses))
              (get result :seeds))
             result)
            (body-eh-error
             "C7-VERIFY"
             :typed-try-source-join
             node
             :exact-canonical-try
             attrs)))))
        owners)))))
   (body-eh-error
    "C7-VERIFY"
    :malformed-typed-handler-family
    {}
    :canonical-handler-input-vectors
    nil))))

(defn body-eh-partition [protected clauses graph]
  (loop [remaining clauses candidates protected handler-errors [] handled []]
    (if (= 0 (count remaining))
      {:residual (body-error-type-union candidates handler-errors) :handled handled}
      (let [clause (first remaining) type (get clause :error-type)
            classified (loop [errors candidates matched [] residual []]
                         (if (= 0 (count errors)) {:matched matched :residual residual}
                           (if (= type (first errors))
                             (recur (rest errors) (conj matched (first errors)) residual)
                             (recur (rest errors) matched (conj residual (first errors))))))
            matched (get classified :matched)
            own (if (= 0 (count matched)) [] (body-error-types graph (get clause :handler-core-node-id)))]
        (recur (rest remaining) (get classified :residual) (body-error-type-union handler-errors own)
          (conj handled {:source-handler (get clause :record) :error-type type
                         :candidate-error-types candidates :matched-error-types matched
                         :handler-error-types own :remaining-error-types (get classified :residual)}))))))

(defn body-eh-child-types [ids types]
  (loop [remaining ids out []]
    (if (= 0 (count remaining)) out
      (recur (rest remaining) (conj out (get types (first remaining) :gravity.type/unknown))))))

(defn body-eh-normal-join [types]
  (loop [remaining types result :gravity.type/never]
    (if (= 0 (count remaining)) result
      (let [type (first remaining)]
        (if (contains? #{nil :gravity.type/unknown} type) :gravity.type/unknown
          (if (= type :gravity.type/never) (recur (rest remaining) result)
            (if (= result :gravity.type/never) (recur (rest remaining) type)
              (if (= result type) (recur (rest remaining) result) :gravity.type/unknown))))))))

(defn body-eh-constraint [node clauses types graph]
  (let [ids (get node :children)
        source-errors (loop [remaining ids out []]
                        (if (= 0 (count remaining)) out
                          (recur (rest remaining) (conj out (body-error-types graph (first remaining))))))
        partition (body-eh-partition (first source-errors) clauses graph)
        premise {:version :sh08-atomic-typed-catch-v1 :source-node node
                 :source-handlers (loop [remaining clauses out []]
                                    (if (= 0 (count remaining)) out
                                      (recur (rest remaining) (conj out (get (first remaining) :record)))))
                 :catch-types (loop [remaining clauses out []]
                                (if (= 0 (count remaining)) out
                                  (recur (rest remaining) (conj out (get (first remaining) :error-type)))))
                 :child-types (body-eh-child-types ids types) :child-source-error-types source-errors
                 :partition partition :normal-result-type (get types (get node :node-id))
                 :matching :exact-canonical-atomic-type :effect-label-discharge :pending-profile-handler-capability-authority}]
    {:constraint-id-request {:domain :gravity/sh08-atomic-typed-catch-v1 :premise premise}
     :kind :equality :producer-rule :sh08-atomic-typed-catch-v1
     :lhs {:core-node-id (get node :node-id) :projection :source-error-handler-result}
     :rhs (get partition :residual) :dependencies premise :origin (get (get node :source) :origin-chain)
     :solution {:normal-result-type (get premise :normal-result-type) :thrown-error-effects (get partition :residual)
                :handled-source-errors (get partition :handled) :effect-label-discharge :pending-profile-handler-capability-authority}
     :invalidation [:error-handlers :error-transfers :catch-type-bindings :catch-lexical-bindings :type-table :source-forms :evaluation-order]
     :status :solved :diagnostics []}))

(defn body-eh-verify [request core facts groups graph]
  (let [tries (body-select (get core :nodes) :core-form :try)
        records (get core :error-handlers)
        rows (body-select (get facts :constraint-ledger) :producer-rule :sh08-atomic-typed-catch-v1)
        resolutions (body-path request [:b47-context :authenticated-core-request :resolution-table])
        source-forms (body-path request [:b47-context :authenticated-core-request :forms])]
    (if (= 0 (count tries))
      (if (= [] rows) {:status :accepted}
        (body-failure :unexpected-typed-catch-constraints))
      (if (= false (body-maps? resolutions)) (body-failure :malformed-catch-resolution-table)
      (let [indexed (body-index resolutions :reference-syntax-id) types (get facts :type-table)
            forms (body-index source-forms :form-id)
            syntax-nodes (loop [remaining (get core :nodes) out {}]
                           (if (= 0 (count remaining)) out
                             (let [node (first remaining)]
                               (recur (rest remaining) (assoc out (get (get node :source) :syntax-id) node)))))
            expected
            (loop [remaining tries values []]
              (if (= 0 (count remaining)) {:status :accepted :rows values}
                (let [node (first remaining) id (get node :node-id) clauses (get groups id)
                      child-types (body-eh-child-types (get node :children) types)
                      joined (body-eh-normal-join child-types)
                      binders-valid?
                      (loop [remaining-clauses clauses]
                        (if (= 0 (count remaining-clauses)) true
                          (let [clause (first remaining-clauses) record (get clause :record)
                                resolution (get indexed (get record :error-type-syntax-id))
                                uses-valid?
                                (loop [uses (get record :catch-binding-use-syntax-ids)]
                                  (if (= 0 (count uses)) true
                                    (let [use-id (first uses) resolved (get indexed use-id)
                                          reference (get syntax-nodes use-id)]
                                      (if (body-all? [(= (get record :catch-binding-id) (get resolved :binding-id))
                                              (= (get resolved :symbol) (get (get forms (get (get reference :source) :form-id)) :value))
                                              (= (get clause :error-type) (get types (get reference :node-id)))])
                                        (recur (rest uses)) false))))]
                            (if (body-all? [(map? resolution) (= :type (get resolution :position))
                                    (= (get resolution :symbol) (get (get forms (get record :error-type-form-id)) :value))
                                    (= (get record :error-type-binding-id) (get resolution :binding-id)) uses-valid?])
                              (recur (rest remaining-clauses)) false))))
                      row (assoc (body-eh-constraint node clauses types graph)
                            :profile (get (get core :module) :profile) :target (get (get core :module) :target))]
                  (if (body-all? [binders-valid? (= false (= joined :gravity.type/unknown)) (= joined (get types id))
                                  (= (get row :rhs) (body-error-types graph id))
                                  (= (get (get row :solution) :handled-source-errors) (get (get graph id) :covered-source-errors))
                                  (= :pending-profile-handler-capability-authority (get (get graph id) :effect-label-discharge))])
                    (recur (rest remaining) (conj values row))
                    (body-failure :incoherent-atomic-typed-catch-body-equation)))))]
        (if (body-all? [(map? indexed) (= :accepted (get expected :status))
                        (if (body-rv? facts) (= [] rows) (= rows (get expected :rows)))])
          (if (body-rv? facts)
            {:status :accepted
             :checked-handler-equations (loop [remaining (get expected :rows) out []]
                                          (if (= 0 (count remaining)) out
                                            (recur (rest remaining) (conj out (get (first remaining) :dependencies)))))}
            {:status :accepted})
          (body-failure :incoherent-atomic-typed-catch-ledger)))))))

(defn body-call-invokes? [node types]
  (loop [remaining (get node :children)]
    (if (= 0 (count remaining)) true
      (if (= :gravity.type/never (get types (first remaining))) false (recur (rest remaining))))))

(defn body-error-types [graph id]
  (get (get graph id) :escaping-thrown-error-types (vec (get (get graph id) :escaping-thrown-errors #{}))))

; L6/STD3: static constructor behavior, not a claim about observed heap
; placement. The existing graph binds ordered child types and source identity.
(defn body-constructor-allocation [node graph]
  (if (= :collection-literal (get node :core-form))
    (let [children (get node :children) kind (get (get node :attributes) :literal-kind)
          normal? (loop [remaining children]
                    (if (= 0 (count remaining)) true
                      (if (= :gravity.type/never (get (get graph (first remaining)) :type)) false (recur (rest remaining)))))]
      {:rule-version :sh09-evaluated-collection-allocation-v1 :collection-kind kind
       :behavior :static-constructor-allocation :condition :normal-operand-completion
       :normal-completion-possible? normal?
       :extent {:unit (if (= kind :map) :entries :elements) :count (if (= kind :map) (quot (count children) 2) (count children))}
       :placement :pending-profile-representation :provider :pending-runtime-provider :ownership :pending-ownership-analysis}) nil))

(defn body-association-allocation [node graph]
  (if (if (= :call (get node :core-form))
        (= :gravity.type/applied-map-association (get (get (get graph (first (get node :children))) :type) :kind)) false)
    {:rule-version :sh09-map-association-allocation-v1 :collection-kind :map :behavior :static-persistent-map-association
     :condition :normal-operand-completion
     :normal-completion-possible? (loop [remaining (get node :children)]
                                    (if (= 0 (count remaining)) true
                                      (if (= :gravity.type/never (get (get graph (first remaining)) :type)) false (recur (rest remaining)))))
     :extent {:unit :association-operands :count 3}
     :placement :pending-profile-representation :provider :pending-runtime-provider :ownership :pending-ownership-analysis} nil))

(defn body-removal-allocation [node graph]
  (let [descriptor (get (get graph (first (get node :children))) :type)]
    (if (if (= :call (get node :core-form)) (= :gravity.type/applied-map-removal (get descriptor :kind)) false)
      {:rule-version :sh09-map-removal-allocation-v1 :collection-kind :map :behavior :static-persistent-map-removal
       :condition :normal-operand-completion :normal-completion-possible? (= :normal (get descriptor :application))
       :extent {:unit :removal-operands :count 2} :allocation-policy (get descriptor :allocation-policy)
       :storage-policy (get descriptor :storage-policy)
       :placement :pending-profile-representation :provider :pending-runtime-provider :ownership :pending-ownership-analysis} nil)))

(defn body-append-allocation [node graph]
  (let [descriptor (get (get graph (first (get node :children))) :type)]
    (if (if (= :call (get node :core-form))
          (contains? #{:gravity.type/applied-vector-append :gravity.type/applied-list-prepend :gravity.type/applied-string-set-insertion :gravity.type/applied-keyword-set-insertion :gravity.type/applied-symbol-set-insertion} (get descriptor :kind)) false)
      (if (contains? #{:gravity.type/applied-string-set-insertion :gravity.type/applied-keyword-set-insertion :gravity.type/applied-symbol-set-insertion} (get descriptor :kind))
        {:rule-version (if (= :gravity.type/applied-symbol-set-insertion (get descriptor :kind))
            :sh09-symbol-set-insertion-allocation-v2
            (if (= :gravity.type/applied-keyword-set-insertion (get descriptor :kind)) :sh09-keyword-set-insertion-allocation-v1 :sh09-string-set-insertion-allocation-v1)) :collection-kind :set
         :behavior :static-persistent-set-insertion :condition :normal-operand-completion
         :normal-completion-possible? (= :normal (get descriptor :application))
         :extent {:unit :insertion-operands :count 2 :result-cardinality :runtime-value-dependent}
         :allocation-policy (get descriptor :allocation-policy) :storage-policy (get descriptor :storage-policy)
         :placement :pending-profile-representation :provider :pending-runtime-provider :ownership :pending-ownership-analysis}
        (if (= :gravity.type/applied-list-prepend (get descriptor :kind))
        {:rule-version :sh09-list-prepend-allocation-v1 :collection-kind :list :behavior :static-persistent-list-prepend
         :condition :normal-operand-completion :normal-completion-possible? (= :normal (get descriptor :application))
         :extent {:unit :prepend-operands :count 2} :allocation-policy (get descriptor :allocation-policy)
         :storage-policy (get descriptor :storage-policy)
         :placement :pending-profile-representation :provider :pending-runtime-provider :ownership :pending-ownership-analysis}
      {:rule-version :sh09-vector-append-allocation-v1 :collection-kind :vector :behavior :static-persistent-vector-append
       :condition :normal-operand-completion
       :normal-completion-possible? (= :normal (get descriptor :application))
       :extent {:unit :elements :count (get descriptor :result-extent)}
       :placement :pending-profile-representation :provider :pending-runtime-provider :ownership :pending-ownership-analysis})) nil)))

(defn body-set-conversion-allocation [node graph]
  (let [descriptor (get (get graph (first (get node :children))) :type)]
    (if (if (= :call (get node :core-form)) (= :gravity.type/applied-set-conversion (get descriptor :kind)) false)
      {:rule-version :sh09-set-conversion-allocation-v1 :collection-kind :set
       :behavior (get (get descriptor :construction-policy) :operation) :condition :normal-operand-completion
       :normal-completion-possible? (= :normal (get descriptor :application))
       :extent (if (= :normal (get descriptor :application)) {:unit :input-elements :upper-bound (get descriptor :input-element-count)
                :result-cardinality :runtime-value-dependent} nil)
       :placement :pending-profile-representation :provider :pending-runtime-provider :ownership :pending-ownership-analysis} nil)))

(defn body-list-construction-allocation [node graph]
  (let [descriptor (get (get graph (first (get node :children))) :type)]
    (if (if (= :call (get node :core-form)) (= :gravity.type/applied-list-construction (get descriptor :kind)) false)
      {:rule-version :sh09-list-construction-allocation-v1 :collection-kind :list :behavior :static-persistent-list-construction
       :condition :normal-operand-completion :normal-completion-possible? (= :normal (get descriptor :application))
       :extent {:unit :elements :count (count (get descriptor :argument-types))}
       :placement :pending-profile-representation :provider :pending-runtime-provider :ownership :pending-ownership-analysis} nil)))

(defn body-string-concat-allocation [node graph]
  (let [descriptor (get (get graph (first (get node :children))) :type)]
    (if (if (= :call (get node :core-form)) (= :gravity.type/applied-string-concat (get descriptor :kind)) false)
      {:rule-version :sh09-string-concat-allocation-v1 :value-kind :string :behavior :static-binary-string-concatenation
       :condition :normal-operand-completion :normal-completion-possible? (= :normal (get descriptor :application))
       :extent {:unit :concatenation-operands :count 2}
       :placement :pending-profile-representation :provider :pending-runtime-provider :ownership :pending-ownership-analysis} nil)))

(defn body-node-record [node target graph type]
  (let [kind (get node :core-form) children (get node :children) source (get node :source)
        construction? (= kind :fn) latent (if construction? (body-node-effects children graph) #{})
        deps (if construction? [] (if (= target nil) children (conj children target)))
        allocation (if (= kind :collection-literal) (body-constructor-allocation node graph)
                       (let [set-allocation (let [list-set (body-lset-allocation node graph)]
                                               (if (= nil list-set) (body-set-conversion-allocation node graph) list-set))
                             quotient (if (= set-allocation nil) (let [numeric (body-nq-allocation node graph)] (if (= numeric nil) (let [scaling (body-cqs-allocation node graph)] (if (= scaling nil) (let [converted (body-scv-allocation node graph)] (if (= converted nil) (body-vsl-allocation node graph) converted)) scaling)) numeric)) set-allocation)
                             map-keys-allocation (if (= quotient nil) (body-mkeys-allocation node graph) quotient)
                             vector-rest-allocation (if (= map-keys-allocation nil) (body-vrest-allocation node graph) map-keys-allocation)
                             list-allocation (if (= vector-rest-allocation nil) (body-list-construction-allocation node graph) vector-rest-allocation)
                             concatenation (if (= list-allocation nil) (body-string-concat-allocation node graph) list-allocation)]
                         (if (= concatenation nil)
                           (let [append (body-append-allocation node graph)]
                             (if (= append nil)
                               (let [removal (body-removal-allocation node graph)]
                                 (if (= removal nil) (body-association-allocation node graph) removal)) append)) concatenation)))
        direct (if (= true (get allocation :normal-completion-possible?)) #{:memory/allocate}
                 (if (if (= kind :throw) (= false (= :gravity.type/never (get (get graph (first children)) :type))) false)
                   #{:error/throw} #{}))
        effects (body-add direct (body-node-effects deps graph))
        error-ids (if construction? children deps)
        errors (loop [ids error-ids out []]
                 (if (= 0 (count ids)) out
                   (recur (rest ids) (body-error-type-union out (body-error-types graph (first ids))))))
        direct-errors (if (= direct #{:error/throw}) #{(get (get graph (first children)) :type)} #{})
        error-evidence? (if (= kind :throw) true
                          (loop [ids error-ids]
                            (if (= 0 (count ids)) false
                              (if (contains? (get graph (first ids)) :escaping-thrown-errors) true (recur (rest ids))))))
        record {:artifact :gravity/c8-effect-node :core-node-id (get node :node-id) :operation kind
     :direct direct :latent latent :transitive effects :escaping effects :handled []
     :evaluated-children (if construction? [] (body-order-ids (get (get node :evaluation) :order)))
     :latent-children (if construction? children [])
     :call-body-dependency target :dependencies deps
     :ordering (get node :evaluation) :conditional-coverage (body-conditional-coverage node)
     :source-span (get source :semantic-span) :syntax-id (get source :syntax-id)
     :origin-chain (get source :origin-chain) :generated-origin (get source :generated-origin)
     :type type :type-fact-id {:resolution :coordinator-digest-required
                              :identity-input {:domain :gravity/sh09-body-node-type-v1
                                               :core-node-id (get node :node-id) :type type}}}
        record (if (= allocation nil) record (assoc record :allocation allocation))]
    (if error-evidence?
      (assoc record :direct-thrown-errors direct-errors
        :escaping-thrown-errors (if construction? #{} (set (body-error-type-union errors (vec direct-errors))))
        :escaping-thrown-error-types (if construction? [] (body-error-type-union errors (vec direct-errors)))
        :latent-thrown-errors (if construction? (set errors) #{})
        :latent-thrown-error-types (if construction? errors [])) record)))

(defn body-node-supported? [node]
  (let [kind (get node :core-form) children (get node :children)]
    (if (body-all? [(map? node) (vector? children) (sh09-sha256-id? (get node :node-id))
                    (map? (get node :source)) (map? (get node :evaluation))])
      (if (contains? #{:literal :quote :reference} kind) (= [] children)
        (if (contains? #{:def :fn :throw} kind) (= 1 (count children))
          (if (= :if kind) (= 3 (count children))
            (if (= :recur kind)
              (if (contains? #{:loop :function} (get (get node :attributes) :target-kind))
                (sh09-sha256-id? (get (get node :attributes) :target-id)) false)
              (if (= kind :keyword-map-lookup) (= 2 (count children))
                (if (= kind :collection-literal)
                  (body-all? [(contains? #{:vector :map :set} (get (get node :attributes) :literal-kind))
                              (= (count children) (get (get node :attributes) :element-count))
                              (if (= :map (get (get node :attributes) :literal-kind))
                                (= (count children) (* 2 (quot (count children) 2))) true)])
                  (contains? #{:let :do :call :match :loop :try} kind))))))) false)))

(defn body-order-valid? [node]
  (let [kind (get node :core-form) children (get node :children) order (get (get node :evaluation) :order)
        expected (if (contains? #{:fn :quote} kind) []
                   (if (contains? #{:if :match :try} kind) [(first children)] children))]
    (if (if (= kind :keyword-map-lookup)
          (body-all? [(= 2 (count children)) (= :keyword-then-map (get (get node :evaluation) :kind))
                      (= :keyword-then-map (get (get node :attributes) :evaluation-order))]) true)
    (if (vector? order)
      (if (= (count expected) (count order))
        (loop [index 0]
          (if (= index (count order)) true
            (let [entry (get order index)]
              (if (if (map? entry) (body-all? [(= index (get entry :index))
                                              (= (get expected index) (get entry :core-node-id))]) false)
                (recur (+ index 1)) false)))) false) false) false)))

(defn body-foreign-node-record [node imported graph type]
  (let [base (body-node-record node nil graph type)
        effects (body-add (get (get imported :summary) :inferred) (get base :transitive))]
    (assoc base :foreign-body-dependency (assoc (get imported :coordinate) :body-core-node-id (get imported :body-core-node-id))
                :transitive effects :escaping effects)))

(defn body-selected-function [edge facts functions]
  (let [proof (get facts :higher-order-proof)]
    (if (if (map? proof) (= (get edge :call-core-node-id) (get proof :inner-call-core-node-id)) false)
      (get functions (get proof :identity-function-syntax-id))
      (get functions (get edge :callee-function-syntax-id)))))

(defn body-local-node-record [node target graph type facts edge]
  (let [base (body-node-record node target graph type) proof (get facts :higher-order-proof)]
    (if (if (map? proof) (= (get node :node-id) (get proof :inner-call-core-node-id)) false)
      (assoc base :call-body-dependency nil
        :selected-body-dependency {:proof-domain (get proof :domain)
          :identity-definition-binding-id (get proof :identity-definition-binding-id)
          :function-id (get proof :identity-function-syntax-id) :body-core-node-id target
          :callable-parameter-binding-id (get proof :apply-callable-binding-id) :source-edge (body-edge-projection edge)}) base)))

(defn body-control-node-record [node target graph type facts edge core source-target]
  (let [base (body-local-node-record node target graph type facts edge)
        base (if (= :try (get node :core-form))
               (let [partition (body-eh-partition (body-error-types graph (first (get node :children)))
                                 (get (get facts :atomic-typed-handlers {}) (get node :node-id) []) graph)]
                 (assoc base :escaping-thrown-error-types (get partition :residual)
                   :escaping-thrown-errors (set (get partition :residual))
                   :covered-source-errors (get partition :handled)
                   :effect-label-discharge :pending-profile-handler-capability-authority)) base)
        invoked? (body-call-invokes? node (get facts :type-table))
        base (if (if (= :call (get node :core-form))
                   (if (= false invoked?) true (contains? base :escaping-thrown-error-types)) false)
               (assoc base :throw-call-dependency {:source-edge edge :callee-source-body-id source-target
                 :analysis :conservative-source-error-potential :invocation-guard :all-operand-types-normal
                 :normal-invocation? invoked? :callee-error-types (if invoked? (body-error-types graph source-target) [])}) base)]
    (if (= :throw (get node :core-form))
      (let [transfer (body-by (get core :error-transfers) :core-node-id (get node :node-id))
            payload-type (get (get graph (get transfer :value-core-node-id)) :type)]
        (assoc base :error-transfer {:source-transfer transfer :payload-type payload-type
          :normal-transfer? (= false (= payload-type :gravity.type/never)) :ordered-steps [:evaluate-value :transfer-error]}))
    (if (= :recur (get node :core-form))
      (let [bodies (body-loop-body-ids node core)
            transfer (body-by (get core :recur-transfers) :recur-core-node-id (get node :node-id))
            target-record (body-by (get core :recur-targets) :target-id (get transfer :target-id))
            effects (body-add (body-node-effects bodies graph) (get base :transitive))]
        (assoc base :dependencies (body-add bodies (get base :dependencies))
          :loop-backedge {:target-id (get transfer :target-id) :body-core-node-ids bodies
                          :argument-core-node-ids (get transfer :argument-node-ids)
                          :source-transfer transfer :source-target target-record}
          :transitive effects :escaping effects)) base))))

(defn body-loop-summary-graph [graph ids summaries]
  (loop [remaining ids graph graph]
    (if (= 0 (count remaining)) graph
      (recur (rest remaining) (assoc graph (first remaining) {:transitive (get summaries (first remaining))})))))

(defn body-ds-summary-valid? [summary]
  (if (if (map? summary) (= #{:transitive :escaping-thrown-errors :escaping-thrown-error-types} (set (keys summary))) false)
    (if (body-all? [(set? (get summary :transitive)) (set? (get summary :escaping-thrown-errors))
                    (vector? (get summary :escaping-thrown-error-types))])
      (= (get summary :escaping-thrown-errors) (set (get summary :escaping-thrown-error-types))) false) false))

(defn body-derive-nodes-pass [core typed foreign recursive summary]
  (if (if (contains? #{:gravity/sh08-declared-self-value-proof-v1 :gravity/sh08-private-self-value-proof-v1 :gravity/sh08-indexed-private-self-value-proof-v1} (get recursive :domain))
        (body-ds-summary-valid? summary) true)
  (let [edges (body-index (get core :call-edges) :call-core-node-id)
        functions (body-index (get typed :function-type-table) :function-id)]
    (loop [pending (get core :nodes) deferred [] graph {} progress 0 rounds 0]
      (if (= 0 (count pending))
        (if (= 0 (count deferred))
          {:status :accepted :nodes graph}
          (if (if (> progress 0) (< rounds (count (get core :nodes))) false)
            (recur deferred [] graph 0 (+ rounds 1))
            {:status :rejected :reason :cyclic-or-missing-body-effect-dependencies}))
        (let [node (first pending) kind (get node :core-form) id (get node :node-id)
              edge (get edges id) function (body-selected-function edge typed functions)
              imported (get foreign (get edge :callee-binding-id))
              target (if (if (= kind :call) (body-call-invokes? node (get typed :type-table)) false)
                       (if (= imported nil) (get function :body-core-node-id) nil) nil)
              declared? (contains? #{:gravity/sh08-declared-self-value-proof-v1 :gravity/sh08-private-self-value-proof-v1 :gravity/sh08-indexed-private-self-value-proof-v1} (get recursive :domain))
              backedge? (= id (if declared? (get recursive :self-call-core-node-id) (get recursive :recursive-call-core-node-id)))
              bodies (if (= kind :recur) (body-loop-body-ids node core) [])
              loop-cut? (if (= kind :recur) (contains? recursive :loop-summaries) false)
              deps (if (if (= target nil) true backedge?) (get node :children) (conj (get node :children) target))
              deps (if loop-cut? deps (body-add bodies deps))
              effective-graph (body-loop-summary-graph
                                (if backedge? (assoc graph target (if declared? summary {:transitive summary})) graph)
                                (if loop-cut? bodies []) (get recursive :loop-summaries))]
          (if (if (body-node-supported? node) (body-order-valid? node) false)
            (if (if (= kind :call) (if (map? imported) true (if (map? function) true
                                           (if (body-io-node? node typed core) true
                                             (if (if (body-ma-node? node typed core) true (body-mr-node? node typed core)) true
                                               (if (body-cq-node? node typed core) true (if (body-vn-node? node typed core) true
                                                 (if (body-va-node? node typed core) true
                                                   (if (if (if (if (if (if (if (body-lq-node? node typed core) true (body-lc-node? node typed core)) true (if (if (if (if (body-vsl-node? node typed core) (body-vsl-node? node typed core) (body-scv-node? node typed core)) (if (body-vsl-node? node typed core) (body-vsl-node? node typed core) (body-scv-node? node typed core)) (body-cqs-node? node typed core)) true (body-nq-node? node typed core)) true (body-sc-node? node typed core))) true (body-mg-node? node typed core)) true (body-mc-node? node typed core)) true (if (if (if (body-st-node? node typed core) true (if (body-ane-node? node typed core) true (if (if (body-chp-node? node typed core) true (body-nilp-node? node typed core)) true (if (body-boolp-node? node typed core) true (if (body-symp-node? node typed core) true (if (if (body-listp-node? node typed core) true (body-setp-node? node typed core)) true (if (body-mapp-node? node typed core) true (if (body-kp-node? node typed core) true (if (body-strp-node? node typed core) true (body-ip-node? node typed core)))))))))) true (body-vp-node? node typed core)) true (body-nt-node? node typed core))) true (body-ae-node? node typed core)) true (body-si-node? node typed core)))))))))
                    (if (= kind :match) (body-match-valid? node core (get typed :type-table)) true))
              (if (body-ready? deps graph)
                (recur (rest pending) deferred
                       (assoc graph id (if (= imported nil)
                                         (body-control-node-record node target
                                           effective-graph
                                           (get (get typed :type-table) id) typed edge core
                                           (get (get functions (get edge :callee-function-syntax-id)) :body-core-node-id))
                                         (body-foreign-node-record node imported graph (get (get typed :type-table) id))))
                       (+ progress 1) rounds)
                (recur (rest pending) (conj deferred node) graph progress rounds))
              {:status :rejected :reason :unsupported-nonlocal-or-higher-order-call :node node})
              {:status :rejected :reason :unsupported-body-operation :node node})))))
    (body-failure :malformed-declared-self-summary)))

(defn body-derive-nodes-with-foreign [core facts foreign]
  (body-derive-nodes-pass core facts foreign {} #{}))

(defn body-graph-equations-valid? [core facts foreign graph]
  (let [edges (body-index (get core :call-edges) :call-core-node-id)
        functions (body-index (get facts :function-type-table) :function-id)]
    (loop [remaining (get core :nodes)]
      (if (= 0 (count remaining)) true
        (let [node (first remaining) id (get node :node-id) edge (get edges id)
              imported (get foreign (get edge :callee-binding-id))
              target (if (if (= :call (get node :core-form)) (body-call-invokes? node (get facts :type-table)) false)
                       (if (= imported nil) (get (body-selected-function edge facts functions) :body-core-node-id) nil) nil)
              deps (if (= target nil) (get node :children) (conj (get node :children) target))
              deps (if (= :recur (get node :core-form)) (body-add (body-loop-body-ids node core) deps) deps)]
          (if (if (if (= :call (get node :core-form))
                     (if (= imported nil) (if (map? (body-selected-function edge facts functions)) true
                                            (if (body-io-node? node facts core) true
                                              (if (if (body-ma-node? node facts core) true (body-mr-node? node facts core)) true
                                                (if (body-cq-node? node facts core) true (if (body-vn-node? node facts core) true
                                                  (if (body-va-node? node facts core) true
                                                    (if (if (if (if (if (if (if (body-lq-node? node facts core) true (body-lc-node? node facts core)) true (if (if (if (if (body-vsl-node? node facts core) (body-vsl-node? node facts core) (body-scv-node? node facts core)) (if (body-vsl-node? node facts core) (body-vsl-node? node facts core) (body-scv-node? node facts core)) (body-cqs-node? node facts core)) true (body-nq-node? node facts core)) true (body-sc-node? node facts core))) true (body-mg-node? node facts core)) true (body-mc-node? node facts core)) true (if (if (if (body-st-node? node facts core) true (if (body-ane-node? node facts core) true (if (if (body-chp-node? node facts core) true (body-nilp-node? node facts core)) true (if (body-boolp-node? node facts core) true (if (body-symp-node? node facts core) true (if (if (body-listp-node? node facts core) true (body-setp-node? node facts core)) true (if (body-mapp-node? node facts core) true (if (body-kp-node? node facts core) true (if (body-strp-node? node facts core) true (body-ip-node? node facts core)))))))))) true (body-vp-node? node facts core)) true (body-nt-node? node facts core))) true (body-ae-node? node facts core)) true (body-si-node? node facts core)))))))) true) true)
                (if (body-ready? deps graph)
                (= (get graph id)
                   (if (= imported nil) (body-control-node-record node target graph (get (get facts :type-table) id) facts edge core
                                          (get (get functions (get edge :callee-function-syntax-id)) :body-core-node-id))
                     (body-foreign-node-record node imported graph (get (get facts :type-table) id)))) false) false)
            (recur (rest remaining)) false))))))

(defn body-function-bottom [facts]
  (loop [remaining (get facts :function-type-table) result {}]
    (if (= 0 (count remaining)) result
      (recur (rest remaining) (assoc result (get (first remaining) :function-id) #{})))))

(defn body-function-summary [facts graph]
  (loop [remaining (get facts :function-type-table) result {}]
    (if (= 0 (count remaining)) result
      (let [function (first remaining)]
        (recur (rest remaining)
          (assoc result (get function :function-id) (get (get graph (get function :body-core-node-id)) :transitive)))))))

(defn body-classify-nodes [core facts]
  (loop [remaining (get core :nodes)]
    (if (= 0 (count remaining)) {:status :accepted}
      (let [node (first remaining)]
        (if (if (body-node-supported? node)
              (if (body-order-valid? node)
                (if (= :match (get node :core-form)) (body-match-valid? node core (get facts :type-table)) true) false) false)
          (recur (rest remaining))
          {:status :rejected :reason :unsupported-body-operation :node node})))))

; The least fixed point below is over actual effects AND escaping error
; types. Empty summaries are analysis bottoms, never C7 callable signatures.
(defn body-ds-summaries [facts graph]
  (loop [remaining (get facts :function-type-table) out {}]
    (if (= 0 (count remaining)) {:status :accepted :functions out}
      (let [function (first remaining) record (get graph (get function :body-core-node-id))
            effects (if (= graph nil) #{} (get record :transitive))
            errors (if (= graph nil) [] (body-error-types graph (get function :body-core-node-id)))]
        (if (if (= graph nil) true (map? record))
          (recur (rest remaining)
            (assoc out (get function :function-id)
              {:transitive effects :escaping-thrown-errors (set errors) :escaping-thrown-error-types errors}))
          (body-failure :missing-recursive-body-summary))))))

(defn body-ds-derive-recursive-nodes [core facts foreign]
  (let [proof (get facts :recursive-proof) bottom (body-ds-summaries facts nil)]
    (if (body-recursive-proof-valid? core facts)
      (let [classified (body-classify-nodes core facts)]
        (if (= :accepted (get classified :status))
          (loop [summaries (get bottom :functions) rounds 0 seen #{}]
            (if (contains? seen summaries)
              (body-failure :recursive-effect-error-equations-mismatch)
              (let [derived (body-derive-nodes-pass core facts foreign proof
                              (get summaries (get proof :function-syntax-id)))
                    next (if (= :accepted (get derived :status)) (body-ds-summaries facts (get derived :nodes)) derived)]
                (if (= :accepted (get next :status))
                  (if (= summaries (get next :functions))
                    (let [final (body-derive-nodes-pass core facts foreign proof
                                  (get (get next :functions) (get proof :function-syntax-id)))
                          checked (if (= :accepted (get final :status)) (body-ds-summaries facts (get final :nodes)) final)]
                      (if (= :accepted (get checked :status))
                        (if (if (= (get next :functions) (get checked :functions))
                              (body-graph-equations-valid? core facts foreign (get final :nodes)) false)
                          (assoc final :fixed-point-rounds (+ rounds 1)
                            :summary-domain :effects-and-escaping-error-types)
                          (body-failure :recursive-effect-error-equations-mismatch))
                        checked))
                    (recur (get next :functions) (+ rounds 1) (conj seen summaries)))
                  next))))
          classified))
      (body-failure :untrusted-recursive-body-proof))))

(defn body-derive-recursive-nodes [core facts foreign]
  (if (body-rv? facts)
    (body-ds-derive-recursive-nodes core facts foreign)
    (let [proof (get facts :recursive-proof)
          classified (body-classify-nodes core facts)]
      (if (body-recursive-proof-valid? core facts)
        (if (= :accepted (get classified :status))
          (loop [summaries (body-function-bottom facts) rounds 0 seen #{}]
            (if (contains? seen summaries)
              (body-failure :recursive-effect-equations-mismatch)
              (let [derived (body-derive-nodes-pass core facts foreign proof
                              (get summaries (get proof :function-syntax-id)))
                    next (if (= :accepted (get derived :status))
                           (body-function-summary facts (get derived :nodes)) {})]
                (if (= :accepted (get derived :status))
                  (if (= summaries next)
                    (let [final (body-derive-nodes-pass core facts foreign proof
                                  (get next (get proof :function-syntax-id)))]
                      (if (= :accepted (get final :status))
                        (if (if (= next (body-function-summary facts (get final :nodes)))
                              (body-graph-equations-valid? core facts foreign (get final :nodes))
                              false)
                          (assoc final :fixed-point-rounds (+ rounds 1))
                          (body-failure :recursive-effect-equations-mismatch))
                        final))
                    (recur next (+ rounds 1) (conj seen summaries)))
                  derived))))
          classified)
        (body-failure :untrusted-recursive-body-proof)))))

(defn body-loop-summary [core graph]
  (loop [remaining (get core :recur-transfers) out {}]
    (if (= 0 (count remaining)) out
      (let [node (body-by (get core :nodes) :node-id (get (first remaining) :recur-core-node-id))
            out (loop [ids (body-loop-body-ids node core) out out]
                  (if (= 0 (count ids)) out
                    (recur (rest ids) (assoc out (first ids) (get (get graph (first ids)) :transitive #{})))))]
        (recur (rest remaining) out)))))

; Caller loops keep the existing lexical-child error rule. Their effect
; summaries compose with declared function effect/error records as a product.
(defn body-ds-loop-state [core facts graph]
  (let [functions (body-ds-summaries facts graph)
        nodes (body-index (get core :nodes) :node-id)
        targets (body-index (get core :recur-targets) :target-id)]
    (if (= :accepted (get functions :status))
      (loop [remaining (get core :recur-transfers) out {}]
        (if (= 0 (count remaining))
          {:status :accepted :functions (get functions :functions) :loops out}
          (let [node (get nodes (get (first remaining) :recur-core-node-id))
                target (get targets (get (get node :attributes) :target-id))
                owner (get nodes (get target :owner-core-node-id))
                indexes (if (= :function (get target :target-kind))
                          [0]
                          (get (get owner :attributes) :body-child-indexes))
                next (loop [indexes indexes out out]
                       (if (= 0 (count indexes))
                         out
                         (let [id (get (get owner :children) (first indexes))
                               effects (if (= graph nil) #{}
                                         (get (get graph id) :transitive #{}))]
                           (recur (rest indexes) (assoc out id effects)))))]
            (recur (rest remaining) next))))
      functions)))

(defn body-ds-loop-state-equal? [left right]
  (if (= (get left :functions) (get right :functions)) (= (get left :loops) (get right :loops)) false))

(defn body-ds-derive-loop-nodes [core facts foreign]
  (let [proof (get facts :recursive-proof)
        classified (body-classify-nodes core facts)
        joined (if (= :accepted (get classified :status))
                 (body-loop-joins core facts)
                 classified)]
    (if (body-recursive-proof-valid? core facts)
      (if (= :accepted (get joined :status))
        (if (body-loop-values-valid? core facts)
          (let [bottom (body-ds-loop-state core facts nil)]
            (loop [state bottom rounds 0 seen #{}]
              (if (contains? seen state)
                (body-failure :declared-self-loop-effect-error-equations-mismatch)
                (let [derived (body-derive-nodes-pass
                               core facts foreign
                               (assoc proof :loop-summaries (get state :loops))
                               (get (get state :functions) (get proof :function-syntax-id)))
                      next (if (= :accepted (get derived :status))
                             (body-ds-loop-state core facts (get derived :nodes))
                             derived)]
                  (if (= :accepted (get next :status))
                    (if (body-ds-loop-state-equal? state next)
                      (let [final (body-derive-nodes-pass
                                   core facts foreign
                                   (assoc proof :loop-summaries (get next :loops))
                                   (get (get next :functions) (get proof :function-syntax-id)))
                            checked (if (= :accepted (get final :status))
                                      (body-ds-loop-state core facts (get final :nodes))
                                      final)]
                        (if (= :accepted (get checked :status))
                          (if (if (body-ds-loop-state-equal? next checked)
                                (body-graph-equations-valid? core facts foreign (get final :nodes))
                                false)
                            (assoc final :fixed-point-rounds (+ rounds 1)
                              :summary-domain :effects-and-escaping-error-types
                              :loop-summary-domain :effects-with-lexical-child-source-errors)
                            (body-failure :declared-self-loop-effect-error-equations-mismatch))
                          checked))
                      (recur next (+ rounds 1) (conj seen state)))
                    next)))))
          (body-failure :incoherent-loop-result-type))
        joined)
      (body-failure :untrusted-recursive-body-proof))))

(defn body-derive-loop-nodes [core facts foreign]
  (if (body-rv? facts)
    (body-ds-derive-loop-nodes core facts foreign)
    (let [proof (get facts :recursive-proof {})
          classified (body-classify-nodes core facts)
          joined (if (= :accepted (get classified :status))
                   (body-loop-joins core facts)
                   classified)]
      (if (if (contains? facts :recursive-proof)
            (body-recursive-proof-valid? core facts)
            true)
        (if (= :accepted (get joined :status))
          (if (body-loop-values-valid? core facts)
            (loop [functions (body-function-bottom facts)
                   summaries (body-loop-summary core {})
                   rounds 0
                   seen #{}]
              (if (contains? seen [functions summaries])
                (body-failure :loop-effect-equations-mismatch)
                (let [derived (body-derive-nodes-pass core facts foreign
                                (assoc proof :loop-summaries summaries)
                                (get functions (get proof :function-syntax-id)))
                      next-functions (if (= :accepted (get derived :status))
                                       (body-function-summary facts (get derived :nodes))
                                       {})
                      next (if (= :accepted (get derived :status))
                             (body-loop-summary core (get derived :nodes))
                             {})]
                  (if (= :accepted (get derived :status))
                    (if (if (= summaries next) (= functions next-functions) false)
                      (let [final (body-derive-nodes-pass core facts foreign
                                    (assoc proof :loop-summaries next)
                                    (get next-functions (get proof :function-syntax-id)))]
                        (if (= :accepted (get final :status))
                          (if (body-all?
                                [(= next (body-loop-summary core (get final :nodes)))
                                 (= next-functions (body-function-summary facts (get final :nodes)))
                                 (body-graph-equations-valid? core facts foreign (get final :nodes))])
                            (assoc final :fixed-point-rounds (+ rounds 1))
                            (body-failure :loop-effect-equations-mismatch))
                          final))
                      (recur next-functions next (+ rounds 1)
                             (conj seen [functions summaries])))
                    derived))))
            (body-failure :incoherent-loop-result-type))
          joined)
        (body-failure :untrusted-recursive-body-proof)))))

(defn body-derive-nodes [core facts]
  (body-derive-nodes-with-foreign core facts {}))

(defn body-function-effects [functions graph]
  (loop [remaining functions result {}]
    (if (= 0 (count remaining)) result
      (let [function (first remaining) effects (get (get graph (get function :body-core-node-id)) :transitive)]
        (recur (rest remaining)
          (assoc result (get function :function-id)
            {:function-id (get function :function-id) :body-core-node-id (get function :body-core-node-id)
             :declared (set (get function :latent-effects)) :inferred effects :latent effects
             :throws (get function :thrown-error-effects) :declared-capabilities (set (get function :capabilities))
             :source-span (get function :source-span)}))))))

(defn body-build-graph [core typed nodes]
  (let [effects (body-node-effects (get core :root-core-node-ids) nodes)]
    {:artifact :gravity/c8-effect-graph :module (get typed :module) :nodes nodes
     :functions (body-function-effects (get typed :function-type-table) nodes)
     :namespace {:declared (set (get (get typed :module) :effects)) :inferred effects :escaping effects :handled []}
     :build-effects :pending-policy :replay-required :pending-policy :ordering-constraints (get core :evaluation-order)
     :residual-effects :pending-legality :diagnostics [] :pending (body-effect-pending)}))

(defn body-derive-module-nodes [core facts foreign]
  (let [transfers (get core :recur-transfers)
        control? (if (if (vector? transfers) (> (count transfers) 0)
                       (if (= transfers nil) false true)) true
                   (loop [remaining (get core :nodes)]
                     (if (= 0 (count remaining)) false
                       (if (contains? #{:loop :recur} (get (first remaining) :core-form)) true
                         (recur (rest remaining))))))
        derived (if control? (body-derive-loop-nodes core facts foreign)
                  (if (contains? facts :recursive-proof)
                    (body-derive-recursive-nodes core facts foreign)
                    (body-derive-nodes-with-foreign core facts foreign)))]
    (assoc derived :recur-control? control?)))

(defn body-throw-source [form]
  {:form-id (get form :form-id) :syntax-id (get form :syntax-id)
   :semantic-span (get form :source-span) :origin-chain (get form :origin-chain)
   :generated-origin (get form :generated-origin)})

(defn body-throw-owners [core]
  (let [nodes (body-index (get core :nodes) :node-id)]
    (loop [pending (loop [ids (get core :root-core-node-ids) out []]
                     (if (= 0 (count ids)) out (recur (rest ids) (conj out {:id (first ids) :owner nil}))))
           out {}]
      (if (= 0 (count pending)) {:status :accepted :owners out}
        (let [entry (first pending) id (get entry :id) node (get nodes id) owner (get entry :owner)]
          (if (if (map? node) (= false (contains? out id)) false)
            (recur (loop [ids (get node :children) stack (vec (rest pending))]
                     (if (= 0 (count ids)) stack
                       (recur (rest ids) (conj stack {:id (first ids)
                         :owner (if (= :fn (get node :core-form)) (get (get node :source) :syntax-id) owner)}))))
                   (assoc out id owner))
            (body-failure :incoherent-throw-owner-graph)))))))

(defn body-throw-transfer-valid? [transfer node payload forms owner ordinal]
  (let [source (get node :source) form (get forms (get source :form-id)) ids (get form :child-form-ids)
        operator (get forms (get ids 0)) value (get forms (get ids 1)) attrs (get node :attributes)
        shared [:construction-order :runtime-reachability :transfer-policy :result-policy :required-effect
                :authenticated-sh06-artifact-id :sh06-semantic-projection-id :type-legality :effect-registry-legality
                :effect-profile-capability-legality :profile-error-lowering-legality :ownership-legality :safety-classification]]
    (body-all?
      [(= ordinal (get transfer :ordinal)) (= :throw (get node :core-form))
       (= (get node :node-id) (get transfer :core-node-id))
       (= source (body-throw-source form)) (= (get source :form-id) (get transfer :form-id))
       (= (get source :syntax-id) (get transfer :syntax-id)) (= :list (get form :kind))
       (vector? ids) (= 2 (count ids)) (= 2 (count (set ids)))
       (if (seq? (get form :value)) (= ['throw (get value :value)] (vec (get form :value))) false)
       (= :symbol (get operator :kind)) (= 'throw (get operator :value)) (= [] (get operator :child-form-ids))
       (= (get form :form-id) (get operator :parent-form-id) (get value :parent-form-id))
       (= (get payload :source) (body-throw-source value))
       (= [(get payload :node-id)] (get node :children) (get transfer :evaluated-children))
       (= (get payload :node-id) (get transfer :value-core-node-id)) (= [] (get node :resolved-binding-ids))
       (= :value-then-transfer (get (get node :evaluation) :kind) (get attrs :evaluation-order))
       (= [{:index 0 :core-node-id (get payload :node-id)}] (get (get node :evaluation) :order))
       (= owner (get transfer :evaluation-owner-function-syntax-id) (get (get node :evaluation) :owner-function-syntax-id))
       (= (get transfer :evaluation-region) (get (get node :evaluation) :region))
       (= [:evaluate-value :transfer-error] (get transfer :ordered-steps)) (= 0 (get attrs :value-child-index))
       (= :postorder-after-value (get attrs :construction-order)) (= :error-transfer (get attrs :transfer-policy))
       (= :never (get attrs :result-policy)) (= :error/throw (get attrs :required-effect))
       (= :not-asserted-by-sh07-b7 (get attrs :runtime-reachability))
       (= [:pending-sh08 :pending-sh09 :pending-sh09 :pending-sh09 :pending-sh10 :pending-sh11]
          [(get attrs :type-legality) (get attrs :effect-registry-legality) (get attrs :effect-profile-capability-legality)
           (get attrs :profile-error-lowering-legality) (get attrs :ownership-legality) (get attrs :safety-classification)])
       (= (body-project transfer shared) (body-project attrs shared))])))

(defn body-tc-scope-with-types [core direct facts]
  (let [nodes (body-index (get core :nodes) :node-id)
        owners (loop [remaining (get core :error-handlers) out #{}]
                 (if (= 0 (count remaining)) out
                   (recur (rest remaining) (conj out (get (first remaining) :evaluation-owner-function-syntax-id)))))
        initial (loop [remaining (keys direct) out owners]
                  (if (= 0 (count remaining)) out (recur (rest remaining) (conj out (first remaining)))))]
  (loop [scope initial next initial edges (get core :call-edges) touched owners]
    (if (= 0 (count edges))
      (if (= scope next) {:status :accepted :scope touched :active? (> (count touched) 0)}
        (recur next next (get core :call-edges) touched))
      (let [edge (first edges) caller (get edge :caller-function-syntax-id) callee (get edge :callee-function-syntax-id)
              local? (= :local-function (get edge :classification))
              intrinsic? (if (body-io-node? (get nodes (get edge :call-core-node-id)) facts core) true
                             (if (if (body-ma-node? (get nodes (get edge :call-core-node-id)) facts core) true (body-mr-node? (get nodes (get edge :call-core-node-id)) facts core)) true
                               (if (body-cq-node? (get nodes (get edge :call-core-node-id)) facts core) true
                                 (if (body-vn-node? (get nodes (get edge :call-core-node-id)) facts core) true
                                   (if (body-va-node? (get nodes (get edge :call-core-node-id)) facts core) true
                                     (if (if (if (if (if (if (if (body-lq-node? (get nodes (get edge :call-core-node-id)) facts core) true (body-lc-node? (get nodes (get edge :call-core-node-id)) facts core)) true (if (if (if (if (body-vsl-node? (get nodes (get edge :call-core-node-id)) facts core) (body-vsl-node? (get nodes (get edge :call-core-node-id)) facts core) (body-scv-node? (get nodes (get edge :call-core-node-id)) facts core)) (if (body-vsl-node? (get nodes (get edge :call-core-node-id)) facts core) (body-vsl-node? (get nodes (get edge :call-core-node-id)) facts core) (body-scv-node? (get nodes (get edge :call-core-node-id)) facts core)) (body-cqs-node? (get nodes (get edge :call-core-node-id)) facts core)) true (body-nq-node? (get nodes (get edge :call-core-node-id)) facts core)) true (body-sc-node? (get nodes (get edge :call-core-node-id)) facts core))) true (body-mg-node? (get nodes (get edge :call-core-node-id)) facts core)) true (body-mc-node? (get nodes (get edge :call-core-node-id)) facts core)) true (if (if (if (body-st-node? (get nodes (get edge :call-core-node-id)) facts core) true (if (body-ane-node? (get nodes (get edge :call-core-node-id)) facts core) true (if (if (body-chp-node? (get nodes (get edge :call-core-node-id)) facts core) true (body-nilp-node? (get nodes (get edge :call-core-node-id)) facts core)) true (if (body-boolp-node? (get nodes (get edge :call-core-node-id)) facts core) true (if (body-symp-node? (get nodes (get edge :call-core-node-id)) facts core) true (if (if (body-listp-node? (get nodes (get edge :call-core-node-id)) facts core) true (body-setp-node? (get nodes (get edge :call-core-node-id)) facts core)) true (if (body-mapp-node? (get nodes (get edge :call-core-node-id)) facts core) true (if (body-kp-node? (get nodes (get edge :call-core-node-id)) facts core) true (if (body-strp-node? (get nodes (get edge :call-core-node-id)) facts core) true (body-ip-node? (get nodes (get edge :call-core-node-id)) facts core)))))))))) true (body-vp-node? (get nodes (get edge :call-core-node-id)) facts core)) true (body-nt-node? (get nodes (get edge :call-core-node-id)) facts core))) true (body-ae-node? (get nodes (get edge :call-core-node-id)) facts core)) true
                                       (body-si-node? (get nodes (get edge :call-core-node-id)) facts core)))))))
              touches? (if (contains? scope caller) true (if local? (contains? scope callee) false))]
          (if (if touches? (if local? false (= false intrinsic?)) false) (body-failure :unsupported-throwing-call-component)
            (recur scope (if touches? (if local? (conj (conj next caller) callee) (conj next caller)) next) (rest edges)
                   (if touches? (if local? (conj (conj touched caller) callee) (conj touched caller)) touched))))))))

(defn body-tc-scope [core direct]
  (body-tc-scope-with-types core direct {}))

(defn body-throw-joins-checked [request facts]
  (let [core (get request :canonical-core-artifact) nodes (get core :nodes)
        transfers (get core :error-transfers) throwing (body-select nodes :core-form :throw)
        rows (body-select (get facts :constraint-ledger) :producer-rule :sh08-direct-typed-throw-v1)]
    (if (= 0 (count throwing))
      (if (body-all? [(if (= transfers nil) true (= [] transfers)) (= [] rows)
              (loop [functions (get facts :function-type-table)]
                (if (= 0 (count functions)) true
                  (if (if (> (count (get core :error-handlers)) 0) true (= [:pending-sh09] (get (first functions) :thrown-error-effects)))
                    (recur (rest functions)) false)))])
        (let [scoped (body-tc-scope-with-types core {} facts)
              owners (if (get scoped :active?) (body-throw-owners core)
                         {:status :accepted :owners {}})]
          (if (body-all? [(= :accepted (get scoped :status)) (= :accepted (get owners :status))])
            {:status :accepted :scope (get scoped :scope) :active? (get scoped :active?) :direct-throws {}
             :owners (get owners :owners)} scoped))
        (body-failure :incoherent-throw-census-or-summary))
      (let [source-forms (body-path request [:b47-context :authenticated-core-request :forms])
            indexed (body-index nodes :node-id) forms (body-index source-forms :form-id)
            owners (body-throw-owners core) types (get facts :type-table)]
        (if (body-all? [(= :accepted (get owners :status)) (map? indexed) (map? forms)
                (vector? transfers) (= (count throwing) (count (if (vector? transfers) transfers [])) (count rows))
                (map? (body-index transfers :core-node-id)) (map? (body-index rows :lhs))
                (= (set (keys (body-index throwing :node-id))) (set (keys (body-index transfers :core-node-id))))
                (= (body-throw-semantic-transfers core) (get (get core :identity-preimage) :error-transfers))])
          (loop [remaining transfers ordinal 0 thrown {}]
            (if (= 0 (count remaining))
              (let [scoped (body-tc-scope-with-types core thrown facts)]
                (if (= :accepted (get scoped :status))
                  (if (if (get scoped :active?) true (loop [functions (get facts :function-type-table)]
                        (if (= 0 (count functions)) true
                          (let [function (first functions) id (get function :function-id)]
                            (if (= (get function :thrown-error-effects) (get thrown id [:pending-sh09]))
                              (recur (rest functions)) false)))))
                    {:status :accepted :scope (get scoped :scope) :active? (get scoped :active?)
                     :direct-throws thrown :owners (get owners :owners)}
                    (body-failure :incoherent-function-thrown-errors))
                  scoped))
              (let [transfer (first remaining) node (get indexed (get transfer :core-node-id))
                      payload (get indexed (get transfer :value-core-node-id)) type (get types (get payload :node-id))
                      owner (get (get owners :owners) (get node :node-id)) occurring? (= false (= type :gravity.type/never))
                      premise {:version :sh08-direct-typed-throw-v1 :source-transfer transfer :source-node node
                               :payload-node payload :payload-type type :owner-function-syntax-id owner
                               :normal-transfer? occurring? :result-type :gravity.type/never}
                      expected {:constraint-id-request {:domain :gravity/sh08-direct-typed-throw-v1 :premise premise}
                                :kind :equality :producer-rule :sh08-direct-typed-throw-v1
                                :lhs (get node :node-id) :rhs :gravity.type/never :dependencies premise
                                :origin (get (get node :source) :origin-chain)
                                :invalidation [:error-transfers :throw-source :payload-source :payload-type :function-owner :evaluation-order]
                                :solution {:type :gravity.type/never :payload-type type :normal-transfer? occurring?}
                                :profile (get (get core :module) :profile) :target (get (get core :module) :target)
                                :status :solved :diagnostics []}]
                  (if (body-all? [(body-throw-transfer-valid? transfer node payload forms owner ordinal)
                          (= :gravity.type/never (get types (get node :node-id)))
                          (= false (= type nil)) (= false (= type :gravity.type/unknown))
                          (= expected (get rows ordinal))])
                    (recur (rest remaining) (+ ordinal 1)
                      (assoc thrown owner (if (if occurring? (= false (contains? (set (get thrown owner [])) type)) false)
                                            (conj (get thrown owner []) type) (get thrown owner []))))
                    (assoc (body-failure :incoherent-typed-throw-transfer) :node node)))))
          (body-failure :incoherent-throw-source-type-census))))))

(defn body-throw-joins [request facts]
  (if (body-maps? (get facts :constraint-ledger))
    (body-throw-joins-checked request facts)
    (body-failure :malformed-thrown-error-constraint-ledger)))

(defn body-tc-constraint [core edge calls nodes records bindings types functions graph]
  (let [id (get edge :call-core-node-id) node (get nodes id)
        caller (get records (get edge :caller-function-syntax-id)) callee (get records (get edge :callee-function-syntax-id))
        invoked? (body-call-invokes? node types) body (get callee :body-core-node-id)
        operand-errors (loop [ids (get node :children) out []]
                         (if (= 0 (count ids)) out (recur (rest ids) (body-error-type-union out (body-error-types graph (first ids))))))
        callee-errors (if invoked? (body-error-types graph body) [])
        argument-types (loop [ids (get edge :argument-core-node-ids) out []]
                         (if (= 0 (count ids)) out (recur (rest ids) (conj out (get types (first ids))))))
        premise {:version :sh08-acyclic-local-thrown-errors-v1 :analysis :conservative-source-error-potential
                 :invocation-guard :all-operand-types-normal :source-edge edge :source-call (get calls id)
                 :source-node node :operator-node (get nodes (first (get node :children)))
                 :caller-function caller :callee-function callee :callee-binding (get bindings (get edge :callee-binding-id))
                 :callee-normal-type (if (contains? #{:gravity.type/applied-integral-ordering :gravity.type/applied-map-association :gravity.type/applied-map-removal :gravity.type/applied-collection-count :gravity.type/applied-vector-nth :gravity.type/applied-vector-get :gravity.type/applied-bounded-successor :gravity.type/applied-bounded-unit-addition :gravity.type/applied-vector-append :gravity.type/applied-list-prepend :gravity.type/applied-string-set-insertion :gravity.type/applied-keyword-set-insertion :gravity.type/applied-symbol-set-insertion :gravity.type/applied-atomic-equality :gravity.type/applied-vector-equality :gravity.type/applied-list-equality :gravity.type/applied-integral-equality :gravity.type/applied-not :gravity.type/applied-vector-predicate :gravity.type/applied-integer-predicate :gravity.type/applied-set-conversion :gravity.type/applied-list-set-conversion :gravity.type/applied-map-contains :gravity.type/applied-map-get :gravity.type/applied-string-concat :gravity.type/applied-nonnegative-integer-quotient :gravity.type/applied-vector-slice :gravity.type/applied-string-character-vector :gravity.type/applied-count-quotient-scaling :gravity.type/applied-list-construction :gravity.type/applied-list-query :gravity.type/applied-map-predicate  :gravity.type/applied-keyword-predicate :gravity.type/applied-string-predicate :gravity.type/applied-keyword-set-equality :gravity.type/applied-bare-keyword-anchor-set-equality :gravity.type/applied-string-set-equality  :gravity.type/applied-keyword-set-contains  :gravity.type/applied-set-predicate :gravity.type/applied-list-predicate :gravity.type/applied-symbol-predicate :gravity.type/applied-boolean-predicate :gravity.type/applied-nil-predicate :gravity.type/applied-character-predicate :gravity.type/applied-atomic-inequality :gravity.type/applied-character-set-contains :gravity.type/applied-string-set-contains :gravity.type/applied-symbol-set-contains :gravity.type/applied-integer-set-contains :gravity.type/applied-vector-first :gravity.type/applied-vector-empty :gravity.type/applied-vector-rest :gravity.type/applied-map-keys :gravity.type/applied-private-map-keys}
                                                    (get (get types (first (get node :children))) :kind))
                   (get types (first (get node :children)))
                   (body-project (get functions (get edge :callee-function-syntax-id)) [:parameters :return :fixed-arity :signature :latent-effects]))
                 :operand-types argument-types :callee-source-body-id body :normal-invocation? invoked?
                 :operand-error-types operand-errors :callee-error-types callee-errors
                 :error-types (body-error-type-union operand-errors callee-errors)}]
    {:constraint-id-request {:domain :gravity/sh08-acyclic-local-thrown-errors-v1 :premise premise}
     :kind :equality :producer-rule :sh08-acyclic-local-thrown-errors-v1
     :lhs {:core-node-id id :projection :thrown-error-effects} :rhs (get premise :error-types)
     :origin (get (get node :source) :origin-chain) :dependencies premise
     :solution {:thrown-error-effects (get premise :error-types) :normal-result-type (get types id)}
     :invalidation [:call-edges :calls :binding-table :function-records :callee-body :type-table :error-transfers :evaluation-order]
     :profile (get (get core :module) :profile) :target (get (get core :module) :target) :status :solved :diagnostics []}))

; C8 owns these recursive error equations. C7 supplies only checked VALUE
; types and authentic direct-throw transfers; it has no recursive error rows.
(defn body-ds-error-equations [core facts bindings graph]
  (let [proof (get facts :recursive-proof) types (get facts :type-table)
        nodes (body-index (get core :nodes) :node-id)
        calls (body-index (get core :calls) :core-node-id)
        records (body-index (get core :function-records) :function-syntax-id)]
    (if (if (body-recursive-proof-valid? core facts)
          (= [] (body-select (get facts :constraint-ledger) :producer-rule :sh08-acyclic-local-thrown-errors-v1)) false)
      (loop [remaining (get core :call-edges) rows []]
        (if (= 0 (count remaining))
          (loop [functions (get facts :function-type-table) out {}]
            (if (= 0 (count functions))
              {:status :accepted :functions out :rows rows}
              (let [function (first functions) id (get function :function-id)
                    errors (body-error-types graph (get function :body-core-node-id))]
                (if (= [:pending-sh09] (get function :thrown-error-effects))
                  (recur (rest functions) (assoc out id errors))
                  (body-failure :recursive-errors-not-pending-at-c7-boundary)))))
          (let [edge (first remaining) id (get edge :call-core-node-id) node (get nodes id)
                  target (get (get records (get edge :callee-function-syntax-id)) :body-core-node-id)
                  invoked? (body-call-invokes? node types)
                  operands (loop [ids (get node :children) out []]
                             (if (= 0 (count ids)) out
                               (recur (rest ids) (body-error-type-union out (body-error-types graph (first ids))))))
                  callee (if (if invoked? (= false (= target nil)) false) (body-error-types graph target) [])
                  errors (body-error-type-union operands callee)
                  premise {:version (if (body-is? facts) :sh09-private-self-error-equation-v1 :sh09-declared-self-error-equation-v1)
                           :analysis :conservative-source-error-potential
                           :recursive-proof-domain (get proof :domain)
                           :source-node node :source-call (get calls id) :source-edge edge
                           :callee-source-body-id target :normal-invocation? invoked?
                           :invocation-guard :all-operand-types-normal
                           :operand-error-types operands :callee-error-types callee
                           :escaping-error-types errors :normal-result-type (get types id)}
                  ]
            (if (= errors (body-error-types graph id))
              (recur (rest remaining)
                (conj rows {:producer-rule (get premise :version)
                            :dependencies premise :solution {:escaping-error-types errors}
                            :status :solved :diagnostics []}))
              (body-failure :incoherent-recursive-call-error-equation)))))
      (body-failure :untrusted-recursive-error-premises))))

(defn body-tc-verify [core facts bindings graph joined]
  (if (body-rv? facts)
    (body-ds-error-equations core facts bindings graph)
    (let [actual (body-select (get facts :constraint-ledger) :producer-rule
                              :sh08-acyclic-local-thrown-errors-v1)
          scope (get joined :scope #{})
          nodes (body-index (get core :nodes) :node-id)
          records (body-index (get core :function-records) :function-syntax-id)
          calls (body-index (get core :calls) :core-node-id)
          functions (body-index (get facts :function-type-table) :function-id)]
      (if (= true (get joined :active?))
        (if (body-all?
              [(loop [remaining (get core :nodes)]
                 (if (= 0 (count remaining))
                   true
                   (let [node (first remaining)
                         owner (get (get joined :owners) (get node :node-id))]
                     (if (if (contains? scope owner)
                           ; Loop joins and effect equations precede this check.
                           ; Typed errors retain the C7 lexical-child source union.
                           (contains? #{:literal :quote :reference :fn :def :do :if :let
                                        :match :loop :recur :collection-literal
                                        :keyword-map-lookup :throw :call :try}
                                      (get node :core-form))
                           true)
                       (recur (rest remaining))
                       false))))
               (loop [remaining (get core :recursion-components)]
                 (if (= 0 (count remaining))
                   true
                   (if (loop [ids (get (first remaining) :function-syntax-ids)]
                         (if (= 0 (count ids))
                           false
                           (if (contains? scope (first ids))
                             true
                             (recur (rest ids)))))
                     false
                     (recur (rest remaining)))))])
          (let [derived
                (loop [remaining (get core :call-edges) rows []]
                  (if (= 0 (count remaining))
                    {:status :accepted :rows rows}
                    (let [edge (first remaining)
                          id (get edge :call-core-node-id)]
                      (if (contains? scope (get edge :caller-function-syntax-id))
                        (let [row (body-tc-constraint core edge calls nodes records bindings
                                                      (get facts :type-table) functions graph)]
                          (if (= (get row :rhs) (body-error-types graph id))
                            (recur (rest remaining) (conj rows row))
                            (body-failure :incoherent-call-body-error-equation)))
                        (recur (rest remaining) rows)))))
                summaries
                (loop [remaining (get core :function-records) out {}]
                  (if (= 0 (count remaining))
                    {:status :accepted :functions out}
                    (let [record (first remaining)
                          id (get record :function-syntax-id)
                          function (get functions id)
                          errors (if (contains? scope id)
                                   (body-error-types graph (get record :body-core-node-id))
                                   (get (get joined :direct-throws) id [:pending-sh09]))
                          normal-types
                          (loop [parameters (get function :parameters) out []]
                            (if (= 0 (count parameters))
                              (conj out (get function :return))
                              (recur (rest parameters)
                                     (conj out (get (first parameters) :type)))))]
                      (if (if (= (get function :thrown-error-effects) errors)
                            (if (contains? scope id)
                              (loop [types normal-types]
                                (if (= 0 (count types))
                                  true
                                  (if (contains? #{nil :gravity.type/unknown} (first types))
                                    false
                                    (recur (rest types)))))
                              true)
                            false)
                        (recur (rest remaining)
                               (if (contains? scope id) (assoc out id errors) out))
                        (body-failure :incoherent-propagated-function-errors)))))]
            (if (body-all? [(= :accepted (get derived :status))
                            (= actual (get derived :rows))
                            (= :accepted (get summaries :status))])
              summaries
              (body-failure :incoherent-call-error-propagation-ledger)))
          (body-failure :unsupported-throwing-call-component))
        (if (= [] actual)
          {:status :accepted :functions {}}
          (body-failure :unexpected-call-error-propagation-ledger))))))

(defn body-allowance-check [core facts graph]
  (let [nodes (get graph :nodes)
        indexed (body-index (get core :nodes) :node-id)
        functions (body-index (get facts :function-type-table) :function-id)]
    (loop [functions-left (get core :function-records)]
      (if (= 0 (count functions-left))
        (loop [remaining (get core :nodes)]
          (if (= 0 (count remaining))
            {:status :accepted}
            (let [node (first remaining)
                  effects (get (get nodes (get node :node-id)) :direct)
                  missing (loop [labels (vec effects)]
                            (if (= 0 (count labels))
                              nil
                              (if (contains? (set (get (get facts :module) :effects))
                                             (first labels))
                                (recur (rest labels))
                                (first labels))))]
              (if (= missing nil)
                (recur (rest remaining))
                {:status :rejected :rule "C8-UNDECLARED"
                 :reason :namespace-effect-outside-source-allowance
                 :node node :effect missing}))))
        (let [function (get functions (get (first functions-left) :function-syntax-id))
              effects (get (get graph :functions) (get function :function-id))
              missing (loop [labels (vec (get effects :inferred))]
                        (if (= 0 (count labels))
                          nil
                          (if (contains? (get effects :declared) (first labels))
                            (recur (rest labels))
                            (first labels))))]
          (if (= missing nil)
            (recur (rest functions-left))
            {:status :rejected :rule "C8-UNDECLARED"
             :reason :function-effect-outside-source-allowance
             :node (get indexed (get function :function-core-node-id))
             :function (get function :function-id) :effect missing}))))))

; Effect analysis is semantic composition. It does not admit or reserve
; compiler work units. Each stage returns its own semantic evidence.
(defn body-analyze-module [request facts foreign]
  (let [base-core (get request :canonical-core-artifact)
        source-forms (body-path request [:b47-context :authenticated-core-request :forms])
        bindings (body-index (body-path request [:b47-context :authenticated-core-request :binding-table])
                             :binding-id)]
    (if (body-shape-valid? base-core facts)
      (let [private (body-is-context base-core facts bindings source-forms)
            core (assoc base-core :sh08-private-self-parameter-premise
                        (if (= :accepted (get private :status))
                          (get private :parameter-value-premise)
                          nil))
            request (assoc request :canonical-core-artifact core)
            associations (if (= :accepted (get private :status))
                           (body-ma-context request facts bindings)
                           private)
            appends (if (= :accepted (get associations :status))
                      (body-va-context request facts bindings)
                      associations)
            equalities (if (= :accepted (get appends :status))
                         (body-ae-context request facts bindings)
                         appends)
            legacy (if (= :accepted (get equalities :status))
                     (body-nt-context request facts bindings)
                     equalities)
            classification (if (= :accepted (get legacy :status))
                           (body-vp-context request facts bindings)
                           legacy)
            integers (if (= :accepted (get classification :status))
                       (body-ip-context request facts bindings)
                       classification)
            sets (if (= :accepted (get integers :status))
                   (body-st-context request facts bindings)
                   integers)
            maps (if (= :accepted (get sets :status))
                   (body-mapp-context request facts bindings)
                   sets)
            keywords (if (= :accepted (get maps :status))
                       (body-kp-context request facts bindings)
                       maps)
            strings (if (= :accepted (get keywords :status))
                      (body-strp-context request facts bindings)
                      keywords)
            list-classification (if (= :accepted (get strings :status))
                                  (body-listp-context request facts bindings)
                                  strings)
            set-classification (if (= :accepted (get list-classification :status))
                                 (body-setp-context request facts bindings)
                                 list-classification)
            symbol-classification (if (= :accepted (get set-classification :status))
                                    (body-symp-context request facts bindings)
                                    set-classification)
            boolean-classification (if (= :accepted (get symbol-classification :status))
                                     (body-boolp-context request facts bindings)
                                     symbol-classification)
            nil-classification (if (= :accepted (get boolean-classification :status))
                                 (body-nilp-context request facts bindings)
                                 boolean-classification)
            characters (if (= :accepted (get nil-classification :status))
                         (body-chp-context request facts bindings)
                         nil-classification)
            atomic-inequalities (if (= :accepted (get characters :status))
                                  (body-ane-context request facts bindings)
                                  characters)
            negations (if (= :accepted (get atomic-inequalities :status))
                        (assoc legacy
                          :vector-predicate-context (get classification :context)
                          :integer-predicate-context (get integers :context)
                          :set-conversion-context (get sets :context)
                          :map-predicate-context (get maps :context)
                          :keyword-predicate-context (get keywords :context)
                          :string-predicate-context (get strings :context)
                          :list-predicate-context (get list-classification :context)
                          :set-predicate-context (get set-classification :context)
                          :symbol-predicate-context (get symbol-classification :context)
                          :boolean-predicate-context (get boolean-classification :context)
                          :nil-predicate-context (get nil-classification :context)
                          :character-predicate-context (get characters :context)
                          :atomic-inequality-context (get atomic-inequalities :context))
                        atomic-inequalities)
            memberships (if (= :accepted (get negations :status))
                          (body-mc-context request facts bindings)
                          negations)
            lookups (if (= :accepted (get memberships :status))
                      (body-mg-context request facts bindings)
                      memberships)
            concatenations (if (= :accepted (get lookups :status))
                             (body-sc-context request facts bindings)
                             lookups)
            lists (if (= :accepted (get concatenations :status))
                    (body-lc-context request facts bindings)
                    concatenations)
            queries (if (= :accepted (get lists :status))
                      (body-lq-context request facts bindings)
                      lists)
            parameters (if (= :accepted (get queries :status))
                         (body-lp-context request facts bindings)
                         queries)
            counts (if (= :accepted (get parameters :status))
                     (body-cq-context request facts bindings)
                     parameters)
            selections (if (= :accepted (get counts :status))
                         (body-vn-context request facts bindings)
                         counts)
            successors (if (= :accepted (get selections :status))
                         (body-si-context request facts bindings)
                         selections)
            removals (if (= :accepted (get successors :status))
                       (body-mr-context request facts bindings)
                       successors)
            returns (if (= :accepted (get removals :status))
                      (body-lr-context core facts bindings source-forms)
                      removals)
            joins (if (= :accepted (get returns :status))
                    (body-ij-context core facts bindings source-forms)
                    returns)
            quotients (if (= :accepted (get joins :status))
                        (body-nq-context request facts bindings)
                        joins)
            facts (assoc facts
                    :quotient-context (get quotients :context)
                    :removal-context (get removals :context)
                    :if-join-context (get joins :context)
                    :return-context (get returns :context)
                    :association-context (get associations :context)
                    :count-context (get counts :context)
                    :append-context (get appends :context)
                    :equality-context (get equalities :context)
                    :list-parameter-context (get parameters :context)
                    :list-query-context (get queries :context)
                    :list-construction-context (get lists :context)
                    :string-concat-context (get concatenations :context)
                    :map-get-context (get lookups :context)
                    :map-contains-context (get memberships :context)
                    :not-context (get negations :context)
                    :vector-predicate-context (get negations :vector-predicate-context)
                    :integer-predicate-context (get negations :integer-predicate-context)
                    :string-predicate-context (get negations :string-predicate-context)
                    :keyword-predicate-context (get negations :keyword-predicate-context)
                    :map-predicate-context (get negations :map-predicate-context)
                    :list-predicate-context (get negations :list-predicate-context)
                    :set-predicate-context (get negations :set-predicate-context)
                    :symbol-predicate-context (get negations :symbol-predicate-context)
                    :boolean-predicate-context (get negations :boolean-predicate-context)
                    :nil-predicate-context (get negations :nil-predicate-context)
                    :character-predicate-context (get negations :character-predicate-context)
                    :atomic-inequality-context (get negations :atomic-inequality-context)
                    :set-conversion-context (get negations :set-conversion-context)
                    :vector-nth-context (get selections :context)
                    :successor-context (get successors :context))]
        (if (= :accepted (get quotients :status))
          (if (if (if (contains? facts :higher-order-proof)
                   (body-ho-proof-valid? core facts bindings)
                   true)
                (if (body-function-joins-valid? core facts bindings)
                  (if (body-call-joins-with-foreign-valid? core facts bindings foreign)
                    (body-local-joins-valid? core facts bindings)
                    false)
                  false)
                false)
            (let [handlers (body-eh-source-products core source-forms
                                                    (body-path request [:b47-context :authenticated-core-request
                                                                        :binding-table]))
                  facts (assoc facts :atomic-typed-handlers (get handlers :groups {}))
                  throws (if (= :accepted (get handlers :status))
                           (body-throw-joins request facts)
                           handlers)
                  derived (if (= :accepted (get throws :status))
                            (body-derive-module-nodes core facts foreign)
                            throws)
                  loop? (get derived :recur-control?)]
              (if (= :accepted (get derived :status))
                (let [handler-check (body-eh-verify request core facts
                                                   (get handlers :groups)
                                                   (get derived :nodes))
                      propagated (if (= :accepted (get handler-check :status))
                                   (body-tc-verify core facts bindings
                                                   (get derived :nodes) throws)
                                   handler-check)
                      graph (let [graph (body-build-graph core facts (get derived :nodes))
                                  graph (if loop?
                                          (assoc graph :loop-fixed-point
                                            {:algorithm :bottom-initialized-bounded-effect-union
                                             :round-count (get derived :fixed-point-rounds)
                                             :equations :checked
                                             :recur-transfers (get core :recur-transfers)})
                                          graph)]
                              (if (contains? facts :recursive-proof)
                                (assoc graph :recursive-fixed-point
                                  {:algorithm (if (body-rv? facts)
                                                :bottom-initialized-bounded-effect-and-error-union
                                                :bottom-initialized-bounded-effect-union)
                                   :round-count (get derived :fixed-point-rounds)
                                   :equations :checked
                                   :recursive-call-core-node-id
                                   (if (body-rv? facts)
                                     (get (get facts :recursive-proof) :self-call-core-node-id)
                                     (get (get facts :recursive-proof)
                                          :recursive-call-core-node-id))})
                                graph))
                      graph (if (body-rv? facts)
                              (assoc graph
                                :recursive-source-error-equations (get propagated :rows)
                                :recursive-source-handler-equations
                                (get handler-check :checked-handler-equations []))
                              graph)
                      graph (loop [ids (keys (get propagated :functions)) out graph]
                              (if (= 0 (count ids))
                                out
                                (recur (rest ids)
                                  (assoc out :functions
                                    (assoc (get out :functions) (first ids)
                                      (assoc (get (get out :functions) (first ids))
                                        :throws
                                        (get (get propagated :functions) (first ids))))))))
                      allowed (if (= :accepted (get propagated :status))
                                (body-allowance-check core facts graph)
                                propagated)]
                  (if (= :accepted (get allowed :status))
                    {:status :accepted :graph graph}
                    allowed))
                derived))
            (body-failure :incoherent-function-or-call-body-type-origin-join))
          quotients))
      (body-failure :incomplete-canonical-core-coverage))))
(defn body-analyze-producers [entries]
  (loop [remaining entries bank {}]
    (if (= 0 (count remaining))
      {:status :accepted :bank bank}
      (let [entry (first remaining)
            key (get entry :module-key)
            checked (body-lsi-first-data-valid? key)]
        (if (= :accepted (get checked :status))
          (let [analyzed (body-analyze-module (get entry :request) (get entry :facts) {})]
            (if (= :accepted (get analyzed :status))
              (recur (rest remaining)
                     (assoc bank key (assoc entry :graph (get analyzed :graph))))
              (assoc analyzed :producer-module key
                     :producer-facts (get entry :facts))))
          {:status :rejected :reason :untrusted-or-transitive-body-producer})))))

(defn body-foreign-bindings [request facts bank]
  (let [bindings (body-index (body-path request [:b47-context :authenticated-core-request :binding-table]) :binding-id)]
    (loop [remaining (get facts :imported-function-types) foreign {} used #{}]
      (if (= 0 (count remaining))
        (if (= (count used) (count bank)) {:status :accepted :foreign foreign}
          (body-failure :unused-body-producer))
        (let [proof (first remaining) id (get proof :binding-id)
              key [(get proof :producer-sh06-artifact-id) (get proof :producer-sh07-artifact-id)]
              entry (get bank key) joined (body-import-origin request (get bindings id) entry proof)
              summary (get (get (get entry :graph) :functions) (get (get proof :function-type) :function-id))]
          (if (if (contains? foreign id) false (body-all? [(map? joined) (map? summary)
                 (= (get joined :body-core-node-id) (get summary :body-core-node-id))
                 (= (get (get joined :function) :function-id) (get summary :function-id))
                 (set? (get summary :inferred)) (= [:pending-sh09] (get summary :throws))]))
            (recur (rest remaining) (assoc foreign id (assoc joined :summary summary)) (conj used key))
            (body-failure :imported-body-origin-or-summary-mismatch)))))))

(defn body-producer-graph-identities [bank]
  (loop [keys (keys bank) result {}]
    (if (= 0 (count keys)) result
      (let [key (first keys) entry (get bank key)]
        (recur (rest keys)
          (assoc result key {:canonical-core-identity-input (body-path entry [:request :canonical-core-artifact :identity-preimage])
                             :sh08-identity-input (get entry :facts) :effect-graph (get entry :graph)}))))))

(defn body-accepted-result [typed binding core graph bank foreign]
  (let [imported? (body-imported? typed)
        scope (if imported? :direct-imported-body-effects-with-thrown-effects-pending
                (if (body-higher-order? typed) :capture-free-one-hop-body-effects-with-thrown-effects-pending
                  (if (body-recursive? typed) :bounded-self-recursive-body-effects-with-thrown-effects-pending
                    :local-first-order-body-effects-with-thrown-effects-pending)))
        producer-graphs (body-producer-graph-identities bank)
        dependencies (loop [ids (keys foreign) result {}]
                       (if (= 0 (count ids)) result
                         (let [id (first ids) target (get foreign id)]
                           (recur (rest ids) (assoc result id (assoc (get target :coordinate) :body-core-node-id (get target :body-core-node-id)))))))
        identity {:domain (if imported? :gravity/sh09-direct-imported-body-effects-v1
                            (if (body-higher-order? typed) :gravity/sh09-capture-free-one-hop-body-effects-v1
                              (if (body-recursive? typed) :gravity/sh09-bounded-self-recursive-body-effects-v1 :gravity/sh09-local-body-effects-v1)))
                  :canonical-core-identity-input (get core :identity-preimage)
                  :sh08-identity-input (get typed :identity-input) :effect-graph graph :scope scope :pending (body-effect-pending)}
        identity (if imported? (assoc identity :producer-effect-graphs producer-graphs :imported-body-dependencies dependencies) identity)
        result {:artifact :gravity/sh09-authenticated-effected-core-template :schema-version 1 :status :accepted
                :scope scope :authentication-status :host-resolved-sh08-function-binding
                :upstream-binding (body-project binding [:artifact :schema-version :boundary :status])
                :sh08-shaped-artifact-id (get typed :sh07-shaped-artifact-id) :module (get typed :module)
                :typed-core (get typed :typed-core) :type-table (get typed :type-table)
                :function-type-table (get typed :function-type-table) :local-binding-facts (get typed :local-binding-facts)
                :call-type-facts (get typed :call-type-facts) :effect-graph graph :identity-input identity
                :identity-resolution :coordinator-digest-required :diagnostics [] :pending (body-effect-pending)
                :provenance (get typed :provenance) :self-hosted? false :clojure-seed-boundary? true}]
    (if imported? (assoc result :producer-effect-graphs producer-graphs :imported-body-dependencies dependencies) result)))

(defn build-body-effect-result [typed verification binding]
  (if (body-input-valid? typed verification binding)
    (let [request (body-path binding [:digest-resolution :preimage :request])
          core (get request :canonical-core-artifact) facts (get typed :identity-input)
          producers (body-producer-entries request facts)]
      (if (= :accepted (get producers :status))
        (let [derived (body-analyze-producers (get producers :entries))]
          (if (= :accepted (get derived :status))
            (let [imports (body-foreign-bindings request facts (get derived :bank))]
              (if (= :accepted (get imports :status))
                (let [caller (body-analyze-module request facts (get imports :foreign))]
                  (if (= :accepted (get caller :status))
                    (body-accepted-result typed binding core (get caller :graph) (get derived :bank) (get imports :foreign))
                    (body-error-result typed caller)))
                (body-error typed (get imports :reason) {})))
            (assoc (body-error-result (get derived :producer-facts typed) derived)
                   :producer-module (get derived :producer-module))))
        (body-error typed (get producers :reason) {})))
    (body-error typed (if (body-imported? typed) :imported-body-effects-pending :untrusted-sh08-body-effect-input) {})))

(defn verify-body-effect-result [typed verification binding candidate]
  (let [expected (build-body-effect-result typed verification binding)]
    {:artifact :gravity/sh09-authenticated-body-effect-result-verification
     :status (if (= expected candidate) :passed :rejected)
     :checks [:fresh-sh08-binding :complete-canonical-node-coverage :local-call-body-propagation
              :construction-versus-latent-effects :conditional-guard-coverage :exact-derived-graph
              :preserved-declarations-and-pending-throws :whole-core-and-graph-identity]
     :expected expected :candidate candidate}))

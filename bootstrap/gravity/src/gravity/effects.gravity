                 (recur (+ i 1)) false))))
         (= (body-nq-call-fact descriptor (get core :module)) (body-nq-one (get facts :call-type-facts) :call-core-node-id (get node :node-id)))
         (let [dividend (get (get validation :proof) :dividend)]

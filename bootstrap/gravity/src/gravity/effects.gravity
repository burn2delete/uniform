  {:constraint-id-request {:domain :gravity/sh08-collection-count-constraint-v1 :application descriptor}
   :kind :equality :producer-rule :sh08-collection-count-v1
   :lhs {:core-node-id (get descriptor :call-core-node-id) :projection :collection-cardinality}

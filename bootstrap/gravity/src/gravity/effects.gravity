                    (= (get descriptor :result-type) (get (get facts :type-table) (get node :node-id)))
                    (body-bka-forms? node call nodes (get (get facts :equality-context) :forms))])) false)))

(defn body-kse-constraint [descriptor]
  (if (if (keyword? (get descriptor :kind)) (= :gravity.type/applied-bare-keyword-anchor-set-equality (get descriptor :kind)) false)

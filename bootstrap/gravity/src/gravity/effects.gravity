       :invalidation [:calls :call-edges :binding-table :source-forms :type-table :lexical-bindings :definitions :function-records
                      :callee-body :membership-domain :member-value-policy :profile :target :evaluation-order]}
          :kind :gravity.type/applied-character-set-contains :version :sh08-character-set-contains-v1
          :intrinsic :gravity.collections/character-set-membership :membership-policy {:input :finite-persistent-character-set :members :character-only :needle :character-only

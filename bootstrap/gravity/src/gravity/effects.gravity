(defn body-cq-call-fact [descriptor module]
  (let [source (get descriptor :source) edge (get descriptor :source-edge)]
    {:artifact :gravity/c7-call-type-fact
     :fact-id-request {:domain :gravity/sh08-collection-count-call-type-fact-v1 :application descriptor}

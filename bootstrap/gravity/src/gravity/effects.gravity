(defn body-ane-constraint [descriptor]
  (if (= :sh08-string-set-carrier-inequality-v1 (get descriptor :version))
    {:constraint-id-request {:domain :gravity/sh08-string-set-carrier-inequality-constraint-v1 :application descriptor}
   :kind :equality :producer-rule :sh08-string-set-carrier-inequality-v1
   :lhs {:core-node-id (get descriptor :call-core-node-id) :projection :string-set-carrier-inequality}
   :rhs (get descriptor :result-type) :dependencies descriptor :origin (get (get descriptor :source) :origin-chain)
   :solution {:result-type (get descriptor :result-type) :application (get descriptor :application)
              :direct-effects (get descriptor :direct-effects)
              :inequality-policy (get descriptor :inequality-policy) :string-set-equality (get descriptor :string-set-equality)}
   :invalidation (get descriptor :invalidation) :profile (get descriptor :profile) :target (get descriptor :target)
   :status :solved :diagnostics []}
  {:constraint-id-request {:domain :gravity/sh08-atomic-inequality-constraint-v1 :application descriptor}
   :kind :equality :producer-rule :sh08-atomic-inequality-v1
   :lhs {:core-node-id (get descriptor :call-core-node-id) :projection :atomic-inequality}
   :rhs (get descriptor :result-type) :dependencies descriptor :origin (get (get descriptor :source) :origin-chain)
   :solution (let [solution {:result-type (get descriptor :result-type) :application (get descriptor :application)
              :direct-effects (get descriptor :direct-effects)
              }]
                (if (contains? descriptor :list-equality)
                  (assoc solution :list-equality (get descriptor :list-equality) :inequality-policy (get descriptor :inequality-policy))
                  (if (contains? descriptor :numeric-equality)
                  (assoc solution :numeric-equality (get descriptor :numeric-equality))
                  (if (contains? descriptor :vector-equality)
                    (assoc solution :vector-equality (get descriptor :vector-equality))
                    (if (contains? descriptor :string-set-equality)
                      (assoc solution :string-set-equality (get descriptor :string-set-equality))
                      (if (contains? descriptor :keyword-set-equality)
                      (assoc solution :keyword-set-equality (get descriptor :keyword-set-equality)) solution))))))
   :invalidation (get descriptor :invalidation) :profile (get descriptor :profile) :target (get descriptor :target)
   :status :solved :diagnostics []}))

(defn body-ane-call-fact [descriptor module]
  (if (= :sh08-string-set-carrier-inequality-v1 (get descriptor :version))
    (let [source (get descriptor :source) edge (get descriptor :source-edge)]
      {:artifact :gravity/c7-call-type-fact
     :fact-id-request {:domain :gravity/sh08-string-set-carrier-inequality-call-type-fact-v1 :application descriptor}
     :call-core-node-id (get descriptor :call-core-node-id) :caller-function-syntax-id (get edge :caller-function-syntax-id)
     :callee-function-syntax-id nil :argument-types (get descriptor :argument-types) :result-type (get descriptor :result-type)
     :evaluation-order :operator-then-arguments :source-span (get source :semantic-span) :syntax-id (get source :syntax-id)
     :origin-chain (get source :origin-chain) :generated-origin (get source :generated-origin)
     :profile (get module :profile) :target (get module :target) :effects (get descriptor :direct-effects) :capabilities [] :status :inferred
     :dispatch :direct-atomic-inequality :applied-atomic-inequality descriptor :effect-facts-source :audited-string-set-carrier-inequality-intrinsic})
  (let [source (get descriptor :source) edge (get descriptor :source-edge)]
    {:artifact :gravity/c7-call-type-fact
     :fact-id-request {:domain :gravity/sh08-atomic-inequality-call-type-fact-v1 :application descriptor}
     :call-core-node-id (get descriptor :call-core-node-id) :caller-function-syntax-id (get edge :caller-function-syntax-id)
     :callee-function-syntax-id nil :argument-types (get descriptor :argument-types) :result-type (get descriptor :result-type)
     :evaluation-order :operator-then-arguments :source-span (get source :semantic-span) :syntax-id (get source :syntax-id)
     :origin-chain (get source :origin-chain) :generated-origin (get source :generated-origin)
     :profile (get module :profile) :target (get module :target) :effects (get descriptor :direct-effects) :capabilities [] :status :inferred

     :dispatch :direct-atomic-inequality :applied-atomic-inequality descriptor :effect-facts-source (if (contains? descriptor :list-equality) :audited-list-inequality-intrinsic
       (if (contains? descriptor :vector-equality) :audited-vector-inequality-intrinsic
       (if (contains? descriptor :string-set-equality) :audited-string-set-inequality-intrinsic
         (if (contains? descriptor :keyword-set-equality) :audited-keyword-set-inequality-intrinsic :audited-atomic-inequality-intrinsic))))})))

(defn body-ane-finish [header]
  (body-normal-or-never-result-finish header))

(defn body-ane-core-identities? [core calls]
  (if (loop [remaining calls]
        (if (= 0 (count remaining))
          true
          (if (body-sse-ids? [(get (first remaining) :core-node-id)] 1)
            (recur (rest remaining))
            false)))
    (if (loop [remaining (get core :nodes)]
          (if (= 0 (count remaining))
            true
            (if (body-sse-ids? [(get (first remaining) :node-id)] 1)
              (recur (rest remaining))
              false)))
      (loop [remaining (get core :call-edges)]
        (if (= 0 (count remaining))
          true
          (if (body-sse-ids? [(get (first remaining) :call-core-node-id)] 1)
            (recur (rest remaining))
            false)))
      false)
    false))

(defn body-ane-forms-valid? [forms]
  (if (vector? forms)
    (loop [remaining forms]
      (if (= 0 (count remaining))
        true
        (if (body-sse-ids? [(get (first remaining) :form-id)] 1)
          (recur (rest remaining))
          false)))
    false))

(defn body-ane-selected-loop [selected forms facts bindings core]
  (let [nodes (body-index (get core :nodes) :node-id)
        form-index (body-index forms :form-id)
        call-index (body-index (get core :calls) :core-node-id)
        edge-index (body-index (get core :call-edges) :call-core-node-id)]
    (loop [remaining selected checks {}]
      (if (= 0 (count remaining))
        {:status :accepted
         :context {:forms form-index
                   :nodes nodes
                   :calls call-index
                   :edges edge-index
                   :bindings bindings
                   :checks checks}}
        (let [call (first remaining)
              node (get nodes (get call :core-node-id))]
          (if (body-sse-call-ids? node call)
            (let [arguments (loop [ids (get call :argument-node-ids) out []]
                              (if (= 0 (count ids))
                                out
                                (let [id (first ids)
                                      type (if (body-sse-ids? [id] 1)
                                             (get (get facts :type-table) id :gravity.type/unknown)
                                             :gravity.type/unknown)]
                                  (recur (rest ids) (conj out type)))))
                  validation (body-ane-type-check arguments)]
              (if (= :accepted (get validation :status))
                (let [next-checks (assoc checks (get call :core-node-id)
                                         {:argument-types arguments :validation validation})]
                  (recur (rest remaining) next-checks))
                (body-failure :body-atomic-inequality-operand-type-required)))
            (body-failure :body-atomic-inequality-arity-mismatch)))))))

(defn body-ane-selected-context [selected request facts bindings core]
  (let [forms (body-path request [:b47-context :authenticated-core-request :forms])]
    (if (body-ane-forms-valid? forms)
      (body-ane-selected-loop selected forms facts bindings core)
      (body-failure :body-atomic-inequality-source-forms-required))))

(defn body-ane-context [request facts bindings]
  (let [core (get request :canonical-core-artifact)
        calls (get core :calls)
        forms (body-path request [:b47-context :authenticated-core-request :forms])]
    (if (= false (body-all? [(vector? calls)
                             (vector? (get core :nodes))
                             (vector? (get core :call-edges))]))
      (body-failure :body-atomic-inequality-families-required)
      (if (body-ane-core-identities? core calls)
        (let [selected (loop [remaining calls out []]
                         (if (= 0 (count remaining))
                           out
                           (let [call (first remaining)
                                 binding-id (get call :operator-binding-id)
                                 binding-valid? (if (= nil binding-id)
                                                  true
                                                  (body-sse-ids? [binding-id] 1))]
                             (if binding-valid?
                               (let [binding (if (body-sse-ids? [binding-id] 1)
                                               (get bindings binding-id)
                                               nil)
                                     candidate? (body-ane-binding? binding (get core :module))]
                                 (recur (rest remaining)
                                        (if candidate? (conj out call) out)))
                               nil))))]
          (if (= nil selected)
            (body-failure :body-atomic-inequality-source-identities-required)
            (if (= 0 (count selected))
              {:status :accepted :context nil}
              (body-ane-selected-context selected request facts bindings core))))
        (body-failure :body-atomic-inequality-source-identities-required)))))

(defn body-ane-call-valid? [core facts bindings node call edge nodes]
  (if (if (vector? (get call :argument-node-ids)) (if (= 2 (count (get call :argument-node-ids))) (if (vector? (get node :children)) (= 3 (count (get node :children))) false) false) false)
(if (loop [remaining (conj (conj (conj (conj (conj (get call :argument-node-ids) (get call :operator-node-id)) (get call :operator-binding-id)) (get node :node-id)) (get (get node :source) :form-id)) (get (get node :source) :syntax-id))] (if (= 0 (count remaining)) (loop [remaining (get node :children)] (if (= 0 (count remaining)) true (if (if (keyword? (first remaining)) true (if (string? (first remaining)) (= 71 (count (first remaining))) false)) (recur (rest remaining)) false))) (if (if (keyword? (first remaining)) true (if (string? (first remaining)) (= 71 (count (first remaining))) false)) (recur (rest remaining)) false))) (let [types (get facts :type-table) descriptor (get types (get call :operator-node-id))
        check (get (get (get facts :atomic-inequality-context) :checks) (get node :node-id))
        args (get call :argument-node-ids)
        arguments [(get types (first args) :gravity.type/unknown) (get types (get args 1) :gravity.type/unknown)]
        header (if (= arguments (get check :argument-types))
                 (body-ane-source core node call edge nodes bindings types (get core :module) (get check :validation)) nil)
        forms (get (get facts :atomic-inequality-context) :forms)
        owner (if (if (keyword? (get (get node :source) :form-id)) true (if (string? (get (get node :source) :form-id)) (= 71 (count (get (get node :source) :form-id))) false)) (get forms (get (get node :source) :form-id)) nil) ids (get owner :child-form-ids)
        producer-rows (loop [remaining (get facts :constraint-ledger) out []] (if (= 0 (count remaining)) out (recur (rest remaining) (if (if (= :sh08-atomic-inequality-v1 (get (first remaining) :producer-rule)) true (= :sh08-string-set-carrier-inequality-v1 (get (first remaining) :producer-rule))) (conj out (first remaining)) out))))
        producer-ids? (loop [remaining producer-rows] (if (= 0 (count remaining)) true (let [lhs (get (first remaining) :lhs) row-id (get lhs :core-node-id) projection (if (= :sh08-string-set-carrier-inequality-v1 (get (first remaining) :producer-rule)) :string-set-carrier-inequality :atomic-inequality)] (if (if (map? lhs) (if (= 2 (count lhs)) (if (= projection (get lhs :projection)) (if (keyword? row-id) true (if (string? row-id) (= 71 (count row-id)) false)) false) false) false) (recur (rest remaining)) false))))
        rows (if producer-ids? (body-select producer-rows :lhs {:core-node-id (get node :node-id) :projection (if (= :sh08-string-set-carrier-inequality-v1 (get descriptor :version)) :string-set-carrier-inequality :atomic-inequality)}) [])]
    (if (if producer-ids? (if (map? header) (if (vector? ids) (if (= 3 (count ids)) (loop [remaining ids] (if (= 0 (count remaining)) true (if (if (keyword? (first remaining)) true (if (string? (first remaining)) (= 71 (count (first remaining))) false)) (recur (rest remaining)) false))) false) false) false) false)
      (if (if (= :list (get (get check :validation) :comparison-domain))
            (body-sse-ids? [(get owner :form-id) (get owner :syntax-id)] 2) true)
(body-all?
        [(= descriptor (body-ane-finish header)) (= (get descriptor :result-type) (get types (get node :node-id)))
         (= :list (get owner :kind)) (vector? ids) (= 3 (if (vector? ids) (count ids) 0) (count (get node :children)))
         (= (get node :source) (get (body-ma-form-node {} owner) :source))
         (= {:operator-child-index 0 :argument-count 2 :argument-child-indexes [1 2]
             :evaluation-order :operator-then-arguments :dispatch :resolved-symbol-call} (get node :attributes))
         (loop [i 0]
           (if (= i 3) true
             (let [form (get forms (get ids i)) child (get nodes (get (get node :children) i))]
               (if (if (if (= :list (get (get check :validation) :comparison-domain))
                                     (body-sse-ids? [(get form :form-id) (get form :syntax-id)
                                                      (get (get child :source) :form-id) (get (get child :source) :syntax-id)] 4) true)
                                  (body-all? [(= (get owner :form-id) (get form :parent-form-id))
                     (= (get child :source) (get (body-ma-form-node {} form) :source))
                     (if (= i 0)
                                     (if (= :list (get (get check :validation) :comparison-domain))
                                       (if (symbol? (get form :value))
                                         (= (get (get child :attributes) :symbol) (get form :value)) false)
                                       (= (get form :value) (get (get child :attributes) :symbol))) true)]) false)
                 (recur (+ i 1)) false))))
         (= (body-ane-call-fact descriptor (get core :module)) (body-by (get facts :call-type-facts) :call-core-node-id (get node :node-id)))
         (= [(body-ane-constraint descriptor)] rows)]) false) false)) false) false))

(defn body-ane-node? [node facts core]
  (let [context (get facts :atomic-inequality-context) id (get node :node-id)]
    (if (if (map? context) (if (keyword? id) true (if (string? id) (= 71 (count id)) false)) false)
      (body-ane-call-valid? core facts (get context :bindings) node (get (get context :calls) id)
                          (get (get context :edges) id) (get context :nodes)) false)))

(defn body-kp-binding? [binding module]
  (if (if (vector? (get binding :profile-set)) (vector? (get binding :target-set)) false)
  (body-all?
    [(= ['keyword? :core :var 'gravity.core {:name 'gravity/core :version "bootstrap-contract-v1"} :gravity.type/core-var :safe]
        [(get binding :name) (get binding :binding-class) (get binding :kind) (get binding :namespace)
         (get binding :package) (get binding :type-ref) (get binding :safety)])
     (= [] (get binding :effects) (get binding :capabilities))
     (= :jvm (get module :target))
     (contains? (set (get binding :profile-set)) (get module :profile))
     (contains? (set (get binding :target-set)) :all)]) false))

(defn body-kp-source [core node call edge nodes bindings types module validation]
  (if (body-lc-native-map? validation)
    (if (= {:status :accepted} validation)
      (if (if (vector? (get call :argument-node-ids))
        (if (= 1 (count (get call :argument-node-ids)))
          (if (vector? (get node :children)) (= 2 (count (get node :children))) false) false) false)
  (let [children (get node :children) operator (get nodes (get call :operator-node-id))
        bid (get call :operator-binding-id) binding (get bindings bid) args (get call :argument-node-ids)
        arguments (body-io-child-types args types)
        invoked? (loop [remaining arguments]
                   (if (= 0 (count remaining)) true
                     (if (= :gravity.type/never (first remaining)) false (recur (rest remaining)))))
        caller (loop [remaining (get core :function-records)]
                 (if (= 0 (count remaining)) nil
                   (if (= (get (first remaining) :function-syntax-id) (get (get node :evaluation) :owner-function-syntax-id))
                     (first remaining) (recur (rest remaining)))))

                       :callee-binding-id bid :callee-definition-syntax-id (get binding :definition-syntax-id)
                       :callee-function-syntax-id nil :callee-function-core-node-id nil :argument-core-node-ids args
                       :ordered-evaluation-node-ids children :evaluation-order :operator-then-arguments :classification :nonlocal-or-nonfunction}]
    (if (body-all?
          [(= :call (get node :core-form)) (= :reference (get operator :core-form))
           (= (count args) 1) (= expected-call call) (= expected-edge edge) (body-lq-binding? binding module)
           (= [bid] (get node :resolved-binding-ids) (get operator :resolved-binding-ids))
           (= {:symbol (get (get operator :attributes) :symbol) :position :operator :binding-id bid :binding-class :core
               :definition-syntax-id (get binding :definition-syntax-id)} (get operator :attributes))
           (if (= 'first (get binding :name))
             (contains? '#{first gravity.core/first} (get (get operator :attributes) :symbol))
             (if (= 'rest (get binding :name))
               (contains? '#{rest gravity.core/rest} (get (get operator :attributes) :symbol))
               (contains? '#{empty? gravity.core/empty?} (get (get operator :attributes) :symbol))))
           (= :operator-then-arguments (get (get node :evaluation) :kind))
           (= (loop [i 0 out []] (if (= i (count children)) out
                (recur (+ i 1) (conj out {:index i :core-node-id (get children i)})))) (get (get node :evaluation) :order))
           (= :accepted (get validation :status))
           (let [input (first arguments)]
             (if vector-first?
               (if (vector? (get input :element-types)) (> (count (get input :element-types)) 0) false)
             (if (= input :gravity.type/never) true
               (if (= input :gravity.type/list) (= false (= 'first (get binding :name)))
                 (if (body-hl-type? input) (if (= 'first (get binding :name)) (map? (get validation :head-proof)) true)
                   (if (map? input) (= :gravity.type/list (get input :kind)) false))))))] )
      (let [header {:kind :gravity.type/applied-list-query :version :sh08-list-query-v1
       :operation (get binding :name) :semantic-owner 'gravity.collections :intrinsic :gravity.collections/persistent-list-query
       :resolution :gravity.core-compatibility :operator-node-id (get operator :node-id) :operator-binding-id bid
       :call-core-node-id (get node :node-id) :source (get node :source) :operator-source (get operator :source)
       :source-call call :source-edge edge :source-binding binding :argument-types arguments
       :query-policy (if (= 'empty? (get binding :name))
                       {:input :persistent-list :operand-evaluation :once :payload-evaluation :none
                        :original :unchanged :test :zero-elements :static-length :not-required}
                     {:input :persistent-list :operand-evaluation :once :payload-evaluation :none
                      :original :unchanged :order :stored-order
                      :head-knowledge (if (body-hl-type? (first arguments)) :homogeneous-requires-nonempty :finite-positional)
                      :suffix-knowledge (if (body-hl-type? (first arguments)) :homogeneous-preserved :available-positional-or-bare)})
       :storage-policy (if (= 'empty? (get binding :name))
                         {:representation :development-persistent-list :empty? :stored-emptiness-test :copy :none}
                       {:representation :development-persistent-list :first :stored-head-value
                        :rest :existing-immutable-tail :retention :may-retain-input-storage :copy :none})
       :value-origin {:kind :list-value-query :operation (get binding :name) :operand-node-id (first args)}

       :application (if invoked? :normal :not-invoked)
       :latent-effects [] :direct-effects [] :capabilities [] :thrown-error-effects []
       :profile (get module :profile) :target (get module :target)
       :invalidation [:calls :call-edges :binding-table :source-forms :type-table :lexical-bindings :definitions :function-records
                      :callee-body :operand-types :query-policy :storage-policy :value-origin :profile :target :evaluation-order]}]
        (if vector-first?
          (let [input (first arguments) elements (get input :element-types)]
            (assoc header :kind :gravity.type/applied-vector-first :version :sh08-vector-first-v1
              :intrinsic :gravity.collections/persistent-vector-first
              :query-policy {:input :nonempty-persistent-vector :operand-evaluation :once :payload-evaluation :none
                         :original :unchanged :order :stored-order :selection :stored-index-zero
                         :type-validation :entire-finite-positional-type :empty-result-policy :unselected}
              :storage-policy {:representation :development-persistent-vector :selection :stored-index-zero :copy :none}
              :value-origin {:kind :vector-value-query :operation 'first :operand-node-id (first args)}
              :bounds-proof {:kind :gravity.type/vector-first-nonempty :version :sh08-vector-first-nonempty-v1
                             :basis :validated-finite-positional-type :operand-node-id (first args) :operand-type input
                             :vector-length (count elements) :selected-index 0 :selected-type (get elements 0)
                             :outcome :proven-safe :check-elision :not-authorized :runtime-guards :retained}
              :invalidation (conj (get header :invalidation) :nonempty-evidence)))
        (if (contains? validation :head-proof)
          (assoc header :version :sh08-list-query-v2 :head-proof (get validation :head-proof)
            :invalidation (conj (get header :invalidation) :control-flow :mutations :branch-facts)) header))) nil)) nil) nil) nil))

(defn body-lq-constraint [descriptor]
  (if (if (keyword? (get descriptor :kind)) (contains? #{:gravity.type/applied-map-keys :gravity.type/applied-private-map-keys} (get descriptor :kind)) false)
(body-mkeys-constraint descriptor)
(if (= :gravity.type/applied-vector-rest (get descriptor :kind))
    (body-vrest-constraint descriptor)
  (if (= :gravity.type/applied-vector-empty (get descriptor :kind))
    (body-vemp-constraint descriptor)
  (let [record {:constraint-id-request {:domain :gravity/sh08-list-query-constraint-v1 :application descriptor}
   :kind :equality :producer-rule :sh08-list-query-v1
   :lhs {:core-node-id (get descriptor :call-core-node-id) :projection :list-query}
   :rhs (get descriptor :result-type) :dependencies descriptor :origin (get (get descriptor :source) :origin-chain)
   :solution {:result-type (get descriptor :result-type) :application (get descriptor :application)
              :direct-effects (get descriptor :direct-effects)}
   :invalidation (get descriptor :invalidation) :profile (get descriptor :profile) :target (get descriptor :target)
   :status :solved :diagnostics []}]
    (if (= :gravity.type/applied-vector-first (get descriptor :kind))
      (assoc record :constraint-id-request {:domain :gravity/sh08-vector-first-constraint-v1 :application descriptor}
        :producer-rule :sh08-vector-first-v1
        :lhs {:core-node-id (get descriptor :call-core-node-id) :projection :vector-first}
        :solution (assoc (get record :solution) :bounds-proof (get descriptor :bounds-proof))) record))
  ))))

(defn body-lq-call-fact [descriptor module]
  (if (if (keyword? (get descriptor :kind)) (contains? #{:gravity.type/applied-map-keys :gravity.type/applied-private-map-keys} (get descriptor :kind)) false)
(body-mkeys-call-fact descriptor module)
(if (= :gravity.type/applied-vector-rest (get descriptor :kind))
    (body-vrest-call-fact descriptor module)
  (if (= :gravity.type/applied-vector-empty (get descriptor :kind))
    (body-vemp-call-fact descriptor module)
  (let [source (get descriptor :source) edge (get descriptor :source-edge)]
    (if (= :gravity.type/applied-vector-first (get descriptor :kind))
      {:artifact :gravity/c7-call-type-fact
       :fact-id-request {:domain :gravity/sh08-vector-first-call-type-fact-v1 :application descriptor}
       :call-core-node-id (get descriptor :call-core-node-id) :caller-function-syntax-id (get edge :caller-function-syntax-id)
       :callee-function-syntax-id nil :argument-types (get descriptor :argument-types) :result-type (get descriptor :result-type)
       :evaluation-order :operator-then-arguments :source-span (get source :semantic-span) :syntax-id (get source :syntax-id)
       :origin-chain (get source :origin-chain) :generated-origin (get source :generated-origin)
       :profile (get module :profile) :target (get module :target) :effects [] :capabilities [] :status :inferred
       :dispatch :direct-vector-first :applied-vector-first descriptor :effect-facts-source :audited-vector-value-query}
    {:artifact :gravity/c7-call-type-fact
     :fact-id-request {:domain :gravity/sh08-list-query-call-type-fact-v1 :application descriptor}
     :call-core-node-id (get descriptor :call-core-node-id) :caller-function-syntax-id (get edge :caller-function-syntax-id)
     :callee-function-syntax-id nil :argument-types (get descriptor :argument-types) :result-type (get descriptor :result-type)
     :evaluation-order :operator-then-arguments :source-span (get source :semantic-span) :syntax-id (get source :syntax-id)
     :origin-chain (get source :origin-chain) :generated-origin (get source :generated-origin)
     :profile (get module :profile) :target (get module :target) :effects (get descriptor :direct-effects) :capabilities [] :status :inferred
     :dispatch :direct-list-query :applied-list-query descriptor :effect-facts-source :audited-list-value-query}))
  ))))


(defn body-lq-finish [header]
  (let [input (first (get header :argument-types))
        type (if (= :not-invoked (get header :application)) :gravity.type/never
               (if (= 'empty? (get header :operation)) :gravity.type/bool
                 (if (= 'first (get header :operation))
                   (if (body-hl-type? input) (get (get header :head-proof) :result-type)
                     (if (= 0 (count (get input :element-types))) :gravity.type/nil
                       (first (get input :element-types))))
                   (if (if (= input :gravity.type/list) true (body-hl-type? input)) input
                     (assoc input :element-types
                       (if (= 0 (count (get input :element-types))) []
                         (subvec (get input :element-types) 1 (count (get input :element-types)))))))))]
    (assoc header :parameter-types (get header :argument-types) :return type :result-type type)))

(defn body-hl-parent-index [records nodes]
  (loop [remaining records pending [] owner nil ordinal 0 parents {}]
    (if (if (= 0 (count remaining)) (= 0 (count pending)) false)
      {:status :accepted :index parents}
      (if (= 0 (count pending))
        (let [node (first remaining)]
          (if (vector? (get node :children))
            (recur (rest remaining) (get node :children) (get node :node-id) 0 parents)
            {:status :rejected :reason :list-head-parent-index-required}))
        (let [id (first pending)]
          (if (if (contains? nodes id) (= false (contains? parents id)) false)
            (recur remaining (rest pending) owner (+ ordinal 1) (assoc parents id {:owner owner :ordinal ordinal}))
            {:status :rejected :reason :list-head-parent-index-required}))))))

(defn body-hl-reference? [node bid bindings]
  (let [binding (get bindings bid)]
    (body-all? [(= :reference (get node :core-form)) (= [] (get node :children))
          (= [:lexical :local] [(get binding :binding-class) (get binding :kind)])
          (= [bid] (get node :resolved-binding-ids))
          (= {:symbol (get binding :name) :position :expression :binding-id bid :binding-class :lexical
              :definition-syntax-id (get binding :definition-syntax-id)} (get node :attributes))])))

(defn body-hl-path [id nodes parents types]
  (loop [current id path [] seen #{}]
    (let [edge (get parents current) owner (get nodes (get edge :owner))]
      (if (= edge nil) {:status :accepted :path path}
        (if (contains? seen current)
          {:status :rejected :reason :list-head-cyclic-path}
          (if (if (= :if (get owner :core-form)) (= :gravity.type/never (get types (first (get owner :children)))) false)
            {:status :rejected :reason :list-head-unreachable-branch}
            (let [next-path (conj path {:owner-core-node-id (get owner :node-id) :child-core-node-id current :child-index (get edge :ordinal)})]
              (if (= :fn (get owner :core-form))
                {:status :accepted :path next-path}
                (recur (get owner :node-id) next-path (conj seen current))))))))))

(defn body-lq-head-proof [core node call nodes bindings types]
  (let [input (get types (first (get call :argument-node-ids)))
        operator (get bindings (get call :operator-binding-id))]
    (if (if (= 'first (get operator :name)) (body-hl-type? input) false)
      (let [prepared (body-hl-parent-index (get core :nodes) nodes)]
        (if (= :accepted (get prepared :status))
          (let [path (body-hl-path (get node :node-id) nodes (get prepared :index) types)
                selected (loop [entries (get path :path)]
                           (if (= 0 (count entries)) nil
                             (if (= :if (get (get nodes (get (first entries) :owner-core-node-id)) :core-form))
                               (first entries) (recur (rest entries)))))
                branch (get nodes (get selected :owner-core-node-id)) ordinal (get selected :child-index)
                condition (get nodes (first (get branch :children)))
                calls (body-index (get core :calls) :core-node-id) edges (body-index (get core :call-edges) :call-core-node-id)
                predicate (get calls (get condition :node-id))
                receiver (get nodes (first (get call :argument-node-ids)))
                tested (get nodes (first (get predicate :argument-node-ids)))
                bid (get (get receiver :attributes) :binding-id) binding (get bindings bid)
                owner-id (get (get node :evaluation) :owner-function-syntax-id)
                parameter (loop [records (get core :function-records)]
                            (if (= 0 (count records)) nil
                              (let [record (first records)]
                                (if (= owner-id (get record :function-syntax-id))
                                  record (recur (rest records))))))
                lexical (loop [records (get core :lexical-bindings)]
                          (if (= 0 (count records)) nil
                            (if (= bid (get (first records) :binding-id)) (first records) (recur (rest records)))))
                parameter-ids (get parameter :parameter-binding-ids)
                parameter-index (if (vector? parameter-ids)
                                  (loop [i 0]
                                    (if (= i (count parameter-ids)) nil
                                      (if (= bid (get parameter-ids i)) i (recur (+ i 1))))) nil)
                declaration (get (get (get parameter :signature) :parameters) parameter-index)
                entry? (if (= declaration nil) (map? (get core :sh08-private-self-parameter-premise)) false)
                entry-parameter (if entry? (body-is-parameter-record core parameter parameter-index binding input) nil)
                immutable? (if (= :immutable (get lexical :mutability))
                             (= input (get types (get lexical :initializer-node-id)))
                             (if (= parameter-index nil) false
                               (if (body-hl-declaration? declaration bindings) (= input (get declaration :type-id))
                                 (map? entry-parameter))))
                mutations? (loop [records (get core :mutations)]
                             (if (= 0 (count records)) false
                               (if (= bid (get (first records) :target-binding-id)) true (recur (rest records)))))
                header (if (if (= :accepted (get path :status))
                             (if (vector? (get predicate :argument-node-ids))
                               (if (= 1 (count (get predicate :argument-node-ids)))
                                 (if (vector? (get condition :children))
                                   (if (= 2 (count (get condition :children)))
                                     (let [predicate-binding (get bindings (get predicate :operator-binding-id))]
                                       (if (= 'empty? (get predicate-binding :name)) (body-lq-binding? predicate-binding (get core :module)) false)) false) false) false) false)
                             false)
                       (body-lq-source core condition predicate (get edges (get condition :node-id))
                                       nodes bindings types (get core :module) (body-lc-validate-types [input])) nil)
                control {:core-node-id (get branch :node-id) :kind :if :condition-node-id (get condition :node-id)
                         :branches [{:role :then :predicate :truthy :core-node-id (get (get branch :children) 1)}
                                    {:role :else :predicate :falsey :core-node-id (get (get branch :children) 2)}]
                         :branch-exclusivity :exactly-one :truthiness {:false-values [:nil :false] :other-values :true}
                         :result-policy :selected-branch}
                controls (loop [records (get core :control-flow) found []]
                           (if (= 0 (count records)) found
                             (recur (rest records) (if (= (get branch :node-id) (get (first records) :core-node-id)) (conj found (first records)) found))))]
            (if (= :accepted (get path :status))
              (if (body-all?
                    [(map? selected) (contains? #{1 2} ordinal) (= :if (get branch :core-form)) (= 3 (count (get branch :children)))
                     (= {:condition-child-index 0 :then-child-index 1 :else-child-index 2 :condition-evaluation :always-first
                         :branch-evaluation :exactly-one :truthiness {:false-values [:nil :false] :other-values :true}} (get branch :attributes))
                     (= :condition-then-exclusive-branch (get (get branch :evaluation) :kind))
                     (= [{:index 0 :core-node-id (get condition :node-id)}] (get (get branch :evaluation) :order))
                     (= [control] controls) immutable? (= false mutations?)
                     (contains? #{nil :immutable} (get binding :mutability))
                     (body-hl-reference? receiver bid bindings) (body-hl-reference? tested bid bindings)
                     (= input (get types (get tested :node-id)))
                     (= owner-id (get (get receiver :evaluation) :owner-function-syntax-id)
                                 (get (get tested :evaluation) :owner-function-syntax-id)
                                 (get (get condition :evaluation) :owner-function-syntax-id)
                                 (get (get branch :evaluation) :owner-function-syntax-id))
                     (map? header) (= 'empty? (get header :operation)) (= :normal (get header :application))
                     (= :gravity.type/bool (get types (get condition :node-id)))
                     (= (body-lq-finish header) (get types (get predicate :operator-node-id)))])
                {:status :accepted
                 :proof {:kind :gravity.type/list-head-branch :version :sh08-list-head-branch-v1
                         :head-call-core-node-id (get node :node-id) :receiver-core-node-id (get receiver :node-id)
                         :receiver-source (get receiver :source) :receiver-type input
                         :binding-id bid :binding binding
                         :immutable-binding-record (if (map? lexical) lexical
                                                     (if (map? entry-parameter) entry-parameter parameter))
                         :condition-core-node-id (get condition :node-id) :condition (body-lq-finish header)
                         :predicate-receiver-core-node-id (get tested :node-id) :predicate-receiver-source (get tested :source)
                         :branch-core-node-id (get branch :node-id) :branch-source (get branch :source) :control-flow control
                         :branch-child-index ordinal :branch-root-core-node-id (get (get branch :children) ordinal)
                         :ancestry (get path :path) :knowledge (if (= ordinal 1) :empty :nonempty)
                         :result-type (if (= ordinal 1) :gravity.type/nil (get input :element-type))}}
                {:status :rejected :reason :list-head-branch-proof-required})
              path))
          prepared))
      {:status :not-applicable})))

(defn body-lq-context-call [core facts bindings nodes forms calls edges call]
  (let [args (get call :argument-node-ids)
        binding (if (body-sse-ids? [(get call :operator-binding-id)] 1)
                  (get bindings (get call :operator-binding-id)) nil)
        name (if (map? binding) (get binding :name) nil)
        query? (if (symbol? name) (contains? '#{keys first rest empty?} name) false)
        unary-value-query? (if (if (symbol? name) (contains? '#{keys empty? rest} name) false)
                              (if (vector? args) (= 1 (count args)) false) false)
        node (get nodes (get call :core-node-id))
        types (get facts :type-table)
        module (get core :module)
        edge (get edges (get call :core-node-id))]
    (if (= false (map? binding))
      (body-failure :body-query-physical-id-required)
      (if (if unary-value-query?
            (if (body-vemp-ids? node call nodes bindings module)
              (body-vemp-type-fields? (get types (first args))) false)
            true)
        (if (body-pmk-entry? node call nodes bindings types module)
          (let [result (body-pmk-evidence core (get facts :constraint-ledger) (get facts :call-type-facts)
                                          node call edge nodes bindings types forms)]
            (if (= :accepted (get result :status))
              {:status :accepted :check result}
              (body-failure :body-private-map-keys-source-mismatch)))
          (if (body-mkeys-entry? node call nodes bindings types module)
            (let [result (body-mkeys-evidence core (get facts :constraint-ledger) (get facts :call-type-facts)
                                              node call edge nodes bindings types)]
              (if (= :accepted (get result :status))
                {:status :accepted :check result}
                (body-failure :body-map-keys-source-mismatch)))
            (if (body-vrest-entry? node call nodes bindings types module)
              (let [result (body-vrest-evidence core (get facts :constraint-ledger) (get facts :call-type-facts)
                                               node call edge nodes bindings types)]
                (if (= :accepted (get result :status))
                  {:status :accepted :check result}
                  (body-failure :body-vector-rest-source-mismatch)))
              (if (body-vemp-entry? node call nodes bindings types module)
                (let [result (body-vemp-evidence core (get facts :constraint-ledger) (get facts :call-type-facts)
                                                node call edge nodes bindings types)]
                  (if (= :accepted (get result :status))
                    {:status :accepted :check result}
                    (body-failure :body-vector-empty-source-mismatch)))
                (if query?
                  (if (body-lq-binding? binding module)
                    (let [arguments (body-io-child-types args types)
                          receiver (first arguments)
                          vector-first? (if (= 'first name)
                                          (if (= :gravity.type/vector receiver) true
                                            (if (map? receiver) (= :gravity.type/vector (get receiver :kind)) false)) false)
                          validation (body-lc-validate-types arguments)
                          head (if (= :accepted (get validation :status))
                                 (body-lq-head-proof core node call nodes bindings types)
                                 {:status :not-applicable})
                          validation (if (= :accepted (get head :status))
                                       (assoc validation :head-proof (get head :proof)) validation)]
                      (if (= :rejected (get head :status))
                        (body-failure (get head :reason))
                        (if (if (= :accepted (get validation :status))
                              (if vector-first?
                                (if (map? receiver)
                                  (if (vector? (get receiver :element-types)) (> (count (get receiver :element-types)) 0) false)
                                  false)
                                true)
                              false)
                          {:status :accepted :check validation}
                          (body-failure (if vector-first?
                                          :body-vector-first-nonempty-complete-positional-type-required
                                          :body-list-query-operand-type-required)))))
                    {:status :skip})
                  {:status :skip})))))
        (body-failure (if (= 'keys name) :body-map-keys-source-mismatch
                        (if (= 'rest name) :body-vector-rest-source-mismatch :body-vector-empty-source-mismatch)))))))

(defn body-lq-context [request facts bindings]
  (if (map? request)
    (let [core (get request :canonical-core-artifact)
          core-shape? (if (map? core)
                        (if (vector? (get core :calls))
                          (if (vector? (get core :nodes))
                            (vector? (get core :call-edges)) false)
                          false)
                        false)]
      (if core-shape?
        (let [present? (loop [remaining (get core :calls)]
                         (if (= 0 (count remaining))
                           false
                           (let [call (first remaining)
                                 bid (if (map? call) (get call :operator-binding-id) nil)]
                             (if (body-sse-ids? [bid] 1)
                               (let [binding (get bindings bid)
                                     name (if (map? binding) (get binding :name) nil)]
                                 (if (if (symbol? name) (contains? '#{keys first rest empty?} name) false)
                                   (if (if (if (= 'keys name) true (= 'rest name))
                                         (if (keyword? (get binding :binding-class))
                                           (if (contains? #{:lexical :namespace :import} (get binding :binding-class)) false true)
                                           true)
                                         (if (= 'empty? name) (= :core (get binding :binding-class))
                                           (body-lq-binding? binding (get core :module))))
                                     true
                                     (recur (rest remaining)))
                                   (recur (rest remaining))))
                               :invalid-query-source))))]
          (if (= :invalid-query-source present?)
            (body-failure :body-query-physical-id-required)
            (if (= false present?)
              {:status :accepted :context nil}
              (let [forms (body-path request [:b47-context :authenticated-core-request :forms])]
                (if (= false (vector? forms))
                  (body-failure :body-list-query-source-forms-required)
                  (let [node-index (body-vemp-index (get core :nodes) :node-id)
                        form-index (body-vemp-index forms :form-id)
                        call-index (body-vemp-index (get core :calls) :core-node-id)
                        edge-index (body-vemp-index (get core :call-edges) :call-core-node-id)]
                    (if (body-all? [(= :accepted (get node-index :status))
                                    (= :accepted (get form-index :status))
                                    (= :accepted (get call-index :status))
                                    (= :accepted (get edge-index :status))])
                      (let [nodes (get node-index :index)
                            calls (get call-index :index)
                            edges (get edge-index :index)]
                        (loop [remaining (get core :calls) checks {}]
                          (if (= 0 (count remaining))
                            {:status :accepted
                             :context {:forms (get form-index :index) :nodes nodes :calls calls
                                       :edges edges :bindings bindings :type-checks checks}}
                            (let [result (body-lq-context-call core facts bindings nodes
                                                               (get form-index :index) calls edges
                                                               (first remaining))]
                              (if (= :accepted (get result :status))
                                (recur (rest remaining)
                                       (assoc checks (get (first remaining) :core-node-id)
                                              (get result :check)))
                                (if (= :skip (get result :status))
                                  (recur (rest remaining) checks)
                                  result))))))
                      (body-failure :body-query-physical-id-required))))))))
        (body-failure :body-query-core-shape-required)))
    (body-failure :body-query-core-shape-required)))

(defn body-lq-call-valid? [core facts bindings node call edge nodes]
  (if (body-pmk-entry? node call nodes bindings (get facts :type-table) (get core :module))
    (body-pmk-call-valid? core facts bindings node call edge nodes)
    (let [types (get facts :type-table)
        unary? (if (vector? (get call :argument-node-ids)) (= 1 (count (get call :argument-node-ids))) false)
        physical? (if unary? (body-vemp-ids? node call nodes bindings (get core :module)) true)
        input (if (if unary? physical? false) (get types (first (get call :argument-node-ids))) nil)]
    (if (= false physical?) false
      (if (= false (body-vemp-type-fields? input)) false
        (if (body-mkeys-entry? node call nodes bindings types (get core :module))
(let [context (get facts :list-query-context)
                result (body-mkeys-evidence core (get facts :constraint-ledger) (get facts :call-type-facts)
                         node call edge nodes bindings types)]
            (if (= :accepted (get result :status))
              (if (if (map? context) (map? (get context :forms)) false)
                (body-all? [(= (get result :descriptor) (get types (get call :operator-node-id)))
                            (= (get (get result :descriptor) :result-type) (get types (get node :node-id)))
                            (body-mkeys-forms? node call nodes (get context :forms))]) false) false))
(if (body-vrest-entry? node call nodes bindings types (get core :module))
          (let [context (get facts :list-query-context)
                result (body-vrest-evidence core (get facts :constraint-ledger) (get facts :call-type-facts)
                         node call edge nodes bindings types)]
            (if (= :accepted (get result :status))
              (if (if (map? context) (map? (get context :forms)) false)
                (body-all? [(= (get result :descriptor) (get types (get call :operator-node-id)))
                            (= (get (get result :descriptor) :result-type) (get types (get node :node-id)))
                            (body-vrest-forms? node call nodes (get context :forms))]) false) false))
        (if (body-vemp-entry? node call nodes bindings types (get core :module))
          (let [context (get facts :list-query-context)
                result (body-vemp-evidence core (get facts :constraint-ledger) (get facts :call-type-facts)
                         node call edge nodes bindings types)]
            (if (= :accepted (get result :status))
              (if (if (map? context) (map? (get context :forms)) false)
                (body-all? [(= (get result :descriptor) (get types (get call :operator-node-id)))
                            (= :gravity.type/bool (get types (get node :node-id)))
                            (body-vemp-forms? node call nodes (get context :forms))]) false) false))
  (let [types (get facts :type-table) descriptor (get types (get call :operator-node-id))
        validation (get (get (get facts :list-query-context) :type-checks) (get node :node-id))
        header (body-lq-source core node call edge nodes bindings types (get core :module) validation)
        forms (get (get facts :list-query-context) :forms)
        owner (get forms (get (get node :source) :form-id)) ids (get owner :child-form-ids)
        rows (body-select (body-select (get facts :constraint-ledger) :producer-rule
                                     (if (= :gravity.type/applied-vector-first (get descriptor :kind)) :sh08-vector-first-v1 :sh08-list-query-v1))
                          :lhs {:core-node-id (get node :node-id) :projection
                                (if (= :gravity.type/applied-vector-first (get descriptor :kind)) :vector-first :list-query)})]
    (if (map? header)
      (body-all?
        [(= descriptor (body-lq-finish header)) (= (get descriptor :result-type) (get types (get node :node-id)))
         (= :list (get owner :kind)) (vector? ids) (= (+ 1 (count (get call :argument-node-ids))) (if (vector? ids) (count ids) 0) (count (get node :children)))
         (= (get node :source) (get (body-ma-form-node {} owner) :source))
         (= {:operator-child-index 0 :argument-count (count (get call :argument-node-ids)) :argument-child-indexes (loop [index 1 out []] (if (= index (count (get node :children))) out (recur (+ index 1) (conj out index))))
             :evaluation-order :operator-then-arguments :dispatch :resolved-symbol-call} (get node :attributes))
         (loop [i 0]
           (if (= i (count (get node :children))) true
             (let [form (get forms (get ids i)) child (get nodes (get (get node :children) i))]
               (if (body-all? [(= (get owner :form-id) (get form :parent-form-id))
                     (= (get child :source) (get (body-ma-form-node {} form) :source))
                     (if (= i 0) (= (get form :value) (get (get child :attributes) :symbol)) true)])
                 (recur (+ i 1)) false))))
         (= (body-lq-call-fact descriptor (get core :module)) (body-by (get facts :call-type-facts) :call-core-node-id (get node :node-id)))
         (= [(body-lq-constraint descriptor)] rows)]) false))
        ))))))))

(defn body-lq-node? [node facts core]
  (let [context (get facts :list-query-context) id (get node :node-id)]
    (if (map? context)
      (body-lq-call-valid? core facts (get context :bindings) node (get (get context :calls) id)
                          (get (get context :edges) id) (get context :nodes)) false)))

(defn body-sc-binding? [binding module]
  (if (if (vector? (get binding :profile-set)) (vector? (get binding :target-set)) false)
  (body-all?
    [(= ['str :core :var 'gravity.core {:name 'gravity/core :version "bootstrap-contract-v1"} :gravity.type/core-var :safe]
        [(get binding :name) (get binding :binding-class) (get binding :kind) (get binding :namespace)
         (get binding :package) (get binding :type-ref) (get binding :safety)])
     (= [] (get binding :effects) (get binding :capabilities))
     (contains? (set (get binding :profile-set)) (get module :profile))
     (contains? (set (get binding :target-set)) :all)]) false))

(defn body-sc-source [core node call edge nodes bindings types module]
  (if (if (vector? (get call :argument-node-ids)) (vector? (get node :children)) false)
  (let [children (get node :children) operator (get nodes (get call :operator-node-id))
        bid (get call :operator-binding-id) binding (get bindings bid) args (get call :argument-node-ids)
        arguments (body-io-child-types args types)
        invoked? (loop [remaining arguments]
                   (if (= 0 (count remaining)) true
                     (if (= :gravity.type/never (first remaining)) false (recur (rest remaining)))))
        caller (loop [remaining (get core :function-records)]
                 (if (= 0 (count remaining)) nil
                   (if (= (get (first remaining) :function-syntax-id) (get (get node :evaluation) :owner-function-syntax-id))
                     (first remaining) (recur (rest remaining)))))
        expected-call {:core-node-id (get node :node-id) :operator-node-id (first children) :operator-binding-id bid
                       :argument-node-ids (vec (rest children)) :ordered-evaluation-node-ids children
                       :evaluation-order :operator-then-arguments :result-policy :call-result}
        expected-edge {:ordinal (get edge :ordinal) :call-core-node-id (get node :node-id)
                       :caller-function-syntax-id (get caller :function-syntax-id) :caller-function-core-node-id (get caller :function-core-node-id)
                       :callee-binding-id bid :callee-definition-syntax-id (get binding :definition-syntax-id)
                       :callee-function-syntax-id nil :callee-function-core-node-id nil :argument-core-node-ids args
                       :ordered-evaluation-node-ids children :evaluation-order :operator-then-arguments :classification :nonlocal-or-nonfunction}]
    (if (body-all?
          [(= :call (get node :core-form)) (= :reference (get operator :core-form))
           (= 2 (count args)) (= expected-call call) (= expected-edge edge) (body-sc-binding? binding module)
           (= [bid] (get node :resolved-binding-ids) (get operator :resolved-binding-ids))
           (= {:symbol (get (get operator :attributes) :symbol) :position :operator :binding-id bid :binding-class :core
               :definition-syntax-id (get binding :definition-syntax-id)} (get operator :attributes))
           (contains? '#{str gravity.core/str} (get (get operator :attributes) :symbol))
           (= :operator-then-arguments (get (get node :evaluation) :kind))
           (= (loop [i 0 out []] (if (= i (count children)) out
                (recur (+ i 1) (conj out {:index i :core-node-id (get children i)})))) (get (get node :evaluation) :order))
           (loop [remaining arguments]
             (if (= 0 (count remaining)) true
               (if (contains? #{:gravity.type/string :gravity.type/never} (first remaining))
                 (recur (rest remaining)) false)))
           (loop [remaining arguments]
             (if (= 0 (count remaining)) true
               (if (contains? #{nil :gravity.type/unknown} (first remaining)) false (recur (rest remaining)))))] )
      {:kind :gravity.type/applied-string-concat :version :sh08-string-concat-v1
       :operation 'str :semantic-owner 'gravity.text :intrinsic :gravity.text/binary-string-concat
       :resolution :gravity.core-compatibility :operator-node-id (get operator :node-id) :operator-binding-id bid
       :call-core-node-id (get node :node-id) :source (get node :source) :operator-source (get operator :source)
       :source-call call :source-edge edge :source-binding binding :argument-types arguments
       :concatenation-policy {:domain :binary-strings :order :left-then-right
                              :scalars :exact-sequence-concatenation :normalization :none :coercion :none
                              :formatting :none :operand-evaluation :once :allocation :normal-invocation-even-empty}
       :application (if invoked? :normal :not-invoked)
       :latent-effects [:memory/allocate] :direct-effects (if invoked? [:memory/allocate] []) :capabilities [] :thrown-error-effects []
       :profile (get module :profile) :target (get module :target)
       :invalidation [:calls :call-edges :binding-table :source-forms :type-table :lexical-bindings :definitions :function-records
                      :callee-body :string-operand-types :concatenation-policy :allocation-condition :profile :target :evaluation-order]} nil)) nil))

(defn body-sc-constraint [descriptor]
  {:constraint-id-request {:domain :gravity/sh08-string-concat-constraint-v1 :application descriptor}
   :kind :equality :producer-rule :sh08-string-concat-v1
   :lhs {:core-node-id (get descriptor :call-core-node-id) :projection :string-concat}
   :rhs (get descriptor :result-type) :dependencies descriptor :origin (get (get descriptor :source) :origin-chain)
   :solution {:result-type (get descriptor :result-type) :application (get descriptor :application)
              :direct-effects (get descriptor :direct-effects)}
   :invalidation (get descriptor :invalidation) :profile (get descriptor :profile) :target (get descriptor :target)
   :status :solved :diagnostics []})

(defn body-sc-call-fact [descriptor module]
  (let [source (get descriptor :source) edge (get descriptor :source-edge)]
    {:artifact :gravity/c7-call-type-fact
     :fact-id-request {:domain :gravity/sh08-string-concat-call-type-fact-v1 :application descriptor}
     :call-core-node-id (get descriptor :call-core-node-id) :caller-function-syntax-id (get edge :caller-function-syntax-id)
     :callee-function-syntax-id nil :argument-types (get descriptor :argument-types) :result-type (get descriptor :result-type)
     :evaluation-order :operator-then-arguments :source-span (get source :semantic-span) :syntax-id (get source :syntax-id)
     :origin-chain (get source :origin-chain) :generated-origin (get source :generated-origin)
     :profile (get module :profile) :target (get module :target) :effects (get descriptor :direct-effects) :capabilities [] :status :inferred
     :dispatch :direct-string-concat :applied-string-concat descriptor :effect-facts-source :audited-text-intrinsic}))


(defn body-sc-finish [header]
  (let [type (if (= :normal (get header :application)) :gravity.type/string :gravity.type/never)]
    (assoc header :parameter-types (get header :argument-types) :return type :result-type type)))

(defn body-sc-context [request facts bindings]
  (let [core (get request :canonical-core-artifact)
        count-calls (loop [remaining (get core :calls) out 0]
                      (if (= 0 (count remaining)) out
                        (recur (rest remaining)
                          (+ out (if (body-sc-binding? (get bindings (get (first remaining) :operator-binding-id)) (get core :module)) 1 0)))))]
    (if (= 0 count-calls) {:status :accepted :context nil}
      (let [forms (body-path request [:b47-context :authenticated-core-request :forms])]
        (if (= false (vector? forms)) (body-failure :body-string-concat-source-forms-required)
          {:status :accepted
           :context {:forms (body-index forms :form-id) :nodes (body-index (get core :nodes) :node-id)
                     :calls (body-index (get core :calls) :core-node-id) :edges (body-index (get core :call-edges) :call-core-node-id)
                     :bindings bindings}})))))

(defn body-sc-call-valid? [core facts bindings node call edge nodes]
  (let [types (get facts :type-table) descriptor (get types (get call :operator-node-id))
        header (body-sc-source core node call edge nodes bindings types (get core :module))
        forms (get (get facts :string-concat-context) :forms)
        owner (get forms (get (get node :source) :form-id)) ids (get owner :child-form-ids)
        rows (body-select (body-select (get facts :constraint-ledger) :producer-rule :sh08-string-concat-v1)
                          :lhs {:core-node-id (get node :node-id) :projection :string-concat})]
    (if (map? header)
      (body-all?
        [(= descriptor (body-sc-finish header)) (= (get descriptor :result-type) (get types (get node :node-id)))
         (= :list (get owner :kind)) (vector? ids) (= 3 (if (vector? ids) (count ids) 0) (count (get node :children)))
         (= (get node :source) (get (body-ma-form-node {} owner) :source))
         (= {:operator-child-index 0 :argument-count 2 :argument-child-indexes [1 2]
             :evaluation-order :operator-then-arguments :dispatch :resolved-symbol-call} (get node :attributes))
         (loop [i 0]
           (if (= i 3) true
             (let [form (get forms (get ids i)) child (get nodes (get (get node :children) i))]
               (if (body-all? [(= (get owner :form-id) (get form :parent-form-id))
                     (= (get child :source) (get (body-ma-form-node {} form) :source))
                     (if (= i 0) (= (get form :value) (get (get child :attributes) :symbol)) true)])
                 (recur (+ i 1)) false))))
         (= (body-sc-call-fact descriptor (get core :module)) (body-by (get facts :call-type-facts) :call-core-node-id (get node :node-id)))
         (= [(body-sc-constraint descriptor)] rows)]) false)))

(defn body-sc-node? [node facts core]
  (let [context (get facts :string-concat-context) id (get node :node-id)]
    (if (map? context)
      (body-sc-call-valid? core facts (get context :bindings) node (get (get context :calls) id)
                          (get (get context :edges) id) (get context :nodes)) false)))

(defn body-mg-member-count [type]
  (if (if (map? type) (vector? (get type :member-types)) false) (count (get type :member-types)) 0))

(defn body-mg-normal-known? [type]
  (if (keyword? type)
    (= false (contains? #{:gravity.type/unknown :gravity.type/never} type))
    (if (map? type) (keyword? (get type :kind)) false)))

(defn body-mg-map-valid? [type]
  (if (= :gravity.type/map type) true
    (if (if (map? type) (= :gravity.type/map (get type :kind)) false)
      (let [members (get type :member-types)]
        (if (vector? members)
          (loop [i 0]
            (if (= i (count members)) true
              (if (< (+ i 1) (count members))
                (if (if (if (keyword? (get members i)) (contains? #{:gravity.type/nil :gravity.type/bool :gravity.type/integer :gravity.type/decimal :gravity.type/ratio
                                    :gravity.type/character :gravity.type/string :gravity.type/symbol :gravity.type/keyword
                                    :gravity.type/i8 :gravity.type/i16 :gravity.type/i32 :gravity.type/i64
                                    :gravity.type/u8 :gravity.type/u16 :gravity.type/u32 :gravity.type/u64 :gravity.type/f32 :gravity.type/f64}
                                  (get members i)) false)
                        (body-mg-normal-known? (get members (+ i 1))) false)
                  (recur (+ i 2)) false) false))) false)) false)))

(defn body-mg-operands? [arguments invoked?]
  (let [map-type (get arguments 0) key-type (get arguments 1) default-type (get arguments 2)]
    (if (if (if (= :gravity.type/never map-type) true (body-mg-map-valid? map-type))
          (if (contains? #{:gravity.type/string :gravity.type/keyword :gravity.type/never} key-type)
            (if (= :gravity.type/never default-type) true (body-mg-normal-known? default-type)) false) false)
      (if invoked?
        (if (map? map-type)
          (let [members (get map-type :member-types)]
            (loop [i 0]
              (if (= i (count members)) true
                (if (if (= key-type (get members i)) (= default-type (get members (+ i 1))) true)
                  (recur (+ i 2)) false)))) false)
        true) false)))

(defn body-mg-present-operands? [arguments args nodes]
  (let [map-type (get arguments 0) key-type (get arguments 1) key-node (get nodes (get args 1))
        normal? (if (= :gravity.type/never map-type) false (= false (= :gravity.type/never key-type)))]
    (if (if (= :gravity.type/never map-type) true (body-mg-map-valid? map-type))
      (if (if (= :gravity.type/never key-type) true
            (body-all? [(= :gravity.type/keyword key-type) (= :literal (get key-node :core-form))
                  (= [] (get key-node :children)) (= :keyword (get (get key-node :attributes) :literal-kind))
                  (keyword? (get (get key-node :attributes) :value))]))
        (if normal? (if (map? map-type) (= :gravity.type/map (get map-type :kind)) false) true) false) false)))

(defn body-mg-present-header [header nodes]
  (let [args (get (get header :source-call) :argument-node-ids) key-node (get nodes (get args 1))]
    (assoc header :version :sh08-map-get-present-v1 :intrinsic :gravity.collections/map-lookup-present
      :key-node-id (get args 1) :key (if (= :gravity.type/never (get (get header :argument-types) 1)) nil
                                   (get (get key-node :attributes) :value))
      :lookup-policy {:input :established-finite-map :keys [:literal-keyword] :key-equality :value
                      :presence :proven-present :default :none :normalization :none :coercion :none
                      :operand-evaluation :map-then-key-once :result :selected-stored-type}
      :invalidation (conj (get header :invalidation) :actual-key :finite-map-shape :selected-part))))

(defn body-mg-present-selection [header input]
  ; C7 owns the source-derived shape. Each consumer joins its actual key,
  ; finite coordinates and selected type without inferring presence from types.
  (let [parts (get input :parts) type (get (get header :argument-types) 0) members (get type :member-types)]
    (if (if (= :normal (get header :application))
          (if (vector? parts)
            (body-all? [(= :accepted (get input :status)) (= :map (get input :shape-kind))
                  (= type (get input :type)) (vector? members) (= (* 2 (count parts)) (count members))]) false) false)
      (loop [index 0 seen #{} selected nil]
        (if (= index (count parts)) selected
          (let [part (get parts index) key (get part :key) shape (get part :shape)]
            (if (body-all? [(keyword? key) (= false (contains? seen key)) (= (+ 1 (* 2 index)) (get part :coordinate))
                      (= :gravity.type/keyword (get members (* 2 index)))
                      (= :accepted (get shape :status)) (body-mg-normal-known? (get shape :type))
                      (= (get shape :type) (get members (+ 1 (* 2 index))))])
              (recur (+ index 1) (conj seen key) (if (= key (get header :key)) part selected)) nil)))) nil)))

(defn body-mg-present-finish [header input]
  (let [normal? (= :normal (get header :application)) part (if normal? (body-mg-present-selection header input) nil)
        type (if normal? (get (get part :shape) :type) :gravity.type/never)]
    (if (if normal? (map? part) (= input nil))
      (assoc header :parameter-types (get header :argument-types) :return type :result-type type
        :presence-proof (if normal?
                          {:kind :finite-map-key-presence :key (get header :key)
                           :operand-node-id (get (get (get header :source-call) :argument-node-ids) 0)
                           :operand-type (get (get header :argument-types) 0) :operand-shape input
                           :selected-part part :selected-coordinate (get part :coordinate) :selected-type type} nil)) nil)))

(defn body-pe-form-source [form]
  (get (body-ma-form-node {} form) :source))


(defn body-pe-select [records key value]
  (loop [remaining records out []]
    (if (= 0 (count remaining)) out
      (recur (rest remaining) (if (= value (get (first remaining) key)) (conj out (first remaining)) out)))))

(defn body-pe-one [records key value]
  (let [matches (body-pe-select records key value)]
    (if (= 1 (count matches)) (first matches) nil)))

(defn body-pe-recursive? [core id]
  (loop [remaining (get core :recursion-components)]
    (if (= 0 (count remaining)) false
      (if (contains? (set (get (first remaining) :function-syntax-ids)) id) true (recur (rest remaining))))))

(defn body-pe-reentry? [core record]
  (let [parameters (set (get record :parameter-binding-ids)) fid (get record :function-core-node-id)]
    (loop [remaining (get core :recur-transfers)]
      (if (= 0 (count remaining)) false
        (let [transfer (first remaining) target (body-pe-one (get core :recur-targets) :target-id (get transfer :target-id))]
          (if (if (= target nil) true
                (if (= fid (get target :owner-core-node-id)) true
                (loop [ids (get target :binding-ids)]
                  (if (= 0 (count ids)) false
                    (if (contains? parameters (first ids)) true (recur (rest ids)))))))
            true (recur (rest remaining))))))))

(defn body-pe-census [header core nodes bindings forms]
  ; Presence belongs to a closed parameter entry set, never a common Map shape.
  (let [receiver (get nodes (get (get (get header :source-call) :argument-node-ids) 0))
        pid (get (get receiver :attributes) :binding-id)
        parameter (get bindings pid)
        record (body-pe-one (get core :function-records) :function-syntax-id
                 (get (get receiver :evaluation) :owner-function-syntax-id))
        params (get record :parameter-binding-ids) bid (get record :definition-binding-id)
        binding (get bindings bid) definition (body-pe-one (get core :definitions) :binding-id bid)
        fn-node (get nodes (get record :function-core-node-id))
        def-node (get nodes (get definition :core-node-id))
        def-form (get forms (get (get def-node :source) :form-id))
        name-form (get forms (get (get def-form :child-form-ids) 1))
        fn-form (get forms (get record :function-form-id))
        exports (get (get core :module) :exports)
        uses (body-pe-select (get core :reference-uses) :binding-id bid)
        resolutions (body-pe-select (get (get core :preserved-resolution) :resolution-table) :binding-id bid)
        references (loop [remaining (get core :nodes) out []]
                     (if (= 0 (count remaining)) out
                       (let [node (first remaining)]
                         (recur (rest remaining)
                           (if (if (= :reference (get node :core-form))
                                 (if (= bid (get (get node :attributes) :binding-id)) true
                                   (contains? (set (get node :resolved-binding-ids)) bid)) false)
                             (conj out node) out)))))
        calls (body-pe-select (get core :calls) :operator-binding-id bid)
        edges (loop [remaining (get core :call-edges) out []]
                (if (= 0 (count remaining)) out
                  (let [edge (first remaining)]
                    (recur (rest remaining)
                      (if (if (= bid (get edge :callee-binding-id)) true
                            (= (get record :function-syntax-id) (get edge :callee-function-syntax-id)))
                        (conj out edge) out)))))
        index (loop [i 0 found nil]
                (if (= i (count params)) found
                  (recur (+ i 1) (if (= pid (get params i)) (if (= found nil) i -1) found))))]
    (if (body-all? [(= :normal (get header :application)) (map? record) (map? definition) (integer? index)
          (if (integer? index) (<= 0 index) false) (vector? params)
          (= :reference (get receiver :core-form)) (= [] (get receiver :children))
          (= [pid] (get receiver :resolved-binding-ids))
          (= :expression (get (get receiver :attributes) :position))
          (= :lexical (get parameter :binding-class) (get (get receiver :attributes) :binding-class))
          (= :local (get parameter :kind))
          (= :named-top-level (get record :definition-kind))
          (= :function (get binding :kind)) (= :namespace (get binding :binding-class))
          (= :private (get binding :visibility) (get (get def-node :attributes) :visibility))
          (= (get (get core :module) :namespace) (get binding :namespace))
          (= (get binding :name) (get definition :name) (get record :definition-name) (get name-form :value))
          (= (get binding :definition-syntax-id) (get (get def-node :attributes) :name-syntax-id) (get name-form :syntax-id))
          (= :def (get def-node :core-form)) (= :fn (get fn-node :core-form))
          (= (get record :definition-core-node-id) (get definition :core-node-id) (get def-node :node-id))
          (= [(get fn-node :node-id)] (get def-node :children))
          (= [bid] (get def-node :resolved-binding-ids))
          (= (get record :function-core-node-id) (get definition :value-node-id) (get fn-node :node-id))
          (= [(get record :body-core-node-id)] (get fn-node :children))
          (= params (get fn-node :resolved-binding-ids))
          (= (count params) (get record :fixed-arity))
          (= (get record :function-syntax-id) (get fn-form :syntax-id) (get (get fn-node :source) :syntax-id))
          (= (get record :function-form-id) (get fn-form :form-id) (get (get def-form :child-form-ids) 2))
          (vector? exports)
          (loop [remaining exports]
            (if (= 0 (count remaining)) true
              (if (if (= (str (first remaining)) (str (get binding :name))) true
                    (= (str (first remaining)) (str (get binding :namespace) "/" (get binding :name))))
                false (recur (rest remaining)))))
          (= false (body-pe-recursive? core (get record :function-syntax-id)))
          (= false (body-pe-reentry? core record))
          (= 0 (count (body-pe-select (get core :var-references) :binding-id bid)))
          (= 0 (count (body-pe-select (get core :mutations) :target-binding-id bid))
               (count (body-pe-select (get core :mutations) :target-binding-id pid)))
          (< 0 (count calls)) (= (count calls) (count edges) (count uses) (count resolutions) (count references))
          (loop [remaining calls seen #{}]
            (if (= 0 (count remaining)) true
              (let [call (first remaining) id (get call :core-node-id) node (get nodes id)
                    children (get node :children) op (get nodes (get call :operator-node-id))
                    source (get op :source) form (get forms (get source :form-id))
                    owner (get forms (get (get node :source) :form-id))
                    use (body-pe-one uses :core-node-id (get op :node-id))
                    resolution (body-pe-one resolutions :reference-syntax-id (get source :syntax-id))
                    edge (body-pe-one edges :call-core-node-id id)
                    caller (body-pe-one (get core :function-records) :function-syntax-id (get edge :caller-function-syntax-id))]
                (if (body-all? [(= false (contains? seen (get op :node-id))) (map? caller)
                      (= :call (get node :core-form)) (= :reference (get op :core-form)) (= [] (get op :children))
                      (= [bid] (get node :resolved-binding-ids) (get op :resolved-binding-ids))
                      (= {:symbol (get form :value) :position :operator :binding-id bid :binding-class :namespace
                          :definition-syntax-id (get binding :definition-syntax-id)} (get op :attributes))
                      (= :symbol (get form :kind))
                      (= {:core-node-id (get op :node-id) :form-id (get source :form-id) :syntax-id (get source :syntax-id)
                          :symbol (get form :value) :position :operator :binding-id bid :binding-class :namespace
                          :definition-syntax-id (get binding :definition-syntax-id)} use)
                      (= {:reference-syntax-id (get source :syntax-id) :symbol (get form :value) :position :operator
                          :binding-id bid :upstream-binding-id (get binding :upstream-binding-id)
                          :resolution-order (get resolution :resolution-order) :source-span (get form :source-span)} resolution)
                      (= {:core-node-id id :operator-node-id (first children) :operator-binding-id bid
                          :argument-node-ids (vec (rest children)) :ordered-evaluation-node-ids children
                          :evaluation-order :operator-then-arguments :result-policy :call-result} call)
                      (= {:ordinal (get edge :ordinal) :call-core-node-id id
                          :caller-function-syntax-id (get caller :function-syntax-id)
                          :caller-function-core-node-id (get caller :function-core-node-id)
                          :callee-binding-id bid :callee-definition-syntax-id (get binding :definition-syntax-id)
                          :callee-function-syntax-id (get record :function-syntax-id)
                          :callee-function-core-node-id (get record :function-core-node-id)
                          :argument-core-node-ids (get call :argument-node-ids) :ordered-evaluation-node-ids children
                          :evaluation-order :operator-then-arguments :classification :local-function} edge)
                      (= (get caller :function-syntax-id) (get (get node :evaluation) :owner-function-syntax-id))
                      (= :operator-then-arguments (get (get node :evaluation) :kind))
                      (= (get record :fixed-arity) (count (get call :argument-node-ids)))
                      (= :list (get owner :kind)) (= (count children) (count (get owner :child-form-ids)))
                      (loop [i 0]
                        (if (= i (count children)) true
                          (let [child (get nodes (get children i)) child-form (get forms (get (get owner :child-form-ids) i))]
                            (if (body-all? [(= (get owner :form-id) (get child-form :parent-form-id))
                                  (= (get child :source) (body-pe-form-source child-form))
                                  (= {:index i :core-node-id (get child :node-id)} (get (get (get node :evaluation) :order) i))])
                              (recur (+ i 1)) false))))])
                  (recur (rest remaining) (conj seen (get op :node-id))) false))))])
      {:kind :closed-private-parameter-entry :receiver-node-id (get receiver :node-id) :receiver-source (get receiver :source)
       :parameter-index index :parameter-binding parameter :function-record record :definition definition
       :definition-binding binding :exports exports :reference-uses uses :resolutions resolutions :calls calls :edges edges}
      nil)))

(defn body-pe-invoked? [types arguments]
  (loop [remaining arguments]
    (if (= 0 (count remaining)) true
      (if (= :gravity.type/never (get types (first remaining))) false (recur (rest remaining))))))

(defn body-pe-vector-root? [type]
  (if (map? type)
    (if (= 3 (count type))
      (if (loop [fields (keys type)]
            (if (= 0 (count fields)) true
              (if (keyword? (first fields)) (recur (rest fields)) false)))
        (if (= #{:kind :shape :element-types} (set (keys type)))
          (if (= :gravity.type/vector (get type :kind))
            (if (= :literal (get type :shape)) (vector? (get type :element-types)) false) false) false) false) false) false))

(defn body-pe-validate-selected [header census shapes types private-root?]
  ; Validate every selected Vector candidate before deep equality or finish.
  (loop [remaining (get census :calls) inputs shapes]
    (if (= 0 (count remaining))
      (if (= 0 (count inputs)) {:status :accepted}
        {:status :rejected :reason :map-get-private-entry-presence-required})
      (if (= 0 (count inputs)) {:status :rejected :reason :map-get-private-entry-presence-required}
        (let [call (first remaining) args (get call :argument-node-ids) shape (first inputs)
              ids? (if (vector? args)
                     (loop [ids args]
                       (if (= 0 (count ids)) true
                         (let [id (first ids)]
                           (if (if (keyword? id) true (if (string? id) (= 71 (count id)) false))
                             (recur (rest ids)) false)))) false)]
          (if (= false ids?) {:status :rejected :reason :map-get-private-entry-presence-required}
            (let [invoked? (body-pe-invoked? types args)
                  candidate (if invoked?
                    (let [parts (get shape :parts)
                          actual (get types (get args (get census :parameter-index)))
                          members (get actual :member-types) supplied-members (get (get shape :type) :member-types)]
                      (if (if (vector? parts) (if (vector? members) (vector? supplied-members) false) false)
                        (loop [i 0 seen #{} selected nil]
                          (if (= i (count parts)) {:status :accepted :types selected}
                            (let [part (get parts i) key (get part :key) coordinate (+ 1 (* 2 i))]
                              (if (keyword? key)
                                (if (contains? seen key) {:status :rejected}
                                  (if (= coordinate (get part :coordinate))
                                    (recur (+ i 1) (conj seen key)
                                      (if (= key (get header :key))
                                        [(get (get part :shape) :type) (get members coordinate) (get supplied-members coordinate)] selected))
                                    {:status :rejected})) {:status :rejected})))) {:status :rejected}))
                    {:status :not-invoked})
                  checked (if (= :accepted (get candidate :status))
                            (let [selected (get candidate :types)]
                              (if (vector? selected)
                                (loop [pending selected]
                                  (if (= 0 (count pending)) {:status :accepted}
                                    (let [type (first pending)]
                                      (if (body-pe-vector-root? type)
                                        (let [walked (body-lc-validate-types [type])]
                                          (if (= :accepted (get walked :status)) (recur (rest pending))
                                            {:status :rejected :reason :map-get-private-entry-selected-type-required}))
                                        (if (if (= false private-root?) true
                                            (if (keyword? type)
                                              (contains? #{:gravity.type/nil :gravity.type/bool :gravity.type/integer :gravity.type/decimal :gravity.type/ratio
                                                           :gravity.type/character :gravity.type/string :gravity.type/symbol :gravity.type/keyword
                                                           :gravity.type/i8 :gravity.type/i16 :gravity.type/i32 :gravity.type/i64
                                                           :gravity.type/u8 :gravity.type/u16 :gravity.type/u32 :gravity.type/u64 :gravity.type/f32 :gravity.type/f64} type) false))
                                          (recur (rest pending))
                                          {:status :rejected :reason :map-get-private-entry-selected-type-required})))))
                                {:status :rejected :reason :map-get-private-entry-presence-required}))
                            (if (= :not-invoked (get candidate :status)) {:status :accepted}
                              {:status :rejected :reason :map-get-private-entry-presence-required}))]
              (if (= :accepted (get checked :status))
                (recur (rest remaining) (rest inputs)) checked))))))))

(defn body-pe-finish [header census shapes core nodes types]
  (if (map? census)
    (loop [remaining (get census :calls) inputs shapes entries [] selected nil normal-count 0]
      (if (= 0 (count remaining))
        (if (if (= 0 (count inputs)) (< 0 normal-count) false)
          (assoc header :version :sh08-map-get-private-entry-v1
            :lookup-policy (assoc (get header :lookup-policy) :input :closed-private-parameter-entries)
            :invalidation (conj (get header :invalidation) :visibility :exports :reference-uses :resolution-table
                            :var-references :mutations :recur-targets :recur-transfers :incoming-arguments)
            :parameter-types (get header :argument-types) :return selected :result-type selected
            :presence-proof {:kind :private-call-entry-key-presence :key (get header :key)
                             :entry-census census :entries entries :selected-type selected}) nil)
        (let [call (first remaining) args (get call :argument-node-ids)
              argument-id (get args (get census :parameter-index))
              argument-type (get types argument-id) invoked? (body-pe-invoked? types args)
              shape (first inputs)
              part (if (if invoked? (= argument-type (get (get header :argument-types) 0)) false) (body-mg-present-selection
                                  (assoc header :argument-types [argument-type :gravity.type/keyword]) shape) nil)
              value-type (get (get part :shape) :type)]
          (if (body-all? [(< 0 (count inputs))
                (loop [ids args] (if (= 0 (count ids)) true
                  (if (contains? #{nil :gravity.type/unknown} (get types (first ids))) false (recur (rest ids)))))
                (if invoked?
                  (body-all? [(map? part)
                    (if (body-pe-vector-root? value-type) true
                    (if (keyword? value-type) (contains? #{:gravity.type/nil :gravity.type/bool :gravity.type/integer :gravity.type/decimal :gravity.type/ratio
                                 :gravity.type/character :gravity.type/string :gravity.type/symbol :gravity.type/keyword
                                 :gravity.type/i8 :gravity.type/i16 :gravity.type/i32 :gravity.type/i64
                                 :gravity.type/u8 :gravity.type/u16 :gravity.type/u32 :gravity.type/u64 :gravity.type/f32 :gravity.type/f64} value-type) false))
                    (if (= normal-count 0) true (= selected value-type))])
                  (= shape nil))])
            (recur (rest remaining) (rest inputs)
              (conj entries {:call-core-node-id (get call :core-node-id) :argument-node-id argument-id
                            :argument-source (get (get nodes argument-id) :source) :argument-type argument-type
                            :argument-types (loop [ids args out []] (if (= 0 (count ids)) out
                                              (recur (rest ids) (conj out (get types (first ids))))))
                            :entry (if invoked? :invoked :not-invoked) :argument-shape shape
                            :selected-part part :selected-coordinate (get part :coordinate) :selected-type value-type})
              (if invoked? value-type selected) (if invoked? (+ normal-count 1) normal-count)) nil)))) nil))

(defn body-pe-check [header descriptor core nodes bindings forms types]
  ; Reconstruct the census and validate selected types before finishing.
  ; Return semantic status and the freshly derived descriptor.
  (let [census (body-pe-census header core nodes bindings forms)
        entries (get (get descriptor :presence-proof) :entries)]
    (if (if (map? census) (if (vector? entries) (= (count entries) (count (get census :calls))) false) false)
      (let [shapes (loop [remaining entries out []]
                     (if (= 0 (count remaining)) out
                       (recur (rest remaining) (conj out (get (first remaining) :argument-shape)))))
            checked (body-pe-validate-selected header census shapes types true)
            expected (if (= :accepted (get checked :status)) (body-pe-finish header census shapes core nodes types) nil)]
        (if (map? expected) (assoc checked :descriptor expected)
          (if (= :rejected (get checked :status)) checked
            {:status :rejected :reason :map-get-private-entry-presence-required})))
      {:status :rejected :reason :map-get-private-entry-presence-required})))

(defn body-pe-recheck [header descriptor core nodes bindings forms types]
  (let [census (body-pe-census header core nodes bindings forms)
        entries (get (get descriptor :presence-proof) :entries)]
    (if (if (map? census) (if (vector? entries) (= (count entries) (count (get census :calls))) false) false)
      (let [shapes (loop [remaining entries out []]
                     (if (= 0 (count remaining)) out
                       (recur (rest remaining) (conj out (get (first remaining) :argument-shape)))))]
        (body-pe-finish header census shapes core nodes types)) nil)))

(defn body-pc-id? [id]
  (if (keyword? id) true (if (string? id) (= 71 (count id)) false)))

(defn body-pc-current-node [id nodes]
  (if (body-pc-id? id)
    (let [node (get nodes id)] (if (map? node) (if (= id (get node :node-id)) node nil) nil)) nil))

(defn body-pc-even-count? [values]
  (if (vector? values)
    (loop [remaining values]
      (if (= 0 (count remaining)) true
        (if (= 1 (count remaining)) false (recur (rest (rest remaining)))))) false))

(defn body-pc-link-core? [record node core nodes bindings]
  (let [bid (get record :binding-id) owner-id (get record :let-core-node-id)
        initializer-id (get record :initializer-node-id) index (get record :ordinal)]
    (if (if (body-pc-id? bid) (if (body-pc-id? owner-id)
          (if (body-pc-id? initializer-id) (if (integer? index) (<= 0 index) false) false) false) false)
      (let [owner (body-pc-current-node owner-id nodes) initializer (body-pc-current-node initializer-id nodes)
            binding (get bindings bid) children (get owner :children) ids (get owner :resolved-binding-ids)
            attrs (get node :attributes) source (get initializer :source)]
        (if (if (map? owner)
              (if (map? initializer)
                (if (map? binding)
                  (if (vector? children)
                    (if (vector? ids)
                      (if (< index (count children)) (< index (count ids)) false)
                      false)
                    false)
                  false)
                false)
              false)
          (if (if (symbol? (get record :name)) (if (symbol? (get binding :name)) (symbol? (get attrs :symbol)) false) false)
            (if (loop [remaining [(get record :definition-syntax-id) (get binding :definition-syntax-id)
                                 (get record :binding-scope-id) (get binding :scope-id)
                                 (get record :initializer-form-id) (get source :form-id)
                                 (get record :initializer-syntax-id) (get source :syntax-id)
                                 (get (get node :evaluation) :owner-function-syntax-id)
                                 (get (get initializer :evaluation) :owner-function-syntax-id)]]
                  (if (= 0 (count remaining)) true
                    (if (body-pc-id? (first remaining)) (recur (rest remaining)) false)))
              (body-all?
                [(= :immutable (get record :mutability)) (= :let (get owner :core-form))
                 (= :reference (get node :core-form))
                 (if (vector? (get node :children)) (= 0 (count (get node :children))) false)
                 (if (vector? (get node :resolved-binding-ids)) (= [bid] (get node :resolved-binding-ids)) false)
                 (= bid (get attrs :binding-id)) (= :lexical (get attrs :binding-class) (get binding :binding-class))
                 (if (= nil (get binding :mutability)) true (= :immutable (get binding :mutability)))
                 (= initializer-id (get children index)) (= bid (get ids index))
                 (= (get record :definition-syntax-id) (get binding :definition-syntax-id))
                 (= (get record :name) (get binding :name) (get attrs :symbol))
                 (= (get record :binding-scope-id) (get binding :scope-id))
                 (= (get record :initializer-form-id) (get source :form-id))
                 (= (get record :initializer-syntax-id) (get source :syntax-id))
                 (= (get (get node :evaluation) :owner-function-syntax-id)
                    (get (get initializer :evaluation) :owner-function-syntax-id))
                 (loop [remaining (get core :mutations)]
                   (if (= 0 (count remaining)) true
                     (if (= bid (get (first remaining) :target-binding-id)) false (recur (rest remaining)))))]) false) false) false)) false)))

(defn body-pc-unroll [id core nodes bindings]
  (loop [current id links [] seen #{}]
    (if (= false (body-pc-id? current))
      {:status :rejected :reason :map-get-source-mismatch}
      (if (contains? seen current)
        {:status :rejected :reason :map-get-source-mismatch}
        (let [node (body-pc-current-node current nodes)]
          (if (map? node)
            (if (= :reference (get node :core-form))
              (if (if (vector? (get core :lexical-bindings)) (vector? (get core :mutations)) false)
                (let [bid (get (get node :attributes) :binding-id)
                      record (if (body-pc-id? bid) (body-pe-one (get core :lexical-bindings) :binding-id bid) nil)
                      initializer (body-pc-current-node (get record :initializer-node-id) nodes)
                      binding (if (body-pc-id? bid) (get bindings bid) nil)
                      measured (body-pc-evidence-work
                                {:record-name (get record :name) :binding-name (get binding :name)
                                 :reference-name (get (get node :attributes) :symbol)
                                 :definition (get record :definition-syntax-id) :binding-definition (get binding :definition-syntax-id)
                                 :record-scope (get record :binding-scope-id) :binding-scope (get binding :scope-id)
                                 :initializer-source (get initializer :source)})]
                  (if (= :accepted (get measured :status))
                    (if (if (map? record) (body-pc-link-core? record node core nodes bindings) false)
                      (recur (get record :initializer-node-id)
                        (conj links {:reference-core-node-id current :reference-source (get node :source)
                                     :binding-record record}) (conj seen current))
                      {:status :rejected :reason :map-get-source-mismatch})
                    measured))
                {:status :rejected :reason :map-get-source-mismatch})
              {:status :accepted :node-id current :links links})
            {:status :rejected :reason :map-get-source-mismatch}))))))

(defn body-pc-evidence-work [proof]
  ; Validate nested evidence values without charging a resource envelope.
  ; Parent reconstruction still owns the closed field domains and equality checks.
  (loop [pending [proof]]
    (if (= 0 (count pending))
      {:status :accepted}
      (let [value (first pending) tail (rest pending)]
        (if (map? value)
          (let [entries (vec value)
                next (loop [remaining entries out tail]
                       (if (= 0 (count remaining)) out
                         (let [entry (first remaining)]
                           (recur (rest remaining) (conj (conj out (get entry 0)) (get entry 1))))))]
            (recur next))
          (if (vector? value)
            (recur (loop [remaining value out tail]
                     (if (= 0 (count remaining)) out
                       (recur (rest remaining) (conj out (first remaining))))))
            (if (if (= nil value) true
                  (if (boolean? value) true
                    (if (keyword? value) true
                      (if (symbol? value) true
                        (if (string? value) true
                          (if (integer? value) true (char? value)))))))
              (recur tail)
              {:status :rejected :reason :map-get-source-mismatch})))))))

(defn body-pc-data-child [value family key]
  (if (= :map family)
    (if (if (keyword? key) (map? value) false)
      (loop [remaining (vec value) seen #{} found? false selected nil]
        (if (= 0 (count remaining))
          (if found? {:status :accepted :value selected}
            {:status :rejected :reason :map-get-private-entry-presence-required})
          (let [entry (first remaining) actual-key (get entry 0)]
            (if (keyword? actual-key)
              (if (contains? seen actual-key)
                {:status :rejected :reason :map-get-source-mismatch}
                (recur (rest remaining) (conj seen actual-key) (if (= key actual-key) true found?)
                  (if (= key actual-key) (get entry 1) selected)))
              {:status :rejected :reason :map-get-source-mismatch}))))
      {:status :rejected :reason :map-get-source-mismatch})
    (if (if (= :vector family) (if (= 0 key) (if (vector? value) (< 0 (count value)) false) false) false)
      {:status :accepted :value (get value 0) :vector-length (count value)}
      {:status :rejected :reason :map-get-source-mismatch})))

(defn body-pc-reanchor [quote-id selectors nodes]
  (if (if (body-pc-id? quote-id) (vector? selectors) false)
    (let [node (body-pc-current-node quote-id nodes) attrs (get node :attributes)
          value (get attrs :quoted-value)]
      (if (body-all?
            [(map? node) (= :quote (get node :core-form))
             (if (vector? (get node :children)) (= 0 (count (get node :children))) false)
             (if (vector? (get node :resolved-binding-ids)) (= 0 (count (get node :resolved-binding-ids))) false)
             (= :no-evaluation (get (get node :evaluation) :kind))
             (if (vector? (get (get node :evaluation) :order)) (= 0 (count (get (get node :evaluation) :order))) false)
             (body-pc-id? (get attrs :quoted-form-id)) (body-pc-id? (get attrs :quoted-syntax-id))
             (if (= :map (get attrs :quoted-kind)) (map? value)
               (if (= :vector (get attrs :quoted-kind)) (vector? value) false))])
        (loop [remaining selectors current value]
          (if (= 0 (count remaining)) {:status :accepted :value current}
            (let [selector (first remaining)
                  fields? (if (map? selector)
                            (if (= 1 (count selector))
                              (loop [keys (keys selector)]
                                (if (= 0 (count keys)) true
                                  (if (keyword? (first keys)) (recur (rest keys)) false)))
                              false)
                            false)]
              (if fields?
                (let [family (if (contains? selector :key) :map (if (contains? selector :index) :vector :unsupported))
                      key (if (= :map family) (get selector :key) (get selector :index))
                      child (body-pc-data-child current family key)]
                  (if (= :accepted (get child :status))
                    (recur (rest remaining) (get child :value))
                    child))
                {:status :rejected :reason :map-get-source-mismatch}))))
        {:status :rejected :reason :map-get-source-mismatch}))
    {:status :rejected :reason :map-get-source-mismatch}))

(defn body-pc-core-child [cursor family key nodes]
  ; Quoted cursors carry logical selectors only. Re-read current C6 data.
  (if (if (= :map family) (keyword? key) (if (= :vector family) (= nil key) false))
    (let [mode (get cursor :source-kind) id (get cursor :node-id)
          node (if (= :core mode) (body-pc-current-node id nodes) nil)
          quote? (if (map? node) (= :quote (get node :core-form)) false)]
      (if (if (= :quoted-data mode) true quote?)
        (let [quote-id (if quote? id (get cursor :quote-core-node-id))
              selectors (if quote? [] (get cursor :selectors))
              anchored (body-pc-reanchor quote-id selectors nodes)]
          (if (= :accepted (get anchored :status))
            (let [child (body-pc-data-child (get anchored :value) family (if (= :vector family) 0 key))]
              (if (= :accepted (get child :status))
                {:status :accepted
                 :cursor {:source-kind :quoted-data :quote-core-node-id quote-id
                          :selectors (conj selectors (if (= :map family) {:key key} {:index 0}))}
                 :location (if (= :map family)
                             {:source-kind :quoted-data :quote-core-node-id quote-id :selectors selectors :key key}
                             {:source-kind :quoted-data :quote-core-node-id quote-id :selectors selectors
                              :coordinate 0 :vector-length (get child :vector-length)})}
                child))
            anchored))
        (let [children (get node :children) width (if (vector? children) (count children) 0)]
          (if (if (= :core mode) (if (map? node) (if (= :collection-literal (get node :core-form))
                (if (= family (get (get node :attributes) :literal-kind))
                  (if (vector? children) (= width (get (get node :attributes) :element-count)) false)
                  false) false) false) false)
            (if (if (= :map family) (body-pc-even-count? children) (< 0 width))
              (if (= :map family)
                (loop [i 0 seen #{} selected nil]
                  (if (= i width)
                    (if (map? selected) (assoc selected :status :accepted)
                      {:status :rejected :reason :map-get-private-entry-presence-required})
                    (let [key-id (get children i) value-id (get children (+ i 1))
                          key-node (body-pc-current-node key-id nodes) value-node (body-pc-current-node value-id nodes)
                          actual-key (get (get key-node :attributes) :value)]
                      (if (if (map? key-node) (if (map? value-node)
                            (if (= :literal (get key-node :core-form))
                              (if (= :keyword (get (get key-node :attributes) :literal-kind))
                                (if (keyword? actual-key)
                                  (if (vector? (get key-node :children))
                                    (if (= 0 (count (get key-node :children)))
                                      (if (vector? (get key-node :resolved-binding-ids))
                                        (= 0 (count (get key-node :resolved-binding-ids))) false) false) false)
                                  false) false) false) false) false)
                        (if (contains? seen actual-key)
                          {:status :rejected :reason :map-get-source-mismatch}
                          (recur (+ i 2) (conj seen actual-key)
                            (if (= key actual-key)
                              {:cursor {:source-kind :core :node-id value-id}
                               :location {:source-kind :evaluated :parent-core-node-id id :coordinate (+ i 1)
                                          :key actual-key :key-node-id key-id :value-node-id value-id}} selected)))
                        {:status :rejected :reason :map-get-source-mismatch}))))
                (let [child-id (get children 0) child (body-pc-current-node child-id nodes)]
                  (if (map? child)
                    {:status :accepted :cursor {:source-kind :core :node-id child-id}
                     :location {:source-kind :evaluated :parent-core-node-id id :coordinate 0 :value-node-id child-id :vector-length width}}
                    {:status :rejected :reason :map-get-source-mismatch})))
              {:status :rejected :reason :map-get-source-mismatch})
            {:status :rejected :reason :map-get-source-mismatch}))))
    {:status :rejected :reason :map-get-source-mismatch}))

(defn body-pc-data-origin [quote-id form path]
  {:kind :quoted-data :quote-core-node-id quote-id :form-id (get form :form-id)
   :syntax-id (get form :syntax-id) :data-path path :child-form-ids (get form :child-form-ids)})

(defn body-pc-quoted-parent [quote-id path nodes forms]
  (if (if (body-pc-id? quote-id) (vector? path) false)
    (let [node (get nodes quote-id) attrs (get node :attributes) source (get node :source)
          owner-id (get source :form-id) payload-id (get attrs :quoted-form-id)
          measured (body-pc-evidence-work {:source source :path path
                                           :payload-id payload-id :payload-syntax-id (get attrs :quoted-syntax-id)})]
      (if (= :rejected (get measured :status))
        measured
        (if (if (body-pc-id? owner-id) (body-pc-id? payload-id) false)
          (let [owner (get forms owner-id) ids (get owner :child-form-ids)]
            (if (if (vector? ids) (= 2 (count ids)) false)
              (if (body-pc-id? (get ids 0))
                (let [operator (get forms (get ids 0)) payload (get forms payload-id)]
                  (if (body-all?
                        [(= :quote (get node :core-form)) (= :list (get owner :kind))
                         (= owner-id (get owner :form-id)) (= (get ids 0) (get operator :form-id))
                         (= source (body-pe-form-source owner))
                         (= 'quote (get operator :value)) (= :symbol (get operator :kind))
                         (= [] (get operator :child-form-ids))
                         (= owner-id (get operator :parent-form-id) (get payload :parent-form-id))
                         (= payload-id (get ids 1) (get payload :form-id))
                         (= (get attrs :quoted-syntax-id) (get payload :syntax-id))
                         (= (get attrs :quoted-kind) (get payload :kind))
                         (= [] (get node :children) (get node :resolved-binding-ids))
                         (= :no-evaluation (get (get node :evaluation) :kind)) (= [] (get (get node :evaluation) :order))])
                    (loop [current payload remaining path traversed []]
                      (if (= 0 (count remaining))
                        {:status :accepted :form current :data-path traversed}
                        (let [children (get current :child-form-ids) index (first remaining)]
                          (if (if (vector? children) (if (integer? index) (if (<= 0 index) (< index (count children)) false) false) false)
                            (let [child-id (get children index)]
                              (if (body-pc-id? child-id)
                                (let [child (get forms child-id)]
                                  (if (if (= child-id (get child :form-id))
                                        (= (get current :form-id) (get child :parent-form-id)) false)
                                    (recur child (rest remaining) (conj traversed index))
                                    {:status :rejected :reason :map-get-source-mismatch}))
                                {:status :rejected :reason :map-get-source-mismatch}))
                            {:status :rejected :reason :map-get-source-mismatch}))))
                    {:status :rejected :reason :map-get-source-mismatch}))
                {:status :rejected :reason :map-get-source-mismatch})
              {:status :rejected :reason :map-get-source-mismatch}))
          {:status :rejected :reason :map-get-source-mismatch})))
    {:status :rejected :reason :map-get-source-mismatch}))

(defn body-pc-value-kind [value]
  ; Selected BU leaves are nil, Bool, Integer, Keyword, String, or Symbol.
  ; Character remains with its existing authenticated owner.
  (if (= nil value) :nil
    (if (boolean? value) :boolean
      (if (keyword? value) :keyword
        (if (string? value) :string
          (if (integer? value) :integer (if (symbol? value) :symbol :unsupported)))))))

(defn body-pc-literal-type [kind]
  (if (keyword? kind)
    (get {:nil :gravity.type/nil :boolean :gravity.type/bool :integer :gravity.type/integer
          :keyword :gravity.type/keyword :string :gravity.type/string :symbol :gravity.type/symbol} kind) nil))

(defn body-pc-leaf [cursor shape nodes]
  (let [mode (get cursor :source-kind) id (get cursor :node-id)
        node (if (= :core mode) (body-pc-current-node id nodes) nil)
        anchored (if (= :quoted-data mode)
                   (body-pc-reanchor (get cursor :quote-core-node-id) (get cursor :selectors) nodes)
                   (if (= :core mode) {:status :accepted :value (get (get node :attributes) :value)}
                     {:status :rejected :reason :map-get-source-mismatch}))
        value (get anchored :value)
        measured (if (= :accepted (get anchored :status))
                   (body-pc-evidence-work {:value value :shape shape :current-source (get node :source)
                                           :source-path (get cursor :source-path)}) anchored)]
    (if (= :accepted (get measured :status))
      (let [kind (body-pc-value-kind value) type (body-pc-literal-type kind)
            domain (get shape :domain) values (get domain :values)
            fields (if (= :core mode)
                     #{:node-id :type :source :binding-links :status :shape-kind :domain}
                     #{:status :type :data-origin :source :binding-links :shape-kind :domain})]
        (if (if (= :core mode)
              (if (map? node) (if (= :literal (get node :core-form)) (= kind (get (get node :attributes) :literal-kind)) false) false)
              (= :quoted-data mode))
          (if (if (map? shape) (if (= 7 (count shape))
                (loop [keys (keys shape)] (if (= 0 (count keys)) true
                  (if (keyword? (first keys)) (recur (rest keys)) false))) false) false)
            (if (body-all?
                  [(= fields (set (keys shape))) (keyword? type) (= type (get shape :type))
                   (= :accepted (get shape :status)) (= :scalar (get shape :shape-kind))
                   (if (vector? (get shape :binding-links)) (= 0 (count (get shape :binding-links))) false)
                   (if (= :core mode) (if (= id (get shape :node-id)) (= (get node :source) (get shape :source)) false)
                     (if (if (= (get (get shape :source) :form-id) (get (get shape :data-origin) :form-id))
                             (= (get (get shape :source) :syntax-id) (get (get shape :data-origin) :syntax-id)) false)
                       (if (= :quoted-data (get (get shape :data-origin) :kind))
                         (if (= (get cursor :quote-core-node-id) (get (get shape :data-origin) :quote-core-node-id))
                           (= (get cursor :source-path) (get (get shape :data-origin) :data-path)) false) false) false))
                   (if (map? domain) (if (= 1 (count domain)) (contains? domain :values) false) false)
                   (if (vector? values) (if (= 1 (count values)) (= value (get values 0)) false) false)])
              {:status :accepted :type type :value value}
              {:status :rejected :reason :map-get-source-mismatch})
            {:status :rejected :reason :map-get-source-mismatch})
          {:status :rejected :reason :map-get-source-mismatch}))
      measured)))

(defn body-pc-key-part [shape key expected]
  (let [parts (get shape :parts) width (if (vector? parts) (count parts) 0)]
    (if (if (keyword? key) (vector? parts) false)
      (let [checked (body-lc-validate-types [(get shape :type)])]
        (if (= :accepted (get checked :status))
          (if (if (map? expected) (if (= :gravity.type/map (get expected :kind))
                (vector? (get expected :member-types)) false) false)
            (if (body-all? [(= :accepted (get shape :status)) (= :map (get shape :shape-kind))
                (= expected (get shape :type)) (= :gravity.type/map (get expected :kind))
                (= (* 2 width) (count (get expected :member-types)))])
              (loop [i 0 seen #{} selected nil]
                (if (= i width)
                  (if (map? selected) {:status :accepted :part selected}
                    {:status :rejected :reason :map-get-private-first-entry-presence-required})
                  (let [part (get parts i) part-key (get part :key) coordinate (+ 1 (* 2 i))]
                    (if (keyword? part-key)
                      (if (contains? seen part-key)
                        {:status :rejected :reason :map-get-source-mismatch}
                        (if (= coordinate (get part :coordinate))
                          (if (= :gravity.type/keyword (get (get expected :member-types) (* 2 i)))
                            (if (= key part-key)
                              (let [type (get (get part :shape) :type)]
                                (if (if (keyword? type)
                                      (contains? #{:gravity.type/nil :gravity.type/bool :gravity.type/integer :gravity.type/keyword
                                                   :gravity.type/string :gravity.type/symbol} type) false)
                                  (if (= type (get (get expected :member-types) coordinate))
                                    (recur (+ i 1) (conj seen part-key) part)
                                    {:status :rejected :reason :map-get-source-mismatch})
                                  {:status :rejected :reason :map-get-private-first-entry-presence-required}))
                              (recur (+ i 1) (conj seen part-key) selected))
                            {:status :rejected :reason :map-get-source-mismatch})
                          {:status :rejected :reason :map-get-source-mismatch}))
                      {:status :rejected :reason :map-get-source-mismatch}))))
              {:status :rejected :reason :map-get-source-mismatch})
            {:status :rejected :reason :map-get-source-mismatch})
          checked))
      {:status :rejected :reason :map-get-source-mismatch})))

(defn body-pc-position [cursor child shape part nodes]
  ; source-path joins retained C7 origins; it never selects a payload value.
  (let [location (get child :location) kind (get location :source-kind)
        metadata {:source (get shape :source) :origin (get shape :data-origin)
                  :key-origin (get part :key-data-origin) :value-origin (get part :value-data-origin)
                  :child-source (get (get part :shape) :source) :child-origin (get (get part :shape) :data-origin)
                  :source-path (get cursor :source-path)}
        measured (body-pc-evidence-work metadata)
        coordinate (get part :coordinate) family (get shape :shape-kind) key (get part :key)]
    (if (= :accepted (get measured :status))
      (if (if (integer? coordinate) (<= 0 coordinate) false)
        (if (= :evaluated kind)
          (let [parent-id (get location :parent-core-node-id) value-id (get location :value-node-id)
                key-id (get location :key-node-id)]
            (if (if (body-pc-id? parent-id) (if (body-pc-id? value-id)
                  (if (= :map family) (body-pc-id? key-id) (= :vector family)) false) false)
              (let [parent (get nodes parent-id) value (get nodes value-id) key-node (if (= :map family) (get nodes key-id) nil)]
                (if (body-all?
                      [(= parent-id (get shape :constructor-node-id)) (= (get shape :source) (get parent :source))
                       (= coordinate (get location :coordinate)) (= key (get location :key))
                       (= value-id (get part :value-node-id))
                       (if (= :map family) (= key-id (get part :key-node-id)) true)])
                  {:status :accepted :cursor (get child :cursor) :location location
                   :source {:source-kind kind :parent-form-id (get (get parent :source) :form-id)
                            :parent-syntax-id (get (get parent :source) :syntax-id) :quote-core-node-id nil :data-path nil
                            :coordinate coordinate :key key :key-form-id (get (get key-node :source) :form-id)
                            :value-form-id (get (get value :source) :form-id) :value-syntax-id (get (get value :source) :syntax-id)}}
                  {:status :rejected :reason :map-get-source-mismatch}))
              {:status :rejected :reason :map-get-source-mismatch}))
          (if (= :quoted-data kind)
            (let [origin (get shape :data-origin) path (get origin :data-path) ids (get origin :child-form-ids)
                  quote-id (get location :quote-core-node-id) value-origin (get part :value-data-origin)
                  key-origin (get part :key-data-origin) source (get shape :source)
                  parent-core? (= :core (get cursor :source-kind))
                  quote-node (if (if parent-core? (body-pc-id? (get cursor :node-id)) false)
                               (get nodes (get cursor :node-id)) nil)]
              (if (if (vector? path) (if (vector? ids) (< coordinate (count ids)) false) false)
                (if (body-all?
                      [(= :quoted-data (get shape :constructor-origin)) (= :quoted-data (get origin :kind))
                       (= quote-id (get origin :quote-core-node-id) (get value-origin :quote-core-node-id))
                       (= (get origin :form-id) (get source :form-id)) (= (get origin :syntax-id) (get source :syntax-id))
                       (= (get ids coordinate) (get value-origin :form-id))
                       (= :quoted-data (get value-origin :kind)) (= (conj path coordinate) (get value-origin :data-path))
                       (= value-origin (get (get part :shape) :data-origin))
                       (if (= :map family)
                         (body-all? [(keyword? key) (= key (get location :key)) (< 0 coordinate)
                           (= :quoted-data (get key-origin :kind)) (= quote-id (get key-origin :quote-core-node-id))
                           (= (get ids (- coordinate 1)) (get key-origin :form-id))
                           (= (conj path (- coordinate 1)) (get key-origin :data-path))])
                         (if (= :vector family) (if (= nil key) (= 0 coordinate (get location :coordinate)) false) false))
                       (if parent-core?
                         (if (= :quote (get quote-node :core-form))
                           (if (= [] path)
                             (body-all? [(= quote-id (get quote-node :node-id))
                               (= (get origin :form-id) (get (get quote-node :attributes) :quoted-form-id))
                               (= (get origin :syntax-id) (get (get quote-node :attributes) :quoted-syntax-id))]) false) false)
                         (if (= :quoted-data (get cursor :source-kind))
                           (if (= quote-id (get cursor :quote-core-node-id)) (= path (get cursor :source-path)) false) false))])
                  {:status :accepted :cursor (assoc (get child :cursor) :source-path (conj path coordinate))
                   :location (assoc location :data-path path :coordinate coordinate)
                   :source {:source-kind kind :parent-form-id (get origin :form-id) :parent-syntax-id (get origin :syntax-id)
                            :quote-core-node-id quote-id :data-path path :coordinate coordinate :key key
                            :key-form-id (get key-origin :form-id) :value-form-id (get value-origin :form-id)
                            :value-syntax-id (get value-origin :syntax-id)}}
                  {:status :rejected :reason :map-get-source-mismatch})
                {:status :rejected :reason :map-get-source-mismatch}))
            {:status :rejected :reason :map-get-source-mismatch}))
        {:status :rejected :reason :map-get-source-mismatch})
      measured)))

(defn body-pc-current-entry [entry outer-key key vector-type map-type nodes]
  ; Expected types are results of current BT/BS reconstruction, not supplied proof types.
  (let [argument-id (get entry :argument-node-id) call-id (get entry :call-core-node-id)
        row {:call-core-node-id call-id :argument-node-id argument-id
             :argument-source (get entry :argument-source) :entry (get entry :entry)}]
    (if (if (body-pc-id? argument-id) (body-pc-id? call-id) false)
      (let [current (body-pc-current-node argument-id nodes)
            source-check (body-pc-evidence-work [(get entry :argument-source) (get current :source)])]
        (if (= :accepted (get source-check :status))
          (if (if (map? current) (if (body-pc-source-domain? (get entry :argument-source))
                (= (get entry :argument-source) (get current :source)) false) false)
            (if (= :not-invoked (get entry :entry))
              {:status :accepted :row (assoc row :selection nil)}
              (if (= :invoked (get entry :entry))
                (let [argument (get entry :argument-shape) outer (get entry :selected-part) vector (get outer :shape)
                      vector-parts (get vector :parts) length (if (vector? vector-parts) (count vector-parts) 0)]
                  (if (if (vector? vector-parts) (if (< 0 length)
                        (if (map? vector-type) (if (= :gravity.type/vector (get vector-type :kind))
                          (if (vector? (get vector-type :element-types))
                            (if (map? map-type) (= :gravity.type/map (get map-type :kind)) false) false) false) false) false) false)
                    (let [head (get vector-parts 0) map-shape (get head :shape)
                          selected (body-pc-key-part map-shape key map-type)]
                      (if (= :accepted (get selected :status))
                        (if (body-all?
                              [(= vector-type (get vector :type)) (= :vector (get vector :shape-kind))
                               (= length (count (get vector-type :element-types))) (= 0 (get head :coordinate))
                               (= nil (get head :key)) (= map-type (get (get vector-type :element-types) 0))])
                          (loop [i 0 cursor {:source-kind :core :node-id argument-id} sources [] locations []]
                            (if (= i 3)
                              (let [leaf (body-pc-leaf cursor (get (get selected :part) :shape) nodes)]
                                (if (= :accepted (get leaf :status))
                                  {:status :accepted :leaf-cursor cursor
                                   :shapes [argument vector map-shape] :parts [outer head (get selected :part)] :locations locations
                                   :row (assoc row :selection {:vector-coordinate 0 :key key
                                           :coordinate (get (get selected :part) :coordinate)
                                           :part (get selected :part) :type (get leaf :type)
                                           :source-spine sources :logical-path [outer-key 0 key]})}
                                  leaf))
                              (let [family (get [:map :vector :map] i)
                                    demanded-key (get [outer-key nil key] i)
                                    shape (get [argument vector map-shape] i)
                                    selected-part (get [outer head (get selected :part)] i)
                                    child (body-pc-core-child cursor family demanded-key nodes)]
                                (if (= :accepted (get child :status))
                                  (if (if (= i 1) (= length (get (get child :location) :vector-length)) true)
                                    (let [position (body-pc-position cursor child shape selected-part nodes)]
                                      (if (= :accepted (get position :status))
                                        (recur (+ i 1) (get position :cursor) (conj sources (get position :source))
                                          (conj locations (get position :location)))
                                        position))
                                    {:status :rejected :reason :map-get-source-mismatch})
                                  child))))
                          {:status :rejected :reason :map-get-source-mismatch})
                        selected))
                    {:status :rejected :reason :map-get-private-first-entry-presence-required}))
                {:status :rejected :reason :map-get-source-mismatch}))
            {:status :rejected :reason :map-get-source-mismatch})
          source-check))
      {:status :rejected :reason :map-get-source-mismatch})))

(defn body-pc-source-step [location shape nodes forms]
  ; Replay one demanded collection level. Unselected values stay inert.
  (let [kind (get location :source-kind) parts (get shape :parts)
        measured (body-pc-evidence-work {:location location :source (get shape :source)
                                         :origin (get shape :data-origin)})
        parent-node (if (= :evaluated kind) (if (body-pc-id? (get location :parent-core-node-id))
                      (get nodes (get location :parent-core-node-id)) nil) nil)
        parent-id (get (get parent-node :source) :form-id)
        opened (if (= :accepted (get measured :status))
                 (if (= :quoted-data kind)
                   (body-pc-quoted-parent (get location :quote-core-node-id) (get location :data-path) nodes forms)
                   (if (= :evaluated kind)
                     (if (body-pc-id? parent-id) {:status :accepted :form (get forms parent-id)}
                       {:status :rejected :reason :map-get-source-mismatch})
                     {:status :rejected :reason :map-get-source-mismatch})) measured)]
    (if (= :accepted (get opened :status))
      (let [parent (get opened :form) ids (get parent :child-form-ids) family (get parent :kind)
            width (if (vector? parts) (count parts) 0)]
        (if (if (vector? parts) (if (vector? ids)
              (if (= :map family) (= (* 2 width) (count ids))
                (if (= :vector family) (= width (count ids)) false)) false) false)
          (if (body-all?
                [(= :accepted (get shape :status)) (= family (get shape :shape-kind))
                 (if (vector? (get shape :binding-links)) (= 0 (count (get shape :binding-links))) false)
                 (if (= nil (get shape :call-links)) true
                   (if (vector? (get shape :call-links)) (= 0 (count (get shape :call-links))) false))
                 (= (get shape :source) (body-pe-form-source parent))
                 (if (= :quoted-data kind)
                   (if (= :quoted-data (get shape :constructor-origin))
                     (= (get shape :data-origin) (body-pc-data-origin (get location :quote-core-node-id) parent (get location :data-path))) false)
                   (if (= :collection-literal (get parent-node :core-form))
                     (if (= family (get (get parent-node :attributes) :literal-kind))
                       (if (= (count ids) (count (get parent-node :children)) (get (get parent-node :attributes) :element-count))
                         (= (get shape :constructor-node-id) (get parent-node :node-id)) false) false) false))])
            (loop [i 0 seen #{} selected nil]
              (if (= i width)
                (if (map? selected) {:status :accepted :source selected}
                  {:status :rejected :reason :map-get-source-mismatch})
                (let [part (get parts i) coordinate (if (= :map family) (+ 1 (* 2 i)) i)
                      key-coordinate (if (= :map family) (* 2 i) nil)
                      key-id (if (= :map family) (get ids key-coordinate) nil) value-id (get ids coordinate)
                      evidence (body-pc-evidence-work
                                 {:key (get part :key) :key-origin (get part :key-data-origin)
                                  :value-origin (get part :value-data-origin)})]
                  (if (= :accepted (get evidence :status))
                    (if (if (body-pc-id? value-id) (if (= :map family) (body-pc-id? key-id) true) false)
                      (let [key-form (if (= :map family) (get forms key-id) nil) value-form (get forms value-id)
                            actual-key (get key-form :value)
                            actual-key? (if (= :map family) (if (= :keyword (get key-form :kind)) (keyword? actual-key) false) true)
                            children (get parent-node :children)
                            key-node-id (if (= :map family) (get children key-coordinate) nil)
                            value-node-id (get children coordinate)]
                        (if actual-key?
                          (if (if (= :map family) (contains? seen actual-key) false)
                            {:status :rejected :reason :map-get-source-mismatch}
                            (if (body-all?
                                  [(= coordinate (get part :coordinate)) (= actual-key (get part :key))
                                   (= value-id (get value-form :form-id))
                                   (if (= :map family) (= key-id (get key-form :form-id)) true)
                                   (= (get parent :form-id) (get value-form :parent-form-id))
                                   (if (= :map family) (= (get parent :form-id) (get key-form :parent-form-id)) true)
                                   (if (= :quoted-data kind)
                                     (body-all? [(= nil (get part :key-node-id) (get part :value-node-id))
                                       (if (= :map family)
                                         (= (get part :key-data-origin) (body-pc-data-origin (get location :quote-core-node-id) key-form
                                                                        (conj (get location :data-path) key-coordinate))) true)
                                       (= (get part :value-data-origin) (body-pc-data-origin (get location :quote-core-node-id) value-form
                                                                         (conj (get location :data-path) coordinate)))])
                                     (if (if (body-pc-id? value-node-id) (if (= :map family) (body-pc-id? key-node-id) true) false)
                                       (body-all?
                                         [(= value-node-id (get part :value-node-id))
                                          (if (= :map family)
                                            (let [key-node (get nodes key-node-id)]
                                              (body-all? [(= key-node-id (get part :key-node-id))
                                                (= :literal (get key-node :core-form)) (= :keyword (get (get key-node :attributes) :literal-kind))
                                                (= actual-key (get (get key-node :attributes) :value))
                                                (= (get key-node :source) (body-pe-form-source key-form))])) true)
                                          (= (get (get nodes value-node-id) :source) (body-pe-form-source value-form))]) false))])
                              (recur (+ i 1) (if (= :map family) (conj seen actual-key) seen)
                                (if (= coordinate (get location :coordinate))
                                  (if (= actual-key (get location :key))
                                    {:source-kind kind :parent-form-id (get parent :form-id) :parent-syntax-id (get parent :syntax-id)
                                     :quote-core-node-id (get location :quote-core-node-id) :data-path (get location :data-path)
                                     :coordinate coordinate :key actual-key :key-form-id key-id
                                     :value-form-id value-id :value-syntax-id (get value-form :syntax-id)} selected) selected))
                              {:status :rejected :reason :map-get-source-mismatch}))
                          {:status :rejected :reason :map-get-source-mismatch}))
                      {:status :rejected :reason :map-get-source-mismatch})
                    evidence))))
            {:status :rejected :reason :map-get-source-mismatch})
          {:status :rejected :reason :map-get-source-mismatch}))
      opened)))

(defn body-pc-source-leaf [cursor shape source nodes forms]
  (let [id (get source :value-form-id)]
    (if (body-pc-id? id)
      (let [form (get forms id)
            measured (body-pc-evidence-work {:value (get form :value) :source (get shape :source)
                                             :origin (get shape :data-origin)})
            kind (get form :kind) type (body-pc-literal-type kind) values (get (get shape :domain) :values)]
        (if (= :accepted (get measured :status))
          (if (body-all?
                [(= id (get form :form-id)) (keyword? type) (= type (get shape :type)) (= kind (body-pc-value-kind (get form :value)))
                 (= (get source :value-syntax-id) (get form :syntax-id))
                 (= (get source :parent-form-id) (get form :parent-form-id))
                 (if (vector? (get form :child-form-ids)) (= 0 (count (get form :child-form-ids))) false)
                 (= (get shape :source) (body-pe-form-source form))
                 (if (vector? values) (if (= 1 (count values)) (= (get values 0) (get form :value)) false) false)
                 (if (= :quoted-data (get source :source-kind))
                   (= (get shape :data-origin) (body-pc-data-origin (get source :quote-core-node-id) form
                                                 (conj (get source :data-path) (get source :coordinate))))
                   (if (= :evaluated (get source :source-kind))
                     (if (body-pc-id? (get cursor :node-id))
                       (= (get (get nodes (get cursor :node-id)) :source) (body-pe-form-source form)) false) false))])
            {:status :accepted}
            {:status :rejected :reason :map-get-source-mismatch})
          measured))
      {:status :rejected :reason :map-get-source-mismatch})))

(defn body-pc-authenticate-entry [projection nodes forms]
  (let [row (get projection :row) shapes (get projection :shapes) locations (get projection :locations)
        parts (get projection :parts)]
    (if (= :not-invoked (get row :entry))
      {:status :accepted :row row}
      (if (if (vector? shapes) (if (vector? locations) (if (vector? parts)
            (= 3 (count shapes) (count locations) (count parts)) false) false) false)
        (loop [i 0 sources []]
          (if (= i 3)
            (let [leaf (body-pc-source-leaf (get projection :leaf-cursor) (get (get parts 2) :shape)
                         (get sources 2) nodes forms)]
              (if (= :accepted (get leaf :status))
                (if (= sources (get (get row :selection) :source-spine))
                  {:status :accepted :row (assoc row :selection (assoc (get row :selection) :source-spine sources))}
                  {:status :rejected :reason :map-get-source-mismatch})
                leaf))
            (let [checked (body-pc-source-step (get locations i) (get shapes i) nodes forms)]
              (if (= :accepted (get checked :status))
                (recur (+ i 1) (conj sources (get checked :source)))
                checked))))
        {:status :rejected :reason :map-get-source-mismatch}))))

(defn body-pc-validate-link-types [links types]
  (if (vector? links)
    (loop [remaining links]
      (if (= 0 (count remaining)) {:status :accepted}
        (let [link (first remaining) ref-id (get link :reference-core-node-id)
              init-id (get (get link :binding-record) :initializer-node-id)]
          (if (if (body-pc-id? ref-id) (body-pc-id? init-id) false)
            (let [ref-type (get types ref-id) init-type (get types init-id)
                  walked (body-lc-validate-types [ref-type init-type])
]
              (if (= :accepted (get walked :status))
                (if (= ref-type init-type) (recur (rest remaining))
                  {:status :rejected :reason :map-get-source-mismatch})
                {:status :rejected :reason :map-get-private-first-entry-presence-required}))
            {:status :rejected :reason :map-get-source-mismatch}))))
    {:status :rejected :reason :map-get-source-mismatch}))

(defn body-pc-candidate [core node call nodes types]
  ; Source structure chooses this probe; descriptor tags never do.
  (let [args (get call :argument-node-ids)
        receiver (body-pc-current-node (if (vector? args) (get args 0) nil) nodes)
        key-node (body-pc-current-node (if (vector? args) (get args 1) nil) nodes)
        receiver-type (get types (get receiver :node-id))]
    (if (if (vector? args) (if (= 2 (count args))
          (if (= :literal (get key-node :core-form))
            (if (if (= :keyword (get (get key-node :attributes) :literal-kind))
                  (if (keyword? (get (get key-node :attributes) :value))
                    (if (vector? (get key-node :children)) (if (= 0 (count (get key-node :children)))
                      (if (vector? (get key-node :resolved-binding-ids)) (= 0 (count (get key-node :resolved-binding-ids))) false) false) false) false) false)
              (if (= :gravity.type/map receiver-type) true
                (if (map? receiver-type) (= :gravity.type/map (get receiver-type :kind)) false)) false) false) false) false)
      (if (= :reference (get receiver :core-form))
        (let [records (get core :lexical-bindings) bid (get (get receiver :attributes) :binding-id)]
          (if (if (body-pc-id? bid) (if (vector? records)
                (map? (body-pe-one records :binding-id bid)) false) false)
            {:status :accepted}
            {:status :not-applicable}))
        (if (= :call (get receiver :core-form))
          (let [children (get receiver :children) operator (body-pc-current-node (if (vector? children) (get children 0) nil) nodes)
                symbol (get (get operator :attributes) :symbol)]
            (if (if (= :reference (get operator :core-form))
                  (if (symbol? symbol) (if (= 'first symbol) true (= 'gravity.core/first symbol)) false) false)
              {:status :accepted} {:status :not-applicable}))
          {:status :not-applicable}))
      {:status :not-applicable})))

(defn body-pc-route [core node call nodes bindings]
  (let [calls (get core :calls)
        edges (get core :call-edges)]
    (if (if (vector? calls) (vector? edges) false)
      (let [receiver (get (get call :argument-node-ids) 0)
            outer (body-pc-unroll receiver core nodes bindings)
            first-id (get outer :node-id)
            first-node (get nodes first-id)
            first-call (body-pe-one calls :core-node-id first-id)
            first-edge (body-pe-one edges :call-core-node-id first-id)
            first-bid (get first-call :operator-binding-id)
            first-args (get first-call :argument-node-ids)
            first-call-valid? (if (body-pc-id? first-bid)
                                (if (vector? first-args) (= 1 (count first-args)) false)
                                false)
            first-binding (get bindings first-bid)
            first-binding-valid? (if (= 'first (get first-binding :name))
                                   (body-lq-binding? first-binding (get core :module))
                                   false)
            inner (if first-call-valid?
                    (body-pc-unroll (get first-args 0) core nodes bindings)
                    {:status :not-applicable})
            get-id (get inner :node-id)
            get-node (get nodes get-id)
            get-call (body-pe-one calls :core-node-id get-id)
            get-edge (body-pe-one edges :call-core-node-id get-id)
            get-bid (get get-call :operator-binding-id)
            get-args (get get-call :argument-node-ids)
            get-call-valid? (if (body-pc-id? get-bid)
                              (if (vector? get-args)
                                (if (= 2 (count get-args))
                                  (if (body-pc-id? (get get-args 0))
                                    (body-pc-id? (get get-args 1))
                                    false)
                                  false)
                                false)
                              false)
            node-owner (get (get node :evaluation) :owner-function-syntax-id)
            first-owner (get (get first-node :evaluation) :owner-function-syntax-id)
            get-owner (get (get get-node :evaluation) :owner-function-syntax-id)
            first-caller (get first-edge :caller-function-syntax-id)
            get-caller (get get-edge :caller-function-syntax-id)
            owner-valid? (body-all?
                           [(body-pc-id? node-owner)
                            (body-pc-id? first-owner)
                            (body-pc-id? get-owner)
                            (body-pc-id? first-caller)
                            (body-pc-id? get-caller)
                            (= :call (get first-node :core-form))
                            (= :call (get get-node :core-form))
                            (= false (= first-id get-id))
                            (= false (= first-id (get node :node-id)))
                            (= false (= get-id (get node :node-id)))
                            (map? first-edge)
                            (map? get-edge)
                            (body-pc-id? (get first-call :operator-node-id))
                            (body-pc-id? (get get-call :operator-node-id))
                            (= node-owner first-owner)
                            (= node-owner get-owner)
                            (= first-caller get-caller)])]
        (if (= :accepted (get outer :status))
          (if first-call-valid?
            (if first-binding-valid?
              (if (= :accepted (get inner :status))
                (if get-call-valid?
                  (if (body-mg-binding? (get bindings get-bid) (get core :module))
                    (if owner-valid?
                      {:status :accepted
                       :first-node-id first-id :first-call first-call :first-edge first-edge
                       :get-node-id get-id :get-call get-call :get-edge get-edge
                       :receiver-links (get outer :links) :vector-links (get inner :links)}
                      {:status :rejected :reason :map-get-source-mismatch})
                    {:status :rejected :reason :map-get-source-mismatch})
                  {:status :rejected :reason :map-get-source-mismatch})
                (assoc inner :status :not-applicable))
              {:status :not-applicable})
            {:status :not-applicable})
          {:status :not-applicable}))
      {:status :rejected :reason :map-get-source-mismatch})))

(defn body-pc-form-source [form]
  (get (body-ma-form-node {} form) :source))

(defn body-pc-keys? [value fields]
  (if (map? value)
    (if (= (count value) (count fields))
      (if (loop [remaining (keys value)]
            (if (= 0 (count remaining)) true
              (if (keyword? (first remaining)) (recur (rest remaining)) false)))
        (= fields (set (keys value))) false) false) false))

(defn body-pc-selected-type? [type]
  (if (keyword? type)
    (contains? #{:gravity.type/nil :gravity.type/bool :gravity.type/integer :gravity.type/keyword
                 :gravity.type/string :gravity.type/symbol} type) false))

(defn body-pc-source-domain? [source]
  (if (body-pc-keys? source #{:form-id :syntax-id :semantic-span :origin-chain :generated-origin})
    (body-all? [(body-pc-id? (get source :form-id)) (body-pc-id? (get source :syntax-id))
      (if (= nil (get source :semantic-span)) true (map? (get source :semantic-span)))
      (if (vector? (get source :origin-chain)) true false)
      (if (= nil (get source :generated-origin)) true
        (let [origins (get source :generated-origin)]
          (if (vector? origins)
            (loop [remaining origins]
              (if (= 0 (count remaining)) true
                (let [origin (first remaining)]
                  (if (body-pc-keys? origin #{:origin-id :kind :from-syntax-id :role})
                    (if (body-pc-id? (get origin :origin-id))
                      (if (body-pc-id? (get origin :from-syntax-id))
                        (recur (rest remaining)) false) false) false)))) false)))]) false))

(defn body-pc-links-domain? [links]
  (if (vector? links)
    (loop [remaining links]
      (if (= 0 (count remaining)) true
        (let [link (first remaining) record (get link :binding-record)]
          (if (body-all?
                [(body-pc-keys? link #{:reference-core-node-id :reference-source :binding-record})
                 (body-pc-id? (get link :reference-core-node-id)) (body-pc-source-domain? (get link :reference-source))
                 (body-pc-keys? record #{:let-core-node-id :ordinal :name :binding-id :definition-form-id :definition-syntax-id
                                       :binding-scope-id :initializer-form-id :initializer-syntax-id :initializer-scope-id
                                       :initializer-node-id :visible-prior-binding-ids :mutability})
                 (if (integer? (get record :ordinal)) (<= 0 (get record :ordinal)) false)
                 (symbol? (get record :name)) (= :immutable (get record :mutability))
                 (loop [ids [(get record :let-core-node-id) (get record :binding-id) (get record :definition-form-id)
                             (get record :definition-syntax-id) (get record :binding-scope-id) (get record :initializer-form-id)
                             (get record :initializer-syntax-id) (get record :initializer-scope-id) (get record :initializer-node-id)]]
                   (if (= 0 (count ids)) true (if (body-pc-id? (first ids)) (recur (rest ids)) false)))
                 (if (vector? (get record :visible-prior-binding-ids))
                   (loop [ids (get record :visible-prior-binding-ids)]
                     (if (= 0 (count ids)) true (if (body-pc-id? (first ids)) (recur (rest ids)) false))) false)])
            (recur (rest remaining)) false)))) false))

(defn body-pc-parent-parameter [route core nodes bindings]
  ; The outer lookup must be the existing private parameter owner.
  (let [call (get route :get-call) id (get (get call :argument-node-ids) 0)
        receiver (body-pc-current-node id nodes)
        owner-id (get (get receiver :evaluation) :owner-function-syntax-id)
        records (get core :function-records)]
    (if (if (vector? records) (body-pc-id? owner-id) false)
      (let [record (body-pe-one records :function-syntax-id owner-id)
            ids (get record :parameter-binding-ids) bid (get (get receiver :attributes) :binding-id)]
        (if (if (vector? ids) (if (body-pc-id? bid)
              (if (= :reference (get receiver :core-form))
                (if (= :lexical (get (get receiver :attributes) :binding-class))
                  (= 1 (loop [remaining ids matches 0]
                         (if (= 0 (count remaining)) matches
                           (recur (rest remaining) (+ matches (if (= bid (first remaining)) 1 0)))))) false) false) false) false)
          {:status :accepted :record record}
          {:status :rejected :reason :map-get-private-first-entry-presence-required}))
      {:status :rejected :reason :map-get-source-mismatch})))

(defn body-pc-entry-set-work [parent record core]
  (let [calls (get core :calls) entries (get (get parent :presence-proof) :entries)]
    (if (if (vector? calls) (vector? entries) false)
      (let [actual (body-pe-select calls :operator-binding-id (get record :definition-binding-id))]
        (if (= (count actual) (count entries))
          (if (loop [i 0]
                (if (= i (count actual)) true
                  (let [id (get (get entries i) :call-core-node-id)]
                    (if (body-pc-id? id)
                      (if (= id (get (get actual i) :core-node-id)) (recur (+ i 1)) false) false))))
            {:status :accepted}
            {:status :rejected :reason :map-get-source-mismatch})
          {:status :rejected :reason :map-get-private-first-entry-presence-required}))
      {:status :rejected :reason :map-get-source-mismatch})))

(defn body-pc-project [header route parent first-descriptor nodes]
  ; Parent types have already survived current BT and BS reconstruction.
  (let [proof (get parent :presence-proof) entries (get proof :entries)
        vector-type (get parent :result-type) map-type (get first-descriptor :result-type)]
    (if (if (= :sh08-map-get-private-entry-v1 (get parent :version))
          (if (= :gravity.type/applied-vector-first (get first-descriptor :kind))
            (if (= :normal (get header :application))
              (if (vector? entries) (< 0 (count entries)) false) false) false) false)
      (loop [remaining entries rows [] projections [] selected nil normals 0]
        (if (= 0 (count remaining))
          (if (< 0 normals)
            {:status :accepted :rows rows :projections projections :type selected}
            {:status :rejected :reason :map-get-private-first-entry-presence-required})
          (let [entry (first remaining)
                projected (body-pc-current-entry entry (get parent :key) (get header :key)
                            vector-type map-type nodes)
                row (get projected :row)
                type (get (get row :selection) :type)
                invoked? (= :invoked (get row :entry))]
            (if (= :accepted (get projected :status))
              (if (if invoked? (if (body-pc-selected-type? type) (if (= nil selected) true (= selected type)) false) true)
                (recur (rest remaining) (conj rows row) (conj projections projected)
                  (if invoked? type selected) (+ normals (if invoked? 1 0)))
                {:status :rejected :reason :map-get-private-first-entry-selected-type-required})
              projected))))
      {:status :rejected :reason :map-get-private-entry-presence-required})))

(defn body-pc-authenticate-project [project nodes forms]
  (loop [remaining (get project :projections)]
    (if (= 0 (count remaining)) {:status :accepted}
      (let [checked (body-pc-authenticate-entry (first remaining) nodes forms)]
        (if (= :accepted (get checked :status))
          (recur (rest remaining))
          checked)))))

(defn body-pc-finish [header route project]
  (let [type (get project :type)]
    (assoc header :version :sh08-map-get-private-first-entry-v1
      :parameter-types (get header :argument-types) :return type :result-type type
      :lookup-policy (assoc (get header :lookup-policy) :input :private-first-entry)
      :presence-proof {:kind :private-first-entry-key-presence
                       :get-call-core-node-id (get route :get-node-id)
                       :first-call-core-node-id (get route :first-node-id)
                       :receiver-links (get route :receiver-links) :vector-links (get route :vector-links)
                       :entries (get project :rows) :selected-type type}
      :invalidation (conj (conj (conj (get header :invalidation) :parent-call-descriptors)
                           :parent-call-facts) :parent-producer-rows :mutations :immutable-binding-links :incoming-arguments :source-spine))))

(defn body-pc-descriptor-work [supplied expected]
  ; Exact reconstruction closes every nested row; no supplied field selects a route or table lookup.
  (let [proof (get supplied :presence-proof)]
    (if (if (body-pc-keys? proof #{:kind :get-call-core-node-id :first-call-core-node-id
                                   :receiver-links :vector-links :entries :selected-type})
          (if (= :private-first-entry-key-presence (get proof :kind))
            (if (body-pc-id? (get proof :get-call-core-node-id))
              (if (body-pc-id? (get proof :first-call-core-node-id))
                (if (body-pc-links-domain? (get proof :receiver-links))
                  (if (body-pc-links-domain? (get proof :vector-links))
                    (if (body-pc-selected-type? (get proof :selected-type)) (= supplied expected) false) false) false) false) false) false) false)
      {:status :accepted}
      {:status :rejected :reason :map-get-source-mismatch})))

(defn body-pc-first-work [route core nodes bindings types]
  (let [call (get route :first-call) node (get nodes (get route :first-node-id))
        checked (body-lc-validate-types (body-io-child-types (get call :argument-node-ids) types))
        header (if (= :accepted (get checked :status))
                 (body-lq-source core node call (get route :first-edge) nodes bindings types (get core :module) checked) nil)
        descriptor (if (map? header) (body-lq-finish header) nil)
        supplied (get types (get call :operator-node-id))
        carrier (if (map? descriptor) (body-pc-evidence-work supplied)
                  {:status :rejected :reason :map-get-source-mismatch})]
    (if (if (= :accepted (get carrier :status)) (if (= :accepted (get checked :status)) (if (map? descriptor)
          (if (= :gravity.type/applied-vector-first (get descriptor :kind))
            (if (= descriptor (get types (get call :operator-node-id)))
              (= (get descriptor :result-type) (get types (get node :node-id))) false) false) false) false) false)
      {:status :accepted :descriptor descriptor :type-validation checked}
      {:status :rejected :reason :map-get-source-mismatch})))

(defn body-pc-call-forms-work [node call nodes forms]
  (let [owner-id (get (get node :source) :form-id)]
    (if (body-pc-id? owner-id)
      (let [owner (get forms owner-id) ids (get owner :child-form-ids) children (get node :children)
            width (if (vector? ids) (count ids) 0)]
        (if (if (vector? ids) (if (vector? children) (= width (count children)) false) false)
          (let [measured (body-pc-evidence-work {:source (get node :source) :form-source (body-pc-form-source owner)})]
            (if (= :accepted (get measured :status))
              (if (if (= owner-id (get owner :form-id)) (if (= :list (get owner :kind))
                    (= (get node :source) (body-pc-form-source owner)) false) false)
                (loop [i 0]
                  (if (= i width) {:status :accepted}
                    (let [id (get ids i) child-id (get children i)]
                      (if (if (body-pc-id? id) (body-pc-id? child-id) false)
                        (let [form (get forms id) child (body-pc-current-node child-id nodes)
                              walked (body-pc-evidence-work {:source (get child :source) :form-source (body-pc-form-source form)
                                                            :symbol (if (= i 0) (get form :value) nil)
                                                            :literal (if (= :literal (get child :core-form)) (get (get child :attributes) :value) nil)
                                                            :form-literal (if (= :literal (get child :core-form)) (get form :value) nil)})]
                          (if (= :accepted (get walked :status))
                            (if (body-all? [(= id (get form :form-id)) (= owner-id (get form :parent-form-id))
                                  (= (get child :source) (body-pc-form-source form))
                                  (if (= :literal (get child :core-form))
                                    (if (= :keyword (get (get child :attributes) :literal-kind))
                                      (if (= :keyword (get form :kind))
                                        (if (keyword? (get form :value))
                                          (= (get (get child :attributes) :value) (get form :value)) false) false) false) true)
                                  (if (= i 0) (if (= :symbol (get form :kind))
                                    (= (get form :value) (get (get child :attributes) :symbol)) false) true)])
                              (recur (+ i 1))
                              {:status :rejected :reason :map-get-source-mismatch})
                            walked))
                        {:status :rejected :reason :map-get-source-mismatch}))))
                {:status :rejected :reason :map-get-source-mismatch})
              measured))
          {:status :rejected :reason :map-get-source-mismatch}))
      {:status :rejected :reason :map-get-source-mismatch})))

(defn body-pc-links-forms-work [links core nodes bindings forms]
  (loop [remaining links]
    (if (= 0 (count remaining)) {:status :accepted}
      (let [link (first remaining) record (get link :binding-record)
            measured (body-pc-evidence-work link)]
        (if (= :accepted (get measured :status))
          (if (body-pc-links-domain? [link])
            (let [reference (get nodes (get link :reference-core-node-id))
                  owner (get nodes (get record :let-core-node-id))
                  owner-id (get (get owner :source) :form-id) vector-id (get (get owner :attributes) :binding-vector-form-id)
                  reference-id (get (get reference :source) :form-id)]
              (if (if (body-pc-id? owner-id) (if (body-pc-id? vector-id) (body-pc-id? reference-id) false) false)
                (let [owner-form (get forms owner-id) vector-form (get forms vector-id)
                      ref-form (get forms reference-id) owner-ids (get owner-form :child-form-ids)
                      vector-ids (get vector-form :child-form-ids) index (get record :ordinal)]
                  (if (if (vector? owner-ids) (if (vector? vector-ids)
                        (if (integer? index) (if (<= 0 index)
                          (if (< 1 (count owner-ids)) (< (+ 1 (* 2 index)) (count vector-ids)) false) false) false) false) false)
                    (let [operator-id (get owner-ids 0)
                          metadata (if (body-pc-id? operator-id)
                                     (body-pc-evidence-work
                                       {:reference-source (get reference :source) :ref-form-source (body-pc-form-source ref-form)
                                        :reference-value (get ref-form :value) :owner-source (get owner :source)
                                        :owner-form-source (body-pc-form-source owner-form)
                                        :operator-value (get (get forms operator-id) :value)
                                        :binding-form (get forms (get record :definition-form-id))
                                        :initializer-source (body-pc-form-source (get forms (get record :initializer-form-id)))})
                                     {:status :rejected :reason :map-get-source-mismatch})]
                      (if (= :accepted (get metadata :status))
                        (if (body-all?
                              [(body-pc-link-core? record reference core nodes bindings)
                               (= reference-id (get ref-form :form-id)) (= :symbol (get ref-form :kind))
                               (= (get record :name) (get ref-form :value))
                               (= (get reference :source) (body-pc-form-source ref-form) (get link :reference-source))
                               (= owner-id (get owner-form :form-id)) (= :list (get owner-form :kind))
                               (= (get owner :source) (body-pc-form-source owner-form))
                               (= operator-id (get (get forms operator-id) :form-id))
                               (= owner-id (get (get forms operator-id) :parent-form-id))
                               (= :symbol (get (get forms operator-id) :kind))
                               (= 'let (get (get forms operator-id) :value))
                               (= vector-id (get vector-form :form-id) (get owner-ids 1))
                               (= owner-id (get vector-form :parent-form-id)) (= :vector (get vector-form :kind))
                               (= (get vector-form :syntax-id) (get (get owner :attributes) :binding-vector-syntax-id))
                               (= (get vector-ids (* 2 index)) (get record :definition-form-id))
                               (= (get vector-ids (+ 1 (* 2 index))) (get record :initializer-form-id))
                               (= (get record :definition-form-id) (get (get forms (get record :definition-form-id)) :form-id))
                               (= vector-id (get (get forms (get record :definition-form-id)) :parent-form-id))
                               (= (get record :definition-syntax-id) (get (get forms (get record :definition-form-id)) :syntax-id))
                               (= (get record :name) (get (get forms (get record :definition-form-id)) :value))
                               (= :symbol (get (get forms (get record :definition-form-id)) :kind))
                               (= (get record :binding-scope-id) (get (get forms (get record :definition-form-id)) :scope-id))
                               (= (get record :initializer-form-id) (get (get forms (get record :initializer-form-id)) :form-id))
                               (= vector-id (get (get forms (get record :initializer-form-id)) :parent-form-id))
                               (= (get record :initializer-scope-id) (get (get forms (get record :initializer-form-id)) :scope-id))])
                          (recur (rest remaining))
                          {:status :rejected :reason :map-get-source-mismatch})
                        metadata))
                    {:status :rejected :reason :map-get-source-mismatch}))
                {:status :rejected :reason :map-get-source-mismatch}))
            {:status :rejected :reason :map-get-source-mismatch})
          measured)))))

(defn body-pc-links [route]
  (loop [remaining (get route :vector-links) out (get route :receiver-links)]
    (if (= 0 (count remaining)) out (recur (rest remaining) (conj out (first remaining))))))

(defn body-pc-core-project [route parent core node call edge nodes bindings types]
  (let [gated (body-pc-parent-parameter route core nodes bindings)
        entry-set (if (= :accepted (get gated :status))
                    (body-pc-entry-set-work parent (get gated :record) core) gated)
        first-result (if (= :accepted (get entry-set :status))
                       (body-pc-first-work route core nodes bindings types) entry-set)
        links (body-pc-links route)
        linked (if (= :accepted (get first-result :status))
                 (body-pc-validate-link-types links types) first-result)]
    (if (= :accepted (get linked :status))
      (let [header (body-mg-source core node call edge nodes bindings types (get core :module))
            project (if (map? header)
                      (body-pc-project header route parent (get first-result :descriptor) nodes)
                      {:status :rejected :reason :map-get-source-mismatch})]
        (if (= :accepted (get project :status))
          {:status :accepted :project project :first-type-validation (get first-result :type-validation)
           :descriptor (body-pc-finish header route project)}
          project))
      linked)))

(defn body-pc-full-project [route parent core node call edge nodes bindings types forms]
  (let [projected (body-pc-core-project route parent core node call edge nodes bindings types)]
    (if (= :accepted (get projected :status))
      (loop [pairs [[node call] [(get nodes (get route :get-node-id)) (get route :get-call)]
                    [(get nodes (get route :first-node-id)) (get route :first-call)]]]
        (if (= 0 (count pairs))
          (let [links (body-pc-links route)
                linked (body-pc-links-forms-work links core nodes bindings forms)
                checked (if (= :accepted (get linked :status))
                          (body-pc-authenticate-project (get projected :project) nodes forms)
                          linked)]
            (if (= :accepted (get checked :status)) projected checked))
          (let [pair (first pairs) checked (body-pc-call-forms-work (get pair 0) (get pair 1) nodes forms)]
            (if (= :accepted (get checked :status))
              (recur (rest pairs))
              checked))))
      projected)))

(defn body-pc-parent-rows-work [route parent first-descriptor core facts ledger parent-reference key]
  ; Supplied carrier references remain separate inputs and are rebuilt before comparison.
  (if (if (vector? facts) (vector? ledger) false)
    (let [fact-selectors (loop [remaining facts out []]
                           (if (= 0 (count remaining)) out
                             (recur (rest remaining) (conj out (get (first remaining) :call-core-node-id)))))
          selectors (loop [remaining ledger out fact-selectors]
                      (if (= 0 (count remaining)) out
                        (let [row (first remaining)]
                          (recur (rest remaining) (conj out [(get row :producer-rule) (get row :lhs)])))))
          measured (body-pc-evidence-work selectors)]
      (if (= :accepted (get measured :status))
        (body-pc-parent-carriers-work
          {:get-call-id (get route :get-node-id) :first-call-id (get route :first-node-id)}
          parent first-descriptor {:parent-reference parent-reference} first-descriptor core
          {:call-type-facts facts :constraint-ledger ledger} key)
        measured))
    {:status :rejected :reason :map-get-source-mismatch}))

(defn body-pc-full-work [route prior-parent core node call edge nodes bindings types forms facts ledger]
  ; prior-parent is expected DATA from this fresh body-mg-context loop only.
  ; The same immutable core/forms/types supplied to that earlier check are retained.
  (let [gated (body-pc-parent-parameter route core nodes bindings)
        parent-call (get route :get-call) parent-node (get nodes (get route :get-node-id))
        reusable? (if (map? prior-parent)
                    (if (= :gravity.type/applied-map-get (get prior-parent :kind))
                      (if (= :sh08-map-get-private-entry-v1 (get prior-parent :version))
                        (= parent-call (get prior-parent :source-call)) false) false) false)]
    (if (= :accepted (get gated :status))
      (let [header (body-mg-source core parent-node parent-call (get route :get-edge) nodes bindings types (get core :module))
            supplied (get types (get parent-call :operator-node-id))
            parent (if (map? header)
                     (if reusable? {:status :accepted :descriptor prior-parent}
                       (body-pe-check header supplied core nodes bindings forms types))
                     {:status :rejected :reason :map-get-source-mismatch})]
        (if (= :accepted (get parent :status))
          (let [key-node (get nodes (get (get call :argument-node-ids) 1))
                matched (body-pc-parent-match-work supplied (get parent :descriptor) (get (get key-node :attributes) :value))]
            (if (= :accepted (get matched :status))
              (let [projected (body-pc-full-project route (get parent :descriptor) core node call edge nodes bindings types forms)]
                (if (= :accepted (get projected :status))
                  (let [first-descriptor (get types (get (get route :first-call) :operator-node-id))
                        rows (body-pc-parent-rows-work route (get parent :descriptor) first-descriptor core facts ledger
                                  (get matched :parent-reference) (get (get projected :descriptor) :key))]
                    (if (= :accepted (get rows :status))
                      (let [matched (body-pc-descriptor-work (get types (get call :operator-node-id))
                                      (get projected :descriptor))]
                        (if (= :accepted (get matched :status))
                          (assoc projected
                            :parents {:get-call-id (get route :get-node-id) :get-operator-id (get parent-call :operator-node-id)
                                      :get-descriptor (get parent :descriptor)
                                      :first-call-id (get route :first-node-id)
                                      :first-operator-id (get (get route :first-call) :operator-node-id)
                                      :first-descriptor first-descriptor :first-type-validation (get projected :first-type-validation)
                                      :inner-call-id (get node :node-id) :inner-operator-id (get call :operator-node-id)
                                      :route route :key (get (get projected :descriptor) :key)
                                      :rows (get (get (get projected :descriptor) :presence-proof) :entries)})
                          matched))
                        rows))
                    projected))
                matched))
            parent))
      gated)))

(defn body-mg-binding? [binding module]
  (if (if (vector? (get binding :profile-set)) (vector? (get binding :target-set)) false)
  (body-all?
    [(= ['get :core :var 'gravity.core {:name 'gravity/core :version "bootstrap-contract-v1"} :gravity.type/core-var :safe]
        [(get binding :name) (get binding :binding-class) (get binding :kind) (get binding :namespace)
         (get binding :package) (get binding :type-ref) (get binding :safety)])
     (= [] (get binding :effects) (get binding :capabilities))
     (contains? (set (get binding :profile-set)) (get module :profile))
     (contains? (set (get binding :target-set)) :all)]) false))

(defn body-mg-source [core node call edge nodes bindings types module]
  (if (if (vector? (get call :argument-node-ids)) (vector? (get node :children)) false)
  (let [children (get node :children) operator (get nodes (get call :operator-node-id))
        bid (get call :operator-binding-id) binding (get bindings bid) args (get call :argument-node-ids)
        arguments (body-io-child-types args types)
        invoked? (loop [remaining arguments]
                   (if (= 0 (count remaining)) true
                     (if (= :gravity.type/never (first remaining)) false (recur (rest remaining)))))
        caller (loop [remaining (get core :function-records)]
                 (if (= 0 (count remaining)) nil
                   (if (= (get (first remaining) :function-syntax-id) (get (get node :evaluation) :owner-function-syntax-id))
                     (first remaining) (recur (rest remaining)))))
        expected-call {:core-node-id (get node :node-id) :operator-node-id (first children) :operator-binding-id bid
                       :argument-node-ids (vec (rest children)) :ordered-evaluation-node-ids children
                       :evaluation-order :operator-then-arguments :result-policy :call-result}
        expected-edge {:ordinal (get edge :ordinal) :call-core-node-id (get node :node-id)
                       :caller-function-syntax-id (get caller :function-syntax-id) :caller-function-core-node-id (get caller :function-core-node-id)
                       :callee-binding-id bid :callee-definition-syntax-id (get binding :definition-syntax-id)
                       :callee-function-syntax-id nil :callee-function-core-node-id nil :argument-core-node-ids args
                       :ordered-evaluation-node-ids children :evaluation-order :operator-then-arguments :classification :nonlocal-or-nonfunction}]
    (if (body-all?
          [(= :call (get node :core-form)) (= :reference (get operator :core-form))
           (contains? #{2 3} (count args)) (= expected-call call) (= expected-edge edge) (body-mg-binding? binding module)
           (= [bid] (get node :resolved-binding-ids) (get operator :resolved-binding-ids))
           (= {:symbol (get (get operator :attributes) :symbol) :position :operator :binding-id bid :binding-class :core
               :definition-syntax-id (get binding :definition-syntax-id)} (get operator :attributes))
           (contains? '#{get gravity.core/get} (get (get operator :attributes) :symbol))
           (= :operator-then-arguments (get (get node :evaluation) :kind))
           (= (loop [i 0 out []] (if (= i (count children)) out
                (recur (+ i 1) (conj out {:index i :core-node-id (get children i)})))) (get (get node :evaluation) :order))
           (if (= 2 (count args)) (body-mg-present-operands? arguments args nodes) (body-mg-operands? arguments invoked?))
           (loop [remaining arguments]
             (if (= 0 (count remaining)) true
               (if (if (= nil (first remaining)) true (= :gravity.type/unknown (first remaining))) false (recur (rest remaining)))))] )
      (let [header {:kind :gravity.type/applied-map-get :version :sh08-map-get-v1
       :operation 'get :semantic-owner 'gravity.collections :intrinsic :gravity.collections/map-lookup-default
       :resolution :gravity.core-compatibility :operator-node-id (get operator :node-id) :operator-binding-id bid
       :call-core-node-id (get node :node-id) :source (get node :source) :operator-source (get operator :source)
       :source-call call :source-edge edge :source-binding binding :argument-types arguments
       :lookup-policy {:input :established-member-map :keys [:string :keyword] :key-equality :value
                       :presence :independent-of-value :default :eager :normalization :none :coercion :none
                       :operand-evaluation :map-then-key-then-default-once :result :one-established-type}
       :application (if invoked? :normal :not-invoked)
       :latent-effects [] :direct-effects [] :capabilities [] :thrown-error-effects []
       :profile (get module :profile) :target (get module :target)
       :invalidation [:calls :call-edges :binding-table :source-forms :type-table :lexical-bindings :definitions :function-records
                      :callee-body :member-types :key-domain :default-type :lookup-policy :profile :target :evaluation-order]}]
        (if (= 2 (count args)) (body-mg-present-header header nodes) header)) nil)) nil))

(defn body-mg-constraint [descriptor]
  {:constraint-id-request {:domain :gravity/sh08-map-get-constraint-v1 :application descriptor}
   :kind :equality :producer-rule :sh08-map-get-v1
   :lhs {:core-node-id (get descriptor :call-core-node-id) :projection :map-get}
   :rhs (get descriptor :result-type) :dependencies descriptor :origin (get (get descriptor :source) :origin-chain)
   :solution {:result-type (get descriptor :result-type) :application (get descriptor :application)
              :direct-effects (get descriptor :direct-effects)}
   :invalidation (get descriptor :invalidation) :profile (get descriptor :profile) :target (get descriptor :target)
   :status :solved :diagnostics []})

(defn body-mg-call-fact [descriptor module]
  (let [source (get descriptor :source) edge (get descriptor :source-edge)]
    {:artifact :gravity/c7-call-type-fact
     :fact-id-request {:domain :gravity/sh08-map-get-call-type-fact-v1 :application descriptor}
     :call-core-node-id (get descriptor :call-core-node-id) :caller-function-syntax-id (get edge :caller-function-syntax-id)
     :callee-function-syntax-id nil :argument-types (get descriptor :argument-types) :result-type (get descriptor :result-type)
     :evaluation-order :operator-then-arguments :source-span (get source :semantic-span) :syntax-id (get source :syntax-id)
     :origin-chain (get source :origin-chain) :generated-origin (get source :generated-origin)
     :profile (get module :profile) :target (get module :target) :effects (get descriptor :direct-effects) :capabilities [] :status :inferred
     :dispatch :direct-map-get :applied-map-get descriptor :effect-facts-source :audited-collection-intrinsic}))


(defn body-mg-finish [header]
  (let [type (if (= :normal (get header :application)) (get (get header :argument-types) 2) :gravity.type/never)]
    (assoc header :parameter-types (get header :argument-types) :return type :result-type type)))

(defn body-pc-without [value fields]
  (if (map? value)
    (loop [remaining (vec value) out {}]
      (if (= 0 (count remaining)) out
        (let [entry (first remaining) key (get entry 0)]
          (if (keyword? key)
            (recur (rest remaining) (if (contains? fields key) out (assoc out key (get entry 1)))) nil)))) nil))

(defn body-pc-entry-metadata-work [entries]
  (loop [remaining entries out []]
    (if (= 0 (count remaining)) {:status :accepted :value out}
      (let [entry (first remaining)]
        (if (map? entry)
          (recur (rest remaining)
            (conj out (body-project entry [:call-core-node-id :argument-node-id :entry])))
          {:status :rejected :reason :map-get-source-mismatch})))))

(defn body-pc-origin-point [origin]
  (if (= nil origin) nil
    [(get origin :kind) (get origin :quote-core-node-id) (get origin :form-id) (get origin :data-path)]))

(defn body-pc-parent-reference [descriptor]
  (let [source (get descriptor :source) operator (get descriptor :operator-source)
        binding (get descriptor :source-binding)]
    (assoc (body-project descriptor
             [:kind :version :operation :semantic-owner :intrinsic :resolution :call-core-node-id :operator-node-id
              :operator-binding-id :key-node-id :key :application :profile :target :result-type
              :latent-effects :direct-effects :capabilities :thrown-error-effects])
      :source-ids [(get source :form-id) (get source :syntax-id)]
      :operator-source-ids [(get operator :form-id) (get operator :syntax-id)]
      :binding-source-ids [(get binding :binding-id) (get binding :definition-syntax-id)])))

(defn body-pc-shape-metadata [shape]
  {:shape-kind (get shape :shape-kind) :constructor-origin (get shape :constructor-origin)
   :constructor-node-id (get shape :constructor-node-id) :node-id (get shape :node-id)
   :form-id (get (get shape :source) :form-id) :origin (body-pc-origin-point (get shape :data-origin))})

(defn body-pc-part-metadata [part]
  {:coordinate (get part :coordinate) :key (get part :key)
   :key-node-id (get part :key-node-id) :value-node-id (get part :value-node-id)
   :key-origin (body-pc-origin-point (get part :key-data-origin))
   :value-origin (body-pc-origin-point (get part :value-data-origin))})


(defn body-pc-parent-data-work [descriptor inner-key]
  (let [proof (get descriptor :presence-proof) entries (get proof :entries)]
    (if (if (map? descriptor) (if (= :sh08-map-get-private-entry-v1 (get descriptor :version))
          (if (map? proof) (vector? entries) false) false) false)
      (let [rows (body-pc-entry-metadata-work entries)]
        (if (= :accepted (get rows :status))
          (let [data {:parent-reference (body-pc-parent-reference descriptor)
                      :proof-kind (get proof :kind) :proof-key (get proof :key) :entries (get rows :value)}
                measured (body-pc-evidence-work data)]
            (if (= :accepted (get measured :status))
              {:status :accepted :value data}
              measured))
          rows))
      {:status :rejected :reason :map-get-source-mismatch})))

(defn body-pc-parent-match-work [supplied expected key]
  (let [actual (body-pc-parent-data-work supplied key)
        rebuilt (if (= :accepted (get actual :status))
                  (body-pc-parent-data-work expected key) actual)]
    (if (= :accepted (get rebuilt :status))
      (if (= (get actual :value) (get rebuilt :value))
        {:status :accepted :parent-reference (get (get rebuilt :value) :parent-reference)}
        {:status :rejected :reason :map-get-source-mismatch})
      rebuilt)))

(defn body-pc-carried-parent-work [descriptor applied-key inner-key]
  ; Reference keys are fixed program text; supplied values are reconstructed
  ; and compared after independent nested evidence validation.
  (let [reference (body-pc-parent-reference descriptor)
        fields [:kind :version :operation :semantic-owner :intrinsic :resolution :call-core-node-id :operator-node-id
                :operator-binding-id :key-node-id :key :application :profile :target :result-type
                :latent-effects :direct-effects :capabilities :thrown-error-effects
                :source-ids :operator-source-ids :binding-source-ids]
        values (loop [remaining fields out []]
                 (if (= 0 (count remaining)) out
                   (recur (rest remaining) (conj out (get reference (first remaining))))))
        walked (body-pc-evidence-work values)]
    (if (= :accepted (get walked :status))
      (if (if (= :applied-map-get applied-key)
            (if (= :gravity.type/applied-map-get (get reference :kind))
              (= :sh08-map-get-private-entry-v1 (get reference :version)) false)
            (if (= :applied-vector-first applied-key)
              (if (= :gravity.type/applied-vector-first (get reference :kind))
                (= :sh08-vector-first-v1 (get reference :version)) false) false))
        {:status :accepted :value reference}
        {:status :rejected :reason :map-get-source-mismatch})
      walked)))

(defn body-pc-fact-data [fact applied-key application applied]
  {:fields (body-pc-without fact (conj #{:fact-id-request} applied-key))
   :request (body-pc-without (get fact :fact-id-request) #{:application}) :application application :applied applied})

(defn body-pc-fact-data-work [fact applied-key inner-key]
  (let [request (get fact :fact-id-request)
        application (body-pc-carried-parent-work (get request :application) applied-key inner-key)
        applied (if (= :accepted (get application :status))
                  (body-pc-carried-parent-work (get fact applied-key) applied-key inner-key) application)]
    (if (= :accepted (get applied :status))
      (let [data (body-pc-fact-data fact applied-key (get application :value) (get applied :value))
            measured (body-pc-evidence-work (body-project data [:fields :request]))]
        (if (= :accepted (get measured :status)) {:status :accepted :value data}
          measured))
      applied)))

(defn body-pc-row-data [row application dependencies]
  {:fields (body-pc-without row #{:constraint-id-request :dependencies})
   :request (body-pc-without (get row :constraint-id-request) #{:application}) :application application :dependencies dependencies})

(defn body-pc-row-data-work [row applied-key inner-key]
  (let [request (get row :constraint-id-request)
        application (body-pc-carried-parent-work (get request :application) applied-key inner-key)
        applied (if (= :accepted (get application :status))
                  (body-pc-carried-parent-work (get row :dependencies) applied-key inner-key) application)]
    (if (= :accepted (get applied :status))
      (let [data (body-pc-row-data row (get application :value) (get applied :value))
            measured (body-pc-evidence-work (body-project data [:fields :request]))]
        (if (= :accepted (get measured :status)) {:status :accepted :value data}
          measured))
      applied)))

(defn body-pc-family-widths [core facts]
  (let [families [(get core :nodes) (get core :definitions) (get core :function-records) (get core :calls)
                  (get core :call-edges) (get core :lexical-bindings) (get core :mutations) (get core :reference-uses)
                  (get (get core :preserved-resolution) :resolution-table) (get core :var-references)
                  (get core :recur-targets) (get core :recur-transfers) (get core :recursion-components)
                  (get (get core :module) :exports) (get facts :call-type-facts) (get facts :constraint-ledger)]]
    (loop [remaining families out []]
      (if (= 0 (count remaining)) out
        (if (vector? (first remaining)) (recur (rest remaining) (conj out (count (first remaining)))) nil)))))

(defn body-pc-entry-types-current? [parent core types]
  (let [proof (get parent :presence-proof) census (get proof :entry-census) entries (get proof :entries)
        calls (get census :calls) index (get census :parameter-index)]
    (if (if (integer? index) (if (<= 0 index) (if (vector? entries) (if (vector? calls)
          (= (count entries) (count calls)) false) false) false) false)
      (loop [i 0]
        (if (= i (count entries)) true
          (let [entry (get entries i) call (get calls i) args (get call :argument-node-ids)]
            (if (if (vector? args) (if (< index (count args))
                  (loop [remaining args]
                    (if (= 0 (count remaining)) true
                      (if (body-pc-id? (first remaining)) (recur (rest remaining)) false))) false) false)
              (if (body-all? [(= (get call :core-node-id) (get entry :call-core-node-id))
                    (= (get args index) (get entry :argument-node-id))
                    (= (get entry :argument-type) (get types (get args index)))
                    (= (get entry :argument-types) (body-io-child-types args types))
                    (= (= :invoked (get entry :entry)) (body-pe-invoked? types args))])
                (recur (+ i 1)) false) false)))) false)))

(defn body-pc-parent-carriers-work [parents current-parent current-first get-data first-data core facts inner-key]
  (let [get-reference (get get-data :parent-reference) first-reference (body-pc-parent-reference first-data)
        get-id (get parents :get-call-id) first-id (get parents :first-call-id)
        get-facts (body-pe-select (get facts :call-type-facts) :call-core-node-id get-id)
        first-facts (body-pe-select (get facts :call-type-facts) :call-core-node-id first-id)
        get-rows (body-pe-select (body-pe-select (get facts :constraint-ledger) :producer-rule :sh08-map-get-v1)
                   :lhs {:core-node-id get-id :projection :map-get})
        first-rows (body-pe-select (body-pe-select (get facts :constraint-ledger) :producer-rule :sh08-vector-first-v1)
                     :lhs {:core-node-id first-id :projection :vector-first})]
    (if (= 1 (count get-facts) (count first-facts) (count get-rows) (count first-rows))
      (loop [pending [[(first get-facts) :fact :applied-map-get
                       (body-pc-fact-data (body-mg-call-fact current-parent (get core :module)) :applied-map-get get-reference get-reference)]
                      [(first first-facts) :fact :applied-vector-first
                       (body-pc-fact-data (body-lq-call-fact current-first (get core :module)) :applied-vector-first first-reference first-reference)]
                      [(first get-rows) :row :applied-map-get
                       (body-pc-row-data (body-mg-constraint current-parent) get-reference get-reference)]
                      [(first first-rows) :row :applied-vector-first
                       (body-pc-row-data (body-lq-constraint current-first) first-reference first-reference)]]]
        (if (= 0 (count pending)) {:status :accepted}
          (let [item (first pending)
                checked (if (= :fact (get item 1))
                          (body-pc-fact-data-work (get item 0) (get item 2) inner-key)
                          (body-pc-row-data-work (get item 0) (get item 2) inner-key))]
            (if (= :accepted (get checked :status))
              (if (= (get checked :value) (get item 3)) (recur (rest pending))
                {:status :rejected :reason :map-get-source-mismatch})
              checked))))
      {:status :rejected :reason :map-get-source-mismatch})))

(defn body-pc-links-current? [links expected core nodes bindings types]
  (if (body-pc-links-domain? links)
    (loop [remaining links]
      (if (= 0 (count remaining)) true
        (let [link (first remaining) record (get link :binding-record)
              ref-id (get link :reference-core-node-id) init-id (get record :initializer-node-id)]
          (if (body-all? [(= record (body-pe-one (get core :lexical-bindings) :binding-id (get record :binding-id)))
                (body-pc-link-core? record (get nodes ref-id) core nodes bindings)
                (= expected (get types ref-id) (get types init-id))])
            (recur (rest remaining)) false)))) false))

(defn body-pc-parents-current? [parents core facts bindings context]
  ; Private leaf use shares this invocation's immutable, C7-validated inputs.
  ; Public entry always rebuilds the full source proof before reaching here.
  ; These joins reuse paid type domains and projections; they do not promise
  ; fresh authentication after replacing an internal context's input payloads.
  (let [widths (body-pc-family-widths core facts)]
    (if (if (vector? widths) (= widths (get parents :core-widths)) false)
      (let [types (get facts :type-table) nodes (get context :nodes) forms (get context :forms)
            get-id (get parents :get-call-id) first-id (get parents :first-call-id)
            parent (get parents :get-descriptor) first-descriptor (get parents :first-descriptor)
            actual-parent (get types (get parents :get-operator-id))
            actual-first (get types (get parents :first-operator-id))
            get-call (body-pe-one (get core :calls) :core-node-id get-id)
            first-call (body-pe-one (get core :calls) :core-node-id first-id)
            get-edge (body-pe-one (get core :call-edges) :call-core-node-id get-id)
            first-edge (body-pe-one (get core :call-edges) :call-core-node-id first-id)
            get-node (body-pe-one (get core :nodes) :node-id get-id)
            first-node (body-pe-one (get core :nodes) :node-id first-id)
            fields [:kind :version :operation :semantic-owner :intrinsic :resolution :operator-node-id :operator-binding-id
                    :call-core-node-id :source :operator-source :source-call :source-edge :source-binding :argument-types
                    :application :latent-effects :direct-effects :capabilities :thrown-error-effects :profile :target :key-node-id :key
                    :lookup-policy :parameter-types :return :result-type :invalidation]]
        (if (body-all? [(= (get parent :source-call) get-call) (= (get first-descriptor :source-call) first-call)
              (= (get parent :source-edge) get-edge) (= (get first-descriptor :source-edge) first-edge)
              (= (get parent :source) (get get-node :source)) (= (get first-descriptor :source) (get first-node :source))
              (body-pc-id? (get (get get-node :evaluation) :owner-function-syntax-id))
              (body-pc-id? (get (get first-node :evaluation) :owner-function-syntax-id))
              (= (get parent :argument-types) (body-io-child-types (get get-call :argument-node-ids) types))
              (= (get first-descriptor :argument-types) (body-io-child-types (get first-call :argument-node-ids) types))
              (= (get parent :result-type) (get types get-id))
              (= (get first-descriptor :result-type) (get types first-id))
              (= (body-project parent fields) (body-project actual-parent fields))
              (= first-descriptor actual-first)
              (body-pc-entry-types-current? actual-parent core types)
              (body-pc-links-current? (get (get parents :route) :receiver-links) (get first-descriptor :result-type) core nodes bindings types)
              (body-pc-links-current? (get (get parents :route) :vector-links) (get parent :result-type) core nodes bindings types)])
          (let [get-header (body-mg-source core get-node get-call get-edge nodes bindings types (get core :module))
                first-header (body-lq-source core first-node first-call first-edge nodes bindings types
                               (get core :module) (get parents :first-type-validation))
                base-fields [:kind :operation :semantic-owner :intrinsic :resolution :operator-node-id :operator-binding-id
                             :call-core-node-id :source :operator-source :source-call :source-edge :source-binding :argument-types
                             :application :latent-effects :direct-effects :capabilities :thrown-error-effects :profile :target :key-node-id :key]]
            (if (if (map? get-header) (map? first-header) false)
              (body-all? [(= (body-project get-header base-fields) (body-project parent base-fields))
                (= (body-lq-finish first-header) first-descriptor)
                (= (body-pe-census get-header core nodes bindings forms) (get (get actual-parent :presence-proof) :entry-census))
                (= [(body-mg-call-fact actual-parent (get core :module))]
                   (body-pe-select (get facts :call-type-facts) :call-core-node-id get-id))
                (= [(body-lq-call-fact actual-first (get core :module))]
                   (body-pe-select (get facts :call-type-facts) :call-core-node-id first-id))
                (= [(body-mg-constraint actual-parent)]
                   (body-pe-select (body-pe-select (get facts :constraint-ledger) :producer-rule :sh08-map-get-v1)
                     :lhs {:core-node-id get-id :projection :map-get}))
                (= [(body-lq-constraint actual-first)]
                   (body-pe-select (body-pe-select (get facts :constraint-ledger) :producer-rule :sh08-vector-first-v1)
                     :lhs {:core-node-id first-id :projection :vector-first}))]) false))
          false))
      false)))

(defn body-mg-context [request facts bindings]
  (let [core (get request :canonical-core-artifact)
        census (loop [remaining (get core :calls) selected 0 private-calls []]
                 (if (= 0 (count remaining))
                   {:calls selected :private-calls private-calls}
                   (let [call (first remaining)
                         selected? (body-mg-binding? (get bindings (get call :operator-binding-id)) (get core :module))
                         private? (if (if selected? (= 2 (count (get call :argument-node-ids))) false)
                                    (let [receiver (get (get facts :type-table) (get (get call :argument-node-ids) 0))
                                          key-type (get (get facts :type-table) (get (get call :argument-node-ids) 1))]
                                      (if (= :gravity.type/map receiver) true
                                        (if (map? receiver) (= :gravity.type/map (get receiver :kind))
                                          (if (= :gravity.type/never receiver) (= :gravity.type/keyword key-type) false))))
                                    false)]
                     (recur (rest remaining) (+ selected (if selected? 1 0))
                       (if private? (conj private-calls call) private-calls)))))]
    (if (= 0 (get census :calls))
      {:status :accepted :context nil}
      (let [forms (body-path request [:b47-context :authenticated-core-request :forms])]
        (if (= false (vector? forms))
          (body-failure :body-map-get-source-forms-required)
          (let [nodes (body-index (get core :nodes) :node-id)
                form-index (body-index forms :form-id)
                call-index (body-index (get core :calls) :core-node-id)
                edge-index (body-index (get core :call-edges) :call-core-node-id)]
            (if (body-all? [(map? nodes) (map? form-index)
                            (map? call-index) (map? edge-index)])
              (loop [remaining (get census :private-calls) checked-private {} checked-parents {}]
                (if (= 0 (count remaining))
                  {:status :accepted
                   :context {:forms form-index :nodes nodes
                             :calls call-index :edges edge-index :bindings bindings
                             :private-selected-checks checked-private :private-parent-checks checked-parents}}
                  (let [call (first remaining) receiver (get nodes (first (get call :argument-node-ids)))
                        supplied (get (get facts :type-table) (get call :operator-node-id))
                        proof (get supplied :presence-proof)
                        private? (if (= :sh08-map-get-private-entry-v1 (get supplied :version)) true
                                   (if (map? proof) (if (contains? proof :entry-census) true (contains? proof :entries)) false))
                        node (get nodes (get call :core-node-id))
                        edge (get edge-index (get call :core-node-id))
                        candidate (body-pc-candidate core node call nodes (get facts :type-table))
                        route (if (= :accepted (get candidate :status))
                                (body-pc-route core node call nodes bindings)
                                candidate)
                        composed? (= :accepted (get route :status))
                        id (get call :core-node-id)
                        header (body-mg-source core node call edge nodes bindings
                                               (get facts :type-table) (get core :module))
                        checked (if (map? header)
                                  (if composed?
                                    (body-pc-full-work route (get checked-private (get route :get-node-id)) core node call edge
                                      nodes bindings (get facts :type-table) form-index
                                      (get facts :call-type-facts) (get facts :constraint-ledger))
                                    (if private?
                                      (body-pe-check header supplied core nodes bindings form-index
                                        (get facts :type-table))
                                      (let [validated (if (= :normal (get header :application))
                                                        (body-pe-validate-selected header {:calls [call] :parameter-index 0}
                                                          [(get proof :operand-shape)] (get facts :type-table) false)
                                                        {:status :accepted})
                                            expected (if (= :accepted (get validated :status))
                                                       (body-mg-present-finish header (get proof :operand-shape)) nil)]
                                        (if (map? expected) (assoc validated :descriptor expected)
                                          (if (= :rejected (get validated :status)) validated
                                            {:status :rejected :reason :map-get-private-entry-presence-required})))))
                                  {:status :rejected :reason :map-get-private-entry-presence-required})]
                    (if (= :accepted (get checked :status))
                      (recur (rest remaining) (assoc checked-private id (get checked :descriptor))
                        (if composed?
                          (assoc checked-parents id (assoc (get checked :parents) :core-widths (body-pc-family-widths core facts)))
                          checked-parents))
                      checked))))
              (body-failure :body-map-get-source-forms-required))))))))

(defn body-mg-present-forms? [node nodes forms header]
  (let [owner (get forms (get (get node :source) :form-id)) ids (get owner :child-form-ids)
        children (get node :children)]
    (if (if (vector? ids) (= 3 (count ids) (count children)) false)
      (body-all? [(= :list (get owner :kind)) (= (get node :source) (get (body-ma-form-node {} owner) :source))
            (= {:operator-child-index 0 :argument-count 2 :argument-child-indexes [1 2]
                :evaluation-order :operator-then-arguments :dispatch :resolved-symbol-call} (get node :attributes))
            (loop [i 0]
              (if (= i 3) true
                (let [form (get forms (get ids i)) child (get nodes (get children i))]
                  (if (body-all? [(= (get owner :form-id) (get form :parent-form-id))
                            (= (get child :source) (get (body-ma-form-node {} form) :source))
                            (if (= i 0) (= (get form :value) (get (get child :attributes) :symbol)) true)
                            (if (= i 2) (if (= :gravity.type/never (get (get header :argument-types) 1)) true
                              (if (= :keyword (get form :kind)) (= (get header :key) (get form :value)) false)) true)])
                    (recur (+ i 1)) false))))]) false)))

(defn body-pc-paid-present-call-valid? [core facts bindings node call edge nodes]
  (let [types (get facts :type-table) descriptor (get types (get call :operator-node-id))
        header (body-mg-source core node call edge nodes bindings types (get core :module))
        forms (get (get facts :map-get-context) :forms)
        input (get (get descriptor :presence-proof) :operand-shape)
        expected (if (map? header)
                   (if (= :not-invoked (get header :application))
                     (body-mg-present-finish header input)
                   (let [paid (get (get (get facts :map-get-context) :private-selected-checks) (get node :node-id))
                         fields [:kind :operation :semantic-owner :intrinsic :resolution :operator-node-id :operator-binding-id
                                 :call-core-node-id :source :operator-source :source-call :source-edge :source-binding :argument-types
                                 :application :latent-effects :direct-effects :capabilities :thrown-error-effects :profile :target :key-node-id :key]
                         current? (if (map? paid) (= (body-project paid fields) (body-project header fields)) false)]
                     (if current?
                       (if (= :sh08-map-get-private-entry-v1 (get paid :version))
                         (let [census (body-pe-census header core nodes bindings forms)
                               entries (get (get paid :presence-proof) :entries)]
                           (if (= census (get (get paid :presence-proof) :entry-census))
                             (if (loop [remaining entries calls (get census :calls)]
                                   (if (= 0 (count remaining)) (= 0 (count calls))
                                     (if (= 0 (count calls)) false
                                       (let [entry (first remaining) source-call (first calls) args (get source-call :argument-node-ids)
                                             argument-id (get args (get census :parameter-index))]
                                         (if (body-all? [(= argument-id (get entry :argument-node-id))
                                               (= (get entry :argument-type) (get types argument-id))
                                               (= (get entry :argument-types) (body-io-child-types args types))])
                                           (recur (rest remaining) (rest calls)) false))))) paid nil) nil))
                         paid) nil))) nil)
        rows (body-select (body-select (get facts :constraint-ledger) :producer-rule :sh08-map-get-v1)
                          :lhs {:core-node-id (get node :node-id) :projection :map-get})]
    (if (map? expected)
      (body-all? [(= expected descriptor) (= (get expected :result-type) (get types (get node :node-id)))
                  (body-mg-present-forms? node nodes forms header)
                  (= (body-mg-call-fact expected (get core :module))
                     (body-by (get facts :call-type-facts) :call-core-node-id (get node :node-id)))
                  (= [(body-mg-constraint expected)] rows)]) false)))

(defn body-mg-present-call-valid? [core facts bindings node call edge nodes]
  (let [context (get facts :map-get-context) id (get node :node-id)
        parents (if (body-pc-id? id) (get (get context :private-parent-checks) id) nil)]
    (if (map? parents)
      (if (body-pc-parents-current? parents core facts bindings context)
        (body-pc-paid-present-call-valid? core facts bindings node call edge nodes) false)
      (body-pc-paid-present-call-valid? core facts bindings node call edge nodes))))

(defn body-mg-call-valid? [core facts bindings node call edge nodes]
  (if (= :sh08-vector-get-indexed-private-self-v1 (get (get (get facts :type-table) (get call :operator-node-id)) :version))
    (body-ix-call-valid? core facts bindings node call edge nodes)
  (if (= 2 (count (get call :argument-node-ids)))
    (body-mg-present-call-valid? core facts bindings node call edge nodes)
  (let [types (get facts :type-table) descriptor (get types (get call :operator-node-id))
        header (body-mg-source core node call edge nodes bindings types (get core :module))
        forms (get (get facts :map-get-context) :forms)
        owner (get forms (get (get node :source) :form-id)) ids (get owner :child-form-ids)
        rows (body-select (body-select (get facts :constraint-ledger) :producer-rule :sh08-map-get-v1)
                          :lhs {:core-node-id (get node :node-id) :projection :map-get})]
    (if (map? header)
      (body-all?
        [(= descriptor (body-mg-finish header)) (= (get descriptor :result-type) (get types (get node :node-id)))
         (= :list (get owner :kind)) (vector? ids) (= 4 (if (vector? ids) (count ids) 0) (count (get node :children)))
         (= (get node :source) (get (body-ma-form-node {} owner) :source))
         (= {:operator-child-index 0 :argument-count 3 :argument-child-indexes [1 2 3]
             :evaluation-order :operator-then-arguments :dispatch :resolved-symbol-call} (get node :attributes))
         (loop [i 0]
           (if (= i 4) true
             (let [form (get forms (get ids i)) child (get nodes (get (get node :children) i))]
               (if (body-all? [(= (get owner :form-id) (get form :parent-form-id))
                     (= (get child :source) (get (body-ma-form-node {} form) :source))
                     (if (= i 0) (= (get form :value) (get (get child :attributes) :symbol)) true)])
                 (recur (+ i 1)) false))))
         (= (body-mg-call-fact descriptor (get core :module)) (body-by (get facts :call-type-facts) :call-core-node-id (get node :node-id)))
         (= [(body-mg-constraint descriptor)] rows)]) false)))))

(defn body-mg-node? [node facts core]
  (let [context (get facts :map-get-context) id (get node :node-id)]
    (if (map? context)
      (body-mg-call-valid? core facts (get context :bindings) node (get (get context :calls) id)
                          (get (get context :edges) id) (get context :nodes)) false)))

(defn body-mc-binding? [binding module]
  (if (if (vector? (get binding :profile-set)) (vector? (get binding :target-set)) false)
  (body-all?
    [(= ['contains? :core :var 'gravity.core {:name 'gravity/core :version "bootstrap-contract-v1"} :gravity.type/core-var :safe]
        [(get binding :name) (get binding :binding-class) (get binding :kind) (get binding :namespace)
         (get binding :package) (get binding :type-ref) (get binding :safety)])
     (= [] (get binding :effects) (get binding :capabilities))
     (contains? (set (get binding :profile-set)) (get module :profile))
     (contains? (set (get binding :target-set)) :all)]) false))

(defn body-sysm-selected? [arguments]
  (if (if (vector? arguments) (= 2 (count arguments)) false)
    (let [items (get arguments 0) needle (get arguments 1)]
      (if (if (= :gravity.type/symbol needle) true (= :gravity.type/never needle))
        (if (= :gravity.type/never items) (= :gravity.type/symbol needle)
        (if (body-syc-type? items) true
        (if (if (map? items) (if (= 3 (count items))
              (if (loop [fields (keys items)] (if (= 0 (count fields)) true
                    (if (keyword? (first fields)) (recur (rest fields)) false)))
                (if (= :gravity.type/set (get items :kind))
                  (if (= :literal (get items :shape)) (vector? (get items :element-types)) false) false) false) false) false)
          (let [members (get items :element-types)]
            (if (= 0 (count members)) (= :gravity.type/symbol needle)
              (if (= :gravity.type/symbol (get members 0))
                (if (= :gravity.type/symbol needle) true (= :gravity.type/never needle)) false))) false)))
        false)) false))

(defn body-sysm-domain [arguments]
  ; STD3 membership: Symbol spelling is inert DATA, never binding authority.
  ; Validate the supplied type graph without charging or reserving work.
  (if (if (vector? arguments) (= 2 (count arguments)) false)
    (let [items (get arguments 0) needle (get arguments 1)]
      (if (if (= :gravity.type/symbol needle) true (= :gravity.type/never needle))
        (if (= :gravity.type/never items)
          {:status :accepted :argument-types arguments :set-member-count nil :membership-family :symbol}
          (if (body-syc-type? items)
            {:status :accepted :argument-types arguments :set-member-count nil :membership-family :symbol}
            (if (if (map? items) (if (= 3 (count items))
                  (if (loop [fields (keys items)] (if (= 0 (count fields)) true
                        (if (keyword? (first fields)) (recur (rest fields)) false)))
                    (if (= :gravity.type/set (get items :kind))
                      (if (= :literal (get items :shape)) (vector? (get items :element-types)) false) false) false) false) false)
              (let [members (get items :element-types) n (count members)]
                (if (loop [i 0] (if (= i n) true
                      (if (= :gravity.type/symbol (get members i)) (recur (+ i 1)) false)))
                  {:status :accepted :argument-types arguments :set-member-count n :membership-family :symbol}
                  {:status :rejected :reason :symbol-set-contains-operand-type-required}))
              {:status :rejected :reason :symbol-set-contains-operand-type-required})))
        {:status :rejected :reason :symbol-set-contains-operand-type-required}))
    {:status :rejected :reason :keyword-set-contains-arity-mismatch}))

(defn body-ism-selected? [arguments]
  (if (if (vector? arguments) (= 2 (count arguments)) false)
    (let [items (get arguments 0) needle (get arguments 1)]
      (if (= :gravity.type/integer needle) true
        (if (= :gravity.type/never needle)
          ; Descriptor field count is schema, not a collection-size quota.
          ; Match C7: reject the wrong shape before reading supplied fields.
          (if (if (map? items) (= 3 (count items)) false)
            (if (if (= :gravity.type/set (get items :kind)) (= :literal (get items :shape)) false)
              (let [members (get items :element-types)]
                (if (vector? members) (= :gravity.type/integer (get members 0)) false)) false) false) false))) false))

(defn body-ism-domain [arguments]
  ; L5/STD5: exact generic Integer equality performs no arithmetic or conversion.
  (if (if (vector? arguments) (= 2 (count arguments)) false)
    (let [items (get arguments 0) needle (get arguments 1)]
      (if (if (= :gravity.type/integer needle) true (= :gravity.type/never needle))
        (if (= :gravity.type/never items)
          {:status :accepted :argument-types arguments :set-member-count nil :membership-family :integer}
          (if (if (map? items) (if (= 3 (count items))
                (if (loop [fields (keys items)] (if (= 0 (count fields)) true
                      (if (keyword? (first fields)) (recur (rest fields)) false)))
                  (if (= :gravity.type/set (get items :kind))
                    (if (= :literal (get items :shape)) (vector? (get items :element-types)) false) false) false) false) false)
            (let [members (get items :element-types) n (count members)]
              (if (loop [i 0]
                    (if (= i n) true
                      (if (= :gravity.type/integer (get members i)) (recur (+ i 1)) false)))
                {:status :accepted :argument-types arguments :set-member-count n :membership-family :integer}
                {:status :rejected :reason :integer-set-contains-operand-type-required}))
            {:status :rejected :reason :integer-set-contains-operand-type-required}))
        {:status :rejected :reason :integer-set-contains-operand-type-required}))
    {:status :rejected :reason :integer-set-contains-operand-type-required}))

(defn body-ksm-set-result [arguments items needle character? strings? type-reason schema?]
  (if (if schema? (= :homogeneous (get items :shape)) false)
    (if (if (body-ss-type? items)
          (if strings? true (= :gravity.type/never needle))
          false)
      {:status :accepted :argument-types arguments :set-member-count nil :membership-family :string}
      {:status :rejected :reason type-reason})
    (let [set-type? (if schema?
                     (if (= :gravity.type/set (get items :kind))
                       (if (= :literal (get items :shape))
                         (vector? (get items :element-types))
                         false)
                       false)
                     false)]
      (if set-type?
        (let [members (get items :element-types)
              n (count members)
              initial-family (if character? :character (if strings? :string :keyword))]
          (loop [i 0 family initial-family]
            (if (= i n)
              (if (= :character family)
                {:status :accepted :argument-types arguments :set-member-count n :membership-family :character}
                (if (= :string family)
                  {:status :accepted :argument-types arguments :set-member-count n :membership-family :string}
                  {:status :accepted :argument-types arguments :set-member-count n}))
              (let [member (get members i)
                    expected (if (= :character family)
                               :gravity.type/character
                               (if (= :string family) :gravity.type/string :gravity.type/keyword))]
                (if (= expected member)
                  (recur (+ i 1) family)
                  (if (if (= i 0) (= :gravity.type/never needle) false)
                    (if (= :gravity.type/character member)
                      (recur 1 :character)
                      (if (= :gravity.type/string member)
                        (recur 1 :string)
                        {:status :rejected :reason type-reason}))
                    {:status :rejected
                     :reason (if (= :character family)
                               :character-set-contains-operand-type-required
                               (if (= :string family)
                                 :string-set-contains-operand-type-required
                                 type-reason))}))))))
        {:status :rejected :reason type-reason}))))

(defn body-ksm-domain [arguments]
  ; Validate the complete input type graph before selecting a membership family.
  ; Inspecting a type graph is semantic validation, not a work reservation.
  (let [ingress (body-lc-validate-types arguments)]
    (if (= :accepted (get ingress :status))
      (let [ism? (body-ism-selected? arguments)
            sysm? (body-sysm-selected? arguments)]
        (if ism?
          (body-ism-domain arguments)
          (if sysm?
            (body-sysm-domain arguments)
            (if (if (vector? arguments) (= 2 (count arguments)) false)
              (let [items (get arguments 0)
                    needle (get arguments 1)
                    character? (= :gravity.type/character needle)
                    strings? (= :gravity.type/string needle)
                    allowed-needle? (if character?
                                     true
                                     (if strings?
                                       true
                                       (if (= :gravity.type/keyword needle)
                                         true
                                         (= :gravity.type/never needle))))
                    type-reason (if character?
                                  :character-set-contains-operand-type-required
                                  (if strings?
                                    :string-set-contains-operand-type-required
                                    :keyword-set-contains-operand-type-required))
                    schema? (if (map? items)
                              (if (= 3 (count items))
                                (loop [fields (keys items)]
                                  (if (= 0 (count fields))
                                    true
                                    (if (keyword? (first fields))
                                      (recur (rest fields))
                                      false)))
                                false)
                              false)]
                (if allowed-needle?
                  (if (= :gravity.type/never items)
                    (if character?
                      {:status :accepted :argument-types arguments :set-member-count nil :membership-family :character}
                      (if strings?
                        {:status :accepted :argument-types arguments :set-member-count nil :membership-family :string}
                        {:status :accepted :argument-types arguments :set-member-count nil}))
                    (body-ksm-set-result arguments items needle character? strings? type-reason schema?))
                  {:status :rejected :reason :keyword-set-contains-operand-type-required}))
              {:status :rejected :reason :keyword-set-contains-arity-mismatch}))))
      {:status :rejected :reason :keyword-set-contains-operand-type-required
       :type-check-reason (get ingress :reason)})))

(defn body-sysm-source-ids? [node call nodes bindings module]
  (if (body-sse-call-ids? node call)
    (let [operator (get nodes (get call :operator-node-id)) binding (get bindings (get call :operator-binding-id))]
      (if (body-sse-ids? [(get operator :node-id) (get (get operator :source) :form-id)
                         (get (get operator :source) :syntax-id) (get binding :binding-id)] 4)
        (if (if (vector? (get binding :profile-set)) (vector? (get binding :target-set)) false)
          (if (loop [items (get binding :profile-set)]
                (if (= 0 (count items)) true (if (keyword? (first items)) (recur (rest items)) false)))
            (if (loop [items (get binding :target-set)]
                  (if (= 0 (count items)) true (if (keyword? (first items)) (recur (rest items)) false)))
              (if (if (symbol? (get (get operator :attributes) :symbol)) (keyword? (get module :profile)) false)
                (body-all?
                  [(= (get node :node-id) (get call :core-node-id))
                   (= (get operator :node-id) (get call :operator-node-id) (first (get node :children)))
                   (= (get binding :binding-id) (get call :operator-binding-id))
                   (= (get call :argument-node-ids) (vec (rest (get node :children))))
                   (= [(get call :operator-binding-id)] (get node :resolved-binding-ids) (get operator :resolved-binding-ids))
                   (contains? '#{contains? gravity.core/contains?} (get (get operator :attributes) :symbol))
                   (= :jvm (get module :target)) (body-mc-binding? binding module)]) false)
              false) false) false) false)) false))

(defn body-ksm-source [core node call edge nodes bindings types module validation]
  (if (if (contains? #{:symbol :integer} (get validation :membership-family)) (body-sysm-source-ids? node call nodes bindings module) true)
    (if (if (vector? (get call :argument-node-ids))
        (if (= 2 (count (get call :argument-node-ids)))
          (if (vector? (get node :children)) (= 3 (count (get node :children))) false) false) false)
  (if (loop [remaining (conj (conj (conj (conj (conj (get call :argument-node-ids) (get call :operator-node-id)) (get call :operator-binding-id)) (get node :node-id)) (get (get node :source) :form-id)) (get (get node :source) :syntax-id))]
        (if (= 0 (count remaining))
          (loop [remaining (get node :children)]
            (if (= 0 (count remaining)) true
              (let [id (first remaining)]
                (if (if (keyword? id) true (if (string? id) (= 71 (count id)) false)) (recur (rest remaining)) false))))
          (let [id (first remaining)]
            (if (if (keyword? id) true (if (string? id) (= 71 (count id)) false)) (recur (rest remaining)) false))))
  (let [children (get node :children) operator (get nodes (get call :operator-node-id))
        bid (get call :operator-binding-id) binding (get bindings bid) args (get call :argument-node-ids)
        arguments (body-io-child-types args types)
        invoked? (loop [remaining arguments]
                   (if (= 0 (count remaining)) true
                     (if (= :gravity.type/never (first remaining)) false (recur (rest remaining)))))
        caller (loop [remaining (get core :function-records)]
                 (if (= 0 (count remaining)) nil
                   (if (= (get (first remaining) :function-syntax-id) (get (get node :evaluation) :owner-function-syntax-id))
                     (first remaining) (recur (rest remaining)))))
        expected-call {:core-node-id (get node :node-id) :operator-node-id (first children) :operator-binding-id bid
                       :argument-node-ids (vec (rest children)) :ordered-evaluation-node-ids children
                       :evaluation-order :operator-then-arguments :result-policy :call-result}
        expected-edge {:ordinal (get edge :ordinal) :call-core-node-id (get node :node-id)
                       :caller-function-syntax-id (get caller :function-syntax-id) :caller-function-core-node-id (get caller :function-core-node-id)
                       :callee-binding-id bid :callee-definition-syntax-id (get binding :definition-syntax-id)
                       :callee-function-syntax-id nil :callee-function-core-node-id nil :argument-core-node-ids args
                       :ordered-evaluation-node-ids children :evaluation-order :operator-then-arguments :classification :nonlocal-or-nonfunction}]
    (if (body-all?
          [(= :accepted (get validation :status)) (= arguments (get validation :argument-types))
           (= :call (get node :core-form)) (= :reference (get operator :core-form))
           (= :jvm (get module :target))
           (= 2 (count args)) (= expected-call call) (= expected-edge edge) (body-mc-binding? binding module)
           (= [bid] (get node :resolved-binding-ids) (get operator :resolved-binding-ids))
           (= {:symbol (get (get operator :attributes) :symbol) :position :operator :binding-id bid :binding-class :core
               :definition-syntax-id (get binding :definition-syntax-id)} (get operator :attributes))
           (contains? '#{contains? gravity.core/contains?} (get (get operator :attributes) :symbol))
           (= :operator-then-arguments (get (get node :evaluation) :kind))
           (= (loop [i 0 out []] (if (= i (count children)) out
                (recur (+ i 1) (conj out {:index i :core-node-id (get children i)})))) (get (get node :evaluation) :order))
          ])
      (if (= :integer (get validation :membership-family))
        {:kind :gravity.type/applied-integer-set-contains :version :sh08-integer-set-contains-v1
       :operation 'contains? :semantic-owner 'gravity.collections :intrinsic :gravity.collections/integer-set-membership
       :resolution :gravity.core-compatibility :operator-node-id (get operator :node-id) :operator-binding-id bid
       :call-core-node-id (get node :node-id) :source (get node :source) :operator-source (get operator :source)
       :source-call call :source-edge edge :source-binding binding :argument-types arguments
       :set-member-count (get validation :set-member-count)
       :membership-policy {:input :finite-persistent-integer-set :members :generic-integer-only :needle :generic-integer-only
                           :comparison :original-integer-values :conversion :none :arithmetic :none :overflow :impossible :rounding :none
                           :cross-type :unsupported :operand-evaluation :set-then-value-once
                           :domain-validation :all-before-hit-or-miss :member-uniqueness :validated-before-result
                           :precision-bound :not-established :provider-cpu-bound :not-established :provider-heap-bound :not-established
                           :payload-evaluation :none :mutation :none :construction :none :refinement :none
                           :cardinality-facts :none :enumeration-order :unobserved}
       :numeric-mode :proof-required :safety :proven-safe
       :safety-rule :same-integral-value-equality-no-conversion-overflow-or-rounding
       :application (if invoked? :normal :not-invoked)
       :latent-effects [] :direct-effects [] :capabilities [] :thrown-error-effects []
       :profile (get module :profile) :target (get module :target)
       :invalidation [:calls :call-edges :binding-table :source-forms :type-table :lexical-bindings :definitions :function-records
                      :callee-body :membership-domain :member-value-policy :profile :target :evaluation-order]}
        (if (= :symbol (get validation :membership-family))
        {:kind :gravity.type/applied-symbol-set-contains :version :sh08-symbol-set-contains-v2
       :operation 'contains? :semantic-owner 'gravity.collections :intrinsic :gravity.collections/symbol-set-membership
       :resolution :gravity.core-compatibility :operator-node-id (get operator :node-id) :operator-binding-id bid
       :call-core-node-id (get node :node-id) :source (get node :source) :operator-source (get operator :source)
       :source-call call :source-edge edge :source-binding binding :argument-types arguments
       :set-member-count (get validation :set-member-count)
       :membership-policy {:carrier-schema :gravity/homogeneous-symbol-set-type-v1 :input :finite-persistent-symbol-set :members :symbol-only :needle :symbol-only
                           :comparison :guarded-atomic-symbol-leaf :operand-evaluation :set-then-value-once

            (body-failure :body-set-conversion-families-required)))
        (body-failure :body-set-conversion-families-required))
      (body-failure :body-set-conversion-families-required))))

(defn body-st-call-valid? [core facts bindings node call edge nodes]
  (if (body-lset-entry? node call nodes bindings (get facts :type-table) (get core :module))
    (let [types (get facts :type-table) context (get facts :set-conversion-context)

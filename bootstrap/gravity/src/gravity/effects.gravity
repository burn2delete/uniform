                           list-checks)))))
                      (body-failure
                       :body-equality-binary-call-required))
                     (body-failure
                      :body-atomic-equality-source-identities-required)))
                   (body-failure
                    :body-equality-binary-call-required))))
                (recur
                 (rest remaining)
                 checks
                 keyword-checks
                 list-checks))))))
           (body-failure
            :body-atomic-equality-source-identities-required))))))))
    (body-failure :body-atomic-equality-source-identities-required)))
  (body-failure :body-atomic-equality-source-identities-required)))

(defn body-ae-call-valid? [core facts bindings node call edge nodes]
  (if (if (body-bka-entry? node call nodes bindings (get facts :type-table) (get core :module)) true
    (if (body-sse-call-ids? node call)
      (if (keyword? (get (get (get facts :type-table) (get call :operator-node-id)) :kind))
        (= :gravity.type/applied-bare-keyword-anchor-set-equality (get (get (get facts :type-table) (get call :operator-node-id)) :kind)) false) false))
    (body-bka-call-valid? core facts bindings node call edge nodes)
    (if (body-sse-call-ids? node call)
    (if (if (= :gravity.type/applied-list-equality (get (get (get facts :type-table) (get call :operator-node-id)) :kind)) true
            (contains? (get (get facts :equality-context) :list-domains) (get node :node-id)))
      (body-le-call-valid? core facts bindings node call edge nodes)
(if (if (contains? #{:gravity.type/applied-keyword-set-equality :gravity.type/applied-string-set-equality} (get (get (get facts :type-table) (get call :operator-node-id)) :kind)) true
          (contains? (get (get facts :equality-context) :keyword-set-domains) (get node :node-id)))
    (body-kse-call-valid? core facts bindings node call edge nodes)
      (if (if (= :gravity.type/applied-vector-equality (get (get (get facts :type-table) (get call :operator-node-id)) :kind)) true
          (contains? (get (get facts :equality-context) :vector-domains) (get node :node-id)))
    (body-ve-call-valid? core facts bindings node call edge nodes)
  (if (if (= :gravity.type/applied-integral-equality (get (get (get facts :type-table) (get call :operator-node-id)) :kind)) true
          (let [args (get call :argument-node-ids) types (get facts :type-table)]
            (if (if (vector? args) (= 2 (count args)) false)
              (if (body-ie-type? (get types (get args 0))) true (body-ie-type? (get types (get args 1)))) false)))
    (body-ie-call-valid? core facts bindings node call edge nodes)
  (let [types (get facts :type-table) descriptor (get types (get call :operator-node-id))
        header (body-ae-source core node call edge nodes bindings types (get core :module))
        forms (get (get facts :equality-context) :forms)
        owner (get forms (get (get node :source) :form-id)) ids (get owner :child-form-ids)
        rows (body-select (body-select (get facts :constraint-ledger) :producer-rule :sh08-atomic-equality-v1)

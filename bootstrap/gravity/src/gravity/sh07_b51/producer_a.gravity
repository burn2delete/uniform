     :macro-origin-expectation :pending-fact-families}))

(defn sh07-b51-v16-artifact-identity-view [artifact]
  {:domain (get (get artifact :identity-preimage) :domain)
   :lineage (get artifact :lineage)
   :projection-binding (get artifact :projection-binding)
   :module (get artifact :module)
   :fragment-manifest (get artifact :fragment-manifest)
   :fragment-coverage (get artifact :fragment-coverage)
   :module-assembly-manifest (get artifact :module-assembly-manifest)

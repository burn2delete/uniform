(defn sh07-b51-v16-result-boundary-shape? [result]
  (let [status (get result :status)
        containment (get result :containment)
        boundary (get result :execution-boundary)]
    (if (= (get result :bounds) (sh07-b51-v16-frozen-bounds))
      (if (sh07-b51-exact-keys?
           containment
           #{:downstream-artifacts-forbidden :host-exception-contained})
        (if (= (get containment :host-exception-contained) true)
          (if (= (get containment :downstream-artifacts-forbidden)
                 (= status :rejected))
            (if (sh07-b51-exact-keys?
                 boundary
                 #{:source-language :owner :entry
                   :sh06-projection-authentication :digest-resolution
                   :artifact-binding :clojure-seed-boundary?})
              (if (= (get boundary :source-language) :gravity)
                (if (= (get boundary :owner) :gravity.checked-core)
                  (if (= (get boundary :entry)
                         'sh07-build-core-template)
                    (if (= (get boundary :sh06-projection-authentication)
                           :clojure-stage0)
                      (if (= (get boundary :digest-resolution)
                             :clojure-stage0)
                        (if (= (get boundary :artifact-binding)
                               (if (= status :accepted)
                                 :clojure-stage0 :forbidden))
                          (= (get boundary :clojure-seed-boundary?) true)
                          false)
                        false)
                      false)
                    false)
                  false)
                false)
              false)
            false)
          false)
        false)
      false)))

(defn sh07-b51-v16-template-result-common-shape? [result]
  (if (sh07-b51-exact-keys?
       result
       #{:artifact :schema-version :status :core-template
         :digest-requests :diagnostics :bounds :containment
         :execution-boundary})
    (if (= (get result :artifact) :gravity/sh07-core-template-result)
      (if (= (get result :schema-version) 16)
        (if (contains? #{:accepted :rejected} (get result :status))
          (if (sh07-b51-v16-digest-request-sequence?
               (get result :digest-requests))
            (if (vector? (get result :diagnostics))
              (sh07-b51-v16-result-boundary-shape? result)
              false)
            false)
          false)
        false)
      false)
    false))

(defn sh07-b51-v16-diagnostic-preimage-shape? [value]
  (if (sh07-b51-exact-keys?
       value
       #{:domain :rule :syntax-id :form-id :semantic-source-span
         :origin-chain :generated-origin-chain :namespace :profile :target
         :source-revision-id :sh06-artifact-id :facts})
    (if (= (get value :domain) :gravity/sh07-b47-c6-diagnostic-v16)
      (if (string? (get value :rule))
        (if (vector? (get value :origin-chain))
          (if (vector? (get value :generated-origin-chain))
            (if (sh07-b51-sha256-id?
                 (get value :source-revision-id))
              (sh07-b51-sha256-id? (get value :sh06-artifact-id))
              false)
            false)
          false)
        false)
      false)
    false))

(defn sh07-b51-v16-diagnostic-shape? [value]
  (if (sh07-b51-exact-keys?
       value
       #{:artifact :rule :severity :stage :syntax-id :form-id
         :core-node-id :source-span :generated-origin-chain :namespace
         :profile :target :lowering-rule :facts :remediation
         :diagnostic-id-request})
    (if (= (get value :artifact) :gravity/sh07-core-diagnostic)
      (if (= (get value :severity) :error)
        (if (= (get value :stage) :core-lowering)
          (if (= (get value :core-node-id) nil)
            (if (= (get value :lowering-rule)
                   :sh07-b47-function-call-recursion-products)
              (if (vector? (get value :generated-origin-chain))
                (string? (get value :remediation))

(defn sh07-b51-v16-diagnostic-facts-from-preimage [preimage]
  {:reason (get (get preimage :facts) :reason)
   :semantic-rule (get (get preimage :facts) :semantic-rule)
   :rule-specific (get preimage :facts)
   :source-revision-id (get preimage :source-revision-id)
   :sh06-artifact-id (get preimage :sh06-artifact-id)
   :fail-closed true})

(defn sh07-b51-v16-diagnostic-source-span [preimage request]
  (let [span (get preimage :semantic-source-span)
        source (get (get request :provenance) :actual-source-path)]
    (if (map? span)
      (assoc span :source source)
      {:source source})))

(defn sh07-b51-v16-diagnostic-matches-preimage?
  [diagnostic preimage request resolved-id?]
  (if (sh07-b51-v16-diagnostic-shape? diagnostic)
    (if (= (get diagnostic :rule) (get preimage :rule))
      (if (= (get diagnostic :syntax-id) (get preimage :syntax-id))
        (if (= (get diagnostic :form-id) (get preimage :form-id))
          (if (= (get diagnostic :source-span)
                 (sh07-b51-v16-diagnostic-source-span preimage request))
            (if (= (get diagnostic :generated-origin-chain)
                   (get preimage :generated-origin-chain))
              (if (= (get diagnostic :namespace) (get preimage :namespace))
                (if (= (get diagnostic :profile) (get preimage :profile))
                  (if (= (get diagnostic :target) (get preimage :target))
                    (if (= (get diagnostic :facts)
                           (sh07-b51-v16-diagnostic-facts-from-preimage
                            preimage))
                      (if resolved-id?
                        (sh07-b51-sha256-id?
                         (get diagnostic :diagnostic-id-request))
                        (if (sh07-b51-v16-internal-reference-shape?
                             (get diagnostic :diagnostic-id-request))
                          (= (get (get diagnostic :diagnostic-id-request)
                                  :ordinal)
                             0)
                          false))
                      false)
                    false)
                  false)
                false)
              false)
            false)
          false)
        false)
      false)
    false))

(defn sh07-b51-v16-rejected-observation-agrees?
  [direct-result structural request]
  (let [requests (get direct-result :digest-requests)
        diagnostics (get direct-result :diagnostics)]
    (if (= (get direct-result :status) :rejected)
      (if (= (get direct-result :core-template) nil)
        (if (= (count requests) 1)
          (if (= (count diagnostics) 1)
            (let [digest-request (first requests)
                  diagnostic (first diagnostics)
                  preimage (get digest-request :preimage)
                  thrown (get structural :thrown)]
              (if (= (get digest-request :ordinal) 0)
                (if (= (get digest-request :purpose)
                       :sh07-core-diagnostic-id)
                  (if (sh07-b51-v16-diagnostic-preimage-shape? preimage)
                    (if (sh07-b51-v16-diagnostic-matches-preimage?
                         diagnostic preimage request false)
                      (if (= (get structural :returned) nil)
                        (if (sh07-b51-v16-diagnostic-matches-preimage?
                             thrown preimage request true)
                          (= thrown
                             (assoc diagnostic :diagnostic-id-request
                                    (get thrown :diagnostic-id-request)))
                          false)
                        false)
                      false)
                    false)
                  false)
                false))
            false)
          false)
        false)
      false)))

(defn sh07-b51-v16-resolve-controlled-value [value resolved]
  (if (sh07-b51-v16-internal-reference-shape? value)
    (let [ordinal (get value :ordinal)]
      (if (< ordinal (count resolved))
        (if (sh07-b51-sha256-id? (get resolved ordinal))
          {:status :accepted :value (get resolved ordinal)}
          {:status :rejected :reason :resolved-reference-not-sha256})
        {:status :rejected :reason :resolved-reference-out-of-range}))
    (if (map? value)
      (loop [remaining (keys value) result {}]
        (if (= (count remaining) 0)
          {:status :accepted :value result}
          (let [key (first remaining)
                resolved-value
                (sh07-b51-v16-resolve-controlled-value
                 (get value key) resolved)]
            (if (= (get resolved-value :status) :accepted)
              (recur
               (rest remaining)
               (assoc result key (get resolved-value :value)))
              resolved-value))))
      (if (vector? value)
        (loop [remaining value result []]
          (if (= (count remaining) 0)
            {:status :accepted :value result}
            (let [resolved-value
                  (sh07-b51-v16-resolve-controlled-value
                   (first remaining) resolved)]
              (if (= (get resolved-value :status) :accepted)
                (recur
                 (rest remaining)
                 (conj result (get resolved-value :value)))
                resolved-value))))
        {:status :accepted :value value}))))

(defn sh07-b51-v16-semantic-projection-id [value]
  (if (get (get value :lineage) :sh06-semantic-projection-id)
    (get (get value :lineage) :sh06-semantic-projection-id)
    (if (get value :sh06-semantic-projection-id)
      (get value :sh06-semantic-projection-id)
      (get (get value :attributes) :sh06-semantic-projection-id))))

(defn sh07-b51-v16-normalize-binding [projection-id binding]
  (let [value-1
        (if (get binding :upstream-binding-id)
          (assoc binding :upstream-binding-id (get binding :binding-id))
          binding)]
    (if (if projection-id
          (contains? value-1 :definition-artifact-id)
          false)
      (assoc value-1 :definition-artifact-id projection-id)
      value-1)))

(defn sh07-b51-v16-normalize-resolution [resolution]
  (if (get resolution :upstream-binding-id)
    (assoc resolution :upstream-binding-id (get resolution :binding-id))
    resolution))

(defn sh07-b51-v16-normalize-reference [projection-id reference]
  (let [value-1
        (if (get reference :upstream-binding-id)
          (assoc reference :upstream-binding-id (get reference :binding-id))
          reference)
        value-2
        (if (if projection-id
              (contains? value-1 :definition-artifact-id)
              false)
          (assoc value-1 :definition-artifact-id projection-id)
          value-1)]
    (if (if projection-id
          (contains? value-2 :authenticated-sh06-artifact-id)
          false)
      (assoc value-2 :authenticated-sh06-artifact-id projection-id)
      value-2)))

(defn sh07-b51-v16-normalize-mutation [projection-id mutation]
  (let [value-1
        (if (get mutation :target-upstream-binding-id)
          (assoc mutation :target-upstream-binding-id
                 (get mutation :target-binding-id))
          mutation)
        value-2
        (if (if projection-id
              (contains? value-1 :target-definition-artifact-id)
              false)
          (assoc value-1 :target-definition-artifact-id projection-id)
          value-1)]
    (if (if projection-id
          (contains? value-2 :authenticated-sh06-artifact-id)
          false)
      (assoc value-2 :authenticated-sh06-artifact-id projection-id)
      value-2)))

(defn sh07-b51-v16-normalize-authenticated-artifact
  [projection-id value]
  (if (if projection-id
        (contains? value :authenticated-sh06-artifact-id)
        false)
    (assoc value :authenticated-sh06-artifact-id projection-id)
    value))

(defn sh07-b51-v16-normalize-node [projection-id node]
  (let [core-form (get node :core-form)]
    (if (= core-form :var)
      (assoc node :attributes
             (sh07-b51-v16-normalize-reference
              projection-id (get node :attributes)))
      (if (= core-form :set!)
        (assoc node :attributes
               (sh07-b51-v16-normalize-mutation
                projection-id (get node :attributes)))
        (if (contains? #{:throw :try} core-form)
          (assoc node :attributes
                 (sh07-b51-v16-normalize-authenticated-artifact
                  projection-id (get node :attributes)))
          node)))))

(defn sh07-b51-v16-map-normalized [values projection-id kind]
  (if (vector? values)
    (loop [remaining values result []]
      (if (= (count remaining) 0)
        result
        (let [value (first remaining)
              normalized
              (if (= kind :binding)
                (sh07-b51-v16-normalize-binding projection-id value)
                (if (= kind :resolution)
                  (sh07-b51-v16-normalize-resolution value)
                  (if (= kind :reference)
                    (sh07-b51-v16-normalize-reference projection-id value)
                    (if (= kind :mutation)
                      (sh07-b51-v16-normalize-mutation projection-id value)
                      (if (= kind :authenticated-artifact)
                        (sh07-b51-v16-normalize-authenticated-artifact
                         projection-id value)
                        (sh07-b51-v16-normalize-node
                         projection-id value))))))]
          (recur (rest remaining) (conj result normalized)))))
    values))

(defn sh07-b51-v16-normalize-identity-preimage [preimage]
  (let [projection-id (sh07-b51-v16-semantic-projection-id preimage)
        value-1
        (if (if projection-id (contains? preimage :projection-binding) false)
          (assoc preimage :projection-binding projection-id)
          preimage)
        value-2
        (if (if projection-id (contains? value-1 :lineage) false)
          (assoc
           value-1 :lineage
           (assoc (get value-1 :lineage)
                  :authenticated-sh06-artifact-id projection-id))
          value-1)
        value-3
        (if (contains? value-2 :binding-table)
          (assoc value-2 :binding-table
                 (sh07-b51-v16-map-normalized
                  (get value-2 :binding-table) projection-id :binding))
          value-2)
        value-4
        (if (contains? value-3 :resolution-table)
          (assoc value-3 :resolution-table
                 (sh07-b51-v16-map-normalized
                  (get value-3 :resolution-table) projection-id :resolution))
          value-3)
        value-5
        (if (contains? value-4 :var-references)
          (assoc value-4 :var-references
                 (sh07-b51-v16-map-normalized
                  (get value-4 :var-references) projection-id :reference))
          value-4)
        value-6
        (if (contains? value-5 :mutations)
          (assoc value-5 :mutations
                 (sh07-b51-v16-map-normalized
                  (get value-5 :mutations) projection-id :mutation))
          value-5)
        value-7
        (if (contains? value-6 :error-transfers)
          (assoc value-6 :error-transfers
                 (sh07-b51-v16-map-normalized
                  (get value-6 :error-transfers)
                  projection-id :authenticated-artifact))
          value-6)
        value-8
        (if (contains? value-7 :error-handlers)
          (assoc value-7 :error-handlers
                 (sh07-b51-v16-map-normalized
                  (get value-7 :error-handlers)
                  projection-id :authenticated-artifact))
          value-7)
        value-9
        (if (contains? value-8 :nodes)
          (assoc value-8 :nodes
                 (sh07-b51-v16-map-normalized
                  (get value-8 :nodes) projection-id :node))
          value-8)]
    (if (= (get value-9 :core-form) :var)
      (assoc value-9 :attributes
             (sh07-b51-v16-normalize-reference
              projection-id (get value-9 :attributes)))
      (if (= (get value-9 :core-form) :set!)
        (assoc value-9 :attributes
               (sh07-b51-v16-normalize-mutation
                projection-id (get value-9 :attributes)))
        (if (contains? #{:throw :try} (get value-9 :core-form))
          (assoc value-9 :attributes
                 (sh07-b51-v16-normalize-authenticated-artifact
                  projection-id (get value-9 :attributes)))
          value-9)))))

(defn sh07-b51-v16-identity-preimage-shape? [value]
  (sh07-b51-exact-keys?
   value
   #{:domain :lineage :projection-binding :module :fragment-manifest
     :fragment-coverage :module-assembly-manifest :root-core-node-ids
     :definitions :nodes :evaluation-order :control-flow :reference-uses
     :var-references :mutations :error-transfers :error-handlers

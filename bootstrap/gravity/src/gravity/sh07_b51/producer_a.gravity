                 :schema-version 4
                 :predecessor-executable-descriptor-id
                 "sha256:f473d088e1528275582dd5ce9194ee20773b7d501547bd882d6a201332a70234"
                 :module-source-ids module-source-ids
                 :link-manifest-id (get manifest :manifest-id)
                 :module-plan-ids module-plan-ids
                 :execution-bundle-id (get bundle :bundle-id)
                 :compile-census-certificate-ids certificate-ids
                 :schedule (get claim :category-schedule)
                 :category-commitments commitments
                 :logical-public-surface
                 (sh07-b51-linked-logical-public-surface)
                 :inherited-contract-value-hashes
                 (sh07-b51-linked-inherited-contract-hashes)
                 :total-row-count total}
                expected-root

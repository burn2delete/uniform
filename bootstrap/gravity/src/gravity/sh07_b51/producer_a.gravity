            (if (contains?
                 #{:module-initialization :function-body
                   :conditional-branch}
                 (get region :parent-region-kind))
              (if (= (get region :parent-region-kind) :conditional-branch)
                (if (sh07-b51-sha256-id?
                     (get region :parent-if-syntax-id))
                  (contains? #{:then :else}
                             (get region :parent-branch-role))
                  false)
                (if (= (get region :parent-if-syntax-id) nil)
                  (= (get region :parent-branch-role) nil)
                  false))
              false)
            false)
          false)
        false)
      false)
    false))

(defn sh07-b51-v18-evaluation-region-shape? [region]
  (if (contains? #{:module-initialization :function-body} region)
    true
    (if (sh07-b51-v18-match-region-shape? region)
      true
      (if (sh07-b51-v18-handler-region-shape? region)
        true
        (sh07-b51-v18-conditional-region-shape? region)))))

(defn sh07-b51-ordinary-handler-clause-shape? [clause ordinal]
  (if (sh07-b51-exact-keys?
       clause
       #{:clause-ordinal :handler-child-index :catch-clause-form-id
         :catch-clause-syntax-id :error-type-form-id
         :error-type-syntax-id :error-type-binding-id
         :catch-binding-form-id :catch-binding-syntax-id
         :catch-binding-id :catch-binding-scope-id})
    (if (= (get clause :clause-ordinal) ordinal)
      (if (= (get clause :handler-child-index) (+ ordinal 1))
        (sh07-b51-ordinary-required-sha-fields?
         clause
         [:catch-clause-form-id :catch-clause-syntax-id
          :error-type-form-id :error-type-syntax-id
          :error-type-binding-id :catch-binding-form-id
          :catch-binding-syntax-id :catch-binding-id
          :catch-binding-scope-id])
        false)
      false)
    false))

(defn sh07-b51-ordinary-handler-clauses-shape? [clauses]
  (if (vector? clauses)
    (loop [remaining clauses ordinal 0]
      (if (= (count remaining) 0)
        true
        (if (sh07-b51-ordinary-handler-clause-shape?
             (first remaining) ordinal)
          (recur (rest remaining) (+ ordinal 1))
          false)))
    false))

(defn sh07-b51-ordinary-match-clause-shape? [clause ordinal]
  (if (sh07-b51-exact-keys?
       clause
       #{:clause-ordinal :branch-child-index :pattern-kind
         :pattern-form-id :pattern-syntax-id :pattern-value
         :branch-form-id :branch-syntax-id :pattern-binding-id
         :pattern-binding-scope-id :pattern-binding-ids})
    (if (= (get clause :clause-ordinal) ordinal)
      (if (= (get clause :branch-child-index) (+ ordinal 1))
        (if (contains? #{:literal :wildcard :binding :vector}
                       (get clause :pattern-kind))
          (if (sh07-b51-ordinary-required-sha-fields?
               clause
               [:pattern-form-id :pattern-syntax-id
                :branch-form-id :branch-syntax-id])
            (if (sh07-b51-all-sha256? (get clause :pattern-binding-ids))
              (if (= (get clause :pattern-kind) :binding)
                (if (sh07-b51-sha256-id?
                     (get clause :pattern-binding-id))
                  (if (sh07-b51-sha256-id?
                       (get clause :pattern-binding-scope-id))
                    (= (get clause :pattern-binding-ids)
                       [(get clause :pattern-binding-id)])
                    false)
                  false)
                (if (= (get clause :pattern-binding-id) nil)
                  (if (= (get clause :pattern-binding-scope-id) nil)
                    (if (= (get clause :pattern-kind) :vector)
                      true
                      (= (get clause :pattern-binding-ids) []))
                    false)
                  false))
              false)
            false)
          false)
        false)
      false)
    false))

(defn sh07-b51-ordinary-match-clauses-shape? [clauses]
  (if (vector? clauses)
    (loop [remaining clauses ordinal 0]
      (if (= (count remaining) 0)
        true
        (if (sh07-b51-ordinary-match-clause-shape?
             (first remaining) ordinal)
          (recur (rest remaining) (+ ordinal 1))
          false)))
    false))

                    'sh07-verify-core-template
                    'sh07-verify-core-resolved])
              (if (= (get descriptor :plan-function-count) 305)
                (if (= (get descriptor :function-member-count) 298)
                  (if (= (get descriptor :edge-count) 849)
                    (if (= (get descriptor :edge-carrier-kind)
                           :canonical-sorted-set-of-pair-vectors)
                      (if (set? (get descriptor :edge-carrier))
                        (if (= (count (get descriptor :edge-carrier)) 849)

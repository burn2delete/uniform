(defn sh07-b51-r1-git-id? [value]
  (if (string? value)
    (if (= (count value) 40)
      (sh07-b51-lowercase-hex? (vec value))
      false)
    false))

(defn sh07-b51-r1-digest-vector? [value expected-count]
  (if (vector? value)
    (if (= (count value) expected-count)
      (sh07-b51-all-sha256? value)
      false)
    false))

(defn sh07-b51-r1-compact-hash [preimage]
  (sh07-b51-success-digest-replay-exact?
   {:mode :attempt30-compact-hash :preimage preimage}
   []))

(defn sh07-b51-r1-compact-value-profile [value]
  (loop [frontier (list {:value value :depth 0})
         nodes 0 collections 0 maximum-depth 0 maximum-width 0
         maximum-scalar 0 canonical-bytes 0]
    (if (= (count frontier) 0)
      {:status :accepted :nodes nodes :depth maximum-depth
       :width maximum-width :collection-count collections
       :scalar-utf8 maximum-scalar
       :canonical-reader-bytes canonical-bytes}
      (if (>= nodes 2048)
        {:status :rejected :reason :certificate-node-bound}
        (let [entry (first frontier)
              current (get entry :value)
              depth (get entry :depth)
              aggregate?
              (if (map? current) true
                (if (vector? current) true
                  (if (set? current) true (list? current))))
              width (if aggregate? (count current) 0)
              next-collections (if aggregate? (+ collections 1) collections)
              scalar
              (if aggregate?
                {:status :accepted :observed-after 0}
                (sh07-b51-producer-observe-decoration-bytes
                 (pr-str current) 0 4096))
              components
              (if (map? current)
                (loop [remaining (vec current) result []]
                  (if (= (count remaining) 0)
                    result
                    (recur
                     (rest remaining)
                     (conj (conj result (first (first remaining)))
                           (second (first remaining))))))
                (if aggregate? (vec current) []))
              canonical-overhead
              (if aggregate?
                (if (map? current)
                  (if (= width 0) 9 (+ 8 (* 4 width)))
                  (+ (if (vector? current) 12
                       (if (set? current) 9 10))
                     (if (> width 0) (- width 1) 0)))
                (get scalar :observed-after))
              next-canonical (+ canonical-bytes canonical-overhead)]
          (if (sh07-b51-r1-all-true?
               [(<= depth 12)
                (<= width 35)
                (<= next-collections 64)
                (= (get scalar :status) :accepted)
                (<= (get scalar :observed-after 4097) 4096)
                (<= next-canonical 262144)])
            (let [child-frontier
                  (loop [remaining components result (rest frontier)]
                    (if (= (count remaining) 0)
                      result
                      (recur
                       (rest remaining)
                       (conj result
                             {:value (first remaining)
                              :depth (+ depth 1)}))))]
              (recur
               child-frontier (+ nodes 1) next-collections
               (if (> depth maximum-depth) depth maximum-depth)
               (if (> width maximum-width) width maximum-width)
               (if (> (get scalar :observed-after) maximum-scalar)
                 (get scalar :observed-after) maximum-scalar)
               next-canonical))
            {:status :rejected :reason :certificate-profile-bound}))))))

(defn sh07-b51-r1-certificate-preflight? [certificate]
  (let [profile (sh07-b51-r1-compact-value-profile certificate)]
    (= (get profile :status) :accepted)))

(defn sh07-b51-r1-category-leaf-count [row-count]
  (if (= row-count 0) 1 (quot (+ row-count 15) 16)))

(defn sh07-b51-r1-category-fold-level-count [leaf-count]
  (loop [children leaf-count level 1]
    (if (<= children 16)
      level
      (recur (quot (+ children 15) 16) (+ level 1)))))

(defn sh07-b51-r1-category-commitments-valid? [commitments]
  (if (vector? commitments)
    (if (= (count commitments) 7)
      (loop [remaining commitments
             categories (sh07-b51-linked-categories)
             total 0]
        (if (= (count remaining) 0)
          (<= total 65536)
          (let [commitment (first remaining)
                row-count (get commitment :row-count)
                leaf-count (get commitment :leaf-count)
                fold-count (get commitment :fold-level-count)]
            (if (sh07-b51-exact-keys?
                 commitment
                 #{:category :row-count :leaf-count
                   :fold-level-count :root-digest})
              (if (= (get commitment :category) (first categories))
                (if (sh07-b51-nonnegative-integer? row-count)
                  (if (<= row-count 65536)
                    (if (= leaf-count
                           (sh07-b51-r1-category-leaf-count row-count))
                      (if (= fold-count
                             (sh07-b51-r1-category-fold-level-count
                              leaf-count))
                        (if (<= fold-count 3)
                          (if (sh07-b51-sha256-id?
                               (get commitment :root-digest))
                            (recur (rest remaining) (rest categories)
                                   (+ total row-count))
                            false)
                          false)
                        false)
                      false)
                    false)
                  false)
                false)
              false))))
      false)
    false))

(defn sh07-b51-r1-module-census-valid? [row ordinal]
  (if (sh07-b51-exact-keys?
       row
       #{:module-ordinal :module :logical-source-path :owner
         :source-byte-count :source-sha256 :module-source-id :plan-id
         :physical-definition-count :reachable-definition-count
         :physical-local-runtime-callsite-count
         :reachable-local-runtime-callsite-count
         :physical-external-runtime-callsite-count
         :reachable-external-runtime-callsite-count
         :physical-referenced-builtin-occurrence-count
         :reachable-referenced-builtin-occurrence-count
         :core-binding-count :lexical-binding-count
         :external-binding-count :aggregate-binding-count})

   [6 'sh07-b51-build-independent-verifier-binding 6 5]
   [7 'sh07-b51-build-final-artifact 7 3]
   [8 'sh07-b51-finalize-rejection 1 6]])

(defn sh07-b51-r1-public-roots-valid?
  [roots descriptors plan-carriers]
  (let [specs (sh07-b51-r1-expected-public-roots plan-carriers)]
    (if (if (vector? roots) (= (count roots) 8) false)
      (loop [remaining specs]
        (if (= (count remaining) 0)
          true
          (let [spec (first remaining)
                root (get roots (- (get spec 0) 1))
                module-ordinal (get spec 3)
                descriptor (get descriptors module-ordinal)
                plan-row (get plan-carriers module-ordinal)
                definition
                (sh07-b51-r1-find-one
                 (get descriptor :definitions) :name (get spec 1))
                plan-definition
                (get (get (get plan-row :plan) :functions) (get spec 1))]
            (if (sh07-b51-exact-keys?
                 root #{:root-ordinal :function :arity :plan-id})
              (if (= [(get root :root-ordinal) (get root :function)
                      (get root :arity) (get root :plan-id)]
                     [(get spec 0) (get spec 1) (get spec 2)
                      (get plan-row :plan-id)])
                (if (= (get definition :count) 1)
                  (if (map? plan-definition)
                    (if (= [(get (get definition :value) :arity)
                            (get plan-definition :arity)]
                           [(get spec 2) (get spec 2)])

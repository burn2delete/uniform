                (if (sh07-b51-exact-keys?
                     route #{:edge-ordinal :caller-plan-id :callee-plan-id})
                  (if (= [(get route :edge-ordinal)
                          (get route :caller-plan-id)
                          (get route :callee-plan-id)]
                         [ordinal
                          (get (get plan-carriers
                                    (get caller :module-ordinal))
                               :plan-id)
                          (get (get plan-carriers
                                    (get callee :module-ordinal))
                               :plan-id)])
                    (recur (+ ordinal 1) (rest remaining))
                    false)
                  false)
                false))))
        false))
    false))


               (get row :owner))
            (if (sh07-b51-r1-all-true?
                 [(sh07-b51-nonnegative-integer?
                   (get row :source-byte-count))
                  (sh07-b51-sha256-id? (get row :source-sha256))
                  (sh07-b51-sha256-id? (get row :module-source-id))
                  (sh07-b51-sha256-id? (get row :plan-id))
                  (sh07-b51-nonnegative-integer?
                   (get row :physical-definition-count))
                  (sh07-b51-nonnegative-integer?
                   (get row :reachable-definition-count))
                  (sh07-b51-nonnegative-integer?
                   (get row :physical-local-runtime-callsite-count))
                  (sh07-b51-nonnegative-integer?
                   (get row :reachable-local-runtime-callsite-count))
                  (sh07-b51-nonnegative-integer?
                   (get row :physical-external-runtime-callsite-count))
                  (sh07-b51-nonnegative-integer?
                   (get row :reachable-external-runtime-callsite-count))
                  (sh07-b51-nonnegative-integer?
                   (get row :physical-referenced-builtin-occurrence-count))
                  (sh07-b51-nonnegative-integer?
                   (get row :reachable-referenced-builtin-occurrence-count))
                  (sh07-b51-nonnegative-integer?
                   (get row :core-binding-count))
                  (sh07-b51-nonnegative-integer?
                   (get row :lexical-binding-count))
                  (sh07-b51-nonnegative-integer?
                   (get row :external-binding-count))
                  (sh07-b51-nonnegative-integer?
                   (get row :aggregate-binding-count))])
              (if (sh07-b51-r1-all-true?
                   [(<= (get row :reachable-definition-count)
                        (get row :physical-definition-count))
                    (<= (get row :reachable-local-runtime-callsite-count)
                        (get row :physical-local-runtime-callsite-count))
                    (<= (get row :reachable-external-runtime-callsite-count)
                        (get row :physical-external-runtime-callsite-count))
                    (<=
                     (get row :reachable-referenced-builtin-occurrence-count)
                     (get row :physical-referenced-builtin-occurrence-count))
                    (= (get row :aggregate-binding-count)
                       (+ (get row :core-binding-count)
                          (get row :lexical-binding-count)
                          (get row :physical-definition-count)
                          (get row :external-binding-count)))
                    (<= (get row :aggregate-binding-count) 2440)])
                true
                false)
              false)
            false)
          false)
        false)
      false)
    false))

(defn sh07-b51-r1-sum-module-census-field [rows field]
  (loop [remaining rows total 0]
    (if (= (count remaining) 0)
      total
      (recur (rest remaining) (+ total (get (first remaining) field))))))

(defn sh07-b51-r1-physical-census-valid? [physical]
  (if (sh07-b51-exact-keys?
       physical
       #{:module-count :module-censuses :physical-definition-count
         :reachable-definition-count
         :physical-local-runtime-callsite-count
         :reachable-local-runtime-callsite-count
         :physical-external-runtime-callsite-count
         :reachable-external-runtime-callsite-count
         :physical-referenced-builtin-occurrence-count
         :reachable-referenced-builtin-occurrence-count
         :semantic-row-count :module-binding-occupancies
         :maximum-binding-occupancy :binding-ceiling})
    (let [rows (get physical :module-censuses)
          occupancies (get physical :module-binding-occupancies)]
      (if (= (get physical :module-count) 7)
        (if (if (vector? rows) (= (count rows) 7) false)
          (if (loop [remaining rows ordinal 0]
                (if (= (count remaining) 0)
                  true
                  (if (sh07-b51-r1-module-census-valid?
                       (first remaining) ordinal)
                    (recur (rest remaining) (+ ordinal 1))
                    false)))
            (if (= occupancies
                   (loop [remaining rows result []]
                     (if (= (count remaining) 0)
                       result
                       (recur
                        (rest remaining)
                        (conj result
                              (get (first remaining)
                                   :aggregate-binding-count))))))
              (let [maximum
                    (loop [remaining occupancies observed 0]
                      (if (= (count remaining) 0)
                        observed
                        (recur
                         (rest remaining)
                         (if (> (first remaining) observed)
                           (first remaining) observed))))]
                (if (= [(get physical :binding-ceiling)
                        (get physical :maximum-binding-occupancy)]
                       [2440 maximum])
                  (if (<= maximum 2440)
                    (= [(get physical :physical-definition-count)
                        (get physical :reachable-definition-count)
                        (get physical
                             :physical-local-runtime-callsite-count)
                        (get physical
                             :reachable-local-runtime-callsite-count)
                        (get physical
                             :physical-external-runtime-callsite-count)
                        (get physical
                             :reachable-external-runtime-callsite-count)
                        (get physical
                             :physical-referenced-builtin-occurrence-count)
                        (get physical
                             :reachable-referenced-builtin-occurrence-count)]
                       [(sh07-b51-r1-sum-module-census-field
                         rows :physical-definition-count)
                        (sh07-b51-r1-sum-module-census-field
                         rows :reachable-definition-count)
                        (sh07-b51-r1-sum-module-census-field
                         rows :physical-local-runtime-callsite-count)
                        (sh07-b51-r1-sum-module-census-field
                         rows :reachable-local-runtime-callsite-count)
                        (sh07-b51-r1-sum-module-census-field
                         rows :physical-external-runtime-callsite-count)
                        (sh07-b51-r1-sum-module-census-field
                         rows :reachable-external-runtime-callsite-count)
                        (sh07-b51-r1-sum-module-census-field
                         rows
                         :physical-referenced-builtin-occurrence-count)
                        (sh07-b51-r1-sum-module-census-field
                         rows
                         :reachable-referenced-builtin-occurrence-count)])
                    false)
                  false))
              false)
            false)
          false)
        false))
    false))

(defn sh07-b51-r1-category-census-joins? [commitments physical]
  (let [counts
        (loop [remaining commitments result {}]
          (if (= (count remaining) 0)
            result
            (recur
             (rest remaining)
             (assoc result
                    (get (first remaining) :category)
                    (get (first remaining) :row-count)))))
        total
        (loop [remaining commitments value 0]
          (if (= (count remaining) 0)
            value
            (recur (rest remaining)
                   (+ value (get (first remaining) :row-count)))))]
    (= [(get counts :roots)
        (get counts :members)
        (get counts :functions)
        (get counts :local-runtime-call-edges)
        (get counts :external-runtime-call-edges)
        (get counts :referenced-builtins)
        (get counts :module-contracts)
        total]
       [8
        (get physical :reachable-definition-count)
        (get physical :reachable-definition-count)
        (get physical :reachable-local-runtime-callsite-count)
        (get physical :reachable-external-runtime-callsite-count)
        (get physical :reachable-referenced-builtin-occurrence-count)
        7
        (get physical :semantic-row-count)])))

(defn sh07-b51-r1-transcript-descriptor-valid?
  [descriptor artifact checker inputs]
  (if (sh07-b51-exact-keys?
       descriptor
       #{:artifact :schema-version :node-count :row-count
         :artifact-id :record-root})
    (if (= [(get descriptor :artifact) (get descriptor :schema-version)]
           [artifact 1])
      (if (sh07-b51-r1-all-true?
           [(sh07-b51-nonnegative-integer? (get descriptor :node-count))
            (sh07-b51-nonnegative-integer? (get descriptor :row-count))
            (<= (get descriptor :row-count)
                (get descriptor :node-count))
            (<= (get descriptor :node-count) 262144)
            (<= (get descriptor :row-count) 65536)
            (sh07-b51-sha256-id? (get descriptor :artifact-id))
            (sh07-b51-sha256-id? (get descriptor :record-root))])
        (= (get descriptor :artifact-id)
           (sh07-b51-r1-compact-hash
            {:domain
             :gravity/sh07-b51-census-transcript-artifact-id-v1
             :schema-version 1
             :artifact artifact
             :checker checker
             :inputs inputs
             :node-count (get descriptor :node-count)
             :row-count (get descriptor :row-count)
             :record-root (get descriptor :record-root)}))
        false)
      false)
    false))


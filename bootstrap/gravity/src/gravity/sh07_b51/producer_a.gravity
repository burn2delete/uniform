(defn sh07-b51-index-records [records primary-field secondary-field]
  (loop [remaining records
         by-primary {}
         by-secondary {}
         duplicate-primary? false
         duplicate-secondary? false]
    (if (= (count remaining) 0)
      {:by-primary by-primary
       :by-secondary by-secondary
       :duplicate-primary? duplicate-primary?
       :duplicate-secondary? duplicate-secondary?}
      (let [record (first remaining)
            primary (get record primary-field)
            secondary (get record secondary-field)]
        (recur
         (rest remaining)
         (assoc by-primary primary record)
         (if (= secondary-field nil)
           by-secondary
           (assoc by-secondary secondary record))
         (if (contains? by-primary primary) true duplicate-primary?)
         (if (= secondary-field nil)
           duplicate-secondary?
           (if (contains? by-secondary secondary)
             true
             duplicate-secondary?)))))))

(defn sh07-b51-index-request [request]
  {:forms
   (sh07-b51-index-records
    (get request :forms) :form-id :syntax-id)
   :bindings
   (sh07-b51-index-records
    (get request :binding-table) :binding-id :definition-syntax-id)
   :resolutions
   (sh07-b51-index-records
    (get request :resolution-table) :reference-syntax-id nil)
   :aliases
   (sh07-b51-index-records
    (get request :alias-table) :alias nil)})

(defn sh07-b51-indexes-unique? [indexes]
  (loop [remaining [:forms :bindings :resolutions :aliases]]
    (if (= (count remaining) 0)
      true
      (let [index (get indexes (first remaining))]
        (if (get index :duplicate-primary?)
          false
          (if (get index :duplicate-secondary?)
            false
            (recur (rest remaining))))))))

(defn sh07-b51-find-form [indexes form-id]
  (get (get (get indexes :forms) :by-primary) form-id))

(defn sh07-b51-find-form-by-syntax [indexes syntax-id]
  (get (get (get indexes :forms) :by-secondary) syntax-id))

(defn sh07-b51-find-binding [indexes binding-id]
  (get (get (get indexes :bindings) :by-primary) binding-id))

(defn sh07-b51-find-binding-by-definition [indexes syntax-id]
  (get (get (get indexes :bindings) :by-secondary) syntax-id))

(defn sh07-b51-find-resolution [indexes syntax-id]
  (get (get (get indexes :resolutions) :by-primary) syntax-id))

(defn sh07-b51-child-membership-count [forms child-id]
  (loop [remaining forms count-found 0 parent nil]
    (if (= (count remaining) 0)
      {:count count-found :parent parent}
      (let [candidate (first remaining)
            occurrence
            (sh07-b51-index-of
             (get candidate :child-form-ids) child-id)]
        (if (= (get occurrence :count) 1)
          (recur (rest remaining) (+ count-found 1) candidate)
          (if (= (get occurrence :count) 0)
            (recur (rest remaining) count-found parent)
            {:count (+ count-found 2) :parent candidate}))))))

(defn sh07-b51-reciprocal-parent-chain [request indexes enclosing]
  (loop [current enclosing depth 0 visited #{} chain []]
    (if (> depth 256)
      {:status :rejected :reason :owner-parent-depth}
      (let [current-id (get current :form-id)]
        (if (contains? visited current-id)
          {:status :rejected :reason :owner-parent-cycle}
          (let [parent-id (get current :parent-form-id)
                next-chain (conj chain current)]
            (if (= parent-id nil)
              (let [root-membership
                    (sh07-b51-index-of
                     (get request :top-level-form-ids) current-id)]
                (if (= (get root-membership :count) 1)
                  {:status :accepted :chain next-chain :root current}
                  {:status :rejected :reason :owner-root-membership}))
              (let [parent (sh07-b51-find-form indexes parent-id)
                    reciprocal
                    (sh07-b51-child-membership-count
                     (get request :forms) current-id)]
                (if (map? parent)
                  (if (= (get reciprocal :count) 1)
                    (if (= (get (get reciprocal :parent) :form-id)
                           parent-id)
                      (recur
                       parent (+ depth 1) (conj visited current-id)
                       next-chain)
                      {:status :rejected
                       :reason :owner-parent-not-reciprocal})
                    {:status :rejected
                     :reason :owner-parent-nonunique})
                  {:status :rejected :reason :owner-parent-missing})))))))))

(defn sh07-b51-select-owner-fragment [request root enclosing]
  (loop [remaining (get request :fragment-manifest)
         found nil
         count-found 0]
    (if (= (count remaining) 0)
      (if (= count-found 1)
        {:status :accepted :fragment found}
        {:status :rejected :reason :owner-fragment-nonunique})
      (let [fragment (first remaining)
            root-id (get root :form-id)
            enclosing-id (get enclosing :form-id)]
        (if (if (= (get fragment :fragment-id) root-id)
              (if (= (get fragment :content-id) root-id)
                (if (= (get fragment :root-form-ids) [root-id])
                  (if (= (get fragment :root-node-ids) [root-id])
                    (if (= (get (sh07-b51-index-of
                                 (get fragment :form-ids) enclosing-id)
                                :count)
                           1)
                      true
                      false)
                    false)
                  false)
                false)
              false)
          (recur (rest remaining) fragment (+ count-found 1))
          (recur (rest remaining) found count-found))))))

(defn sh07-b51-core-operator-authenticated?
  [indexes operator-form expected-symbol]
  (let [resolution
        (sh07-b51-find-resolution indexes (get operator-form :syntax-id))
        binding
        (sh07-b51-find-binding indexes (get resolution :binding-id))]
    (if (= (get operator-form :kind) :symbol)
      (if (= (get operator-form :value) expected-symbol)
        (if (map? resolution)
          (if (map? binding)
            (if (= (get resolution :symbol) expected-symbol)
              (if (= (get resolution :position) :operator)
                (if (= (get resolution :resolution-order)
                       :profile-allowed-core-binding)
                  (if (= (get resolution :binding-id)
                         (get binding :binding-id))
                    (if (= (get resolution :upstream-binding-id)
                           (get binding :upstream-binding-id))
                      (if (= (get binding :binding-class) :core)
                        (if (= (get binding :visibility) :public)
                          (= (get binding :namespace) 'gravity.core)
                          false)
                        false)
                      false)
                    false)
                  false)
                false)
              false)
            false)
          false)
        false)
      false)))

(defn sh07-b51-authenticated-list-operator?
  [indexes form expected-symbol]
  (if (= (get form :kind) :list)
    (let [children (get form :child-form-ids)]
      (if (> (count children) 0)
        (let [operator-form
              (sh07-b51-find-form indexes (first children))]
          (if (map? operator-form)
            (sh07-b51-core-operator-authenticated?
             indexes operator-form expected-symbol)
            false))
        false))
    false))

(defn sh07-b51-chain-contains-form? [chain form-id]
  (loop [remaining chain]
    (if (= (count remaining) 0)
      false
      (if (= (get (first remaining) :form-id) form-id)
        true
        (recur (rest remaining))))))

(defn sh07-b51-source-def-shape?
  [request indexes root fragment chain]
  (let [children (get root :child-form-ids)]
    (if (= (count children) 3)
      (let [operator (sh07-b51-find-form indexes (first children))
            declared-name
            (sh07-b51-find-form indexes (first (rest children)))
            value-form
            (sh07-b51-find-form indexes (first (rest (rest children))))
            binding
            (sh07-b51-find-binding-by-definition
             indexes (get declared-name :syntax-id))]
        (if (sh07-b51-core-operator-authenticated?
             indexes operator 'def)
          (if (map? declared-name)
            (if (= (get declared-name :kind) :symbol)
              (if (map? binding)
                (if (= (get binding :binding-class) :namespace)
                  (if (= (get binding :name) (get declared-name :value))
                    (if (= (get binding :namespace)
                           (get (get request :module) :namespace))
                      (if (= (get (sh07-b51-index-of
                                   (get fragment :local-binding-ids)
                                   (get binding :binding-id))
                                  :count)
                             1)
                        (if (map? value-form)
                          (if (= (get value-form :form-id)
                                 (get (first chain) :form-id))
                            false
                            (sh07-b51-chain-contains-form?
                             chain (get value-form :form-id)))
                          false)
                        false)
                      false)
                    false)
                  false)
                false)
              false)
            false)
          false))
      false)))

(defn sh07-b51-macro-origins [form]
  (loop [remaining (get form :generated-origin) result []]
    (if (= (count remaining) 0)
      result
      (if (= (get (first remaining) :kind) :macro-expansion)
        (recur (rest remaining) (conj result (first remaining)))
        (recur (rest remaining) result)))))

(defn sh07-b51-macro-origins-by-role [form role]
  (loop [remaining (get form :generated-origin) result []]
    (if (= (count remaining) 0)
      result
      (let [origin (first remaining)]
        (if (if (= (get origin :kind) :macro-expansion)
              (= (get origin :role) role)
              false)
          (recur (rest remaining) (conj result origin))
          (recur (rest remaining) result))))))

(defn sh07-b51-exact-macro-origin?
  [origin origin-id input-syntax-id role]
  (if (sh07-b51-exact-keys?
       origin #{:origin-id :kind :from-syntax-id :role})
    (if (= (get origin :kind) :macro-expansion)
      (if (= (get origin :origin-id) origin-id)
        (if (= (get origin :from-syntax-id) input-syntax-id)
          (= (get origin :role) role)
          false)
        false)
      false)
    false))

(defn sh07-b51-root-macro-traces [request root]
  (loop [remaining (get request :macro-origin-traces) result []]
    (if (= (count remaining) 0)
      result
      (if (= (get (first remaining) :output-def-syntax-id)
             (get root :syntax-id))
        (recur (rest remaining) (conj result (first remaining)))
        (recur (rest remaining) result)))))

(defn sh07-b51-expanded-defn-selection
  [indexes root chain trace]
  (let [children (get root :child-form-ids)
        value-form
        (if (= (count children) 3)
          (sh07-b51-find-form
           indexes (first (rest (rest children))))
          nil)
        def-origins
        (sh07-b51-macro-origins-by-role root :introduced-def)
        fn-origins
        (if (map? value-form)
          (sh07-b51-macro-origins-by-role value-form :introduced-fn)
          [])]
    (if (sh07-b51-exact-keys?
         trace
         #{:macro :input-syntax-id :output-def-syntax-id
           :introduced-fn-syntax-id :def-generated-origin-id
           :fn-generated-origin-id :source-revision-id :sh05-artifact-id
           :macro-expansion-trace-id})
      (if (= (get trace :macro) 'defn)
        (if (= (get trace :output-def-syntax-id) (get root :syntax-id))
          (if (map? value-form)
            (if (= (get trace :introduced-fn-syntax-id)
                   (get value-form :syntax-id))
              (if (sh07-b51-authenticated-list-operator?
                   indexes value-form 'fn)
                (if (= (get value-form :form-id)
                       (get (first chain) :form-id))
                  {:status :rejected :reason :fn-owner-not-strict-ancestor}
                  (if (sh07-b51-chain-contains-form?
                       chain (get value-form :form-id))
                    (if (= (count def-origins) 1)
                    (if (= (count fn-origins) 1)
                      (if (sh07-b51-exact-macro-origin?
                           (first def-origins)
                           (get trace :def-generated-origin-id)
                           (get trace :input-syntax-id)
                           :introduced-def)
                        (if (sh07-b51-exact-macro-origin?
                             (first fn-origins)
                             (get trace :fn-generated-origin-id)
                             (get trace :input-syntax-id)
                             :introduced-fn)
                          {:status :accepted :fn-form value-form}
                          {:status :rejected :reason :fn-origin-mismatch})
                        {:status :rejected :reason :def-origin-mismatch})
                      {:status :rejected :reason :fn-origin-nonunique})
                      {:status :rejected :reason :def-origin-nonunique})
                    {:status :rejected :reason :fn-not-owner-ancestor}))
                {:status :rejected :reason :fn-operator-unauthenticated})
              {:status :rejected :reason :introduced-fn-mismatch})
            {:status :rejected :reason :introduced-fn-missing})
          {:status :rejected :reason :output-def-mismatch})
        {:status :rejected :reason :macro-kind-mismatch})
      {:status :rejected :reason :macro-trace-shape})))

(defn sh07-b51-owner-coordinate [request indexes enclosing]
  (if (sh07-b51-indexes-unique? indexes)
    (if (= enclosing
           (sh07-b51-find-form indexes (get enclosing :form-id)))
      (if (if (sh07-b51-authenticated-list-operator?
               indexes enclosing 'let)
            true
            (sh07-b51-authenticated-list-operator?
             indexes enclosing 'loop))
      (let [chain-result
            (sh07-b51-reciprocal-parent-chain request indexes enclosing)]
        (if (= (get chain-result :status) :accepted)
          (let [root (get chain-result :root)
                chain (get chain-result :chain)
                fragment-result
                (sh07-b51-select-owner-fragment request root enclosing)]
            (if (= (get fragment-result :status) :accepted)
              (let [fragment (get fragment-result :fragment)
                    source-def?
                    (sh07-b51-source-def-shape?
                     request indexes root fragment chain)
                    traces (sh07-b51-root-macro-traces request root)
                    root-origins
                    (sh07-b51-macro-origins-by-role
                     root :introduced-def)]
                (if (> (count traces) 1)
                  {:status :rejected :reason :owner-trace-nonunique}
                  (if (= (count traces) 1)
                    (if source-def?
                      (let [expanded
                            (sh07-b51-expanded-defn-selection
                             indexes root chain (first traces))]
                        (if (= (get expanded :status) :accepted)
                          {:status :accepted
                           :branch :expanded-defn
                           :coordinate
                           {:fragment-id (get fragment :fragment-id)
                            :fragment-ordinal (get fragment :ordinal)
                            :root-form-id (get root :form-id)
                            :root-syntax-id (get root :syntax-id)
                            :owning-definition-form-id (get root :form-id)
                            :owning-definition-syntax-id (get root :syntax-id)
                            :def-form-id (get root :form-id)
                            :def-syntax-id (get root :syntax-id)
                            :defn-input-syntax-id
                            (get (first traces) :input-syntax-id)
                            :fn-form-id
                            (get (get expanded :fn-form) :form-id)
                            :fn-syntax-id
                            (get (get expanded :fn-form) :syntax-id)
                            :enclosing-form-id (get enclosing :form-id)
                            :enclosing-syntax-id (get enclosing :syntax-id)}}
                          expanded))
                      {:status :rejected :reason :traced-root-not-source-def})
                    (if (> (count root-origins) 0)
                      {:status :rejected :reason :introduced-def-without-trace}
                      (if source-def?
                        {:status :accepted
                         :branch :source-def
                         :coordinate
                         {:fragment-id (get fragment :fragment-id)
                          :fragment-ordinal (get fragment :ordinal)
                          :root-form-id (get root :form-id)
                          :root-syntax-id (get root :syntax-id)
                          :owning-definition-form-id (get root :form-id)
                          :owning-definition-syntax-id (get root :syntax-id)
                          :def-form-id (get root :form-id)
                          :def-syntax-id (get root :syntax-id)
                          :defn-input-syntax-id nil
                          :fn-form-id nil
                          :fn-syntax-id nil
                          :enclosing-form-id (get enclosing :form-id)
                          :enclosing-syntax-id (get enclosing :syntax-id)}}
                        {:status :accepted
                         :branch :non-definition
                         :coordinate
                         {:fragment-id (get fragment :fragment-id)
                          :fragment-ordinal (get fragment :ordinal)
                          :root-form-id (get root :form-id)
                          :root-syntax-id (get root :syntax-id)
                          :owning-definition-form-id nil
                          :owning-definition-syntax-id nil
                          :def-form-id nil
                          :def-syntax-id nil
                          :defn-input-syntax-id nil
                          :fn-form-id nil
                          :fn-syntax-id nil
                          :enclosing-form-id (get enclosing :form-id)
                          :enclosing-syntax-id
                          (get enclosing :syntax-id)}})))))
              fragment-result))
          chain-result))
        {:status :rejected :reason :enclosing-operator-unauthenticated})
      {:status :rejected :reason :enclosing-form-unauthenticated})
    {:status :rejected :reason :request-index-duplicate}))

(defn sh07-b51-vector-subset? [requested available]
  (loop [remaining requested]
    (if (= (count remaining) 0)
      true
      (if (sh07-b51-vector-contains? available (first remaining))
        (recur (rest remaining))
        false))))

(defn sh07-b51-unique-record [records field value]
  (let [result (sh07-b51-find-by records field value)]
    (if (= (get result :count) 1)
      (get result :value)
      nil)))

(defn sh07-b51-resolution-ordinal [request resolution]
  (sh07-b51-index-of
   (loop [remaining (get request :resolution-table) result []]
     (if (= (count remaining) 0)
       result
       (recur
        (rest remaining)
        (conj result (get (first remaining) :reference-syntax-id)))))
   (get resolution :reference-syntax-id)))

(defn sh07-b51-source-fragment [request indexes resolution]
  (let [reference
        (sh07-b51-find-form-by-syntax
         indexes (get resolution :reference-syntax-id))]
    (if (map? reference)
      (loop [remaining (get request :fragment-manifest)
             found nil count-found 0]
        (if (= (count remaining) 0)
          (if (= count-found 1) found nil)
          (let [fragment (first remaining)
                reference-membership
                (sh07-b51-index-of
                 (get fragment :resolution-reference-syntax-ids)
                 (get resolution :reference-syntax-id))
                form-membership
                (sh07-b51-index-of
                 (get fragment :form-ids) (get reference :form-id))]
            (if (if (= (get reference-membership :count) 1)
                  (= (get form-membership :count) 1)
                  false)
              (recur (rest remaining) fragment (+ count-found 1))
              (if (if (= (get reference-membership :count) 0)
                    (= (get form-membership :count) 0)
                    false)
                (recur (rest remaining) found count-found)
                nil)))))
      nil)))

(defn sh07-b51-binding-membership [fragment binding-id]
  (let [local-count
        (get (sh07-b51-index-of
              (get fragment :local-binding-ids) binding-id)
             :count)
        external-count
        (get (sh07-b51-index-of
              (get fragment :external-binding-ids) binding-id)
             :count)]
    (if (if (= local-count 1) (= external-count 0) false)
      :local
      (if (if (= local-count 0) (= external-count 1) false)
        :external
        nil))))

(defn sh07-b51-raw-resolution-context
  [resolution-artifact request indexes resolution]
  (let [boundary (get resolution-artifact :gravity-resolution-boundary)
        raw-request (get boundary :authenticated-resolution-request)
        analysis (get boundary :resolved-analysis)
        ordinal-result
        (sh07-b51-resolution-ordinal request resolution)
        ordinal (get ordinal-result :index)
        binding
        (sh07-b51-find-binding indexes (get resolution :binding-id))
        source-fragment
        (sh07-b51-source-fragment request indexes resolution)
        membership
        (if (map? source-fragment)
          (sh07-b51-binding-membership
           source-fragment (get resolution :binding-id))
          nil)
        raw-reference
        (if (= (get ordinal-result :count) 1)
          (get (get raw-request :references) ordinal)
          nil)
        raw-resolution
        (if (= (get ordinal-result :count) 1)
          (get (get analysis :resolution-table) ordinal)
          nil)
        upstream-binding-result
        (if (map? binding)
          (sh07-b51-find-by
           (get analysis :binding-table)
           :binding-id (get binding :upstream-binding-id))
          {:count 0 :value nil})
        upstream-binding (get upstream-binding-result :value)]
    (if (= (get ordinal-result :count) 1)
      (if (map? binding)
        (if (map? source-fragment)
          (if (keyword? membership)
            (if (= (get upstream-binding-result :count) 1)
              (if (= (get resolution :upstream-binding-id)
                     (get binding :upstream-binding-id))
                (if (= (get upstream-binding :binding-id)
                       (get binding :upstream-binding-id))
                  (if (map? raw-reference)
                    (if (map? raw-resolution)
                      (if (= (get raw-reference :syntax-id)
                             (get raw-resolution :syntax-id))
                        (if (= (get raw-reference :symbol)
                               (get resolution :symbol))
                          (if (= (get raw-resolution :symbol)
                                 (get resolution :symbol))
                            (if (= (get raw-reference :position)
                                   (get resolution :position))
                              (if (= (get raw-resolution :position)
                                     (get resolution :position))
                                (if (= (get raw-resolution :binding-id)
                                       (get upstream-binding :binding-id))
                                  (if (= (get raw-resolution
                                              :resolution-order)
                                         (get resolution
                                              :resolution-order))
                                    {:raw-request raw-request
                                     :analysis analysis
                                     :binding binding
                                     :upstream-binding upstream-binding
                                     :raw-reference raw-reference
                                     :raw-resolution raw-resolution
                                     :source-fragment source-fragment
                                     :membership membership}
                                    nil)
                                  nil)
                                nil)
                              nil)
                            nil)
                          nil)
                        nil)
                      nil)
                    nil)
                  nil)
                nil)
              nil)
            nil)
          nil)
        nil)
      nil)))

(defn sh07-b51-projected-upstream-binding-agree? [binding upstream]
  (loop [remaining
         [:name :kind :binding-class :namespace :package
          :definition-artifact-id :visibility :profile-set :target-set
          :type-ref :effects :capabilities :safety :semantic-span]]
    (if (= (count remaining) 0)
      true
      (if (= (get binding (first remaining))
             (get upstream (first remaining)))
        (recur (rest remaining))
        false))))

(defn sh07-b51-declaration-upstream-agree? [declaration upstream]
  (if (sh07-b51-exact-keys?
       declaration
       #{:name :kind :namespace :package :binding-class :visibility
         :profile-set :target-set :type-ref :effects :capabilities :safety
         :semantic-span :source-span :definition-syntax-id
         :definition-artifact-id})
    (loop [remaining
           [:name :kind :namespace :package :binding-class :visibility
            :profile-set :target-set :type-ref :effects :capabilities :safety
            :semantic-span :source-span :definition-syntax-id
            :definition-artifact-id]]
      (if (= (count remaining) 0)
        true
        (if (= (get declaration (first remaining))
               (get upstream (first remaining)))
          (recur (rest remaining))
          false)))
    false))

(defn sh07-b51-definition-fragment [request indexes binding]
  (let [definition
        (sh07-b51-find-form-by-syntax
         indexes (get binding :definition-syntax-id))]
    (if (map? definition)
      (loop [remaining (get request :fragment-manifest)
             found nil count-found 0]
        (if (= (count remaining) 0)
          {:count count-found :fragment found :form definition}
          (let [membership
                (sh07-b51-index-of
                 (get (first remaining) :form-ids)
                 (get definition :form-id))]
            (if (= (get membership :count) 1)
              (recur
               (rest remaining) (first remaining) (+ count-found 1))
              (if (= (get membership :count) 0)
                (recur (rest remaining) found count-found)
                {:count 2 :fragment nil :form definition})))))
      {:count 0 :fragment nil :form nil})))

(defn sh07-b51-raw-declaration [records upstream]
  (let [result
        (sh07-b51-find-by
         records :definition-syntax-id
         (get upstream :definition-syntax-id))]
    (if (= (get result :count) 1)
      (let [declaration (get result :value)]
        (if (sh07-b51-declaration-upstream-agree? declaration upstream)
          declaration
          nil))
      nil)))

(defn sh07-b51-lexical-local-authorized?
  [request indexes context]
  (let [binding (get context :binding)
        upstream (get context :upstream-binding)
        raw-request (get context :raw-request)
        analysis (get context :analysis)
        source-fragment (get context :source-fragment)
        raw-reference (get context :raw-reference)
        raw-scope-result
        (sh07-b51-find-by
         (get raw-request :lexical-scopes)
         :scope-id (get upstream :scope-id))
        analysis-scope-result
        (sh07-b51-find-by
         (get analysis :lexical-scope-graph)
         :scope-id (get upstream :scope-id))
        raw-scope (get raw-scope-result :value)
        local-result
        (if (map? raw-scope)
          (sh07-b51-find-by
           (get raw-scope :bindings)
           :binding-syntax-id (get upstream :definition-syntax-id))
          {:count 0 :value nil})
        local (get local-result :value)
        definition
        (sh07-b51-find-form-by-syntax
         indexes (get binding :definition-syntax-id))]
    (if (= (get context :membership) :local)
      (if (= (get binding :binding-class) :lexical)
        (if (= (get upstream :binding-class) :lexical)
          (if (= (get (get context :raw-resolution) :resolution-order)
                 :local-lexical-binding)
            (if (sh07-b51-projected-upstream-binding-agree?
                 binding upstream)
              (if (= (get raw-scope-result :count) 1)
                (if (= (get analysis-scope-result :count) 1)
                  (if (= raw-scope (get analysis-scope-result :value))
                    (if (= (get local-result :count) 1)
                      (if (sh07-b51-exact-keys?
                           local
                           #{:name :kind :semantic-span :source-span
                             :binding-syntax-id :allow-shadow?})
                        (if (= (get local :name) (get upstream :name))
                          (if (= (get local :kind) (get upstream :kind))
                            (if (= (get local :semantic-span)
                                   (get upstream :semantic-span))
                              (if (= (get local :source-span)
                                     (get upstream :source-span))
                                (if (= (get local :allow-shadow?)
                                       (get upstream :allow-shadow?))
                                  (if (sh07-b51-vector-contains?
                                       (get raw-reference :scope-chain)
                                       (get upstream :scope-id))
                                    (if (map? definition)
                                      (if (= (get definition :kind) :symbol)
                                        (if (= (get definition :value)
                                               (get binding :name))
                                          (if (= (get definition :scope-id)
                                                 (get binding :scope-id))
                                            (= (get
                                                (sh07-b51-index-of
                                                 (get source-fragment :form-ids)
                                                 (get definition :form-id))
                                                :count)
                                               1)
                                            false)
                                          false)
                                        false)
                                      false)
                                    false)
                                  false)
                                false)
                              false)
                            false)
                          false)
                        false)
                      false)
                    false)
                  false)
                false)
              false)
            false)
          false)
        false)
      false)))

(defn sh07-b51-no-form-namespace-declaration?
  [declaration upstream]
  (if (sh07-b51-declaration-upstream-agree? declaration upstream)
    (if (= (get declaration :binding-class) :namespace)
      (if (contains? #{:public :private} (get declaration :visibility))
        (if (= (get declaration :type-ref) :gravity.type/value)
          (if (= (get declaration :safety) :safe)
            (if (= (get (get declaration :package) :version) "workspace")
              (if (sh07-b51-exact-keys?
                   (get declaration :semantic-span)
                   #{:explicit-candidate :name :namespace})
                (if (integer?
                     (get (get declaration :semantic-span)
                          :explicit-candidate))
                  (if (>= (get (get declaration :semantic-span)
                               :explicit-candidate)
                          0)
                    (if (sh07-b51-exact-keys?
                         (get declaration :source-span)
                         #{:source :form-index})
                      (if (string?
                           (get (get declaration :source-span) :source))
                        (= (get (get declaration :source-span) :form-index) 0)
                        false)
                      false)
                    false)
                  false)
                false)
              false)
            false)
          false)
        false)
      false)
    false))

(defn sh07-b51-form-backed-namespace?
  [request binding declaration definition-result]
  (let [definition (get definition-result :form)
        definition-fragment (get definition-result :fragment)]
    (if (= (get definition-result :count) 1)
      (if (map? definition)
        (if (= (get definition :kind) :symbol)
          (if (= (get definition :value) (get binding :name))
            (if (= (get
                    (sh07-b51-index-of
                     (get definition-fragment :local-binding-ids)
                     (get binding :binding-id))
                    :count)
                   1)
              (if (= (get binding :namespace)
                     (get (get request :module) :namespace))
                (if (sh07-b51-no-form-namespace-declaration?
                     declaration declaration)
                  false
                  true)
                false)
              false)
            false)
          false)
        false)
      false)))

(defn sh07-b51-resolution-name-authorized?
  [resolution binding order]
  (if (= order :fully-qualified-namespace-binding)
    (= (str (get binding :namespace) "/" (get binding :name))
       (str (get resolution :symbol)))
    (= (get resolution :symbol) (get binding :name))))

(defn sh07-b51-namespace-authorized [request indexes context]
  (let [binding (get context :binding)
        upstream (get context :upstream-binding)
        raw-request (get context :raw-request)
        resolution (get context :raw-resolution)
        order (get resolution :resolution-order)
        declaration
        (sh07-b51-raw-declaration
         (get raw-request :definitions) upstream)
        definition-result
        (sh07-b51-definition-fragment request indexes binding)
        definition-fragment (get definition-result :fragment)
        source-fragment (get context :source-fragment)
        visibility (get upstream :visibility)]
    (if (= (get binding :binding-class) :namespace)
      (if (= (get upstream :binding-class) :namespace)
        (if (contains?
             #{:current-namespace-binding
               :fully-qualified-namespace-binding}
             order)
          (if (sh07-b51-resolution-name-authorized?
               resolution upstream order)
            (if (sh07-b51-projected-upstream-binding-agree?
                 binding upstream)
              (if (map? declaration)
                (if (= (get binding :namespace)
                       (get (get request :module) :namespace))
                  (if (contains? #{:public :private} visibility)
                    (if (= (get definition-result :count) 1)
                      (if (sh07-b51-form-backed-namespace?
                           request binding declaration definition-result)
                        (if (= (get definition-fragment :fragment-id)
                               (get source-fragment :fragment-id))
                          (if (= (get context :membership) :local)
                            :owning-fragment-local
                            nil)
                          (if (= (get context :membership) :external)
                            :authenticated-external
                            nil))
                        nil)
                      (if (= (get definition-result :count) 0)
                        (if (= (get context :membership) :external)
                          (if (sh07-b51-no-form-namespace-declaration?
                               declaration upstream)
                            :authenticated-external
                            nil)
                          nil)
                        nil))
                    nil)
                  nil)
                nil)
              nil)
            nil)
          nil)
        nil)
      nil)))

(defn sh07-b51-core-authorized [request context]
  (let [binding (get context :binding)
        upstream (get context :upstream-binding)
        raw-request (get context :raw-request)
        resolution (get context :raw-resolution)
        declaration
        (sh07-b51-raw-declaration
         (get raw-request :core-bindings) upstream)]
    (if (= (get context :membership) :external)
      (if (= (get binding :binding-class) :core)
        (if (= (get upstream :binding-class) :core)
          (if (= (get upstream :visibility) :public)
            (if (= (get upstream :namespace) 'gravity.core)
              (if (= (get resolution :resolution-order)
                     :profile-allowed-core-binding)
                (if (= (get resolution :symbol) (get upstream :name))
                  (if (sh07-b51-projected-upstream-binding-agree?
                       binding upstream)
                    (if (map? declaration)
                      :authenticated-external
                      nil)
                    nil)
                  nil)
                nil)
              nil)
            nil)
          nil)
        nil)
      nil)))

(defn sh07-b51-dependency-analysis-agree?
  [request dependency product]
  (if (sh07-b51-exact-keys?
       dependency
       #{:namespace :alias :kind :profile :targets :visibility :refer
         :effects :capabilities :safety :boundary :semantic-span
         :source-span :dependency-artifact-id
         :foreign-record-complete?})
    (if (= (get product :from)
           (get (get request :module) :namespace))
      (if (= (get product :to) (get dependency :namespace))
        (if (= (get product :kind) (get dependency :kind))
          (if (= (get product :effects) (get dependency :effects))
            (if (= (get product :capabilities)
                   (get dependency :capabilities))
              (if (= (get product :targets) (get dependency :targets))
                (if (= (get product :dependency-artifact-id)
                       (get dependency :dependency-artifact-id))
                  (if (= (get product :semantic-span)
                         (get dependency :semantic-span))
                    (= (get product :source-span)
                       (get dependency :source-span))
                    false)
                  false)
                false)
              false)
            false)
          false)
        false)
      false)
    false))

(defn sh07-b51-import-context [request context]
  (let [upstream (get context :upstream-binding)
        raw-request (get context :raw-request)
        analysis (get context :analysis)
        declaration
        (sh07-b51-raw-declaration
         (get raw-request :import-bindings) upstream)
        dependency-result
        (sh07-b51-find-by
         (get raw-request :imports)
         :dependency-artifact-id
         (get upstream :definition-artifact-id))
        product-result
        (sh07-b51-find-by
         (get analysis :dependency-records)
         :dependency-artifact-id
         (get upstream :definition-artifact-id))
        dependency (get dependency-result :value)
        product (get product-result :value)]
    (if (map? declaration)
      (if (= (get dependency-result :count) 1)
        (if (= (get product-result :count) 1)
          (if (sh07-b51-dependency-analysis-agree?
               request dependency product)
            {:declaration declaration
             :dependency dependency
             :dependency-product product}
            nil)
          nil)
        nil)
      nil)))

(defn sh07-b51-alias-authorized?
  [request context dependency]
  (let [raw-reference (get context :raw-reference)
        alias-name (get raw-reference :qualifier)
        projected-alias-result
        (sh07-b51-find-by
         (get request :alias-table) :alias alias-name)
        analysis-alias-result
        (sh07-b51-find-by
         (get (get context :analysis) :alias-table) :alias alias-name)
        projected-alias (get projected-alias-result :value)
        analysis-alias (get analysis-alias-result :value)]
    (if (= (get projected-alias-result :count) 1)
      (if (= (get analysis-alias-result :count) 1)
        (if (= projected-alias analysis-alias)
          (if (sh07-b51-exact-keys?
               projected-alias
               #{:alias :namespace :kind :profile :targets
                 :dependency-artifact-id})
            (if (= (get projected-alias :namespace)
                   (get dependency :namespace))
              (if (= (get projected-alias :kind) (get dependency :kind))
                (if (= (get projected-alias :profile)
                       (get dependency :profile))
                  (if (= (get projected-alias :targets)
                         (get dependency :targets))
                    (if (= (get projected-alias :dependency-artifact-id)
                           (get dependency :dependency-artifact-id))
                      (if (= (get dependency :alias) alias-name)
                        (sh07-b51-vector-contains?
                         (get (get context :source-fragment) :alias-names)
                         alias-name)
                        false)
                      false)
                    false)
                  false)
                false)
              false)
            false)
          false)
        false)
      false)))

(defn sh07-b51-import-order-authorized?
  [request context dependency]
  (let [resolution (get context :raw-resolution)
        raw-reference (get context :raw-reference)
        upstream (get context :upstream-binding)
        order (get resolution :resolution-order)]
    (if (= order :profile-allowed-core-binding)
      (if (= (get resolution :symbol) (get upstream :name))
        (if (= (get raw-reference :qualifier) nil)
          (if (= (get dependency :refer) [:all])
            true
            (sh07-b51-vector-contains?
             (get dependency :refer) (get upstream :name)))
          false)
        false)
      (if (= order :alias-qualified-required-binding)
        (if (= (str (get raw-reference :qualifier)
                    "/" (get upstream :name))
               (str (get resolution :symbol)))
          (sh07-b51-alias-authorized? request context dependency)
          false)
        (if (= order :fully-qualified-namespace-binding)
          (if (= (get raw-reference :qualifier)
                 (get dependency :namespace))
            (= (str (get dependency :namespace)
                    "/" (get upstream :name))
               (str (get resolution :symbol)))
            false)
          (if (= order :explicit-foreign-import-binding)
            (if (= (get dependency :kind) :foreign)
              (if (= (get dependency :foreign-record-complete?) true)
                (if (if (= (get raw-reference :qualifier)
                           (get dependency :namespace))
                      true
                      (= (get raw-reference :qualifier)
                         (get dependency :alias)))
                  (= (str (get raw-reference :qualifier)
                          "/" (get upstream :name))
                     (str (get resolution :symbol)))
                  false)
                false)
              false)
            false))))))

(defn sh07-b51-import-authorized [request context]
  (let [binding (get context :binding)
        upstream (get context :upstream-binding)
        import-context (sh07-b51-import-context request context)
        dependency (get import-context :dependency)]
    (if (= (get context :membership) :external)
      (if (= (get binding :binding-class) :import)
        (if (= (get upstream :binding-class) :import)
          (if (= (get upstream :visibility) :public)
            (if (sh07-b51-projected-upstream-binding-agree?
                 binding upstream)
              (if (map? import-context)
                (if (sh07-b51-import-order-authorized?
                     request context dependency)
                  :authenticated-external
                  nil)
                nil)
              nil)
            nil)
          nil)
        nil)
      nil)))

(defn sh07-b51-flatten-fragment-resolutions [request]
  (loop [fragments (get request :fragment-manifest) result []]
    (if (= (count fragments) 0)
      result
      (recur
       (rest fragments)
       (sh07-b51-vector-append
        result
        (get (first fragments) :resolution-reference-syntax-ids))))))

(defn sh07-b51-projected-resolution-ids [request]
  (loop [remaining (get request :resolution-table) result []]
    (if (= (count remaining) 0)
      result
      (recur
       (rest remaining)
       (conj result (get (first remaining) :reference-syntax-id))))))

(defn sh07-b51-raw-reference-shape? [reference]
  (if (sh07-b51-exact-keys?
       reference
       #{:syntax-id :symbol :qualifier :name :position :scope-chain
         :semantic-span :source-span})
    (if (sh07-b51-sha256-id? (get reference :syntax-id))
      (if (vector? (get reference :scope-chain))
        (sh07-b51-all-unique? (get reference :scope-chain))
        false)
      false)
    false))

(defn sh07-b51-raw-resolution-shape? [resolution]
  (if (sh07-b51-exact-keys?
       resolution
       #{:syntax-id :symbol :position :semantic-span :source-span
         :resolution-order :binding-id})
    (if (sh07-b51-sha256-id? (get resolution :syntax-id))
      (sh07-b51-sha256-id? (get resolution :binding-id))
      false)
    false))

(defn sh07-b51-projected-resolution-shape? [resolution]
  (if (sh07-b51-exact-keys?
       resolution
       #{:reference-syntax-id :symbol :position :binding-id
         :upstream-binding-id :resolution-order :source-span})
    (if (sh07-b51-sha256-id?
         (get resolution :reference-syntax-id))
      (if (sh07-b51-sha256-id? (get resolution :binding-id))
        (sh07-b51-sha256-id? (get resolution :upstream-binding-id))
        false)
      false)
    false))

(defn sh07-b51-source-span-projection-authenticated?
  [raw-span projected-span]
  (let [primary (get raw-span :primary)]
    (if (sh07-b51-exact-keys? raw-span #{:all :primary})
      (if (vector? (get raw-span :all))
        (if (sh07-b51-vector-contains? (get raw-span :all) primary)
          (if (sh07-b51-exact-keys?
               primary
               #{:byte-start :byte-end :line-start :column-start
                 :line-end :column-end :scalar-start :scalar-end
                 :file :source})
            (if (sh07-b51-exact-keys?
                 projected-span
                 #{:byte-start :byte-end :line-start :column-start
                   :line-end :column-end :scalar-start :scalar-end})
              (if (sh07-b51-sha256-id? (get primary :file))
                (if (string? (get primary :source))
                  (loop [remaining
                         [:byte-start :byte-end :line-start :column-start
                          :line-end :column-end :scalar-start :scalar-end]]
                    (if (= (count remaining) 0)
                      true
                      (if (= (get primary (first remaining))
                             (get projected-span (first remaining)))
                        (recur (rest remaining))
                        false)))
                  false)
                false)
              false)
            false)
          false)
        false)
      false)))

(defn sh07-b51-reference-scope-chain-authenticated?
  [raw-request analysis reference upstream]
  (let [scope-chain (get reference :scope-chain)]
    (if (sh07-b51-all-unique? scope-chain)
      (if (loop [remaining scope-chain]
            (if (= (count remaining) 0)
              true
              (let [raw-result
                    (sh07-b51-find-by
                     (get raw-request :lexical-scopes)
                     :scope-id (first remaining))
                    analysis-result
                    (sh07-b51-find-by
                     (get analysis :lexical-scope-graph)
                     :scope-id (first remaining))]
                (if (= (get raw-result :count) 1)
                  (if (= (get analysis-result :count) 1)
                    (if (= (get raw-result :value)
                           (get analysis-result :value))
                      (recur (rest remaining))
                      false)
                    false)
                  false))))
        (if (= (get upstream :binding-class) :lexical)
          (sh07-b51-vector-contains?
           scope-chain (get upstream :scope-id))
          true)
        false)
      false)))

(defn sh07-b51-reference-occurrence-relations
  [resolution-artifact request indexes]
  (let [boundary (get resolution-artifact :gravity-resolution-boundary)
        raw-request (get boundary :authenticated-resolution-request)
        analysis (get boundary :resolved-analysis)
        references (get raw-request :references)
        raw-resolutions (get analysis :resolution-table)
        projected-resolutions (get request :resolution-table)
        projected-ids (sh07-b51-projected-resolution-ids request)
        fragment-ids
        (sh07-b51-flatten-fragment-resolutions request)]
    (if (= projected-ids fragment-ids)
      (if (sh07-b51-all-unique? projected-ids)
        (if (= (count references) (count raw-resolutions))
          (if (= (count references) (count projected-resolutions))
            (loop [remaining-references references
                   remaining-raw raw-resolutions
                   remaining-projected projected-resolutions
                   ordinal 1
                   seen-raw #{}
                   relations []]
              (if (= (count remaining-references) 0)
                {:status :accepted
                 :raw-reference-count (count seen-raw)
                 :relations relations}
                (let [reference (first remaining-references)
                      raw-resolution (first remaining-raw)
                      projected-resolution (first remaining-projected)
                      raw-id (get reference :syntax-id)
                      projected-id
                      (get projected-resolution :reference-syntax-id)
                      reference-form
                      (sh07-b51-find-form-by-syntax indexes projected-id)
                      binding
                      (sh07-b51-find-binding
                       indexes (get projected-resolution :binding-id))
                      upstream-result
                      (if (map? binding)
                        (sh07-b51-find-by
                         (get analysis :binding-table)
                         :binding-id (get binding :upstream-binding-id))
                        {:count 0 :value nil})
                      upstream (get upstream-result :value)
                      source-fragment
                      (sh07-b51-source-fragment
                       request indexes projected-resolution)
                      membership
                      (if (map? source-fragment)
                        (sh07-b51-binding-membership
                         source-fragment (get projected-resolution :binding-id))
                        nil)]
                  (if (sh07-b51-raw-reference-shape? reference)
                    (if (sh07-b51-raw-resolution-shape? raw-resolution)
                      (if (sh07-b51-projected-resolution-shape?
                           projected-resolution)
                        (if (contains? seen-raw raw-id)
                          {:status :rejected
                           :reason :raw-reference-duplicate}
                          (if (= (get (get reference :semantic-span) :ordinal)
                                 ordinal)
                            (if (= raw-id (get raw-resolution :syntax-id))
                              (if (= (get reference :symbol)
                                     (get raw-resolution :symbol)
                                     (get projected-resolution :symbol))
                                (if (= (get reference :position)
                                       (get raw-resolution :position)
                                       (get projected-resolution :position))
                                  (if (= (get reference :semantic-span)
                                         (get raw-resolution :semantic-span))
                                    (if (= (get reference :source-span)
                                           (get raw-resolution :source-span))
                                      (if (sh07-b51-source-span-projection-authenticated?
                                           (get reference :source-span)
                                           (get projected-resolution
                                                :source-span))
                                        (if (= (get raw-resolution
                                                  :resolution-order)
                                             (get projected-resolution
                                                  :resolution-order))
                                        (if (= (get upstream-result :count) 1)
                                          (if (= (get raw-resolution
                                                      :binding-id)
                                                 (get upstream :binding-id)
                                                 (get binding
                                                      :upstream-binding-id)
                                                 (get projected-resolution
                                                      :upstream-binding-id))
                                            (if (= (get projected-resolution
                                                        :binding-id)
                                                   (get binding :binding-id))
                                              (if (map? reference-form)
                                                (if (= (get reference-form :kind)
                                                       :symbol)
                                                  (if (= (get reference-form
                                                              :value)
                                                         (get reference :symbol))
                                                    (if (map? source-fragment)
                                                      (if (keyword? membership)
                                                        (if (sh07-b51-reference-scope-chain-authenticated?
                                                             raw-request analysis
                                                             reference upstream)
                                                          (recur
                                                           (rest remaining-references)
                                                           (rest remaining-raw)
                                                           (rest remaining-projected)
                                                           (+ ordinal 1)
                                                           (conj seen-raw raw-id)
                                                           (conj relations
                                                                 {:ordinal ordinal
                                                                  :raw-reference-syntax-id raw-id
                                                                  :projected-reference-syntax-id projected-id
                                                                  :raw-binding-id
                                                                  (get upstream :binding-id)
                                                                  :projected-binding-id
                                                                  (get binding :binding-id)
                                                                  :raw-scope-chain
                                                                  (get reference :scope-chain)
                                                                  :source-fragment-id
                                                                  (get source-fragment :fragment-id)
                                                                  :membership membership}))
                                                          {:status :rejected
                                                           :reason :reference-scope-chain})
                                                        {:status :rejected
                                                         :reason :fragment-binding-membership})
                                                      {:status :rejected
                                                       :reason :reference-source-fragment})
                                                    {:status :rejected
                                                     :reason :projected-reference-symbol})
                                                  {:status :rejected
                                                   :reason :projected-reference-kind})
                                                {:status :rejected
                                                 :reason :projected-reference-missing})
                                              {:status :rejected
                                               :reason :projected-binding-join})
                                            {:status :rejected
                                             :reason :upstream-binding-join})
                                          {:status :rejected
                                           :reason :upstream-binding-nonunique})
                                          {:status :rejected
                                           :reason :resolution-order-substitution})
                                        {:status :rejected
                                         :reason :projected-source-span-substitution})
                                      {:status :rejected
                                       :reason :raw-source-span-substitution})
                                    {:status :rejected
                                     :reason :reference-semantic-span-substitution})
                                  {:status :rejected
                                   :reason :reference-position-substitution})
                                {:status :rejected
                                 :reason :reference-symbol-substitution})
                              {:status :rejected
                               :reason :raw-reference-resolution-join})
                            {:status :rejected
                             :reason :raw-reference-ordinal-substitution}))
                        {:status :rejected
                         :reason :projected-resolution-shape})
                      {:status :rejected :reason :raw-resolution-shape})
                    {:status :rejected :reason :raw-reference-shape}))))
            {:status :rejected :reason :reference-projection-count})
          {:status :rejected :reason :reference-analysis-count})
        {:status :rejected :reason :projected-reference-duplicate})
      {:status :rejected :reason :fragment-resolution-order})))

(defn sh07-b51-upstream-binding-shape? [binding]
  (let [base
        #{:artifact :binding-id :name :kind :namespace :package
          :visibility :profile-set :target-set :type-ref :effects
          :capabilities :safety :semantic-span :source-span
          :definition-syntax-id :definition-artifact-id :binding-class}]
    (if (if (= (get binding :binding-class) :lexical)
          (sh07-b51-exact-keys?
           binding (conj (conj base :scope-id) :allow-shadow?))
          (sh07-b51-exact-keys? binding base))
      (if (sh07-b51-sha256-id? (get binding :binding-id))
        (if (sh07-b51-sha256-id?
             (get binding :definition-syntax-id))
          (sh07-b51-sha256-id?
           (get binding :definition-artifact-id))
          false)
        false)
      false)))

(defn sh07-b51-projected-binding-shape? [binding]
  (if (sh07-b51-exact-keys?
       binding
       #{:binding-id :name :kind :binding-class :namespace :package
         :upstream-binding-id :scope-id :definition-syntax-id
         :definition-artifact-id :visibility :profile-set :target-set
         :type-ref :effects :capabilities :safety :semantic-span})
    (if (sh07-b51-sha256-id? (get binding :binding-id))
      (if (sh07-b51-sha256-id? (get binding :upstream-binding-id))
        (sh07-b51-sha256-id? (get binding :definition-syntax-id))
        false)
      false)
    false))

(defn sh07-b51-raw-local-definition-authenticated?
  [raw-request analysis upstream]
  (let [raw-scope-result
        (sh07-b51-find-by
         (get raw-request :lexical-scopes)
         :scope-id (get upstream :scope-id))
        analysis-scope-result
        (sh07-b51-find-by
         (get analysis :lexical-scope-graph)
         :scope-id (get upstream :scope-id))
        raw-scope (get raw-scope-result :value)
        local-result
        (if (map? raw-scope)
          (sh07-b51-find-by
           (get raw-scope :bindings)
           :binding-syntax-id (get upstream :definition-syntax-id))
          {:count 0 :value nil})
        local (get local-result :value)]
    (if (= (get raw-scope-result :count) 1)
      (if (= (get analysis-scope-result :count) 1)
        (if (= raw-scope (get analysis-scope-result :value))
          (if (= (get local-result :count) 1)
            (if (sh07-b51-exact-keys?
                 local
                 #{:name :kind :semantic-span :source-span
                   :binding-syntax-id :allow-shadow?})
              (if (= (get local :binding-syntax-id)
                     (get upstream :definition-syntax-id))
                (if (= (get local :name) (get upstream :name))
                  (if (= (get local :kind) (get upstream :kind))
                    (if (= (get local :semantic-span)
                           (get upstream :semantic-span))
                      (if (= (get local :source-span)
                             (get upstream :source-span))
                        (= (get local :allow-shadow?)
                           (get upstream :allow-shadow?))
                        false)
                      false)
                    false)
                  false)
                false)
              false)
            false)
          false)
        false)
      false)))

(defn sh07-b51-binding-local-membership-count [request binding-id]
  (loop [remaining (get request :fragment-manifest) result 0]
    (if (= (count remaining) 0)
      result
      (let [membership
            (sh07-b51-index-of
             (get (first remaining) :local-binding-ids) binding-id)]
        (if (> (get membership :count) 1)
          (+ result 2)
          (recur (rest remaining)
                 (+ result (get membership :count))))))))

(defn sh07-b51-projected-local-definition-authenticated?
  [request indexes binding]
  (let [definition-result
        (sh07-b51-definition-fragment request indexes binding)
        definition (get definition-result :form)
        fragment (get definition-result :fragment)]
    (if (= (get definition-result :count) 1)
      (if (= (get definition :kind) :symbol)
        (if (= (get definition :value) (get binding :name))
          (if (= (get definition :scope-id) (get binding :scope-id))
            (= (get (sh07-b51-index-of
                     (get fragment :local-binding-ids)
                     (get binding :binding-id))
                    :count)
               1)
            false)
          false)
        false)
      false)))

(defn sh07-b51-no-projected-local-definition?
  [request indexes binding]
  (let [definition-result
        (sh07-b51-definition-fragment request indexes binding)]
    (if (= (get definition-result :count) 0)
      (= (sh07-b51-binding-local-membership-count
          request (get binding :binding-id))
         0)
      false)))

(defn sh07-b51-binding-definition-class-authenticated?
  [raw-request analysis request indexes binding upstream]
  (let [binding-class (get upstream :binding-class)]
    (if (= binding-class :lexical)
      (if (sh07-b51-raw-local-definition-authenticated?
           raw-request analysis upstream)
        (sh07-b51-projected-local-definition-authenticated?
         request indexes binding)
        false)
      (if (= binding-class :namespace)
        (let [declaration
              (sh07-b51-raw-declaration
               (get raw-request :definitions) upstream)
              definition-result
              (sh07-b51-definition-fragment request indexes binding)]
          (if (map? declaration)
            (if (= (get definition-result :count) 1)
              (if (sh07-b51-projected-local-definition-authenticated?
                   request indexes binding)
                (if (sh07-b51-no-form-namespace-declaration?
                     declaration upstream)
                  false
                  true)
                false)
              (if (= (get definition-result :count) 0)
                (if (sh07-b51-no-projected-local-definition?
                     request indexes binding)
                  (if (sh07-b51-no-form-namespace-declaration?
                       declaration upstream)
                    (= (get binding :definition-syntax-id)
                       (get upstream :definition-syntax-id))
                    false)
                  false)
                false))
            false))
        (if (contains? #{:core :import} binding-class)
          (let [records
                (if (= binding-class :core)
                  (get raw-request :core-bindings)
                  (get raw-request :import-bindings))
                declaration (sh07-b51-raw-declaration records upstream)]
            (if (map? declaration)
              (if (sh07-b51-no-projected-local-definition?
                   request indexes binding)
                (= (get binding :definition-syntax-id)
                   (get upstream :definition-syntax-id))
                false)
              false))
          false)))))

(defn sh07-b51-binding-definition-relations
  [resolution-artifact request indexes]
  (let [boundary (get resolution-artifact :gravity-resolution-boundary)
        raw-request (get boundary :authenticated-resolution-request)
        analysis (get boundary :resolved-analysis)
        projected-bindings (get request :binding-table)
        upstream-bindings (get analysis :binding-table)]
    (if (= (count projected-bindings) (count upstream-bindings))
      (loop [remaining projected-bindings
             seen-upstream #{}
             raw-to-projected-scope {}
             projected-to-raw-scope {}
             relations []]
        (if (= (count remaining) 0)
          (if (= (count seen-upstream) (count upstream-bindings))
            {:status :accepted
             :raw-to-projected-scope raw-to-projected-scope
             :projected-to-raw-scope projected-to-raw-scope
             :relations relations}
            {:status :rejected :reason :upstream-binding-incomplete})
          (let [binding (first remaining)
                upstream-result
                (sh07-b51-find-by
                 upstream-bindings :binding-id
                 (get binding :upstream-binding-id))
                upstream (get upstream-result :value)
                lexical? (= (get upstream :binding-class) :lexical)
                raw-scope-id (get upstream :scope-id)
                projected-scope-id (get binding :scope-id)
                prior-projected
                (get raw-to-projected-scope raw-scope-id)
                prior-raw
                (get projected-to-raw-scope projected-scope-id)]
            (if (sh07-b51-projected-binding-shape? binding)
              (if (= (get upstream-result :count) 1)
                (if (sh07-b51-upstream-binding-shape? upstream)
                  (if (contains? seen-upstream
                                 (get upstream :binding-id))
                    {:status :rejected :reason :upstream-binding-reused}
                    (if (sh07-b51-projected-upstream-binding-agree?
                         binding upstream)
                      (if (sh07-b51-binding-definition-class-authenticated?
                           raw-request analysis request indexes
                           binding upstream)
                        (if (if lexical?
                              (if (sh07-b51-sha256-id? raw-scope-id)
                                (if (sh07-b51-sha256-id?
                                     projected-scope-id)
                                  (if (if (= prior-projected nil)
                                        true
                                        (= prior-projected
                                           projected-scope-id))
                                    (if (= prior-raw nil)
                                      true
                                      (= prior-raw raw-scope-id))
                                    false)
                                  false)
                                false)
                              (= projected-scope-id nil))
                          (recur
                           (rest remaining)
                           (conj seen-upstream (get upstream :binding-id))
                           (if lexical?
                             (assoc raw-to-projected-scope
                                    raw-scope-id projected-scope-id)
                             raw-to-projected-scope)
                           (if lexical?
                             (assoc projected-to-raw-scope
                                    projected-scope-id raw-scope-id)
                             projected-to-raw-scope)
                           (conj relations
                                 {:raw-binding-id
                                  (get upstream :binding-id)
                                  :projected-binding-id
                                  (get binding :binding-id)
                                  :raw-definition-syntax-id
                                  (get upstream :definition-syntax-id)
                                  :projected-definition-syntax-id
                                  (get binding :definition-syntax-id)
                                  :raw-scope-id raw-scope-id
                                  :projected-scope-id projected-scope-id}))
                          {:status :rejected
                           :reason :scope-projection-nonbijective})
                        {:status :rejected
                         :reason :definition-syntax-projection})
                      {:status :rejected
                       :reason :binding-field-substitution}))
                  {:status :rejected :reason :upstream-binding-shape})
                {:status :rejected :reason :upstream-binding-nonunique})
              {:status :rejected :reason :projected-binding-shape}))))
      {:status :rejected :reason :binding-projection-count})))

(defn sh07-b51-resolution-maps-authenticated?
  [resolution-artifact request indexes]
  (let [references
        (sh07-b51-reference-occurrence-relations
         resolution-artifact request indexes)
        bindings
        (sh07-b51-binding-definition-relations
         resolution-artifact request indexes)]
    (if (= (get references :status) :accepted)
      (= (get bindings :status) :accepted)
      false)))

(defn sh07-b51-authorize-resolution-from-maps
  [resolution-artifact request indexes resolution]
  (let [context
        (sh07-b51-raw-resolution-context
         resolution-artifact request indexes resolution)
        binding (get context :binding)
        binding-class (get binding :binding-class)]
    (if (map? context)
      (if (= binding-class :lexical)
        (if (sh07-b51-lexical-local-authorized?
             request indexes context)
          :owning-fragment-local
          nil)
        (if (= binding-class :namespace)
          (sh07-b51-namespace-authorized request indexes context)
          (if (= binding-class :core)
            (sh07-b51-core-authorized request context)
            (if (= binding-class :import)
              (sh07-b51-import-authorized request context)
              nil))))
      nil)))

(defn sh07-b51-authorize-resolution
  [resolution-artifact request indexes resolution]
  (if (sh07-b51-resolution-maps-authenticated?
       resolution-artifact request indexes)
    (sh07-b51-authorize-resolution-from-maps
     resolution-artifact request indexes resolution)
    nil))

(defn sh07-b51-authorize-all-resolutions
  [resolution-artifact request indexes]
  (if (sh07-b51-resolution-maps-authenticated?
       resolution-artifact request indexes)
    (loop [remaining (get request :resolution-table) result []]
      (if (= (count remaining) 0)
        {:status :accepted :classifications result}
        (let [classification
              (sh07-b51-authorize-resolution-from-maps
               resolution-artifact request indexes (first remaining))]
          (if (contains?
               #{:owning-fragment-local :authenticated-external}
               classification)
            (recur (rest remaining) (conj result classification))
            {:status :rejected
             :reason :unauthorized-resolution
             :reference-syntax-id
             (get (first remaining) :reference-syntax-id)}))))
    {:status :rejected :reason :resolution-map-authentication}))

(defn sh07-b51-resource-bound-catalog []
  [{:check :owner-slot-limit
    :unit :owner-slots :maximum 1024 :crossing 1025
    :source :authenticated-owner-slot-pairs
    :boundary-owner :predecessor-b47 :terminal-reason :request-shape
    :diagnostic-schema :b47-13-key-preimage-and-16-key-emitted
    :coordinate-policy :frozen-b47-request-shape
    :finalizer :frozen-b47-diagnostic-request}
   {:check :module-slot-limit
    :unit :module-slots :maximum 1024 :crossing 1025
    :source :authenticated-module-owner-slot-pairs
    :boundary-owner :v18 :terminal-reason :module-slot-limit-exceeded
    :diagnostic-schema :v18-29-key-preimage-and-30-key-materialized
    :coordinate-policy :pattern-preflight
    :finalizer :sh07-b51-finalize-rejection}
   {:check :vector-width-limit
    :unit :vector-immediate-children :maximum 1024 :crossing 1025
    :source :authenticated-vector-child-form-ids
    :boundary-owner :predecessor-b47 :terminal-reason :request-shape
    :diagnostic-schema :b47-13-key-preimage-and-16-key-emitted
    :coordinate-policy :frozen-b47-request-shape
    :finalizer :frozen-b47-diagnostic-request}
   {:check :slot-pattern-node-limit
    :unit :slot-pattern-nodes :maximum 1024 :crossing 1025
    :source :authenticated-pattern-preorder
    :boundary-owner :predecessor-b47 :terminal-reason :request-shape
    :diagnostic-schema :b47-13-key-preimage-and-16-key-emitted
    :coordinate-policy :frozen-b47-request-shape
    :finalizer :frozen-b47-diagnostic-request}
   {:check :module-extraction-limit
    :unit :module-prospective-extractions :maximum 65536 :crossing 65537
    :source :authenticated-module-pattern-preorder
    :boundary-owner :predecessor-b47 :terminal-reason :request-shape
    :diagnostic-schema :b47-13-key-preimage-and-16-key-emitted
    :coordinate-policy :frozen-b47-request-shape
    :finalizer :frozen-b47-diagnostic-request}
   {:check :module-binding-leaf-limit
    :unit :module-binding-leaves :maximum 2048 :crossing 2049
    :source :authenticated-binding-leaf-preorder
    :boundary-owner :v18
    :terminal-reason :module-binding-leaf-limit-exceeded
    :diagnostic-schema :v18-29-key-preimage-and-30-key-materialized
    :coordinate-policy :pattern-preflight
    :finalizer :sh07-b51-finalize-rejection}
   {:check :vector-depth-limit
    :unit :vector-nesting-depth :maximum 256 :crossing 257
    :source :authenticated-vector-ancestry
    :boundary-owner :predecessor-b47 :terminal-reason :form-depth-or-cycle
    :diagnostic-schema :b47-13-key-preimage-and-16-key-emitted
    :coordinate-policy :frozen-b47-graph-offender
    :finalizer :frozen-b47-diagnostic-request}
   {:check :extraction-path-length-limit
    :unit :pattern-path-indexes :maximum 256 :crossing 257
    :source :authenticated-pattern-path
    :boundary-owner :predecessor-b47 :terminal-reason :form-depth-or-cycle
    :diagnostic-schema :b47-13-key-preimage-and-16-key-emitted
    :coordinate-policy :frozen-b47-graph-offender
    :finalizer :frozen-b47-diagnostic-request}])

(defn sh07-b51-resource-bound-row [check]
  (let [result
        (sh07-b51-find-by
         (sh07-b51-resource-bound-catalog) :check check)]
    (if (= (get result :count) 1)
      (get result :value)
      nil)))

(defn sh07-b51-resource-bound-catalog-valid? []
  (let [catalog (sh07-b51-resource-bound-catalog)]
    (if (= (count catalog) 8)
      (if (= (loop [remaining catalog result []]
               (if (= (count remaining) 0)
                 result
                 (recur (rest remaining)
                        (conj result (get (first remaining) :check)))))
             [:owner-slot-limit :module-slot-limit :vector-width-limit
              :slot-pattern-node-limit :module-extraction-limit
              :module-binding-leaf-limit :vector-depth-limit
              :extraction-path-length-limit])
        (loop [remaining catalog]
          (if (= (count remaining) 0)
            true
            (let [row (first remaining)]
              (if (sh07-b51-exact-keys?
                   row
                   #{:check :unit :maximum :crossing :source
                     :boundary-owner :terminal-reason :diagnostic-schema
                     :coordinate-policy :finalizer})
                (if (= (get row :crossing) (+ (get row :maximum) 1))
                  (recur (rest remaining))
                  false)
                false))))
        false)
      false)))

(defn sh07-b51-pattern-rejection
  [reason check offending-form path first-duplicate later-duplicate]
  {:status :rejected
   :reason reason
   :check check
   :offending-form offending-form
   :path path
   :first-duplicate first-duplicate
   :later-duplicate later-duplicate
   :partial-extractions []})

(defn sh07-b51-pattern-occurrence-evidence
  [form path pattern-node-ordinal terminal-ordinal leaf-ordinal]
  {:binding-name (get form :value)
   :form-id (get form :form-id)
   :syntax-id (get form :syntax-id)
   :scope-id (get form :scope-id)
   :source-span (get form :source-span)
   :generated-origin (get form :generated-origin)
   :path path
   :pattern-node-ordinal pattern-node-ordinal
   :terminal-ordinal terminal-ordinal
   :leaf-ordinal leaf-ordinal})

(defn sh07-b51-authenticated-pattern-binding
  [indexes fragment form]
  (let [binding
        (sh07-b51-find-binding-by-definition
         indexes (get form :syntax-id))]
    (if (map? binding)
      (if (= (get binding :binding-class) :lexical)
        (if (= (get binding :name) (get form :value))
          (if (= (get binding :definition-syntax-id)
                 (get form :syntax-id))
            (if (= (get binding :scope-id) (get form :scope-id))
              (if (= (get (sh07-b51-index-of
                           (get fragment :local-binding-ids)
                           (get binding :binding-id))
                          :count)
                     1)
                binding
                nil)
              nil)
            nil)
          nil)
        nil)
      nil)))

(defn sh07-b51-vector-pattern-descriptor
  [form path ordinal parent-ordinal depth]
  {:pattern-node-ordinal ordinal
   :parent-pattern-node-ordinal parent-ordinal
   :terminal-ordinal nil
   :leaf-ordinal nil
   :kind :vector-node
   :path path
   :form-id (get form :form-id)
   :syntax-id (get form :syntax-id)
   :scope-id (get form :scope-id)
   :expected-width (count (get form :child-form-ids))
   :binding-id nil
   :binding-name nil
   :definition-form-id nil
   :definition-syntax-id nil
   :binding-scope-id nil
   :vector-depth depth})

(defn sh07-b51-wildcard-pattern-descriptor
  [form path ordinal parent-ordinal terminal-ordinal]
  {:pattern-node-ordinal ordinal
   :parent-pattern-node-ordinal parent-ordinal
   :terminal-ordinal terminal-ordinal
   :leaf-ordinal nil
   :kind :wildcard-leaf
   :path path
   :form-id (get form :form-id)
   :syntax-id (get form :syntax-id)
   :scope-id (get form :scope-id)
   :expected-width nil
   :binding-id nil
   :binding-name nil
   :definition-form-id nil
   :definition-syntax-id nil
   :binding-scope-id nil
   :vector-depth nil})

(defn sh07-b51-binding-pattern-descriptor
  [form binding path ordinal parent-ordinal terminal-ordinal leaf-ordinal]
  {:pattern-node-ordinal ordinal
   :parent-pattern-node-ordinal parent-ordinal
   :terminal-ordinal terminal-ordinal
   :leaf-ordinal leaf-ordinal
   :kind :binding-leaf
   :path path
   :form-id (get form :form-id)
   :syntax-id (get form :syntax-id)
   :scope-id (get form :scope-id)
   :expected-width nil
   :binding-id (get binding :binding-id)
   :binding-name (get binding :name)
   :definition-form-id (get form :form-id)
   :definition-syntax-id (get binding :definition-syntax-id)
   :binding-scope-id (get binding :scope-id)
   :vector-depth nil})

(defn sh07-b51-prepend-pattern-children
  [request indexes form parent-ordinal path depth frontier]
  (let [child-ids (get form :child-form-ids)]
    (if (sh07-b51-all-unique? child-ids)
      (loop [index 0 result []]
        (if (= index (count child-ids))
          {:status :accepted
           :frontier (sh07-b51-vector-append result frontier)}
          (let [child-id (get child-ids index)
                child (sh07-b51-find-form indexes child-id)
                reciprocal
                (sh07-b51-child-membership-count
                 (get request :forms) child-id)]
            (if (map? child)
              (if (= (get child :parent-form-id) (get form :form-id))
                (if (= (get reciprocal :count) 1)
                  (if (= (get (get reciprocal :parent) :form-id)
                         (get form :form-id))
                    (recur
                     (+ index 1)
                     (conj
                      result
                      {:form child
                       :parent-pattern-node-ordinal parent-ordinal
                       :path (conj path index)
                       :vector-depth (+ depth 1)
                       :expected-parent-form-id (get form :form-id)}))
                    {:status :rejected
                     :reason :pattern-parent-not-reciprocal
                     :offending-form child})
                  {:status :rejected
                   :reason :pattern-parent-nonunique
                   :offending-form child})
                {:status :rejected
                 :reason :pattern-parent-not-reciprocal
                 :offending-form child})
              {:status :rejected
               :reason :pattern-child-missing
               :offending-form nil}))))
      {:status :rejected
       :reason :pattern-child-duplicate
       :offending-form form})))

(defn sh07-b51-slot-pattern-result
  [pattern-kind root descriptors introduced-binding-ids terminal-count
   leaf-count vector-node-count maximum-depth maximum-width
   maximum-path-length]
  {:status :accepted
   :pattern-kind pattern-kind
   :pattern-root root
   :descriptors descriptors
   :introduced-binding-ids introduced-binding-ids
   :node-count (count descriptors)
   :extraction-count (count descriptors)
   :terminal-count terminal-count
   :leaf-count leaf-count
   :vector-node-count vector-node-count
   :maximum-vector-depth maximum-depth
   :maximum-vector-width maximum-width
   :maximum-path-length maximum-path-length})

(defn sh07-b51-enumerate-slot-pattern
  [request indexes fragment pattern-form]
  (let [canonical
        (sh07-b51-find-form indexes (get pattern-form :form-id))
        root-kind
        (if (= (get pattern-form :kind) :symbol)
          :legacy-simple-symbol
          (if (= (get pattern-form :kind) :vector)
            :vector-pattern
            nil))]
    (if (sh07-b51-indexes-unique? indexes)
      (if (= pattern-form canonical)
        (if (= (get (sh07-b51-index-of
                     (get fragment :form-ids)
                     (get pattern-form :form-id))
                    :count)
               1)
          (if (keyword? root-kind)
            (loop [frontier
                   [{:form pattern-form
                     :parent-pattern-node-ordinal nil
                     :path []
                     :vector-depth 0
                     :expected-parent-form-id nil}]
                   descriptors []
                   introduced-binding-ids []
                   first-by-name {}
                   next-node 0
                   next-terminal 0
                   next-leaf 0
                   vector-node-count 0
                   maximum-depth 0
                   maximum-width 0
                   maximum-path-length 0]
              (if (= (count frontier) 0)
                (sh07-b51-slot-pattern-result
                 root-kind pattern-form descriptors introduced-binding-ids
                 next-terminal next-leaf vector-node-count
                 maximum-depth maximum-width maximum-path-length)
                (let [entry (first frontier)
                      form (get entry :form)
                      path (get entry :path)
                      depth (get entry :vector-depth)
                      parent-ordinal
                      (get entry :parent-pattern-node-ordinal)
                      expected-parent (get entry :expected-parent-form-id)
                      canonical-form
                      (sh07-b51-find-form indexes (get form :form-id))
                      form-kind (get form :kind)
                      descendant? (if (= parent-ordinal nil) false true)]
                  (if (= form canonical-form)
                    (if (= (get (sh07-b51-index-of
                                 (get fragment :form-ids)
                                 (get form :form-id))
                                :count)
                           1)
                      (if (if (= expected-parent nil)
                            true
                            (= (get form :parent-form-id) expected-parent))
                        (if (> (+ next-node 1) 1024)
                          (sh07-b51-pattern-rejection
                           :predecessor-bound-mask
                           :slot-pattern-node-limit form path nil nil)
                          (if (> (count path) 256)
                            (sh07-b51-pattern-rejection
                             :predecessor-bound-mask
                             :extraction-path-length-limit form path nil nil)
                            (if (= form-kind :vector)
                              (let [width (count (get form :child-form-ids))]
                                (if (> width 1024)
                                  (sh07-b51-pattern-rejection
                                   :predecessor-bound-mask
                                   :vector-width-limit form path nil nil)
                                  (if (> depth 256)
                                    (sh07-b51-pattern-rejection
                                     :predecessor-bound-mask
                                     :vector-depth-limit form path nil nil)
                                    (let [children
                                          (sh07-b51-prepend-pattern-children
                                           request indexes form next-node path depth
                                           (rest frontier))]
                                      (if (= (get children :status) :accepted)
                                        (recur
                                         (get children :frontier)
                                         (conj descriptors
                                               (sh07-b51-vector-pattern-descriptor
                                                form path next-node
                                                parent-ordinal depth))
                                         introduced-binding-ids first-by-name
                                         (+ next-node 1) next-terminal next-leaf
                                         (+ vector-node-count 1)
                                         (if (> depth maximum-depth)
                                           depth maximum-depth)
                                         (if (> width maximum-width)
                                           width maximum-width)
                                         (if (> (count path)
                                                maximum-path-length)
                                           (count path)
                                           maximum-path-length))
                                        (sh07-b51-pattern-rejection
                                         (get children :reason) nil
                                         (get children :offending-form)
                                         path nil nil))))))
                              (if (= form-kind :symbol)
                                (if (if descendant?
                                      (= (get form :value) '&)
                                      false)
                                  (sh07-b51-pattern-rejection
                                   :unsupported-vector-rest nil form path nil nil)
                                  (if (if descendant?
                                        (= (get form :value) '_)
                                        false)
                                    (recur
                                     (rest frontier)
                                     (conj descriptors
                                           (sh07-b51-wildcard-pattern-descriptor
                                            form path next-node parent-ordinal
                                            next-terminal))
                                     introduced-binding-ids first-by-name
                                     (+ next-node 1) (+ next-terminal 1)
                                     next-leaf vector-node-count maximum-depth
                                     maximum-width
                                     (if (> (count path) maximum-path-length)
                                       (count path) maximum-path-length))
                                    (let [name (get form :value)
                                          occurrence
                                          (sh07-b51-pattern-occurrence-evidence
                                           form path next-node next-terminal
                                           next-leaf)]
                                      (if (contains? first-by-name name)
                                        (sh07-b51-pattern-rejection
                                         :duplicate-vector-binding-name nil
                                         form path (get first-by-name name)
                                         occurrence)
                                        (let [binding
                                              (sh07-b51-authenticated-pattern-binding
                                               indexes fragment form)]
                                          (if (map? binding)
                                            (recur
                                             (rest frontier)
                                             (conj descriptors
                                                   (sh07-b51-binding-pattern-descriptor
                                                    form binding path next-node
                                                    parent-ordinal next-terminal
                                                    next-leaf))
                                             (conj introduced-binding-ids
                                                   (get binding :binding-id))
                                             (assoc first-by-name name occurrence)
                                             (+ next-node 1)
                                             (+ next-terminal 1)
                                             (+ next-leaf 1)
                                             vector-node-count maximum-depth
                                             maximum-width
                                             (if (> (count path)
                                                    maximum-path-length)
                                               (count path)
                                               maximum-path-length))
                                            (sh07-b51-pattern-rejection
                                             :binding-leaf-unauthenticated nil
                                             form path nil nil)))))))
                                (sh07-b51-pattern-rejection
                                 :unsupported-nested-pattern nil
                                 form path nil nil)))))
                        (sh07-b51-pattern-rejection
                         :pattern-parent-not-reciprocal nil
                         form path nil nil))
                      (sh07-b51-pattern-rejection
                       :pattern-cross-fragment nil form path nil nil))
                    (sh07-b51-pattern-rejection
                     :pattern-form-substitution nil form path nil nil)))))
            (sh07-b51-pattern-rejection
             :unsupported-nested-pattern nil pattern-form [] nil nil))
          (sh07-b51-pattern-rejection
           :pattern-cross-fragment nil pattern-form [] nil nil))
        (sh07-b51-pattern-rejection
         :pattern-form-substitution nil pattern-form [] nil nil))
      (sh07-b51-pattern-rejection
       :request-index-duplicate nil pattern-form [] nil nil))))

(defn sh07-b51-pattern-result-shape? [result]
  (if (sh07-b51-exact-keys?
       result
       #{:status :pattern-kind :pattern-root :descriptors
         :introduced-binding-ids :node-count :extraction-count
         :terminal-count :leaf-count :vector-node-count
         :maximum-vector-depth :maximum-vector-width
         :maximum-path-length})
    (if (= (get result :status) :accepted)
      (if (contains? #{:legacy-simple-symbol :vector-pattern}
                     (get result :pattern-kind))
        (if (vector? (get result :descriptors))
          (if (= (get result :node-count)
                 (count (get result :descriptors)))
            (if (= (get result :extraction-count)
                   (get result :node-count))
              (if (= (get result :leaf-count)
                     (count (get result :introduced-binding-ids)))
                (loop [remaining
                       [:node-count :extraction-count :terminal-count
                        :leaf-count :vector-node-count
                        :maximum-vector-depth :maximum-vector-width
                        :maximum-path-length]]
                  (if (= (count remaining) 0)
                    true
                    (let [value (get result (first remaining))]
                      (if (integer? value)
                        (if (>= value 0)
                          (recur (rest remaining))
                          false)
                        false))))
                false)
              false)
            false)
          false)
        false)
      false)
    false))

(defn sh07-b51-module-pattern-slot-shape? [slot]
  (if (sh07-b51-exact-keys?
       slot #{:owner-coordinate :fragment :pattern})
    (if (map? (get slot :owner-coordinate))
      (if (map? (get slot :fragment))
        (sh07-b51-pattern-result-shape? (get slot :pattern))
        false)
      false)
    false))

(defn sh07-b51-predecessor-mask-check
  [check observed maximum]
  (let [crossing (+ maximum 1)
        saturated (if (> observed crossing) crossing observed)]
    {:check check
     :boundary-owner :predecessor-b47
     :maximum maximum
     :observed saturated
     :status (if (<= saturated maximum) :passed :masked-violation)}))

(defn sh07-b51-predecessor-mask-checks [slots]
  (loop [remaining slots
         owner-counts {}
         maximum-owner-slots 0
         maximum-width 0
         maximum-nodes 0
         extraction-count 0
         maximum-depth 0
         maximum-path-length 0]
    (if (= (count remaining) 0)
      [(sh07-b51-predecessor-mask-check
        :owner-slot-limit maximum-owner-slots 1024)
       (sh07-b51-predecessor-mask-check
        :vector-width-limit maximum-width 1024)
       (sh07-b51-predecessor-mask-check
        :slot-pattern-node-limit maximum-nodes 1024)
       (sh07-b51-predecessor-mask-check
        :module-extraction-limit extraction-count 65536)
       (sh07-b51-predecessor-mask-check
        :vector-depth-limit maximum-depth 256)
       (sh07-b51-predecessor-mask-check
        :extraction-path-length-limit maximum-path-length 256)]
      (let [slot (first remaining)
            owner (get slot :owner-coordinate)
            pattern (get slot :pattern)
            owner-key [(get owner :root-form-id)
                       (get owner :enclosing-form-id)]
            prior-owner-count (get owner-counts owner-key)
            next-owner-count
            (if (= prior-owner-count nil) 1 (+ prior-owner-count 1))
            next-extraction-count
            (+ extraction-count (get pattern :extraction-count))]
        (recur
         (rest remaining)
         (assoc owner-counts owner-key next-owner-count)
         (if (> next-owner-count maximum-owner-slots)
           next-owner-count maximum-owner-slots)
         (if (> (get pattern :maximum-vector-width) maximum-width)
           (get pattern :maximum-vector-width) maximum-width)
         (if (> (get pattern :node-count) maximum-nodes)
           (get pattern :node-count) maximum-nodes)
         (if (> next-extraction-count 65537)
           65537 next-extraction-count)
         (if (> (get pattern :maximum-vector-depth) maximum-depth)
           (get pattern :maximum-vector-depth) maximum-depth)
         (if (> (get pattern :maximum-path-length) maximum-path-length)
           (get pattern :maximum-path-length) maximum-path-length))))))

(defn sh07-b51-first-masked-bound [checks]
  (loop [remaining checks]
    (if (= (count remaining) 0)
      nil
      (if (= (get (first remaining) :status) :passed)
        (recur (rest remaining))
        (first remaining)))))

(defn sh07-b51-module-slot-offender [slots]
  (loop [remaining slots ordinal 1]
    (if (= (count remaining) 0)
      nil
      (if (= ordinal 1025)
        {:slot-ordinal ordinal
         :pattern-root (get (get (first remaining) :pattern) :pattern-root)
         :path []
         :fragment (get (first remaining) :fragment)
         :owner-coordinate (get (first remaining) :owner-coordinate)}
        (recur (rest remaining) (+ ordinal 1))))))

(defn sh07-b51-module-leaf-offender [slots]
  (loop [remaining-slots slots
         remaining-descriptors []
         current-slot nil
         leaf-count 0]
    (if (= (count remaining-descriptors) 0)
      (if (= (count remaining-slots) 0)
        nil
        (recur
         (rest remaining-slots)
         (get (get (first remaining-slots) :pattern) :descriptors)
         (first remaining-slots) leaf-count))
      (let [descriptor (first remaining-descriptors)]
        (if (= (get descriptor :kind) :binding-leaf)
          (if (= (+ leaf-count 1) 2049)
            {:leaf-ordinal 2049
             :descriptor descriptor
             :pattern-root
             (get (get current-slot :pattern) :pattern-root)
             :path (get descriptor :path)
             :fragment (get current-slot :fragment)
             :owner-coordinate (get current-slot :owner-coordinate)}
            (recur
             remaining-slots (rest remaining-descriptors)
             current-slot (+ leaf-count 1)))
          (recur
           remaining-slots (rest remaining-descriptors)
           current-slot leaf-count))))))

(defn sh07-b51-module-binding-leaf-count [slots]
  (loop [remaining-slots slots
         remaining-descriptors []
         result 0]
    (if (= (count remaining-descriptors) 0)
      (if (= (count remaining-slots) 0)
        result
        (recur
         (rest remaining-slots)
         (get (get (first remaining-slots) :pattern) :descriptors)
         result))
      (if (= (get (first remaining-descriptors) :kind) :binding-leaf)
        (recur
         remaining-slots (rest remaining-descriptors)
         (if (= result 2049) 2049 (+ result 1)))
        (recur remaining-slots (rest remaining-descriptors) result)))))

(defn sh07-b51-module-resource-rejection
  [reason check offender mask-checks]
  (let [row (sh07-b51-resource-bound-row check)]
    {:status :rejected
     :reason reason
     :check check
     :catalog-row row
     :expected {:unit (get row :unit) :maximum (get row :maximum)}
     :observed {:unit (get row :unit)
                :saturating-count (get row :crossing)}
     :offender offender
     :predecessor-mask-checks mask-checks
     :partial-products []}))

(defn sh07-b51-module-resource-preflight [slots]
  (if (sh07-b51-resource-bound-catalog-valid?)
    (if (vector? slots)
      (if (loop [remaining slots]
            (if (= (count remaining) 0)
              true
              (if (sh07-b51-module-pattern-slot-shape? (first remaining))
                (recur (rest remaining))
                false)))
        (let [mask-checks (sh07-b51-predecessor-mask-checks slots)
              masked (sh07-b51-first-masked-bound mask-checks)]
          (if (map? masked)
            {:status :rejected
             :reason :predecessor-bound-mask
             :check (get masked :check)
             :predecessor-mask-checks mask-checks
             :partial-products []}
            (if (> (count slots) 1024)
              (sh07-b51-module-resource-rejection
               :module-slot-limit-exceeded :module-slot-limit
               (sh07-b51-module-slot-offender slots) mask-checks)
              (let [leaf-count
                    (sh07-b51-module-binding-leaf-count slots)]
                (if (> leaf-count 2048)
                  (sh07-b51-module-resource-rejection
                   :module-binding-leaf-limit-exceeded
                   :module-binding-leaf-limit
                   (sh07-b51-module-leaf-offender slots) mask-checks)
                  {:status :accepted
                   :slot-count (count slots)
                   :binding-leaf-count leaf-count
                   :predecessor-mask-checks mask-checks
                   :partial-products []})))))
        {:status :rejected
         :reason :module-pattern-slot-shape
         :check nil
         :predecessor-mask-checks []
         :partial-products []})
      {:status :rejected
       :reason :module-pattern-slot-shape
       :check nil
       :predecessor-mask-checks []
       :partial-products []})
    {:status :rejected
     :reason :resource-bound-catalog
     :check nil
     :predecessor-mask-checks []
     :partial-products []}))


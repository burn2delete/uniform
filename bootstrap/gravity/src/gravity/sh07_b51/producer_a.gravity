           :gravity/sh07-b51-predecessor-executable-closure-v18)
      (if (= (get descriptor :schema-version) 18)
        (if (= (get descriptor :base-commit)
               "3d7d4b532176841a45db71fa3ca37f7300d2d2c8")
          (if (= (get descriptor :source-relative-path)
                 "bootstrap/gravity/src/gravity/checked_core.gravity")

                 :module-plans module-plans
                 :routes (get bundle :routes)
                 :public-roots (get bundle :public-roots)}
                bundle-core-id
                (sh07-b51-r1-compact-hash bundle-core)
                certificate-ids
                (get bundle :compile-census-certificate-ids)
                bundle-preimage
                {:artifact (get bundle :artifact)
                 :schema-version (get bundle :schema-version)
                 :manifest-id (get bundle :manifest-id)
                 :module-plans (get bundle :module-plans)
                 :routes (get bundle :routes)
                 :public-roots (get bundle :public-roots)
                 :bundle-core-id (get bundle :bundle-core-id)
                 :compile-census-certificate-ids certificate-ids}
                expected-bundle-id

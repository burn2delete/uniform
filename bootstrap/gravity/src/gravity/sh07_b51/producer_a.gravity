      (if (>= (get coordinate :module-ordinal) 0)
        (if (< (get coordinate :module-ordinal) 7)
          (if (sh07-b51-sha256-id? (get coordinate :module-source-id))
            (if (sh07-b51-sha256-id? (get coordinate :plan-id))
              (symbol? (get coordinate :function)) false)
            false)

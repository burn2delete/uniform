(defn sh07-b51-v16-resolved-identity-agrees?
  [template requests resolved artifact artifact-ordinal]
  (let [request-preimage (get (get requests artifact-ordinal) :preimage)
        resolved-preimage
        (sh07-b51-v16-resolve-controlled-value request-preimage resolved)]
    (if (= request-preimage (get template :identity-preimage))
      (if (= (get resolved-preimage :status) :accepted)
        (let [normalized
              (sh07-b51-v16-normalize-identity-preimage
               (get resolved-preimage :value))
              normalized-artifact-identity
              (sh07-b51-v16-normalize-identity-preimage
               (get artifact :identity-preimage))
              normalized-artifact-view
              (sh07-b51-v16-normalize-identity-preimage
               (sh07-b51-v16-artifact-identity-view artifact))]
          (if (sh07-b51-v16-identity-preimage-shape? normalized)
            (if (sh07-b51-v16-identity-preimage-shape?
                 normalized-artifact-identity)
              (if (sh07-b51-v16-identity-preimage-shape?
                   normalized-artifact-view)
                (if (= (get normalized :domain)
                       :gravity/sh07-b47-canonical-core-v16)
                  (if (= normalized normalized-artifact-identity)
                    (= normalized normalized-artifact-view)
                    false)
                  false)
                false)
              false)
            false))
        false)
      false)))

(defn sh07-b51-v16-resolved-provenance-agrees?
  [template requests resolved artifact provenance-ordinal]
  (let [request-preimage (get (get requests provenance-ordinal) :preimage)
        resolved-preimage
        (sh07-b51-v16-resolve-controlled-value request-preimage resolved)
        resolved-preserved-resolution
        (sh07-b51-v16-resolve-controlled-value
         (get template :preserved-resolution) resolved)]
    (if (= request-preimage (get template :provenance-binding-preimage))
      (if (= (get resolved-preimage :status) :accepted)
        (let [preimage (get resolved-preimage :value)]
          (if (sh07-b51-exact-keys?
               preimage
               #{:domain :core-artifact-id-request :source-revision-id
                 :sh06-artifact-id :actual-source-path})
            (if (= (get preimage :domain)
                   :gravity/sh07-b47-core-provenance-binding-v16)
              (if (= (get preimage :core-artifact-id-request)
                     (get artifact :artifact-id))
                (if (= preimage (get artifact :provenance-binding-preimage))
                  (if (= (get artifact :provenance)
                         (get template :provenance))
                    (if (= (get resolved-preserved-resolution :status)
                           :accepted)
                      (if (= (get artifact :preserved-resolution)
                             (get resolved-preserved-resolution :value))
                        (= (get artifact :diagnostics) [])
                        false)
                      false)
                    false)
                  false)
                false)
              false)
            false))
        false)
      false)))

(defn sh07-b51-v16-accepted-artifact-chain-agrees?
  [direct-result structural]
  (let [template (get direct-result :core-template)
        requests (get direct-result :digest-requests)
        resolved (get structural :resolved-digests)
        artifact (get structural :canonical-core-artifact)
        artifact-reference (get template :artifact-id-request)
        provenance-reference (get template :provenance-binding-id-request)
        artifact-ordinal (get artifact-reference :ordinal)
        provenance-ordinal (get provenance-reference :ordinal)]
    (if (= (get direct-result :status) :accepted)
      (if (= (get direct-result :diagnostics) [])
        (if (map? template)
          (if (= (get template :artifact)
                 :gravity/sh07-canonical-core-template)
            (if (= (get template :schema-version) 16)
              (if (sh07-b51-v16-resolved-digest-sequence?
                   requests resolved)
                (if (sh07-b51-v16-internal-reference-shape?
                     artifact-reference)
                  (if (sh07-b51-v16-internal-reference-shape?
                       provenance-reference)
                    (if (< artifact-ordinal (count requests))
                      (if (< provenance-ordinal (count requests))
                        (if (= (get (get requests artifact-ordinal) :purpose)
                               :sh07-core-artifact-id)
                          (if (= (get (get requests provenance-ordinal)
                                      :purpose)
                                 :sh07-core-provenance-binding-id)
                            (if (sh07-b51-sha256-id?
                                 (get resolved artifact-ordinal))
                              (if (sh07-b51-sha256-id?
                                   (get resolved provenance-ordinal))
                                (if (sh07-b51-exact-keys?
                                     artifact
                                     #{:artifact :schema-version :artifact-id
                                       :provenance-binding-id :module :lineage
                                       :projection-binding :fragment-manifest
                                       :fragment-coverage
                                       :module-assembly-manifest
                                       :root-core-node-ids :definitions :nodes
                                       :evaluation-order :control-flow
                                       :reference-uses :var-references :mutations
                                       :error-transfers :error-handlers
                                       :match-branch-records
                                       :match-decision-skeletons
                                       :match-pattern-records :calls
                                       :function-records :call-edges
                                       :recursion-components :keyword-lookups
                                       :lexical-bindings :loop-bindings
                                       :recur-targets :recur-transfers :source-map
                                       :preserved-resolution
                                       :declared-alias-table
                                       :macro-expansion-trace
                                       :macro-origin-traces
                                       :macro-origin-expectation
                                       :pending-fact-families
                                       :identity-preimage
                                       :provenance-binding-preimage
                                       :provenance :diagnostics})
                                  (if (= (get artifact :artifact)
                                         :gravity/sh07-canonical-core-artifact)
                                    (if (= (get artifact :schema-version) 16)
                                      (if (= (get artifact :artifact-id)
                                             (get resolved artifact-ordinal))
                                        (if (= (get artifact
                                                    :provenance-binding-id)
                                               (get resolved
                                                    provenance-ordinal))
                                          (if (sh07-b51-v16-resolved-identity-agrees?
                                               template requests resolved
                                               artifact artifact-ordinal)
                                            (sh07-b51-v16-resolved-provenance-agrees?
                                             template requests resolved artifact
                                             provenance-ordinal)
                                            false)
                                          false)
                                        false)
                                      false)
                                    false)
                                  false)
                                false)
                              false)
                            false)
                          false)
                        false)
                      false)
                    false)
                  false)
                false)
              false)
            false)
          false)
        false)
      false)))

(defn sh07-b51-v16-accepted-observation-agrees?
  [direct-result structural]
  (if (= (get structural :thrown) nil)
    (let [returned (get structural :returned)]
      (if (sh07-b51-exact-keys?
           returned
           #{:raw-template-result :canonical-core-artifact
             :digest-requests :resolved-digests :template-verification
             :resolved-verification})
        (if (= (get returned :raw-template-result) direct-result)
          (if (= (get returned :digest-requests)
                 (get direct-result :digest-requests))
            (if (sh07-b51-v16-template-verification-passed?
                 (get returned :template-verification))
              (if (sh07-b51-v16-resolved-verification-passed?
                   (get returned :resolved-verification))
                (sh07-b51-v16-accepted-artifact-chain-agrees?
                 direct-result returned)
                false)
              false)
            false)
          false)
        false))
    false))

(defn sh07-b51-raw-observation-shape? [value request]
  (if (sh07-b51-exact-keys?
       value #{:direct-template-observation :structural-runner-observation})
    (let [direct (get value :direct-template-observation)
          structural (get value :structural-runner-observation)]
      (if (sh07-b51-exact-keys?
           direct #{:entrypoint :request :returned :thrown})
        (if (sh07-b51-exact-keys?
             structural #{:entrypoint :request :returned :thrown})
          (if (= (get direct :entrypoint) 'sh07-build-core-template)
            (if (= (get structural :entrypoint)
                   'sh07-core-run-structural-request-for-test)
              (if (= (get direct :request) request)
                (if (= (get structural :request) request)
                  (if (= (get direct :thrown) nil)
                    (let [result (get direct :returned)]
                      (if (sh07-b51-v16-template-result-common-shape? result)
                        (if (= (get result :status) :accepted)
                          (sh07-b51-v16-accepted-observation-agrees?
                           result structural)
                          (if (= (get result :status) :rejected)
                            (sh07-b51-v16-rejected-observation-agrees?
                             result structural request)
                            false))
                        false))
                    false)
                  false)
                false)
              false)
            false)
          false)
        false))
    false))

(defn sh07-b51-sh06-checks-shape? [checks]
  (if (sh07-b51-exact-keys?
       checks
       #{:bounded-artifact-carrier? :bounded-semantic-components?
         :exact-kind? :accepted-status? :document-set-current?
         :governing-document-current? :fresh-upstream-sh05-verification?
         :plan-binding-current? :fresh-gravity-request-replay?
         :authenticated-resolution-request-current?
         :raw-template-result-current? :raw-analysis-current?
         :resolved-analysis-current? :digest-requests-current?
         :resolved-digests-current? :template-verification-current?
         :resolved-verification-current? :upstream-request-binding?
         :fresh-gravity-verification? :namespace-analysis-current?
         :binding-table-current? :alias-table-current?
         :import-export-current? :lexical-scope-current?
         :dependency-graph-current? :cross-profile-current?
         :invalidation-current? :resolution-table-current?
         :artifact-identity-current? :fresh-sh02-envelope-verified?
         :exact-artifact-shape? :exact-boundary-shape?
         :fixed-boundary-contract? :pass-contract-current?
         :execution-boundary-current?
         :component-transport-bounds-current?
         :aggregate-artifact-bounds-current? :provenance-current?
         :accepted-diagnostics-empty? :embedded-capability-proof-current?})
    (loop [remaining (keys checks)]
      (if (= (count remaining) 0)
        true
        (if (= (get checks (first remaining)) true)
          (recur (rest remaining))
          false)))
    false))

(defn sh07-b51-sh06-proof-agrees? [proof checks]
  (if (sh07-b51-exact-keys?
       proof
       #{:bounded-artifact-carrier? :bounded-semantic-components?
         :exact-kind? :accepted-status? :document-set-current?
         :governing-document-current? :fresh-upstream-sh05-verification?
         :plan-binding-current? :fresh-gravity-request-replay?
         :authenticated-resolution-request-current?
         :raw-template-result-current? :raw-analysis-current?
         :resolved-analysis-current? :digest-requests-current?
         :resolved-digests-current? :template-verification-current?
         :resolved-verification-current? :upstream-request-binding?
         :fresh-gravity-verification? :namespace-analysis-current?
         :binding-table-current? :alias-table-current?
         :import-export-current? :lexical-scope-current?
         :dependency-graph-current? :cross-profile-current?
         :invalidation-current? :resolution-table-current?
         :artifact-identity-current? :fresh-sh02-envelope-verified?
         :exact-artifact-shape? :exact-boundary-shape?
         :fixed-boundary-contract? :pass-contract-current?
         :execution-boundary-current?
         :component-transport-bounds-current?
         :aggregate-artifact-bounds-current? :provenance-current?
         :accepted-diagnostics-empty? :embedded-capability-proof-current?
         :artifact :status :failed-checks})
    (if (= (get proof :artifact)
           :gravity/sh06-resolution-capability-proof)
      (if (= (get proof :status) :complete)
        (if (= (get proof :failed-checks) [])
          (loop [remaining (keys checks)]
            (if (= (count remaining) 0)
              true
              (if (= (get proof (first remaining))
                     (get checks (first remaining)))
                (recur (rest remaining))
                false)))
          false)
        false)
      false)
    false))

(defn sh07-b51-sh06-module-projection-bound?
  [raw-module analysis request]
  (let [projected (get request :module)]
    (if (= raw-module (get analysis :module-contract))
      (loop [remaining
             [:namespace :profile :target :safety :effects
              :capabilities :exports]]
        (if (= (count remaining) 0)
          (if (= (get projected :source-revision-id)
                 (get (get request :lineage) :source-revision-id))
            (if (= (get projected :source-revision-id)
                   (get (get request :module-assembly-manifest)
                        :source-revision-id))
              (= (get projected :source-revision-id)
                 (get (get request :macro-origin-expectation)
                      :source-revision-id))
              false)
            false)
          (if (= (get projected (first remaining))
                 (get raw-module (first remaining)))
            (recur (rest remaining))
            false)))
      false)))

(defn sh07-b51-sh06-resolution-kind [order]
  (if (= order :local-lexical-binding)
    :local
    (if (= order :current-namespace-binding)
      :namespace
      (if (= order :alias-qualified-required-binding)
        :alias-qualified
        (if (= order :fully-qualified-namespace-binding)
          :fully-qualified
          (if (= order :profile-allowed-core-binding)
            :core-auto-import
            (if (= order :explicit-foreign-import-binding)
              :foreign
              order)))))))

(defn sh07-b51-sh06-resolution-projection-bound?
  [analysis-record projected-record]
  (= projected-record
     (assoc analysis-record
            :resolution-kind
            (sh07-b51-sh06-resolution-kind
             (get analysis-record :resolution-order)))))

(defn sh07-b51-sh06-resolution-vector-bound?
  [analysis-records projected-records]
  (if (= (count analysis-records) (count projected-records))
    (loop [remaining-analysis analysis-records
           remaining-projected projected-records]
      (if (= (count remaining-analysis) 0)
        true
        (if (sh07-b51-sh06-resolution-projection-bound?
             (first remaining-analysis) (first remaining-projected))
          (recur (rest remaining-analysis) (rest remaining-projected))
          false)))
    false))

(defn sh07-b51-sh06-products-bound? [artifact analysis]
  (let [binding-product (get artifact :binding-table)
        alias-product (get artifact :alias-table)
        import-product (get artifact :import-export-table)
        lexical-product (get artifact :lexical-scope-graph)
        dependency-product (get artifact :dependency-graph)
        cross-product (get artifact :cross-profile-edge-report)
        invalidation-product (get artifact :incremental-invalidation-keys)
        resolution-product (get artifact :resolution-table)]
    (if (= (get artifact :namespace-analysis)
           (assoc analysis :artifact :gravity/namespace-analysis))
      (if (sh07-b51-exact-keys?
           binding-product
           #{:artifact :status :bindings :resolution-table})
        (if (= (get binding-product :artifact) :gravity/c5-binding-table)
          (if (= (get binding-product :status) :complete)
            (if (= (get binding-product :bindings)
                   (get analysis :binding-table))
              (if (sh07-b51-sh06-resolution-vector-bound?
                   (get analysis :resolution-table)
                   (get binding-product :resolution-table))
                (if (= alias-product
                       {:artifact :gravity/c5-alias-table
                        :status :complete
                        :aliases (get analysis :alias-table)})
                  (if (= import-product
                         {:artifact :gravity/c5-import-export-table
                          :status :complete
                          :imports (get analysis :dependency-records)
                          :exports (get analysis :exports)})
                    (if (= lexical-product
                           {:artifact :gravity/c5-lexical-scope-graph
                            :status :complete
                            :scopes (get analysis :lexical-scope-graph)})
                      (if (= dependency-product
                             (assoc
                              (assoc (get analysis :dependency-graph)
                                     :artifact
                                     :gravity/c5-module-dependency-graph)
                              :status :complete))
                        (if (= cross-product
                               {:artifact :gravity/c5-cross-profile-edge-report
                                :status :complete
                                :records
                                (get analysis :cross-profile-edge-report)})
                          (if (sh07-b51-exact-keys?
                               invalidation-product
                               #{:artifact :status :inputs :invalidation-id})
                            (if (= (get invalidation-product :artifact)
                                   :gravity/c5-incremental-invalidation-keys)
                              (if (= (get invalidation-product :status)
                                     :stable)
                                (if (= (get invalidation-product :inputs)
                                       (get analysis
                                            :incremental-invalidation-inputs))
                                  (if (sh07-b51-sha256-id?
                                       (get invalidation-product
                                            :invalidation-id))
                                    (sh07-b51-sh06-resolution-vector-bound?
                                     (get analysis :resolution-table)
                                     resolution-product)
                                    false)
                                  false)
                                false)
                              false)
                            false)
                          false)
                        false)
                      false)
                    false)
                  false)
                false)
              false)
            false)
          false)
        false)
      false)))

(defn sh07-b51-fresh-sh06-binding? [carrier]
  (let [request (get carrier :authenticated-sh06-request)
        report (get carrier :authenticated-sh06-verification-report)
        artifact (get carrier :sh06-resolution-artifact)
        boundary (get artifact :gravity-resolution-boundary)
        raw-request (get boundary :authenticated-resolution-request)
        analysis (get boundary :resolved-analysis)
        checks (get report :checks)
        proof (get artifact :capability-based-proof)
        source-path (get (get artifact :provenance) :source-path)]
    (if (sh07-b51-exact-keys?
         artifact
         #{:kind :status :slice :task :document-set :governing-document
           :artifact-id :sh05-macro-artifact :gravity-resolution-boundary
           :provenance :pass :execution-boundary :capability-based-proof
           :diagnostics :namespace-analysis :binding-table :alias-table
           :import-export-table :lexical-scope-graph :dependency-graph
           :cross-profile-edge-report :incremental-invalidation-keys
           :resolution-table})
      (if (sh07-b51-exact-keys?
           boundary
           #{:slice :owner :adapter-contract :plan-binding
             :authenticated-resolution-request :raw-template-result
             :raw-analysis :resolved-analysis :digest-requests
             :resolved-digests :template-verification
             :resolved-verification :authenticated-envelope-descriptor
             :authenticated-envelope :target-source-reread?
             :clojure-adapter-residual? :self-hosted?})
        (if (sh07-b51-exact-keys?
             report
             #{:artifact :status :checks :failed-checks :source-path
               :gravity-verification :upstream-verification})
          (if (= (get artifact :kind) :gravity/sh06-resolution-artifact)
            (if (= (get artifact :status) :accepted)
              (if (= (get report :artifact)
                     :gravity/sh06-resolution-artifact-verification)
                (if (= (get report :status) :passed)
                  (if (= (get report :failed-checks) [])
                    (if (= (get report :source-path) source-path)
                      (if (sh07-b51-sh06-checks-shape? checks)
                        (if (sh07-b51-sh06-proof-agrees? proof checks)
                          (if (= (get (get request :lineage)
                                      :authenticated-sh06-artifact-id)
                                 (get artifact :artifact-id))
                            (if (= (get request :provenance)
                                   {:actual-source-path source-path})
                              (if (= (get raw-request :provenance)
                                     {:actual-source-path source-path})
                                (if (sh07-b51-sh06-module-projection-bound?
                                     (get raw-request :module)
                                     analysis request)
                                  (if (= (get raw-request :lexical-scopes)
                                         (get analysis
                                              :lexical-scope-graph))
                                    (if (= (get raw-request
                                                :macro-expansion-binding)
                                           (get analysis
                                                :macro-expansion-binding))
                                      (sh07-b51-sh06-products-bound?
                                       artifact analysis)
                                      false)
                                    false)
                                  false)
                                false)
                              false)
                            false)
                          false)
                        false)
                      false)
                    false)
                  false)
                false)
              false)
            false)
          false)
        false)
      false)))


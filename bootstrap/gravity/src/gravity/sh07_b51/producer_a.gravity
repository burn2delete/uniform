                                                              (if (sh07-b51-digest-reference?
                                                                   (get preimage
                                                                        :predecessor-authority-id))
                                                                (if (sh07-b51-digest-reference?
                                                                     (get preimage
                                                                          :loop-core-node-id))
                                                                  (if (sh07-b51-digest-reference?
                                                                       (get preimage
                                                                            :recur-core-node-id))
                                                                    (if (sh07-b51-digest-reference?
                                                                         (get preimage
                                                                              :target-loop-core-node-id))
                                                                      (if (sh07-b51-digest-reference?
                                                                           (get preimage
                                                                                :commit-publication-id))
                                                                        (if (= (get preimage
                                                                                    :recur-form-id)
                                                                               (get recur-coordinate
                                                                                    :recur-form-id))
                                                                          (if (= (get preimage
                                                                                      :recur-syntax-id)
                                                                                 (get recur-coordinate
                                                                                      :recur-syntax-id))
                                                                            (if (= (get preimage
                                                                                        :recur-core-node-id)
                                                                                   (get recur-coordinate
                                                                                        :recur-core-node-id))
                                                                              (if (= (get preimage
                                                                                          :loop-form-id)
                                                                                     (get owner
                                                                                          :enclosing-form-id))
                                                                                (if (= (get preimage
                                                                                            :loop-syntax-id)
                                                                                       (get owner
                                                                                            :enclosing-syntax-id))
                                                                                  (if (= (get preimage
                                                                                              :target-loop-form-id)
                                                                                         (get preimage
                                                                                              :loop-form-id))
                                                                                    (if (= (get preimage
                                                                                                :target-loop-syntax-id)
                                                                                           (get preimage
                                                                                                :loop-syntax-id))
                                                                                      (if (= (get preimage
                                                                                                  :target-loop-core-node-id)
                                                                                             (get preimage
                                                                                                  :loop-core-node-id))
                                                                                        (if (= (get preimage
                                                                                                    :fragment-id)
                                                                                               (get owner
                                                                                                    :fragment-id))
                                                                                          (if (= (get preimage
                                                                                                      :fragment-ordinal)
                                                                                                 (get owner
                                                                                                      :fragment-ordinal))
                                                                                            (if (= (get preimage
                                                                                                        :root-form-id)
                                                                                                   (get owner
                                                                                                        :root-form-id))
                                                                                              (if (= (get preimage
                                                                                                          :root-syntax-id)
                                                                                                     (get owner
                                                                                                          :root-syntax-id))
                                                                                                (if (loop [remaining
                                                                                                           [:fragment-id :root-form-id
                                                                                                            :root-syntax-id :loop-form-id
                                                                                                            :loop-syntax-id :recur-form-id
                                                                                                            :recur-syntax-id
                                                                                                            :target-loop-form-id
                                                                                                            :target-loop-syntax-id]]
                                                                                                      (if (= (count remaining) 0)
                                                                                                        true
                                                                                                        (if (sh07-b51-sha256-id?
                                                                                                             (get preimage
                                                                                                                  (first remaining)))
                                                                                                          (recur (rest remaining))
                                                                                                          false)))
                                                                                                  (if (sh07-b51-origin-vector?
                                                                                                       (get preimage
                                                                                                            :source-origin-chain))
                                                                                                    (sh07-b51-origin-vector?
                                                                                                     (get preimage
                                                                                                          :source-generated-origin))
                                                                                                    false)
                                                                                                  false)
                                                                                                false)
                                                                                              false)
                                                                                            false)
                                                                                          false)
                                                                                        false)
                                                                                      false)
                                                                                    false)
                                                                                  false)
                                                                                false)
                                                                              false)
                                                                            false)
                                                                          false)
                                                                        false)
                                                                      false)
                                                                    false)
                                                                  false)
                                                                false)
                                                              false)
                                                            false)
                                                          false)
                                                        false)
                                                      false)
                                                    false)
                                                  false)
                                                false)
                                              false)
                                            false)
                                          false)
                                        false)
                                      false)
                                    false)
                                  false)
                                false)
                              false)
                            false)
                          false)
                        false)
                      false)
                    false)
                  false)
                false)
              false)
            false))
        false)
      false)
    false))

(defn sh07-b51-build-recur-slot-mapping-preimage [preimage]
  (if (sh07-b51-recur-slot-mapping-preimage-shape? preimage)
    {:status :accepted :preimage preimage}
    {:status :rejected :reason :recur-slot-mapping-preimage-shape
     :partial-products []}))

(defn sh07-b51-owner-fragment-by-coordinate
  [request owner-coordinate]
  (loop [remaining (get request :fragment-manifest)
         found nil count-found 0]
    (if (= (count remaining) 0)
      (if (= count-found 1)
        {:status :accepted :fragment found}
        {:status :rejected :reason :owner-fragment-coordinate
         :partial-products []})
      (let [fragment (first remaining)]
        (if (if (= (get fragment :fragment-id)
                   (get owner-coordinate :fragment-id))
              (= (get fragment :ordinal)
                 (get owner-coordinate :fragment-ordinal))
              false)
          (recur (rest remaining) fragment (+ count-found 1))
          (recur (rest remaining) found count-found))))))

(defn sh07-b51-authenticated-direct-child
  [request indexes parent child-id]
  (let [child (sh07-b51-find-form indexes child-id)
        listed (sh07-b51-index-of (get parent :child-form-ids) child-id)
        reciprocal (sh07-b51-child-membership-count
                    (get request :forms) child-id)]
    (if (map? child)
      (if (= (get listed :count) 1)
        (if (= (get child :parent-form-id) (get parent :form-id))
          (if (= (get reciprocal :count) 1)
            (if (= (get (get reciprocal :parent) :form-id)
                   (get parent :form-id))
              {:status :accepted :form child}
              {:status :rejected :reason :direct-child-parent-substitution
               :partial-products []})
            {:status :rejected :reason :direct-child-parent-nonunique
             :partial-products []})
          {:status :rejected :reason :direct-child-parent-mismatch
           :partial-products []})
        {:status :rejected :reason :direct-child-list-nonunique
         :partial-products []})
      {:status :rejected :reason :direct-child-missing
       :partial-products []})))

(defn sh07-b51-even-vector-count? [values]
  (if (vector? values)
    (loop [remaining values]
      (if (= (count remaining) 0)
        true
        (if (= (count remaining) 1)
          false
          (recur (rest (rest remaining))))))
    false))

(defn sh07-b51-let-owner-skeleton [request indexes enclosing]
  (if (= enclosing
         (sh07-b51-find-form indexes (get enclosing :form-id)))
    (if (sh07-b51-authenticated-list-operator? indexes enclosing 'let)
      (let [owner-result
            (sh07-b51-owner-coordinate request indexes enclosing)]
        (if (= (get owner-result :status) :accepted)
          (let [owner-coordinate (get owner-result :coordinate)
                fragment-result
                (sh07-b51-owner-fragment-by-coordinate
                 request owner-coordinate)
                child-ids (get enclosing :child-form-ids)]
            (if (sh07-b51-owner-coordinate-shape? owner-coordinate)
              (if (= (get fragment-result :status) :accepted)
                (if (sh07-b51-all-unique? child-ids)
                  (if (>= (count child-ids) 3)
                    (let [binding-result
                          (sh07-b51-authenticated-direct-child
                           request indexes enclosing (get child-ids 1))]
                      (if (= (get binding-result :status) :accepted)
                        (let [binding-vector
                              (get binding-result :form)]
                          (if (= (get binding-vector :kind) :vector)
                            (if (sh07-b51-even-vector-count?
                                 (get binding-vector :child-form-ids))
                              {:status :accepted
                               :owner-coordinate owner-coordinate
                               :owner-branch (get owner-result :branch)
                               :fragment (get fragment-result :fragment)
                               :binding-vector binding-vector
                               :body-child-ids
                               (loop [index 2 result []]
                                 (if (= index (count child-ids))
                                   result
                                   (recur (+ index 1)
                                          (conj result
                                                (get child-ids index)))))}
                              {:status :rejected
                               :reason :let-bindings-even-required
                               :partial-products []})
                            {:status :rejected
                             :reason :let-binding-vector-required
                             :partial-products []}))
                        binding-result))
                    {:status :rejected :reason :let-body-required
                     :partial-products []})
                  {:status :rejected :reason :let-child-duplicate
                   :partial-products []})
                fragment-result)
              {:status :rejected :reason :owner-coordinate-shape
               :partial-products []}))
          (assoc owner-result :partial-products [])))
      {:status :rejected :reason :let-operator-unauthenticated
       :partial-products []})
    {:status :rejected :reason :let-owner-substitution
     :partial-products []}))

(defn sh07-b51-loop-owner-skeleton [request indexes enclosing]
  (if (= enclosing
         (sh07-b51-find-form indexes (get enclosing :form-id)))
    (if (sh07-b51-authenticated-list-operator? indexes enclosing 'loop)
      (let [owner-result
            (sh07-b51-owner-coordinate request indexes enclosing)]
        (if (= (get owner-result :status) :accepted)
          (let [owner-coordinate (get owner-result :coordinate)
                fragment-result
                (sh07-b51-owner-fragment-by-coordinate
                 request owner-coordinate)
                child-ids (get enclosing :child-form-ids)]
            (if (sh07-b51-owner-coordinate-shape? owner-coordinate)
              (if (= (get fragment-result :status) :accepted)
                (if (sh07-b51-all-unique? child-ids)
                  (if (>= (count child-ids) 3)
                    (let [binding-result
                          (sh07-b51-authenticated-direct-child
                           request indexes enclosing (get child-ids 1))]
                      (if (= (get binding-result :status) :accepted)
                        (let [binding-vector (get binding-result :form)]
                          (if (= (get binding-vector :kind) :vector)
                            (if (sh07-b51-even-vector-count?
                                 (get binding-vector :child-form-ids))
                              {:status :accepted
                               :owner-coordinate owner-coordinate
                               :owner-branch (get owner-result :branch)
                               :fragment (get fragment-result :fragment)
                               :binding-vector binding-vector
                               :body-child-ids
                               (loop [index 2 result []]
                                 (if (= index (count child-ids))
                                   result
                                   (recur
                                    (+ index 1)
                                    (conj result (get child-ids index)))))}
                              {:status :rejected
                               :reason :loop-bindings-even-required
                               :partial-products []})
                            {:status :rejected
                             :reason :loop-binding-vector-required
                             :partial-products []}))
                        binding-result))
                    {:status :rejected :reason :loop-body-required
                     :partial-products []})
                  {:status :rejected :reason :loop-child-duplicate
                   :partial-products []})
                fragment-result)
              {:status :rejected :reason :owner-coordinate-shape
               :partial-products []}))
          (assoc owner-result :partial-products [])))
      {:status :rejected :reason :loop-operator-unauthenticated
       :partial-products []})
    {:status :rejected :reason :loop-owner-substitution
     :partial-products []}))

(defn sh07-b51-let-slot-patterns
  [request indexes skeleton]
  (let [binding-vector (get skeleton :binding-vector)
        fragment (get skeleton :fragment)
        child-ids (get binding-vector :child-form-ids)]
    (if (sh07-b51-all-unique? child-ids)
      (loop [index 0 slot-ordinal 0 slots []]
        (if (= index (count child-ids))
          {:status :accepted :slots slots}
          (let [pattern-result
                (sh07-b51-authenticated-direct-child
                 request indexes binding-vector (get child-ids index))
                initializer-result
                (sh07-b51-authenticated-direct-child
                 request indexes binding-vector (get child-ids (+ index 1)))]
            (if (= (get pattern-result :status) :accepted)
              (if (= (get initializer-result :status) :accepted)
                (let [pattern-form (get pattern-result :form)
                      initializer-form (get initializer-result :form)
                      coordinate-result
                      (sh07-b51-build-slot-coordinate
                       (get skeleton :owner-coordinate) slot-ordinal
                       pattern-form initializer-form)
                      pattern
                      (sh07-b51-enumerate-slot-pattern
                       request indexes fragment pattern-form)]
                  (if (= (get coordinate-result :status) :accepted)
                    (if (= (get pattern :status) :accepted)
                      (recur
                       (+ index 2) (+ slot-ordinal 1)
                       (conj slots
                             {:owner-coordinate
                              (get skeleton :owner-coordinate)
                              :fragment fragment
                              :slot-coordinate
                              (get coordinate-result :slot-coordinate)
                              :pattern-form pattern-form
                              :initializer-form initializer-form
                              :pattern pattern}))
                      (assoc
                       (assoc pattern :owner-coordinate
                              (get skeleton :owner-coordinate))
                       :slot-coordinate
                       (get coordinate-result :slot-coordinate)))
                    coordinate-result))
                initializer-result)
              pattern-result))))
      {:status :rejected :reason :binding-vector-child-duplicate
       :partial-products []})))

(defn sh07-b51-validate-let-body
  [request indexes skeleton]
  (loop [remaining (get skeleton :body-child-ids) result []]
    (if (= (count remaining) 0)
      {:status :accepted :body-forms result}
      (let [child
            (sh07-b51-authenticated-direct-child
             request indexes
             (sh07-b51-find-form
              indexes
              (get (get skeleton :owner-coordinate) :enclosing-form-id))
             (first remaining))]
        (if (= (get child :status) :accepted)
          (recur (rest remaining) (conj result (get child :form)))
          child)))))

(defn sh07-b51-initializer-child-entries
  [request indexes form depth]
  (loop [remaining (get form :child-form-ids) children []]
    (if (= (count remaining) 0)
      {:status :accepted :children children}
      (let [child
            (sh07-b51-authenticated-direct-child
             request indexes form (first remaining))]
        (if (= (get child :status) :accepted)
          (recur
           (rest remaining)
           (conj children
                 {:form (get child :form) :depth (+ depth 1)}))
          child)))))

(defn sh07-b51-initializer-reference-ids
  [request indexes fragment initializer]
  (loop [frontier [{:form initializer :depth 0}]
         visited #{}
         references []]
    (if (= (count frontier) 0)
      {:status :accepted :referenced-binding-ids references}
      (let [entry (first frontier)
            form (get entry :form)
            depth (get entry :depth)
            form-id (get form :form-id)
            canonical (sh07-b51-find-form indexes form-id)
            membership
            (sh07-b51-index-of (get fragment :form-ids) form-id)
            resolution
            (sh07-b51-find-resolution indexes (get form :syntax-id))]
        (if (> depth 256)
          {:status :rejected :reason :initializer-depth-bound
           :partial-products []}
          (if (contains? visited form-id)
            {:status :rejected :reason :initializer-form-cycle
             :partial-products []}
            (if (= form canonical)
              (if (= (get membership :count) 1)
                (if (sh07-b51-all-unique? (get form :child-form-ids))
                  (let [children
                        (sh07-b51-initializer-child-entries
                         request indexes form depth)]
                    (if (= (get children :status) :accepted)
                      (recur
                       (sh07-b51-vector-append
                        (get children :children) (rest frontier))
                       (conj visited form-id)
                       (if (map? resolution)
                         (if (sh07-b51-vector-contains?
                              references (get resolution :binding-id))
                           references
                           (conj references (get resolution :binding-id)))
                         references))
                      children))
                  {:status :rejected
                   :reason :initializer-child-duplicate
                   :partial-products []})
                {:status :rejected :reason :initializer-cross-fragment
                 :partial-products []})
              {:status :rejected :reason :initializer-form-substitution
               :partial-products []})))))))

(defn sh07-b51-slot-binding-ids-after [slots start]
  (loop [remaining slots index 0 result []]
    (if (= (count remaining) 0)
      result
      (if (>= index start)
        (recur
         (rest remaining) (+ index 1)
         (sh07-b51-vector-append
          result (get (get (first remaining) :pattern)
                      :introduced-binding-ids)))
        (recur (rest remaining) (+ index 1) result)))))

(defn sh07-b51-reference-intersection [references forbidden]
  (loop [remaining references result []]
    (if (= (count remaining) 0)
      result
      (if (sh07-b51-vector-contains? forbidden (first remaining))
        (recur (rest remaining) (conj result (first remaining)))
        (recur (rest remaining) result)))))

(defn sh07-b51-let-initializer-evaluations
  [request indexes slots initializer-core-node-ids]
  (if (= (count slots) (count initializer-core-node-ids))
    (loop [remaining slots
           remaining-core initializer-core-node-ids
           slot-ordinal 0
           visible-prior []
           evaluations []]
      (if (= (count remaining) 0)
        {:status :accepted :evaluations evaluations}
        (let [slot (first remaining)
              initializer (get slot :initializer-form)
              references-result
              (sh07-b51-initializer-reference-ids
               request indexes (get slot :fragment) initializer)
              forbidden-candidates
              (sh07-b51-slot-binding-ids-after slots slot-ordinal)]
          (if (= (get references-result :status) :accepted)
            (let [references
                  (get references-result :referenced-binding-ids)
                  forbidden
                  (sh07-b51-reference-intersection
                   references forbidden-candidates)]
              (if (= forbidden [])
                (recur
                 (rest remaining) (rest remaining-core)
                 (+ slot-ordinal 1)
                 (sh07-b51-vector-append
                  visible-prior
                  (get (get slot :pattern) :introduced-binding-ids))
                 (conj
                  evaluations
                  {:slot-ordinal slot-ordinal
                   :initializer-form-id (get initializer :form-id)
                   :initializer-syntax-id (get initializer :syntax-id)
                   :initializer-scope-id (get initializer :scope-id)
                   :initializer-core-node-id (first remaining-core)
                   :evaluation-count 1
                   :evaluation-order :initializers-left-to-right
                   :visible-prior-binding-ids visible-prior
                   :referenced-binding-ids references
                   :prior-scope-only true
                   :source-span (get initializer :source-span)
                   :source-origin-chain (get initializer :origin-chain)
                   :source-generated-origin
                   (get initializer :generated-origin)
                   :metadata (get initializer :metadata)
                   :preserved-declarations
                   {:effects (get (get request :module) :effects)
                    :capabilities
                    (get (get request :module) :capabilities)
                    :safety (get (get request :module) :safety)}
                   :pending-fact-families
                   [:types :effects :ownership :safety]}))
                {:status :rejected
                 :reason :let-initializer-binding-visibility
                 :slot-ordinal slot-ordinal
                 :visible-prior-binding-ids visible-prior
                 :forbidden-binding-ids forbidden
                 :partial-products []}))
            references-result))))
    {:status :rejected :reason :initializer-core-node-count
     :partial-products []}))

(defn sh07-b51-flatten-reference-vectors [values]
  (loop [remaining values result []]
    (if (= (count remaining) 0)
      result
      (recur (rest remaining)
             (sh07-b51-vector-append result (first remaining))))))

(defn sh07-b51-internal-reference-vector-increasing? [values]
  (if (vector? values)
    (loop [remaining values prior nil]
      (if (= (count remaining) 0)
        true
        (let [value (first remaining)]
          (if (sh07-b51-internal-reference? value)
            (if (if (= prior nil)
                  true
                  (> (get value :ordinal) prior))
              (recur (rest remaining) (get value :ordinal))
              false)
            false))))
    false))

(defn sh07-b51-vector-of-increasing-reference-vectors? [values]
  (if (vector? values)
    (loop [remaining values]
      (if (= (count remaining) 0)
        true
        (if (sh07-b51-internal-reference-vector-increasing?
             (first remaining))
          (recur (rest remaining))
          false)))
    false))

(defn sh07-b51-reference-layout-shape? [layout]
  (if (sh07-b51-exact-keys?
       layout
       #{:predecessor-authority-id :owner-core-node-id
         :initializer-core-node-ids :slot-ids :extraction-id-vectors
         :runtime-check-id-vectors :publication-event-ids
         :projection-id-vectors :product-node-id-vectors
         :first-global-slot-ordinal :first-global-extraction-ordinal
         :first-global-runtime-check-ordinal
         :first-global-publication-ordinal})
    (if (sh07-b51-internal-reference?
         (get layout :predecessor-authority-id))
      (if (sh07-b51-internal-reference? (get layout :owner-core-node-id))
        (if (sh07-b51-internal-reference-vector-increasing?
             (get layout :initializer-core-node-ids))
          (if (sh07-b51-internal-reference-vector-increasing?
               (get layout :slot-ids))
            (if (sh07-b51-vector-of-increasing-reference-vectors?
                 (get layout :extraction-id-vectors))
              (if (sh07-b51-vector-of-increasing-reference-vectors?
                   (get layout :runtime-check-id-vectors))
                (if (sh07-b51-internal-reference-vector-increasing?
                     (get layout :publication-event-ids))
                  (if (sh07-b51-vector-of-increasing-reference-vectors?
                       (get layout :projection-id-vectors))
                    (if (sh07-b51-vector-of-increasing-reference-vectors?
                         (get layout :product-node-id-vectors))
                      (loop [remaining
                             [:first-global-slot-ordinal
                              :first-global-extraction-ordinal
                              :first-global-runtime-check-ordinal
                              :first-global-publication-ordinal]]
                        (if (= (count remaining) 0)
                          true
                          (if (sh07-b51-nonnegative-integer?
                               (get layout (first remaining)))
                            (recur (rest remaining))
                            false)))
                      false)
                    false)
                  false)
                false)
              false)
            false)
          false)
        false)
      false)
    false))

(defn sh07-b51-projections-match-products?
  [projection-ids product-ids vector-count]
  (loop [remaining projection-ids product-index (+ vector-count 1)]
    (if (= (count remaining) 0)
      true
      (if (= (first remaining) (get product-ids product-index))
        (recur (rest remaining) (+ product-index 1))
        false))))

(defn sh07-b51-reference-layout-aligns? [layout slots]
  (let [slot-count (count slots)]
    (if (sh07-b51-reference-layout-shape? layout)
      (if (= (count (get layout :initializer-core-node-ids)) slot-count)
        (if (= (count (get layout :slot-ids)) slot-count)
          (if (= (count (get layout :extraction-id-vectors)) slot-count)
            (if (= (count (get layout :runtime-check-id-vectors)) slot-count)
              (if (= (count (get layout :publication-event-ids)) slot-count)
                (if (= (count (get layout :projection-id-vectors)) slot-count)
                  (if (= (count (get layout :product-node-id-vectors))
                         slot-count)
                    (loop [remaining slots index 0]
                      (if (= (count remaining) 0)
                        (if (sh07-b51-all-unique?
                             (get layout :initializer-core-node-ids))
                          (if (sh07-b51-all-unique? (get layout :slot-ids))
                            (if (sh07-b51-all-unique?
                                 (sh07-b51-flatten-reference-vectors
                                  (get layout :extraction-id-vectors)))
                              (if (sh07-b51-all-unique?
                                   (sh07-b51-flatten-reference-vectors
                                    (get layout :runtime-check-id-vectors)))
                                (if (sh07-b51-all-unique?
                                     (get layout :publication-event-ids))
                                  (if (sh07-b51-all-unique?
                                       (sh07-b51-flatten-reference-vectors
                                        (get layout :projection-id-vectors)))
                                    (sh07-b51-all-unique?
                                     (sh07-b51-flatten-reference-vectors
                                      (get layout :product-node-id-vectors)))
                                    false)
                                  false)
                                false)
                              false)
                            false)
                          false)
                        (let [pattern (get (first remaining) :pattern)
                              vector-count (get pattern :vector-node-count)
                              terminal-count (get pattern :terminal-count)
                              product-count (+ 2 vector-count terminal-count)]
                          (if (= (count (get (get layout
                                                  :extraction-id-vectors)
                                             index))
                                 (get pattern :extraction-count))
                            (if (= (count (get (get layout
                                                    :runtime-check-id-vectors)
                                               index))
                                   vector-count)
                              (if (= (count (get (get layout
                                                      :projection-id-vectors)
                                                 index))
                                     terminal-count)
                                (if (= (count (get (get layout
                                                        :product-node-id-vectors)
                                                   index))
                                       product-count)
                                  (if (sh07-b51-projections-match-products?
                                       (get (get layout
                                                 :projection-id-vectors)
                                            index)
                                       (get (get layout
                                                 :product-node-id-vectors)
                                            index)
                                       vector-count)
                                    (recur (rest remaining) (+ index 1))
                                    false)
                                  false)
                                false)
                              false)
                            false))))
                    false)
                  false)
                false)
              false)
            false)
          false)
        false)
      false)))

(defn sh07-b51-binding-slot-preimage-for-let
  [slot evaluation layout slot-index]
  (let [owner (get slot :owner-coordinate)
        coordinate (get slot :slot-coordinate)
        pattern-form (get slot :pattern-form)
        initializer (get slot :initializer-form)
        preimage
        {:domain :gravity/sh07-b51-binding-slot-id-preimage-v18
         :schema-version 18
         :predecessor-authority-id
         (get layout :predecessor-authority-id)
         :global-slot-ordinal
         (+ (get layout :first-global-slot-ordinal) slot-index)
         :owner-kind :let
         :owner-form-id (get owner :enclosing-form-id)
         :owner-syntax-id (get owner :enclosing-syntax-id)
         :owner-core-node-id (get layout :owner-core-node-id)
         :owner-coordinate owner
         :owning-definition-form-id
         (get owner :owning-definition-form-id)
         :owning-definition-syntax-id
         (get owner :owning-definition-syntax-id)
         :slot-coordinate coordinate
         :slot-ordinal slot-index
         :pattern-form-id (get pattern-form :form-id)
         :pattern-syntax-id (get pattern-form :syntax-id)
         :pattern-scope-id (get pattern-form :scope-id)
         :initializer-form-id (get initializer :form-id)
         :initializer-syntax-id (get initializer :syntax-id)
         :initializer-scope-id (get initializer :scope-id)
         :initializer-core-node-id
         (get (get layout :initializer-core-node-ids) slot-index)
         :source-origin-chain (get pattern-form :origin-chain)
         :source-generated-origin (get pattern-form :generated-origin)}
        built (sh07-b51-build-binding-slot-preimage preimage)]
    (if (= (get built :status) :accepted)
      {:status :accepted :preimage (get built :preimage)}
      built)))

(defn sh07-b51-binding-extraction-preimages-for-let
  [indexes slot layout slot-index first-global-extraction]
  (let [owner (get slot :owner-coordinate)
        coordinate (get slot :slot-coordinate)
        pattern-form (get slot :pattern-form)
        initializer (get slot :initializer-form)
        fragment (get slot :fragment)
        descriptors (get (get slot :pattern) :descriptors)
        extraction-ids (get (get layout :extraction-id-vectors) slot-index)
        slot-id (get (get layout :slot-ids) slot-index)]
    (loop [remaining descriptors
           remaining-ids extraction-ids
           local-ordinal 0
           result []]
      (if (= (count remaining) 0)
        {:status :accepted :preimages result}
        (let [descriptor (first remaining)
              form (sh07-b51-find-form indexes (get descriptor :form-id))
              preimage
              {:domain
               :gravity/sh07-b51-binding-extraction-id-preimage-v18
               :schema-version 18
               :predecessor-authority-id
               (get layout :predecessor-authority-id)
               :slot-id slot-id
               :slot-coordinate coordinate
               :global-ordinal (+ first-global-extraction local-ordinal)
               :global-slot-ordinal
               (+ (get layout :first-global-slot-ordinal) slot-index)
               :slot-ordinal slot-index
               :pattern-node-ordinal
               (get descriptor :pattern-node-ordinal)
               :parent-pattern-node-ordinal
               (get descriptor :parent-pattern-node-ordinal)
               :terminal-ordinal (get descriptor :terminal-ordinal)
               :leaf-ordinal (get descriptor :leaf-ordinal)
               :kind (get descriptor :kind)
               :path (get descriptor :path)
               :form-id (get descriptor :form-id)
               :syntax-id (get descriptor :syntax-id)
               :scope-id (get descriptor :scope-id)
               :enclosing-form-id (get owner :enclosing-form-id)
               :enclosing-syntax-id (get owner :enclosing-syntax-id)
               :pattern-form-id (get pattern-form :form-id)
               :pattern-syntax-id (get pattern-form :syntax-id)
               :initializer-form-id (get initializer :form-id)
               :initializer-syntax-id (get initializer :syntax-id)
               :expected-width (get descriptor :expected-width)
               :binding-id (get descriptor :binding-id)
               :binding-name (get descriptor :binding-name)
               :definition-form-id (get descriptor :definition-form-id)
               :definition-syntax-id
               (get descriptor :definition-syntax-id)
               :binding-scope-id (get descriptor :binding-scope-id)
               :fragment-id (get fragment :fragment-id)
               :fragment-ordinal (get fragment :ordinal)
               :owning-root-form-id (get owner :root-form-id)
               :owning-root-syntax-id (get owner :root-syntax-id)
               :owning-definition-form-id
               (get owner :owning-definition-form-id)
               :owning-definition-syntax-id
               (get owner :owning-definition-syntax-id)
               :owner-coordinate owner
               :defn-input-syntax-id (get owner :defn-input-syntax-id)
               :fn-form-id (get owner :fn-form-id)
               :fn-syntax-id (get owner :fn-syntax-id)
               :source-origin-chain (get form :origin-chain)
               :source-generated-origin (get form :generated-origin)}
              built
              (sh07-b51-build-binding-extraction-preimage preimage)]
          (if (= (get built :status) :accepted)
            (recur
             (rest remaining) (rest remaining-ids) (+ local-ordinal 1)
             (conj result (get built :preimage)))
            built))))))

(defn sh07-b51-runtime-check-preimages-for-let
  [indexes slot layout slot-index first-global-check]
  (let [owner (get slot :owner-coordinate)
        coordinate (get slot :slot-coordinate)
        descriptors (get (get slot :pattern) :descriptors)
        check-ids (get (get layout :runtime-check-id-vectors) slot-index)
        extraction-ids (get (get layout :extraction-id-vectors) slot-index)
        slot-id (get (get layout :slot-ids) slot-index)
        publication-ordinal
        (+ (get layout :first-global-publication-ordinal) slot-index)]
    (loop [remaining descriptors
           descriptor-index 0
           check-index 0
           result []]
      (if (= (count remaining) 0)
        {:status :accepted :preimages result}
        (let [descriptor (first remaining)]
          (if (= (get descriptor :kind) :vector-node)
            (let [form
                  (sh07-b51-find-form indexes (get descriptor :form-id))
                  preimage
                  {:domain :gravity/sh07-b51-runtime-check-id-preimage-v18
                   :schema-version 18
                   :global-runtime-check-ordinal
                   (+ first-global-check check-index)
                   :predecessor-authority-id
                   (get layout :predecessor-authority-id)
                   :fragment-id (get owner :fragment-id)
                   :fragment-ordinal (get owner :fragment-ordinal)
                   :root-form-id (get owner :root-form-id)
                   :root-syntax-id (get owner :root-syntax-id)
                   :owner-kind :let
                   :owner-form-id (get owner :enclosing-form-id)
                   :owner-syntax-id (get owner :enclosing-syntax-id)
                   :owner-coordinate owner
                   :slot-coordinate coordinate
                   :site-kind :init
                   :recur-coordinate nil
                   :slot-id slot-id
                   :extraction-id (get extraction-ids descriptor-index)
                   :path (get descriptor :path)
                   :check-kind :exact-vector-shape
                   :expected-kind :vector
                   :expected-width (get descriptor :expected-width)
                   :check-order check-index
                   :guarded-publication-ordinal publication-ordinal
                   :guarded-event-kind :slot-atomic-publication
                   :failure-rule "L7-PATTERN-TYPE"
                   :reasons [:vector-required :vector-width-mismatch]
                   :guard-policy :publish-after-all-checks
                   :fail-closed true
                   :source-origin-chain (get form :origin-chain)
                   :source-generated-origin (get form :generated-origin)}
                  built (sh07-b51-build-runtime-check-preimage preimage)]
              (if (= (get built :status) :accepted)
                (recur
                 (rest remaining) (+ descriptor-index 1)
                 (+ check-index 1) (conj result (get built :preimage)))
                built))
            (recur
             (rest remaining) (+ descriptor-index 1) check-index result)))))))

(defn sh07-b51-terminal-projection-plan
  [slot layout slot-index]
  (loop [remaining (get (get slot :pattern) :descriptors)
         remaining-ids (get (get layout :projection-id-vectors) slot-index)
         result []]
    (if (= (count remaining) 0)
      {:status :accepted :projections result}
      (let [descriptor (first remaining)]
        (if (contains? #{:binding-leaf :wildcard-leaf}
                       (get descriptor :kind))
          (recur
           (rest remaining) (rest remaining-ids)
           (conj
            result
            {:projection-id (first remaining-ids)
             :terminal-ordinal (get descriptor :terminal-ordinal)
             :leaf-ordinal (get descriptor :leaf-ordinal)
             :kind (get descriptor :kind)
             :path (get descriptor :path)
             :binding-ids
             (if (= (get descriptor :kind) :binding-leaf)
               [(get descriptor :binding-id)]
               [])
             :from-initializer-evaluation true
             :reevaluate-initializer false}))
          (recur (rest remaining) remaining-ids result))))))

(defn sh07-b51-publication-preimage-for-let
  [slot evaluation layout slot-index projections]
  (let [owner (get slot :owner-coordinate)
        coordinate (get slot :slot-coordinate)
        pattern-form (get slot :pattern-form)
        introduced (get (get slot :pattern) :introduced-binding-ids)
        projection-ids (get (get layout :projection-id-vectors) slot-index)
        check-ids (get (get layout :runtime-check-id-vectors) slot-index)
        product-ids (get (get layout :product-node-id-vectors) slot-index)
        visible-before (get evaluation :visible-prior-binding-ids)
        visible-after
        (sh07-b51-vector-append visible-before introduced)
        slot-id (get (get layout :slot-ids) slot-index)
        preimage
        {:domain
         :gravity/sh07-b51-publication-event-id-preimage-v18
         :schema-version 18
         :global-publication-ordinal
         (+ (get layout :first-global-publication-ordinal) slot-index)
         :predecessor-authority-id
         (get layout :predecessor-authority-id)
         :fragment-id (get owner :fragment-id)
         :fragment-ordinal (get owner :fragment-ordinal)
         :root-form-id (get owner :root-form-id)
         :root-syntax-id (get owner :root-syntax-id)
         :owner-kind :let
         :owner-form-id (get owner :enclosing-form-id)
         :owner-syntax-id (get owner :enclosing-syntax-id)
         :owner-coordinate owner
         :slot-coordinate coordinate
         :slot-coordinates [coordinate]
         :recur-coordinate nil
         :slot-id slot-id
         :slot-ids [slot-id]
         :event-kind :slot-atomic-publication
         :introduced-binding-ids introduced
         :introduced-binding-id-vectors [introduced]
         :projection-ids projection-ids
         :projection-id-vectors [projection-ids]
         :required-check-ids check-ids
         :required-check-id-vectors [check-ids]
         :product-node-ids product-ids
         :product-node-id-vectors [product-ids]
         :visible-before-binding-ids visible-before
         :visible-before-binding-id-vectors [visible-before]
         :visible-after-binding-ids visible-after
         :visible-after-binding-id-vectors [visible-after]
         :commit-order
         (+ (get layout :first-global-publication-ordinal) slot-index)
         :all-or-none true
         :publish-none
         (if (= introduced []) (= projection-ids []) false)
         :source-origin-chain (get pattern-form :origin-chain)
         :source-generated-origin (get pattern-form :generated-origin)}
        built (sh07-b51-build-publication-event-preimage preimage)]
    (if (= (get built :status) :accepted)
      {:status :accepted :preimage (get built :preimage)}
      built)))

(defn sh07-b51-let-slot-foundation
  [indexes slot evaluation layout slot-index extraction-cursor check-cursor]
  (let [slot-preimage
        (sh07-b51-binding-slot-preimage-for-let
         slot evaluation layout slot-index)
        extractions
        (sh07-b51-binding-extraction-preimages-for-let
         indexes slot layout slot-index extraction-cursor)
        checks
        (sh07-b51-runtime-check-preimages-for-let
         indexes slot layout slot-index check-cursor)
        projections
        (sh07-b51-terminal-projection-plan slot layout slot-index)]
    (if (= (get slot-preimage :status) :accepted)
      (if (= (get extractions :status) :accepted)
        (if (= (get checks :status) :accepted)
          (if (= (get projections :status) :accepted)
            (let [publication
                  (sh07-b51-publication-preimage-for-let
                   slot evaluation layout slot-index
                   (get projections :projections))]
              (if (= (get publication :status) :accepted)
                (let [pattern (get slot :pattern)
                      policy
                      (if (= (get pattern :pattern-kind)
                             :legacy-simple-symbol)
                        :legacy-direct-binding-no-check
                        :exact-width-runtime-checked)]
                  {:status :accepted
                   :slot-plan
                   {:slot-ordinal slot-index
                    :slot-id (get (get layout :slot-ids) slot-index)
                    :extraction-ids
                    (get (get layout :extraction-id-vectors) slot-index)
                    :runtime-check-ids
                    (get (get layout :runtime-check-id-vectors) slot-index)
                    :publication-event-id
                    (get (get layout :publication-event-ids) slot-index)
                    :projection-ids
                    (get (get layout :projection-id-vectors) slot-index)
                    :product-node-ids
                    (get (get layout :product-node-id-vectors) slot-index)
                    :slot-coordinate (get slot :slot-coordinate)
                    :binding-slot-preimage (get slot-preimage :preimage)
                    :binding-extraction-preimages
                    (get extractions :preimages)
                    :runtime-check-preimages (get checks :preimages)
                    :terminal-projections
                    (get projections :projections)
                    :publication-event-preimage
                    (get publication :preimage)
                    :initializer-evaluation evaluation
                    :runtime-policy policy
                    :initializer-evaluated-once true
                    :checks-before-projections true
                    :publish-after-all-checks true
                    :all-or-none true
                    :publish-no-partial-bindings true
                    :legacy-byte-parity-path
                    (if (= policy :legacy-direct-binding-no-check)
                      :b47-simple-symbol-slot
                      nil)
                    :empty-vector-width-zero
                    (if (= (get pattern :pattern-kind) :vector-pattern)
                      (if (= (get pattern :terminal-count) 0)
                        (= (get (first (get pattern :descriptors))
                                :expected-width)
                           0)
                        false)
                      false)}
                   :next-extraction-cursor
                   (+ extraction-cursor (get pattern :extraction-count))
                   :next-check-cursor
                   (+ check-cursor (get pattern :vector-node-count))})
                publication))
            projections)
          checks)
        extractions)
      slot-preimage)))

(defn sh07-b51-let-slot-foundation-semantics? [slot-plan]
  (let [slot-preimage (get slot-plan :binding-slot-preimage)
        extractions (get slot-plan :binding-extraction-preimages)
        checks (get slot-plan :runtime-check-preimages)
        projections (get slot-plan :terminal-projections)
        publication (get slot-plan :publication-event-preimage)
        policy (get slot-plan :runtime-policy)]
    (if (= policy :legacy-direct-binding-no-check)
      (if (= (count extractions) 1)
        (let [extraction (first extractions)]
          (if (= (get extraction :kind) :binding-leaf)
            (if (= (get extraction :pattern-node-ordinal) 0)
              (if (= (get extraction :parent-pattern-node-ordinal) nil)
                (if (= (get extraction :terminal-ordinal) 0)
                  (if (= (get extraction :leaf-ordinal) 0)
                    (if (= (get extraction :path) [])
                      (if (= checks [])
                        (if (= (count projections) 1)
                          (if (= (get publication :event-kind)
                                 :slot-atomic-publication)
                            (if (= (get slot-plan :legacy-byte-parity-path)
                                   :b47-simple-symbol-slot)
                              (= (get slot-preimage :slot-ordinal)
                                 (get slot-plan :slot-ordinal))
                              false)
                            false)
                          false)
                        false)
                      false)
                    false)
                  false)
                false)
              false)
            false))
        false)
      (if (= policy :exact-width-runtime-checked)
        (let [vector-count
              (loop [remaining extractions result 0]
                (if (= (count remaining) 0)
                  result
                  (recur
                   (rest remaining)
                   (if (= (get (first remaining) :kind) :vector-node)
                     (+ result 1) result))))]
          (if (= (count checks) vector-count)
            (if (= (get publication :guard-policy) nil)
              (if (= (get publication :all-or-none) true)
                (if (= (get slot-plan :legacy-byte-parity-path) nil)
                  true
                  false)
                false)
              false)
            false))
        false))))

(defn sh07-b51-let-slot-event-sequence [slot-plans]
  (loop [remaining slot-plans result []]
    (if (= (count remaining) 0)
      result
      (let [slot (first remaining)
            slot-ordinal (get slot :slot-ordinal)
            after-initializer
            (conj result
                  {:slot-ordinal slot-ordinal
                   :event-kind :initializer-evaluation
                   :evaluation-count 1
                   :initializer-core-node-id
                   (get (get slot :initializer-evaluation)
                        :initializer-core-node-id)})
            after-checks
            (loop [checks (get slot :runtime-check-preimages)
                   values after-initializer]
              (if (= (count checks) 0)
                values
                (recur
                 (rest checks)
                 (conj values
                       {:slot-ordinal slot-ordinal
                        :event-kind :vector-check
                        :path (get (first checks) :path)
                        :check-order (get (first checks) :check-order)
                        :expected-width
                        (get (first checks) :expected-width)}))))
            after-projections
            (loop [projections (get slot :terminal-projections)
                   values after-checks]
              (if (= (count projections) 0)
                values
                (recur
                 (rest projections)
                 (conj values
                       {:slot-ordinal slot-ordinal
                        :event-kind :terminal-projection
                        :path (get (first projections) :path)
                        :terminal-ordinal
                        (get (first projections) :terminal-ordinal)
                        :reevaluate-initializer false}))))]
        (recur
         (rest remaining)
         (conj after-projections
               {:slot-ordinal slot-ordinal
                :event-kind :slot-atomic-publication
                :all-or-none true
                :publication-ordinal
                (get (get slot :publication-event-preimage)
                     :global-publication-ordinal)}))))))

(defn sh07-b51-flatten-slot-plan-field [slot-plans field]
  (loop [remaining slot-plans result []]
    (if (= (count remaining) 0)
      result
      (recur
       (rest remaining)
       (sh07-b51-vector-append result (get (first remaining) field))))))

(defn sh07-b51-build-let-slot-foundations
  [indexes slots evaluations layout]
  (loop [remaining-slots slots
         remaining-evaluations evaluations
         slot-index 0
         extraction-cursor (get layout :first-global-extraction-ordinal)
         check-cursor (get layout :first-global-runtime-check-ordinal)
         slot-plans []]
    (if (= (count remaining-slots) 0)
      {:status :accepted :slot-plans slot-plans}
      (let [built
            (sh07-b51-let-slot-foundation
             indexes (first remaining-slots) (first remaining-evaluations)
             layout slot-index extraction-cursor check-cursor)]
        (if (= (get built :status) :accepted)
          (if (sh07-b51-let-slot-foundation-semantics?
               (get built :slot-plan))
            (recur
             (rest remaining-slots) (rest remaining-evaluations)
             (+ slot-index 1)
             (get built :next-extraction-cursor)
             (get built :next-check-cursor)
             (conj slot-plans (get built :slot-plan)))
            {:status :rejected :reason :let-slot-semantic-shape
             :partial-products []})
          built)))))

(defn sh07-b51-lower-let-slots-foundation
  [request enclosing reference-layout]
  (let [indexes (sh07-b51-index-request request)]
    (if (sh07-b51-indexes-unique? indexes)
      (let [skeleton
            (sh07-b51-let-owner-skeleton request indexes enclosing)]
        (if (= (get skeleton :status) :accepted)
          (let [slot-result
                (sh07-b51-let-slot-patterns request indexes skeleton)
                body-result
                (sh07-b51-validate-let-body request indexes skeleton)]
            (if (= (get slot-result :status) :accepted)
              (if (= (get body-result :status) :accepted)
                (let [slots (get slot-result :slots)
                      preflight-slots
                      (loop [remaining slots result []]
                        (if (= (count remaining) 0)
                          result
                          (let [slot (first remaining)]
                            (recur
                             (rest remaining)
                             (conj result
                                   {:owner-coordinate
                                    (get slot :owner-coordinate)
                                    :fragment (get slot :fragment)
                                    :pattern (get slot :pattern)})))))
                      preflight
                      (sh07-b51-module-resource-preflight preflight-slots)]
                  (if (= (get preflight :status) :accepted)
                    (if (sh07-b51-reference-layout-aligns?
                         reference-layout slots)
                      (let [evaluation-result
                            (sh07-b51-let-initializer-evaluations
                             request indexes slots
                             (get reference-layout
                                  :initializer-core-node-ids))]
                        (if (= (get evaluation-result :status) :accepted)
                          (let [built
                                (sh07-b51-build-let-slot-foundations
                                 indexes slots
                                 (get evaluation-result :evaluations)
                                 reference-layout)]
                            (if (= (get built :status) :accepted)
                              (let [slot-plans (get built :slot-plans)]
                                {:status :accepted
                                 :owner-kind :let
                                 :owner-branch
                                 (get skeleton :owner-branch)
                                 :owner-coordinate
                                 (get skeleton :owner-coordinate)
                                 :fragment (get skeleton :fragment)
                                 :binding-vector-form-id
                                 (get (get skeleton :binding-vector) :form-id)
                                 :binding-vector-syntax-id
                                 (get (get skeleton :binding-vector)
                                      :syntax-id)
                                 :body-form-ids
                                 (loop [remaining
                                        (get body-result :body-forms)
                                        result []]
                                   (if (= (count remaining) 0)
                                     result
                                     (recur
                                      (rest remaining)
                                      (conj result
                                            (get (first remaining)
                                                 :form-id)))))
                                 :slot-count (count slot-plans)
                                 :slot-plans slot-plans
                                 :binding-slot-preimages
                                 (loop [remaining slot-plans result []]
                                   (if (= (count remaining) 0)
                                     result
                                     (recur
                                      (rest remaining)
                                      (conj result
                                            (get (first remaining)
                                                 :binding-slot-preimage)))))
                                 :binding-extraction-preimages
                                 (sh07-b51-flatten-slot-plan-field
                                  slot-plans
                                  :binding-extraction-preimages)
                                 :runtime-check-preimages
                                 (sh07-b51-flatten-slot-plan-field
                                  slot-plans :runtime-check-preimages)
                                 :publication-event-preimages
                                 (loop [remaining slot-plans result []]
                                   (if (= (count remaining) 0)
                                     result
                                     (recur
                                      (rest remaining)
                                      (conj result
                                            (get (first remaining)
                                                 :publication-event-preimage)))))
                                 :initializer-evaluations
                                 (get evaluation-result :evaluations)
                                 :event-sequence
                                 (sh07-b51-let-slot-event-sequence slot-plans)
                                 :resource-preflight preflight
                                 :evaluation-policy
                                 :initializers-once-prior-scope-left-to-right
                                 :projection-policy
                                 :preorder-without-initializer-reevaluation
                                 :publication-policy
                                 :per-slot-simultaneous-after-all-checks
                                 :failure-policy
                                 {:publish-current-slot false
                                  :evaluate-later-initializers false
                                  :evaluate-body false
                                  :rule "L7-PATTERN-TYPE"}
                                 :preserved-declarations
                                 {:effects
                                  (get (get request :module) :effects)
                                  :capabilities
                                  (get (get request :module) :capabilities)
                                  :safety
                                  (get (get request :module) :safety)}
                                 :pending-fact-families
                                 [:types :effects :ownership :safety]
                                 :calls-b47-lowerer false
                                 :partial-products []})
                              built))
                          evaluation-result))
                      {:status :rejected
                       :reason :reference-layout-misaligned
                       :partial-products []})
                    preflight))
                body-result)
              slot-result))
          skeleton))
      {:status :rejected :reason :request-index-duplicate
       :partial-products []})))

(defn sh07-b51-loopize-runtime-check-preimages [preimages]
  (loop [remaining preimages result []]
    (if (= (count remaining) 0)
      {:status :accepted :preimages result}
      (let [preimage (assoc (first remaining) :owner-kind :loop)
            built (sh07-b51-build-runtime-check-preimage preimage)]
        (if (= (get built :status) :accepted)
          (recur (rest remaining) (conj result (get built :preimage)))
          built)))))

(defn sh07-b51-loopize-slot-plan [slot-plan]
  (let [slot-preimage
        (sh07-b51-build-binding-slot-preimage
         (assoc (get slot-plan :binding-slot-preimage) :owner-kind :loop))
        checks
        (sh07-b51-loopize-runtime-check-preimages
         (get slot-plan :runtime-check-preimages))
        publication
        (sh07-b51-build-publication-event-preimage
         (assoc (get slot-plan :publication-event-preimage)
                :owner-kind :loop))]
    (if (= (get slot-preimage :status) :accepted)
      (if (= (get checks :status) :accepted)
        (if (= (get publication :status) :accepted)
          {:status :accepted
           :slot-plan
           (assoc
            (assoc
             (assoc slot-plan
                    :binding-slot-preimage (get slot-preimage :preimage))
             :runtime-check-preimages (get checks :preimages))
            :publication-event-preimage (get publication :preimage))}
          publication)
        checks)
      slot-preimage)))

(defn sh07-b51-loopize-slot-plans [slot-plans]
  (loop [remaining slot-plans result []]
    (if (= (count remaining) 0)
      {:status :accepted :slot-plans result}
      (let [built (sh07-b51-loopize-slot-plan (first remaining))]
        (if (= (get built :status) :accepted)
          (recur (rest remaining) (conj result (get built :slot-plan)))
          built)))))

(defn sh07-b51-lower-loop-slots-foundation
  [request enclosing reference-layout]
  (let [indexes (sh07-b51-index-request request)]
    (if (sh07-b51-indexes-unique? indexes)
      (let [skeleton
            (sh07-b51-loop-owner-skeleton request indexes enclosing)]
        (if (= (get skeleton :status) :accepted)
          (let [slot-result
                (sh07-b51-let-slot-patterns request indexes skeleton)
                body-result
                (sh07-b51-validate-let-body request indexes skeleton)]
            (if (= (get slot-result :status) :accepted)
              (if (= (get body-result :status) :accepted)
                (let [slots (get slot-result :slots)
                      preflight-input
                      (loop [remaining slots result []]
                        (if (= (count remaining) 0)
                          result
                          (recur
                           (rest remaining)
                           (conj result
                                 {:owner-coordinate
                                  (get (first remaining) :owner-coordinate)
                                  :fragment (get (first remaining) :fragment)
                                  :pattern
                                  (get (first remaining) :pattern)}))))
                      preflight
                      (sh07-b51-module-resource-preflight preflight-input)]
                  (if (= (get preflight :status) :accepted)
                    (if (sh07-b51-reference-layout-aligns?
                         reference-layout slots)
                      (let [evaluations
                            (sh07-b51-let-initializer-evaluations
                             request indexes slots
                             (get reference-layout
                                  :initializer-core-node-ids))]
                        (if (= (get evaluations :status) :accepted)
                          (let [built-let
                                (sh07-b51-build-let-slot-foundations
                                 indexes slots (get evaluations :evaluations)
                                 reference-layout)]
                            (if (= (get built-let :status) :accepted)
                              (let [loopized
                                    (sh07-b51-loopize-slot-plans
                                     (get built-let :slot-plans))]
                                (if (= (get loopized :status) :accepted)
                                  (let [slot-plans
                                        (get loopized :slot-plans)]
                                    {:status :accepted
                                     :owner-kind :loop
                                     :owner-branch
                                     (get skeleton :owner-branch)
                                     :owner-coordinate
                                     (get skeleton :owner-coordinate)
                                     :owner-core-node-id
                                     (get reference-layout
                                          :owner-core-node-id)
                                     :fragment (get skeleton :fragment)
                                     :enclosing-form enclosing
                                     :binding-vector-form-id
                                     (get (get skeleton :binding-vector)
                                          :form-id)
                                     :binding-vector-syntax-id
                                     (get (get skeleton :binding-vector)
                                          :syntax-id)
                                     :body-forms (get body-result :body-forms)
                                     :slot-count (count slot-plans)
                                     :slot-plans slot-plans
                                     :initializer-evaluations
                                     (get evaluations :evaluations)
                                     :event-sequence
                                     (sh07-b51-let-slot-event-sequence
                                      slot-plans)
                                     :resource-preflight preflight
                                     :evaluation-policy
                                     :initializers-once-prior-scope-left-to-right
                                     :publication-policy
                                     :per-slot-simultaneous-after-all-checks
                                     :recur-policy
                                     :slot-arity-simultaneous-transfer
                                     :preserved-declarations
                                     {:effects
                                      (get (get request :module) :effects)
                                      :capabilities
                                      (get (get request :module)
                                           :capabilities)
                                      :safety
                                      (get (get request :module) :safety)}
                                     :pending-fact-families
                                     [:types :effects :ownership :safety]
                                     :calls-b47-lowerer false
                                     :partial-products []})
                                  loopized))
                              built-let))
                          evaluations))
                      {:status :rejected
                       :reason :reference-layout-misaligned
                       :partial-products []})
                    preflight))
                body-result)
              slot-result))
          skeleton))
      {:status :rejected :reason :request-index-duplicate
       :partial-products []})))

(defn sh07-b51-tail-parent-allows?
  [indexes parent child-id loop-form-id]
  (let [children (get parent :child-form-ids)
        position (sh07-b51-index-of children child-id)
        index (get position :index)
        last-index (- (count children) 1)]
    (if (= (get position :count) 1)
      (if (= (get parent :form-id) loop-form-id)
        (= index last-index)
        (if (sh07-b51-authenticated-list-operator? indexes parent 'if)
          (if (contains? #{3 4} (count children))
            (if (= index 2)
              true
              (if (= (count children) 4)
                (= index 3)
                false))
            false)
          (if (sh07-b51-authenticated-list-operator? indexes parent 'do)
            (= index last-index)
            (if (sh07-b51-authenticated-list-operator? indexes parent 'match)
              (loop [branch-index 3]
                (if (> branch-index last-index)
                  false
                  (if (= index branch-index)
                    true
                    (recur (+ branch-index 2)))))
              (if (sh07-b51-authenticated-list-operator? indexes parent 'let)
                (= index last-index)
                false)))))
      false)))

(defn sh07-b51-loop-recur-tail-authenticated?
  [request indexes fragment recur-form loop-form]
  (loop [current recur-form depth 0 visited #{}]
    (if (> depth 256)
      false
      (let [current-id (get current :form-id)
            parent-id (get current :parent-form-id)]
        (if (contains? visited current-id)
          false
          (if (= parent-id nil)
            false
            (let [parent (sh07-b51-find-form indexes parent-id)
                  membership
                  (if (map? parent)
                    (sh07-b51-index-of
                     (get fragment :form-ids) (get parent :form-id))
                    {:count 0})
                  direct
                  (if (map? parent)
                    (sh07-b51-authenticated-direct-child
                     request indexes parent current-id)
                    {:status :rejected})]
              (if (map? parent)
                (if (= (get membership :count) 1)
                  (if (= (get direct :status) :accepted)
                    (if (sh07-b51-tail-parent-allows?
                         indexes parent current-id (get loop-form :form-id))
                      (if (= (get parent :form-id) (get loop-form :form-id))
                        true
                        (if (sh07-b51-authenticated-list-operator?
                             indexes parent 'loop)
                          false
                          (if (sh07-b51-authenticated-list-operator?
                               indexes parent 'fn)
                            false
                            (recur
                             parent (+ depth 1) (conj visited current-id)))))
                      false)
                    false)
                  false)
                false))))))))

(defn sh07-b51-authenticated-loop-recur
  [request indexes loop-foundation recur-form recur-core-node-id]
  (let [canonical
        (sh07-b51-find-form indexes (get recur-form :form-id))
        fragment (get loop-foundation :fragment)
        loop-form (get loop-foundation :enclosing-form)
        child-ids (get recur-form :child-form-ids)
        membership
        (sh07-b51-index-of
         (get fragment :form-ids) (get recur-form :form-id))]
    (if (= recur-form canonical)
      (if (= (get membership :count) 1)
        (if (sh07-b51-authenticated-list-operator? indexes recur-form 'recur)
          (if (sh07-b51-all-unique? child-ids)
            (if (= (- (count child-ids) 1)
                   (get loop-foundation :slot-count))
              (if (sh07-b51-loop-recur-tail-authenticated?
                   request indexes fragment recur-form loop-form)
                (if (sh07-b51-internal-reference? recur-core-node-id)
                  (loop [index 1 arguments []]
                    (if (= index (count child-ids))
                      {:status :accepted
                       :recur-coordinate
                       {:recur-form-id (get recur-form :form-id)
                        :recur-syntax-id (get recur-form :syntax-id)
                        :recur-core-node-id recur-core-node-id}
                       :argument-forms arguments}
                      (let [argument
                            (sh07-b51-authenticated-direct-child
                             request indexes recur-form (get child-ids index))]
                        (if (= (get argument :status) :accepted)
                          (recur
                           (+ index 1)
                           (conj arguments (get argument :form)))
                          argument))))
                  {:status :rejected :reason :recur-core-reference
                   :partial-products []})
                {:status :rejected :reason :recur-not-tail
                 :offending-form recur-form
                 :owner-coordinate (get loop-foundation :owner-coordinate)
                 :target-form-id (get loop-form :form-id)
                 :partial-products []})
              {:status :rejected :reason :recur-arity-mismatch
               :expected (get loop-foundation :slot-count)
               :observed (- (count child-ids) 1)
               :offending-form recur-form
               :owner-coordinate (get loop-foundation :owner-coordinate)
               :target-form-id (get loop-form :form-id)
               :partial-products []})
            {:status :rejected :reason :recur-child-duplicate
             :partial-products []})
          {:status :rejected :reason :recur-operator-unauthenticated
           :partial-products []})
        {:status :rejected :reason :recur-cross-fragment
         :partial-products []})
      {:status :rejected :reason :recur-form-substitution
       :partial-products []})))

(defn sh07-b51-loop-recur-reference-layout-shape? [layout]
  (if (sh07-b51-exact-keys?
       layout
       #{:predecessor-authority-id :recur-core-node-id
         :argument-node-ids :runtime-check-id-vectors
         :projection-id-vectors :product-node-id-vectors
         :argument-product-node-ids :commit-product-node-id
         :publication-event-id :recur-slot-mapping-id
         :first-global-runtime-check-ordinal
         :global-publication-ordinal :global-recur-mapping-ordinal})
    (if (sh07-b51-internal-reference?
         (get layout :predecessor-authority-id))
      (if (sh07-b51-internal-reference? (get layout :recur-core-node-id))
        (if (sh07-b51-internal-reference-vector-increasing?
             (get layout :argument-node-ids))
          (if (sh07-b51-vector-of-increasing-reference-vectors?
               (get layout :runtime-check-id-vectors))
            (if (sh07-b51-vector-of-increasing-reference-vectors?
                 (get layout :projection-id-vectors))
              (if (sh07-b51-vector-of-increasing-reference-vectors?
                   (get layout :product-node-id-vectors))
                (if (sh07-b51-internal-reference-vector-increasing?
                     (get layout :argument-product-node-ids))
                  (if (sh07-b51-internal-reference?
                       (get layout :commit-product-node-id))
                    (if (sh07-b51-internal-reference?
                         (get layout :publication-event-id))
                      (if (sh07-b51-internal-reference?
                           (get layout :recur-slot-mapping-id))
                        (loop [remaining
                               [:first-global-runtime-check-ordinal
                                :global-publication-ordinal
                                :global-recur-mapping-ordinal]]
                          (if (= (count remaining) 0)
                            true
                            (if (sh07-b51-nonnegative-integer?
                                 (get layout (first remaining)))
                              (recur (rest remaining))
                              false)))
                        false)
                      false)
                    false)
                  false)
                false)
              false)
            false)
          false)
        false)
      false)
    false))

(defn sh07-b51-loop-recur-reference-layout-aligns?
  [layout slot-plans]
  (let [slot-count (count slot-plans)]
    (if (sh07-b51-loop-recur-reference-layout-shape? layout)
      (if (= (count (get layout :argument-node-ids)) slot-count)
        (if (= (count (get layout :argument-product-node-ids)) slot-count)
          (if (= (count (get layout :runtime-check-id-vectors)) slot-count)
            (if (= (count (get layout :projection-id-vectors)) slot-count)
              (if (= (count (get layout :product-node-id-vectors)) slot-count)
                (loop [remaining slot-plans index 0]
                  (if (= (count remaining) 0)
                    true
                    (let [slot (first remaining)
                          vector-count
                          (count (get slot :runtime-check-preimages))
                          terminal-count
                          (count (get slot :terminal-projections))]
                      (if (= (count
                              (get (get layout :runtime-check-id-vectors)
                                   index))
                             vector-count)
                        (if (= (count
                                (get (get layout :projection-id-vectors)
                                     index))
                               terminal-count)
                          (if (= (count
                                  (get (get layout :product-node-id-vectors)
                                       index))
                                 (+ vector-count terminal-count))
                            (recur (rest remaining) (+ index 1))
                            false)
                          false)
                        false))))
                false)
              false)
            false)
          false)
        false)
      false)))

(defn sh07-b51-loop-recur-argument-evaluations
  [request indexes loop-foundation recur-result layout]
  (let [all-bindings
        (loop [remaining (get loop-foundation :slot-plans) result []]
          (if (= (count remaining) 0)
            result
            (recur
             (rest remaining)
             (sh07-b51-vector-append
              result
              (get (get (first remaining) :publication-event-preimage)
                   :introduced-binding-ids)))))]
    (loop [remaining (get recur-result :argument-forms)
           remaining-nodes (get layout :argument-node-ids)
           ordinal 0 result []]
      (if (= (count remaining) 0)
        {:status :accepted :evaluations result}
        (let [form (first remaining)
              references
              (sh07-b51-initializer-reference-ids
               request indexes (get loop-foundation :fragment) form)]
          (if (= (get references :status) :accepted)
            (recur
             (rest remaining) (rest remaining-nodes) (+ ordinal 1)
             (conj
              result
              {:argument-ordinal ordinal
               :argument-form-id (get form :form-id)
               :argument-syntax-id (get form :syntax-id)
               :argument-scope-id (get form :scope-id)
               :argument-node-id (first remaining-nodes)
               :evaluation-count 1
               :evaluation-order :arguments-left-to-right
               :visible-loop-binding-ids all-bindings
               :referenced-binding-ids
               (get references :referenced-binding-ids)
               :source-span (get form :source-span)
               :source-origin-chain (get form :origin-chain)
               :source-generated-origin (get form :generated-origin)
               :metadata (get form :metadata)
               :preserved-declarations
               {:effects (get (get request :module) :effects)
                :capabilities (get (get request :module) :capabilities)
                :safety (get (get request :module) :safety)}
               :pending-fact-families
               [:types :effects :ownership :safety]}))
            references))))))

(defn sh07-b51-loop-recur-checks-for-slot
  [indexes loop-foundation recur-coordinate slot-plan layout slot-index
   global-check-ordinal event-check-order]
  (let [owner (get loop-foundation :owner-coordinate)
        recur-form
        (sh07-b51-find-form indexes (get recur-coordinate :recur-form-id))
        extractions (get slot-plan :binding-extraction-preimages)
        extraction-ids (get slot-plan :extraction-ids)
        check-ids (get (get layout :runtime-check-id-vectors) slot-index)]
    (loop [remaining extractions
           descriptor-index 0 check-index 0 result []]
      (if (= (count remaining) 0)
        {:status :accepted
         :preimages result
         :next-global-check-ordinal (+ global-check-ordinal check-index)
         :next-event-check-order (+ event-check-order check-index)}
        (let [extraction (first remaining)]
          (if (= (get extraction :kind) :vector-node)
            (let [preimage
                  {:domain :gravity/sh07-b51-runtime-check-id-preimage-v18
                   :schema-version 18
                   :global-runtime-check-ordinal
                   (+ global-check-ordinal check-index)
                   :predecessor-authority-id
                   (get layout :predecessor-authority-id)
                   :fragment-id (get owner :fragment-id)
                   :fragment-ordinal (get owner :fragment-ordinal)
                   :root-form-id (get owner :root-form-id)
                   :root-syntax-id (get owner :root-syntax-id)
                   :owner-kind :loop
                   :owner-form-id (get owner :enclosing-form-id)
                   :owner-syntax-id (get owner :enclosing-syntax-id)
                   :owner-coordinate owner
                   :slot-coordinate (get slot-plan :slot-coordinate)
                   :site-kind :recur
                   :recur-coordinate recur-coordinate
                   :slot-id (get slot-plan :slot-id)
                   :extraction-id (get extraction-ids descriptor-index)
                   :path (get extraction :path)
                   :check-kind :exact-vector-shape
                   :expected-kind :vector
                   :expected-width (get extraction :expected-width)
                   :check-order (+ event-check-order check-index)
                   :guarded-publication-ordinal
                   (get layout :global-publication-ordinal)
                   :guarded-event-kind :loop-atomic-transfer
                   :failure-rule "L7-PATTERN-TYPE"
                   :reasons [:vector-required :vector-width-mismatch]
                   :guard-policy :publish-after-all-checks
                   :fail-closed true
                   :source-origin-chain (get recur-form :origin-chain)
                   :source-generated-origin
                   (get recur-form :generated-origin)}
                  built (sh07-b51-build-runtime-check-preimage preimage)]
              (if (= (get built :status) :accepted)
                (recur
                 (rest remaining) (+ descriptor-index 1) (+ check-index 1)
                 (conj result (get built :preimage)))
                built))
            (recur
             (rest remaining) (+ descriptor-index 1) check-index result)))))))

(defn sh07-b51-loop-recur-checks
  [indexes loop-foundation recur-coordinate layout]
  (loop [remaining (get loop-foundation :slot-plans)
         slot-index 0
         global-check-ordinal
         (get layout :first-global-runtime-check-ordinal)
         event-check-order 0
         vectors []]
    (if (= (count remaining) 0)
      {:status :accepted :preimage-vectors vectors}
      (let [built
            (sh07-b51-loop-recur-checks-for-slot
             indexes loop-foundation recur-coordinate (first remaining)
             layout slot-index global-check-ordinal event-check-order)]
        (if (= (get built :status) :accepted)
          (recur
           (rest remaining) (+ slot-index 1)
           (get built :next-global-check-ordinal)
           (get built :next-event-check-order)
           (conj vectors (get built :preimages)))
          built)))))

(defn sh07-b51-loop-recur-projections-for-slot
  [slot projection-ids slot-index]
  (loop [extractions (get slot :binding-extraction-preimages)
         ids projection-ids projections []]
    (if (= (count extractions) 0)
      {:status :accepted :projections projections}
      (let [extraction (first extractions)]
        (if (contains? #{:binding-leaf :wildcard-leaf}
                       (get extraction :kind))
          (recur
           (rest extractions) (rest ids)
           (conj projections
                 {:projection-id (first ids)
                  :slot-ordinal slot-index
                  :terminal-ordinal (get extraction :terminal-ordinal)
                  :leaf-ordinal (get extraction :leaf-ordinal)
                  :kind (get extraction :kind)
                  :path (get extraction :path)
                  :binding-ids
                  (if (= (get extraction :kind) :binding-leaf)
                    [(get extraction :binding-id)] [])
                  :from-argument-evaluation true
                  :reevaluate-argument false}))
          (recur (rest extractions) ids projections))))))

(defn sh07-b51-loop-recur-projection-vectors [loop-foundation layout]
  (loop [remaining (get loop-foundation :slot-plans)
         slot-index 0 vectors []]
    (if (= (count remaining) 0)
      {:status :accepted :projection-vectors vectors}
      (let [built
            (sh07-b51-loop-recur-projections-for-slot
             (first remaining)
             (get (get layout :projection-id-vectors) slot-index)
             slot-index)]
        (if (= (get built :status) :accepted)
          (recur
           (rest remaining) (+ slot-index 1)
           (conj vectors (get built :projections)))
          built)))))

(defn sh07-b51-loop-slot-plan-vector [slot-plans field]
  (loop [remaining slot-plans result []]
    (if (= (count remaining) 0)
      result
      (recur (rest remaining) (conj result (get (first remaining) field))))))

(defn sh07-b51-loop-binding-id-vectors [slot-plans]
  (loop [remaining slot-plans result []]
    (if (= (count remaining) 0)
      result
      (recur
       (rest remaining)
       (conj result
             (get (get (first remaining) :publication-event-preimage)
                  :introduced-binding-ids))))))

(defn sh07-b51-repeat-vector [value count-value]
  (loop [remaining count-value result []]
    (if (= remaining 0)
      result
      (recur (- remaining 1) (conj result value)))))

(defn sh07-b51-loop-transfer-aligns-with-slot-plans?
  [preimage slot-plans layout]
  (if (= (get preimage :slot-ids)
         (sh07-b51-loop-slot-plan-vector slot-plans :slot-id))
    (if (= (get preimage :slot-coordinates)
           (sh07-b51-loop-slot-plan-vector slot-plans :slot-coordinate))
      (if (= (get preimage :introduced-binding-id-vectors)
             (sh07-b51-loop-binding-id-vectors slot-plans))
        (if (= (get preimage :projection-id-vectors)
               (get layout :projection-id-vectors))
          (if (= (get preimage :required-check-id-vectors)
                 (get layout :runtime-check-id-vectors))
            (= (get preimage :product-node-id-vectors)
               (get layout :product-node-id-vectors))
            false)
          false)
        false)
      false)
    false))

(defn sh07-b51-loop-transfer-publication-preimage
  [loop-foundation recur-form recur-coordinate layout]
  (let [owner (get loop-foundation :owner-coordinate)
        slot-plans (get loop-foundation :slot-plans)
        slot-ids (sh07-b51-loop-slot-plan-vector slot-plans :slot-id)
        coordinates
        (sh07-b51-loop-slot-plan-vector slot-plans :slot-coordinate)
        binding-vectors (sh07-b51-loop-binding-id-vectors slot-plans)
        all-bindings (sh07-b51-flatten-reference-vectors binding-vectors)
        visible-vectors
        (sh07-b51-repeat-vector all-bindings (count slot-plans))
        projection-vectors (get layout :projection-id-vectors)
        check-vectors (get layout :runtime-check-id-vectors)
        product-vectors (get layout :product-node-id-vectors)
        preimage
        {:domain
         :gravity/sh07-b51-publication-event-id-preimage-v18
         :schema-version 18
         :global-publication-ordinal
         (get layout :global-publication-ordinal)
         :predecessor-authority-id
         (get layout :predecessor-authority-id)
         :fragment-id (get owner :fragment-id)
         :fragment-ordinal (get owner :fragment-ordinal)
         :root-form-id (get owner :root-form-id)
         :root-syntax-id (get owner :root-syntax-id)
         :owner-kind :loop
         :owner-form-id (get owner :enclosing-form-id)
         :owner-syntax-id (get owner :enclosing-syntax-id)
         :owner-coordinate owner
         :slot-coordinate nil
         :slot-coordinates coordinates
         :recur-coordinate recur-coordinate
         :slot-id nil
         :slot-ids slot-ids
         :event-kind :loop-atomic-transfer
         :introduced-binding-ids []
         :introduced-binding-id-vectors binding-vectors
         :projection-ids []
         :projection-id-vectors projection-vectors
         :required-check-ids []
         :required-check-id-vectors check-vectors
         :product-node-ids []
         :product-node-id-vectors product-vectors
         :visible-before-binding-ids []
         :visible-before-binding-id-vectors visible-vectors
         :visible-after-binding-ids []
         :visible-after-binding-id-vectors visible-vectors
         :commit-order (get layout :global-publication-ordinal)
         :all-or-none true
         :publish-none
         (if (sh07-b51-all-vectors-empty? binding-vectors)
           (sh07-b51-all-vectors-empty? projection-vectors)
           false)
         :source-origin-chain
         (get recur-form :origin-chain)
         :source-generated-origin
         (get recur-form :generated-origin)}
        built (sh07-b51-build-publication-event-preimage preimage)]
    (if (= (get built :status) :accepted)
      (if (sh07-b51-loop-transfer-aligns-with-slot-plans?
           (get built :preimage) slot-plans layout)
        {:status :accepted :preimage (get built :preimage)}
        {:status :rejected :reason :loop-slot-reference-misaligned
         :partial-products []})
      built)))

(defn sh07-b51-zero-ordinals [count-value]
  (loop [ordinal 0 result []]
    (if (= ordinal count-value)
      result
      (recur (+ ordinal 1) (conj result ordinal)))))

(defn sh07-b51-loop-recur-mapping-aligns?
  [preimage loop-foundation layout]
  (let [slot-plans (get loop-foundation :slot-plans)]
    (if (= (get preimage :slot-ids)
           (sh07-b51-loop-slot-plan-vector slot-plans :slot-id))
      (if (= (get preimage :slot-coordinates)
             (sh07-b51-loop-slot-plan-vector slot-plans :slot-coordinate))
        (if (= (get preimage :extraction-id-vectors)
               (sh07-b51-loop-slot-plan-vector slot-plans :extraction-ids))
          (if (= (get preimage :required-check-id-vectors)
                 (get layout :runtime-check-id-vectors))
            (if (= (get preimage :projection-id-vectors)
                   (get layout :projection-id-vectors))
              (= (get preimage :binding-id-vectors)
                 (sh07-b51-loop-binding-id-vectors slot-plans))
              false)
            false)
          false)
        false)
      false)))

(defn sh07-b51-loop-recur-mapping-preimage
  [loop-foundation recur-form recur-coordinate layout]
  (let [owner (get loop-foundation :owner-coordinate)
        slot-plans (get loop-foundation :slot-plans)
        slot-count (count slot-plans)
        ordinals (sh07-b51-zero-ordinals slot-count)
        preimage
        {:domain :gravity/sh07-b51-recur-slot-mapping-id-preimage-v18
         :schema-version 18
         :global-recur-mapping-ordinal
         (get layout :global-recur-mapping-ordinal)
         :predecessor-authority-id
         (get layout :predecessor-authority-id)
         :fragment-id (get owner :fragment-id)
         :fragment-ordinal (get owner :fragment-ordinal)
         :root-form-id (get owner :root-form-id)
         :root-syntax-id (get owner :root-syntax-id)
         :loop-form-id (get owner :enclosing-form-id)
         :loop-syntax-id (get owner :enclosing-syntax-id)
         :loop-core-node-id (get loop-foundation :owner-core-node-id)
         :recur-form-id (get recur-form :form-id)
         :recur-syntax-id (get recur-form :syntax-id)
         :recur-core-node-id (get layout :recur-core-node-id)
         :target-loop-form-id (get owner :enclosing-form-id)
         :target-loop-syntax-id (get owner :enclosing-syntax-id)
         :target-loop-core-node-id
         (get loop-foundation :owner-core-node-id)
         :commit-publication-id (get layout :publication-event-id)
         :owner-coordinate owner
         :recur-coordinate recur-coordinate
         :slot-count slot-count
         :argument-count slot-count
         :slot-ordinals ordinals
         :argument-ordinals ordinals
         :slot-ids
         (sh07-b51-loop-slot-plan-vector slot-plans :slot-id)
         :slot-coordinates
         (sh07-b51-loop-slot-plan-vector slot-plans :slot-coordinate)
         :argument-node-ids (get layout :argument-node-ids)
         :extraction-id-vectors
         (sh07-b51-loop-slot-plan-vector slot-plans :extraction-ids)
         :required-check-id-vectors
         (get layout :runtime-check-id-vectors)
         :projection-id-vectors (get layout :projection-id-vectors)
         :binding-id-vectors
         (sh07-b51-loop-binding-id-vectors slot-plans)
         :evaluation-order ordinals
         :commit-policy :simultaneous-after-all-checks
         :all-or-none true
         :tail-only true
         :source-origin-chain (get recur-form :origin-chain)
         :source-generated-origin (get recur-form :generated-origin)}
        built (sh07-b51-build-recur-slot-mapping-preimage preimage)]
    (if (= (get built :status) :accepted)
      (if (sh07-b51-loop-recur-mapping-aligns?
           (get built :preimage) loop-foundation layout)
        {:status :accepted :preimage (get built :preimage)}
        {:status :rejected :reason :recur-slot-reference-misaligned
         :partial-products []})
      built)))

(defn sh07-b51-loop-recur-event-sequence
  [evaluations check-vectors projection-vectors publication mapping]
  (let [after-arguments
        (loop [remaining evaluations result []]
          (if (= (count remaining) 0)
            result
            (recur
             (rest remaining)
             (conj result
                   {:event-kind :recur-argument
                    :argument-ordinal
                    (get (first remaining) :argument-ordinal)
                    :evaluation-count 1
                    :argument-node-id
                    (get (first remaining) :argument-node-id)}))))
        after-checks
        (loop [remaining-vectors check-vectors
               remaining [] result after-arguments]
          (if (= (count remaining) 0)
            (if (= (count remaining-vectors) 0)
              result
              (recur
               (rest remaining-vectors) (first remaining-vectors) result))
            (recur
             remaining-vectors (rest remaining)
             (conj result
                   {:event-kind :vector-check
                    :slot-ordinal
                    (get (get (first remaining) :slot-coordinate)
                         :slot-ordinal)
                    :check-order (get (first remaining) :check-order)
                    :path (get (first remaining) :path)
                    :expected-width
                    (get (first remaining) :expected-width)}))))
        after-projections
        (loop [remaining-vectors projection-vectors
               remaining [] result after-checks]
          (if (= (count remaining) 0)
            (if (= (count remaining-vectors) 0)
              result
              (recur
               (rest remaining-vectors) (first remaining-vectors) result))
            (recur
             remaining-vectors (rest remaining)
             (conj result
                   {:event-kind :terminal-projection
                    :slot-ordinal (get (first remaining) :slot-ordinal)
                    :terminal-ordinal
                    (get (first remaining) :terminal-ordinal)
                    :path (get (first remaining) :path)
                    :reevaluate-argument false}))))]
    (conj
     (conj after-projections
           {:event-kind :loop-atomic-transfer
            :global-publication-ordinal
            (get publication :global-publication-ordinal)
            :all-or-none true})
     {:event-kind :recur-slot-mapping
      :global-recur-mapping-ordinal
      (get mapping :global-recur-mapping-ordinal)
      :tail-only true})))

(defn sh07-b51-lower-loop-recur-foundation
  [request loop-foundation recur-form reference-layout]
  (let [indexes (sh07-b51-index-request request)]
    (if (sh07-b51-indexes-unique? indexes)
      (if (= (get loop-foundation :status) :accepted)
        (if (= (get loop-foundation :owner-kind) :loop)
          (if (sh07-b51-loop-recur-reference-layout-aligns?
               reference-layout (get loop-foundation :slot-plans))
            (let [recur-result
                  (sh07-b51-authenticated-loop-recur
                   request indexes loop-foundation recur-form
                   (get reference-layout :recur-core-node-id))]
              (if (= (get recur-result :status) :accepted)
                (let [recur-coordinate
                      (get recur-result :recur-coordinate)
                      arguments
                      (sh07-b51-loop-recur-argument-evaluations
                       request indexes loop-foundation recur-result
                       reference-layout)
                      checks
                      (sh07-b51-loop-recur-checks
                       indexes loop-foundation recur-coordinate
                       reference-layout)
                      projections
                      (sh07-b51-loop-recur-projection-vectors
                       loop-foundation reference-layout)]
                  (if (= (get arguments :status) :accepted)
                    (if (= (get checks :status) :accepted)
                      (if (= (get projections :status) :accepted)
                        (let [publication
                              (sh07-b51-loop-transfer-publication-preimage
                               loop-foundation recur-form recur-coordinate
                               reference-layout)
                              mapping
                              (sh07-b51-loop-recur-mapping-preimage
                               loop-foundation recur-form recur-coordinate
                               reference-layout)]
                          (if (= (get publication :status) :accepted)
                            (if (= (get mapping :status) :accepted)
                              {:status :accepted
                               :target-kind :loop
                               :target-loop-form-id
                               (get (get loop-foundation :owner-coordinate)
                                    :enclosing-form-id)
                               :target-slot-count
                               (get loop-foundation :slot-count)
                               :recur-coordinate recur-coordinate
                               :argument-evaluations
                               (get arguments :evaluations)
                               :runtime-check-preimage-vectors
                               (get checks :preimage-vectors)
                               :projection-vectors
                               (get projections :projection-vectors)
                               :publication-event-preimage
                               (get publication :preimage)
                               :recur-slot-mapping-preimage
                               (get mapping :preimage)
                               :event-sequence
                               (sh07-b51-loop-recur-event-sequence
                                (get arguments :evaluations)
                                (get checks :preimage-vectors)
                                (get projections :projection-vectors)
                                (get publication :preimage)
                                (get mapping :preimage))
                               :evaluation-policy
                               :arguments-once-left-to-right
                               :check-policy :slot-then-preorder
                               :projection-policy
                               :without-argument-reevaluation
                               :commit-policy
                               :simultaneous-after-all-checks
                               :failure-policy
                               {:publish-any-slot false
                                :transfer-control false
                                :rule "L7-PATTERN-TYPE"}
                               :tail-only true
                               :all-or-none true
                               :calls-b47-lowerer false
                               :partial-products []}
                              mapping)
                            publication))
                        projections)
                      checks)
                    arguments))
                recur-result))
            {:status :rejected :reason :recur-reference-layout-misaligned
             :partial-products []})
          {:status :rejected :reason :loop-foundation-kind
           :partial-products []})
        {:status :rejected :reason :loop-foundation-required
         :partial-products []})
      {:status :rejected :reason :request-index-duplicate
       :partial-products []})))

(defn sh07-b51-owner-slot-preflight-records [slots]
  (loop [remaining slots result []]
    (if (= (count remaining) 0)
      result
      (let [slot (first remaining)]
        (recur
         (rest remaining)
         (conj result
               {:owner-coordinate (get slot :owner-coordinate)
                :fragment (get slot :fragment)
                :pattern (get slot :pattern)}))))))

(defn sh07-b51-authenticated-form-preorder [request indexes]
  (let [root-ids (get request :top-level-form-ids)
        fragment-ids
        (loop [remaining (get request :fragment-manifest) result []]
          (if (= (count remaining) 0)
            result
            (recur (rest remaining)
                   (conj result (get (first remaining) :fragment-id)))))
        assembly-ids
        (get (get request :module-assembly-manifest)
             :ordered-fragment-ids)]
    (if (sh07-b51-all-unique? root-ids)
      (if (= fragment-ids root-ids)
        (if (= assembly-ids root-ids)
          (loop [frontier
                 (loop [remaining root-ids root-index 0 result []]
                   (if (= (count remaining) 0)
                     result
                     (let [root
                           (sh07-b51-find-form indexes (first remaining))]
                       (if (map? root)
                         (recur
                          (rest remaining) (+ root-index 1)
                          (conj result
                                {:form root :root? true
                                 :occurrence-path [root-index]
                                 :ancestry []}))
                         [{:missing-root true}]))))
                 seen-form-ids #{} result [] occurrence-paths []]
            (if (= (count frontier) 0)
              (if (= (count seen-form-ids) (count (get request :forms)))
                {:status :accepted :forms result
                 :occurrence-paths occurrence-paths
                 :occurrence-aware true}
                {:status :rejected :reason :request-form-coverage-mismatch
                 :partial-products []})
              (let [entry (first frontier)
                    form (get entry :form)
                    form-id (get form :form-id)
                    ancestry (get entry :ancestry)]
                (if (map? form)
                  (if (= form (sh07-b51-find-form indexes form-id))
                    (if (sh07-b51-vector-contains? ancestry form-id)
                      {:status :rejected :reason :form-preorder-cycle
                       :partial-products []}
                      (if (if (get entry :root?)
                            (= (get form :parent-form-id) nil)
                            true)
                        (let [children
                              (loop [remaining-ids
                                     (get form :child-form-ids)
                                     child-index 0 values []]
                                (if (= (count remaining-ids) 0)
                                  {:status :accepted :children values}
                                  (let [child
                                        (sh07-b51-find-form
                                         indexes (first remaining-ids))]
                                    (if (map? child)
                                      (if (= (get child :parent-form-id)
                                             form-id)
                                        (recur
                                         (rest remaining-ids)
                                         (+ child-index 1)
                                         (conj
                                          values
                                          {:form child :root? false
                                           :occurrence-path
                                           (conj
                                            (get entry :occurrence-path)
                                            child-index)
                                           :ancestry
                                           (conj ancestry form-id)}))
                                        {:status :rejected
                                         :reason :form-preorder-parent
                                         :partial-products []})
                                      {:status :rejected
                                       :reason :form-preorder-child-missing
                                       :partial-products []}))))]
                          (if (= (get children :status) :accepted)
                            (recur
                             (sh07-b51-vector-append
                              (get children :children) (rest frontier))
                             (conj seen-form-ids form-id)
                             (conj result form)
                             (conj occurrence-paths
                                   (get entry :occurrence-path)))
                            children))
                        {:status :rejected :reason :root-parent-nonnil
                         :partial-products []}))
                    {:status :rejected :reason :form-preorder-substitution
                     :partial-products []})
                  {:status :rejected :reason :top-level-root-missing
                   :partial-products []}))))
          {:status :rejected :reason :assembly-fragment-order-substitution
           :partial-products []})
        {:status :rejected :reason :fragment-root-order-substitution
         :partial-products []})
      {:status :rejected :reason :top-level-root-duplicate
       :partial-products []})))

(defn sh07-b51-module-owner-slot-entry [request indexes form]
  (let [owner-kind
        (if (sh07-b51-authenticated-list-operator? indexes form 'let)
          :let
          (if (sh07-b51-authenticated-list-operator? indexes form 'loop)
            :loop nil))]
    (if (= owner-kind nil)
      {:status :accepted :owner nil :slots []}
      (let [skeleton
            (if (= owner-kind :let)
              (sh07-b51-let-owner-skeleton request indexes form)
              (sh07-b51-loop-owner-skeleton request indexes form))]
        (if (= (get skeleton :status) :accepted)
          (let [patterns
                (sh07-b51-let-slot-patterns request indexes skeleton)]
            (if (= (get patterns :status) :accepted)
              {:status :accepted
               :owner
               {:owner-kind owner-kind
                :enclosing-form-id (get form :form-id)
                :enclosing-syntax-id (get form :syntax-id)
                :owner-coordinate (get skeleton :owner-coordinate)
                :fragment (get skeleton :fragment)
                :slot-count (count (get patterns :slots))}
               :slots (get patterns :slots)}
              patterns))
          skeleton)))))

(defn sh07-b51-collect-module-owner-slots [request]
  (let [indexes (sh07-b51-index-request request)]
    (if (sh07-b51-indexes-unique? indexes)
      (let [preorder (sh07-b51-authenticated-form-preorder request indexes)]
        (if (= (get preorder :status) :accepted)
          (loop [remaining (get preorder :forms)
                 owners [] slots [] owner-form-ids #{}]
            (if (= (count remaining) 0)
              (let [preflight
                    (sh07-b51-module-resource-preflight
                     (sh07-b51-owner-slot-preflight-records slots))]
                (if (= (get preflight :status) :accepted)
                  {:status :accepted
                   :owners owners :slots slots
                   :owner-count (count owners) :slot-count (count slots)
                   :binding-leaf-count (get preflight :binding-leaf-count)
                   :module-global-preflight preflight
                   :preflight-before-products true
                   :authenticated-form-order (get preorder :forms)
                   :partial-products []}
                  preflight))
              (let [entry
                    (sh07-b51-module-owner-slot-entry
                     request indexes (first remaining))
                    owner (get entry :owner)]
                (if (= (get entry :status) :accepted)
                  (if (= owner nil)
                    (recur (rest remaining) owners slots owner-form-ids)
                    (if (contains? owner-form-ids
                                   (get owner :enclosing-form-id))
                      {:status :rejected
                       :reason :owner-occurrence-ambiguous
                       :partial-products []}
                      (recur
                       (rest remaining) (conj owners owner)
                       (sh07-b51-vector-append slots (get entry :slots))
                       (conj owner-form-ids
                             (get owner :enclosing-form-id)))))
                  entry))))
          preorder))
      {:status :rejected :reason :request-index-duplicate
       :partial-products []})))

(defn sh07-b51-collect-recur-forms-from-body
  [request indexes fragment body-forms]
  (loop [frontier
         (loop [remaining body-forms body-index 0 result []]
           (if (= (count remaining) 0)
             result
             (recur
              (rest remaining) (+ body-index 1)
              (conj result
                    {:form (first remaining) :depth 0
                     :occurrence-path [body-index] :ancestry []}))))
         recurs [] recur-form-ids #{}]
    (if (= (count frontier) 0)
      {:status :accepted :recur-forms recurs}
      (let [entry (first frontier)
            form (get entry :form)
            depth (get entry :depth)
            form-id (get form :form-id)
            ancestry (get entry :ancestry)
            membership
            (sh07-b51-index-of (get fragment :form-ids) form-id)]
        (if (> depth 256)
          {:status :rejected :reason :body-recur-traversal-depth
           :partial-products []}
          (if (sh07-b51-vector-contains? ancestry form-id)
            {:status :rejected :reason :body-recur-traversal-cycle
             :partial-products []}
            (if (= form (sh07-b51-find-form indexes form-id))
              (if (= (get membership :count) 1)
                (let [children
                      (loop [remaining-ids (get form :child-form-ids)
                             child-index 0 values []]
                        (if (= (count remaining-ids) 0)
                          {:status :accepted :children values}
                          (let [child
                                (sh07-b51-find-form
                                 indexes (first remaining-ids))]
                            (if (map? child)
                              (if (= (get child :parent-form-id) form-id)
                                (recur
                                 (rest remaining-ids) (+ child-index 1)
                                 (conj
                                  values
                                  {:form child :depth (+ depth 1)
                                   :occurrence-path
                                   (conj (get entry :occurrence-path)
                                         child-index)
                                   :ancestry (conj ancestry form-id)}))
                                {:status :rejected
                                 :reason :body-child-parent-substitution
                                 :partial-products []})
                              {:status :rejected
                               :reason :body-child-missing
                               :partial-products []}))))
                      recur?
                      (sh07-b51-authenticated-list-operator?
                       indexes form 'recur)]
                    (if (= (get children :status) :accepted)
                      (if (if recur? (contains? recur-form-ids form-id) false)
                        {:status :rejected
                         :reason :recur-occurrence-ambiguous
                         :partial-products []}
                      (recur
                       (sh07-b51-vector-append
                        (get children :children) (rest frontier))
                       (if recur?
                         (conj recurs form)
                         recurs)
                       (if recur?
                         (conj recur-form-ids form-id)
                         recur-form-ids)))
                      children))
                {:status :rejected :reason :body-form-cross-fragment
                 :partial-products []})
              {:status :rejected :reason :body-form-substitution
               :partial-products []})))))))

(defn sh07-b51-nearest-recur-target
  [request indexes fragment recur-form]
  (loop [current recur-form depth 0 visited #{}]
    (if (> depth 256)
      {:status :rejected :reason :recur-target-depth
       :partial-products []}
      (let [current-id (get current :form-id)
            parent-id (get current :parent-form-id)]
        (if (contains? visited current-id)
          {:status :rejected :reason :recur-target-cycle
           :partial-products []}
          (if (= parent-id nil)
            {:status :rejected :reason :missing-recur-target
             :offending-form recur-form
             :partial-products []}
            (let [parent (sh07-b51-find-form indexes parent-id)
                  direct
                  (if (map? parent)
                    (sh07-b51-authenticated-direct-child
                     request indexes parent current-id)
                    {:status :rejected})
                  membership
                  (if (map? parent)
                    (sh07-b51-index-of
                     (get fragment :form-ids) parent-id)
                    {:count 0})]
              (if (map? parent)
                (if (= (get direct :status) :accepted)
                  (if (= (get membership :count) 1)
                    (if (sh07-b51-authenticated-list-operator?
                         indexes parent 'loop)
                      {:status :accepted
                       :target-kind :loop :target-form parent}
                      (if (sh07-b51-authenticated-list-operator?
                           indexes parent 'fn)
                        {:status :accepted
                         :target-kind :function :target-form parent}
                        (recur
                         parent (+ depth 1) (conj visited current-id))))
                    {:status :rejected :reason :recur-target-cross-fragment
                     :partial-products []})
                  direct)
                {:status :rejected :reason :recur-target-parent-missing
                 :partial-products []}))))))))

(defn sh07-b51-function-target-recur-parity
  [request indexes fragment recur-form target-form]
  (let [target-children (get target-form :child-form-ids)
        recur-children (get recur-form :child-form-ids)]
    (if (= (count target-children) 3)
      (let [parameters
            (sh07-b51-authenticated-direct-child
             request indexes target-form (get target-children 1))]
        (if (= (get parameters :status) :accepted)
          (if (= (get (get parameters :form) :kind) :vector)
            (let [arity
                  (count (get (get parameters :form) :child-form-ids))
                  argument-count (- (count recur-children) 1)]
              (if (= argument-count arity)
                (if (sh07-b51-loop-recur-tail-authenticated?
                     request indexes fragment recur-form target-form)
                  {:status :accepted
                   :target-kind :function
                   :target-form-id (get target-form :form-id)
                   :target-syntax-id (get target-form :syntax-id)
                   :arity arity
                   :argument-count argument-count
                   :tail-only true
                   :b51-products []
                   :legacy-parity-required true
                   :calls-b47-lowerer false}
                  {:status :rejected :reason :recur-not-tail
                   :offending-form recur-form
                   :target-form-id (get target-form :form-id)
                   :partial-products []})
                {:status :rejected :reason :recur-arity-mismatch
                 :expected arity :observed argument-count
                 :offending-form recur-form
                 :target-form-id (get target-form :form-id)
                 :partial-products []}))
            {:status :rejected :reason :function-parameter-vector-required
             :partial-products []})
          parameters))
      {:status :rejected :reason :function-target-shape
       :partial-products []})))

(defn sh07-b51-classify-loop-body-recurs
  [request indexes loop-foundation recur-forms]
  (loop [remaining recur-forms
         loop-recurs [] function-recurs [] nested-loop-recurs []]
    (if (= (count remaining) 0)
      {:status :accepted
       :loop-recurs loop-recurs
       :function-recurs function-recurs
       :nested-loop-recurs nested-loop-recurs}
      (let [recur-form (first remaining)
            selected
            (sh07-b51-nearest-recur-target
             request indexes (get loop-foundation :fragment) recur-form)]
        (if (= (get selected :status) :accepted)
          (let [target (get selected :target-form)
                target-kind (get selected :target-kind)]
            (if (= target-kind :function)
              (let [parity
                    (sh07-b51-function-target-recur-parity
                     request indexes (get loop-foundation :fragment)
                     recur-form target)]
                (if (= (get parity :status) :accepted)
                  (recur
                   (rest remaining) loop-recurs
                   (conj function-recurs
                         {:recur-form recur-form :target parity})
                   nested-loop-recurs)
                  (assoc parity :owner-coordinate
                         (get loop-foundation :owner-coordinate))))
              (if (= (get target :form-id)
                     (get (get loop-foundation :owner-coordinate)
                          :enclosing-form-id))
                (recur
                 (rest remaining) (conj loop-recurs recur-form)
                 function-recurs nested-loop-recurs)
                (recur
                 (rest remaining) loop-recurs function-recurs
                 (conj nested-loop-recurs
                       {:recur-form recur-form
                        :target-loop-form target
                        :b51-products-owned-by-nested-loop true})))))
          (assoc
           (assoc selected :owner-coordinate
                  (get loop-foundation :owner-coordinate))
           :target-form-id nil))))))

(defn sh07-b51-loop-recur-layouts-align?
  [entries loop-recurs slot-plans]
  (if (vector? entries)
    (if (= (count entries) (count loop-recurs))
      (loop [remaining-entries entries remaining-recurs loop-recurs]
        (if (= (count remaining-entries) 0)
          true
          (let [entry (first remaining-entries)
                recur-form (first remaining-recurs)]
            (if (sh07-b51-exact-keys? entry #{:recur-form-id :layout})
              (if (= (get entry :recur-form-id) (get recur-form :form-id))
                (if (sh07-b51-loop-recur-reference-layout-aligns?
                     (get entry :layout) slot-plans)
                  (recur (rest remaining-entries)
                         (rest remaining-recurs))
                  false)
                false)
              false))))
      false)
    false))

(defn sh07-b51-lower-loop-body-recurs-foundation
  [request loop-foundation recur-layout-entries]
  (let [indexes (sh07-b51-index-request request)]
    (if (sh07-b51-indexes-unique? indexes)
      (let [collected
            (sh07-b51-collect-recur-forms-from-body
             request indexes (get loop-foundation :fragment)
             (get loop-foundation :body-forms))]
        (if (= (get collected :status) :accepted)
          (let [classified
                (sh07-b51-classify-loop-body-recurs
                 request indexes loop-foundation
                 (get collected :recur-forms))]
            (if (= (get classified :status) :accepted)
              (let [loop-recurs (get classified :loop-recurs)]
                (if (sh07-b51-loop-recur-layouts-align?
                     recur-layout-entries loop-recurs
                     (get loop-foundation :slot-plans))
                  (loop [remaining-recurs loop-recurs
                         remaining-layouts recur-layout-entries
                         lowered []]
                    (if (= (count remaining-recurs) 0)
                      {:status :accepted
                       :loop-recur-sites lowered
                       :loop-recur-count (count lowered)
                       :function-recur-sites
                       (get classified :function-recurs)
                       :nested-loop-recur-sites
                       (get classified :nested-loop-recurs)
                       :all-body-recur-count
                       (count (get collected :recur-forms))
                       :all-body-recurs-classified true
                       :applicable-loop-recurs-covered true
                       :function-target-b51-products []
                       :global-counter-status
                       :pending-module-occurrence-replay
                       :admitting-success false
                       :partial-products []}
                      (let [built
                            (sh07-b51-lower-loop-recur-foundation
                             request loop-foundation
                             (first remaining-recurs)
                             (get (first remaining-layouts) :layout))]
                        (if (= (get built :status) :accepted)
                          (recur
                           (rest remaining-recurs)
                           (rest remaining-layouts)
                           (conj lowered built))
                          built))))
                  {:status :rejected
                   :reason :loop-recur-layout-coverage
                   :partial-products []}))
              classified))
          collected))
      {:status :rejected :reason :request-index-duplicate
       :partial-products []})))

(defn sh07-b51-compose-loop-body-foundation
  [request loop-form initialization-layout recur-layout-entries]
  (let [module-preflight (sh07-b51-collect-module-owner-slots request)]
    (if (= (get module-preflight :status) :accepted)
      (let [loop-foundation
            (sh07-b51-lower-loop-slots-foundation
             request loop-form initialization-layout)]
        (if (= (get loop-foundation :status) :accepted)
          (let [recurs
                (sh07-b51-lower-loop-body-recurs-foundation
                 request loop-foundation recur-layout-entries)]
            (if (= (get recurs :status) :accepted)
              {:status :accepted
               :module-global-preflight module-preflight
               :module-global-preflight-before-products true
               :loop-foundation loop-foundation
               :body-recur-foundation recurs
               :all-loop-recurs-covered
               (get recurs :applicable-loop-recurs-covered)
               :mixed-targets-classified
               (get recurs :all-body-recurs-classified)
               :global-counter-status
               :pending-module-occurrence-replay
               :digest-purpose-authentication-status
               :pending-final-verifier
               :admitting-success false
               :partial-products []}
              recurs))
          loop-foundation))
      module-preflight)))


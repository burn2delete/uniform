(defn sh07-b51-linked-module-sources-shape? [descriptors]
  (if (vector? descriptors)
    (if (= (count descriptors) 7)
      (loop [remaining descriptors ordinal 0 ids #{}]
        (if (= (count remaining) 0)
          true
          (let [descriptor (first remaining)
                id (get descriptor :module-source-id)]
            (if (sh07-b51-linked-module-source-shape? descriptor ordinal)
              (if (contains? ids id)
                false
                (recur (rest remaining) (+ ordinal 1) (conj ids id)))
              false))))
      false)
    false))

(defn sh07-b51-linked-plan-carriers-shape? [descriptors carriers]
  (if (vector? carriers)
    (if (= (count carriers) 7)
      (loop [remaining carriers ordinal 0 ids #{}]
        (if (= (count remaining) 0)
          true
          (let [carrier (first remaining)
                descriptor (get descriptors ordinal)
                plan (get carrier :plan)
                plan-id (get carrier :plan-id)]
            (if (sh07-b51-exact-keys?
                 carrier #{:module-ordinal :module-source-id :plan-id :plan})
              (if (= (get carrier :module-ordinal) ordinal)
                (if (= (get carrier :module-source-id)
                       (get descriptor :module-source-id))
                  (if (map? plan)
                    (if (= (get plan :plan-id) plan-id)
                      (if (= (get plan :sh07-b51-module-source-id)
                             (get carrier :module-source-id))
                        (if (sh07-b51-sha256-id? plan-id)
                          (if (contains? ids plan-id)
                            false
                            (recur
                             (rest remaining) (+ ordinal 1)
                             (conj ids plan-id)))
                          false)
                        false)
                      false)
                    false)
                  false)
                false)
              false))))
      false)
    false))


                      false)
                    false)
                  false)
                false)
              false))))
      false)))

(defn sh07-b51-r1-routes-valid?
  [routes edges descriptors plan-carriers]
  (if (if (vector? routes) (= (count routes) (count edges)) false)
    (let [indexes (sh07-b51-r1-edge-join-indexes descriptors)]
      (if (= (get indexes :status) :accepted)
        (loop [ordinal 0 remaining edges]
          (if (= (count remaining) 0)

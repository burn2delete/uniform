(defn sh07-b51-r1-find-one [records field value]
  (loop [remaining records found nil matches 0]
    (if (= (count remaining) 0)
      {:value found :count matches}
      (let [row (first remaining)
            selected? (= (get row field) value)]
        (recur (rest remaining)
               (if selected? row found)
               (if selected? (+ matches 1) matches))))))

(defn sh07-b51-r1-index-unique-records [records field maximum]
  (if (vector? records)
    (if (<= (count records) maximum)
      (loop [remaining records by-key {}]
        (if (= (count remaining) 0)
          {:status :accepted :by-key by-key}
          (let [row (first remaining)
                key (get row field)]
            (if (contains? by-key key)
              {:status :rejected :reason :duplicate-index-key}
              (recur (rest remaining) (assoc by-key key row))))))
      {:status :rejected :reason :index-bound})
    {:status :rejected :reason :index-shape}))

(defn sh07-b51-r1-edge-join-indexes [descriptors]
  (if (if (vector? descriptors) (= (count descriptors) 7) false)
    (loop [remaining descriptors
           descriptor-by-source {}
           definitions-by-source {}
           externals-by-source {}]
      (if (= (count remaining) 0)
        {:status :accepted
         :descriptor-by-source descriptor-by-source
         :definitions-by-source definitions-by-source
         :externals-by-source externals-by-source}
        (let [descriptor (first remaining)
              source-id (get descriptor :module-source-id)
              definitions
              (sh07-b51-r1-index-unique-records
               (get descriptor :definitions) :name 2440)
              externals
              (sh07-b51-r1-index-unique-records
               (get descriptor :external-bindings) :symbol 2440)]
          (if (sh07-b51-sha256-id? source-id)
            (if (contains? descriptor-by-source source-id)
              {:status :rejected :reason :duplicate-module-source-id}
              (if (= (get definitions :status) :accepted)
                (if (= (get externals :status) :accepted)
                  (recur
                   (rest remaining)
                   (assoc descriptor-by-source source-id descriptor)
                   (assoc definitions-by-source source-id
                          (get definitions :by-key))
                   (assoc externals-by-source source-id
                          (get externals :by-key)))
                  externals)
                definitions))
            {:status :rejected :reason :invalid-module-source-id}))))
    {:status :rejected :reason :descriptor-index-shape}))

(defn sh07-b51-r1-owner-edge-kind [caller-owner callee-owner]
  (if (= caller-owner callee-owner)
    (if (= caller-owner :r1-producer)
      :producer-internal
      (if (= caller-owner :r6-independent-verifier)
        :root6-internal
        nil))
    (if (if (= caller-owner :r8-finalizer)
          (= callee-owner :r1-producer)
          false)
      :root8-to-producer-interface
      nil)))

(defn sh07-b51-r1-indexed-edge-join [indexes edge ordinal]
  (if (sh07-b51-exact-keys?
       edge
       #{:ordinal :caller-module-source-id :caller-function
         :caller-function-source-hash :callsite-path
         :callee-module-source-id :callee-function
         :callee-function-source-hash :arity :owner-edge
         :authorization})
    (let [caller-id (get edge :caller-module-source-id)
          callee-id (get edge :callee-module-source-id)
          caller (get (get indexes :descriptor-by-source) caller-id)
          callee (get (get indexes :descriptor-by-source) callee-id)
          caller-definition
          (get (get (get indexes :definitions-by-source) caller-id)
               (get edge :caller-function))
          callee-definition
          (get (get (get indexes :definitions-by-source) callee-id)
               (get edge :callee-function))
          binding-value
          (get (get (get indexes :externals-by-source) caller-id)
               (get edge :callee-function))
          expected-owner
          (sh07-b51-r1-owner-edge-kind
           (get caller :owner) (get callee :owner))]
      (if (if (map? caller)
            (if (map? callee)
              (if (map? caller-definition)
                (if (map? callee-definition)
                  (if (map? binding-value)
                    (if (= expected-owner nil) false true) false)
                  false)
                false)
              false)
            false)
        (if (= [(get edge :ordinal)
                (get edge :caller-function-source-hash)
                (get edge :callee-function-source-hash)
                (get edge :arity)
                (get edge :owner-edge)
                (get edge :authorization)]
               [ordinal
                (get caller-definition :source-hash)
                (get callee-definition :source-hash)
                (get callee-definition :arity)
                expected-owner
                :authenticated-b51-namespace-external])
          (if (= (set (keys binding-value))
                 #{:symbol :callee-module-ordinal :callee-module
                   :callee-source-sha256
                   :callee-definition-source-hash :arity :owner-edge})
            (if (= [(get binding-value :symbol)
                    (get binding-value :callee-module-ordinal)
                    (get binding-value :callee-module)
                    (get binding-value :callee-source-sha256)
                    (get binding-value :callee-definition-source-hash)
                    (get binding-value :arity)
                    (get binding-value :owner-edge)]
                   [(get edge :callee-function)
                    (get callee :module-ordinal)
                    (get callee :module)
                    (get callee :source-sha256)
                    (get edge :callee-function-source-hash)
                    (get edge :arity)
                    expected-owner])
              {:status :accepted :caller caller :callee callee}
              {:status :rejected :reason :external-binding-mismatch})
            {:status :rejected :reason :external-binding-mismatch})
          {:status :rejected :reason :edge-identity-mismatch})
        {:status :rejected :reason :missing-edge-coordinate}))
    {:status :rejected :reason :edge-shape}))

(defn sh07-b51-r1-module-and-root-joins?
  [descriptors plan-carriers manifest inputs physical]
  (let [source-identities (get inputs :module-source-identities)
        source-byte-counts (get inputs :module-source-byte-counts)
        m0-ids (get inputs :m0-ids)
        m2-ids (get inputs :m2-ids)
        module-censuses (get physical :module-censuses)]
    (if (sh07-b51-linked-module-sources-shape? descriptors)
      (if (sh07-b51-linked-plan-carriers-shape?
           descriptors plan-carriers)
        (loop [ordinal 0]
          (if (= ordinal 7)
            true
            (let [descriptor (get descriptors ordinal)
                  plan-row (get plan-carriers ordinal)
                  plan (get plan-row :plan)
                  census (get module-censuses ordinal)]
              (if (= [(get descriptor :source-sha256)
                      (get descriptor :source-byte-count)
                      (get descriptor :module-source-id)
                      (get plan-row :plan-id)
                      (get plan :plan-id)
                      (get plan :sh07-b51-module-source-id)
                      (get plan :sh07-b51-link-manifest-id)
                      (get (get plan :source) :sha256)
                      (get (get plan :module) :module)
                      (get (get plan :compiler) :source-content-hash)
                      (get (get plan :compiler) :semantic-hash)]
                     [(get source-identities ordinal)
                      (get source-byte-counts ordinal)
                      (get m0-ids ordinal)
                      (get m2-ids ordinal)
                      (get m2-ids ordinal)
                      (get m0-ids ordinal)
                      (get manifest :manifest-id)
                      (get descriptor :source-sha256)
                      (get descriptor :module)
                      (get inputs :emitter-source-id)
                      (get inputs :emitter-semantic-id)])
                (if (= [(get census :module-ordinal)
                        (get census :module)
                        (get census :logical-source-path)
                        (get census :owner)
                        (get census :source-byte-count)
                        (get census :source-sha256)
                        (get census :module-source-id)
                        (get census :plan-id)
                        (get census :physical-definition-count)
                        (get census :core-binding-count)
                        (get census :lexical-binding-count)
                        (get census :external-binding-count)
                        (get census :aggregate-binding-count)]
                       [ordinal
                        (get descriptor :module)
                        (get descriptor :logical-source-path)
                        (get descriptor :owner)
                        (get descriptor :source-byte-count)
                        (get descriptor :source-sha256)
                        (get descriptor :module-source-id)
                        (get plan-row :plan-id)
                        (count (get descriptor :definitions))
                        (get descriptor :core-binding-count)
                        (get descriptor :lexical-binding-count)
                        (count (get descriptor :external-bindings))
                        (get descriptor :aggregate-binding-count)])
                  (recur (+ ordinal 1))
                  false)
                false))))
        false)
      false)))

(defn sh07-b51-r1-expected-public-roots [plan-carriers]
  [[1 'sh07-b51-build-template 1 3]
   [2 'sh07-b51-verify-template 3 3]
   [3 'sh07-b51-resolve-digest-preimage 3 2]
   [4 'sh07-b51-resolve-template 3 3]

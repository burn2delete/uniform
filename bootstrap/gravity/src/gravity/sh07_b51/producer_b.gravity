     :partial-products []}))

(defn sh07-b51-authenticate-owner-body-node-digest-joins
  [body-node-records digest-requests]
  (if (vector? body-node-records)
    (loop [remaining body-node-records result []]
      (if (= (count remaining) 0)
        {:status :accepted
         :records result
         :all-core-node-purpose-preimages-joined true}
        (let [record (first remaining)
              joined
              (sh07-b51-authenticate-internal-digest-reference
               (get record :node-id) digest-requests
               :sh07-b51-core-node-id
               (get record :core-node-preimage))]
          (if (= (get joined :status) :accepted)
            (let [source (get (get record :core-node-preimage) :source)
                  issued (get joined :request)]
              (if (= (get source :form-id) (get record :form-id))
                (if (= (get source :syntax-id) (get record :syntax-id))
                  (if (= (get issued :batch-ordinal)
                         (get record :core-postorder-index))
                    (if (= (get issued :subtier-ordinal)
                           (get record :core-postorder-index))
                      (recur (rest remaining) (conj result record))
                      {:status :rejected
                       :reason :body-node-core-subtier-postorder-substitution
                       :partial-products []})
                    {:status :rejected
                     :reason :body-node-core-postorder-substitution
                     :partial-products []})
                  {:status :rejected
                   :reason :body-node-core-source-syntax-substitution
                   :partial-products []})
                {:status :rejected
                 :reason :body-node-core-source-form-substitution
                 :partial-products []}))
            joined))))
    {:status :rejected :reason :owner-body-node-record-vector
     :partial-products []}))

(defn sh07-b51-build-owner-core-node-authenticated-requests
  [request foundation body-node-records target-id
   predecessor-authority context digest-requests]
  (let [structural
        (sh07-b51-authenticate-owner-body-node-records
         request foundation body-node-records)]
    (if (= (get structural :status) :accepted)
      (let [joined
            (sh07-b51-authenticate-owner-body-node-digest-joins
             body-node-records digest-requests)]
        (if (= (get joined :status) :accepted)
          (sh07-b51-build-owner-core-node-preimage
           request foundation (get structural :node-ids) target-id
           predecessor-authority context)
          joined))
      structural)))

(defn sh07-b51-authenticated-operator-symbol [indexes form]

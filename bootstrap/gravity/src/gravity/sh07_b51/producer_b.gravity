 sh07-b51-v16-replay-bounds-value
 []
 {:maximum-bindings 2048,
  :maximum-forms 65536,
  :maximum-module-recur-transfer-records 65536,
  :maximum-match-branch-records 1024,
  :maximum-match-pattern-depth 64,
  :maximum-module-loop-binding-records 65536,
  :maximum-generated-digest-carrier-width 65536,
  :maximum-error-transfer-records 1024,
  :maximum-generated-digest-carrier-nodes 16777216,
  :maximum-resolved-core-carrier-nodes 16777216,
  :maximum-module-error-transfer-records 65536,
  :maximum-resolved-core-carrier-width 65536,
  :maximum-var-reference-records 1024,
  :maximum-module-bindings 2440,
  :maximum-generated-digest-scalar-bytes 1073741824,
  :maximum-resolved-core-carrier-depth 256,
  :maximum-recur-target-depth 256,
  :maximum-form-children 1024,
  :maximum-effects 128,
  :maximum-module-call-records 65536,
  :maximum-match-decision-skeletons 1024,
  :maximum-template-carrier-depth 256,
  :maximum-exports 1024,
  :maximum-template-scalar-bytes 1073741824,
  :maximum-module-error-handler-records 65536,
  :maximum-module-control-flow-records 65536,
  :maximum-module-match-pattern-records 65536,
  :maximum-origin-entries 256,
  :maximum-carrier-depth 256,
  :maximum-carrier-width 65536,
  :maximum-module-var-reference-records 65536,
  :maximum-lexical-binding-records 1024,
  :maximum-loop-binding-records 1024,
  :maximum-module-match-decision-skeletons 65536,
  :maximum-resolutions 2048,
  :maximum-core-nodes 1024,
  :maximum-scalar-bytes 268435456,
  :maximum-module-mutation-records 65536,
  :maximum-keyword-lookup-records 1024,
  :maximum-module-resolutions 65536,
  :component-maxima-simultaneous? false,
  :maximum-match-pattern-width 256,
  :maximum-form-depth 256,
  :maximum-error-handler-records 1024,
  :maximum-template-carrier-nodes 33554432,
  :maximum-module-recur-target-records 65536,
  :maximum-resolved-core-scalar-bytes 1073741824,
  :maximum-call-records 1024,
  :maximum-control-flow-records 1024,
  :maximum-reference-use-records 1024,
  :maximum-module-lexical-binding-records 65536,
  :maximum-recur-transfer-records 1024,
  :maximum-template-carrier-width 65536,
  :maximum-top-level-forms 1024,
  :maximum-match-pattern-records 1024,
  :aggregate-limit-policy :effective-over-combined-carriers,
  :maximum-recur-target-records 1024,
  :maximum-combined-lexical-loop-records 65536,
  :maximum-module-match-branch-records 65536,
  :maximum-module-reference-use-records 65536,
  :maximum-metadata-entries 256,
  :maximum-digest-requests 65540,
  :maximum-module-core-nodes 65536,

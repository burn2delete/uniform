(defn sh07-b51-v16-form-root-id [indexes form]
  (loop [current form depth 0]
    (if (> depth 256)
      nil
      (let [parent-id (get current :parent-form-id)]
        (if (= parent-id nil)
          (get current :form-id)
          (let [parent (sh07-b51-find-form indexes parent-id)]
            (if (map? parent)
              (recur parent (+ depth 1)) nil)))))))

(defn sh07-b51-v16-form-ids-belong-to-root?
  [indexes form-ids root-id]
  (loop [remaining form-ids]
    (if (= (count remaining) 0)
      true
      (let [form (sh07-b51-find-form indexes (first remaining))]
        (if (map? form)
          (if (= (sh07-b51-v16-form-root-id indexes form) root-id)
            (recur (rest remaining)) false)
          false)))))

(defn sh07-b51-v16-fragment-local-binding-ids
  [request indexes root-id]
  (loop [remaining (get request :binding-table) result []]
    (if (= (count remaining) 0)
      result
      (let [binding (first remaining)
            definition
            (sh07-b51-find-form-by-syntax
             indexes (get binding :definition-syntax-id))]
        (if (if (map? definition)
              (= (sh07-b51-v16-form-root-id indexes definition) root-id)
              false)
          (recur
           (rest remaining) (conj result (get binding :binding-id)))
          (recur (rest remaining) result))))))

(defn sh07-b51-v16-fragment-resolution-records
  [request indexes root-id]
  (loop [remaining (get request :resolution-table) result []]

                                      (if (= provenance nil) false true)
                                      callee (if (map? value)
                                               (get value :function) nil)
                                      exact?
                                      (if has-provenance?
                                        (if (contains?
                                             (sh07-b51-r1-linked-internal-builtins)
                                             callee)
                                          (= provenance
                                             {:artifact
                                              :gravity/sh07-compiler-internal-call-provenance-v2
                                              :manifest-id
                                              (get manifest :manifest-id)
                                              :module-source-id
                                              (get descriptor :module-source-id)
                                              :source-sha256
                                              (get descriptor :source-sha256)
                                              :function caller
                                              :function-source-hash
                                              (get (get source-row :value)
                                                   :source-hash)
                                              :callee callee})
                                          false)
                                        true)
                                      components
                                      (sh07-b51-r1-linked-m2-instruction-children
                                       value)]
                                  (recur
                                   (sh07-b51-vector-append
                                    (rest frontier) components)
                                   (if accepted? exact? false)
                                   (if has-provenance? (+ total 1) total)))))]
                        (recur (rest remaining)
                               (get scanned :valid?)
                               (get scanned :count)))))]
              (recur (rest descriptors-left)
                     (get result :valid?) (get result :count)))))]
    (if (get checked :valid?)
      (= (get checked :count) expected-count) false)))

(defn sh07-b51-implementation-preimage-for-carrier?
  [carrier preimage]
  (let [linked-carrier (get carrier :v18-executable-descriptor)]
    (if (sh07-b51-exact-keys?

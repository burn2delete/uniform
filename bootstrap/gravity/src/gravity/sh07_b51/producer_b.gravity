           :semantic-manifest :semantic-root-hash})
      (if (= (get preimage :domain)
             :gravity/sh07-b51-linked-implementation-semantic-id-preimage-v3)
        (if (= (get preimage :schema-version) 3)
          (if (= (get preimage :predecessor-executable-descriptor)
                 (get carrier :predecessor-executable-descriptor))
            (if (= (get preimage :semantic-manifest)
                   (get linked-carrier :semantic-manifest))
              (= (get preimage :semantic-root-hash)
                 (get linked-carrier :semantic-root-hash))
              false)
            false)
          false)
        false)
      false)))


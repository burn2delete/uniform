                 (if (> (get record :maximum-depth) maximum-depth)
                   (get record :maximum-depth) maximum-depth))
          {:status :rejected :reason :output-byte-limit})))))

(defn sh07-b51-producer-decoration-for-form
  [indexes form-id depth ancestry]
  (if (> depth 96) {:status :rejected :reason :depth-limit}
    (if (contains? ancestry form-id)
      {:status :rejected :reason :cyclic-form}
      (let [form (sh07-b51-find-form indexes form-id)
            kind (get form :kind)
            children (get form :child-form-ids)]
        (if (map? form)
          (if (contains? #{:vector :list :map :set} kind)
            (if (<= (count children) 512)
              (let [decorated
                    (loop [remaining children result []]
                      (if (= (count remaining) 0)
                        {:status :accepted :records result}
                        (let [next
                              (sh07-b51-producer-decoration-for-form
                               indexes (first remaining) (+ depth 1)
                               (conj ancestry form-id))]
                          (if (= (get next :status) :accepted)
                            (recur (rest remaining) (conj result next)) next))))]
                (if (= (get decorated :status) :accepted)
                  (let [records (get decorated :records)]
                    (if (= kind :map)
                      (if (sh07-b51-producer-even-natural? (count records))
                        (let [entries
                              (loop [remaining records ids children result []]
                                (if (= (count remaining) 0) result
                                  (recur (vec (rest (rest remaining)))
                                         (vec (rest (rest ids)))
                                         (conj result
                                               {:key (first remaining)
                                                :value (get remaining 1)
                                                :key-id (first ids)
                                                :value-id (get ids 1)}))))
                              ordered
                              (loop [remaining entries result []]
                                (if (= (count remaining) 0) result
                                  (recur (rest remaining)
                                         (sh07-b51-producer-insert-decoration
                                          result (first remaining) true))))
                              rendered
                              (loop [remaining ordered result [] ids []]
                                (if (= (count remaining) 0)
                                  {:records result :child-ids ids}
                                  (let [entry (first remaining)
                                        key-depth
                                        (get (get entry :key) :maximum-depth)
                                        value-depth
                                        (get (get entry :value) :maximum-depth)]
                                    (recur
                                     (rest remaining)
                                     (conj result
                                           {:status :accepted
                                            :text (str (get (get entry :key) :text)
                                                       " "
                                                       (get (get entry :value) :text))
                                            :nodes (+ (get (get entry :key) :nodes)
                                                      (get (get entry :value) :nodes))
                                            :maximum-depth
                                            (if (> key-depth value-depth)
                                              key-depth value-depth)})
                                     (conj (conj ids (get entry :key-id))
                                           (get entry :value-id))))))
                              joined
                              (sh07-b51-producer-join-decoration
                               "{" ", " "}" (get rendered :records) depth)]
                          (if (= (get joined :status) :accepted)
                            (assoc joined :child-form-ids
                                   (get rendered :child-ids)) joined))
                        {:status :rejected :reason :map-width})
                      (if (= kind :set)
                        (let [paired
                              (loop [remaining records ids children result []]
                                (if (= (count remaining) 0) result
                                  (recur (rest remaining) (rest ids)
                                         (conj result
                                               (assoc (first remaining)
                                                      :child-id (first ids))))))
                              ordered
                              (loop [remaining paired result []]
                                (if (= (count remaining) 0) result
                                  (recur (rest remaining)
                                         (sh07-b51-producer-insert-decoration
                                          result (first remaining) false))))
                              joined
                              (sh07-b51-producer-join-decoration
                               "#{" " " "}" ordered depth)]
                          (if (= (get joined :status) :accepted)
                            (assoc joined :child-form-ids
                                   (loop [remaining ordered result []]
                                     (if (= (count remaining) 0) result
                                       (recur (rest remaining)
                                              (conj result
                                                    (get (first remaining)
                                                         :child-id))))))
                            joined))
                        (let [joined
                              (sh07-b51-producer-join-decoration
                               (if (= kind :vector) "[" "(") " "
                               (if (= kind :vector) "]" ")") records depth)]
                          (if (= (get joined :status) :accepted)
                            (assoc joined :child-form-ids children) joined)))))
                  decorated))
              {:status :rejected :reason :collection-width-limit})
            (let [scalar (sh07-b51-producer-scalar-decoration form)]
              (if (= (get scalar :status) :accepted)
                (assoc scalar :nodes 1 :maximum-depth depth
                       :child-form-ids []) scalar)))
          {:status :rejected :reason :form-missing})))))

(defn sh07-b51-producer-ordered-child-form-ids [indexes form]
  (let [decorated
        (sh07-b51-producer-decoration-for-form
         indexes (get form :form-id) 0 #{})]
    (if (= (get decorated :status) :accepted)
      {:status :accepted :child-form-ids
       (get decorated :child-form-ids)}
      {:status :rejected :reason (get decorated :reason)
       :partial-products []})))

(defn sh07-b51-core-expression-child-ids [indexes form]
  (let [kind (get form :kind)
        children (get form :child-form-ids)
        operator (sh07-b51-authenticated-operator-symbol indexes form)]
    (if (= kind :list)
      (if (= operator 'quote)
        {:status :accepted :child-form-ids []}
        (if (= operator 'var)
          {:status :accepted :child-form-ids []}
          (if (= operator 'fn)
            (if (= (count children) 3)
              {:status :accepted :child-form-ids [(get children 2)]}
              {:status :rejected :reason :fn-shape :partial-products []})
            (if (= operator 'def)
              (if (= (count children) 3)
                {:status :accepted :child-form-ids [(get children 2)]}
                {:status :rejected :reason :def-shape :partial-products []})
              (if (= operator 'if)
                (if (= (count children) 4)
                  {:status :accepted
                   :child-form-ids (sh07-b51-vector-tail-after children 1)}
                  {:status :rejected :reason :if-shape
                   :partial-products []})
                (if (= operator 'do)
                  (if (> (count children) 1)
                    {:status :accepted
                     :child-form-ids
                     (sh07-b51-vector-tail-after children 1)}
                    {:status :rejected :reason :do-shape
                     :partial-products []})
                  (if (contains? #{'let 'loop} operator)
                    (sh07-b51-let-loop-core-child-ids indexes form)
                    (if (= operator 'recur)
                      {:status :accepted
                       :child-form-ids
                       (sh07-b51-vector-tail-after children 1)}
                      (if (= operator 'set!)
                        (if (= (count children) 3)
                          {:status :accepted
                           :child-form-ids [(get children 2)]}
                          {:status :rejected :reason :set-shape
                           :partial-products []})
                        (if (= operator 'throw)
                          (if (= (count children) 2)
                            {:status :accepted
                             :child-form-ids [(get children 1)]}
                            {:status :rejected :reason :throw-shape
                             :partial-products []})
                          (if (= operator 'try)
                            (sh07-b51-try-core-child-ids indexes form)
                            (if (= operator 'match)
                              (sh07-b51-match-core-child-ids form)
                              (if (contains? #{'catch 'finally 'ns} operator)
                                {:status :rejected
                                 :reason :non-expression-operator
                                 :partial-products []}
                                {:status :accepted
                                 :child-form-ids children})))))))))))))
      (if (contains? #{:vector :map :set} kind)
        (sh07-b51-producer-ordered-child-form-ids indexes form)
        {:status :accepted :child-form-ids []}))))

(defn sh07-b51-direct-child-occurrences [child-ids first-index]
  (loop [remaining child-ids index 0 result []]
    (if (= (count remaining) 0)
      result
      (recur
       (rest remaining) (+ index 1)
       (if (>= index first-index)
         (conj result {:form-id (first remaining)
                       :relative-path [index]})
         result)))))

(defn sh07-b51-alternating-child-occurrences
  [child-ids first-index path-prefix]
  (loop [remaining child-ids index 0 select? true result []]
    (if (= (count remaining) 0)
      result
      (if (< index first-index)
        (recur (rest remaining) (+ index 1) select? result)
        (recur
         (rest remaining) (+ index 1) (if select? false true)
         (if select?
           (conj result
                 {:form-id (first remaining)
                  :relative-path
                  (sh07-b51-vector-append path-prefix [index])})
           result))))))

(defn sh07-b51-let-loop-child-occurrences [indexes form]
  (let [children (get form :child-form-ids)
        binding (sh07-b51-find-form indexes (get children 1))]
    (sh07-b51-vector-append
     (sh07-b51-alternating-child-occurrences
      (get binding :child-form-ids) 1 [1])
     (sh07-b51-direct-child-occurrences children 2))))

(defn sh07-b51-try-child-occurrences [indexes form]
  (let [children (get form :child-form-ids)]
    (loop [remaining (sh07-b51-vector-tail-after children 2)
           raw-index 2 result [{:form-id (get children 1)
                                :relative-path [1]}]]
      (if (= (count remaining) 0)
        result
        (let [clause (sh07-b51-find-form indexes (first remaining))]
          (recur
           (rest remaining) (+ raw-index 1)
           (conj result
                 {:form-id (get (get clause :child-form-ids) 3)
                  :relative-path [raw-index 3]})))))))

(defn sh07-b51-match-child-occurrences [form]
  (let [children (get form :child-form-ids)]
    (sh07-b51-vector-append
     [{:form-id (get children 1) :relative-path [1]}]
     (sh07-b51-alternating-child-occurrences children 3 []))))

(defn sh07-b51-core-expression-child-occurrences [indexes form]
  (let [kind (get form :kind)
        children (get form :child-form-ids)
        operator (sh07-b51-authenticated-operator-symbol indexes form)]
    (if (= kind :list)
      (if (contains? #{'quote 'var} operator)
        []
        (if (contains? #{'fn 'def} operator)
          [{:form-id (get children 2) :relative-path [2]}]
          (if (contains? #{'if 'do 'recur} operator)
            (sh07-b51-direct-child-occurrences children 1)
            (if (contains? #{'let 'loop} operator)
              (sh07-b51-let-loop-child-occurrences indexes form)
              (if (= operator 'set!)
                [{:form-id (get children 2) :relative-path [2]}]
                (if (= operator 'throw)
                  [{:form-id (get children 1) :relative-path [1]}]
                  (if (= operator 'try)
                    (sh07-b51-try-child-occurrences indexes form)
                    (if (= operator 'match)
                      (sh07-b51-match-child-occurrences form)
                      (sh07-b51-direct-child-occurrences children 0)))))))))
      (if (contains? #{:vector :map :set} kind)
        (let [ordered (sh07-b51-producer-ordered-child-form-ids indexes form)]
          (if (= (get ordered :status) :accepted)
            (sh07-b51-direct-child-occurrences
             (get ordered :child-form-ids) 0) []))
        []))))

(defn sh07-b51-child-occurrences-align?
  [child-form-ids child-occurrences]
  (if (= (count child-form-ids) (count child-occurrences))
    (loop [remaining-ids child-form-ids
           remaining-occurrences child-occurrences]
      (if (= (count remaining-ids) 0)
        true
        (if (= (first remaining-ids)
               (get (first remaining-occurrences) :form-id))
          (recur (rest remaining-ids) (rest remaining-occurrences))
          false)))
    false))

(defn sh07-b51-core-postorder-node-record-shape? [record]
  (if (sh07-b51-exact-keys?
       record
       #{:form-id :syntax-id :core-postorder-index
         :occurrence-path :child-core-postorder-indexes :spec})
    (if (sh07-b51-sha256-id? (get record :form-id))
      (if (sh07-b51-sha256-id? (get record :syntax-id))
        (if (sh07-b51-nonnegative-integer?
             (get record :core-postorder-index))
          (if (sh07-b51-nonnegative-path? (get record :occurrence-path))
            (if (vector? (get record :child-core-postorder-indexes))
            (if (loop [remaining
                       (get record :child-core-postorder-indexes)]
                  (if (= (count remaining) 0)
                    true
                    (if (sh07-b51-nonnegative-integer? (first remaining))
                      (if (< (first remaining)
                             (get record :core-postorder-index))
                        (recur (rest remaining))
                        false)
                      false)))
              (sh07-b51-occurrence-spec-shape? (get record :spec))
              false)
            false)
            false)
          false)
        false)
      false)
    false))

(defn sh07-b51-core-postorder-form
  [request indexes form next-core-index depth occurrence-path ancestry]
  (if (> depth 256)
    {:status :rejected :reason :core-postorder-depth
     :partial-products []}
    (if (sh07-b51-vector-contains? ancestry (get form :form-id))
      {:status :rejected :reason :core-postorder-cycle
       :partial-products []}
      (if (= form (sh07-b51-find-form indexes (get form :form-id)))
      (let [selected (sh07-b51-core-expression-child-ids indexes form)
            child-occurrences
            (sh07-b51-core-expression-child-occurrences indexes form)]
        (if (= (get selected :status) :accepted)
          (if (sh07-b51-child-occurrences-align?
               (get selected :child-form-ids) child-occurrences)
          (loop [remaining child-occurrences
                 ordinal next-core-index records [] child-indexes []]
            (if (= (count remaining) 0)
              (let [spec
                    {:record-kind :ordinary-core-node
                     :product-kind nil :event-kind nil
                     :form-id (get form :form-id) :event-form-id nil
                     :owner-form-id nil
                     :form-occurrence-path occurrence-path
                     :event-occurrence-path nil
                     :owner-occurrence-path nil
                     :core-postorder-index ordinal
                     :slot-ordinal nil :pattern-preorder-index nil
                     :local-use-index nil}
                    record
                    {:form-id (get form :form-id)
                     :syntax-id (get form :syntax-id)
                     :core-postorder-index ordinal
                     :occurrence-path occurrence-path
                     :child-core-postorder-indexes child-indexes
                     :spec spec}]
                (if (sh07-b51-core-postorder-node-record-shape? record)
                  {:status :accepted
                   :records (conj records record)
                   :root-core-postorder-index ordinal
                   :next-core-index (+ ordinal 1)}
                  {:status :rejected :reason :core-postorder-record-shape
                   :partial-products []}))
              (let [child-form
                    (sh07-b51-find-form
                     indexes (get (first remaining) :form-id))]
                (if (map? child-form)
                  (let [walked
                        (sh07-b51-core-postorder-form
                         request indexes child-form ordinal
                         (+ depth 1)
                         (sh07-b51-vector-append
                          occurrence-path
                          (get (first remaining) :relative-path))
                         (conj ancestry (get form :form-id)))]
                    (if (= (get walked :status) :accepted)
                      (recur
                       (rest remaining) (get walked :next-core-index)
                       (sh07-b51-vector-append
                        records (get walked :records))
                       (conj child-indexes
                             (get walked :root-core-postorder-index)))
                      walked))
                  {:status :rejected :reason :core-child-form-missing
                   :parent-form-id (get form :form-id)
                   :child-form-id (get (first remaining) :form-id)
                   :partial-products []}))))
          {:status :rejected :reason :core-child-occurrence-alignment
           :partial-products []})
          selected))
      {:status :rejected :reason :core-postorder-form-substitution
       :partial-products []}))))

(defn sh07-b51-independent-core-postorder [request]
  (let [indexes (sh07-b51-index-request request)
        root-ids (get request :top-level-form-ids)]
    (if (sh07-b51-indexes-unique? indexes)
      (if (sh07-b51-all-unique? root-ids)
        (loop [remaining root-ids root-occurrence-index 0
               next-core-index 0 records []]
          (if (= (count remaining) 0)
            {:status :accepted
             :records records
             :specs
             (loop [remaining-records records result []]
               (if (= (count remaining-records) 0)
                 result
                 (recur
                  (rest remaining-records)
                  (conj result (get (first remaining-records) :spec)))))
             :core-node-count (count records)
             :dense-postorder true
             :children-before-parent true}
            (let [form (sh07-b51-find-form indexes (first remaining))
                  operator (sh07-b51-authenticated-operator-symbol indexes form)]
              (if (= operator 'ns)
                (recur
                 (rest remaining) (+ root-occurrence-index 1)
                 next-core-index records)
                (let [walked
                      (sh07-b51-core-postorder-form
                       request indexes form next-core-index 0
                       [root-occurrence-index] [])]
                  (if (= (get walked :status) :accepted)
                    (recur
                     (rest remaining) (+ root-occurrence-index 1)
                     (get walked :next-core-index)
                     (sh07-b51-vector-append records (get walked :records)))
                    walked))))))
        {:status :rejected :reason :top-level-root-duplicate
         :partial-products []})
      {:status :rejected :reason :request-index-duplicate
       :partial-products []})))

(defn sh07-b51-occurrence-spec
  [record-kind product-kind event-kind form-id event-form-id owner-form-id
   core-index slot-ordinal pattern-index local-use-index]
  {:record-kind record-kind
   :product-kind product-kind
   :event-kind event-kind
   :form-id form-id
   :event-form-id event-form-id
   :owner-form-id owner-form-id
   :form-occurrence-path nil
   :event-occurrence-path nil
   :owner-occurrence-path nil
   :core-postorder-index core-index
   :slot-ordinal slot-ordinal
   :pattern-preorder-index pattern-index
   :local-use-index local-use-index})

(defn sh07-b51-slot-pattern-index-for-path [slot-plan path kind-class]
  (loop [remaining (get slot-plan :binding-extraction-preimages)
         found nil count-found 0]
    (if (= (count remaining) 0)
      (if (= count-found 1) found nil)
      (let [extraction (first remaining)
            kind (get extraction :kind)
            kind-matches
            (if (= kind-class :vector)
              (= kind :vector-node)
              (contains? #{:binding-leaf :wildcard-leaf} kind))]
        (if (if kind-matches (= (get extraction :path) path) false)
          (recur
           (rest remaining) (get extraction :pattern-node-ordinal)
           (+ count-found 1))
          (recur (rest remaining) found count-found))))))

(defn sh07-b51-slot-initializer-event-specs [foundation slot-plan]
  (let [owner-form-id
        (get (get foundation :owner-coordinate) :enclosing-form-id)
        initializer-form-id
        (get (get slot-plan :binding-slot-preimage) :initializer-form-id)
        slot-ordinal (get slot-plan :slot-ordinal)
        check-products
        (loop [remaining (get slot-plan :runtime-check-preimages)
               local-use 0 result []]
          (if (= (count remaining) 0)
            result
            (recur
             (rest remaining) (+ local-use 1)
             (conj result
                   (sh07-b51-occurrence-spec
                    :supplemental-product :vector-check :initializer
                    owner-form-id initializer-form-id owner-form-id nil
                    slot-ordinal
                    (sh07-b51-slot-pattern-index-for-path
                     slot-plan (get (first remaining) :path) :vector)
                    local-use)))))
        projection-products
        (loop [remaining (get slot-plan :terminal-projections)
               local-use 0 result []]
          (if (= (count remaining) 0)
            result
            (recur
             (rest remaining) (+ local-use 1)
             (conj result
                   (sh07-b51-occurrence-spec
                    :supplemental-product :terminal-projection :initializer
                    owner-form-id initializer-form-id owner-form-id nil
                    slot-ordinal
                    (sh07-b51-slot-pattern-index-for-path
                     slot-plan (get (first remaining) :path) :terminal)
                    local-use)))))
        check-records
        (loop [remaining (get slot-plan :runtime-check-preimages)
               local-use 0 result []]
          (if (= (count remaining) 0)
            result
            (recur
             (rest remaining) (+ local-use 1)
             (conj result
                   (sh07-b51-occurrence-spec
                    :runtime-check nil :initializer owner-form-id
                    initializer-form-id owner-form-id nil slot-ordinal
                    (sh07-b51-slot-pattern-index-for-path
                     slot-plan (get (first remaining) :path) :vector)
                    local-use)))))]
    (sh07-b51-vector-append
     (sh07-b51-vector-append
      [(sh07-b51-occurrence-spec
        :supplemental-product :slot-initializer :initializer
        owner-form-id initializer-form-id owner-form-id nil
        slot-ordinal nil 0)]
      (sh07-b51-vector-append
       check-products
       (sh07-b51-vector-append
        projection-products
        [(sh07-b51-occurrence-spec
          :supplemental-product :slot-publication :initializer
          owner-form-id initializer-form-id owner-form-id nil
          slot-ordinal nil 0)])))
     (sh07-b51-vector-append
      check-records
      [(sh07-b51-occurrence-spec
        :publication-event nil :initializer owner-form-id
        initializer-form-id owner-form-id nil nil nil slot-ordinal)]))))

(defn sh07-b51-owner-static-specs [foundation]
  (let [owner-form-id
        (get (get foundation :owner-coordinate) :enclosing-form-id)]
    (loop [remaining (get foundation :slot-plans) result []]
      (if (= (count remaining) 0)
        result
        (let [slot (first remaining)
              slot-ordinal (get slot :slot-ordinal)
              with-slot
              (conj result
                    (sh07-b51-occurrence-spec
                     :binding-slot nil nil owner-form-id nil owner-form-id
                     nil slot-ordinal nil nil))
              with-extractions
              (loop [remaining-extractions
                     (get slot :binding-extraction-preimages)
                     values with-slot]
                (if (= (count remaining-extractions) 0)
                  values
                  (let [extraction (first remaining-extractions)]
                    (recur
                     (rest remaining-extractions)
                     (conj values
                           (sh07-b51-occurrence-spec
                            :binding-extraction nil nil
                            (get extraction :form-id) nil owner-form-id nil
                            slot-ordinal
                            (get extraction :pattern-node-ordinal) nil))))))]
          (recur (rest remaining) with-extractions))))))

(defn sh07-b51-occurrence-group-add [groups trigger-form-id specs]
  (loop [remaining groups result [] found false]
    (if (= (count remaining) 0)
      (if found result
        (conj result {:trigger-form-id trigger-form-id :specs specs}))
      (let [group (first remaining)]
        (if (= (get group :trigger-form-id) trigger-form-id)
          (recur
           (rest remaining)
           (conj result
                 {:trigger-form-id trigger-form-id
                  :specs (sh07-b51-vector-append
                          (get group :specs) specs)})
           true)
          (recur (rest remaining) (conj result group) found))))))

(defn sh07-b51-owner-initializer-groups [foundation groups]
  (loop [remaining (get foundation :slot-plans) result groups]
    (if (= (count remaining) 0)
      result
      (let [slot (first remaining)
            initializer-form-id
            (get (get slot :binding-slot-preimage) :initializer-form-id)]
        (recur
         (rest remaining)
         (sh07-b51-occurrence-group-add
          result initializer-form-id
          (sh07-b51-slot-initializer-event-specs foundation slot)))))))

(defn sh07-b51-materialize-owner-foundations [request owner-plans]
  (let [collected (sh07-b51-collect-module-owner-slots request)
        indexes (sh07-b51-index-request request)]
    (if (= (get collected :status) :accepted)
      (if (vector? owner-plans)
        (if (= (count owner-plans) (count (get collected :owners)))
          (loop [remaining-plans owner-plans
                 remaining-owners (get collected :owners) result []]
            (if (= (count remaining-plans) 0)
              {:status :accepted :owners result
               :module-global-preflight
               (get collected :module-global-preflight)}
              (let [plan (first remaining-plans)
                    owner (first remaining-owners)]
                (if (sh07-b51-exact-keys?
                     plan
                     #{:owner-form-id :initialization-layout
                       :recur-layout-entries})
                  (if (= (get plan :owner-form-id)
                         (get owner :enclosing-form-id))
                    (let [form
                          (sh07-b51-find-form indexes
                                             (get plan :owner-form-id))
                          built
                          (if (= (get owner :owner-kind) :let)
                            (if (= (get plan :recur-layout-entries) [])
                              (sh07-b51-lower-let-slots-foundation
                               request form (get plan :initialization-layout))
                              {:status :rejected
                               :reason :let-recur-layout-forbidden
                               :partial-products []})
                            (sh07-b51-compose-loop-body-foundation
                             request form (get plan :initialization-layout)
                             (get plan :recur-layout-entries)))]
                      (if (= (get built :status) :accepted)
                        (recur
                         (rest remaining-plans) (rest remaining-owners)
                         (conj result
                               {:owner-kind (get owner :owner-kind)
                                :owner-form-id (get owner :enclosing-form-id)
                                :initialization-layout
                                (get plan :initialization-layout)
                                :recur-layout-entries
                                (get plan :recur-layout-entries)
                                :foundation
                                (if (= (get owner :owner-kind) :let)
                                  built (get built :loop-foundation))
                                :loop-recur-sites
                                (if (= (get owner :owner-kind) :loop)
                                  (get (get built :body-recur-foundation)
                                       :loop-recur-sites)
                                  [])}))
                        built))
                    {:status :rejected :reason :owner-plan-order
                     :partial-products []})
                  {:status :rejected :reason :owner-plan-shape
                   :partial-products []}))))
          {:status :rejected :reason :owner-plan-cardinality
           :partial-products []})
        {:status :rejected :reason :owner-plan-vector
         :partial-products []})
      collected)))

(defn sh07-b51-recur-site-product-specs
  [foundation recur-site recur-form-id]
  (let [owner-form-id
        (get (get foundation :owner-coordinate) :enclosing-form-id)
        check-products
        (loop [remaining-slots (get foundation :slot-plans)
               slot-ordinal 0 local-use 0 result []]
          (if (= (count remaining-slots) 0)
            result
            (let [slot (first remaining-slots)
                  with-slot
                  (loop [remaining
                         (get slot :binding-extraction-preimages)
                         values result next-local local-use]
                    (if (= (count remaining) 0)
                      {:values values :next-local next-local}
                      (let [extraction (first remaining)]
                        (if (= (get extraction :kind) :vector-node)
                          (recur
                           (rest remaining)
                           (conj values
                                 (sh07-b51-occurrence-spec
                                  :supplemental-product :vector-check :recur
                                  recur-form-id recur-form-id owner-form-id nil
                                  slot-ordinal
                                  (get extraction :pattern-node-ordinal)
                                  next-local))
                           (+ next-local 1))
                          (recur (rest remaining) values next-local)))))]
              (recur
               (rest remaining-slots) (+ slot-ordinal 1)
               (get with-slot :next-local) (get with-slot :values)))))
        projection-products
        (loop [remaining-slots (get foundation :slot-plans)
               slot-ordinal 0 local-use 0 result []]
          (if (= (count remaining-slots) 0)
            result
            (let [slot (first remaining-slots)
                  with-slot
                  (loop [remaining
                         (get slot :binding-extraction-preimages)
                         values result next-local local-use]
                    (if (= (count remaining) 0)
                      {:values values :next-local next-local}
                      (let [extraction (first remaining)]
                        (if (contains? #{:binding-leaf :wildcard-leaf}
                                       (get extraction :kind))
                          (recur
                           (rest remaining)
                           (conj values
                                 (sh07-b51-occurrence-spec
                                  :supplemental-product
                                  :terminal-projection :recur recur-form-id
                                  recur-form-id owner-form-id nil slot-ordinal
                                  (get extraction :pattern-node-ordinal)
                                  next-local))
                           (+ next-local 1))
                          (recur (rest remaining) values next-local)))))]
              (recur
               (rest remaining-slots) (+ slot-ordinal 1)
               (get with-slot :next-local) (get with-slot :values)))))
        arguments
        (loop [remaining (get recur-site :argument-evaluations)
               local-use 0 result []]
          (if (= (count remaining) 0)
            result
            (recur
             (rest remaining) (+ local-use 1)
             (conj result
                   (sh07-b51-occurrence-spec
                    :supplemental-product :recur-argument :recur
                    recur-form-id recur-form-id owner-form-id nil nil nil
                    local-use)))))]
    (sh07-b51-vector-append
     check-products
     (sh07-b51-vector-append
      projection-products
      (sh07-b51-vector-append
       arguments
       [(sh07-b51-occurrence-spec
         :supplemental-product :recur-commit :recur recur-form-id
         recur-form-id owner-form-id nil nil nil 0)])))))

(defn sh07-b51-recur-site-check-specs
  [foundation recur-site recur-form-id]
  (let [owner-form-id
        (get (get foundation :owner-coordinate) :enclosing-form-id)]
    (loop [remaining-vectors
           (get recur-site :runtime-check-preimage-vectors)
           remaining-slots (get foundation :slot-plans)
           slot-ordinal 0 local-use 0 result []]
      (if (= (count remaining-vectors) 0)
        result
        (let [slot (first remaining-slots)
              with-slot
              (loop [remaining (first remaining-vectors)
                     next-local local-use values result]
                (if (= (count remaining) 0)
                  {:next-local next-local :values values}
                  (let [check (first remaining)]
                    (recur
                     (rest remaining) (+ next-local 1)
                     (conj values
                           (sh07-b51-occurrence-spec
                            :runtime-check nil :recur recur-form-id
                            recur-form-id owner-form-id nil slot-ordinal
                            (sh07-b51-slot-pattern-index-for-path
                             slot (get check :path) :vector)
                            next-local))))))]
          (recur
           (rest remaining-vectors) (rest remaining-slots)
           (+ slot-ordinal 1) (get with-slot :next-local)
           (get with-slot :values)))))))

(defn sh07-b51-recur-site-specs
  [foundation recur-site recur-use-index]
  (let [recur-form-id
        (get (get recur-site :recur-coordinate) :recur-form-id)
        owner-form-id
        (get (get foundation :owner-coordinate) :enclosing-form-id)]
    (sh07-b51-vector-append
     (sh07-b51-recur-site-product-specs
      foundation recur-site recur-form-id)
     (sh07-b51-vector-append
      (sh07-b51-recur-site-check-specs
       foundation recur-site recur-form-id)
      [(sh07-b51-occurrence-spec
        :publication-event nil :recur recur-form-id recur-form-id
        owner-form-id nil nil nil recur-use-index)
       (sh07-b51-occurrence-spec
        :recur-slot-mapping nil :recur recur-form-id recur-form-id
        owner-form-id nil nil nil recur-use-index)]))))

(defn sh07-b51-materialized-occurrence-groups [materialized]
  (loop [remaining (get materialized :owners) groups []]
    (if (= (count remaining) 0)
      {:status :accepted :groups groups}
      (let [owner-entry (first remaining)
            foundation (get owner-entry :foundation)
            owner-form-id (get owner-entry :owner-form-id)
            with-initializers
            (sh07-b51-owner-initializer-groups foundation groups)
            with-static
            (sh07-b51-occurrence-group-add
             with-initializers owner-form-id
             (sh07-b51-owner-static-specs foundation))
            with-recurs
            (loop [remaining-sites (get owner-entry :loop-recur-sites)
                   recur-use-index 0 result with-static]
              (if (= (count remaining-sites) 0)
                result
                (let [site (first remaining-sites)
                      recur-form-id
                      (get (get site :recur-coordinate) :recur-form-id)]
                  (recur
                   (rest remaining-sites) (+ recur-use-index 1)
                   (sh07-b51-occurrence-group-add
                    result recur-form-id
                    (sh07-b51-recur-site-specs
                     foundation site recur-use-index))))))]
        (recur (rest remaining) with-recurs)))))

(defn sh07-b51-find-occurrence-group [groups form-id]
  (loop [remaining groups found nil count-found 0]
    (if (= (count remaining) 0)
      {:group found :count count-found}
      (if (= (get (first remaining) :trigger-form-id) form-id)
        (recur (rest remaining) (first remaining) (+ count-found 1))
        (recur (rest remaining) found count-found)))))

(defn sh07-b51-unique-occurrence-position-for-form [positions form-id]
  (loop [remaining positions found nil count-found 0]
    (if (= (count remaining) 0)
      {:position found :count count-found}
      (if (= (get (first remaining) :form-id) form-id)
        (recur (rest remaining) (first remaining) (+ count-found 1))
        (recur (rest remaining) found count-found)))))

(defn sh07-b51-attach-occurrence-spec-locators [positions specs]
  (loop [remaining specs result []]
    (if (= (count remaining) 0)
      {:status :accepted :specs result}
      (let [spec (first remaining)
            record-kind (get spec :record-kind)]
        (if (= record-kind :module-transcript)
          (recur (rest remaining) (conj result spec))
          (let [form-result
                (if (= record-kind :ordinary-core-node)
                  (sh07-b51-find-occurrence-position
                   positions (get spec :form-id)
                   (get spec :form-occurrence-path))
                  (sh07-b51-unique-occurrence-position-for-form
                   positions (get spec :form-id)))
                event-result
                (if (= (get spec :event-form-id) nil)
                  {:position nil :count 0}
                  (sh07-b51-unique-occurrence-position-for-form
                   positions (get spec :event-form-id)))
                owner-result
                (if (= (get spec :owner-form-id) nil)
                  {:position nil :count 0}
                  (sh07-b51-unique-occurrence-position-for-form
                   positions (get spec :owner-form-id)))]
            (if (= (get form-result :count) 1)
              (if (if (= (get spec :event-form-id) nil)
                    (= (get event-result :count) 0)
                    (= (get event-result :count) 1))
                (if (if (= (get spec :owner-form-id) nil)
                      (= (get owner-result :count) 0)
                      (= (get owner-result :count) 1))
                  (let [located
                        (assoc
                         (assoc
                          (assoc
                           spec :form-occurrence-path
                           (get (get form-result :position)
                                :occurrence-path))
                          :event-occurrence-path
                          (get (get event-result :position)
                               :occurrence-path))
                         :owner-occurrence-path
                         (get (get owner-result :position)
                              :occurrence-path))]
                    (if (sh07-b51-occurrence-spec-shape? located)
                      (recur (rest remaining) (conj result located))
                      {:status :rejected :reason :occurrence-locator-shape
                       :partial-products []}))
                  {:status :rejected
                   :reason :owner-occurrence-locator-ambiguous
                   :partial-products []})
                {:status :rejected
                 :reason :event-occurrence-locator-ambiguous
                 :partial-products []})
              {:status :rejected :reason :form-occurrence-locator-ambiguous
               :partial-products []})))))))

(defn sh07-b51-compose-expected-occurrence-specs
  [request owner-plans]
  (let [postorder (sh07-b51-independent-core-postorder request)
        materialized
        (sh07-b51-materialize-owner-foundations request owner-plans)]
    (if (= (get postorder :status) :accepted)
      (if (= (get materialized :status) :accepted)
        (let [group-result
              (sh07-b51-materialized-occurrence-groups materialized)]
          (if (= (get group-result :status) :accepted)
            (let [groups (get group-result :groups)
                  streamed
                  (loop [remaining (get postorder :records)
                         consumed #{} specs []]
                    (if (= (count remaining) 0)
                      {:status :accepted :specs specs :consumed consumed}
                      (let [record (first remaining)
                            form-id (get record :form-id)
                            selected
                            (sh07-b51-find-occurrence-group groups form-id)]
                        (if (> (get selected :count) 1)
                          {:status :rejected
                           :reason :occurrence-group-nonunique
                           :partial-products []}
                          (if (= (get selected :count) 1)
                            (if (contains? consumed form-id)
                              {:status :rejected
                               :reason :occurrence-group-ambiguous-form
                               :partial-products []}
                              (recur
                               (rest remaining) (conj consumed form-id)
                               (sh07-b51-vector-append
                                (conj specs (get record :spec))
                                (get (get selected :group) :specs))))
                            (recur
                             (rest remaining) consumed
                             (conj specs (get record :spec))))))))]
              (if (= (get streamed :status) :accepted)
                (if (= (count (get streamed :consumed)) (count groups))
                  (let [catalog (sh07-b51-form-position-catalog request)
                        with-transcript
                        (conj
                         (get streamed :specs)
                         (sh07-b51-occurrence-spec
                          :module-transcript nil nil nil nil nil nil nil nil nil))]
                    (if (= (get catalog :status) :accepted)
                      (let [located
                            (sh07-b51-attach-occurrence-spec-locators
                             (get catalog :positions) with-transcript)]
                        (if (= (get located :status) :accepted)
                          {:status :accepted
                           :specs (get located :specs)
                           :postorder-records (get postorder :records)
                           :materialized-owners (get materialized :owners)
                           :module-global-preflight
                           (get materialized :module-global-preflight)
                           :specs-independently-regenerated true}
                          located))
                      catalog))
                  {:status :rejected :reason :occurrence-group-unconsumed
                   :partial-products []})
                streamed))
            group-result))
        materialized)
      postorder)))

(defn sh07-b51-verify-and-replay-occurrence-specs
  [request owner-plans supplied-specs]
  (let [expected
        (sh07-b51-compose-expected-occurrence-specs request owner-plans)]
    (if (= (get expected :status) :accepted)
      (if (= supplied-specs (get expected :specs))
        (let [replayed
              (sh07-b51-replay-occurrence-specs-foundation
               request (get expected :specs))]
          (if (= (get replayed :status) :accepted)
            (assoc
             (assoc replayed :source-spec-regeneration :independent-exact)
             :admitting-success true)
            replayed))
        {:status :rejected :reason :occurrence-spec-replay-mismatch
         :expected-spec-count (count (get expected :specs))
         :observed-spec-count
         (if (vector? supplied-specs) (count supplied-specs) nil)
         :partial-products []})
      expected)))

(defn sh07-b51-occurrence-spec-semantic-equal? [left right]
  (loop [remaining
         [:record-kind :product-kind :event-kind :form-id :event-form-id
          :owner-form-id :core-postorder-index :slot-ordinal
          :pattern-preorder-index :local-use-index]]
    (if (= (count remaining) 0)
      true
      (if (= (get left (first remaining))
             (get right (first remaining)))
        (recur (rest remaining))
        false))))

(defn sh07-b51-find-semantic-replay-entry [entries spec]
  (loop [remaining entries found nil count-found 0]
    (if (= (count remaining) 0)
      {:entry found :count count-found}
      (let [entry (first remaining)]
        (if (sh07-b51-occurrence-spec-semantic-equal?
             (get entry :spec) spec)
          (recur (rest remaining) entry (+ count-found 1))
          (recur (rest remaining) found count-found))))))

(defn sh07-b51-find-event-replay-entry
  [entries record-kind event-kind event-form-id owner-form-id]
  (loop [remaining entries found nil count-found 0]
    (if (= (count remaining) 0)
      {:entry found :count count-found}
      (let [spec (get (first remaining) :spec)]
        (if (if (= (get spec :record-kind) record-kind)
              (if (= (get spec :event-kind) event-kind)
                (if (= (get spec :event-form-id) event-form-id)
                  (= (get spec :owner-form-id) owner-form-id)
                  false)
                false)
              false)
          (recur (rest remaining) (first remaining) (+ count-found 1))
          (recur (rest remaining) found count-found))))))

(defn sh07-b51-numbered-preimage-shape? [record-kind preimage]
  (if (= record-kind :supplemental-product)
    (sh07-b51-product-node-preimage-shape? preimage)
    (if (= record-kind :binding-slot)
      (sh07-b51-binding-slot-preimage-shape? preimage)
      (if (= record-kind :binding-extraction)
        (sh07-b51-binding-extraction-preimage-shape? preimage)
        (if (= record-kind :runtime-check)
          (if (sh07-b51-runtime-check-preimage-shape? preimage)
            true
            (sh07-b51-runtime-recur-check-preimage-shape? preimage))
          (if (= record-kind :publication-event)
            (sh07-b51-publication-event-preimage-shape? preimage)
            (if (= record-kind :recur-slot-mapping)
              (sh07-b51-recur-slot-mapping-preimage-shape? preimage)
              false)))))))

(defn sh07-b51-numbered-preimage-row
  [entries spec purpose reference preimage]
  (let [selected (sh07-b51-find-semantic-replay-entry entries spec)]
    (if (= (get selected :count) 1)
      (let [entry (get selected :entry)
            record-kind (get spec :record-kind)
            numbered-field
            (if (= record-kind :supplemental-product)
              :global-product-ordinal
              (if (= record-kind :binding-slot) :global-slot-ordinal
                (if (= record-kind :binding-extraction) :global-ordinal
                  (if (= record-kind :runtime-check)
                    :global-runtime-check-ordinal
                    (if (= record-kind :publication-event)
                      :global-publication-ordinal
                      (if (= record-kind :recur-slot-mapping)
                        :global-recur-mapping-ordinal nil))))))]
        (if (sh07-b51-internal-reference? reference)
          (if (if (keyword? numbered-field)
                (= (get preimage numbered-field)
                   (get entry :global-ordinal))
                false)
            (if (sh07-b51-numbered-preimage-shape? record-kind preimage)
            {:status :accepted
             :row {:record-kind record-kind
                   :purpose purpose
                   :reference reference
                   :spec (get entry :spec)
                   :occurrence-key (get entry :occurrence-key)
                   :global-ordinal (get entry :global-ordinal)
                   :preimage preimage}}
            {:status :rejected :reason :numbered-preimage-shape
             :partial-products []})
            {:status :rejected :reason :numbered-preimage-global-ordinal
             :partial-products []})
          {:status :rejected :reason :numbered-preimage-reference
           :partial-products []}))
      {:status :rejected :reason :numbered-preimage-occurrence-join
       :partial-products []})))

(defn sh07-b51-numbered-row-field [record-kind]
  (if (= record-kind :supplemental-product) :global-product-ordinal
    (if (= record-kind :binding-slot) :global-slot-ordinal
    (if (= record-kind :binding-extraction) :global-ordinal
      (if (= record-kind :runtime-check) :global-runtime-check-ordinal
        (if (= record-kind :publication-event)
          :global-publication-ordinal
          (if (= record-kind :recur-slot-mapping)
            :global-recur-mapping-ordinal nil)))))))

(defn sh07-b51-rewrite-numbered-preimage
  [entries spec purpose reference preimage authority-reference]
  (let [selected (sh07-b51-find-semantic-replay-entry entries spec)
        record-kind (get spec :record-kind)]
    (if (= (get selected :count) 1)
      (if (= (get preimage :predecessor-authority-id)
             authority-reference)
        (let [field (sh07-b51-numbered-row-field record-kind)
              rewritten
              (if (keyword? field)
                (assoc preimage field
                       (get (get selected :entry) :global-ordinal))
                preimage)]
          (sh07-b51-numbered-preimage-row
           entries spec purpose reference rewritten))
        {:status :rejected :reason :numbered-preimage-authority
         :partial-products []})
      {:status :rejected :reason :numbered-preimage-occurrence-join
       :partial-products []})))

(defn sh07-b51-select-occurrence-specs [specs record-kind]
  (loop [remaining specs result []]
    (if (= (count remaining) 0)
      result
      (recur
       (rest remaining)
       (if (= (get (first remaining) :record-kind) record-kind)
         (conj result (first remaining))
         result)))))

(defn sh07-b51-build-numbered-product-row
  [request entries spec reference authority-reference owner-coordinate]
  (let [selected (sh07-b51-find-semantic-replay-entry entries spec)
        indexes (sh07-b51-index-request request)
        form (sh07-b51-find-form indexes (get spec :form-id))]
    (if (= (get selected :count) 1)
      (if (map? form)
        (let [built
              (sh07-b51-product-preimage
               authority-reference (get (get selected :entry) :global-ordinal)
               (get spec :product-kind) owner-coordinate form)]
          (if (= (get built :status) :accepted)
            (sh07-b51-numbered-preimage-row
             entries spec :sh07-b51-product-node-id reference
             (get built :preimage))
            built))
        {:status :rejected :reason :numbered-product-source-form
         :partial-products []})
      {:status :rejected :reason :numbered-product-occurrence-join
       :partial-products []})))

(defn sh07-b51-build-numbered-product-rows
  [request entries specs references authority-reference owner-coordinate]
  (if (= (count specs) (count references))
    (loop [remaining-specs specs remaining-references references result []]
      (if (= (count remaining-specs) 0)
        {:status :accepted :rows result}
        (let [built
              (sh07-b51-build-numbered-product-row
               request entries (first remaining-specs)
               (first remaining-references) authority-reference
               owner-coordinate)]
          (if (= (get built :status) :accepted)
            (recur
             (rest remaining-specs) (rest remaining-references)
             (conj result (get built :row)))
            built))))
    {:status :rejected :reason :numbered-product-reference-cardinality
     :partial-products []}))

(defn sh07-b51-linked-publication-ordinal
  [entries spec]
  (let [selected
        (sh07-b51-find-event-replay-entry
         entries :publication-event (get spec :event-kind)
         (get spec :event-form-id) (get spec :owner-form-id))]
    (if (= (get selected :count) 1)
      {:status :accepted
       :global-publication-ordinal
       (get (get selected :entry) :global-ordinal)}
      {:status :rejected :reason :numbered-publication-event-join
       :partial-products []})))

(defn sh07-b51-rewrite-event-numbered-preimage
  [entries spec purpose reference preimage authority-reference]
  (let [record-kind (get spec :record-kind)
        publication
        (if (contains? #{:runtime-check :publication-event} record-kind)
          (sh07-b51-linked-publication-ordinal entries spec)
          {:status :accepted :global-publication-ordinal nil})]
    (if (= (get publication :status) :accepted)
      (let [ordinal (get publication :global-publication-ordinal)
            prepared
            (if (= record-kind :runtime-check)
              (assoc preimage :guarded-publication-ordinal ordinal)
              (if (= record-kind :publication-event)
                (assoc preimage :commit-order ordinal)
                preimage))]
        (sh07-b51-rewrite-numbered-preimage
         entries spec purpose reference prepared authority-reference))
      publication)))

(defn sh07-b51-build-numbered-use-rows
  [entries specs references preimages purpose authority-reference]
  (if (= (count specs) (count references))
    (if (= (count specs) (count preimages))
      (loop [remaining-specs specs remaining-references references
             remaining-preimages preimages result []]
        (if (= (count remaining-specs) 0)
          {:status :accepted :rows result}
          (let [built
                (sh07-b51-rewrite-event-numbered-preimage
                 entries (first remaining-specs) purpose
                 (first remaining-references) (first remaining-preimages)
                 authority-reference)]
            (if (= (get built :status) :accepted)
              (recur
               (rest remaining-specs) (rest remaining-references)
               (rest remaining-preimages) (conj result (get built :row)))
              built))))
      {:status :rejected :reason :numbered-use-preimage-cardinality
       :partial-products []})
    {:status :rejected :reason :numbered-use-reference-cardinality
     :partial-products []}))

(defn sh07-b51-slot-static-numbered-rows
  [entries owner-form-id slot-plan authority-reference]
  (let [slot-ordinal (get slot-plan :slot-ordinal)
        slot-spec
        (sh07-b51-occurrence-spec
         :binding-slot nil nil owner-form-id nil owner-form-id nil
         slot-ordinal nil nil)
        slot-entry (sh07-b51-find-semantic-replay-entry entries slot-spec)
        slot-row
        (sh07-b51-rewrite-numbered-preimage
         entries slot-spec :sh07-b51-binding-slot-id
         (get slot-plan :slot-id)
         (get slot-plan :binding-slot-preimage) authority-reference)]
    (if (= (get slot-row :status) :accepted)
      (if (= (get slot-entry :count) 1)
        (let [slot-global (get (get slot-entry :entry) :global-ordinal)]
          (loop [remaining-preimages
                 (get slot-plan :binding-extraction-preimages)
                 remaining-references (get slot-plan :extraction-ids)
                 rows [(get slot-row :row)]]
            (if (= (count remaining-preimages) 0)
              (if (= (count remaining-references) 0)
                {:status :accepted :rows rows}
                {:status :rejected
                 :reason :numbered-extraction-reference-cardinality
                 :partial-products []})
              (if (> (count remaining-references) 0)
                (let [preimage (first remaining-preimages)
                      spec
                      (sh07-b51-occurrence-spec
                       :binding-extraction nil nil
                       (get preimage :form-id) nil owner-form-id nil
                       slot-ordinal (get preimage :pattern-node-ordinal) nil)
                      prepared
                      (assoc preimage :global-slot-ordinal slot-global)
                      built
                      (sh07-b51-rewrite-numbered-preimage
                       entries spec :sh07-b51-binding-extraction-id
                       (first remaining-references) prepared
                       authority-reference)]
                  (if (= (get built :status) :accepted)
                    (recur
                     (rest remaining-preimages)
                     (rest remaining-references)
                     (conj rows (get built :row)))
                    built))
                {:status :rejected
                 :reason :numbered-extraction-reference-cardinality
                 :partial-products []}))))
        {:status :rejected :reason :numbered-slot-occurrence-join
         :partial-products []})
      slot-row)))

(defn sh07-b51-slot-initializer-numbered-rows
  [request entries foundation slot-plan authority-reference]
  (let [specs
        (sh07-b51-slot-initializer-event-specs foundation slot-plan)
        product-specs
        (sh07-b51-select-occurrence-specs specs :supplemental-product)
        check-specs (sh07-b51-select-occurrence-specs specs :runtime-check)
        publication-specs
        (sh07-b51-select-occurrence-specs specs :publication-event)
        products
        (sh07-b51-build-numbered-product-rows
         request entries product-specs (get slot-plan :product-node-ids)
         authority-reference (get foundation :owner-coordinate))]
    (if (= (get products :status) :accepted)
      (let [checks
            (sh07-b51-build-numbered-use-rows
             entries check-specs (get slot-plan :runtime-check-ids)
             (get slot-plan :runtime-check-preimages)
             :sh07-b51-runtime-check-id authority-reference)]
        (if (= (get checks :status) :accepted)
          (if (= (count publication-specs) 1)
            (let [publication
                  (sh07-b51-rewrite-event-numbered-preimage
                   entries (first publication-specs)
                   :sh07-b51-publication-event-id
                   (get slot-plan :publication-event-id)
                   (get slot-plan :publication-event-preimage)
                   authority-reference)]
              (if (= (get publication :status) :accepted)
                {:status :accepted
                 :rows
                 (sh07-b51-vector-append
                  (get products :rows)
                  (conj (get checks :rows) (get publication :row)))}
                publication))
            {:status :rejected
             :reason :numbered-initializer-publication-cardinality
             :partial-products []})
          checks))
      products)))

(defn sh07-b51-owner-initializer-numbered-rows
  [request entries owner-entry authority-reference]
  (let [foundation (get owner-entry :foundation)]
    (loop [remaining (get foundation :slot-plans) result []]
      (if (= (count remaining) 0)
        {:status :accepted :rows result}
        (let [built
              (sh07-b51-slot-initializer-numbered-rows
               request entries foundation (first remaining)
               authority-reference)]
          (if (= (get built :status) :accepted)
            (recur
             (rest remaining)
             (sh07-b51-vector-append result (get built :rows)))
            built))))))

(defn sh07-b51-owner-static-numbered-rows
  [entries owner-entry authority-reference]
  (loop [remaining (get (get owner-entry :foundation) :slot-plans)
         result []]
    (if (= (count remaining) 0)
      {:status :accepted :rows result}
      (let [built
            (sh07-b51-slot-static-numbered-rows
             entries (get owner-entry :owner-form-id) (first remaining)
             authority-reference)]
        (if (= (get built :status) :accepted)
          (recur
           (rest remaining)
           (sh07-b51-vector-append result (get built :rows)))
          built)))))

(defn sh07-b51-find-recur-layout-entry [owner-entry recur-form-id]
  (loop [remaining (get owner-entry :recur-layout-entries)
         found nil count-found 0]
    (if (= (count remaining) 0)
      {:entry found :count count-found}
      (if (= (get (first remaining) :recur-form-id) recur-form-id)
        (recur (rest remaining) (first remaining) (+ count-found 1))
        (recur (rest remaining) found count-found)))))

(defn sh07-b51-recur-product-references [foundation layout]
  (let [check-references
        (loop [remaining-slots (get foundation :slot-plans)
               remaining-vectors (get layout :product-node-id-vectors)
               result []]
          (if (= (count remaining-slots) 0)
            result
            (let [check-count
                  (count (get (first remaining-slots)
                              :runtime-check-preimages))]
              (recur
               (rest remaining-slots) (rest remaining-vectors)
               (sh07-b51-vector-append
                result
                (loop [remaining (first remaining-vectors)
                       index 0 values []]
                  (if (= (count remaining) 0)
                    values
                    (recur
                     (rest remaining) (+ index 1)
                     (if (< index check-count)
                       (conj values (first remaining)) values)))))))))
        projection-references
        (loop [remaining-slots (get foundation :slot-plans)
               remaining-vectors (get layout :product-node-id-vectors)
               result []]
          (if (= (count remaining-slots) 0)
            result
            (let [check-count
                  (count (get (first remaining-slots)
                              :runtime-check-preimages))]
              (recur
               (rest remaining-slots) (rest remaining-vectors)
               (sh07-b51-vector-append
                result
                (loop [remaining (first remaining-vectors)
                       index 0 values []]
                  (if (= (count remaining) 0)
                    values
                    (recur
                     (rest remaining) (+ index 1)
                     (if (>= index check-count)
                       (conj values (first remaining)) values)))))))))]
    (sh07-b51-vector-append
     check-references
     (sh07-b51-vector-append
      projection-references
      (sh07-b51-vector-append
       (get layout :argument-product-node-ids)
       [(get layout :commit-product-node-id)])))))

(defn sh07-b51-recur-site-numbered-rows
  [request entries owner-entry recur-site recur-use-index
   authority-reference]
  (let [foundation (get owner-entry :foundation)
        recur-form-id
        (get (get recur-site :recur-coordinate) :recur-form-id)
        selected-layout
        (sh07-b51-find-recur-layout-entry owner-entry recur-form-id)]
    (if (= (get selected-layout :count) 1)
      (let [layout (get (get selected-layout :entry) :layout)
            specs
            (sh07-b51-recur-site-specs
             foundation recur-site recur-use-index)
            product-specs
            (sh07-b51-select-occurrence-specs
             specs :supplemental-product)
            check-specs
            (sh07-b51-select-occurrence-specs specs :runtime-check)
            publication-specs
            (sh07-b51-select-occurrence-specs specs :publication-event)
            mapping-specs
            (sh07-b51-select-occurrence-specs specs :recur-slot-mapping)]
        (if (= (get layout :predecessor-authority-id)
               authority-reference)
          (let [products
                (sh07-b51-build-numbered-product-rows
                 request entries product-specs
                 (sh07-b51-recur-product-references foundation layout)
                 authority-reference (get foundation :owner-coordinate))]
            (if (= (get products :status) :accepted)
              (let [checks
                    (sh07-b51-build-numbered-use-rows
                     entries check-specs
                     (sh07-b51-flatten-reference-vectors
                      (get layout :runtime-check-id-vectors))
                     (sh07-b51-flatten-reference-vectors
                      (get recur-site :runtime-check-preimage-vectors))
                     :sh07-b51-runtime-check-id authority-reference)]
                (if (= (get checks :status) :accepted)
                  (if (= (count publication-specs) 1)
                    (if (= (count mapping-specs) 1)
                      (let [publication
                            (sh07-b51-rewrite-event-numbered-preimage
                             entries (first publication-specs)
                             :sh07-b51-publication-event-id
                             (get layout :publication-event-id)
                             (get recur-site :publication-event-preimage)
                             authority-reference)
                            mapping
                            (sh07-b51-rewrite-numbered-preimage
                             entries (first mapping-specs)
                             :sh07-b51-recur-slot-mapping-id
                             (get layout :recur-slot-mapping-id)
                             (get recur-site
                                  :recur-slot-mapping-preimage)
                             authority-reference)]
                        (if (= (get publication :status) :accepted)
                          (if (= (get mapping :status) :accepted)
                            {:status :accepted
                             :rows
                             (sh07-b51-vector-append
                              (get products :rows)
                              (sh07-b51-vector-append
                               (get checks :rows)
                               [(get publication :row)
                                (get mapping :row)]))}
                            mapping)
                          publication))
                      {:status :rejected
                       :reason :numbered-recur-mapping-cardinality
                       :partial-products []})
                    {:status :rejected
                     :reason :numbered-recur-publication-cardinality
                     :partial-products []})
                  checks))
              products))
          {:status :rejected :reason :numbered-recur-authority
           :partial-products []}))
      {:status :rejected :reason :numbered-recur-layout-join
       :partial-products []})))

(defn sh07-b51-owner-recur-numbered-rows
  [request entries owner-entry authority-reference]
  (loop [remaining (get owner-entry :loop-recur-sites)
         recur-use-index 0 result []]
    (if (= (count remaining) 0)
      {:status :accepted :rows result}
      (let [site (first remaining)
            built
            (sh07-b51-recur-site-numbered-rows
             request entries owner-entry site recur-use-index
             authority-reference)]
        (if (= (get built :status) :accepted)
          (recur
           (rest remaining) (+ recur-use-index 1)
           (sh07-b51-vector-append result (get built :rows)))
          built)))))

(defn sh07-b51-owner-numbered-preimage-rows
  [request entries owner-entry authority-reference]
  (if (= (get (get owner-entry :initialization-layout)
              :predecessor-authority-id)
         authority-reference)
    (let [initializers
          (sh07-b51-owner-initializer-numbered-rows
           request entries owner-entry authority-reference)]
      (if (= (get initializers :status) :accepted)
        (let [static
              (sh07-b51-owner-static-numbered-rows
               entries owner-entry authority-reference)]
          (if (= (get static :status) :accepted)
            (let [recurs
                  (sh07-b51-owner-recur-numbered-rows
                   request entries owner-entry authority-reference)]
              (if (= (get recurs :status) :accepted)
                {:status :accepted
                 :rows
                 (sh07-b51-vector-append
                  (get initializers :rows)
                  (sh07-b51-vector-append
                   (get static :rows) (get recurs :rows)))}
                recurs))
            static))
        initializers))
    {:status :rejected :reason :numbered-owner-authority
     :partial-products []}))

(defn sh07-b51-all-owner-numbered-preimage-rows
  [request entries owners authority-reference]
  (loop [remaining owners result []]
    (if (= (count remaining) 0)
      {:status :accepted :rows result}
      (let [built
            (sh07-b51-owner-numbered-preimage-rows
             request entries (first remaining) authority-reference)]
        (if (= (get built :status) :accepted)
          (recur
           (rest remaining)
           (sh07-b51-vector-append result (get built :rows)))
          built)))))

(defn sh07-b51-find-numbered-row [rows global-ordinal]
  (loop [remaining rows found nil count-found 0]
    (if (= (count remaining) 0)
      {:row found :count count-found}
      (if (= (get (first remaining) :global-ordinal) global-ordinal)
        (recur (rest remaining) (first remaining) (+ count-found 1))
        (recur (rest remaining) found count-found)))))

(defn sh07-b51-numbered-row-category [rows record-kind]
  (let [category
        (loop [remaining rows result []]
          (if (= (count remaining) 0)
            result
            (recur
             (rest remaining)
             (if (= (get (first remaining) :record-kind) record-kind)
               (conj result (first remaining)) result))))]
    (loop [expected 0 ordered []]
      (if (= expected (count category))
        {:status :accepted
         :rows ordered
         :references
         (loop [remaining ordered result []]
           (if (= (count remaining) 0)
             result
             (recur
              (rest remaining)
              (conj result (get (first remaining) :reference)))))
         :preimages
         (loop [remaining ordered result []]
           (if (= (count remaining) 0)
             result
             (recur
              (rest remaining)
              (conj result (get (first remaining) :preimage)))))}
        (let [selected (sh07-b51-find-numbered-row category expected)]
          (if (= (get selected :count) 1)
            (recur (+ expected 1) (conj ordered (get selected :row)))
            {:status :rejected :reason :numbered-category-ordinal-density
             :record-kind record-kind :global-ordinal expected
             :partial-products []}))))))

(defn sh07-b51-numbered-row-coverage-count [entries]
  (loop [remaining entries result 0]
    (if (= (count remaining) 0)
      result
      (let [record-kind (get (get (first remaining) :spec) :record-kind)]
        (recur
         (rest remaining)
         (if (contains?
              #{:ordinary-core-node :module-transcript} record-kind)
           result (+ result 1)))))))

(defn sh07-b51-build-numbered-transcript-preimage
  [authority-reference same-request-reference slots extractions checks
   publications mappings]
  (sh07-b51-build-slot-extraction-transcript-preimage
   {:domain
    :gravity/sh07-b51-slot-extraction-transcript-id-preimage-v18
    :schema-version 18
    :predecessor-authority-id authority-reference
    :same-request-semantic-id same-request-reference
    :slot-count (count (get slots :references))
    :extraction-count (count (get extractions :references))
    :runtime-check-count (count (get checks :references))
    :publication-event-count (count (get publications :references))
    :recur-slot-mapping-count (count (get mappings :references))
    :slot-ids (get slots :references)
    :extraction-ids (get extractions :references)
    :runtime-check-ids (get checks :references)
    :publication-event-ids (get publications :references)
    :recur-slot-mapping-ids (get mappings :references)
    :global-slot-range {:first 0 :count (count (get slots :references))}
    :global-extraction-range
    {:first 0 :count (count (get extractions :references))}
    :global-runtime-check-range
    {:first 0 :count (count (get checks :references))}
    :global-publication-range
    {:first 0 :count (count (get publications :references))}
    :global-recur-range
    {:first 0 :count (count (get mappings :references))}}))

(defn sh07-b51-compose-numbered-preimages
  [request owner-plans supplied-specs authority-reference
   same-request-reference]
  (let [expected
        (sh07-b51-compose-expected-occurrence-specs request owner-plans)]
    (if (= (get expected :status) :accepted)
      (if (= supplied-specs (get expected :specs))
        (let [replay
              (sh07-b51-replay-occurrence-specs-foundation
               request supplied-specs)]
          (if (= (get replay :status) :accepted)
            (if (sh07-b51-internal-reference? authority-reference)
              (if (sh07-b51-internal-reference? same-request-reference)
                (let [built
                      (sh07-b51-all-owner-numbered-preimage-rows
                       request (get replay :entries)
                       (get expected :materialized-owners)
                       authority-reference)]
                  (if (= (get built :status) :accepted)
                    (if (= (count (get built :rows))
                           (sh07-b51-numbered-row-coverage-count
                            (get replay :entries)))
                      (let [products
                            (sh07-b51-numbered-row-category
                             (get built :rows) :supplemental-product)
                            slots
                            (sh07-b51-numbered-row-category
                             (get built :rows) :binding-slot)
                            extractions
                            (sh07-b51-numbered-row-category
                             (get built :rows) :binding-extraction)
                            checks
                            (sh07-b51-numbered-row-category
                             (get built :rows) :runtime-check)
                            publications
                            (sh07-b51-numbered-row-category
                             (get built :rows) :publication-event)
                            mappings
                            (sh07-b51-numbered-row-category
                             (get built :rows) :recur-slot-mapping)]
                        (if (= (get products :status) :accepted)
                          (if (= (get slots :status) :accepted)
                            (if (= (get extractions :status) :accepted)
                              (if (= (get checks :status) :accepted)
                                (if (= (get publications :status) :accepted)
                                  (if (= (get mappings :status) :accepted)
                                    (let [transcript
                                          (sh07-b51-build-numbered-transcript-preimage
                                           authority-reference
                                           same-request-reference slots
                                           extractions checks publications
                                           mappings)]
                                      (if (= (get transcript :status)
                                             :accepted)
                                        {:status :accepted
                                         :numbered-preimage-rows
                                         (get built :rows)
                                         :occurrence-replay replay
                                         :product-node-preimages
                                         (get products :preimages)
                                         :product-node-references
                                         (get products :references)
                                         :binding-slot-preimages
                                         (get slots :preimages)
                                         :binding-slot-references
                                         (get slots :references)
                                         :binding-extraction-preimages
                                         (get extractions :preimages)
                                         :binding-extraction-references
                                         (get extractions :references)
                                         :runtime-check-preimages
                                         (get checks :preimages)
                                         :runtime-check-references
                                         (get checks :references)
                                         :publication-event-preimages
                                         (get publications :preimages)
                                         :publication-event-references
                                         (get publications :references)
                                         :recur-slot-mapping-preimages
                                         (get mappings :preimages)
                                         :recur-slot-mapping-references
                                         (get mappings :references)
                                         :slot-extraction-transcript-preimage
                                         (get transcript :preimage)
                                         :global-ordinals-derived true
                                         :module-transcript-replayed true
                                         :partial-products []}
                                        transcript))
                                    mappings)
                                  publications)
                                checks)
                              extractions)
                            slots)
                          products))
                      {:status :rejected
                       :reason :numbered-preimage-row-coverage
                       :partial-products []})
                    built))
                {:status :rejected :reason :same-request-reference
                 :partial-products []})
              {:status :rejected :reason :authority-reference
               :partial-products []})
            replay))
        {:status :rejected :reason :numbered-preimage-spec-mismatch
         :partial-products []})
      expected)))

(defn sh07-b51-same-request-preimage-shape?
  [request preimage]
  (if (sh07-b51-exact-keys?
       preimage
       #{:domain :schema-version :request-artifact
         :request-schema-version :request-semantic-id
         :source-revision-id :top-level-root-semantic-ids})
    (if (= (get preimage :domain)
           :gravity/sh07-b51-same-request-binding-v18)
      (if (= (get preimage :schema-version) 18)
        (if (= (get preimage :request-artifact)
               :gravity/sh07-authenticated-sh06-core-request)
          (if (= (get preimage :request-schema-version) 15)
            (if (= (get preimage :request-semantic-id)
                   (get request :projection-binding))
              (if (sh07-b51-sha256-id?
                   (get preimage :request-semantic-id))
                (if (= (get preimage :source-revision-id)
                       (get (get request :lineage) :source-revision-id))
                  (if (sh07-b51-sha256-id?
                       (get preimage :source-revision-id))
                    (if (= (get preimage :top-level-root-semantic-ids)
                           (get request :top-level-form-ids))
                      (sh07-b51-all-sha256?
                       (get preimage :top-level-root-semantic-ids))
                      false)
                    false)
                  false)
                false)
              false)
            false)
          false)
        false)
      false)
    false))

(defn sh07-b51-authority-outcome-matrix? [preimage]
  (let [outcome-kind (get preimage :outcome-kind)
        artifact-id (get preimage :semantic-artifact-id)
        authorization (get preimage :authorization)]
    (if (= outcome-kind :legacy-v16-accepted)
      (if (sh07-b51-digest-reference? artifact-id)
        (= authorization :legacy-v16-equivalence) false)
      (if (= outcome-kind :b51-vector-frontier-rejected)
        (if (= artifact-id nil)
          (= authorization :v18-vector-lowering) false)
        (if (= outcome-kind :legacy-v16-accepted-after-no-form-waiver)
          (if (= artifact-id nil)
            (= authorization :v18-authenticated-no-form-namespace) false)
          (if (= outcome-kind
                 :b51-vector-frontier-rejected-after-no-form-waiver)
            (if (= artifact-id nil)
              (= authorization
                 :v18-no-form-namespace-and-vector-lowering)
              false)
            false))))))

(defn sh07-b51-predecessor-authority-preimage-shape? [preimage]
  (if (sh07-b51-exact-keys?
       preimage
       #{:domain :schema-version :implementation-semantic-id
         :contract-semantic-id :same-request-semantic-id
         :outcome-semantic-id :outcome-kind :semantic-artifact-id
         :authorization})
    (if (= (get preimage :domain)
           :gravity/sh07-b51-predecessor-authority-v18)
      (if (= (get preimage :schema-version) 18)
        (if (loop [remaining
                   [:implementation-semantic-id :contract-semantic-id
                    :same-request-semantic-id :outcome-semantic-id]]
              (if (= (count remaining) 0)
                true
                (if (sh07-b51-digest-reference?
                     (get preimage (first remaining)))
                  (recur (rest remaining)) false)))
          (sh07-b51-authority-outcome-matrix? preimage)
          false)
        false)
      false)
    false))

(defn sh07-b51-authenticate-scheduled-reference
  [reference digest-requests purpose expected-preimage tier subtier
   subtier-ordinal batch batch-rank batch-ordinal]
  (if (sh07-b51-internal-reference? reference)
    (if (vector? digest-requests)
      (let [ordinal (get reference :ordinal)]
        (if (< ordinal (count digest-requests))
          (let [request (get digest-requests ordinal)]
            (if (sh07-b51-exact-keys?
                 request
                 #{:ordinal :tier :subtier :subtier-ordinal :batch
                   :batch-rank :batch-ordinal :purpose :preimage})
              (if (= (get request :ordinal) ordinal)
                (if (= (get request :purpose) purpose)
                  (if (= (get request :preimage) expected-preimage)
                    (if (= (get request :tier) tier)
                      (if (= (get request :subtier) subtier)
                        (if (= (get request :subtier-ordinal)
                               subtier-ordinal)
                          (if (= (get request :batch) batch)
                            (if (= (get request :batch-rank) batch-rank)
                              (if (= (get request :batch-ordinal)
                                     batch-ordinal)
                                {:status :accepted :request request
                                 :reference reference
                                 :exact-schedule-join true}
                                {:status :rejected
                                 :reason :scheduled-reference-batch-ordinal
                                 :partial-products []})
                              {:status :rejected
                               :reason :scheduled-reference-batch-rank
                               :partial-products []})
                            {:status :rejected
                             :reason :scheduled-reference-batch
                             :partial-products []})
                          {:status :rejected
                           :reason :scheduled-reference-subtier-ordinal
                           :partial-products []})
                        {:status :rejected
                         :reason :scheduled-reference-subtier
                         :partial-products []})
                      {:status :rejected :reason :scheduled-reference-tier
                       :partial-products []})
                    {:status :rejected
                     :reason :scheduled-reference-preimage-substitution
                     :partial-products []})
                  {:status :rejected
                   :reason :scheduled-reference-purpose-substitution
                   :partial-products []})
                {:status :rejected
                 :reason :scheduled-reference-ordinal-substitution
                 :partial-products []})
              {:status :rejected :reason :scheduled-reference-request-shape
               :partial-products []}))
          {:status :rejected :reason :scheduled-reference-out-of-range
           :partial-products []}))
      {:status :rejected :reason :scheduled-reference-plan-vector
       :partial-products []})

(defn
 sh07-b51-v16-replay-throw-record
 [request state ordinal node-id form value-node-id]
 (sh07-b51-v16-replay-throw-add-legality-facts
  {:transfer-policy :error-transfer,
   :required-effect :error/throw,
   :evaluation-region (get state :evaluation-region),

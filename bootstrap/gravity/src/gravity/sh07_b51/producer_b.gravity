(defn sh07-b51-authenticate-internal-digest-reference
  [reference digest-requests expected-purpose expected-preimage]
  (if (sh07-b51-internal-reference? reference)
    (if (vector? digest-requests)
      (let [ordinal (get reference :ordinal)]
        (if (< ordinal (count digest-requests))
          (let [request (get digest-requests ordinal)]
            (if (sh07-b51-foundation-digest-request-shape? request)
              (if (= (get request :ordinal) ordinal)
                (if (= (get request :purpose) expected-purpose)
                  (if (= (get request :preimage) expected-preimage)
                    {:status :accepted
                     :reference reference
                     :request request
                     :preimage (get request :preimage)
                     :purpose expected-purpose
                     :ordinal ordinal}
                    {:status :rejected
                     :reason :digest-reference-preimage-substitution
                     :partial-products []})
                  {:status :rejected
                   :reason :digest-reference-purpose-substitution
                   :partial-products []})
                {:status :rejected
                 :reason :digest-reference-ordinal-substitution
                 :partial-products []})
              {:status :rejected :reason :digest-request-shape
               :partial-products []}))
          {:status :rejected :reason :digest-reference-out-of-range
           :partial-products []}))
      {:status :rejected :reason :digest-request-vector
       :partial-products []})

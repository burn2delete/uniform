     (= (get value-lowered :status) :accepted)
     (let
      [value-node-id
       (get value-lowered :node-id)
       value-state
       (assoc
        (get value-lowered :state)
        :tail-target-id
        (get state :tail-target-id))
       ordinal
       (count (get value-state :error-transfers))
       added
       (sh07-b51-v16-replay-add-node
        request
        value-state
        form
        :throw
        [value-node-id]
        (sh07-b51-v16-replay-throw-node-attributes request)
        []
        :value-then-transfer)
       record
       (sh07-b51-v16-replay-throw-record
        request
        state
        ordinal
        (get added :node-id)
        form
        value-node-id)
       next-state
       (assoc
        (get added :state)
        :error-transfers
        (conj (get (get added :state) :error-transfers) record))]
      (assoc added :state next-state))
     value-lowered))
   {:status :rejected,
    :rule "C6-CORE-SHAPE",
    :form form,
    :facts
    {:reason :throw-arity,
     :actual-operand-count
     (if (= (count children) 0) 0 (- (count children) 1)),
     :required-operand-count 1}})))


(defn sh07-b51-match-core-child-ids [form]
  (let [children (get form :child-form-ids)]
    (if (> (count children) 2)
      (let [tail (sh07-b51-vector-tail-after children 2)]
        (if (= (* (/ (count tail) 2) 2) (count tail))

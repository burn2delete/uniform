            (recur (rest remaining) result)
            (recur (rest remaining) (conj result alias-name))))))))

(defn sh07-b51-v16-fragment-semantics-valid? [request indexes]
  (loop [remaining (get request :fragment-manifest)]
    (if (= (count remaining) 0)
      true
      (let [fragment (first remaining)
            root-id (first (get fragment :root-form-ids))
            local-binding-ids
            (sh07-b51-v16-fragment-local-binding-ids
             request indexes root-id)
            resolutions
            (sh07-b51-v16-fragment-resolution-records
             request indexes root-id)
            resolution-ids
            (sh07-b51-v16-resolution-reference-ids resolutions)
            external-binding-ids
            (sh07-b51-v16-external-binding-ids
             resolutions local-binding-ids)
            alias-names
            (sh07-b51-v16-fragment-alias-names
             request indexes resolutions)]
        (if (sh07-b51-v16-form-ids-belong-to-root?
             indexes (get fragment :form-ids) root-id)
          (if (= (get fragment :local-binding-ids) local-binding-ids)
            (if (= (get fragment :external-binding-ids)
                   external-binding-ids)
              (if (= (get fragment :resolution-reference-syntax-ids)
                     resolution-ids)
                (if (= (get fragment :alias-names) alias-names)
                  (recur (rest remaining)) false)
                false)
              false)
            false)
          false)))))

(defn sh07-b51-v16-children-valid? [indexes parent]
  (loop [remaining (get parent :child-form-ids)]
    (if (= (count remaining) 0)

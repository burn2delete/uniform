(defn sh07-b51-vector-outcome-common-shape? [preimage]
  (if (= (get preimage :domain)
         :gravity/sh07-b51-predecessor-outcome-semantic-v18)
    (if (= (get preimage :schema-version) 18)
      (if (= (get preimage :status) :rejected)
        (if (loop [remaining
                   [:same-request-semantic-id :implementation-semantic-id
                    :contract-semantic-id]]
              (if (= (count remaining) 0)
                true
                (if (sh07-b51-digest-reference?
                     (get preimage (first remaining)))
                  (recur (rest remaining)) false)))
          (if (sh07-b51-sha256-id? (get preimage :frontier-form-id))
          (if (= (get preimage :identity-preimage-domain) nil)
            (if (= (get preimage :actual-core-artifact-kind) nil)
              (if (= (get preimage :actual-wrapper-artifact-kind) nil)
                (if (contains? #{:let :loop}
                               (get preimage :frontier-owner))
                  (if (= (get preimage :frontier-rule)
                         "C6-LOWERING-GAP")
                    (if (contains?
                         #{:let-destructuring-deferred
                           :loop-destructuring-deferred}
                         (get preimage :frontier-reason))
                      (if (= (get preimage :frontier-binding-kind) :vector)
                        (if (sh07-b51-frontier-coordinate-shape?
                             (get preimage :frontier-coordinate))
                          (= (get preimage :semantic-artifact-id) nil)
                          false)
                        false)
                      false)
                    false)
                  false)
                false)
              false)
            false)
          false)
          false)
        false)
      false)
    false))

(defn sh07-b51-vector-outcome-preimage-shape? [preimage]
  (let [outcome-kind (get preimage :outcome-kind)]
    (if (= outcome-kind :b51-vector-frontier-rejected)
      (if (sh07-b51-exact-keys?
           preimage
           #{:domain :schema-version :outcome-kind :status
             :same-request-semantic-id :implementation-semantic-id
             :contract-semantic-id :identity-preimage-domain
             :actual-core-artifact-kind :actual-wrapper-artifact-kind
             :frontier-owner :frontier-rule :frontier-reason
             :frontier-binding-kind :frontier-form-id
             :frontier-coordinate :semantic-artifact-id :authorization})
        (if (sh07-b51-vector-outcome-common-shape? preimage)
          (= (get preimage :authorization) :v18-vector-lowering)
          false)
        false)
      (if (= outcome-kind
             :b51-vector-frontier-rejected-after-no-form-waiver)
        (if (sh07-b51-exact-keys?
             preimage
             #{:domain :schema-version :outcome-kind :status
               :same-request-semantic-id :implementation-semantic-id
               :contract-semantic-id :identity-preimage-domain
               :actual-core-artifact-kind :actual-wrapper-artifact-kind
               :waived-rule :waived-reason :failing-binding-ids
               :failing-declarations :replay-status :frontier-owner
               :frontier-rule :frontier-reason :frontier-binding-kind
               :frontier-form-id :frontier-coordinate
               :semantic-artifact-id :authorization})
          (if (sh07-b51-vector-outcome-common-shape? preimage)
            (if (= (get preimage :waived-rule) "C6-VERIFY")
              (if (= (get preimage :waived-reason)
                     :authoritative-record-shape)
                (if (sh07-b51-all-sha256?
                     (get preimage :failing-binding-ids))
                  (if (sh07-b51-no-form-projection-vector-shape?
                       (get preimage :failing-declarations))
                    (if (= (get preimage :replay-status)
                           :all-invariants-before-expected-vector-stop-passed)
                      (= (get preimage :authorization)
                         :v18-no-form-namespace-and-vector-lowering)
                      false)
                    false)
                  false)
                false)
              false)
            false)
          false)
        false))))

(defn sh07-b51-find-no-form-resolution [request projection]
  (loop [remaining (get request :resolution-table)
         found nil count-found 0]
    (if (= (count remaining) 0)
      {:resolution found :count count-found}
      (let [resolution (first remaining)]
        (if (if (= (get resolution :binding-id)
                   (get projection :binding-id))
              (if (= (get resolution :upstream-binding-id)
                     (get projection :upstream-binding-id))
                (= (get resolution :resolution-order)
                   (get projection :resolution-order))
                false)
              false)
          (recur (rest remaining) resolution (+ count-found 1))
          (recur (rest remaining) found count-found))))))

(defn sh07-b51-no-form-projection-from-context
  [context resolution]
  (let [binding (get context :binding)
        declaration
        (sh07-b51-raw-declaration
         (get (get context :raw-request) :definitions)
         (get context :upstream-binding))]
    {:binding-id (get binding :binding-id)
     :upstream-binding-id (get binding :upstream-binding-id)
     :name (get binding :name)
     :namespace (get binding :namespace)
     :kind (get binding :kind)
     :binding-class (get binding :binding-class)
     :visibility (get binding :visibility)
     :profile-set (get binding :profile-set)
     :target-set (get binding :target-set)
     :definition-syntax-id (get binding :definition-syntax-id)
     :definition-artifact-id (get binding :definition-artifact-id)
     :explicit-candidate-ordinal
     (get (get declaration :semantic-span) :explicit-candidate)
     :resolution-order (get resolution :resolution-order)}))

(defn sh07-b51-no-form-projection-authenticated?
  [resolution-artifact request indexes projection]
  (let [selected (sh07-b51-find-no-form-resolution request projection)
        resolution (get selected :resolution)
        context
        (if (= (get selected :count) 1)
          (sh07-b51-raw-resolution-context
           resolution-artifact request indexes resolution)
          nil)
        declaration
        (if (map? context)
          (sh07-b51-raw-declaration
           (get (get context :raw-request) :definitions)
           (get context :upstream-binding))
          nil)]
    (if (= (get selected :count) 1)
      (if (map? context)
        (if (= (sh07-b51-authorize-resolution-from-maps
                resolution-artifact request indexes resolution)
               :authenticated-external)
          (if (map? declaration)
            (if (sh07-b51-no-form-namespace-declaration?
                 declaration (get context :upstream-binding))
              (= projection
                 (sh07-b51-no-form-projection-from-context
                  context resolution))
              false)
            false)
          false)
        false)
      false)))


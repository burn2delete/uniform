      (let [child (sh07-b51-find-form indexes (first remaining))]
        (if (map? child)
          (if (= (get child :parent-form-id) (get parent :form-id))
            (recur (rest remaining)) false)
          false)))))

(defn sh07-b51-v16-graph-references-valid? [request indexes]
  (loop [remaining (get request :forms)]
    (if (= (count remaining) 0)
      (loop [roots (get request :top-level-form-ids)]
        (if (= (count roots) 0)
          true
          (let [root (sh07-b51-find-form indexes (first roots))]
            (if (map? root)
              (if (= (get root :parent-form-id) nil)
                (recur (rest roots)) false)
              false))))
      (if (sh07-b51-v16-children-valid? indexes (first remaining))
        (recur (rest remaining)) false))))

(defn sh07-b51-v16-depth-valid? [request indexes]
  (let [forms (get request :forms)]
    (loop [frontier
           (loop [roots (get request :top-level-form-ids) result []]
             (if (= (count roots) 0)
               result
               (recur
                (rest roots) (conj result [(first roots) 1]))))
           visited #{}]
      (if (= (count frontier) 0)
        (= (count visited) (count forms))
        (let [entry (first frontier)
              form-id (first entry)
              depth (first (rest entry))
              form (sh07-b51-find-form indexes form-id)]
          (if (> depth 256)
            false
            (if (contains? visited form-id)
              false
              (if (map? form)
                (recur
                 (loop [children (get form :child-form-ids)
                        result (rest frontier)]
                   (if (= (count children) 0)
                     result
                     (recur
                      (rest children)
                      (conj result [(first children) (+ depth 1)]))))
                 (conj visited form-id))
                false))))))))

(defn sh07-b51-derived-no-form-failing-binding-ids [request indexes]
  (if (if (= (get (get indexes :forms) :duplicate-primary?) false)
        (= (get (get indexes :forms) :duplicate-secondary?) false)
        false)
    (if (if (= (get (get indexes :bindings) :duplicate-primary?) false)
          (= (get (get indexes :bindings) :duplicate-secondary?) false)
          false)
      (loop [remaining (get request :binding-table) failing []]
        (if (= (count remaining) 0)
          {:status :accepted :binding-ids failing}
          (let [binding (first remaining)
                declaration
                (sh07-b51-find-form-by-syntax
                 indexes (get binding :definition-syntax-id))
                declaration-count (if (map? declaration) 1 0)
                binding-class (get binding :binding-class)]
            (if (sh07-b51-v16-binding-record-base-shape? binding)
              (if (contains? #{:core :import} binding-class)
                (recur (rest remaining) failing)
                (if (= declaration-count 1)
                  (recur (rest remaining) failing)
                  (if (= declaration-count 0)
                    (if (= binding-class :namespace)
                      (recur
                       (rest remaining)
                       (conj failing (get binding :binding-id)))
                      {:status :rejected
                       :reason :non-waivable-missing-binding-form
                       :partial-products []})
                    {:status :rejected
                     :reason :duplicate-binding-definition-form
                     :partial-products []})))
              {:status :rejected :reason :projected-binding-shape
               :partial-products []}))))
      {:status :rejected :reason :binding-index-duplicate
       :partial-products []})
    {:status :rejected :reason :form-index-duplicate
     :partial-products []}))

(defn sh07-b51-v16-record-shape-replay
  [resolution-artifact request indexes]
  (let [catalog (sh07-b51-form-position-catalog request)
        derived
        (sh07-b51-derived-no-form-failing-binding-ids request indexes)]
    (if (= (get catalog :status) :accepted)
      (if (= (get derived :status) :accepted)
        (loop [remaining-forms (get request :forms)]
          (if (= (count remaining-forms) 0)
            (loop [remaining-aliases (get request :alias-table)]
              (if (= (count remaining-aliases) 0)
                (loop [remaining-resolutions (get request :resolution-table)]
                  (if (= (count remaining-resolutions) 0)
                    (if (sh07-b51-resolution-maps-authenticated?
                         resolution-artifact request indexes)
                      (if (sh07-b51-v16-fragment-semantics-valid?
                           request indexes)
                        (if (sh07-b51-v16-graph-references-valid?
                             request indexes)
                          (if (sh07-b51-v16-depth-valid? request indexes)
                            {:status :accepted
                             :failing-binding-ids
                             (get derived :binding-ids)
                             :only-waived-predicate
                             :authoritative-record-shape
                             :pre-record-raw-witness true
                             :all-other-record-shapes-passed true
                             :b13-fragment-semantics-passed true
                             :b47-graph-references-passed true
                             :b47-depth-passed true}
                            {:status :rejected
                             :reason :post-waiver-depth
                             :partial-products []})
                          {:status :rejected
                           :reason :post-waiver-graph-references
                           :partial-products []})
                        {:status :rejected
                         :reason :post-waiver-fragment-semantics
                         :partial-products []})
                      {:status :rejected
                       :reason :post-waiver-resolution-replay
                       :partial-products []})
                    (if (sh07-b51-v16-resolution-record-shape?
                         (first remaining-resolutions))
                      (recur (rest remaining-resolutions))
                      {:status :rejected
                       :reason :second-resolution-record-shape-failure
                       :partial-products []})))
                (if (sh07-b51-v16-alias-record-shape?
                     (first remaining-aliases)
                     (get (get request :module) :target))
                  (recur (rest remaining-aliases))
                  {:status :rejected
                   :reason :second-alias-record-shape-failure
                   :partial-products []})))
            (if (sh07-b51-v16-form-record-shape?
                 (first remaining-forms))
              (recur (rest remaining-forms))
              {:status :rejected
               :reason :second-form-record-shape-failure
               :partial-products []})))
        derived)
      catalog)))

(defn sh07-b51-authenticated-no-form-projection-for-binding
  [resolution-artifact request indexes binding-id]
  (loop [remaining (get request :resolution-table)
         count-found 0 projection nil]
    (if (= (count remaining) 0)
      (if (> count-found 0)
        {:status :accepted :projection projection}
        {:status :rejected :reason :no-form-binding-without-resolution
         :partial-products []})
      (let [resolution (first remaining)]
        (if (= (get resolution :binding-id) binding-id)
          (let [context
                (sh07-b51-raw-resolution-context
                 resolution-artifact request indexes resolution)
                declaration
                (if (map? context)
                  (sh07-b51-raw-declaration
                   (get (get context :raw-request) :definitions)
                   (get context :upstream-binding))
                  nil)
                next-projection
                (if (map? context)
                  (sh07-b51-no-form-projection-from-context
                   context resolution)
                  nil)]
            (if (map? context)
              (if (map? declaration)
                (if (sh07-b51-no-form-namespace-declaration?
                     declaration (get context :upstream-binding))
                  (if (= (sh07-b51-authorize-resolution-from-maps
                          resolution-artifact request indexes resolution)
                         :authenticated-external)
                    (if (if (= count-found 0)
                          true
                          (= projection next-projection))
                      (recur
                       (rest remaining) (+ count-found 1) next-projection)
                      {:status :rejected
                       :reason :no-form-binding-resolution-disagreement
                       :partial-products []})
                    {:status :rejected
                     :reason :no-form-projection-unauthorized
                     :partial-products []})
                  {:status :rejected
                   :reason :no-form-declaration-shape
                   :partial-products []})
                {:status :rejected :reason :no-form-declaration-missing
                 :partial-products []})
              {:status :rejected :reason :no-form-resolution-context
               :partial-products []}))
          (recur (rest remaining) count-found projection))))))

(defn sh07-b51-authenticated-no-form-projections
  [resolution-artifact request indexes failing-binding-ids]
  (if (sh07-b51-resolution-maps-authenticated?
       resolution-artifact request indexes)
    (if (vector? failing-binding-ids)
      (if (> (count failing-binding-ids) 0)
        (if (sh07-b51-all-sha256? failing-binding-ids)
          (if (sh07-b51-all-unique? failing-binding-ids)
            (loop [remaining failing-binding-ids result []]
              (if (= (count remaining) 0)
                {:status :accepted :projections result}
                (let [projected
                      (sh07-b51-authenticated-no-form-projection-for-binding
                       resolution-artifact request indexes
                       (first remaining))]
                  (if (= (get projected :status) :accepted)
                    (recur
                     (rest remaining)
                     (conj result (get projected :projection)))
                    projected))))
            {:status :rejected :reason :no-form-binding-id-duplicate
             :partial-products []})
          {:status :rejected :reason :no-form-binding-id-shape
           :partial-products []})
        {:status :rejected :reason :no-form-binding-id-empty
         :partial-products []})
      {:status :rejected :reason :no-form-binding-id-vector
       :partial-products []})
    {:status :rejected :reason :no-form-resolution-map-authentication
     :partial-products []}))

(defn sh07-b51-no-form-outcome-authenticated?
  [raw-carrier outcome]
  (let [request (get raw-carrier :authenticated-sh06-request)
        artifact (get raw-carrier :sh06-resolution-artifact)
        indexes (sh07-b51-index-request request)
        projections (get outcome :failing-declarations)
        binding-ids (get outcome :failing-binding-ids)
        no-form-variant?
        (= (get outcome :outcome-kind)
           :b51-vector-frontier-rejected-after-no-form-waiver)
        replay
        (sh07-b51-v16-record-shape-replay artifact request indexes)
        derived
        (if (= (get replay :status) :accepted)
          {:status :accepted
           :binding-ids (get replay :failing-binding-ids)}
          replay)
        expected
        (if no-form-variant?
          (if (= (get derived :status) :accepted)
            (sh07-b51-authenticated-no-form-projections
             artifact request indexes (get derived :binding-ids))
            derived)
          {:status :accepted :projections []})
        returned
        (get (get (get raw-carrier :predecessor-raw-outcome)
                  :direct-template-observation)
             :returned)
        diagnostics (get returned :diagnostics)
        diagnostic
        (if (if (= (get returned :status) :rejected)
              (if (vector? diagnostics) (> (count diagnostics) 0) false)
              false)
          (first diagnostics) nil)
        raw-reason
        (get (get (get diagnostic :facts) :rule-specific) :reason)]
    (if no-form-variant?
      (if (map? diagnostic)
        (if (= (get diagnostic :rule) "C6-VERIFY")
          (if (= raw-reason :authoritative-record-shape)
            (if (= (get derived :status) :accepted)
              (if (> (count (get derived :binding-ids)) 0)
                (if (= binding-ids (get derived :binding-ids))
                  (if (= (get expected :status) :accepted)
                    (= projections (get expected :projections))
                    false)
                  false)
                false)
              false)
            false)
          false)
        false)
      (if (= (get derived :status) :accepted)
        (= (get derived :binding-ids) []) false))))

(defn sh07-b51-first-vector-frontier [request]
  (let [collected (sh07-b51-collect-module-owner-slots request)]
    (if (= (get collected :status) :accepted)
      (loop [remaining (get collected :slots)]
        (if (= (count remaining) 0)
          {:status :rejected :reason :vector-frontier-missing
           :partial-products []}
          (let [slot (first remaining)]
            (if (= (get (get slot :pattern) :pattern-kind)
                   :vector-pattern)
              (let [form (get slot :pattern-form)
                    fragment (get slot :fragment)
                    owner-form
                    (sh07-b51-find-form
                     (sh07-b51-index-request request)
                     (get (get slot :owner-coordinate)
                          :enclosing-form-id))
                    position
                    (sh07-b51-index-of
                     (get fragment :form-ids) (get form :form-id))]
                (if (= (get position :count) 1)
                  {:status :accepted
                   :owner-kind
                   (if (sh07-b51-authenticated-list-operator?
                        (sh07-b51-index-request request)
                        (sh07-b51-find-form
                         (sh07-b51-index-request request)
                         (get (get slot :owner-coordinate)
                              :enclosing-form-id))
                        'let)
                     :let :loop)
                   :reason
                   (if (sh07-b51-authenticated-list-operator?
                        (sh07-b51-index-request request)
                        (sh07-b51-find-form
                         (sh07-b51-index-request request)
                         (get (get slot :owner-coordinate)
                              :enclosing-form-id))
                        'let)
                     :let-destructuring-deferred
                     :loop-destructuring-deferred)
                   :form form
                   :diagnostic-form form
                   :coordinate
                   {:fragment-id (get fragment :fragment-id)
                    :form-ordinal (get position :index)}}
                  {:status :rejected :reason :vector-frontier-position
                   :partial-products []}))
              (recur (rest remaining))))))
      collected)))

(defn sh07-b51-v16-replay-index-request [request]
  (let [form-index
        (loop [remaining (get request :forms)
               by-id {} by-syntax {} duplicate? false]
          (if (= (count remaining) 0)
            {:by-id by-id :by-syntax by-syntax :duplicate? duplicate?}
            (let [form (first remaining)
                  form-id (get form :form-id)
                  syntax-id (get form :syntax-id)]
              (recur
               (rest remaining)
               (assoc by-id form-id form)
               (assoc by-syntax syntax-id form)
               (if (contains? by-id form-id)
                 true
                 (contains? by-syntax syntax-id))))))
        binding-index
        (loop [remaining (get request :binding-table)
               by-id {} by-definition {} by-scope {} duplicate? false]
          (if (= (count remaining) 0)
            {:by-id by-id :by-definition by-definition
             :by-scope by-scope :duplicate? duplicate?}
            (let [binding (first remaining)
                  binding-id (get binding :binding-id)
                  definition-id (get binding :definition-syntax-id)
                  scope-id (get binding :scope-id)]
              (recur
               (rest remaining)
               (assoc by-id binding-id binding)
               (assoc by-definition definition-id binding)
               (assoc by-scope scope-id
                      (conj (get by-scope scope-id []) binding-id))
               (if (contains? by-id binding-id)
                 true
                 (contains? by-definition definition-id))))))
        alias-index
        (loop [remaining (get request :alias-table)
               by-alias {} duplicate? false]
          (if (= (count remaining) 0)
            {:by-alias by-alias :duplicate? duplicate?}
            (let [alias-record (first remaining)
                  alias-name (get alias-record :alias)]
              (recur
               (rest remaining)
               (assoc by-alias alias-name alias-record)
               (if (contains? by-alias alias-name) true duplicate?)))))
        resolution-index
        (loop [remaining (get request :resolution-table)
               by-reference {} duplicate? false]
          (if (= (count remaining) 0)
            {:by-reference by-reference :duplicate? duplicate?}
            (let [resolution (first remaining)
                  reference-id (get resolution :reference-syntax-id)]
              (recur
               (rest remaining)
               (assoc by-reference reference-id resolution)
               (if (contains? by-reference reference-id)
                 true duplicate?)))))]
    {:forms form-index :bindings binding-index
     :aliases alias-index :resolutions resolution-index}))


; Gravity-owned SH-07 B51 bounded module; Attempt24 owner :r1-producer.
(ns gravity.sh07-b51.producer-b
  (:profile :meta)
  (:target :jvm)
  (:exports [])
  (:effects #{})
  (:capabilities #{})
  (:safety :safe))

(defn sh07-b51-ordinary-pending-legality? [attributes]
  (if (= (get attributes :type-legality) :pending-sh08)
    (if (= (get attributes :effect-registry-legality) :pending-sh09)
      (if (= (get attributes :effect-profile-capability-legality)
             :pending-sh09)
        (if (= (get attributes :ownership-legality) :pending-sh10)
          (= (get attributes :safety-classification) :pending-sh11)
          false)
        false)
      false)
    false))

(defn sh07-b51-ordinary-core-specific-values?
  [core-form attributes children]
  (if (= core-form :var)
    (if (= children [])
    (if (symbol? (get attributes :symbol))
      (if (= (get attributes :binding-class) :namespace)
        (if (contains? #{:var :function}
                       (get attributes :definition-kind))
          (if (sh07-b51-ordinary-required-sha-fields?
               attributes
               [:binding-id :upstream-binding-id :definition-syntax-id
                :definition-artifact-id :operand-form-id
                :operand-syntax-id :authenticated-sh06-artifact-id
                :sh06-semantic-projection-id])
            (if (symbol? (get attributes :namespace))
              (if (= (get attributes :object-kind) :top-level-var)
                (if (= (get attributes :object-policy)
                       :reference-without-dereference-or-execution)
                  (if (= (get attributes :resolution-order)
                         :current-namespace-binding)
                    (= (get attributes :profile-legality) :pending-sh09)
                    false)
                  false)
                false)
              false)
            false)
          false)
        false)
      false)
    false)
    (if (= core-form :set!)
      (if (sh07-b51-ordinary-required-sha-fields?
           attributes
           [:target-binding-id :target-upstream-binding-id
            :target-definition-syntax-id :target-definition-artifact-id
            :target-form-id :target-syntax-id
            :authenticated-sh06-artifact-id
            :sh06-semantic-projection-id])
        (if (= (count children) 1)
          (if (symbol? (get attributes :target-symbol))
          (if (= (get attributes :target-binding-class) :namespace)
            (if (contains? #{:var :function}
                           (get attributes :target-definition-kind))
            (if (= (get attributes :target-location) :top-level-var)
              (if (symbol? (get attributes :target-namespace))
              (if (= (get attributes :resolution-order)
                     :current-namespace-binding)
                (if (= (get attributes :target-evaluation) :none)
                  (if (= (get attributes :value-child-index) 0)
                    (if (= (get attributes :evaluation-order)
                           :evaluate-value-then-write)
                      (if (= (get attributes :result-policy) :unit)
                        (if (= (get attributes :required-effect) :state/write)
                          (sh07-b51-ordinary-pending-legality? attributes)
                          false)
                        false)
                      false)
                    false)
                  false)
                false)
              false)
              false)
            false)
            false)
          false)
          false)
        false)
      (if (= core-form :throw)
        (if (= (count children) 1)
          (if (= (get attributes :value-child-index) 0)
            (if (= (get attributes :evaluation-order) :value-then-transfer)
              (if (= (get attributes :construction-order)
                     :postorder-after-value)
                (if (= (get attributes :runtime-reachability)
                       :not-asserted-by-sh07-b7)
                  (if (= (get attributes :transfer-policy) :error-transfer)
                    (if (= (get attributes :result-policy) :never)
                      (if (= (get attributes :required-effect) :error/throw)
                        (if (sh07-b51-ordinary-required-sha-fields?
                             attributes
                             [:authenticated-sh06-artifact-id
                              :sh06-semantic-projection-id])
                          (if (= (get attributes
                                      :profile-error-lowering-legality)
                                 :pending-sh09)
                            (sh07-b51-ordinary-pending-legality? attributes)
                            false)
                          false)
                        false)
                      false)
                    false)
                  false)
                false)
              false)
            false)
          false)
        (if (= core-form :try)
          (let [handler-count (get attributes :handler-count)]
            (if (sh07-b51-nonnegative-integer? handler-count)
              (if (> handler-count 0)
                (if (= (count children) (+ handler-count 1))
                  (if (= (count (get attributes :handler-clauses))
                         handler-count)
                    (if (sh07-b51-ordinary-handler-clauses-shape?
                         (get attributes :handler-clauses))
                      (if (= (get attributes :protected-child-index) 0)
                        (if (sh07-b51-index-vector-from?
                             (get attributes :handler-child-indexes) 1)
                          (if (= (count
                                  (get attributes :handler-child-indexes))
                                 handler-count)
                            (if (= (get attributes :evaluation-order)
                                   :protected-then-ordered-typed-handler-candidates)
                              (if (= (get attributes :runtime-reachability)
                                     :not-asserted-by-sh07-b9)
                                (if (= (get attributes :selection-policy)
                                       :source-ordered-typed-handler-candidates)
                                  (if (= (get attributes :result-policy)
                                         :protected-or-selected-handler-last)
                                    (if (sh07-b51-ordinary-required-sha-fields?
                                         attributes
                                         [:authenticated-sh06-artifact-id
                                          :sh06-semantic-projection-id])
                                      (if (= (get attributes
                                                  :type-coverage-legality)
                                             :pending-sh08)
                                        (if (= (get attributes
                                                    :result-type-join-legality)
                                               :pending-sh08)
                                          (if (= (get attributes
                                                      :profile-error-lowering-legality)
                                                 :pending-sh09)
                                            (sh07-b51-ordinary-pending-legality?
                                             (assoc attributes
                                                    :type-legality
                                                    :pending-sh08))
                                            false)
                                          false)
                                        false)
                                      false)
                                    false)
                                  false)
                                false)
                              false)
                            false)
                          false)
                        false)
                      false)
                    false)
                  false)
                false)
              false))
          (if (= core-form :fn)
            (if (sh07-b51-ordinary-symbol-vector?
                 (get attributes :parameters))
              (if (= (get attributes :fixed-arity)
                     (count (get attributes :parameters)))
                (if (sh07-b51-ordinary-required-sha-fields?
                     attributes
                     [:parameter-form-id :parameter-syntax-id
                      :recur-target-id])
                  (= (count children) 1)
                  false)
                false)
              false)
              (if (= core-form :def)
                (if (symbol? (get attributes :name))
                  (if (sh07-b51-ordinary-required-sha-fields?
                     attributes [:name-form-id :name-syntax-id])
                  (if (contains? #{:public :private}
                                 (get attributes :visibility))
                    (= (count children) 1)
                    false)
                  false)
                false)
              (if (= core-form :if)
                (if (= (count children) 3)
                  (if (= (get attributes :condition-child-index) 0)
                    (if (= (get attributes :then-child-index) 1)
                      (if (= (get attributes :else-child-index) 2)
                        (if (= (get attributes :condition-evaluation)
                               :always-first)
                          (if (= (get attributes :branch-evaluation)
                                 :exactly-one)
                            (= (get attributes :truthiness)
                               {:false-values [:nil :false]
                                :other-values :true})
                            false)
                          false)
                        false)
                      false)
                    false)
                  false)
                (if (= core-form :do)
                  (if (> (count children) 0)
                    (if (= (get attributes :body-count) (count children))
                      (if (= (get attributes :evaluation-order)
                             :left-to-right)
                        (if (= (get attributes :result) :last-child)
                          (= (get attributes :result-child-index)
                             (- (count children) 1))
                          false)
                        false)
                      false)
                    false)
                  (if (= core-form :match)
                    (let [branch-count (get attributes :branch-count)]
                      (if (sh07-b51-nonnegative-integer? branch-count)
                        (if (> branch-count 0)
                          (if (= (count children) (+ branch-count 1))
                            (if (= (count (get attributes :branch-clauses))
                                   branch-count)
                              (if (sh07-b51-ordinary-match-clauses-shape?
                                   (get attributes :branch-clauses))
                                (if (= (get attributes
                                            :scrutinee-child-index) 0)
                                  (if (sh07-b51-index-vector-from?
                                       (get attributes
                                            :branch-child-indexes) 1)
                                    (if (= (count
                                            (get attributes
                                                 :branch-child-indexes))
                                           branch-count)
                                      (if (= (get attributes
                                                  :evaluation-order)
                                             :scrutinee-then-source-ordered-pattern-candidates)
                                        (if (= (get attributes
                                                    :runtime-reachability)
                                               :not-asserted-by-sh07-b11)
                                          (if (= (get attributes
                                                      :selection-policy)
                                                 :source-ordered-pattern-candidates)
                                            (if (= (get attributes
                                                        :result-type-join)
                                                   :pending-sh08)
                                              (if (= (get attributes
                                                          :exhaustiveness)
                                                     :pending-sh08)
                                                (sh07-b51-ordinary-required-sha-fields?
                                                 attributes
                                                 [:authenticated-sh06-artifact-id
                                                  :sh06-semantic-projection-id])
                                                false)
                                              false)
                                            false)
                                          false)
                                        false)
                                      false)
                                    false)
                                  false)
                                false)
                              false)
                            false)
                          false)
                        false))
                    false))))))))))

(defn sh07-b51-ordinary-core-attributes-shape?
  [core-form attributes children]
  (let [expected (sh07-b51-ordinary-core-attribute-keys core-form)]
    (if (set? expected)
      (if (sh07-b51-exact-keys? attributes expected)
        (if (= core-form :reference)
          (if (symbol? (get attributes :symbol))
            (if (contains? #{:expression :operator}
                           (get attributes :position))
              (if (sh07-b51-sha256-id? (get attributes :binding-id))
                (if (keyword? (get attributes :binding-class))
                  (if (sh07-b51-sha256-id?
                       (get attributes :definition-syntax-id))
                    (= children [])
                    false)
                  false)
                false)
              false)
            false)
          (if (= core-form :literal)
            (if (= children [])
              (sh07-b51-ordinary-literal-value-shape?
               (get attributes :literal-kind) (get attributes :value))
              false)
            (if (= core-form :collection-literal)
              (if (contains? #{:vector :map :set}
                             (get attributes :literal-kind))
                (if (= (get attributes :element-count) (count children))
                  (if (= (get attributes :literal-kind) :map)
                    (sh07-b51-ordinary-even-count? children)
                    true)
                  false)
                false)
              (if (= core-form :call)
                (if (= (get attributes :operator-child-index) 0)
                  (if (= (get attributes :argument-count)
                         (- (count children) 1))
                    (if (sh07-b51-index-vector-from?
                         (get attributes :argument-child-indexes) 1)
                      (if (= (count
                              (get attributes :argument-child-indexes))
                             (get attributes :argument-count))
                        (if (= (get attributes :evaluation-order)
                               :operator-then-arguments)
                          (= (get attributes :dispatch)
                             :resolved-symbol-call)
                          false)
                        false)
                      false)
                    false)
                  false)
                (if (= core-form :keyword-map-lookup)
                  (if (= (count children) 2)
                    (if (= (get attributes :keyword-child-index) 0)
                      (if (= (get attributes :map-child-index) 1)
                        (if (keyword? (get attributes :keyword))
                          (if (= (get attributes :evaluation-order)
                                 :keyword-then-map)
                            (if (= (get attributes :dispatch)
                                   :keyword-map-lookup)
                              (if (= (get attributes :missing-key-policy)
                                     :nil)
                                (if (= (get attributes :result-policy)
                                       :map-value-or-nil)
                                  (= (get attributes :target-type-legality)
                                     :pending-sh08)
                                  false)
                                false)
                              false)
                            false)
                          false)
                        false)
                      false)
                    false)
                  (if (= core-form :quote)
                    (if (= children [])
                      (if (sh07-b51-sha256-id?
                           (get attributes :quoted-form-id))
                        (sh07-b51-sha256-id?
                         (get attributes :quoted-syntax-id))
                        false)
                      false)
                    (sh07-b51-ordinary-core-specific-values?
                     core-form attributes children)))))))
        false)
      false)))

(defn sh07-b51-ordinary-clause-binding-ids [clauses fields]
  (loop [remaining clauses result []]
    (if (= (count remaining) 0)
      result
      (let [values
            (loop [remaining-fields fields field-result result]
              (if (= (count remaining-fields) 0)
                field-result
                (let [value
                      (get (first remaining) (first remaining-fields))]
                  (recur
                   (rest remaining-fields)
                   (if (vector? value)
                     (sh07-b51-vector-append field-result value)
                     (conj field-result value))))))]
        (recur (rest remaining) values)))))

(defn sh07-b51-ordinary-core-binding-ids-shape? [preimage]
  (let [core-form (get preimage :core-form)
        attributes (get preimage :attributes)
        binding-ids (get preimage :resolved-binding-ids)]
    (if (contains? #{:reference :var} core-form)
      (= binding-ids [(get attributes :binding-id)])
      (if (= core-form :set!)
        (= binding-ids [(get attributes :target-binding-id)])
        (if (= core-form :call)
          (= (count binding-ids) 1)
          (if (= core-form :fn)
            (= (count binding-ids) (get attributes :fixed-arity))
            (if (= core-form :def)
              (= (count binding-ids) 1)
              (if (= core-form :try)
                (= binding-ids
                   (sh07-b51-ordinary-clause-binding-ids
                    (get attributes :handler-clauses)
                    [:error-type-binding-id :catch-binding-id]))
                (if (= core-form :match)
                  (= binding-ids
                     (sh07-b51-ordinary-clause-binding-ids
                      (get attributes :branch-clauses)
                      [:pattern-binding-ids]))
                  (= binding-ids []))))))))))

(defn sh07-b51-ordinary-core-preimage-shape? [preimage]
  (if (map? preimage)
    (if (sh07-b51-ordinary-core-attributes-shape?
         (get preimage :core-form) (get preimage :attributes)
         (get preimage :children))
      (if (= (get preimage :evaluation-kind)
             (sh07-b51-ordinary-evaluation-kind
              (get preimage :core-form)))
        (sh07-b51-ordinary-core-binding-ids-shape? preimage)
        false)
      false)
    false))

(defn sh07-b51-core-node-preimage-shape? [preimage]
  (if (sh07-b51-exact-keys?
       preimage
       #{:domain :schema-version :predecessor-authority-id :core-form
         :children :attributes :source :resolved-binding-ids
         :evaluation-kind :evaluation-region
         :evaluation-owner-function-syntax-id :evaluated-children
         :namespace :profile :target :metadata :binding-context
         :generated? :preserved-declarations :pending-fact-families})
    (if (= (get preimage :domain)
           :gravity/sh07-b51-core-node-id-preimage-v18)
      (if (= (get preimage :schema-version) 18)
        (if (sh07-b51-digest-reference?
             (get preimage :predecessor-authority-id))
          (if (contains?
               #{:reference :literal :collection-literal
                 :keyword-map-lookup :call :quote :var :set! :throw
                 :try :fn :let :loop :recur :def :if :do :match}
               (get preimage :core-form))
            (if (sh07-b51-all-digest-references? (get preimage :children))
              (if (= (get preimage :evaluated-children)
                     (sh07-b51-v18-evaluated-children
                      (get preimage :evaluation-kind)
                      (get preimage :children)))
                (if (if (= (get preimage :core-form) :recur)
                      (sh07-b51-recur-core-attributes-shape?
                       (get preimage :attributes))
                      (if (contains? #{:let :loop}
                                     (get preimage :core-form))
                        (sh07-b51-owner-core-attributes-shape?
                         (get preimage :core-form)
                         (get preimage :attributes))
                        (sh07-b51-ordinary-core-preimage-shape?
                         preimage)))
                  (if (sh07-b51-core-source-shape?
                       (get preimage :source))
                    (if (sh07-b51-all-sha256?
                         (get preimage :resolved-binding-ids))
                      (if (keyword? (get preimage :evaluation-kind))
                        (if (sh07-b51-v18-evaluation-region-shape?
                             (get preimage :evaluation-region))
                          (if (if (= (get preimage
                                         :evaluation-owner-function-syntax-id)
                                    nil)
                                true
                                (sh07-b51-sha256-id?
                                 (get preimage
                                      :evaluation-owner-function-syntax-id)))
                            (if (symbol? (get preimage :namespace))
                              (if (= (get preimage :profile) :meta)
                                (if (= (get preimage :target) :jvm)
                                  (if (= (get preimage :metadata) {})
                                    (if (if (= (get preimage :binding-context)
                                               nil)
                                          true
                                          (sh07-b51-sha256-id?
                                           (get preimage :binding-context)))
                                      (if (contains? #{true false}
                                                     (get preimage
                                                          :generated?))
                                        (if (sh07-b51-preserved-declarations-shape?
                                             (get preimage
                                                  :preserved-declarations))
                                          (sh07-b51-keyword-vector?
                                           (get preimage
                                                :pending-fact-families))
                                          false)
                                        false)
                                      false)
                                    false)
                                  false)
                                false)
                              false)
                            false)
                          false)
                        false)
                      false)
                    false)
                  false)
                false)
              false)
            false)
          false)
        false)
      false)
    false))

(defn sh07-b51-build-core-node-preimage [preimage]
  (if (sh07-b51-core-node-preimage-shape? preimage)
    {:status :accepted :preimage preimage}
    {:status :rejected :reason :core-node-preimage-shape
     :partial-products []}))

(defn sh07-b51-vector-range [first-index count-value]
  (loop [index first-index remaining count-value result []]
    (if (= remaining 0)
      result
      (recur (+ index 1) (- remaining 1) (conj result index)))))

(defn sh07-b51-owner-body-forms [indexes foundation]
  (if (= (get foundation :owner-kind) :loop)
    (get foundation :body-forms)
    (loop [remaining (get foundation :body-form-ids) result []]
      (if (= (count remaining) 0)
        result
        (let [form (sh07-b51-find-form indexes (first remaining))]
          (if (map? form)
            (recur (rest remaining) (conj result form))
            []))))))

(defn sh07-b51-owner-introduced-binding-ids [slot-plans]
  (loop [remaining slot-plans result []]
    (if (= (count remaining) 0)
      result
      (recur
       (rest remaining)
       (sh07-b51-vector-append
        result
        (get (get (first remaining) :publication-event-preimage)
             :introduced-binding-ids))))))

(defn sh07-b51-owner-slot-pattern-kinds [slot-plans]
  (loop [remaining slot-plans result []]
    (if (= (count remaining) 0)
      result
      (recur
       (rest remaining)
       (conj result
             (if (= (get (first remaining) :runtime-policy)
                    :legacy-direct-binding-no-check)
               :legacy-simple-symbol
               :vector-pattern))))))

(defn sh07-b51-module-preserved-declarations [request]
  (let [module (get request :module)]
    (if (sh07-b51-keyword-vector? (get module :effects))
      (if (sh07-b51-keyword-vector? (get module :capabilities))
        (if (= (get module :safety) :safe)
          {:status :accepted
           :value {:effects (get module :effects)
                   :capabilities (get module :capabilities)
                   :safety (get module :safety)}}
          {:status :rejected :reason :safety-declaration-weakened
           :partial-products []})
        {:status :rejected :reason :capability-declaration-unordered
         :partial-products []})
      {:status :rejected :reason :effect-declaration-unordered
       :partial-products []})))

(defn sh07-b51-core-evaluation-context-shape? [context]
  (if (sh07-b51-exact-keys?
       context
       #{:evaluation-kind :evaluation-region
         :evaluation-owner-function-syntax-id :binding-context})
    (if (keyword? (get context :evaluation-kind))
      (if (sh07-b51-v18-evaluation-region-shape?
           (get context :evaluation-region))
        (if (if (= (get context :evaluation-owner-function-syntax-id) nil)
              true
              (sh07-b51-sha256-id?
               (get context :evaluation-owner-function-syntax-id)))
          (if (= (get context :binding-context) nil)
            true
            (sh07-b51-sha256-id? (get context :binding-context)))
          false)
        false)
      false)
    false))

(defn sh07-b51-owner-core-attributes
  [indexes foundation body-forms target-id]
  (let [slot-plans (get foundation :slot-plans)
        binding-count (count slot-plans)
        body-count (count body-forms)
        child-count (+ binding-count body-count)
        owner-form
        (sh07-b51-find-form
         indexes (get (get foundation :owner-coordinate) :enclosing-form-id))
        base
        {:binding-vector-form-id
         (get foundation :binding-vector-form-id)
         :binding-vector-syntax-id
         (get foundation :binding-vector-syntax-id)
         :outer-scope-id (get owner-form :scope-id)
         :body-scope-id (get (first body-forms) :scope-id)
         :binding-count binding-count
         :introduced-binding-count
         (count (sh07-b51-owner-introduced-binding-ids slot-plans))
         :slot-pattern-kinds
         (sh07-b51-owner-slot-pattern-kinds slot-plans)
         :body-count body-count
         :initializer-child-indexes
         (sh07-b51-vector-range 0 binding-count)
         :body-child-indexes
         (sh07-b51-vector-range binding-count body-count)
         :evaluation-order :initializers-then-body-left-to-right
         :result-policy {:kind :last-body
                         :child-index (- child-count 1)}}]
    (if (= (get foundation :owner-kind) :loop)
      (assoc base :target-id target-id)
      base)))

(defn sh07-b51-owner-initializer-node-ids [slot-plans]
  (loop [remaining slot-plans result []]
    (if (= (count remaining) 0)
      result
      (recur
       (rest remaining)
       (conj result
             (get (get (first remaining) :initializer-evaluation)
                  :initializer-core-node-id))))))

(defn sh07-b51-build-owner-core-node-preimage
  [request foundation body-node-ids target-id predecessor-authority context]
  (let [indexes (sh07-b51-index-request request)
        owner (get foundation :owner-coordinate)
        owner-form
        (sh07-b51-find-form indexes (get owner :enclosing-form-id))
        body-forms (sh07-b51-owner-body-forms indexes foundation)
        initializer-node-ids
        (sh07-b51-owner-initializer-node-ids
         (get foundation :slot-plans))
        children
        (sh07-b51-vector-append initializer-node-ids body-node-ids)
        declarations (sh07-b51-module-preserved-declarations request)
        attributes
        (sh07-b51-owner-core-attributes
         indexes foundation body-forms target-id)
        preimage
        {:domain :gravity/sh07-b51-core-node-id-preimage-v18
         :schema-version 18
         :predecessor-authority-id predecessor-authority
         :core-form (get foundation :owner-kind)
         :children children
         :attributes attributes
         :source
         {:syntax-id (get owner-form :syntax-id)
          :form-id (get owner-form :form-id)
          :semantic-span (get owner-form :source-span)
          :origin-chain (get owner-form :origin-chain)
          :generated-origin (get owner-form :generated-origin)}
         :resolved-binding-ids
         (sh07-b51-owner-introduced-binding-ids
          (get foundation :slot-plans))
         :evaluation-kind (get context :evaluation-kind)
         :evaluation-region (get context :evaluation-region)
         :evaluation-owner-function-syntax-id
         (get context :evaluation-owner-function-syntax-id)
         :evaluated-children children
         :namespace (get (get request :module) :namespace)
         :profile :meta
         :target :jvm
         :metadata (get owner-form :metadata)
         :binding-context (get context :binding-context)
         :generated? (> (count (get owner-form :generated-origin)) 0)
         :preserved-declarations (get declarations :value)
         :pending-fact-families [:types :effects :ownership :safety]}]
    (if (= (get declarations :status) :accepted)
      (if (sh07-b51-core-evaluation-context-shape? context)
        (if (= (count body-forms) (count body-node-ids))
          (if (> (count body-forms) 0)
            (if (if (= (get foundation :owner-kind) :loop)
                  (sh07-b51-digest-reference? target-id)
                  (= target-id nil))
              (sh07-b51-build-core-node-preimage preimage)
              {:status :rejected :reason :owner-target-reference
               :partial-products []})
            {:status :rejected :reason :owner-body-required
             :partial-products []})
          {:status :rejected :reason :owner-body-node-count
           :partial-products []})
        {:status :rejected :reason :core-evaluation-context
         :partial-products []})
      declarations)))

(defn sh07-b51-ordinary-occurrence-key-shape? [key]
  (if (sh07-b51-exact-keys?
       key
       #{:record-kind :root-index :fragment-ordinal
         :form-preorder-index :enclosing-occurrence-index
         :core-postorder-index :record-kind-rank :event-kind-rank
         :event-form-preorder-index :slot-ordinal
         :pattern-preorder-index :product-kind-rank :local-use-index
         :traversal-emission-index})
    (if (= (get key :record-kind) :ordinary-core-node)
      (if (loop [remaining
                 [:root-index :fragment-ordinal :form-preorder-index
                  :core-postorder-index :record-kind-rank
                  :traversal-emission-index]]
            (if (= (count remaining) 0)
              true
              (if (sh07-b51-nonnegative-integer?
                   (get key (first remaining)))
                (recur (rest remaining))
                false)))
        (loop [remaining
               [:enclosing-occurrence-index :event-kind-rank
                :event-form-preorder-index :slot-ordinal
                :pattern-preorder-index :product-kind-rank
                :local-use-index]]
          (if (= (count remaining) 0)
            true
            (if (= (get key (first remaining)) :na)
              (recur (rest remaining))
              false)))
        false)
      false)
    false))

(defn sh07-b51-owner-body-node-record-shape? [record]
  (if (sh07-b51-exact-keys?
       record
       #{:node-id :form-id :syntax-id :owner-child-index
         :core-postorder-index :occurrence-key :core-node-preimage})
    (if (sh07-b51-internal-reference? (get record :node-id))
      (if (sh07-b51-sha256-id? (get record :form-id))
        (if (sh07-b51-sha256-id? (get record :syntax-id))
          (if (sh07-b51-nonnegative-integer?
               (get record :owner-child-index))
            (if (sh07-b51-nonnegative-integer?
                 (get record :core-postorder-index))
              (if (sh07-b51-ordinary-occurrence-key-shape?
                   (get record :occurrence-key))
                (sh07-b51-core-node-preimage-shape?
                 (get record :core-node-preimage))
                false)
              false)
            false)
          false)
        false)
      false)
    false))

(defn sh07-b51-owner-body-occurrence-key-agrees?
  [record position]
  (let [key (get record :occurrence-key)]
    (if (= (get key :record-kind) :ordinary-core-node)
      (if (= (get key :root-index) (get position :root-index))
        (if (= (get key :fragment-ordinal)
               (get position :fragment-ordinal))
          (if (= (get key :form-preorder-index)
                 (get position :form-preorder-index))
            (if (= (get key :core-postorder-index)
                   (get record :core-postorder-index))
              (if (= (get key :record-kind-rank) 0)
                (if (= (get key :enclosing-occurrence-index) :na)
                  (if (= (get key :event-kind-rank) :na)
                    (if (= (get key :event-form-preorder-index) :na)
                      (if (= (get key :slot-ordinal) :na)
                        (if (= (get key :pattern-preorder-index) :na)
                          (if (= (get key :product-kind-rank) :na)
                            (= (get key :local-use-index) :na)
                            false)
                          false)
                        false)
                      false)
                    false)
                  false)
                false)
              false)
            false)
          false)
        false)
      false)))

(defn sh07-b51-find-postorder-record
  [records form-id occurrence-path]
  (loop [remaining records found nil count-found 0]
    (if (= (count remaining) 0)
      {:record found :count count-found}
      (let [record (first remaining)]
        (if (if (= (get record :form-id) form-id)
              (= (get record :occurrence-path) occurrence-path)
              false)
          (recur (rest remaining) record (+ count-found 1))
          (recur (rest remaining) found count-found))))))

(defn sh07-b51-authenticate-owner-body-node-records
  [request foundation records]
  (let [indexes (sh07-b51-index-request request)
        body-forms (sh07-b51-owner-body-forms indexes foundation)
        catalog (sh07-b51-form-position-catalog request)
        postorder (sh07-b51-independent-core-postorder request)
        owner-position
        (sh07-b51-find-occurrence-position
         (get catalog :positions)
         (get (get foundation :owner-coordinate) :enclosing-form-id) nil)
        first-child-index (count (get foundation :slot-plans))]
    (if (sh07-b51-indexes-unique? indexes)
      (if (= (get catalog :status) :accepted)
        (if (= (get postorder :status) :accepted)
          (if (= (get owner-position :count) 1)
        (if (vector? records)
          (if (= (count records) (count body-forms))
            (loop [remaining-records records remaining-forms body-forms
                   child-index first-child-index
                   body-index 0
                   previous-core-index nil previous-emission-index nil
                   node-ids []]
              (if (= (count remaining-records) 0)
                {:status :accepted
                 :node-ids node-ids
                 :body-node-count (count node-ids)
                 :authenticated-form-child-joins true
                 :authenticated-postorder-joins true}
                (let [record (first remaining-records)
                      form (first remaining-forms)
                      occurrence-path
                      (conj
                       (get (get owner-position :position) :occurrence-path)
                       (+ body-index 2))
                      position-result
                      (sh07-b51-find-occurrence-position
                       (get catalog :positions) (get form :form-id)
                       occurrence-path)
                      position (get position-result :position)
                      postorder-result
                      (sh07-b51-find-postorder-record
                       (get postorder :records) (get form :form-id)
                       occurrence-path)
                      expected-postorder
                      (get postorder-result :record)
                      core-index (get record :core-postorder-index)
                      emission-index
                      (get (get record :occurrence-key)
                           :traversal-emission-index)]
                  (if (sh07-b51-owner-body-node-record-shape? record)
                    (if (= (get record :form-id) (get form :form-id))
                      (if (= (get record :syntax-id) (get form :syntax-id))
                        (if (= (get record :owner-child-index) child-index)
                          (if (if (= (get position-result :count) 1)
                                (if (= (get postorder-result :count) 1)
                                  (if (= core-index
                                         (get expected-postorder
                                              :core-postorder-index))
                                    (sh07-b51-owner-body-occurrence-key-agrees?
                                     record position)
                                    false)
                                  false)
                                false)
                            (if (if (= previous-core-index nil)
                                  true
                                  (< previous-core-index core-index))
                              (if (if (= previous-emission-index nil)
                                    true
                                    (< previous-emission-index emission-index))
                                (recur
                                 (rest remaining-records)
                                 (rest remaining-forms) (+ child-index 1)
                                 (+ body-index 1)
                                 core-index emission-index
                                 (conj node-ids (get record :node-id)))
                                {:status :rejected
                                 :reason :body-node-emission-order
                                 :partial-products []})
                              {:status :rejected
                               :reason :body-node-postorder
                               :partial-products []})
                            {:status :rejected
                             :reason :body-node-occurrence-join
                             :partial-products []})
                          {:status :rejected
                           :reason :body-node-child-index
                           :partial-products []})
                        {:status :rejected
                         :reason :body-node-syntax-substitution
                         :partial-products []})
                      {:status :rejected :reason :body-node-form-substitution
                       :partial-products []})
                    {:status :rejected :reason :body-node-record-shape
                     :partial-products []}))))
            {:status :rejected :reason :owner-body-node-count
             :partial-products []})
          {:status :rejected :reason :owner-body-node-record-vector
           :partial-products []})
          {:status :rejected :reason :owner-body-occurrence-ambiguous
           :partial-products []})
          postorder)
        catalog)
      {:status :rejected :reason :request-index-duplicate
       :partial-products []})))

(defn sh07-b51-build-owner-core-node-authenticated-body
  [request foundation body-node-records target-id
   predecessor-authority context]
  (let [authenticated
        (sh07-b51-authenticate-owner-body-node-records
         request foundation body-node-records)]
    (if (= (get authenticated :status) :accepted)
      (sh07-b51-build-owner-core-node-preimage
       request foundation (get authenticated :node-ids) target-id
       predecessor-authority context)
      authenticated)))

(defn sh07-b51-append-unique-values [values additions]
  (loop [remaining additions result values]
    (if (= (count remaining) 0)
      result
      (if (sh07-b51-vector-contains? result (first remaining))
        (recur (rest remaining) result)
        (recur (rest remaining) (conj result (first remaining)))))))

(defn sh07-b51-unique-reference-ids-from-evaluations [evaluations]
  (loop [remaining evaluations result []]
    (if (= (count remaining) 0)
      result
      (recur
       (rest remaining)
       (sh07-b51-append-unique-values
        result (get (first remaining) :referenced-binding-ids))))))

(defn sh07-b51-build-recur-core-node-preimage
  [request recur-foundation target-id predecessor-authority context]
  (let [indexes (sh07-b51-index-request request)
        coordinate (get recur-foundation :recur-coordinate)
        recur-form
        (sh07-b51-find-form indexes (get coordinate :recur-form-id))
        evaluations (get recur-foundation :argument-evaluations)
        children
        (loop [remaining evaluations result []]
          (if (= (count remaining) 0)
            result
            (recur
             (rest remaining)
             (conj result (get (first remaining) :argument-node-id)))))
        declarations (sh07-b51-module-preserved-declarations request)
        preimage
        {:domain :gravity/sh07-b51-core-node-id-preimage-v18
         :schema-version 18
         :predecessor-authority-id predecessor-authority
         :core-form :recur
         :children children
         :attributes
         {:target-id target-id
          :target-kind (get recur-foundation :target-kind)
          :arity (get recur-foundation :target-slot-count)
          :semantic-rule "L2-RECUR-TARGET"
          :type-compatibility :pending-sh08}
         :source
         {:syntax-id (get recur-form :syntax-id)
          :form-id (get recur-form :form-id)
          :semantic-span (get recur-form :source-span)
          :origin-chain (get recur-form :origin-chain)
          :generated-origin (get recur-form :generated-origin)}
         :resolved-binding-ids
         (sh07-b51-unique-reference-ids-from-evaluations evaluations)
         :evaluation-kind (get context :evaluation-kind)
         :evaluation-region (get context :evaluation-region)
         :evaluation-owner-function-syntax-id
         (get context :evaluation-owner-function-syntax-id)
         :evaluated-children children
         :namespace (get (get request :module) :namespace)
         :profile :meta
         :target :jvm
         :metadata (get recur-form :metadata)
         :binding-context (get context :binding-context)
         :generated? (> (count (get recur-form :generated-origin)) 0)
         :preserved-declarations (get declarations :value)
         :pending-fact-families [:types :effects :ownership :safety]}]
    (if (= (get declarations :status) :accepted)
      (if (sh07-b51-core-evaluation-context-shape? context)
        (if (sh07-b51-sha256-id? target-id)
          (if (= (count children) (get recur-foundation :target-slot-count))
            (sh07-b51-build-core-node-preimage preimage)
            {:status :rejected :reason :recur-core-child-arity
             :partial-products []})
          {:status :rejected :reason :recur-target-reference
           :partial-products []})
        {:status :rejected :reason :core-evaluation-context
         :partial-products []})
      declarations)))

(defn sh07-b51-product-preimage
  [authority global-ordinal product-kind owner form]
  (sh07-b51-build-product-node-preimage
   {:domain :gravity/sh07-b51-product-node-id-preimage-v18
    :schema-version 18
    :predecessor-authority-id authority
    :global-product-ordinal global-ordinal
    :product-kind product-kind
    :owner-coordinate owner
    :owning-definition-form-id
    (get owner :owning-definition-form-id)
    :owning-definition-syntax-id
    (get owner :owning-definition-syntax-id)
    :source-origin-chain (get form :origin-chain)
    :source-generated-origin (get form :generated-origin)}))

(defn sh07-b51-repeat-product-preimages
  [authority owner form product-kind count-value first-ordinal]
  (loop [remaining count-value ordinal first-ordinal result []]
    (if (= remaining 0)
      {:status :accepted :preimages result :next-ordinal ordinal}
      (let [built
            (sh07-b51-product-preimage
             authority ordinal product-kind owner form)]
        (if (= (get built :status) :accepted)
          (recur
           (- remaining 1) (+ ordinal 1)
           (conj result (get built :preimage)))
          built)))))

(defn sh07-b51-owner-slot-product-preimages
  [authority owner owner-form slot-plan first-ordinal]
  (let [initializer
        (sh07-b51-repeat-product-preimages
         authority owner owner-form :slot-initializer 1 first-ordinal)]
    (if (= (get initializer :status) :accepted)
      (let [checks
            (sh07-b51-repeat-product-preimages
             authority owner owner-form :vector-check
             (count (get slot-plan :runtime-check-preimages))
             (get initializer :next-ordinal))]
        (if (= (get checks :status) :accepted)
          (let [projections
                (sh07-b51-repeat-product-preimages
                 authority owner owner-form :terminal-projection
                 (count (get slot-plan :terminal-projections))
                 (get checks :next-ordinal))]
            (if (= (get projections :status) :accepted)
              (let [publication
                    (sh07-b51-repeat-product-preimages
                     authority owner owner-form :slot-publication 1
                     (get projections :next-ordinal))]
                (if (= (get publication :status) :accepted)
                  {:status :accepted
                   :preimages
                   (sh07-b51-vector-append
                    (sh07-b51-vector-append
                     (get initializer :preimages) (get checks :preimages))
                    (sh07-b51-vector-append
                     (get projections :preimages)
                     (get publication :preimages)))
                   :next-ordinal (get publication :next-ordinal)}
                  publication))
              projections))
          checks))
      initializer)))

(defn sh07-b51-owner-product-node-preimages
  [request foundation authority first-ordinal]
  (let [indexes (sh07-b51-index-request request)
        owner (get foundation :owner-coordinate)
        owner-form
        (sh07-b51-find-form indexes (get owner :enclosing-form-id))]
    (loop [remaining (get foundation :slot-plans)
           ordinal first-ordinal result []]
      (if (= (count remaining) 0)
        {:status :accepted :preimages result :next-ordinal ordinal}
        (let [built
              (sh07-b51-owner-slot-product-preimages
               authority owner owner-form (first remaining) ordinal)]
          (if (= (get built :status) :accepted)
            (recur
             (rest remaining) (get built :next-ordinal)
             (sh07-b51-vector-append result (get built :preimages)))
            built))))))

(defn sh07-b51-recur-product-node-preimages
  [request recur-foundation authority first-ordinal]
  (let [indexes (sh07-b51-index-request request)
        coordinate (get recur-foundation :recur-coordinate)
        recur-form
        (sh07-b51-find-form indexes (get coordinate :recur-form-id))
        mapping (get recur-foundation :recur-slot-mapping-preimage)
        owner (get mapping :owner-coordinate)
        check-count
        (count (sh07-b51-flatten-reference-vectors
                (get recur-foundation :runtime-check-preimage-vectors)))
        projection-count
        (count (sh07-b51-flatten-reference-vectors
                (get recur-foundation :projection-vectors)))
        argument-count (count (get recur-foundation :argument-evaluations))
        checks
        (sh07-b51-repeat-product-preimages
         authority owner recur-form :vector-check check-count first-ordinal)]
    (if (= (get checks :status) :accepted)
      (let [projections
            (sh07-b51-repeat-product-preimages
             authority owner recur-form :terminal-projection projection-count
             (get checks :next-ordinal))]
        (if (= (get projections :status) :accepted)
          (let [arguments
                (sh07-b51-repeat-product-preimages
                 authority owner recur-form :recur-argument argument-count
                 (get projections :next-ordinal))]
            (if (= (get arguments :status) :accepted)
              (let [commit
                    (sh07-b51-repeat-product-preimages
                     authority owner recur-form :recur-commit 1
                     (get arguments :next-ordinal))]
                (if (= (get commit :status) :accepted)
                  {:status :accepted
                   :preimages
                   (sh07-b51-vector-append
                    (sh07-b51-vector-append
                     (get checks :preimages) (get projections :preimages))
                    (sh07-b51-vector-append
                     (get arguments :preimages) (get commit :preimages)))
                   :next-ordinal (get commit :next-ordinal)}
                  commit))
              arguments))
          projections))
      checks)))

(defn sh07-b51-occurrence-record-rank [record-kind]
  (if (= record-kind :ordinary-core-node) 0
    (if (= record-kind :supplemental-product) 1
      (if (= record-kind :binding-slot) 2
        (if (= record-kind :binding-extraction) 3
          (if (= record-kind :runtime-check) 4
            (if (= record-kind :publication-event) 5
              (if (= record-kind :recur-slot-mapping) 6
                (if (= record-kind :module-transcript) 7 nil)))))))))

(defn sh07-b51-occurrence-event-rank [event-kind]
  (if (= event-kind :initializer) 0
    (if (= event-kind :recur) 1 nil)))

(defn sh07-b51-occurrence-product-rank [product-kind]
  (if (= product-kind :slot-initializer) 0
    (if (= product-kind :vector-check) 1
      (if (= product-kind :terminal-projection) 2
        (if (= product-kind :slot-publication) 3
          (if (= product-kind :recur-argument) 4
            (if (= product-kind :recur-commit) 5 nil)))))))

(defn sh07-b51-raw-occurrence-preorder
  [request indexes fragment form root-index occurrence-path
   form-preorder-index owner-occurrence-index ancestry seen-form-ids]
  (if (> (count occurrence-path) 257)
    {:status :rejected :reason :form-occurrence-depth
     :partial-products []}
    (if (sh07-b51-vector-contains? ancestry (get form :form-id))
      {:status :rejected :reason :form-occurrence-cycle
       :partial-products []}
      (let [membership
            (sh07-b51-index-of
             (get fragment :form-ids) (get form :form-id))
            owner?
            (if (sh07-b51-authenticated-list-operator? indexes form 'let)
              true
              (sh07-b51-authenticated-list-operator? indexes form 'loop))]
        (if (= (get membership :count) 1)
          (if (sh07-b51-all-unique? (get form :child-form-ids))
            (loop [remaining (get form :child-form-ids)
                   raw-child-index 0
                   next-preorder (+ form-preorder-index 1)
                   next-owner-index
                   (if owner? (+ owner-occurrence-index 1)
                     owner-occurrence-index)
                   positions
                   [{:form-id (get form :form-id)
                     :occurrence-path occurrence-path
                     :root-index root-index
                     :fragment-ordinal (get fragment :ordinal)
                     :form-preorder-index form-preorder-index
                     :enclosing-occurrence-index
                     (if owner? owner-occurrence-index nil)}]
                   seen (conj seen-form-ids (get form :form-id))]
              (if (= (count remaining) 0)
                {:status :accepted
                 :positions positions
                 :next-form-preorder-index next-preorder
                 :next-owner-occurrence-index next-owner-index
                 :seen-form-ids seen}
                (let [child (sh07-b51-find-form indexes (first remaining))]
                  (if (map? child)
                    (if (= (get child :parent-form-id) (get form :form-id))
                      (let [walked
                            (sh07-b51-raw-occurrence-preorder
                             request indexes fragment child root-index
                             (conj occurrence-path raw-child-index)
                             next-preorder next-owner-index
                             (conj ancestry (get form :form-id)) seen)]
                        (if (= (get walked :status) :accepted)
                          (recur
                           (rest remaining) (+ raw-child-index 1)
                           (get walked :next-form-preorder-index)
                           (get walked :next-owner-occurrence-index)
                           (sh07-b51-vector-append
                            positions (get walked :positions))
                           (get walked :seen-form-ids))
                          walked))
                      {:status :rejected
                       :reason :form-occurrence-parent-substitution
                       :partial-products []})
                    {:status :rejected :reason :form-occurrence-child-missing
                     :partial-products []}))))
            {:status :rejected :reason :form-occurrence-child-duplicate
             :partial-products []})
          {:status :rejected :reason :form-fragment-position
           :partial-products []})))))

(defn sh07-b51-root-fragment [request root-id]
  (loop [remaining (get request :fragment-manifest)
         found nil count-found 0]
    (if (= (count remaining) 0)
      {:fragment found :count count-found}
      (if (= (get (first remaining) :fragment-id) root-id)
        (recur (rest remaining) (first remaining) (+ count-found 1))
        (recur (rest remaining) found count-found)))))

(defn sh07-b51-form-position-catalog [request]
  (let [indexes (sh07-b51-index-request request)
        root-ids (get request :top-level-form-ids)]
    (if (sh07-b51-indexes-unique? indexes)
      (if (sh07-b51-all-unique? root-ids)
        (loop [remaining root-ids root-index 0 owner-index 0
               positions [] seen #{}]
          (if (= (count remaining) 0)
            (if (= (count seen) (count (get request :forms)))
              {:status :accepted :positions positions
               :occurrence-aware true}
              {:status :rejected :reason :request-form-coverage-mismatch
               :partial-products []})
            (let [root (sh07-b51-find-form indexes (first remaining))
                  fragment-result
                  (sh07-b51-root-fragment request (first remaining))]
              (if (map? root)
                (if (= (get fragment-result :count) 1)
                  (let [walked
                        (sh07-b51-raw-occurrence-preorder
                         request indexes (get fragment-result :fragment)
                         root root-index [root-index] 0 owner-index [] seen)]
                    (if (= (get walked :status) :accepted)
                      (recur
                       (rest remaining) (+ root-index 1)
                       (get walked :next-owner-occurrence-index)
                       (sh07-b51-vector-append
                        positions (get walked :positions))
                       (get walked :seen-form-ids))
                      walked))
                  {:status :rejected :reason :root-fragment-nonunique
                   :partial-products []})
                {:status :rejected :reason :top-level-root-missing
                 :partial-products []}))))
        {:status :rejected :reason :top-level-root-duplicate
         :partial-products []})
      {:status :rejected :reason :request-index-duplicate
       :partial-products []})))

(defn sh07-b51-find-occurrence-position [positions form-id occurrence-path]
  (loop [remaining positions found nil count-found 0]
    (if (= (count remaining) 0)
      {:position found :count count-found}
      (let [position (first remaining)]
        (if (if (= (get position :form-id) form-id)
              (if (= occurrence-path nil)
                true
                (= (get position :occurrence-path) occurrence-path))
              false)
          (recur (rest remaining) position (+ count-found 1))
          (recur (rest remaining) found count-found))))))

(defn sh07-b51-occurrence-spec-shape? [spec]
  (if (sh07-b51-exact-keys?
       spec
       #{:record-kind :product-kind :event-kind :form-id
         :event-form-id :owner-form-id :form-occurrence-path
         :event-occurrence-path :owner-occurrence-path
         :core-postorder-index :slot-ordinal
         :pattern-preorder-index :local-use-index})
    (if (keyword? (get spec :record-kind))

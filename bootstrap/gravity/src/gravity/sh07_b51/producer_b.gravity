(defn
 sh07-b51-v16-replay-error-handler-region
 [outer-region form catch-form clause-ordinal clause-count]
 {:clause-count clause-count,
  :clause-ordinal clause-ordinal,
  :catch-form-id (get catch-form :form-id),
  :try-syntax-id (get form :syntax-id),
  :kind :typed-error-handler-candidate,
  :runtime-reachability :not-asserted-by-sh07-b9,
  :catch-syntax-id (get catch-form :syntax-id),
  :try-form-id (get form :form-id),
  :parent-region-kind
  (if (map? outer-region) (get outer-region :kind) outer-region)})

(defn
 sh07-b51-v16-replay-candidate-error-transfers
 [records start-ordinal owner-function-syntax-id]
 (loop
  [remaining (subvec records start-ordinal (count records)) values []]
  (if
   (= (count remaining) 0)
   values
   (let
    [record (first remaining)]
    (if
     (=
      (get record :evaluation-owner-function-syntax-id)
      owner-function-syntax-id)
     (recur
      (rest remaining)
      (conj
       values
       {:ordinal (get record :ordinal),
        :core-node-id (get record :core-node-id)}))
     (recur (rest remaining) values))))))

(defn
 sh07-b51-v16-replay-catch-binding-use-syntax-ids
 [records start-ordinal binding-id]
 (loop
  [remaining (subvec records start-ordinal (count records)) values []]
  (if
   (= (count remaining) 0)
   values
   (let
    [record (first remaining)]
    (if
     (= (get record :binding-id) binding-id)
     (recur (rest remaining) (conj values (get record :syntax-id)))
     (recur (rest remaining) values))))))


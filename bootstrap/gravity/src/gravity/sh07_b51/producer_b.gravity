  {:selection-policy :source-ordered-typed-handler-candidates,
   :protected-child-index 0,
   :handler-child-indexes
   (loop
    [remaining handler-clauses values []]
    (if
     (= (count remaining) 0)
     values
     (recur
      (rest remaining)
      (conj values (get (first remaining) :handler-child-index))))),
   :result-policy :protected-or-selected-handler-last,
   :evaluation-order :protected-then-ordered-typed-handler-candidates,
   :handler-clauses handler-clauses,
   :sh06-semantic-projection-id
   (get (get request :lineage) :sh06-semantic-projection-id),
   :handler-count (count handler-clauses),
   :runtime-reachability :not-asserted-by-sh07-b9,
   :authenticated-sh06-artifact-id
   (get (get request :lineage) :authenticated-sh06-artifact-id)}))

(defn
 sh07-b51-v16-replay-error-handler-record
 [request
  state
  ordinal
  node-id
  form
  protected-node-id
  handler-node-id
  clause-ordinal
  clause-count
  handler-child-index
  catch-form
  error-type-form
  error-type-binding
  catch-binding-form
  catch-binding
  binding-use-syntax-ids
  candidate-error-transfers]
 (sh07-b51-v16-replay-handler-add-legality-facts
  {:handler-core-node-id handler-node-id,
   :handler-child-index handler-child-index,
   :catch-clause-form-id (get catch-form :form-id),
   :clause-count clause-count,
   :selection-policy :source-ordered-typed-handler-candidates,
   :candidate-error-transfers candidate-error-transfers,
   :evaluation-region (get state :evaluation-region),
   :catch-binding-id (get catch-binding :binding-id),
   :ordinal ordinal,
   :result-policy :protected-or-selected-handler-last,
   :construction-order :protected-then-handlers-source-order-then-try,
   :catch-binding-syntax-id (get catch-binding-form :syntax-id),
   :clause-ordinal clause-ordinal,
   :ordered-steps
   [:evaluate-protected
    :conditionally-select-source-ordered-typed-handler],
   :syntax-id (get form :syntax-id),
   :error-type-binding-id (get error-type-binding :binding-id),
   :protected-core-node-id protected-node-id,
   :sh06-semantic-projection-id
   (get (get request :lineage) :sh06-semantic-projection-id),
   :catch-clause-syntax-id (get catch-form :syntax-id),
   :runtime-evaluation :protected-then-conditional-handler-chain,
   :runtime-reachability :not-asserted-by-sh07-b9,
   :core-node-id node-id,
   :form-id (get form :form-id),
   :catch-binding-form-id (get catch-binding-form :form-id),
   :authenticated-sh06-artifact-id
   (get (get request :lineage) :authenticated-sh06-artifact-id),
   :error-type-form-id (get error-type-form :form-id),
   :catch-binding-scope-id (get catch-binding :scope-id),
   :error-type-syntax-id (get error-type-form :syntax-id),
   :catch-binding-use-syntax-ids binding-use-syntax-ids,
   :evaluation-owner-function-syntax-id
   (get state :evaluation-owner-function-syntax-id)}))

(defn
 sh07-b51-v16-replay-list-clause-count
 [request form-ids operator]
 (loop
  [remaining form-ids count-value 0]
  (if
   (= (count remaining) 0)
   count-value
   (let
    [form
     (sh07-b51-v16-replay-find-form
      (get request :internal-indexes)
      (first remaining))]
    (recur
     (rest remaining)
     (if
      (if
       (= (get form :kind) :list)
       (= (sh07-b51-v16-replay-list-operator request form) operator)
       false)
      (+ count-value 1)
      count-value))))))

(defn
 sh07-b51-v16-replay-first-list-clause-index
 [request form-ids operator]
 (loop
  [remaining form-ids index 0]
  (if
   (= (count remaining) 0)
   nil
   (let
    [form
     (sh07-b51-v16-replay-find-form
      (get request :internal-indexes)
      (first remaining))]
    (if
     (if
      (= (get form :kind) :list)
      (= (sh07-b51-v16-replay-list-operator request form) operator)
      false)
     index
     (recur (rest remaining) (+ index 1)))))))

              false)
          (recur (rest remaining) (conj result resolution))
          (recur (rest remaining) result))))))

(defn sh07-b51-v16-resolution-reference-ids [resolutions]
  (loop [remaining resolutions result []]
    (if (= (count remaining) 0)
      result
      (recur
       (rest remaining)
       (conj result (get (first remaining) :reference-syntax-id))))))

(defn sh07-b51-v16-external-binding-ids
  [resolutions local-binding-ids]
  (loop [remaining resolutions result []]
    (if (= (count remaining) 0)
      result
      (let [binding-id (get (first remaining) :binding-id)]
        (if (sh07-b51-vector-contains? local-binding-ids binding-id)
          (recur (rest remaining) result)
          (if (sh07-b51-vector-contains? result binding-id)
            (recur (rest remaining) result)
            (recur (rest remaining) (conj result binding-id))))))))

(defn sh07-b51-v16-resolution-alias-name
  [request indexes resolution]
  (if (= (get resolution :resolution-order)
         :alias-qualified-required-binding)
    (let [binding
          (sh07-b51-find-binding indexes (get resolution :binding-id))]
      (loop [remaining (get request :alias-table)]
        (if (= (count remaining) 0)
          nil
          (let [alias-record (first remaining)
                alias-name (get alias-record :alias)]
            (if (if (= (get alias-record :namespace)
                       (get binding :namespace))
                  (= (str alias-name "/" (get binding :name))
                     (str (get resolution :symbol)))
                  false)
              alias-name
              (recur (rest remaining)))))))
    nil))

(defn sh07-b51-v16-fragment-alias-names
  [request indexes resolutions]
  (loop [remaining resolutions result []]
    (if (= (count remaining) 0)
      result
      (let [alias-name
            (sh07-b51-v16-resolution-alias-name
             request indexes (first remaining))]
        (if (= alias-name nil)

(defn sh07-b51-verify-template-private
  [raw-carrier template digest-requests]
  (if (sh07-b51-root1-invocation-shape? raw-carrier)
    (if (map? template)
      (if (vector? digest-requests)
        (let [rebuilt (sh07-b51-rebuild-success-template-private raw-carrier)]
          (if (= (get rebuilt :status) :accepted)
            (if (= template (get rebuilt :template))
                (if (= digest-requests (get rebuilt :digest-requests))

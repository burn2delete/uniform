       :preimage (get resolved :value)}
      nil)))

(defn sh07-b51-build-final-artifact-private
  [raw-carrier resolved-core predecessor-observation
   provenance-binding verifier-binding digest-requests resolved-digests]
  (if (sh07-b51-root1-invocation-shape? raw-carrier)
    (if (map? resolved-core)
      (if (map? predecessor-observation)
        (if (map? provenance-binding)
          (if (map? verifier-binding)
            (if (vector? digest-requests)
              (if (vector? resolved-digests)
                (let [plan (sh07-b51-success-plan-exact? digest-requests)
                      outcome-kind
                      (sh07-b51-success-outcome-kind digest-requests)]
                  (if (= (get plan :status) :accepted)
                    (if (sh07-b51-success-digest-replay-exhaustive
                         digest-requests resolved-digests)
                      (let [identity-selection
                            (sh07-b51-purpose-request
                             digest-requests :sh07-b51-core-identity-id)
                            observation-selection
                            (sh07-b51-purpose-request
                             digest-requests
                             :sh07-b51-predecessor-observation-id)
                            provenance-selection
                            (sh07-b51-purpose-request
                             digest-requests
                             :sh07-b51-provenance-binding-id)
                            verifier-selection
                            (sh07-b51-purpose-request
                             digest-requests
                             :sh07-b51-independent-verifier-binding-id)
                            final-selection
                            (sh07-b51-purpose-request
                             digest-requests
                             :sh07-b51-final-artifact-binding-id)]
                        (if (= [(get identity-selection :count)
                                (get observation-selection :count)
                                (get provenance-selection :count)
                                (get verifier-selection :count)
                                (get final-selection :count)]
                               [1 1 1 1 1])
                          (let [identity-request
                                (get identity-selection :request)
                                observation-request
                                (get observation-selection :request)
                                provenance-request
                                (get provenance-selection :request)
                                identity-resolved
                                (sh07-b51-resolve-controlled-preimage
                                 identity-request outcome-kind
                                 resolved-digests)
                                observation-resolved
                                (sh07-b51-resolve-controlled-preimage
                                 observation-request outcome-kind
                                 resolved-digests)
                                provenance-resolved
                                (sh07-b51-resolve-controlled-preimage
                                 provenance-request outcome-kind
                                 resolved-digests)
                                identity-id
                                (get resolved-digests
                                     (get identity-request :ordinal))
                                observation-id
                                (get resolved-digests
                                     (get observation-request :ordinal))
                                provenance-id
                                (get resolved-digests
                                     (get provenance-request :ordinal))
                                identity-record
                                {:artifact :gravity/sh07-b51-core-identity-v18
                                 :schema-version 18
                                 :semantic-identity-id identity-id
                                 :preimage (get identity-resolved :value)}
                                expected-core
                                (if (= (get identity-resolved :status)
                                       :accepted)
                                  (sh07-b51-resolved-core-from-identity-preimage
                                   (get identity-resolved :value) identity-id)
                                  nil)
                                expected-observation
                                {:artifact
                                 :gravity/sh07-b51-predecessor-observation-v18
                                 :schema-version 18
                                 :observation-id observation-id
                                 :preimage (get observation-resolved :value)}
                                expected-provenance
                                {:artifact :gravity/sh07-b51-provenance-binding-v18
                                 :schema-version 18
                                 :provenance-binding-id provenance-id
                                 :preimage (get provenance-resolved :value)}
                                verifier-record
                                (sh07-b51-r7-materialized-verifier
                                 (get verifier-selection :request)
                                 resolved-digests outcome-kind)
                                final-record
                                (sh07-b51-r7-materialized-final-binding
                                 (get final-selection :request)
                                 resolved-digests outcome-kind)]
                            (if (sh07-b51-materialized-core-identity-shape?
                                 identity-record)
                              (if (sh07-b51-resolved-core-shape?
                                   expected-core)
                                (if (= resolved-core expected-core)
                                  (if (sh07-b51-materialized-observation-shape?
                                       expected-observation)
                                    (if (= predecessor-observation
                                           expected-observation)
                                      (if (= raw-carrier
                                             (get (get expected-observation
                                                       :preimage)
                                                  :raw-adapter-request))
                                        (if (sh07-b51-materialized-provenance-shape?
                                             expected-provenance)
                                          (if (= provenance-binding
                                                 expected-provenance)
                                            (if (sh07-b51-materialized-verifier-shape?
                                                 verifier-record)
                                              (if (= verifier-binding
                                                     verifier-record)
                                                (if (sh07-b51-materialized-final-binding-shape?
                                                     final-record)
                                                  (let [verifier-id
                                                        (get verifier-record
                                                             :independent-verifier-binding-id)
                                                        final-id
                                                        (get final-record
                                                             :final-artifact-binding-id)
                                                        artifact
                                                        (sh07-b51-r7-canonical-artifact
                                                         resolved-core
                                                         provenance-id
                                                         verifier-id final-id)]
                                                    (if (sh07-b51-r7-canonical-artifact-exact?
                                                         artifact resolved-core
                                                         provenance-id
                                                         verifier-id final-id)
                                                      (sh07-b51-entrypoint-envelope
                                                       :accepted
                                                       :final-artifact-built
                                                       {:canonical-artifact
                                                        artifact
                                                        :outer-wrapper nil})
                                                      (sh07-b51-r7-boundary
                                                       :invocation-mismatch)))
                                                  (sh07-b51-r7-boundary
                                                   :invocation-mismatch))
                                                (sh07-b51-r7-boundary
                                                 :invocation-mismatch))
                                              (sh07-b51-r7-boundary

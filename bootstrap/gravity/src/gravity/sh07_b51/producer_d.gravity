  #{:artifact :schema-version :status :predecessor-outcome-kind
    :artifact-kind :task :semantic-identity-id :provenance-binding-id
    :independent-verifier-binding-id :final-artifact-binding-id
    :same-request-semantic-id :predecessor-authority-id :module :lineage
    :projection-binding :fragment-manifest :fragment-coverage
    :module-assembly-manifest :root-core-node-ids :definitions :nodes
    :evaluation-order :control-flow :reference-uses :var-references
    :mutations :error-transfers :error-handlers :match-branch-records
    :match-decision-skeletons :match-pattern-records :calls
    :function-records :call-edges :recursion-components :keyword-lookups
    :lexical-bindings :loop-bindings :recur-targets :recur-transfers
    :source-map :binding-table :declared-alias-table :resolution-table
    :macro-expansion-trace :macro-origin-traces :macro-origin-expectation
    :pending-fact-families :destructuring-product-nodes :binding-slots
    :binding-extractions :slot-extraction-transcript :runtime-checks
    :publication-events :recur-slot-mappings :legacy-v16-equivalence
    :diagnostics})

(defn sh07-b51-r7-canonical-artifact
  [resolved-core provenance-id verifier-id final-id]
  (let [base
        {:artifact :gravity/sh07-b51-canonical-core-artifact-v18
         :schema-version 18 :status :accepted
         :predecessor-outcome-kind
         (get resolved-core :predecessor-outcome-kind)
         :artifact-kind :gravity/sh07-b51-canonical-core-artifact-v18
         :task "SH-07-B51"
         :semantic-identity-id (get resolved-core :semantic-identity-id)
         :provenance-binding-id provenance-id
         :independent-verifier-binding-id verifier-id
         :final-artifact-binding-id final-id
         :same-request-semantic-id
         (get resolved-core :same-request-semantic-id)
         :predecessor-authority-id
         (get resolved-core :predecessor-authority-id)
         :module (get resolved-core :module)
         :lineage (get resolved-core :lineage)
         :projection-binding (get resolved-core :projection-binding)}]
    (loop [remaining (sh07-b51-product-key-order) result base]
      (if (= (count remaining) 0)
        (assoc result :diagnostics (get resolved-core :diagnostics))
        (recur
         (rest remaining)
         (assoc result (first remaining)
                (get resolved-core (first remaining))))))))

(defn sh07-b51-r7-canonical-artifact-exact?
  [artifact resolved-core provenance-id verifier-id final-id]
  (if (sh07-b51-exact-keys?
       artifact (sh07-b51-r7-canonical-artifact-keys))
    (if (= (count artifact) 57)
      (= artifact
         (sh07-b51-r7-canonical-artifact
          resolved-core provenance-id verifier-id final-id))
      false)
    false))

(defn sh07-b51-r7-materialized-verifier
  [request resolved-digests outcome-kind]
  (let [resolved
        (sh07-b51-resolve-controlled-preimage
         request outcome-kind resolved-digests)
        ordinal (get request :ordinal)]
    (if (= (get resolved :status) :accepted)
      {:artifact :gravity/sh07-b51-independent-verifier-binding-v18
       :schema-version 18
       :independent-verifier-binding-id (get resolved-digests ordinal)
       :preimage (get resolved :value)}
      nil)))

(defn sh07-b51-r7-materialized-final-binding

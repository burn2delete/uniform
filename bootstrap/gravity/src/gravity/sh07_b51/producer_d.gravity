; Gravity-owned SH-07 B51 bounded module; Attempt24 owner :r1-producer.
(ns gravity.sh07-b51.producer-d
  (:profile :meta)
  (:target :jvm)
  (:exports [sh07-b51-build-template sh07-b51-verify-template sh07-b51-resolve-template sh07-b51-verify-resolved sh07-b51-build-final-artifact])
  (:effects #{})
  (:capabilities #{})
  (:safety :safe))

(defn sh07-b51-producer-vector-node-extraction-ids
  [slot-plan extraction-references]
  (loop [remaining-preimages
         (get slot-plan :binding-extraction-preimages)
         remaining-references extraction-references result []]
    (if (= (count remaining-preimages) 0)
      result
      (recur
       (rest remaining-preimages) (rest remaining-references)
       (if (= (get (first remaining-preimages) :kind) :vector-node)
         (conj result (first remaining-references)) result)))))

(defn sh07-b51-producer-binding-slot-record
  [slot-plan slot-preimage slot-reference extraction-references]
  (let [owner (get slot-preimage :owner-coordinate)
        evaluation (get slot-plan :initializer-evaluation)
        publication (get slot-plan :publication-event-preimage)]
    {:schema :gravity/sh07-b51-binding-slot-v18
     :slot-id slot-reference
     :predecessor-authority-id
     (get slot-preimage :predecessor-authority-id)
     :global-slot-ordinal (get slot-preimage :global-slot-ordinal)
     :owner-kind (get slot-preimage :owner-kind)
     :owner-form-id (get slot-preimage :owner-form-id)
     :owner-syntax-id (get slot-preimage :owner-syntax-id)
     :owner-core-node-id (get slot-preimage :owner-core-node-id)
     :owner-coordinate owner
     :slot-coordinate (get slot-preimage :slot-coordinate)
     :enclosing-form-id (get owner :enclosing-form-id)
     :enclosing-syntax-id (get owner :enclosing-syntax-id)
     :fragment-id (get owner :fragment-id)
     :fragment-ordinal (get owner :fragment-ordinal)
     :owning-root-form-id (get owner :root-form-id)
     :owning-root-syntax-id (get owner :root-syntax-id)
     :owning-definition-form-id
     (get owner :owning-definition-form-id)
     :owning-definition-syntax-id
     (get owner :owning-definition-syntax-id)
     :def-form-id (get owner :def-form-id)
     :def-syntax-id (get owner :def-syntax-id)
     :defn-input-syntax-id (get owner :defn-input-syntax-id)
     :fn-form-id (get owner :fn-form-id)
     :fn-syntax-id (get owner :fn-syntax-id)
     :slot-ordinal (get slot-preimage :slot-ordinal)
     :pattern-form-id (get slot-preimage :pattern-form-id)
     :pattern-syntax-id (get slot-preimage :pattern-syntax-id)
     :pattern-scope-id (get slot-preimage :pattern-scope-id)
     :initializer-form-id (get slot-preimage :initializer-form-id)
     :initializer-syntax-id (get slot-preimage :initializer-syntax-id)
     :initializer-scope-id (get slot-preimage :initializer-scope-id)
     :initializer-core-node-id
     (get slot-preimage :initializer-core-node-id)
     :first-global-extraction-ordinal
     (get (first (get slot-plan :binding-extraction-preimages))
          :global-ordinal)
     :extraction-count
     (count (get slot-plan :binding-extraction-preimages))
     :terminal-count (count (get slot-plan :terminal-projections))
     :leaf-count (count (get publication :introduced-binding-ids))
     :vector-node-count (count (get slot-plan :runtime-check-preimages))
     :vector-node-extraction-ids
     (sh07-b51-producer-vector-node-extraction-ids
      slot-plan extraction-references)
     :visible-prior-binding-ids
     (get evaluation :visible-prior-binding-ids)
     :introduced-binding-ids (get publication :introduced-binding-ids)
     :runtime-policy (get slot-plan :runtime-policy)
     :mutability :immutable
     :source-origin-chain (get slot-preimage :source-origin-chain)
     :source-generated-origin
     (get slot-preimage :source-generated-origin)}))

(defn sh07-b51-producer-slot-items
  [slot-preimages slot-references extraction-reference-vectors]
  (if (= (count slot-preimages) (count slot-references))
    (if (= (count slot-preimages) (count extraction-reference-vectors))
      (loop [remaining-preimages slot-preimages
             remaining-references slot-references
             remaining-extractions extraction-reference-vectors
             result []]
        (if (= (count remaining-preimages) 0)
          {:status :accepted :items result}
          (recur
           (rest remaining-preimages)
           (rest remaining-references)
           (rest remaining-extractions)
           (conj result
                 {:preimage (first remaining-preimages)
                  :reference (first remaining-references)
                  :extractions (first remaining-extractions)}))))
      {:status :rejected :reason :producer-slot-item-cardinality
       :partial-products []})
    {:status :rejected :reason :producer-slot-item-cardinality
     :partial-products []}))

(defn sh07-b51-producer-select-slot-item [items expected-preimage]
  (loop [remaining items found nil found-count 0]
    (if (= (count remaining) 0)
      (if (= found-count 1)
        (let [removed (sh07-b51-remove-first-equal items found)]
          (if (get removed :found)
            {:status :accepted :item found
             :remaining-items (get removed :values)}
            {:status :rejected :reason :producer-slot-coordinate-join
             :partial-products []}))
        {:status :rejected :reason :producer-slot-coordinate-join
         :partial-products []})
      (let [item (first remaining)]
        (if (= (get item :preimage)
               (assoc
                expected-preimage :global-slot-ordinal
                (get (get item :preimage) :global-slot-ordinal)))
          (recur (rest remaining) item (+ found-count 1))
          (recur (rest remaining) found found-count))))))

(defn sh07-b51-producer-slot-records-for-owners
  [materialized-owners slot-preimages slot-references
   extraction-reference-vectors]
  (let [expected-count
        (loop [remaining materialized-owners result 0]
          (if (= (count remaining) 0) result
            (recur
             (rest remaining)
             (+ result
                (count
                 (get (get (first remaining) :foundation)
                      :slot-plans))))))
        item-result
        (sh07-b51-producer-slot-items
         slot-preimages slot-references extraction-reference-vectors)]
  (if (if (= (count slot-preimages) expected-count)
        (if (= (count slot-references) expected-count)
          (if (= (count extraction-reference-vectors) expected-count)
            (= (get item-result :status) :accepted)
            false)
          false)
        false)
  (loop [remaining-owners materialized-owners
         remaining-plans []
         remaining-items (get item-result :items)
         result []]
    (if (= (count remaining-plans) 0)
      (if (= (count remaining-owners) 0)
        (if (= (count remaining-items) 0)
          {:status :accepted :records result}
          {:status :rejected :reason :producer-slot-record-excess
           :partial-products []})
        (recur
         (rest remaining-owners)
         (get (get (first remaining-owners) :foundation) :slot-plans)
         remaining-items result))
      (let [selected
            (sh07-b51-producer-select-slot-item
             remaining-items
             (get (first remaining-plans) :binding-slot-preimage))]
        (if (= (get selected :status) :accepted)
          (let [item (get selected :item)
                record
                (sh07-b51-producer-binding-slot-record
                 (first remaining-plans) (get item :preimage)
                 (get item :reference) (get item :extractions))]
            (if (= (get item :reference)
                   (get (first remaining-plans) :slot-id))
              (if (= (get item :extractions)
                     (get (first remaining-plans) :extraction-ids))
                (if (sh07-b51-binding-slot-record-shape? record)
                  (recur
                   remaining-owners (rest remaining-plans)
                   (get selected :remaining-items) (conj result record))
                  {:status :rejected :reason :producer-slot-record-shape
                   :partial-products []})
                {:status :rejected
                 :reason :producer-slot-extraction-reference-join
                 :partial-products []})
              {:status :rejected :reason :producer-slot-reference-join
               :partial-products []}))
          selected))))
  {:status :rejected :reason :producer-slot-record-cardinality
   :partial-products []})))

(defn sh07-b51-v18-node-source [form]
  {:syntax-id (get form :syntax-id)
   :form-id (get form :form-id)
   :semantic-span (get form :source-span)
   :origin-chain (get form :origin-chain)
   :generated-origin (get form :generated-origin)})

(defn sh07-b51-v18-evaluation-order [evaluated-children]
  (loop [remaining evaluated-children index 0 result []]
    (if (= (count remaining) 0)
      result
      (recur
       (rest remaining) (+ index 1)
       (conj result {:index index :core-node-id (first remaining)})))))

(defn sh07-b51-v18-add-node
  [request form core-form children attributes binding-ids evaluation-kind
   evaluation-region evaluation-owner predecessor-authority node-id]
  (let [module (get request :module)
        declarations (sh07-b51-module-preserved-declarations request)
        evaluated-children
        (sh07-b51-v18-evaluated-children evaluation-kind children)
        preimage
        {:domain :gravity/sh07-b51-core-node-id-preimage-v18
         :schema-version 18
         :predecessor-authority-id predecessor-authority
         :core-form core-form
         :children children
         :attributes attributes
         :source (sh07-b51-v18-node-source form)
         :resolved-binding-ids binding-ids
         :evaluation-kind evaluation-kind
         :evaluation-region evaluation-region
         :evaluation-owner-function-syntax-id evaluation-owner
         :evaluated-children evaluated-children
         :namespace (get module :namespace)
         :profile (get module :profile)
         :target (get module :target)
         :metadata (get form :metadata)
         :binding-context (get form :scope-id)
         :generated? (> (count (get form :generated-origin)) 0)
         :preserved-declarations (get declarations :value)
         :pending-fact-families [:types :effects :ownership :safety]}
        record
        {:artifact :gravity/sh07-b51-core-node-v18
         :schema-version 18
         :node-id node-id
         :core-form core-form
         :children children
         :attributes attributes
         :source (sh07-b51-v18-node-source form)
         :binding-context (get form :scope-id)
         :generated? (> (count (get form :generated-origin)) 0)
         :resolved-binding-ids binding-ids
         :evaluation
         {:kind evaluation-kind
          :region evaluation-region
          :owner-function-syntax-id evaluation-owner
          :order (sh07-b51-v18-evaluation-order evaluated-children)}
         :module
         {:namespace (get module :namespace)
          :profile (get module :profile)
          :target (get module :target)}
         :metadata (get form :metadata)
         :preserved-declarations (get declarations :value)
         :pending-fact-families [:types :effects :ownership :safety]
         :lowering-rule-version :sh07-b51-v18}]
    (if (= (get declarations :status) :accepted)
      (if (= form
             (sh07-b51-find-form
              (sh07-b51-index-request request) (get form :form-id)))
        (if (sh07-b51-internal-reference? node-id)
          (if (sh07-b51-core-node-preimage-shape? preimage)
            (if (sh07-b51-core-node-record-preimage-agrees? record preimage)
              {:status :accepted :preimage preimage :record record
               :node-id node-id}
              {:status :rejected :reason :producer-v18-node-record-agreement
               :partial-products []})
            {:status :rejected :reason :producer-v18-node-preimage-shape
             :partial-products []})
          {:status :rejected :reason :producer-v18-node-id
           :partial-products []})
        {:status :rejected :reason :producer-v18-node-form-substitution
         :partial-products []})
      declarations)))

(defn sh07-b51-v18-parent-region-kind [region]
  (if (map? region) (get region :kind) region))

(defn sh07-b51-v18-if-child-region [outer-region form role]
  {:kind :conditional-branch
   :if-syntax-id (get form :syntax-id)
   :if-form-id (get form :form-id)
   :role role
   :execution :selected-exactly-once
   :parent-region-kind (sh07-b51-v18-parent-region-kind outer-region)
   :parent-if-syntax-id
   (if (= (sh07-b51-v18-parent-region-kind outer-region)
          :conditional-branch)
     (get outer-region :if-syntax-id) nil)
   :parent-branch-role
   (if (= (sh07-b51-v18-parent-region-kind outer-region)
          :conditional-branch)
     (get outer-region :role) nil)})

(defn sh07-b51-v18-try-child-region
  [indexes outer-region form raw-child-index]
  (let [catch-form
        (sh07-b51-find-form indexes
                            (get (get form :child-form-ids)
                                 raw-child-index))
        handler-count (- (count (get form :child-form-ids)) 2)
        clause-ordinal (- raw-child-index 2)]
    {:kind :typed-error-handler-candidate
     :try-syntax-id (get form :syntax-id)
     :try-form-id (get form :form-id)
     :catch-syntax-id (get catch-form :syntax-id)
     :catch-form-id (get catch-form :form-id)
     :clause-ordinal clause-ordinal
     :clause-count handler-count
     :runtime-reachability :not-asserted-by-sh07-b9
     :parent-region-kind (sh07-b51-v18-parent-region-kind outer-region)}))

(defn sh07-b51-v18-child-context
  [indexes form child-occurrence context]
  (let [operator (sh07-b51-authenticated-operator-symbol indexes form)
        relative-path (get child-occurrence :relative-path)
        first-index (first relative-path)
        outer-region (get context :evaluation-region)
        outer-owner (get context :evaluation-owner-function-syntax-id)
        reference-position
        (if (if (= (get form :kind) :list)
              (if (= first-index 0)
                (if (symbol? operator)
                  (if (contains?
                       #{'quote 'var 'fn 'def 'if 'do 'let 'loop 'recur
                         'set! 'throw 'try 'match 'catch 'finally 'ns}
                       operator)
                    false true)
                  false)
                false)
              false)
          :operator :expression)]
    (if (= operator 'fn)
      {:evaluation-region :function-body
       :evaluation-owner-function-syntax-id (get form :syntax-id)
       :reference-position reference-position}
      (if (= operator 'if)
        {:evaluation-region
         (if (= first-index 2)
           (sh07-b51-v18-if-child-region outer-region form :then)
           (if (= first-index 3)
             (sh07-b51-v18-if-child-region outer-region form :else)
             outer-region))
         :evaluation-owner-function-syntax-id outer-owner
         :reference-position reference-position}
        (if (= operator 'try)
          {:evaluation-region
           (if (> first-index 1)
             (sh07-b51-v18-try-child-region
              indexes outer-region form first-index)
             outer-region)
           :evaluation-owner-function-syntax-id outer-owner
           :reference-position reference-position}
          (if (= operator 'match)
            {:evaluation-region
             (if (> first-index 1)
               {:kind :match-branch
                :match-syntax-id (get form :syntax-id)
                :clause-ordinal (/ (- first-index 3) 2)}
               outer-region)
             :evaluation-owner-function-syntax-id outer-owner
             :reference-position reference-position}
            {:evaluation-region outer-region
             :evaluation-owner-function-syntax-id outer-owner
             :reference-position reference-position}))))))

(defn sh07-b51-v18-context-walk
  [request indexes form occurrence-path context depth ancestry]
  (if (sh07-b51-nonnegative-path? occurrence-path)
  (if (> depth 256)
    {:status :rejected :reason :producer-v18-context-depth
     :partial-products []}
    (if (sh07-b51-vector-contains? ancestry (get form :form-id))
      {:status :rejected :reason :producer-v18-context-cycle
       :partial-products []}
      (if (= form (sh07-b51-find-form indexes (get form :form-id)))
        (let [selected
              (sh07-b51-core-expression-child-ids indexes form)
              child-occurrences
              (sh07-b51-core-expression-child-occurrences indexes form)
              current
              {:form-id (get form :form-id)
               :syntax-id (get form :syntax-id)
               :occurrence-path occurrence-path
               :evaluation-region (get context :evaluation-region)
               :evaluation-owner-function-syntax-id
               (get context :evaluation-owner-function-syntax-id)
               :reference-position (get context :reference-position)}]
          (if (= (get selected :status) :accepted)
          (if (sh07-b51-child-occurrences-align?
               (get selected :child-form-ids) child-occurrences)
          (loop [remaining child-occurrences records [current]]
            (if (= (count remaining) 0)
              {:status :accepted :records records}
              (let [child-occurrence (first remaining)
                    child-form
                    (sh07-b51-find-form
                     indexes (get child-occurrence :form-id))
                    child-context
                    (sh07-b51-v18-child-context
                     indexes form child-occurrence context)
                    walked
                    (if (map? child-form)
                      (sh07-b51-v18-context-walk
                       request indexes child-form
                       (sh07-b51-vector-append
                        occurrence-path
                        (get child-occurrence :relative-path))
                       child-context (+ depth 1)
                       (conj ancestry (get form :form-id)))
                      {:status :rejected
                       :reason :producer-v18-context-child-missing
                       :partial-products []})]
                (if (= (get walked :status) :accepted)
                  (recur
                   (rest remaining)
                   (sh07-b51-vector-append records (get walked :records)))
                  walked))))
          {:status :rejected :reason :producer-v18-context-child-alignment
           :partial-products []})
          selected))
        {:status :rejected :reason :producer-v18-context-form-substitution
         :partial-products []})))
  {:status :rejected :reason :producer-v18-context-occurrence-path
   :partial-products []}))

(defn sh07-b51-v18-context-coverage-exact?
  [request contexts postorder positions]
  (if (= (count contexts) (count postorder))
    (loop [remaining contexts seen #{}]
      (if (= (count remaining) 0)
        (= (count seen) (count postorder))
        (let [context (first remaining)
              locator [(get context :form-id) (get context :occurrence-path)]
              postorder-result
              (sh07-b51-find-postorder-record
               postorder (get context :form-id)
               (get context :occurrence-path))
              position-result
              (sh07-b51-find-occurrence-position
               positions (get context :form-id)
               (get context :occurrence-path))]
          (if (= (get postorder-result :count) 1)
            (if (= (get position-result :count) 1)
              (if (contains? seen locator)
                false
                (recur (rest remaining) (conj seen locator)))
              false)
            false))))
    false))

(defn sh07-b51-v18-context-catalog [request]
  (let [indexes (sh07-b51-index-request request)
        postorder (sh07-b51-independent-core-postorder request)
        positions (sh07-b51-form-position-catalog request)]
    (if (sh07-b51-indexes-unique? indexes)
      (if (= (get postorder :status) :accepted)
      (if (= (get positions :status) :accepted)
      (loop [remaining (get request :top-level-form-ids)
             root-index 0 records []]
        (if (= (count remaining) 0)
          (if (sh07-b51-v18-context-coverage-exact?
               request records (get postorder :records)
               (get positions :positions))
            {:status :accepted :records records
             :postorder-coverage-exact true
             :position-coverage-exact true}
            {:status :rejected :reason :producer-v18-context-coverage
             :partial-products []})
          (let [form (sh07-b51-find-form indexes (first remaining))
                operator
                (sh07-b51-authenticated-operator-symbol indexes form)]
            (if (= operator 'ns)
              (recur (rest remaining) (+ root-index 1) records)
              (let [walked
                    (if (map? form)
                      (sh07-b51-v18-context-walk
                       request indexes form [root-index]
                       {:evaluation-region :module-initialization
                        :evaluation-owner-function-syntax-id nil
                        :reference-position :expression}
                       0 [])
                      {:status :rejected
                       :reason :producer-v18-context-root-missing
                       :partial-products []})]
                (if (= (get walked :status) :accepted)
                  (recur
                   (rest remaining) (+ root-index 1)
                   (sh07-b51-vector-append records (get walked :records)))
                  walked))))))
      positions)
      postorder)
      {:status :rejected :reason :producer-v18-context-index-duplicate
       :partial-products []})))

(defn sh07-b51-v18-find-context
  [catalog form-id occurrence-path]
  (loop [remaining (get catalog :records) found nil found-count 0]
    (if (= (count remaining) 0)
      (if (= found-count 1)
        {:status :accepted :context found}
        {:status :rejected :reason :producer-v18-context-join
         :partial-products []})
      (let [record (first remaining)]
        (if (if (= (get record :form-id) form-id)
              (= (get record :occurrence-path) occurrence-path)
              false)
          (recur (rest remaining) record (+ found-count 1))
          (recur (rest remaining) found found-count))))))

(defn sh07-b51-v18-classify-form [indexes form]
  (let [kind (get form :kind)
        operator-form
        (if (= kind :list)
          (sh07-b51-find-form indexes
                              (first (get form :child-form-ids)))
          nil)
        operator
        (if (= (get operator-form :kind) :symbol)
          (get operator-form :value) nil)]
    (if (= kind :symbol)
      {:status :accepted :core-form :reference}
      (if (contains?
           #{:nil :boolean :integer :decimal :ratio :character
             :string :keyword}
           kind)
        {:status :accepted :core-form :literal}
        (if (contains? #{:vector :map :set} kind)
          {:status :accepted :core-form :collection-literal}
          (if (= kind :list)
            (if (= (get operator-form :kind) :keyword)
              {:status :accepted :core-form :keyword-map-lookup}
              (if (= (get operator-form :kind) :symbol)
                (if (= operator 'quote) {:status :accepted :core-form :quote}
                  (if (= operator 'var) {:status :accepted :core-form :var}
                    (if (= operator 'set!)
                      {:status :accepted :core-form :set!}
                      (if (= operator 'throw)
                        {:status :accepted :core-form :throw}
                        (if (= operator 'try)
                          {:status :accepted :core-form :try}
                          (if (= operator 'fn)
                            {:status :accepted :core-form :fn}
                            (if (= operator 'let)
                              {:status :accepted :core-form :let}
                              (if (= operator 'loop)
                                {:status :accepted :core-form :loop}
                                (if (= operator 'recur)
                                  {:status :accepted :core-form :recur}
                                  (if (= operator 'def)
                                    {:status :accepted :core-form :def}
                                    (if (= operator 'if)
                                      {:status :accepted :core-form :if}
                                      (if (= operator 'do)
                                        {:status :accepted :core-form :do}
                                        (if (= operator 'match)
                                          {:status :accepted
                                           :core-form :match}
                                          (if (contains?
                                               #{'catch 'finally 'ns 'defconst
                                                 'syntax-quote 'unquote
                                                 'splice-unquote 'unsafe}
                                               operator)
                                            {:status :rejected
                                             :reason
                                             :producer-v18-non-expression-form
                                            :partial-products []}
                                            {:status :accepted
                                             :core-form :call}))))))))))))))
                {:status :rejected
                 :reason :producer-v18-call-operator-kind
                 :partial-products []}))
            {:status :rejected :reason :producer-v18-form-kind
             :partial-products []}))))))

(defn sh07-b51-v18-child-node-ids [postorder-record core-base]
  (loop [remaining (get postorder-record :child-core-postorder-indexes)
         result []]
    (if (= (count remaining) 0)
      result
      (recur
       (rest remaining)
       (conj result
             (sh07-b51-internal-reference
             (+ core-base (first remaining))))))))

(defn sh07-b51-v18-alias-qualified-name-valid?
  [indexes reference-symbol binding]
  (loop [remaining (vec (get (get indexes :aliases) :by-primary))]
    (if (= (count remaining) 0)
      false
      (let [alias-record (second (first remaining))]
        (if (= (str (get alias-record :alias) "/"
                    (get binding :name))
               (str reference-symbol))
          (if (= (get alias-record :namespace)
                 (get binding :namespace))
            (if (= (get alias-record :dependency-artifact-id)
                   (get binding :definition-artifact-id))
              (if (sh07-b51-vector-contains?
                   (get binding :profile-set)
                   (get alias-record :profile))
                (if (sh07-b51-all-unique? (get binding :profile-set))
                  (if (sh07-b51-all-unique? (get binding :target-set))
                    (sh07-b51-vector-subset?
                     (get alias-record :targets)
                     (get binding :target-set))
                    false)
                  false)
                false)
              false)
            false)
          (recur (rest remaining)))))))

(defn sh07-b51-v18-resolution-binding-name-valid?
  [indexes resolution binding]
  (let [reference-symbol (get resolution :symbol)
        order (get resolution :resolution-order)
        namespace-qualified
        (= (str (get binding :namespace) "/" (get binding :name))
           (str reference-symbol))]
    (if (= order :fully-qualified-namespace-binding)
      namespace-qualified
      (if (= order :alias-qualified-required-binding)
        (sh07-b51-v18-alias-qualified-name-valid?
         indexes reference-symbol binding)
        (if (= order :explicit-foreign-import-binding)
          (if namespace-qualified
            true
            (if (= (get binding :name) reference-symbol)
              true
              (sh07-b51-v18-alias-qualified-name-valid?
               indexes reference-symbol binding)))
          (= (get binding :name) reference-symbol))))))

(defn sh07-b51-v18-reference-semantics
  [indexes form context]
  (let [resolution (sh07-b51-find-resolution indexes (get form :syntax-id))
        binding
        (if (map? resolution)
          (sh07-b51-find-binding indexes (get resolution :binding-id)) nil)
        expected-position (get context :reference-position)]
    (if (map? resolution)
      (if (map? binding)
        (if (= (get resolution :symbol) (get form :value))
          (if (= (get resolution :position) expected-position)
            (if (= (get resolution :binding-id) (get binding :binding-id))
              (if (sh07-b51-v18-resolution-binding-name-valid?
                   indexes resolution binding)
                {:status :accepted
                 :attributes
                 {:symbol (get form :value)
                  :position expected-position
                  :binding-id (get binding :binding-id)
                  :binding-class (get binding :binding-class)
                  :definition-syntax-id
                  (get binding :definition-syntax-id)}
                 :binding-ids [(get binding :binding-id)]
                 :evaluation-kind :value}
                {:status :rejected
                 :reason :producer-v18-reference-binding-name
                 :partial-products []})
              {:status :rejected
               :reason :producer-v18-reference-binding-id
               :partial-products []})
            {:status :rejected :reason :producer-v18-reference-position
             :partial-products []})
          {:status :rejected :reason :producer-v18-reference-symbol
           :partial-products []})
        {:status :rejected :reason :producer-v18-reference-binding
         :partial-products []})
      {:status :rejected :reason :producer-v18-reference-resolution
       :partial-products []})))

(defn sh07-b51-v18-definition-binding-ids [indexes forms]
  (loop [remaining forms result []]
    (if (= (count remaining) 0)
      {:status :accepted :binding-ids result}
      (let [form (first remaining)
            binding
            (sh07-b51-find-binding-by-definition
             indexes (get form :syntax-id))]
        (if (map? binding)
          (if (if (= (get form :kind) :symbol)
                (if (= (get form :value) '&) false true)
                false)
            (if (= (get binding :name) (get form :value))
              (if (= (get binding :binding-class) :lexical)
                (if (= (get binding :definition-syntax-id)
                       (get form :syntax-id))
                  (if (= (get binding :scope-id) (get form :scope-id))
                    (recur (rest remaining)
                           (conj result (get binding :binding-id)))
                    {:status :rejected
                     :reason :producer-v18-definition-binding-scope
                     :partial-products []})
                  {:status :rejected
                   :reason :producer-v18-definition-binding-syntax
                   :partial-products []})
                {:status :rejected
                 :reason :producer-v18-definition-binding-class
                 :partial-products []})
              {:status :rejected
               :reason :producer-v18-definition-binding-name
               :partial-products []})
            {:status :rejected
             :reason :producer-v18-definition-binding-symbol
             :partial-products []})
          {:status :rejected :reason :producer-v18-definition-binding
           :partial-products []})))))

(defn sh07-b51-v18-forms-for-ids [indexes form-ids]
  (loop [remaining form-ids result []]
    (if (= (count remaining) 0)
      {:status :accepted :forms result}
      (let [form (sh07-b51-find-form indexes (first remaining))]
        (if (map? form)
          (recur (rest remaining) (conj result form))
          {:status :rejected :reason :producer-v18-form-id-join
           :partial-products []})))))

(defn sh07-b51-v18-var-semantics [request indexes form]
  (let [operand
        (sh07-b51-find-form indexes (get (get form :child-form-ids) 1))
        resolution
        (if (map? operand)
          (sh07-b51-find-resolution indexes (get operand :syntax-id)) nil)
        binding
        (if (map? resolution)
          (sh07-b51-find-binding indexes (get resolution :binding-id)) nil)
        lineage (get request :lineage)]
    (if (= (count (get form :child-form-ids)) 2)
    (if (= (get operand :kind) :symbol)
      (if (map? resolution)
        (if (map? binding)
          (if (= (get resolution :symbol) (get operand :value))
            (if (= (get resolution :position) :expression)
              (if (= (get binding :binding-class) :namespace)
                (if (contains? #{:var :function} (get binding :kind))
                  (if (= (get binding :namespace)
                         (get (get request :module) :namespace))
                    (if (= (get resolution :resolution-order)
                           :current-namespace-binding)
                      (if (= (get resolution :upstream-binding-id)
                             (get binding :upstream-binding-id))
                      {:status :accepted
                       :attributes
                       {:symbol (get operand :value)
                        :binding-id (get binding :binding-id)
                        :binding-class :namespace
                        :definition-kind (get binding :kind)
                        :object-kind :top-level-var
                        :upstream-binding-id
                        (get binding :upstream-binding-id)
                        :namespace (get binding :namespace)
                        :definition-syntax-id
                        (get binding :definition-syntax-id)
                        :definition-artifact-id
                        (get binding :definition-artifact-id)
                        :operand-form-id (get operand :form-id)
                        :operand-syntax-id (get operand :syntax-id)
                        :object-policy
                        :reference-without-dereference-or-execution
                        :resolution-order :current-namespace-binding
                        :authenticated-sh06-artifact-id
                        (get lineage :authenticated-sh06-artifact-id)
                        :sh06-semantic-projection-id
                        (get lineage :sh06-semantic-projection-id)
                        :profile-legality :pending-sh09}
                       :binding-ids [(get binding :binding-id)]
                       :evaluation-kind :no-evaluation}
                      {:status :rejected
                       :reason :producer-v18-var-upstream-binding
                       :partial-products []})
                      {:status :rejected
                       :reason :producer-v18-var-resolution-order
                       :partial-products []})
                    {:status :rejected
                     :reason :producer-v18-var-namespace
                     :partial-products []})
                  {:status :rejected :reason :producer-v18-var-kind
                   :partial-products []})
                {:status :rejected :reason :producer-v18-var-binding-class
                 :partial-products []})
              {:status :rejected :reason :producer-v18-var-position
               :partial-products []})
            {:status :rejected :reason :producer-v18-var-symbol
             :partial-products []})
          {:status :rejected :reason :producer-v18-var-binding
           :partial-products []})
        {:status :rejected :reason :producer-v18-var-resolution
         :partial-products []})
      {:status :rejected :reason :producer-v18-var-operand
       :partial-products []})
    {:status :rejected :reason :producer-v18-var-arity
     :partial-products []})))

(defn sh07-b51-v18-set-semantics [request indexes form children]
  (let [target
        (sh07-b51-find-form indexes (get (get form :child-form-ids) 1))
        resolution
        (if (map? target)
          (sh07-b51-find-resolution indexes (get target :syntax-id)) nil)
        binding
        (if (map? resolution)
          (sh07-b51-find-binding indexes (get resolution :binding-id)) nil)
        lineage (get request :lineage)]
    (if (if (= (count children) 1)
          (= (count (get form :child-form-ids)) 3) false)
      (if (= (get target :kind) :symbol)
        (if (map? resolution)
          (if (map? binding)
            (if (= (get resolution :symbol) (get target :value))
              (if (= (get resolution :position) :expression)
                (if (= (get binding :binding-class) :namespace)
                  (if (contains? #{:var :function} (get binding :kind))
                    (if (= (get binding :namespace)
                           (get (get request :module) :namespace))
                      (if (= (get resolution :resolution-order)
                             :current-namespace-binding)
                        (if (= (get resolution :upstream-binding-id)
                               (get binding :upstream-binding-id))
                        {:status :accepted
                         :attributes
                         {:target-symbol (get target :value)
                          :target-binding-id (get binding :binding-id)
                          :target-binding-class :namespace
                          :target-definition-kind (get binding :kind)
                          :target-location :top-level-var
                          :target-upstream-binding-id
                          (get binding :upstream-binding-id)
                          :target-namespace (get binding :namespace)
                          :target-definition-syntax-id
                          (get binding :definition-syntax-id)
                          :target-definition-artifact-id
                          (get binding :definition-artifact-id)
                          :target-form-id (get target :form-id)
                          :target-syntax-id (get target :syntax-id)
                          :resolution-order :current-namespace-binding
                          :target-evaluation :none
                          :value-child-index 0
                          :evaluation-order :evaluate-value-then-write
                          :result-policy :unit
                          :required-effect :state/write
                          :authenticated-sh06-artifact-id
                          (get lineage :authenticated-sh06-artifact-id)
                          :sh06-semantic-projection-id
                          (get lineage :sh06-semantic-projection-id)
                          :type-legality :pending-sh08
                          :effect-registry-legality :pending-sh09
                          :effect-profile-capability-legality :pending-sh09
                          :ownership-legality :pending-sh10
                          :safety-classification :pending-sh11}
                         :binding-ids [(get binding :binding-id)]
                         :evaluation-kind :value-then-write}
                        {:status :rejected
                         :reason :producer-v18-set-upstream-binding
                         :partial-products []})
                        {:status :rejected
                         :reason :producer-v18-set-resolution-order
                         :partial-products []})
                      {:status :rejected :reason :producer-v18-set-namespace
                       :partial-products []})
                    {:status :rejected :reason :producer-v18-set-kind
                     :partial-products []})
                  {:status :rejected :reason :producer-v18-set-binding-class
                   :partial-products []})
                {:status :rejected :reason :producer-v18-set-position
                 :partial-products []})
              {:status :rejected :reason :producer-v18-set-symbol
               :partial-products []})
            {:status :rejected :reason :producer-v18-set-binding
             :partial-products []})
          {:status :rejected :reason :producer-v18-set-resolution
           :partial-products []})
        {:status :rejected :reason :producer-v18-set-target
         :partial-products []})
      {:status :rejected :reason :producer-v18-set-arity
       :partial-products []})))

(defn sh07-b51-v18-try-handler-descriptors [request indexes form]
  (loop [remaining (rest (rest (get form :child-form-ids)))
         clause-ordinal 0 descriptors [] binding-ids []]
    (if (= (count remaining) 0)
      {:status :accepted :descriptors descriptors
       :binding-ids binding-ids}
      (let [catch-form (sh07-b51-find-form indexes (first remaining))
            catch-children (get catch-form :child-form-ids)
            error-type-form
            (sh07-b51-find-form indexes (get catch-children 1))
            catch-binding-form
            (sh07-b51-find-form indexes (get catch-children 2))
            error-resolution
            (if (map? error-type-form)
              (sh07-b51-find-resolution
               indexes (get error-type-form :syntax-id)) nil)
            error-binding
            (if (map? error-resolution)
              (sh07-b51-find-binding
               indexes (get error-resolution :binding-id)) nil)
            catch-binding
            (if (map? catch-binding-form)
              (sh07-b51-find-binding-by-definition
               indexes (get catch-binding-form :syntax-id)) nil)]
        (if (= (sh07-b51-authenticated-operator-symbol indexes catch-form)
               'catch)
          (if (= (count catch-children) 4)
            (if (map? error-binding)
              (if (map? catch-binding)
                (if (= (get error-resolution :symbol)
                       (get error-type-form :value))
                  (if (= (get error-resolution :position) :type)
                    (if (= (get error-resolution :upstream-binding-id)
                           (get error-binding :upstream-binding-id))
                    (if (if (= (get error-binding :kind) :type)
                          (= (get error-binding :binding-class) :core)
                          false)
                    (if (if (= (get catch-binding-form :kind) :symbol)
                          (if (= (get catch-binding :kind) :local)
                            (if (= (get catch-binding :binding-class) :lexical)
                              (if (= (get catch-binding :definition-syntax-id)
                                     (get catch-binding-form :syntax-id))
                                (= (get catch-binding :scope-id)
                                   (get catch-binding-form :scope-id))
                                false)
                              false)
                            false)
                          false)
                    (if (= (get catch-binding :name)
                           (get catch-binding-form :value))
                      (let [descriptor
                            {:handler-child-index (+ clause-ordinal 1)
                             :catch-clause-form-id
                             (get catch-form :form-id)
                             :catch-binding-id
                             (get catch-binding :binding-id)
                             :catch-binding-syntax-id
                             (get catch-binding-form :syntax-id)
                             :clause-ordinal clause-ordinal
                             :error-type-binding-id
                             (get error-binding :binding-id)
                             :catch-clause-syntax-id
                             (get catch-form :syntax-id)
                             :catch-binding-form-id
                             (get catch-binding-form :form-id)
                             :error-type-form-id
                             (get error-type-form :form-id)
                             :catch-binding-scope-id
                             (get catch-binding :scope-id)
                             :error-type-syntax-id
                             (get error-type-form :syntax-id)}]
                        (if (sh07-b51-ordinary-handler-clause-shape?
                             descriptor clause-ordinal)
                          (recur
                           (rest remaining) (+ clause-ordinal 1)
                           (conj descriptors descriptor)
                           (conj
                            (conj binding-ids
                                  (get error-binding :binding-id))
                            (get catch-binding :binding-id)))
                          {:status :rejected
                           :reason :producer-v18-try-descriptor-shape
                           :partial-products []}))
                      {:status :rejected
                       :reason :producer-v18-catch-binding-name
                       :partial-products []})
                    {:status :rejected
                     :reason :producer-v18-catch-binding-authentication
                     :partial-products []})
                    {:status :rejected
                     :reason :producer-v18-catch-type-binding-class
                     :partial-products []})
                    {:status :rejected
                     :reason :producer-v18-catch-type-upstream-binding
                     :partial-products []})
                    {:status :rejected
                     :reason :producer-v18-catch-type-position
                     :partial-products []})
                  {:status :rejected :reason :producer-v18-catch-type-symbol
                   :partial-products []})
                {:status :rejected :reason :producer-v18-catch-binding
                 :partial-products []})
              {:status :rejected :reason :producer-v18-catch-type-binding
               :partial-products []})
            {:status :rejected :reason :producer-v18-catch-shape
             :partial-products []})
          {:status :rejected :reason :producer-v18-try-handler
           :partial-products []})))))

(defn sh07-b51-v18-try-semantics [request indexes form children]
  (let [handlers (sh07-b51-v18-try-handler-descriptors
                  request indexes form)
        lineage (get request :lineage)]
    (if (= (get handlers :status) :accepted)
      (let [descriptors (get handlers :descriptors)
            handler-count (count descriptors)]
        (if (> handler-count 0)
          (if (= (count children) (+ handler-count 1))
            {:status :accepted
             :attributes
             {:protected-child-index 0
              :handler-count handler-count
              :handler-child-indexes
              (sh07-b51-vector-range 1 handler-count)
              :handler-clauses descriptors
              :evaluation-order
              :protected-then-ordered-typed-handler-candidates
              :runtime-reachability :not-asserted-by-sh07-b9
              :selection-policy :source-ordered-typed-handler-candidates
              :result-policy :protected-or-selected-handler-last
              :authenticated-sh06-artifact-id
              (get lineage :authenticated-sh06-artifact-id)
              :sh06-semantic-projection-id
              (get lineage :sh06-semantic-projection-id)
              :type-coverage-legality :pending-sh08
              :result-type-join-legality :pending-sh08
              :effect-registry-legality :pending-sh09
              :effect-profile-capability-legality :pending-sh09
              :profile-error-lowering-legality :pending-sh09
              :ownership-legality :pending-sh10
              :safety-classification :pending-sh11}
             :binding-ids (get handlers :binding-ids)
             :evaluation-kind
             :protected-then-ordered-typed-handler-candidates}
            {:status :rejected :reason :producer-v18-try-child-count
             :partial-products []})
          {:status :rejected :reason :producer-v18-try-handler-count
           :partial-products []}))
      handlers)))

(defn sh07-b51-v18-append-match-bindings [bindings seen additions]
  (loop [remaining additions next-bindings bindings next-seen seen]
    (if (= (count remaining) 0)
      {:status :accepted :bindings next-bindings :seen next-seen}
      (let [binding (first remaining) name (get binding :name)]
        (if (contains? next-seen name)
          {:status :rejected
           :reason :producer-v18-match-binding-duplicate
           :partial-products []}
          (recur
           (rest remaining) (conj next-bindings binding)
           (conj next-seen name)))))))

(defn sh07-b51-v18-match-pattern-bindings
  [indexes pattern depth ancestry]
  (if (> depth 256)
    {:status :rejected :reason :producer-v18-match-pattern-depth
     :partial-products []}
    (if (sh07-b51-vector-contains? ancestry (get pattern :form-id))
      {:status :rejected :reason :producer-v18-match-pattern-cycle
       :partial-products []}
      (let [kind (get pattern :kind) value (get pattern :value)]
        (if (= kind :symbol)
          (if (= value '&)
            {:status :rejected :reason :producer-v18-match-rest
             :partial-products []}
            (if (= value '_)
              {:status :accepted :pattern-kind :wildcard
               :bindings []}
              (let [binding
                    (sh07-b51-find-binding-by-definition
                     indexes (get pattern :syntax-id))]
                (if (map? binding)
                  (if (= (get binding :name) value)
                    {:status :accepted :pattern-kind :binding
                     :bindings [binding]}
                    {:status :rejected
                     :reason :producer-v18-match-binding-name
                     :partial-products []})
                  {:status :rejected :reason :producer-v18-match-binding
                   :partial-products []}))))
          (if (contains?
               #{:nil :boolean :integer :decimal :ratio :character
                 :string :keyword}
               kind)
            (if (sh07-b51-ordinary-literal-value-shape? kind value)
              {:status :accepted :pattern-kind :literal :bindings []}
              {:status :rejected :reason :producer-v18-match-literal
               :partial-products []})
            (if (= kind :vector)
              (loop [remaining (get pattern :child-form-ids)
                     bindings [] seen #{}]
                (if (= (count remaining) 0)
                  {:status :accepted :pattern-kind :vector
                   :bindings bindings}
                  (let [child (sh07-b51-find-form indexes (first remaining))
                        selected
                        (if (map? child)
                          (sh07-b51-v18-match-pattern-bindings
                           indexes child (+ depth 1)
                           (conj ancestry (get pattern :form-id)))
                          {:status :rejected})]
                    (if (= (get selected :status) :accepted)
                      (let [appended
                            (sh07-b51-v18-append-match-bindings
                             bindings seen (get selected :bindings))]
                        (if (= (get appended :status) :accepted)
                          (recur
                           (rest remaining) (get appended :bindings)
                           (get appended :seen))
                          appended))
                      selected))))
              {:status :rejected :reason :producer-v18-match-pattern-kind
               :partial-products []})))))))

(defn sh07-b51-v18-match-clauses [indexes form]
  (loop [remaining (rest (rest (get form :child-form-ids)))
         clause-ordinal 0 clauses [] binding-ids []]
    (if (= (count remaining) 0)
      {:status :accepted :clauses clauses :binding-ids binding-ids}
      (if (> (count remaining) 1)
        (let [pattern (sh07-b51-find-form indexes (first remaining))
              branch (sh07-b51-find-form indexes (first (rest remaining)))
              descriptor
              (if (map? pattern)
                (sh07-b51-v18-match-pattern-bindings
                 indexes pattern 0 [])
                {:status :rejected})]
          (if (= (get descriptor :status) :accepted)
            (if (map? branch)
              (let [bindings (get descriptor :bindings)
                    root-binding
                    (if (= (get descriptor :pattern-kind) :binding)
                      (first bindings) nil)
                    ids
                    (loop [remaining-bindings bindings result []]
                      (if (= (count remaining-bindings) 0)
                        result
                        (recur
                         (rest remaining-bindings)
                         (conj result
                               (get (first remaining-bindings)
                                    :binding-id)))))
                    clause
                    {:clause-ordinal clause-ordinal
                     :branch-child-index (+ clause-ordinal 1)
                     :pattern-kind (get descriptor :pattern-kind)
                     :pattern-form-id (get pattern :form-id)
                     :pattern-syntax-id (get pattern :syntax-id)
                     :pattern-value (get pattern :value)
                     :branch-form-id (get branch :form-id)
                     :branch-syntax-id (get branch :syntax-id)
                     :pattern-binding-id
                     (if (map? root-binding)
                       (get root-binding :binding-id) nil)
                     :pattern-binding-scope-id
                     (if (map? root-binding)
                       (get root-binding :scope-id) nil)
                     :pattern-binding-ids ids}]
                (if (sh07-b51-ordinary-match-clause-shape?
                     clause clause-ordinal)
                  (recur
                   (rest (rest remaining)) (+ clause-ordinal 1)
                   (conj clauses clause)
                   (sh07-b51-vector-append binding-ids ids))
                  {:status :rejected
                   :reason :producer-v18-match-clause-shape
                   :partial-products []}))
              {:status :rejected :reason :producer-v18-match-branch
               :partial-products []})
            descriptor))
        {:status :rejected :reason :producer-v18-match-pair
         :partial-products []}))))

(defn sh07-b51-v18-match-semantics [request indexes form children]
  (let [built (sh07-b51-v18-match-clauses indexes form)
        lineage (get request :lineage)]
    (if (= (get built :status) :accepted)
      (let [branch-count (count (get built :clauses))]
        (if (> branch-count 0)
          (if (= (count children) (+ branch-count 1))
            {:status :accepted
             :attributes
             {:scrutinee-child-index 0
              :branch-count branch-count
              :branch-child-indexes
              (sh07-b51-vector-range 1 branch-count)
              :branch-clauses (get built :clauses)
              :evaluation-order
              :scrutinee-then-source-ordered-pattern-candidates
              :runtime-reachability :not-asserted-by-sh07-b11
              :selection-policy :source-ordered-pattern-candidates
              :result-type-join :pending-sh08
              :exhaustiveness :pending-sh08
              :authenticated-sh06-artifact-id
              (get lineage :authenticated-sh06-artifact-id)
              :sh06-semantic-projection-id
              (get lineage :sh06-semantic-projection-id)}
             :binding-ids (get built :binding-ids)
             :evaluation-kind
             :scrutinee-then-source-ordered-pattern-candidates}
            {:status :rejected :reason :producer-v18-match-child-count
             :partial-products []})
          {:status :rejected :reason :producer-v18-match-clause-count
           :partial-products []}))
      built)))

(defn sh07-b51-v18-top-level-definition-authentic?
  [request indexes form name-form binding context]
  (let [membership
        (sh07-b51-index-of
         (get request :top-level-form-ids) (get form :form-id))
        fragment (sh07-b51-select-owner-fragment request form form)]
    (if (if (= (get context :evaluation-region) :module-initialization)
          (= (get context :evaluation-owner-function-syntax-id) nil)
          false)
    (if (= (count (get form :child-form-ids)) 3)
      (if (= (get form :parent-form-id) nil)
        (if (= (get membership :count) 1)
          (if (= (get fragment :status) :accepted)
            (if (= (get name-form :kind) :symbol)
              (if (= (get binding :definition-syntax-id)
                     (get name-form :syntax-id))
                (if (= (get binding :name) (get name-form :value))
                  (if (= (get binding :binding-class) :namespace)
                    (if (= (get binding :namespace)
                           (get (get request :module) :namespace))
                      (if (contains? #{:var :function} (get binding :kind))
                        (contains? #{:public :private}
                                   (get binding :visibility))
                        false)
                      false)
                    false)
                  false)
                false)
              false)
            false)
          false)
        false)
      false)
    false)))

(defn sh07-b51-v18-simple-semantics
  [request indexes form core-form children context]
  (let [raw-children (get form :child-form-ids)
        lineage (get request :lineage)]
    (if (= core-form :reference)
      (sh07-b51-v18-reference-semantics indexes form context)
      (if (= core-form :literal)
        {:status :accepted
         :attributes {:literal-kind (get form :kind)
                      :value (get form :value)}
         :binding-ids [] :evaluation-kind :value}
        (if (= core-form :collection-literal)
          {:status :accepted
           :attributes {:literal-kind (get form :kind)
                        :element-count (count children)
                        :source-value (get form :value)}
           :binding-ids [] :evaluation-kind :left-to-right}
          (if (= core-form :keyword-map-lookup)
            (let [operator-form
                  (sh07-b51-find-form indexes (first raw-children))]
              (if (= (count children) 2)
                {:status :accepted
                 :attributes
                 {:keyword-child-index 0 :map-child-index 1
                  :keyword (get operator-form :value)
                  :evaluation-order :keyword-then-map
                  :dispatch :keyword-map-lookup
                  :missing-key-policy :nil
                  :result-policy :map-value-or-nil
                  :target-type-legality :pending-sh08}
                 :binding-ids [] :evaluation-kind :keyword-then-map}
                {:status :rejected :reason :producer-v18-keyword-arity
                 :partial-products []}))
            (if (= core-form :call)
              (let [argument-count (- (count children) 1)
                    operator-form
                    (sh07-b51-find-form indexes (first raw-children))
                    resolution
                    (sh07-b51-find-resolution
                     indexes (get operator-form :syntax-id))]
                (if (> (count children) 0)
                (if (map? resolution)
                  {:status :accepted
                   :attributes
                   {:operator-child-index 0
                    :argument-count argument-count
                    :argument-child-indexes
                    (sh07-b51-vector-range 1 argument-count)
                    :evaluation-order :operator-then-arguments
                    :dispatch :resolved-symbol-call}
                   :binding-ids [(get resolution :binding-id)]
                   :evaluation-kind :operator-then-arguments}
                  {:status :rejected
                   :reason :producer-v18-call-resolution
                   :partial-products []})
                {:status :rejected :reason :producer-v18-call-arity
                 :partial-products []}))
              (if (= core-form :quote)
                (let [quoted
                      (sh07-b51-find-form indexes (get raw-children 1))]
                  (if (if (= (count raw-children) 2)
                        (if (= children []) (map? quoted) false) false)
                    {:status :accepted
                     :attributes
                     {:quoted-form-id (get quoted :form-id)
                      :quoted-syntax-id (get quoted :syntax-id)
                      :quoted-kind (get quoted :kind)
                      :quoted-value (get quoted :value)}
                     :binding-ids [] :evaluation-kind :no-evaluation}
                    {:status :rejected :reason :producer-v18-quote-form
                     :partial-products []}))
                (if (= core-form :var)
                  (sh07-b51-v18-var-semantics request indexes form)
                (if (= core-form :set!)
                  (sh07-b51-v18-set-semantics
                   request indexes form children)
                (if (= core-form :try)
                  (sh07-b51-v18-try-semantics
                   request indexes form children)
                (if (= core-form :match)
                  (sh07-b51-v18-match-semantics
                   request indexes form children)
                (if (= core-form :throw)
                  {:status :accepted
                   :attributes
                   {:value-child-index 0
                    :evaluation-order :value-then-transfer
                    :construction-order :postorder-after-value
                    :runtime-reachability :not-asserted-by-sh07-b7
                    :transfer-policy :error-transfer
                    :result-policy :never :required-effect :error/throw
                    :authenticated-sh06-artifact-id
                    (get lineage :authenticated-sh06-artifact-id)
                    :sh06-semantic-projection-id
                    (get lineage :sh06-semantic-projection-id)
                    :type-legality :pending-sh08
                    :effect-registry-legality :pending-sh09
                    :effect-profile-capability-legality :pending-sh09
                    :profile-error-lowering-legality :pending-sh09
                    :ownership-legality :pending-sh10
                    :safety-classification :pending-sh11}
                   :binding-ids [] :evaluation-kind :value-then-transfer}
                  (if (= core-form :if)
                    {:status :accepted
                     :attributes
                     {:condition-child-index 0 :then-child-index 1
                      :else-child-index 2
                      :condition-evaluation :always-first
                      :branch-evaluation :exactly-one
                      :truthiness {:false-values [:nil :false]
                                   :other-values :true}}
                     :binding-ids []
                     :evaluation-kind
                     :condition-then-exclusive-branch}
                    (if (= core-form :do)
                      {:status :accepted
                       :attributes
                       {:body-count (count children)
                        :evaluation-order :left-to-right
                        :result :last-child
                        :result-child-index (- (count children) 1)}
                       :binding-ids [] :evaluation-kind :left-to-right}
                      (if (= core-form :def)
                        (let [name-form
                              (sh07-b51-find-form indexes
                                                  (get raw-children 1))
                              binding
                              (if (map? name-form)
                                (sh07-b51-find-binding-by-definition
                                 indexes (get name-form :syntax-id)) nil)]
                          (if (if (map? binding)
                                 (sh07-b51-v18-top-level-definition-authentic?
                                 request indexes form name-form binding context)
                                false)
                            {:status :accepted
                             :attributes
                             {:name (get name-form :value)
                              :name-form-id (get name-form :form-id)
                              :name-syntax-id (get name-form :syntax-id)
                              :visibility (get binding :visibility)}
                             :binding-ids [(get binding :binding-id)]
                             :evaluation-kind :initialize-once}
                            {:status :rejected
                             :reason :producer-v18-def-binding
                             :partial-products []}))
                        (if (= core-form :fn)
                          (let [params
                                (sh07-b51-find-form indexes
                                                    (get raw-children 1))
                                body
                                (sh07-b51-find-form indexes
                                                    (get raw-children 2))
                                parameter-forms
                                (if (= (get params :kind) :vector)
                                  (sh07-b51-v18-forms-for-ids
                                   indexes (get params :child-form-ids))
                                  {:status :rejected})
                                bindings
                                (if (= (get parameter-forms :status)
                                       :accepted)
                                  (sh07-b51-v18-definition-binding-ids
                                   indexes (get parameter-forms :forms))
                                  parameter-forms)]
                            (if (if (= (count raw-children) 3)
                                  (if (= (count children) 1)
                                    (if (map? body)
                                      (if (= (get body :form-id)
                                             (get raw-children 2))
                                        (if (= (get body :parent-form-id)
                                               (get form :form-id))
                                          (= (get
                                              (sh07-b51-core-expression-child-ids
                                               indexes form)
                                              :child-form-ids)
                                             [(get body :form-id)])
                                          false)
                                        false)
                                      false)
                                    false)
                                  false)
                              (if (= (get bindings :status) :accepted)
                              {:status :accepted
                               :attributes
                               {:parameters (get params :value)
                                :parameter-form-id (get params :form-id)
                                :parameter-syntax-id (get params :syntax-id)
                                :fixed-arity
                                (count (get bindings :binding-ids))
                                :recur-target-id (get form :syntax-id)}
                               :binding-ids (get bindings :binding-ids)
                               :evaluation-kind :function-creation}
                              bindings)
                              {:status :rejected
                               :reason :producer-v18-fn-shape
                               :partial-products []}))
                          {:status :rejected
                           :reason :producer-v18-specialized-form-required
                           :partial-products []})))))))))))))))))

(defn sh07-b51-v18-postorder-input-authentic?
  [request postorder-record context core-base predecessor-authority]
  (let [postorder (sh07-b51-independent-core-postorder request)
        selected
        (if (= (get postorder :status) :accepted)
          (sh07-b51-find-postorder-record
           (get postorder :records) (get postorder-record :form-id)
           (get postorder-record :occurrence-path))
          {:count 0})
        contexts (sh07-b51-v18-context-catalog request)
        selected-context
        (if (= (get contexts :status) :accepted)
          (sh07-b51-v18-find-context
           contexts (get postorder-record :form-id)
           (get postorder-record :occurrence-path))
          contexts)]
    (if (sh07-b51-core-postorder-node-record-shape? postorder-record)
      (if (= (get selected :count) 1)
        (if (= (get selected :record) postorder-record)
          (if (= (get selected-context :status) :accepted)
            (if (= (get selected-context :context) context)
              (if (sh07-b51-nonnegative-integer? core-base)
                (sh07-b51-internal-reference? predecessor-authority)
                false)
              false)
            false)
          false)
        false)
      false)))

(defn sh07-b51-v18-build-simple-postorder-node
  [request postorder-record context core-base predecessor-authority]
  (let [indexes (sh07-b51-index-request request)
        form
        (sh07-b51-find-form indexes (get postorder-record :form-id))
        classified
        (if (map? form)
          (sh07-b51-v18-classify-form indexes form)
          {:status :rejected :reason :producer-v18-postorder-form})
        core-form (get classified :core-form)
        children
        (sh07-b51-v18-child-node-ids postorder-record core-base)
        semantics
        (if (= (get classified :status) :accepted)
          (sh07-b51-v18-simple-semantics
           request indexes form core-form children context)
          classified)
        node-id
        (sh07-b51-internal-reference
         (+ core-base (get postorder-record :core-postorder-index)))]
    (if (sh07-b51-v18-postorder-input-authentic?
         request postorder-record context core-base predecessor-authority)
    (if (= (get classified :status) :accepted)
      (if (= (get semantics :status) :accepted)
        (if (= (get semantics :evaluation-kind)
               (sh07-b51-ordinary-evaluation-kind core-form))
          (let [built
                (sh07-b51-v18-add-node
                 request form core-form children
                 (get semantics :attributes) (get semantics :binding-ids)
                 (get semantics :evaluation-kind)
                 (get context :evaluation-region)
                 (get context :evaluation-owner-function-syntax-id)
                 predecessor-authority node-id)]
            (if (= (get built :status) :accepted)
              {:status :accepted
               :record (get built :record)
               :preimage (get built :preimage)
               :node-id node-id
               :form-id (get form :form-id)
               :syntax-id (get form :syntax-id)
               :occurrence-path (get postorder-record :occurrence-path)
               :core-postorder-index
               (get postorder-record :core-postorder-index)
               :context context}
              built))
          {:status :rejected :reason :producer-v18-evaluation-kind
           :partial-products []})
        semantics)
      classified)
    {:status :rejected :reason :producer-v18-postorder-context-authentication
     :partial-products []})))

(defn sh07-b51-v18-vector-take [values count-value]
  (loop [remaining values left count-value result []]
    (if (= left 0)
      result
      (if (= (count remaining) 0)
        []
        (recur (rest remaining) (- left 1)
               (conj result (first remaining)))))))

(defn sh07-b51-v18-vector-drop [values count-value]
  (loop [remaining values left count-value]
    (if (= left 0)
      (vec remaining)
      (if (= (count remaining) 0)
        []
        (recur (rest remaining) (- left 1))))))

(defn sh07-b51-v18-find-materialized-owner [two-pass owner-form-id]
  (loop [remaining (get two-pass :materialized-owners)
         found nil found-count 0]
    (if (= (count remaining) 0)
      (if (= found-count 1)
        {:status :accepted :owner-entry found}
        {:status :rejected :reason :producer-v18-owner-foundation-join
         :partial-products []})
      (let [entry (first remaining)]
        (if (= (get entry :owner-form-id) owner-form-id)
          (recur (rest remaining) entry (+ found-count 1))
          (recur (rest remaining) found found-count))))))

(defn sh07-b51-v18-two-pass-authentic? [request two-pass]
  (if (= (get two-pass :status) :accepted)
    (let [expected
          (sh07-b51-compose-expected-occurrence-specs
           request (get two-pass :owner-plans))
          authority
          (sh07-b51-internal-reference
           (get (get two-pass :bases) :authority))
          same-request
          (sh07-b51-internal-reference
           (get (get two-pass :bases) :same-request))
          numbered
          (if (= (get expected :status) :accepted)
            (sh07-b51-compose-numbered-preimages
             request (get two-pass :owner-plans) (get expected :specs)
             authority same-request)
            expected)]
      (if (= (get expected :status) :accepted)
        (if (= (get numbered :status) :accepted)
          (if (= (get two-pass :expected-specs) (get expected :specs))
            (if (= (get two-pass :postorder-records)
                   (get expected :postorder-records))
              (let [reconciled
                    (sh07-b51-producer-reconcile-materialized-owners
                     (get expected :materialized-owners) numbered)]
                (if (= (get reconciled :status) :accepted)
                  (if (= (get two-pass :materialized-owners)
                         (get reconciled :owners))
                    (= (get two-pass :numbered) numbered)
                    false)
                  false))
              false)
            false)
          false)
        false))
    false))

(defn sh07-b51-v18-owner-builder-context [form context]
  {:evaluation-kind :initializers-then-body-left-to-right
   :evaluation-region (get context :evaluation-region)
   :evaluation-owner-function-syntax-id
   (get context :evaluation-owner-function-syntax-id)
   :binding-context (get form :scope-id)})

(defn sh07-b51-v18-accepted-node-envelope
  [built postorder-record context]
  {:status :accepted
   :record (get built :record)
   :preimage (get built :preimage)
   :node-id (get built :node-id)
   :form-id (get postorder-record :form-id)
   :syntax-id (get postorder-record :syntax-id)
   :occurrence-path (get postorder-record :occurrence-path)
   :core-postorder-index (get postorder-record :core-postorder-index)
   :context context})

(defn sh07-b51-v18-build-owner-postorder-node
  [request two-pass postorder-record context]
  (let [indexes (sh07-b51-index-request request)
        form (sh07-b51-find-form indexes (get postorder-record :form-id))
        selected
        (sh07-b51-v18-find-materialized-owner
         two-pass (get postorder-record :form-id))
        owner-entry (get selected :owner-entry)
        foundation (get owner-entry :foundation)
        layout (get owner-entry :initialization-layout)
        core-base (get (get two-pass :bases) :core)
        authority
        (sh07-b51-internal-reference
         (get (get two-pass :bases) :authority))
        node-id
        (sh07-b51-internal-reference
         (+ core-base (get postorder-record :core-postorder-index)))
        children (sh07-b51-v18-child-node-ids postorder-record core-base)
        slot-count (count (get foundation :slot-plans))
        initializer-children
        (sh07-b51-v18-vector-take children slot-count)
        body-children (sh07-b51-v18-vector-drop children slot-count)
        expected-initializers
        (sh07-b51-owner-initializer-node-ids (get foundation :slot-plans))
        builder-context (sh07-b51-v18-owner-builder-context form context)
        target-id
        (if (= (get foundation :owner-kind) :loop)
          (get form :syntax-id) nil)
        preimage-result
        (if (= (get selected :status) :accepted)
          (sh07-b51-build-owner-core-node-preimage
           request foundation body-children target-id authority builder-context)
          selected)]
    (if (sh07-b51-v18-two-pass-authentic? request two-pass)
    (if (= (get selected :status) :accepted)
      (if (sh07-b51-v18-postorder-input-authentic?
           request postorder-record context core-base authority)
        (if (= (get layout :predecessor-authority-id) authority)
          (if (= (get layout :owner-core-node-id) node-id)
            (if (= initializer-children expected-initializers)
              (if (= (get preimage-result :status) :accepted)
                (let [preimage (get preimage-result :preimage)
                      built
                      (sh07-b51-v18-add-node
                       request form (get foundation :owner-kind) children
                       (get preimage :attributes)
                       (get preimage :resolved-binding-ids)
                       (get preimage :evaluation-kind)
                       (get preimage :evaluation-region)
                       (get preimage :evaluation-owner-function-syntax-id)
                       authority node-id)]
                  (if (= (get built :status) :accepted)
                    (if (= (get built :preimage) preimage)
                      (sh07-b51-v18-accepted-node-envelope
                       built postorder-record context)
                      {:status :rejected
                       :reason :producer-v18-owner-preimage-recomposition
                       :partial-products []})
                    built))
                preimage-result)
              {:status :rejected
               :reason :producer-v18-owner-initializer-child-join
               :partial-products []})
            {:status :rejected :reason :producer-v18-owner-node-id-join
             :partial-products []})
          {:status :rejected :reason :producer-v18-owner-authority-join
           :partial-products []})
        {:status :rejected
         :reason :producer-v18-owner-postorder-context-authentication
         :partial-products []})
      selected)
    {:status :rejected :reason :producer-v18-two-pass-authentication
     :partial-products []})))

(defn sh07-b51-v18-find-loop-recur-foundation
  [two-pass recur-form-id]
  (loop [remaining-owners (get two-pass :materialized-owners)
         found-owner nil found-site nil found-layout nil found-count 0]
    (if (= (count remaining-owners) 0)
      (if (= found-count 1)
        {:status :accepted :owner-entry found-owner
         :recur-site found-site :layout found-layout}
        {:status :rejected :reason :producer-v18-recur-foundation-join
         :partial-products []})
      (let [owner-entry (first remaining-owners)
            selected-layout
            (sh07-b51-find-recur-layout-entry owner-entry recur-form-id)
            selected-site
            (loop [remaining-sites (get owner-entry :loop-recur-sites)
                   site nil site-count 0]
              (if (= (count remaining-sites) 0)
                {:site site :count site-count}
                (let [candidate (first remaining-sites)]
                  (if (= (get (get candidate :recur-coordinate)
                              :recur-form-id)
                         recur-form-id)
                    (recur (rest remaining-sites) candidate (+ site-count 1))
                    (recur (rest remaining-sites) site site-count)))))]
        (if (if (= (get selected-layout :count) 1)
              (= (get selected-site :count) 1) false)
          (recur
           (rest remaining-owners) owner-entry (get selected-site :site)
           (get (get selected-layout :entry) :layout) (+ found-count 1))
          (if (if (= (get selected-layout :count) 0)
                (= (get selected-site :count) 0) false)
            (recur
             (rest remaining-owners) found-owner found-site found-layout
             found-count)
            {:status :rejected :reason :producer-v18-recur-layout-site-join
             :partial-products []}))))))

(defn sh07-b51-v18-recur-builder-context [form context]
  {:evaluation-kind :arguments-left-to-right-then-transfer
   :evaluation-region (get context :evaluation-region)
   :evaluation-owner-function-syntax-id
   (get context :evaluation-owner-function-syntax-id)
   :binding-context (get form :scope-id)})

(defn sh07-b51-v18-recur-evaluation-node-ids [recur-site]
  (loop [remaining (get recur-site :argument-evaluations) result []]
    (if (= (count remaining) 0)
      result
      (recur
       (rest remaining)
       (conj result (get (first remaining) :argument-node-id))))))

(defn sh07-b51-v18-loop-recur-target-and-policy-authentic?
  [two-pass owner-entry recur-site layout target-id]
  (let [foundation (get owner-entry :foundation)
        owner (get foundation :owner-coordinate)
        mapping (get recur-site :recur-slot-mapping-preimage)
        publication (get recur-site :publication-event-preimage)
        selected-owner-postorder
        (sh07-b51-producer-find-postorder-by-form-id
         (get two-pass :postorder-records) (get owner-entry :owner-form-id))
        expected-target
        (if (= (get selected-owner-postorder :count) 1)
          (sh07-b51-internal-reference
           (+ (get (get two-pass :bases) :core)
              (get (get selected-owner-postorder :record)
                   :core-postorder-index)))
          nil)]
    (if (= (get selected-owner-postorder :count) 1)
      (if (= target-id expected-target)
        (if (= target-id (get foundation :owner-core-node-id))
          (if (= (get recur-site :target-kind) :loop)
            (if (= (get recur-site :target-loop-form-id)
                   (get owner :enclosing-form-id))
              (if (= (get recur-site :commit-policy)
                     :simultaneous-after-all-checks)
                (if (= (get recur-site :all-or-none) true)
                  (if (= (get recur-site :tail-only) true)
                    (if (sh07-b51-recur-slot-mapping-preimage-shape? mapping)
                      (if (sh07-b51-publication-event-preimage-shape?
                           publication)
                        (if (= (get mapping :target-loop-form-id)
                               (get owner :enclosing-form-id))
                          (if (= (get mapping :target-loop-syntax-id)
                                 (get owner :enclosing-syntax-id))
                            (if (= (get mapping :target-loop-core-node-id)
                                   target-id)
                              (if (= (get mapping :loop-core-node-id)
                                     target-id)
                                (if (= (get mapping :commit-policy)
                                       :simultaneous-after-all-checks)
                                  (if (= (get mapping :all-or-none) true)
                                    (if (= (get mapping :tail-only) true)
                                      (if (= (get mapping
                                                   :commit-publication-id)
                                             (get layout
                                                  :publication-event-id))
                                        (if (= (get publication :all-or-none)
                                               true)
                                          (= (get publication :event-kind)
                                             :loop-atomic-transfer)
                                          false)
                                        false)
                                      false)
                                    false)
                                  false)
                                false)
                              false)
                            false)
                          false)
                        false)
                      false)
                    false)
                  false)
                false)
              false)
            false)
          false)
        false)
      false)))

(defn sh07-b51-v18-build-loop-recur-postorder-node
  [request two-pass postorder-record context]
  (let [indexes (sh07-b51-index-request request)
        form (sh07-b51-find-form indexes (get postorder-record :form-id))
        selected
        (sh07-b51-v18-find-loop-recur-foundation
         two-pass (get postorder-record :form-id))
        owner-entry (get selected :owner-entry)
        recur-site (get selected :recur-site)
        layout (get selected :layout)
        foundation (get owner-entry :foundation)
        core-base (get (get two-pass :bases) :core)
        authority
        (sh07-b51-internal-reference
         (get (get two-pass :bases) :authority))
        node-id
        (sh07-b51-internal-reference
         (+ core-base (get postorder-record :core-postorder-index)))
        children (sh07-b51-v18-child-node-ids postorder-record core-base)
        evaluation-children
        (sh07-b51-v18-recur-evaluation-node-ids recur-site)
        target-core-node-id
        (get (get owner-entry :initialization-layout) :owner-core-node-id)
        target-id
        (get (get foundation :owner-coordinate) :enclosing-syntax-id)
        builder-context (sh07-b51-v18-recur-builder-context form context)
        preimage-result
        (if (= (get selected :status) :accepted)
          (sh07-b51-build-recur-core-node-preimage
           request recur-site target-id authority builder-context)
          selected)]
    (if (sh07-b51-v18-two-pass-authentic? request two-pass)
    (if (= (get selected :status) :accepted)
      (if (sh07-b51-v18-postorder-input-authentic?
           request postorder-record context core-base authority)
        (if (sh07-b51-v18-loop-recur-target-and-policy-authentic?
             two-pass owner-entry recur-site layout target-core-node-id)
        (if (= (get layout :predecessor-authority-id) authority)
          (if (= (get layout :recur-core-node-id) node-id)
            (if (= (get layout :argument-node-ids) children)
              (if (= evaluation-children children)
                (if (= (get preimage-result :status) :accepted)
                  (let [preimage (get preimage-result :preimage)
                        built
                        (sh07-b51-v18-add-node
                         request form :recur children
                         (get preimage :attributes)
                         (get preimage :resolved-binding-ids)
                         (get preimage :evaluation-kind)
                         (get preimage :evaluation-region)
                         (get preimage :evaluation-owner-function-syntax-id)
                         authority node-id)]
                    (if (= (get built :status) :accepted)
                      (if (= (get built :preimage) preimage)
                        (sh07-b51-v18-accepted-node-envelope
                         built postorder-record context)
                        {:status :rejected
                         :reason :producer-v18-recur-preimage-recomposition
                         :partial-products []})
                      built))
                  preimage-result)
                {:status :rejected
                 :reason :producer-v18-recur-evaluation-child-join
                 :partial-products []})
              {:status :rejected
               :reason :producer-v18-recur-layout-argument-join
               :partial-products []})
            {:status :rejected :reason :producer-v18-recur-node-id-join
             :partial-products []})
          {:status :rejected :reason :producer-v18-recur-authority-join
           :partial-products []})
        {:status :rejected :reason :producer-v18-recur-target-policy-join
         :partial-products []})
        {:status :rejected
         :reason :producer-v18-recur-postorder-context-authentication
         :partial-products []})
      selected)
    {:status :rejected :reason :producer-v18-two-pass-authentication
     :partial-products []})))

(defn sh07-b51-v18-function-recur-zero-products?
  [two-pass recur-form-id]
  (loop [remaining (get two-pass :expected-specs)]
    (if (= (count remaining) 0)
      true
      (let [spec (first remaining)]
        (if (if (= (get spec :event-form-id) recur-form-id)
              (if (= (get spec :record-kind) :ordinary-core-node)
                false true)
              false)
          false
          (recur (rest remaining)))))))

(defn sh07-b51-v18-authenticated-recur-owner-coordinate
  [request indexes recur-form chain fragment-result]
  (let [root (get chain :root)
        fragment (get fragment-result :fragment)
        traces (sh07-b51-root-macro-traces request root)
        source-def?
        (sh07-b51-source-def-shape?
         request indexes root fragment (get chain :chain))
        expanded
        (if (if source-def? (= (count traces) 1) false)
          (sh07-b51-expanded-defn-selection
           indexes root (get chain :chain) (first traces))
          {:status :rejected})]
    (if (= (get fragment-result :status) :accepted)
      (if (= (get fragment :root-form-ids) [(get root :form-id)])
        (if (if (= (count traces) 1)
              (= (get expanded :status) :accepted) true)
          {:fragment-id (get fragment :fragment-id)
           :fragment-ordinal (get fragment :ordinal)
           :root-form-id (get root :form-id)
           :root-syntax-id (get root :syntax-id)
           :owning-definition-form-id (if source-def? (get root :form-id) nil)
           :owning-definition-syntax-id
           (if source-def? (get root :syntax-id) nil)
           :def-form-id (if source-def? (get root :form-id) nil)
           :def-syntax-id (if source-def? (get root :syntax-id) nil)
           :defn-input-syntax-id
           (if (= (count traces) 1) (get (first traces) :input-syntax-id) nil)
           :fn-form-id
           (if (= (count traces) 1)
             (get (get expanded :fn-form) :form-id) nil)
           :fn-syntax-id
           (if (= (count traces) 1)
             (get (get expanded :fn-form) :syntax-id) nil)
           :enclosing-form-id (get recur-form :form-id)
           :enclosing-syntax-id (get recur-form :syntax-id)}
          nil)
        nil)
      nil)))

(defn sh07-b51-v18-function-recur-target
  [request indexes recur-form context]
  (let [chain
        (sh07-b51-reciprocal-parent-chain request indexes recur-form)
        fragment
        (if (= (get chain :status) :accepted)
          (sh07-b51-select-owner-fragment
           request (get chain :root) recur-form)
          chain)
        selected
        (if (= (get fragment :status) :accepted)
          (sh07-b51-nearest-recur-target
           request indexes (get fragment :fragment) recur-form)
          fragment)
        target-form (get selected :target-form)
        owner-coordinate
        (if (= (get fragment :status) :accepted)
          (sh07-b51-v18-authenticated-recur-owner-coordinate
           request indexes recur-form chain fragment)
          nil)
        parity
        (if (if (= (get selected :status) :accepted)
              (= (get selected :target-kind) :function) false)
          (sh07-b51-function-target-recur-parity
           request indexes (get fragment :fragment) recur-form target-form)
          selected)]
    (if (= (get parity :status) :accepted)
      (if (= (get context :evaluation-owner-function-syntax-id)
             (get target-form :syntax-id))
        {:status :accepted :target-form target-form
         :fragment (get fragment :fragment) :parity parity}
        {:status :rejected :reason :producer-v18-function-recur-owner
         :partial-products []})
      (if (map? owner-coordinate)
        (assoc
         (assoc parity :owner-coordinate owner-coordinate)
         :target-form-id
         (if (map? target-form) (get target-form :form-id) nil))
        parity))))

(defn sh07-b51-v18-function-parameter-bindings [indexes target-form]
  (let [params
        (sh07-b51-find-form indexes (get (get target-form :child-form-ids) 1))
        forms
        (if (= (get params :kind) :vector)
          (sh07-b51-v18-forms-for-ids indexes (get params :child-form-ids))
          {:status :rejected :reason :producer-v18-function-recur-parameters
           :partial-products []})]
    (if (= (get forms :status) :accepted)
      (let [bindings
            (sh07-b51-v18-definition-binding-ids indexes (get forms :forms))]
        (if (= (get bindings :status) :accepted)
          {:status :accepted :parameter-form params
           :binding-ids (get bindings :binding-ids)}
          bindings))
      forms)))

(defn sh07-b51-v18-authenticate-function-target-node
  [request two-pass target-form parameters target-postorder authority]
  (let [contexts (sh07-b51-v18-context-catalog request)
        target-context
        (if (= (get contexts :status) :accepted)
          (sh07-b51-v18-find-context
           contexts (get target-form :form-id)
           (get target-postorder :occurrence-path))
          contexts)
        built
        (if (= (get target-context :status) :accepted)
          (sh07-b51-v18-build-simple-postorder-node
           request target-postorder (get target-context :context)
           (get (get two-pass :bases) :core) authority)
          target-context)
        record (get built :record)
        attributes (get record :attributes)]
    (if (= (get built :status) :accepted)
      (if (= (get record :core-form) :fn)
        (if (= (get record :node-id)
               (sh07-b51-internal-reference
                (+ (get (get two-pass :bases) :core)
                   (get target-postorder :core-postorder-index))))
          (if (= (get record :resolved-binding-ids)
                 (get parameters :binding-ids))
            (if (= (get attributes :fixed-arity)
                   (count (get parameters :binding-ids)))
              (= (get attributes :recur-target-id)
                 (get target-form :syntax-id))
              false)
            false)
          false)
        false)
      false)))

(defn sh07-b51-v18-build-function-recur-postorder-node
  [request two-pass postorder-record context]
  (let [indexes (sh07-b51-index-request request)
        form (sh07-b51-find-form indexes (get postorder-record :form-id))
        target
        (if (map? form)
          (sh07-b51-v18-function-recur-target request indexes form context)
          {:status :rejected :reason :producer-v18-function-recur-form
           :partial-products []})
        target-form (get target :target-form)
        parameters
        (if (= (get target :status) :accepted)
          (sh07-b51-v18-function-parameter-bindings indexes target-form)
          target)
        target-postorder
        (if (= (get target :status) :accepted)
          (sh07-b51-producer-find-postorder-by-form-id
           (get two-pass :postorder-records) (get target-form :form-id))
          {:count 0})
        core-base (get (get two-pass :bases) :core)
        authority
        (sh07-b51-internal-reference
         (get (get two-pass :bases) :authority))
        node-id
        (sh07-b51-internal-reference
         (+ core-base (get postorder-record :core-postorder-index)))
        target-core-node-id
        (if (= (get target-postorder :count) 1)
          (sh07-b51-internal-reference
           (+ core-base
              (get (get target-postorder :record) :core-postorder-index)))
          nil)
        children (sh07-b51-v18-child-node-ids postorder-record core-base)
        attributes
        {:target-id (get target-form :syntax-id) :target-kind :function
         :arity (count (get parameters :binding-ids))
         :semantic-rule "L2-RECUR-TARGET"
         :type-compatibility :pending-sh08}]
    (if (sh07-b51-v18-two-pass-authentic? request two-pass)
      (if (= (get target :status) :accepted)
        (if (= (get parameters :status) :accepted)
          (if (sh07-b51-v18-postorder-input-authentic?
               request postorder-record context core-base authority)
            (if (= (get target-postorder :count) 1)
              (if (sh07-b51-v18-authenticate-function-target-node
                   request two-pass target-form parameters
                   (get target-postorder :record) authority)
              (if (= (count children) (count (get parameters :binding-ids)))
                (if (= (get (get target :parity) :arity)
                       (count children))
                  (if (sh07-b51-v18-function-recur-zero-products?
                       two-pass (get form :form-id))
                    (let [built
                          (sh07-b51-v18-add-node
                           request form :recur children attributes
                           (get parameters :binding-ids)
                           :arguments-left-to-right-then-transfer
                           (get context :evaluation-region)
                           (get context
                                :evaluation-owner-function-syntax-id)
                           authority node-id)]
                      (if (= (get built :status) :accepted)
                        (sh07-b51-v18-accepted-node-envelope
                         built postorder-record context)
                        built))
                    {:status :rejected
                     :reason :producer-v18-function-recur-products-present
                     :partial-products []})
                  {:status :rejected
                   :reason :producer-v18-function-recur-parity
                   :partial-products []})
                {:status :rejected :reason :producer-v18-function-recur-arity
                 :partial-products []})
              {:status :rejected
               :reason :producer-v18-function-target-node-authentication
               :partial-products []})
              {:status :rejected
               :reason :producer-v18-function-target-postorder
               :partial-products []})
            {:status :rejected
             :reason :producer-v18-function-recur-postorder-context
             :partial-products []})
          parameters)
        target)
      {:status :rejected :reason :producer-v18-two-pass-authentication
       :partial-products []})))

(defn sh07-b51-v18-build-recur-postorder-node
  [request two-pass postorder-record context]
  (let [loop-target
        (sh07-b51-v18-find-loop-recur-foundation
         two-pass (get postorder-record :form-id))]
    (if (= (get loop-target :status) :accepted)
      (sh07-b51-v18-build-loop-recur-postorder-node
       request two-pass postorder-record context)
      (sh07-b51-v18-build-function-recur-postorder-node
       request two-pass postorder-record context))))

(defn sh07-b51-v18-function-recur-target-record-shape? [record]
  (if (sh07-b51-exact-keys?
       record
       #{:target-id :target-kind :owner-core-node-id :owner-form-id
         :owner-syntax-id :arity :binding-ids :body-scope-id
         :parent-target-id :type-compatibility})
    (if (sh07-b51-sha256-id? (get record :target-id))
      (if (contains? #{:loop :function} (get record :target-kind))
        (if (sh07-b51-internal-reference?
             (get record :owner-core-node-id))
          (if (sh07-b51-sha256-id? (get record :owner-form-id))
            (if (sh07-b51-sha256-id? (get record :owner-syntax-id))
              (if (= (get record :target-id)
                     (get record :owner-syntax-id))
                (if (sh07-b51-nonnegative-integer? (get record :arity))
                  (if (sh07-b51-all-sha256? (get record :binding-ids))
                    (if (= (count (get record :binding-ids))
                           (get record :arity))
                      (if (sh07-b51-sha256-id? (get record :body-scope-id))
                        (if (if (= (get record :parent-target-id) nil)
                              true
                              (sh07-b51-sha256-id?
                               (get record :parent-target-id)))
                          (= (get record :type-compatibility) :pending-sh08)
                          false)
                        false)
                      false)
                    false)
                  false)
                false)
              false)
            false)
          false)
        false)
      false)
    false))

(defn sh07-b51-v18-loop-recur-target-record-shape? [record]
  (if (sh07-b51-exact-keys?
       record
       #{:target-id :target-kind :owner-core-node-id :owner-form-id
         :owner-syntax-id :slot-count :slot-ids :slot-ordinals
         :binding-id-vectors :body-scope-id :parent-target-id
         :type-compatibility})
    (if (sh07-b51-sha256-id? (get record :target-id))
      (if (= (get record :target-kind) :loop)
        (if (sh07-b51-internal-reference?
             (get record :owner-core-node-id))
          (if (sh07-b51-sha256-id? (get record :owner-form-id))
            (if (sh07-b51-sha256-id? (get record :owner-syntax-id))
              (if (= (get record :target-id)
                     (get record :owner-syntax-id))
                (let [slot-count (get record :slot-count)]
                  (if (sh07-b51-nonnegative-integer? slot-count)
                    (if (sh07-b51-all-digest-references?
                         (get record :slot-ids))
                      (if (= (count (get record :slot-ids)) slot-count)
                        (if (sh07-b51-dense-zero-ordinals?
                             (get record :slot-ordinals))
                          (if (= (count (get record :slot-ordinals))
                                 slot-count)
                            (if (= (count (get record :binding-id-vectors))
                                   slot-count)
                              (if (loop [remaining
                                         (get record :binding-id-vectors)]
                                    (if (= (count remaining) 0)
                                      true
                                      (if (sh07-b51-all-sha256?
                                           (first remaining))
                                        (recur (rest remaining)) false)))
                                (if (sh07-b51-sha256-id?
                                     (get record :body-scope-id))
                                  (if (if (= (get record :parent-target-id) nil)
                                        true
                                        (sh07-b51-sha256-id?
                                         (get record :parent-target-id)))
                                    (= (get record :type-compatibility)
                                       :pending-sh08)
                                    false)
                                  false)
                                false)
                              false)
                            false)
                          false)
                        false)
                      false)
                    false))
                false)
              false)
            false)
          false)
        false)
      false)
    false))

(defn sh07-b51-v18-recur-target-record-shape? [record]
  (if (= (get record :target-kind) :function)
    (sh07-b51-v18-function-recur-target-record-shape? record)
    (if (= (get record :target-kind) :loop)
      (sh07-b51-v18-loop-recur-target-record-shape? record)
      false)))

(defn sh07-b51-v18-recur-transfer-record-shape? [record]
  (if (sh07-b51-exact-keys?
       record
       #{:recur-core-node-id :recur-form-id :recur-syntax-id
         :target-id :target-kind :arity :argument-node-ids
         :tail-position :evaluation-order :transfer-policy
         :type-compatibility})
    (if (sh07-b51-internal-reference? (get record :recur-core-node-id))
      (if (sh07-b51-sha256-id? (get record :recur-form-id))
        (if (sh07-b51-sha256-id? (get record :recur-syntax-id))
          (if (sh07-b51-sha256-id? (get record :target-id))
            (if (contains? #{:loop :function} (get record :target-kind))
              (if (sh07-b51-nonnegative-integer? (get record :arity))
                (if (sh07-b51-all-digest-references?
                     (get record :argument-node-ids))
                  (if (= (count (get record :argument-node-ids))
                         (get record :arity))
                    (if (= (get record :tail-position) true)
                      (if (= (get record :evaluation-order)
                             :arguments-left-to-right)
                        (if (= (get record :transfer-policy)
                               :nearest-lexical-recur-target)
                          (= (get record :type-compatibility) :pending-sh08)
                          false)
                        false)
                      false)
                    false)
                  false)
                false)
              false)
            false)
          false)
        false)
      false)
    false))

(defn sh07-b51-v18-parent-target-id [request indexes owner-form]
  (loop [current owner-form depth 0 visited #{}]
    (if (> depth 256)
      {:status :rejected :reason :producer-v18-parent-target-depth
       :partial-products []}
      (let [parent-id (get current :parent-form-id)]
        (if (= parent-id nil)
          {:status :accepted :parent-target-id nil}
          (if (contains? visited (get current :form-id))
            {:status :rejected :reason :producer-v18-parent-target-cycle
             :partial-products []}
            (let [parent (sh07-b51-find-form indexes parent-id)
                  direct
                  (if (map? parent)
                    (sh07-b51-authenticated-direct-child
                     request indexes parent (get current :form-id))
                    {:status :rejected})]
              (if (= (get direct :status) :accepted)
                (if (if (sh07-b51-authenticated-list-operator?
                         indexes parent 'loop)
                      true
                      (sh07-b51-authenticated-list-operator?
                       indexes parent 'fn))
                  {:status :accepted
                   :parent-target-id (get parent :syntax-id)}
                  (recur parent (+ depth 1)
                         (conj visited (get current :form-id))))
                direct))))))))

(defn sh07-b51-v18-build-recur-target-record
  [request two-pass postorder-record context]
  (let [indexes (sh07-b51-index-request request)
        form (sh07-b51-find-form indexes (get postorder-record :form-id))
        operator
        (if (map? form)
          (sh07-b51-authenticated-operator-symbol indexes form) nil)
        target-kind
        (if (= operator 'fn) :function (if (= operator 'loop) :loop nil))
        owner-selected
        (if (= target-kind :loop)
          (sh07-b51-v18-find-materialized-owner
           two-pass (get form :form-id))
          {:status :accepted})
        owner-entry (get owner-selected :owner-entry)
        foundation (get owner-entry :foundation)
        parameters
        (if (= target-kind :function)
          (sh07-b51-v18-function-parameter-bindings indexes form)
          {:status :accepted
           :binding-ids
           (sh07-b51-owner-introduced-binding-ids
            (get foundation :slot-plans))})
        body-form
        (if (= target-kind :function)
          (sh07-b51-find-form indexes (get (get form :child-form-ids) 2))
          (first (sh07-b51-owner-body-forms indexes foundation)))
        parent
        (if (= target-kind :loop)
          (sh07-b51-v18-parent-target-id request indexes form)
          {:status :accepted :parent-target-id nil})
        node
        (if (= target-kind :function)
          (sh07-b51-v18-build-simple-postorder-node
           request postorder-record context
           (get (get two-pass :bases) :core)
           (sh07-b51-internal-reference
            (get (get two-pass :bases) :authority)))
          (if (= target-kind :loop)
            (sh07-b51-v18-build-owner-postorder-node
             request two-pass postorder-record context)
            {:status :rejected :reason :producer-v18-target-kind
             :partial-products []}))
        record-base
        {:target-id (get form :syntax-id)
         :target-kind target-kind
         :owner-core-node-id (get node :node-id)
         :owner-form-id (get form :form-id)
         :owner-syntax-id (get form :syntax-id)
         :body-scope-id (get body-form :scope-id)
         :parent-target-id (get parent :parent-target-id)
         :type-compatibility :pending-sh08}
        record
        (if (= target-kind :function)
          (assoc
           (assoc record-base :arity (count (get parameters :binding-ids)))
           :binding-ids (get parameters :binding-ids))
          (let [slot-plans (get foundation :slot-plans)
                slot-count (count slot-plans)]
            (assoc
             (assoc
              (assoc
               (assoc record-base :slot-count slot-count)
               :slot-ids
               (sh07-b51-loop-slot-plan-vector slot-plans :slot-id))
              :slot-ordinals (sh07-b51-zero-ordinals slot-count))
             :binding-id-vectors
             (sh07-b51-loop-binding-id-vectors slot-plans))))]
    (if (sh07-b51-v18-two-pass-authentic? request two-pass)
      (if (contains? #{:function :loop} target-kind)
        (if (= (get owner-selected :status) :accepted)
          (if (= (get parameters :status) :accepted)
            (if (= (get parent :status) :accepted)
              (if (map? body-form)
                (if (= (get node :status) :accepted)
                  (if (sh07-b51-v18-recur-target-record-shape? record)
                    {:status :accepted :record record :node-envelope node}
                    {:status :rejected
                     :reason :producer-v18-recur-target-record-shape
                     :partial-products []})
                  node)
                {:status :rejected :reason :producer-v18-target-body
                 :partial-products []})
              parent)
            parameters)
          owner-selected)
        {:status :rejected :reason :producer-v18-target-form
         :partial-products []})
      {:status :rejected :reason :producer-v18-two-pass-authentication
       :partial-products []})))

(defn sh07-b51-v18-target-records-unique? [records]
  (if (vector? records)
    (loop [remaining records seen-target-ids []]
      (if (= (count remaining) 0)
        true
        (let [record (first remaining)
              target-id (get record :target-id)]
          (if (sh07-b51-v18-recur-target-record-shape? record)
            (if (sh07-b51-vector-contains? seen-target-ids target-id)
              false
              (recur
               (rest remaining) (conj seen-target-ids target-id)))
            false))))
    false))

(defn sh07-b51-v18-target-records-authentic?
  [request two-pass records]
  (let [contexts (sh07-b51-v18-context-catalog request)]
    (if (sh07-b51-v18-target-records-unique? records)
      (if (= (get contexts :status) :accepted)
        (loop [remaining records]
          (if (= (count remaining) 0)
            true
            (let [record (first remaining)
                  selected-postorder
                  (sh07-b51-producer-find-postorder-by-form-id
                   (get two-pass :postorder-records)
                   (get record :owner-form-id))
                  postorder-record (get selected-postorder :record)
                  selected-context
                  (if (= (get selected-postorder :count) 1)
                    (sh07-b51-v18-find-context
                     contexts (get postorder-record :form-id)
                     (get postorder-record :occurrence-path))
                    {:status :rejected})
                  rebuilt
                  (if (= (get selected-context :status) :accepted)
                    (sh07-b51-v18-build-recur-target-record
                     request two-pass postorder-record
                     (get selected-context :context))
                    selected-context)]
              (if (= (get rebuilt :status) :accepted)
                (if (= (get rebuilt :record) record)
                  (recur (rest remaining))
                  false)
                false))))
        false)
      false)))

(defn sh07-b51-v18-find-target-record [records target-id]
  (loop [remaining records found nil found-count 0]
    (if (= (count remaining) 0)
      (if (= found-count 1)
        {:status :accepted :record found}
        {:status :rejected :reason :producer-v18-recur-target-record-join
         :partial-products []})
      (let [record (first remaining)]
        (if (= (get record :target-id) target-id)
          (recur (rest remaining) record (+ found-count 1))
          (recur (rest remaining) found found-count))))))

(defn sh07-b51-v18-build-recur-transfer-record
  [request two-pass postorder-record context target-records]
  (let [node
        (sh07-b51-v18-build-recur-postorder-node
         request two-pass postorder-record context)
        preimage (get node :preimage)
        attributes (get preimage :attributes)
        target
        (sh07-b51-v18-find-target-record
         target-records (get attributes :target-id))
        target-record (get target :record)
        record
        {:recur-core-node-id (get node :node-id)
         :recur-form-id (get node :form-id)
         :recur-syntax-id (get node :syntax-id)
         :target-id (get attributes :target-id)
         :target-kind (get attributes :target-kind)
         :arity (get attributes :arity)
         :argument-node-ids (get preimage :children)
         :tail-position true
         :evaluation-order :arguments-left-to-right
         :transfer-policy :nearest-lexical-recur-target
         :type-compatibility :pending-sh08}]
    (if (= (get node :status) :accepted)
      (if (sh07-b51-v18-target-records-authentic?
           request two-pass target-records)
      (if (= (get target :status) :accepted)
        (if (sh07-b51-v18-recur-target-record-shape? target-record)
          (if (= (get target-record :target-kind)
                 (get attributes :target-kind))
            (if (if (= (get attributes :target-kind) :function)
                  (= (get target-record :arity) (get attributes :arity))
                  (= (get target-record :slot-count)
                     (get attributes :arity)))
              (if (if (= (get attributes :target-kind) :function)
                    (= (get target-record :binding-ids)
                       (get preimage :resolved-binding-ids))
                    true)
                (if (sh07-b51-v18-recur-transfer-record-shape? record)
                  {:status :accepted :record record :node-envelope node}
                  {:status :rejected
                   :reason :producer-v18-recur-transfer-record-shape
                   :partial-products []})
                {:status :rejected
                 :reason :producer-v18-recur-transfer-binding-join
                 :partial-products []})
              {:status :rejected
               :reason :producer-v18-recur-transfer-arity-join
               :partial-products []})
            {:status :rejected
             :reason :producer-v18-recur-transfer-kind-join
             :partial-products []})
          {:status :rejected :reason :producer-v18-recur-target-shape
           :partial-products []})
        target)
      {:status :rejected :reason :producer-v18-recur-target-set
       :partial-products []})
      node)))

(defn sh07-b51-v18-build-postorder-node
  [request two-pass postorder-record context]
  (let [indexes (sh07-b51-index-request request)
        form (sh07-b51-find-form indexes (get postorder-record :form-id))
        classified
        (if (map? form)
          (sh07-b51-v18-classify-form indexes form)
          {:status :rejected :reason :producer-v18-postorder-form
           :partial-products []})
        core-form (get classified :core-form)]
    (if (= (get classified :status) :accepted)
      (if (contains? #{:let :loop} core-form)
        (sh07-b51-v18-build-owner-postorder-node
         request two-pass postorder-record context)
        (if (= core-form :recur)
          (sh07-b51-v18-build-recur-postorder-node
           request two-pass postorder-record context)
          (sh07-b51-v18-build-simple-postorder-node
           request postorder-record context
           (get (get two-pass :bases) :core)
           (sh07-b51-internal-reference
            (get (get two-pass :bases) :authority)))))
      classified)))

(defn sh07-b51-v18-target-record-vector-shape? [records]
  (sh07-b51-v18-target-records-unique? records))

(defn sh07-b51-v18-transfer-record-vector-shape? [records]
  (if (vector? records)
    (loop [remaining records seen #{}]
      (if (= (count remaining) 0)
        true
        (let [record (first remaining)
              recur-id (get record :recur-core-node-id)]
          (if (sh07-b51-v18-recur-transfer-record-shape? record)
            (if (contains? seen recur-id)
              false
              (recur (rest remaining) (conj seen recur-id)))
            false))))
    false))

(defn sh07-b51-v18-build-node-and-target-pass
  [request two-pass postorder-records contexts]
  (loop [remaining postorder-records
         envelopes [] records [] preimages [] targets []]
    (if (= (count remaining) 0)
      (if (sh07-b51-v18-target-record-vector-shape? targets)
        {:status :accepted :envelopes envelopes :records records
         :preimages preimages :recur-targets targets}
        {:status :rejected :reason :producer-v18-target-vector-shape
         :partial-products []})
      (let [postorder-record (first remaining)
            selected-context
            (sh07-b51-v18-find-context
             contexts (get postorder-record :form-id)
             (get postorder-record :occurrence-path))
            context (get selected-context :context)
            built
            (if (= (get selected-context :status) :accepted)
              (sh07-b51-v18-build-postorder-node
               request two-pass postorder-record context)
              selected-context)
            core-form (get (get built :record) :core-form)
            target
            (if (if (= (get built :status) :accepted)
                  (contains? #{:fn :loop} core-form) false)
              (sh07-b51-v18-build-recur-target-record
               request two-pass postorder-record context)
              {:status :accepted :record nil})]
        (if (= (get built :status) :accepted)
          (if (= (get target :status) :accepted)
            (if (if (= (get target :record) nil)
                  true
                  (= (get target :node-envelope) built))
              (recur
               (rest remaining) (conj envelopes built)
               (conj records (get built :record))
               (conj preimages (get built :preimage))
               (if (= (get target :record) nil)
                 targets (conj targets (get target :record))))
              {:status :rejected
               :reason :producer-v18-target-node-envelope-join
               :partial-products []})
            target)
          built)))))

(defn sh07-b51-v18-build-transfer-pass
  [request two-pass envelopes target-records]
  (loop [remaining envelopes result []]
    (if (= (count remaining) 0)
      (if (sh07-b51-v18-transfer-record-vector-shape? result)
        {:status :accepted :recur-transfers result}
        {:status :rejected :reason :producer-v18-transfer-vector-shape
         :partial-products []})
      (let [envelope (first remaining)]
        (if (= (get (get envelope :record) :core-form) :recur)
          (let [built
                (sh07-b51-v18-build-recur-transfer-record
                 request two-pass
                 (get
                  (sh07-b51-find-postorder-record
                   (get two-pass :postorder-records)
                   (get envelope :form-id)
                   (get envelope :occurrence-path))
                  :record)
                 (get envelope :context) target-records)]
            (if (= (get built :status) :accepted)
              (if (= (get built :node-envelope) envelope)
                (recur (rest remaining) (conj result (get built :record)))
                {:status :rejected
                 :reason :producer-v18-transfer-node-envelope-join
                 :partial-products []})
              built))
          (recur (rest remaining) result))))))

(defn sh07-b51-producer-ordinary-core-records [request two-pass]
  (let [contexts (sh07-b51-v18-context-catalog request)
        postorder-records (get two-pass :postorder-records)
        nodes
        (if (= (get contexts :status) :accepted)
          (sh07-b51-v18-build-node-and-target-pass
           request two-pass postorder-records contexts)
          contexts)
        transfers
        (if (= (get nodes :status) :accepted)
          (sh07-b51-v18-build-transfer-pass
           request two-pass (get nodes :envelopes)
           (get nodes :recur-targets))
          nodes)]
    (if (sh07-b51-v18-two-pass-authentic? request two-pass)
      (if (= (get contexts :status) :accepted)
        (if (= (get nodes :status) :accepted)
          (if (= (get transfers :status) :accepted)
            (if (= (count (get nodes :records)) (count postorder-records))
              (if (= (count (get nodes :preimages))
                     (count postorder-records))
                (if (<= (count (get nodes :recur-targets)) 65536)
                  (if (<= (count (get transfers :recur-transfers)) 65536)
                    {:status :accepted
                     :records (get nodes :records)
                     :preimages (get nodes :preimages)
                     :recur-targets (get nodes :recur-targets)
                     :recur-transfers (get transfers :recur-transfers)
                     :postorder-count (count postorder-records)
                     :all-postorder-records-covered true
                     :target-transfer-joins-exact true
                     :partial-products []}
                    {:status :rejected
                     :reason :producer-v18-recur-transfer-bound
                     :partial-products []})
                  {:status :rejected :reason :producer-v18-recur-target-bound
                   :partial-products []})
                {:status :rejected :reason :producer-v18-preimage-coverage
                 :partial-products []})
              {:status :rejected :reason :producer-v18-node-coverage
               :partial-products []})
            transfers)
          nodes)
        contexts)
      {:status :rejected :reason :producer-v18-two-pass-authentication
       :partial-products []})))

(defn sh07-b51-ordinary-core-bundle-shape? [bundle]
  (if (sh07-b51-exact-keys?
       bundle
       #{:status :records :preimages :recur-targets :recur-transfers
         :postorder-count :all-postorder-records-covered
         :target-transfer-joins-exact :partial-products})
    (if (= (get bundle :status) :accepted)
      (if (vector? (get bundle :records))
        (if (vector? (get bundle :preimages))
          (if (= (count (get bundle :records))
                 (count (get bundle :preimages)))
            (if (= (count (get bundle :records))
                   (get bundle :postorder-count))
              (if (sh07-b51-v18-target-record-vector-shape?
                   (get bundle :recur-targets))
                (if (sh07-b51-v18-transfer-record-vector-shape?
                     (get bundle :recur-transfers))
                  (if (= (get bundle :all-postorder-records-covered) true)
                    (if (= (get bundle :target-transfer-joins-exact) true)
                      (= (get bundle :partial-products) [])
                      false)
                    false)
                  false)
                false)
              false)
            false)
          false)
        false)
      false)
    false))

(defn sh07-b51-authenticate-ordinary-core-records
  [request two-pass supplied-bundle]
  (let [regenerated
        (sh07-b51-producer-ordinary-core-records request two-pass)]
    (if (= (get regenerated :status) :accepted)
      (if (sh07-b51-ordinary-core-bundle-shape? supplied-bundle)
        (if (= supplied-bundle regenerated)
          {:status :accepted :bundle supplied-bundle
           :independently-regenerated true :partial-products []}
          {:status :rejected :reason :producer-v18-core-bundle-mismatch
           :partial-products []})
        {:status :rejected :reason :producer-v18-core-bundle-shape
         :partial-products []})
      regenerated)))

(defn sh07-b51-producer-v18-node-by-form-id [records form-id]
  (loop [remaining records found nil found-count 0]
    (if (= (count remaining) 0)
      (if (= found-count 1)
        {:status :accepted :record found}
        {:status :rejected :reason :producer-inherited-node-form-join
         :partial-products []})
      (let [record (first remaining)]
        (if (= (get (get record :source) :form-id) form-id)
          (recur (rest remaining) record (+ found-count 1))
          (recur (rest remaining) found found-count))))))

(defn sh07-b51-producer-inherited-evaluation-order [records]
  (loop [remaining records result []]
    (if (= (count remaining) 0)
      result
      (let [record (first remaining)
            evaluation (get record :evaluation)]
        (recur
         (rest remaining)
         (conj
          result
          {:core-node-id (get record :node-id)
           :kind (get evaluation :kind)
           :region (get evaluation :region)
           :owner-function-syntax-id
           (get evaluation :owner-function-syntax-id)
           :children
           (loop [entries (get evaluation :order) children []]
             (if (= (count entries) 0)
               children
               (recur
                (rest entries)
                (conj children (get (first entries) :core-node-id)))))}))))))

(defn sh07-b51-producer-inherited-source-map [records]
  (loop [remaining records result []]
    (if (= (count remaining) 0)
      result
      (let [record (first remaining)
            source (get record :source)]
        (recur
         (rest remaining)
         (conj
          result
          {:core-node-id (get record :node-id)
           :syntax-id (get source :syntax-id)
           :form-id (get source :form-id)
           :source-span (get source :semantic-span)
           :origin-chain (get source :origin-chain)
           :generated-origin (get source :generated-origin)}))))))

(defn sh07-b51-producer-inherited-definitions [records]
  (loop [remaining records result []]
    (if (= (count remaining) 0)
      {:status :accepted :records result}
      (let [record (first remaining)]
        (if (= (get record :core-form) :def)
          (let [attributes (get record :attributes)
                children (get record :children)
                binding-ids (get record :resolved-binding-ids)]
            (if (if (= (count children) 1)
                  (= (count binding-ids) 1) false)
              (recur
               (rest remaining)
               (conj
                result
                {:name (get attributes :name)
                 :binding-id (first binding-ids)
                 :core-node-id (get record :node-id)
                 :value-node-id (first children)
                 :syntax-id (get (get record :source) :syntax-id)}))
              {:status :rejected
               :reason :producer-inherited-definition-node-join
               :partial-products []}))
          (recur (rest remaining) result))))))

(defn sh07-b51-producer-inherited-reference-uses [records]
  (loop [remaining records result []]
    (if (= (count remaining) 0)
      result
      (let [record (first remaining)]
        (if (= (get record :core-form) :reference)
          (let [attributes (get record :attributes)
                source (get record :source)]
            (recur
             (rest remaining)
             (conj
              result
              {:core-node-id (get record :node-id)
               :form-id (get source :form-id)
               :syntax-id (get source :syntax-id)
               :symbol (get attributes :symbol)
               :position (get attributes :position)
               :binding-id (get attributes :binding-id)
               :binding-class (get attributes :binding-class)
               :definition-syntax-id
               (get attributes :definition-syntax-id)})))
          (recur (rest remaining) result))))))

(defn sh07-b51-producer-inherited-control-flow [records]
  (loop [remaining records result []]
    (if (= (count remaining) 0)
      result
      (let [record (first remaining)
            core-form (get record :core-form)
            children (get record :children)]
        (if (= core-form :if)
          (recur
           (rest remaining)
           (conj
            result
            {:core-node-id (get record :node-id)
             :kind :if
             :condition-node-id (get children 0)
             :branches
             [{:role :then :predicate :truthy
               :core-node-id (get children 1)}
              {:role :else :predicate :falsey
               :core-node-id (get children 2)}]
             :branch-exclusivity :exactly-one
             :truthiness {:false-values [:nil :false]
                          :other-values :true}
             :result-policy :selected-branch}))
          (if (= core-form :do)
            (recur
             (rest remaining)
             (conj
              result
              {:core-node-id (get record :node-id)
               :kind :do
               :ordered-child-node-ids children
               :evaluation-order :left-to-right
               :result-policy
               {:kind :last-child
                :core-node-id (get children (- (count children) 1))}}))
            (recur (rest remaining) result)))))))

(defn sh07-b51-producer-inherited-calls [records]
  (loop [remaining records result []]
    (if (= (count remaining) 0)
      result
      (let [record (first remaining)]
        (if (= (get record :core-form) :call)
          (let [children (get record :children)
                binding-ids (get record :resolved-binding-ids)]
            (recur
             (rest remaining)
             (conj
              result
              {:core-node-id (get record :node-id)
               :operator-node-id (first children)
               :operator-binding-id (first binding-ids)
               :argument-node-ids (vec (rest children))
               :ordered-evaluation-node-ids children
               :evaluation-order :operator-then-arguments
               :result-policy :call-result})))
          (recur (rest remaining) result))))))

(defn sh07-b51-producer-inherited-keyword-lookups [records]
  (loop [remaining records result []]
    (if (= (count remaining) 0)
      result
      (let [record (first remaining)]
        (if (= (get record :core-form) :keyword-map-lookup)
          (let [children (get record :children)
                attributes (get record :attributes)]
            (recur
             (rest remaining)
             (conj
              result
              {:core-node-id (get record :node-id)
               :keyword-node-id (get children 0)
               :map-node-id (get children 1)
               :keyword (get attributes :keyword)
               :ordered-evaluation-node-ids children
               :evaluation-order :keyword-then-map
               :missing-key-policy :nil
               :result-policy :map-value-or-nil})))
          (recur (rest remaining) result))))))

(defn sh07-b51-producer-inherited-var-references [records]
  (loop [remaining records ordinal 0 result []]
    (if (= (count remaining) 0)
      result
      (let [record (first remaining)]
        (if (= (get record :core-form) :var)
          (let [attributes (get record :attributes)
                source (get record :source)]
            (recur
             (rest remaining) (+ ordinal 1)
             (conj
              result
              {:ordinal ordinal
               :core-node-id (get record :node-id)
               :form-id (get source :form-id)
               :syntax-id (get source :syntax-id)
               :operand-form-id (get attributes :operand-form-id)
               :operand-syntax-id (get attributes :operand-syntax-id)
               :symbol (get attributes :symbol)
               :binding-id (get attributes :binding-id)
               :binding-class (get attributes :binding-class)
               :definition-kind (get attributes :definition-kind)
               :object-kind (get attributes :object-kind)
               :upstream-binding-id
               (get attributes :upstream-binding-id)
               :namespace (get attributes :namespace)
               :definition-syntax-id
               (get attributes :definition-syntax-id)
               :definition-artifact-id
               (get attributes :definition-artifact-id)
               :resolution-order (get attributes :resolution-order)
               :authenticated-sh06-artifact-id
               (get attributes :authenticated-sh06-artifact-id)
               :sh06-semantic-projection-id
               (get attributes :sh06-semantic-projection-id)
               :object-policy (get attributes :object-policy)
               :evaluated-children []
               :evaluation-order []
               :profile-legality (get attributes :profile-legality)})))
          (recur (rest remaining) ordinal result))))))

(defn sh07-b51-producer-inherited-mutations [records]
  (loop [remaining records ordinal 0 result []]
    (if (= (count remaining) 0)
      result
      (let [record (first remaining)]
        (if (= (get record :core-form) :set!)
          (let [attributes (get record :attributes)
                source (get record :source)
                evaluation (get record :evaluation)
                value-node-id (first (get record :children))]
            (recur
             (rest remaining) (+ ordinal 1)
             (conj
              result
              {:target-symbol (get attributes :target-symbol)
               :target-binding-id (get attributes :target-binding-id)
               :target-binding-class
               (get attributes :target-binding-class)
               :target-definition-kind
               (get attributes :target-definition-kind)
               :target-location (get attributes :target-location)
               :target-upstream-binding-id
               (get attributes :target-upstream-binding-id)
               :target-namespace (get attributes :target-namespace)
               :target-definition-syntax-id
               (get attributes :target-definition-syntax-id)
               :target-definition-artifact-id
               (get attributes :target-definition-artifact-id)
               :target-form-id (get attributes :target-form-id)
               :target-syntax-id (get attributes :target-syntax-id)
               :resolution-order (get attributes :resolution-order)
               :authenticated-sh06-artifact-id
               (get attributes :authenticated-sh06-artifact-id)
               :sh06-semantic-projection-id
               (get attributes :sh06-semantic-projection-id)
               :ordinal ordinal
               :core-node-id (get record :node-id)
               :form-id (get source :form-id)
               :syntax-id (get source :syntax-id)
               :value-core-node-id value-node-id
               :target-evaluated-children []
               :evaluated-children [value-node-id]
               :evaluation-region (get evaluation :region)
               :evaluation-owner-function-syntax-id
               (get evaluation :owner-function-syntax-id)
               :ordered-steps [:evaluate-value :write-target :yield-unit]
               :result-policy :unit
               :required-effect :state/write
               :type-legality (get attributes :type-legality)
               :effect-registry-legality
               (get attributes :effect-registry-legality)
               :effect-profile-capability-legality
               (get attributes :effect-profile-capability-legality)
               :ownership-legality (get attributes :ownership-legality)
               :safety-classification
               (get attributes :safety-classification)})))
          (recur (rest remaining) ordinal result))))))

(defn sh07-b51-producer-inherited-error-transfers [records]
  (loop [remaining records ordinal 0 result []]
    (if (= (count remaining) 0)
      result
      (let [record (first remaining)]
        (if (= (get record :core-form) :throw)
          (let [attributes (get record :attributes)
                source (get record :source)
                evaluation (get record :evaluation)
                value-node-id (first (get record :children))]
            (recur
             (rest remaining) (+ ordinal 1)
             (conj
              result
              {:ordinal ordinal
               :core-node-id (get record :node-id)
               :form-id (get source :form-id)
               :syntax-id (get source :syntax-id)
               :value-core-node-id value-node-id
               :evaluated-children [value-node-id]
               :evaluation-region (get evaluation :region)
               :evaluation-owner-function-syntax-id
               (get evaluation :owner-function-syntax-id)
               :ordered-steps [:evaluate-value :transfer-error]
               :construction-order (get attributes :construction-order)
               :runtime-reachability
               (get attributes :runtime-reachability)
               :transfer-policy (get attributes :transfer-policy)
               :result-policy (get attributes :result-policy)
               :required-effect (get attributes :required-effect)
               :authenticated-sh06-artifact-id
               (get attributes :authenticated-sh06-artifact-id)
               :sh06-semantic-projection-id
               (get attributes :sh06-semantic-projection-id)
               :type-legality (get attributes :type-legality)
               :effect-registry-legality
               (get attributes :effect-registry-legality)
               :effect-profile-capability-legality
               (get attributes :effect-profile-capability-legality)
               :profile-error-lowering-legality
               (get attributes :profile-error-lowering-legality)
               :ownership-legality (get attributes :ownership-legality)
               :safety-classification
               (get attributes :safety-classification)})))
          (recur (rest remaining) ordinal result))))))

(defn sh07-b51-producer-owner-slot-leaf-records
  [owner-entry slot-plan]
  (let [foundation (get owner-entry :foundation)
        owner-kind (get foundation :owner-kind)
        owner-core-node-id
        (get (get owner-entry :initialization-layout) :owner-core-node-id)
        slot-preimage (get slot-plan :binding-slot-preimage)
        evaluation (get slot-plan :initializer-evaluation)]
    (loop [remaining (get slot-plan :binding-extraction-preimages)
           result []]
      (if (= (count remaining) 0)
        result
        (let [extraction (first remaining)]
          (if (= (get extraction :kind) :binding-leaf)
            (let [record
                  {:slot-id (get slot-plan :slot-id)
                   :slot-ordinal (get slot-preimage :slot-ordinal)
                   :leaf-ordinal (get extraction :leaf-ordinal)
                   :name (get extraction :binding-name)
                   :binding-id (get extraction :binding-id)
                   :definition-form-id
                   (get extraction :definition-form-id)
                   :definition-syntax-id
                   (get extraction :definition-syntax-id)
                   :binding-scope-id
                   (get extraction :binding-scope-id)
                   :initializer-form-id
                   (get slot-preimage :initializer-form-id)
                   :initializer-syntax-id
                   (get slot-preimage :initializer-syntax-id)
                   :initializer-scope-id
                   (get slot-preimage :initializer-scope-id)
                   :initializer-node-id
                   (get slot-preimage :initializer-core-node-id)
                   :visible-prior-binding-ids
                   (get evaluation :visible-prior-binding-ids)
                   :mutability :immutable}
                  bound
                  (if (= owner-kind :let)
                    (assoc record :let-core-node-id owner-core-node-id)
                    (assoc record :loop-core-node-id owner-core-node-id))]
              (recur (rest remaining) (conj result bound)))
            (recur (rest remaining) result)))))))

(defn sh07-b51-producer-inherited-owner-bindings [two-pass]
  (loop [remaining-owners (get two-pass :materialized-owners)
         lexical [] loop-bindings []]
    (if (= (count remaining-owners) 0)
      {:status :accepted :lexical-bindings lexical
       :loop-bindings loop-bindings}
      (let [owner-entry (first remaining-owners)
            foundation (get owner-entry :foundation)
            owner-kind (get foundation :owner-kind)
            records
            (loop [remaining-slots (get foundation :slot-plans)
                   result []]
              (if (= (count remaining-slots) 0)
                result
                (recur
                 (rest remaining-slots)
                 (sh07-b51-vector-append
                  result
                  (sh07-b51-producer-owner-slot-leaf-records
                   owner-entry (first remaining-slots))))))]
        (if (= owner-kind :let)
          (recur
           (rest remaining-owners)
           (sh07-b51-vector-append lexical records) loop-bindings)
          (if (= owner-kind :loop)
            (recur
             (rest remaining-owners) lexical
             (sh07-b51-vector-append loop-bindings records))
            {:status :rejected :reason :producer-inherited-owner-kind
             :partial-products []}))))))

(defn sh07-b51-producer-find-definition-by-value [definitions node-id]
  (loop [remaining definitions]
    (if (= (count remaining) 0) nil
      (if (= (get (first remaining) :value-node-id) node-id)
        (first remaining) (recur (rest remaining))))))

(defn sh07-b51-producer-find-definition-by-binding [definitions binding-id]
  (loop [remaining definitions]
    (if (= (count remaining) 0) nil
      (if (= (get (first remaining) :binding-id) binding-id)
        (first remaining) (recur (rest remaining))))))

(defn sh07-b51-producer-find-function-by-syntax [records syntax-id]
  (loop [remaining records]
    (if (= (count remaining) 0) nil
      (if (= (get (first remaining) :function-syntax-id) syntax-id)
        (first remaining) (recur (rest remaining))))))

(defn sh07-b51-producer-find-function-by-node [records node-id]
  (loop [remaining records]
    (if (= (count remaining) 0) nil
      (if (= (get (first remaining) :function-core-node-id) node-id)
        (first remaining) (recur (rest remaining))))))

(defn sh07-b51-producer-inherited-functions [records definitions]
  (loop [remaining records ordinal 0 result []]
    (if (= (count remaining) 0)
      result
      (let [record (first remaining)]
        (if (= (get record :core-form) :fn)
          (let [attributes (get record :attributes)
                source (get record :source)
                definition
                (sh07-b51-producer-find-definition-by-value
                 definitions (get record :node-id))]
            (recur
             (rest remaining) (+ ordinal 1)
             (conj
              result
              {:ordinal ordinal
               :function-core-node-id (get record :node-id)
               :function-form-id (get source :form-id)
               :function-syntax-id (get source :syntax-id)
               :body-core-node-id (first (get record :children))
               :parameter-binding-ids (get record :resolved-binding-ids)
               :fixed-arity (get attributes :fixed-arity)
               :definition-kind
               (if (map? definition) :named-top-level :anonymous)
               :definition-binding-id
               (if (map? definition) (get definition :binding-id) nil)
               :definition-core-node-id
               (if (map? definition) (get definition :core-node-id) nil)
               :definition-name
               (if (map? definition) (get definition :name) nil)})))
          (recur (rest remaining) ordinal result))))))

(defn sh07-b51-producer-inherited-call-edges
  [request records definitions calls functions]
  (let [indexes (sh07-b51-index-request request)]
    (loop [remaining calls ordinal 0 result []]
      (if (= (count remaining) 0)
        result
        (let [call (first remaining)
              call-node
              (loop [nodes records]
                (if (= (count nodes) 0) nil
                  (if (= (get (first nodes) :node-id)
                         (get call :core-node-id))
                    (first nodes) (recur (rest nodes)))))
              caller
              (sh07-b51-producer-find-function-by-syntax
               functions
               (get (get call-node :evaluation)
                    :owner-function-syntax-id))
              binding
              (sh07-b51-find-binding indexes
                                      (get call :operator-binding-id))
              definition
              (sh07-b51-producer-find-definition-by-binding
               definitions (get call :operator-binding-id))
              callee
              (if (map? definition)
                (sh07-b51-producer-find-function-by-node
                 functions (get definition :value-node-id)) nil)]
          (recur
           (rest remaining) (+ ordinal 1)
           (conj
            result
            {:ordinal ordinal
             :call-core-node-id (get call :core-node-id)
             :caller-function-syntax-id
             (if (map? caller) (get caller :function-syntax-id) nil)
             :caller-function-core-node-id
             (if (map? caller) (get caller :function-core-node-id) nil)
             :callee-binding-id (get call :operator-binding-id)
             :callee-definition-syntax-id
             (get binding :definition-syntax-id)
             :callee-function-syntax-id
             (if (map? callee) (get callee :function-syntax-id) nil)
             :callee-function-core-node-id
             (if (map? callee) (get callee :function-core-node-id) nil)
             :argument-core-node-ids (get call :argument-node-ids)
             :ordered-evaluation-node-ids
             (get call :ordered-evaluation-node-ids)
             :evaluation-order :operator-then-arguments
             :classification
             (if (map? callee)
               :local-function :nonlocal-or-nonfunction)})))))))

(defn sh07-b51-producer-call-adjacency [edges direction]
  (loop [remaining edges result {}]
    (if (= (count remaining) 0) result
      (let [edge (first remaining)]
        (if (= (get edge :classification) :local-function)
          (let [source
                (if (= direction :forward)
                  (get edge :caller-function-syntax-id)
                  (get edge :callee-function-syntax-id))
                target
                (if (= direction :forward)
                  (get edge :callee-function-syntax-id)
                  (get edge :caller-function-syntax-id))
                targets (get result source [])]
            (if (sh07-b51-vector-contains? targets target)
              (recur (rest remaining) result)
              (recur
               (rest remaining) (assoc result source (conj targets target)))))
          (recur (rest remaining) result))))))

(defn sh07-b51-producer-reachable-functions [adjacency start]
  (loop [frontier [start] visited [start]]
    (if (= (count frontier) 0) visited
      (let [current (first frontier)
            targets (get adjacency current [])
            added
            (loop [remaining targets next-frontier (vec (rest frontier))
                   next-visited visited]
              (if (= (count remaining) 0)
                {:frontier next-frontier :visited next-visited}
                (let [target (first remaining)]
                  (if (sh07-b51-vector-contains? next-visited target)
                    (recur (rest remaining) next-frontier next-visited)
                    (recur
                     (rest remaining) (conj next-frontier target)
                     (conj next-visited target))))))]
        (recur (get added :frontier) (get added :visited))))))

(defn sh07-b51-producer-self-call? [edges syntax-id]
  (loop [remaining edges]
    (if (= (count remaining) 0) false
      (let [edge (first remaining)]
        (if (if (= (get edge :classification) :local-function)
              (if (= (get edge :caller-function-syntax-id) syntax-id)
                (= (get edge :callee-function-syntax-id) syntax-id) false)
              false)
          true (recur (rest remaining)))))))

(defn sh07-b51-producer-component-members
  [functions outgoing incoming syntax-id]
  (let [forward (sh07-b51-producer-reachable-functions outgoing syntax-id)
        backward (sh07-b51-producer-reachable-functions incoming syntax-id)]
    (loop [remaining functions result []]
      (if (= (count remaining) 0) result
        (let [record (first remaining)
              candidate (get record :function-syntax-id)]
          (if (if (= (get record :definition-kind) :named-top-level)
                (if (sh07-b51-vector-contains? forward candidate)
                  (sh07-b51-vector-contains? backward candidate) false)
                false)
            (recur (rest remaining) (conj result record))
            (recur (rest remaining) result)))))))

(defn sh07-b51-producer-component-edge-ordinals [edges syntax-ids]
  (loop [remaining edges result []]
    (if (= (count remaining) 0) result
      (let [edge (first remaining)]
        (if (if (= (get edge :classification) :local-function)
              (if (sh07-b51-vector-contains?
                   syntax-ids (get edge :caller-function-syntax-id))
                (sh07-b51-vector-contains?
                 syntax-ids (get edge :callee-function-syntax-id)) false)
              false)
          (recur (rest remaining) (conj result (get edge :ordinal)))
          (recur (rest remaining) result))))))

(defn sh07-b51-producer-inherited-recursion-components [functions edges]
  (let [outgoing (sh07-b51-producer-call-adjacency edges :forward)
        incoming (sh07-b51-producer-call-adjacency edges :reverse)]
    (loop [remaining functions assigned [] ordinal 0 result []]
      (if (= (count remaining) 0) result
        (let [record (first remaining)
              syntax-id (get record :function-syntax-id)]
          (if (if (= (get record :definition-kind) :named-top-level)
                (if (sh07-b51-vector-contains? assigned syntax-id)
                  false true) false)
            (let [members
                  (sh07-b51-producer-component-members
                   functions outgoing incoming syntax-id)
                  cyclic?
                  (if (> (count members) 1) true
                    (sh07-b51-producer-self-call? edges syntax-id))]
              (if cyclic?
                (let [syntax-ids
                      (loop [values members ids []]
                        (if (= (count values) 0) ids
                          (recur
                           (rest values)
                           (conj ids
                                 (get (first values)
                                      :function-syntax-id)))))
                      node-ids
                      (loop [values members ids []]
                        (if (= (count values) 0) ids
                          (recur
                           (rest values)
                           (conj ids
                                 (get (first values)
                                      :function-core-node-id)))))]
                  (recur
                   (rest remaining)
                   (sh07-b51-vector-append assigned syntax-ids)
                   (+ ordinal 1)
                   (conj
                    result
                    {:ordinal ordinal
                     :kind
                     (if (= (count members) 1)
                       :self-recursive :mutually-recursive)
                     :function-syntax-ids syntax-ids
                     :function-core-node-ids node-ids
                     :internal-call-edge-ordinals
                     (sh07-b51-producer-component-edge-ordinals
                      edges syntax-ids)})))
                (recur (rest remaining) assigned ordinal result)))
            (recur (rest remaining) assigned ordinal result)))))))

(defn sh07-b51-producer-node-by-id [records node-id]
  (loop [remaining records]
    (if (= (count remaining) 0) nil
      (if (= (get (first remaining) :node-id) node-id)
        (first remaining) (recur (rest remaining))))))

(defn sh07-b51-producer-node-in-subtree?
  [records root-node-id candidate-node-id depth ancestry]
  (if (> depth 256) false
    (if (= root-node-id candidate-node-id) true
      (if (sh07-b51-vector-contains? ancestry root-node-id) false
        (let [record (sh07-b51-producer-node-by-id records root-node-id)]
          (if (map? record)
            (loop [remaining (get record :children)]
              (if (= (count remaining) 0) false
                (if (sh07-b51-producer-node-in-subtree?
                     records (first remaining) candidate-node-id (+ depth 1)
                     (conj ancestry root-node-id))
                  true (recur (rest remaining)))))
            false))))))

(defn sh07-b51-producer-handler-candidate-transfers
  [records error-transfers protected-node-id owner-syntax-id]
  (loop [remaining error-transfers result []]
    (if (= (count remaining) 0) result
      (let [transfer (first remaining)]
        (if (if (= (get transfer :evaluation-owner-function-syntax-id)
                   owner-syntax-id)
              (sh07-b51-producer-node-in-subtree?
               records protected-node-id (get transfer :core-node-id) 0 [])
              false)
          (recur
           (rest remaining)
           (conj result {:ordinal (get transfer :ordinal)
                         :core-node-id (get transfer :core-node-id)}))
          (recur (rest remaining) result))))))

(defn sh07-b51-producer-handler-binding-uses
  [records reference-uses handler-node-id binding-id]
  (loop [remaining reference-uses result []]
    (if (= (count remaining) 0) result
      (let [reference (first remaining)]
        (if (if (= (get reference :binding-id) binding-id)
              (sh07-b51-producer-node-in-subtree?
               records handler-node-id (get reference :core-node-id) 0 [])
              false)
          (recur (rest remaining) (conj result (get reference :syntax-id)))
          (recur (rest remaining) result))))))

(defn sh07-b51-producer-inherited-error-handlers
  [request records reference-uses error-transfers]
  (loop [remaining records ordinal 0 result []]
    (if (= (count remaining) 0) result
      (let [record (first remaining)]
        (if (= (get record :core-form) :try)
          (let [attributes (get record :attributes)
                source (get record :source)
                evaluation (get record :evaluation)
                children (get record :children)
                protected-node-id (first children)
                clauses (get attributes :handler-clauses)
                candidates
                (sh07-b51-producer-handler-candidate-transfers
                 records error-transfers protected-node-id
                 (get evaluation :owner-function-syntax-id))
                built
                (loop [remaining-clauses clauses
                       next-ordinal ordinal records-built []]
                  (if (= (count remaining-clauses) 0)
                    {:next-ordinal next-ordinal :records records-built}
                    (let [clause (first remaining-clauses)
                          handler-node-id
                          (get children (get clause :handler-child-index))
                          uses
                          (sh07-b51-producer-handler-binding-uses
                           records reference-uses handler-node-id
                           (get clause :catch-binding-id))]
                      (recur
                       (rest remaining-clauses) (+ next-ordinal 1)
                       (conj
                        records-built
                        {:ordinal next-ordinal
                         :clause-ordinal (get clause :clause-ordinal)
                         :clause-count (count clauses)
                         :handler-child-index
                         (get clause :handler-child-index)
                         :core-node-id (get record :node-id)
                         :form-id (get source :form-id)
                         :syntax-id (get source :syntax-id)
                         :protected-core-node-id protected-node-id
                         :handler-core-node-id handler-node-id
                         :catch-clause-form-id
                         (get clause :catch-clause-form-id)
                         :catch-clause-syntax-id
                         (get clause :catch-clause-syntax-id)
                         :error-type-form-id
                         (get clause :error-type-form-id)
                         :error-type-syntax-id
                         (get clause :error-type-syntax-id)
                         :error-type-binding-id
                         (get clause :error-type-binding-id)
                         :catch-binding-form-id
                         (get clause :catch-binding-form-id)
                         :catch-binding-syntax-id
                         (get clause :catch-binding-syntax-id)
                         :catch-binding-id (get clause :catch-binding-id)
                         :catch-binding-scope-id
                         (get clause :catch-binding-scope-id)
                         :catch-binding-use-syntax-ids uses
                         :candidate-error-transfers candidates
                         :evaluation-region (get evaluation :region)
                         :evaluation-owner-function-syntax-id
                         (get evaluation :owner-function-syntax-id)
                         :ordered-steps
                         [:evaluate-protected
                          :conditionally-select-source-ordered-typed-handler]
                         :construction-order
                         :protected-then-handlers-source-order-then-try
                         :runtime-evaluation
                         :protected-then-conditional-handler-chain
                         :runtime-reachability :not-asserted-by-sh07-b9
                         :selection-policy
                         :source-ordered-typed-handler-candidates
                         :result-policy
                         :protected-or-selected-handler-last
                         :authenticated-sh06-artifact-id
                         (get attributes :authenticated-sh06-artifact-id)
                         :sh06-semantic-projection-id
                         (get attributes :sh06-semantic-projection-id)
                         :type-coverage-legality :pending-sh08
                         :result-type-join-legality :pending-sh08
                         :effect-registry-legality :pending-sh09
                         :effect-profile-capability-legality :pending-sh09
                         :profile-error-lowering-legality :pending-sh09
                         :ownership-legality :pending-sh10
                         :safety-classification :pending-sh11})))))]
            (recur
             (rest remaining) (get built :next-ordinal)
             (sh07-b51-vector-append result (get built :records))))
          (recur (rest remaining) ordinal result))))))

(defn sh07-b51-producer-match-pattern-seed
  [request pattern clause-ordinal local-ordinal parent-local-ordinal
   depth path pattern-kind pattern-value vector-width binding]
  {:ordinal nil :clause-ordinal clause-ordinal
   :local-ordinal local-ordinal
   :parent-local-ordinal parent-local-ordinal :root-local-ordinal 0
   :parent-ordinal nil :root-ordinal nil :core-node-id nil
   :depth depth :path path :pattern-kind pattern-kind
   :pattern-form-id (get pattern :form-id)
   :pattern-syntax-id (get pattern :syntax-id)
   :pattern-value pattern-value :vector-width vector-width
   :pattern-binding-id (if (map? binding) (get binding :binding-id) nil)
   :pattern-binding-scope-id
   (if (map? binding) (get binding :scope-id) nil)
   :pattern-binding-use-syntax-ids []
   :authenticated-sh06-artifact-id
   (get (get request :lineage) :authenticated-sh06-artifact-id)
   :sh06-semantic-projection-id
   (get (get request :lineage) :sh06-semantic-projection-id)})

(defn sh07-b51-producer-match-pattern-walk
  [request indexes pattern clause-ordinal parent-local-ordinal
   depth path local-ordinal]
  (let [kind (get pattern :kind) value (get pattern :value)]
    (if (= kind :symbol)
      (if (= value '_)
        {:status :accepted :next-local-ordinal (+ local-ordinal 1)
         :records
         [(sh07-b51-producer-match-pattern-seed
           request pattern clause-ordinal local-ordinal
           parent-local-ordinal depth path :wildcard '_ nil nil)]}
        (let [binding
              (sh07-b51-find-binding-by-definition
               indexes (get pattern :syntax-id))]
          (if (map? binding)
            {:status :accepted :next-local-ordinal (+ local-ordinal 1)
             :records
             [(sh07-b51-producer-match-pattern-seed
               request pattern clause-ordinal local-ordinal
               parent-local-ordinal depth path :binding value nil binding)]}
            {:status :rejected :reason :producer-inherited-match-binding
             :partial-products []})))
      (if (contains?
           #{:nil :boolean :integer :decimal :ratio :character
             :string :keyword}
           kind)
        {:status :accepted :next-local-ordinal (+ local-ordinal 1)
         :records
         [(sh07-b51-producer-match-pattern-seed
           request pattern clause-ordinal local-ordinal
           parent-local-ordinal depth path :literal value nil nil)]}
        (if (= kind :vector)
          (loop [remaining (get pattern :child-form-ids)
                 child-index 0 next-local (+ local-ordinal 1)
                 result
                 [(sh07-b51-producer-match-pattern-seed
                   request pattern clause-ordinal local-ordinal
                   parent-local-ordinal depth path :vector nil
                   (count (get pattern :child-form-ids)) nil)]]
            (if (= (count remaining) 0)
              {:status :accepted :next-local-ordinal next-local
               :records result}
              (let [child (sh07-b51-find-form indexes (first remaining))
                    walked
                    (if (map? child)
                      (sh07-b51-producer-match-pattern-walk
                       request indexes child clause-ordinal local-ordinal
                       (+ depth 1) (conj path child-index) next-local)
                      {:status :rejected})]
                (if (= (get walked :status) :accepted)
                  (recur
                   (rest remaining) (+ child-index 1)
                   (get walked :next-local-ordinal)
                   (sh07-b51-vector-append result (get walked :records)))
                  {:status :rejected
                   :reason :producer-inherited-match-pattern
                   :partial-products []}))))
          {:status :rejected :reason :producer-inherited-match-pattern-kind
           :partial-products []})))))

(defn sh07-b51-producer-bind-match-patterns
  [records first-ordinal match-node-id branch-node-id
   ordinary-records reference-uses]
  (loop [remaining records ordinal first-ordinal
         root-ordinal first-ordinal result []]
    (if (= (count remaining) 0)
      {:status :accepted :next-ordinal ordinal :records result}
      (let [record (first remaining)
            parent-local (get record :parent-local-ordinal)
            binding-id (get record :pattern-binding-id)
            uses
            (if (= binding-id nil) []
              (sh07-b51-producer-handler-binding-uses
               ordinary-records reference-uses branch-node-id binding-id))
            bound
            (assoc
             (assoc
              (assoc
               (assoc
                (assoc record :ordinal ordinal)
                :root-ordinal root-ordinal)
               :parent-ordinal
               (if (= parent-local nil) nil (+ root-ordinal parent-local)))
              :core-node-id match-node-id)
             :pattern-binding-use-syntax-ids uses)]
        (recur
         (rest remaining) (+ ordinal 1) root-ordinal
         (conj result bound))))))

(defn sh07-b51-producer-inherited-match-products
  [request ordinary-records reference-uses]
  (let [indexes (sh07-b51-index-request request)]
    (loop [remaining ordinary-records branch-ordinal 0 pattern-ordinal 0
           branches [] patterns [] skeletons []]
      (if (= (count remaining) 0)
        {:status :accepted :match-branch-records branches
         :match-pattern-records patterns
         :match-decision-skeletons skeletons}
        (let [record (first remaining)]
          (if (= (get record :core-form) :match)
            (let [attributes (get record :attributes)
                  clauses (get attributes :branch-clauses)
                  children (get record :children)
                  source (get record :source)
                  built
                  (loop [remaining-clauses clauses
                         next-branch branch-ordinal
                         next-pattern pattern-ordinal
                         branch-records [] pattern-records []]
                    (if (= (count remaining-clauses) 0)
                      {:status :accepted :next-branch next-branch
                       :next-pattern next-pattern
                       :branch-records branch-records
                       :pattern-records pattern-records}
                      (let [clause (first remaining-clauses)
                            clause-ordinal (get clause :clause-ordinal)
                            pattern-form
                            (sh07-b51-find-form
                             indexes (get clause :pattern-form-id))
                            branch-node-id
                            (get children (get clause :branch-child-index))
                            walked
                            (if (map? pattern-form)
                              (sh07-b51-producer-match-pattern-walk
                               request indexes pattern-form clause-ordinal
                               nil 0 [] 0)
                              {:status :rejected})
                            bound
                            (if (= (get walked :status) :accepted)
                              (sh07-b51-producer-bind-match-patterns
                               (get walked :records) next-pattern
                               (get record :node-id) branch-node-id
                               ordinary-records reference-uses)
                              walked)
                            binding-id (get clause :pattern-binding-id)
                            uses
                            (if (= binding-id nil) []
                              (sh07-b51-producer-handler-binding-uses
                               ordinary-records reference-uses
                               branch-node-id binding-id))]
                        (if (= (get bound :status) :accepted)
                          (recur
                           (rest remaining-clauses) (+ next-branch 1)
                           (get bound :next-ordinal)
                           (conj
                            branch-records
                            {:ordinal next-branch
                             :clause-ordinal clause-ordinal
                             :clause-count (count clauses)
                             :core-node-id (get record :node-id)
                             :scrutinee-core-node-id (first children)
                             :branch-core-node-id branch-node-id
                             :branch-child-index
                             (get clause :branch-child-index)
                             :pattern-kind (get clause :pattern-kind)
                             :pattern-form-id (get clause :pattern-form-id)
                             :pattern-syntax-id
                             (get clause :pattern-syntax-id)
                             :pattern-value (get clause :pattern-value)
                             :branch-form-id (get clause :branch-form-id)
                             :branch-syntax-id
                             (get clause :branch-syntax-id)
                             :pattern-binding-id binding-id
                             :pattern-binding-scope-id
                             (get clause :pattern-binding-scope-id)
                             :pattern-binding-ids
                             (get clause :pattern-binding-ids)
                             :pattern-binding-use-syntax-ids uses
                             :conditional-region
                             {:kind :match-branch
                              :match-syntax-id (get source :syntax-id)
                              :clause-ordinal clause-ordinal}
                             :scrutinee-evaluation
                             :evaluate-scrutinee-once
                             :branch-evaluation
                             :conditionally-evaluate-selected-branch
                             :authenticated-sh06-artifact-id
                             (get attributes
                                  :authenticated-sh06-artifact-id)
                             :sh06-semantic-projection-id
                             (get attributes
                                  :sh06-semantic-projection-id)})
                           (sh07-b51-vector-append
                            pattern-records (get bound :records)))
                          {:status :rejected
                           :reason :producer-inherited-match-pattern
                           :partial-products []}))))]
              (if (= (get built :status) :accepted)
                (recur
                 (rest remaining) (get built :next-branch)
                 (get built :next-pattern)
                 (sh07-b51-vector-append
                  branches (get built :branch-records))
                 (sh07-b51-vector-append
                  patterns (get built :pattern-records))
                 (conj
                  skeletons
                  {:core-node-id (get record :node-id)
                   :scrutinee-core-node-id (first children)
                   :branch-core-node-ids (vec (rest children))
                   :selection-policy
                   :source-ordered-pattern-candidates
                   :runtime-reachability :not-asserted-by-sh07-b11
                   :result-type-join :pending-sh08
                   :exhaustiveness :pending-sh08
                   :authenticated-sh06-artifact-id
                   (get attributes :authenticated-sh06-artifact-id)
                   :sh06-semantic-projection-id
                   (get attributes :sh06-semantic-projection-id)}))
                built))
            (recur
             (rest remaining) branch-ordinal pattern-ordinal
             branches patterns skeletons)))))))

(defn sh07-b51-producer-fragment-root-nodes
  [indexes records root-form-ids]
  (loop [remaining root-form-ids result []]
    (if (= (count remaining) 0)
      {:status :accepted :root-node-ids result}
      (let [form (sh07-b51-find-form indexes (first remaining))]
        (if (map? form)
          (if (sh07-b51-authenticated-list-operator? indexes form 'ns)
            (recur (rest remaining) result)
            (let [selected
                  (sh07-b51-producer-v18-node-by-form-id
                   records (get form :form-id))]
              (if (= (get selected :status) :accepted)
                (recur
                 (rest remaining)
                 (conj result (get (get selected :record) :node-id)))
                selected)))
          {:status :rejected :reason :producer-inherited-root-form
           :partial-products []})))))

(defn sh07-b51-producer-inherited-fragments [request records]
  (let [indexes (sh07-b51-index-request request)]
    (loop [remaining (get request :fragment-manifest)
           fragments [] roots []]
      (if (= (count remaining) 0)
        {:status :accepted :fragment-manifest fragments
         :root-core-node-ids roots}
        (let [fragment (first remaining)
              selected
              (sh07-b51-producer-fragment-root-nodes
               indexes records (get fragment :root-form-ids))]
          (if (= (get selected :status) :accepted)
            (let [root-node-ids (get selected :root-node-ids)]
              (recur
               (rest remaining)
               (conj fragments (assoc fragment :root-node-ids root-node-ids))
               (sh07-b51-vector-append roots root-node-ids)))
            selected))))))

(defn sh07-b51-producer-inherited-foundation-products
  [request two-pass ordinary-bundle]
  (let [records (get ordinary-bundle :records)
        fragments
        (sh07-b51-producer-inherited-fragments request records)
        definitions
        (sh07-b51-producer-inherited-definitions records)
        owner-bindings
        (sh07-b51-producer-inherited-owner-bindings two-pass)
        calls (sh07-b51-producer-inherited-calls records)
        reference-uses
        (sh07-b51-producer-inherited-reference-uses records)
        error-transfers
        (sh07-b51-producer-inherited-error-transfers records)
        error-handlers
        (sh07-b51-producer-inherited-error-handlers
         request records reference-uses error-transfers)
        match-products
        (sh07-b51-producer-inherited-match-products
         request records reference-uses)
        functions
        (if (= (get definitions :status) :accepted)
          (sh07-b51-producer-inherited-functions
           records (get definitions :records)) [])
        call-edges
        (if (= (get definitions :status) :accepted)
          (sh07-b51-producer-inherited-call-edges
           request records (get definitions :records) calls functions) [])
        recursion-components
        (sh07-b51-producer-inherited-recursion-components
         functions call-edges)]
    (if (= (get fragments :status) :accepted)
      (if (= (get definitions :status) :accepted)
        (if (= (get owner-bindings :status) :accepted)
        (if (= (get match-products :status) :accepted)
        {:status :accepted
         :products
         {:fragment-manifest (get fragments :fragment-manifest)
          :fragment-coverage (get request :fragment-coverage)
          :module-assembly-manifest
          (get request :module-assembly-manifest)
          :root-core-node-ids (get fragments :root-core-node-ids)
          :definitions (get definitions :records)
          :nodes records
          :evaluation-order
          (sh07-b51-producer-inherited-evaluation-order records)
          :control-flow
          (sh07-b51-producer-inherited-control-flow records)
          :reference-uses
          reference-uses
          :var-references
          (sh07-b51-producer-inherited-var-references records)
          :mutations (sh07-b51-producer-inherited-mutations records)
          :error-transfers
          error-transfers
          :error-handlers error-handlers
          :match-branch-records
          (get match-products :match-branch-records)
          :match-decision-skeletons
          (get match-products :match-decision-skeletons)
          :match-pattern-records
          (get match-products :match-pattern-records)
          :calls calls
          :function-records functions
          :call-edges call-edges
          :recursion-components recursion-components
          :keyword-lookups
          (sh07-b51-producer-inherited-keyword-lookups records)
          :lexical-bindings (get owner-bindings :lexical-bindings)
          :loop-bindings (get owner-bindings :loop-bindings)
          :recur-targets (get ordinary-bundle :recur-targets)
          :recur-transfers (get ordinary-bundle :recur-transfers)
          :source-map (sh07-b51-producer-inherited-source-map records)
          :binding-table (get request :binding-table)
          :declared-alias-table (get request :alias-table)
          :resolution-table (get request :resolution-table)
          :macro-expansion-trace (get request :macro-expansion-trace)
          :macro-origin-traces (get request :macro-origin-traces)
          :macro-origin-expectation
          (get request :macro-origin-expectation)
          :pending-fact-families [:types :effects :ownership :safety]}
         :partial-products []}
        match-products)
        owner-bindings)
        definitions)
      fragments)))

(defn sh07-b51-producer-find-slot-plan [foundation slot-ordinal]
  (loop [remaining (get foundation :slot-plans)
         found nil found-count 0]
    (if (= (count remaining) 0)
      (if (= found-count 1)
        {:status :accepted :slot-plan found}
        {:status :rejected :reason :producer-product-slot-join
         :partial-products []})
      (if (= (get (first remaining) :slot-ordinal) slot-ordinal)
        (recur (rest remaining) (first remaining) (+ found-count 1))
        (recur (rest remaining) found found-count)))))

(defn sh07-b51-producer-find-extraction-position
  [slot-plan pattern-node-ordinal]
  (loop [remaining (get slot-plan :binding-extraction-preimages)
         index 0 found nil found-count 0]
    (if (= (count remaining) 0)
      (if (= found-count 1)
        {:status :accepted :index found
         :preimage
         (get (get slot-plan :binding-extraction-preimages) found)
         :reference (get (get slot-plan :extraction-ids) found)}
        {:status :rejected :reason :producer-product-extraction-join
         :partial-products []})
      (if (= (get (first remaining) :pattern-node-ordinal)
             pattern-node-ordinal)
        (recur (rest remaining) (+ index 1) index (+ found-count 1))
        (recur (rest remaining) (+ index 1) found found-count)))))

(defn sh07-b51-producer-find-recur-site-and-layout
  [owner-entry recur-form-id]
  (loop [remaining-sites (get owner-entry :loop-recur-sites)
         remaining-layouts (get owner-entry :recur-layout-entries)
         found-site nil found-layout nil found-count 0]
    (if (= (count remaining-sites) 0)
      (if (= (count remaining-layouts) 0)
        (if (= found-count 1)
          {:status :accepted :recur-site found-site :layout found-layout}
          {:status :rejected :reason :producer-product-recur-join
           :partial-products []})
        {:status :rejected :reason :producer-product-recur-cardinality
         :partial-products []})
      (if (= (count remaining-layouts) 0)
        {:status :rejected :reason :producer-product-recur-cardinality
         :partial-products []}
        (if (= (get (get (first remaining-sites) :recur-coordinate)
                    :recur-form-id)
               recur-form-id)
          (if (= (get (first remaining-layouts) :recur-form-id)
                 recur-form-id)
            (recur
             (rest remaining-sites) (rest remaining-layouts)
             (first remaining-sites) (get (first remaining-layouts) :layout)
             (+ found-count 1))
            {:status :rejected :reason :producer-product-recur-layout-order
             :partial-products []})
          (recur
           (rest remaining-sites) (rest remaining-layouts)
           found-site found-layout found-count))))))

(defn sh07-b51-producer-product-common-record
  [row foundation owner-core-node-id slot-coordinate recur-coordinate]
  (let [owner (get foundation :owner-coordinate)]
    {:schema :gravity/sh07-b51-product-node-v18
     :node-id (get row :reference)
     :global-product-ordinal (get row :global-ordinal)
     :product-kind (get (get row :spec) :product-kind)
     :predecessor-authority-id
     (get (get row :preimage) :predecessor-authority-id)
     :fragment-id (get owner :fragment-id)
     :fragment-ordinal (get owner :fragment-ordinal)
     :owning-root-form-id (get owner :root-form-id)
     :owning-root-syntax-id (get owner :root-syntax-id)
     :owning-definition-form-id (get owner :owning-definition-form-id)
     :owning-definition-syntax-id (get owner :owning-definition-syntax-id)
     :owner-kind (get foundation :owner-kind)
     :owner-form-id (get owner :enclosing-form-id)
     :owner-syntax-id (get owner :enclosing-syntax-id)
     :owner-core-node-id owner-core-node-id
     :owner-coordinate owner
     :slot-coordinate slot-coordinate
     :recur-coordinate recur-coordinate
     :slot-id nil :extraction-id nil :runtime-check-id nil
     :publication-event-id nil :recur-slot-mapping-id nil
     :loop-form-id nil :loop-syntax-id nil
     :target-loop-form-id nil :target-loop-syntax-id nil
     :argument-node-ids [] :required-check-ids []
     :child-node-ids [] :evaluated-child-node-ids []
     :binding-ids [] :path nil :expected-width nil
     :evaluation-order 0 :commit-policy nil
     :source-origin-chain (get (get row :preimage) :source-origin-chain)
     :source-generated-origin
     (get (get row :preimage) :source-generated-origin)}))

(defn sh07-b51-producer-vector-node-local-index
  [slot-plan pattern-node-ordinal]
  (loop [remaining (get slot-plan :binding-extraction-preimages)
         local-index 0]
    (if (= (count remaining) 0) nil
      (let [extraction (first remaining)]
        (if (= (get extraction :kind) :vector-node)
          (if (= (get extraction :pattern-node-ordinal)
                 pattern-node-ordinal)
            local-index
            (recur (rest remaining) (+ local-index 1)))
          (recur (rest remaining) local-index))))))

(defn sh07-b51-producer-terminal-local-index
  [slot-plan pattern-node-ordinal]
  (loop [remaining (get slot-plan :binding-extraction-preimages)
         local-index 0]
    (if (= (count remaining) 0) nil
      (let [extraction (first remaining)]
        (if (contains? #{:binding-leaf :wildcard-leaf}
                       (get extraction :kind))
          (if (= (get extraction :pattern-node-ordinal)
                 pattern-node-ordinal)
            local-index
            (recur (rest remaining) (+ local-index 1)))
          (recur (rest remaining) local-index))))))

(defn sh07-b51-producer-init-product-record
  [row foundation owner-core-node-id slot-plan]
  (let [spec (get row :spec)
        kind (get spec :product-kind)
        extraction
        (if (contains? #{:vector-check :terminal-projection} kind)
          (sh07-b51-producer-find-extraction-position
           slot-plan (get spec :pattern-preorder-index))
          {:status :accepted})
        common
        (sh07-b51-producer-product-common-record
         row foundation owner-core-node-id
         (get slot-plan :slot-coordinate) nil)
        check-index
        (sh07-b51-producer-vector-node-local-index
         slot-plan (get spec :pattern-preorder-index))
        terminal-index
        (sh07-b51-producer-terminal-local-index
         slot-plan (get spec :pattern-preorder-index))
        check-count (count (get slot-plan :runtime-check-preimages))]
    (if (= (get extraction :status) :accepted)
      (if (= kind :slot-initializer)
        {:status :accepted
         :record
         (assoc
          (assoc
           (assoc common :slot-id (get slot-plan :slot-id))
           :child-node-ids
           [(get (get slot-plan :initializer-evaluation)
                 :initializer-core-node-id)])
          :evaluated-child-node-ids
          [(get (get slot-plan :initializer-evaluation)
                :initializer-core-node-id)])}
        (if (= kind :vector-check)
          (if (integer? check-index)
            {:status :accepted
             :record
             (assoc
              (assoc
               (assoc
                (assoc
                 (assoc
                  (assoc common :slot-id (get slot-plan :slot-id))
                  :extraction-id (get extraction :reference))
                 :runtime-check-id
                 (get (get slot-plan :runtime-check-ids) check-index))
                :path (get (get extraction :preimage) :path))
               :expected-width
               (get (get extraction :preimage) :expected-width))
              :evaluation-order (+ 1 check-index))}
            {:status :rejected :reason :producer-product-check-join
             :partial-products []})
          (if (= kind :terminal-projection)
            (if (integer? terminal-index)
              (let [projection
                    (get (get slot-plan :terminal-projections)
                         terminal-index)]
                {:status :accepted
                 :record
                 (assoc
                  (assoc
                   (assoc
                    (assoc
                     (assoc common :slot-id (get slot-plan :slot-id))
                     :extraction-id (get extraction :reference))
                    :path (get projection :path))
                   :binding-ids (get projection :binding-ids))
                  :evaluation-order (+ 1 check-count terminal-index))})
              {:status :rejected :reason :producer-product-projection-join
               :partial-products []})
            (if (= kind :slot-publication)
              {:status :accepted
               :record
               (assoc
                (assoc
                 (assoc
                  (assoc
                   (assoc common :slot-id (get slot-plan :slot-id))
                   :publication-event-id
                   (get slot-plan :publication-event-id))
                  :binding-ids
                  (get (get slot-plan :publication-event-preimage)
                       :introduced-binding-ids))
                 :commit-policy :simultaneous-after-all-checks)
                :evaluation-order
                (+ 1 check-count
                   (count (get slot-plan :terminal-projections))))}
              {:status :rejected :reason :producer-product-kind
               :partial-products []}))))
      extraction)))

(defn sh07-b51-producer-flatten-vectors [vectors]
  (loop [remaining vectors result []]
    (if (= (count remaining) 0) result
      (recur
       (rest remaining)
       (sh07-b51-vector-append result (first remaining))))))

(defn sh07-b51-producer-recur-product-record
  [row foundation owner-core-node-id recur-site layout]
  (let [spec (get row :spec)
        kind (get spec :product-kind)
        slot-result
        (if (contains? #{:vector-check :terminal-projection} kind)
          (sh07-b51-producer-find-slot-plan
           foundation (get spec :slot-ordinal))
          {:status :accepted})
        slot-plan (get slot-result :slot-plan)
        extraction
        (if (contains? #{:vector-check :terminal-projection} kind)
          (sh07-b51-producer-find-extraction-position
           slot-plan (get spec :pattern-preorder-index))
          {:status :accepted})
        recur-coordinate (get recur-site :recur-coordinate)
        common
        (sh07-b51-producer-product-common-record
         row foundation owner-core-node-id
         (if (map? slot-plan) (get slot-plan :slot-coordinate) nil)
         recur-coordinate)
        mapping (get recur-site :recur-slot-mapping-preimage)
        slot-ordinal (get spec :slot-ordinal)
        check-index
        (if (map? slot-plan)
          (sh07-b51-producer-vector-node-local-index
           slot-plan (get spec :pattern-preorder-index)) nil)
        terminal-index
        (if (map? slot-plan)
          (sh07-b51-producer-terminal-local-index
           slot-plan (get spec :pattern-preorder-index)) nil)
        all-checks
        (sh07-b51-producer-flatten-vectors
         (get layout :runtime-check-id-vectors))
        all-projections
        (sh07-b51-producer-flatten-vectors
         (get recur-site :projection-vectors))
        argument-count (count (get recur-site :argument-evaluations))
        check-count (count all-checks)]
    (if (= (get slot-result :status) :accepted)
      (if (= (get extraction :status) :accepted)
        (if (= kind :vector-check)
          (if (integer? check-index)
            (let [check
                  (get
                   (get (get recur-site :runtime-check-preimage-vectors)
                        slot-ordinal)
                   check-index)]
              {:status :accepted
               :record
               (assoc
                (assoc
                 (assoc
                  (assoc
                   (assoc
                    (assoc common :slot-id (get slot-plan :slot-id))
                    :extraction-id (get extraction :reference))
                   :runtime-check-id
                   (get
                    (get (get layout :runtime-check-id-vectors)
                         slot-ordinal)
                    check-index))
                  :path (get (get extraction :preimage) :path))
                 :expected-width
                 (get (get extraction :preimage) :expected-width))
                :evaluation-order (+ argument-count (get check :check-order)))})
            {:status :rejected :reason :producer-product-check-join
             :partial-products []})
          (if (= kind :terminal-projection)
            (if (integer? terminal-index)
              (let [projection
                    (get
                     (get (get recur-site :projection-vectors)
                          slot-ordinal)
                     terminal-index)
                    projection-reference
                    (get
                     (get (get layout :projection-id-vectors)
                          slot-ordinal)
                     terminal-index)]
                (if (map? projection)
                  (if (= (get projection :projection-id)
                         projection-reference)
                    {:status :accepted
                     :record
                     (assoc
                      (assoc
                       (assoc
                        (assoc
                         (assoc common :slot-id (get slot-plan :slot-id))
                         :extraction-id (get extraction :reference))
                        :path (get projection :path))
                       :binding-ids (get projection :binding-ids))
                      :evaluation-order
                      (+ argument-count check-count
                         (get spec :local-use-index)))}
                    {:status :rejected
                     :reason :producer-product-projection-reference-join
                     :partial-products []})
                  {:status :rejected :reason :producer-product-projection-shape
                   :partial-products []}))
              {:status :rejected :reason :producer-product-projection-join
               :partial-products []})
            (if (= kind :recur-argument)
              (let [argument-index (get spec :local-use-index)
                    evaluation
                    (get (get recur-site :argument-evaluations)
                         argument-index)]
                {:status :accepted
                 :record
                 (assoc
                  (assoc
                   (assoc
                    (assoc
                     (assoc
                      (assoc common
                             :loop-form-id (get mapping :loop-form-id))
                      :loop-syntax-id (get mapping :loop-syntax-id))
                     :target-loop-form-id
                     (get mapping :target-loop-form-id))
                    :target-loop-syntax-id
                    (get mapping :target-loop-syntax-id))
                  :recur-slot-mapping-id
                  (get layout :recur-slot-mapping-id))
                 :argument-node-ids
                  [(get evaluation :argument-node-id)])})
              (if (= kind :recur-commit)
                {:status :accepted
                 :record
                 (assoc
                  (assoc
                   (assoc
                    (assoc
                     (assoc
                      (assoc
                       (assoc
                        (assoc common
                               :loop-form-id (get mapping :loop-form-id))
                        :loop-syntax-id (get mapping :loop-syntax-id))
                       :target-loop-form-id
                       (get mapping :target-loop-form-id))
                      :target-loop-syntax-id
                      (get mapping :target-loop-syntax-id))
                     :publication-event-id
                     (get layout :publication-event-id))
                    :recur-slot-mapping-id
                    (get layout :recur-slot-mapping-id))
                   :commit-policy :simultaneous-after-all-checks)
                  :evaluation-order
                  (+ argument-count check-count (count all-projections)))}
                {:status :rejected :reason :producer-product-kind
                 :partial-products []}))))
        extraction)
      slot-result)))

(defn sh07-b51-producer-product-record-for-row [two-pass row]
  (let [spec (get row :spec)
        selected-owner
        (sh07-b51-v18-find-materialized-owner
         two-pass (get spec :owner-form-id))]
    (if (= (get selected-owner :status) :accepted)
      (let [owner-entry (get selected-owner :owner-entry)
            foundation (get owner-entry :foundation)
            owner-core-node-id
            (get (get owner-entry :initialization-layout)
                 :owner-core-node-id)]
        (if (sh07-b51-internal-reference? owner-core-node-id)
        (if (= (get spec :event-kind) :initializer)
          (let [selected-slot
                (sh07-b51-producer-find-slot-plan
                 foundation (get spec :slot-ordinal))]
            (if (= (get selected-slot :status) :accepted)
              (if (= owner-core-node-id
                     (get
                      (get (get selected-slot :slot-plan)
                           :binding-slot-preimage)
                      :owner-core-node-id))
                (sh07-b51-producer-init-product-record
                 row foundation owner-core-node-id
                 (get selected-slot :slot-plan))
                {:status :rejected :reason :producer-product-owner-core-join
                 :partial-products []})
              selected-slot))
          (if (= (get spec :event-kind) :recur)
            (let [selected-recur
                  (sh07-b51-producer-find-recur-site-and-layout
                   owner-entry (get spec :event-form-id))]
              (if (= (get selected-recur :status) :accepted)
                (if (= owner-core-node-id
                       (get
                        (get (get selected-recur :recur-site)
                             :recur-slot-mapping-preimage)
                        :loop-core-node-id))
                  (sh07-b51-producer-recur-product-record
                   row foundation owner-core-node-id
                   (get selected-recur :recur-site)
                   (get selected-recur :layout))
                  {:status :rejected
                   :reason :producer-product-owner-core-join
                   :partial-products []})
                selected-recur))
            {:status :rejected :reason :producer-product-event
             :partial-products []}))
        {:status :rejected :reason :producer-product-owner-core-reference
         :partial-products []}))
      selected-owner)))


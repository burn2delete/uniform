(defn sh07-b51-verify-resolved-private
  [raw-carrier resolved-core digest-requests resolved-digests]
  (if (sh07-b51-root1-invocation-shape? raw-carrier)
    (if (map? resolved-core)
      (if (vector? digest-requests)
        (if (vector? resolved-digests)
          (let [rebuilt
                (sh07-b51-rebuild-success-template-private raw-carrier)]
            (if (= (get rebuilt :status) :accepted)
                (if (= digest-requests (get rebuilt :digest-requests))
                  (if (sh07-b51-success-digest-replay-exhaustive
                       digest-requests resolved-digests)
                    (let [resolved
                          (sh07-b51-resolve-template-private
                           (get rebuilt :template)
                           digest-requests resolved-digests)]
                      (if (= (get resolved :status) :accepted)
                        (if (= (get resolved :tag) :template-resolved)
                          (if (= resolved-core
                                 (get (get resolved :value) :resolved-core))
                            (sh07-b51-entrypoint-envelope
                             :accepted :resolved-verified
                             (sh07-b51-resolved-verification-passed))
                            (sh07-b51-resolved-verification-boundary
                             :invocation-mismatch))
                          (sh07-b51-resolved-verification-boundary
                           :invocation-mismatch))
                        (sh07-b51-resolved-verification-boundary
                         :invocation-mismatch)))
                    (sh07-b51-resolved-verification-boundary
                     :digest-mismatch))
                  (sh07-b51-resolved-verification-boundary
                   :invocation-mismatch))
              (sh07-b51-resolved-verification-boundary
               :invocation-mismatch)))
          (sh07-b51-resolved-verification-boundary :malformed-invocation))
        (sh07-b51-resolved-verification-boundary :malformed-invocation))
      (sh07-b51-resolved-verification-boundary :malformed-invocation))
    (sh07-b51-resolved-verification-boundary :malformed-invocation)))


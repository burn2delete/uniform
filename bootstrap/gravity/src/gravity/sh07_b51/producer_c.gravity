(defn sh07-b51-success-plan-exact? [requests]
  (let [replay (sh07-b51-success-request-plan-replay requests)
        outcome-kind (sh07-b51-success-outcome-kind requests)]
    (if (= (get replay :status) :accepted)
      (if (sh07-b51-dependency-catalog-exact?)
        (if (sh07-b51-success-plan-exact-cardinality? requests)
          (loop [remaining requests]
            (if (= (count remaining) 0)
              (if (sh07-b51-reference-registry-static-census?
                   outcome-kind)
                (if (sh07-b51-success-plan-reference-dag-valid?
                     requests outcome-kind)
                  {:status :accepted
                   :request-count (count requests)
                   :core-node-count (get replay :core-node-count)
                   :schedule-exact true :cardinality-exact true
                   :branch-exact true :dependency-edge-count 58
                   :reference-registry-exact true
                   :reference-path-census
                   (sh07-b51-reference-registry-generated-count
                    outcome-kind)}
                  {:status :rejected :reason :malformed-request-plan})
                {:status :rejected :reason :malformed-request-plan})
              (let [request (first remaining)]
                (if (sh07-b51-success-request-exact-shape? request)
                  (if (sh07-b51-purpose-branch-allows?
                       (get request :purpose) outcome-kind)
                    (recur (rest remaining))
                    {:status :rejected :reason :cardinality-mismatch})
                  {:status :rejected :reason :malformed-request-plan}))))
          {:status :rejected :reason :cardinality-mismatch})
        {:status :rejected :reason :malformed-request-plan})
      replay)))


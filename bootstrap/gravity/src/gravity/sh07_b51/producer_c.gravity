(defn sh07-b51-diagnostic-kind-reason? [kind reason]
  (if (= kind :core-shape)
    (contains?
     #{:invalid-owning-core-shape :invalid-defn-trace-shape} reason)
    (if (= kind :lowering-gap)
      (contains?
       #{:unsupported-vector-rest :unsupported-nested-pattern} reason)
      (if (= kind :duplicate-binding)
        (= reason :duplicate-vector-binding-name)
        (if (= kind :pattern-type)
          (= reason :malformed-authenticated-pattern-shape)
          (if (= kind :evaluation-order)
            (contains?
             #{:initializer-order-mismatch :check-order-mismatch
               :publication-order-mismatch}
             reason)
            (if (= kind :origin)
              (contains?
               #{:missing-origin :ambiguous-origin :origin-mismatch}
               reason)
              (if (= kind :recur-target)
                (contains?
                 #{:missing-recur-target :ambiguous-recur-target
                   :recur-arity-mismatch :recur-not-tail}
                 reason)
                (if (= kind :effect-drop)
                  (contains?
                   #{:effect-omitted :effect-reordered :effect-weakened}
                   reason)
                  (if (= kind :unsafe-drop)
                    (contains?
                     #{:safety-weakened :capability-omitted
                       :unsafe-island-omitted}
                     reason)
                    (if (= kind :verify)
                      (contains?
                       #{:raw-carrier-shape :authentication-membership
                         :branch-mismatch :digest-protocol :schema-shape
                         :fragment-membership :owner-selection
                         :module-slot-limit-exceeded
                         :module-binding-leaf-limit-exceeded}
                       reason)
                      false)))))))))))

(defn sh07-b51-diagnostic-related-shape? [values expected-count]
  (if (sh07-b51-all-sha256? values)
    (= (count values) expected-count)
    false))

(defn sh07-b51-diagnostic-unsafe-value-shape? [value allow-nil]
  (if (contains? #{:safe :unsafe-island} value)
    true
    (if (sh07-b51-keyword-vector? value)
      true
      (if allow-nil (= value nil) false))))

(defn sh07-b51-diagnostic-catalog-values-shape?
  [kind reason expected observed related]
  (if (= kind :core-shape)
    (if (= expected :authenticated-owning-core-shape)
      (if (contains? #{:let :loop :def :fn :other} observed)
        (sh07-b51-diagnostic-related-shape? related 0) false)
      false)
    (if (= kind :lowering-gap)
      (if (= expected :legacy-symbol-or-fixed-vector-pattern)
        (if (contains? #{:rest-marker :unsupported-form} observed)
          (sh07-b51-diagnostic-related-shape? related 0) false)
        false)
      (if (= kind :duplicate-binding)
        (if (= expected :unique-vector-leaf-name)
          (if (symbol? observed)
            (sh07-b51-diagnostic-related-shape? related 2) false)
          false)
        (if (= kind :pattern-type)
          (if (= expected :authenticated-fixed-vector-pattern)
            (if (= observed :malformed-pattern)
              (sh07-b51-diagnostic-related-shape? related 0) false)
            false)
          (if (= kind :evaluation-order)
            (if (sh07-b51-nonnegative-integer? expected)
              (if (sh07-b51-nonnegative-integer? observed)
                (sh07-b51-diagnostic-related-shape? related 2) false)
              false)
            (if (= kind :origin)
              (if (= expected :one-authenticated-origin-chain)
                (if (contains? #{:missing :multiple :mismatched} observed)
                  (sh07-b51-diagnostic-related-shape? related 0) false)
                false)
              (if (= kind :recur-target)
                (if (= reason :recur-arity-mismatch)
                  (if (sh07-b51-nonnegative-integer? expected)
                    (if (sh07-b51-nonnegative-integer? observed)
                      (sh07-b51-diagnostic-related-shape? related 1)
                      false)
                    false)
                  (if (= expected
                         :nearest-compatible-function-or-loop-target)
                    (if (= reason :missing-recur-target)
                      (if (= observed :missing)
                        (sh07-b51-diagnostic-related-shape? related 1)
                        false)
                      (if (= reason :ambiguous-recur-target)
                        (if (= observed :multiple)
                          (sh07-b51-diagnostic-related-shape? related 1)
                          false)
                        (if (= observed :non-tail)
                          (sh07-b51-diagnostic-related-shape? related 1)
                          false)))
                    false))
                (if (= kind :effect-drop)
                  (if (sh07-b51-keyword-vector? expected)
                    (if (sh07-b51-keyword-vector? observed)
                      (sh07-b51-diagnostic-related-shape? related 1)
                      false)
                    false)
                  (if (= kind :unsafe-drop)
                    (if (sh07-b51-diagnostic-unsafe-value-shape?
                         expected false)
                      (if (sh07-b51-diagnostic-unsafe-value-shape?
                           observed true)
                        (sh07-b51-diagnostic-related-shape? related 1)
                        false)
                      false)
                    (if (= kind :verify)
                      (if (= reason :module-slot-limit-exceeded)
                        (if (= expected
                               {:unit :module-slots :maximum 1024})
                          (if (= observed
                                 {:unit :module-slots
                                  :saturating-count 1025})
                            (sh07-b51-diagnostic-related-shape? related 1)
                            false)
                          false)
                        (if (= reason
                               :module-binding-leaf-limit-exceeded)
                          (if (= expected
                                 {:unit :module-binding-leaves
                                  :maximum 2048})
                            (if (= observed
                                   {:unit :module-binding-leaves
                                    :saturating-count 2049})
                              (sh07-b51-diagnostic-related-shape? related 1)
                              false)
                            false)
                          (if (= expected :authenticated-closed-value)
                            (if (contains?
                                 #{:missing :duplicate :mismatched
                                   :malformed}
                                 observed)
                              (sh07-b51-diagnostic-related-shape? related 0)
                              false)
                            false)))
                      false)))))))))))

(defn sh07-b51-diagnostic-coordinate-shape? [semantic]
  (let [form-id (get semantic :form-id)
        recur-form-id (get semantic :recur-form-id)
        recur-syntax-id (get semantic :recur-syntax-id)
        path (get semantic :path)]
    (if (= form-id nil)
      (if (= (get semantic :form-ordinal) nil)
        (if (= (get semantic :fragment-ordinal) nil)
          (if (= (get semantic :syntax-id) nil)
            (if (= (get semantic :source-span) nil)
              (if (= (get semantic :generated-origin-chain) [])
                (if (= (get semantic :core-node-id) nil)
                  (if (= (get semantic :owner-coordinate) nil)
                    (if (= (get semantic :slot-id) nil)
                      (if (= (get semantic :extraction-id) nil)
                        (if (= recur-form-id nil)
                          (if (= recur-syntax-id nil)
                            (= path nil) false)
                          false)
                        false)
                      false)
                    false)
                  false)
                false)
              false)
            false)
          false)
        false)
      (if (sh07-b51-sha256-id? form-id)
        (if (sh07-b51-nonnegative-integer?
             (get semantic :form-ordinal))
          (if (sh07-b51-optional-nonnegative-integer?
               (get semantic :fragment-ordinal))
            (if (sh07-b51-sha256-id? (get semantic :syntax-id))
              (if (sh07-b51-semantic-span-shape?
                   (get semantic :source-span))
                (if (sh07-b51-origin-vector?
                     (get semantic :generated-origin-chain))
                  (if (sh07-b51-optional-sha256?
                       (get semantic :core-node-id))
                    (if (if (= (get semantic :owner-coordinate) nil)
                          true
                          (sh07-b51-owner-coordinate-shape?
                           (get semantic :owner-coordinate)))
                      (if (sh07-b51-optional-sha256?
                           (get semantic :slot-id))
                        (if (sh07-b51-optional-sha256?
                             (get semantic :extraction-id))
                          (if (if (= recur-form-id nil)
                                (= recur-syntax-id nil)
                                (if (sh07-b51-sha256-id? recur-form-id)
                                  (sh07-b51-sha256-id? recur-syntax-id)
                                  false))
                            (if (= path nil)
                              true (sh07-b51-nonnegative-path? path))
                            false)
                          false)
                        false)
                      false)
                    false)
                  false)
                false)
              false)
            false)
          false)
        false))))

(defn sh07-b51-diagnostic-semantic-shape? [semantic]
  (if (sh07-b51-exact-keys?
       semantic
       #{:artifact :schema-version :status :diagnostic-kind :rule
         :severity :stage :reason :form-id :form-ordinal
         :fragment-ordinal :syntax-id :source-span :generated-origin-chain
         :core-node-id :owner-coordinate :slot-id :extraction-id
         :recur-form-id :recur-syntax-id :path :expected :observed
         :related-semantic-ids :lowering-rule :profile :target
         :remediation :fail-closed})
    (let [coordinate
          {:form-id (get semantic :form-id)
           :form-ordinal (get semantic :form-ordinal)
           :fragment-ordinal (get semantic :fragment-ordinal)
           :syntax-id (get semantic :syntax-id)
           :source-span (get semantic :source-span)
           :generated-origin-chain (get semantic :generated-origin-chain)
           :core-node-id (get semantic :core-node-id)
           :owner-coordinate (get semantic :owner-coordinate)
           :slot-id (get semantic :slot-id)
           :extraction-id (get semantic :extraction-id)
           :recur-form-id (get semantic :recur-form-id)
           :recur-syntax-id (get semantic :recur-syntax-id)
           :path (get semantic :path)}]
      (if (sh07-b51-diagnostic-kind-reason?
           (get semantic :diagnostic-kind) (get semantic :reason))
        (if (sh07-b51-diagnostic-catalog-values-shape?
             (get semantic :diagnostic-kind) (get semantic :reason)
             (get semantic :expected) (get semantic :observed)
             (get semantic :related-semantic-ids))
          (if (sh07-b51-diagnostic-coordinate-shape? semantic)
            (= semantic
               (sh07-b51-diagnostic-semantic
                (get semantic :diagnostic-kind) (get semantic :reason)
                coordinate (get semantic :expected) (get semantic :observed)
                (get semantic :related-semantic-ids)))
            false)
          false)
        false))
    false))

(defn sh07-b51-failure-digest-request-shape? [request]
  (if (sh07-b51-exact-keys? request #{:purpose :preimage})
    (if (= (get request :purpose) :sh07-b51-c6-diagnostic-id)
      (let [preimage (get request :preimage)]
        (if (sh07-b51-exact-keys?
             preimage
             #{:domain :schema-version :diagnostic-semantic-value})
          (if (= (get preimage :domain)
                 :gravity/sh07-b51-c6-diagnostic-id-preimage-v18)
            (if (= (get preimage :schema-version) 18)
              (sh07-b51-diagnostic-semantic-shape?
               (get preimage :diagnostic-semantic-value))
              false)
            false)
          false))
      false)
    false))

(defn sh07-b51-pending-rejected-envelope-shape? [envelope]
  (if (sh07-b51-exact-keys?
       envelope #{:artifact :schema-version :pending-result})
    (if (= (get envelope :artifact)
           :gravity/sh07-b51-rejected-envelope-v18)
      (if (= (get envelope :schema-version) 18)
        (let [result (get envelope :pending-result)]
          (if (sh07-b51-exact-keys?
               result
               #{:artifact :schema-version :status
                 :diagnostic-semantic-value :diagnostic-id-request})
            (if (= (get result :artifact)
                   :gravity/sh07-b51-rejected-result-v18)
              (if (= (get result :schema-version) 18)
                (if (= (get result :status) :rejected)
                  (let [semantic
                        (get result :diagnostic-semantic-value)
                        request (get result :diagnostic-id-request)]
                    (if (sh07-b51-diagnostic-semantic-shape? semantic)
                      (if (sh07-b51-failure-digest-request-shape? request)
                        (= semantic
                           (get (get request :preimage)
                                :diagnostic-semantic-value))
                        false)
                      false))
                  false)
                false)
              false)
            false))
        false)
      false)
    false))

(defn sh07-b51-success-purpose-preimage-shape? [purpose preimage]
  (if (= purpose :sh07-b51-implementation-semantic-id)
    (sh07-b51-generic-implementation-preimage-shape? preimage)
    (if (= purpose :sh07-b51-contract-semantic-id)
      (sh07-b51-generic-contract-preimage-shape? preimage)
      (if (= purpose :sh07-b51-same-request-semantic-id)
        (sh07-b51-generic-same-request-preimage-shape? preimage)
        (if (= purpose :sh07-b51-v16-verification-semantic-id)
          (sh07-b51-v16-verification-preimage-shape? preimage)
          (if (= purpose :sh07-b51-predecessor-outcome-semantic-id)
            (sh07-b51-success-outcome-preimage-shape? preimage)
            (if (= purpose :sh07-b51-predecessor-authority-id)
              (sh07-b51-predecessor-authority-preimage-shape? preimage)
              (if (contains?
                   #{:sh07-b51-core-node-id :sh07-b51-product-node-id
                     :sh07-b51-binding-slot-id
                     :sh07-b51-binding-extraction-id
                     :sh07-b51-runtime-check-id
                     :sh07-b51-publication-event-id
                     :sh07-b51-recur-slot-mapping-id
                     :sh07-b51-slot-extraction-transcript-id}
                   purpose)
                (sh07-b51-foundation-purpose-preimage-shape?
                 purpose preimage)
                (if (= purpose :sh07-b51-core-identity-id)
                  (sh07-b51-core-identity-preimage-shape? preimage)
                  (if (= purpose :sh07-b51-predecessor-observation-id)
                    (sh07-b51-observation-preimage-shape? preimage)
                    (if (= purpose :sh07-b51-provenance-binding-id)
                      (sh07-b51-provenance-preimage-shape? preimage)
                      (if (= purpose
                             :sh07-b51-independent-verifier-binding-id)
                        (sh07-b51-verifier-preimage-shape? preimage)
                        (if (= purpose
                               :sh07-b51-final-artifact-binding-id)
                          (sh07-b51-final-binding-preimage-shape? preimage)
                          false)))))))))))))

(defn sh07-b51-purpose-dependencies [purpose]
  (if (= purpose :sh07-b51-implementation-semantic-id) []
    (if (= purpose :sh07-b51-contract-semantic-id) []
      (if (= purpose :sh07-b51-same-request-semantic-id) []
        (if (= purpose :sh07-b51-v16-verification-semantic-id) []
          (if (= purpose :sh07-b51-predecessor-outcome-semantic-id)
            [:sh07-b51-implementation-semantic-id
             :sh07-b51-contract-semantic-id
             :sh07-b51-same-request-semantic-id
             :sh07-b51-v16-verification-semantic-id]
            (if (= purpose :sh07-b51-predecessor-authority-id)
              [:sh07-b51-implementation-semantic-id
               :sh07-b51-contract-semantic-id
               :sh07-b51-same-request-semantic-id
               :sh07-b51-predecessor-outcome-semantic-id]
              (if (= purpose :sh07-b51-core-node-id)
                [:sh07-b51-predecessor-authority-id
                 :sh07-b51-core-node-id]
                (if (= purpose :sh07-b51-product-node-id)
                  [:sh07-b51-predecessor-authority-id]
                  (if (= purpose :sh07-b51-binding-slot-id)
                    [:sh07-b51-predecessor-authority-id
                     :sh07-b51-core-node-id]
                    (if (= purpose :sh07-b51-binding-extraction-id)
                      [:sh07-b51-predecessor-authority-id
                       :sh07-b51-binding-slot-id]
                      (if (= purpose :sh07-b51-runtime-check-id)
                        [:sh07-b51-predecessor-authority-id
                         :sh07-b51-core-node-id
                         :sh07-b51-binding-slot-id
                         :sh07-b51-binding-extraction-id]
                        (if (= purpose :sh07-b51-publication-event-id)
                          [:sh07-b51-predecessor-authority-id
                           :sh07-b51-core-node-id
                           :sh07-b51-product-node-id
                           :sh07-b51-binding-slot-id
                           :sh07-b51-runtime-check-id]
                          (if (= purpose :sh07-b51-recur-slot-mapping-id)
                            [:sh07-b51-predecessor-authority-id
                             :sh07-b51-core-node-id
                             :sh07-b51-product-node-id
                             :sh07-b51-binding-slot-id
                             :sh07-b51-binding-extraction-id
                             :sh07-b51-runtime-check-id
                             :sh07-b51-publication-event-id]
                            (if (= purpose
                              :sh07-b51-slot-extraction-transcript-id)
                              [:sh07-b51-predecessor-authority-id
                               :sh07-b51-same-request-semantic-id
                               :sh07-b51-binding-slot-id
                               :sh07-b51-binding-extraction-id
                               :sh07-b51-runtime-check-id
                               :sh07-b51-publication-event-id
                               :sh07-b51-recur-slot-mapping-id]
                              (if (= purpose :sh07-b51-core-identity-id)
                                [:sh07-b51-same-request-semantic-id
                                 {:accepted-only
                                  :sh07-b51-v16-verification-semantic-id}
                                 {:accepted-only
                                  :sh07-b51-predecessor-outcome-semantic-id}
                                 :sh07-b51-predecessor-authority-id
                                 {:non-v16-only
                                  :sh07-b51-core-node-id}
                                 :sh07-b51-product-node-id
                                 :sh07-b51-binding-slot-id
                                 :sh07-b51-binding-extraction-id
                                 :sh07-b51-runtime-check-id
                                 :sh07-b51-publication-event-id
                                 :sh07-b51-recur-slot-mapping-id
                                 :sh07-b51-slot-extraction-transcript-id]
                                (if (= purpose
                                       :sh07-b51-predecessor-observation-id)
                                  [:sh07-b51-core-identity-id]
                                  (if (= purpose
                                         :sh07-b51-provenance-binding-id)
                                    [:sh07-b51-core-identity-id
                                     :sh07-b51-predecessor-observation-id]
                                    (if (= purpose
                                           :sh07-b51-independent-verifier-binding-id)
                                      [:sh07-b51-core-identity-id
                                       :sh07-b51-provenance-binding-id]
                                      (if (= purpose
                                             :sh07-b51-final-artifact-binding-id)
                                        [:sh07-b51-core-identity-id
                                         :sh07-b51-provenance-binding-id
                                         :sh07-b51-independent-verifier-binding-id]
                                        nil))))))))))))))))))))

(defn sh07-b51-dependency-entry-target [entry]
  (if (keyword? entry)
    entry
    (if (sh07-b51-exact-keys? entry #{:accepted-only})
      (get entry :accepted-only)
      (if (sh07-b51-exact-keys? entry #{:non-v16-only})
        (get entry :non-v16-only)
        nil))))

(defn sh07-b51-dependency-entry-active? [entry outcome-kind]
  (if (contains?
       #{:legacy-v16-accepted :b51-vector-frontier-rejected
         :legacy-v16-accepted-after-no-form-waiver
         :b51-vector-frontier-rejected-after-no-form-waiver}
       outcome-kind)
    (if (keyword? entry)
      true
      (if (sh07-b51-exact-keys? entry #{:accepted-only})
        (= outcome-kind :legacy-v16-accepted)
        (if (sh07-b51-exact-keys? entry #{:non-v16-only})
          (contains?
           #{:b51-vector-frontier-rejected
             :legacy-v16-accepted-after-no-form-waiver
             :b51-vector-frontier-rejected-after-no-form-waiver}
           outcome-kind)
          false)))
    false))

(defn sh07-b51-purpose-dependency-active?
  [source-purpose target-purpose outcome-kind]
  (let [dependencies (sh07-b51-purpose-dependencies source-purpose)]
    (if (vector? dependencies)
      (loop [remaining dependencies match-count 0 active false]
        (if (= (count remaining) 0)
          (if (= match-count 1) active false)
          (let [entry (first remaining)]
            (if (= (sh07-b51-dependency-entry-target entry)
                   target-purpose)
              (recur
               (rest remaining) (+ match-count 1)
               (sh07-b51-dependency-entry-active? entry outcome-kind))
              (recur (rest remaining) match-count active)))))
      false)))

(defn sh07-b51-dependency-catalog-edge-count []
  (loop [remaining
         [:sh07-b51-implementation-semantic-id
          :sh07-b51-contract-semantic-id
          :sh07-b51-same-request-semantic-id
          :sh07-b51-v16-verification-semantic-id
          :sh07-b51-predecessor-outcome-semantic-id
          :sh07-b51-predecessor-authority-id
          :sh07-b51-core-node-id :sh07-b51-product-node-id
          :sh07-b51-binding-slot-id :sh07-b51-binding-extraction-id
          :sh07-b51-runtime-check-id :sh07-b51-publication-event-id
          :sh07-b51-recur-slot-mapping-id
          :sh07-b51-slot-extraction-transcript-id
          :sh07-b51-core-identity-id
          :sh07-b51-predecessor-observation-id
          :sh07-b51-provenance-binding-id
          :sh07-b51-independent-verifier-binding-id
          :sh07-b51-final-artifact-binding-id]
         count-value 0]
    (if (= (count remaining) 0)
      count-value
      (recur
       (rest remaining)
       (+ count-value
          (count (sh07-b51-purpose-dependencies (first remaining))))))))

(defn sh07-b51-collect-internal-references [value]
  (if (sh07-b51-internal-reference? value)
    [value]
    (if (map? value)
      (loop [remaining (vec value) result []]
        (if (= (count remaining) 0)
          result
          (recur
           (rest remaining)
           (sh07-b51-vector-append
            result
            (sh07-b51-collect-internal-references
             (second (first remaining)))))))
      (if (vector? value)
        (loop [remaining value result []]
          (if (= (count remaining) 0)
            result
            (recur
             (rest remaining)
             (sh07-b51-vector-append
              result
              (sh07-b51-collect-internal-references
               (first remaining))))))
        (if (set? value)
          (loop [remaining value result []]
            (if (= (count remaining) 0)
              result
              (recur
               (rest remaining)
               (sh07-b51-vector-append
                result
                (sh07-b51-collect-internal-references
                 (first remaining))))))
          (if (seq? value)
            (loop [remaining value result []]
              (if (= (count remaining) 0)
                result
                (recur
                 (rest remaining)
                 (sh07-b51-vector-append
                  result
                  (sh07-b51-collect-internal-references
                   (first remaining))))))
            []))))))

(defn sh07-b51-reference-path-step [states token]
  (if (= token :each)
    (loop [remaining states result []]
      (if (= (count remaining) 0)
        {:status :accepted :states result}
        (let [value (get (first remaining) :value)]
          (if (vector? value)
            (recur
             (rest remaining)
             (loop [items value expanded result]
               (if (= (count items) 0)
                 expanded
                 (recur
                  (rest items)
                  (conj expanded
                        {:value (first items) :parent value})))))
            {:status :rejected :reason :path-vector-required}))))
    (if (= token :optional)
      (loop [remaining states result []]
        (if (= (count remaining) 0)
          {:status :accepted :states result}
          (let [state (first remaining)]
            (recur
             (rest remaining)
             (if (= (get state :value) nil)
               result
               (conj result state))))))
      (if (contains? #{:if-kind :do-kind :target-kind=:loop} token)
        (let [required-kind
              (if (= token :if-kind) :if
                (if (= token :do-kind) :do :loop))]
          (loop [remaining states result []]
            (if (= (count remaining) 0)
              {:status :accepted :states result}
              (let [state (first remaining)
                    parent (get state :parent)]
                (if (map? parent)
                  (recur
                   (rest remaining)
                   (if (= (if (= token :target-kind=:loop)
                            (get parent :target-kind)
                            (get parent :kind))
                          required-kind)
                     (conj result state) result))
                  {:status :rejected :reason :path-kind-parent})))))
        (loop [remaining states result []]
          (if (= (count remaining) 0)
            {:status :accepted :states result}
            (let [state (first remaining)
                  value (get state :value)]
              (if (map? value)
                (if (contains? value token)
                  (recur
                   (rest remaining)
                   (conj result
                         {:value (get value token) :parent value}))
                  {:status :rejected :reason :path-key-missing})
                {:status :rejected :reason :path-map-required}))))))))

(defn sh07-b51-reference-path-values [preimage path]
  (if (vector? path)
    (loop [remaining path
           step-result {:status :accepted
                        :states [{:value preimage :parent nil}]}]
      (if (= (get step-result :status) :accepted)
        (if (= (count remaining) 0)
          {:status :accepted
           :values
           (loop [states (get step-result :states) result []]
             (if (= (count states) 0)
               result
               (recur
                (rest states)
                (conj result (get (first states) :value)))))}
          (let [token (first remaining)
                next-token
                (if (> (count remaining) 1)
                  (first (rest remaining)) nil)]
            (if (if (= next-token :target-kind=:loop)
                  true
                  (contains? #{:if-kind :do-kind} next-token))
              (let [required-kind
                    (if (= next-token :if-kind) :if
                      (if (= next-token :do-kind) :do :loop))
                    filtered
                    (loop [states (get step-result :states) result []]
                      (if (= (count states) 0)
                        result
                        (let [state (first states)
                              value (get state :value)]
                          (if (map? value)
                            (recur
                             (rest states)
                             (if (= (if (= next-token :target-kind=:loop)
                                      (get value :target-kind)
                                      (get value :kind))
                                    required-kind)
                               (conj result state) result))
                            (recur (rest states) result)))))]
                (recur
                 (rest (rest remaining))
                 (sh07-b51-reference-path-step filtered token)))
              (recur
               (rest remaining)
               (sh07-b51-reference-path-step
                (get step-result :states) token)))))
        step-result))
    {:status :rejected :reason :path-not-vector}))

(defn sh07-b51-reference-descriptor [path target representation]
  {:path path :target-purpose target :representation representation})

(defn sh07-b51-descriptor-vector [paths target representation]
  (loop [remaining paths result []]
    (if (= (count remaining) 0)
      result
      (recur
       (rest remaining)
       (conj result
             (sh07-b51-reference-descriptor
              (first remaining) target representation))))))

(defn sh07-b51-outcome-preimage-reference-descriptors [outcome-kind]
  (sh07-b51-descriptor-vector
   (if (= outcome-kind :legacy-v16-accepted)
     [[:implementation-semantic-id] [:contract-semantic-id]
      [:same-request-semantic-id] [:v16-verification-semantic-id]]
     [[:implementation-semantic-id] [:contract-semantic-id]
      [:same-request-semantic-id]])
   nil :generated))

(defn sh07-b51-purpose-nontier3-reference-descriptors
  [purpose outcome-kind]
  (let [legacy? (= outcome-kind :legacy-v16-accepted)]
    (if (contains?
         #{:sh07-b51-implementation-semantic-id
           :sh07-b51-contract-semantic-id
           :sh07-b51-same-request-semantic-id
           :sh07-b51-v16-verification-semantic-id}
         purpose)
      []
      (if (= purpose :sh07-b51-predecessor-outcome-semantic-id)
        [(sh07-b51-reference-descriptor
          [:implementation-semantic-id]
          :sh07-b51-implementation-semantic-id :generated)
         (sh07-b51-reference-descriptor
          [:contract-semantic-id]
          :sh07-b51-contract-semantic-id :generated)
         (sh07-b51-reference-descriptor
          [:same-request-semantic-id]
          :sh07-b51-same-request-semantic-id :generated)
         (if legacy?
           (sh07-b51-reference-descriptor
            [:v16-verification-semantic-id]
            :sh07-b51-v16-verification-semantic-id :generated)
           nil)]
        (if (= purpose :sh07-b51-predecessor-authority-id)
          [(sh07-b51-reference-descriptor
            [:implementation-semantic-id]
            :sh07-b51-implementation-semantic-id :generated)
           (sh07-b51-reference-descriptor
            [:contract-semantic-id]
            :sh07-b51-contract-semantic-id :generated)
           (sh07-b51-reference-descriptor
            [:same-request-semantic-id]
            :sh07-b51-same-request-semantic-id :generated)
           (sh07-b51-reference-descriptor
            [:outcome-semantic-id]
            :sh07-b51-predecessor-outcome-semantic-id :generated)]
          (if (= purpose :sh07-b51-core-node-id)
            [(sh07-b51-reference-descriptor
              [:predecessor-authority-id]
              :sh07-b51-predecessor-authority-id :generated)
             (if legacy? nil
               (sh07-b51-reference-descriptor
                [:children :each]
                :sh07-b51-core-node-id :generated))
             (if legacy? nil
               (sh07-b51-reference-descriptor
                [:evaluated-children :each]
                :sh07-b51-core-node-id :generated))]
            (if (= purpose :sh07-b51-product-node-id)
              [(sh07-b51-reference-descriptor
                [:predecessor-authority-id]
                :sh07-b51-predecessor-authority-id :generated)]
              (if (= purpose :sh07-b51-binding-slot-id)
                [(sh07-b51-reference-descriptor
                  [:predecessor-authority-id]
                  :sh07-b51-predecessor-authority-id :generated)
                 (if legacy? nil
                   (sh07-b51-reference-descriptor
                    [:owner-core-node-id]
                    :sh07-b51-core-node-id :generated))
                 (if legacy? nil
                   (sh07-b51-reference-descriptor
                    [:initializer-core-node-id]
                    :sh07-b51-core-node-id :generated))]
                (if (= purpose :sh07-b51-binding-extraction-id)
                  [(sh07-b51-reference-descriptor
                    [:predecessor-authority-id]
                    :sh07-b51-predecessor-authority-id :generated)
                   (sh07-b51-reference-descriptor
                    [:slot-id] :sh07-b51-binding-slot-id :generated)]
                  (if (= purpose :sh07-b51-runtime-check-id)
                    [(sh07-b51-reference-descriptor
                      [:predecessor-authority-id]
                      :sh07-b51-predecessor-authority-id :generated)
                     (sh07-b51-reference-descriptor
                      [:slot-id] :sh07-b51-binding-slot-id :generated)
                     (sh07-b51-reference-descriptor
                      [:extraction-id]
                      :sh07-b51-binding-extraction-id :generated)
                     (if legacy? nil
                       (sh07-b51-reference-descriptor
                        [:recur-coordinate :optional :recur-core-node-id]
                        :sh07-b51-core-node-id :generated))]
                    (if (= purpose :sh07-b51-publication-event-id)
                      [(sh07-b51-reference-descriptor
                        [:predecessor-authority-id]
                        :sh07-b51-predecessor-authority-id :generated)
                       (sh07-b51-reference-descriptor
                        [:slot-id :optional]
                        :sh07-b51-binding-slot-id :generated)
                       (sh07-b51-reference-descriptor
                        [:slot-ids :each]
                        :sh07-b51-binding-slot-id :generated)
                       (sh07-b51-reference-descriptor
                        [:projection-ids :each]
                        :sh07-b51-product-node-id :generated)
                       (sh07-b51-reference-descriptor
                        [:projection-id-vectors :each :each]
                        :sh07-b51-product-node-id :generated)
                       (sh07-b51-reference-descriptor
                        [:required-check-ids :each]
                        :sh07-b51-runtime-check-id :generated)
                       (sh07-b51-reference-descriptor
                        [:required-check-id-vectors :each :each]
                        :sh07-b51-runtime-check-id :generated)
                       (sh07-b51-reference-descriptor
                        [:product-node-ids :each]
                        :sh07-b51-product-node-id :generated)
                       (sh07-b51-reference-descriptor
                        [:product-node-id-vectors :each :each]
                        :sh07-b51-product-node-id :generated)
                       (if legacy? nil
                         (sh07-b51-reference-descriptor
                          [:recur-coordinate :optional :recur-core-node-id]
                          :sh07-b51-core-node-id :generated))]
                      (if (= purpose :sh07-b51-recur-slot-mapping-id)
                        [(sh07-b51-reference-descriptor
                          [:predecessor-authority-id]
                          :sh07-b51-predecessor-authority-id :generated)
                         (sh07-b51-reference-descriptor
                          [:commit-publication-id]
                          :sh07-b51-publication-event-id :generated)
                         (sh07-b51-reference-descriptor
                          [:slot-ids :each]
                          :sh07-b51-binding-slot-id :generated)
                         (sh07-b51-reference-descriptor
                          [:extraction-id-vectors :each :each]
                          :sh07-b51-binding-extraction-id :generated)
                         (sh07-b51-reference-descriptor
                          [:required-check-id-vectors :each :each]
                          :sh07-b51-runtime-check-id :generated)
                         (sh07-b51-reference-descriptor
                          [:projection-id-vectors :each :each]
                          :sh07-b51-product-node-id :generated)
                         (if legacy? nil
                           (sh07-b51-reference-descriptor
                            [:loop-core-node-id]
                            :sh07-b51-core-node-id :generated))
                         (if legacy? nil
                           (sh07-b51-reference-descriptor
                            [:recur-core-node-id]
                            :sh07-b51-core-node-id :generated))
                         (if legacy? nil
                           (sh07-b51-reference-descriptor
                            [:target-loop-core-node-id]
                            :sh07-b51-core-node-id :generated))
                         (if legacy? nil
                           (sh07-b51-reference-descriptor
                            [:argument-node-ids :each]
                            :sh07-b51-core-node-id :generated))]
                        (if (= purpose
                               :sh07-b51-slot-extraction-transcript-id)
                          [(sh07-b51-reference-descriptor
                            [:predecessor-authority-id]
                            :sh07-b51-predecessor-authority-id :generated)
                           (sh07-b51-reference-descriptor
                            [:same-request-semantic-id]
                            :sh07-b51-same-request-semantic-id :generated)
                           (sh07-b51-reference-descriptor
                            [:slot-ids :each]
                            :sh07-b51-binding-slot-id :generated)
                           (sh07-b51-reference-descriptor
                            [:extraction-ids :each]
                            :sh07-b51-binding-extraction-id :generated)
                           (sh07-b51-reference-descriptor
                            [:runtime-check-ids :each]
                            :sh07-b51-runtime-check-id :generated)
                           (sh07-b51-reference-descriptor
                            [:publication-event-ids :each]
                            :sh07-b51-publication-event-id :generated)
                           (sh07-b51-reference-descriptor
                            [:recur-slot-mapping-ids :each]
                            :sh07-b51-recur-slot-mapping-id :generated)]
                          (if (= purpose
                                 :sh07-b51-predecessor-observation-id)
                            [(sh07-b51-reference-descriptor
                              [:semantic-identity-id]
                              :sh07-b51-core-identity-id :generated)]
                            (if (= purpose
                                   :sh07-b51-provenance-binding-id)
                              [(sh07-b51-reference-descriptor
                                [:semantic-identity-id]
                                :sh07-b51-core-identity-id :generated)
                               (sh07-b51-reference-descriptor
                                [:observation-id]
                                :sh07-b51-predecessor-observation-id
                                :generated)]
                              (if (= purpose
                                     :sh07-b51-independent-verifier-binding-id)
                                [(sh07-b51-reference-descriptor
                                  [:semantic-identity-id]
                                  :sh07-b51-core-identity-id :generated)
                                 (sh07-b51-reference-descriptor
                                  [:provenance-binding-id]
                                  :sh07-b51-provenance-binding-id
                                  :generated)]
                                (if (= purpose
                                       :sh07-b51-final-artifact-binding-id)
                                  [(sh07-b51-reference-descriptor
                                    [:semantic-identity-id]
                                    :sh07-b51-core-identity-id :generated)
                                   (sh07-b51-reference-descriptor
                                    [:provenance-binding-id]
                                    :sh07-b51-provenance-binding-id
                                    :generated)
                                   (sh07-b51-reference-descriptor
                                    [:independent-verifier-binding-id]
                                    :sh07-b51-independent-verifier-binding-id
                                    :generated)]
                                  [])))))))))))))))))

(defn sh07-b51-compact-reference-descriptors [descriptors]
  (loop [remaining descriptors result []]
    (if (= (count remaining) 0)
      result
      (recur
       (rest remaining)
       (if (= (first remaining) nil)
         result
         (conj result (first remaining)))))))

(defn sh07-b51-inherited-product-reference-paths []
  [[:fragment-manifest :each :root-node-ids :each]
   [:root-core-node-ids :each]
   [:definitions :each :core-node-id]
   [:definitions :each :value-node-id]
   [:nodes :each :node-id]
   [:nodes :each :children :each]
   [:nodes :each :evaluation :order :each :core-node-id]
   [:evaluation-order :each :core-node-id]
   [:evaluation-order :each :children :each]
   [:control-flow :each :core-node-id]
   [:control-flow :each :condition-node-id :if-kind]
   [:control-flow :each :branches :if-kind :each :core-node-id]
   [:control-flow :each :ordered-child-node-ids :do-kind :each]
   [:control-flow :each :result-policy :do-kind :core-node-id]
   [:reference-uses :each :core-node-id]
   [:var-references :each :core-node-id]
   [:mutations :each :core-node-id]
   [:mutations :each :value-core-node-id]
   [:mutations :each :evaluated-children :each]
   [:error-transfers :each :core-node-id]
   [:error-transfers :each :value-core-node-id]
   [:error-transfers :each :evaluated-children :each]
   [:error-handlers :each :core-node-id]
   [:error-handlers :each :protected-core-node-id]
   [:error-handlers :each :handler-core-node-id]
   [:error-handlers :each :candidate-error-transfers :each :core-node-id]
   [:match-branch-records :each :core-node-id]
   [:match-branch-records :each :scrutinee-core-node-id]
   [:match-branch-records :each :branch-core-node-id]
   [:match-decision-skeletons :each :core-node-id]
   [:match-decision-skeletons :each :scrutinee-core-node-id]
   [:match-decision-skeletons :each :branch-core-node-ids :each]
   [:match-pattern-records :each :core-node-id]
   [:calls :each :core-node-id]
   [:calls :each :operator-node-id]
   [:calls :each :argument-node-ids :each]
   [:calls :each :ordered-evaluation-node-ids :each]
   [:function-records :each :function-core-node-id]
   [:function-records :each :body-core-node-id]
   [:function-records :each :definition-core-node-id :optional]
   [:call-edges :each :call-core-node-id]
   [:call-edges :each :caller-function-core-node-id :optional]
   [:call-edges :each :callee-function-core-node-id :optional]
   [:call-edges :each :argument-core-node-ids :each]
   [:call-edges :each :ordered-evaluation-node-ids :each]
   [:recursion-components :each :function-core-node-ids :each]
   [:keyword-lookups :each :core-node-id]
   [:keyword-lookups :each :keyword-node-id]
   [:keyword-lookups :each :map-node-id]
   [:keyword-lookups :each :ordered-evaluation-node-ids :each]
   [:lexical-bindings :each :let-core-node-id]
   [:lexical-bindings :each :initializer-node-id]
   [:loop-bindings :each :loop-core-node-id]
   [:loop-bindings :each :initializer-node-id]
   [:recur-targets :each :owner-core-node-id]
   [:recur-transfers :each :recur-core-node-id]
   [:recur-transfers :each :argument-node-ids :each]
   [:source-map :each :core-node-id]])

(defn sh07-b51-ordinary-core-terminal-paths []
  [[:destructuring-product-nodes :each :owner-core-node-id]
   [:destructuring-product-nodes :each :recur-coordinate :optional
    :recur-core-node-id]
   [:destructuring-product-nodes :each :argument-node-ids :each]
   [:destructuring-product-nodes :each :child-node-ids :each]
   [:destructuring-product-nodes :each :evaluated-child-node-ids :each]
   [:binding-slots :each :owner-core-node-id]
   [:binding-slots :each :initializer-core-node-id]
   [:runtime-checks :each :recur-coordinate :optional :recur-core-node-id]
   [:publication-events :each :recur-coordinate :optional
    :recur-core-node-id]
   [:recur-slot-mappings :each :loop-core-node-id]
   [:recur-slot-mappings :each :recur-core-node-id]
   [:recur-slot-mappings :each :target-loop-core-node-id]
   [:recur-slot-mappings :each :argument-node-ids :each]])

(defn sh07-b51-rejected-category-reference-paths []
  [[:lexical-bindings :each :slot-id]
   [:loop-bindings :each :slot-id]
   [:recur-targets :each :slot-ids :target-kind=:loop :each]])

(defn sh07-b51-noncore-generated-reference-descriptors []
  (sh07-b51-vector-append
   (sh07-b51-descriptor-vector
    [[:destructuring-product-nodes :each :node-id]
     [:publication-events :each :projection-ids :each]
     [:publication-events :each :projection-id-vectors :each :each]
     [:publication-events :each :product-node-ids :each]
     [:publication-events :each :product-node-id-vectors :each :each]
     [:recur-slot-mappings :each :projection-id-vectors :each :each]]
    :sh07-b51-product-node-id :generated)
   (sh07-b51-vector-append
    (sh07-b51-descriptor-vector
     [[:destructuring-product-nodes :each :predecessor-authority-id]
      [:binding-slots :each :predecessor-authority-id]
      [:binding-extractions :each :predecessor-authority-id]
      [:slot-extraction-transcript :predecessor-authority-id]
      [:runtime-checks :each :predecessor-authority-id]
      [:publication-events :each :predecessor-authority-id]
      [:recur-slot-mappings :each :predecessor-authority-id]]
     :sh07-b51-predecessor-authority-id :generated)
    (sh07-b51-vector-append
     (sh07-b51-descriptor-vector
      [[:destructuring-product-nodes :each :slot-id :optional]
       [:binding-slots :each :slot-id]
       [:binding-extractions :each :slot-id]
       [:slot-extraction-transcript :slot-ids :each]
       [:runtime-checks :each :slot-id]
       [:publication-events :each :slot-id :optional]
       [:publication-events :each :slot-ids :each]
       [:recur-slot-mappings :each :slot-ids :each]]
      :sh07-b51-binding-slot-id :generated)
     (sh07-b51-vector-append
      (sh07-b51-descriptor-vector
       [[:destructuring-product-nodes :each :extraction-id :optional]
        [:binding-slots :each :vector-node-extraction-ids :each]
        [:binding-extractions :each :extraction-id]
        [:slot-extraction-transcript :extraction-ids :each]
        [:runtime-checks :each :extraction-id]
        [:recur-slot-mappings :each :extraction-id-vectors :each :each]]
       :sh07-b51-binding-extraction-id :generated)
      (sh07-b51-vector-append
       (sh07-b51-descriptor-vector
        [[:destructuring-product-nodes :each :runtime-check-id :optional]
         [:destructuring-product-nodes :each :required-check-ids :each]
         [:slot-extraction-transcript :runtime-check-ids :each]
         [:runtime-checks :each :id]
         [:publication-events :each :required-check-ids :each]
         [:publication-events :each :required-check-id-vectors :each :each]
         [:recur-slot-mappings :each :required-check-id-vectors :each :each]]
        :sh07-b51-runtime-check-id :generated)
       (sh07-b51-vector-append
        (sh07-b51-descriptor-vector
         [[:destructuring-product-nodes :each :publication-event-id :optional]
          [:slot-extraction-transcript :publication-event-ids :each]
          [:publication-events :each :id]
          [:recur-slot-mappings :each :commit-publication-id]]
         :sh07-b51-publication-event-id :generated)
        (sh07-b51-vector-append
         (sh07-b51-descriptor-vector
          [[:destructuring-product-nodes :each :recur-slot-mapping-id :optional]
           [:slot-extraction-transcript :recur-slot-mapping-ids :each]
           [:recur-slot-mappings :each :mapping-id]]
          :sh07-b51-recur-slot-mapping-id :generated)
         [(sh07-b51-reference-descriptor
           [:slot-extraction-transcript :transcript-id]
           :sh07-b51-slot-extraction-transcript-id :generated)
          (sh07-b51-reference-descriptor
           [:slot-extraction-transcript :same-request-semantic-id]
          :sh07-b51-same-request-semantic-id :generated)]))))))))

(defn sh07-b51-prefix-reference-descriptors [prefix descriptors]
  (loop [remaining descriptors result []]
    (if (= (count remaining) 0)
      result
      (let [descriptor (first remaining)]
        (recur
         (rest remaining)
         (conj
          result
          (assoc
           descriptor :path
           (sh07-b51-vector-append
            prefix (get descriptor :path)))))))))

(defn sh07-b51-tier3-reference-descriptors [outcome-kind]
  (let [legacy? (= outcome-kind :legacy-v16-accepted)
        top-level
        [(sh07-b51-reference-descriptor
          [:same-request-semantic-id]
          :sh07-b51-same-request-semantic-id :generated)
         (sh07-b51-reference-descriptor
          [:predecessor-authority-id]
          :sh07-b51-predecessor-authority-id :generated)]
        inherited
        (sh07-b51-prefix-reference-descriptors
         [:products]
         (sh07-b51-descriptor-vector
          (sh07-b51-inherited-product-reference-paths)
          (if legacy? nil :sh07-b51-core-node-id)
          (if legacy? :concrete :generated)))
        ordinary
        (sh07-b51-prefix-reference-descriptors
         [:products]
         (sh07-b51-descriptor-vector
          (sh07-b51-ordinary-core-terminal-paths)
          (if legacy? nil :sh07-b51-core-node-id)
          (if legacy? :concrete :generated)))
        noncore
        (sh07-b51-prefix-reference-descriptors
         [:products]
         (sh07-b51-noncore-generated-reference-descriptors))
        rejected
        (if legacy? []
          (sh07-b51-prefix-reference-descriptors
           [:products]
           (sh07-b51-descriptor-vector
            (sh07-b51-rejected-category-reference-paths)
            :sh07-b51-binding-slot-id :generated)))
        legacy-paths
        (if legacy?
          [(sh07-b51-reference-descriptor
            [:products :legacy-v16-equivalence
             :same-request-semantic-id]
            :sh07-b51-same-request-semantic-id :generated)
           (sh07-b51-reference-descriptor
            [:products :legacy-v16-equivalence
             :predecessor-outcome-semantic-id]
            :sh07-b51-predecessor-outcome-semantic-id :generated)
           (sh07-b51-reference-descriptor
            [:products :legacy-v16-equivalence
             :v16-verification-semantic-id]
            :sh07-b51-v16-verification-semantic-id :generated)
           (sh07-b51-reference-descriptor
            [:products :legacy-v16-equivalence
             :inherited-v16-semantic-artifact-id]
            nil :concrete)]
          [])]
    (sh07-b51-vector-append
     top-level
     (sh07-b51-vector-append
      inherited
      (sh07-b51-vector-append
       rejected
       (sh07-b51-vector-append
        noncore
        (sh07-b51-vector-append ordinary legacy-paths)))))))

(defn sh07-b51-purpose-reference-descriptors [purpose outcome-kind]
  (if (= purpose :sh07-b51-core-identity-id)
    (sh07-b51-tier3-reference-descriptors outcome-kind)
    (sh07-b51-compact-reference-descriptors
     (sh07-b51-purpose-nontier3-reference-descriptors
      purpose outcome-kind))))

(defn sh07-b51-reference-paths-unique? [descriptors]
  (loop [remaining descriptors seen #{}]
    (if (= (count remaining) 0)
      true
      (let [path (get (first remaining) :path)]
        (if (contains? seen path)
          false
          (recur (rest remaining) (conj seen path)))))))

(defn sh07-b51-validate-reference-descriptor [preimage descriptor]
  (let [path-result
        (sh07-b51-reference-path-values
         preimage (get descriptor :path))]
    (if (= (get path-result :status) :accepted)
      (loop [remaining (get path-result :values) result []]
        (if (= (count remaining) 0)
          {:status :accepted :references result}
          (let [value (first remaining)
                representation (get descriptor :representation)]
            (if (= representation :generated)
              (if (sh07-b51-internal-reference? value)
                (recur
                 (rest remaining)
                 (conj result
                       {:reference value
                        :path (get descriptor :path)
                        :target-purpose
                        (get descriptor :target-purpose)}))
                {:status :rejected
                 :reason :generated-reference-representation})
              (if (= representation :concrete)
                (if (sh07-b51-sha256-id? value)
                  (recur (rest remaining) result)
                  {:status :rejected
                   :reason :concrete-reference-representation})
                {:status :rejected
                 :reason :reference-representation-unknown})))))
      path-result)))

(defn sh07-b51-validate-reference-descriptors [preimage descriptors]
  (if (sh07-b51-reference-paths-unique? descriptors)
    (loop [remaining descriptors result []]
      (if (= (count remaining) 0)
        {:status :accepted :references result}
        (let [validated
              (sh07-b51-validate-reference-descriptor
               preimage (first remaining))]
          (if (= (get validated :status) :accepted)
            (recur
             (rest remaining)
             (sh07-b51-vector-append
              result (get validated :references)))
            validated))))
    {:status :rejected :reason :reference-path-duplicate}))

(defn sh07-b51-remove-first-equal [values expected]
  (loop [remaining values result [] found false]
    (if (= (count remaining) 0)
      {:found found :values result}
      (if (if (= (first remaining) expected) (= found false) false)
        (recur (rest remaining) result true)
        (recur (rest remaining) (conj result (first remaining)) found)))))

(defn sh07-b51-reference-multiset-equal? [left right]
  (if (= (count left) (count right))
    (loop [remaining left unmatched right]
      (if (= (count remaining) 0)
        (= (count unmatched) 0)
        (let [removed
              (sh07-b51-remove-first-equal
               unmatched (first remaining))]
          (if (get removed :found)
            (recur (rest remaining) (get removed :values))
            false))))
    false))

(defn sh07-b51-reference-record-values [records]
  (loop [remaining records result []]
    (if (= (count remaining) 0)
      result
      (recur
       (rest remaining)
       (conj result (get (first remaining) :reference))))))

(defn sh07-b51-purpose-catalog []
  [:sh07-b51-implementation-semantic-id
   :sh07-b51-contract-semantic-id
   :sh07-b51-same-request-semantic-id
   :sh07-b51-v16-verification-semantic-id
   :sh07-b51-predecessor-outcome-semantic-id
   :sh07-b51-predecessor-authority-id
   :sh07-b51-core-node-id :sh07-b51-product-node-id
   :sh07-b51-binding-slot-id :sh07-b51-binding-extraction-id
   :sh07-b51-runtime-check-id :sh07-b51-publication-event-id
   :sh07-b51-recur-slot-mapping-id
   :sh07-b51-slot-extraction-transcript-id
   :sh07-b51-core-identity-id
   :sh07-b51-predecessor-observation-id
   :sh07-b51-provenance-binding-id
   :sh07-b51-independent-verifier-binding-id
   :sh07-b51-final-artifact-binding-id])

(defn sh07-b51-dependency-catalog-cardinalities []
  (loop [purposes (sh07-b51-purpose-catalog) result []]
    (if (= (count purposes) 0)
      result
      (let [dependencies
            (sh07-b51-purpose-dependencies (first purposes))]
        (if (vector? dependencies)
          (recur (rest purposes) (conj result (count dependencies)))
          [])))))

(defn sh07-b51-dependency-row-exact? [source-purpose dependencies]
  (if (vector? dependencies)
    (loop [remaining dependencies seen #{}]
      (if (= (count remaining) 0)
        true
        (let [entry (first remaining)
              target (sh07-b51-dependency-entry-target entry)]
          (if (sh07-b51-vector-contains?
               (sh07-b51-purpose-catalog) target)
            (if (contains? seen target)
              false
              (if (map? entry)
                (if (= source-purpose :sh07-b51-core-identity-id)
                  (recur (rest remaining) (conj seen target))
                  false)
                (if (keyword? entry)
                  (recur (rest remaining) (conj seen target))
                  false)))
            false))))
    false))

(defn sh07-b51-dependency-catalog-exact? []
  (if (= (sh07-b51-dependency-catalog-cardinalities)
         [0 0 0 0 4 4 2 1 2 2 4 5 7 7 12 1 2 2 3])
    (if (= (sh07-b51-dependency-catalog-edge-count) 58)
      (if (= (sh07-b51-purpose-dependencies
              :sh07-b51-core-identity-id)
             [:sh07-b51-same-request-semantic-id
              {:accepted-only
               :sh07-b51-v16-verification-semantic-id}
              {:accepted-only
               :sh07-b51-predecessor-outcome-semantic-id}
              :sh07-b51-predecessor-authority-id
              {:non-v16-only :sh07-b51-core-node-id}
              :sh07-b51-product-node-id
              :sh07-b51-binding-slot-id
              :sh07-b51-binding-extraction-id
              :sh07-b51-runtime-check-id
              :sh07-b51-publication-event-id
              :sh07-b51-recur-slot-mapping-id
              :sh07-b51-slot-extraction-transcript-id])
        (loop [purposes (sh07-b51-purpose-catalog)]
          (if (= (count purposes) 0)
            true
            (let [purpose (first purposes)]
              (if (sh07-b51-dependency-row-exact?
                   purpose (sh07-b51-purpose-dependencies purpose))
                (recur (rest purposes))
                false))))
        false)
      false)
    false))

(defn sh07-b51-reference-registry-generated-count [outcome-kind]
  (loop [purposes (sh07-b51-purpose-catalog) count-value 0]
    (if (= (count purposes) 0)
      count-value
      (let [descriptors
            (sh07-b51-purpose-reference-descriptors
             (first purposes) outcome-kind)]
        (recur
         (rest purposes)
         (+ count-value
            (loop [remaining descriptors count-found 0]
              (if (= (count remaining) 0)
                count-found
                (recur
                 (rest remaining)
                 (if (= (get (first remaining) :representation)
                        :generated)
                   (+ count-found 1) count-found))))))))))

(defn sh07-b51-reference-descriptor-static-shape?
  [source-purpose descriptor outcome-kind]
  (if (sh07-b51-exact-keys?
       descriptor #{:path :target-purpose :representation})

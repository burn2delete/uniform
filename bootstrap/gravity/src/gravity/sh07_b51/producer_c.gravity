; Gravity-owned SH-07 B51 bounded module; Attempt24 owner :r1-producer.
(ns gravity.sh07-b51.producer-c
  (:profile :meta)
  (:target :jvm)
  (:exports [sh07-b51-resolve-digest-preimage])
  (:effects #{})
  (:capabilities #{})
  (:safety :safe))

(defn
 sh07-b51-v16-replay-all-list-clauses?
 [request form-ids operator]
 (loop
  [remaining form-ids]
  (if
   (= (count remaining) 0)
   true
   (let
    [form
     (sh07-b51-v16-replay-find-form
      (get request :internal-indexes)
      (first remaining))]
    (if
     (if
      (= (get form :kind) :list)
      (= (sh07-b51-v16-replay-list-operator request form) operator)
      false)
     (recur (rest remaining))
     false)))))

(defn
 sh07-b51-v16-replay-try-noncanonical-shape
 [request form children]
 (let
  [operands
   (vec (rest children))
   catch-count
   (sh07-b51-v16-replay-list-clause-count request operands 'catch)
   finally-count
   (sh07-b51-v16-replay-list-clause-count request operands 'finally)
   first-catch-index
   (sh07-b51-v16-replay-first-list-clause-index
    request
    operands
    'catch)]
  (if
   (> finally-count 0)
   {:status :rejected,
    :rule "C6-LOWERING-GAP",
    :form form,
    :facts {:reason :finally-clause-deferred}}
   (if
    (= catch-count 0)
    {:status :rejected,
     :rule "C6-CORE-SHAPE",
     :form form,
     :facts {:reason :try-catch-required}}
    (if
     (= first-catch-index 0)
     {:status :rejected,
      :rule "C6-CORE-SHAPE",
      :form form,
      :facts {:reason :try-protected-expression-required}}
     (if
      (> first-catch-index 1)
      {:status :rejected,
       :rule "C6-LOWERING-GAP",
       :form form,
       :facts {:reason :try-protected-sequencing-deferred}}
      (if
       (sh07-b51-v16-replay-all-list-clauses?
        request
        (subvec operands 1 (count operands))
        'catch)
       {:status :accepted}
       {:status :rejected,
        :rule "C6-CORE-SHAPE",
        :form form,
        :facts {:reason :try-handler-chain-contiguity-required}})))))))

(defn
 sh07-b51-v16-replay-try-catch-descriptor
 [request catch-form]
 (let
  [indexes
   (get request :internal-indexes)
   catch-children
   (get catch-form :child-form-ids)]
  (if
   (= (count catch-children) 4)
   (let
    [error-type-form
     (sh07-b51-v16-replay-find-form indexes (get catch-children 1))
     catch-binding-form
     (sh07-b51-v16-replay-find-form indexes (get catch-children 2))
     handler-form
     (sh07-b51-v16-replay-find-form indexes (get catch-children 3))]
    (if
     (= (get error-type-form :kind) :symbol)
     (if
      (= (get catch-binding-form :kind) :symbol)
      (let
       [error-type-resolution
        (sh07-b51-v16-replay-find-resolution
         indexes
         (get error-type-form :syntax-id))
        error-type-binding
        (sh07-b51-v16-replay-find-binding
         indexes
         (get error-type-resolution :binding-id))
        catch-binding
        (sh07-b51-v16-replay-definition-binding
         indexes
         (get catch-binding-form :syntax-id))]
       (if
        (if
         (map? error-type-resolution)
         (if
          (= (get error-type-resolution :position) :type)
          (if
           (=
            (get error-type-resolution :symbol)
            (get error-type-form :value))
           (if
            (map? error-type-binding)
            (if
             (= (get error-type-binding :kind) :type)
             (= (get error-type-binding :binding-class) :core)
             false)
            false)
           false)
          false)
         false)
        (if
         (if
          (map? catch-binding)
          (if
           (= (get catch-binding :kind) :local)
           (if
            (= (get catch-binding :binding-class) :lexical)
            (if
             (=
              (get catch-binding :name)
              (get catch-binding-form :value))
             (=
              (get catch-binding :scope-id)
              (get catch-binding-form :scope-id))
             false)
            false)
           false)
          false)
         {:status :accepted,
          :catch-form catch-form,
          :error-type-form error-type-form,
          :error-type-binding error-type-binding,
          :catch-binding-form catch-binding-form,
          :catch-binding catch-binding,
          :handler-form handler-form}
         {:status :rejected,
          :rule "C6-VERIFY",
          :form catch-binding-form,
          :facts {:reason :catch-binding-resolution-mismatch}})
        {:status :rejected,
         :rule "C6-VERIFY",
         :form error-type-form,
         :facts {:reason :catch-type-resolution-mismatch}}))
      {:status :rejected,
       :rule "C6-CORE-SHAPE",
       :form catch-binding-form,
       :facts {:reason :catch-binding-symbol-required}})
     {:status :rejected,
      :rule "C6-CORE-SHAPE",
      :form error-type-form,
      :facts {:reason :catch-type-symbol-required}}))
   (if
    (< (count catch-children) 4)
    {:status :rejected,
     :rule "C6-CORE-SHAPE",
     :form catch-form,
     :facts {:reason :catch-handler-expression-required}}
    {:status :rejected,
     :rule "C6-LOWERING-GAP",
     :form catch-form,
     :facts {:reason :catch-handler-sequencing-deferred}}))))

(defn
 sh07-b51-v16-replay-try-catch-descriptors
 [request catch-form-ids]
 (loop
  [remaining catch-form-ids values []]
  (if
   (= (count remaining) 0)
   {:status :accepted, :descriptors values}
   (let
    [catch-form
     (sh07-b51-v16-replay-find-form
      (get request :internal-indexes)
      (first remaining))
     descriptor
     (sh07-b51-v16-replay-try-catch-descriptor request catch-form)]
    (if
     (= (get descriptor :status) :accepted)
     (recur (rest remaining) (conj values descriptor))
     descriptor)))))

(defn
 sh07-b51-v16-replay-lower-try-handlers
 [request state form descriptors]
 (let
  [clause-count (count descriptors)]
  (loop
   [remaining
    descriptors
    clause-ordinal
    0
    current-state
    state
    lowered
    []]
   (if
    (= (count remaining) 0)
    {:status :accepted, :state current-state, :handlers lowered}
    (let
     [descriptor
      (first remaining)
      reference-use-start
      (count (get current-state :reference-uses))
      handler-lowered
      (sh07-b51-v16-replay-lower-form
       request
       (assoc
        (assoc
         (assoc current-state :definition-context :nested-expression)
         :tail-target-id
         nil)
        :evaluation-region
        (sh07-b51-v16-replay-error-handler-region
         (get state :evaluation-region)
         form
         (get descriptor :catch-form)
         clause-ordinal
         clause-count))
       (get descriptor :handler-form))]
     (if
      (= (get handler-lowered :status) :accepted)
      (let
       [handler-state
        (get handler-lowered :state)
        binding-use-syntax-ids
        (sh07-b51-v16-replay-catch-binding-use-syntax-ids
         (get handler-state :reference-uses)
         reference-use-start
         (get (get descriptor :catch-binding) :binding-id))]
       (recur
        (rest remaining)
        (+ clause-ordinal 1)
        handler-state
        (conj
         lowered
         (assoc
          (assoc
           descriptor
           :handler-node-id
           (get handler-lowered :node-id))
          :binding-use-syntax-ids
          binding-use-syntax-ids))))
      handler-lowered))))))

(defn
 sh07-b51-v16-replay-handler-node-ids
 [handlers]
 (loop
  [remaining handlers values []]
  (if
   (= (count remaining) 0)
   values
   (recur
    (rest remaining)
    (conj values (get (first remaining) :handler-node-id))))))

(defn
 sh07-b51-v16-replay-append-vector
 [left right]
 (loop
  [remaining right values left]
  (if
   (= (count remaining) 0)
   values
   (recur (rest remaining) (conj values (first remaining))))))

(defn
 sh07-b51-v16-replay-handler-clause-descriptors
 [handlers]
 (loop
  [remaining handlers clause-ordinal 0 values []]
  (if
   (= (count remaining) 0)
   values
   (let
    [handler (first remaining)]
    (recur
     (rest remaining)
     (+ clause-ordinal 1)
     (conj
      values
      (sh07-b51-v16-replay-handler-clause-descriptor
       clause-ordinal
       (+ clause-ordinal 1)
       (get handler :catch-form)
       (get handler :error-type-form)
       (get handler :error-type-binding)
       (get handler :catch-binding-form)
       (get handler :catch-binding))))))))

(defn
 sh07-b51-v16-replay-handler-binding-ids
 [handlers]
 (loop
  [remaining handlers values []]
  (if
   (= (count remaining) 0)
   values
   (let
    [handler (first remaining)]
    (recur
     (rest remaining)
     (conj
      (conj values (get (get handler :error-type-binding) :binding-id))
      (get (get handler :catch-binding) :binding-id)))))))

(defn
 sh07-b51-v16-replay-handler-records
 [request
  state
  first-ordinal
  node-id
  form
  protected-node-id
  handlers
  candidates]
 (loop
  [remaining handlers clause-ordinal 0 values []]
  (if
   (= (count remaining) 0)
   values
   (let
    [handler (first remaining)]
    (recur
     (rest remaining)
     (+ clause-ordinal 1)
     (conj
      values
      (sh07-b51-v16-replay-error-handler-record
       request
       state
       (+ first-ordinal clause-ordinal)
       node-id
       form
       protected-node-id
       (get handler :handler-node-id)
       clause-ordinal
       (count handlers)
       (+ clause-ordinal 1)
       (get handler :catch-form)
       (get handler :error-type-form)
       (get handler :error-type-binding)
       (get handler :catch-binding-form)
       (get handler :catch-binding)
       (get handler :binding-use-syntax-ids)
       candidates)))))))

(defn
 sh07-b51-v16-replay-lower-try
 [request state form]
 (let
  [indexes
   (get request :internal-indexes)
   children
   (get form :child-form-ids)
   shape
   (sh07-b51-v16-replay-try-noncanonical-shape request form children)]
  (if
   (= (get shape :status) :accepted)
   (let
    [protected-form
     (sh07-b51-v16-replay-find-form indexes (get children 1))
     descriptors-result
     (sh07-b51-v16-replay-try-catch-descriptors
      request
      (subvec children 2 (count children)))]
    (if
     (= (get descriptors-result :status) :accepted)
     (let
      [transfer-start
       (count (get state :error-transfers))
       protected-lowered
       (sh07-b51-v16-replay-lower-form
        request
        (assoc
         (assoc state :definition-context :nested-expression)
         :tail-target-id
         nil)
        protected-form)]
      (if
       (= (get protected-lowered :status) :accepted)
       (let
        [protected-state
         (get protected-lowered :state)
         protected-node-id
         (get protected-lowered :node-id)
         candidates
         (sh07-b51-v16-replay-candidate-error-transfers
          (get protected-state :error-transfers)
          transfer-start
          (get state :evaluation-owner-function-syntax-id))
         handlers-result
         (sh07-b51-v16-replay-lower-try-handlers
          request
          protected-state
          form
          (get descriptors-result :descriptors))]
        (if
         (= (get handlers-result :status) :accepted)
         (let
          [handlers
           (get handlers-result :handlers)
           restored-state
           (assoc
            (assoc
             (get handlers-result :state)
             :evaluation-region
             (get state :evaluation-region))
            :tail-target-id
            (get state :tail-target-id))
           handler-node-ids
           (sh07-b51-v16-replay-handler-node-ids handlers)
           handler-clauses
           (sh07-b51-v16-replay-handler-clause-descriptors handlers)
           added
           (sh07-b51-v16-replay-add-node
            request
            restored-state
            form
            :try
            (sh07-b51-v16-replay-append-vector
             [protected-node-id]
             handler-node-ids)
            (sh07-b51-v16-replay-try-node-attributes
             request
             handler-clauses)
            (sh07-b51-v16-replay-handler-binding-ids handlers)
            :protected-then-ordered-typed-handler-candidates)
           first-ordinal
           (count (get (get added :state) :error-handlers))
           records
           (sh07-b51-v16-replay-handler-records
            request
            state
            first-ordinal
            (get added :node-id)
            form
            protected-node-id
            handlers
            candidates)
           next-state
           (assoc
            (get added :state)
            :error-handlers
            (sh07-b51-v16-replay-append-vector
             (get (get added :state) :error-handlers)
             records))]
          (assoc added :state next-state))
         handlers-result))
       protected-lowered))
     descriptors-result))
   shape)))

(defn
 sh07-b51-v16-replay-binding-descriptors-for-symbol-vector
 [request vector-form destructuring-reason variadic-reason]
 (let
  [indexes (get request :internal-indexes)]
  (loop
   [remaining (get vector-form :child-form-ids) ordinal 0 values []]
   (if
    (= (count remaining) 0)
    {:status :accepted, :descriptors values}
    (let
     [parameter
      (sh07-b51-v16-replay-find-form indexes (first remaining))]
     (if
      (= (get parameter :kind) :symbol)
      (if
       (= (get parameter :value) '&)
       {:status :rejected,
        :rule "C6-LOWERING-GAP",
        :form parameter,
        :facts {:reason variadic-reason}}
       (let
        [binding
         (sh07-b51-v16-replay-definition-binding
          indexes
          (get parameter :syntax-id))]
        (if
         (if
          (map? binding)
          (= (get binding :binding-class) :lexical)
          false)
         (recur
          (rest remaining)
          (+ ordinal 1)
          (conj
           values
           {:ordinal ordinal, :name-form parameter, :binding binding}))
         {:status :rejected,
          :rule "C6-VERIFY",
          :form parameter,
          :facts
          {:reason :binding-resolution-mismatch,
           :semantic-rule "L2-RECUR-TARGET"}})))
      {:status :rejected,
       :rule "C6-LOWERING-GAP",
       :form parameter,
       :facts
       {:reason destructuring-reason,
        :binding-kind (get parameter :kind)}}))))))

(defn
 sh07-b51-v16-replay-descriptor-binding-ids
 [descriptors]
 (loop
  [remaining descriptors values []]
  (if
   (= (count remaining) 0)
   values
   (recur
    (rest remaining)
    (conj values (get (get (first remaining) :binding) :binding-id))))))

(defn
 sh07-b51-v16-replay-add-recur-target-record
 [state target core-node-id]
 (let
  [records (get state :recur-targets) next-count (+ (count records) 1)]
  (if
   (<=
    next-count
    (get
     (sh07-b51-v16-replay-bounds-value)
     :maximum-module-recur-target-records))
   {:status :accepted,
    :state
    (assoc
     state
     :recur-targets
     (conj
      records
      {:type-compatibility :pending-sh08,
       :target-kind (get target :target-kind),
       :owner-form-id (get target :form-id),
       :binding-ids (get target :binding-ids),
       :owner-core-node-id core-node-id,
       :parent-target-id (get target :parent-target-id),
       :body-scope-id (get target :body-scope-id),
       :target-id (get target :target-id),
       :arity (get target :arity),
       :owner-syntax-id (get target :syntax-id)}))}
   {:status :rejected,
    :rule "C6-VERIFY",
    :form nil,
    :facts
    {:reason :recur-target-record-bound,
     :semantic-rule "L2-RECUR-TARGET"}})))

(defn
 sh07-b51-v16-replay-lower-fn
 [request state form]
 (let
  [children (get form :child-form-ids)]
  (if
   (= (count children) 3)
   (let
    [params
     (sh07-b51-v16-replay-find-form
      (get request :internal-indexes)
      (first (rest children)))
     body
     (sh07-b51-v16-replay-find-form
      (get request :internal-indexes)
      (first (rest (rest children))))]
    (if
     (= (get params :kind) :vector)
     (let
      [parameter-descriptors
       (sh07-b51-v16-replay-binding-descriptors-for-symbol-vector
        request
        params
        :fn-parameter-destructuring-deferred
        :variadic-function-recur-deferred)]
      (if
       (= (get parameter-descriptors :status) :accepted)
       (let
        [outer-region
         (get state :evaluation-region)
         outer-owner
         (get state :evaluation-owner-function-syntax-id)
         outer-target-stack
         (get state :recur-target-stack)
         outer-tail-target-id
         (get state :tail-target-id)
         binding-ids
         (sh07-b51-v16-replay-descriptor-binding-ids
          (get parameter-descriptors :descriptors))
         target
         {:target-kind :function,
          :binding-ids binding-ids,
          :parent-target-id nil,
          :body-scope-id (get body :scope-id),
          :target-id (get form :syntax-id),
          :syntax-id (get form :syntax-id),
          :depth 1,
          :form-id (get form :form-id),
          :arity (count binding-ids)}
         body-state
         (assoc
          (assoc
           (assoc
            (assoc
             (assoc state :evaluation-region :function-body)
             :definition-context
             :nested-expression)
            :evaluation-owner-function-syntax-id
            (get form :syntax-id))
           :recur-target-stack
           [target])
          :tail-target-id
          (get target :target-id))
         body-lowered
         (sh07-b51-v16-replay-lower-form request body-state body)]
        (if
         (= (get body-lowered :status) :accepted)
         (let
          [restored
           (assoc
            (assoc
             (assoc
              (assoc
               (get body-lowered :state)
               :evaluation-region
               outer-region)
              :evaluation-owner-function-syntax-id
              outer-owner)
             :recur-target-stack
             outer-target-stack)
            :tail-target-id
            outer-tail-target-id)
           added
           (sh07-b51-v16-replay-add-node
            request
            restored
            form
            :fn
            [(get body-lowered :node-id)]
            {:parameters (get params :value),
             :parameter-form-id (get params :form-id),
             :parameter-syntax-id (get params :syntax-id),
             :fixed-arity (count binding-ids),
             :recur-target-id (get target :target-id)}
            binding-ids
            :function-creation)
           target-added
           (sh07-b51-v16-replay-add-recur-target-record
            (get added :state)
            target
            (get added :node-id))]
          (if
           (= (get target-added :status) :accepted)
           (assoc added :state (get target-added :state))
           target-added))
         body-lowered))
       parameter-descriptors))
     {:status :rejected,
      :rule "C6-CORE-SHAPE",
      :form params,
      :facts {:reason :fn-parameter-vector-required}}))
   {:status :rejected,
    :rule "C6-LOWERING-GAP",
    :form form,
    :facts
    {:reason :fn-multiple-body-or-shape,
     :actual-child-count (count children),
     :supported-child-count 3}})))

(defn
 sh07-b51-v16-replay-let-binding-shape-failure
 [name-form]
 (if
  (contains? #{:vector :map} (get name-form :kind))
  {:status :rejected,
   :rule "C6-LOWERING-GAP",
   :form name-form,
   :facts
   {:reason :let-destructuring-deferred,
    :binding-kind (get name-form :kind)}}
  {:status :rejected,
   :rule "C6-CORE-SHAPE",
   :form name-form,
   :facts
   {:reason :let-binding-symbol-required,
    :binding-kind (get name-form :kind)}}))

(defn
 sh07-b51-v16-replay-let-binding-descriptors
 [request binding-form]
 (let
  [indexes
   (get request :internal-indexes)
   child-ids
   (get binding-form :child-form-ids)]
  (loop
   [remaining child-ids ordinal 0 result []]
   (if
    (= (count remaining) 0)
    {:status :accepted, :descriptors result}
    (let
     [name-form
      (sh07-b51-v16-replay-find-form indexes (first remaining))
      initializer-form
      (sh07-b51-v16-replay-find-form indexes (first (rest remaining)))]
     (if
      (= (get name-form :kind) :symbol)
      (let
       [binding
        (sh07-b51-v16-replay-definition-binding
         indexes
         (get name-form :syntax-id))]
       (if
        (if
         (map? binding)
         (if
          (= (get binding :binding-class) :lexical)
          (=
           (get binding :definition-syntax-id)
           (get name-form :syntax-id))
          false)
         false)
        (recur
         (rest (rest remaining))
         (+ ordinal 1)
         (conj
          result
          {:ordinal ordinal,
           :name-form name-form,
           :initializer-form initializer-form,
           :binding binding}))
        {:status :rejected,
         :rule "C6-VERIFY",
         :form name-form,
         :facts
         {:reason :let-binding-resolution-mismatch,
          :definition-syntax-id (get name-form :syntax-id),
          :scope-id (get name-form :scope-id)}}))
      (sh07-b51-v16-replay-let-binding-shape-failure name-form)))))))

(defn
 sh07-b51-v16-replay-reference-binding-ids-after
 [state prior-count]
 (loop
  [remaining
   (sh07-b51-v16-replay-sequence-after
    (get state :reference-uses)
    prior-count)
   values
   #{}]
  (if
   (= (count remaining) 0)
   values
   (recur
    (rest remaining)
    (conj values (get (first remaining) :binding-id))))))

(defn
 sh07-b51-v16-replay-lower-let-initializers
 [request state descriptors all-binding-ids]
 (loop
  [remaining
   descriptors
   current
   state
   visible-prior-binding-ids
   []
   node-ids
   []
   records
   []]
  (if
   (= (count remaining) 0)
   {:status :accepted,
    :state current,
    :node-ids node-ids,
    :records records,
    :binding-ids all-binding-ids}
   (let
    [descriptor
     (first remaining)
     binding
     (get descriptor :binding)
     name-form
     (get descriptor :name-form)
     initializer-form
     (get descriptor :initializer-form)
     prior-reference-count
     (count (get current :reference-uses))
     initializer
     (sh07-b51-v16-replay-lower-form
      request
      (assoc
       (assoc current :definition-context :nested-expression)
       :tail-target-id
       nil)
      initializer-form)]
    (if
     (= (get initializer :status) :accepted)
     (let
      [used-binding-ids
       (sh07-b51-v16-replay-reference-binding-ids-after
        (get initializer :state)
        prior-reference-count)
       unavailable-binding-ids
       (set
        (sh07-b51-v16-replay-sequence-after
         all-binding-ids
         (get descriptor :ordinal)))
       forbidden
       (loop
        [remaining used-binding-ids values []]
        (if
         (= (count remaining) 0)
         values
         (if
          (contains? unavailable-binding-ids (first remaining))
          (recur (rest remaining) (conj values (first remaining)))
          (recur (rest remaining) values))))]
      (if
       (= (count forbidden) 0)
       (let
        [binding-id
         (get binding :binding-id)
         record
         {:mutability :immutable,
          :let-core-node-id nil,
          :name (get name-form :value),
          :visible-prior-binding-ids visible-prior-binding-ids,
          :definition-form-id (get name-form :form-id),
          :initializer-node-id (get initializer :node-id),
          :ordinal (get descriptor :ordinal),
          :initializer-scope-id (get initializer-form :scope-id),
          :initializer-syntax-id (get initializer-form :syntax-id),
          :binding-id binding-id,
          :initializer-form-id (get initializer-form :form-id),
          :binding-scope-id (get binding :scope-id),
          :definition-syntax-id (get name-form :syntax-id)}]
        (recur
         (rest remaining)
         (get initializer :state)
         (conj visible-prior-binding-ids binding-id)
         (conj node-ids (get initializer :node-id))
         (conj records record)))
       {:status :rejected,
        :rule "C6-VERIFY",
        :form initializer-form,
        :facts
        {:reason :let-initializer-binding-visibility,
         :binding-ordinal (get descriptor :ordinal),
         :visible-prior-binding-ids visible-prior-binding-ids,
         :forbidden-binding-ids forbidden}}))
     initializer)))))

(defn
 sh07-b51-v16-replay-lower-let
 [request state form]
 (let
  [children
   (get form :child-form-ids)
   indexes
   (get request :internal-indexes)
   inherited-tail-target-id
   (get state :tail-target-id)
   binding-form
   (if
    (> (count children) 1)
    (sh07-b51-v16-replay-find-form indexes (get children 1))
    nil)
   body-ids
   (if (> (count children) 2) (vec (rest (rest children))) [])]
  (if
   (if (map? binding-form) (= (get binding-form :kind) :vector) false)
   (let
    [binding-child-ids (get binding-form :child-form-ids)]
    (if
     (sh07-b51-v16-replay-even-count? binding-child-ids)
     (if
      (> (count body-ids) 0)
      (let
       [descriptors
        (sh07-b51-v16-replay-let-binding-descriptors
         request
         binding-form)]
       (if
        (= (get descriptors :status) :accepted)
        (let
         [binding-ids
          (loop
           [remaining (get descriptors :descriptors) values []]
           (if
            (= (count remaining) 0)
            values
            (recur
             (rest remaining)
             (conj
              values
              (get (get (first remaining) :binding) :binding-id)))))
          initializers
          (sh07-b51-v16-replay-lower-let-initializers
           request
           state
           (get descriptors :descriptors)
           binding-ids)]
         (if
          (= (get initializers :status) :accepted)
          (let
           [body
            (sh07-b51-v16-replay-lower-body-form-ids
             request
             (assoc
              (get initializers :state)
              :tail-target-id
              inherited-tail-target-id)
             body-ids)]
           (if
            (= (get body :status) :accepted)
            (let
             [initializer-node-ids
              (get initializers :node-ids)
              body-node-ids
              (get body :node-ids)
              children
              (sh07-b51-v16-replay-vector-append
               initializer-node-ids
               body-node-ids)
              initializer-count
              (count initializer-node-ids)
              child-count
              (count children)
              added
              (sh07-b51-v16-replay-add-node
               request
               (get body :state)
               form
               :let
               children
               {:binding-count initializer-count,
                :binding-vector-syntax-id
                (get binding-form :syntax-id),
                :result-policy
                {:kind :last-body, :child-index (- child-count 1)},
                :body-scope-id
                (get
                 (sh07-b51-v16-replay-find-form
                  indexes
                  (first body-ids))
                 :scope-id),
                :evaluation-order
                :initializers-then-body-left-to-right,
                :outer-scope-id (get form :scope-id),
                :body-child-indexes
                (sh07-b51-v16-replay-index-range
                 initializer-count
                 child-count),
                :binding-vector-form-id (get binding-form :form-id),
                :initializer-child-indexes
                (sh07-b51-v16-replay-index-range 0 initializer-count),
                :body-count (count body-node-ids)}
               binding-ids
               :initializers-then-body-left-to-right)
              let-node-id
              (get added :node-id)
              lexical-records
              (sh07-b51-v16-replay-bind-lexical-records
               (get initializers :records)
               let-node-id)
              existing
              (get (get added :state) :lexical-bindings)
              next-count
              (+ (count existing) (count lexical-records))]
             (if
              (<=
               next-count
               (get
                (sh07-b51-v16-replay-bounds-value)
                :maximum-module-lexical-binding-records))
              (assoc
               added
               :state
               (assoc
                (get added :state)
                :lexical-bindings
                (sh07-b51-v16-replay-vector-append
                 existing
                 lexical-records)))
              {:status :rejected,
               :rule "C6-VERIFY",
               :form form,
               :facts
               {:reason :lexical-binding-record-bound,
                :maximum
                (get
                 (sh07-b51-v16-replay-bounds-value)
                 :maximum-module-lexical-binding-records),
                :observed next-count}}))
            body))
          initializers))
        descriptors))
      {:status :rejected,
       :rule "C6-CORE-SHAPE",
       :form form,
       :facts
       {:reason :let-body-required,
        :actual-body-count 0,
        :required-minimum-body-count 1}})
     {:status :rejected,
      :rule "C6-CORE-SHAPE",
      :form binding-form,
      :facts
      {:reason :let-bindings-even-required,
       :actual-binding-form-count (count binding-child-ids)}}))
   {:status :rejected,
    :rule "C6-CORE-SHAPE",
    :form form,
    :facts
    {:reason :let-binding-vector-required,
     :binding-kind
     (if (map? binding-form) (get binding-form :kind) nil)}})))

(defn
 sh07-b51-v16-replay-loop-binding-descriptors
 [request binding-form]
 (let
  [indexes
   (get request :internal-indexes)
   child-ids
   (get binding-form :child-form-ids)]
  (loop
   [remaining child-ids ordinal 0 values []]
   (if
    (= (count remaining) 0)
    {:status :accepted, :descriptors values}
    (let
     [name-form
      (sh07-b51-v16-replay-find-form indexes (first remaining))
      initializer-form
      (sh07-b51-v16-replay-find-form indexes (first (rest remaining)))]
     (if
      (= (get name-form :kind) :symbol)
      (let
       [binding
        (sh07-b51-v16-replay-definition-binding
         indexes
         (get name-form :syntax-id))]
       (if
        (if
         (map? binding)
         (= (get binding :binding-class) :lexical)
         false)
        (recur
         (rest (rest remaining))
         (+ ordinal 1)
         (conj
          values
          {:ordinal ordinal,
           :name-form name-form,
           :initializer-form initializer-form,
           :binding binding}))
        {:status :rejected,
         :rule "C6-VERIFY",
         :form name-form,
         :facts
         {:reason :loop-binding-resolution-mismatch,
          :semantic-rule "L2-RECUR-TARGET"}}))
      (if
       (contains? #{:vector :map} (get name-form :kind))
       {:status :rejected,
        :rule "C6-LOWERING-GAP",
        :form name-form,
        :facts {:reason :loop-destructuring-deferred}}
       {:status :rejected,
        :rule "C6-CORE-SHAPE",
        :form name-form,
        :facts {:reason :loop-binding-symbol-required}})))))))

(defn
 sh07-b51-v16-replay-loop-binding-records
 [records loop-core-node-id]
 (loop
  [remaining records values []]
  (if
   (= (count remaining) 0)
   values
   (let
    [record (first remaining)]
    (recur
     (rest remaining)
     (conj
      values
      {:mutability :immutable,
       :loop-core-node-id loop-core-node-id,
       :name (get record :name),
       :visible-prior-binding-ids
       (get record :visible-prior-binding-ids),
       :definition-form-id (get record :definition-form-id),
       :initializer-node-id (get record :initializer-node-id),
       :ordinal (get record :ordinal),
       :initializer-scope-id (get record :initializer-scope-id),
       :initializer-syntax-id (get record :initializer-syntax-id),
       :binding-id (get record :binding-id),
       :initializer-form-id (get record :initializer-form-id),
       :binding-scope-id (get record :binding-scope-id),
       :definition-syntax-id (get record :definition-syntax-id)}))))))

(defn
 sh07-b51-v16-replay-lower-loop
 [request state form]
 (let
  [children
   (get form :child-form-ids)
   indexes
   (get request :internal-indexes)
   binding-form
   (if
    (> (count children) 1)
    (sh07-b51-v16-replay-find-form indexes (get children 1))
    nil)
   body-ids
   (if (> (count children) 2) (vec (rest (rest children))) [])]
  (if
   (if (map? binding-form) (= (get binding-form :kind) :vector) false)
   (let
    [binding-child-ids (get binding-form :child-form-ids)]
    (if
     (sh07-b51-v16-replay-even-count? binding-child-ids)
     (if
      (> (count body-ids) 0)
      (let
       [descriptors
        (sh07-b51-v16-replay-loop-binding-descriptors
         request
         binding-form)]
       (if
        (= (get descriptors :status) :accepted)
        (let
         [binding-ids
          (sh07-b51-v16-replay-descriptor-binding-ids
           (get descriptors :descriptors))
          initializers
          (sh07-b51-v16-replay-lower-let-initializers
           request
           state
           (get descriptors :descriptors)
           binding-ids)]
         (if
          (= (get initializers :status) :accepted)
          (let
           [depth (+ (count (get state :recur-target-stack)) 1)]
           (if
            (<=
             depth
             (get
              (sh07-b51-v16-replay-bounds-value)
              :maximum-recur-target-depth))
            (let
             [outer-stack
              (get state :recur-target-stack)
              outer-tail
              (get state :tail-target-id)
              target
              {:target-kind :loop,
               :binding-ids binding-ids,
               :parent-target-id
               (if
                (= (count outer-stack) 0)
                nil
                (get
                 (get outer-stack (- (count outer-stack) 1))
                 :target-id)),
               :body-scope-id
               (get
                (sh07-b51-v16-replay-find-form
                 indexes
                 (first body-ids))
                :scope-id),
               :target-id (get form :syntax-id),
               :syntax-id (get form :syntax-id),
               :depth depth,
               :form-id (get form :form-id),
               :arity (count binding-ids)}
              body-state
              (assoc
               (assoc
                (get initializers :state)
                :recur-target-stack
                (conj outer-stack target))
               :tail-target-id
               (get target :target-id))
              body
              (sh07-b51-v16-replay-lower-body-form-ids
               request
               body-state
               body-ids)]
             (if
              (= (get body :status) :accepted)
              (let
               [initializer-node-ids
                (get initializers :node-ids)
                body-node-ids
                (get body :node-ids)
                all-children
                (sh07-b51-v16-replay-vector-append
                 initializer-node-ids
                 body-node-ids)
                initializer-count
                (count initializer-node-ids)
                child-count
                (count all-children)
                restored
                (assoc
                 (assoc
                  (get body :state)
                  :recur-target-stack
                  outer-stack)
                 :tail-target-id
                 outer-tail)
                added
                (sh07-b51-v16-replay-add-node
                 request
                 restored
                 form
                 :loop
                 all-children
                 {:binding-count initializer-count,
                  :binding-vector-syntax-id
                  (get binding-form :syntax-id),
                  :result-policy
                  {:kind :last-body, :child-index (- child-count 1)},
                  :target-id (get target :target-id),
                  :evaluation-order
                  :initializers-then-body-left-to-right,
                  :body-child-indexes
                  (sh07-b51-v16-replay-index-range
                   initializer-count
                   child-count),
                  :binding-vector-form-id (get binding-form :form-id),
                  :initializer-child-indexes
                  (sh07-b51-v16-replay-index-range
                   0
                   initializer-count),
                  :body-count (count body-node-ids)}
                 binding-ids
                 :initializers-then-body-left-to-right)
                loop-records
                (sh07-b51-v16-replay-loop-binding-records
                 (get initializers :records)
                 (get added :node-id))
                existing
                (get (get added :state) :loop-bindings)
                combined-count
                (+
                 (count (get (get added :state) :lexical-bindings))
                 (+ (count existing) (count loop-records)))]
               (if
                (if
                 (<=
                  combined-count
                  (get
                   (sh07-b51-v16-replay-bounds-value)
                   :maximum-combined-lexical-loop-records))
                 (<=
                  (+ (count existing) (count loop-records))
                  (get
                   (sh07-b51-v16-replay-bounds-value)
                   :maximum-module-loop-binding-records))
                 false)
                (let
                 [with-bindings
                  (assoc
                   (get added :state)
                   :loop-bindings
                   (sh07-b51-v16-replay-vector-append
                    existing
                    loop-records))
                  target-added
                  (sh07-b51-v16-replay-add-recur-target-record
                   with-bindings
                   target
                   (get added :node-id))]
                 (if
                  (= (get target-added :status) :accepted)
                  (assoc added :state (get target-added :state))
                  target-added))
                {:status :rejected,
                 :rule "C6-VERIFY",
                 :form form,
                 :facts
                 {:reason :combined-let-loop-binding-bound,
                  :semantic-rule "L2-RECUR-TARGET"}}))
              body))
            {:status :rejected,
             :rule "C6-VERIFY",
             :form form,
             :facts
             {:reason :recur-target-depth-bound,
              :semantic-rule "L2-RECUR-TARGET"}}))
          initializers))
        descriptors))
      {:status :rejected,
       :rule "C6-CORE-SHAPE",
       :form form,
       :facts {:reason :loop-body-required}})
     {:status :rejected,
      :rule "C6-CORE-SHAPE",
      :form binding-form,
      :facts {:reason :loop-bindings-even-required}}))
   {:status :rejected,
    :rule "C6-CORE-SHAPE",
    :form form,
    :facts {:reason :loop-binding-vector-required}})))

(defn
 sh07-b51-v16-replay-lower-recur
 [request state form]
 (let
  [children
   (get form :child-form-ids)
   argument-ids
   (vec (rest children))
   stack
   (get state :recur-target-stack)]
  (if
   (= (count stack) 0)
   {:status :rejected,
    :rule "C6-VERIFY",
    :form form,
    :facts
    {:reason :recur-target-required, :semantic-rule "L2-RECUR-TARGET"}}
   (let
    [target
     (get stack (- (count stack) 1))
     actual-arity
     (count argument-ids)]
    (if
     (= actual-arity (get target :arity))
     (if
      (= (get state :tail-target-id) (get target :target-id))
      (let
       [arguments
        (sh07-b51-v16-replay-lower-form-ids
         request
         state
         argument-ids)]
       (if
        (= (get arguments :status) :accepted)
        (let
         [added
          (sh07-b51-v16-replay-add-node
           request
           (get arguments :state)
           form
           :recur
           (get arguments :node-ids)
           {:target-id (get target :target-id),
            :target-kind (get target :target-kind),
            :arity actual-arity,
            :semantic-rule "L2-RECUR-TARGET",
            :type-compatibility :pending-sh08}
           (get target :binding-ids)
           :arguments-left-to-right-then-transfer)
          transfers
          (get (get added :state) :recur-transfers)]
         (if
          (<
           (count transfers)
           (get
            (sh07-b51-v16-replay-bounds-value)
            :maximum-module-recur-transfer-records))
          (assoc
           added
           :state
           (assoc
            (get added :state)
            :recur-transfers
            (conj
             transfers
             {:type-compatibility :pending-sh08,
              :target-kind (get target :target-kind),
              :transfer-policy :nearest-lexical-recur-target,
              :target-id (get target :target-id),
              :evaluation-order :arguments-left-to-right,
              :recur-syntax-id (get form :syntax-id),
              :tail-position true,
              :recur-core-node-id (get added :node-id),
              :argument-node-ids (get arguments :node-ids),
              :arity actual-arity,
              :recur-form-id (get form :form-id)})))
          {:status :rejected,
           :rule "C6-VERIFY",
           :form form,
           :facts
           {:reason :recur-transfer-record-bound,
            :semantic-rule "L2-RECUR-TARGET"}}))
        arguments))
      {:status :rejected,
       :rule "C6-VERIFY",
       :form form,
       :facts
       {:reason :recur-tail-position-required,
        :target-id (get target :target-id),
        :semantic-rule "L2-RECUR-TARGET"}})
     {:status :rejected,
      :rule "C6-VERIFY",
      :form form,
      :facts
      {:reason :recur-arity-mismatch,
       :target-id (get target :target-id),
       :target-kind (get target :target-kind),
       :expected-arity (get target :arity),
       :actual-arity actual-arity,
       :semantic-rule "L2-RECUR-TARGET"}})))))

(defn
 sh07-b51-v16-replay-lower-def
 [request state form]
 (if
  (= (get state :definition-context) :top-level)
  (let
   [children (get form :child-form-ids)]
   (if
    (= (count children) 3)
    (let
     [name-form
      (sh07-b51-v16-replay-find-form
       (get request :internal-indexes)
       (first (rest children)))
      value-form
      (sh07-b51-v16-replay-find-form
       (get request :internal-indexes)
       (first (rest (rest children))))
      binding
      (sh07-b51-v16-replay-definition-binding
       (get request :internal-indexes)
       (get name-form :syntax-id))]
     (if
      (= (get name-form :kind) :symbol)
      (if
       (map? binding)
       (let
        [value-lowered
         (sh07-b51-v16-replay-lower-form
          request
          (assoc state :definition-context :nested-expression)
          value-form)]
        (if
         (= (get value-lowered :status) :accepted)
         (let
          [added
           (sh07-b51-v16-replay-add-node
            request
            (get value-lowered :state)
            form
            :def
            [(get value-lowered :node-id)]
            {:name (get name-form :value),
             :name-form-id (get name-form :form-id),
             :name-syntax-id (get name-form :syntax-id),
             :visibility (get binding :visibility)}
            [(get binding :binding-id)]
            :initialize-once)
           next-state
           (assoc
            (get added :state)
            :definitions
            (conj
             (get (get added :state) :definitions)
             {:name (get name-form :value),
              :binding-id (get binding :binding-id),
              :core-node-id (get added :node-id),
              :value-node-id (get value-lowered :node-id),
              :syntax-id (get form :syntax-id)}))]
          (assoc added :state next-state))
         value-lowered))
       {:status :rejected,
        :rule "C6-VERIFY",
        :form form,
        :facts
        {:reason :missing-sh06-definition-binding,
         :definition-syntax-id (get name-form :syntax-id)}})
      {:status :rejected,
       :rule "C6-CORE-SHAPE",
       :form name-form,
       :facts {:reason :def-name-symbol-required}}))
    {:status :rejected,
     :rule "C6-CORE-SHAPE",
     :form form,
     :facts
     {:reason :def-arity,
      :actual-child-count (count children),
      :required-child-count 3}}))
  {:status :rejected,
   :rule "C6-CORE-SHAPE",
   :form form,
   :facts
   {:reason :def-top-level-only,
    :definition-context (get state :definition-context),
    :required-definition-context :top-level}}))

(defn
 sh07-b51-v16-replay-if-branch-region
 [outer-region form role]
 {:kind :conditional-branch,
  :if-syntax-id (get form :syntax-id),
  :if-form-id (get form :form-id),
  :role role,
  :execution :selected-exactly-once,
  :parent-region-kind
  (if (map? outer-region) (get outer-region :kind) outer-region),
  :parent-if-syntax-id
  (if (map? outer-region) (get outer-region :if-syntax-id) nil),
  :parent-branch-role
  (if (map? outer-region) (get outer-region :role) nil)})

(defn
 sh07-b51-v16-replay-lower-if
 [request state form]
 (let
  [children (get form :child-form-ids)]
  (if
   (= (count children) 4)
   (let
    [condition-form
     (sh07-b51-v16-replay-find-form
      (get request :internal-indexes)
      (first (rest children)))
     then-form
     (sh07-b51-v16-replay-find-form
      (get request :internal-indexes)
      (first (rest (rest children))))
     else-form
     (sh07-b51-v16-replay-find-form
      (get request :internal-indexes)
      (first (rest (rest (rest children)))))
     outer-region
     (get state :evaluation-region)
     inherited-tail-target-id
     (get state :tail-target-id)
     condition-lowered
     (sh07-b51-v16-replay-lower-form
      request
      (assoc
       (assoc state :definition-context :nested-expression)
       :tail-target-id
       nil)
      condition-form)]
    (if
     (= (get condition-lowered :status) :accepted)
     (let
      [then-state
       (assoc
        (assoc
         (get condition-lowered :state)
         :evaluation-region
         (sh07-b51-v16-replay-if-branch-region
          outer-region
          form
          :then))
        :tail-target-id
        inherited-tail-target-id)
       then-lowered
       (sh07-b51-v16-replay-lower-form
        request
        (assoc then-state :definition-context :nested-expression)
        then-form)]
      (if
       (= (get then-lowered :status) :accepted)
       (let
        [else-state
         (assoc
          (assoc
           (get then-lowered :state)
           :evaluation-region
           (sh07-b51-v16-replay-if-branch-region
            outer-region
            form
            :else))
          :tail-target-id
          inherited-tail-target-id)
         else-lowered
         (sh07-b51-v16-replay-lower-form
          request
          (assoc else-state :definition-context :nested-expression)
          else-form)]
        (if
         (= (get else-lowered :status) :accepted)
         (let
          [condition-node-id
           (get condition-lowered :node-id)
           then-node-id
           (get then-lowered :node-id)
           else-node-id
           (get else-lowered :node-id)
           added
           (sh07-b51-v16-replay-add-node
            request
            (assoc
             (get else-lowered :state)
             :evaluation-region
             outer-region)
            form
            :if
            [condition-node-id then-node-id else-node-id]
            {:condition-child-index 0,
             :then-child-index 1,
             :else-child-index 2,
             :condition-evaluation :always-first,
             :branch-evaluation :exactly-one,
             :truthiness
             {:false-values [:nil :false], :other-values :true}}
            []
            :condition-then-exclusive-branch)
           control-record
           {:core-node-id (get added :node-id),
            :kind :if,
            :condition-node-id condition-node-id,
            :branches
            [{:role :then,
              :predicate :truthy,
              :core-node-id then-node-id}
             {:role :else,
              :predicate :falsey,
              :core-node-id else-node-id}],
            :branch-exclusivity :exactly-one,
            :truthiness
            {:false-values [:nil :false], :other-values :true},
            :result-policy :selected-branch}
           next-state
           (assoc
            (get added :state)
            :control-flow
            (conj
             (get (get added :state) :control-flow)
             control-record))]
          (assoc added :state next-state))
         else-lowered))
       then-lowered))
     condition-lowered))
   {:status :rejected,
    :rule "C6-CORE-SHAPE",
    :form form,
    :facts
    {:reason :if-arity,
     :actual-child-count (count children),
     :required-child-count 4,
     :required-operands 3}})))

(defn
 sh07-b51-v16-replay-lower-do
 [request state form]
 (let
  [children (get form :child-form-ids) body-ids (vec (rest children))]
  (if
   (> (count body-ids) 0)
   (let
    [body
     (sh07-b51-v16-replay-lower-body-form-ids request state body-ids)]
    (if
     (= (get body :status) :accepted)
     (let
      [node-ids
       (get body :node-ids)
       added
       (sh07-b51-v16-replay-add-node
        request
        (get body :state)
        form
        :do
        node-ids
        {:body-count (count body-ids),
         :evaluation-order :left-to-right,
         :result :last-child,
         :result-child-index (- (count body-ids) 1)}
        []
        :left-to-right)
       control-record
       {:core-node-id (get added :node-id),
        :kind :do,
        :ordered-child-node-ids node-ids,
        :evaluation-order :left-to-right,
        :result-policy
        {:kind :last-child,
         :core-node-id (get node-ids (- (count node-ids) 1))}}
       next-state
       (assoc
        (get added :state)
        :control-flow
        (conj (get (get added :state) :control-flow) control-record))]
      (assoc added :state next-state))
     body))
   {:status :rejected,
    :rule "C6-CORE-SHAPE",
    :form form,
    :facts
    {:reason :do-empty-body,
     :actual-child-count (count children),
     :required-minimum-child-count 2,
     :required-minimum-body-count 1}})))

(defn
 sh07-b51-v16-replay-match-pattern-literal?
 [form]
 (sh07-b51-v16-replay-literal-kind? (get form :kind)))

(defn
 sh07-b51-v16-replay-match-guard-pattern?
 [form]
 (if
  (= (get form :kind) :map)
  (if
   (map? (get form :value))
   (contains? (get form :value) :when)
   false)
  false))

(defn
 sh07-b51-v16-replay-match-pattern-record
 [request
  pattern
  clause-ordinal
  local-ordinal
  parent-local-ordinal
  depth
  path
  pattern-kind
  pattern-value
  vector-width
  binding]
 {:path path,
  :root-local-ordinal 0,
  :local-ordinal local-ordinal,
  :pattern-binding-use-syntax-ids [],
  :pattern-form-id (get pattern :form-id),
  :vector-width vector-width,
  :ordinal nil,
  :clause-ordinal clause-ordinal,
  :parent-local-ordinal parent-local-ordinal,
  :root-ordinal nil,
  :sh06-semantic-projection-id
  (get (get request :lineage) :sh06-semantic-projection-id),
  :pattern-kind pattern-kind,
  :core-node-id nil,
  :depth depth,
  :pattern-binding-id
  (if (map? binding) (get binding :binding-id) nil),
  :pattern-binding-scope-id
  (if (map? binding) (get binding :scope-id) nil),
  :pattern-value pattern-value,
  :authenticated-sh06-artifact-id
  (get (get request :lineage) :authenticated-sh06-artifact-id),
  :pattern-syntax-id (get pattern :syntax-id),
  :parent-ordinal nil})

(defn
 sh07-b51-v16-replay-match-binding-descriptor
 [request pattern]
 (let
  [value
   (get pattern :value)
   binding
   (sh07-b51-v16-replay-definition-binding
    (get request :internal-indexes)
    (get pattern :syntax-id))]
  (if
   (if
    (map? binding)
    (if
     (= (get binding :binding-class) :lexical)
     (if
      (= (get binding :definition-syntax-id) (get pattern :syntax-id))
      (= (get binding :name) value)
      false)
     false)
    false)
   {:status :accepted, :binding binding}
   {:status :rejected,
    :rule "C6-VERIFY",
    :form pattern,
    :facts
    {:reason :match-binding-resolution-mismatch,
     :definition-syntax-id (get pattern :syntax-id),
     :scope-id (get pattern :scope-id)}})))

(defn
 sh07-b51-v16-replay-match-pattern-preflight-children
 [request child-form-ids depth seen]
 (loop
  [remaining child-form-ids current-seen seen]
  (if
   (= (count remaining) 0)
   {:status :accepted, :seen current-seen}
   (let
    [child
     (sh07-b51-v16-replay-find-form
      (get request :internal-indexes)
      (first remaining))
     checked
     (sh07-b51-v16-replay-match-pattern-preflight
      request
      child
      depth
      current-seen)]
    (if
     (= (get checked :status) :accepted)
     (recur (rest remaining) (get checked :seen))
     checked)))))

(defn
 sh07-b51-v16-replay-match-pattern-preflight
 [request pattern depth seen]
 (let
  [kind
   (get pattern :kind)
   value
   (get pattern :value)
   bounds
   (sh07-b51-v16-replay-bounds-value)
   maximum-depth
   (get bounds :maximum-match-pattern-depth)
   maximum-width
   (get bounds :maximum-match-pattern-width)]
  (if
   (> depth maximum-depth)
   {:status :rejected,
    :rule "C6-LOWERING-GAP",
    :form pattern,
    :facts
    {:reason :vector-pattern-depth-bound,
     :maximum maximum-depth,
     :observed depth}}
   (if
    (= kind :symbol)
    (if
     (= value '&)
     {:status :rejected,
      :rule "C6-LOWERING-GAP",
      :form pattern,
      :facts {:reason :variable-width-vector-pattern-deferred}}
     (if
      (= value '_)
      {:status :accepted, :seen seen}
      (if
       (contains? seen value)
       {:status :rejected,
        :rule "C6-LOWERING-GAP",
        :form pattern,
        :facts
        {:reason :duplicate-vector-binding-deferred, :binding value}}
       {:status :accepted, :seen (conj seen value)})))
    (if
     (sh07-b51-v16-replay-match-pattern-literal? pattern)
     {:status :accepted, :seen seen}
     (if
      (= kind :vector)
      (let
       [child-form-ids
        (get pattern :child-form-ids)
        width
        (count child-form-ids)]
       (if
        (> width maximum-width)
        {:status :rejected,
         :rule "C6-LOWERING-GAP",
         :form pattern,
         :facts
         {:reason :vector-pattern-width-bound,
          :maximum maximum-width,
          :observed width}}
        (sh07-b51-v16-replay-match-pattern-preflight-children
         request
         child-form-ids
         (+ depth 1)
         seen)))
      {:status :rejected,
       :rule "C6-LOWERING-GAP",
       :form pattern,
       :facts
       {:reason :unsupported-vector-pattern-leaf,
        :pattern-kind kind}}))))))

(defn
 sh07-b51-v16-replay-match-vector-child-descriptors
 [request
  child-form-ids
  clause-ordinal
  parent-local-ordinal
  depth
  path
  next-local-ordinal]
 (loop
  [remaining
   child-form-ids
   child-index
   0
   next-ordinal
   next-local-ordinal
   records
   []
   bindings
   []]
  (if
   (= (count remaining) 0)
   {:status :accepted,
    :next-local-ordinal next-ordinal,
    :records records,
    :bindings bindings}
   (let
    [child
     (sh07-b51-v16-replay-find-form
      (get request :internal-indexes)
      (first remaining))
     descriptor
     (sh07-b51-v16-replay-match-pattern-node-descriptor
      request
      child
      clause-ordinal
      parent-local-ordinal
      depth
      (conj path child-index)
      next-ordinal)]
    (if
     (= (get descriptor :status) :accepted)
     (recur
      (rest remaining)
      (+ child-index 1)
      (get descriptor :next-local-ordinal)
      (sh07-b51-v16-replay-vector-append
       records
       (get descriptor :records))
      (sh07-b51-v16-replay-vector-append
       bindings
       (get descriptor :bindings)))
     descriptor)))))

(defn
 sh07-b51-v16-replay-match-pattern-node-descriptor
 [request
  pattern
  clause-ordinal
  parent-local-ordinal
  depth
  path
  local-ordinal]
 (let
  [kind
   (get pattern :kind)
   value
   (get pattern :value)
   maximum-depth
   (get
    (sh07-b51-v16-replay-bounds-value)
    :maximum-match-pattern-depth)]
  (if
   (> depth maximum-depth)
   {:status :rejected,
    :rule "C6-LOWERING-GAP",
    :form pattern,
    :facts
    {:reason :vector-pattern-depth-bound,
     :maximum maximum-depth,
     :observed depth}}
   (if
    (= kind :symbol)
    (if
     (= value '&)
     {:status :rejected,
      :rule "C6-LOWERING-GAP",
      :form pattern,
      :facts {:reason :variable-width-vector-pattern-deferred}}
     (if
      (= value '_)
      {:status :accepted,
       :next-local-ordinal (+ local-ordinal 1),
       :records
       [(sh07-b51-v16-replay-match-pattern-record
         request
         pattern
         clause-ordinal
         local-ordinal
         parent-local-ordinal
         depth
         path
         :wildcard
         '_
         nil
         nil)],
       :bindings []}
      (let
       [binding
        (sh07-b51-v16-replay-match-binding-descriptor request pattern)]
       (if
        (= (get binding :status) :accepted)
        {:status :accepted,
         :next-local-ordinal (+ local-ordinal 1),
         :records
         [(sh07-b51-v16-replay-match-pattern-record
           request
           pattern
           clause-ordinal
           local-ordinal
           parent-local-ordinal
           depth
           path
           :binding
           value
           nil
           (get binding :binding))],
         :bindings [(get binding :binding)]}
        binding))))
    (if
     (sh07-b51-v16-replay-match-pattern-literal? pattern)
     (if
      (if
       (= kind :decimal)
       (sh07-b51-v16-replay-exact-decimal-descriptor? value)
       true)
      {:status :accepted,
       :next-local-ordinal (+ local-ordinal 1),
       :records
       [(sh07-b51-v16-replay-match-pattern-record
         request
         pattern
         clause-ordinal
         local-ordinal
         parent-local-ordinal
         depth
         path
         :literal
         value
         nil
         nil)],
       :bindings []}
      {:status :rejected,
       :rule "C6-VERIFY",
       :form pattern,
       :facts {:reason :exact-decimal-descriptor-required}})
     (if
      (= kind :vector)
      (let
       [child-form-ids
        (get pattern :child-form-ids)
        width
        (count child-form-ids)
        preflight
        (sh07-b51-v16-replay-match-pattern-preflight
         request
         pattern
         depth
         #{})]
       (if
        (= (get preflight :status) :accepted)
        (let
         [children
          (sh07-b51-v16-replay-match-vector-child-descriptors
           request
           child-form-ids
           clause-ordinal
           local-ordinal
           (+ depth 1)
           path
           (+ local-ordinal 1))]
         (if
          (= (get children :status) :accepted)
          {:status :accepted,
           :next-local-ordinal (get children :next-local-ordinal),
           :records
           (sh07-b51-v16-replay-vector-append
            [(sh07-b51-v16-replay-match-pattern-record
              request
              pattern
              clause-ordinal
              local-ordinal
              parent-local-ordinal
              depth
              path
              :vector
              nil
              width
              nil)]
            (get children :records)),
           :bindings (get children :bindings)}
          children))
        preflight))
      (if
       (sh07-b51-v16-replay-match-guard-pattern? pattern)
       {:status :rejected,
        :rule "C6-LOWERING-GAP",
        :form pattern,
        :facts {:reason :guard-pattern-deferred}}
       {:status :rejected,
        :rule "C6-LOWERING-GAP",
        :form pattern,
        :facts
        {:reason
         (if
          (= parent-local-ordinal nil)
          :composite-pattern-deferred
          :unsupported-vector-pattern-leaf),
         :pattern-kind kind}})))))))

(defn
 sh07-b51-v16-replay-duplicate-match-binding
 [bindings]
 (loop
  [remaining bindings seen #{}]
  (if
   (= (count remaining) 0)
   nil
   (let
    [binding (first remaining) name (get binding :name)]
    (if
     (contains? seen name)
     name
     (recur (rest remaining) (conj seen name)))))))

(defn
 sh07-b51-v16-replay-match-pattern-descriptor
 [request pattern clause-ordinal]
 (let
  [descriptor
   (sh07-b51-v16-replay-match-pattern-node-descriptor
    request
    pattern
    clause-ordinal
    nil
    0
    []
    0)]
  (if
   (= (get descriptor :status) :accepted)
   (let
    [duplicate
     (sh07-b51-v16-replay-duplicate-match-binding
      (get descriptor :bindings))]
    (if
     (= duplicate nil)
     (assoc
      descriptor
      :pattern-kind
      (get (first (get descriptor :records)) :pattern-kind))
     {:status :rejected,
      :rule "C6-LOWERING-GAP",
      :form pattern,
      :facts
      {:reason :duplicate-vector-binding-deferred,
       :binding duplicate}}))
   descriptor)))

(defn
 sh07-b51-v16-replay-binding-use-syntax-ids-after
 [state prior-count binding-id]
 (loop
  [remaining
   (sh07-b51-v16-replay-sequence-after
    (get state :reference-uses)
    prior-count)
   values
   []]
  (if
   (= (count remaining) 0)
   values
   (if
    (= (get (first remaining) :binding-id) binding-id)
    (recur
     (rest remaining)
     (conj values (get (first remaining) :syntax-id)))
    (recur (rest remaining) values)))))

(defn
 sh07-b51-v16-replay-bind-match-pattern-record-uses
 [records state prior-reference-count]
 (loop
  [remaining records values []]
  (if
   (= (count remaining) 0)
   values
   (let
    [record
     (first remaining)
     binding-id
     (get record :pattern-binding-id)]
    (recur
     (rest remaining)
     (conj
      values
      (assoc
       record
       :pattern-binding-use-syntax-ids
       (if
        (= binding-id nil)
        []
        (sh07-b51-v16-replay-binding-use-syntax-ids-after
         state
         prior-reference-count
         binding-id)))))))))

(defn
 sh07-b51-v16-replay-lower-match-branches
 [request state form branch-form-ids scrutinee-node-id]
 (let
  [indexes
   (get request :internal-indexes)
   branch-count
   (/ (count branch-form-ids) 2)
   inherited-region
   (get state :evaluation-region)
   inherited-tail-target-id
   (get state :tail-target-id)]
  (loop
   [remaining
    branch-form-ids
    clause-ordinal
    0
    current
    state
    branch-node-ids
    []
    clauses
    []
    records
    []
    pattern-records
    []
    binding-ids
    []]
   (if
    (= (count remaining) 0)
    {:status :accepted,
     :state current,
     :branch-node-ids branch-node-ids,
     :clauses clauses,
     :records records,
     :pattern-records pattern-records,
     :binding-ids binding-ids}
    (let
     [pattern
      (sh07-b51-v16-replay-find-form indexes (first remaining))
      branch
      (sh07-b51-v16-replay-find-form indexes (first (rest remaining)))
      descriptor
      (sh07-b51-v16-replay-match-pattern-descriptor
       request
       pattern
       clause-ordinal)]
     (if
      (= (get descriptor :status) :accepted)
      (let
       [bindings
        (get descriptor :bindings)
        binding
        (if
         (= (get descriptor :pattern-kind) :binding)
         (first bindings)
         nil)
        binding-id
        (if (map? binding) (get binding :binding-id) nil)
        prior-reference-count
        (count (get current :reference-uses))
        conditional-region
        {:kind :match-branch,
         :match-syntax-id (get form :syntax-id),
         :clause-ordinal clause-ordinal}
        lowered
        (sh07-b51-v16-replay-lower-form
         request
         (assoc
          (assoc
           (assoc current :evaluation-region conditional-region)
           :definition-context
           :nested-expression)
          :tail-target-id
          inherited-tail-target-id)
         branch)]
       (if
        (= (get lowered :status) :accepted)
        (let
         [restored
          (assoc
           (get lowered :state)
           :evaluation-region
           inherited-region)
          uses
          (if
           binding-id
           (sh07-b51-v16-replay-binding-use-syntax-ids-after
            restored
            prior-reference-count
            binding-id)
           [])
          bound-pattern-records
          (sh07-b51-v16-replay-bind-match-pattern-record-uses
           (get descriptor :records)
           restored
           prior-reference-count)
          descriptor-binding-ids
          (loop
           [remaining-bindings bindings values []]
           (if
            (= (count remaining-bindings) 0)
            values
            (recur
             (rest remaining-bindings)
             (conj
              values
              (get (first remaining-bindings) :binding-id)))))
          clause
          {:pattern-binding-ids descriptor-binding-ids,
           :pattern-form-id (get pattern :form-id),
           :branch-syntax-id (get branch :syntax-id),
           :branch-child-index (+ clause-ordinal 1),
           :clause-ordinal clause-ordinal,
           :pattern-kind (get descriptor :pattern-kind),
           :pattern-binding-id binding-id,
           :pattern-binding-scope-id
           (if binding-id (get binding :scope-id) nil),
           :pattern-value (get pattern :value),
           :branch-form-id (get branch :form-id),
           :pattern-syntax-id (get pattern :syntax-id)}
          record
          {:pattern-binding-ids descriptor-binding-ids,
           :clause-count branch-count,
           :pattern-binding-use-syntax-ids uses,
           :pattern-form-id (get pattern :form-id),
           :branch-syntax-id (get branch :syntax-id),
           :scrutinee-evaluation :evaluate-scrutinee-once,
           :scrutinee-core-node-id scrutinee-node-id,
           :conditional-region conditional-region,
           :ordinal nil,
           :branch-child-index (+ clause-ordinal 1),
           :clause-ordinal clause-ordinal,
           :branch-evaluation :conditionally-evaluate-selected-branch,
           :sh06-semantic-projection-id
           (get (get request :lineage) :sh06-semantic-projection-id),
           :pattern-kind (get descriptor :pattern-kind),
           :branch-core-node-id (get lowered :node-id),
           :core-node-id nil,
           :pattern-binding-id binding-id,
           :pattern-binding-scope-id
           (if binding-id (get binding :scope-id) nil),
           :pattern-value (get pattern :value),
           :branch-form-id (get branch :form-id),
           :authenticated-sh06-artifact-id
           (get
            (get request :lineage)
            :authenticated-sh06-artifact-id),
           :pattern-syntax-id (get pattern :syntax-id)}]
         (recur
          (rest (rest remaining))
          (+ clause-ordinal 1)
          restored
          (conj branch-node-ids (get lowered :node-id))
          (conj clauses clause)
          (conj records record)
          (sh07-b51-v16-replay-vector-append
           pattern-records
           bound-pattern-records)
          (sh07-b51-v16-replay-vector-append
           binding-ids
           descriptor-binding-ids)))
        lowered))
      descriptor))))))

(defn
 sh07-b51-v16-replay-bind-match-branch-records
 [records first-ordinal match-core-node-id]
 (loop
  [remaining records ordinal first-ordinal values []]
  (if
   (= (count remaining) 0)
   values
   (recur
    (rest remaining)
    (+ ordinal 1)
    (conj
     values
     (assoc
      (assoc (first remaining) :ordinal ordinal)
      :core-node-id
      match-core-node-id))))))

(defn
 sh07-b51-v16-replay-bind-match-pattern-records
 [records first-ordinal match-core-node-id]
 (loop
  [remaining
   records
   ordinal
   first-ordinal
   active-clause
   nil
   clause-root-ordinal
   nil
   values
   []]
  (if
   (= (count remaining) 0)
   values
   (let
    [record
     (first remaining)
     clause-ordinal
     (get record :clause-ordinal)
     next-clause?
     (if
      (= active-clause nil)
      true
      (if (= active-clause clause-ordinal) false true))
     root-ordinal
     (if next-clause? ordinal clause-root-ordinal)
     parent-local-ordinal
     (get record :parent-local-ordinal)
     bound
     (assoc
      (assoc
       (assoc
        (assoc record :ordinal ordinal)
        :root-ordinal
        root-ordinal)
       :parent-ordinal
       (if
        (= parent-local-ordinal nil)
        nil
        (+ root-ordinal parent-local-ordinal)))
      :core-node-id
      match-core-node-id)]
    (recur
     (rest remaining)
     (+ ordinal 1)
     clause-ordinal
     root-ordinal
     (conj values bound))))))

(defn
 sh07-b51-v16-replay-complete-lowered-match
 [request form scrutinee branches branch-count]
 (let
  [prior-records
   (get (get branches :state) :match-branch-records)
   observed-count
   (+ (count prior-records) branch-count)
   prior-pattern-records
   (get (get branches :state) :match-pattern-records)
   observed-pattern-count
   (+
    (count prior-pattern-records)
    (count (get branches :pattern-records)))]
  (if
   (<=
    observed-count
    (get
     (sh07-b51-v16-replay-bounds-value)
     :maximum-module-match-branch-records))
   (if
    (<=
     observed-pattern-count
     (get
      (sh07-b51-v16-replay-bounds-value)
      :maximum-module-match-pattern-records))
    (let
     [branch-node-ids
      (get branches :branch-node-ids)
      node-children
      (sh07-b51-v16-replay-vector-append
       [(get scrutinee :node-id)]
       branch-node-ids)
      added
      (sh07-b51-v16-replay-add-node
       request
       (get branches :state)
       form
       :match
       node-children
       {:selection-policy :source-ordered-pattern-candidates,
        :exhaustiveness :pending-sh08,
        :branch-clauses (get branches :clauses),
        :result-type-join :pending-sh08,
        :evaluation-order
        :scrutinee-then-source-ordered-pattern-candidates,
        :sh06-semantic-projection-id
        (get (get request :lineage) :sh06-semantic-projection-id),
        :branch-count branch-count,
        :scrutinee-child-index 0,
        :runtime-reachability :not-asserted-by-sh07-b11,
        :branch-child-indexes
        (sh07-b51-v16-replay-index-range 1 (+ branch-count 1)),
        :authenticated-sh06-artifact-id
        (get (get request :lineage) :authenticated-sh06-artifact-id)}
       (get branches :binding-ids)
       :scrutinee-then-source-ordered-pattern-candidates)
      bound-records
      (sh07-b51-v16-replay-bind-match-branch-records
       (get branches :records)
       (count prior-records)
       (get added :node-id))
      bound-pattern-records
      (sh07-b51-v16-replay-bind-match-pattern-records
       (get branches :pattern-records)
       (count prior-pattern-records)
       (get added :node-id))
      skeleton
      {:branch-core-node-ids branch-node-ids,
       :selection-policy :source-ordered-pattern-candidates,
       :exhaustiveness :pending-sh08,
       :result-type-join :pending-sh08,
       :scrutinee-core-node-id (get scrutinee :node-id),
       :sh06-semantic-projection-id
       (get (get request :lineage) :sh06-semantic-projection-id),
       :runtime-reachability :not-asserted-by-sh07-b11,
       :core-node-id (get added :node-id),
       :authenticated-sh06-artifact-id
       (get (get request :lineage) :authenticated-sh06-artifact-id)}
      next-state
      (assoc
       (assoc
        (assoc
         (get added :state)
         :match-branch-records
         (sh07-b51-v16-replay-vector-append
          prior-records
          bound-records))
        :match-pattern-records
        (sh07-b51-v16-replay-vector-append
         prior-pattern-records
         bound-pattern-records))
       :match-decision-skeletons
       (conj
        (get (get added :state) :match-decision-skeletons)
        skeleton))]
     (assoc added :state next-state))
    {:status :rejected,
     :rule "C6-VERIFY",
     :form form,
     :facts
     {:reason :match-pattern-record-bound,
      :maximum
      (get
       (sh07-b51-v16-replay-bounds-value)
       :maximum-module-match-pattern-records),
      :observed observed-pattern-count}})
   {:status :rejected,
    :rule "C6-VERIFY",
    :form form,
    :facts
    {:reason :match-branch-record-bound,
     :maximum
     (get
      (sh07-b51-v16-replay-bounds-value)
      :maximum-module-match-branch-records),
     :observed observed-count}})))

(defn
 sh07-b51-v16-replay-lower-match
 [request state form]
 (let
  [children (get form :child-form-ids) child-count (count children)]
  (if
   (< child-count 2)
   {:status :rejected,
    :rule "C6-CORE-SHAPE",
    :form form,
    :facts {:reason :match-scrutinee-required}}
   (if
    (= child-count 2)
    {:status :rejected,
     :rule "C6-CORE-SHAPE",
     :form form,
     :facts {:reason :match-clause-required}}
    (let
     [branch-form-ids (vec (rest (rest children)))]
     (if
      (= (sh07-b51-v16-replay-even-count? branch-form-ids) false)
      {:status :rejected,
       :rule "C6-CORE-SHAPE",
       :form form,
       :facts
       {:reason :match-pattern-expression-pairs-required,
        :actual-tail-count (count branch-form-ids)}}
      (let
       [current-record-count
        (count (get state :match-branch-records))
        branch-count
        (/ (count branch-form-ids) 2)]
       (if
        (<=
         (+ current-record-count branch-count)
         (get
          (sh07-b51-v16-replay-bounds-value)
          :maximum-module-match-branch-records))
        (let
         [scrutinee-form
          (sh07-b51-v16-replay-find-form
           (get request :internal-indexes)
           (get children 1))
          scrutinee
          (sh07-b51-v16-replay-lower-form
           request
           (assoc
            (assoc state :definition-context :nested-expression)
            :tail-target-id
            nil)
           scrutinee-form)]
         (if
          (= (get scrutinee :status) :accepted)
          (let
           [branches
            (sh07-b51-v16-replay-lower-match-branches
             request
             (assoc
              (get scrutinee :state)
              :tail-target-id
              (get state :tail-target-id))
             form
             branch-form-ids
             (get scrutinee :node-id))]
           (if
            (= (get branches :status) :accepted)
            (sh07-b51-v16-replay-complete-lowered-match
             request
             form
             scrutinee
             branches
             branch-count)
            branches))
          scrutinee))
        {:status :rejected,
         :rule "C6-VERIFY",
         :form form,
         :facts
         {:reason :match-branch-record-bound,
          :maximum
          (get
           (sh07-b51-v16-replay-bounds-value)
           :maximum-module-match-branch-records),
          :observed (+ current-record-count branch-count)}}))))))))

(defn
 sh07-b51-v16-replay-lower-form
 [request state form]
 (if
  (map? form)
  (if
   (= (get form :kind) :list)
   (let
    [operator (sh07-b51-v16-replay-list-operator request form)]
    (if
     (= operator 'quote)
     (sh07-b51-v16-replay-lower-quote request state form)
     (if
      (= operator 'fn)
      (sh07-b51-v16-replay-lower-fn request state form)
      (if
       (= operator 'def)
       (sh07-b51-v16-replay-lower-def request state form)
       (if
        (= operator 'if)
        (sh07-b51-v16-replay-lower-if request state form)
        (if
         (= operator 'do)
         (sh07-b51-v16-replay-lower-do request state form)
         (if
          (= operator 'let)
          (sh07-b51-v16-replay-lower-let request state form)
          (if
           (= operator 'loop)
           (sh07-b51-v16-replay-lower-loop request state form)
           (if
            (= operator 'recur)
            (sh07-b51-v16-replay-lower-recur request state form)
            (if
             (= operator 'var)
             (sh07-b51-v16-replay-lower-var request state form)
             (if
              (= operator 'set!)
              (sh07-b51-v16-replay-lower-set request state form)
              (if
               (= operator 'throw)
               (sh07-b51-v16-replay-lower-throw request state form)
               (if
                (= operator 'try)
                (sh07-b51-v16-replay-lower-try request state form)
                (if
                 (= operator 'match)
                 (sh07-b51-v16-replay-lower-match request state form)
                 (sh07-b51-v16-replay-lower-call
                  request
                  state
                  form)))))))))))))))
   (sh07-b51-v16-replay-lower-literal request state form))
  {:status :rejected,
   :rule "C6-CORE-SHAPE",
   :form nil,
   :facts
   {:reason :missing-form-record,
    :definition-context (get state :definition-context)}}))

(defn
 sh07-b51-v16-replay-namespace-form?
 [request form]
 (if
  (= (get form :kind) :list)
  (= (sh07-b51-v16-replay-list-operator request form) 'ns)
  false))

(defn
 sh07-b51-v16-replay-special-operator?
 [symbol]
 (contains?
  '#{defconst
     try
     match
     finally
     unsafe
     let
     fn
     do
     if
     unquote
     recur
     loop
     splice-unquote
     syntax-quote
     set!
     var
     quote
     catch
     throw
     def}
  symbol))

(defn
 sh07-b51-v16-replay-executable-resolution?
 [resolution]
 (if
  (= (get resolution :position) :type)
  false
  (if
   (= (get resolution :position) :operator)
   (if
    (sh07-b51-v16-replay-special-operator? (get resolution :symbol))
    false
    true)
   true)))

(defn
 sh07-b51-v16-replay-resolution-syntax-ids
 [request]
 (loop
  [remaining (get request :resolution-table) values #{}]
  (if
   (= (count remaining) 0)
   values
   (if
    (sh07-b51-v16-replay-executable-resolution? (first remaining))
    (recur
     (rest remaining)
     (conj values (get (first remaining) :reference-syntax-id)))
    (recur (rest remaining) values)))))

(defn
 sh07-b51-v16-replay-find-node-by-id
 [nodes node-id]
 (loop
  [remaining nodes]
  (if
   (= (count remaining) 0)
   nil
   (if
    (= (get (first remaining) :node-id) node-id)
    (first remaining)
    (recur (rest remaining))))))

(defn
 sh07-b51-v16-replay-find-definition-by-value-node-id
 [definitions node-id]
 (loop
  [remaining definitions]
  (if
   (= (count remaining) 0)
   nil
   (if
    (= (get (first remaining) :value-node-id) node-id)
    (first remaining)
    (recur (rest remaining))))))

(defn
 sh07-b51-v16-replay-find-definition-by-binding-id
 [definitions binding-id]
 (loop
  [remaining definitions]
  (if
   (= (count remaining) 0)
   nil
   (if
    (= (get (first remaining) :binding-id) binding-id)
    (first remaining)
    (recur (rest remaining))))))

(defn
 sh07-b51-v16-replay-find-function-by-syntax-id
 [records syntax-id]
 (loop
  [remaining records]
  (if
   (= (count remaining) 0)
   nil
   (if
    (= (get (first remaining) :function-syntax-id) syntax-id)
    (first remaining)
    (recur (rest remaining))))))

(defn
 sh07-b51-v16-replay-find-function-by-node-id
 [records node-id]
 (loop
  [remaining records]
  (if
   (= (count remaining) 0)
   nil
   (if
    (= (get (first remaining) :function-core-node-id) node-id)
    (first remaining)
    (recur (rest remaining))))))

(defn
 sh07-b51-v16-replay-build-function-records
 [state]
 (let
  [nodes (get state :nodes) definitions (get state :definitions)]
  (loop
   [remaining nodes ordinal 0 values []]
   (if
    (= (count remaining) 0)
    values
    (let
     [node (first remaining)]
     (if
      (= (get node :core-form) :fn)
      (let
       [attributes
        (get node :attributes)
        source
        (get node :source)
        definition
        (sh07-b51-v16-replay-find-definition-by-value-node-id
         definitions
         (get node :node-id))]
       (recur
        (rest remaining)
        (+ ordinal 1)
        (conj
         values
         {:definition-name
          (if (map? definition) (get definition :name) nil),
          :function-syntax-id (get source :syntax-id),
          :definition-core-node-id
          (if (map? definition) (get definition :core-node-id) nil),
          :body-core-node-id (first (get node :children)),
          :ordinal ordinal,
          :fixed-arity (get attributes :fixed-arity),
          :definition-kind
          (if (map? definition) :named-top-level :anonymous),
          :parameter-binding-ids (get node :resolved-binding-ids),
          :function-form-id (get source :form-id),
          :function-core-node-id (get node :node-id),
          :definition-binding-id
          (if (map? definition) (get definition :binding-id) nil)})))
      (recur (rest remaining) ordinal values)))))))

(defn
 sh07-b51-v16-replay-build-call-edges
 [request state function-records]
 (let
  [definitions
   (get state :definitions)
   indexes
   (get request :internal-indexes)]
  (loop
   [remaining (get state :calls) ordinal 0 values []]
   (if
    (= (count remaining) 0)
    values
    (let
     [call
      (first remaining)
      call-node
      (sh07-b51-v16-replay-find-node-by-id
       (get state :nodes)
       (get call :core-node-id))
      caller-syntax-id
      (get (get call-node :evaluation) :owner-function-syntax-id)
      caller
      (sh07-b51-v16-replay-find-function-by-syntax-id
       function-records
       caller-syntax-id)
      binding
      (sh07-b51-v16-replay-find-binding
       indexes
       (get call :operator-binding-id))
      definition
      (sh07-b51-v16-replay-find-definition-by-binding-id
       definitions
       (get call :operator-binding-id))
      callee
      (if
       (map? definition)
       (sh07-b51-v16-replay-find-function-by-node-id
        function-records
        (get definition :value-node-id))
       nil)]
     (recur
      (rest remaining)
      (+ ordinal 1)
      (conj
       values
       {:callee-binding-id (get call :operator-binding-id),
        :argument-core-node-ids (get call :argument-node-ids),
        :callee-definition-syntax-id
        (get binding :definition-syntax-id),
        :ordered-evaluation-node-ids
        (get call :ordered-evaluation-node-ids),
        :callee-function-core-node-id
        (if (map? callee) (get callee :function-core-node-id) nil),
        :ordinal ordinal,
        :caller-function-core-node-id
        (if (map? caller) (get caller :function-core-node-id) nil),
        :evaluation-order :operator-then-arguments,
        :callee-function-syntax-id
        (if (map? callee) (get callee :function-syntax-id) nil),
        :classification
        (if (map? callee) :local-function :nonlocal-or-nonfunction),
        :call-core-node-id (get call :core-node-id),
        :caller-function-syntax-id
        (if (map? caller) (get caller :function-syntax-id) nil)})))))))

(defn
 sh07-b51-v16-replay-call-edge-adjacency
 [edges direction]
 (loop
  [remaining edges result {}]
  (if
   (= (count remaining) 0)
   result
   (let
    [edge (first remaining)]
    (if
     (= (get edge :classification) :local-function)
     (let
      [source
       (if
        (= direction :forward)
        (get edge :caller-function-syntax-id)
        (get edge :callee-function-syntax-id))
       target
       (if
        (= direction :forward)
        (get edge :callee-function-syntax-id)
        (get edge :caller-function-syntax-id))
       targets
       (get result source [])]
      (if
       (contains? (set targets) target)
       (recur (rest remaining) result)
       (recur
        (rest remaining)
        (assoc result source (conj targets target)))))
     (recur (rest remaining) result))))))

(defn
 sh07-b51-v16-replay-add-unvisited-call-targets
 [targets frontier visited]
 (loop
  [remaining targets next-frontier frontier next-visited visited]
  (if
   (= (count remaining) 0)
   {:frontier next-frontier, :visited next-visited}
   (let
    [target (first remaining)]
    (if
     (contains? next-visited target)
     (recur (rest remaining) next-frontier next-visited)
     (recur
      (rest remaining)
      (conj next-frontier target)
      (conj next-visited target)))))))

(defn
 sh07-b51-v16-replay-reachable-function-syntax-ids
 [adjacency start]
 (loop
  [frontier [start] visited #{start}]
  (if
   (= (count frontier) 0)
   visited
   (let
    [current
     (first frontier)
     targets
     (get adjacency current [])
     added
     (sh07-b51-v16-replay-add-unvisited-call-targets
      targets
      (vec (rest frontier))
      visited)]
    (recur (get added :frontier) (get added :visited))))))

(defn
 sh07-b51-v16-replay-self-call-edge?
 [edges function-syntax-id]
 (loop
  [remaining edges]
  (if
   (= (count remaining) 0)
   false
   (let
    [edge (first remaining)]
    (if
     (if
      (= (get edge :classification) :local-function)
      (if
       (= (get edge :caller-function-syntax-id) function-syntax-id)
       (= (get edge :callee-function-syntax-id) function-syntax-id)
       false)
      false)
     true
     (recur (rest remaining)))))))

(defn
 sh07-b51-v16-replay-mutually-reachable-functions
 [function-records outgoing incoming start-syntax-id]
 (let
  [forward
   (sh07-b51-v16-replay-reachable-function-syntax-ids
    outgoing
    start-syntax-id)
   backward
   (sh07-b51-v16-replay-reachable-function-syntax-ids
    incoming
    start-syntax-id)]
  (loop
   [remaining function-records values []]
   (if
    (= (count remaining) 0)
    values
    (let
     [record
      (first remaining)
      candidate
      (get record :function-syntax-id)]
     (if
      (if
       (= (get record :definition-kind) :named-top-level)
       (if
        (contains? forward candidate)
        (contains? backward candidate)
        false)
       false)
      (recur (rest remaining) (conj values record))
      (recur (rest remaining) values)))))))

(defn
 sh07-b51-v16-replay-component-edge-ordinals
 [edges syntax-ids]
 (let
  [members (set syntax-ids)]
  (loop
   [remaining edges values []]
   (if
    (= (count remaining) 0)
    values
    (let
     [edge (first remaining)]
     (if
      (if
       (= (get edge :classification) :local-function)
       (if
        (contains? members (get edge :caller-function-syntax-id))
        (contains? members (get edge :callee-function-syntax-id))
        false)
       false)
      (recur (rest remaining) (conj values (get edge :ordinal)))
      (recur (rest remaining) values)))))))

(defn
 sh07-b51-v16-replay-add-values-to-set
 [values target]
 (loop
  [remaining values result target]
  (if
   (= (count remaining) 0)
   result
   (recur (rest remaining) (conj result (first remaining))))))

(defn
 sh07-b51-v16-replay-build-recursion-components
 [function-records edges]
 (let
  [outgoing
   (sh07-b51-v16-replay-call-edge-adjacency edges :forward)
   incoming
   (sh07-b51-v16-replay-call-edge-adjacency edges :reverse)]
  (loop
   [remaining function-records assigned #{} ordinal 0 values []]
   (if
    (= (count remaining) 0)
    values
    (let
     [record
      (first remaining)
      syntax-id
      (get record :function-syntax-id)]
     (if
      (if
       (= (get record :definition-kind) :named-top-level)
       (if (contains? assigned syntax-id) false true)
       false)
      (let
       [component
        (sh07-b51-v16-replay-mutually-reachable-functions
         function-records
         outgoing
         incoming
         syntax-id)
        cyclic?
        (if
         (> (count component) 1)
         true
         (sh07-b51-v16-replay-self-call-edge? edges syntax-id))]
       (if
        cyclic?
        (let
         [syntax-ids
          (loop
           [members component result []]
           (if
            (= (count members) 0)
            result
            (recur
             (rest members)
             (conj result (get (first members) :function-syntax-id)))))
          node-ids
          (loop
           [members component result []]
           (if
            (= (count members) 0)
            result
            (recur
             (rest members)
             (conj
              result
              (get (first members) :function-core-node-id)))))]
         (recur
          (rest remaining)
          (sh07-b51-v16-replay-add-values-to-set syntax-ids assigned)
          (+ ordinal 1)
          (conj
           values
           {:ordinal ordinal,
            :kind
            (if
             (= (count component) 1)
             :self-recursive
             :mutually-recursive),
            :function-syntax-ids syntax-ids,
            :function-core-node-ids node-ids,
            :internal-call-edge-ordinals
            (sh07-b51-v16-replay-component-edge-ordinals
             edges
             syntax-ids)})))
        (recur (rest remaining) assigned ordinal values)))
      (recur (rest remaining) assigned ordinal values)))))))

(defn
 sh07-b51-v16-replay-finalize-function-products
 [request state]
 (let
  [functions
   (sh07-b51-v16-replay-build-function-records state)
   edges
   (sh07-b51-v16-replay-build-call-edges request state functions)
   components
   (sh07-b51-v16-replay-build-recursion-components functions edges)]
  (if
   (<=
    (count functions)
    (get (sh07-b51-v16-replay-bounds-value) :maximum-module-bindings))
   (if
    (<=
     (count edges)
     (get
      (sh07-b51-v16-replay-bounds-value)
      :maximum-module-call-records))
    (if
     (<=
      (count components)
      (get
       (sh07-b51-v16-replay-bounds-value)
       :maximum-module-bindings))
     {:status :accepted,
      :state
      (assoc
       (assoc
        (assoc state :function-records functions)
        :call-edges
        edges)
       :recursion-components
       components)}
     {:status :rejected,
      :rule "C6-VERIFY",
      :form nil,
      :facts {:reason :recursion-component-bound}})
    {:status :rejected,
     :rule "C6-VERIFY",
     :form nil,
     :facts {:reason :call-edge-record-bound}})
   {:status :rejected,
    :rule "C6-VERIFY",
    :form nil,
    :facts {:reason :function-record-bound}})))

(defn
 sh07-b51-v16-replay-finish-top-level
 [request state roots]
 (let
  [expected
   (sh07-b51-v16-replay-resolution-syntax-ids request)
   observed
   (get state :used-reference-syntax-ids)]
  (if
   (= expected observed)
   (if
    (<=
     (count (get state :reference-uses))
     (get
      (sh07-b51-v16-replay-bounds-value)
      :maximum-module-reference-use-records))
    (if
     (<=
      (count (get state :var-references))
      (get
       (sh07-b51-v16-replay-bounds-value)
       :maximum-module-var-reference-records))
     (if
      (<=
       (count (get state :mutations))
       (get
        (sh07-b51-v16-replay-bounds-value)
        :maximum-module-mutation-records))
      (if
       (<=
        (count (get state :error-transfers))
        (get
         (sh07-b51-v16-replay-bounds-value)
         :maximum-module-error-transfer-records))
       (if
        (<=
         (count (get state :error-handlers))
         (get
          (sh07-b51-v16-replay-bounds-value)
          :maximum-module-error-handler-records))
        (if
         (<=
          (count (get state :calls))
          (get
           (sh07-b51-v16-replay-bounds-value)
           :maximum-module-call-records))
         (if
          (<=
           (count (get state :keyword-lookups))
           (get
            (sh07-b51-v16-replay-bounds-value)
            :maximum-module-keyword-lookup-records))
          (if
           (if
            (<=
             (+
              (count (get state :lexical-bindings))
              (count (get state :loop-bindings)))
             (get
              (sh07-b51-v16-replay-bounds-value)
              :maximum-combined-lexical-loop-records))
            (if
             (<=
              (count (get state :recur-targets))
              (get
               (sh07-b51-v16-replay-bounds-value)
               :maximum-module-recur-target-records))
             (<=
              (count (get state :recur-transfers))
              (get
               (sh07-b51-v16-replay-bounds-value)
               :maximum-module-recur-transfer-records))
             false)
            false)
           (let
            [finalized
             (sh07-b51-v16-replay-finalize-function-products
              request
              state)]
            (if
             (= (get finalized :status) :accepted)
             {:status :accepted,
              :state (get finalized :state),
              :roots roots}
             finalized))
           {:status :rejected,
            :rule "C6-VERIFY",
            :form nil,
            :facts
            {:reason :b8-product-record-bound,
             :maximum
             (get
              (sh07-b51-v16-replay-bounds-value)
              :maximum-combined-lexical-loop-records),
             :observed
             (+
              (count (get state :lexical-bindings))
              (count (get state :loop-bindings)))}})
          {:status :rejected,
           :rule "C6-VERIFY",
           :form nil,
           :facts
           {:reason :keyword-lookup-record-bound,
            :maximum
            (get
             (sh07-b51-v16-replay-bounds-value)
             :maximum-module-keyword-lookup-records),
            :observed (count (get state :keyword-lookups))}})
         {:status :rejected,
          :rule "C6-VERIFY",
          :form nil,
          :facts
          {:reason :call-record-bound,
           :maximum
           (get
            (sh07-b51-v16-replay-bounds-value)
            :maximum-module-call-records),
           :observed (count (get state :calls))}})
        {:status :rejected,
         :rule "C6-VERIFY",
         :form nil,
         :facts
         {:reason :error-handler-record-bound,
          :maximum
          (get
           (sh07-b51-v16-replay-bounds-value)
           :maximum-module-error-handler-records),
          :observed (count (get state :error-handlers))}})
       {:status :rejected,
        :rule "C6-VERIFY",
        :form nil,
        :facts
        {:reason :error-transfer-record-bound,
         :maximum
         (get
          (sh07-b51-v16-replay-bounds-value)
          :maximum-module-error-transfer-records),
         :observed (count (get state :error-transfers))}})
      {:status :rejected,
       :rule "C6-VERIFY",
       :form nil,
       :facts
       {:reason :mutation-record-bound,
        :maximum
        (get
         (sh07-b51-v16-replay-bounds-value)
         :maximum-module-mutation-records),
        :observed (count (get state :mutations))}})
     {:status :rejected,
      :rule "C6-VERIFY",
      :form nil,
      :facts
      {:reason :var-reference-record-bound,
       :maximum
       (get
        (sh07-b51-v16-replay-bounds-value)
        :maximum-module-var-reference-records),
       :observed (count (get state :var-references))}})
    {:status :rejected,
     :rule "C6-VERIFY",
     :form nil,
     :facts
     {:reason :reference-use-record-bound,
      :maximum
      (get
       (sh07-b51-v16-replay-bounds-value)
       :maximum-module-reference-use-records),
      :observed (count (get state :reference-uses))}})
   {:status :rejected,
    :rule "C6-VERIFY",
    :form nil,
    :facts
    {:reason :sh06-resolution-bijection-mismatch,
     :expected-count (count expected),
     :observed-count (count observed)}})))

(defn
 sh07-b51-v16-replay-lower-fragment-roots
 [request root-ids ordinal state roots]
 (let
  [form-id (get root-ids ordinal)]
  (if
   (= form-id nil)
   {:status :accepted, :state state, :roots roots}
   (let
    [form
     (sh07-b51-v16-replay-find-form
      (get request :internal-indexes)
      form-id)]
    (if
     (map? form)
     (if
      (sh07-b51-v16-replay-namespace-form? request form)
      (sh07-b51-v16-replay-lower-fragment-roots
       request
       root-ids
       (+ ordinal 1)
       state
       roots)
      (let
       [lowered (sh07-b51-v16-replay-lower-form request state form)]
       (if
        (= (get lowered :status) :accepted)
        (sh07-b51-v16-replay-lower-fragment-roots
         request
         root-ids
         (+ ordinal 1)
         (assoc (get lowered :state) :definition-context :top-level)
         (conj roots (get lowered :node-id)))
        lowered)))
     {:status :rejected,
      :rule "C6-VERIFY",
      :form nil,
      :facts
      {:reason :missing-fragment-root-form-record,
       :ordinal ordinal,
       :top-level-form-id form-id}})))))

(defn
 sh07-b51-v16-replay-lower-fragments
 [request fragments state roots]
 (if
  (= (count fragments) 0)
  (sh07-b51-v16-replay-finish-top-level request state roots)
  (let
   [fragment
    (first fragments)
    lowered
    (sh07-b51-v16-replay-lower-fragment-roots
     request
     (get fragment :root-form-ids)
     0
     state
     roots)]
   (if
    (= (get lowered :status) :accepted)
    (sh07-b51-v16-replay-lower-fragments
     request
     (rest fragments)
     (get lowered :state)
     (get lowered :roots))
    lowered))))

(defn
 sh07-b51-v16-replay-lower-top-level
 [request]
 (sh07-b51-v16-replay-lower-fragments
  request
  (get request :fragment-manifest)
  (sh07-b51-v16-replay-empty-state)
  []))

(defn sh07-b51-v16-pre-frontier-lowering-replay
  [request frontier]
  (let [indexed-request
        (assoc
         request :internal-indexes
         (sh07-b51-v16-replay-index-request request))
        lowered
        (sh07-b51-v16-replay-lower-top-level indexed-request)
        facts (get lowered :facts)]
    (if (= (get lowered :status) :rejected)
      (if (= (get lowered :rule) "C6-LOWERING-GAP")
        (if (= (get lowered :form) (get frontier :form))
          (if (= (get facts :reason) (get frontier :reason))
            (if (= (get (get frontier :form) :kind) :vector)
              {:status :accepted
               :terminal :first-exact-vector-deferred-stop
               :frozen-b47-equivalent-lowering-result lowered
               :disjoint-b51-lowering-replay true
               :origin-and-request-prechecks-inherited-from-raw-witness true}
              {:status :rejected :reason :post-waiver-binding-kind
               :partial-products []})
            {:status :rejected :reason :post-waiver-frontier-reason
             :partial-products []})
          {:status :rejected :reason :post-waiver-frontier-form
           :partial-products []})
        {:status :rejected :reason :post-waiver-earlier-lowering-rule
         :partial-products []})
      {:status :rejected :reason :post-waiver-lowering-did-not-reject
       :partial-products []})))

(defn sh07-b51-v16-post-waiver-terminal-replay
  [raw-carrier outcome]
  (let [request (get raw-carrier :authenticated-sh06-request)
        artifact (get raw-carrier :sh06-resolution-artifact)
        indexes (sh07-b51-index-request request)
        records
        (sh07-b51-v16-record-shape-replay artifact request indexes)
        frontier (sh07-b51-first-vector-frontier request)
        lowering
        (if (= (get frontier :status) :accepted)
          (sh07-b51-v16-pre-frontier-lowering-replay
           request frontier)
          frontier)]
    (if (= (get records :status) :accepted)
      (if (> (count (get records :failing-binding-ids)) 0)
        (if (= (get records :failing-binding-ids)
               (get outcome :failing-binding-ids))
          (if (= (get lowering :status) :accepted)
            (if (= (get lowering :terminal)
                   :first-exact-vector-deferred-stop)
              {:status :accepted
               :terminal-status
               :all-invariants-before-expected-vector-stop-passed
               :record-replay records
               :lowering-replay lowering}
              {:status :rejected :reason :post-waiver-terminal-kind
               :partial-products []})
            lowering)
          {:status :rejected :reason :post-waiver-failure-set
           :partial-products []})
        {:status :rejected :reason :post-waiver-empty-failure-set
         :partial-products []})
      records)))

(defn sh07-b51-raw-first-diagnostic [raw-carrier]
  (let [returned
        (get (get (get raw-carrier :predecessor-raw-outcome)
                  :direct-template-observation)
             :returned)
        diagnostics (get returned :diagnostics)]
    (if (= (get returned :status) :rejected)
      (if (vector? diagnostics)
        (if (> (count diagnostics) 0)
          {:status :accepted :diagnostic (first diagnostics)}
          {:status :rejected :reason :raw-diagnostic-missing
           :partial-products []})
        {:status :rejected :reason :raw-diagnostic-vector
         :partial-products []})
      {:status :rejected :reason :raw-vector-outcome-not-rejected
       :partial-products []})))

(defn sh07-b51-vector-outcome-frontier-authenticated?
  [raw-carrier outcome]
  (let [request (get raw-carrier :authenticated-sh06-request)
        frontier (sh07-b51-first-vector-frontier request)
        raw (sh07-b51-raw-first-diagnostic raw-carrier)
        diagnostic (get raw :diagnostic)
        rule-specific (get (get diagnostic :facts) :rule-specific)
        no-form?
        (= (get outcome :outcome-kind)
           :b51-vector-frontier-rejected-after-no-form-waiver)
        waiver-replay
        (if no-form?
          (sh07-b51-v16-post-waiver-terminal-replay
           raw-carrier outcome)
          {:status :accepted :failing-binding-ids []})]
    (if (= (get frontier :status) :accepted)
      (if (= (get raw :status) :accepted)
        (if (= (get outcome :frontier-owner)
               (get frontier :owner-kind))
          (if (= (get outcome :frontier-rule) "C6-LOWERING-GAP")
            (if (= (get outcome :frontier-reason)
                   (get frontier :reason))
              (if (= (get outcome :frontier-binding-kind) :vector)
                (if (= (get outcome :frontier-form-id)
                       (get (get frontier :form) :form-id))
                  (if (= (get outcome :frontier-coordinate)
                         (get frontier :coordinate))
                    (if no-form?
                      (if (= (get waiver-replay :status) :accepted)
                        (if (= (get waiver-replay :terminal-status)
                               :all-invariants-before-expected-vector-stop-passed)
                          (if (= (get
                                  (get waiver-replay :record-replay)
                                  :only-waived-predicate)
                                 :authoritative-record-shape)
                            (if (= (get diagnostic :rule) "C6-VERIFY")
                              (= (get rule-specific :reason)
                                 :authoritative-record-shape)
                              false)
                            false)
                          false)
                        false)
                      (if (= (get diagnostic :rule)
                             "C6-LOWERING-GAP")
                        (if (= (get diagnostic :form-id)
                               (get (get frontier :diagnostic-form)
                                    :form-id))
                          (if (= (get rule-specific :reason)
                                 (get outcome :frontier-reason))
                            (= (get rule-specific :binding-kind) :vector)
                            false)
                          false)
                        false))
                    false)
                  false)
                false)
              false)
            false)
          false)
        false)
      false)))

(defn sh07-b51-authority-outcome-preimages-agree?
  [authority outcome]
  (if (= (get authority :implementation-semantic-id)
         (get outcome :implementation-semantic-id))
    (if (= (get authority :contract-semantic-id)
           (get outcome :contract-semantic-id))
      (if (= (get authority :same-request-semantic-id)
             (get outcome :same-request-semantic-id))
        (if (= (get authority :outcome-kind) (get outcome :outcome-kind))
          (if (= (get authority :semantic-artifact-id)
                 (if (= (get outcome :outcome-kind) :legacy-v16-accepted)
                   (get outcome :v16-semantic-artifact-id)
                   (get outcome :semantic-artifact-id)))
            (= (get authority :authorization)
               (get outcome :authorization))
            false)
          false)
        false)
      false)
    false))

(defn sh07-b51-compose-numbered-preimages-authenticated
  [raw-carrier owner-plans supplied-specs digest-requests
   implementation-preimage contract-preimage outcome-preimage
   authority-reference authority-preimage same-request-reference
   same-request-preimage transcript-reference]
  (let [request (get raw-carrier :authenticated-sh06-request)]
  (if (sh07-b51-raw-carrier-shape? raw-carrier)
  (if (sh07-b51-implementation-preimage-for-carrier?
       raw-carrier implementation-preimage)
  (if (sh07-b51-contract-preimage-for-carrier?
       raw-carrier contract-preimage)
  (if (sh07-b51-vector-outcome-preimage-shape? outcome-preimage)
  (if (sh07-b51-vector-outcome-frontier-authenticated?
       raw-carrier outcome-preimage)
  (if (sh07-b51-no-form-outcome-authenticated?
       raw-carrier outcome-preimage)
  (if (sh07-b51-predecessor-authority-preimage-shape?
       authority-preimage)
    (if (sh07-b51-same-request-preimage-shape?
         request same-request-preimage)
      (if (= (get authority-preimage :same-request-semantic-id)
             same-request-reference)
        (if (sh07-b51-authority-outcome-preimages-agree?
             authority-preimage outcome-preimage)
        (if (contains?
             #{:b51-vector-frontier-rejected
               :b51-vector-frontier-rejected-after-no-form-waiver}
             (get authority-preimage :outcome-kind))
      (let [authority
            (sh07-b51-authenticate-scheduled-reference
             authority-reference digest-requests
             :sh07-b51-predecessor-authority-id authority-preimage
             0 :0c 0 :0c-authority 5 0)
            same-request
            (sh07-b51-authenticate-scheduled-reference
             same-request-reference digest-requests
             :sh07-b51-same-request-semantic-id same-request-preimage
             0 :0a 2 :0a-same-request 2 0)
            implementation
            (sh07-b51-authenticate-scheduled-reference
             (get authority-preimage :implementation-semantic-id)
             digest-requests :sh07-b51-implementation-semantic-id
             implementation-preimage 0 :0a 0 :0a-implementation 0 0)
            contract
            (sh07-b51-authenticate-scheduled-reference
             (get authority-preimage :contract-semantic-id)
             digest-requests :sh07-b51-contract-semantic-id
             contract-preimage 0 :0a 1 :0a-contract 1 0)
            outcome
            (sh07-b51-authenticate-scheduled-reference
             (get authority-preimage :outcome-semantic-id)
             digest-requests :sh07-b51-predecessor-outcome-semantic-id
             outcome-preimage 0 :0b 0 :0b-outcome 4 0)]
        (if (= (get implementation :status) :accepted)
        (if (= (get contract :status) :accepted)
        (if (= (get outcome :status) :accepted)
        (if (= (get authority :status) :accepted)
          (if (= (get same-request :status) :accepted)
            (let [built
                  (sh07-b51-compose-numbered-preimages
                   request owner-plans supplied-specs authority-reference
                   same-request-reference)]
              (if (= (get built :status) :accepted)
                (let [core-count
                      (get
                       (get (get built :occurrence-replay)
                            :category-counts)
                       :global-core-node-ordinal)
                      numbered
                      (sh07-b51-authenticate-numbered-row-references
                       (get built :numbered-preimage-rows)
                       digest-requests core-count)
                      transcript
                      (sh07-b51-authenticate-scheduled-reference
                       transcript-reference digest-requests
                       :sh07-b51-slot-extraction-transcript-id
                       (get built :slot-extraction-transcript-preimage)
                       2 nil nil :t2-transcript 13 0)]
                  (if (= (get numbered :status) :accepted)
                    (if (= (get transcript :status) :accepted)
                      (assoc
                       (assoc
                        (assoc
                         (assoc built :authenticated-authority-request
                                (get authority :request))
                         :authenticated-same-request-request
                         (get same-request :request))
                        :authenticated-numbered-requests
                        (get numbered :requests))
                       :authenticated-transcript-request
                       (get transcript :request))
                      transcript)
                    numbered))
                built))
            same-request)
          authority)
          outcome)
          contract)
          implementation))
          {:status :rejected :reason :authority-vector-branch
           :partial-products []})
        {:status :rejected :reason :authority-outcome-preimage-join
         :partial-products []})
        {:status :rejected :reason :authority-same-request-join
         :partial-products []})
      {:status :rejected :reason :same-request-preimage-domain
       :partial-products []})
    {:status :rejected :reason :authority-preimage-domain
     :partial-products []})
    {:status :rejected :reason :no-form-outcome-authentication
     :partial-products []})
    {:status :rejected :reason :outcome-frontier-authentication
     :partial-products []})
    {:status :rejected :reason :outcome-preimage-shape
     :partial-products []})
    {:status :rejected :reason :contract-preimage-shape
     :partial-products []})
    {:status :rejected :reason :implementation-preimage-shape
     :partial-products []})
    {:status :rejected :reason :raw-carrier-shape
     :partial-products []})))

(defn sh07-b51-success-purpose-spec [purpose]
  (if (= purpose :sh07-b51-implementation-semantic-id)
    {:preimage-domain
     :gravity/sh07-b51-linked-implementation-semantic-id-preimage-v3
     :tier 0 :subtier :0a :batch :0a-implementation :batch-rank 0
     :branch :both :cardinality :one-per-C}
    (if (= purpose :sh07-b51-contract-semantic-id)
      {:preimage-domain :gravity/sh07-b51-contract-semantic-id-preimage-v18
       :tier 0 :subtier :0a :batch :0a-contract :batch-rank 1
       :branch :both :cardinality :one}
      (if (= purpose :sh07-b51-same-request-semantic-id)
        {:preimage-domain :gravity/sh07-b51-same-request-binding-v18
         :tier 0 :subtier :0a :batch :0a-same-request :batch-rank 2
         :branch :both :cardinality :one}
        (if (= purpose :sh07-b51-v16-verification-semantic-id)
          {:preimage-domain :gravity/sh07-b51-v16-verification-semantic-v18
           :tier 0 :subtier :0a :batch :0a-v16-verification :batch-rank 3
           :branch :accepted :cardinality :one}
          (if (= purpose :sh07-b51-predecessor-outcome-semantic-id)
            {:preimage-domain :gravity/sh07-b51-predecessor-outcome-semantic-v18
             :tier 0 :subtier :0b :batch :0b-outcome :batch-rank 4
             :branch :both :cardinality :one}
            (if (= purpose :sh07-b51-predecessor-authority-id)
              {:preimage-domain :gravity/sh07-b51-predecessor-authority-v18
               :tier 0 :subtier :0c :batch :0c-authority :batch-rank 5
               :branch :both :cardinality :one}
              (if (= purpose :sh07-b51-core-node-id)
                {:preimage-domain :gravity/sh07-b51-core-node-id-preimage-v18
                 :tier 0 :subtier :0d :batch :0d-core-node :batch-rank 6
                 :branch :rejected :cardinality :per-rejected-core-node}
                (if (= purpose :sh07-b51-product-node-id)
                  {:preimage-domain :gravity/sh07-b51-product-node-id-preimage-v18
                   :tier 0 :subtier :0d :batch :0d-product-node
                   :batch-rank 7 :branch :both
                   :cardinality :per-supplemental-product}
                  (if (= purpose :sh07-b51-binding-slot-id)
                    {:preimage-domain :gravity/sh07-b51-binding-slot-id-preimage-v18
                     :tier 1 :subtier nil :batch :t1-slot :batch-rank 8
                     :branch :both :cardinality :per-slot}
                    (if (= purpose :sh07-b51-binding-extraction-id)
                      {:preimage-domain
                       :gravity/sh07-b51-binding-extraction-id-preimage-v18
                       :tier 1 :subtier nil :batch :t1-extraction
                       :batch-rank 9 :branch :both
                       :cardinality :per-extraction}
                      (if (= purpose :sh07-b51-runtime-check-id)
                        {:preimage-domain :gravity/sh07-b51-runtime-check-id-preimage-v18
                         :tier 2 :subtier nil :batch :t2-runtime-check
                         :batch-rank 10 :branch :both
                         :cardinality :per-vector-node-use}
                        (if (= purpose :sh07-b51-publication-event-id)
                          {:preimage-domain
                           :gravity/sh07-b51-publication-event-id-preimage-v18
                           :tier 2 :subtier nil :batch :t2-publication
                           :batch-rank 11 :branch :both
                           :cardinality :per-event}
                          (if (= purpose :sh07-b51-recur-slot-mapping-id)
                            {:preimage-domain
                             :gravity/sh07-b51-recur-slot-mapping-id-preimage-v18
                             :tier 2 :subtier nil :batch :t2-recur-mapping
                             :batch-rank 12 :branch :both
                             :cardinality :per-recur}
                            (if (= purpose
                                   :sh07-b51-slot-extraction-transcript-id)
                              {:preimage-domain
                               :gravity/sh07-b51-slot-extraction-transcript-id-preimage-v18
                               :tier 2 :subtier nil :batch :t2-transcript
                               :batch-rank 13 :branch :both
                               :cardinality :one}
                              (if (= purpose :sh07-b51-core-identity-id)
                                {:preimage-domain
                                 :gravity/sh07-b51-core-identity-preimage-v18
                                 :tier 3 :subtier nil :batch :t3-core-identity
                                 :batch-rank 14 :branch :both
                                 :cardinality :one}
                                (if (= purpose
                                       :sh07-b51-predecessor-observation-id)
                                  {:preimage-domain
                                   :gravity/sh07-b51-linked-predecessor-observation-preimage-v3
                                   :tier 4 :subtier nil
                                   :batch :t4-observation :batch-rank 15
                                   :branch :both :cardinality :one}
                                  (if (= purpose
                                         :sh07-b51-provenance-binding-id)
                                    {:preimage-domain
                                     :gravity/sh07-b51-linked-provenance-binding-preimage-v3
                                     :tier 4 :subtier nil
                                     :batch :t4-provenance :batch-rank 16
                                     :branch :both :cardinality :one}
                                    (if (= purpose
                                           :sh07-b51-independent-verifier-binding-id)
                                      {:preimage-domain
                                       :gravity/sh07-b51-independent-verifier-binding-preimage-v18
                                       :tier 5 :subtier nil
                                       :batch :t5-verifier :batch-rank 17
                                       :branch :both :cardinality :one}
                                      (if (= purpose
                                             :sh07-b51-final-artifact-binding-id)
                                        {:preimage-domain
                                         :gravity/sh07-b51-final-artifact-binding-preimage-v18
                                         :tier 6 :subtier nil
                                         :batch :t6-final :batch-rank 18
                                         :branch :both :cardinality :one}
                                        nil))))))))))))))))))))

(defn sh07-b51-success-request-base-shape? [request]
  (if (sh07-b51-exact-keys?
       request
       #{:ordinal :tier :subtier :subtier-ordinal :batch :batch-rank
         :batch-ordinal :purpose :preimage})
    (let [spec (sh07-b51-success-purpose-spec (get request :purpose))]
      (if (map? spec)
        (if (sh07-b51-nonnegative-integer? (get request :ordinal))
          (if (= (get request :tier) (get spec :tier))
            (if (= (get request :subtier) (get spec :subtier))
              (if (= (get request :batch) (get spec :batch))
                (if (= (get request :batch-rank) (get spec :batch-rank))
                  (if (sh07-b51-nonnegative-integer?
                       (get request :batch-ordinal))
                    (if (map? (get request :preimage))
                      (= (get (get request :preimage) :domain)
                         (get spec :preimage-domain))
                      false)
                    false)
                  false)
                false)
              false)
            false)
          false)
        false))
    false))

(defn sh07-b51-purpose-count [requests purpose]
  (loop [remaining requests count-found 0]
    (if (= (count remaining) 0)
      count-found
      (recur
       (rest remaining)
       (if (= (get (first remaining) :purpose) purpose)
         (+ count-found 1) count-found)))))

(defn sh07-b51-purpose-request [requests purpose]
  (loop [remaining requests found nil count-found 0]
    (if (= (count remaining) 0)
      {:request found :count count-found}
      (if (= (get (first remaining) :purpose) purpose)
        (recur (rest remaining) (first remaining) (+ count-found 1))
        (recur (rest remaining) found count-found)))))

(defn sh07-b51-success-plan-cardinality [requests]
  (let [outcome-result
        (sh07-b51-purpose-request
         requests :sh07-b51-predecessor-outcome-semantic-id)
        outcome-kind
        (get (get (get outcome-result :request) :preimage) :outcome-kind)
        legacy? (= outcome-kind :legacy-v16-accepted)]
    (if (= (get outcome-result :count) 1)
      (if (contains?
           #{:legacy-v16-accepted
             :legacy-v16-accepted-after-no-form-waiver
             :b51-vector-frontier-rejected
             :b51-vector-frontier-rejected-after-no-form-waiver}
           outcome-kind)
        (if (loop [remaining
                   [:sh07-b51-implementation-semantic-id
                    :sh07-b51-contract-semantic-id
                    :sh07-b51-same-request-semantic-id
                    :sh07-b51-predecessor-outcome-semantic-id
                    :sh07-b51-predecessor-authority-id
                    :sh07-b51-slot-extraction-transcript-id
                    :sh07-b51-core-identity-id
                    :sh07-b51-predecessor-observation-id
                    :sh07-b51-provenance-binding-id
                    :sh07-b51-independent-verifier-binding-id
                    :sh07-b51-final-artifact-binding-id]]
              (if (= (count remaining) 0)
                true
                (if (= (sh07-b51-purpose-count
                        requests (first remaining))
                       1)
                  (recur (rest remaining)) false)))
          (if (= (sh07-b51-purpose-count
                  requests :sh07-b51-v16-verification-semantic-id)
                 (if legacy? 1 0))
            (if legacy?
              (= (sh07-b51-purpose-count
                  requests :sh07-b51-core-node-id)
                 0)
              (> (sh07-b51-purpose-count
                  requests :sh07-b51-core-node-id)
                 0))
            false)
          false)
        false)
      false)))

(defn sh07-b51-success-request-subtier-ordinal
  [request core-node-count]
  (let [rank (get request :batch-rank)
        batch-ordinal (get request :batch-ordinal)]
    (if (= rank 0) 0
      (if (= rank 1) 1
        (if (= rank 2) 2
          (if (= rank 3) 3
            (if (contains? #{4 5} rank) 0
              (if (= rank 6) batch-ordinal
                (if (= rank 7) (+ core-node-count batch-ordinal)
                  nil)))))))))

(defn sh07-b51-success-request-plan-replay [requests]
  (if (vector? requests)
    (if (<= (count requests) 65540)
      (let [core-node-count
            (sh07-b51-purpose-count requests :sh07-b51-core-node-id)]
        (loop [remaining requests ordinal 0 previous-rank -1 counts {}]
          (if (= (count remaining) 0)
            (if (sh07-b51-success-plan-cardinality requests)
              {:status :accepted
               :request-count ordinal
               :core-node-count core-node-count
               :schedule-exact true
               :cardinality-exact true}
              {:status :rejected :reason :cardinality-mismatch})
            (let [request (first remaining)
                  purpose (get request :purpose)
                  rank (get request :batch-rank)
                  prior-count
                  (if (integer? (get counts purpose))
                    (get counts purpose) 0)]
              (if (sh07-b51-success-request-base-shape? request)
                (if (= (get request :ordinal) ordinal)
                  (if (>= rank previous-rank)
                    (if (= (get request :batch-ordinal) prior-count)
                      (if (= (get request :subtier-ordinal)
                             (sh07-b51-success-request-subtier-ordinal
                              request core-node-count))
                        (recur
                         (rest remaining) (+ ordinal 1) rank
                         (assoc counts purpose (+ prior-count 1)))
                        {:status :rejected :reason :schedule-mismatch})
                      {:status :rejected :reason :schedule-mismatch})
                    {:status :rejected :reason :schedule-mismatch})
                  {:status :rejected :reason :schedule-mismatch})
                {:status :rejected :reason :malformed-request-plan})))))
      {:status :rejected :reason :cardinality-mismatch})
    {:status :rejected :reason :malformed-request-plan}))

(defn sh07-b51-entrypoint-envelope [status tag value]
  {:artifact :gravity/sh07-b51-entrypoint-result-v18
   :domain :gravity/sh07-b51-entrypoint-abi-v18
   :schema-version 18
   :status status
   :tag tag
   :value value})

(defn sh07-b51-digest-boundary-envelope [reason]
  (sh07-b51-entrypoint-envelope
   :boundary-rejected :digest-preimage-boundary-rejected
   {:status :boundary-rejected
    :boundary :sh07-b51-resolve-digest-preimage
    :reason reason
    :recursive-diagnostic-forbidden true}))

(defn sh07-b51-resolved-prefix-shape? [prefix expected-count]
  (if (vector? prefix)
    (if (= (count prefix) expected-count)
      (sh07-b51-all-sha256? prefix)
      false)
    false))

(defn sh07-b51-resolve-digest-preimage-foundation
  [request digest-requests resolved-prefix]
  (if (sh07-b51-success-request-base-shape? request)
    (let [plan (sh07-b51-success-request-plan-replay digest-requests)
          ordinal (get request :ordinal)]
      (if (= (get plan :status) :accepted)
        (if (< ordinal (count digest-requests))
          (if (= request (get digest-requests ordinal))
            (if (sh07-b51-resolved-prefix-shape? resolved-prefix ordinal)
              (sh07-b51-entrypoint-envelope
               :accepted :digest-preimage-resolved
               {:status :accepted
                :request request
                :digest-requests digest-requests
                :resolved-prefix resolved-prefix
                :hash-input
                {:domain :gravity/sh07-declared-digest-v1
                 :purpose (get request :purpose)
                 :preimage (get request :preimage)}})
              (sh07-b51-digest-boundary-envelope :prefix-mismatch))
            (sh07-b51-digest-boundary-envelope :schedule-mismatch))
          (sh07-b51-digest-boundary-envelope :schedule-mismatch))
        (sh07-b51-digest-boundary-envelope (get plan :reason))))
    (sh07-b51-digest-boundary-envelope :malformed-request)))

(defn sh07-b51-generic-implementation-preimage-shape? [preimage]
  (if (sh07-b51-exact-keys?
       preimage
       #{:domain :schema-version :predecessor-executable-descriptor
         :semantic-manifest :semantic-root-hash})
    (if (= (get preimage :domain)
           :gravity/sh07-b51-linked-implementation-semantic-id-preimage-v3)
      (if (= (get preimage :schema-version) 3)
        (if (sh07-b51-predecessor-descriptor-shape?
             (get preimage :predecessor-executable-descriptor))
          (if (sh07-b51-linked-semantic-manifest-shape?
               (get preimage :semantic-manifest))
            (sh07-b51-sha256-id?
             (get preimage :semantic-root-hash))
            false)
          false)
        false)
      false)
    false))

(defn sh07-b51-generic-contract-preimage-shape? [preimage]
  (if (sh07-b51-exact-keys?
       preimage

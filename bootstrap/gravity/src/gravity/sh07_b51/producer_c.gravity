(defn sh07-b51-success-plan-fixed-preimages-authenticated? [requests]
  (let [carrier (sh07-b51-success-plan-raw-carrier requests)
        request (get carrier :authenticated-sh06-request)
        implementation
        (sh07-b51-success-plan-preimage
         requests :sh07-b51-implementation-semantic-id)
        contract
        (sh07-b51-success-plan-preimage
         requests :sh07-b51-contract-semantic-id)
        same-request
        (sh07-b51-success-plan-preimage
         requests :sh07-b51-same-request-semantic-id)
        verification
        (sh07-b51-success-plan-preimage
         requests :sh07-b51-v16-verification-semantic-id)
        outcome
        (sh07-b51-success-plan-preimage
         requests :sh07-b51-predecessor-outcome-semantic-id)
        authority
        (sh07-b51-success-plan-preimage
         requests :sh07-b51-predecessor-authority-id)
        identity
        (sh07-b51-success-plan-preimage
         requests :sh07-b51-core-identity-id)
        outcome-kind (get outcome :outcome-kind)]
    (if (sh07-b51-raw-carrier-shape? carrier)
      (if (sh07-b51-implementation-preimage-for-carrier?
           carrier implementation)
        (if (sh07-b51-contract-preimage-for-carrier? carrier contract)
          (if (sh07-b51-same-request-preimage-shape?
               request same-request)
            (if (sh07-b51-outcome-preimage-for-carrier? carrier outcome)
              (if (sh07-b51-predecessor-authority-preimage-shape?
                   authority)
                (if (sh07-b51-authority-outcome-preimages-agree?
                     authority outcome)
                  (if (sh07-b51-core-identity-preimage-for-carrier?
                       carrier identity)
                    (if (= outcome-kind :legacy-v16-accepted)
                      (sh07-b51-v16-verification-preimage-for-carrier?
                       carrier verification)
                      (= verification nil))
                    false)
                  false)
                false)
              false)
            false)
          false)
        false)
      false)))

(defn sh07-b51-digest-boundary-reason [reason]
  (if (contains?
       #{:malformed-request :malformed-request-plan :prefix-mismatch
         :schedule-mismatch :cardinality-mismatch}
       reason)
    reason
    :malformed-request-plan))

(defn sh07-b51-failure-request-plan-exact?
  [request digest-requests resolved-prefix]
  (if (sh07-b51-failure-digest-request-shape? request)
    (if (= digest-requests [request])
      (= resolved-prefix [])
      false)
    false))

(defn sh07-b51-resolve-digest-preimage-private
  [request digest-requests resolved-prefix]
  (if (sh07-b51-failure-digest-request-shape? request)
    (if (sh07-b51-failure-request-plan-exact?
         request digest-requests resolved-prefix)
      (sh07-b51-entrypoint-envelope
       :accepted :digest-preimage-resolved
       {:status :accepted
        :request request :digest-requests digest-requests
        :resolved-prefix resolved-prefix
        :hash-input
        {:domain :gravity/sh07-declared-digest-v1
         :purpose (get request :purpose)
         :preimage (get request :preimage)}})
      (sh07-b51-digest-boundary-envelope :malformed-request-plan))
    (if (sh07-b51-success-request-base-shape? request)
      (let [plan (sh07-b51-success-plan-exact? digest-requests)
            ordinal (get request :ordinal)
            outcome-kind (sh07-b51-success-outcome-kind digest-requests)]
        (if (= (get plan :status) :accepted)
          (if (sh07-b51-success-plan-fixed-preimages-authenticated?
               digest-requests)
            (if (< ordinal (count digest-requests))
              (if (= request (get digest-requests ordinal))
                (if (sh07-b51-resolved-prefix-shape?
                     resolved-prefix ordinal)
                  (if (sh07-b51-request-reference-prefix-valid?
                       request outcome-kind resolved-prefix)
                    (sh07-b51-entrypoint-envelope
                     :accepted :digest-preimage-resolved
                     {:status :accepted
                      :request request :digest-requests digest-requests
                      :resolved-prefix resolved-prefix
                      :hash-input
                      {:domain :gravity/sh07-declared-digest-v1
                       :purpose (get request :purpose)
                       :preimage (get request :preimage)}})
                    (sh07-b51-digest-boundary-envelope :prefix-mismatch))
                  (sh07-b51-digest-boundary-envelope :prefix-mismatch))
                (sh07-b51-digest-boundary-envelope :schedule-mismatch))
              (sh07-b51-digest-boundary-envelope :schedule-mismatch))
            (sh07-b51-digest-boundary-envelope :malformed-request-plan))
          (sh07-b51-digest-boundary-envelope
           (sh07-b51-digest-boundary-reason (get plan :reason)))))
      (sh07-b51-digest-boundary-envelope :malformed-request))))

(defn sh07-b51-resolve-digest-preimage
  [request digest-requests resolved-prefix]
  (sh07-b51-resolve-digest-preimage-private
   request digest-requests resolved-prefix))

(defn sh07-b51-digest-resolution-accepted-exact?
  [resolution request digest-requests resolved-prefix hash-input]
  (if (sh07-b51-exact-keys?
       resolution #{:artifact :domain :schema-version :status :tag :value})
    (if (= (get resolution :artifact)
           :gravity/sh07-b51-entrypoint-result-v18)
      (if (= (get resolution :domain) :gravity/sh07-b51-entrypoint-abi-v18)
        (if (= (get resolution :schema-version) 18)
          (if (= (get resolution :status) :accepted)
            (if (= (get resolution :tag) :digest-preimage-resolved)
              (let [value (get resolution :value)]
                (if (sh07-b51-exact-keys?
                     value
                     #{:status :request :digest-requests
                       :resolved-prefix :hash-input})
                  (if (= (get value :status) :accepted)
                    (if (= (get value :request) request)
                      (if (= (get value :digest-requests) digest-requests)
                        (if (= (get value :resolved-prefix) resolved-prefix)
                          (= (get value :hash-input) hash-input)
                          false)
                        false)
                      false)
                    false)
                  false))
              false)
            false)
          false)
        false)
      false)
    false))

(defn sh07-b51-r1-linked-ordered-members
  [descriptors plan-carriers reachable]
  (loop [remaining descriptors result []]
    (if (= (count remaining) 0)
      result
      (let [descriptor (first remaining)
            selected
            (sh07-b51-r1-linked-plan-row
             plan-carriers (get descriptor :module-ordinal))
            functions (get (get (get selected :value) :plan) :functions)
            names (if (map? functions) (vec (sort-by-pr-str (keys functions))) [])
            admitted
            (loop [left names values []]
              (if (= (count left) 0) values
                (recur (rest left)
                       (if (contains? reachable (first left))
                         (conj values (first left)) values))))]
        (recur (rest remaining)
               (sh07-b51-vector-append result admitted))))))

(defn sh07-b51-r1-linked-member-rows
  [descriptors plan-carriers members]
  (loop [remaining members ordinal 0 member-rows [] function-rows []]
    (if (= (count remaining) 0)
      {:status :accepted :members member-rows :functions function-rows}
      (let [function (first remaining)
            owner
            (sh07-b51-r1-linked-function-owner
             descriptors plan-carriers function)
            descriptor (get owner :value)
            source-row (sh07-b51-r1-linked-definition-row descriptor function)
            coordinate
            (sh07-b51-r1-linked-coordinate descriptor plan-carriers function)]
        (if (if (= (get owner :count) 1)
              (= (get source-row :count) 1) false)
          (recur
           (rest remaining) (+ ordinal 1)
           (conj member-rows
                 {:member-ordinal ordinal :coordinate coordinate})
           (conj function-rows
                 {:member-ordinal ordinal :coordinate coordinate
                  :definition-source-hash
                  (get (get source-row :value) :source-hash)}))
          {:status :rejected :reason :linked-definition-join})))))

(defn sh07-b51-r1-linked-local-rows
  [descriptors plan-carriers calls reachable]
  (loop [remaining calls ordinal 0 rows []]
    (if (= (count remaining) 0)
      rows
      (let [call (first remaining)
            caller (get call :caller)
            callee (get call :callee)
            caller-owner
            (sh07-b51-r1-linked-function-owner
             descriptors plan-carriers caller)
            callee-owner
            (sh07-b51-r1-linked-function-owner
             descriptors plan-carriers callee)
            local?
            (if (= (get call :kind) :function)
              (if (= (get caller-owner :count) 1)
                (if (= (get callee-owner :count) 1)
                  (= (get (get caller-owner :value) :module-ordinal)
                     (get (get callee-owner :value) :module-ordinal)) false)
                false)
              false)]
        (if (if local? (contains? reachable caller) false)
          (recur
           (rest remaining) (+ ordinal 1)
           (conj rows
                 {:edge-ordinal ordinal
                  :caller
                  (sh07-b51-r1-linked-coordinate
                   (get caller-owner :value) plan-carriers caller)
                  :callee
                  (sh07-b51-r1-linked-coordinate
                   (get callee-owner :value) plan-carriers callee)
                  :arity (get call :arity)
                  :source-callsite-ordinal ordinal}))
          (recur (rest remaining) ordinal rows))))))

(defn sh07-b51-r1-linked-external-rows
  [descriptors plan-carriers manifest bundle reachable]
  (loop [remaining (get manifest :edges) semantic-ordinal 0 rows []]
    (if (= (count remaining) 0)
      rows
      (let [edge (first remaining)
            caller (get edge :caller-function)]
        (if (contains? reachable caller)
          (let [caller-owner
                (sh07-b51-r1-linked-function-owner
                 descriptors plan-carriers caller)
                callee-owner
                (sh07-b51-r1-linked-function-owner
                 descriptors plan-carriers (get edge :callee-function))
                physical (get edge :ordinal)
                route (get (get bundle :routes) physical)]
            (if (if (= (get caller-owner :count) 1)
                  (= (get callee-owner :count) 1) false)
              (recur
               (rest remaining) (+ semantic-ordinal 1)
               (conj rows
                     {:semantic-edge-ordinal semantic-ordinal
                      :m1-edge-ordinal physical
                      :manifest-id (get manifest :manifest-id)
                      :caller
                      (sh07-b51-r1-linked-coordinate
                       (get caller-owner :value) plan-carriers caller)
                      :callee
                      (sh07-b51-r1-linked-coordinate
                       (get callee-owner :value) plan-carriers
                       (get edge :callee-function))
                      :arity (get edge :arity)
                      :owner-edge (get edge :owner-edge)
                      :route route}))
              [{:status :rejected :reason :linked-external-owner-join}]))
          (recur (rest remaining) semantic-ordinal rows))))))

(defn sh07-b51-r1-linked-builtin-rows
  [descriptors plan-carriers reachable]
  (loop [descriptor-rows descriptors ordinal 0 rows []]
    (if (= (count descriptor-rows) 0)
      rows
      (let [descriptor (first descriptor-rows)
            built
            (loop [remaining (get descriptor :builtin-calls)
                   next-ordinal ordinal result rows]
              (if (= (count remaining) 0)
                {:ordinal next-ordinal :rows result}
                (let [call (first remaining)
                      caller (get call :caller)]
                  (if (contains? reachable caller)
                    (recur
                     (rest remaining) (+ next-ordinal 1)
                     (conj result
                           {:occurrence-ordinal next-ordinal
                            :caller
                            (sh07-b51-r1-linked-coordinate
                             descriptor plan-carriers caller)
                            :builtin (get call :builtin)
                            :arity (get call :arity)
                            :compiler-internal?
                            (get call :compiler-internal?)
                            :source-callsite-ordinal next-ordinal}))
                    (recur (rest remaining) next-ordinal result)))))]
        (recur (rest descriptor-rows)
               (get built :ordinal) (get built :rows))))))

(defn sh07-b51-r1-linked-m0-builtin-replay?
  [descriptors m2-calls]
  (sh07-b51-r1-linked-m0-m2-builtin-parity? descriptors m2-calls))

(defn sh07-b51-r1-linked-category-rows [carrier]
  (let [descriptors (get carrier :module-source-descriptors)
        plan-carriers (get carrier :module-plan-carriers)
        manifest (get carrier :link-manifest)
        bundle (get carrier :execution-bundle)
        call-result
        (sh07-b51-r1-linked-call-census descriptors plan-carriers)
        source-calls (get call-result :calls)
        m2-call-result
        (sh07-b51-r1-linked-m2-call-census descriptors plan-carriers)
        calls (get m2-call-result :calls)
        reachable-result
        (if (= (get m2-call-result :status) :accepted)
          (sh07-b51-r1-linked-reachable
           descriptors plan-carriers calls (get bundle :public-roots))
          {:status :rejected})
        reachable (get reachable-result :members)
        members
        (if (= (get reachable-result :status) :accepted)
          (sh07-b51-r1-linked-ordered-members
           descriptors plan-carriers reachable) [])
        member-rows
        (sh07-b51-r1-linked-member-rows descriptors plan-carriers members)
        roots
        (loop [remaining (get bundle :public-roots) rows []]
          (if (= (count remaining) 0) rows
            (let [root (first remaining)
                  owner
                  (sh07-b51-r1-linked-function-owner
                   descriptors plan-carriers (get root :function))]
              (recur
               (rest remaining)
               (conj rows
                     {:root-ordinal (get root :root-ordinal)
                      :coordinate
                      (sh07-b51-r1-linked-coordinate
                       (get owner :value) plan-carriers
                       (get root :function))
                      :arity (get root :arity)})))))
        contracts
        (loop [remaining descriptors rows []]
          (if (= (count remaining) 0) rows
            (let [descriptor (first remaining)]
              (recur
               (rest remaining)
               (conj rows
                     {:module-ordinal (get descriptor :module-ordinal)
                      :module-source-id
                      (get descriptor :module-source-id)})))))]
    (if (if (= (get call-result :status) :accepted)
          (if (= (get reachable-result :status) :accepted)
          (if (= (get member-rows :status) :accepted)
            (sh07-b51-r1-linked-m0-builtin-replay? descriptors calls) false)
          false) false)
      {:status :accepted :reachable reachable :calls calls
       :source-calls source-calls
       :rows
       {:roots roots
        :members (get member-rows :members)
        :functions (get member-rows :functions)
        :local-runtime-call-edges
        (sh07-b51-r1-linked-local-rows
         descriptors plan-carriers calls reachable)
        :external-runtime-call-edges
        (sh07-b51-r1-linked-external-rows
         descriptors plan-carriers manifest bundle reachable)
        :referenced-builtins
        (sh07-b51-r1-linked-builtin-rows
         descriptors plan-carriers reachable)
        :module-contracts contracts}}
      {:status :rejected :reason :linked-category-replay})))

(defn sh07-b51-success-digest-replay-exact?
  [request carrier]
  (if (sh07-b51-exact-keys? request #{:mode :preimage})
    (if (= (get request :mode) :attempt30-compact-hash)
      (sh07-declared-digest-hash (get request :preimage))
      (sh07-b51-success-digest-replay-exhaustive request carrier))
    (sh07-b51-success-digest-replay-exhaustive request carrier)))

(defn sh07-b51-success-digest-replay-exhaustive
  [digest-requests resolved-digests]
  (if (map? digest-requests)
    (if (= (get digest-requests :mode) :linked-v3-semantic-replay)
      (let [carrier resolved-digests
            rows (get digest-requests :rows)
            schedule (sh07-b51-linked-schedule)
            replay
            (loop [categories (sh07-b51-linked-categories)
                   commitments [] total 0]
              (if (= (count categories) 0)
                {:status :accepted :commitments commitments :total total}
                (let [category (first categories)
                      category-rows (get rows category)
                      row-count (count category-rows)
                      rows-bounded?
                      (if (vector? category-rows)
                        (loop [remaining category-rows]
                          (if (= (count remaining) 0) true
                            (if (sh07-b51-r1-linked-class-bounds?
                                 :row schedule (first remaining))
                              (recur (rest remaining)) false)))
                        false)
                      leaves
                      (if rows-bounded?
                        (loop [first-row 0 shard 0 result []]
                          (if (if (= row-count 0) (> shard 0)
                                (>= first-row row-count))
                            result
                            (let [end
                                  (if (> (+ first-row 16) row-count)
                                    row-count (+ first-row 16))
                                  selected
                                  (if (= row-count 0) []
                                    (subvec category-rows first-row end))
                                  preimage
                                  {:domain
                                   :gravity/sh07-b51-linked-closure-leaf-v2
                                   :schema-version 2 :category category
                                   :shard-ordinal shard
                                   :first-row-ordinal first-row
                                   :row-count (count selected)
                                   :category-row-count row-count
                                   :rows selected}]
                              (if (sh07-b51-r1-linked-class-bounds?
                                   :leaf schedule preimage)
                                (let [digest
                                      (sh07-b51-success-digest-replay-exact?
                                       {:mode :attempt30-compact-hash
                                        :preimage preimage}
                                       [])]
                                  (if (sh07-b51-sha256-id? digest)
                                    (recur
                                     end (+ shard 1)
                                     (conj result
                                           {:child-ordinal shard
                                            :first-row-ordinal first-row
                                            :row-count (count selected)
                                            :digest digest}))
                                    []))
                                []))))
                        [])
                      folded
                      (if (> (count leaves) 0)
                        (loop [level 1 children leaves]
                          (if (> level (get schedule :maximum-fold-levels))
                            {:status :rejected}
                            (let [next
                                  (loop [first-child 0 group 0 result []]
                                    (if (>= first-child (count children))
                                      result
                                      (let [end
                                            (if (> (+ first-child 16)
                                                   (count children))
                                              (count children)
                                              (+ first-child 16))
                                            selected
                                            (subvec children first-child end)
                                            row-sum
                                            (loop [remaining selected sum 0]
                                              (if (= (count remaining) 0) sum
                                                (recur
                                                 (rest remaining)
                                                 (+ sum
                                                    (get (first remaining)
                                                         :row-count)))))
                                            preimage
                                            {:domain
                                             :gravity/sh07-b51-linked-closure-fold-v2
                                             :schema-version 2
                                             :category category :level level
                                             :group-ordinal group
                                             :first-child-ordinal first-child
                                             :child-count (count selected)
                                             :row-count row-sum
                                             :children selected}]
                                        (if (sh07-b51-r1-linked-class-bounds?
                                             :fold schedule preimage)
                                          (let [digest
                                                (sh07-b51-success-digest-replay-exact?
                                                 {:mode
                                                  :attempt30-compact-hash
                                                  :preimage preimage}
                                                 [])]
                                            (if (sh07-b51-sha256-id? digest)
                                              (recur
                                               end (+ group 1)
                                               (conj result
                                                     {:child-ordinal group
                                                      :first-row-ordinal
                                                      (get (first selected)
                                                           :first-row-ordinal)
                                                      :row-count row-sum
                                                      :digest digest}))
                                              []))
                                          []))))]
                              (if (= (count next) 1)
                                {:status :accepted :level level
                                 :root (first next)}
                                (if (> (count next) 1)
                                  (recur (+ level 1) next)
                                  {:status :rejected})))))
                        {:status :rejected})
                      commitment
                      {:category category :row-count row-count
                       :leaf-count (count leaves)
                       :fold-level-count (get folded :level)
                       :root-digest (get (get folded :root) :digest)}]
                  (if (if (= (get folded :status) :accepted)
                        (sh07-b51-r1-linked-class-bounds?
                         :commitment schedule commitment) false)
                    (if (<= (+ total row-count)
                            (get schedule :maximum-total-rows))
                      (recur (rest categories)
                             (conj commitments commitment)
                             (+ total row-count))
                      {:status :rejected})
                    {:status :rejected}))))
            descriptors (get carrier :module-source-descriptors)
            plans (get carrier :module-plan-carriers)
            manifest (get carrier :link-manifest)
            bundle (get carrier :execution-bundle)
            semantic
            {:domain :gravity/sh07-b51-v18-linked-semantic-manifest-v3
             :schema-version 3
             :predecessor-executable-descriptor-id
             "sha256:f473d088e1528275582dd5ce9194ee20773b7d501547bd882d6a201332a70234"
             :module-source-ids
             (loop [remaining descriptors result []]
               (if (= (count remaining) 0) result
                 (recur (rest remaining)
                        (conj result
                              (get (first remaining) :module-source-id)))))
             :link-manifest-id (get manifest :manifest-id)
             :module-plan-ids
             (loop [remaining plans result []]
               (if (= (count remaining) 0) result
                 (recur (rest remaining)
                        (conj result (get (first remaining) :plan-id)))))
             :execution-bundle-id (get bundle :bundle-id)
             :schedule schedule
             :category-commitments (get replay :commitments)
             :logical-public-surface
             (sh07-b51-linked-logical-public-surface)
             :inherited-contract-value-hashes
             (sh07-b51-linked-inherited-contract-hashes)
             :total-row-count (get replay :total)}
            root-preimage
            {:domain :gravity/sh07-b51-v18-linked-semantic-root-v3
             :schema-version 3 :semantic-manifest semantic}]
        (if (if (= (get replay :status) :accepted)
              (sh07-b51-r1-linked-class-bounds?
               :root schedule root-preimage) false)
          (let [root-hash
                (sh07-b51-success-digest-replay-exact?
                 {:mode :attempt30-compact-hash
                  :preimage root-preimage}
                 [])]
            (if (sh07-b51-sha256-id? root-hash)
              {:status :accepted :semantic-manifest semantic
               :semantic-root-hash root-hash}
              {:status :rejected}))
          {:status :rejected}))
      false)
    (if (vector? digest-requests)
    (if (vector? resolved-digests)
      (if (= (count digest-requests) (count resolved-digests))
        (loop [remaining digest-requests ordinal 0 prefix []]
          (if (= (count remaining) 0)
            (= prefix resolved-digests)
            (let [request (first remaining)
                  resolution
                  (sh07-b51-resolve-digest-preimage-private
                   request digest-requests prefix)]
              (let [hash-input
                        {:domain :gravity/sh07-declared-digest-v1
                         :purpose (get request :purpose)
                         :preimage (get request :preimage)}]
                (if (sh07-b51-digest-resolution-accepted-exact?
                     resolution request digest-requests prefix hash-input)
                            (let [expected
                                  (sh07-b51-success-digest-replay-exact?
                                   {:mode :attempt30-compact-hash
                                    :preimage hash-input}
                                   [])]
                              (if (sh07-b51-sha256-id? expected)
                                (if (= expected
                                       (get resolved-digests ordinal))
                                  (recur
                                   (rest remaining) (+ ordinal 1)
                                   (conj prefix expected))
                                  false)
                                false))
                  false)))))
        false)
      false)
      false)))

(defn sh07-b51-r1-linked-carrier-replay [carrier]
  (let [descriptors (get carrier :module-source-descriptors)
        plans (get carrier :module-plan-carriers)
        manifest (get carrier :link-manifest)
        bundle (get carrier :execution-bundle)
        products-shape?
        (if (if (vector? descriptors) (= (count descriptors) 7) false)
          (if (if (vector? plans) (= (count plans) 7) false)
            (if (sh07-b51-exact-keys?
                 manifest #{:artifact :schema-version :manifest-id
                            :module-source-ids :edges})
              (if (= [(get manifest :artifact) (get manifest :schema-version)]
                     [:gravity/sh07-b51-link-manifest-v1 1])
                (if (sh07-b51-exact-keys?
                     bundle #{:artifact :schema-version :bundle-id
                              :manifest-id :module-plans :routes
                              :public-roots})
                  (= [(get bundle :artifact) (get bundle :schema-version)
                      (get bundle :manifest-id)]
                     [:gravity/sh07-b51-execution-bundle-v1 1
                      (get manifest :manifest-id)])
                  false)
                false)
              false)
            false)
          false)
        module-joins?
        (if products-shape?
          (loop [remaining descriptors ordinal 0 source-ids []
                 module-plans [] valid? true]
            (if (= (count remaining) 0)
              (if valid?
                (= [(get manifest :module-source-ids)
                    (get bundle :module-plans)]
                   [source-ids module-plans]) false)
              (let [descriptor (first remaining)
                    selected
                    (sh07-b51-r1-linked-plan-row plans ordinal)
                    row (get selected :value)
                    plan (get row :plan)
                    valid-row?
                    (if (sh07-b51-linked-module-source-shape?
                         descriptor ordinal)
                      (if (= (get selected :count) 1)
                        (= [(get row :module-source-id)
                            (get row :plan-id)
                            (get plan :sh07-b51-module-source-id)
                            (get plan :sh07-b51-link-manifest-id)]
                           [(get descriptor :module-source-id)
                            (get plan :plan-id)
                            (get descriptor :module-source-id)
                            (get manifest :manifest-id)]) false)
                      false)]
                (recur
                 (rest remaining) (+ ordinal 1)
                 (conj source-ids (get descriptor :module-source-id))
                 (conj module-plans
                       {:module-ordinal ordinal
                        :module-source-id (get descriptor :module-source-id)
                        :plan-id (get row :plan-id)})
                 (if valid? valid-row? false)))))
          false)
        expected-roots
        (if module-joins?
          (let [specs
                [[1 'sh07-b51-build-template 1 3]
                 [2 'sh07-b51-verify-template 3 3]
                 [3 'sh07-b51-resolve-digest-preimage 3 2]
                 [4 'sh07-b51-resolve-template 3 3]
                 [5 'sh07-b51-verify-resolved 4 3]
                 [6 'sh07-b51-build-independent-verifier-binding 6 5]
                 [7 'sh07-b51-build-final-artifact 7 3]
                 [8 'sh07-b51-finalize-rejection 1 6]]]
            (loop [remaining specs rows []]
              (if (= (count remaining) 0) rows
                (let [spec (first remaining)
                      plan-row (get plans (get spec 3))]
                  (recur
                   (rest remaining)
                   (conj rows
                         {:root-ordinal (get spec 0)
                          :function (get spec 1)
                          :arity (get spec 2)
                          :plan-id (get plan-row :plan-id)}))))))
          [])
        roots-authentic? (= expected-roots (get bundle :public-roots))
        categories
        (if (if module-joins? roots-authentic? false)
          (sh07-b51-r1-linked-category-rows carrier)
          {:status :rejected})
        rows (get categories :rows)
        physical
        (if (= (get categories :status) :accepted)
          (sh07-b51-r1-linked-physical-census carrier categories) nil)
        census-bounded?
        (if (map? physical)
          (loop [remaining (get physical :module-censuses)]
            (if (= (count remaining) 0) true
              (let [profile
                    (sh07-b51-r1-linked-value-profile (first remaining))]
                (if (= (get profile :status) :accepted)
                  (if (<= (get profile :nodes) 64)
                    (if (<= (get profile :depth) 2)
                      (if (<= (get profile :width) 20)
                        (if (<= (get profile :scalar) 4096)
                          (if (<= (get profile :c11) 8192)
                            (if (<= (get profile :canonical-reader) 9216)
                              (if (<= (get (first remaining)
                                           :aggregate-binding-count) 2440)
                                (recur (rest remaining)) false)
                              false)
                            false)
                          false)
                        false)
                      false)
                    false)
                  false))))
          false)
        external-authentic?
        (if (= (get categories :status) :accepted)
          (sh07-b51-r1-linked-external-authentic?
           descriptors plans (get categories :source-calls) manifest bundle)
          false)
        provenance-authentic?
        (if external-authentic?
          (sh07-b51-r1-linked-v2-provenance-authentic?
           descriptors plans manifest)
          false)
        digests
        (if (if census-bounded? provenance-authentic? false)
          (sh07-b51-success-digest-replay-exhaustive
           {:mode :linked-v3-semantic-replay :rows rows} carrier)
          {:status :rejected})]
    (if (= (get digests :status) :accepted)
      (if (= physical (get carrier :physical-census))
        (if (= (get digests :semantic-manifest)
               (get carrier :semantic-manifest))
          (if (= (get digests :semantic-root-hash)
                 (get carrier :semantic-root-hash))
            {:status :accepted :semantic-manifest
             (get digests :semantic-manifest)
             :semantic-root-hash (get digests :semantic-root-hash)
             :physical-census physical}
            {:status :rejected :reason :linked-semantic-root})
          {:status :rejected :reason :linked-semantic-manifest})
        {:status :rejected :reason :linked-physical-census})
      {:status :rejected :reason :linked-carrier-replay})))

(defn sh07-b51-semantic-coordinate [semantic]
  {:form-id (get semantic :form-id)
   :form-ordinal (get semantic :form-ordinal)
   :fragment-ordinal (get semantic :fragment-ordinal)
   :syntax-id (get semantic :syntax-id)
   :source-span (get semantic :source-span)
   :generated-origin-chain (get semantic :generated-origin-chain)
   :core-node-id (get semantic :core-node-id)
   :owner-coordinate (get semantic :owner-coordinate)
   :slot-id (get semantic :slot-id)
   :extraction-id (get semantic :extraction-id)
   :recur-form-id (get semantic :recur-form-id)
   :recur-syntax-id (get semantic :recur-syntax-id)
   :path (get semantic :path)})

(defn sh07-b51-resolve-controlled-path
  [value path resolved-digests]
  (if (vector? path)
    (if (= (count path) 0)
      (if (sh07-b51-internal-reference? value)
        (let [ordinal (get value :ordinal)]
          (if (< ordinal (count resolved-digests))
            (let [resolved (get resolved-digests ordinal)]
              (if (sh07-b51-sha256-id? resolved)
                {:status :accepted :value resolved}
                {:status :rejected :reason :resolved-id-shape}))
            {:status :rejected :reason :reference-ordinal-range}))
        {:status :rejected :reason :generated-reference-representation})
      (let [token (first path)
            remaining (vec (rest path))]
        (if (= token :each)
          (if (vector? value)
            (loop [items value result []]
              (if (= (count items) 0)
                {:status :accepted :value result}
                (let [resolved
                      (sh07-b51-resolve-controlled-path
                       (first items) remaining resolved-digests)]
                  (if (= (get resolved :status) :accepted)
                    (recur
                     (rest items) (conj result (get resolved :value)))
                    resolved))))
            {:status :rejected :reason :path-vector-required})
          (if (= token :optional)
            (if (= value nil)
              {:status :accepted :value nil}
              (sh07-b51-resolve-controlled-path
               value remaining resolved-digests))
            (if (contains? #{:if-kind :do-kind :target-kind=:loop} token)
              {:status :rejected :reason :path-kind-position}
              (if (map? value)
                (let [next-token
                      (if (> (count remaining) 0)
                        (first remaining) nil)
                      conditional?
                      (if (= next-token :target-kind=:loop)
                        true
                        (contains? #{:if-kind :do-kind} next-token))]
                  (if conditional?
                    (let [required-kind
                          (if (= next-token :if-kind) :if
                            (if (= next-token :do-kind) :do :loop))]
                      (if (= (if (= next-token :target-kind=:loop)
                               (get value :target-kind)
                               (get value :kind))
                             required-kind)
                        (if (contains? value token)
                          (let [resolved
                                (sh07-b51-resolve-controlled-path
                                 (get value token) (vec (rest remaining))
                                 resolved-digests)]
                            (if (= (get resolved :status) :accepted)
                              {:status :accepted
                               :value
                               (assoc value token (get resolved :value))}
                              resolved))
                          {:status :rejected :reason :path-key-missing})
                        {:status :accepted :value value}))
                    (if (contains? value token)
                      (let [resolved
                            (sh07-b51-resolve-controlled-path
                             (get value token) remaining resolved-digests)]
                        (if (= (get resolved :status) :accepted)
                          {:status :accepted
                           :value (assoc value token (get resolved :value))}
                          resolved))
                      {:status :rejected :reason :path-key-missing})))
                {:status :rejected :reason :path-map-required}))))))
    {:status :rejected :reason :path-not-vector}))

(defn sh07-b51-resolve-controlled-descriptors
  [preimage descriptors resolved-digests]
  (loop [remaining descriptors value preimage]
    (if (= (count remaining) 0)
      {:status :accepted :value value}
      (let [descriptor (first remaining)]
        (if (= (get descriptor :representation) :generated)
          (let [resolved
                (sh07-b51-resolve-controlled-path
                 value (get descriptor :path) resolved-digests)]
            (if (= (get resolved :status) :accepted)
              (recur (rest remaining) (get resolved :value))
              resolved))
          (if (= (get descriptor :representation) :concrete)
            (recur (rest remaining) value)
            {:status :rejected
             :reason :reference-representation-unknown}))))))

(defn sh07-b51-resolve-controlled-preimage
  [request outcome-kind resolved-digests]
  (let [registered
        (sh07-b51-request-controlled-references request outcome-kind)]
    (if (= (get registered :status) :accepted)
      (sh07-b51-resolve-controlled-descriptors
       (get request :preimage)
       (sh07-b51-purpose-reference-descriptors
        (get request :purpose) outcome-kind)
       resolved-digests)
      registered)))

(defn sh07-b51-template-from-identity-preimage
  [preimage digest-requests]
  (let [base
        {:artifact :gravity/sh07-b51-canonical-template-v18
         :schema-version 18
         :predecessor-outcome-kind
         (get preimage :predecessor-outcome-kind)
         :same-request-semantic-id
         (get preimage :same-request-semantic-id)
         :predecessor-authority-id
         (get preimage :predecessor-authority-id)
         :module (get preimage :module)
         :lineage (get preimage :lineage)
         :projection-binding (get preimage :projection-binding)
         :digest-requests digest-requests
         :diagnostics (get preimage :diagnostics)}
        products (get preimage :products)]
    (loop [remaining (sh07-b51-product-key-order) result base]
      (if (= (count remaining) 0)
        result
        (let [key (first remaining)]
          (recur (rest remaining) (assoc result key (get products key))))))))

(defn sh07-b51-template-shape-for-plan? [template digest-requests]
  (let [plan (sh07-b51-success-plan-exact? digest-requests)
        identity
        (sh07-b51-purpose-request
         digest-requests :sh07-b51-core-identity-id)]
    (if (= (get plan :status) :accepted)
      (if (sh07-b51-success-plan-fixed-preimages-authenticated?
           digest-requests)
        (if (= (get identity :count) 1)
          (= template
             (sh07-b51-template-from-identity-preimage
              (get (get identity :request) :preimage)
              digest-requests))
          false)
        false)
      false)))

(defn sh07-b51-resolved-reference-descriptors-shape?
  [value descriptors]
  (loop [remaining descriptors]
    (if (= (count remaining) 0)
      true
      (let [path-result
            (sh07-b51-reference-path-values
             value (get (first remaining) :path))]
        (if (= (get path-result :status) :accepted)
          (if (sh07-b51-all-sha256? (get path-result :values))
            (recur (rest remaining)) false)
          false)))))

(defn sh07-b51-resolved-core-identity-preimage-shape? [preimage]
  (if (sh07-b51-exact-keys?
       preimage
       #{:domain :schema-version :artifact-kind :task :scope
         :predecessor-outcome-kind :same-request-semantic-id
         :predecessor-authority-id :module :lineage :projection-binding
         :product-key-order :products :diagnostics})
    (let [outcome-kind (get preimage :predecessor-outcome-kind)]
      (if (= (get preimage :domain)
             :gravity/sh07-b51-core-identity-preimage-v18)
        (if (= (get preimage :schema-version) 18)
          (if (= (get preimage :artifact-kind)
                 :gravity/sh07-b51-canonical-core-artifact-v18)
            (if (= (get preimage :task) "SH-07-B51")
              (if (= (get preimage :scope)
                     :sh07-b51-vector-destructuring)
                (if (contains?
                     #{:legacy-v16-accepted
                       :b51-vector-frontier-rejected
                       :legacy-v16-accepted-after-no-form-waiver
                       :b51-vector-frontier-rejected-after-no-form-waiver}
                     outcome-kind)
                  (if (sh07-b51-sha256-id?
                       (get preimage :same-request-semantic-id))
                    (if (sh07-b51-sha256-id?
                         (get preimage :predecessor-authority-id))
                      (if (map? (get preimage :module))
                        (if (map? (get preimage :lineage))
                          (if (sh07-b51-sha256-id?
                               (get preimage :projection-binding))
                            (if (= (get preimage :product-key-order)
                                   (sh07-b51-product-key-order))
                              (if (sh07-b51-products-closed-shape?
                                   (get preimage :products) outcome-kind)
                                (if (= (get preimage :diagnostics) [])
                                  (sh07-b51-resolved-reference-descriptors-shape?
                                   preimage
                                   (sh07-b51-tier3-reference-descriptors
                                    outcome-kind))
                                  false)
                                false)
                              false)
                            false)
                          false)
                        false)
                      false)
                    false)
                  false)
                false)
              false)
            false)
          false)
        false))
    false))


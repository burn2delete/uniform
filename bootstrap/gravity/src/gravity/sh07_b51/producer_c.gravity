         :lexical-bindings (get artifact :lexical-bindings)
         :loop-bindings (get artifact :loop-bindings)
         :recur-targets (get artifact :recur-targets)
         :recur-transfers (get artifact :recur-transfers)
         :source-map (get artifact :source-map)
         :binding-table (get preserved :binding-table)
         :declared-alias-table (get artifact :declared-alias-table)
         :resolution-table (get preserved :resolution-table)
         :macro-expansion-trace (get artifact :macro-expansion-trace)
         :macro-origin-traces (get artifact :macro-origin-traces)
         :macro-origin-expectation (get artifact :macro-origin-expectation)
         :pending-fact-families (get artifact :pending-fact-families)}
        equivalence (get products :legacy-v16-equivalence)
        normalized-identity
        (sh07-b51-v16-normalize-identity-preimage
         (get artifact :identity-preimage))]
    (if (loop [remaining (vec expected)]
          (if (= (count remaining) 0)
            true
            (let [entry (first remaining)]
              (if (= (get products (first entry)) (second entry))
                (recur (rest remaining)) false))))
      (if (sh07-b51-legacy-equivalence-record-shape? equivalence)
        (if (= (get equivalence :inherited-v16-semantic-artifact-id)
               (get artifact :artifact-id))
          (if (= (get equivalence :v16-semantic-projection)
                 normalized-identity)
            (= (get equivalence :v18-compatibility-projection)
               normalized-identity)
            false)
          false)
        false)
      false)))

(defn sh07-b51-core-identity-preimage-for-carrier?
  [carrier preimage]

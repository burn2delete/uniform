(defn sh07-b51-resolved-core-from-identity-preimage
  [preimage semantic-identity-id]
  (let [base
        {:artifact :gravity/sh07-b51-resolved-core-v18
         :schema-version 18
         :predecessor-outcome-kind
         (get preimage :predecessor-outcome-kind)
         :same-request-semantic-id
         (get preimage :same-request-semantic-id)
         :predecessor-authority-id
         (get preimage :predecessor-authority-id)
         :module (get preimage :module)
         :lineage (get preimage :lineage)
         :projection-binding (get preimage :projection-binding)
         :semantic-identity-id semantic-identity-id
         :diagnostics (get preimage :diagnostics)}
        products (get preimage :products)]
    (loop [remaining (sh07-b51-product-key-order) result base]
      (if (= (count remaining) 0)
        result
        (let [key (first remaining)]
          (recur (rest remaining) (assoc result key (get products key))))))))

(defn sh07-b51-resolved-core-identity-preimage [resolved-core]
  (let [products
        (loop [remaining (sh07-b51-product-key-order) result {}]
          (if (= (count remaining) 0)
            result
            (let [key (first remaining)]
              (recur
               (rest remaining)
               (assoc result key (get resolved-core key))))))]
    {:domain :gravity/sh07-b51-core-identity-preimage-v18
     :schema-version 18
     :artifact-kind :gravity/sh07-b51-canonical-core-artifact-v18
     :task "SH-07-B51"
     :scope :sh07-b51-vector-destructuring
     :predecessor-outcome-kind
     (get resolved-core :predecessor-outcome-kind)
     :same-request-semantic-id
     (get resolved-core :same-request-semantic-id)
     :predecessor-authority-id
     (get resolved-core :predecessor-authority-id)
     :module (get resolved-core :module)
     :lineage (get resolved-core :lineage)
     :projection-binding (get resolved-core :projection-binding)
     :product-key-order (sh07-b51-product-key-order)
     :products products
     :diagnostics (get resolved-core :diagnostics)}))

(defn sh07-b51-resolved-core-shape? [resolved-core]
  (if (sh07-b51-exact-keys?
       resolved-core
       #{:artifact :schema-version :predecessor-outcome-kind
         :same-request-semantic-id :predecessor-authority-id
         :module :lineage :projection-binding :semantic-identity-id
         :fragment-manifest :fragment-coverage :module-assembly-manifest
         :root-core-node-ids :definitions :nodes :evaluation-order
         :control-flow :reference-uses :var-references :mutations
         :error-transfers :error-handlers :match-branch-records
         :match-decision-skeletons :match-pattern-records :calls
         :function-records :call-edges :recursion-components
         :keyword-lookups :lexical-bindings :loop-bindings :recur-targets
         :recur-transfers :source-map :binding-table :declared-alias-table
         :resolution-table :macro-expansion-trace :macro-origin-traces
         :macro-origin-expectation :pending-fact-families
         :destructuring-product-nodes :binding-slots
         :binding-extractions :slot-extraction-transcript
         :runtime-checks :publication-events :recur-slot-mappings
         :legacy-v16-equivalence :diagnostics})
    (if (= (get resolved-core :artifact)
           :gravity/sh07-b51-resolved-core-v18)
      (if (= (get resolved-core :schema-version) 18)
        (if (sh07-b51-sha256-id?
             (get resolved-core :semantic-identity-id))
          (let [preimage
                (sh07-b51-resolved-core-identity-preimage resolved-core)]
            (if (sh07-b51-resolved-core-identity-preimage-shape? preimage)
              (= resolved-core
                 (sh07-b51-resolved-core-from-identity-preimage
                  preimage (get resolved-core :semantic-identity-id)))
              false))
          false)
        false)
      false)
    false))

(defn sh07-b51-template-resolution-boundary [reason]
  (sh07-b51-root-boundary-envelope
   :template-resolution-boundary-rejected
   :sh07-b51-resolve-template reason))

(defn sh07-b51-resolve-template-private
  [template digest-requests resolved-digests]
  (if (map? template)
    (if (vector? digest-requests)
      (if (vector? resolved-digests)
        (if (sh07-b51-template-shape-for-plan? template digest-requests)
          (if (sh07-b51-success-digest-replay-exhaustive
               digest-requests resolved-digests)
      (let [outcome-kind
            (get template :predecessor-outcome-kind)
            identity-selection
            (sh07-b51-purpose-request
             digest-requests :sh07-b51-core-identity-id)
            observation-selection
            (sh07-b51-purpose-request
             digest-requests :sh07-b51-predecessor-observation-id)
            provenance-selection
            (sh07-b51-purpose-request
             digest-requests :sh07-b51-provenance-binding-id)]
        (if (= (get identity-selection :count) 1)
          (if (= (get observation-selection :count) 1)
            (if (= (get provenance-selection :count) 1)
              (let [identity-request (get identity-selection :request)
                    observation-request
                    (get observation-selection :request)
                    provenance-request (get provenance-selection :request)
                    identity-resolved
                    (sh07-b51-resolve-controlled-preimage
                     identity-request outcome-kind resolved-digests)
                    observation-resolved
                    (sh07-b51-resolve-controlled-preimage
                     observation-request outcome-kind resolved-digests)
                    provenance-resolved
                    (sh07-b51-resolve-controlled-preimage
                     provenance-request outcome-kind resolved-digests)]
                (if (= (get identity-resolved :status) :accepted)
                  (if (= (get observation-resolved :status) :accepted)
                    (if (= (get provenance-resolved :status) :accepted)
                      (let [identity-preimage
                            (get identity-resolved :value)
                            observation-preimage
                            (get observation-resolved :value)
                            provenance-preimage
                            (get provenance-resolved :value)
                            identity-id
                            (get resolved-digests
                                 (get identity-request :ordinal))
                            observation-id
                            (get resolved-digests
                                 (get observation-request :ordinal))
                            provenance-id
                            (get resolved-digests
                                 (get provenance-request :ordinal))
                            identity-record
                            {:artifact :gravity/sh07-b51-core-identity-v18
                             :schema-version 18
                             :semantic-identity-id identity-id
                             :preimage identity-preimage}
                            resolved-core
                            (sh07-b51-resolved-core-from-identity-preimage
                             identity-preimage identity-id)
                            observation-record
                            {:artifact
                             :gravity/sh07-b51-predecessor-observation-v18
                             :schema-version 18
                             :observation-id observation-id
                             :preimage observation-preimage}
                            provenance-record
                            {:artifact :gravity/sh07-b51-provenance-binding-v18
                             :schema-version 18
                             :provenance-binding-id provenance-id
                             :preimage provenance-preimage}]
                        (if (sh07-b51-materialized-core-identity-shape?
                             identity-record)
                          (if (sh07-b51-resolved-core-shape? resolved-core)
                            (if (sh07-b51-materialized-observation-shape?
                                 observation-record)
                              (if (sh07-b51-materialized-provenance-shape?
                                   provenance-record)
                                (sh07-b51-entrypoint-envelope
                                 :accepted :template-resolved
                                 {:resolved-core resolved-core
                                  :predecessor-observation
                                  observation-record
                                  :provenance-binding provenance-record})
                                (sh07-b51-template-resolution-boundary
                                 :invocation-mismatch))
                              (sh07-b51-template-resolution-boundary
                               :invocation-mismatch))
                            (sh07-b51-template-resolution-boundary
                             :invocation-mismatch))
                          (sh07-b51-template-resolution-boundary
                           :invocation-mismatch)))
                      (sh07-b51-template-resolution-boundary
                       :invocation-mismatch))
                    (sh07-b51-template-resolution-boundary
                     :invocation-mismatch))
                  (sh07-b51-template-resolution-boundary
                   :invocation-mismatch)))
              (sh07-b51-template-resolution-boundary :invocation-mismatch))
            (sh07-b51-template-resolution-boundary :invocation-mismatch))
          (sh07-b51-template-resolution-boundary :invocation-mismatch)))
          (sh07-b51-template-resolution-boundary :digest-mismatch))
        (sh07-b51-template-resolution-boundary :invocation-mismatch))
      (sh07-b51-template-resolution-boundary :malformed-invocation))
    (sh07-b51-template-resolution-boundary :malformed-invocation))
  (sh07-b51-template-resolution-boundary :malformed-invocation)))

(defn sh07-b51-producer-reference-vector [first-ordinal count-value]
  (loop [ordinal first-ordinal remaining count-value result []]
    (if (= remaining 0)
      result
      (recur
       (+ ordinal 1) (- remaining 1)
       (conj result (sh07-b51-internal-reference ordinal))))))

(defn sh07-b51-producer-slot-reference-vectors
  [slots first-ordinal count-field]
  (loop [remaining slots ordinal first-ordinal result []]
    (if (= (count remaining) 0)
      {:vectors result :next-ordinal ordinal}
      (let [count-value (get (get (first remaining) :pattern) count-field)]
        (recur
         (rest remaining) (+ ordinal count-value)
         (conj result
               (sh07-b51-producer-reference-vector ordinal count-value)))))))

(defn sh07-b51-producer-product-reference-vectors
  [slots first-ordinal]
  (loop [remaining slots ordinal first-ordinal result [] projections []]
    (if (= (count remaining) 0)
      {:vectors result :projections projections :next-ordinal ordinal}
      (let [pattern (get (first remaining) :pattern)
            vector-count (get pattern :vector-node-count)
            terminal-count (get pattern :terminal-count)
            count-value (+ 2 vector-count terminal-count)
            references
            (sh07-b51-producer-reference-vector ordinal count-value)
            projection-start (+ vector-count 1)]
        (recur
         (rest remaining) (+ ordinal count-value)
         (conj result references)
         (conj
          projections
          (loop [index projection-start values []]
            (if (= index (+ projection-start terminal-count))
              values
              (recur (+ index 1) (conj values (get references index)))))))))))

(defn sh07-b51-producer-recur-projection-vectors
  [slot-plans product-vectors]
  (loop [remaining-slots slot-plans
         remaining-products product-vectors result []]
    (if (= (count remaining-slots) 0)
      result
      (let [check-count
            (count (get (first remaining-slots) :runtime-check-preimages))
            terminal-count
            (count (get (first remaining-slots) :terminal-projections))
            products (first remaining-products)]
        (recur
         (rest remaining-slots) (rest remaining-products)
         (conj
          result
          (loop [index check-count values []]
            (if (= index (+ check-count terminal-count))
              values
              (recur (+ index 1) (conj values (get products index)))))))))))

(defn sh07-b51-producer-initialization-layout
  [owner-slots owner-index counters]
  (let [base (+ 1000000000 (* owner-index 10000000))
        slot-count (count owner-slots)
        extractions
        (sh07-b51-producer-slot-reference-vectors
         owner-slots (+ base 2000000) :extraction-count)
        checks
        (sh07-b51-producer-slot-reference-vectors
         owner-slots (+ base 3000000) :vector-node-count)
        products
        (sh07-b51-producer-product-reference-vectors
         owner-slots (+ base 5000000))]
    {:layout
     {:predecessor-authority-id (sh07-b51-internal-reference 5)
      :owner-core-node-id (sh07-b51-internal-reference base)
      :initializer-core-node-ids
      (sh07-b51-producer-reference-vector (+ base 1000000) slot-count)
      :slot-ids
      (sh07-b51-producer-reference-vector (+ base 1500000) slot-count)
      :extraction-id-vectors (get extractions :vectors)
      :runtime-check-id-vectors (get checks :vectors)
      :publication-event-ids
      (sh07-b51-producer-reference-vector (+ base 4000000) slot-count)
      :projection-id-vectors (get products :projections)
      :product-node-id-vectors (get products :vectors)
      :first-global-slot-ordinal (get counters :slot)
      :first-global-extraction-ordinal (get counters :extraction)
      :first-global-runtime-check-ordinal (get counters :check)
      :first-global-publication-ordinal (get counters :publication)}
     :next-counters
     {:slot (+ (get counters :slot) slot-count)
      :extraction
      (+ (get counters :extraction)
         (loop [remaining owner-slots total 0]
           (if (= (count remaining) 0) total
             (recur
              (rest remaining)
              (+ total
                 (get (get (first remaining) :pattern)
                      :extraction-count))))))
      :check
      (+ (get counters :check)
         (loop [remaining owner-slots total 0]
           (if (= (count remaining) 0) total
             (recur
              (rest remaining)
              (+ total
                 (get (get (first remaining) :pattern)
                      :vector-node-count))))))
      :publication (+ (get counters :publication) slot-count)
      :mapping (get counters :mapping)}}))

(defn sh07-b51-producer-recur-layout
  [slot-plans owner-index recur-index counters]
  (let [base
        (+ 1000000000000000000
           (* owner-index 1000000000000000)
           (* recur-index 1000000000))
        checks
        (loop [remaining slot-plans ordinal (+ base 20000) result []]
          (if (= (count remaining) 0)
            {:vectors result :next-ordinal ordinal}
            (let [count-value
                  (count (get (first remaining) :runtime-check-preimages))]
              (recur
               (rest remaining) (+ ordinal count-value)
               (conj result
                     (sh07-b51-producer-reference-vector
                      ordinal count-value))))))
        products
        (loop [remaining slot-plans ordinal (+ base 40000) result []]
          (if (= (count remaining) 0)
            {:vectors result :next-ordinal ordinal}
            (let [count-value
                  (+ (count (get (first remaining) :runtime-check-preimages))
                     (count (get (first remaining) :terminal-projections)))]
              (recur
               (rest remaining) (+ ordinal count-value)
               (conj result
                     (sh07-b51-producer-reference-vector
                      ordinal count-value))))))
        slot-count (count slot-plans)
        check-count
        (loop [remaining slot-plans total 0]
          (if (= (count remaining) 0) total
            (recur
             (rest remaining)
             (+ total
                (count (get (first remaining) :runtime-check-preimages))))))]
    {:layout
     {:predecessor-authority-id (sh07-b51-internal-reference 5)
      :recur-core-node-id (sh07-b51-internal-reference base)
      :argument-node-ids
      (sh07-b51-producer-reference-vector (+ base 10000) slot-count)
      :runtime-check-id-vectors (get checks :vectors)
      :projection-id-vectors
      (sh07-b51-producer-recur-projection-vectors
       slot-plans (get products :vectors))
      :product-node-id-vectors (get products :vectors)
      :argument-product-node-ids
      (sh07-b51-producer-reference-vector (+ base 50000) slot-count)
      :commit-product-node-id (sh07-b51-internal-reference (+ base 60000))
      :publication-event-id (sh07-b51-internal-reference (+ base 70000))
      :recur-slot-mapping-id (sh07-b51-internal-reference (+ base 80000))
      :first-global-runtime-check-ordinal (get counters :check)
      :global-publication-ordinal (get counters :publication)
      :global-recur-mapping-ordinal (get counters :mapping)}
     :next-counters
     {:slot (get counters :slot)
      :extraction (get counters :extraction)
      :check (+ (get counters :check) check-count)
      :publication (+ (get counters :publication) 1)
      :mapping (+ (get counters :mapping) 1)}}))

(defn sh07-b51-producer-owner-slot-slice [slots first-index count-value]
  (loop [index first-index remaining count-value result []]
    (if (= remaining 0)
      result
      (recur (+ index 1) (- remaining 1) (conj result (get slots index))))))

(defn sh07-b51-producer-loop-recur-entries
  [request indexes foundation owner-index counters]
  (let [collected
        (sh07-b51-collect-recur-forms-from-body
         request indexes (get foundation :fragment)
         (get foundation :body-forms))]
    (if (= (get collected :status) :accepted)
      (let [classified
            (sh07-b51-classify-loop-body-recurs
             request indexes foundation (get collected :recur-forms))]
        (if (= (get classified :status) :accepted)
          (loop [remaining (get classified :loop-recurs)
                 recur-index 0 state counters result []]
            (if (= (count remaining) 0)
              {:status :accepted :entries result :next-counters state}
              (let [allocated
                    (sh07-b51-producer-recur-layout
                     (get foundation :slot-plans)
                     owner-index recur-index state)]
                (recur
                 (rest remaining) (+ recur-index 1)
                 (get allocated :next-counters)
                 (conj
                  result
                  {:recur-form-id (get (first remaining) :form-id)
                   :layout (get allocated :layout)})))))
          classified))
      collected)))

(defn sh07-b51-producer-owner-plans [request]
  (let [collected (sh07-b51-collect-module-owner-slots request)
        indexes (sh07-b51-index-request request)]
    (if (= (get collected :status) :accepted)
      (loop [remaining (get collected :owners)
             owner-index 0 slot-index 0
             counters {:slot 0 :extraction 0 :check 0
                       :publication 0 :mapping 0}
             result []]
        (if (= (count remaining) 0)
          {:status :accepted :owner-plans result
           :next-counters counters
           :module-global-preflight
           (get collected :module-global-preflight)}
          (let [owner (first remaining)
                slot-count (get owner :slot-count)
                owner-slots
                (sh07-b51-producer-owner-slot-slice
                 (get collected :slots) slot-index slot-count)
                initialized
                (sh07-b51-producer-initialization-layout
                 owner-slots owner-index counters)
                form
                (sh07-b51-find-form indexes (get owner :enclosing-form-id))
                foundation
                (if (= (get owner :owner-kind) :let)
                  (sh07-b51-lower-let-slots-foundation
                   request form (get initialized :layout))
                  (sh07-b51-lower-loop-slots-foundation
                   request form (get initialized :layout)))]
            (if (= (get foundation :status) :accepted)
              (let [recurs
                    (if (= (get owner :owner-kind) :loop)
                      (sh07-b51-producer-loop-recur-entries
                       request indexes foundation owner-index
                       (get initialized :next-counters))
                      {:status :accepted :entries []
                       :next-counters (get initialized :next-counters)})]
                (if (= (get recurs :status) :accepted)
                  (recur
                   (rest remaining) (+ owner-index 1)
                   (+ slot-index slot-count)
                   (get recurs :next-counters)
                   (conj
                    result
                    {:owner-form-id (get owner :enclosing-form-id)
                     :initialization-layout (get initialized :layout)
                     :recur-layout-entries (get recurs :entries)}))
                  recurs))
              foundation))))
      collected)))

(defn sh07-b51-producer-planner-reference-ordinals [value]
  (if (sh07-b51-internal-reference? value)
    [(get value :ordinal)]
    (if (vector? value)
      (loop [remaining value result []]
        (if (= (count remaining) 0) result
          (recur
           (rest remaining)
           (sh07-b51-vector-append
            result
            (sh07-b51-producer-planner-reference-ordinals
             (first remaining))))))
      (if (map? value)
        (loop [remaining (vec value) result []]
          (if (= (count remaining) 0) result
            (recur
             (rest remaining)
             (sh07-b51-vector-append
              result
              (sh07-b51-producer-planner-reference-ordinals
               (second (first remaining)))))))
        []))))

(defn sh07-b51-producer-allocation-reference-ordinals [value]
  (if (sh07-b51-internal-reference? value)
    [(get value :ordinal)]
    (if (vector? value)
      (loop [remaining value result []]
        (if (= (count remaining) 0) result
          (recur
           (rest remaining)
           (sh07-b51-vector-append
            result
            (sh07-b51-producer-allocation-reference-ordinals
             (first remaining))))))
      (if (map? value)
        (loop [remaining (vec value) result []]
          (if (= (count remaining) 0) result
            (let [entry (first remaining)]
              (recur
               (rest remaining)
               (if (= (first entry) :projection-id-vectors)
                 result
                 (sh07-b51-vector-append
                  result
                  (sh07-b51-producer-allocation-reference-ordinals
                   (second entry))))))))
        []))))

(defn sh07-b51-producer-planner-references-unique? [owner-plans]
  (let [ordinals
        (sh07-b51-producer-allocation-reference-ordinals owner-plans)
        generated
        (loop [remaining ordinals result []]
          (if (= (count remaining) 0) result
            (let [ordinal (first remaining)]
              (recur
               (rest remaining)
               (if (contains? #{2 5} ordinal)
                 result (conj result ordinal))))))]
    (sh07-b51-all-unique? generated)))

(defn sh07-b51-producer-allocation-regions-valid? []
  (if (< (+ 1000000000 (* 1023 10000000) 8000000)
         1000000000000000000)
    (if (< (+ (* 65535 1000000000) 1000000)
           1000000000000000)
      (< (+ 1000000000000000000
            (* 1023 1000000000000000)
            (* 65535 1000000000) 1000000)
         9223372036854775807)
      false)
    false))

(defn sh07-b51-producer-provisional-numbered [request]
  (let [planned (sh07-b51-producer-owner-plans request)]
    (if (= (get planned :status) :accepted)
      (let [owner-plans (get planned :owner-plans)
            expected
            (sh07-b51-compose-expected-occurrence-specs request owner-plans)]
        (if (sh07-b51-producer-allocation-regions-valid?)
        (if (sh07-b51-producer-planner-references-unique? owner-plans)
        (if (= (get expected :status) :accepted)
          (let [numbered
                (sh07-b51-compose-numbered-preimages
                 request owner-plans (get expected :specs)
                 (sh07-b51-internal-reference 5)
                 (sh07-b51-internal-reference 2))]
            (if (= (get numbered :status) :accepted)
              {:status :accepted
               :owner-plans owner-plans
               :expected-specs (get expected :specs)
               :postorder-records (get expected :postorder-records)
               :materialized-owners (get expected :materialized-owners)
               :numbered numbered
               :module-global-preflight
               (get planned :module-global-preflight)
               :partial-products []}
              numbered))
          expected)
        {:status :rejected :reason :producer-provisional-reference-collision
         :partial-products []})
        {:status :rejected :reason :producer-allocation-region-proof
         :partial-products []}))
      planned)))

(defn sh07-b51-producer-purpose-counts-from-numbered [provisional]
  (let [numbered (get provisional :numbered)
        replay (get numbered :occurrence-replay)
        counts (get replay :category-counts)]
    {:core (get counts :global-core-node-ordinal)
     :product (get counts :global-product-ordinal)
     :slot (get counts :global-slot-ordinal)
     :extraction (get counts :global-extraction-ordinal)
     :check (get counts :global-runtime-check-ordinal)
     :publication (get counts :global-publication-ordinal)
     :mapping (get counts :global-recur-mapping-ordinal)
     :transcript (get counts :global-transcript-ordinal)}))

(defn sh07-b51-producer-purpose-bases [legacy? counts]
  (let [core-base (if legacy? 6 5)
        product-base (+ core-base (if legacy? 0 (get counts :core)))
        slot-base (+ product-base (get counts :product))
        extraction-base (+ slot-base (get counts :slot))
        check-base (+ extraction-base (get counts :extraction))
        publication-base (+ check-base (get counts :check))
        mapping-base (+ publication-base (get counts :publication))
        transcript-base (+ mapping-base (get counts :mapping))]
    {:implementation 0 :contract 1 :same-request 2
     :verification (if legacy? 3 nil)
     :outcome (if legacy? 4 3)
     :authority (if legacy? 5 4)
     :core core-base :product product-base :slot slot-base
     :extraction extraction-base :check check-base
     :publication publication-base :mapping mapping-base
     :transcript transcript-base :identity (+ transcript-base 1)
     :observation (+ transcript-base 2)
     :provenance (+ transcript-base 3)
     :verifier (+ transcript-base 4)
     :final (+ transcript-base 5)}))

(defn sh07-b51-producer-row-base-key [record-kind]
  (if (= record-kind :supplemental-product) :product
    (if (= record-kind :binding-slot) :slot
      (if (= record-kind :binding-extraction) :extraction
        (if (= record-kind :runtime-check) :check
          (if (= record-kind :publication-event) :publication
            (if (= record-kind :recur-slot-mapping) :mapping nil)))))))

(defn sh07-b51-producer-numbered-reference-map [rows bases]
  (loop [remaining rows result {}]
    (if (= (count remaining) 0)
      result
      (let [row (first remaining)
            key (sh07-b51-producer-row-base-key (get row :record-kind))
            reference (get row :reference)]
        (if (keyword? key)
          (recur
           (rest remaining)
           (assoc
            result (get reference :ordinal)
            (+ (get bases key) (get row :global-ordinal))))
          (recur (rest remaining) result))))))

(defn sh07-b51-producer-find-postorder-by-form-id [records form-id]
  (loop [remaining records found nil count-found 0]
    (if (= (count remaining) 0)
      {:record found :count count-found}
      (if (= (get (first remaining) :form-id) form-id)
        (recur (rest remaining) (first remaining) (+ count-found 1))
        (recur (rest remaining) found count-found)))))

(defn sh07-b51-producer-add-core-reference
  [mapping reference form-id postorder-records core-base]
  (let [selected
        (sh07-b51-producer-find-postorder-by-form-id
         postorder-records form-id)]
    (if (= (get selected :count) 1)
      {:status :accepted
       :mapping
       (assoc
        mapping (get reference :ordinal)
        (+ core-base
           (get (get selected :record) :core-postorder-index)))}
      {:status :rejected :reason :producer-core-occurrence-join
       :partial-products []})))

(defn sh07-b51-producer-add-slot-core-references
  [mapping slot-plans layout postorder-records core-base]
  (loop [remaining slot-plans index 0 result mapping]
    (if (= (count remaining) 0)
      {:status :accepted :mapping result}
      (let [preimage (get (first remaining) :binding-slot-preimage)
            added
            (sh07-b51-producer-add-core-reference
             result (get (get layout :initializer-core-node-ids) index)
             (get preimage :initializer-form-id)
             postorder-records core-base)]
        (if (= (get added :status) :accepted)
          (recur
           (rest remaining) (+ index 1) (get added :mapping))
          added)))))

(defn sh07-b51-producer-add-argument-core-references
  [mapping evaluations references postorder-records core-base]
  (loop [remaining-evaluations evaluations
         remaining-references references result mapping]
    (if (= (count remaining-evaluations) 0)
      {:status :accepted :mapping result}
      (let [added
            (sh07-b51-producer-add-core-reference
             result (first remaining-references)
             (get (first remaining-evaluations) :argument-form-id)
             postorder-records core-base)]
        (if (= (get added :status) :accepted)
          (recur
           (rest remaining-evaluations) (rest remaining-references)
           (get added :mapping))
          added)))))

(defn sh07-b51-producer-add-recur-core-references
  [mapping owner-entry postorder-records core-base]
  (loop [remaining-sites (get owner-entry :loop-recur-sites)
         remaining-layouts (get owner-entry :recur-layout-entries)
         result mapping]
    (if (= (count remaining-sites) 0)
      {:status :accepted :mapping result}
      (let [site (first remaining-sites)
            layout (get (first remaining-layouts) :layout)
            recur-form-id
            (get (get site :recur-coordinate) :recur-form-id)
            recur-added
            (sh07-b51-producer-add-core-reference
             result (get layout :recur-core-node-id)
             recur-form-id postorder-records core-base)]
        (if (= (get recur-added :status) :accepted)
          (let [arguments-added
                (sh07-b51-producer-add-argument-core-references
                 (get recur-added :mapping)
                 (get site :argument-evaluations)
                 (get layout :argument-node-ids)
                 postorder-records core-base)]
            (if (= (get arguments-added :status) :accepted)
              (recur
               (rest remaining-sites) (rest remaining-layouts)
               (get arguments-added :mapping))
              arguments-added))
          recur-added)))))

(defn sh07-b51-producer-core-reference-map [provisional bases]
  (loop [remaining (get provisional :materialized-owners)
         result {}]
    (if (= (count remaining) 0)
      {:status :accepted :mapping result}
      (let [owner-entry (first remaining)
            foundation (get owner-entry :foundation)
            layout (get owner-entry :initialization-layout)
            owner-added
            (sh07-b51-producer-add-core-reference
             result (get layout :owner-core-node-id)
             (get owner-entry :owner-form-id)
             (get provisional :postorder-records) (get bases :core))]
        (if (= (get owner-added :status) :accepted)
          (let [slots-added
                (sh07-b51-producer-add-slot-core-references
                 (get owner-added :mapping) (get foundation :slot-plans)
                 layout (get provisional :postorder-records)
                 (get bases :core))]
            (if (= (get slots-added :status) :accepted)
              (let [recurs-added
                    (sh07-b51-producer-add-recur-core-references
                     (get slots-added :mapping) owner-entry
                     (get provisional :postorder-records)
                     (get bases :core))]
                (if (= (get recurs-added :status) :accepted)
                  (recur (rest remaining) (get recurs-added :mapping))
                  recurs-added))
              slots-added))
          owner-added)))))

(defn sh07-b51-producer-rewrite-planner-value [value mapping]
  (if (sh07-b51-internal-reference? value)
    (let [ordinal (get value :ordinal)
          replacement (get mapping ordinal)]
      (if (integer? replacement)
        (sh07-b51-internal-reference replacement)
        value))
    (if (vector? value)
      (loop [remaining value result []]
        (if (= (count remaining) 0) result
          (recur
           (rest remaining)
           (conj result
                 (sh07-b51-producer-rewrite-planner-value
                  (first remaining) mapping)))))
      (if (map? value)
        (loop [remaining (vec value) result {}]
          (if (= (count remaining) 0) result
            (let [entry (first remaining)]
              (recur
               (rest remaining)
               (assoc
                result (first entry)
                (sh07-b51-producer-rewrite-planner-value
                 (second entry) mapping))))))
        value))))

(defn sh07-b51-producer-final-plan-references-bounded?
  [owner-plans request-count]
  (loop [remaining
         (sh07-b51-producer-planner-reference-ordinals owner-plans)]
    (if (= (count remaining) 0)
      true
      (if (< (first remaining) request-count)
        (recur (rest remaining))
        false))))

(defn sh07-b51-producer-final-owner-plans
  [provisional legacy?]
  (if legacy?
    {:status :rejected :reason :producer-legacy-concrete-core-path-required
     :partial-products []}
  (let [counts (sh07-b51-producer-purpose-counts-from-numbered provisional)
        bases (sh07-b51-producer-purpose-bases legacy? counts)
        row-mapping
        (sh07-b51-producer-numbered-reference-map
         (get (get provisional :numbered) :numbered-preimage-rows) bases)
        core-mapping (sh07-b51-producer-core-reference-map provisional bases)]
    (if (= (get core-mapping :status) :accepted)
      (let [mapping
            (assoc
             (assoc
              (loop [remaining (vec row-mapping)
                     result (get core-mapping :mapping)]
                (if (= (count remaining) 0) result
                  (recur
                   (rest remaining)
                   (assoc result
                          (first (first remaining))
                          (second (first remaining))))))
              5 (get bases :authority))
             2 (get bases :same-request))]
        (let [rewritten
              (sh07-b51-producer-rewrite-planner-value
               (get provisional :owner-plans) mapping)]
          (if (sh07-b51-producer-final-plan-references-bounded?
               rewritten (+ (get bases :final) 1))
            {:status :accepted :owner-plans rewritten
             :counts counts :bases bases :reference-mapping mapping
             :no-provisional-reference-survives true}
            {:status :rejected
             :reason :producer-provisional-reference-survived
             :partial-products []})))
      core-mapping))))

(defn sh07-b51-producer-numbered-preimage-normalized
  [expected candidate kind]
  (if (= kind :slot)
    (assoc expected :global-slot-ordinal
           (get candidate :global-slot-ordinal))
    (if (= kind :extraction)
      (assoc
       (assoc expected :global-slot-ordinal
              (get candidate :global-slot-ordinal))
       :global-ordinal (get candidate :global-ordinal))
      (if (= kind :runtime)
        (assoc
         (assoc expected :global-runtime-check-ordinal
                (get candidate :global-runtime-check-ordinal))
         :guarded-publication-ordinal
         (get candidate :guarded-publication-ordinal))
        (if (= kind :publication)
          (assoc
           (assoc expected :global-publication-ordinal
                  (get candidate :global-publication-ordinal))
           :commit-order (get candidate :commit-order))
          (if (= kind :mapping)
            (assoc expected :global-recur-mapping-ordinal
                   (get candidate :global-recur-mapping-ordinal))
            expected))))))

(defn sh07-b51-producer-select-numbered-preimage
  [preimages references expected kind]
  (if (= (count preimages) (count references))
    (loop [remaining-preimages preimages remaining-references references
           found-preimage nil found-reference nil found-count 0]
      (if (= (count remaining-preimages) 0)
        (if (= found-count 1)
          {:status :accepted :preimage found-preimage
           :reference found-reference}
          {:status :rejected :reason :producer-numbered-preimage-join
           :partial-products []})
        (let [candidate (first remaining-preimages)]
          (if (= candidate
                 (sh07-b51-producer-numbered-preimage-normalized
                  expected candidate kind))
            (recur
             (rest remaining-preimages) (rest remaining-references)
             candidate (first remaining-references) (+ found-count 1))
            (recur
             (rest remaining-preimages) (rest remaining-references)
             found-preimage found-reference found-count)))))
    {:status :rejected :reason :producer-numbered-preimage-cardinality
     :partial-products []}))

(defn sh07-b51-producer-reconcile-preimage-vector
  [expected-preimages numbered-preimages numbered-references kind]
  (loop [remaining expected-preimages preimages [] references []]
    (if (= (count remaining) 0)
      {:status :accepted :preimages preimages :references references}
      (let [selected
            (sh07-b51-producer-select-numbered-preimage
             numbered-preimages numbered-references (first remaining) kind)]
        (if (= (get selected :status) :accepted)
          (recur
           (rest remaining)
           (conj preimages (get selected :preimage))
           (conj references (get selected :reference)))
          selected)))))

(defn sh07-b51-producer-reconcile-slot-plan [slot-plan numbered]
  (let [slot
        (sh07-b51-producer-select-numbered-preimage
         (get numbered :binding-slot-preimages)
         (get numbered :binding-slot-references)
         (get slot-plan :binding-slot-preimage) :slot)
        extractions
        (sh07-b51-producer-reconcile-preimage-vector
         (get slot-plan :binding-extraction-preimages)
         (get numbered :binding-extraction-preimages)
         (get numbered :binding-extraction-references) :extraction)
        checks
        (sh07-b51-producer-reconcile-preimage-vector
         (get slot-plan :runtime-check-preimages)
         (get numbered :runtime-check-preimages)
         (get numbered :runtime-check-references) :runtime)
        publication
        (sh07-b51-producer-select-numbered-preimage
         (get numbered :publication-event-preimages)
         (get numbered :publication-event-references)
         (get slot-plan :publication-event-preimage) :publication)]
    (if (= (get slot :status) :accepted)
      (if (= (get extractions :status) :accepted)
        (if (= (get checks :status) :accepted)
          (if (= (get publication :status) :accepted)
            {:status :accepted
             :slot-plan
             (assoc
              (assoc
               (assoc
                (assoc
                 (assoc
                  (assoc
                   (assoc slot-plan
                          :binding-slot-preimage (get slot :preimage))
                   :slot-id (get slot :reference))
                  :binding-extraction-preimages
                  (get extractions :preimages))
                 :extraction-ids (get extractions :references))
                :runtime-check-preimages (get checks :preimages))
               :runtime-check-ids (get checks :references))
              :publication-event-preimage (get publication :preimage))
             :publication-reference (get publication :reference)}
            publication)
          checks)
        extractions)
      slot)))

(defn sh07-b51-producer-reconcile-slot-plans [slot-plans numbered]
  (loop [remaining slot-plans result []]
    (if (= (count remaining) 0)
      {:status :accepted :slot-plans result}
      (let [built
            (sh07-b51-producer-reconcile-slot-plan
             (first remaining) numbered)]
        (if (= (get built :status) :accepted)
          (recur
           (rest remaining)
           (conj result
                 (assoc
                  (get built :slot-plan) :publication-event-id
                  (get built :publication-reference))))
          built)))))

(defn sh07-b51-producer-reconcile-recur-site [site numbered]
  (let [checks
        (loop [remaining (get site :runtime-check-preimage-vectors)
               preimage-vectors [] reference-vectors []]
          (if (= (count remaining) 0)
            {:status :accepted :preimage-vectors preimage-vectors
             :reference-vectors reference-vectors}
            (let [built
                  (sh07-b51-producer-reconcile-preimage-vector
                   (first remaining)
                   (get numbered :runtime-check-preimages)
                   (get numbered :runtime-check-references) :runtime)]
              (if (= (get built :status) :accepted)
                (recur
                 (rest remaining)
                 (conj preimage-vectors (get built :preimages))
                 (conj reference-vectors (get built :references)))
                built))))
        publication
        (sh07-b51-producer-select-numbered-preimage
         (get numbered :publication-event-preimages)
         (get numbered :publication-event-references)
         (get site :publication-event-preimage) :publication)
        mapping
        (sh07-b51-producer-select-numbered-preimage
         (get numbered :recur-slot-mapping-preimages)
         (get numbered :recur-slot-mapping-references)
         (get site :recur-slot-mapping-preimage) :mapping)]
    (if (= (get checks :status) :accepted)
      (if (= (get publication :status) :accepted)
        (if (= (get mapping :status) :accepted)
          {:status :accepted
           :recur-site
           (assoc
            (assoc
             (assoc site :runtime-check-preimage-vectors
                    (get checks :preimage-vectors))
             :publication-event-preimage (get publication :preimage))
            :recur-slot-mapping-preimage (get mapping :preimage))
           :runtime-check-reference-vectors (get checks :reference-vectors)
           :publication-reference (get publication :reference)
           :mapping-reference (get mapping :reference)}
          mapping)
        publication)
      checks)))

(defn sh07-b51-producer-reconcile-recur-sites [sites numbered]
  (loop [remaining sites result []]
    (if (= (count remaining) 0)
      {:status :accepted :sites result}
      (let [built
            (sh07-b51-producer-reconcile-recur-site
             (first remaining) numbered)]
        (if (= (get built :status) :accepted)
          (recur (rest remaining) (conj result built))
          built)))))

(defn sh07-b51-producer-reconcile-materialized-owners
  [owners numbered]
  (loop [remaining owners result []]
    (if (= (count remaining) 0)
      {:status :accepted :owners result}
      (let [owner (first remaining)
            slots
            (sh07-b51-producer-reconcile-slot-plans
             (get (get owner :foundation) :slot-plans) numbered)
            sites
            (sh07-b51-producer-reconcile-recur-sites
             (get owner :loop-recur-sites) numbered)]
        (if (= (get slots :status) :accepted)
          (if (= (get sites :status) :accepted)
            (recur
             (rest remaining)
             (conj
              result
              (assoc
               (assoc owner :foundation
                      (assoc (get owner :foundation) :slot-plans
                             (get slots :slot-plans)))
               :loop-recur-sites
               (loop [remaining-sites (get sites :sites) values []]
                 (if (= (count remaining-sites) 0) values
                   (recur
                    (rest remaining-sites)
                    (conj values (get (first remaining-sites) :recur-site))))))))
            sites)
          slots)))))

(defn sh07-b51-producer-two-pass-numbered [request legacy?]
  (let [provisional (sh07-b51-producer-provisional-numbered request)]
    (if (= (get provisional :status) :accepted)
      (let [final-plans
            (sh07-b51-producer-final-owner-plans provisional legacy?)]
        (if (= (get final-plans :status) :accepted)
          (let [owner-plans (get final-plans :owner-plans)
                expected
                (sh07-b51-compose-expected-occurrence-specs
                 request owner-plans)]
            (if (= (get expected :status) :accepted)
              (let [numbered
                    (sh07-b51-compose-numbered-preimages
                     request owner-plans (get expected :specs)
                     (sh07-b51-internal-reference
                      (get (get final-plans :bases) :authority))
                     (sh07-b51-internal-reference
                      (get (get final-plans :bases) :same-request)))]
                (if (= (get numbered :status) :accepted)
                  (let [reconciled
                        (sh07-b51-producer-reconcile-materialized-owners
                         (get expected :materialized-owners) numbered)]
                    (if (= (get reconciled :status) :accepted)
                      {:status :accepted
                       :owner-plans owner-plans
                       :expected-specs (get expected :specs)
                       :postorder-records (get expected :postorder-records)
                       :materialized-owners (get reconciled :owners)
                       :numbered numbered
                       :counts (get final-plans :counts)
                       :bases (get final-plans :bases)
                       :reference-mapping
                       (get final-plans :reference-mapping)
                       :module-global-preflight
                       (get provisional :module-global-preflight)
                       :partial-products []}
                      reconciled))
                  numbered))
              expected))
          final-plans))
      provisional)))

(defn sh07-b51-producer-implementation-preimage [carrier]
  (let [linked (get carrier :v18-executable-descriptor)]
    {:domain :gravity/sh07-b51-linked-implementation-semantic-id-preimage-v3
     :schema-version 3
     :predecessor-executable-descriptor
     (get carrier :predecessor-executable-descriptor)
     :semantic-manifest (get linked :semantic-manifest)
     :semantic-root-hash (get linked :semantic-root-hash)}))

(defn sh07-b51-producer-contract-preimage [carrier]
  (let [contract (get carrier :predecessor-contract-carrier)]
    {:domain :gravity/sh07-b51-contract-semantic-id-preimage-v18
     :schema-version 18
     :predecessor-contract-carrier contract
     :retained-source-contract (get contract :source-contract-forms)}))

(defn sh07-b51-producer-same-request-preimage [request]
  {:domain :gravity/sh07-b51-same-request-binding-v18
   :schema-version 18
   :request-artifact :gravity/sh07-authenticated-sh06-core-request
   :request-schema-version 15
   :request-semantic-id (get request :projection-binding)
   :source-revision-id (get (get request :lineage) :source-revision-id)
   :top-level-root-semantic-ids (get request :top-level-form-ids)})

(defn sh07-b51-producer-v16-verification-preimage [carrier]
  (let [structural
        (get
         (get (get carrier :predecessor-raw-outcome)
              :structural-runner-observation)
         :returned)
        artifact (get structural :canonical-core-artifact)]
    {:domain :gravity/sh07-b51-v16-verification-semantic-v18
     :schema-version 18 :status :passed
     :template-verification (get structural :template-verification)
     :resolved-verification (get structural :resolved-verification)
     :resolved-v16-identity-preimage
     (sh07-b51-v16-normalize-identity-preimage
      (get artifact :identity-preimage))}))

(defn sh07-b51-producer-outcome-kind [carrier]
  (let [request (get carrier :authenticated-sh06-request)
        direct
        (get (get (get carrier :predecessor-raw-outcome)
                  :direct-template-observation)
             :returned)]
    (if (= (get direct :status) :accepted)
      (let [artifact
            (get
             (get
              (get (get carrier :predecessor-raw-outcome)
                   :structural-runner-observation)
              :returned)
             :canonical-core-artifact)]
        (if (if (map? artifact)
              (if (= (get artifact :artifact)
                     :gravity/sh07-canonical-core-artifact)
                (if (= (get artifact :schema-version) 16)
                  (if (sh07-b51-sha256-id? (get artifact :artifact-id))
                    (map? (get artifact :identity-preimage)) false)
                  false)
                false)
              false)
          {:status :accepted :outcome-kind :legacy-v16-accepted}
          {:status :rejected
           :reason :producer-legacy-structural-artifact-missing
           :partial-products []}))
      (let [indexes (sh07-b51-index-request request)
            replay
            (sh07-b51-v16-record-shape-replay
             (get carrier :sh06-resolution-artifact) request indexes)
            failing (get replay :failing-binding-ids)
            frontier (sh07-b51-first-vector-frontier request)
            lowered
            (if (if (= (get replay :status) :accepted)
                  (> (count failing) 0) false)
              (sh07-b51-v16-replay-lower-top-level
               (assoc request :internal-indexes
                      (sh07-b51-v16-replay-index-request request)))
              {:status :rejected})]
        (if (= (get replay :status) :accepted)
          (if (> (count failing) 0)
            (if (= (get lowered :status) :accepted)
              {:status :accepted
               :outcome-kind :legacy-v16-accepted-after-no-form-waiver
               :replay replay}
              (if (= (get frontier :status) :accepted)
                {:status :accepted
                 :outcome-kind
                 :b51-vector-frontier-rejected-after-no-form-waiver
                 :replay replay :frontier frontier}
                {:status :rejected :reason :producer-outcome-terminal
                 :partial-products []}))
            (if (= (get frontier :status) :accepted)
              {:status :accepted
               :outcome-kind :b51-vector-frontier-rejected
               :replay replay :frontier frontier}
              {:status :rejected :reason :producer-outcome-terminal
               :partial-products []}))
          replay)))))

(defn sh07-b51-producer-outcome-fixed-fields [bases]
  {:same-request-semantic-id
   (sh07-b51-internal-reference (get bases :same-request))
   :implementation-semantic-id
   (sh07-b51-internal-reference (get bases :implementation))
   :contract-semantic-id
   (sh07-b51-internal-reference (get bases :contract))})

(defn sh07-b51-producer-outcome-preimage
  [carrier derived bases]
  (let [kind (get derived :outcome-kind)
        request (get carrier :authenticated-sh06-request)
        fixed (sh07-b51-producer-outcome-fixed-fields bases)]
    (if (= (get derived :status) :accepted)
    (if (= kind :legacy-v16-accepted)
      (let [structural
            (get
             (get (get carrier :predecessor-raw-outcome)
                  :structural-runner-observation)
             :returned)
            artifact (get structural :canonical-core-artifact)]
        (if (if (map? artifact)
              (if (= (get artifact :artifact)
                     :gravity/sh07-canonical-core-artifact)
                (sh07-b51-sha256-id? (get artifact :artifact-id))
                false)
              false)
        (assoc
         (assoc
          (assoc
           (assoc
            (assoc
             (assoc
              (assoc
               (assoc
                (assoc fixed
                       :domain
                       :gravity/sh07-b51-predecessor-outcome-semantic-v18)
                :schema-version 18)
               :outcome-kind kind)
              :status :accepted)
             :identity-preimage-domain
             (get (get artifact :identity-preimage) :domain))
            :actual-core-artifact-kind (get artifact :artifact))
           :actual-wrapper-artifact-kind nil)
          :v16-semantic-artifact-id (get artifact :artifact-id))
         :v16-verification-semantic-id
         (sh07-b51-internal-reference (get bases :verification))
         :authorization :legacy-v16-equivalence)
        {:status :rejected
         :reason :producer-legacy-structural-artifact-missing
         :partial-products []}))
      (let [replay (get derived :replay)
            failing (get replay :failing-binding-ids)
            projections
            (if (> (count failing) 0)
              (sh07-b51-authenticated-no-form-projections
               (get carrier :sh06-resolution-artifact) request
               (sh07-b51-index-request request) failing)
              {:status :accepted :projections []})]
        (if (= (get projections :status) :accepted)
          (if (= kind :legacy-v16-accepted-after-no-form-waiver)
            (assoc
             (assoc
              (assoc
               (assoc
                (assoc
                 (assoc
                  (assoc
                   (assoc
                    (assoc
                     (assoc
                      (assoc
                       (assoc fixed
                              :domain
                              :gravity/sh07-b51-predecessor-outcome-semantic-v18)
                       :schema-version 18)
                      :outcome-kind kind)
                     :status :accepted)
                    :identity-preimage-domain nil)
                   :actual-core-artifact-kind nil)
                  :actual-wrapper-artifact-kind nil)
                 :frontier-rule "C6-VERIFY")
                :frontier-reason :authoritative-record-shape)
               :failing-binding-ids failing)
              :failing-declarations (get projections :projections))
             :replay-status :all-other-b47-invariants-passed
             :semantic-artifact-id nil
             :authorization :v18-authenticated-no-form-namespace)
            (let [frontier (get derived :frontier)
                  no-form?
                  (= kind
                     :b51-vector-frontier-rejected-after-no-form-waiver)
                  base
                  (assoc
                   fixed
                   :domain
                   :gravity/sh07-b51-predecessor-outcome-semantic-v18
                   :schema-version 18 :outcome-kind kind :status :rejected
                   :identity-preimage-domain nil
                   :actual-core-artifact-kind nil
                   :actual-wrapper-artifact-kind nil
                   :frontier-owner (get frontier :owner-kind)
                   :frontier-rule "C6-LOWERING-GAP"
                   :frontier-reason (get frontier :reason)
                   :frontier-binding-kind :vector
                   :frontier-form-id
                   (get (get frontier :diagnostic-form) :form-id)
                   :frontier-coordinate (get frontier :coordinate)
                   :semantic-artifact-id nil
                   :authorization
                   (if no-form?
                     :v18-no-form-namespace-and-vector-lowering
                     :v18-vector-lowering))]
              (if no-form?
                (assoc
                 (assoc
                  (assoc
                   (assoc base :waived-rule "C6-VERIFY")
                   :waived-reason :authoritative-record-shape)
                  :failing-binding-ids failing)
                 :failing-declarations (get projections :projections)
                 :replay-status
                 :all-invariants-before-expected-vector-stop-passed)
                base)))
          projections)))
    derived)))

(defn sh07-b51-producer-authority-preimage [outcome bases]
  {:domain :gravity/sh07-b51-predecessor-authority-v18
   :schema-version 18
   :implementation-semantic-id
   (sh07-b51-internal-reference (get bases :implementation))
   :contract-semantic-id
   (sh07-b51-internal-reference (get bases :contract))
   :same-request-semantic-id
   (sh07-b51-internal-reference (get bases :same-request))
   :outcome-semantic-id
   (sh07-b51-internal-reference (get bases :outcome))
   :outcome-kind (get outcome :outcome-kind)
   :semantic-artifact-id
   (if (= (get outcome :outcome-kind) :legacy-v16-accepted)
     (get outcome :v16-semantic-artifact-id)
     (get outcome :semantic-artifact-id))
   :authorization (get outcome :authorization)})

(defn sh07-b51-producer-success-request
  [ordinal purpose batch-ordinal core-count preimage]
  (let [spec (sh07-b51-success-purpose-spec purpose)
        seed
        {:ordinal ordinal :tier (get spec :tier)
         :subtier (get spec :subtier) :subtier-ordinal nil
         :batch (get spec :batch) :batch-rank (get spec :batch-rank)
         :batch-ordinal batch-ordinal :purpose purpose :preimage preimage}]
    (assoc
     seed :subtier-ordinal
     (sh07-b51-success-request-subtier-ordinal seed core-count))))

(defn sh07-b51-producer-append-purpose-requests
  [requests purpose preimages core-count]
  (loop [remaining preimages batch-ordinal 0 result requests]
    (if (= (count remaining) 0)
      result
      (recur
       (rest remaining) (+ batch-ordinal 1)
       (conj
        result
        (sh07-b51-producer-success-request
         (count result) purpose batch-ordinal core-count
         (first remaining)))))))

(defn sh07-b51-producer-record-from-preimage
  [preimage schema own-id-key own-id]
  (loop [remaining (vec preimage)
         result {:schema schema own-id-key own-id}]
    (if (= (count remaining) 0)
      result
      (let [entry (first remaining)]
        (recur
         (rest remaining)
         (if (contains? #{:domain :schema-version} (first entry))
           result
           (assoc result (first entry) (second entry))))))))

(defn sh07-b51-producer-simple-record-shape? [record schema]
  (if (= schema :gravity/sh07-b51-binding-extraction-v18)
    (sh07-b51-full-record-through-preimage-shape?
     record schema :extraction-id :sh07-b51-binding-extraction-id
     :gravity/sh07-b51-binding-extraction-id-preimage-v18)
    (if (= schema :gravity/sh07-b51-runtime-check-v18)
      (sh07-b51-full-record-through-preimage-shape?
       record schema :id :sh07-b51-runtime-check-id
       :gravity/sh07-b51-runtime-check-id-preimage-v18)
      (if (= schema :gravity/sh07-b51-publication-event-v18)
        (sh07-b51-full-record-through-preimage-shape?
         record schema :id :sh07-b51-publication-event-id
         :gravity/sh07-b51-publication-event-id-preimage-v18)
        (if (= schema :gravity/sh07-b51-recur-slot-mapping-v18)
          (sh07-b51-full-record-through-preimage-shape?
           record schema :mapping-id :sh07-b51-recur-slot-mapping-id
           :gravity/sh07-b51-recur-slot-mapping-id-preimage-v18)
          (if (= schema
                 :gravity/sh07-b51-slot-extraction-transcript-v18)
            (sh07-b51-transcript-record-shape? record)
            false))))))

(defn sh07-b51-producer-simple-record-vector
  [preimages references schema own-id-key]
  (if (= (count preimages) (count references))
    (loop [remaining-preimages preimages
           remaining-references references result []]
      (if (= (count remaining-preimages) 0)
        {:status :accepted :records result}
        (let [record
              (sh07-b51-producer-record-from-preimage
               (first remaining-preimages) schema own-id-key
               (first remaining-references))]
          (if (sh07-b51-producer-simple-record-shape? record schema)
            (recur
             (rest remaining-preimages) (rest remaining-references)
             (conj result record))
            {:status :rejected :reason :producer-simple-record-shape
             :partial-products []}))))
    {:status :rejected :reason :producer-record-reference-cardinality
     :partial-products []}))

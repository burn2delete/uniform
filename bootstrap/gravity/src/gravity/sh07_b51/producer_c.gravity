        (if (if (= record-kind :core)
              true
              (= (sh07-b51-record-global-ordinal
                  (first remaining) record-kind)
                 category-ordinal))
          (if (sh07-b51-record-request-join?
               (first remaining) record-kind purpose requests
               category-ordinal)
            (recur (rest remaining) (+ category-ordinal 1))
            false)

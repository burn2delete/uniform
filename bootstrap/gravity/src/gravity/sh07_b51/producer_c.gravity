      (let [ordinal (get reference :ordinal)]
        (if (< ordinal (count requests))
          (let [request (get requests ordinal)
                preimage (get request :preimage)
                expected
                (sh07-b51-record-seed-preimage record record-kind)]
            (if (= (get request :purpose) purpose)
              (if (= (get request :batch-ordinal) category-ordinal)
                (if (= record-kind :core)
                  (sh07-b51-core-node-record-preimage-agrees?
                   record preimage)
                  (= preimage expected))
                false)
              false))
          false))
      false)))

(defn sh07-b51-record-vector-request-joins?
  [records record-kind purpose requests]
  (if (vector? records)

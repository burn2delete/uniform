    (if (= (get registered :status) :accepted)
      (if (vector? dependencies)
        (loop [remaining (get registered :references)]
          (if (= (count remaining) 0)
            true
            (let [record (first remaining)
                  reference (get record :reference)
                  target-purpose (get record :target-purpose)
                  ordinal (get reference :ordinal)]
              (if (sh07-b51-purpose-dependency-active?
                   (get request :purpose) target-purpose outcome-kind)
                (if (< ordinal (count digest-requests))
                  (let [target (get digest-requests ordinal)]
                    (if (= (get target :ordinal) ordinal)
                      (if (= (get target :purpose) target-purpose)
                        (if (sh07-b51-strict-coordinate-earlier?
                             target request)
                          (recur (rest remaining))

         :retained-source-contract})
    (if (= (get preimage :domain)
           :gravity/sh07-b51-contract-semantic-id-preimage-v18)
      (if (= (get preimage :schema-version) 18)
        (if (sh07-b51-predecessor-contract-shape?
             (get preimage :predecessor-contract-carrier))
          (map? (get preimage :retained-source-contract))
          false)
        false)
      false)
    false))

(defn sh07-b51-generic-same-request-preimage-shape? [preimage]
  (if (sh07-b51-exact-keys?
       preimage
       #{:domain :schema-version :request-artifact
         :request-schema-version :request-semantic-id
         :source-revision-id :top-level-root-semantic-ids})
    (if (= (get preimage :domain)
           :gravity/sh07-b51-same-request-binding-v18)
      (if (= (get preimage :schema-version) 18)
        (if (= (get preimage :request-artifact)
               :gravity/sh07-authenticated-sh06-core-request)
          (if (= (get preimage :request-schema-version) 15)
            (if (sh07-b51-sha256-id?
                 (get preimage :request-semantic-id))
              (if (sh07-b51-sha256-id?
                   (get preimage :source-revision-id))
                (sh07-b51-all-sha256?
                 (get preimage :top-level-root-semantic-ids))
                false)
              false)
            false)
          false)
        false)
      false)
    false))

(defn sh07-b51-v16-verification-preimage-shape? [preimage]
  (if (sh07-b51-exact-keys?
       preimage
       #{:domain :schema-version :status :template-verification
         :resolved-verification :resolved-v16-identity-preimage})
    (if (= (get preimage :domain)
           :gravity/sh07-b51-v16-verification-semantic-v18)
      (if (= (get preimage :schema-version) 18)
        (if (= (get preimage :status) :passed)
          (if (sh07-b51-v16-template-verification-passed?
               (get preimage :template-verification))
            (if (sh07-b51-v16-resolved-verification-passed?
                 (get preimage :resolved-verification))
              (sh07-b51-v16-identity-preimage-shape?
               (get preimage :resolved-v16-identity-preimage))
              false)
            false)
          false)
        false)
      false)
    false))

(defn sh07-b51-legacy-outcome-preimage-shape? [preimage]
  (if (sh07-b51-exact-keys?
       preimage
       #{:domain :schema-version :outcome-kind :status
         :same-request-semantic-id :implementation-semantic-id
         :contract-semantic-id :identity-preimage-domain
         :actual-core-artifact-kind :actual-wrapper-artifact-kind
         :v16-semantic-artifact-id :v16-verification-semantic-id
         :authorization})
    (if (= (get preimage :domain)
           :gravity/sh07-b51-predecessor-outcome-semantic-v18)
      (if (= (get preimage :schema-version) 18)
        (if (= (get preimage :outcome-kind) :legacy-v16-accepted)
          (if (= (get preimage :status) :accepted)
            (if (= (get preimage :identity-preimage-domain)
                   :gravity/sh07-b47-canonical-core-v16)
              (if (= (get preimage :actual-core-artifact-kind)
                     :gravity/sh07-canonical-core-artifact)
                (if (= (get preimage :actual-wrapper-artifact-kind) nil)
                  (if (sh07-b51-sha256-id?
                       (get preimage :v16-semantic-artifact-id))
                    (if (sh07-b51-internal-reference?
                         (get preimage :v16-verification-semantic-id))
                      (= (get preimage :authorization)
                         :legacy-v16-equivalence)
                      false)
                    false)
                  false)
                false)
              false)
            false)
          false)
        false)
      false)
    false))

(defn sh07-b51-waived-accepted-outcome-preimage-shape? [preimage]
  (if (sh07-b51-exact-keys?
       preimage
       #{:domain :schema-version :outcome-kind :status
         :same-request-semantic-id :implementation-semantic-id
         :contract-semantic-id :identity-preimage-domain
         :actual-core-artifact-kind :actual-wrapper-artifact-kind
         :frontier-rule :frontier-reason :failing-binding-ids
         :failing-declarations :replay-status :semantic-artifact-id
         :authorization})
    (if (= (get preimage :domain)
           :gravity/sh07-b51-predecessor-outcome-semantic-v18)
      (if (= (get preimage :schema-version) 18)
        (if (= (get preimage :outcome-kind)
               :legacy-v16-accepted-after-no-form-waiver)
          (if (= (get preimage :status) :accepted)
            (if (= (get preimage :identity-preimage-domain) nil)
              (if (= (get preimage :actual-core-artifact-kind) nil)
                (if (= (get preimage :actual-wrapper-artifact-kind) nil)
                  (if (= (get preimage :frontier-rule) "C6-VERIFY")
                    (if (= (get preimage :frontier-reason)
                           :authoritative-record-shape)
                      (if (sh07-b51-all-sha256?
                           (get preimage :failing-binding-ids))
                        (if (> (count
                                (get preimage :failing-binding-ids)) 0)
                          (if (sh07-b51-no-form-projection-vector-shape?
                               (get preimage :failing-declarations))
                            (if (= (get preimage :replay-status)
                                   :all-other-b47-invariants-passed)
                              (if (= (get preimage :semantic-artifact-id) nil)
                                (= (get preimage :authorization)
                                   :v18-authenticated-no-form-namespace)
                                false)
                              false)
                            false)
                          false)
                        false)
                      false)
                    false)
                  false)
                false)
              false)
            false)
          false)
        false)
      false)
    false))

(defn sh07-b51-success-outcome-preimage-shape? [preimage]
  (if (sh07-b51-legacy-outcome-preimage-shape? preimage)
    true
    (if (sh07-b51-waived-accepted-outcome-preimage-shape? preimage)
      true
      (sh07-b51-vector-outcome-preimage-shape? preimage))))

(defn sh07-b51-full-record-preimage
  [record own-id-key domain]
  (loop [remaining (vec record)
         result {:domain domain :schema-version 18}]
    (if (= (count remaining) 0)
      result
      (let [entry (first remaining)
            key (first entry)]
        (if (contains? #{:schema own-id-key} key)
          (recur (rest remaining) result)
          (recur
           (rest remaining)
           (assoc result key (second entry))))))))

(defn sh07-b51-full-record-through-preimage-shape?
  [record schema own-id-key purpose domain]
  (if (map? record)
    (if (= (get record :schema) schema)
      (if (sh07-b51-digest-reference? (get record own-id-key))
        (sh07-b51-foundation-purpose-preimage-shape?
         purpose
         (sh07-b51-full-record-preimage record own-id-key domain))
        false)
      false)
    false))

(defn sh07-b51-binding-slot-record-shape? [record]
  (if (sh07-b51-exact-keys?
       record
       #{:schema :slot-id :predecessor-authority-id
         :global-slot-ordinal :owner-kind :owner-form-id :owner-syntax-id
         :owner-core-node-id :owner-coordinate :slot-coordinate
         :enclosing-form-id :enclosing-syntax-id :fragment-id
         :fragment-ordinal :owning-root-form-id :owning-root-syntax-id
         :owning-definition-form-id :owning-definition-syntax-id
         :def-form-id :def-syntax-id :defn-input-syntax-id
         :fn-form-id :fn-syntax-id :slot-ordinal :pattern-form-id
         :pattern-syntax-id :pattern-scope-id :initializer-form-id
         :initializer-syntax-id :initializer-scope-id
         :initializer-core-node-id :first-global-extraction-ordinal
         :extraction-count :terminal-count :leaf-count :vector-node-count
         :vector-node-extraction-ids :visible-prior-binding-ids
         :introduced-binding-ids :runtime-policy :mutability
         :source-origin-chain :source-generated-origin})
    (let [seed
          {:domain :gravity/sh07-b51-binding-slot-id-preimage-v18
           :schema-version 18
           :predecessor-authority-id
           (get record :predecessor-authority-id)
           :global-slot-ordinal (get record :global-slot-ordinal)
           :owner-kind (get record :owner-kind)
           :owner-form-id (get record :owner-form-id)
           :owner-syntax-id (get record :owner-syntax-id)
           :owner-core-node-id (get record :owner-core-node-id)
           :owner-coordinate (get record :owner-coordinate)
           :owning-definition-form-id
           (get record :owning-definition-form-id)
           :owning-definition-syntax-id
           (get record :owning-definition-syntax-id)
           :slot-coordinate (get record :slot-coordinate)
           :slot-ordinal (get record :slot-ordinal)
           :pattern-form-id (get record :pattern-form-id)
           :pattern-syntax-id (get record :pattern-syntax-id)
           :pattern-scope-id (get record :pattern-scope-id)
           :initializer-form-id (get record :initializer-form-id)
           :initializer-syntax-id (get record :initializer-syntax-id)
           :initializer-scope-id (get record :initializer-scope-id)
           :initializer-core-node-id (get record :initializer-core-node-id)
           :source-origin-chain (get record :source-origin-chain)
           :source-generated-origin (get record :source-generated-origin)}]
      (if (= (get record :schema)
             :gravity/sh07-b51-binding-slot-v18)
        (if (sh07-b51-digest-reference? (get record :slot-id))
          (if (sh07-b51-binding-slot-preimage-shape? seed)
            (if (= (get record :enclosing-form-id)
                   (get record :owner-form-id))
              (if (= (get record :enclosing-syntax-id)
                     (get record :owner-syntax-id))
                (if (sh07-b51-nonnegative-integer?
                     (get record :fragment-ordinal))
                  (if (loop [remaining
                             [:fragment-id :owning-root-form-id
                              :owning-root-syntax-id]]
                        (if (= (count remaining) 0)
                          true
                          (if (sh07-b51-sha256-id?
                               (get record (first remaining)))
                            (recur (rest remaining)) false)))
                    (if (sh07-b51-nonnegative-integer?
                         (get record :first-global-extraction-ordinal))
                      (if (if (integer? (get record :extraction-count))
                            (> (get record :extraction-count) 0) false)
                        (if (loop [remaining
                                   [:terminal-count :leaf-count
                                    :vector-node-count]]
                              (if (= (count remaining) 0)
                                true
                                (if (sh07-b51-nonnegative-integer?
                                     (get record (first remaining)))
                                  (recur (rest remaining)) false)))
                          (if (sh07-b51-all-digest-references?
                               (get record :vector-node-extraction-ids))
                            (if (= (count
                                    (get record
                                         :vector-node-extraction-ids))
                                   (get record :vector-node-count))
                              (if (sh07-b51-all-sha256?
                                   (get record :visible-prior-binding-ids))
                                (if (sh07-b51-all-sha256?
                                     (get record :introduced-binding-ids))
                                  (if (= (get record :mutability) :immutable)
                                    (contains?
                                     #{:legacy-direct-binding-no-check
                                       :exact-width-runtime-checked}
                                     (get record :runtime-policy))
                                    false)
                                  false)
                                false)
                              false)
                            false)
                          false)
                        false)
                      false)
                    false)
                  false)
                false)
              false)
            false)
          false)
        false))
    false))

(defn sh07-b51-product-record-common-shape? [record]
  (if (sh07-b51-exact-keys?
       record
       #{:schema :node-id :global-product-ordinal :product-kind
         :predecessor-authority-id :fragment-id :fragment-ordinal
         :owning-root-form-id :owning-root-syntax-id
         :owning-definition-form-id :owning-definition-syntax-id
         :owner-kind :owner-form-id :owner-syntax-id :owner-core-node-id
         :owner-coordinate :slot-coordinate :recur-coordinate :slot-id
         :extraction-id :runtime-check-id :publication-event-id
         :recur-slot-mapping-id :loop-form-id :loop-syntax-id
         :target-loop-form-id :target-loop-syntax-id :argument-node-ids
         :required-check-ids :child-node-ids :evaluated-child-node-ids
         :binding-ids :path :expected-width :evaluation-order
         :commit-policy :source-origin-chain :source-generated-origin})
    (let [seed
          {:domain :gravity/sh07-b51-product-node-id-preimage-v18
           :schema-version 18
           :predecessor-authority-id
           (get record :predecessor-authority-id)
           :global-product-ordinal (get record :global-product-ordinal)
           :product-kind (get record :product-kind)
           :owner-coordinate (get record :owner-coordinate)
           :owning-definition-form-id
           (get record :owning-definition-form-id)
           :owning-definition-syntax-id
           (get record :owning-definition-syntax-id)
           :source-origin-chain (get record :source-origin-chain)
           :source-generated-origin (get record :source-generated-origin)}]
      (if (= (get record :schema) :gravity/sh07-b51-product-node-v18)
        (if (sh07-b51-digest-reference? (get record :node-id))
          (if (sh07-b51-product-node-preimage-shape? seed)
            (if (contains? #{:let :loop} (get record :owner-kind))
              (if (loop [remaining
                         [:fragment-id :owning-root-form-id
                          :owning-root-syntax-id :owner-form-id
                          :owner-syntax-id]]
                    (if (= (count remaining) 0)
                      true
                      (if (sh07-b51-sha256-id?
                           (get record (first remaining)))
                        (recur (rest remaining)) false)))
                (if (sh07-b51-digest-reference?
                     (get record :owner-core-node-id))
                  (if (loop [remaining
                             [:argument-node-ids :required-check-ids
                              :child-node-ids :evaluated-child-node-ids]]
                        (if (= (count remaining) 0)
                          true
                          (if (sh07-b51-all-digest-references?
                               (get record (first remaining)))
                            (recur (rest remaining)) false)))
                    (if (sh07-b51-all-sha256?
                         (get record :binding-ids))
                      (sh07-b51-nonnegative-integer?
                       (get record :evaluation-order))
                      false)
                    false)
                  false)
                false)
              false)
            false)
          false)
        false))
    false))

(defn sh07-b51-optional-digest-reference? [value]
  (if (= value nil) true (sh07-b51-digest-reference? value)))

(defn sh07-b51-product-record-shape? [record]
  (if (sh07-b51-product-record-common-shape? record)
    (if (loop [remaining
               [:slot-id :extraction-id :runtime-check-id
                :publication-event-id :recur-slot-mapping-id]]
          (if (= (count remaining) 0)
            true
            (if (sh07-b51-optional-digest-reference?
                 (get record (first remaining)))
              (recur (rest remaining)) false)))
      (let [kind (get record :product-kind)
            slot-kind?
            (contains?
             #{:slot-initializer :vector-check :terminal-projection
               :slot-publication}
             kind)
            recur-kind?
            (contains? #{:recur-argument :recur-commit} kind)]
        (if slot-kind?
          (if (sh07-b51-slot-coordinate-shape?
               (get record :slot-coordinate))
            (if (= (get record :slot-id) nil) false
              (if recur-kind? false true))
            false)
          (if recur-kind?
            (if (= (get record :slot-coordinate) nil)
              (sh07-b51-recur-coordinate-template-shape?
               (get record :recur-coordinate))
              false)
            false)))
      false)
    false))

(defn sh07-b51-record-vector-shape? [values predicate-kind]
  (if (vector? values)
    (loop [remaining values]
      (if (= (count remaining) 0)
        true
        (let [value (first remaining)
              valid?
              (if (= predicate-kind :product)
                (sh07-b51-product-record-shape? value)
                (if (= predicate-kind :slot)
                  (sh07-b51-binding-slot-record-shape? value)
                  (if (= predicate-kind :extraction)
                    (sh07-b51-full-record-through-preimage-shape?
                     value :gravity/sh07-b51-binding-extraction-v18
                     :extraction-id :sh07-b51-binding-extraction-id
                     :gravity/sh07-b51-binding-extraction-id-preimage-v18)
                    (if (= predicate-kind :runtime)
                      (sh07-b51-full-record-through-preimage-shape?
                       value :gravity/sh07-b51-runtime-check-v18
                       :id :sh07-b51-runtime-check-id
                       :gravity/sh07-b51-runtime-check-id-preimage-v18)
                      (if (= predicate-kind :publication)
                        (sh07-b51-full-record-through-preimage-shape?
                         value :gravity/sh07-b51-publication-event-v18
                         :id :sh07-b51-publication-event-id
                         :gravity/sh07-b51-publication-event-id-preimage-v18)
                        (sh07-b51-full-record-through-preimage-shape?
                         value :gravity/sh07-b51-recur-slot-mapping-v18

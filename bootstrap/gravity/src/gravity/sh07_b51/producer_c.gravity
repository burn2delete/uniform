(defn sh07-b51-reference-registry-static-shape? [outcome-kind]
  (loop [purposes (sh07-b51-purpose-catalog) seen #{}]
    (if (= (count purposes) 0)
      true
      (let [purpose (first purposes)
            descriptors
            (sh07-b51-purpose-reference-descriptors
             purpose outcome-kind)
            checked
            (loop [remaining descriptors local-seen seen]
              (if (= (count remaining) 0)
                {:status :accepted :seen local-seen}
                (let [descriptor (first remaining)
                      qualified [purpose (get descriptor :path)]]
                  (if (sh07-b51-reference-descriptor-static-shape?
                       purpose descriptor outcome-kind)
                    (if (contains? local-seen qualified)
                      {:status :rejected :reason :qualified-path-duplicate}
                      (recur
                       (rest remaining)
                       (conj local-seen qualified)))
                    {:status :rejected
                     :reason :descriptor-static-shape}))))]
        (if (= (get checked :status) :accepted)
          (recur (rest purposes) (get checked :seen))
          false)))))


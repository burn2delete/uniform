        artifact (get carrier :sh06-resolution-artifact)
        indexes (sh07-b51-index-request request)
        replay (sh07-b51-v16-record-shape-replay artifact request indexes)
        binding-ids (get replay :failing-binding-ids)
        projections
        (if (= (get replay :status) :accepted)
          (sh07-b51-authenticated-no-form-projections
           artifact request indexes binding-ids)
          replay)
        lowered
        (sh07-b51-v16-replay-lower-top-level
         (assoc request :internal-indexes
                (sh07-b51-v16-replay-index-request request)))]
    (if (sh07-b51-waived-accepted-outcome-preimage-shape? outcome)
      (if (= (get replay :status) :accepted)
        (if (> (count binding-ids) 0)
          (if (= binding-ids (get outcome :failing-binding-ids))
            (if (= (get projections :status) :accepted)
              (if (= (get projections :projections)
                     (get outcome :failing-declarations))
                (if (= (get lowered :status) :accepted)
                  (= (get outcome :replay-status)
                     :all-other-b47-invariants-passed)

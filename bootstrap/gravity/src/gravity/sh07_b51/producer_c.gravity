(defn sh07-b51-outcome-fixed-references-authentic? [outcome]
  (if (= (get outcome :implementation-semantic-id)
         (sh07-b51-internal-reference 0))
    (if (= (get outcome :contract-semantic-id)
           (sh07-b51-internal-reference 1))
      (if (= (get outcome :same-request-semantic-id)
             (sh07-b51-internal-reference 2))
        (if (= (get outcome :outcome-kind) :legacy-v16-accepted)
          (= (get outcome :v16-verification-semantic-id)
             (sh07-b51-internal-reference 3))
          true)
        false)
      false)
    false))

(defn sh07-b51-outcome-preimage-for-carrier? [carrier outcome]
  (let [kind (get outcome :outcome-kind)]
    (if (sh07-b51-outcome-fixed-references-authentic? outcome)
    (if (= kind :legacy-v16-accepted)
      (sh07-b51-legacy-outcome-preimage-for-carrier? carrier outcome)
      (if (= kind :legacy-v16-accepted-after-no-form-waiver)
        (sh07-b51-no-form-accepted-outcome-for-carrier? carrier outcome)
        (if (contains?
             #{:b51-vector-frontier-rejected
               :b51-vector-frontier-rejected-after-no-form-waiver}
             kind)

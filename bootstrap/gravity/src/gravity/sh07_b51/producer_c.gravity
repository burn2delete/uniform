(defn sh07-b51-record-seed-preimage [record record-kind]
  (if (= record-kind :core)
    nil
    (if (= record-kind :product)
      (sh07-b51-product-record-seed-preimage record)
      (if (= record-kind :slot)
        (sh07-b51-slot-record-seed-preimage record)
        (if (= record-kind :extraction)
          (sh07-b51-full-record-preimage
           record :extraction-id
           :gravity/sh07-b51-binding-extraction-id-preimage-v18)
          (if (= record-kind :runtime)
            (sh07-b51-full-record-preimage
             record :id :gravity/sh07-b51-runtime-check-id-preimage-v18)
            (if (= record-kind :publication)
              (sh07-b51-full-record-preimage
               record :id
               :gravity/sh07-b51-publication-event-id-preimage-v18)
              (if (= record-kind :mapping)
                (sh07-b51-full-record-preimage
                 record :mapping-id
                 :gravity/sh07-b51-recur-slot-mapping-id-preimage-v18)
                (sh07-b51-full-record-preimage
                 record :transcript-id
                 :gravity/sh07-b51-slot-extraction-transcript-id-preimage-v18)))))))))

(defn sh07-b51-record-own-id [record record-kind]
  (if (= record-kind :core) (get record :node-id)
    (if (= record-kind :product) (get record :node-id)
      (if (= record-kind :slot) (get record :slot-id)
        (if (= record-kind :extraction) (get record :extraction-id)
          (if (= record-kind :runtime) (get record :id)
            (if (= record-kind :publication) (get record :id)
              (if (= record-kind :mapping) (get record :mapping-id)
                (get record :transcript-id)))))))))

(defn sh07-b51-record-global-ordinal [record record-kind]
  (if (= record-kind :core) nil
    (if (= record-kind :product) (get record :global-product-ordinal)
      (if (= record-kind :slot) (get record :global-slot-ordinal)
        (if (= record-kind :extraction) (get record :global-ordinal)
          (if (= record-kind :runtime)
            (get record :global-runtime-check-ordinal)
            (if (= record-kind :publication)
              (get record :global-publication-ordinal)
              (if (= record-kind :mapping)
                (get record :global-recur-mapping-ordinal)
                nil))))))))

(defn sh07-b51-record-request-join?

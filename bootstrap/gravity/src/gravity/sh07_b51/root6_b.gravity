; Gravity-owned SH-07 B51 bounded module; Attempt24 owner :r6-independent-verifier.
(ns gravity.sh07-b51.root6-b
  (:profile :meta)
  (:target :jvm)
  (:exports [sh07-b51-build-independent-verifier-binding])
  (:effects #{})
  (:capabilities #{})
  (:safety :safe))

(defn sh07-b51-r6-project-scope-catalog [carrier]
  (let [request (get carrier :authenticated-sh06-request)
        boundary-request
        (get (get (get carrier :sh06-resolution-artifact)
                  :gravity-resolution-boundary)
             :authenticated-resolution-request)
        revision-id (get (get request :lineage) :source-revision-id)
        namespace-root
        (sh07-declared-digest-hash
         {:domain :gravity/sh07-projected-namespace-root-scope-v1
          :source-revision-id revision-id
          :namespace (get (get request :module) :namespace)})]
    (loop [remaining (get boundary-request :lexical-scopes)
           ordinal 0 by-upstream {} records []]
      (if (= (count remaining) 0)
        {:status :accepted :namespace-root-scope-id namespace-root
         :by-upstream by-upstream :records records}
        (let [scope (first remaining)
              parent
              (if (contains? by-upstream (get scope :parent-scope-id))
                (get by-upstream (get scope :parent-scope-id))
                namespace-root)
              names
              (loop [bindings (get scope :bindings) result []]
                (if (= (count bindings) 0) result
                  (recur (rest bindings)
                         (conj result (get (first bindings) :name)))))
              projected
              (sh07-declared-digest-hash
               {:domain :gravity/sh07-projected-lexical-scope-v1
                :source-revision-id revision-id :ordinal ordinal
                :parent-scope-id parent :binding-names names})]
          (if (sh07-b51-r6-sha256-id? parent)
            (if (contains? by-upstream (get scope :scope-id))
              {:status :rejected :reason :projection-scope-duplicate}
              (recur (rest remaining) (+ ordinal 1)
                     (assoc by-upstream (get scope :scope-id) projected)
                     (conj records
                           {:upstream-scope-id (get scope :scope-id)
                            :projected-scope-id projected
                            :parent-scope-id parent
                            :binding-names names})))
            {:status :rejected :reason :projection-scope-parent}))))))

(defn sh07-b51-r6-project-bindings [carrier lexical]
  (let [request (get carrier :authenticated-sh06-request)
        analysis
        (get (get (get carrier :sh06-resolution-artifact)
                  :gravity-resolution-boundary) :resolved-analysis)
        revision-id (get (get request :lineage) :source-revision-id)]
    (loop [remaining (get analysis :binding-table)
           supplied (get request :binding-table) result []]
      (if (= (count remaining) 0)
        (if (= (count supplied) 0)
          {:status :accepted :bindings result}
          {:status :rejected :reason :projection-binding-count})
        (if (= (count supplied) 0)
          {:status :rejected :reason :projection-binding-count}
          (let [upstream (first remaining) row (first supplied)
                definition-syntax-id
                (if (= (get upstream :binding-class) :lexical)
                  (get (get (get lexical :declarations)
                            (get upstream :definition-syntax-id)) :syntax-id)
                  (sh07-b51-r6-project-definition-syntax-id
                   carrier upstream revision-id))
                semantic
                {:name (get upstream :name) :kind (get upstream :kind)
                 :binding-class (get upstream :binding-class)
                 :namespace (get upstream :namespace)
                 :package (get upstream :package)
                 :upstream-binding-id (get upstream :binding-id)
                 :scope-id
                 (if (= (get upstream :binding-class) :lexical)
                   (get (get lexical :projected-by-upstream)
                        (get upstream :scope-id)) nil)
                 :definition-syntax-id definition-syntax-id
                 :definition-artifact-id
                 (get upstream :definition-artifact-id)
                 :visibility (get upstream :visibility)
                 :profile-set (get upstream :profile-set)
                 :target-set (get upstream :target-set)
                 :type-ref (get upstream :type-ref)
                 :effects (get upstream :effects)
                 :capabilities (get upstream :capabilities)
                 :safety (get upstream :safety)
                 :semantic-span (get upstream :semantic-span)}
                projected-id
                (sh07-declared-digest-hash
                 {:domain :gravity/sh07-projected-sh06-binding-v1
                  :source-revision-id revision-id
                  :binding
                  (sh07-b51-r6-without-keys
                   semantic #{:upstream-binding-id :definition-artifact-id})})
                expected (assoc semantic :binding-id projected-id)]
            (if (= row expected)
              (recur (rest remaining) (rest supplied)
                     (conj result expected))
              {:status :rejected :reason :projection-binding-row})))))))

(defn sh07-b51-r6-resolution-position [request form]
  (let [parent-id (get form :parent-form-id)
        parent
        (sh07-b51-r6-find-one (get request :forms) :form-id parent-id)]
    (if (= (get parent :count) 1)
      (if (= (first (get (get parent :value) :child-form-ids))
             (get form :form-id))
        :operator :expression)
      :expression)))

(defn sh07-b51-r6-project-resolutions [carrier bindings lexical]
  (let [request (get carrier :authenticated-sh06-request)
        analysis
        (get (get (get carrier :sh06-resolution-artifact)
                  :gravity-resolution-boundary) :resolved-analysis)]
    (loop [remaining (get lexical :occurrences)
           supplied (get request :resolution-table) result []]
      (if (= (count remaining) 0)
        (if (= (count supplied) 0)
          {:status :accepted :resolutions result}
          {:status :rejected :reason :projection-resolution-count})
        (if (= (count supplied) 0)
          {:status :rejected :reason :projection-resolution-count}
        (let [occurrence (first remaining) row (first supplied)
              projected-binding
              (sh07-b51-r6-find-one
               bindings :upstream-binding-id (get row :upstream-binding-id))
              upstream
              (sh07-b51-r6-find-one
               (get analysis :resolution-table) :syntax-id
               (get occurrence :upstream-reference-syntax-id))
              raw (get upstream :value)
              expected
              {:reference-syntax-id (get occurrence :projected-syntax-id)
               :symbol (get raw :symbol) :position (get raw :position)
               :binding-id (get (get projected-binding :value) :binding-id)
               :upstream-binding-id (get raw :binding-id)
               :resolution-order (get raw :resolution-order)
               :source-span
               (sh07-b51-r6-semantic-span (get raw :source-span))}]
          (if (= [(get projected-binding :count) (get upstream :count)] [1 1])
            (if (= row expected)
              (recur (rest remaining) (rest supplied) (conj result row))
              {:status :rejected :reason :projection-resolution-row})
            {:status :rejected :reason :projection-resolution-join})))))))

(defn sh07-b51-r6-project-macro-products [request lineage forms]
  (let [traces (get forms :traces)
        lineage-value (get lineage :lineage)
        expectation
        {:source-revision-id (get lineage-value :source-revision-id)
         :sh05-artifact-id (get lineage-value :sh05-artifact-id)
         :macro-expansion-trace-id
         (get lineage-value :macro-expansion-trace-id)
         :expanded-defn-count (count traces)
         :expected-input-syntax-ids
         (loop [remaining traces result []]
           (if (= (count remaining) 0) result
             (recur (rest remaining)
                    (conj result
                          (get (first remaining) :input-syntax-id)))))
         :expected-output-def-syntax-ids
         (loop [remaining traces result []]
           (if (= (count remaining) 0) result
             (recur
              (rest remaining)
              (conj result
                    (get (first remaining) :output-def-syntax-id)))))
         :expected-introduced-fn-syntax-ids
         (loop [remaining traces result []]
           (if (= (count remaining) 0) result
             (recur
              (rest remaining)
              (conj result
                    (get (first remaining) :introduced-fn-syntax-id)))))}]
    (if (= (get request :macro-expansion-trace)
           (get lineage :semantic-macro-trace))
      (if (= (get request :macro-origin-traces) traces)
        (if (= (get request :macro-origin-expectation) expectation)
          {:status :accepted} {:status :rejected :reason :projection-macro-expectation})
        {:status :rejected :reason :projection-origin-traces})
      {:status :rejected :reason :projection-macro-trace})))

(defn sh07-b51-r6-form-under-root?
  [forms form root-id depth visited]
  (if (> depth 256) false
    (let [form-id (get form :form-id)]
      (if (= form-id root-id) true
        (if (contains? visited form-id) false
          (let [parent-id (get form :parent-form-id)
                parent (sh07-b51-r6-find-one forms :form-id parent-id)]
            (if (= (get parent :count) 1)
              (sh07-b51-r6-form-under-root?
               forms (get parent :value) root-id (+ depth 1)
               (conj visited form-id))
              false)))))))

(defn sh07-b51-r6-conj-unique [values value]
  (if (= (sh07-b51-r6-vector-membership-count values value) 0)
    (conj values value) values))

(defn sh07-b51-r6-project-fragments [request]
  (let [forms (get request :forms)
        bindings (get request :binding-table)
        resolutions (get request :resolution-table)
        aliases (get request :alias-table)
        roots (get request :top-level-form-ids)]
    (loop [remaining roots ordinal 0 manifests []]
      (if (= (count remaining) 0)
        (let [lineage (get request :lineage)
              covered-roots
              (loop [left manifests result []]
                (if (= (count left) 0) result
                  (recur (rest left)
                         (sh07-b51-r6-append
                          result (get (first left) :root-form-ids)))))
              covered-forms
              (loop [left manifests result []]
                (if (= (count left) 0) result
                  (recur (rest left)
                         (sh07-b51-r6-append
                          result (get (first left) :form-ids)))))
              covered-bindings
              (loop [left manifests result []]
                (if (= (count left) 0) result
                  (recur
                   (rest left)
                   (sh07-b51-r6-append
                    result (get (first left) :local-binding-ids)))))
              covered-resolutions
              (loop [left manifests result []]
                (if (= (count left) 0) result
                  (recur
                   (rest left)
                   (sh07-b51-r6-append result
                         (get (first left)
                              :resolution-reference-syntax-ids)))))
              coverage
              {:root-form-count (count covered-roots)
               :form-count (count forms)
               :local-binding-count (count covered-bindings)
               :resolution-count (count resolutions)
               :fragment-count (count manifests)
               :covered-root-form-ids covered-roots
               :covered-form-ids covered-forms
               :covered-local-binding-ids covered-bindings
               :covered-resolution-reference-syntax-ids
               covered-resolutions}
              assembly
              {:ordered-fragment-ids
               (loop [left manifests result []]
                 (if (= (count left) 0) result
                   (recur (rest left)
                          (conj result (get (first left) :fragment-id)))))
               :root-form-ids covered-roots
               :source-revision-id (get lineage :source-revision-id)
               :sh06-semantic-projection-id
               (get lineage :sh06-semantic-projection-id)
               :alias-table-id (get lineage :alias-table-id)
               :content-id (get lineage :source-revision-id)
               :module-id (get lineage :sh06-semantic-projection-id)}]
          (if (= manifests (get request :fragment-manifest))
            (if (= coverage (get request :fragment-coverage))
              (if (= assembly (get request :module-assembly-manifest))
                {:status :accepted :manifest manifests
                 :coverage coverage :assembly assembly}
                {:status :rejected :reason :projection-assembly})
              {:status :rejected :reason :projection-coverage})
            {:status :rejected :reason :projection-fragments}))
        (let [root-id (first remaining)
              tree-forms
              (loop [left forms result []]
                (if (= (count left) 0) result
                  (let [form (first left)]
                    (recur
                     (rest left)
                     (if (sh07-b51-r6-form-under-root?
                          forms form root-id 0 #{})
                       (conj result form) result)))))
              syntax-ids
              (loop [left tree-forms result #{}]
                (if (= (count left) 0) result
                  (recur (rest left)
                         (conj result (get (first left) :syntax-id)))))
              local-bindings
              (loop [left bindings result []]
                (if (= (count left) 0) result
                  (let [binding (first left)]
                    (recur
                     (rest left)
                     (if (contains? syntax-ids
                                    (get binding :definition-syntax-id))
                       (conj result binding) result)))))
              local-ids
              (loop [left local-bindings result []]
                (if (= (count left) 0) result
                  (recur (rest left)
                         (conj result (get (first left) :binding-id)))))
              fragment-resolutions
              (loop [left resolutions result []]
                (if (= (count left) 0) result
                  (let [resolution (first left)]
                    (recur
                     (rest left)
                     (if (contains?
                          syntax-ids
                          (get resolution :reference-syntax-id))
                       (conj result resolution) result)))))
              external-ids
              (loop [left fragment-resolutions result []]
                (if (= (count left) 0) result
                  (let [binding-id (get (first left) :binding-id)]
                    (recur
                     (rest left)
                     (if (= (sh07-b51-r6-vector-membership-count
                             local-ids binding-id) 0)
                       (sh07-b51-r6-conj-unique result binding-id)
                       result)))))
              alias-names
              (loop [left fragment-resolutions result []]
                (if (= (count left) 0) result
                  (let [resolution (first left)]
                    (if (= (get resolution :resolution-order)
                           :alias-qualified-required-binding)
                      (let [binding
                            (sh07-b51-r6-find-one
                             bindings :binding-id
                             (get resolution :binding-id))
                            alias
                            (sh07-b51-r6-find-one
                             aliases :namespace
                             (get (get binding :value) :namespace))]
                        (if (= [(get binding :count) (get alias :count)] [1 1])
                          (recur
                           (rest left)
                           (sh07-b51-r6-conj-unique
                            result (get (get alias :value) :alias)))
                          [{:invalid-alias true}]))
                      (recur (rest left) result)))))
              form-ids
              (loop [left tree-forms result []]
                (if (= (count left) 0) result
                  (recur (rest left)
                         (conj result (get (first left) :form-id)))))
              fragment
              {:ordinal ordinal :root-form-ids [root-id]
               :form-ids form-ids :local-binding-ids local-ids
               :external-binding-ids external-ids
               :resolution-reference-syntax-ids
               (loop [left fragment-resolutions result []]
                 (if (= (count left) 0) result
                   (recur
                    (rest left)
                    (conj result
                          (get (first left) :reference-syntax-id)))))
               :alias-names alias-names :root-node-ids [root-id]
               :fragment-id root-id :content-id root-id}]
          (recur (rest remaining) (+ ordinal 1)
                 (conj manifests fragment)))))))

(defn sh07-b51-r6-project-sh07-core-request [carrier]
  (let [request (get carrier :authenticated-sh06-request)
        lineage (sh07-b51-r6-project-lineage carrier)
        scopes (sh07-b51-r6-project-scope-catalog carrier)
        forms (sh07-b51-r6-project-forms carrier)
        lexical (get forms :lexical)
        bindings (sh07-b51-r6-project-bindings carrier lexical)
        resolutions
        (sh07-b51-r6-project-resolutions
         carrier (get bindings :bindings) lexical)
        macros
        (sh07-b51-r6-project-macro-products request lineage forms)
        fragments (sh07-b51-r6-project-fragments request)
        analysis
        (get (get (get carrier :sh06-resolution-artifact)
                  :gravity-resolution-boundary) :resolved-analysis)]
    (if (sh07-b51-r6-fresh-sh06? carrier)
      (if (= (get lineage :status) :accepted)
       (if (= (get scopes :status) :accepted)
        (if (= (get forms :status) :accepted)
        (if (= (get bindings :status) :accepted)
          (if (= (get resolutions :status) :accepted)
            (if (= (get macros :status) :accepted)
              (if (= (get fragments :status) :accepted)
                (if (= (get request :alias-table)
                       (vec (get analysis :alias-table)))
                  (if (= (get request :projection-binding)
                         (sh07-b51-r6-projection-binding request))
                    {:status :accepted :request request
                     :forms (sh07-b51-r6-without-keys forms #{:lexical})
                     :bindings bindings :resolutions resolutions
                     :fragments fragments}
                    {:status :rejected :reason :projection-binding})
                  {:status :rejected :reason :projection-aliases})
                fragments)
              macros)
            resolutions)
          bindings)
        forms)
        scopes)
       lineage)
      {:status :rejected :reason :projection-upstream})))

(defn sh07-b51-r6-lower-authenticated-forms [carrier requests]
  (let [projected (sh07-b51-r6-project-sh07-core-request carrier)
        request (get projected :request)
        indexes (sh07-b51-r6-index-request request)]
    (if (= (get projected :status) :accepted)
      (if (sh07-b51-r6-request-outer? request)
      (if (sh07-b51-r6-indexes-unique? request indexes)
        (loop [remaining (get request :top-level-form-ids) nodes []]
          (if (= (count remaining) 0)
            {:status :accepted :nodes nodes}
            (let [lowered
                  (sh07-b51-r6-lower-form-tree
                   request requests indexes (first remaining)
                   :module-initialization nil 0 #{})]
              (if (= (get lowered :status) :accepted)
                (recur (rest remaining)
                       (sh07-b51-r6-append nodes (get lowered :nodes)))
                lowered))))
        {:status :rejected :reason :lowering-index})
        {:status :rejected :reason :lowering-request})
      {:status :rejected :reason :lowering-boundary-commitment})))

(defn sh07-b51-r6-form-descends-from?
  [indexes form-id ancestor-id depth visited]
  (if (> depth 256) false
    (if (= form-id ancestor-id) true
      (if (contains? visited form-id) false
        (let [form (get (get indexes :forms-by-id) form-id)
              parent-id (get form :parent-form-id)]
          (if (= parent-id nil) false
            (sh07-b51-r6-form-descends-from?
             indexes parent-id ancestor-id (+ depth 1)
             (conj visited form-id))))))))

(defn sh07-b51-r6-defn-trace-authentic? [request coordinate]
  (let [input-id (get coordinate :defn-input-syntax-id)]
    (if (sh07-b51-r6-sha256-id? input-id)
      (let [selected
            (loop [remaining (get request :macro-origin-traces)
                   found nil matches 0]
              (if (= (count remaining) 0)
                {:count matches :trace found}
                (let [trace (first remaining)]
                  (if (= (get trace :input-syntax-id) input-id)
                    (recur (rest remaining) trace (+ matches 1))
                    (recur (rest remaining) found matches)))))
            trace (get selected :trace)]
        (if (= (get selected :count) 1)
          (= [(get trace :macro) (get trace :output-def-syntax-id)
              (get trace :introduced-fn-syntax-id)]
             ['defn (get coordinate :def-syntax-id)
              (get coordinate :fn-syntax-id)])
          false))
      false)))

(defn sh07-b51-r6-owner-coordinate-authentic?
  [request indexes coordinate]
  (if (sh07-b51-r6-exact-keys?
       coordinate
       #{:fragment-id :fragment-ordinal :root-form-id :root-syntax-id
         :owning-definition-form-id :owning-definition-syntax-id
         :def-form-id :def-syntax-id :defn-input-syntax-id
         :fn-form-id :fn-syntax-id :enclosing-form-id
         :enclosing-syntax-id})
    (let [ordinal (get coordinate :fragment-ordinal)
          fragment (if (sh07-b51-r6-nonnegative-integer? ordinal)
                     (get (get request :fragment-manifest) ordinal) nil)
          root (get (get indexes :forms-by-id)
                    (get coordinate :root-form-id))
          definition (get (get indexes :forms-by-id)
                          (get coordinate :def-form-id))
          function (get (get indexes :forms-by-id)
                        (get coordinate :fn-form-id))
          enclosing (get (get indexes :forms-by-id)
                         (get coordinate :enclosing-form-id))]
      (if (map? fragment)
        (if (= (get fragment :fragment-id) (get coordinate :fragment-id))
          (if (= (sh07-b51-r6-vector-membership-count
                  (get request :top-level-form-ids)
                  (get coordinate :root-form-id)) 1)
            (if (= (sh07-b51-r6-vector-membership-count
                    (get fragment :root-form-ids)
                    (get coordinate :root-form-id)) 1)
              (if (= [(get root :syntax-id) (get root :parent-form-id)
                      (get coordinate :owning-definition-form-id)
                      (get coordinate :owning-definition-syntax-id)
                      (get coordinate :def-form-id)
                      (get coordinate :def-syntax-id)]
                     [(get coordinate :root-syntax-id) nil
                      (get coordinate :root-form-id)
                      (get coordinate :root-syntax-id)
                      (get coordinate :root-form-id)
                      (get coordinate :root-syntax-id)])
                (if (contains? #{'def 'defn} (get definition :head-symbol))
                  (if (= [(get function :syntax-id)
                          (get function :head-symbol)
                          (get function :parent-form-id)]
                         [(get coordinate :fn-syntax-id) 'fn*
                          (get coordinate :def-form-id)])
                    (if (sh07-b51-r6-defn-trace-authentic?
                         request coordinate)
                    (if (= (get enclosing :syntax-id)
                           (get coordinate :enclosing-syntax-id))
                      (if (sh07-b51-r6-form-descends-from?
                           indexes (get coordinate :enclosing-form-id)
                           (get coordinate :fn-form-id) 0 #{})
                        (if (= (sh07-b51-r6-vector-membership-count
                                (get fragment :form-ids)
                                (get coordinate :enclosing-form-id)) 1)
                          true false)
                        false)
                      false)
                    false)
                    false)
                  false)
                false)
              false)
            false)
          false)
        false))
    false))

(defn sh07-b51-r6-fragment-membership [request binding-id]
  (loop [remaining (get request :fragment-manifest)
         local-count 0 external-count 0]
    (if (= (count remaining) 0)
      {:local-count local-count :external-count external-count}
      (let [fragment (first remaining)
            local (sh07-b51-r6-find-one
                   (get fragment :local-binding-ids) nil binding-id)
            external (sh07-b51-r6-find-one
                      (get fragment :external-binding-ids) nil binding-id)]
        (recur (rest remaining)
               (+ local-count (get local :count))
               (+ external-count (get external :count)))))))

(defn sh07-b51-r6-vector-membership-count [values value]
  (loop [remaining values result 0]
    (if (= (count remaining) 0) result
      (recur (rest remaining)
             (if (= (first remaining) value) (+ result 1) result)))))

(defn sh07-b51-r6-resolution-record-authentic?
  [request binding resolution]
  (if (contains? resolution :symbol)
    (let [selected-form
          (loop [remaining (get request :forms) found nil matches 0]
            (if (= (count remaining) 0) {:count matches :form found}
              (let [form (first remaining)]
                (if (= (get form :syntax-id)
                       (get resolution :reference-syntax-id))
                  (recur (rest remaining) form (+ matches 1))
                  (recur (rest remaining) found matches)))))
          form (get selected-form :form)]
      (if (sh07-b51-r6-exact-keys?
           resolution
           #{:reference-syntax-id :symbol :position :binding-id
             :upstream-binding-id :resolution-order :source-span})
        (if (= (get selected-form :count) 1)
          (if (= [(get form :kind) (get form :value)
                  (get resolution :symbol) (get resolution :binding-id)
                  (get resolution :upstream-binding-id)]
                 [:symbol (get binding :name) (get binding :name)
                  (get binding :binding-id)
                  (get binding :upstream-binding-id)])
            (= (get resolution :source-span) (get form :source-span))
            false)
          false)
        false))
    (= (set (keys resolution))
       #{:binding-id :reference-syntax-id})))

(defn sh07-b51-r6-authorize-resolution
  [carrier request indexes resolution]
  (let [binding (get (get indexes :bindings-by-id)
                     (get resolution :binding-id))
        reference-fragment
        (loop [remaining (get request :fragment-manifest)
               found nil count-found 0]
          (if (= (count remaining) 0)
            {:count count-found :value found}
            (let [fragment (first remaining)]
              (if (= (sh07-b51-r6-vector-membership-count
                      (get fragment :resolution-reference-syntax-ids)
                      (get resolution :reference-syntax-id)) 1)
                (recur (rest remaining) fragment (+ count-found 1))
                (recur (rest remaining) found count-found)))))
        fragment (get reference-fragment :value)

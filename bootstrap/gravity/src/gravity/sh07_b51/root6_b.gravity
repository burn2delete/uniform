                        (conj values
                              (get (first remaining) :module-source-id))))))
        (if (vector? (get manifest :edges))
          (if (loop [remaining (get manifest :edges) ordinal 0 seen #{}]
                (if (= (count remaining) 0) true
                  (let [edge (first remaining)

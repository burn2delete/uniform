                   :frontier-reason (get frontier :reason)
                   :frontier-binding-kind :vector
                   :frontier-form-id (get (get frontier :form) :form-id)
                   :frontier-coordinate (get frontier :coordinate)
                   :semantic-artifact-id nil
                   :authorization
                   :v18-no-form-namespace-and-vector-lowering)
            (assoc common
                   :domain :gravity/sh07-b51-predecessor-outcome-semantic-v18
                   :schema-version 18
                   :outcome-kind :legacy-v16-accepted-after-no-form-waiver
                   :status :accepted :identity-preimage-domain nil
                   :actual-core-artifact-kind nil
                   :actual-wrapper-artifact-kind nil
                   :frontier-rule "C6-VERIFY"
                   :frontier-reason :authoritative-record-shape
                   :failing-binding-ids (get no-form :binding-ids)
                   :failing-declarations (get no-form :projections)
                   :replay-status :all-other-b47-invariants-passed
                   :semantic-artifact-id nil
                   :authorization :v18-authenticated-no-form-namespace))
          nil)
        (if (map? frontier)
          (let [facts
                (if (= (get frontier :owner) 'let)
                  {:reason (get frontier :reason) :binding-kind :vector}
                  {:reason (get frontier :reason)})]
            (if (sh07-b51-r6-b47-diagnostic-authentic?
                 carrier request "C6-LOWERING-GAP"
                 (get frontier :form) facts)
              (assoc common
                     :domain :gravity/sh07-b51-predecessor-outcome-semantic-v18
                     :schema-version 18
                     :outcome-kind :b51-vector-frontier-rejected
                     :status :rejected :identity-preimage-domain nil
                     :actual-core-artifact-kind nil
                     :actual-wrapper-artifact-kind nil
                     :frontier-owner
                     (if (= (get frontier :owner) 'let) :let :loop)
                     :frontier-rule "C6-LOWERING-GAP"
                     :frontier-reason (get frontier :reason)
                     :frontier-binding-kind :vector
                     :frontier-form-id (get (get frontier :form) :form-id)
                     :frontier-coordinate (get frontier :coordinate)
                     :semantic-artifact-id nil
                     :authorization :v18-vector-lowering)
              nil))
          nil)))))

(defn sh07-b51-r6-derive-predecessor-outcome
  [carrier requests]
  (let [outcome (sh07-b51-r6-selected-preimage
                 requests :sh07-b51-predecessor-outcome-semantic-id)
        derived (sh07-b51-r6-derived-outcome-preimage carrier requests)]
    (if (if (map? derived) (= outcome derived) false)
      {:status :accepted :outcome derived} {:status :rejected})))

(defn sh07-b51-r6-authority-preimage-exact?
  [requests outcome authority]
  (= authority
     {:domain :gravity/sh07-b51-predecessor-authority-v18
      :schema-version 18
      :implementation-semantic-id
      (sh07-b51-r6-reference-for-purpose
       requests :sh07-b51-implementation-semantic-id)
      :contract-semantic-id
      (sh07-b51-r6-reference-for-purpose
       requests :sh07-b51-contract-semantic-id)
      :same-request-semantic-id
      (sh07-b51-r6-reference-for-purpose
       requests :sh07-b51-same-request-semantic-id)
      :outcome-semantic-id
      (sh07-b51-r6-reference-for-purpose
       requests :sh07-b51-predecessor-outcome-semantic-id)
      :outcome-kind (get outcome :outcome-kind)
      :semantic-artifact-id
      (if (= (get outcome :outcome-kind) :legacy-v16-accepted)
        (get outcome :v16-semantic-artifact-id)
        (get outcome :semantic-artifact-id))
      :authorization (get outcome :authorization)}))

(defn sh07-b51-r6-product-key-order []
  [:fragment-manifest :fragment-coverage :module-assembly-manifest
   :root-core-node-ids :definitions :nodes :evaluation-order :control-flow
   :reference-uses :var-references :mutations :error-transfers :error-handlers
   :match-branch-records :match-decision-skeletons :match-pattern-records
   :calls :function-records :call-edges :recursion-components :keyword-lookups
   :lexical-bindings :loop-bindings :recur-targets :recur-transfers :source-map
   :binding-table :declared-alias-table :resolution-table
   :macro-expansion-trace :macro-origin-traces :macro-origin-expectation
   :pending-fact-families :destructuring-product-nodes :binding-slots
   :binding-extractions :slot-extraction-transcript :runtime-checks
   :publication-events :recur-slot-mappings :legacy-v16-equivalence])

(defn sh07-b51-r6-product-map-exact? [products]
  (if (map? products)
    (= (set (keys products)) (set (sh07-b51-r6-product-key-order))) false))

(defn sh07-b51-r6-record-preimage-keyset?
  [purpose preimage]
  (let [keys-found (set (keys preimage))]
    (if (= purpose :sh07-b51-binding-slot-id)
      (contains?
       #{#{:domain :schema-version :slot-ordinal :binding-name}
         #{:domain :schema-version :predecessor-authority-id
           :global-slot-ordinal :owner-kind :owner-form-id :owner-syntax-id
           :owner-core-node-id :owner-coordinate
           :owning-definition-form-id :owning-definition-syntax-id
           :slot-coordinate :slot-ordinal :pattern-form-id
           :pattern-syntax-id :pattern-scope-id :initializer-form-id
           :initializer-syntax-id :initializer-scope-id
           :initializer-core-node-id :source-origin-chain
           :source-generated-origin}}
       keys-found)
      (if (= purpose :sh07-b51-binding-extraction-id)
        (= keys-found
           #{:domain :schema-version :predecessor-authority-id :slot-id
             :slot-coordinate :global-ordinal :global-slot-ordinal
             :slot-ordinal :pattern-node-ordinal
             :parent-pattern-node-ordinal :terminal-ordinal :leaf-ordinal
             :kind :path :form-id :syntax-id :scope-id
             :enclosing-form-id :enclosing-syntax-id :pattern-form-id
             :pattern-syntax-id :initializer-form-id
             :initializer-syntax-id :expected-width :binding-id
             :binding-name :definition-form-id :definition-syntax-id
             :binding-scope-id :fragment-id :fragment-ordinal
             :owning-root-form-id :owning-root-syntax-id
             :owning-definition-form-id :owning-definition-syntax-id
             :owner-coordinate :defn-input-syntax-id :fn-form-id
             :fn-syntax-id :source-origin-chain :source-generated-origin})
        (if (= purpose :sh07-b51-runtime-check-id)
          (= keys-found
             #{:domain :schema-version :global-runtime-check-ordinal
               :predecessor-authority-id :fragment-id :fragment-ordinal
               :root-form-id :root-syntax-id :owner-kind :owner-form-id
               :owner-syntax-id :owner-coordinate :slot-coordinate
               :site-kind :recur-coordinate :slot-id :extraction-id :path
               :check-kind :expected-kind :expected-width :check-order
               :guarded-publication-ordinal :guarded-event-kind
               :failure-rule :reasons :guard-policy :fail-closed
               :source-origin-chain :source-generated-origin})
          (if (= purpose :sh07-b51-publication-event-id)
            (= keys-found
               #{:domain :schema-version :global-publication-ordinal
                 :predecessor-authority-id :fragment-id :fragment-ordinal
                 :root-form-id :root-syntax-id :owner-kind :owner-form-id
                 :owner-syntax-id :owner-coordinate :slot-coordinate
                 :slot-coordinates :recur-coordinate :slot-id :slot-ids
                 :event-kind :introduced-binding-ids
                 :introduced-binding-id-vectors :projection-ids
                 :projection-id-vectors :required-check-ids
                 :required-check-id-vectors :product-node-ids
                 :product-node-id-vectors :visible-before-binding-ids
                 :visible-before-binding-id-vectors
                 :visible-after-binding-ids
                 :visible-after-binding-id-vectors :commit-order
                 :all-or-none :publish-none :source-origin-chain
                 :source-generated-origin})
            (if (= purpose :sh07-b51-recur-slot-mapping-id)
              (= keys-found
                 #{:domain :schema-version :global-recur-mapping-ordinal
                   :predecessor-authority-id :fragment-id
                   :fragment-ordinal :root-form-id :root-syntax-id
                   :loop-form-id :loop-syntax-id :loop-core-node-id
                   :recur-form-id :recur-syntax-id :recur-core-node-id
                   :target-loop-form-id :target-loop-syntax-id
                   :target-loop-core-node-id :commit-publication-id
                   :owner-coordinate :recur-coordinate :slot-count
                   :argument-count :slot-ordinals :argument-ordinals
                   :slot-ids :slot-coordinates :argument-node-ids
                   :extraction-id-vectors :required-check-id-vectors
                   :projection-id-vectors :binding-id-vectors
                   :evaluation-order :commit-policy :all-or-none
                   :tail-only :source-origin-chain
                   :source-generated-origin})
              true)))))))

(defn sh07-b51-r6-record-expected-keyset [preimage own-id-key]
  (loop [remaining (vec preimage) result #{own-id-key}]
    (if (= (count remaining) 0) result
      (let [key (first (first remaining))]
        (recur
         (rest remaining)
         (if (contains? #{:domain :schema-version} key)
           result (conj result key)))))))

(defn sh07-b51-r6-record-request-authentic?
  [requests purpose own-id-key domain record]
  (let [reference (get record own-id-key)
        ordinal (get reference :ordinal)
        request (if (sh07-b51-r6-internal-reference? reference)
                  (get requests ordinal) nil)
        preimage (get request :preimage)]
    (if (map? record)
      (if (map? request)
        (if (= (get request :purpose) purpose)
          (if (= (get preimage :domain) domain)
            (if (= (get preimage :schema-version) 18)
              (if (sh07-b51-r6-record-preimage-keyset?
                   purpose preimage)
                (if (= (set (keys record))
                       (sh07-b51-r6-record-expected-keyset
                        preimage own-id-key))
                  (loop [remaining (vec preimage)]
                    (if (= (count remaining) 0) true
                      (let [entry (first remaining) key (first entry)]
                        (if (contains? #{:domain :schema-version} key)
                          (recur (rest remaining))
                          (if (= (get record key) (second entry))
                            (recur (rest remaining)) false)))))
                  false)
                false)
              false)
            false)
          false)
        false)
      false)))

(defn sh07-b51-r6-record-request-projection
  [requests own-id-key record]
  (let [reference (get record own-id-key)
        request (if (sh07-b51-r6-internal-reference? reference)
                  (get requests (get reference :ordinal)) nil)
        preimage (get request :preimage)]
    (if (map? preimage)
      (loop [remaining (vec preimage) result {own-id-key reference}]
        (if (= (count remaining) 0) result
          (let [key (first (first remaining))]
            (if (contains? #{:domain :schema-version} key)
              (recur (rest remaining) result)
              (recur (rest remaining)
                     (assoc result key (get record key)))))))
      {})))

(defn sh07-b51-r6-record-vector-authentic?
  [requests purpose own-id-key domain records]
  (if (vector? records)
    (loop [remaining records seen #{}]
      (if (= (count remaining) 0) true
        (let [record (first remaining) id (get record own-id-key)]
          (if (contains? seen id) false
            (if (sh07-b51-r6-record-request-authentic?
                 requests purpose own-id-key domain record)
              (recur (rest remaining) (conj seen id)) false)))))
    false))

(defn sh07-b51-r6-record-owner-authentic?
  [request indexes record]
  (let [coordinate (get record :owner-coordinate)]
    (if (map? coordinate)
      (if (sh07-b51-r6-owner-coordinate-authentic?
           request indexes coordinate)
        (if (= (get record :owner-form-id)
               (get coordinate :enclosing-form-id))
          (if (= (get record :owner-syntax-id)
                 (get coordinate :enclosing-syntax-id))
            true false)
          false)
        false)
      false)))

(defn sh07-b51-r6-record-owners-authentic?
  [request indexes records]
  (if (vector? records)
    (loop [remaining records]
      (if (= (count remaining) 0) true
        (if (sh07-b51-r6-record-owner-authentic?
             request indexes (first remaining))
          (recur (rest remaining)) false)))
    false))

(defn sh07-b51-r6-pattern-extractions-authentic?
  [request indexes records]
  (if (sh07-b51-r6-dense-ordinal-field? records :global-ordinal)
    (loop [remaining records seen #{}]
      (if (= (count remaining) 0) true
        (let [record (first remaining)
              id (get record :extraction-id)
              form (get (get indexes :forms-by-id) (get record :form-id))
              kind (get record :kind)]
          (if (contains? seen id) false
            (if (= (get form :syntax-id) (get record :syntax-id))
              (if (= kind :vector-node)
                (if (= [(get form :kind)
                        (count (get form :child-form-ids))]
                       [:vector (get record :expected-width)])
                  (recur (rest remaining) (conj seen id)) false)
                (if (= kind :binding-leaf)
                  (if (= [(get form :kind) (get form :value)]
                         [:symbol (get record :binding-name)])
                    (recur (rest remaining) (conj seen id)) false)
                  (if (= kind :wildcard-leaf)
                    (if (= [(get form :kind) (get form :value)
                            (get record :binding-id)]
                           [:symbol '_ nil])
                      (recur (rest remaining) (conj seen id)) false)
                    false)))
              false)))))
    false))

(defn sh07-b51-r6-node-for-form [nodes form-id]
  (loop [remaining nodes found nil matches 0]
    (if (= (count remaining) 0) {:count matches :node found}
      (let [node (first remaining)]
        (if (= (get (get node :source) :form-id) form-id)
          (recur (rest remaining) node (+ matches 1))
          (recur (rest remaining) found matches))))))

(defn sh07-b51-r6-raw-node-record [request indexes nodes form node]
  (let [core-form (sh07-b51-r6-form-core-kind indexes form)
        kind (get form :kind)
        raw-children (get form :child-form-ids)
        expression-children
        (sh07-b51-r6-expression-child-form-ids indexes form)
        child-selection
        (loop [remaining expression-children result []]
          (if (= (count remaining) 0) {:status :accepted :ids result}
            (let [selected
                  (sh07-b51-r6-node-for-form nodes (first remaining))]
              (if (= (get selected :count) 1)
                (recur (rest remaining)
                       (conj result (get (get selected :node) :node-id)))
                {:status :rejected}))))
        children (get child-selection :ids)
        resolution
        (if (= core-form :reference)
          (sh07-b51-r6-form-resolution request form) {:count 0})
        resolved (get resolution :value)
        operator-form
        (if (= core-form :call)
          (get (get indexes :forms-by-id) (first raw-children)) nil)
        operator-resolution
        (if (= core-form :call)
          (sh07-b51-r6-form-resolution request operator-form) {:count 0})
        operator-resolved (get operator-resolution :value)
        ordinary-attributes
        (if (= core-form :literal)
          {:literal-kind kind :value (get form :value)}
          (if (= core-form :collection-literal)
            {:literal-kind kind :element-count (count children)
             :source-value (get form :value)}
            (if (= core-form :reference)
              {:symbol (get form :value) :position :expression
               :binding-id (get resolved :binding-id)
               :binding-class (get resolved :binding-class)
               :definition-syntax-id (get resolved :definition-syntax-id)}
              (if (= core-form :keyword-map-lookup)
                (let [operator-form
                      (get (get indexes :forms-by-id) (first raw-children))]
                  {:keyword-child-index 0 :map-child-index 1
                   :keyword (get operator-form :value)
                   :evaluation-order :keyword-then-map
                   :dispatch :keyword-map-lookup
                   :missing-key-policy :nil
                   :result-policy :map-value-or-nil
                   :target-type-legality :pending-sh08})
                (if (= core-form :call)
                 {:operator-child-index 0
                 :argument-count (- (count children) 1)
                 :argument-child-indexes
                 (loop [index 1 result []]
                   (if (= index (count children)) result
                     (recur (+ index 1) (conj result index))))
                 :evaluation-order :operator-then-arguments
                 :dispatch :resolved-symbol-call}
                (if (= core-form :quote)
                  (let [quoted
                        (get (get indexes :forms-by-id) (get raw-children 1))]
                    {:quoted-form-id (get quoted :form-id)
                     :quoted-syntax-id (get quoted :syntax-id)
                     :quoted-kind (get quoted :kind)
                     :quoted-value (get quoted :value)})
                  (if (= core-form :throw)
                    {:value-child-index 0
                     :evaluation-order :value-then-transfer
                     :construction-order :postorder-after-value
                     :runtime-reachability :not-asserted-by-sh07-b7
                     :transfer-policy :error-transfer
                     :result-policy :never :required-effect :error/throw
                     :authenticated-sh06-artifact-id
                     (get (get request :lineage)
                          :authenticated-sh06-artifact-id)
                     :sh06-semantic-projection-id
                     (get (get request :lineage)
                          :sh06-semantic-projection-id)
                     :type-legality :pending-sh08
                     :effect-registry-legality :pending-sh09
                     :effect-profile-capability-legality :pending-sh09
                     :profile-error-lowering-legality :pending-sh09
                     :ownership-legality :pending-sh10
                     :safety-classification :pending-sh11}
                    (if (= core-form :if)
                      {:condition-child-index 0 :then-child-index 1
                       :else-child-index 2
                       :condition-evaluation :always-first
                       :branch-evaluation :exactly-one
                       :truthiness {:false-values [:nil :false]
                                    :other-values :true}}
                      (if (= core-form :do)
                        {:body-count (count children)
                         :evaluation-order :left-to-right
                         :result :last-child
                         :result-child-index (- (count children) 1)}
                        nil)))))))))
        special
        (if (= core-form :var)
          (sh07-b51-r6-var-semantics request indexes form)
          (if (= core-form :set!)
            (sh07-b51-r6-set-semantics request indexes form children)
            (if (= core-form :def)
              (sh07-b51-r6-def-semantics request indexes form children)
              (if (= core-form :try)
                (sh07-b51-r6-try-semantics request indexes form children)
                (if (= core-form :match)
                  (sh07-b51-r6-match-semantics request indexes form children)
                  (if (= core-form :fn)
                    (sh07-b51-r6-fn-semantics request indexes form children)
                    (if (= core-form :let)
                      (sh07-b51-r6-let-semantics
                       request indexes form children :let)
                      (if (= core-form :loop)
                        (sh07-b51-r6-let-semantics
                         request indexes form children :loop)
                        (if (= core-form :recur)
                          (sh07-b51-r6-recur-semantics
                           request indexes form children
                           (get (get node :evaluation)
                                :owner-function-syntax-id))
                          {:status :not-special})))))))))
        attributes
        (if (= (get special :status) :accepted)
          (get special :attributes) ordinary-attributes)
        evaluation-kind
        (if (contains? #{:reference :literal} core-form) :value
          (if (= core-form :collection-literal) :left-to-right
            (if (= core-form :keyword-map-lookup) :keyword-then-map
             (if (= core-form :call) :operator-then-arguments
              (if (= core-form :quote) :no-evaluation
                (if (= core-form :throw) :value-then-transfer
                  (if (= core-form :if)
                    :condition-then-exclusive-branch
                    (if (= core-form :do) :left-to-right
                      (if (contains?
                           #{:var :set! :def :try :match :fn :let :loop :recur}
                                    core-form)
                        (get special :evaluation-kind)
                        nil)))))))))
        bindings
        (if (= core-form :reference)
          [(get resolved :binding-id)]
          (if (= core-form :call)
            [(get operator-resolved :binding-id)]
            (if (contains?
                 #{:var :set! :def :try :match :fn :let :loop :recur}
                 core-form)
              (get special :binding-ids)
              [])))
        module (get request :module)
        generated (get form :generated-origin)
        evaluation (get node :evaluation)]
    (if (= (get child-selection :status) :accepted)
      (if (contains? #{:reference :literal :collection-literal
                       :keyword-map-lookup :call
                       :quote :throw :if :do :var :set! :def :try :match :fn
                       :let :loop :recur}
                     core-form)
        (if (if (= core-form :reference) (= (get resolution :count) 1) true)
          (if (if (= core-form :call)
                (= (get operator-resolution :count) 1)
                (if (= core-form :quote)
                  (if (= (count raw-children) 2) (= (count children) 0) false)
                  (if (= core-form :throw) (= (count children) 1)
                    (if (= core-form :if) (= (count children) 3)
                      (if (= core-form :do) (< 0 (count children))
                        (if (= core-form :keyword-map-lookup)
                          (= (count children) 2)
                        (if (contains?
                             #{:var :set! :def :try :match :fn :let :loop
                               :recur}
                             core-form)
                          (= (get special :status) :accepted)
                          true)))))))
            {:status :accepted
             :record
             {:predecessor-authority-id (get node :predecessor-authority-id)
              :core-form core-form :children children :attributes attributes
              :source (sh07-b51-r6-form-source form)
              :resolved-binding-ids bindings
              :namespace (get module :namespace)
              :profile (get module :profile) :target (get module :target)
              :metadata
              (if (map? (get form :metadata)) (get form :metadata) {})
              :binding-context (get form :scope-id)
              :generated?
              (if (vector? generated) (< 0 (count generated)) false)
              :preserved-declarations
              (if (vector? (get module :preserved-declarations))
                (get module :preserved-declarations) [])
              :pending-fact-families [:types :effects :ownership :safety]
              :node-id (get node :node-id)
              :evaluation
              {:kind evaluation-kind :region (get evaluation :region)
               :owner-function-syntax-id
               (get evaluation :owner-function-syntax-id)
               :order (sh07-b51-r6-evaluation-order children)}}}
            {:status :rejected})
          {:status :rejected})
        {:status :rejected})
      {:status :rejected})))

(defn sh07-b51-r6-core-nodes-raw-authentic?
  [request indexes nodes]
  (if (vector? nodes)
    (loop [remaining nodes]
      (if (= (count remaining) 0) true
        (let [node (first remaining)
              source (get node :source)
              form-id (get source :form-id)
              form (get (get indexes :forms-by-id) form-id)
              derived
              (if (map? form)
                (sh07-b51-r6-raw-node-record
                 request indexes nodes form node)
                {:status :rejected})]
          (if (= (get derived :status) :accepted)
            (if (= node (get derived :record))
              (recur (rest remaining)) false)
            false))))
    false))

(defn sh07-b51-r6-derived-definitions [nodes]
  (loop [remaining nodes result []]
    (if (= (count remaining) 0) result
      (let [node (first remaining)]
        (if (= (get node :core-form) :def)
          (let [attributes (get node :attributes)
                children (get node :children)
                bindings (get node :resolved-binding-ids)
                source (get node :source)]
            (if (if (= (count children) 1) (= (count bindings) 1) false)
              (recur
               (rest remaining)
               (conj result
                     {:name (get attributes :name)
                      :binding-id (first bindings)
                      :core-node-id (get node :node-id)
                      :value-node-id (first children)
                      :syntax-id (get source :syntax-id)}))
              [{:invalid-definition-node true}]))
          (recur (rest remaining) result))))))

(defn sh07-b51-r6-derived-node-product [key node]
  (let [node-id (get node :node-id)
        core-form (get node :core-form)
        source (get node :source)
        attributes (get node :attributes)
        children (get node :children)
        evaluation (get node :evaluation)
        bindings (get node :resolved-binding-ids)]
    (if (= key :evaluation-order)
      {:core-node-id node-id :kind (get evaluation :kind)
       :region (get evaluation :region)
       :owner-function-syntax-id
       (get evaluation :owner-function-syntax-id)
       :children
       (loop [remaining (get evaluation :order) result []]
         (if (= (count remaining) 0) result
           (recur (rest remaining)
                  (conj result (get (first remaining) :core-node-id)))))}
      (if (= key :source-map)
        {:core-node-id node-id :syntax-id (get source :syntax-id)
         :form-id (get source :form-id)
         :source-span (get source :semantic-span)
         :origin-chain (get source :origin-chain)
         :generated-origin (get source :generated-origin)}
        (if (= key :reference-uses)
          (if (= core-form :reference)
            {:core-node-id node-id :form-id (get source :form-id)
             :syntax-id (get source :syntax-id)
             :symbol (get attributes :symbol)
             :position (get attributes :position)
             :binding-id (get attributes :binding-id)
             :binding-class (get attributes :binding-class)
             :definition-syntax-id
             (get attributes :definition-syntax-id)} nil)
          (if (= key :calls)
            (if (= core-form :call)
              {:core-node-id node-id :operator-node-id (first children)
               :operator-binding-id (first bindings)
               :argument-node-ids (vec (rest children))
               :ordered-evaluation-node-ids children
               :evaluation-order :operator-then-arguments
               :result-policy :call-result} nil)
            (if (= key :keyword-lookups)
              (if (= core-form :keyword-map-lookup)
                {:core-node-id node-id
                 :keyword-node-id (get children 0)
                 :map-node-id (get children 1)
                 :keyword (get attributes :keyword)
                 :ordered-evaluation-node-ids children
                 :evaluation-order :keyword-then-map
                 :missing-key-policy :nil
                 :result-policy :map-value-or-nil} nil)
              (if (= key :control-flow)
                (if (= core-form :if)
                  {:core-node-id node-id :kind :if
                   :condition-node-id (get children 0)
                   :branches
                   [{:role :then :predicate :truthy
                     :core-node-id (get children 1)}
                    {:role :else :predicate :falsey
                     :core-node-id (get children 2)}]
                   :branch-exclusivity :exactly-one
                   :truthiness {:false-values [:nil :false]
                                :other-values :true}
                   :result-policy :selected-branch}
                  (if (= core-form :do)
                    {:core-node-id node-id :kind :do
                     :ordered-child-node-ids children
                     :evaluation-order :left-to-right
                     :result-policy
                     {:kind :last-child
                      :core-node-id (get children (- (count children) 1))}}
                    nil))
                nil))))))))

(defn sh07-b51-r6-derived-node-products [key nodes]
  (if (= key :var-references)
    (sh07-b51-r6-derived-var-references nodes)
  (if (= key :mutations)
    (sh07-b51-r6-derived-mutations nodes)
  (if (= key :error-transfers)
    (sh07-b51-r6-derived-error-transfers nodes)
  (if (= key :function-records)
    (sh07-b51-r6-derived-functions nodes)
  (if (= key :call-edges)
    (sh07-b51-r6-derived-call-edges nodes)
  (if (= key :recur-transfers)
    (sh07-b51-r6-derived-recur-transfers nodes)
  (loop [remaining nodes ordinal 0 result []]
    (if (= (count remaining) 0) result
      (let [node (first remaining)
            derived (sh07-b51-r6-derived-node-product key node)]
        (recur
         (rest remaining) (+ ordinal 1)
         (if (= derived nil)
           result
           (conj result derived)))))))))))))

(defn sh07-b51-r6-derived-var-references [nodes]
  (loop [remaining nodes ordinal 0 result []]
    (if (= (count remaining) 0) result
      (let [node (first remaining)]
        (if (= (get node :core-form) :var)
          (let [attributes (get node :attributes)
                source (get node :source)]
            (recur
             (rest remaining) (+ ordinal 1)
             (conj
              result
              {:ordinal ordinal :core-node-id (get node :node-id)
               :form-id (get source :form-id)
               :syntax-id (get source :syntax-id)
               :operand-form-id (get attributes :operand-form-id)
               :operand-syntax-id (get attributes :operand-syntax-id)
               :symbol (get attributes :symbol)
               :binding-id (get attributes :binding-id)
               :binding-class (get attributes :binding-class)
               :definition-kind (get attributes :definition-kind)
               :object-kind (get attributes :object-kind)
               :upstream-binding-id (get attributes :upstream-binding-id)
               :namespace (get attributes :namespace)
               :definition-syntax-id
               (get attributes :definition-syntax-id)
               :definition-artifact-id
               (get attributes :definition-artifact-id)
               :resolution-order (get attributes :resolution-order)
               :authenticated-sh06-artifact-id
               (get attributes :authenticated-sh06-artifact-id)
               :sh06-semantic-projection-id
               (get attributes :sh06-semantic-projection-id)
               :object-policy (get attributes :object-policy)
               :evaluated-children [] :evaluation-order []
               :profile-legality (get attributes :profile-legality)})))
          (recur (rest remaining) ordinal result))))))

(defn sh07-b51-r6-derived-mutations [nodes]
  (loop [remaining nodes ordinal 0 result []]
    (if (= (count remaining) 0) result
      (let [node (first remaining)]
        (if (= (get node :core-form) :set!)
          (let [a (get node :attributes) s (get node :source)
                e (get node :evaluation) value (first (get node :children))]
            (recur
             (rest remaining) (+ ordinal 1)
             (conj result
                   {:target-symbol (get a :target-symbol)
                    :target-binding-id (get a :target-binding-id)
                    :target-binding-class (get a :target-binding-class)
                    :target-definition-kind (get a :target-definition-kind)
                    :target-location (get a :target-location)
                    :target-upstream-binding-id
                    (get a :target-upstream-binding-id)
                    :target-namespace (get a :target-namespace)
                    :target-definition-syntax-id
                    (get a :target-definition-syntax-id)
                    :target-definition-artifact-id
                    (get a :target-definition-artifact-id)
                    :target-form-id (get a :target-form-id)
                    :target-syntax-id (get a :target-syntax-id)
                    :resolution-order (get a :resolution-order)
                    :authenticated-sh06-artifact-id
                    (get a :authenticated-sh06-artifact-id)
                    :sh06-semantic-projection-id
                    (get a :sh06-semantic-projection-id)
                    :ordinal ordinal :core-node-id (get node :node-id)
                    :form-id (get s :form-id) :syntax-id (get s :syntax-id)
                    :value-core-node-id value
                    :target-evaluated-children [] :evaluated-children [value]
                    :evaluation-region (get e :region)
                    :evaluation-owner-function-syntax-id
                    (get e :owner-function-syntax-id)
                    :ordered-steps
                    [:evaluate-value :write-target :yield-unit]
                    :result-policy :unit :required-effect :state/write
                    :type-legality (get a :type-legality)
                    :effect-registry-legality
                    (get a :effect-registry-legality)
                    :effect-profile-capability-legality
                    (get a :effect-profile-capability-legality)
                    :ownership-legality (get a :ownership-legality)
                    :safety-classification (get a :safety-classification)})))
          (recur (rest remaining) ordinal result))))))

(defn sh07-b51-r6-derived-error-transfers [nodes]
  (loop [remaining nodes ordinal 0 result []]
    (if (= (count remaining) 0) result
      (let [node (first remaining)]
        (if (= (get node :core-form) :throw)
          (let [a (get node :attributes) s (get node :source)
                e (get node :evaluation) value (first (get node :children))]
            (recur
             (rest remaining) (+ ordinal 1)
             (conj result
                   {:ordinal ordinal :core-node-id (get node :node-id)
                    :form-id (get s :form-id) :syntax-id (get s :syntax-id)
                    :value-core-node-id value :evaluated-children [value]
                    :evaluation-region (get e :region)
                    :evaluation-owner-function-syntax-id
                    (get e :owner-function-syntax-id)
                    :ordered-steps [:evaluate-value :transfer-error]
                    :construction-order (get a :construction-order)
                    :runtime-reachability (get a :runtime-reachability)
                    :transfer-policy (get a :transfer-policy)
                    :result-policy (get a :result-policy)
                    :required-effect (get a :required-effect)
                    :authenticated-sh06-artifact-id
                    (get a :authenticated-sh06-artifact-id)
                    :sh06-semantic-projection-id
                    (get a :sh06-semantic-projection-id)
                    :type-legality (get a :type-legality)
                    :effect-registry-legality
                    (get a :effect-registry-legality)
                    :effect-profile-capability-legality
                    (get a :effect-profile-capability-legality)
                    :profile-error-lowering-legality
                    (get a :profile-error-lowering-legality)
                    :ownership-legality (get a :ownership-legality)
                    :safety-classification (get a :safety-classification)})))
          (recur (rest remaining) ordinal result))))))

(defn sh07-b51-r6-definition-for-value [definitions node-id]
  (loop [remaining definitions]
    (if (= (count remaining) 0) nil
      (if (= (get (first remaining) :value-node-id) node-id)
        (first remaining) (recur (rest remaining))))))

(defn sh07-b51-r6-derived-functions [nodes]
  (let [definitions (sh07-b51-r6-derived-definitions nodes)]
    (loop [remaining nodes ordinal 0 result []]
      (if (= (count remaining) 0) result
        (let [node (first remaining)]
          (if (= (get node :core-form) :fn)
            (let [a (get node :attributes) s (get node :source)
                  definition
                  (sh07-b51-r6-definition-for-value
                   definitions (get node :node-id))]
              (recur
               (rest remaining) (+ ordinal 1)
               (conj result
                     {:ordinal ordinal
                      :function-core-node-id (get node :node-id)
                      :function-form-id (get s :form-id)
                      :function-syntax-id (get s :syntax-id)
                      :body-core-node-id (first (get node :children))
                      :parameter-binding-ids
                      (get node :resolved-binding-ids)
                      :fixed-arity (get a :fixed-arity)
                      :definition-kind
                      (if (map? definition) :named-top-level :anonymous)
                      :definition-binding-id
                      (if (map? definition)
                        (get definition :binding-id) nil)
                      :definition-core-node-id
                      (if (map? definition)
                        (get definition :core-node-id) nil)
                      :definition-name
                      (if (map? definition) (get definition :name) nil)})))
            (recur (rest remaining) ordinal result)))))))

(defn sh07-b51-r6-derived-call-edges [nodes]
  (let [definitions (sh07-b51-r6-derived-definitions nodes)
        functions (sh07-b51-r6-derived-functions nodes)
        calls (sh07-b51-r6-derived-node-products :calls nodes)]
    (loop [remaining calls ordinal 0 result []]
      (if (= (count remaining) 0) result
        (let [call (first remaining)
              call-node
              (get (sh07-b51-r6-find-one
                    nodes :node-id (get call :core-node-id)) :value)
              owner-syntax
              (get (get call-node :evaluation)
                   :owner-function-syntax-id)
              caller
              (get (sh07-b51-r6-find-one
                    functions :function-syntax-id owner-syntax) :value)
              definition
              (get (sh07-b51-r6-find-one
                    definitions :binding-id
                    (get call :operator-binding-id)) :value)
              callee
              (if (map? definition)
                (get (sh07-b51-r6-find-one
                      functions :function-core-node-id
                      (get definition :value-node-id)) :value) nil)]
          (recur
           (rest remaining) (+ ordinal 1)
           (conj result
                 {:ordinal ordinal
                  :call-core-node-id (get call :core-node-id)
                  :caller-function-syntax-id
                  (if (map? caller)
                    (get caller :function-syntax-id) nil)
                  :caller-function-core-node-id
                  (if (map? caller)
                    (get caller :function-core-node-id) nil)
                  :callee-binding-id (get call :operator-binding-id)
                  :callee-definition-syntax-id nil
                  :callee-function-syntax-id
                  (if (map? callee)
                    (get callee :function-syntax-id) nil)
                  :callee-function-core-node-id
                  (if (map? callee)
                    (get callee :function-core-node-id) nil)
                  :argument-core-node-ids (get call :argument-node-ids)
                  :ordered-evaluation-node-ids
                  (get call :ordered-evaluation-node-ids)
                  :evaluation-order :operator-then-arguments
                  :classification
                  (if (map? callee)
                    :local-function :nonlocal-or-nonfunction)})))))))

(defn sh07-b51-r6-derived-recur-transfers [nodes]
  (loop [remaining nodes result []]
    (if (= (count remaining) 0) result
      (let [node (first remaining)]
        (if (= (get node :core-form) :recur)
          (let [a (get node :attributes) s (get node :source)]
            (recur
             (rest remaining)
             (conj result
                   {:recur-core-node-id (get node :node-id)
                    :recur-form-id (get s :form-id)
                    :recur-syntax-id (get s :syntax-id)
                    :target-id (get a :target-id)
                    :target-kind (get a :target-kind)
                    :arity (get a :arity)
                    :argument-node-ids (get node :children)
                    :tail-position true
                    :evaluation-order :arguments-left-to-right
                    :transfer-policy :nearest-lexical-recur-target
                    :type-compatibility :pending-sh08})))
          (recur (rest remaining) result))))))

(defn sh07-b51-r6-node-products-authentic? [products]
  (let [nodes (get products :nodes)
        keys [:evaluation-order :source-map :reference-uses
              :control-flow :calls :keyword-lookups]
        complex-keys
        [:function-records :call-edges]]
    (loop [remaining keys]
      (if (= (count remaining) 0)
        (if (if (contains? products :var-references)
              (= (get products :var-references)
                 (sh07-b51-r6-derived-var-references nodes)) true)
          (if (if (contains? products :mutations)
                (= (get products :mutations)
                   (sh07-b51-r6-derived-mutations nodes)) true)
            (if (if (contains? products :error-transfers)
                  (= (get products :error-transfers)
                     (sh07-b51-r6-derived-error-transfers nodes)) true)
              (loop [complex complex-keys]
                (if (= (count complex) 0) true
                  (let [key (first complex)]
                    (if (if (contains? products key)
                          (= (get products key)
                             (sh07-b51-r6-derived-node-products key nodes))
                          true)
                      (recur (rest complex)) false))))
              false)
            false)
          false)
        (let [key (first remaining)]
          (if (= (get products key)
                 (sh07-b51-r6-derived-node-products key nodes))
            (recur (rest remaining)) false))))))

(defn sh07-b51-r6-relational-node-base-authentic? [node-products]
  (if (sh07-b51-r6-exact-keys?
       node-products
       #{:nodes :definitions :reference-uses :calls :function-records
         :call-edges :error-transfers})
    (let [nodes (get node-products :nodes)]
      (= [(get node-products :definitions)
          (get node-products :reference-uses)
          (get node-products :calls)
          (get node-products :function-records)
          (get node-products :call-edges)
          (get node-products :error-transfers)]
         [(sh07-b51-r6-derived-definitions nodes)
          (sh07-b51-r6-derived-node-products :reference-uses nodes)
          (sh07-b51-r6-derived-node-products :calls nodes)
          (sh07-b51-r6-derived-functions nodes)
          (sh07-b51-r6-derived-call-edges nodes)
          (sh07-b51-r6-derived-error-transfers nodes)]))
    false))

(defn sh07-b51-r6-derived-fragment-products [request nodes]
  (loop [remaining (get request :fragment-manifest)
         manifests [] roots []]
    (if (= (count remaining) 0)
      {:status :accepted :fragment-manifest manifests
       :root-core-node-ids roots}
      (let [fragment (first remaining)
            selected
            (loop [root-forms (get fragment :root-form-ids) result []]
              (if (= (count root-forms) 0)
                {:status :accepted :roots result}
                (let [found
                      (loop [records nodes count-found 0 node nil]
                        (if (= (count records) 0)
                          {:count count-found :node node}
                          (if (= (get (get (first records) :source) :form-id)
                                 (first root-forms))
                            (recur (rest records) (+ count-found 1)
                                   (first records))
                            (recur (rest records) count-found node))))]
                  (if (= (get found :count) 1)
                    (recur (rest root-forms)
                           (conj result (get (get found :node) :node-id)))
                    (if (= (get found :count) 0)
                      (recur (rest root-forms) result)
                      {:status :rejected})))))]
        (if (= (get selected :status) :accepted)
          (let [node-ids (get selected :roots)]
            (recur (rest remaining)
                   (conj manifests
                         (assoc fragment :root-node-ids node-ids))
                   (sh07-b51-r6-append roots node-ids)))
          {:status :rejected :reason :fragment-root-join})))))

(defn sh07-b51-r6-relational-context-authentic?
  [carrier requests nodes]
  (let [context (get carrier :authenticated-sh06-request)
        forms (get context :forms)]
    (if (sh07-b51-r6-raw-outer? carrier)
      (if (sh07-b51-r6-request-outer? context)
        (if (vector? forms)
          (if (if (= (count forms) 0) (= (count nodes) 0) true)
            (if (loop [remaining requests]
                  (if (= (count remaining) 0) true
                    (if (contains? (set (sh07-b51-r6-purpose-order))
                                   (get (first remaining) :purpose))
                      (recur (rest remaining)) false)))
              (loop [remaining nodes]
                (if (= (count remaining) 0) true
                  (let [node (first remaining)
                        source (get node :source)
                        found-form
                        (sh07-b51-r6-find-one
                         forms :form-id (get source :form-id))
                        found-request
                        (loop [left requests found nil count-found 0]
                          (if (= (count left) 0)
                            {:count count-found :value found}
                            (let [request (first left)
                                  preimage (get request :preimage)]
                              (if (if (= (get request :purpose)
                                         :sh07-b51-core-node-id)
                                    (= (get preimage :source) source) false)
                                (recur (rest left) preimage
                                       (+ count-found 1))
                                (recur (rest left) found count-found)))))
                        preimage (get found-request :value)]
                    (if (= (get found-form :count) 1)
                      (if (= (get found-request :count) 1)
                        (if (sh07-b51-r6-exact-keys?
                             preimage
                             #{:domain :schema-version
                               :predecessor-authority-id :core-form
                               :children :attributes :source
                               :resolved-binding-ids :evaluation-kind
                               :evaluation-region
                               :evaluation-owner-function-syntax-id
                               :evaluated-children :namespace :profile
                               :target :metadata :binding-context :generated?
                               :preserved-declarations
                               :pending-fact-families})
                          (if (= (get preimage :domain)
                                 :gravity/sh07-b51-core-node-id-preimage-v18)
                            (if (= (get preimage :schema-version) 18)
                              (if (= [(get preimage :core-form)
                                      (get preimage :children)
                                      (get preimage :attributes)
                                      (get preimage :resolved-binding-ids)
                                      (get preimage :evaluation-kind)
                                      (get preimage :evaluation-region)
                                      (get preimage
                                           :evaluation-owner-function-syntax-id)
                                      (get preimage :evaluated-children)]
                                     [(get node :core-form)
                                      (get node :children)
                                      (get node :attributes)
                                      (get node :resolved-binding-ids)
                                      (get (get node :evaluation) :kind)
                                      (get (get node :evaluation) :region)
                                      (get (get node :evaluation)
                                           :owner-function-syntax-id)
                                      (get node :children)])
                                (recur (rest remaining)) false)
                              false)
                            false)
                          false)
                        false)
                      false))))
              false)
            false)
          false)
        false)
      false)))

(defn sh07-b51-r6-preimages-for-purpose [requests purpose field]
  (loop [remaining requests result []]
    (if (= (count remaining) 0) result
      (let [request (first remaining)]
        (if (= (get request :purpose) purpose)
          (recur (rest remaining)
                 (conj result (get (get request :preimage) field)))
          (recur (rest remaining) result))))))

(defn sh07-b51-r6-function-reachable?
  [start-syntax-id target-syntax-id call-edges depth visited]
  (if (> depth 256) false
    (if (= start-syntax-id target-syntax-id) true
      (if (contains? visited start-syntax-id) false
        (loop [remaining call-edges]
          (if (= (count remaining) 0) false
            (let [edge (first remaining)]
              (if (= (get edge :caller-function-syntax-id)
                     start-syntax-id)
                (if (sh07-b51-r6-function-reachable?
                     (get edge :callee-function-syntax-id)
                     target-syntax-id call-edges (+ depth 1)
                     (conj visited start-syntax-id))
                  true (recur (rest remaining)))
                (recur (rest remaining))))))))))

(defn sh07-b51-r6-derived-recursion-components
  [function-records call-edges]
  (loop [remaining function-records assigned #{} ordinal 0 result []]
    (if (= (count remaining) 0) result
      (let [function (first remaining)
            syntax-id (get function :function-syntax-id)]
        (if (contains? assigned syntax-id)
          (recur (rest remaining) assigned ordinal result)
          (let [component
                (loop [candidates function-records found []]
                  (if (= (count candidates) 0) found
                    (let [candidate (first candidates)
                          candidate-syntax-id
                          (get candidate :function-syntax-id)]
                      (if (if (sh07-b51-r6-function-reachable?
                               syntax-id candidate-syntax-id
                               call-edges 0 #{})
                            (sh07-b51-r6-function-reachable?
                             candidate-syntax-id syntax-id
                             call-edges 0 #{}) false)
                        (recur (rest candidates) (conj found candidate))
                        (recur (rest candidates) found)))))
                syntax-ids
                (loop [rows component found []]
                  (if (= (count rows) 0) found
                    (recur (rest rows)
                           (conj found
                                 (get (first rows)
                                      :function-syntax-id)))))
                syntax-set (set syntax-ids)
                internal
                (loop [edges call-edges found []]
                  (if (= (count edges) 0) found
                    (let [edge (first edges)]
                      (if (if (contains?
                               syntax-set
                               (get edge :caller-function-syntax-id))
                            (contains?
                             syntax-set
                             (get edge :callee-function-syntax-id)) false)
                        (recur (rest edges)
                               (conj found (get edge :ordinal)))
                        (recur (rest edges) found)))))
                recursive?
                (if (< 1 (count component)) true
                  (< 0 (count internal)))]
            (if recursive?
              (recur
               (rest remaining)
               (sh07-b51-r6-append assigned syntax-set) (+ ordinal 1)
               (conj result
                     {:ordinal ordinal
                      :kind
                      (if (= (count component) 1)
                        :self-recursive :mutually-recursive)
                      :function-syntax-ids syntax-ids
                      :function-core-node-ids
                      (loop [rows component found []]
                        (if (= (count rows) 0) found
                          (recur
                           (rest rows)
                           (conj found
                                 (get (first rows)
                                      :function-core-node-id)))))
                      :internal-call-edge-ordinals internal}))
              (recur (rest remaining) assigned ordinal result))))))))

(defn sh07-b51-r6-node-in-subtree?
  [nodes root-node-id candidate-node-id depth ancestry]
  (if (> depth 256) false
    (if (= root-node-id candidate-node-id) true
      (if (< 0 (sh07-b51-r6-vector-membership-count ancestry root-node-id))
        false
        (let [selected
              (sh07-b51-r6-find-one nodes :node-id root-node-id)
              node (get selected :value)]
          (if (= (get selected :count) 1)
            (loop [remaining (get node :children)]
              (if (= (count remaining) 0) false
                (if (sh07-b51-r6-node-in-subtree?
                     nodes (first remaining) candidate-node-id (+ depth 1)
                     (conj ancestry root-node-id))
                  true (recur (rest remaining)))))
            false))))))

(defn sh07-b51-r6-derived-error-handlers
  [context nodes reference-uses error-transfers]
  (let [lineage (get context :lineage)]
    (loop [remaining nodes ordinal 0 result []]
      (if (= (count remaining) 0) result
        (let [node (first remaining)]
          (if (= (get node :core-form) :try)
            (let [source (get node :source)
                  attributes (get node :attributes)
                  clauses (get attributes :handler-clauses)
                  children (get node :children)
                  evaluation (get node :evaluation)
                  artifact-id
                  (get attributes :authenticated-sh06-artifact-id)
                  projection-id
                  (get attributes :sh06-semantic-projection-id)]
              (if (if (= artifact-id
                         (get lineage :authenticated-sh06-artifact-id))
                    (if (= projection-id
                           (get lineage :sh06-semantic-projection-id))
                      (if (vector? clauses)
                        (= (count children) (+ 1 (count clauses))) false)
                      false)
                    false)
                (let [built
                      (loop [left clauses clause-ordinal 0 rows []]
                        (if (= (count left) 0) rows
                          (let [clause (first left)]
                            (if (= (get clause :clause-ordinal)
                                   clause-ordinal)
                              (let [handler-index
                                    (get (get attributes
                                              :handler-child-indexes)
                                         clause-ordinal)
                                    handler-id (get children handler-index)
                                    candidates
                                    (loop [transfers error-transfers found []]
                                      (if (= (count transfers) 0) found
                                        (let [transfer (first transfers)]
                                          (if (if (= (get transfer
                                                          :evaluation-owner-function-syntax-id)
                                                     (get evaluation
                                                          :owner-function-syntax-id))
                                                (sh07-b51-r6-node-in-subtree?
                                                 nodes (get children 0)
                                                 (get transfer :core-node-id)
                                                 0 []) false)
                                            (recur
                                             (rest transfers)
                                             (conj found
                                                   {:ordinal
                                                    (get transfer :ordinal)
                                                    :core-node-id
                                                    (get transfer
                                                         :core-node-id)}))
                                            (recur (rest transfers) found)))))
                                    uses
                                    (loop [references reference-uses found []]
                                      (if (= (count references) 0) found
                                        (let [reference (first references)]
                                          (if (if (= (get reference :binding-id)
                                                     (get clause
                                                          :catch-binding-id))
                                                (sh07-b51-r6-node-in-subtree?
                                                 nodes handler-id
                                                 (get reference :core-node-id)
                                                 0 []) false)
                                            (recur
                                             (rest references)
                                             (conj found
                                                   (get reference :syntax-id)))
                                            (recur (rest references) found)))))]
                              (recur
                               (rest left) (+ clause-ordinal 1)
                               (conj
                                rows
                                {:ordinal (+ ordinal clause-ordinal)
                                 :clause-ordinal clause-ordinal
                                 :clause-count (count clauses)
                                 :handler-child-index handler-index
                                 :core-node-id (get node :node-id)
                                 :form-id (get source :form-id)
                                 :syntax-id (get source :syntax-id)
                                 :protected-core-node-id (get children 0)
                                 :handler-core-node-id
                                 handler-id
                                 :catch-clause-form-id
                                 (get clause :catch-clause-form-id)
                                 :catch-clause-syntax-id
                                 (get clause :catch-clause-syntax-id)
                                 :error-type-form-id
                                 (get clause :error-type-form-id)
                                 :error-type-syntax-id
                                 (get clause :error-type-syntax-id)
                                 :error-type-binding-id
                                 (get clause :error-type-binding-id)
                                 :catch-binding-form-id
                                 (get clause :catch-binding-form-id)
                                 :catch-binding-syntax-id
                                 (get clause :catch-binding-syntax-id)
                                 :catch-binding-id
                                 (get clause :catch-binding-id)
                                 :catch-binding-scope-id
                                 (get clause :catch-binding-scope-id)
                                 :catch-binding-use-syntax-ids
                                 uses
                                 :candidate-error-transfers candidates
                                 :evaluation-region (get evaluation :region)
                                 :evaluation-owner-function-syntax-id
                                 (get evaluation :owner-function-syntax-id)
                                 :ordered-steps
                                 [:evaluate-protected
                                  :conditionally-select-source-ordered-typed-handler]
                                 :construction-order
                                 :protected-then-handlers-source-order-then-try
                                 :runtime-evaluation
                                 :protected-then-conditional-handler-chain
                                 :runtime-reachability
                                 :not-asserted-by-sh07-b9
                                 :selection-policy
                                 :source-ordered-typed-handler-candidates
                                 :result-policy
                                 :protected-or-selected-handler-last
                                 :authenticated-sh06-artifact-id
                                 artifact-id
                                 :sh06-semantic-projection-id
                                 projection-id
                                 :type-coverage-legality
                                 :pending-sh08
                                 :result-type-join-legality
                                 :pending-sh08
                                 :effect-registry-legality
                                 :pending-sh09
                                 :effect-profile-capability-legality
                                 :pending-sh09
                                 :profile-error-lowering-legality
                                 :pending-sh09
                                 :ownership-legality
                                 :pending-sh10
                                 :safety-classification
                                 :pending-sh11})))
                              [{:invalid-handler-clause true}]))))]
                  (if (if (= (count built) 1)
                        (contains? (first built) :invalid-handler-clause)
                        false)
                    built
                    (recur (rest remaining) (+ ordinal (count built))
                           (sh07-b51-r6-append result built))))
                [{:invalid-handler-node true}]))
            (recur (rest remaining) ordinal result)))))))

(defn sh07-b51-r6-walk-authenticated-pattern
  [context nodes form-id clause-ordinal match-node-id branch-node-id
   reference-uses base-ordinal parent-local depth path local-ordinal]
  (let [selected (sh07-b51-r6-find-one
                  (get context :forms) :form-id form-id)
        form (get selected :value)
        kind (get form :kind)
        value (get form :value)
        binding
        (sh07-b51-r6-find-one
         (get context :binding-table) :definition-syntax-id
         (get form :syntax-id))
        binding-value (get binding :value)
        pattern-kind
        (if (= kind :symbol)
          (if (= value '_) :wildcard :binding)
          (if (= kind :vector) :vector
            (if (contains?
                 #{:nil :boolean :integer :decimal :ratio :character
                   :string :keyword} kind)
              :literal nil)))
        binding-id
        (if (= pattern-kind :binding)
          (get binding-value :binding-id) nil)
        uses
        (if (= binding-id nil) []
          (loop [remaining reference-uses result []]
            (if (= (count remaining) 0) result
              (let [reference (first remaining)]
                (if (if (= (get reference :binding-id) binding-id)
                      (sh07-b51-r6-node-in-subtree?
                       nodes branch-node-id (get reference :core-node-id) 0 [])
                      false)
                  (recur (rest remaining)
                         (conj result (get reference :syntax-id)))
                  (recur (rest remaining) result))))))]
    (if (if (= (get selected :count) 1)
          (if (= pattern-kind nil) false
            (if (= pattern-kind :binding)
              (= (get binding :count) 1) true)) false)
      (let [record
            {:ordinal (+ base-ordinal local-ordinal)
             :clause-ordinal clause-ordinal
             :local-ordinal local-ordinal
             :parent-local-ordinal parent-local
             :root-local-ordinal 0
             :parent-ordinal
             (if (= parent-local nil) nil (+ base-ordinal parent-local))
             :root-ordinal base-ordinal :core-node-id match-node-id
             :depth depth :path path :pattern-kind pattern-kind
             :pattern-form-id (get form :form-id)
             :pattern-syntax-id (get form :syntax-id)
             :pattern-value
             (if (contains? #{:binding :wildcard :literal} pattern-kind)
               value nil)
             :vector-width
             (if (= pattern-kind :vector)
               (count (get form :child-form-ids)) nil)
             :pattern-binding-id binding-id
             :pattern-binding-scope-id
             (if (= binding-id nil) nil (get binding-value :scope-id))
             :pattern-binding-use-syntax-ids uses
             :authenticated-sh06-artifact-id
             (get (get context :lineage) :authenticated-sh06-artifact-id)
             :sh06-semantic-projection-id
             (get (get context :lineage) :sh06-semantic-projection-id)}]
        (if (= pattern-kind :vector)
          (loop [children (get form :child-form-ids) child-index 0
                 next-local (+ local-ordinal 1) records [record]]
            (if (= (count children) 0)
              {:status :accepted :next-local next-local :records records}
              (let [walked
                    (sh07-b51-r6-walk-authenticated-pattern
                     context nodes (first children) clause-ordinal match-node-id
                     branch-node-id reference-uses base-ordinal local-ordinal
                     (+ depth 1) (conj path child-index) next-local)]
                (if (= (get walked :status) :accepted)
                  (recur (rest children) (+ child-index 1)
                         (get walked :next-local)
                         (sh07-b51-r6-append records (get walked :records)))
                  walked))))
          {:status :accepted :next-local (+ local-ordinal 1)
           :records [record]}))
      {:status :rejected})))

(defn sh07-b51-r6-derived-authentic-match-products
  [context nodes reference-uses]
  (let [lineage (get context :lineage)]
    (loop [remaining nodes branch-ordinal 0 pattern-ordinal 0
           branches [] patterns [] skeletons []]
      (if (= (count remaining) 0)
        {:status :accepted :match-branch-records branches
         :match-pattern-records patterns
         :match-decision-skeletons skeletons}
        (let [node (first remaining)]
          (if (= (get node :core-form) :match)
            (let [a (get node :attributes) s (get node :source)
                  children (get node :children)
                  clauses (get a :branch-clauses)]
              (if (if (= (get a :authenticated-sh06-artifact-id)
                         (get lineage :authenticated-sh06-artifact-id))
                    (if (= (get a :sh06-semantic-projection-id)
                           (get lineage :sh06-semantic-projection-id))
                      (vector? clauses) false) false)
                (let [built
                      (loop [left clauses next-branch branch-ordinal
                             next-pattern pattern-ordinal bs [] ps []]
                        (if (= (count left) 0)
                          {:status :accepted :next-branch next-branch
                           :next-pattern next-pattern :branches bs
                           :patterns ps}
                          (let [clause (first left)
                                clause-ordinal (get clause :clause-ordinal)
                                branch-index
                                (get (get a :branch-child-indexes)
                                     clause-ordinal)
                                branch-id
                                (get children branch-index)
                                walked
                                (sh07-b51-r6-walk-authenticated-pattern
                                 context nodes (get clause :pattern-form-id)
                                 clause-ordinal (get node :node-id) branch-id
                                 reference-uses next-pattern nil 0 [] 0)
                                binding-id (get clause :pattern-binding-id)
                                binding
                                (if (= binding-id nil) {:count 0 :value nil}
                                  (sh07-b51-r6-find-one
                                   (get context :binding-table) :binding-id
                                   binding-id))
                                uses
                                (if (= binding-id nil) []
                                  (loop [refs reference-uses found []]
                                    (if (= (count refs) 0) found
                                      (let [reference (first refs)]
                                        (if (if (= (get reference :binding-id)
                                                   binding-id)
                                              (sh07-b51-r6-node-in-subtree?
                                               nodes branch-id
                                               (get reference :core-node-id)
                                               0 []) false)
                                          (recur
                                           (rest refs)
                                           (conj found
                                                 (get reference :syntax-id)))
                                          (recur (rest refs) found))))))]
                            (if (= (get walked :status) :accepted)
                              (recur
                               (rest left) (+ next-branch 1)
                               (+ next-pattern
                                  (count (get walked :records)))
                               (conj
                                bs
                                {:ordinal next-branch
                                 :clause-ordinal clause-ordinal
                                 :clause-count (count clauses)
                                 :core-node-id (get node :node-id)
                                 :scrutinee-core-node-id (first children)
                                 :branch-core-node-id branch-id
                                 :branch-child-index
                                 branch-index
                                 :pattern-kind (get clause :pattern-kind)
                                 :pattern-form-id (get clause :pattern-form-id)
                                 :pattern-syntax-id
                                 (get clause :pattern-syntax-id)
                                 :pattern-value (get clause :pattern-value)
                                 :branch-form-id (get clause :branch-form-id)
                                 :branch-syntax-id
                                 (get clause :branch-syntax-id)
                                 :pattern-binding-id binding-id
                                 :pattern-binding-scope-id
                                 (if (= (get binding :count) 1)
                                   (get (get binding :value) :scope-id) nil)
                                 :pattern-binding-ids
                                 (get clause :pattern-binding-ids)
                                 :pattern-binding-use-syntax-ids uses
                                 :conditional-region
                                  {:kind :match-branch
                                  :match-syntax-id
                                  (get s :syntax-id)
                                  :clause-ordinal clause-ordinal}
                                 :scrutinee-evaluation
                                 :evaluate-scrutinee-once
                                 :branch-evaluation
                                 :conditionally-evaluate-selected-branch
                                 :authenticated-sh06-artifact-id
                                 (get a :authenticated-sh06-artifact-id)
                                 :sh06-semantic-projection-id
                                 (get a :sh06-semantic-projection-id)})
                               (sh07-b51-r6-append ps (get walked :records)))
                              {:status :rejected}))))]
                  (if (= (get built :status) :accepted)
                    (recur
                     (rest remaining) (get built :next-branch)
                     (get built :next-pattern)
                     (sh07-b51-r6-append branches (get built :branches))
                     (sh07-b51-r6-append patterns (get built :patterns))
                     (conj skeletons
                           {:core-node-id (get node :node-id)
                            :scrutinee-core-node-id (first children)
                            :branch-core-node-ids (vec (rest children))
                            :selection-policy
                            :source-ordered-pattern-candidates
                            :runtime-reachability
                            :not-asserted-by-sh07-b11
                            :result-type-join :pending-sh08
                            :exhaustiveness :pending-sh08
                            :authenticated-sh06-artifact-id
                            (get a :authenticated-sh06-artifact-id)
                            :sh06-semantic-projection-id
                            (get a :sh06-semantic-projection-id)}))
                    built))
                {:status :rejected}))
            (recur (rest remaining) branch-ordinal pattern-ordinal
                   branches patterns skeletons)))))))

(defn sh07-b51-r6-derived-slot-binding-products [context requests nodes]
  (loop [remaining requests lexical [] loops []]
    (if (= (count remaining) 0)
      {:status :accepted :lexical-bindings lexical :loop-bindings loops}
      (let [request (first remaining)]
        (if (= (get request :purpose) :sh07-b51-binding-extraction-id)
          (let [extraction (get request :preimage)]
            (if (= (get extraction :kind) :binding-leaf)
              (let [slot-reference (get extraction :slot-id)
                    selected-slot
                    (loop [left requests found nil count-found 0]
                      (if (= (count left) 0)
                        {:count count-found :value found}
                        (let [candidate-request (first left)
                              candidate (get candidate-request :preimage)]
                          (if (if (= (get candidate-request :purpose)
                                     :sh07-b51-binding-slot-id)
                                (if (= (get candidate :slot-coordinate)
                                       (get extraction :slot-coordinate))
                                  (= (get candidate :global-slot-ordinal)
                                     (get extraction :global-slot-ordinal))
                                  false)
                                false)
                            (recur (rest left) candidate (+ count-found 1))
                            (recur (rest left) found count-found)))))
                    slot (get selected-slot :value)
                    owner-kind (get slot :owner-kind)
                    selected-owner
                    (sh07-b51-r6-find-one
                     nodes :node-id (get slot :owner-core-node-id))
                    owner-node (get selected-owner :value)
                    owner-source (get owner-node :source)
                    selected-binding
                    (sh07-b51-r6-find-one
                     (get context :binding-table) :binding-id
                     (get extraction :binding-id))
                    binding (get selected-binding :value)
                    prior-bindings
                    (loop [rows requests result []]
                      (if (= (count rows) 0) result
                        (let [candidate-request (first rows)
                              candidate (get candidate-request :preimage)]
                          (if (if (= (get candidate-request :purpose)
                                     :sh07-b51-binding-extraction-id)
                                (if (= (get candidate :kind) :binding-leaf)
                                  (if (= (get candidate :owner-coordinate)
                                         (get extraction :owner-coordinate))
                                    (if (= (get candidate
                                                :global-slot-ordinal)
                                           (get extraction
                                                :global-slot-ordinal))
                                      (< (get candidate :leaf-ordinal)
                                         (get extraction :leaf-ordinal))
                                      (< (get candidate :global-slot-ordinal)
                                         (get extraction
                                              :global-slot-ordinal)))
                                    false)
                                  false)
                                false)
                            (recur (rest rows)
                                   (conj result (get candidate :binding-id)))
                            (recur (rest rows) result)))))
                    record
                    {:ordinal (get extraction :leaf-ordinal)
                     :name (get extraction :binding-name)
                     :binding-id (get extraction :binding-id)
                     :definition-form-id
                     (get extraction :definition-form-id)
                     :definition-syntax-id
                     (get extraction :definition-syntax-id)
                     :binding-scope-id
                     (get extraction :binding-scope-id)
                     :initializer-form-id (get slot :initializer-form-id)
                     :initializer-syntax-id
                     (get slot :initializer-syntax-id)
                     :initializer-scope-id
                     (get slot :initializer-scope-id)
                     :initializer-node-id
                     (get slot :initializer-core-node-id)
                     :visible-prior-binding-ids prior-bindings
                     :mutability :immutable}
                    bound
                    (if (= owner-kind :let)
                      (assoc record :let-core-node-id
                             (get slot :owner-core-node-id))
                      (if (= owner-kind :loop)
                        (assoc record :loop-core-node-id
                               (get slot :owner-core-node-id)) nil))]
                (if (if (= (get selected-slot :count) 1)
                      (if (sh07-b51-r6-internal-reference? slot-reference)
                        (if (= (get slot :domain)
                               :gravity/sh07-b51-binding-slot-id-preimage-v18)
                          (if (= (get slot :schema-version) 18)
                            (if (= (get extraction :domain)
                                   :gravity/sh07-b51-binding-extraction-id-preimage-v18)
                              (if (= (get extraction :schema-version) 18)
                                (if (= (get extraction :owner-coordinate)
                                       (get slot :owner-coordinate))
                                  (if (= (get selected-owner :count) 1)
                                    (if (= [(get owner-node :core-form)
                                            (get owner-source :form-id)
                                            (get owner-source :syntax-id)]
                                           [owner-kind
                                            (get slot :owner-form-id)
                                            (get slot :owner-syntax-id)])
                                      (if (= (get selected-binding :count) 1)
                                        (if (= [(get binding :name)
                                                (get binding
                                                     :definition-form-id)
                                                (get binding
                                                     :definition-syntax-id)
                                                (get binding :scope-id)]
                                               [(get extraction :binding-name)
                                                (get extraction
                                                     :definition-form-id)
                                                (get extraction
                                                     :definition-syntax-id)
                                                (get extraction
                                                     :binding-scope-id)])
                                          (if (= (get extraction
                                                      :initializer-form-id)
                                                 (get slot
                                                      :initializer-form-id))
                                            (if (= (get extraction
                                                        :initializer-syntax-id)
                                                   (get slot
                                                        :initializer-syntax-id))
                                              (map? bound) false)
                                            false)
                                          false)
                                        false)
                                      false)
                                    false)
                                  false)
                                false)
                              false)
                            false)
                          false)
                        false)
                      false)
                  (recur
                   (rest remaining)
                   (if (= owner-kind :let) (conj lexical bound) lexical)
                   (if (= owner-kind :loop) (conj loops bound) loops))
                  {:status :rejected}))
              (recur (rest remaining) lexical loops)))
          (recur (rest remaining) lexical loops))))))

(defn sh07-b51-r6-derived-recur-targets
  [context requests nodes]
  (let [binding-table (get context :binding-table)]
    (loop [remaining nodes result []]
      (if (= (count remaining) 0) result
        (let [node (first remaining)]
          (if (= (get node :core-form) :loop)
            (let [attributes (get node :attributes)
                  source (get node :source)
                  target-id (get attributes :target-id)
                  selected-mapping
                  (loop [left requests found nil count-found 0]
                    (if (= (count left) 0)
                      {:count count-found :value found}
                      (let [request (first left)
                            mapping (get request :preimage)]
                        (if (if (= (get request :purpose)
                                   :sh07-b51-recur-slot-mapping-id)
                              (= (get mapping :target-loop-core-node-id)
                                 (get node :node-id)) false)
                          (recur (rest left) mapping (+ count-found 1))
                          (recur (rest left) found count-found)))))
                  mapping (get selected-mapping :value)
                  coordinates (get mapping :slot-coordinates)
                  joined
                  (loop [left coordinates ordinal 0 binding-ids [] valid 1]
                    (if (= (count left) 0)
                      {:valid valid :binding-ids binding-ids}
                      (let [coordinate (first left)
                            selected-slot
                            (loop [rows requests found nil count-found 0]
                              (if (= (count rows) 0)
                                {:count count-found :value found}
                                (let [request (first rows)
                                      preimage (get request :preimage)]
                                  (if (if (= (get request :purpose)
                                             :sh07-b51-binding-slot-id)
                                        (= (get preimage :slot-coordinate)
                                           coordinate) false)
                                    (recur (rest rows) preimage
                                           (+ count-found 1))
                                    (recur (rest rows) found count-found)))))
                            slot (get selected-slot :value)
                            expected-bindings
                            (get (get mapping :binding-id-vectors) ordinal)
                            selected-extraction
                            (loop [rows requests found nil count-found 0]
                              (if (= (count rows) 0)
                                {:count count-found :value found}
                                (let [request (first rows)
                                      preimage (get request :preimage)]
                                  (if (if (= (get request :purpose)
                                             :sh07-b51-binding-extraction-id)
                                        (if (= (get preimage :slot-coordinate)
                                               coordinate)
                                          (= [(get preimage :binding-id)]
                                             expected-bindings) false)
                                        false)
                                    (recur (rest rows) preimage
                                           (+ count-found 1))
                                    (recur (rest rows) found count-found)))))
                            extraction (get selected-extraction :value)
                            good
                            (if (= valid 1)
                              (if (= (get selected-slot :count) 1)
                                (if (= (get selected-extraction :count) 1)
                                  (if (= (get slot :owner-core-node-id)
                                         (get node :node-id))
                                    (if (= (get slot :slot-ordinal) ordinal)
                                      (= (get extraction :owner-coordinate)
                                         (get slot :owner-coordinate)) false)
                                    false)
                                  false)
                                false)
                              false)]
                        (recur
                         (rest left) (+ ordinal 1)
                         (if good
                           (conj binding-ids (get extraction :binding-id))
                           binding-ids)
                         (if good 1 0)))))]
              (if (if (= (get selected-mapping :count) 1)
                    (if (= (get joined :valid) 1)
                      (if (= (get mapping :domain)
                             :gravity/sh07-b51-recur-slot-mapping-id-preimage-v18)
                        (if (= (get mapping :schema-version) 18)
                          (if (= [(get mapping :loop-form-id)
                                  (get mapping :loop-syntax-id)
                                  (get mapping :loop-core-node-id)
                                  (get mapping :target-loop-form-id)
                                  (get mapping :target-loop-syntax-id)
                                  (get mapping :target-loop-core-node-id)
                                  (get mapping :slot-count)
                                  (get mapping :slot-ordinals)]
                                 [(get source :form-id)
                                  (get source :syntax-id)
                                  (get node :node-id)
                                  (get source :form-id)
                                  (get source :syntax-id)
                                  (get node :node-id)
                                  (count coordinates)
                                  (sh07-b51-r6-ordinals
                                   (count coordinates))])
                            (if (= (count (get mapping :binding-id-vectors))
                                   (count coordinates)) true false)
                            false)
                          false)
                        false)
                      false)
                    false)
                (recur
                 (rest remaining)
                 (let [binding
                       (sh07-b51-r6-find-one
                        binding-table :binding-id
                        (first (get joined :binding-ids)))]
                   (conj result
                         {:target-id target-id :target-kind :loop
                          :owner-core-node-id (get node :node-id)
                          :owner-form-id (get source :form-id)
                          :owner-syntax-id (get source :syntax-id)
                          :arity (count (get joined :binding-ids))
                          :binding-ids (get joined :binding-ids)
                          :body-scope-id
                          (get (get binding :value) :scope-id)
                          :parent-target-id nil
                          :type-compatibility :pending-sh08})))
                [{:invalid-recur-target-join true}]))
            (recur (rest remaining) result)))))))

(defn sh07-b51-r6-invalid-relational-record? [record]
  (loop [remaining
         [:invalid-handler-clause :invalid-handler-node
          :invalid-match-clause :invalid-match-node
          :invalid-binding-initializer :invalid-binding-definition
          :invalid-binding-join :invalid-recur-target-join]]
    (if (= (count remaining) 0) false
      (if (contains? record (first remaining)) true
        (recur (rest remaining))))))

(defn sh07-b51-r6-derived-relational-products
  [carrier requests node-products]
  (let [nodes (get node-products :nodes)
        context (get carrier :authenticated-sh06-request)
        match-products
        (sh07-b51-r6-derived-authentic-match-products
         context nodes (get node-products :reference-uses))
        binding-products
        (sh07-b51-r6-derived-slot-binding-products context requests nodes)
        relational-keys
        [:error-handlers :match-branch-records :match-decision-skeletons
         :match-pattern-records :recursion-components :lexical-bindings
         :loop-bindings :recur-targets :recur-transfers]]
    (if (map? carrier)
      (if (vector? requests)
        (if (sh07-b51-r6-relational-node-base-authentic? node-products)
          (if (sh07-b51-r6-relational-context-authentic?
               carrier requests nodes)
            (let [products
                  (loop [remaining relational-keys result {}]
                    (if (= (count remaining) 0) result
                      (let [key (first remaining)]
                        (recur
                         (rest remaining)
                         (assoc
                          result key
                          (if (= key :error-handlers)
                            (sh07-b51-r6-derived-error-handlers
                             context nodes
                             (get node-products :reference-uses)
                             (get node-products :error-transfers))
                            (if (contains?
                                 #{:match-branch-records
                                   :match-decision-skeletons
                                   :match-pattern-records} key)
                              (get match-products key)
                              (if (contains?
                                   #{:lexical-bindings :loop-bindings} key)
                                (get binding-products key)
                                (if (= key :recursion-components)
                                  (sh07-b51-r6-derived-recursion-components
                                   (get node-products :function-records)
                                   (get node-products :call-edges))
                                  (if (= key :recur-targets)
                                    (sh07-b51-r6-derived-recur-targets
                                     context requests nodes)
                                    (sh07-b51-r6-derived-node-products
                                     key nodes)))))))))))]
              (if (if (= (get match-products :status) :accepted)
                    (= (get binding-products :status) :accepted) false)
                (if (loop [entries (vec products)]
                      (if (= (count entries) 0) false
                        (let [records (second (first entries))]
                          (if (loop [left records]
                                (if (= (count left) 0) false
                                  (if (sh07-b51-r6-invalid-relational-record?
                                       (first left))
                                    true (recur (rest left)))))
                            true (recur (rest entries))))))
                  {:status :rejected :reason :relational-derived-join}
                  {:status :accepted :products products})
                {:status :rejected :reason :relational-derived-join}))
            {:status :rejected :reason :relational-context})
          {:status :rejected :reason :relational-node-base})
        {:status :rejected :reason :relational-requests})
      {:status :rejected :reason :relational-carrier})))

(defn sh07-b51-r6-plan-product-cardinality?
  [requests outcome-kind products]
  (let [legacy? (= outcome-kind :legacy-v16-accepted)
        expected
        {:sh07-b51-implementation-semantic-id 1
         :sh07-b51-contract-semantic-id 1
         :sh07-b51-same-request-semantic-id 1
         :sh07-b51-v16-verification-semantic-id (if legacy? 1 0)
         :sh07-b51-predecessor-outcome-semantic-id 1
         :sh07-b51-predecessor-authority-id 1
         :sh07-b51-core-node-id (if legacy? 0 (count (get products :nodes)))
         :sh07-b51-product-node-id
         (count (get products :destructuring-product-nodes))
         :sh07-b51-binding-slot-id (count (get products :binding-slots))
         :sh07-b51-binding-extraction-id
         (count (get products :binding-extractions))
         :sh07-b51-runtime-check-id (count (get products :runtime-checks))
         :sh07-b51-publication-event-id
         (count (get products :publication-events))
         :sh07-b51-recur-slot-mapping-id
         (count (get products :recur-slot-mappings))
         :sh07-b51-slot-extraction-transcript-id 1
         :sh07-b51-core-identity-id 1
         :sh07-b51-predecessor-observation-id 1
         :sh07-b51-provenance-binding-id 1
         :sh07-b51-independent-verifier-binding-id 1
         :sh07-b51-final-artifact-binding-id 1}]
    (loop [remaining (sh07-b51-r6-purpose-order)]
      (if (= (count remaining) 0) true
        (let [purpose (first remaining)]
          (if (= (get (sh07-b51-r6-purpose-request requests purpose) :count)
                 (get expected purpose))
            (recur (rest remaining)) false))))))

(defn sh07-b51-r6-sh06-metadata-source-authentic? [carrier]
  (let [request (get carrier :authenticated-sh06-request)
        artifact (get carrier :sh06-resolution-artifact)
        boundary (get artifact :gravity-resolution-boundary)
        analysis (get boundary :resolved-analysis)
        sh05 (get artifact :sh05-macro-artifact)
        source-revision-id
        (get (get analysis :module-contract) :source-revision-id)
        lineage (get request :lineage)
        macro-trace (get request :macro-expansion-trace)
        origin-traces (get request :macro-origin-traces)
        expectation (get request :macro-origin-expectation)]
    (if (sh07-b51-r6-fresh-sh06? carrier)
      (if (= [(get lineage :source-revision-id)
              (get (get request :module) :source-revision-id)
              (get request :alias-table)]
             [source-revision-id source-revision-id
              (if (vector? (get analysis :alias-table))
                (get analysis :alias-table) [])])
        (if (loop [remaining (get request :binding-table)]
              (if (= (count remaining) 0) true
                (let [binding (first remaining)
                      upstream
                      (sh07-b51-r6-find-one
                       (get analysis :binding-table) :binding-id
                       (get binding :upstream-binding-id))
                      value (get upstream :value)]
                  (if (= (get upstream :count) 1)
                    (if (= [(get binding :name) (get binding :kind)
                            (get binding :binding-class)
                            (get binding :namespace) (get binding :package)
                            (get binding :visibility)
                            (get binding :profile-set)
                            (get binding :target-set)
                            (get binding :type-ref) (get binding :effects)
                            (get binding :capabilities) (get binding :safety)
                            (get binding :semantic-span)]
                           [(get value :name) (get value :kind)
                            (get value :binding-class)
                            (get value :namespace) (get value :package)
                            (get value :visibility)
                            (get value :profile-set)
                            (get value :target-set)
                            (get value :type-ref) (get value :effects)
                            (get value :capabilities) (get value :safety)
                            (get value :semantic-span)])
                      (recur (rest remaining)) false)
                    false))))
          (if (loop [remaining (get request :resolution-table)]
                (if (= (count remaining) 0) true
                  (let [resolution (first remaining)
                        upstream
                        (sh07-b51-r6-find-one
                         (get analysis :resolution-table)
                         :binding-id (get resolution :upstream-binding-id))
                        value (get upstream :value)]
                    (if (= (get upstream :count) 1)
                      (if (= [(get resolution :symbol)
                              (get resolution :position)
                              (get resolution :resolution-order)
                              (get resolution :source-span)]
                             [(get value :symbol) (get value :position)
                              (get value :resolution-order)
                              (sh07-b51-r6-semantic-span
                               (get value :source-span))])
                        (recur (rest remaining)) false)
                      false))))
            (if (loop [remaining macro-trace ordinal 0]
                  (if (= (count remaining) 0) true
                    (let [step (first remaining)
                          raw (get (get sh05 :macro-expansion-trace) ordinal)]
                      (if (= step
                             {:artifact
                              :gravity/sh07-preserved-macro-expansion-step
                              :ordinal ordinal :macro (get raw :macro)
                              :profile (get raw :profile)
                              :target (get raw :target)
                              :step (get raw :step)
                              :capabilities (get raw :capabilities)
                              :build-effects (get raw :build-effects)
                              :diagnostics (get raw :diagnostics)})
                        (recur (rest remaining) (+ ordinal 1)) false))))
              (if (loop [remaining origin-traces ordinal 0]
                    (if (= (count remaining) 0) true
                      (let [trace (first remaining)]
                        (if (sh07-b51-r6-exact-keys?
                             trace
                             #{:macro :input-syntax-id
                               :output-def-syntax-id
                               :introduced-fn-syntax-id
                               :def-generated-origin-id
                               :fn-generated-origin-id :source-revision-id
                               :sh05-artifact-id
                               :macro-expansion-trace-id})
                          (if (= [(get trace :macro)
                                  (get trace :source-revision-id)
                                  (get trace :sh05-artifact-id)
                                  (get trace :macro-expansion-trace-id)]
                                 ['defn (get lineage :source-revision-id)
                                  (get lineage :sh05-artifact-id)
                                  (get lineage :macro-expansion-trace-id)])
                            (recur (rest remaining) (+ ordinal 1)) false)
                          false))))
                (= expectation
                   {:source-revision-id (get lineage :source-revision-id)
                    :sh05-artifact-id (get lineage :sh05-artifact-id)
                    :macro-expansion-trace-id
                    (get lineage :macro-expansion-trace-id)
                    :expanded-defn-count (count origin-traces)
                    :expected-input-syntax-ids
                    (loop [remaining origin-traces result []]
                      (if (= (count remaining) 0) result
                        (recur
                         (rest remaining)
                         (conj result
                               (get (first remaining) :input-syntax-id)))))
                    :expected-output-def-syntax-ids
                    (loop [remaining origin-traces result []]
                      (if (= (count remaining) 0) result
                        (recur
                         (rest remaining)
                         (conj result
                               (get (first remaining)
                                    :output-def-syntax-id)))))
                    :expected-introduced-fn-syntax-ids
                    (loop [remaining origin-traces result []]
                      (if (= (count remaining) 0) result
                        (recur
                         (rest remaining)
                         (conj result
                               (get (first remaining)
                                    :introduced-fn-syntax-id)))))})
                false)
              false)
            false)
          false)
        false)
      false)))

(defn sh07-b51-r6-request-products-authentic? [carrier products]
  (let [request (get carrier :authenticated-sh06-request)
        fragments
        (sh07-b51-r6-derived-fragment-products request (get products :nodes))
        manifest (get request :fragment-manifest)
        coverage (get request :fragment-coverage)
        assembly (get request :module-assembly-manifest)
        lineage (get request :lineage)
        expected-coverage
        {:root-form-count (count (get request :top-level-form-ids))
         :form-count (count (get request :forms))
         :local-binding-count
         (loop [remaining manifest total 0]
           (if (= (count remaining) 0) total
             (recur (rest remaining)
                    (+ total (count (get (first remaining)
                                         :local-binding-ids))))))
         :resolution-count (count (get request :resolution-table))
         :fragment-count (count manifest)
         :covered-root-form-ids
         (loop [remaining manifest result []]
           (if (= (count remaining) 0) result
             (recur (rest remaining)
                    (sh07-b51-r6-append
                     result (get (first remaining) :root-form-ids)))))
         :covered-form-ids
         (loop [remaining manifest result []]
           (if (= (count remaining) 0) result
             (recur (rest remaining)
                    (sh07-b51-r6-append
                     result (get (first remaining) :form-ids)))))
         :covered-local-binding-ids
         (loop [remaining manifest result []]
           (if (= (count remaining) 0) result
             (recur (rest remaining)
                    (sh07-b51-r6-append result
                          (get (first remaining) :local-binding-ids)))))
         :covered-resolution-reference-syntax-ids
         (loop [remaining manifest result []]
           (if (= (count remaining) 0) result
             (recur
              (rest remaining)
              (sh07-b51-r6-append result
                    (get (first remaining)
                         :resolution-reference-syntax-ids)))))}
        expected-assembly
        {:ordered-fragment-ids
         (loop [remaining manifest result []]
           (if (= (count remaining) 0) result
             (recur (rest remaining)
                    (conj result (get (first remaining) :fragment-id)))))
         :root-form-ids (get request :top-level-form-ids)
         :source-revision-id (get lineage :source-revision-id)
         :sh06-semantic-projection-id
         (get lineage :sh06-semantic-projection-id)
         :alias-table-id (get lineage :alias-table-id)
         :content-id (get lineage :source-revision-id)
         :module-id (get lineage :sh06-semantic-projection-id)}]
  (if (sh07-b51-r6-sh06-metadata-source-authentic? carrier)
    (if (= coverage expected-coverage)
      (if (= (get coverage :covered-form-ids)
             (loop [remaining (get request :forms) result []]
               (if (= (count remaining) 0) result
                 (recur (rest remaining)
                        (conj result (get (first remaining) :form-id))))))
        (if (= assembly expected-assembly)
        (= [(get fragments :status)
      (get products :fragment-manifest)
      (get products :root-core-node-ids)
      (get products :fragment-coverage)
      (get products :module-assembly-manifest)
      (get products :binding-table)
      (get products :declared-alias-table)
      (get products :resolution-table)
      (get products :definitions)
      (get products :macro-expansion-trace)
      (get products :macro-origin-traces)
      (get products :macro-origin-expectation)]
     [:accepted
      (get fragments :fragment-manifest)
      (get fragments :root-core-node-ids)
      (get request :fragment-coverage)
      (get request :module-assembly-manifest)
      (get request :binding-table)
      (get request :alias-table)
      (get request :resolution-table)
      (sh07-b51-r6-derived-definitions (get products :nodes))
      (get request :macro-expansion-trace)
      (get request :macro-origin-traces)
      (get request :macro-origin-expectation)])
        false)
        false)
      false)
    false)))

(defn sh07-b51-r6-v16-key-order []
  [:domain :lineage :projection-binding :module
   :fragment-manifest :fragment-coverage :module-assembly-manifest
   :root-core-node-ids :definitions :nodes :evaluation-order :control-flow
   :reference-uses :var-references :mutations :error-transfers :error-handlers
   :match-branch-records :match-decision-skeletons :match-pattern-records
   :calls :function-records :call-edges :recursion-components :keyword-lookups
   :lexical-bindings :loop-bindings :recur-targets :recur-transfers :source-map
   :binding-table :declared-alias-table :resolution-table
   :macro-expansion-trace :macro-origin-traces :macro-origin-expectation
   :pending-fact-families])

(defn sh07-b51-r6-v16-projection-id [value]
  (let [lineage-id (get (get value :lineage) :sh06-semantic-projection-id)
        top-id (get value :sh06-semantic-projection-id)
        attribute-id (get (get value :attributes)
                          :sh06-semantic-projection-id)]
    (if lineage-id lineage-id (if top-id top-id attribute-id))))

(defn sh07-b51-r6-v16-normalize-item [item projection-id kind]
  (let [upstream-key
        (if (= kind :mutation) :target-upstream-binding-id
          :upstream-binding-id)
        binding-key
        (if (= kind :mutation) :target-binding-id :binding-id)
        definition-key
        (if (= kind :mutation) :target-definition-artifact-id
          :definition-artifact-id)
        first-value
        (if (if (contains? #{:binding :resolution :reference :mutation} kind)
              (get item upstream-key) false)
          (assoc item upstream-key (get item binding-key)) item)
        second-value
        (if (if (contains? #{:binding :reference :mutation} kind)
              (if projection-id (contains? first-value definition-key) false)
              false)
          (assoc first-value definition-key projection-id) first-value)]
    (if (if (contains? #{:reference :mutation :artifact} kind)
          (if projection-id
            (contains? second-value :authenticated-sh06-artifact-id) false)
          false)
      (assoc second-value :authenticated-sh06-artifact-id projection-id)
      second-value)))

(defn sh07-b51-r6-v16-normalize-node [node projection-id]
  (let [kind (get node :core-form)]
    (if (= kind :var)
      (assoc node :attributes
             (sh07-b51-r6-v16-normalize-item
              (get node :attributes) projection-id :reference))
      (if (= kind :set!)
        (assoc node :attributes
               (sh07-b51-r6-v16-normalize-item
                (get node :attributes) projection-id :mutation))
        (if (contains? #{:throw :try} kind)
          (assoc node :attributes
                 (sh07-b51-r6-v16-normalize-item
                  (get node :attributes) projection-id :artifact))
          node)))))

(defn sh07-b51-r6-v16-normalize-vector [values projection-id kind]
  (if (vector? values)
    (loop [remaining values result []]
      (if (= (count remaining) 0) result
        (recur
         (rest remaining)
         (conj result
               (if (= kind :node)
                 (sh07-b51-r6-v16-normalize-node
                  (first remaining) projection-id)
                 (sh07-b51-r6-v16-normalize-item
                  (first remaining) projection-id kind))))))
    values))

(defn sh07-b51-r6-v16-normalize [preimage]
  (let [projection-id (sh07-b51-r6-v16-projection-id preimage)
        seed
        (if (if projection-id (contains? preimage :projection-binding) false)
          (assoc preimage :projection-binding projection-id) preimage)
        lineage (get seed :lineage)
        seed
        (if (if projection-id (contains? seed :lineage) false)
          (if (map? lineage)
            (assoc seed :lineage
                   (assoc lineage :authenticated-sh06-artifact-id
                          projection-id))
            seed)
          seed)
        categories
        [[:binding-table :binding] [:resolution-table :resolution]
         [:var-references :reference] [:mutations :mutation]
         [:error-transfers :artifact] [:error-handlers :artifact]
         [:nodes :node]]
        normalized
        (loop [remaining categories result seed]
          (if (= (count remaining) 0) result
            (let [entry (first remaining) key (first entry) kind (second entry)]
              (recur
               (rest remaining)
               (if (contains? result key)
                 (assoc result key
                        (sh07-b51-r6-v16-normalize-vector
                         (get result key) projection-id kind)) result)))))]
    (if (contains? #{:var :set! :throw :try} (get normalized :core-form))
      (let [kind (get normalized :core-form)]
        (assoc normalized :attributes
               (if (= kind :var)
                 (sh07-b51-r6-v16-normalize-item
                  (get normalized :attributes) projection-id :reference)
                 (if (= kind :set!)
                   (sh07-b51-r6-v16-normalize-item
                    (get normalized :attributes) projection-id :mutation)
                   (sh07-b51-r6-v16-normalize-item
                    (get normalized :attributes) projection-id :artifact)))))
      normalized)))

(defn sh07-b51-r6-ordered-map-entries [value]
  (loop [remaining (vec value) result []]
    (if (= (count remaining) 0)
      (loop [rows result ordered []]
        (if (= (count rows) 0) ordered
          (recur (rest rows)
                 (sh07-b51-r6-decoration-insert
                  ordered (first rows) true))))
      (let [entry (first remaining)
            key-decoration
            (sh07-b51-r6-canonical-decoration (first entry) 0 1 #{})
            value-decoration
            (sh07-b51-r6-canonical-decoration (second entry) 0 1 #{})]
        (if (if (= (get key-decoration :status) :decorated)
              (= (get value-decoration :status) :decorated) false)
          (recur (rest remaining)
                 (conj result {:entry entry :key key-decoration
                               :value value-decoration}))
          [])))))

(defn sh07-b51-r6-legacy-mapping-leaves [value path]
  (if (map? value)
    (loop [remaining (sh07-b51-r6-ordered-map-entries value) result []]
      (if (= (count remaining) 0) result
        (let [entry (get (first remaining) :entry)]
          (recur
           (rest remaining)
           (sh07-b51-r6-append result
                 (sh07-b51-r6-legacy-mapping-leaves
                  (second entry) (conj path (first entry))))))))
    (if (vector? value)
      (loop [remaining value ordinal 0 result []]
        (if (= (count remaining) 0) result
          (recur
           (rest remaining) (+ ordinal 1)
           (sh07-b51-r6-append result
                 (sh07-b51-r6-legacy-mapping-leaves
                  (first remaining) (conj path ordinal))))))
      [{:v16-path path :v18-path path
        :normalization :direct-resolved-semantic}])))

(defn sh07-b51-r6-legacy-field-mapping [projection]
  (loop [remaining (sh07-b51-r6-v16-key-order) result []]
    (if (= (count remaining) 0) result
      (let [key (first remaining) path [key]
            top
            (if (= key :domain)
              {:v16-path path :v18-path path :normalization :constant-source
               :constant :gravity/sh07-b47-canonical-core-v16}
              {:v16-path path :v18-path path
               :normalization :direct-resolved-semantic})
            nested
            (if (= key :domain) []
              (let [value (get projection key)]
                (if (if (map? value) true (vector? value))
                  (sh07-b51-r6-legacy-mapping-leaves value path) [])))]
        (recur (rest remaining)
               (sh07-b51-r6-append (conj result top) nested))))))

(defn sh07-b51-r6-legacy-equivalence-authentic?
  [carrier requests products]
  (let [artifact
        (get (get (get (get carrier :predecessor-raw-outcome)
                       :structural-runner-observation) :returned)
             :canonical-core-artifact)
        source (get artifact :identity-preimage)
        compatibility
        (loop [remaining (sh07-b51-r6-v16-key-order) result {}]
          (if (= (count remaining) 0) result
            (let [key (first remaining)]
              (recur
               (rest remaining)
               (assoc result key
                      (if (= key :domain) (get source :domain)
                        (if (= key :lineage) (get artifact :lineage)
                          (if (= key :projection-binding)
                            (get artifact :projection-binding)
                            (if (= key :module) (get artifact :module)
                              (get products key))))))))))
        v16 (sh07-b51-r6-v16-normalize source)
        v18 (sh07-b51-r6-v16-normalize compatibility)
        expected
        {:domain :gravity/sh07-b51-legacy-v16-equivalence-v18
         :schema-version 18
         :legacy-artifact-kind :gravity/sh07-canonical-core-artifact
         :legacy-schema-version 16 :legacy-wrapper-kind nil
         :legacy-identity-preimage-domain
         :gravity/sh07-b47-canonical-core-v16
         :same-request-semantic-id
         (sh07-b51-r6-reference-for-purpose
          requests :sh07-b51-same-request-semantic-id)
         :predecessor-outcome-semantic-id
         (sh07-b51-r6-reference-for-purpose
          requests :sh07-b51-predecessor-outcome-semantic-id)
         :inherited-v16-semantic-artifact-id (get artifact :artifact-id)
         :inherited-v16-artifact-purpose :sh07-core-artifact-id
         :v16-semantic-projection v16 :v18-compatibility-projection v18
         :v16-semantic-key-order (sh07-b51-r6-v16-key-order)
         :field-mapping (sh07-b51-r6-legacy-field-mapping v18)
         :normalization-policy :v16-resolved-semantic-canonical-v1
         :missing-fields [] :unexpected-fields [] :delta [] :equal? true
         :v16-verification-semantic-id
         (sh07-b51-r6-reference-for-purpose
          requests :sh07-b51-v16-verification-semantic-id)}]
    (if (= (set (keys source)) (set (sh07-b51-r6-v16-key-order)))
      (if (= (set (keys compatibility))
             (set (sh07-b51-r6-v16-key-order)))
        (if (= v16 v18)
          (= (get products :legacy-v16-equivalence) expected) false)
        false)
      false)))

(defn sh07-b51-r6-inherited-products-authentic?
  [carrier requests outcome-kind products]
  (let [request (get carrier :authenticated-sh06-request)
        structural (get (get (get carrier :predecessor-raw-outcome)
                             :structural-runner-observation) :returned)
        artifact (get structural :canonical-core-artifact)
        lowered (sh07-b51-r6-lower-authenticated-forms carrier requests)
        inherited
        [:fragment-manifest :fragment-coverage :module-assembly-manifest
         :root-core-node-ids :definitions :nodes :evaluation-order
         :control-flow :reference-uses :var-references :mutations
         :error-transfers :error-handlers :match-branch-records
         :match-decision-skeletons :match-pattern-records :calls
         :function-records :call-edges :recursion-components
         :keyword-lookups :lexical-bindings :loop-bindings :recur-targets
         :recur-transfers :source-map :binding-table :declared-alias-table
         :resolution-table :macro-expansion-trace :macro-origin-traces
         :macro-origin-expectation :pending-fact-families]]
    (if (= outcome-kind :legacy-v16-accepted)
      (loop [remaining inherited]
        (if (= (count remaining) 0)
          (sh07-b51-r6-legacy-equivalence-authentic?
           carrier requests products)
          (let [key (first remaining)
                expected (if (= key :binding-table)
                           (get request :binding-table)
                           (if (= key :resolution-table)
                             (get request :resolution-table)
                             (get artifact key)))]
            (if (= (get products key) expected)
              (recur (rest remaining)) false))))
      (if (if (= (get products :pending-fact-families)
                 [:types :effects :ownership :safety])
            (= (get products :legacy-v16-equivalence) nil) false)
        (if (= (get lowered :status) :accepted)
          (if (= (get products :nodes) (get lowered :nodes))
            (if (sh07-b51-r6-node-products-authentic? products)
          (if (sh07-b51-r6-fresh-sh06? carrier)
            (if (sh07-b51-r6-request-products-authentic? carrier products)
              (let [derived
                    (sh07-b51-r6-derived-relational-products
                     carrier requests
                     {:nodes (get products :nodes)

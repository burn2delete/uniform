                                       :gravity/sh07-b51-v18-linked-semantic-manifest-v4
                                       :schema-version 4
                                       :predecessor-executable-descriptor-id
                                       (get carrier
                                            :predecessor-executable-descriptor-id)
                                       :module-source-ids (get inputs :m0-ids)
                                       :link-manifest-id (get inputs :m1-id)
                                       :module-plan-ids (get inputs :m2-ids)
                                       :execution-bundle-id expected-bundle-id
                                       :compile-census-certificate-ids
                                       certificate-ids
                                       :schedule
                                       (get claim :category-schedule)
                                       :category-commitments commitments
                                       :logical-public-surface

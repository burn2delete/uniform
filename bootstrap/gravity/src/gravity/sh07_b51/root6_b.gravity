                                      false)
                                    false))
                                false))
                            false)
                          false)
                        false)
                      false)
                    false)
                  false)
                  false)
                false))
            false))
        false)
      false)))

(defn sh07-b51-r6-c30-request-proof?
  [carrier requests resolved-digests products-result outcome-result rebuilt]
  (let [request (get carrier :authenticated-sh06-request)
        indexes (sh07-b51-r6-index-request request)
        outcome (get outcome-result :outcome)
        outcome-kind (get outcome :outcome-kind)
        authority
        (sh07-b51-r6-selected-preimage
         requests :sh07-b51-predecessor-authority-id)
        products (get products-result :products)]
    (if (= (sh07-b51-admitted-executable-carrier-validation?
            (get carrier :v18-executable-descriptor))
           true)
      (if (if (sh07-b51-r6-request-outer? request)
            (if (sh07-b51-r6-indexes-unique? request indexes)
              (sh07-b51-r6-request-aggregate-bounds? request) false)
            false)
        (if (sh07-b51-r6-fresh-sh06? carrier)
          (if (if (sh07-b51-r6-predecessor-closure-authentic? carrier)
                (sh07-b51-r6-predecessor-contract-authentic? carrier) false)
            (if (sh07-b51-r6-same-request-preimage-authentic?
                 carrier requests)
              (if (= (get outcome-result :status) :accepted)
                (if (sh07-b51-r6-authority-preimage-exact?
                     requests outcome authority)
                  (if (sh07-b51-r6-record-owners-authentic?
                       request indexes (get products :binding-slots))
                    (if (sh07-b51-r6-all-resolutions-authorized?
                         carrier request indexes)
                      (if (if (sh07-b51-r6-record-owners-authentic?
                               request indexes
                               (get products :binding-extractions))
                            (if (sh07-b51-r6-pattern-extractions-authentic?
                                 request indexes
                                 (get products :binding-extractions))
                              (sh07-b51-r6-binding-resource-bounds? products)
                              false)
                            false)
                        (if (sh07-b51-r6-record-vector-authentic?
                             requests :sh07-b51-binding-extraction-id
                             :extraction-id
                             :gravity/sh07-b51-binding-extraction-id-preimage-v18
                             (get products :binding-extractions))
                          (if (sh07-b51-r6-vector-check-coverage-authentic?
                               products)
                            (if (sh07-b51-r6-publications-authentic?
                                 requests products)
                              (if (sh07-b51-r6-runtime-checks-authentic?
                                   requests products)
                                (if (sh07-b51-r6-recur-mappings-authentic?
                                     requests products)
                                  (if (= (get products-result :status)
                                         :accepted)
                                    (if (if (= outcome-kind
                                               :legacy-v16-accepted)
                                          (sh07-b51-r6-legacy-equivalence-authentic?
                                           carrier requests products)
                                          (= (get products
                                                  :legacy-v16-equivalence)
                                             nil))
                                      (if (sh07-b51-r6-replay-digests
                                           requests resolved-digests)
                                        (if (sh07-b51-r6-plan-product-cardinality?
                                             requests outcome-kind products)
                                          (if (sh07-b51-r6-plan-dag-exact?
                                               requests outcome-kind)
                                            (if (sh07-b51-r6-tier4-preimages-authentic?
                                                 carrier requests)
                                              (= (get rebuilt :status)
                                                 :accepted)
                                              false)
                                            false)
                                          false)
                                        false)
                                      false)
                                    false)
                                  false)
                                false)
                              false)
                            false)
                          false)
                        false)
                      false)
                    false)
                  false)
                false)
              false)
            false)
          false)
        false)
      false)))

(defn sh07-b51-r6-c30-passed-evaluations []
  (loop [remaining (sh07-b51-r6-check-order) result []]
    (if (= (count remaining) 0) result
      (recur (rest remaining)
             (conj result {:check (first remaining) :passed? true})))))

(defn sh07-b51-r6-check-order []
  [:raw-carrier-exact-shape :authenticated-sh06-membership
   :fresh-sh06-verification :predecessor-closure :predecessor-contract
   :same-request :predecessor-outcome :predecessor-authority
   :owning-root-fragment :external-binding-authorization
   :vector-pattern-grammar :slot-extraction-reconstruction
   :empty-vector-width :visibility-and-publication :runtime-check-order
   :loop-recur-atomicity :semantic-product-closure
   :legacy-v16-equivalence :digest-dag :tier3-identity
   :tier4-observation-provenance])

(defn sh07-b51-r6-check-evaluation [check passed?]
  {:check check :passed? (= passed? true)})

(defn sh07-b51-r6-evaluate-check-booleans
  [carrier requests resolved-digests]
  (let [request (get carrier :authenticated-sh06-request)
        indexes (sh07-b51-r6-index-request request)
        outcome-result (sh07-b51-r6-derive-predecessor-outcome
                        carrier requests)
        outcome (get outcome-result :outcome)
        outcome-kind (get outcome :outcome-kind)
        authority (sh07-b51-r6-selected-preimage
                   requests :sh07-b51-predecessor-authority-id)
        product-result (sh07-b51-r6-reconstruct-products carrier requests)
        products (get product-result :products)
        digest-replay?
        (if (sh07-b51-r6-plan-dag-exact? requests outcome-kind)
          (sh07-b51-r6-replay-digests requests resolved-digests) false)
        rebuilt (sh07-b51-r6-rebuild-supplied
                 carrier requests resolved-digests)]
    [(sh07-b51-r6-check-evaluation
      :raw-carrier-exact-shape
      (if (sh07-b51-r6-raw-outer? carrier)
        (= (get (sh07-b51-r6-carrier-structure-preflight
                 carrier 8388608 256 65536) :status) :accepted)
        false))
     (sh07-b51-r6-check-evaluation
      :authenticated-sh06-membership
      (if (sh07-b51-r6-request-outer? request)
        (if (sh07-b51-r6-indexes-unique? request indexes)
          (sh07-b51-r6-request-aggregate-bounds? request) false)
        false))
     (sh07-b51-r6-check-evaluation
      :fresh-sh06-verification (sh07-b51-r6-fresh-sh06? carrier))
     (sh07-b51-r6-check-evaluation
      :predecessor-closure
      (if (sh07-b51-r6-predecessor-closure-authentic? carrier)
        (sh07-b51-r6-v18-executable-authentic? carrier) false))
     (sh07-b51-r6-check-evaluation
      :predecessor-contract
      (sh07-b51-r6-predecessor-contract-authentic? carrier))
     (sh07-b51-r6-check-evaluation
      :same-request
      (sh07-b51-r6-same-request-preimage-authentic? carrier requests))
     (sh07-b51-r6-check-evaluation
      :predecessor-outcome (= (get outcome-result :status) :accepted))
     (sh07-b51-r6-check-evaluation
      :predecessor-authority
      (sh07-b51-r6-authority-preimage-exact? requests outcome authority))
     (sh07-b51-r6-check-evaluation
     :owning-root-fragment
      (sh07-b51-r6-record-owners-authentic?
       request indexes (get products :binding-slots)))
     (sh07-b51-r6-check-evaluation
      :external-binding-authorization
      (if (sh07-b51-r6-request-outer? request)
        (sh07-b51-r6-all-resolutions-authorized? carrier request indexes)
        false))
     (sh07-b51-r6-check-evaluation
      :vector-pattern-grammar
      (if (sh07-b51-r6-record-owners-authentic?
           request indexes (get products :binding-extractions))
        (if (sh07-b51-r6-pattern-extractions-authentic?
             request indexes (get products :binding-extractions))
          (sh07-b51-r6-binding-resource-bounds? products) false)
        false))
     (sh07-b51-r6-check-evaluation
      :slot-extraction-reconstruction
      (sh07-b51-r6-record-vector-authentic?
       requests :sh07-b51-binding-extraction-id :extraction-id
       :gravity/sh07-b51-binding-extraction-id-preimage-v18
       (get products :binding-extractions)))
     (sh07-b51-r6-check-evaluation
      :empty-vector-width
      (sh07-b51-r6-vector-check-coverage-authentic? products))
     (sh07-b51-r6-check-evaluation
      :visibility-and-publication
      (sh07-b51-r6-publications-authentic? requests products))
     (sh07-b51-r6-check-evaluation
      :runtime-check-order
      (sh07-b51-r6-runtime-checks-authentic? requests products))
     (sh07-b51-r6-check-evaluation
      :loop-recur-atomicity
      (sh07-b51-r6-recur-mappings-authentic? requests products))
     (sh07-b51-r6-check-evaluation
      :semantic-product-closure
      (= (get product-result :status) :accepted))
     (sh07-b51-r6-check-evaluation
      :legacy-v16-equivalence
      (if (sh07-b51-r6-outcome-kind? outcome-kind)
        (if (= outcome-kind :legacy-v16-accepted)
          (sh07-b51-r6-legacy-equivalence-authentic?
           carrier requests products)
          (if (= (get product-result :status) :accepted)
            (= (get products :legacy-v16-equivalence) nil) false))
        false))
     (sh07-b51-r6-check-evaluation
      :digest-dag
      digest-replay?)
     (sh07-b51-r6-check-evaluation
      :tier3-identity
      (if digest-replay?
       (if (= (get product-result :status) :accepted)
        (if (sh07-b51-r6-plan-product-cardinality?
             requests outcome-kind products)
          (= (get rebuilt :status) :accepted) false)
        false)
       false))
     (sh07-b51-r6-check-evaluation
      :tier4-observation-provenance
      (if digest-replay?
        (if (sh07-b51-r6-tier4-preimages-authentic? carrier requests)
          (= (get rebuilt :status) :accepted) false)
        false))]))

(defn sh07-b51-r6-check-proof-kind [check]
  (get
   {:raw-carrier-exact-shape :closed-raw-carrier-and-aggregate-census
    :authenticated-sh06-membership :exact-sh06-request-index-replay
    :fresh-sh06-verification :exact-report-proof-boundary-agreement
    :predecessor-closure :immutable-b47-closure-and-edge-hash
    :predecessor-contract :immutable-b47-contract-carrier
    :same-request :fixed-tier0-request-binding
    :predecessor-outcome :four-branch-raw-outcome-replay
    :predecessor-authority :outcome-bound-authority-preimage
    :owning-root-fragment :top-level-defn-fn-fragment-ancestry
    :external-binding-authorization :localized-resolution-authority
    :vector-pattern-grammar :authenticated-pattern-owner-replay
    :slot-extraction-reconstruction :exact-record-preimage-joins
    :empty-vector-width :zero-width-pattern-and-check-replay
    :visibility-and-publication :publication-authority-and-order
    :runtime-check-order :dense-global-runtime-check-order
    :loop-recur-atomicity :dense-recur-target-slot-commit
    :semantic-product-closure :raw-lowered-complete-product-equality
    :legacy-v16-equivalence :normalized-complete-v16-v18-equality
    :digest-dag :typed-path-dag-and-prefix-digest-replay
    :tier3-identity :exact-identity-and-registry-materialization
    :tier4-observation-provenance :opaque-observation-provenance-binding}
   check))

(defn sh07-b51-r6-check-proofs
  [carrier requests resolved-digests]
  (let [evaluations
        (sh07-b51-r6-evaluate-check-booleans
         carrier requests resolved-digests)]
    (loop [remaining evaluations ordinal 0 result []]
      (if (= (count remaining) 0) result
        (let [evaluation (first remaining)
              check (get evaluation :check)]
          (recur
           (rest remaining) (+ ordinal 1)
           (conj result
                 {:ordinal ordinal :check check
                  :proof-kind (sh07-b51-r6-check-proof-kind check)
                  :passed? (get evaluation :passed?)})))))))

(defn sh07-b51-r6-evaluate-checks [carrier requests resolved-digests]
  (loop [remaining
         (sh07-b51-r6-check-proofs carrier requests resolved-digests)
         result []]
    (if (= (count remaining) 0) result
      (recur (rest remaining)
             (conj result
                   {:check (get (first remaining) :check)
                    :passed? (get (first remaining) :passed?)})))))

(defn sh07-b51-r6-all-checks-passed? [evaluations]
  (if (= (count evaluations) 21)
    (loop [remaining evaluations expected (sh07-b51-r6-check-order)]
      (if (= (count remaining) 0) (= (count expected) 0)
        (let [evaluation (first remaining)]
          (if (sh07-b51-r6-exact-keys? evaluation #{:check :passed?})
            (if (= (get evaluation :check) (first expected))
              (if (= (get evaluation :passed?) true)
                (recur (rest remaining) (rest expected)) false)
              false)
            false))))
    false))

(defn sh07-b51-r6-passed-check-rows [evaluations]
  (if (sh07-b51-r6-all-checks-passed? evaluations)
    (loop [remaining evaluations ordinal 0 result []]
      (if (= (count remaining) 0) result
        (recur (rest remaining) (+ ordinal 1)
               (conj result
                     {:ordinal ordinal
                      :check (get (first remaining) :check)
                      :status :passed}))))
    []))

(defn sh07-b51-r6-predecessor-outcome-authentic?
  [carrier outcome]
  (if (map? outcome)
    (let [kind (get outcome :outcome-kind)
          direct (get (get (get carrier :predecessor-raw-outcome)
                           :direct-template-observation) :returned)
          structural (get (get (get carrier :predecessor-raw-outcome)
                               :structural-runner-observation) :returned)
          artifact (get structural :canonical-core-artifact)
          diagnostic (get (get direct :diagnostics) 0)
          raw-reason (get (get (get diagnostic :facts) :rule-specific)
                          :reason)]
      (if (sh07-b51-r6-outcome-kind? kind)
        (if (= kind :legacy-v16-accepted)
          (if (= (get direct :status) :accepted)
            (= (get outcome :v16-semantic-artifact-id)
               (get artifact :artifact-id)) false)
          (if (= kind :legacy-v16-accepted-after-no-form-waiver)
            (= raw-reason :authoritative-record-shape)
            (if (= (get direct :status) :rejected)
              (= (get outcome :frontier-binding-kind) :vector) false)))
        false))
    false))

(defn sh07-b51-r6-resolved-bundle
  [carrier requests resolved-digests]
  (sh07-b51-r6-rebuild-supplied carrier requests resolved-digests))

(defn sh07-b51-r6-verifier-preimage
  [identity-id provenance-id evaluations]
  {:domain :gravity/sh07-b51-independent-verifier-binding-preimage-v18
   :schema-version 18
   :verifier :sh07-b51-independent-verifier-v18
   :verifier-entrypoint 'sh07-b51-build-independent-verifier-binding
   :semantic-identity-id identity-id
   :provenance-binding-id provenance-id
   :check-order (sh07-b51-r6-check-order)
   :checks (sh07-b51-r6-passed-check-rows evaluations)
   :status :passed})

(defn sh07-b51-r6-boundary [reason]
  {:artifact :gravity/sh07-b51-entrypoint-result-v18
   :domain :gravity/sh07-b51-entrypoint-abi-v18
   :schema-version 18 :status :boundary-rejected
   :tag :independent-verifier-boundary-rejected
   :value
   {:status :boundary-rejected
    :boundary :sh07-b51-build-independent-verifier-binding
    :reason reason :recursive-diagnostic-forbidden true}})

(defn sh07-b51-r6-success [value]
  {:artifact :gravity/sh07-b51-entrypoint-result-v18
   :domain :gravity/sh07-b51-entrypoint-abi-v18
   :schema-version 18 :status :accepted
   :tag :independent-verifier-bound :value value})

(defn sh07-b51-build-independent-verifier-binding
  [raw-carrier resolved-core predecessor-observation
   provenance-binding digest-requests resolved-digests]
  (if (sh07-b51-r6-raw-outer? raw-carrier)
    (if (map? resolved-core)
      (if (map? predecessor-observation)
        (if (map? provenance-binding)
          (if (vector? digest-requests)
            (if (vector? resolved-digests)
              (let [outcome-result
                    (sh07-b51-r6-derive-predecessor-outcome
                     raw-carrier digest-requests)
                    outcome (get outcome-result :outcome)
                    outcome-kind (get outcome :outcome-kind)
                    products-result
                    (sh07-b51-r6-reconstruct-products
                     raw-carrier digest-requests)
                    rebuilt
                    (if (= (get products-result :status) :accepted)
                      (sh07-b51-r6-rebuild-supplied
                       raw-carrier digest-requests resolved-digests)
                      {:status :rejected})]
                (if (sh07-b51-r6-plan-schedule? digest-requests)
                  (if (= (get outcome-result :status) :accepted)
                    (if (sh07-b51-r6-predecessor-outcome-authentic?
                         raw-carrier outcome)
                      (if (sh07-b51-r6-v16-verification-authentic?
                           raw-carrier digest-requests outcome-kind)
                        (if (sh07-b51-r6-fixed-preimages-authentic?
                             raw-carrier digest-requests)
                          (if (sh07-b51-r6-c30-request-proof?
                               raw-carrier digest-requests resolved-digests
                               products-result outcome-result rebuilt)
                            (if (= resolved-core (get rebuilt :resolved-core))
                              (if (= predecessor-observation
                                     (get rebuilt :predecessor-observation))
                                (if (= provenance-binding
                                       (get rebuilt :provenance-binding))
                                  (let [evaluations
                                        (sh07-b51-r6-c30-passed-evaluations)
                                        preimage
                                        (sh07-b51-r6-verifier-preimage
                                         (get rebuilt :identity-id)
                                         (get rebuilt :provenance-id)
                                         evaluations)
                                        verifier-row
                                        (sh07-b51-r6-purpose-request
                                         digest-requests
                                         :sh07-b51-independent-verifier-binding-id)]
                                    (if (sh07-b51-r6-all-checks-passed?
                                         evaluations)
                                      (if (= (get verifier-row :count) 1)
                                        (if (= preimage
                                               (get (get verifier-row :request)
                                                    :preimage))
                                          (sh07-b51-r6-success
                                           {:artifact
                                            :gravity/sh07-b51-independent-verifier-binding-v18
                                            :schema-version 18
                                            :independent-verifier-binding-id
                                            (get rebuilt :verifier-id)
                                            :preimage preimage})
                                          (sh07-b51-r6-boundary
                                           :invocation-mismatch))
                                        (sh07-b51-r6-boundary
                                         :invocation-mismatch))
                                      (sh07-b51-r6-boundary
                                       :invocation-mismatch)))
                                  (sh07-b51-r6-boundary
                                   :invocation-mismatch))
                                (sh07-b51-r6-boundary
                                 :invocation-mismatch))
                              (sh07-b51-r6-boundary :invocation-mismatch))
                            (sh07-b51-r6-boundary :invocation-mismatch))
                          (sh07-b51-r6-boundary :invocation-mismatch))
                        (sh07-b51-r6-boundary :invocation-mismatch))
                      (sh07-b51-r6-boundary :invocation-mismatch))
                    (sh07-b51-r6-boundary :invocation-mismatch))
                  (sh07-b51-r6-boundary :invocation-mismatch)))
              (sh07-b51-r6-boundary :malformed-invocation))
            (sh07-b51-r6-boundary :malformed-invocation))
          (sh07-b51-r6-boundary :malformed-invocation))
        (sh07-b51-r6-boundary :malformed-invocation))
      (sh07-b51-r6-boundary :malformed-invocation))
    (sh07-b51-r6-boundary :malformed-invocation)))

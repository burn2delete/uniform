                            (get census :external-binding-count)
                            (get census :aggregate-binding-count)]
                           [ordinal (get descriptor :module)
                            (get descriptor :logical-source-path)
                            (get descriptor :owner)
                            (get descriptor :source-byte-count)
                            (get descriptor :source-sha256)
                            (get descriptor :module-source-id)
                            (get plan-row :plan-id)
                            (count (get descriptor :definitions))
                            (get descriptor :core-binding-count)
                            (get descriptor :lexical-binding-count)
                            (count (get descriptor :external-bindings))
                            (get descriptor :aggregate-binding-count)])

                  (let [row (first remaining) name (get row :name)]
                    (if (sh07-b51-r6-c30-definition-row? row)
                      (if (contains? seen name) false
                        (recur (rest remaining) (conj seen name)))
                      false))))
            (if (loop [remaining externals seen #{}]
                  (if (= (count remaining) 0) true
                    (let [row (first remaining) symbol (get row :symbol)]
                      (if (sh07-b51-r6-c30-external-binding-row? row)
                        (if (contains? seen symbol) false
                          (recur (rest remaining) (conj seen symbol)))
                        false))))
              (if (= (get descriptor :aggregate-binding-count)
                     (+ (get descriptor :core-binding-count)
                        (get descriptor :lexical-binding-count)
                        (count definitions) (count externals)))
                (<= (get descriptor :aggregate-binding-count) 2440)
                false)
              false)
            false)
          false))
      false)
    false))

(defn sh07-b51-r6-c30-plan-coordinate?
  [row descriptor manifest-id expected-plan-id]
  (if (sh07-b51-r6-exact-keys?
       row #{:module-ordinal :module-source-id :plan-id :plan})
    (let [plan (get row :plan)]
      (if (map? plan)
        (if (= [(get row :module-ordinal)
                (get row :module-source-id) (get row :plan-id)
                (get plan :plan-id)
                (get plan :sh07-b51-module-source-id)
                (get plan :sh07-b51-link-manifest-id)
                (get (get plan :source) :sha256)
                (get (get plan :module) :module)]
               [(get descriptor :module-ordinal)
                (get descriptor :module-source-id) expected-plan-id
                expected-plan-id (get descriptor :module-source-id)
                manifest-id (get descriptor :source-sha256)
                (get descriptor :module)])
          (if (map? (get plan :compiler))
            (if (map? (get plan :functions)) true false)
            false)
          false)
        false))
    false))

(defn sh07-b51-r6-c30-index-unique [records field maximum]
  (if (vector? records)
    (if (<= (count records) maximum)
      (loop [remaining records values {}]
        (if (= (count remaining) 0)
          {:status :accepted :values values}
          (let [row (first remaining)
                key (get row field)]
            (if (contains? values key)
              {:status :rejected :reason :duplicate-index-coordinate}
              (recur (rest remaining) (assoc values key row))))))
      {:status :rejected :reason :index-bound})
    {:status :rejected :reason :index-shape}))

(defn sh07-b51-r6-c30-edge-indexes [descriptors plan-carriers]
  (if (if (vector? descriptors) (= (count descriptors) 7) false)
    (if (if (vector? plan-carriers) (= (count plan-carriers) 7) false)
      (let [plans
            (sh07-b51-r6-c30-index-unique
             plan-carriers :module-source-id 7)]
        (if (= (get plans :status) :accepted)
          (loop [remaining descriptors
                 descriptor-by-source {}
                 definitions-by-source {}
                 externals-by-source {}]
            (if (= (count remaining) 0)
              {:status :accepted
               :descriptor-by-source descriptor-by-source
               :definitions-by-source definitions-by-source
               :externals-by-source externals-by-source
               :plans-by-source (get plans :values)}
              (let [descriptor (first remaining)
                    source-id (get descriptor :module-source-id)
                    definition-rows (get descriptor :definitions)
                    descriptor-anchor
                    (sh07-b51-r6-find-one
                     descriptors :module-source-id source-id)
                    plan-anchor
                    (sh07-b51-r6-find-one
                     plan-carriers :module-source-id source-id)
                    definition-anchor
                    (sh07-b51-r6-find-one
                     definition-rows :name (get (first definition-rows) :name))
                    definitions
                    (sh07-b51-r6-c30-index-unique
                     definition-rows :name 2440)
                    externals
                    (sh07-b51-r6-c30-index-unique
                     (get descriptor :external-bindings) :symbol 2440)]
                (if (= [(get descriptor-anchor :count)
                        (get plan-anchor :count)
                        (get definition-anchor :count)]
                       [1 1 1])
                  (if (sh07-b51-r6-sha256-id? source-id)
                  (if (contains? descriptor-by-source source-id)
                    {:status :rejected
                     :reason :duplicate-module-source-id}
                    (if (= (get definitions :status) :accepted)
                      (if (= (get externals :status) :accepted)
                        (recur
                         (rest remaining)
                         (assoc descriptor-by-source source-id descriptor)
                         (assoc definitions-by-source source-id
                                (get definitions :values))
                         (assoc externals-by-source source-id
                                (get externals :values)))
                        externals)
                      definitions))
                  {:status :rejected
                   :reason :invalid-module-source-id})
                  {:status :rejected :reason :missing-index-anchor}))))
          plans))
      {:status :rejected :reason :plan-index-shape})
    {:status :rejected :reason :descriptor-index-shape}))

(defn sh07-b51-r6-c30-owner-edge [caller-owner callee-owner]
  (if (= caller-owner callee-owner)
    (if (= caller-owner :r1-producer) :producer-internal
      (if (= caller-owner :r6-independent-verifier) :root6-internal nil))
    (if (if (= caller-owner :r8-finalizer)
          (= callee-owner :r1-producer) false)
      :root8-to-producer-interface nil)))

(defn sh07-b51-r6-c30-manifest-edge?
  [edge ordinal indexes]
  (if (sh07-b51-r6-exact-keys?
       edge
       #{:ordinal :caller-module-source-id :caller-function
         :caller-function-source-hash :callsite-path
         :callee-module-source-id :callee-function
         :callee-function-source-hash :arity :owner-edge
         :authorization})
    (if (= (get edge :ordinal) ordinal)
      (if (sh07-b51-r6-c30-all-true?
           [(sh07-b51-r6-sha256-id?
             (get edge :caller-module-source-id))
            (symbol? (get edge :caller-function))
            (sh07-b51-r6-sha256-id?
             (get edge :caller-function-source-hash))
            (vector? (get edge :callsite-path))
            (sh07-b51-r6-c30-natural-vector?
             (get edge :callsite-path) (count (get edge :callsite-path)))
            (sh07-b51-r6-sha256-id?
             (get edge :callee-module-source-id))
            (symbol? (get edge :callee-function))
            (sh07-b51-r6-sha256-id?
             (get edge :callee-function-source-hash))
            (sh07-b51-r6-nonnegative-integer? (get edge :arity))
            (= (get edge :authorization)
               :authenticated-b51-namespace-external)])
        (let [caller-id (get edge :caller-module-source-id)
              callee-id (get edge :callee-module-source-id)
              caller (get (get indexes :descriptor-by-source) caller-id)
              callee (get (get indexes :descriptor-by-source) callee-id)
              caller-definition
              (get (get (get indexes :definitions-by-source) caller-id)
                   (get edge :caller-function))
              callee-definition
              (get (get (get indexes :definitions-by-source) callee-id)
                   (get edge :callee-function))
              external-value
              (get (get (get indexes :externals-by-source) caller-id)
                   (get edge :callee-function))
              expected-owner
              (sh07-b51-r6-c30-owner-edge
               (get caller :owner) (get callee :owner))]
          (if (sh07-b51-r6-c30-all-true?
               [(map? caller) (map? callee)
                (map? caller-definition) (map? callee-definition)
                (map? external-value)])
            (if (= expected-owner nil) false
              (= [(get edge :caller-function-source-hash)
                  (get edge :callee-function-source-hash)
                  (get edge :arity) (get edge :owner-edge)
                  (get external-value :callee-module-ordinal)
                  (get external-value :callee-module)
                  (get external-value :callee-source-sha256)
                  (get external-value :callee-definition-source-hash)
                  (get external-value :arity)
                  (get external-value :owner-edge)]
                 [(get caller-definition :source-hash)
                  (get callee-definition :source-hash)
                  (get callee-definition :arity)
                  expected-owner (get callee :module-ordinal)
                  (get callee :module) (get callee :source-sha256)
                  (get callee-definition :source-hash)
                  (get edge :arity) expected-owner]))
            false))
        false)
      false)
    false))

(defn sh07-b51-r6-c30-manifest?
  [manifest descriptors indexes expected-id]
  (if (sh07-b51-r6-exact-keys?
       manifest #{:artifact :schema-version :manifest-id
                  :module-source-ids :edges})
    (if (= [(get manifest :artifact) (get manifest :schema-version)
            (get manifest :manifest-id)]
           [:gravity/sh07-b51-link-manifest-v1 1 expected-id])
      (if (= (get manifest :module-source-ids)
             (loop [remaining descriptors values []]

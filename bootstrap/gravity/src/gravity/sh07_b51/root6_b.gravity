(defn sh07-b51-r6-linked-row-shape? [category row]
  (if (= category :roots)
    (sh07-b51-r6-exact-keys? row #{:root-ordinal :coordinate :arity})
    (if (= category :members)
      (sh07-b51-r6-exact-keys? row #{:member-ordinal :coordinate})
      (if (= category :functions)
        (sh07-b51-r6-exact-keys?
         row #{:member-ordinal :coordinate :definition-source-hash})
        (if (= category :local-runtime-call-edges)
          (sh07-b51-r6-exact-keys?
           row #{:edge-ordinal :caller :callee :arity
                 :source-callsite-ordinal})
          (if (= category :external-runtime-call-edges)
            (sh07-b51-r6-exact-keys?
             row #{:semantic-edge-ordinal :m1-edge-ordinal :manifest-id
                   :caller :callee :arity :owner-edge :route})
            (if (= category :referenced-builtins)
              (sh07-b51-r6-exact-keys?
               row #{:occurrence-ordinal :caller :builtin :arity
                     :compiler-internal? :source-callsite-ordinal})
              (if (= category :module-contracts)
                (sh07-b51-r6-exact-keys?
                 row #{:module-ordinal :module-source-id})
                false))))))))

(defn sh07-b51-r6-linked-module-census
  [descriptor category-result module-ordinal]
  (let [sources (get descriptor :module-source-descriptors)
        plans (get descriptor :module-plan-carriers)
        source (get sources module-ordinal)
        plan-row (get plans module-ordinal)
        reachable (get category-result :reachable)
        reachable-members
        (loop [remaining (get source :definitions) count-value 0]
          (if (= (count remaining) 0) count-value
            (recur
             (rest remaining)
             (if (contains? reachable (get (first remaining) :name))
               (+ count-value 1) count-value))))
        physical-local
        (loop [remaining (get source :definitions) count-value 0]
          (if (= (count remaining) 0) count-value
            (let [caller (get (first remaining) :name)
                  definition
                  (get (get (get plan-row :plan) :functions) caller)
                  calls
                  (sh07-b51-r6-linked-function-occurrences definition)
                  local-count
                  (loop [left (get calls :occurrences) result 0]
                    (if (= (count left) 0) result
                      (let [owner
                            (sh07-b51-r6-linked-function-owner
                             sources plans (get (first left) :function))]
                        (recur
                         (rest left)
                         (if (if (= (get owner :count) 1)
                               (= (get (get owner :value) :module-ordinal)
                                  module-ordinal) false)
                           (+ result 1) result)))))]
              (recur (rest remaining) (+ count-value local-count)))))
        external
        (loop [remaining (get (get descriptor :link-manifest) :edges)
               physical 0 reachable-count 0]
          (if (= (count remaining) 0)
            {:physical physical :reachable reachable-count}
            (let [edge (first remaining)
                  caller-owner
                  (sh07-b51-r6-linked-function-owner
                   sources plans (get edge :caller-function))
                  selected?
                  (if (= (get caller-owner :count) 1)
                    (= (get (get caller-owner :value) :module-ordinal)
                       module-ordinal) false)]
              (recur
               (rest remaining)
               (if selected? (+ physical 1) physical)
               (if (if selected?
                     (contains? reachable (get edge :caller-function)) false)
                 (+ reachable-count 1) reachable-count)))))
        builtin
        (loop [remaining (get source :builtin-calls) reachable-count 0]
          (if (= (count remaining) 0) reachable-count
            (recur
             (rest remaining)
             (if (contains? reachable (get (first remaining) :caller))
               (+ reachable-count 1) reachable-count))))]
    {:module-ordinal module-ordinal
     :module (get source :module)
     :logical-source-path (get source :logical-source-path)
     :owner (get source :owner)
     :source-byte-count (get source :source-byte-count)
     :source-sha256 (get source :source-sha256)
     :module-source-id (get source :module-source-id)
     :plan-id (get plan-row :plan-id)
     :physical-definition-count (count (get source :definitions))
     :reachable-definition-count reachable-members
     :physical-local-runtime-callsite-count physical-local
     :reachable-local-runtime-callsite-count
     (loop [remaining
            (get (get category-result :rows) :local-runtime-call-edges)
            result 0]
       (if (= (count remaining) 0) result
         (recur
          (rest remaining)
          (if (= (get (get (first remaining) :caller) :module-ordinal)
                 module-ordinal)
            (+ result 1) result))))
     :physical-external-runtime-callsite-count (get external :physical)
     :reachable-external-runtime-callsite-count (get external :reachable)
     :physical-referenced-builtin-occurrence-count
     (count (get source :builtin-calls))
     :reachable-referenced-builtin-occurrence-count builtin
     :core-binding-count (get source :core-binding-count)
     :lexical-binding-count (get source :lexical-binding-count)
     :external-binding-count (count (get source :external-bindings))
     :aggregate-binding-count (get source :aggregate-binding-count)}))

(defn sh07-b51-r6-linked-sum-module-field [module-rows key]
  (loop [remaining module-rows result 0]
    (if (= (count remaining) 0) result
      (recur (rest remaining)
             (+ result (get (first remaining) key))))))

(defn sh07-b51-r6-linked-physical-census
  [descriptor category-result]
  (let [module-rows
        (loop [ordinal 0 rows []]
          (if (= ordinal 7) rows
            (recur
             (+ ordinal 1)
             (conj rows
                   (sh07-b51-r6-linked-module-census
                    descriptor category-result ordinal)))))]
    {:module-count 7
     :module-censuses module-rows
     :physical-definition-count
     (sh07-b51-r6-linked-sum-module-field
      module-rows :physical-definition-count)
     :reachable-definition-count
     (sh07-b51-r6-linked-sum-module-field
      module-rows :reachable-definition-count)
     :physical-local-runtime-callsite-count
     (sh07-b51-r6-linked-sum-module-field
      module-rows :physical-local-runtime-callsite-count)
     :reachable-local-runtime-callsite-count
     (sh07-b51-r6-linked-sum-module-field
      module-rows :reachable-local-runtime-callsite-count)
     :physical-external-runtime-callsite-count
     (sh07-b51-r6-linked-sum-module-field
      module-rows :physical-external-runtime-callsite-count)
     :reachable-external-runtime-callsite-count
     (sh07-b51-r6-linked-sum-module-field
      module-rows :reachable-external-runtime-callsite-count)
     :physical-referenced-builtin-occurrence-count
     (sh07-b51-r6-linked-sum-module-field
      module-rows :physical-referenced-builtin-occurrence-count)
     :reachable-referenced-builtin-occurrence-count
     (sh07-b51-r6-linked-sum-module-field
      module-rows :reachable-referenced-builtin-occurrence-count)
     :semantic-row-count
     (loop [remaining (sh07-b51-r6-linked-category-order) result 0]
       (if (= (count remaining) 0) result
         (recur
          (rest remaining)
          (+ result
             (count (get (get category-result :rows) (first remaining)))))))
     :module-binding-occupancies
     (loop [remaining module-rows result []]
       (if (= (count remaining) 0) result
         (recur (rest remaining)
                (conj result
                      (get (first remaining) :aggregate-binding-count)))))
     :maximum-binding-occupancy
     (loop [remaining module-rows result 0]
       (if (= (count remaining) 0) result
         (recur
          (rest remaining)
          (if (> (get (first remaining) :aggregate-binding-count) result)
            (get (first remaining) :aggregate-binding-count) result))))
     :binding-ceiling 2440}))


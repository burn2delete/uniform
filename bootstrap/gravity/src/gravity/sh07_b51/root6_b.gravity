(defn sh07-b51-r6-v16-verification-authentic?
  [carrier requests outcome-kind]
  (let [verification (sh07-b51-r6-selected-preimage
                      requests :sh07-b51-v16-verification-semantic-id)
        structural (get (get (get carrier :predecessor-raw-outcome)
                             :structural-runner-observation) :returned)
        artifact (get structural :canonical-core-artifact)]

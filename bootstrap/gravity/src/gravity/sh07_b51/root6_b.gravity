               (sh07-b51-r6-reference-for-purpose
                requests :sh07-b51-v16-verification-semantic-id)
               :authorization :legacy-v16-equivalence)
        nil)
      (if (if (= (get no-form :status) :accepted)
            (< 0 (count (get no-form :binding-ids))) false)
        (if (sh07-b51-r6-b47-diagnostic-authentic?
             carrier request "C6-VERIFY" nil no-form-facts)
          (if (map? frontier)
            (assoc common
                   :domain :gravity/sh07-b51-predecessor-outcome-semantic-v18
                   :schema-version 18
                   :outcome-kind
                   :b51-vector-frontier-rejected-after-no-form-waiver

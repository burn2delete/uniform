(defn sh07-b51-r6-b47-diagnostic-authentic?
  [carrier request rule form facts]
  (let [raw (get carrier :predecessor-raw-outcome)
        direct-observation (get raw :direct-template-observation)
        structural-observation (get raw :structural-runner-observation)
        returned (get direct-observation :returned)
        diagnostic (get (get returned :diagnostics) 0)
        preimage (sh07-b51-r6-b47-diagnostic-preimage request rule form facts)
        source-span
        (if (map? (get preimage :semantic-source-span))
          (assoc (get preimage :semantic-source-span) :source
                 (get (get request :provenance) :actual-source-path))
          {:source (get (get request :provenance) :actual-source-path)})
        expected-facts
        {:reason (get facts :reason)
         :semantic-rule (get facts :semantic-rule)
         :rule-specific facts
         :source-revision-id (get (get request :lineage) :source-revision-id)
         :sh06-artifact-id (get (get request :lineage) :sh06-artifact-id)
         :fail-closed true}
        reference
        {:artifact :gravity/sh07-internal-digest-reference
         :schema-version 1 :ordinal 0 :authority :sh07-digest-resolver}
        expected-diagnostic
        {:artifact :gravity/sh07-core-diagnostic :rule rule :severity :error
         :stage :core-lowering :syntax-id (get preimage :syntax-id)
         :form-id (get preimage :form-id) :core-node-id nil
         :source-span source-span
         :generated-origin-chain (get preimage :generated-origin-chain)
         :namespace (get preimage :namespace) :profile (get preimage :profile)
         :target (get preimage :target)
         :lowering-rule :sh07-b47-function-call-recursion-products
         :facts expected-facts
         :remediation
         (if (= rule "C6-LOWERING-GAP")
           "Use only the declared bounded SH-07 core subset; defer unsupported lowering families to their owning slices."
           "Replay the Gravity template and bind every digest ordinal exactly once.")
         :diagnostic-id-request reference}
        request-record {:ordinal 0 :purpose :sh07-core-diagnostic-id
                        :preimage preimage}
        thrown (get structural-observation :thrown)]
    (if (sh07-b51-r6-exact-keys?
         raw #{:direct-template-observation :structural-runner-observation})
      (if (= (get direct-observation :entrypoint) 'sh07-build-core-template)
        (if (= (get direct-observation :request) request)
          (if (= (get direct-observation :thrown) nil)
            (if (if (sh07-b51-r6-exact-keys?
                     returned
                     #{:artifact :schema-version :status :core-template
                       :digest-requests :diagnostics :bounds :containment
                       :execution-boundary})
                  (if (= (get returned :status) :rejected)
                  (if (= (get returned :core-template) nil)
                    (if (= (get returned :digest-requests) [request-record])
                      (= (get returned :diagnostics) [expected-diagnostic]) false)
                    false) false) false)
              (if (= (get structural-observation :entrypoint)
                     'sh07-core-run-structural-request-for-test)
                (if (= (get structural-observation :request) request)
                  (if (= (get structural-observation :returned) nil)
                    (if (sh07-b51-r6-sha256-id?
                         (get thrown :diagnostic-id-request))
                      (= thrown
                         (assoc expected-diagnostic :diagnostic-id-request
                                (get thrown :diagnostic-id-request))) false)
                    false) false)
                false)
              false)
            false) false)
        false)
      false)))


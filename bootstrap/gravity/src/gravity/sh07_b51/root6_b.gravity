                                 :bundle-id})
                            (let [bundle-without-id
                                  (sh07-b51-r6-without-keys
                                   bundle #{:bundle-id})
                                  expected-bundle-id
                                  (sh07-b51-r6-c30-hash
                                   {:domain
                                    :gravity/sh07-b51-execution-bundle-id-v2
                                    :schema-version 1
                                    :bundle bundle-without-id})]
                              (if (= [(get bundle :artifact)
                                      (get bundle :schema-version)
                                      (get bundle :manifest-id)
                                      (get bundle :module-plans)
                                      (get bundle
                                           :compile-census-certificate-ids)
                                      (get bundle :bundle-id)]
                                     [:gravity/sh07-b51-execution-bundle-v2
                                      2 (get manifest :manifest-id)
                                      (get core :module-plans)
                                      certificate-ids expected-bundle-id])
                                (let [total
                                      (loop [remaining commitments value 0]
                                        (if (= (count remaining) 0) value
                                          (recur
                                           (rest remaining)

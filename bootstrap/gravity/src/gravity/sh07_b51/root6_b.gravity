(defn sh07-b51-r6-derived-outcome-preimage [carrier requests]
  (let [request (get carrier :authenticated-sh06-request)
        projection (sh07-b51-r6-project-sh07-core-request carrier)
        direct
        (if (= (get projection :status) :accepted)
          (get (get (get carrier :predecessor-raw-outcome)
                    :direct-template-observation) :returned)

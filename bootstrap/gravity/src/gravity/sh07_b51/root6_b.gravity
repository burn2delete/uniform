              (let [observed
                    (sh07-b51-r6-observe-scalar-bytes
                     current scalar-bytes maximum-scalar-bytes)]
                (if (= (get observed :status) :accepted)
                  (recur (rest frontier) (- remaining-nodes 1)
                         (get observed :observed-after))
                  observed)))))))))

(defn sh07-b51-r6-aggregate-bounds?
  [carrier requests products]
  (if (= (get (sh07-b51-r6-carrier-structure-preflight
               carrier 8388608 256 65536) :status) :accepted)
    (if (= (get (sh07-b51-r6-carrier-structure-preflight
                 requests 16777216 256 65536) :status) :accepted)
      (if (= (get (sh07-b51-r6-carrier-structure-preflight
                   products 16777216 256 65536) :status) :accepted)
        (if (= (get (sh07-b51-r6-carrier-census
                     (get carrier :authenticated-sh06-request)
                     8388608 256 65536 268435456) :status) :accepted)
        (if (= (get (sh07-b51-r6-carrier-census
                     (get carrier :predecessor-raw-outcome)
                     33554432 256 65536 1073741824) :status) :accepted)
        (if (= (get (sh07-b51-r6-carrier-census
                     products 16777216 256 65536 1073741824)
                    :status) :accepted)
        (if (= (get (sh07-b51-r6-carrier-census
                     requests 16777216 256 65536 1073741824)
                    :status) :accepted)
        (if (sh07-b51-r6-request-aggregate-bounds?
             (get carrier :authenticated-sh06-request))
          (if (sh07-b51-r6-vector-at-most? requests 65540)
            (if (sh07-b51-r6-product-family-bounds? products)
              (if (sh07-b51-r6-product-fragment-bounds?
                   (get carrier :authenticated-sh06-request)
                   requests products)
                (sh07-b51-r6-binding-resource-bounds? products) false)
              false)
            false)
          false)
        false)
        false)
        false)
        false)
        false)
      false)
    false))

(defn sh07-b51-r6-fixed-preimages-authentic?
  [carrier requests]
  (let [raw-request (get carrier :authenticated-sh06-request)
        implementation (sh07-b51-r6-selected-preimage
                        requests :sh07-b51-implementation-semantic-id)
        contract (sh07-b51-r6-selected-preimage
                  requests :sh07-b51-contract-semantic-id)
        same-request (sh07-b51-r6-selected-preimage
                      requests :sh07-b51-same-request-semantic-id)
        identity-row (sh07-b51-r6-purpose-request
                      requests :sh07-b51-core-identity-id)
        observation-row (sh07-b51-r6-purpose-request
                         requests :sh07-b51-predecessor-observation-id)
        identity (get (get identity-row :request) :preimage)
        observation (get (get observation-row :request) :preimage)
        provenance (sh07-b51-r6-selected-preimage
                    requests :sh07-b51-provenance-binding-id)]
    (if (= implementation
           {:domain
            :gravity/sh07-b51-linked-implementation-semantic-id-preimage-v3
            :schema-version 3
            :predecessor-executable-descriptor
            (get carrier :predecessor-executable-descriptor)
            :semantic-manifest
            (get (get carrier :v18-executable-descriptor)
                 :semantic-manifest)
            :semantic-root-hash
            (get (get carrier :v18-executable-descriptor)
                 :semantic-root-hash)})
      (if (= contract
             {:domain :gravity/sh07-b51-contract-semantic-id-preimage-v18
              :schema-version 18
              :predecessor-contract-carrier
              (get carrier :predecessor-contract-carrier)
              :retained-source-contract
              (get (get carrier :predecessor-contract-carrier)
                   :source-contract-forms)})
        (if (= same-request
               {:domain :gravity/sh07-b51-same-request-binding-v18
                :schema-version 18
                :request-artifact :gravity/sh07-authenticated-sh06-core-request
                :request-schema-version 15
                :request-semantic-id (get raw-request :projection-binding)
                :source-revision-id
                (get (get raw-request :lineage) :source-revision-id)
                :top-level-root-semantic-ids
                (get raw-request :top-level-form-ids)})
          (if (= (get identity :module) (get raw-request :module))
            (if (= (get identity :lineage) (get raw-request :lineage))
              (if (= (get identity :projection-binding)
                     (get raw-request :projection-binding))
                (if (= observation
                       {:domain
                        :gravity/sh07-b51-predecessor-observation-preimage-v18
                        :schema-version 18
                        :semantic-identity-id
                        (sh07-b51-r6-reference-for-purpose
                         requests :sh07-b51-core-identity-id)
                        :raw-adapter-request carrier})
                  (= provenance
                     {:domain
                      :gravity/sh07-b51-provenance-binding-preimage-v18
                      :schema-version 18
                      :semantic-identity-id
                      (sh07-b51-r6-reference-for-purpose
                       requests :sh07-b51-core-identity-id)
                      :observation-id
                      (sh07-b51-r6-reference-for-purpose
                       requests :sh07-b51-predecessor-observation-id)})
                  false)
                false)
              false)
            false)
          false)
        false)
      false)))


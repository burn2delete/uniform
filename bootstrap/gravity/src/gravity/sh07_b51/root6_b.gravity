(defn sh07-b51-r6-operation-calls [value depth remaining-nodes]
  (if (> depth 256)
    {:status :rejected :reason :closure-depth}
    (if (<= remaining-nodes 0)
      {:status :rejected :reason :closure-nodes}
      (if (map? value)
        (if (= (get value :op) :literal)
          {:status :accepted :calls [] :builtins []
           :remaining-nodes (- remaining-nodes 1)}
          (loop [remaining (vec value)
                 calls (if (= (get value :op) :function-call)
                         [(get value :function)] [])
                 builtins (if (= (get value :op) :builtin-call)
                            [(get value :function)] [])
                 budget (- remaining-nodes 1)]
            (if (= (count remaining) 0)
              {:status :accepted :calls calls :builtins builtins
               :remaining-nodes budget}
              (let [child
                    (sh07-b51-r6-operation-calls
                     (second (first remaining)) (+ depth 1) budget)]
                (if (= (get child :status) :accepted)
                  (recur (rest remaining)
                         (sh07-b51-r6-append calls (get child :calls))
                         (sh07-b51-r6-append builtins (get child :builtins))
                         (get child :remaining-nodes))
                  child)))))
        (if (vector? value)
          (loop [remaining value calls [] builtins []
                 budget (- remaining-nodes 1)]
            (if (= (count remaining) 0)
              {:status :accepted :calls calls :builtins builtins
               :remaining-nodes budget}
              (let [child
                    (sh07-b51-r6-operation-calls
                     (first remaining) (+ depth 1) budget)]
                (if (= (get child :status) :accepted)
                  (recur (rest remaining)
                         (sh07-b51-r6-append calls (get child :calls))
                         (sh07-b51-r6-append builtins (get child :builtins))
                         (get child :remaining-nodes))
                  child))))
          {:status :accepted :calls [] :builtins []
           :remaining-nodes (- remaining-nodes 1)})))))

(defn sh07-b51-r6-v18-closure-replay [semantic]
  (let [functions (get semantic :functions)
        roots (get semantic :roots)]
    (if (if (map? functions) (vector? roots) false)
      (loop [pending roots members #{} edges #{} builtins #{}

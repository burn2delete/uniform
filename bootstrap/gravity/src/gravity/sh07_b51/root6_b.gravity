(defn sh07-b51-r6-frontier-coordinate [request form-id]
  (loop [remaining (get request :fragment-manifest) found nil matches 0]
    (if (= (count remaining) 0)
      (if (= matches 1) found nil)
      (let [fragment (first remaining)
            position
            (loop [forms (get fragment :form-ids) ordinal 0 result nil hits 0]
              (if (= (count forms) 0) {:ordinal result :count hits}
                (recur (rest forms) (+ ordinal 1)
                       (if (= (first forms) form-id) ordinal result)
                       (if (= (first forms) form-id) (+ hits 1) hits))))]
        (recur
         (rest remaining)
         (if (= (get position :count) 1)
           {:fragment-id (get fragment :fragment-id)
            :form-ordinal (get position :ordinal)} found)
         (+ matches (get position :count)))))))

(defn sh07-b51-r6-first-vector-frontier [request]
  (let [indexes (sh07-b51-r6-index-request request)]
    (loop [frontier (get request :top-level-form-ids) visited #{}]
      (if (= (count frontier) 0) nil
        (let [form-id (first frontier)
              form (get (get indexes :forms-by-id) form-id)
              children (if (map? form) (get form :child-form-ids) [])
              operator
              (if (< 0 (count children))
                (get (get indexes :forms-by-id) (first children)) nil)
              owner
              (if (if (= (get operator :kind) :symbol)
                    (contains? #{'let 'loop} (get operator :value)) false)
                (get operator :value) nil)
              binding-vector
              (if (if (if (= owner nil) false true) (< 1 (count children)) false)
                (get (get indexes :forms-by-id) (get children 1)) nil)
              selected
              (if (= (get binding-vector :kind) :vector)
                (loop [remaining (get binding-vector :child-form-ids)
                       ordinal 0]
                  (if (= (count remaining) 0) nil
                    (let [pattern
                          (get (get indexes :forms-by-id) (first remaining))]
                      (if (= (get pattern :kind) :vector) pattern
                        (recur (rest (rest remaining)) (+ ordinal 1)))))) nil)]
          (if (map? selected)
            (let [coordinate
                  (sh07-b51-r6-frontier-coordinate
                   request (get selected :form-id))]
              (if (map? coordinate)
                {:owner owner :form selected :coordinate coordinate
                 :reason (if (= owner 'let)
                           :let-destructuring-deferred
                           :loop-destructuring-deferred)} nil))
            (if (contains? visited form-id) nil
              (recur (sh07-b51-r6-append (vec children) (rest frontier))
                     (conj visited form-id)))))))))


      (= verification
         {:domain :gravity/sh07-b51-v16-verification-semantic-v18
          :schema-version 18 :status :passed
          :template-verification (get structural :template-verification)
          :resolved-verification (get structural :resolved-verification)
          :resolved-v16-identity-preimage (get artifact :identity-preimage)})
      (= verification nil))))

(defn sh07-b51-r6-materialize-registered-path
  [value parent tokens resolved-prefix depth remaining-work]
  (if (> depth 256)
    {:status :rejected :reason :materialization-depth}
    (if (<= remaining-work 0)
      {:status :rejected :reason :materialization-work}
      (if (= (count tokens) 0)
        (if (sh07-b51-r6-internal-reference? value)
          (let [ordinal (get value :ordinal)]
            (if (< ordinal (count resolved-prefix))
              (let [resolved (get resolved-prefix ordinal)]
                (if (sh07-b51-r6-sha256-id? resolved)
                  {:status :accepted :value resolved
                   :remaining-work (- remaining-work 1)}
                  {:status :rejected :reason :resolved-id-shape}))
              {:status :rejected :reason :reference-prefix}))
          {:status :rejected :reason :registered-reference-shape})
        (let [token (first tokens) tail (rest tokens)
              conditional-slot?
              (if (= token :slot-ids)
                (= (first tail) :target-kind-loop) false)
              control-kind
              (if (= (first tail) :if-kind)
                (if (contains? #{:condition-node-id :branches} token) :if nil)
                (if (= (first tail) :do-kind)
                  (if (contains? #{:ordered-child-node-ids :result-policy} token)
                    :do nil)
                  nil))]
          (if (= token :each)
            (if (vector? value)
              (loop [remaining value result [] budget (- remaining-work 1)]
                (if (= (count remaining) 0)
                  {:status :accepted :value result :remaining-work budget}
                  (let [child
                        (sh07-b51-r6-materialize-registered-path
                         (first remaining) value tail resolved-prefix
                         (+ depth 1) budget)]
                    (if (= (get child :status) :accepted)
                      (recur (rest remaining)
                             (conj result (get child :value))
                             (get child :remaining-work))
                      child))))
              {:status :rejected :reason :registry-vector-required})
            (if (= token :optional)
              (if (= value nil)
                {:status :accepted :value nil
                 :remaining-work (- remaining-work 1)}
                (sh07-b51-r6-materialize-registered-path
                 value parent tail resolved-prefix (+ depth 1)
                 (- remaining-work 1)))
              (if (contains? #{:if-kind :do-kind :target-kind-loop} token)
                (let [expected
                      (if (= token :if-kind) :if
                        (if (= token :do-kind) :do :loop))
                      actual
                      (if (= token :target-kind-loop)
                        (get parent :target-kind) (get parent :kind))]
                  (if (= actual expected)
                    (sh07-b51-r6-materialize-registered-path
                     value parent tail resolved-prefix (+ depth 1)
                     (- remaining-work 1))
                    {:status :accepted :value value
                     :remaining-work (- remaining-work 1)}))
                (if (map? value)
                  (if (if conditional-slot?
                        (contains? #{:function :loop}
                                   (get value :target-kind))
                        (if (= control-kind nil) true
                          (contains? #{:if :do} (get value :kind))))
                    (if (if conditional-slot?
                          (= (get value :target-kind) :function)
                          (if (= control-kind nil) false
                            (if (= (get value :kind) control-kind) false true)))
                      ; Visit the selector to retain its depth/work charge while
                      ; leaving the skipped record whole, without field lookup.
                      (sh07-b51-r6-materialize-registered-path
                       value value tail resolved-prefix
                       (+ depth 1) (- remaining-work 1))
                      (if (contains? value token)
                        (let [child
                              (sh07-b51-r6-materialize-registered-path
                               (get value token) value tail resolved-prefix
                               (+ depth 1) (- remaining-work 1))]
                          (if (= (get child :status) :accepted)
                            {:status :accepted
                             :value (assoc value token (get child :value))
                             :remaining-work (get child :remaining-work)}
                            child))
                        {:status :rejected :reason :registry-key-missing}))
                    {:status :rejected :reason :registry-key-missing})
                  {:status :rejected :reason :registry-map-required})))))))))

(defn sh07-b51-r6-materialize-request-preimage
  [request outcome-kind resolved-prefix]
  (let [controlled
        (sh07-b51-r6-request-controlled-references request outcome-kind)
        source (get request :purpose)
        rows
        (loop [remaining (sh07-b51-r6-path-registry outcome-kind) result []]
          (if (= (count remaining) 0) result
            (recur (rest remaining)
                   (if (= (get (first remaining) :source-purpose) source)
                     (conj result (first remaining)) result))))]
    (if (= (get controlled :status) :accepted)
      (loop [remaining rows value (get request :preimage) budget 65540]
        (if (= (count remaining) 0)
          (let [residual
                (sh07-b51-r6-reference-occurrences
                 (sh07-b51-r6-reference-audit-value request value)
                 [] 0 budget)]
            (if (= (get residual :status) :accepted)
              (if (= (count (get residual :occurrences)) 0)
                {:status :accepted :value value
                 :remaining-work (get residual :remaining-nodes)}
                {:status :rejected :reason :unmaterialized-reference})
              residual))
          (let [materialized
                (sh07-b51-r6-materialize-registered-path
                 value nil (get (first remaining) :path)
                 resolved-prefix 0 budget)]
            (if (= (get materialized :status) :accepted)
              (recur (rest remaining) (get materialized :value)
                     (get materialized :remaining-work))
              materialized))))
      controlled)))

(defn sh07-b51-r6-core-from-identity [identity identity-id]
  (let [base
        {:artifact :gravity/sh07-b51-resolved-core-v18
         :schema-version 18
         :predecessor-outcome-kind (get identity :predecessor-outcome-kind)
         :same-request-semantic-id (get identity :same-request-semantic-id)
         :predecessor-authority-id (get identity :predecessor-authority-id)
         :module (get identity :module) :lineage (get identity :lineage)
         :projection-binding (get identity :projection-binding)
         :semantic-identity-id identity-id
         :diagnostics (get identity :diagnostics)}
        products (get identity :products)]
    (loop [remaining (sh07-b51-r6-product-key-order) result base]
      (if (= (count remaining) 0) result
        (recur (rest remaining)
               (assoc result (first remaining)
                      (get products (first remaining))))))))

(defn sh07-b51-r6-rebuild-supplied
  [carrier requests resolved-digests]
  (let [identity-row (sh07-b51-r6-purpose-request
                      requests :sh07-b51-core-identity-id)
        observation-row (sh07-b51-r6-purpose-request
                         requests :sh07-b51-predecessor-observation-id)
        provenance-row (sh07-b51-r6-purpose-request
                        requests :sh07-b51-provenance-binding-id)
        verifier-row (sh07-b51-r6-purpose-request
                      requests :sh07-b51-independent-verifier-binding-id)
        identity-request (get identity-row :request)
        identity-ordinal (get (get identity-row :request) :ordinal)
        observation-ordinal (get (get observation-row :request) :ordinal)
        provenance-ordinal (get (get provenance-row :request) :ordinal)
        verifier-ordinal (get (get verifier-row :request) :ordinal)
        outcome-kind
        (get (sh07-b51-r6-selected-preimage
              requests :sh07-b51-predecessor-outcome-semantic-id)
             :outcome-kind)
        identity-preimage (get identity-request :preimage)
        products (get identity-preimage :products)
        raw-request (get carrier :authenticated-sh06-request)
        outcome (sh07-b51-r6-selected-preimage
                 requests :sh07-b51-predecessor-outcome-semantic-id)
        identity
        (if (= [(get identity-row :count) (get observation-row :count)
                (get provenance-row :count) (get verifier-row :count)]
               [1 1 1 1])
          (if (vector? resolved-digests)
            (if (sh07-b51-r6-core-identity-preimage-authentic?
                 raw-request requests outcome products identity-preimage)
              (if (loop [ordinals [identity-ordinal observation-ordinal
                                   provenance-ordinal verifier-ordinal]]
                    (if (= (count ordinals) 0) true
                      (let [ordinal (first ordinals)]
                        (if (sh07-b51-r6-nonnegative-integer? ordinal)
                          (if (< ordinal (count resolved-digests))
                            (if (sh07-b51-r6-sha256-id?
                                 (get resolved-digests ordinal))
                              (recur (rest ordinals)) false)
                            false)
                          false))))
                (sh07-b51-r6-materialize-request-preimage
                 identity-request outcome-kind resolved-digests)
                {:status :rejected :reason :materialization-digest-shape})
              {:status :rejected :reason :identity-preimage})
            {:status :rejected :reason :resolved-digests-shape})
          {:status :rejected :reason :materialization-cardinality})]
    (if (= (get identity :status) :accepted)
      {:status :accepted
       :resolved-core
       (sh07-b51-r6-core-from-identity
        (get identity :value) (get resolved-digests identity-ordinal))
       :predecessor-observation
       {:artifact :gravity/sh07-b51-predecessor-observation-v18
        :schema-version 18
        :observation-id (get resolved-digests observation-ordinal)
        :preimage
        {:domain :gravity/sh07-b51-predecessor-observation-preimage-v18
         :schema-version 18
         :semantic-identity-id (get resolved-digests identity-ordinal)
         :raw-adapter-request carrier}}
       :provenance-binding
       {:artifact :gravity/sh07-b51-provenance-binding-v18
        :schema-version 18
        :provenance-binding-id (get resolved-digests provenance-ordinal)
        :preimage
        {:domain :gravity/sh07-b51-provenance-binding-preimage-v18
         :schema-version 18
         :semantic-identity-id (get resolved-digests identity-ordinal)
         :observation-id (get resolved-digests observation-ordinal)}}
       :identity-id (get resolved-digests identity-ordinal)
       :provenance-id (get resolved-digests provenance-ordinal)
       :verifier-id (get resolved-digests verifier-ordinal)}
      {:status :rejected :reason :identity-materialization})))

(defn sh07-b51-r6-dense-ordinal-field? [records key]
  (if (vector? records)
    (loop [remaining records ordinal 0]
      (if (= (count remaining) 0) true
        (if (= (get (first remaining) key) ordinal)
          (recur (rest remaining) (+ ordinal 1)) false)))
    false))

(defn sh07-b51-r6-linked-profile [value]
  (loop [frontier [[value 0]] nodes 0 maximum-depth 0 maximum-width 0
         maximum-scalar 0]
    (if (= (count frontier) 0)
      (let [c11-text (pr-str value)
            canonical
            (sh07-b51-r6-canonical-decoration value 0 1 #{})
            c11
            (sh07-b51-r6-observe-scalar-bytes
             c11-text 0 1073741824)
            canonical-bytes
            (if (= (get canonical :status) :decorated)
              (sh07-b51-r6-observe-scalar-bytes
               (get canonical :text) 0 1073741824)
              {:status :rejected})]
        (if (if (= (get c11 :status) :accepted)
              (= (get canonical-bytes :status) :accepted) false)
          {:status :accepted :nodes nodes :depth maximum-depth
           :width maximum-width :scalar maximum-scalar
           :c11 (get c11 :observed-after)
           :canonical-reader (get canonical-bytes :observed-after)}
          {:status :rejected :reason :linked-byte-census}))
      (let [entry (first frontier) current (get entry 0) depth (get entry 1)
            aggregate?
            (if (map? current) true
              (if (vector? current) true
                (if (set? current) true (list? current))))
            components
            (if aggregate? (sh07-b51-r6-carrier-components current) [])
            width (if aggregate? (count current) 0)
            scalar
            (if aggregate? {:status :accepted :observed-after 0}
              (sh07-b51-r6-observe-scalar-bytes current 0 1073741824))]
        (if (= (get scalar :status) :accepted)
          (recur
           (loop [remaining components result (rest frontier)]
             (if (= (count remaining) 0) result
               (recur (rest remaining)
                      (conj result [(first remaining) (+ depth 1)]))))
           (+ nodes 1)
           (if (> depth maximum-depth) depth maximum-depth)
           (if (> width maximum-width) width maximum-width)
           (if (> (get scalar :observed-after) maximum-scalar)
             (get scalar :observed-after) maximum-scalar))
          {:status :rejected :reason :linked-scalar-census})))))

(defn sh07-b51-r6-linked-within-bounds?
  [value maximum-nodes maximum-depth maximum-width maximum-scalar
   maximum-c11 maximum-canonical]
  (let [profile (sh07-b51-r6-linked-profile value)]
    (if (= (get profile :status) :accepted)
      (if (<= (get profile :nodes) maximum-nodes)
        (if (<= (get profile :depth) maximum-depth)
          (if (<= (get profile :width) maximum-width)
            (if (<= (get profile :scalar) maximum-scalar)
              (if (<= (get profile :c11) maximum-c11)
                (<= (get profile :canonical-reader) maximum-canonical)
                false)
              false)
            false)
          false)
        false)
      false)))

(defn sh07-b51-r6-linked-class-bounds? [class schedule value]
  (let [prefix
        (if (= class :row) :row
          (if (= class :leaf) :leaf
            (if (= class :fold) :fold
              (if (= class :commitment) :commitment :root))))
        nodes
        (get schedule
             (if (= prefix :row) :maximum-row-nodes
               (if (= prefix :leaf) :maximum-leaf-nodes
                 (if (= prefix :fold) :maximum-fold-nodes
                   (if (= prefix :commitment) :maximum-commitment-nodes
                     :maximum-root-nodes)))))
        depth
        (get schedule
             (if (= prefix :row) :maximum-row-depth
               (if (= prefix :leaf) :maximum-leaf-depth
                 (if (= prefix :fold) :maximum-fold-depth
                   (if (= prefix :commitment) :maximum-commitment-depth
                     :maximum-root-depth)))))
        width
        (get schedule
             (if (= prefix :row) :maximum-row-width
               (if (= prefix :leaf) :maximum-leaf-width
                 (if (= prefix :fold) :maximum-fold-width
                   (if (= prefix :commitment) :maximum-commitment-width
                     :maximum-root-width)))))
        scalar
        (get schedule
             (if (= prefix :row) :maximum-row-scalar-utf8
               (if (= prefix :leaf) :maximum-leaf-scalar-utf8
                 (if (= prefix :fold) :maximum-fold-scalar-utf8
                   (if (= prefix :commitment)
                     :maximum-commitment-scalar-utf8
                     :maximum-root-scalar-utf8)))))
        c11
        (get schedule
             (if (= prefix :row) :maximum-row-c11-bytes
               (if (= prefix :leaf) :maximum-leaf-c11-bytes
                 (if (= prefix :fold) :maximum-fold-c11-bytes
                   (if (= prefix :commitment) :maximum-commitment-c11-bytes
                     :maximum-root-c11-bytes)))))
        canonical
        (get schedule
             (if (= prefix :row) :maximum-row-canonical-reader-bytes
               (if (= prefix :leaf) :maximum-leaf-canonical-reader-bytes
                 (if (= prefix :fold) :maximum-fold-canonical-reader-bytes
                   (if (= prefix :commitment)
                     :maximum-commitment-canonical-reader-bytes
                     :maximum-root-canonical-reader-bytes)))))]
    (sh07-b51-r6-linked-within-bounds?
     value nodes depth width scalar c11 canonical)))

(defn sh07-b51-r6-linked-m0-shape? [value]
  (if (sh07-b51-r6-exact-keys?
       value
       #{:artifact :schema-version :module-source-id :module-ordinal :module
         :logical-source-path :owner :source-byte-count :source-sha256
         :profile :target :effects :capabilities :safety :definitions
         :exports :core-binding-count :lexical-binding-count
         :external-bindings :aggregate-binding-count :builtin-calls})
    (if (= [(get value :artifact) (get value :schema-version)
            (get value :profile) (get value :target)
            (get value :effects) (get value :capabilities)
            (get value :safety)]
           [:gravity/sh07-b51-module-source-v1 1 :meta :jvm #{} #{} :safe])
      (if (sh07-b51-r6-sha256-id? (get value :module-source-id))
        (if (sh07-b51-r6-sha256-id? (get value :source-sha256))
          (if (vector? (get value :definitions))
            (if (vector? (get value :external-bindings))
              (if (vector? (get value :builtin-calls))
                (= (get value :aggregate-binding-count)
                   (+ 262 (count (get value :definitions))
                      (get value :lexical-binding-count)
                      (count (get value :external-bindings))))
                false)
              false)
            false)
          false)
        false)
      false)
    false))

(defn sh07-b51-r6-linked-products-shape? [descriptor]
  (let [sources (get descriptor :module-source-descriptors)
        manifest (get descriptor :link-manifest)
        plans (get descriptor :module-plan-carriers)
        bundle (get descriptor :execution-bundle)]
    (if (if (vector? sources) (= (count sources) 7) false)
      (if (loop [remaining sources ordinal 0]
            (if (= (count remaining) 0) true
              (let [source (first remaining)]
                (if (sh07-b51-r6-linked-m0-shape? source)
                  (if (= (get source :module-ordinal) ordinal)
                    (if (<= (get source :aggregate-binding-count) 2440)
                      (recur (rest remaining) (+ ordinal 1)) false)
                    false)
                  false))))
        (if (sh07-b51-r6-exact-keys?
             manifest #{:artifact :schema-version :manifest-id
                        :module-source-ids :edges})
          (if (= [(get manifest :artifact) (get manifest :schema-version)

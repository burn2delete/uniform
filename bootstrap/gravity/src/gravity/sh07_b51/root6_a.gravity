         :external-binding-count :aggregate-binding-count})
    (if (= (get row :module-ordinal) ordinal)
      (if (symbol? (get row :module))
        (if (string? (get row :logical-source-path))
          (if (contains?
               #{:r1-producer :r6-independent-verifier :r8-finalizer}
               (get row :owner))
            (if (sh07-b51-r6-c30-all-true?
                 [(sh07-b51-r6-nonnegative-integer?
                   (get row :source-byte-count))
                  (sh07-b51-r6-sha256-id? (get row :source-sha256))
                  (sh07-b51-r6-sha256-id? (get row :module-source-id))
                  (sh07-b51-r6-sha256-id? (get row :plan-id))
                  (sh07-b51-r6-nonnegative-integer?
                   (get row :physical-definition-count))
                  (sh07-b51-r6-nonnegative-integer?
                   (get row :reachable-definition-count))
                  (sh07-b51-r6-nonnegative-integer?
                   (get row :physical-local-runtime-callsite-count))
                  (sh07-b51-r6-nonnegative-integer?
                   (get row :reachable-local-runtime-callsite-count))
                  (sh07-b51-r6-nonnegative-integer?
                   (get row :physical-external-runtime-callsite-count))
                  (sh07-b51-r6-nonnegative-integer?
                   (get row :reachable-external-runtime-callsite-count))
                  (sh07-b51-r6-nonnegative-integer?
                   (get row :physical-referenced-builtin-occurrence-count))
                  (sh07-b51-r6-nonnegative-integer?
                   (get row :reachable-referenced-builtin-occurrence-count))
                  (sh07-b51-r6-nonnegative-integer?
                   (get row :core-binding-count))
                  (sh07-b51-r6-nonnegative-integer?
                   (get row :lexical-binding-count))
                  (sh07-b51-r6-nonnegative-integer?
                   (get row :external-binding-count))
                  (sh07-b51-r6-nonnegative-integer?
                   (get row :aggregate-binding-count))])
              (if (sh07-b51-r6-c30-all-true?
                   [(<= (get row :reachable-definition-count)
                        (get row :physical-definition-count))
                    (<= (get row :reachable-local-runtime-callsite-count)
                        (get row :physical-local-runtime-callsite-count))
                    (<= (get row :reachable-external-runtime-callsite-count)
                        (get row :physical-external-runtime-callsite-count))
                    (<= (get row
                              :reachable-referenced-builtin-occurrence-count)
                        (get row
                             :physical-referenced-builtin-occurrence-count))
                    (= (get row :aggregate-binding-count)
                       (+ (get row :core-binding-count)
                          (get row :lexical-binding-count)
                          (get row :physical-definition-count)
                          (get row :external-binding-count)))
                    (<= (get row :aggregate-binding-count) 2440)])
                true false)
              false)
            false)
          false)
        false)
      false)
    false))

(defn sh07-b51-r6-c30-sum-row-field [rows field]
  (loop [remaining rows total 0]
    (if (= (count remaining) 0) total
      (recur (rest remaining) (+ total (get (first remaining) field))))))

(defn sh07-b51-r6-c30-maximum [values]
  (loop [remaining values maximum 0]
    (if (= (count remaining) 0) maximum
      (recur (rest remaining)
             (if (> (first remaining) maximum)
               (first remaining) maximum)))))

(defn sh07-b51-r6-c30-physical-census? [physical]
  (if (sh07-b51-r6-exact-keys?
       physical
       #{:module-count :module-censuses :physical-definition-count
         :reachable-definition-count
         :physical-local-runtime-callsite-count
         :reachable-local-runtime-callsite-count
         :physical-external-runtime-callsite-count
         :reachable-external-runtime-callsite-count
         :physical-referenced-builtin-occurrence-count
         :reachable-referenced-builtin-occurrence-count

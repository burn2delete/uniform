         :sign (if (get signed :negative?) :negative :positive)
         :digit-codepoints digits}))))

(defn sh07-b51-r6-decimal-inverse [text]
  (if (if (string? text) (if (<= 1 (count text)) (<= (count text) 261) false)
        false)
    (if (= text "0E+0")
      {:kind :decimal :sign 1 :coefficient [48] :decimal-power 0}
      (let [characters (vec text)
            negative? (= (first characters) \-)
            start (if negative? 1 0)
            first-digit (get characters start)
            e-selection
            (loop [remaining characters index 0 found nil matches 0]
              (if (= (count remaining) 0)
                {:index found :count matches}
                (recur (rest remaining) (+ index 1)
                       (if (= (first remaining) \E) index found)
                       (if (= (first remaining) \E) (+ matches 1) matches))))
            e-index (get e-selection :index)]
        (if (if (= (get e-selection :count) 1)
              (if (integer? e-index) (> e-index start) false) false)
          (if (if (char? first-digit)
                (let [digit (sh07-b51-r6-decimal-digit first-digit)]
                  (if (integer? digit) (<= 1 digit) false)) false)

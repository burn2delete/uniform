                           descriptors plan-carriers (get call :function))]
                      (recur
                       (rest left) (+ next 1)
                       (conj result
                             {:edge-ordinal next
                              :caller
                              (sh07-b51-r6-linked-coordinate
                               caller-descriptor plan-carriers caller)
                              :callee
                              (sh07-b51-r6-linked-coordinate
                               (get callee-owner :value) plan-carriers
                               (get call :function))
                              :arity (get call :arity)
                              :source-callsite-ordinal next})))))]

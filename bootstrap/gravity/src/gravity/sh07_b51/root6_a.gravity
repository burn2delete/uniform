(defn sh07-b51-r6-linked-plan-row [descriptor plan-carriers]
  (loop [remaining plan-carriers found nil found-count 0]
    (if (= (count remaining) 0)
      {:value found :count found-count}
      (let [candidate (first remaining)
            selected?
            (= (get candidate :module-ordinal)
               (get descriptor :module-ordinal))]
        (recur (rest remaining)
               (if selected? candidate found)
               (if selected? (+ found-count 1) found-count))))))

(defn sh07-b51-r6-linked-coordinate
  [descriptor plan-carriers function]
  (let [selected (sh07-b51-r6-linked-plan-row descriptor plan-carriers)
        carrier (get selected :value)]
    (if (= (get selected :count) 1)
      {:module-ordinal (get descriptor :module-ordinal)
       :module-source-id (get descriptor :module-source-id)
       :plan-id (get carrier :plan-id)
       :function function}
      nil)))

(defn sh07-b51-r6-linked-function-owner
  [descriptors plan-carriers function]
  (loop [remaining descriptors found nil found-count 0]
    (if (= (count remaining) 0)
      {:value found :count found-count}
      (let [descriptor (first remaining)
            selected (sh07-b51-r6-linked-plan-row descriptor plan-carriers)
            functions (get (get (get selected :value) :plan) :functions)
            present? (if (map? functions) (contains? functions function) false)]
        (recur (rest remaining)
               (if present? descriptor found)
               (if present? (+ found-count 1) found-count))))))

(defn sh07-b51-r6-linked-operation-occurrences
  [value path remaining-nodes]
  (if (<= remaining-nodes 0)
    {:status :rejected :reason :linked-operation-node-bound}
    (let [operation (if (map? value) (get value :op) nil)
          own
          (if (contains? #{:function-call :builtin-call} operation)
            [{:kind (if (= operation :function-call) :function :builtin)
              :function (get value :function)
              :arity (count (get value :args)) :path path
              :external-link (get value :external-link)
              :compiler-internal-caller
              (get value :compiler-internal-caller)
              :compiler-internal-provenance
              (get value :compiler-internal-provenance)}]
            [])
          children
          (if (vector? value) value
            (if (map? value)
              (if (contains? #{:function-call :builtin-call :recur :println}
                             operation)
                (get value :args)
                (if (= operation :do) (get value :body)
                  (if (= operation :if)
                    [(get value :test) (get value :then) (get value :else)]
                    (if (contains? #{:let :loop} operation)
                      (sh07-b51-r6-append
                       (loop [remaining (get value :bindings) result []]
                         (if (= (count remaining) 0) result
                           (recur (rest remaining)
                                  (conj result
                                        (get (first remaining) :expr)))))
                       (get value :body))
                      (if (contains? #{:vector-literal :set-literal} operation)
                        (get value :items)
                        (if (= operation :map-literal)
                          (loop [remaining (get value :entries) result []]
                            (if (= (count remaining) 0) result
                              (let [entry (first remaining)]
                                (recur (rest remaining)
                                       (conj (conj result (get entry :key))
                                             (get entry :value))))))
                          []))))))
              []))]
      (loop [remaining children index 0 occurrences own
             budget (- remaining-nodes 1)]
        (if (= (count remaining) 0)
          {:status :accepted :occurrences occurrences
           :remaining-nodes budget}
          (let [child
                (sh07-b51-r6-linked-operation-occurrences
                 (first remaining) (conj path index) budget)]
            (if (= (get child :status) :accepted)
              (recur (rest remaining) (+ index 1)
                     (sh07-b51-r6-append
                      occurrences (get child :occurrences))
                     (get child :remaining-nodes))
              child)))))))

(defn sh07-b51-r6-linked-function-occurrences [definition]
  (let [instructions (get definition :instructions)
        result
        (sh07-b51-r6-linked-operation-occurrences
         instructions [] 16777216)]
    result))

(defn sh07-b51-r6-linked-reachable
  [descriptors plan-carriers roots]
  (loop [pending
         (loop [remaining roots result []]
           (if (= (count remaining) 0) result
             (recur (rest remaining)
                    (conj result (get (first remaining) :function)))))
         seen #{} remaining-functions 65536 remaining-nodes 16777216]
    (if (= (count pending) 0)
      {:status :accepted :members seen}
      (if (<= remaining-functions 0)
        {:status :rejected :reason :linked-member-bound}
        (let [function (first pending)]
          (if (contains? seen function)
            (recur (rest pending) seen remaining-functions remaining-nodes)
            (let [owner
                  (sh07-b51-r6-linked-function-owner
                   descriptors plan-carriers function)
                  selected
                  (if (= (get owner :count) 1)
                    (sh07-b51-r6-linked-plan-row
                     (get owner :value) plan-carriers)
                    {:count 0})
                  definition
                  (get (get (get (get selected :value) :plan) :functions)
                       function)
                  calls (sh07-b51-r6-linked-function-occurrences definition)]
              (if (if (= (get owner :count) 1)
                    (= (get calls :status) :accepted) false)
                (recur
                 (sh07-b51-r6-append
                  (rest pending)
                  (loop [remaining (get calls :occurrences) result []]
                    (if (= (count remaining) 0) result
                      (let [call (first remaining)]
                        (recur
                         (rest remaining)
                         (if (= (get call :kind) :function)
                           (conj result (get call :function)) result))))))
                 (conj seen function) (- remaining-functions 1)
                 remaining-nodes)
                {:status :rejected :reason :linked-function-join}))))))))

(defn sh07-b51-r6-linked-ordered-members
  [descriptors reachable]
  (loop [remaining descriptors result []]
    (if (= (count remaining) 0) result
      (let [descriptor (first remaining)
            ordered
            (loop [definitions (get descriptor :definitions) rows []]
              (if (= (count definitions) 0) rows

; Attempt30 compact-certificate vocabulary.  These checks are intentionally
; organized around checker B's closed evidence object, rather than Root1's
; producer-oriented verifier or the retired runtime census traversal below.
(defn sh07-b51-r6-c30-report-id []
  "sha256:b105b395ba03a29e5bbd75ded681f21cdbb0375e4df73df9f9fbccf9aafa78db")

(defn sh07-b51-r6-c30-limits []
  {:certificate-maximum-nodes 2048
   :certificate-maximum-depth 12
   :certificate-maximum-width 35
   :certificate-maximum-collection-count 64
   :certificate-maximum-scalar-utf8 4096
   :certificate-maximum-canonical-reader-bytes 262144
   :outer-request-maximum-collection-count 65536
   :carrier-maximum-nodes 8388608
   :carrier-maximum-depth 256
   :carrier-maximum-width 65536
   :carrier-maximum-collection-count 524288
   :carrier-partition-maximum-collection-count 65536
   :carrier-maximum-scalar-utf8 65536
   :offline-transcript-maximum-nodes 262144
   :offline-transcript-maximum-records 262144
   :offline-transcript-maximum-call-rows 65536
   :offline-transcript-maximum-bytes 268435456})

(defn sh07-b51-r6-c30-hash [preimage]
  (sh07-b51-r6-replay-digests
   {:mode :attempt30-compact-hash :preimage preimage} []))

(defn sh07-b51-r6-c30-all-true? [values]
  (loop [remaining values]
    (if (= (count remaining) 0) true
      (if (= (first remaining) true)
        (recur (rest remaining)) false))))

(defn sh07-b51-r6-c30-git-id? [value]
  (if (string? value)
    (if (= (count value) 40)
      (sh07-b51-r6-lowercase-hex? (vec value)) false)
    false))

(defn sh07-b51-r6-c30-digest-vector? [value cardinality]
  (if (vector? value)
    (if (= (count value) cardinality)
      (loop [remaining value]
        (if (= (count remaining) 0) true
          (if (sh07-b51-r6-sha256-id? (first remaining))
            (recur (rest remaining)) false)))
      false)
    false))

(defn sh07-b51-r6-c30-natural-vector? [value cardinality]
  (if (vector? value)
    (if (= (count value) cardinality)
      (loop [remaining value]
        (if (= (count remaining) 0) true
          (if (sh07-b51-r6-nonnegative-integer? (first remaining))
            (recur (rest remaining)) false)))
      false)
    false))

(defn sh07-b51-r6-c30-components [value]
  (if (map? value)
    (loop [remaining (vec value) result []]
      (if (= (count remaining) 0) result
        (let [entry (first remaining)]
          (recur (rest remaining)
                 (conj (conj result (first entry)) (second entry))))))
    (vec value)))

(defn sh07-b51-r6-c30-certificate-profile [value]
  (loop [pending (list [value 0]) nodes 0 collections 0
         observed-depth 0 observed-width 0 observed-scalar 0]
    (if (= (count pending) 0)
      (let [measured
            (sh07-b51-r6-observe-scalar-bytes
             (pr-str value) 0 262144)]
        (if (= (get measured :status) :accepted)
          {:status :accepted :nodes nodes :depth observed-depth
           :width observed-width :collection-count collections
           :scalar-utf8 observed-scalar
           :canonical-reader-bytes (get measured :observed-after)}
          {:status :rejected :reason :certificate-canonical-byte-bound}))
      (if (>= nodes 2048)
        {:status :rejected :reason :certificate-node-bound}
        (let [entry (first pending) current (get entry 0)
              depth (get entry 1)
              aggregate?
              (if (map? current) true
                (if (vector? current) true
                  (if (set? current) true (list? current))))
              width (if aggregate? (count current) 0)
              next-collections (if aggregate? (+ collections 1) collections)
              measured
              (if aggregate?
                {:status :accepted :observed-after 0}
                (sh07-b51-r6-observe-scalar-bytes
                 (pr-str current) 0 4096))]
          (if (sh07-b51-r6-c30-all-true?
               [(<= depth 12) (<= width 35)
                (<= next-collections 64)
                (= (get measured :status) :accepted)])
            (recur
             (loop [remaining
                    (if aggregate?
                      (sh07-b51-r6-c30-components current) [])
                    result (rest pending)]
               (if (= (count remaining) 0) result
                 (recur (rest remaining)
                        (conj result [(first remaining) (+ depth 1)]))))
             (+ nodes 1) next-collections
             (if (> depth observed-depth) depth observed-depth)
             (if (> width observed-width) width observed-width)
             (if (> (get measured :observed-after) observed-scalar)
               (get measured :observed-after) observed-scalar))
            {:status :rejected :reason :certificate-profile-bound}))))))

(defn sh07-b51-r6-c30-certificate-preflight? [certificate]
  (let [profile (sh07-b51-r6-c30-certificate-profile certificate)]
    (if (= (get profile :status) :accepted)
      (sh07-b51-r6-c30-all-true?
       [(<= (get profile :nodes) 2048)
        (<= (get profile :depth) 12)
        (<= (get profile :width) 35)
        (<= (get profile :collection-count) 64)
        (<= (get profile :scalar-utf8) 4096)
        (<= (get profile :canonical-reader-bytes) 262144)])
      false)))


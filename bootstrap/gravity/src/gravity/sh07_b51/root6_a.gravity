             descriptor plan-carriers function)
            definition
            (loop [left (get descriptor :definitions) found nil]
              (if (= (count left) 0) found
                (if (= (get (first left) :name) function)
                  (first left) (recur (rest left) found))))]
        (if (if (= (get owner :count) 1) (map? definition) false)
          (recur
           (rest remaining) (+ ordinal 1)
           (conj member-rows
                 {:member-ordinal ordinal :coordinate coordinate})
           (conj function-rows
                 {:member-ordinal ordinal :coordinate coordinate
                  :definition-source-hash (get definition :source-hash)}))
          {:status :rejected :reason :linked-definition-join})))))

(defn sh07-b51-r6-linked-local-rows
  [descriptors plan-carriers members]
  (loop [remaining members ordinal 0 rows []]
    (if (= (count remaining) 0) rows
      (let [caller (first remaining)
            caller-owner
            (sh07-b51-r6-linked-function-owner
             descriptors plan-carriers caller)
            caller-descriptor (get caller-owner :value)

         commitments :external-runtime-call-edges)
        builtins
        (sh07-b51-r6-c30-category-count commitments :referenced-builtins)
        modules
        (sh07-b51-r6-c30-category-count commitments :module-contracts)
        total
        (loop [remaining commitments value 0]
          (if (= (count remaining) 0) value
            (recur (rest remaining)
                   (+ value (get (first remaining) :row-count)))))]
    (= [[(get roots :count) (get roots :value)]
        [(get members :count) (get members :value)]
        [(get functions :count) (get functions :value)]
        [(get locals :count) (get locals :value)]
        [(get externals :count) (get externals :value)]
        [(get builtins :count) (get builtins :value)]
        [(get modules :count) (get modules :value)] total]
       [[1 8]
        [1 (get physical :reachable-definition-count)]
        [1 (get physical :reachable-definition-count)]
        [1 (get physical :reachable-local-runtime-callsite-count)]
        [1 (get physical :reachable-external-runtime-callsite-count)]
        [1 (get physical
                :reachable-referenced-builtin-occurrence-count)]

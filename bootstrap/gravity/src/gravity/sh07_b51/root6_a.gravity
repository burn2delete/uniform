          (if (= (count remaining) 0)
            (if (get signed :negative?) (- 0 magnitude) magnitude)
            (recur (rest remaining)
                   (+ (* magnitude 10)
                      (sh07-b51-r6-decimal-digit
                       (sh07-b51-r6-decimal-character
                        (first remaining)))))))

(defn sh07-b51-r6-linked-external-rows
  [descriptors plan-carriers reachable manifest bundle]
  (loop [remaining (get manifest :edges) semantic-ordinal 0 rows []]
    (if (= (count remaining) 0) rows
      (let [edge (first remaining)
            caller (get edge :caller-function)]
        (if (contains? reachable caller)
          (let [caller-owner
                (sh07-b51-r6-linked-function-owner
                 descriptors plan-carriers caller)
                callee-owner
                (sh07-b51-r6-linked-function-owner
                 descriptors plan-carriers (get edge :callee-function))
                physical-ordinal (get edge :ordinal)
                route (get (get bundle :routes) physical-ordinal)]
            (if (if (= (get caller-owner :count) 1)
                  (= (get callee-owner :count) 1) false)
              (recur
               (rest remaining) (+ semantic-ordinal 1)
               (conj rows
                     {:semantic-edge-ordinal semantic-ordinal
                      :m1-edge-ordinal physical-ordinal
                      :manifest-id (get manifest :manifest-id)
                      :caller
                      (sh07-b51-r6-linked-coordinate
                       (get caller-owner :value) plan-carriers caller)
                      :callee
                      (sh07-b51-r6-linked-coordinate
                       (get callee-owner :value) plan-carriers
                       (get edge :callee-function))
                      :arity (get edge :arity)
                      :owner-edge (get edge :owner-edge)
                      :route route}))
              {:status :rejected :reason :linked-external-call-join}))
          (recur (rest remaining) semantic-ordinal rows))))))


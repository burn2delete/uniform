  [:roots :members :functions :local-runtime-call-edges
   :external-runtime-call-edges :referenced-builtins :module-contracts])

(defn sh07-b51-r6-c30-leaf-count [row-count]
  (if (= row-count 0) 1
    (get (sh07-b51-r6-divide-natural (+ row-count 15) 16) :quotient)))

(defn sh07-b51-r6-c30-fold-depth [leaf-count]
  (loop [children leaf-count level 1]
    (if (<= children 16) level
      (recur
       (get (sh07-b51-r6-divide-natural (+ children 15) 16) :quotient)
       (+ level 1)))))

(defn sh07-b51-r6-c30-category-commitments? [commitments]
  (if (if (vector? commitments) (= (count commitments) 7) false)
    (loop [remaining commitments categories (sh07-b51-r6-c30-category-order)
           total 0]
      (if (= (count remaining) 0)
        (if (= (count categories) 0) (<= total 65536) false)
        (let [commitment (first remaining)
              row-count (get commitment :row-count)
              leaf-count (get commitment :leaf-count)
              fold-depth (get commitment :fold-level-count)]
          (if (sh07-b51-r6-exact-keys?
               commitment
               #{:category :row-count :leaf-count
                 :fold-level-count :root-digest})
            (if (= (get commitment :category) (first categories))
              (if (sh07-b51-r6-c30-all-true?
                   [(sh07-b51-r6-nonnegative-integer? row-count)
                    (sh07-b51-r6-nonnegative-integer? leaf-count)
                    (sh07-b51-r6-nonnegative-integer? fold-depth)])
                (if (<= row-count 65536)
                  (if (= leaf-count
                         (sh07-b51-r6-c30-leaf-count row-count))
                    (if (= fold-depth
                           (sh07-b51-r6-c30-fold-depth leaf-count))
                      (if (<= fold-depth 3)
                        (if (sh07-b51-r6-sha256-id?
                             (get commitment :root-digest))
                          (recur (rest remaining) (rest categories)
                                 (+ total row-count))
                          false)
                        false)
                      false)
                    false)
                  false)
                false)
              false)
            false))))
    false))

(defn sh07-b51-r6-c30-module-census-row? [row ordinal]
  (if (sh07-b51-r6-exact-keys?
       row
       #{:module-ordinal :module :logical-source-path :owner
         :source-byte-count :source-sha256 :module-source-id :plan-id
         :physical-definition-count :reachable-definition-count
         :physical-local-runtime-callsite-count

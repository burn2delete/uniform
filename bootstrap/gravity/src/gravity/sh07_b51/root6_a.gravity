                      name (get definition :name)]
                  (recur
                   (rest definitions)
                   (if (contains? reachable name)
                     (sh07-b51-r6-decoration-insert
                      rows {:text (str name) :function name} false)
                     rows)))))]
        (recur
         (rest remaining)
         (sh07-b51-r6-append
          result
          (loop [rows ordered values []]
            (if (= (count rows) 0) values

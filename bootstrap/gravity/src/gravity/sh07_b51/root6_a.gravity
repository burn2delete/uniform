                  exponent-part (subvec characters (+ e-index 1))
                  dotted? (if (> (count mantissa) 1)
                            (= (get mantissa 1) \.) false)
                  coefficient-characters
                  (if dotted?
                    (sh07-b51-r6-append
                     [(first mantissa)] (subvec mantissa 2)) mantissa)
                  exponent-sign (first exponent-part)
                  exponent-characters (vec (rest exponent-part))
                  coefficient
                  (loop [remaining coefficient-characters result []]
                    (if (= (count remaining) 0) result
                      (let [digit (sh07-b51-r6-decimal-digit (first remaining))]
                        (if (integer? digit)
                          (recur (rest remaining)
                                 (conj result
                                       (sh07-b51-r6-decimal-codepoint digit)))
                          []))))
                  exponent-digits
                  (loop [remaining exponent-characters result []]
                    (if (= (count remaining) 0) result
                      (let [digit (sh07-b51-r6-decimal-digit (first remaining))]
                        (if (integer? digit)
                          (recur (rest remaining)
                                 (conj result
                                       (sh07-b51-r6-decimal-codepoint digit)))
                          []))))]
              (if (if (if (= (count mantissa) 1) true
                        (if dotted? (> (count mantissa) 2) false))
                    (if (= (count coefficient)
                           (count coefficient-characters))
                      (if (if (= (get coefficient (- (count coefficient) 1)) 48) false true)
                        (if (contains? #{\- \+} exponent-sign)
                          (if (= (count exponent-digits)
                                 (count exponent-characters))
                            (if (< 0 (count exponent-digits))
                              (if (= (count exponent-digits) 1) true
                                (if (= (first exponent-digits) 48) false true)) false)
                            false)
                          false)
                        false)
                      false)
                    false)
                (let [exponent
                      (sh07-b51-r6-decimal-signed
                       (= exponent-sign \-) exponent-digits)
                      adjustment
                      (sh07-b51-r6-decimal-signed
                       true
                       (sh07-b51-r6-decimal-natural-digits
                        (- (count coefficient) 1)))
                      key {:kind :decimal :sign (if negative? -1 1)
                           :coefficient coefficient
                           :decimal-power
                           (sh07-b51-r6-decimal-power-value
                            (sh07-b51-r6-decimal-signed-add
                             exponent adjustment))}]
                  (if (= (sh07-b51-r6-decimal-spell key) text) key
                    nil))
                nil))
            nil)
          nil)))
    nil))

(defn sh07-b51-r6-decimal-readable-rejection []

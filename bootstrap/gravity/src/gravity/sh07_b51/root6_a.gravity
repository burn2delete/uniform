(defn sh07-b51-r6-append [target values]
  (loop [remaining values result target]
    (if (= (count remaining) 0) result
      (recur (rest remaining) (conj result (first remaining))))))

(defn sh07-b51-r6-tail-after [values skip-count]
  (loop [remaining values ordinal 0 result []]
    (if (= (count remaining) 0) result
      (recur
       (rest remaining) (+ ordinal 1)
       (if (< ordinal skip-count)
         result
         (conj result (first remaining)))))))

(defn sh07-b51-r6-without-keys [source removal-keys]
  (loop [remaining (vec source) result {}]
    (if (= (count remaining) 0) result
      (let [entry (first remaining)
            key (first entry)]
        (recur
         (rest remaining)
         (if (contains? removal-keys key)
           result
           (assoc result key (second entry))))))))

(defn sh07-b51-r6-ordinals [cardinality]
  (loop [ordinal 0 result []]
    (if (= ordinal cardinality) result
      (recur (+ ordinal 1) (conj result ordinal)))))

(defn sh07-b51-r6-prefix-paths [prefix paths]
  (loop [remaining paths result []]
    (if (= (count remaining) 0) result
      (recur (rest remaining)
             (conj result
                   (sh07-b51-r6-append prefix (first remaining)))))))

(defn sh07-b51-r6-tier3-registry [outcome-kind]
  (let [source :sh07-b51-core-identity-id
        nonlegacy? (if (= outcome-kind :legacy-v16-accepted) false true)
        initial
        (sh07-b51-r6-append
         (sh07-b51-r6-path-rows
          source :sh07-b51-same-request-semantic-id
          [[:same-request-semantic-id]])
         (sh07-b51-r6-path-rows
          source :sh07-b51-predecessor-authority-id
          [[:predecessor-authority-id]]))
        with-noncore
        (loop [groups (sh07-b51-r6-tier3-noncore-groups) result initial]
          (if (= (count groups) 0) result
            (let [group (first groups)]
              (recur
               (rest groups)
               (sh07-b51-r6-append result
                     (sh07-b51-r6-path-rows
                      source (get group 0)
                      (sh07-b51-r6-prefix-paths
                       [:products] (get group 1))))))))
        with-core
        (if nonlegacy?
          (sh07-b51-r6-append
           (sh07-b51-r6-append with-noncore
                 (sh07-b51-r6-path-rows
                  source :sh07-b51-core-node-id
                  (sh07-b51-r6-prefix-paths
                   [:products] (sh07-b51-r6-tier3-core-paths))))
           (sh07-b51-r6-path-rows
            source :sh07-b51-core-node-id
            (sh07-b51-r6-prefix-paths
             [:products] (sh07-b51-r6-tier3-ordinary-core-paths))))
          with-noncore)]
    (if nonlegacy?
      (sh07-b51-r6-append
       with-core
       (sh07-b51-r6-path-rows
        source :sh07-b51-binding-slot-id
        (sh07-b51-r6-prefix-paths
         [:products]
         [[:lexical-bindings :each :slot-id]
          [:loop-bindings :each :slot-id]
          [:recur-targets :each :slot-ids :target-kind=:loop :each]])))
      (sh07-b51-r6-append
       (sh07-b51-r6-append
        with-core
        (sh07-b51-r6-path-rows
         source :sh07-b51-same-request-semantic-id
         [[:products :legacy-v16-equivalence :same-request-semantic-id]]))
       (sh07-b51-r6-append
        (sh07-b51-r6-path-rows
         source :sh07-b51-predecessor-outcome-semantic-id
         [[:products :legacy-v16-equivalence
           :predecessor-outcome-semantic-id]])
        (sh07-b51-r6-path-rows
         source :sh07-b51-v16-verification-semantic-id
         [[:products :legacy-v16-equivalence
           :v16-verification-semantic-id]]))))))

(defn sh07-b51-r6-nontier3-registry [outcome-kind]
  (let [legacy? (= outcome-kind :legacy-v16-accepted)
        core-paths
        (if legacy? [[:predecessor-authority-id]]
          [[:predecessor-authority-id] [:children :each]
           [:evaluated-children :each]])
        slot-paths
        (if legacy? [[:predecessor-authority-id]]
          [[:predecessor-authority-id] [:owner-core-node-id]
           [:initializer-core-node-id]])
        runtime-paths
        (if legacy?
          [[:predecessor-authority-id] [:slot-id] [:extraction-id]]
          [[:predecessor-authority-id] [:slot-id] [:extraction-id]
           [:recur-coordinate :optional :recur-core-node-id]])
        publication-paths
        (sh07-b51-r6-append
         [[:predecessor-authority-id] [:slot-id :optional]
          [:slot-ids :each] [:projection-ids :each]
          [:projection-id-vectors :each :each]
          [:required-check-ids :each]
          [:required-check-id-vectors :each :each]
          [:product-node-ids :each]
          [:product-node-id-vectors :each :each]]
         (if legacy? []
           [[:recur-coordinate :optional :recur-core-node-id]]))
        recur-paths
        (sh07-b51-r6-append
         [[:predecessor-authority-id] [:commit-publication-id]
          [:slot-ids :each] [:extraction-id-vectors :each :each]
          [:required-check-id-vectors :each :each]
          [:projection-id-vectors :each :each]]
         (if legacy? []
           [[:loop-core-node-id] [:recur-core-node-id]
            [:target-loop-core-node-id] [:argument-node-ids :each]]))
        groups
        [[:sh07-b51-predecessor-outcome-semantic-id
          :sh07-b51-implementation-semantic-id
          [[:implementation-semantic-id]]]
         [:sh07-b51-predecessor-outcome-semantic-id
          :sh07-b51-contract-semantic-id [[:contract-semantic-id]]]
         [:sh07-b51-predecessor-outcome-semantic-id
          :sh07-b51-same-request-semantic-id
          [[:same-request-semantic-id]]]
         [:sh07-b51-predecessor-authority-id
          :sh07-b51-implementation-semantic-id
          [[:implementation-semantic-id]]]
         [:sh07-b51-predecessor-authority-id
          :sh07-b51-contract-semantic-id [[:contract-semantic-id]]]
         [:sh07-b51-predecessor-authority-id
          :sh07-b51-same-request-semantic-id
          [[:same-request-semantic-id]]]
         [:sh07-b51-predecessor-authority-id
          :sh07-b51-predecessor-outcome-semantic-id
          [[:outcome-semantic-id]]]
         [:sh07-b51-core-node-id :sh07-b51-predecessor-authority-id
          [[:predecessor-authority-id]]]
         [:sh07-b51-core-node-id :sh07-b51-core-node-id
          (vec (rest core-paths))]
         [:sh07-b51-product-node-id :sh07-b51-predecessor-authority-id
          [[:predecessor-authority-id]]]
         [:sh07-b51-binding-slot-id :sh07-b51-predecessor-authority-id
          [[:predecessor-authority-id]]]
         [:sh07-b51-binding-slot-id :sh07-b51-core-node-id
          (vec (rest slot-paths))]
         [:sh07-b51-binding-extraction-id
          :sh07-b51-predecessor-authority-id [[:predecessor-authority-id]]]
         [:sh07-b51-binding-extraction-id :sh07-b51-binding-slot-id
          [[:slot-id]]]
         [:sh07-b51-runtime-check-id :sh07-b51-predecessor-authority-id
          [[:predecessor-authority-id]]]
         [:sh07-b51-runtime-check-id :sh07-b51-binding-slot-id [[:slot-id]]]
         [:sh07-b51-runtime-check-id :sh07-b51-binding-extraction-id
          [[:extraction-id]]]
         [:sh07-b51-runtime-check-id :sh07-b51-core-node-id
          (sh07-b51-r6-tail-after runtime-paths 3)]
         [:sh07-b51-publication-event-id
          :sh07-b51-predecessor-authority-id [[:predecessor-authority-id]]]
         [:sh07-b51-publication-event-id :sh07-b51-binding-slot-id
          [[:slot-id :optional] [:slot-ids :each]]]
         [:sh07-b51-publication-event-id :sh07-b51-product-node-id
          [[:projection-ids :each] [:projection-id-vectors :each :each]
           [:product-node-ids :each] [:product-node-id-vectors :each :each]]]
         [:sh07-b51-publication-event-id :sh07-b51-runtime-check-id
          [[:required-check-ids :each]
           [:required-check-id-vectors :each :each]]]
         [:sh07-b51-publication-event-id :sh07-b51-core-node-id
          (sh07-b51-r6-tail-after publication-paths 9)]
         [:sh07-b51-recur-slot-mapping-id
          :sh07-b51-predecessor-authority-id [[:predecessor-authority-id]]]
         [:sh07-b51-recur-slot-mapping-id
          :sh07-b51-publication-event-id [[:commit-publication-id]]]
         [:sh07-b51-recur-slot-mapping-id :sh07-b51-binding-slot-id
          [[:slot-ids :each]]]
         [:sh07-b51-recur-slot-mapping-id
          :sh07-b51-binding-extraction-id
          [[:extraction-id-vectors :each :each]]]
         [:sh07-b51-recur-slot-mapping-id :sh07-b51-runtime-check-id
          [[:required-check-id-vectors :each :each]]]
         [:sh07-b51-recur-slot-mapping-id :sh07-b51-product-node-id
          [[:projection-id-vectors :each :each]]]
         [:sh07-b51-recur-slot-mapping-id :sh07-b51-core-node-id
          (sh07-b51-r6-tail-after recur-paths 6)]
         [:sh07-b51-slot-extraction-transcript-id
          :sh07-b51-predecessor-authority-id [[:predecessor-authority-id]]]
         [:sh07-b51-slot-extraction-transcript-id
          :sh07-b51-same-request-semantic-id [[:same-request-semantic-id]]]
         [:sh07-b51-slot-extraction-transcript-id
          :sh07-b51-binding-slot-id [[:slot-ids :each]]]
         [:sh07-b51-slot-extraction-transcript-id
          :sh07-b51-binding-extraction-id [[:extraction-ids :each]]]
         [:sh07-b51-slot-extraction-transcript-id
          :sh07-b51-runtime-check-id [[:runtime-check-ids :each]]]
         [:sh07-b51-slot-extraction-transcript-id
          :sh07-b51-publication-event-id [[:publication-event-ids :each]]]
         [:sh07-b51-slot-extraction-transcript-id
          :sh07-b51-recur-slot-mapping-id [[:recur-slot-mapping-ids :each]]]
         [:sh07-b51-predecessor-observation-id :sh07-b51-core-identity-id
          [[:semantic-identity-id]]]
         [:sh07-b51-provenance-binding-id :sh07-b51-core-identity-id
          [[:semantic-identity-id]]]
         [:sh07-b51-provenance-binding-id
          :sh07-b51-predecessor-observation-id [[:observation-id]]]
         [:sh07-b51-independent-verifier-binding-id
          :sh07-b51-core-identity-id [[:semantic-identity-id]]]
         [:sh07-b51-independent-verifier-binding-id
          :sh07-b51-provenance-binding-id [[:provenance-binding-id]]]
         [:sh07-b51-final-artifact-binding-id :sh07-b51-core-identity-id
          [[:semantic-identity-id]]]
         [:sh07-b51-final-artifact-binding-id
          :sh07-b51-provenance-binding-id [[:provenance-binding-id]]]
         [:sh07-b51-final-artifact-binding-id
          :sh07-b51-independent-verifier-binding-id
          [[:independent-verifier-binding-id]]]]
        with-legacy-outcome
        (if legacy?
          (conj groups
                [:sh07-b51-predecessor-outcome-semantic-id
                 :sh07-b51-v16-verification-semantic-id
                 [[:v16-verification-semantic-id]]])
          groups)]
    (loop [remaining with-legacy-outcome result []]
      (if (= (count remaining) 0) result
        (let [group (first remaining)]
          (recur (rest remaining)
                 (sh07-b51-r6-append result
                       (sh07-b51-r6-path-rows
                        (get group 0) (get group 1) (get group 2)))))))))

(defn sh07-b51-r6-path-registry [outcome-kind]
  (if (sh07-b51-r6-outcome-kind? outcome-kind)
    (sh07-b51-r6-append (sh07-b51-r6-nontier3-registry outcome-kind)
          (sh07-b51-r6-tier3-registry outcome-kind)) nil))

(defn sh07-b51-r6-controlled-path-count [outcome-kind]
  (let [registry (sh07-b51-r6-path-registry outcome-kind)]
    (if (vector? registry) (count registry) nil)))


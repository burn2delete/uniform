         :maximum-binding-occupancy :binding-ceiling})
    (let [rows (get physical :module-censuses)
          occupancies (get physical :module-binding-occupancies)]
      (if (= (get physical :module-count) 7)
        (if (if (vector? rows) (= (count rows) 7) false)
          (if (loop [remaining rows ordinal 0]
                (if (= (count remaining) 0) true
                  (if (sh07-b51-r6-c30-module-census-row?
                       (first remaining) ordinal)
                    (recur (rest remaining) (+ ordinal 1)) false)))
            (if (= occupancies
                   (loop [remaining rows values []]
                     (if (= (count remaining) 0) values
                       (recur
                        (rest remaining)
                        (conj values
                              (get (first remaining)
                                   :aggregate-binding-count))))))
              (if (= [(get physical :maximum-binding-occupancy)
                      (get physical :binding-ceiling)]
                     [(sh07-b51-r6-c30-maximum occupancies) 2440])
                (if (<= (get physical :maximum-binding-occupancy) 2440)
                  (= [(get physical :physical-definition-count)
                      (get physical :reachable-definition-count)
                      (get physical :physical-local-runtime-callsite-count)
                      (get physical :reachable-local-runtime-callsite-count)
                      (get physical :physical-external-runtime-callsite-count)
                      (get physical :reachable-external-runtime-callsite-count)
                      (get physical
                           :physical-referenced-builtin-occurrence-count)
                      (get physical
                           :reachable-referenced-builtin-occurrence-count)]
                     [(sh07-b51-r6-c30-sum-row-field
                       rows :physical-definition-count)
                      (sh07-b51-r6-c30-sum-row-field
                       rows :reachable-definition-count)
                      (sh07-b51-r6-c30-sum-row-field
                       rows :physical-local-runtime-callsite-count)
                      (sh07-b51-r6-c30-sum-row-field
                       rows :reachable-local-runtime-callsite-count)
                      (sh07-b51-r6-c30-sum-row-field
                       rows :physical-external-runtime-callsite-count)
                      (sh07-b51-r6-c30-sum-row-field
                       rows :reachable-external-runtime-callsite-count)
                      (sh07-b51-r6-c30-sum-row-field
                       rows :physical-referenced-builtin-occurrence-count)
                      (sh07-b51-r6-c30-sum-row-field
                       rows :reachable-referenced-builtin-occurrence-count)])
                  false)
                false)
              false)
            false)
          false)
        false))
    false))

(defn sh07-b51-r6-c30-category-count [commitments category]
  (loop [remaining commitments found nil matches 0]
    (if (= (count remaining) 0)
      {:value found :count matches}
      (let [row (first remaining)
            selected? (= (get row :category) category)]
        (recur (rest remaining)
               (if selected? (get row :row-count) found)
               (if selected? (+ matches 1) matches))))))

(defn sh07-b51-r6-c30-category-physical-joins?
  [commitments physical]
  (let [roots (sh07-b51-r6-c30-category-count commitments :roots)
        members (sh07-b51-r6-c30-category-count commitments :members)
        functions (sh07-b51-r6-c30-category-count commitments :functions)
        locals
        (sh07-b51-r6-c30-category-count
         commitments :local-runtime-call-edges)
        externals

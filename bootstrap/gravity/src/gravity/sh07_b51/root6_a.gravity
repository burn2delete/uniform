                    (if (= [(get literal-record :raw)
                            (get deferred-record :raw)
                            (get deferred-record :kind)
                            (get deferred-record :value)
                            (get deferred-record :span)]
                           [text text :decimal (get form-record :value)
                            (get form-record :span)])
                      (let [key (sh07-b51-r6-decimal-inverse text)]
                        (if (sh07-b51-r6-decimal-key-authentic? key)
                          (if (= (get form-record :value)
                                 (get literal-record :decoded))
                            {:status :normalization-deferred

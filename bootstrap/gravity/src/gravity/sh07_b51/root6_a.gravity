                             :semantic-key key}
                            (sh07-b51-r6-decimal-readable-rejection))
                          (sh07-b51-r6-decimal-readable-rejection)))
                      (sh07-b51-r6-decimal-readable-rejection))
                    (sh07-b51-r6-decimal-readable-rejection))
                  (sh07-b51-r6-decimal-readable-rejection))))
            (sh07-b51-r6-decimal-readable-rejection))
          (sh07-b51-r6-decimal-readable-rejection))
        (sh07-b51-r6-decimal-readable-rejection))
      (sh07-b51-r6-decimal-readable-rejection)))
    (sh07-b51-r6-decimal-readable-rejection)))

(defn sh07-b51-r6-decimal-occurrence-canonical
  [decimal-evidence value]
  (if (map? decimal-evidence)
    (let [c2-artifact (get decimal-evidence :c2-artifact)
          projection (get decimal-evidence :projection)
          selected
          (loop [remaining (get projection :occurrences)
                 key nil text nil matches 0 valid? true]
            (if (= (count remaining) 0)
              {:key key :text text :count matches :valid? valid?}
              (let [occurrence (first remaining)
                    entry (get occurrence :semantic-value-entry)
                    literal
                    (sh07-b51-r6-find-one
                     (get c2-artifact :literal-decoding-records)
                     :form-id (get occurrence :adapted-form-id))
                    form
                    (sh07-b51-r6-find-one
                     (get c2-artifact :form-tree)
                     :form-id (get occurrence :adapted-form-id))
                    candidate-key (get entry :semantic-key)
                    candidate-text
                    (if (sh07-b51-r6-decimal-key-authentic? candidate-key)
                      (sh07-b51-r6-decimal-spell candidate-key) nil)
                    matches-value?
                    (if (= [(get literal :count) (get form :count)] [1 1])
                      (= (get (get literal :value) :decoded) value) false)
                    occurrence-valid?
                    (if matches-value?
                      (if (string? candidate-text)
                        (if (= (get (get form :value) :semantic-key)
                               candidate-key)
                          (if (= key nil) true (= key candidate-key)) false)
                        false)
                      true)]
                (recur (rest remaining)
                       (if matches-value? candidate-key key)
                       (if matches-value? candidate-text text)
                       (if matches-value? (+ matches 1) matches)
                       (if occurrence-valid? valid? false))))) ]
      (if (if (sh07-b51-r6-decimal-projection-authentic? projection)
            (sh07-b51-r6-decimal-projection-bound?
             c2-artifact projection)
            false)
        (if (if (get selected :valid?) (< 0 (get selected :count)) false)
          (let [inverse
                (sh07-b51-r6-decimal-inverse (get selected :text))]
            (if (if (map? inverse) (= inverse (get selected :key)) false)
              {:status :accepted :text (get selected :text)
               :semantic-key inverse :c2-branch :occurrence-authenticated}
              {:status :rejected
               :reason :unsupported-decimal-readable-spelling}))
          {:status :rejected
           :reason :unsupported-decimal-readable-spelling})
        {:status :rejected
         :reason :unsupported-decimal-readable-spelling}))
    {:status :rejected :reason :unsupported-decimal-readable-spelling}))

(defn sh07-b51-r6-decimal-components [raw]
  (if (if (string? raw) (< 0 (count raw)) false)
    (if (<= (count raw) 4096)
      (loop [index 0 negative? false decimal? false exponent? false
             exponent-negative? false exponent-digits 0 exponent 0
             fractional 0 mantissa-digits 0 digits ""]
        (if (= index (count raw))
          (if (if (< 0 mantissa-digits)
                (if exponent? (< 0 exponent-digits) true) false)
            (let [canonical
                  (loop [position 0 started? false result ""]
                    (if (= position (count digits))
                      (if (= result "") "0" result)
                      (let [character (get digits position)]
                        (if (if (= started? false) (= character \0) false)
                          (recur (+ position 1) false result)
                          (recur (+ position 1) true
                                 (str result character))))))
                  signed-exponent
                  (if exponent-negative? (- 0 exponent) exponent)
                  scale (- fractional signed-exponent)]
              (if (<= (if (< scale 0) (- 0 scale) scale) 65536)
                {:status :accepted
                 :unscaled-value
                 (if (if negative? (if (= canonical "0") false true) false)
                   (str "-" canonical) canonical)
                 :scale scale}
                {:status :rejected :reason :projection-decimal-scale}))
            {:status :rejected :reason :projection-decimal-grammar})
          (let [character (get raw index)
                digit (sh07-b51-r6-decimal-digit character)]
            (if (= index 0)
              (if (contains? #{\- \+} character)
                (recur (+ index 1) (= character \-) decimal? exponent?
                       exponent-negative? exponent-digits exponent fractional
                       mantissa-digits digits)
                (if (= digit nil)
                  (if (= character \.)
                    (recur (+ index 1) negative? true exponent?
                           exponent-negative? exponent-digits exponent
                           fractional mantissa-digits digits)
                    {:status :rejected
                     :reason :projection-decimal-character})
                  (recur (+ index 1) negative? decimal? exponent?
                         exponent-negative? exponent-digits exponent
                         fractional (+ mantissa-digits 1)
                         (str digits character))))
              (if (= digit nil)
                (if (if (= character \.)
                      (if (= decimal? false) (= exponent? false) false)
                      false)
                  (recur (+ index 1) negative? true exponent?
                         exponent-negative? exponent-digits exponent fractional
                         mantissa-digits digits)
                  (if (if (contains? #{\e \E} character)
                        (= exponent? false) false)
                    (recur (+ index 1) negative? decimal? true false 0 0
                           fractional mantissa-digits digits)
                    (if (if exponent?
                          (if (= exponent-digits 0)
                            (contains? #{\- \+} character) false)
                          false)
                      (recur (+ index 1) negative? decimal? exponent?
                             (= character \-) exponent-digits exponent
                             fractional mantissa-digits digits)
                      {:status :rejected
                       :reason :projection-decimal-character})))
                (if exponent?
                  (recur (+ index 1) negative? decimal? exponent?
                         exponent-negative? (+ exponent-digits 1)
                         (+ (* exponent 10) digit) fractional
                         mantissa-digits digits)
                  (recur (+ index 1) negative? decimal? exponent?
                         exponent-negative? exponent-digits exponent
                         (if decimal? (+ fractional 1) fractional)
                         (+ mantissa-digits 1)
                         (str digits character))))))))
      {:status :rejected :reason :projection-decimal-length})
    {:status :rejected :reason :projection-decimal-raw}))

(defn sh07-b51-r6-decimal-projection-authentic? [projection]
  (if (= (set (keys projection))
         #{:artifact :schema-version :projection-id :reader-result-id
           :semantic-value-table-id :adapted-source-unit-id
           :adapted-token-stream-id :adapted-form-tree-id
           :token-id-projection-id :form-id-projection-id
           :occurrence-count :occurrences})
    (if (= [(get projection :artifact) (get projection :schema-version)]
           [:gravity/sh03-c2-decimal-occurrence-projection 1])
      (let [occurrences (get projection :occurrences)
            checked
            (if (vector? occurrences)
              (loop [remaining occurrences ordinal 0
                     raw-values #{} raw-forms #{} raw-tokens #{}]
                (if (= (count remaining) 0) true
                  (let [occurrence (first remaining)
                        entry (get occurrence :semantic-value-entry)
                        ids [(get entry :value-id) (get entry :form-id)
                             (get entry :token-id)
                             (get occurrence :adapted-form-id)
                             (get occurrence :adapted-token-id)]]
                    (if (= (set (keys occurrence))
                           #{:ordinal :semantic-value-entry
                             :adapted-form-id :adapted-token-id})
                      (if (= (get occurrence :ordinal) ordinal)
                        (if (= (set (keys entry))
                               #{:artifact :schema-version :value-id
                                 :form-id :token-id :kind :descriptor
                                 :semantic-key})
                          (if (= [(get entry :artifact)
                                  (get entry :schema-version)
                                  (get entry :kind)]
                                 [:gravity/semantic-value 1 :decimal])
                            (if (loop [left ids]
                                  (if (= (count left) 0) true
                                    (if (sh07-b51-r6-sha256-id? (first left))
                                      (recur (rest left)) false)))
                              (if (if (contains? raw-values (get ids 0)) false
                                    (if (contains? raw-forms (get ids 1)) false
                                      (if (contains? raw-tokens (get ids 2)) false true)))
                                (recur (rest remaining) (+ ordinal 1)
                                       (conj raw-values (get ids 0))
                                       (conj raw-forms (get ids 1))
                                       (conj raw-tokens (get ids 2)))
                                false)
                              false)
                            false)
                          false)
                        false)
                      false))))
              false)
            preimage
            {:domain :gravity/sh03-c2-decimal-occurrence-projection-v1
             :reader-result-id (get projection :reader-result-id)
             :semantic-value-table-id
             (get projection :semantic-value-table-id)
             :adapted-source-unit-id (get projection :adapted-source-unit-id)
             :adapted-token-stream-id
             (get projection :adapted-token-stream-id)
             :adapted-form-tree-id (get projection :adapted-form-tree-id)
             :token-id-projection-id
             (get projection :token-id-projection-id)
             :form-id-projection-id (get projection :form-id-projection-id)
             :occurrence-count (get projection :occurrence-count)
             :occurrences occurrences}]
        (if checked
          (if (= (get projection :occurrence-count) (count occurrences))
            (= (get projection :projection-id)
               (sh07-declared-digest-hash preimage)) false)
          false))
      false)
    false))

(defn sh07-b51-r6-reader-product-summary [c2]
  (let [projections
        (get
         (get (get c2 :gravity-reader-boundary)
              :authenticated-envelope-descriptor)
         :semantic-projections)]
    (loop [remaining projections found nil matches 0]
      (if (= (count remaining) 0)
        (if (= matches 1) found nil)
        (let [record (first remaining)]
          (if (= (get record :name) :reader-product-identities)
            (recur (rest remaining) (get record :value) (+ matches 1))
            (recur (rest remaining) found matches)))))))

(defn sh07-b51-r6-decimal-projection-bound? [c2 projection]
  (let [boundary (get c2 :gravity-reader-boundary)
        summary (sh07-b51-r6-reader-product-summary c2)
        source-unit (get c2 :source-unit-record)
        resolved (get boundary :resolved-reader-result)
        projection-id (get projection :projection-id)]
    (if (sh07-b51-r6-exact-keys?
         summary
         #{:slice :status :adapter-contract :source-unit-id
           :token-stream-id :form-tree-id :extension-invocation-set-id
           :reader-result-id :semantic-value-table-id
           :adapted-source-unit-id :adapted-token-stream-id
           :adapted-form-tree-id :adapted-extension-invocation-set-id
           :token-id-projection-id :form-id-projection-id
           :decimal-occurrence-projection-id})
      (if (= [(get boundary :adapter-contract)
              (get summary :adapter-contract)]
             [:gravity/sh03-to-c2-reader-products-v3
              :gravity/sh03-to-c2-reader-products-v3])
        (if (= projection-id
               (get boundary :decimal-occurrence-projection-id)
               (get summary :decimal-occurrence-projection-id))
          (if (= [(get projection :reader-result-id)
                  (get projection :semantic-value-table-id)
                  (get projection :adapted-source-unit-id)
                  (get projection :adapted-token-stream-id)
                  (get projection :adapted-form-tree-id)
                  (get projection :token-id-projection-id)
                  (get projection :form-id-projection-id)]
                 [(get summary :reader-result-id)
                  (get summary :semantic-value-table-id)
                  (get summary :adapted-source-unit-id)
                  (get summary :adapted-token-stream-id)
                  (get summary :adapted-form-tree-id)
                  (get summary :token-id-projection-id)
                  (get summary :form-id-projection-id)])
            (= [(get projection :reader-result-id)
                (get projection :semantic-value-table-id)
                (get projection :adapted-source-unit-id)]
               [(get (get resolved :incremental-reader-hashes)
                     :reader-result)
                (get boundary :semantic-value-table-id)
                (get source-unit :source-id)])
            false)
          false)
        false)
      false)))

(defn sh07-b51-r6-key-from-decimal-components [components]
  (let [unscaled (get components :unscaled-value)
        scale (get components :scale)
        characters (if (string? unscaled) (vec unscaled) [])
        negative? (if (> (count characters) 0)
                    (= (first characters) \-) false)
        digits (if negative? (vec (rest characters)) characters)
        trimmed
        (loop [remaining digits removed 0]
          (if (if (> (count remaining) 1)
                (= (get remaining (- (count remaining) 1)) \0) false)
            (recur
             (subvec remaining 0 (- (count remaining) 1))
             (+ removed 1))
            {:digits remaining :removed removed}))
        zero? (= (get trimmed :digits) [\0])]
    {:kind :decimal
     :sign (if (if negative? (if zero? false true) false) -1 1)
     :coefficient
     (loop [remaining (get trimmed :digits) result []]
       (if (= (count remaining) 0) result
         (recur
          (rest remaining)
          (conj result
                (sh07-b51-r6-decimal-codepoint
                 (sh07-b51-r6-decimal-digit (first remaining)))))))
     :decimal-power (if zero? 0 (+ (- 0 scale) (get trimmed :removed)))}))

(defn sh07-b51-r6-project-decimal
  [records raw-value supplied-value projection-form-id]
  (let [c2 (get records :c2-artifact)
        projection (get records :projection)
        selected
        (loop [remaining (get projection :occurrences)
               found nil literal nil matches 0]
          (if (= (count remaining) 0)
            {:occurrence found :literal literal :count matches}
            (let [occurrence (first remaining)
                  adapted-form-id (get occurrence :adapted-form-id)
                  candidate
                  (sh07-b51-r6-find-one
                   (get c2 :literal-decoding-records)
                   :form-id adapted-form-id)
                  row (get candidate :value)
                  evidence-id
                  (if (= (get candidate :count) 1)
                    (sh07-declared-digest-hash
                     {:domain :gravity/sh07-c2-decimal-form-evidence-v1
                      :form-id adapted-form-id
                      :literal-id (get row :literal-id)}) nil)]
              (if (= evidence-id (get supplied-value :form-id))
                (recur (rest remaining) occurrence row (+ matches 1))
                (recur (rest remaining) found literal matches)))))
        occurrence (get selected :occurrence)
        record (get selected :literal)
        entry (get occurrence :semantic-value-entry)
        components (sh07-b51-r6-decimal-components (get record :raw))
        semantic-key
        (if (= (get components :status) :accepted)
          (sh07-b51-r6-key-from-decimal-components components) nil)
        expected
        {:kind :gravity/arbitrary-decimal-literal
         :unscaled-value (get components :unscaled-value)
         :scale (get components :scale)
         :literal-id
         (sh07-declared-digest-hash
          {:domain :gravity/sh07-c2-decimal-literal-evidence-v1
           :literal-id (get record :literal-id)
           :form-id (get occurrence :adapted-form-id)})
         :form-id
         (sh07-declared-digest-hash
          {:domain :gravity/sh07-c2-decimal-form-evidence-v1
           :form-id (get occurrence :adapted-form-id)
           :literal-id (get record :literal-id)})
         :token-id
         (sh07-declared-digest-hash
          {:domain :gravity/sh07-c2-decimal-token-evidence-v1
           :token-id (get occurrence :adapted-token-id)
           :literal-id (get record :literal-id)
           :form-id (get occurrence :adapted-form-id)})
         :projection-form-id projection-form-id}]
    (if (if (sh07-b51-r6-decimal-projection-authentic? projection)
          (sh07-b51-r6-decimal-projection-bound? c2 projection)
          false)
      (if (= (get selected :count) 1)
        (if (= (get components :status) :accepted)
          (if (= supplied-value expected)
            (if (= semantic-key (get entry :semantic-key))
              (let [spelled (sh07-b51-r6-decimal-spell semantic-key)]
                (if (string? spelled)
                  (let [inverse (sh07-b51-r6-decimal-inverse spelled)]
                    (if (if (map? inverse) (= inverse semantic-key) false)
                      {:status :accepted :value expected
                       :semantic-key semantic-key
                       :occurrence-ordinal (get occurrence :ordinal)}
                      {:status :rejected
                       :reason :unsupported-decimal-readable-spelling}))
                  {:status :rejected
                   :reason :unsupported-decimal-readable-spelling}))
              {:status :rejected
               :reason :unsupported-decimal-readable-spelling})
            {:status :rejected :reason :projection-decimal-descriptor})
          components)
        {:status :rejected :reason :projection-decimal-evidence})
      {:status :rejected :reason :projection-decimal-projection})))

(defn sh07-b51-r6-projected-macro-traces
  [artifact revision-id executable-syntax]
  (let [sh05 (get artifact :sh05-macro-artifact)
        request-lineage nil
        raw-trace (get sh05 :macro-expansion-trace)
        semantic-trace-id
        (sh07-declared-digest-hash
         {:domain :gravity/sh07-semantic-macro-trace-v1
          :source-revision-id revision-id
          :trace
          (loop [left raw-trace index 0 trace-result []]
            (if (= (count left) 0) trace-result
              (let [step (first left)]
                (recur
                 (rest left) (+ index 1)
                 (conj trace-result
                       {:artifact
                        :gravity/sh07-preserved-macro-expansion-step
                        :ordinal index :macro (get step :macro)
                        :profile (get step :profile)
                        :target (get step :target)
                        :step (get step :step)
                        :capabilities
                        (sh07-b51-r6-path-neutral-value
                         (get step :capabilities))
                        :build-effects
                        (sh07-b51-r6-path-neutral-value
                         (get step :build-effects))
                        :diagnostics
                        (sh07-b51-r6-path-neutral-value
                         (get step :diagnostics))})))))})
        expanded-forms
        (loop [left (get sh05 :expanded-syntax-stream) result []]
          (if (= (count left) 0) result
            (recur (rest left)
                   (conj result (get (first left) :form)))))
        sh05-semantic-id
        (sh07-declared-digest-hash
         {:domain :gravity/sh07-semantic-sh05-artifact-v1
          :source-revision-id revision-id
          :expanded-forms
          (sh07-b51-r6-path-neutral-value expanded-forms)
          :macro-trace
          (loop [left raw-trace index 0 trace-result []]
            (if (= (count left) 0) trace-result
              (let [step (first left)]
                (recur
                 (rest left) (+ index 1)
                 (conj trace-result
                       {:artifact
                        :gravity/sh07-preserved-macro-expansion-step
                        :ordinal index :macro (get step :macro)
                        :profile (get step :profile)
                        :target (get step :target)
                        :step (get step :step)
                        :capabilities
                        (sh07-b51-r6-path-neutral-value
                         (get step :capabilities))
                        :build-effects
                        (sh07-b51-r6-path-neutral-value
                         (get step :build-effects))
                        :diagnostics
                        (sh07-b51-r6-path-neutral-value
                         (get step :diagnostics))})))))})]
    (loop [remaining raw-trace ordinal 0 result []]
      (if (= (count remaining) 0) {:status :accepted :traces result}
        (let [step (first remaining)]
          (if (= (get step :macro) 'defn)
            (let [input-id
                  (sh07-declared-digest-hash
                   {:domain :gravity/sh07-macro-input-syntax-v1
                    :source-revision-id revision-id :ordinal ordinal
                    :macro (get step :macro)})
                  output
                  (loop [left executable-syntax found nil matches 0]
                    (if (= (count left) 0)
                      {:value found :count matches}
                      (if (= (get (first left) :syntax/id)
                             (get step :output-syntax-id))
                        (recur (rest left) (first left) (+ matches 1))
                        (recur (rest left) found matches))))
                  output-id (get (get output :value) :r6-root-syntax-id)
                  fn-id
                  (sh07-declared-digest-hash
                   {:domain :gravity/sh07-introduced-fn-syntax-v1
                    :input-syntax-id input-id
                    :output-def-syntax-id output-id})
                  trace
                  {:macro 'defn :input-syntax-id input-id
                   :output-def-syntax-id output-id
                   :introduced-fn-syntax-id fn-id
                   :def-generated-origin-id
                   (sh07-declared-digest-hash
                    {:domain :gravity/sh07-def-generated-origin-v1
                     :input-syntax-id input-id :output-syntax-id output-id})
                   :fn-generated-origin-id
                   (sh07-declared-digest-hash
                    {:domain :gravity/sh07-fn-generated-origin-v1
                     :input-syntax-id input-id :fn-syntax-id fn-id})
                   :source-revision-id revision-id
                   :sh05-artifact-id sh05-semantic-id
                   :macro-expansion-trace-id semantic-trace-id}]
              (if (= (get output :count) 1)
                (recur (rest remaining) (+ ordinal 1)
                       (conj result trace))
                {:status :rejected :reason :projection-macro-output}))
            (recur (rest remaining) ordinal result)))))))

(defn sh07-b51-r6-select [value selected-keys]
  (loop [remaining selected-keys result {}]
    (if (= (count remaining) 0) result
      (let [key (first remaining)]
        (recur (rest remaining)
               (if (contains? value key)
                 (assoc result key (get value key)) result))))))

(defn sh07-b51-r6-semantic-macro-trace [raw-trace]
  (loop [remaining raw-trace ordinal 0 result []]
    (if (= (count remaining) 0) result
      (let [step (first remaining)]
        (recur
         (rest remaining) (+ ordinal 1)
         (conj result
               {:artifact :gravity/sh07-preserved-macro-expansion-step
                :ordinal ordinal :macro (get step :macro)
                :profile (get step :profile) :target (get step :target)
                :step (get step :step)
                :capabilities
                (sh07-b51-r6-path-neutral-value
                 (get step :capabilities))
                :build-effects
                (sh07-b51-r6-path-neutral-value
                 (get step :build-effects))
                :diagnostics
                (sh07-b51-r6-path-neutral-value
                 (get step :diagnostics))}))))))

(defn sh07-b51-r6-project-lineage [carrier]
  (let [artifact (get carrier :sh06-resolution-artifact)
        request (get carrier :authenticated-sh06-request)
        analysis
        (get (get artifact :gravity-resolution-boundary) :resolved-analysis)
        sh05 (get artifact :sh05-macro-artifact)
        source-unit
        (get (get (get (get (get sh05 :gravity-macro-boundary)
                            :authenticated-sh04-artifact)
                       :c2-reader-artifact) :source-unit-record)
             :bytes-hash)
        raw-trace (get sh05 :macro-expansion-trace)
        semantic-trace (sh07-b51-r6-semantic-macro-trace raw-trace)
        expanded-forms
        (loop [remaining (get sh05 :expanded-syntax-stream) result []]
          (if (= (count remaining) 0) result
            (recur (rest remaining)
                   (conj result (get (first remaining) :form)))))
        neutral-expanded
        (sh07-b51-r6-path-neutral-value expanded-forms)
        module
        (sh07-b51-r6-select
         (get analysis :module-contract)
         [:namespace :profile :target :safety :effects :capabilities
          :exports])
        bindings
        (loop [remaining (get analysis :binding-table) result []]
          (if (= (count remaining) 0) result
            (recur
             (rest remaining)
             (conj result
                   (sh07-b51-r6-select
                    (first remaining)
                    [:name :kind :namespace :package :binding-class
                     :visibility :profile-set :target-set :type-ref
                     :effects :capabilities :safety :semantic-span])))))
        resolutions
        (loop [remaining (get analysis :resolution-table) result []]
          (if (= (count remaining) 0) result
            (recur
             (rest remaining)
             (conj result
                   (sh07-b51-r6-select
                    (first remaining)
                    [:reference-syntax-id :symbol :position
                     :resolution-order :semantic-span
                     :resolution-kind])))))
        aliases (vec (get analysis :alias-table))
        sh05-id
        (sh07-declared-digest-hash
         {:domain :gravity/sh07-semantic-sh05-artifact-v1
          :source-revision-id source-unit
          :expanded-forms neutral-expanded :macro-trace semantic-trace})
        expected
        {:authenticated-sh06-artifact-id (get artifact :artifact-id)
         :sh06-semantic-projection-id
         (sh07-declared-digest-hash
          {:domain :gravity/sh07-semantic-sh06-artifact-v1
           :source-revision-id source-unit :module module
           :expanded-forms neutral-expanded :bindings bindings
           :aliases aliases :resolutions resolutions})
         :sh06-artifact-id
         (sh07-declared-digest-hash
          {:domain :gravity/sh07-semantic-sh06-artifact-v1
           :source-revision-id source-unit :module module
           :expanded-forms neutral-expanded :bindings bindings
           :aliases aliases :resolutions resolutions})
         :sh06-analysis-artifact-id
         (sh07-declared-digest-hash
          {:domain :gravity/sh07-semantic-sh06-analysis-v1
           :source-revision-id source-unit :module module
           :bindings bindings :aliases aliases :resolutions resolutions})
         :source-revision-id source-unit :sh05-artifact-id sh05-id
         :expanded-syntax-stream-id
         (sh07-declared-digest-hash
          {:domain :gravity/sh07-semantic-expanded-stream-v1
           :source-revision-id source-unit
           :expanded-forms neutral-expanded})
         :macro-expansion-trace-id
         (sh07-declared-digest-hash
          {:domain :gravity/sh07-semantic-macro-trace-v1
           :source-revision-id source-unit :trace semantic-trace})
         :binding-table-id
         (sh07-declared-digest-hash
          {:domain :gravity/sh07-sh06-binding-table-v1
           :bindings bindings})
         :resolution-table-id
         (sh07-declared-digest-hash
          {:domain :gravity/sh07-sh06-resolution-table-v1
           :resolutions resolutions})
         :alias-table-id
         (sh07-declared-digest-hash
          {:domain :gravity/sh07-sh06-alias-table-v1 :aliases aliases})
         :lexical-scope-graph-id
         (sh07-declared-digest-hash
          {:domain :gravity/sh07-sh06-lexical-scope-graph-v1
           :source-revision-id source-unit
           :graph
           (sh07-b51-r6-path-neutral-value
            (sh07-b51-r6-select
             (get analysis :lexical-scope-graph)
             [:scope-count :edge-count :status]))})
         :authenticated-envelope-id
         (sh07-declared-digest-hash
          {:domain :gravity/sh07-semantic-upstream-envelope-v1
           :source-revision-id source-unit :sh05-artifact-id sh05-id})}]
    (if (= expected (get request :lineage))
      {:status :accepted :lineage expected
       :semantic-macro-trace semantic-trace}
      {:status :rejected :reason :projection-lineage})))

(defn sh07-b51-r6-project-form-tree
  [forms decimal-records revision-id root-syntax-id source-span value path
   parent-id trace scope-id depth]
  (if (> depth 256) {:status :rejected :reason :projection-form-depth}
    (let [kind (sh07-b51-r6-projected-kind value decimal-records)
          form-id
          (sh07-b51-r6-projected-form-id
           revision-id root-syntax-id path kind)
          syntax-id
          (sh07-b51-r6-projected-syntax-id
           revision-id root-syntax-id path kind trace)
          selected (sh07-b51-r6-find-one forms :form-id form-id)
          supplied (get selected :value)
          unordered-children (sh07-b51-r6-projected-children value)
          collection-order
          (if (= kind :set)
            (sh07-b51-r6-order-set-children
             decimal-records unordered-children (get supplied :child-form-ids)
             revision-id root-syntax-id path)
            (if (= kind :map)
              (sh07-b51-r6-order-map-children
               decimal-records (vec value) (get supplied :child-form-ids))
              {:status :accepted :children unordered-children}))
          children (get collection-order :children)
          child-result
          (loop [remaining children index 0 records [] child-ids []]
            (if (= (count remaining) 0)
              {:status :accepted :records records :child-ids child-ids}
              (let [child
                    (sh07-b51-r6-project-form-tree
                     forms decimal-records revision-id root-syntax-id source-span
                     (first remaining) (conj path index) form-id trace scope-id
                     (+ depth 1))]
                (if (= (get child :status) :accepted)
                  (recur (rest remaining) (+ index 1)
                         (sh07-b51-r6-append records (get child :records))
                         (conj child-ids (get child :form-id)))
                  child))))
          generated
          (if (map? trace)
            (if (= (count path) 0)
              [{:origin-id (get trace :def-generated-origin-id)
                :kind :macro-expansion
                :from-syntax-id (get trace :input-syntax-id)
                :role :introduced-def}]
              (if (= path [2])
                [{:origin-id (get trace :fn-generated-origin-id)
                  :kind :macro-expansion
                  :from-syntax-id (get trace :input-syntax-id)
                  :role :introduced-fn}]
                []))
            [])
          decimal
          (if (= kind :decimal)
            (sh07-b51-r6-project-decimal
             decimal-records value (get supplied :value) form-id)
            {:status :accepted
             :value (sh07-b51-r6-path-neutral-value value)})
          expected
          {:form-id form-id :syntax-id syntax-id :kind kind
           :value (get decimal :value)
           :parent-form-id parent-id
           :child-form-ids (get child-result :child-ids)
           :source-span source-span :origin-chain []
           :generated-origin generated
           :metadata {}
           :scope-id nil}]
      (if (= (get selected :count) 1)
        (if (= (get decimal :status) :accepted)
         (if (= (get collection-order :status) :accepted)
         (if (= (get child-result :status) :accepted)
          (if (= (sh07-b51-r6-without-keys supplied #{:scope-id})
                 (sh07-b51-r6-without-keys expected #{:scope-id}))
            {:status :accepted
             :records (conj (get child-result :records) expected)
             :form-id form-id}
            {:status :rejected :reason :projection-form-record})
          child-result)
         collection-order)
         decimal)
        {:status :rejected :reason :projection-form-id}))))

(defn sh07-b51-r6-replay-current-scope [state scope-chain]
  (if (= (count scope-chain) 0)
    (get state :namespace-scope-id)
    (get (get state :projected-by-upstream) (first scope-chain))))

(defn sh07-b51-r6-replay-consume-scope
  [carrier state owner-syntax-id scope-chain declarations]
  (let [raw-request
        (get (get (get carrier :sh06-resolution-artifact)
                  :gravity-resolution-boundary)
             :authenticated-resolution-request)
        index (get state :scope-index)
        scope (get (get raw-request :lexical-scopes) index)
        parent-upstream (if (= (count scope-chain) 0) nil (first scope-chain))
        parent-projected
        (sh07-b51-r6-replay-current-scope state scope-chain)
        names
        (loop [remaining declarations result []]
          (if (= (count remaining) 0) result
            (recur (rest remaining)
                   (conj result (get (first remaining) :name)))))
        raw-names
        (loop [remaining (get scope :bindings) result []]
          (if (= (count remaining) 0) result
            (recur (rest remaining)
                   (conj result (get (first remaining) :name)))))
        projected
        (sh07-declared-digest-hash
         {:domain :gravity/sh07-projected-lexical-scope-v1
          :source-revision-id (get state :revision-id) :ordinal index
          :parent-scope-id parent-projected :binding-names names})]
    (if (if (map? scope)
          (if (= (get scope :owner-syntax-id) owner-syntax-id)
            (if (= (get scope :parent-scope-id) parent-upstream)
              (= raw-names names) false) false) false)
      (if (if (sh07-b51-r6-sha256-id? projected)
            (if (contains? (get state :projected-by-upstream)
                           (get scope :scope-id)) false true) false)
        (loop [raw-bindings (get scope :bindings) remaining declarations
               next-state
               (assoc
                (assoc state :scope-index (+ index 1))
                :projected-by-upstream
                (assoc (get state :projected-by-upstream)
                       (get scope :scope-id) projected))]
          (if (= (count raw-bindings) 0)
            {:status :accepted :state next-state
             :upstream-scope-id (get scope :scope-id)
             :projected-scope-id projected}
            (let [raw-binding (first raw-bindings)
                  declaration (first remaining)]
              (recur
               (rest raw-bindings) (rest remaining)
               (assoc next-state :declarations
                      (assoc (get next-state :declarations)
                             (get raw-binding :binding-syntax-id)
                             {:syntax-id (get declaration :syntax-id)
                              :scope-id projected}))))))
        {:status :rejected :reason :projection-scope-id})
      {:status :rejected :reason :projection-scope-consumption})))

(defn sh07-b51-r6-replay-reference
  [carrier state owner-syntax-id scope-chain form position]
  (let [raw-request
        (get (get (get carrier :sh06-resolution-artifact)
                  :gravity-resolution-boundary)
             :authenticated-resolution-request)
        index (get state :reference-index)
        reference (get (get raw-request :references) index)
        symbol (get form :value)
        expected-id
        (sh07-declared-digest-hash
         {:domain :gravity/sh06-reference-syntax-v1
          :owner-syntax-id owner-syntax-id :ordinal (+ index 1)
          :symbol symbol :position position})]
    (if (if (map? reference)
          (= [(get reference :syntax-id) (get reference :symbol)
              (get reference :position) (get reference :scope-chain)]
             [expected-id symbol position scope-chain]) false)
      {:status :accepted
       :state
       (assoc
        (assoc state :reference-index (+ index 1))
        :occurrences
        (conj (get state :occurrences)
              {:projected-syntax-id (get form :syntax-id)
               :upstream-reference-syntax-id (get reference :syntax-id)
               :symbol symbol :position position}))}
      {:status :rejected :reason :projection-reference-consumption})))

(defn sh07-b51-r6-replay-pattern-declarations
  [indexes form depth]
  (if (> depth 256) {:status :rejected}
    (let [kind (get form :kind) value (get form :value)]
      (if (= kind :symbol)
        (if (= value '_) {:status :accepted :declarations []}
          {:status :accepted
           :declarations [{:name value :syntax-id (get form :syntax-id)}]})
        (if (= kind :vector)
          (loop [remaining (get form :child-form-ids)
                 result [] names #{}]
            (if (= (count remaining) 0)
              {:status :accepted :declarations result}
              (let [child (get (get indexes :forms-by-id) (first remaining))
                    walked
                    (if (map? child)
                      (sh07-b51-r6-replay-pattern-declarations
                       indexes child (+ depth 1)) {:status :rejected})]
                (if (= (get walked :status) :accepted)
                  (let [duplicate
                        (loop [left (get walked :declarations)]
                          (if (= (count left) 0) false
                            (if (contains? names (get (first left) :name)) true
                              (recur (rest left)))))
                        next-names
                        (loop [left (get walked :declarations) next names]
                          (if (= (count left) 0) next
                            (recur (rest left)
                                   (conj next (get (first left) :name)))))]
                    (if duplicate {:status :rejected}
                      (recur (rest remaining)
                             (sh07-b51-r6-append
                              result (get walked :declarations))
                             next-names)))
                  walked))))
          (if (contains?
               #{:nil :boolean :integer :decimal :ratio :character
                 :string :keyword} kind)
            {:status :accepted :declarations []} {:status :rejected}))))))

(defn sh07-b51-r6-replay-assign-declarations
  [state declarations projected-scope-id]
  (loop [remaining declarations next state]
    (if (= (count remaining) 0) next
      (recur
       (rest remaining)
       (assoc next :scope-by-syntax
              (assoc (get next :scope-by-syntax)
                     (get (first remaining) :syntax-id)
                     projected-scope-id))))))

(defn sh07-b51-r6-replay-assign-form [state form scope-chain]
  (assoc state :scope-by-syntax
         (assoc (get state :scope-by-syntax) (get form :syntax-id)
                (sh07-b51-r6-replay-current-scope state scope-chain))))

(defn sh07-b51-r6-replay-walk-sequence
  [carrier indexes owner-syntax-id form-ids scope-chain state position]
  (loop [remaining form-ids next state]
    (if (= (count remaining) 0) {:status :accepted :state next}
      (let [form (get (get indexes :forms-by-id) (first remaining))
            walked
            (if (map? form)
              (sh07-b51-r6-replay-walk-form
               carrier indexes owner-syntax-id form scope-chain next position)
              {:status :rejected :reason :projection-child-form})]
        (if (= (get walked :status) :accepted)
          (recur (rest remaining) (get walked :state)) walked)))))

(defn sh07-b51-r6-replay-special-operator
  [carrier indexes owner-syntax-id form scope-chain state]
  (let [operator
        (get (get indexes :forms-by-id) (first (get form :child-form-ids)))]
    (if (map? operator)
      (sh07-b51-r6-replay-reference
       carrier state owner-syntax-id scope-chain operator :operator)
      {:status :rejected :reason :projection-operator-form})))

(defn sh07-b51-r6-replay-walk-fn
  [carrier indexes owner-syntax-id form scope-chain state]
  (let [raw (get form :child-form-ids)
        params (get (get indexes :forms-by-id) (get raw 1))
        declarations
        (if (= (get params :kind) :vector)
          (loop [remaining (get params :child-form-ids) result [] names #{}]
            (if (= (count remaining) 0)
              {:status :accepted :values result}
              (let [parameter
                    (get (get indexes :forms-by-id) (first remaining))
                    name (get parameter :value)]
                (if (if (= (get parameter :kind) :symbol)
                      (if (= name '&) false (if (contains? names name) false true)) false)
                  (recur (rest remaining)
                         (conj result {:name name
                                       :syntax-id (get parameter :syntax-id)})
                         (conj names name))
                  {:status :rejected :reason :projection-fn-parameters}))))
          {:status :rejected :reason :projection-fn-parameter-vector})
        consumed
        (if (= (get declarations :status) :accepted)
          (sh07-b51-r6-replay-consume-scope
           carrier state owner-syntax-id scope-chain (get declarations :values))
          declarations)]
    (if (= (get consumed :status) :accepted)
      (let [projected (get consumed :projected-scope-id)
            upstream (get consumed :upstream-scope-id)
            nested (conj [] upstream)
            nested
            (loop [remaining scope-chain result nested]
              (if (= (count remaining) 0) result
                (recur (rest remaining) (conj result (first remaining)))))
            scoped
            (sh07-b51-r6-replay-assign-declarations
             (assoc (get consumed :state) :scope-by-syntax
                    (assoc (get (get consumed :state) :scope-by-syntax)
                           (get form :syntax-id) projected
                           (get params :syntax-id) projected))
             (get declarations :values) projected)
            operator
            (sh07-b51-r6-replay-special-operator
             carrier indexes owner-syntax-id form scope-chain scoped)]
        (if (= (get operator :status) :accepted)
          (sh07-b51-r6-replay-walk-sequence
           carrier indexes owner-syntax-id (vec (rest (rest raw))) nested
           (get operator :state) :expression)
          operator))
      consumed)))

(defn sh07-b51-r6-replay-walk-let-loop
  [carrier indexes owner-syntax-id form scope-chain state]
  (let [raw (get form :child-form-ids)
        binding-vector (get (get indexes :forms-by-id) (get raw 1))
        slots (get binding-vector :child-form-ids)
        operator
        (sh07-b51-r6-replay-special-operator
         carrier indexes owner-syntax-id form scope-chain state)]
    (if (if (= (get operator :status) :accepted)
          (if (= (get binding-vector :kind) :vector)
            (sh07-b51-r6-even-natural? (count slots)) false) false)
      (loop [remaining slots active scope-chain next (get operator :state)]
        (if (= (count remaining) 0)
          (sh07-b51-r6-replay-walk-sequence
           carrier indexes owner-syntax-id (vec (rest (rest raw))) active
           next :expression)
          (let [pattern
                (get (get indexes :forms-by-id) (first remaining))
                initializer
                (get (get indexes :forms-by-id) (get remaining 1))
                initialized
                (if (map? initializer)
                  (sh07-b51-r6-replay-walk-form
                   carrier indexes owner-syntax-id initializer active next
                   :expression)
                  {:status :rejected :reason :projection-initializer})
                declarations
                (if (map? pattern)
                  (sh07-b51-r6-replay-pattern-declarations indexes pattern 0)
                  {:status :rejected})
                consumed
                (if (if (= (get initialized :status) :accepted)
                      (= (get declarations :status) :accepted) false)
                  (sh07-b51-r6-replay-consume-scope
                   carrier (get initialized :state) owner-syntax-id active
                   (get declarations :declarations)) declarations)]
            (if (= (get consumed :status) :accepted)
              (let [upstream (get consumed :upstream-scope-id)
                    nested (sh07-b51-r6-append [upstream] active)
                    projected (get consumed :projected-scope-id)
                    scoped
                    (sh07-b51-r6-replay-assign-declarations
                     (get consumed :state)
                     (get declarations :declarations) projected)
                    scoped
                    (if (= (get pattern :kind) :vector)
                      (assoc scoped :scope-by-syntax
                             (assoc (get scoped :scope-by-syntax)
                                    (get pattern :syntax-id) projected))
                      scoped)]
                (recur (vec (rest (rest remaining))) nested scoped))
              consumed))))
      operator)))

(defn sh07-b51-r6-replay-walk-match
  [carrier indexes owner-syntax-id form scope-chain state]
  (let [raw (get form :child-form-ids)
        operator
        (sh07-b51-r6-replay-special-operator
         carrier indexes owner-syntax-id form scope-chain state)
        scrutinee (get (get indexes :forms-by-id) (get raw 1))
        walked
        (if (= (get operator :status) :accepted)
          (sh07-b51-r6-replay-walk-form
           carrier indexes owner-syntax-id scrutinee scope-chain
           (get operator :state) :expression) operator)]
    (if (= (get walked :status) :accepted)
      (loop [remaining (vec (rest (rest raw))) next (get walked :state)]
        (if (= (count remaining) 0) {:status :accepted :state next}
          (let [pattern
                (get (get indexes :forms-by-id) (first remaining))
                branch (get (get indexes :forms-by-id) (get remaining 1))
                declarations
                (if (map? pattern)
                  (sh07-b51-r6-replay-pattern-declarations indexes pattern 0)
                  {:status :rejected})]
            (if (= (get declarations :status) :accepted)
              (if (= (count (get declarations :declarations)) 0)
                (let [branch-result
                      (sh07-b51-r6-replay-walk-form
                       carrier indexes owner-syntax-id branch scope-chain next
                       :expression)]
                  (if (= (get branch-result :status) :accepted)
                    (recur (vec (rest (rest remaining)))
                           (get branch-result :state)) branch-result))
                (let [consumed
                      (sh07-b51-r6-replay-consume-scope
                       carrier next owner-syntax-id scope-chain
                       (get declarations :declarations))]
                  (if (= (get consumed :status) :accepted)
                    (let [projected (get consumed :projected-scope-id)
                          nested
                          (sh07-b51-r6-append
                           [(get consumed :upstream-scope-id)] scope-chain)
                          scoped
                          (sh07-b51-r6-replay-assign-declarations
                           (get consumed :state)
                           (get declarations :declarations) projected)
                          branch-result
                          (sh07-b51-r6-replay-walk-form
                           carrier indexes owner-syntax-id branch nested scoped
                           :expression)]
                      (if (= (get branch-result :status) :accepted)
                        (recur (vec (rest (rest remaining)))
                               (get branch-result :state)) branch-result))
                    consumed)))
              declarations))))
      walked)))

(defn sh07-b51-r6-replay-walk-try-items
  [carrier indexes owner-syntax-id scope-chain remaining state]
  (if (= (count remaining) 0) {:status :accepted :state state}
    (let [item (get (get indexes :forms-by-id) (first remaining))
          item-kind (sh07-b51-r6-form-core-kind indexes item)]
      (if (= item-kind nil)
        (let [children (get item :child-form-ids)
              clause-op (get (get indexes :forms-by-id) (first children))]
          (if (= [(get item :kind) (get clause-op :value)] [:list 'catch])
            (let [catch-ref
                  (sh07-b51-r6-replay-reference
                   carrier state owner-syntax-id scope-chain clause-op :operator)
                  type-form (get (get indexes :forms-by-id) (get children 1))
                  type-result
                  (if (= (get catch-ref :status) :accepted)
                    (sh07-b51-r6-replay-walk-form
                     carrier indexes owner-syntax-id type-form scope-chain
                     (get catch-ref :state) :type) catch-ref)
                  binding-form
                  (get (get indexes :forms-by-id) (get children 2))
                  declarations
                  (if (= (get binding-form :kind) :symbol)
                    [{:name (get binding-form :value)
                      :syntax-id (get binding-form :syntax-id)}] [])
                  consumed
                  (if (= (get type-result :status) :accepted)
                    (sh07-b51-r6-replay-consume-scope
                     carrier (get type-result :state) owner-syntax-id
                     scope-chain declarations) type-result)]
              (if (= (get consumed :status) :accepted)
                (let [projected (get consumed :projected-scope-id)
                      nested
                      (sh07-b51-r6-append
                       [(get consumed :upstream-scope-id)] scope-chain)
                      scoped
                      (sh07-b51-r6-replay-assign-declarations
                       (get consumed :state) declarations projected)
                      handlers
                      (sh07-b51-r6-replay-walk-sequence
                       carrier indexes owner-syntax-id
                       (vec (rest (rest (rest children)))) nested scoped
                       :expression)]
                  (if (= (get handlers :status) :accepted)
                    (sh07-b51-r6-replay-walk-try-items
                     carrier indexes owner-syntax-id scope-chain
                     (rest remaining) (get handlers :state)) handlers))
                consumed))
            {:status :rejected :reason :projection-try-clause}))
        (let [protected
              (sh07-b51-r6-replay-walk-form
               carrier indexes owner-syntax-id item scope-chain state
               :expression)]
          (if (= (get protected :status) :accepted)
            (sh07-b51-r6-replay-walk-try-items
             carrier indexes owner-syntax-id scope-chain (rest remaining)
             (get protected :state)) protected))))))

(defn sh07-b51-r6-replay-walk-try
  [carrier indexes owner-syntax-id form scope-chain state]
  (let [operator
        (sh07-b51-r6-replay-special-operator
         carrier indexes owner-syntax-id form scope-chain state)]
    (if (= (get operator :status) :accepted)
      (sh07-b51-r6-replay-walk-try-items
       carrier indexes owner-syntax-id scope-chain
       (vec (rest (get form :child-form-ids))) (get operator :state))
      operator)))

(defn sh07-b51-r6-replay-walk-form
  [carrier indexes owner-syntax-id form scope-chain state position]
  (let [kind (sh07-b51-r6-form-core-kind indexes form)
        scoped (sh07-b51-r6-replay-assign-form state form scope-chain)]
    (if (= (get form :kind) :symbol)
      (sh07-b51-r6-replay-reference
       carrier scoped owner-syntax-id scope-chain form position)
      (if (= kind :quote)
        (sh07-b51-r6-replay-special-operator
         carrier indexes owner-syntax-id form scope-chain scoped)
        (if (contains? #{:def :var :set!} kind)
          (let [operator
                (sh07-b51-r6-replay-special-operator
                 carrier indexes owner-syntax-id form scope-chain scoped)
                ids (get form :child-form-ids)
                values
                (if (= kind :def) (vec (rest (rest ids)))
                  (if (= kind :set!) (vec (rest ids))
                    (if (= kind :var) [(get ids 1)] [])))]
            (if (= (get operator :status) :accepted)
              (sh07-b51-r6-replay-walk-sequence
               carrier indexes owner-syntax-id values scope-chain
               (get operator :state) :expression) operator))
          (if (= kind :fn)
            (sh07-b51-r6-replay-walk-fn
             carrier indexes owner-syntax-id form scope-chain scoped)
            (if (contains? #{:let :loop} kind)
              (sh07-b51-r6-replay-walk-let-loop
               carrier indexes owner-syntax-id form scope-chain scoped)
              (if (= kind :match)
                (sh07-b51-r6-replay-walk-match
                 carrier indexes owner-syntax-id form scope-chain scoped)
                (if (= kind :try)
                  (sh07-b51-r6-replay-walk-try
                   carrier indexes owner-syntax-id form scope-chain scoped)
                  (loop [remaining (get form :child-form-ids)
                         index 0 next scoped]
                    (if (= (count remaining) 0)
                      {:status :accepted :state next}
                      (let [child
                            (get (get indexes :forms-by-id) (first remaining))
                            walked
                            (if (map? child)
                              (sh07-b51-r6-replay-walk-form
                               carrier indexes owner-syntax-id child scope-chain
                               next (if (= index 0) :operator position))
                              {:status :rejected
                               :reason :projection-child-form})]
                        (if (= (get walked :status) :accepted)
                          (recur (rest remaining) (+ index 1)
                                 (get walked :state)) walked)))))))))))))

(defn sh07-b51-r6-replay-lexical-projection
  [carrier records roots executable revision-id namespace-scope-id]
  (let [indexes
        {:forms-by-id
         (loop [remaining records result {}]
           (if (= (count remaining) 0) result
             (recur (rest remaining)
                    (assoc result (get (first remaining) :form-id)
                           (first remaining)))))}
        initial
        {:scope-index 0 :reference-index 0 :projected-by-upstream {}
         :scope-by-syntax {} :declarations {} :occurrences []
         :revision-id revision-id :namespace-scope-id namespace-scope-id}
        walked
        (loop [remaining-roots roots remaining-syntax executable next initial]
          (if (= (count remaining-roots) 0)
            {:status :accepted :state next}
            (let [root (get (get indexes :forms-by-id) (first remaining-roots))
                  syntax (first remaining-syntax)
                  result
                  (if (map? root)
                    (sh07-b51-r6-replay-walk-form
                     carrier indexes (get syntax :syntax/id) root [] next
                     :expression)
                    {:status :rejected :reason :projection-root-form})]
              (if (= (get result :status) :accepted)
                (recur (rest remaining-roots) (rest remaining-syntax)
                       (get result :state)) result))))
        state (get walked :state)
        raw-request
        (get (get (get carrier :sh06-resolution-artifact)
                  :gravity-resolution-boundary)
             :authenticated-resolution-request)]
    (if (= (get walked :status) :accepted)
      (if (= [(get state :scope-index) (get state :reference-index)]
             [(count (get raw-request :lexical-scopes))
              (count (get raw-request :references))])
        {:status :accepted
         :forms
         (loop [remaining records result []]
           (if (= (count remaining) 0) result
             (let [form (first remaining)]
               (recur
                (rest remaining)
                (conj result
                      (assoc form :scope-id
                             (get (get state :scope-by-syntax)
                                  (get form :syntax-id))))))))
         :declarations (get state :declarations)
         :occurrences (get state :occurrences)
         :projected-by-upstream (get state :projected-by-upstream)}
        {:status :rejected :reason :projection-lexical-census})
      walked)))

(defn sh07-b51-r6-project-forms [carrier]
  (let [artifact (get carrier :sh06-resolution-artifact)
        request (get carrier :authenticated-sh06-request)
        sh05 (get artifact :sh05-macro-artifact)
        source-unit
        (get (get (get (get (get sh05 :gravity-macro-boundary)
                            :authenticated-sh04-artifact)
                       :c2-reader-artifact)
                  :source-unit-record)
             :bytes-hash)
        revision-id source-unit
        namespace-root-scope-id
        (sh07-declared-digest-hash
         {:domain :gravity/sh07-projected-namespace-root-scope-v1
          :source-revision-id revision-id
          :namespace
          (get (get request :module) :namespace)})
        raw-stream (get sh05 :expanded-syntax-stream)
        c2-artifact
        (get (get (get sh05 :gravity-macro-boundary)
                  :authenticated-sh04-artifact) :c2-reader-artifact)
        decimal-records
        {:c2-artifact c2-artifact
         :projection
         (get c2-artifact :sh07-decimal-occurrence-projection)
         :records (get c2-artifact :literal-decoding-records)}
        executable
        (loop [remaining raw-stream ordinal 0 result []]
          (if (= (count remaining) 0) result
            (let [syntax (first remaining) form (get syntax :form)]
              (if (if (seq? form) (= (first form) 'ns) false)
                (recur (rest remaining) ordinal result)
                (let [root-id
                      (sh07-declared-digest-hash
                       {:domain :gravity/sh07-root-syntax-v1
                        :source-revision-id revision-id :ordinal ordinal
                        :form (sh07-b51-r6-path-neutral-value form)})]
                  (recur (rest remaining) (+ ordinal 1)
                         (conj result
                               (assoc syntax :r6-root-syntax-id root-id))))))))
        traces (sh07-b51-r6-projected-macro-traces
                artifact revision-id executable)]
    (if (if (sh07-b51-r6-decimal-projection-authentic?
             (get decimal-records :projection))
          (sh07-b51-r6-decimal-projection-bound?
           c2-artifact (get decimal-records :projection))
          false)
     (if (= revision-id
            (get (get request :lineage) :source-revision-id))
      (if (= (get traces :status) :accepted)
        (loop [remaining executable records [] roots []]
          (if (= (count remaining) 0)
            (let [lexical
                  (sh07-b51-r6-replay-lexical-projection
                   carrier records roots executable revision-id
                   namespace-root-scope-id)]
              (if (= (get lexical :status) :accepted)
                (if (= (get lexical :forms) (get request :forms))
                  (if (= roots (get request :top-level-form-ids))
                    {:status :accepted :forms (get lexical :forms) :roots roots
                     :traces (get traces :traces) :lexical lexical}
                    {:status :rejected :reason :projection-roots})
                  {:status :rejected :reason :projection-forms})
                lexical))
            (let [syntax (first remaining)
                  root-id (get syntax :r6-root-syntax-id)
                  trace
                  (loop [left (get traces :traces) found nil]
                    (if (= (count left) 0) found
                      (if (= (get (first left) :output-def-syntax-id)
                             root-id)
                        (first left) (recur (rest left) found))))
                  tree
                  (sh07-b51-r6-project-form-tree
                   (get request :forms) decimal-records revision-id root-id
                   (sh07-b51-r6-semantic-span (get syntax :span))
                   (get syntax :form) [] nil trace namespace-root-scope-id 0)]
              (if (= (get tree :status) :accepted)
                (recur (rest remaining)
                       (sh07-b51-r6-append records (get tree :records))
                       (conj roots (get tree :form-id)))
                tree))))
        traces)
       {:status :rejected :reason :projection-source-revision})
     {:status :rejected :reason :projection-decimal-projection})))

(defn sh07-b51-r6-project-definition-syntax-id
  [carrier upstream revision-id]
  (let [request (get carrier :authenticated-sh06-request)
        sh05
        (get (get carrier :sh06-resolution-artifact)
             :sh05-macro-artifact)
        stream (get sh05 :expanded-syntax-stream)]
    (if (= (get upstream :binding-class) :lexical) nil
      (if (= (get upstream :binding-class) :namespace)
        (loop [remaining stream ordinal 0]
          (if (= (count remaining) 0) nil
            (let [syntax (first remaining) form (get syntax :form)]
              (if (if (seq? form) (= (first form) 'ns) false)
                (recur (rest remaining) ordinal)
                (let [root-id
                      (sh07-declared-digest-hash
                       {:domain :gravity/sh07-root-syntax-v1
                        :source-revision-id revision-id :ordinal ordinal
                        :form (sh07-b51-r6-path-neutral-value form)})]
                  (if (= (get syntax :syntax/id)
                         (get upstream :definition-syntax-id))
                    (let [root
                          (sh07-b51-r6-find-one
                           (get request :forms) :form-id root-id)
                          name-id (get (get (get root :value)
                                           :child-form-ids) 1)
                          name
                          (sh07-b51-r6-find-one
                           (get request :forms) :form-id name-id)]
                      (if (= [(get root :count) (get name :count)] [1 1])
                        (get (get name :value) :syntax-id) nil))
                    (recur (rest remaining) (+ ordinal 1))))))))
        (get upstream :definition-syntax-id)))))

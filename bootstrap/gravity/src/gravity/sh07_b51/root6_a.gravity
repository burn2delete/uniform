(defn sh07-b51-r6-decimal-c2-branch [c2-artifact form-id text]
  (if (if (string? text) (<= (count text) 261) false)
    (let [literal (sh07-b51-r6-find-one
                 (get c2-artifact :literal-decoding-records)
                 :form-id form-id)
        form (sh07-b51-r6-find-one
              (get c2-artifact :form-tree) :form-id form-id)
        deferred
        (sh07-b51-r6-find-one
         (get (get c2-artifact :semantic-error-deferment-record)
              :deferred-literal-records)
         :form-id form-id)
        literal-record (get literal :value)
        form-record (get form :value)
        exact-branch? (<= (count text) 256)]
    (if (= [(get literal :count) (get form :count)] [1 1])
      (if (= (set (keys literal-record))
             #{:literal-id :form-id :kind :raw :span :decoded :facts})
        (if (= (set (keys form-record))
               #{:form-id :form-index :kind :collection-kind
                 :parent-form-id :children :open-token :close-token
                 :open-token-index :close-token-index :token-range :span
                 :raw :value :semantic-key :subtree-form-count :metadata
                 :surface-span :abbreviation :abbrev :tag-codepoints
                 :generated-origin :origin})
          (if (= [(get literal-record :kind) (get form-record :kind)
                  (get literal-record :raw) (get form-record :raw)
                  (get literal-record :span) (get form-record :span)
                  (get literal-record :decoded) (get form-record :value)
                  (set (keys (get literal-record :facts)))
                  (get (get literal-record :facts) :exact?)]
                 [:decimal :decimal (get literal-record :raw)
                  (get literal-record :raw) (get literal-record :span)
                  (get literal-record :span) (get literal-record :decoded)
                  (get literal-record :decoded)
                  #{:exponent-spelling :exact?} false])
            (if exact-branch?
              (let [key (get form-record :semantic-key)]
                (if (<= (get deferred :count) 1)
                  (if (= (get (get literal-record :facts)
                              :semantic-validation) :accepted)
                    (if (sh07-b51-r6-decimal-key-authentic? key)
                      (if (= (sh07-b51-r6-decimal-spell key) text)
                        (let [inverse
                              (sh07-b51-r6-decimal-inverse text)]
                          (if (if (map? inverse) (= inverse key) false)
                            {:status :exact-normalized :semantic-key key}
                            (sh07-b51-r6-decimal-readable-rejection)))
                        (sh07-b51-r6-decimal-readable-rejection))
                      (sh07-b51-r6-decimal-readable-rejection))
                    (sh07-b51-r6-decimal-readable-rejection))
                  (sh07-b51-r6-decimal-readable-rejection)))
              (let [deferred-record (get deferred :value)]
                (if (= (get deferred :count) 1)
                  (if (= (set (keys deferred-record))

(defn sh07-b51-r6-c30-certificate-inputs? [inputs]
  (if (sh07-b51-r6-exact-keys?
       inputs
       #{:architecture-report-sha256 :snapshot-commit :snapshot-tree
         :predecessor-executable-descriptor-id :module-source-identities
         :module-source-byte-counts :emitter-source-id :emitter-semantic-id
         :m0-ids :m1-id :m2-ids :bundle-core-id})
    (if (= (get inputs :architecture-report-sha256)
           (sh07-b51-r6-c30-report-id))
      (sh07-b51-r6-c30-all-true?
       [(sh07-b51-r6-c30-git-id? (get inputs :snapshot-commit))
        (sh07-b51-r6-c30-git-id? (get inputs :snapshot-tree))
        (sh07-b51-r6-sha256-id?
         (get inputs :predecessor-executable-descriptor-id))
        (sh07-b51-r6-c30-digest-vector?
         (get inputs :module-source-identities) 7)

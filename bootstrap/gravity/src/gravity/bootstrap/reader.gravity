    :stage :stage1
    :purpose
    :reader-release-attestation-seed-retirement-assumption-replacement
    :retirement-objective
    :replace-physical-supply-chain-and-independent-diversity-assumptions-with-release-attestation-and-seed-retirement}})

(def stage1-reader-formal-release-governance-seed-retirement
  {:engine :gravity-reader-formal-release-governance-v1
   :entrypoint :stage1-read-source-formal-release-governance-seed-retirement
   :replaces [:human-release-governance
              :legal-custody-record-retention
              :deployment-environment-custody]
   :release-attestation-seed-retirement
   :stage1-reader-release-attestation-seed-retirement
   :diverse-bootstrap-verification
   :stage1-reader-diverse-bootstrap-verification
   :verified-boot-chain :stage1-reader-verified-boot-chain
   :input [:formal-release-governance
           :deployment-custody
           :self-hosting-evidence
           :release-attestation
           :source-path
           :source-text]
   :output :gravity/stage1-reader-form-records
   :artifact
   :gravity/stage1-reader-formal-release-governance-seed-retirement-artifact
   :diagnostic-stream
   :gravity/stage1-reader-formal-release-governance-seed-retirement-diagnostic-stream
   :proof-kind
   :gravity/stage1-reader-formal-release-governance-seed-retirement-proof
   :residual-release-governance-boundaries []
   :formal-release-governance-fallbacks []
   :formal-governance-operations
   [:verify-formal-release-governance
    :verify-deployment-custody
    :verify-self-hosting-evidence
    :verify-reproducible-rebuild
    :verify-stage-comparison
    :record-tcb-delta
    :record-unsafe-audit
    :record-formal-release-provenance]
   :formal-release-governance-record
   {:record-id :stage1-reader-formal-release-governance
    :policy-engine :gravity-release-policy-v1
    :governance-source :versioned-rfc-ledger
    :approval-model :machine-checkable-governance
    :required-policies [:GOV6 :GOV10 :BOOT6 :BOOT7 :BOOT8 :TEST13]
    :human-release-governance-replaced? true
    :legal-custody-record-retention-replaced? true
    :deployment-environment-custody-replaced? true
    :status :verified}
   :deployment-custody-record
   {:record-id :stage1-reader-deployment-custody
    :custody-model :content-addressed-release-graph
    :environment :reproducible-bootstrap-lab
    :builder-selection :policy-verified
    :artifact-admission :hash-and-policy-gated
    :network :disabled
    :mutable-state :forbidden
    :status :verifiable}
   :self-hosting-evidence
   {:record-id :stage1-reader-self-hosting-evidence
    :scope :stage1-reader-claimed-subset
    :staged-compiler-artifact :verified
    :reproducible-rebuild-log :verified
    :conformance-report :verified
    :stage-comparison-report :verified
    :provenance-attestation :verified
    :tcb-delta :verified
    :unsafe-audit-report :not-applicable
    :claimed-subset-self-hosted? true
    :full-language-compiler-self-hosted? false
    :clojure-seed-retired? false
    :status :verified}
   :seed-retirement-evidence
   {:record-id :stage1-reader-formal-governance-seed-retirement
    :retired-assumptions [:human-release-governance
                          :legal-custody-record-retention
                          :deployment-environment-custody]
    :claimed-subset-seed-retired? true
    :full-compiler-seed-retired? false
    :clojure-seed-retired? false
    :remaining-boundaries [:full-language-compiler-self-hosting]
    :status :recorded}
   :tcb-delta-record
   {:record-id :stage1-reader-formal-governance-tcb-delta
    :removed [:human-release-governance
              :legal-custody-record-retention
              :deployment-environment-custody]
    :remaining [:full-language-compiler-self-hosting]
    :new-unsafe-islands []
    :status :complete}
   :unsafe-audit-report
   {:record-id :stage1-reader-formal-governance-unsafe-audit
    :unsafe-islands []
    :unsafe-required? false
    :status :not-applicable}
   :formal-release-provenance-record
   {:record-id :stage1-reader-formal-release-provenance
    :lineage [:stage1-reader-formal-release-governance-seed-retirement
              :stage1-reader-release-attestation-seed-retirement
              :stage1-reader-diverse-bootstrap-verification
              :stage1-reader-verified-boot-chain
              :stage1-reader-runtime-image
              :stage1-reader-runtime-entrypoint
              :stage1-reader-compiler-driver
              :stage1-reader-core-bootstrap-runtime
              :stage1-reader-self-hosted-runtime
              :stage1-reader-source-runtime]
    :canonicalized true
    :auditor-traversable true
    :status :complete}
   :direct-stages
   [{:label :formal-release-governance
     :op :stage1-formal-governance-verify
     :evidence [:policy-engine :governance-source
                :approval-model :required-policies]}
    {:label :deployment-custody
     :op :stage1-formal-governance-deployment-custody
     :evidence [:content-addressed-release-graph
                :policy-verified-builder
                :hash-and-policy-gated-artifact-admission]}
    {:label :self-hosting-evidence
     :op :stage1-formal-governance-self-hosting-evidence
     :evidence [:staged-compiler-artifact
                :conformance-report
                :provenance-attestation]}
    {:label :reproducible-rebuild
     :op :stage1-formal-governance-reproducible-rebuild
     :evidence [:reproducible-rebuild-log :stage-comparison-report]}
    {:label :stage-comparison
     :op :stage1-formal-governance-stage-comparison
     :evidence [:stage0-form-parity :trace-comparison]}
    {:label :tcb-delta
     :op :stage1-formal-governance-tcb-delta
     :removed [:human-release-governance
               :legal-custody-record-retention
               :deployment-environment-custody]}
    {:label :unsafe-audit
     :op :stage1-formal-governance-unsafe-audit
     :unsafe-islands []}
    {:label :formal-release-provenance
     :op :stage1-formal-governance-record-provenance
     :lineage [:stage1-reader-formal-release-governance-seed-retirement
               :stage1-reader-release-attestation-seed-retirement
               :stage1-reader-diverse-bootstrap-verification]}]
   :uses-runtimes [:stage1-reader-formal-release-governance-seed-retirement
                   :stage1-reader-release-attestation-seed-retirement
                   :stage1-reader-diverse-bootstrap-verification
                   :stage1-reader-verified-boot-chain
                   :stage1-reader-runtime-image
                   :stage1-reader-runtime-entrypoint
                   :stage1-reader-compiler-driver
                   :stage1-reader-core-bootstrap-runtime
                   :stage1-reader-self-hosted-runtime
                   :stage1-reader-source-runtime]
   :uses-builtins [:stage1-reader-core-bootstrap-builtins]
   :uses-executors [:stage1-reader-token-automaton-executor
                    :stage1-reader-form-builder-executor]
   :preserves [:source-spans :diagnostic-codes :artifact-provenance
               :stage0-form-parity :release-attestation-routing
               :diverse-bootstrap-verification-routing
               :verified-boot-chain-routing :runtime-image-routing
               :runtime-entrypoint-routing :compiler-driver-routing
               :core-bootstrap-builtin-coverage]
   :diagnostics
   {:missing-entrypoint "STAGE1GOV001"
    :unsupported-formal-governance-operation "STAGE1GOV002"
    :missing-formal-release-governance "STAGE1GOV003"
    :unverifiable-deployment-custody "STAGE1GOV004"
    :missing-self-hosting-evidence "STAGE1GOV005"
    :unreproducible-full-compiler-rebuild "STAGE1GOV006"
    :missing-stage-compiler-equivalence "STAGE1GOV007"
    :missing-tcb-delta "STAGE1GOV008"
    :illegal-governance-or-deployment-fallback "STAGE1GOV009"
    :invalid-formal-release-governance "STAGE1GOV010"}
   :provenance
   {:owner :gravity-source
    :stage :stage1
    :purpose :reader-formal-release-governance-assumption-replacement
    :retirement-objective
    :replace-human-release-governance-and-deployment-custody-with-formal-release-governance-while-keeping-full-compiler-self-hosting-explicit}})

(defn stage1-read-source [source-path source-text]
  (reader/read-with-table source-path source-text stage1-reader-table))

(defn stage1-read-source-pipeline [source-path source-text]
  (let [token-stream (reader/scan-tokens source-path
                                         source-text
                                         stage1-reader-table)]
    (reader/forms-from-tokens source-path
                              source-text
                              stage1-reader-table
                              token-stream)))

(defn stage1-read-source-character-pipeline [source-path source-text]
  (let [character-stream (reader/source-characters source-path source-text)
        token-stream (reader/tokens-from-characters source-path
                                                   source-text
                                                   stage1-reader-table
                                                   character-stream)]
    (reader/forms-from-tokens source-path
                              source-text
                              stage1-reader-table
                              token-stream)))

(defn stage1-read-source-token-classifier-pipeline [source-path source-text]
  (let [character-stream (reader/source-characters source-path source-text)
        token-stream (reader/tokens-from-classifier source-path
                                                   source-text
                                                   stage1-reader-token-classifier
                                                   character-stream)]
    (reader/forms-from-tokens source-path
                              source-text
                              stage1-reader-table
                              token-stream)))

(defn stage1-read-source-token-realizer-pipeline [source-path source-text]
  (let [character-stream (reader/source-characters source-path source-text)
        token-stream (reader/realize-tokens source-path
                                           source-text
                                           stage1-reader-token-classifier
                                           stage1-reader-token-realizer
                                           character-stream)]
    (reader/forms-from-tokens source-path
                              source-text
                              stage1-reader-table
                              token-stream)))

(defn stage1-read-source-token-automaton-pipeline [source-path source-text]
  (let [character-stream (reader/source-characters source-path source-text)
        token-stream (reader/run-token-automaton source-path
                                                source-text
                                                stage1-reader-token-classifier
                                                stage1-reader-token-realizer
                                                stage1-reader-token-automaton
                                                character-stream)]
    (reader/forms-from-tokens source-path
                              source-text
                              stage1-reader-table
                              token-stream)))

(defn stage1-read-source-form-builder-pipeline [source-path source-text]
  (let [character-stream (reader/source-characters source-path source-text)
        token-stream (reader/run-token-automaton source-path
                                                source-text
                                                stage1-reader-token-classifier
                                                stage1-reader-token-realizer
                                                stage1-reader-token-automaton
                                                character-stream)]
    (reader/build-forms source-path
                        source-text
                        stage1-reader-token-classifier
                        stage1-reader-token-realizer
                        stage1-reader-token-automaton
                        stage1-reader-form-builder
                        token-stream)))

(defn stage1-execute-token-automaton [source-path
                                      source-text
                                      token-classifier
                                      token-realizer
                                      token-automaton
                                      token-automaton-executor
                                      character-stream]
  (quote {:gravity-executor :token-automaton
          :source source-path
          :text source-text
          :classifier token-classifier
          :realizer token-realizer
          :automaton token-automaton
          :executor token-automaton-executor
          :characters character-stream}))

(defn stage1-execute-form-builder [source-path
                                   source-text
                                   token-classifier
                                   token-realizer
                                   token-automaton
                                   form-builder
                                   form-builder-executor
                                   token-stream]
  (quote {:gravity-executor :form-builder
          :source source-path
          :text source-text
          :classifier token-classifier
          :realizer token-realizer
          :automaton token-automaton
          :form-builder form-builder
          :executor form-builder-executor
          :tokens token-stream}))

(defn stage1-create-character-stream [source-path
                                      source-text
                                      source-runtime]
  (quote {:gravity-runtime :source-characters
          :source source-path
          :text source-text
          :runtime source-runtime}))

(defn stage1-read-source-executor-pipeline [source-path source-text]
  (let [character-stream (reader/source-characters source-path source-text)
        token-stream (stage1-execute-token-automaton
                      source-path
                      source-text
                      stage1-reader-token-classifier
                      stage1-reader-token-realizer
                      stage1-reader-token-automaton
                      stage1-reader-token-automaton-executor
                      character-stream)]
    (stage1-execute-form-builder
     source-path
     source-text
     stage1-reader-token-classifier
     stage1-reader-token-realizer
     stage1-reader-token-automaton
     stage1-reader-form-builder
     stage1-reader-form-builder-executor
     token-stream)))

(defn stage1-read-source-runtime-pipeline [source-path source-text]
  (let [character-stream (stage1-create-character-stream
                          source-path
                          source-text
                          stage1-reader-source-runtime)
        token-stream (stage1-execute-token-automaton
                      source-path
                      source-text
                      stage1-reader-token-classifier
                      stage1-reader-token-realizer
                      stage1-reader-token-automaton
                      stage1-reader-token-automaton-executor
                      character-stream)]
    (stage1-execute-form-builder
     source-path
     source-text
     stage1-reader-token-classifier
     stage1-reader-token-realizer
     stage1-reader-token-automaton
     stage1-reader-form-builder
     stage1-reader-form-builder-executor
     token-stream)))

(defn stage1-read-source-compiled-pipeline [source-path source-text]
  (reader/execute-compiled-program
   source-path
   source-text
   stage1-reader-compiled-program))

(defn stage1-read-source-binary-pipeline [source-path source-text]
  (reader/execute-binary
   source-path
   source-text
   stage1-reader-emitted-binary))

(defn stage1-read-source-self-hosted-runtime [source-path source-text]
  (reader/execute-self-hosted-runtime
   source-path
   source-text
   stage1-reader-self-hosted-runtime))

(defn stage1-read-source-core-bootstrap [source-path source-text]
  (reader/execute-core-bootstrap-runtime
   source-path
   source-text
   stage1-reader-core-bootstrap-runtime
   stage1-reader-core-bootstrap-builtins))

(defn stage1-read-source-compiler-driver [source-path source-text]
  (reader/execute-compiler-driver
   source-path
   source-text
   stage1-reader-compiler-driver
   stage1-reader-core-bootstrap-runtime
   stage1-reader-core-bootstrap-builtins))

(defn stage1-read-source-runtime-entrypoint [source-path source-text]
  (reader/execute-runtime-entrypoint
   source-path
   source-text
   stage1-reader-runtime-entrypoint
   stage1-reader-compiler-driver))

(defn stage1-read-source-runtime-image [source-path source-text]
  (reader/execute-runtime-image
   source-path
   source-text
   stage1-reader-runtime-image
   stage1-reader-runtime-entrypoint))

(defn stage1-read-source-verified-boot-chain [source-path source-text]
  (reader/execute-verified-boot-chain
   source-path
   source-text
   stage1-reader-verified-boot-chain
   stage1-reader-runtime-image))

(defn stage1-read-source-diverse-bootstrap-verification [source-path source-text]
  (reader/execute-diverse-bootstrap-verification
   source-path
   source-text
   stage1-reader-diverse-bootstrap-verification
   stage1-reader-verified-boot-chain))

(defn stage1-read-source-release-attestation-seed-retirement
  [source-path source-text]
  (reader/execute-release-attestation-seed-retirement
   source-path
   source-text
   stage1-reader-release-attestation-seed-retirement
   stage1-reader-diverse-bootstrap-verification
   stage1-reader-verified-boot-chain))

(defn stage1-read-source-formal-release-governance-seed-retirement
  [source-path source-text]
  (reader/execute-formal-release-governance-seed-retirement
   source-path
   source-text
   stage1-reader-formal-release-governance-seed-retirement
   stage1-reader-release-attestation-seed-retirement))

(def stage1-reader-core-bootstrap-runtime
  {:engine :gravity-reader-core-bootstrap-runtime-v1
   :entrypoint :stage1-read-source-core-bootstrap
   :replaces [:clojure-seed-builtins]
   :base-runtime :stage1-reader-self-hosted-runtime
   :core-bootstrap-builtins :stage1-reader-core-bootstrap-builtins
   :input [:source-path :source-text]
   :output :gravity/stage1-reader-form-records
   :direct-stages [{:label :characters
                    :op :stage1-core-bootstrap-create-character-stream
                    :runtime :stage1-reader-source-runtime

; Stage1 Gravity-owned reader skeleton. The Clojure seed verifies this source
; before it can be made executable by a later self-hosting stage.
(ns gravity.bootstrap.reader
  (:profile :meta)
  (:target :jvm)
  (:exports [read-source-form-records stage1-read-source
             stage1-read-source-pipeline
             stage1-read-source-character-pipeline
             stage1-read-source-token-classifier-pipeline
             stage1-read-source-token-realizer-pipeline
             stage1-read-source-token-automaton-pipeline
             stage1-read-source-form-builder-pipeline
             stage1-read-source-executor-pipeline
             stage1-read-source-runtime-pipeline
             stage1-read-source-compiled-pipeline
             stage1-read-source-binary-pipeline
             stage1-read-source-self-hosted-runtime
             stage1-read-source-core-bootstrap
             stage1-read-source-compiler-driver
             stage1-read-source-runtime-entrypoint
             stage1-read-source-runtime-image
             stage1-read-source-verified-boot-chain
             stage1-read-source-diverse-bootstrap-verification
             stage1-read-source-release-attestation-seed-retirement
             stage1-read-source-formal-release-governance-seed-retirement
             sh03-reader-contract
             sh03-reader-bounds
             sh03-read-source-unit
             sh03-verify-reader-result])
  (:effects #{})
  (:capabilities #{})
  (:safety :safe)
  (:metadata {:bootstrap
              {:stage :stage1
               :component :reader
               :owner :gravity-source
               :source-language :gravity
               :seed :clojure-stage0
               :retirement-objective :replace-clojure-seed
               :ambient-authority-denied true
               :documents ["BOOT1" "BOOT2" "BOOT3" "BOOT4"
                           "BOOT5" "BOOT6" "BOOT7" "BOOT8"
                           "C2" "C3" "C15"]
               :implements [:reader :source-locations :abbreviations
                             :reader-diagnostics :reader-entrypoint
                             :reader-pipeline :reader-character-pipeline
                             :reader-token-classifier
                             :reader-token-realizer
                             :reader-token-automaton
                             :reader-form-builder
                             :reader-token-automaton-executor
                             :reader-form-builder-executor
                             :reader-source-runtime
                             :reader-evaluator-runtime
                             :reader-compiled-program
                             :reader-emitted-binary
                             :reader-self-hosted-runtime
                             :reader-core-bootstrap-builtins
                             :reader-compiler-driver
                             :reader-runtime-entrypoint
                             :reader-runtime-image
                             :reader-verified-boot-chain
                             :reader-diverse-bootstrap-verification
                             :reader-release-attestation-seed-retirement
                             :reader-formal-release-governance-seed-retirement
                             :unicode-scalar-carrier-validation
                             :gravity-token-classification
                             :gravity-delimiter-form-building
                             :gravity-literal-policy
                             :gravity-reader-abbreviations
                             :gravity-reader-metadata
                             :gravity-reader-extension-policy
                             :gravity-reader-diagnostics
                             :gravity-reader-result-replay]
               :preserves #{:source-spans :syntax-identity
                            :raw-spellings :literal-descriptors
                            :diagnostic-codes :artifact-provenance}
               :lineage {:verified-by :clojure-stage0
                         :compiled-by :clojure-stage0
                         :next-stage :stage1
                         :replaces [:clojure-reader-subset]}
               :conformance {:accepted-fixture "bootstrap/gravity/src"
                             :rejected-fixtures
                             ["stage1-bootstrap-missing-owner.gravity"
                              "stage1-bootstrap-wrong-profile.gravity"
                              "stage1-bootstrap-ambient-authority.gravity"
                              "stage1-bootstrap-missing-lineage.gravity"
                              "stage1-bootstrap-missing-preserved-fact.gravity"
                              "stage1-bootstrap-incomplete-source-set.gravity"]}}}))

(defn read-source-form-records [source-bytes]
  (quote {:status :stage1-source-owned
          :input source-bytes
          :emits [:forms :source-spans :reader-diagnostics]}))

(def stage1-reader-table
  {:engine :gravity-reader-table-v1
   :line-comment ";"
   :string-delimiter "\""
   :whitespace [" " "\n" "\r" "\t" ","]
   :delimiters {"(" {:kind :list-open :closes ")"}
                "[" {:kind :vector-open :closes "]"}
                "{" {:kind :map-open :closes "}"}
                ")" {:kind :close}
                "]" {:kind :close}
                "}" {:kind :close}}
   :dispatch {"#" {"{" {:kind :set-open :closes "}"}}}
   :literal-kinds [:nil :boolean :integer :string :keyword :symbol
                   :list :vector :map :set]
   :diagnostics {:unexpected-close "STAGE1READER001"
                 :unclosed-form "STAGE1READER002"
                 :unclosed-string "STAGE1READER003"
                 :unsupported-dispatch "STAGE1READER004"
                 :odd-map "STAGE1READER005"
                 :missing-table "STAGE1READER006"}
   :accepted-fixture "bootstrap/clojure/fixtures/accepted/stage1-reader-execution.gravity"
   :rejected-fixtures {"bootstrap/clojure/fixtures/rejected/stage1-reader-unexpected-close.gravity"
                       "STAGE1READER001"
                       "bootstrap/clojure/fixtures/rejected/stage1-reader-unclosed-list.gravity"
                       "STAGE1READER002"
                       "bootstrap/clojure/fixtures/rejected/stage1-reader-unclosed-string.gravity"
                       "STAGE1READER003"
                       "bootstrap/clojure/fixtures/rejected/stage1-reader-unsupported-dispatch.gravity"
                       "STAGE1READER004"
                       "bootstrap/clojure/fixtures/rejected/stage1-reader-odd-map.gravity"
                       "STAGE1READER005"}})

(def stage1-reader-token-classifier
  {:engine :gravity-reader-token-classifier-v1
   :derived-from :stage1-reader-table
   :whitespace [" " "\n" "\r" "\t" ","]
   :line-comment ";"
   :string-delimiter "\""
   :delimiters {"(" {:kind :list-open :closes ")"}
                "[" {:kind :vector-open :closes "]"}
                "{" {:kind :map-open :closes "}"}
                ")" {:kind :close}
                "]" {:kind :close}
                "}" {:kind :close}}
   :dispatch {"#" {"{" {:kind :set-open :closes "}"}}}
   :literal-kinds [:nil :boolean :integer :string :keyword :symbol
                   :list :vector :map :set]
   :diagnostics {:unexpected-close "STAGE1READER001"
                 :unclosed-form "STAGE1READER002"
                 :unclosed-string "STAGE1READER003"
                 :unsupported-dispatch "STAGE1READER004"
                 :odd-map "STAGE1READER005"
                 :invalid-classifier "STAGE1CLASS004"}
   :provenance {:owner :gravity-source
                :stage :stage1
                :purpose :reader-token-classification
                :retirement-objective :replace-host-tokenizer}})

(def stage1-reader-token-realizer
  {:engine :gravity-reader-token-realizer-v1
   :derived-from :stage1-reader-token-classifier
   :classifier-engine :gravity-reader-token-classifier-v1
   :table-derived-from :stage1-reader-table
   :emits :gravity/stage1-reader-token-stream
   :token-record-fields [:index :kind :lexeme :span]
   :preserves [:source-spans :raw-spelling :literal-kind :reader-table-id]
   :diagnostics {:unexpected-close "STAGE1READER001"
                 :unclosed-form "STAGE1READER002"
                 :unclosed-string "STAGE1READER003"
                 :unsupported-dispatch "STAGE1READER004"
                 :odd-map "STAGE1READER005"
                 :invalid-realizer "STAGE1REAL004"}
   :provenance {:owner :gravity-source
                :stage :stage1
                :purpose :reader-token-realization
                :retirement-objective :replace-host-token-realizer}})

(def stage1-reader-token-automaton
  {:engine :gravity-reader-token-automaton-v1
   :derived-from :stage1-reader-token-realizer
   :classifier-engine :gravity-reader-token-classifier-v1
   :realizer-engine :gravity-reader-token-realizer-v1
   :input :gravity/stage1-reader-character-stream
   :emits :gravity/stage1-reader-token-stream
   :states [:scan :line-comment :string :atom :dispatch :done]
   :operations [:skip-whitespace :skip-line-comment :read-string-token
                :read-dispatch-token :read-delimiter-token :read-atom-token]
   :token-record-fields [:index :kind :lexeme :span]
   :preserves [:source-spans :raw-spelling :literal-kind
               :reader-table-id :character-index]
   :diagnostics {:unexpected-close "STAGE1READER001"
                 :unclosed-form "STAGE1READER002"
                 :unclosed-string "STAGE1READER003"
                 :unsupported-dispatch "STAGE1READER004"
                 :odd-map "STAGE1READER005"
                 :invalid-automaton "STAGE1AUTO004"}
   :provenance {:owner :gravity-source
                :stage :stage1
                :purpose :reader-token-automaton
                :retirement-objective :replace-host-token-realizer-executor}})

(def stage1-reader-form-builder
  {:engine :gravity-reader-form-builder-v1
   :derived-from :stage1-reader-token-automaton
   :token-automaton-engine :gravity-reader-token-automaton-v1
   :table-derived-from :stage1-reader-table
   :input :gravity/stage1-reader-token-stream
   :emits :gravity/stage1-reader-form-records
   :collection-kinds [:list :vector :map :set]
   :operations [:build-list-form :build-vector-form :build-map-form
                :build-set-form :build-atom-form :build-string-form
                :validate-delimiters :validate-map-arity]
   :form-record-fields [:form :kind :span]
   :preserves [:source-spans :form-index :literal-kind :token-origin]
   :diagnostics {:unexpected-close "STAGE1READER001"
                 :unclosed-form "STAGE1READER002"
                 :unclosed-string "STAGE1READER003"
                 :unsupported-dispatch "STAGE1READER004"
                 :odd-map "STAGE1READER005"
                 :invalid-form-builder "STAGE1FORM004"}
   :provenance {:owner :gravity-source
                :stage :stage1
                :purpose :reader-form-building
                :retirement-objective :replace-host-form-builder}})


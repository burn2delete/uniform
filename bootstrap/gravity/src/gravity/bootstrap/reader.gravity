                :retirement-objective
                :replace-clojure-seed-builtins-with-gravity-core-bootstrap}})

(def stage1-reader-compiler-driver
  {:engine :gravity-reader-compiler-driver-v1
   :entrypoint :stage1-read-source-compiler-driver
   :replaces [:clojure-seed-orchestration]
   :base-runtime :stage1-reader-core-bootstrap-runtime
   :core-bootstrap-builtins :stage1-reader-core-bootstrap-builtins
   :input [:source-path :source-text]
   :output :gravity/stage1-reader-form-records
   :artifact :gravity/stage1-reader-compiler-driver-artifact
   :diagnostic-stream :gravity/stage1-reader-compiler-driver-diagnostic-stream
   :proof-kind :gravity/stage1-reader-compiler-driver-proof
   :host-boundaries [:host-command-invocation :host-file-read]
   :seed-orchestration-fallbacks []
   :driver-operations [:load-reader-source
                       :resolve-stage1-entrypoint
                       :route-source-text

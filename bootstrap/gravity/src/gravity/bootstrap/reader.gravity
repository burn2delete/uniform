                :retirement-objective :replace-host-form-builder-executor}})

(def stage1-reader-source-runtime
  {:engine :gravity-reader-source-runtime-v1
   :family :bootstrap-reader
   :input :gravity/source-text
   :emits :gravity/stage1-reader-character-stream
   :services {:generated [:source-character-stream :source-span-index
                          :source-id]
              :delegated []
              :forbidden [:filesystem :network :shell :environment
                          :dynamic-eval]}
   :operations [:decode-source-text :index-source-characters
                :attach-source-spans :compute-source-id]
   :effects #{}
   :capabilities #{}
   :preserves [:source-spans :source-id :character-index
               :artifact-provenance]
   :diagnostics {:invalid-runtime "STAGE1RUN004"
                 :source-divergence "STAGE1RUN005"}
   :provenance {:owner :gravity-source
                :stage :stage1
                :purpose :reader-source-character-runtime
                :retirement-objective :replace-host-character-stream}})

(def stage1-reader-evaluator-runtime
  {:engine :gravity-reader-evaluator-runtime-v1
   :family :bootstrap-reader
   :executes :stage1-read-source-runtime-pipeline
   :evaluates [:let :function-call :def :defn :quote]
   :runtime-services [:stage1-reader-source-runtime
                      :stage1-reader-token-automaton-executor
                      :stage1-reader-form-builder-executor]
   :remaining-trusted-implementation :clojure-stage0
   :effects #{}
   :capabilities #{}

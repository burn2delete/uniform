(def stage1-reader-core-bootstrap-builtins
  {:engine :gravity-core-bootstrap-builtins-v1
   :profile :meta
   :owner :gravity-source
   :replaces [:clojure-seed-builtins]
   :host-fallbacks []
   :effects #{}
   :capabilities #{}
   :operations [{:op :source-character-stream

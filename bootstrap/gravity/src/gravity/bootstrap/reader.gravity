   :preserves [:source-spans :diagnostic-codes :artifact-provenance
               :stage0-form-parity]
   :diagnostics {:missing-entrypoint "STAGE1CORE001"
                 :unsupported-builtin-operation "STAGE1CORE002"
                 :missing-builtin-record "STAGE1CORE003"
                 :builtin-runtime-divergence "STAGE1CORE004"
                 :illegal-host-fallback "STAGE1CORE005"

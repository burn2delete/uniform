           (get preimage :mutations) resolved-digests)
          error-transfers
          (sh07-resolve-error-transfer-vector
           (get preimage :error-transfers) resolved-digests)
          calls
          (sh07-resolve-call-vector
           (get preimage :calls) resolved-digests)
          lexical-bindings
          (sh07-resolve-lexical-binding-vector
           (get preimage :lexical-bindings) resolved-digests)
          loop-bindings
          (sh07-resolve-loop-binding-vector
           (get preimage :loop-bindings) resolved-digests)
          recur-targets
          (sh07-resolve-recur-target-vector
           (get preimage :recur-targets) resolved-digests)
          recur-transfers
          (sh07-resolve-recur-transfer-vector
           (get preimage :recur-transfers) resolved-digests)
          source-map
          (sh07-resolve-source-map-vector
           (get preimage :source-map) resolved-digests)]
      (if (= (get roots :status) :accepted)
        (if (= (get definitions :status) :accepted)
          (if (= (get nodes :status) :accepted)
            (if (= (get evaluation :status) :accepted)
              (if (= (get control-flow :status) :accepted)
                (if (= (get reference-uses :status) :accepted)
                  (if (= (get var-references :status) :accepted)
                    (if (= (get mutations :status) :accepted)
                      (if (= (get error-transfers :status) :accepted)
                        (if (= (get calls :status) :accepted)
                          (if (= (get lexical-bindings :status) :accepted)
                            (if (= (get loop-bindings :status) :accepted)
                              (if (= (get recur-targets :status) :accepted)
                                (if (= (get recur-transfers :status) :accepted)
                                  (if (= (get source-map :status) :accepted)
                                    (sh07-resolution-success
                                     (sh07-resolved-identity-value
                                      preimage
                                      (get roots :value)
                                      (get definitions :value)
                                      (get nodes :value)
                                      (get evaluation :value)
                                      (get control-flow :value)
                                      (get reference-uses :value)
                                      (get var-references :value)
                                      (get mutations :value)
                                      (get error-transfers :value)
                                      (get calls :value)
                                      (get lexical-bindings :value)
                                      (get loop-bindings :value)
                                      (get recur-targets :value)
                                      (get recur-transfers :value)
                                      (get source-map :value)))
                                    source-map)
                                  recur-transfers)
                                recur-targets)
                              loop-bindings)
                            lexical-bindings)
                          calls)
                        error-transfers)
                      mutations)
                    var-references)
                  reference-uses)
                control-flow)
              evaluation)
            nodes)
          definitions)
        roots))
    (sh07-resolution-failure
     :unexpected-identity-preimage-shape)))

(defn sh07-resolve-provenance-preimage [preimage resolved-digests]
  (if (if (sh07-exact-keys?
           preimage
           #{:domain :core-artifact-id-request :source-revision-id
             :sh06-artifact-id :actual-source-path})
        (= (get preimage :domain)
           :gravity/sh07-b7-core-provenance-binding-v8)
        false)
    (let [artifact-id
          (sh07-resolve-controlled-reference
           (get preimage :core-artifact-id-request)
           resolved-digests)]
      (if (= (get artifact-id :status) :accepted)
        (sh07-resolution-success
         (assoc
          preimage
          :core-artifact-id-request
          (get artifact-id :value)))
        artifact-id))
    (sh07-resolution-failure
     :unexpected-provenance-preimage-shape)))

(defn sh07-resolved-template-value
  [template artifact-id provenance-id roots definitions nodes evaluation
   control-flow reference-uses var-references mutations error-transfers calls
   lexical-bindings loop-bindings
   recur-targets recur-transfers source-map identity provenance]
  (assoc
   (assoc
    (assoc
     (assoc
      (assoc
       (assoc
        (assoc
         (assoc
          (assoc
         (assoc
          (assoc
           (assoc
            (assoc
             (assoc
              (assoc
               (assoc
                (assoc
                 (assoc template :artifact-id-request artifact-id)
                 :provenance-binding-id-request provenance-id)
                :root-core-node-ids roots)
               :definitions definitions)
              :nodes nodes)
            :evaluation-order evaluation)
           :control-flow control-flow)
          :reference-uses reference-uses)
         :var-references var-references)
         :mutations mutations)
        :error-transfers error-transfers)
       :calls calls)
      :lexical-bindings lexical-bindings)
     :loop-bindings loop-bindings)
    :recur-targets recur-targets)
   :recur-transfers recur-transfers)
   :source-map source-map)
  :identity-preimage identity
  :provenance-binding-preimage provenance))

(defn sh07-resolve-core-template [template resolved-digests]
  (if (sh07-exact-keys?
       template
       #{:artifact :schema-version :artifact-id-request
         :provenance-binding-id-request :module :lineage
         :projection-binding :root-core-node-ids :definitions
         :nodes :evaluation-order :control-flow :reference-uses
         :var-references :mutations :error-transfers :calls
         :lexical-bindings :loop-bindings
         :recur-targets :recur-transfers :source-map
         :preserved-resolution :macro-expansion-trace
         :macro-origin-traces
         :macro-origin-expectation
         :pending-fact-families :identity-preimage
         :provenance-binding-preimage :provenance :diagnostics})
    (if (if (= (get template :artifact)
               :gravity/sh07-canonical-core-template)
          (= (get template :schema-version) 8)
          false)
      (let [artifact-id
            (sh07-resolve-controlled-reference
             (get template :artifact-id-request)
             resolved-digests)
            provenance-id
            (sh07-resolve-controlled-reference
             (get template :provenance-binding-id-request)
             resolved-digests)
            roots
            (sh07-resolve-reference-vector
             (get template :root-core-node-ids)
             resolved-digests)
            definitions
            (sh07-resolve-definition-vector
             (get template :definitions) resolved-digests)
            nodes
            (sh07-resolve-node-vector
             (get template :nodes) resolved-digests)
            evaluation
            (sh07-resolve-evaluation-vector
             (get template :evaluation-order)
             resolved-digests)
            control-flow
            (sh07-resolve-control-flow-vector
             (get template :control-flow)
             resolved-digests)
            reference-uses
            (sh07-resolve-reference-use-vector
             (get template :reference-uses)
             resolved-digests)
            var-references
            (sh07-resolve-var-reference-vector
             (get template :var-references)
             resolved-digests)
            mutations
            (sh07-resolve-mutation-vector
             (get template :mutations)
             resolved-digests)
            error-transfers
            (sh07-resolve-error-transfer-vector
             (get template :error-transfers)
             resolved-digests)
            calls
            (sh07-resolve-call-vector
             (get template :calls)
             resolved-digests)
            lexical-bindings
            (sh07-resolve-lexical-binding-vector
             (get template :lexical-bindings)
             resolved-digests)
            loop-bindings
            (sh07-resolve-loop-binding-vector
             (get template :loop-bindings)
             resolved-digests)
            recur-targets
            (sh07-resolve-recur-target-vector
             (get template :recur-targets)
             resolved-digests)
            recur-transfers
            (sh07-resolve-recur-transfer-vector
             (get template :recur-transfers)
             resolved-digests)
            source-map
            (sh07-resolve-source-map-vector
             (get template :source-map)
             resolved-digests)
            identity
            (sh07-resolve-identity-preimage
             (get template :identity-preimage)
             resolved-digests)
            provenance
            (sh07-resolve-provenance-preimage
             (get template :provenance-binding-preimage)
             resolved-digests)]
        (if (= (get artifact-id :status) :accepted)
          (if (= (get provenance-id :status) :accepted)
            (if (= (get roots :status) :accepted)
              (if (= (get definitions :status) :accepted)
                (if (= (get nodes :status) :accepted)
                  (if (= (get evaluation :status) :accepted)
                    (if (= (get control-flow :status) :accepted)
                      (if (= (get reference-uses :status) :accepted)
                        (if (= (get var-references :status) :accepted)
                          (if (= (get mutations :status) :accepted)
                            (if (= (get error-transfers :status) :accepted)
                              (if (= (get calls :status) :accepted)
                              (if (= (get lexical-bindings :status) :accepted)
                                (if (= (get loop-bindings :status) :accepted)
                                  (if (= (get recur-targets :status) :accepted)
                                    (if (= (get recur-transfers :status) :accepted)
                                (if (= (get source-map :status) :accepted)
                                  (if (= (get identity :status) :accepted)
                                    (if (= (get provenance :status) :accepted)
                                      (sh07-resolution-success
                                       (sh07-resolved-template-value
                                        template
                                        (get artifact-id :value)
                                        (get provenance-id :value)
                                        (get roots :value)
                                        (get definitions :value)
                                        (get nodes :value)
                                        (get evaluation :value)
                                        (get control-flow :value)
                                        (get reference-uses :value)
                                        (get var-references :value)
                                        (get mutations :value)
                                        (get error-transfers :value)
                                        (get calls :value)
                                        (get lexical-bindings :value)
                                        (get loop-bindings :value)
                                        (get recur-targets :value)
                                        (get recur-transfers :value)
                                        (get source-map :value)
                                        (get identity :value)
                                        (get provenance :value)))
                                      provenance)
                                    identity)
                                  source-map)
                                      recur-transfers)
                                    recur-targets)
                                  loop-bindings)
                                lexical-bindings)
                              calls)
                              error-transfers)
                            mutations)
                          var-references)
                        reference-uses)
                      control-flow)
                    evaluation)
                  nodes)
                definitions)
              roots)
            provenance-id)
          artifact-id))
      (sh07-resolution-failure
       :unexpected-core-template-artifact))
    (sh07-resolution-failure
     :unexpected-core-template-shape)))

(defn sh07-resolved-digests-shape? [requests resolved-digests]
  (if (= (count requests) (count resolved-digests))
    (loop [remaining resolved-digests]
      (if (= (count remaining) 0)
        true
        (if (sh07-sha256-id? (first remaining))
          (recur (rest remaining))
          false)))
    false))

(defn sh07-verify-core-resolved
  [request resolved-core digest-requests resolved-digests]
  (let [resolved-carrier (sh07-carrier-preflight resolved-core)
        requests-carrier (sh07-carrier-preflight digest-requests)
        digests-carrier (sh07-carrier-preflight resolved-digests)]
    (if (= (get resolved-carrier :status) :accepted)
      (if (= (get requests-carrier :status) :accepted)
        (if (= (get digests-carrier :status) :accepted)
          (let [rebuilt (sh07-build-core-template request)]
            (if (= (get rebuilt :status) :accepted)
      (if (= digest-requests (get rebuilt :digest-requests))
        (if (sh07-digest-request-sequence? digest-requests)
          (if (sh07-resolved-digests-shape?
               digest-requests resolved-digests)
            (let [expected
                  (sh07-resolve-core-template
                   (get rebuilt :core-template)
                   resolved-digests)]
              (if (= (get expected :status) :accepted)
                (if (= resolved-core (get expected :value))
                  {:artifact :gravity/sh07-core-resolved-verification
                   :schema-version 8 :status :passed :rule nil}
                  {:artifact :gravity/sh07-core-resolved-verification
                   :schema-version 8 :status :rejected :rule "C6-VERIFY"})
                {:artifact :gravity/sh07-core-resolved-verification
                 :schema-version 8 :status :rejected :rule "C6-VERIFY"}))
            {:artifact :gravity/sh07-core-resolved-verification
             :schema-version 8 :status :rejected :rule "C6-VERIFY"})
          {:artifact :gravity/sh07-core-resolved-verification
           :schema-version 8 :status :rejected :rule "C6-VERIFY"})
        {:artifact :gravity/sh07-core-resolved-verification
         :schema-version 8 :status :rejected :rule "C6-VERIFY"})
      {:artifact :gravity/sh07-core-resolved-verification
       :schema-version 8 :status :rejected :rule "C6-VERIFY"}))
          {:artifact :gravity/sh07-core-resolved-verification
           :schema-version 8 :status :rejected :rule "C6-VERIFY"})
        {:artifact :gravity/sh07-core-resolved-verification
         :schema-version 8 :status :rejected :rule "C6-VERIFY"})
      {:artifact :gravity/sh07-core-resolved-verification
       :schema-version 8 :status :rejected :rule "C6-VERIFY"})))

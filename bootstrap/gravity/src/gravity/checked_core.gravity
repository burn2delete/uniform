(defn sh07-resolved-identity-value
  [preimage roots definitions nodes evaluation control-flow
   reference-uses var-references mutations error-transfers error-handlers calls
   keyword-lookups
   match-branch-records match-decision-skeletons match-pattern-records
   lexical-bindings loop-bindings
   recur-targets recur-transfers source-map]
  (let [value-01 (assoc preimage :root-core-node-ids roots)
        value-02 (assoc value-01 :definitions definitions)
        value-03 (assoc value-02 :nodes nodes)
        value-04 (assoc value-03 :evaluation-order evaluation)
        value-05 (assoc value-04 :control-flow control-flow)
        value-06 (assoc value-05 :reference-uses reference-uses)
        value-07 (assoc value-06 :var-references var-references)
        value-08 (assoc value-07 :mutations mutations)
        value-09 (assoc value-08 :error-transfers error-transfers)
        value-10 (assoc value-09 :error-handlers error-handlers)
        value-11
        (assoc value-10 :match-branch-records match-branch-records)
        value-12
        (assoc
         value-11 :match-decision-skeletons
         match-decision-skeletons)
        value-13
        (assoc value-12 :match-pattern-records match-pattern-records)
        value-14 (assoc value-13 :calls calls)
        value-15 (assoc value-14 :keyword-lookups keyword-lookups)
        value-16 (assoc value-15 :lexical-bindings lexical-bindings)
        value-17 (assoc value-16 :loop-bindings loop-bindings)
        value-18 (assoc value-17 :recur-targets recur-targets)
        value-19 (assoc value-18 :recur-transfers recur-transfers)]
    (assoc value-19 :source-map source-map)))

(defn sh07-resolve-identity-preimage [preimage resolved-digests]
  (if (if (sh07-exact-keys?
           preimage
           #{:domain :lineage :projection-binding :module
             :fragment-manifest :fragment-coverage
             :module-assembly-manifest
             :root-core-node-ids :definitions :nodes
             :evaluation-order :control-flow :reference-uses
             :var-references :mutations :error-transfers :error-handlers :calls
             :keyword-lookups
             :match-branch-records :match-decision-skeletons
             :match-pattern-records
             :lexical-bindings :loop-bindings
             :recur-targets :recur-transfers
             :source-map :binding-table
             :declared-alias-table
             :resolution-table :macro-expansion-trace
             :macro-origin-traces
             :macro-origin-expectation
             :pending-fact-families})
        (= (get preimage :domain)
           :gravity/sh07-b15-canonical-core-v15)
        false)
    (let [fragments
          (sh07-resolve-b13-fragment-vector
           (get preimage :fragment-manifest) resolved-digests)
          roots
          (sh07-resolve-reference-vector
           (get preimage :root-core-node-ids) resolved-digests)
          definitions
          (sh07-resolve-definition-vector
           (get preimage :definitions) resolved-digests)
          nodes
          (sh07-resolve-node-vector
           (get preimage :nodes) resolved-digests)
          evaluation
          (sh07-resolve-evaluation-vector
           (get preimage :evaluation-order) resolved-digests)
          control-flow
          (sh07-resolve-control-flow-vector
           (get preimage :control-flow) resolved-digests)
          reference-uses
          (sh07-resolve-reference-use-vector
           (get preimage :reference-uses) resolved-digests)
          var-references
          (sh07-resolve-var-reference-vector
           (get preimage :var-references) resolved-digests)
          mutations
          (sh07-resolve-mutation-vector
           (get preimage :mutations) resolved-digests)
          error-transfers
          (sh07-resolve-error-transfer-vector
           (get preimage :error-transfers) resolved-digests)
          error-handlers
          (sh07-resolve-error-handler-vector
           (get preimage :error-handlers) resolved-digests)
          match-branch-records
          (sh07-resolve-module-match-branch-vector
           (get preimage :match-branch-records) resolved-digests)
          match-decision-skeletons
          (sh07-resolve-module-match-decision-skeleton-vector
           (get preimage :match-decision-skeletons)
           resolved-digests)
          match-pattern-records
          (sh07-resolve-module-match-pattern-vector
           (get preimage :match-pattern-records)
           resolved-digests)
          calls
          (sh07-resolve-call-vector
           (get preimage :calls) resolved-digests)
          keyword-lookups
          (sh07-resolve-keyword-lookup-vector
           (get preimage :keyword-lookups) resolved-digests)
          lexical-bindings
          (sh07-resolve-lexical-binding-vector
           (get preimage :lexical-bindings) resolved-digests)
          loop-bindings
          (sh07-resolve-loop-binding-vector
           (get preimage :loop-bindings) resolved-digests)
          recur-targets
          (sh07-resolve-recur-target-vector
           (get preimage :recur-targets) resolved-digests)
          recur-transfers
          (sh07-resolve-recur-transfer-vector
           (get preimage :recur-transfers) resolved-digests)
          source-map
          (sh07-resolve-source-map-vector
           (get preimage :source-map) resolved-digests)]
      (if (= (get fragments :status) :accepted)
      (if (= (get roots :status) :accepted)
        (if (= (get definitions :status) :accepted)
          (if (= (get nodes :status) :accepted)
            (if (= (get evaluation :status) :accepted)
              (if (= (get control-flow :status) :accepted)
                (if (= (get reference-uses :status) :accepted)
                  (if (= (get var-references :status) :accepted)
                    (if (= (get mutations :status) :accepted)
                      (if (= (get error-transfers :status) :accepted)
                        (if (= (get error-handlers :status) :accepted)
                          (if (= (get match-branch-records :status)
                                 :accepted)
                            (if (= (get match-decision-skeletons :status)
                                   :accepted)
                              (if (= (get match-pattern-records :status)
                                     :accepted)
                          (if (= (get calls :status) :accepted)
                          (if (= (get keyword-lookups :status) :accepted)
                          (if (= (get lexical-bindings :status) :accepted)
                            (if (= (get loop-bindings :status) :accepted)
                              (if (= (get recur-targets :status) :accepted)
                                (if (= (get recur-transfers :status) :accepted)
                                  (if (= (get source-map :status) :accepted)
                                    (sh07-resolution-success
                                     (sh07-resolved-identity-value
                                      (assoc
                                       preimage
                                       :fragment-manifest
                                       (get fragments :value))
                                      (get roots :value)
                                      (get definitions :value)
                                      (get nodes :value)
                                      (get evaluation :value)
                                      (get control-flow :value)
                                      (get reference-uses :value)
                                      (get var-references :value)
                                      (get mutations :value)
                                      (get error-transfers :value)
                                      (get error-handlers :value)
                                      (get calls :value)
                                      (get keyword-lookups :value)
                                      (get match-branch-records :value)
                                      (get match-decision-skeletons :value)
                                      (get match-pattern-records :value)
                                      (get lexical-bindings :value)
                                      (get loop-bindings :value)
                                      (get recur-targets :value)
                                      (get recur-transfers :value)
                                      (get source-map :value)))
                                    source-map)
                                  recur-transfers)
                                recur-targets)
                              loop-bindings)
                            lexical-bindings)
                            keyword-lookups)
                            calls)
                            match-pattern-records)
                          match-decision-skeletons)
                          match-branch-records)
                          error-handlers)
                        error-transfers)
                      mutations)
                    var-references)
                  reference-uses)
                control-flow)
              evaluation)
            nodes)
          definitions)
        roots)
        fragments))
    (sh07-resolution-failure
     :unexpected-identity-preimage-shape)))

(defn sh07-resolve-provenance-preimage [preimage resolved-digests]
  (if (if (sh07-exact-keys?
           preimage
           #{:domain :core-artifact-id-request :source-revision-id
             :sh06-artifact-id :actual-source-path})
        (= (get preimage :domain)
           :gravity/sh07-b15-core-provenance-binding-v15)
        false)
    (let [artifact-id
          (sh07-resolve-controlled-reference
           (get preimage :core-artifact-id-request)
           resolved-digests)]
      (if (= (get artifact-id :status) :accepted)
        (sh07-resolution-success
         (assoc
          preimage
          :core-artifact-id-request
          (get artifact-id :value)))
        artifact-id))
    (sh07-resolution-failure
     :unexpected-provenance-preimage-shape)))

(defn sh07-resolved-template-value
  [template artifact-id provenance-id roots definitions nodes evaluation
   control-flow reference-uses var-references mutations error-transfers
   error-handlers calls keyword-lookups
   match-branch-records match-decision-skeletons match-pattern-records
   lexical-bindings loop-bindings
   recur-targets recur-transfers source-map identity provenance]
  (let [value-01 (assoc template :artifact-id-request artifact-id)
        value-02
        (assoc
         value-01 :provenance-binding-id-request provenance-id)
        value-03 (assoc value-02 :root-core-node-ids roots)
        value-04 (assoc value-03 :definitions definitions)
        value-05 (assoc value-04 :nodes nodes)
        value-06 (assoc value-05 :evaluation-order evaluation)
        value-07 (assoc value-06 :control-flow control-flow)
        value-08 (assoc value-07 :reference-uses reference-uses)
        value-09 (assoc value-08 :var-references var-references)
        value-10 (assoc value-09 :mutations mutations)
        value-11 (assoc value-10 :error-transfers error-transfers)
        value-12 (assoc value-11 :error-handlers error-handlers)
        value-13
        (assoc value-12 :match-branch-records match-branch-records)
        value-14
        (assoc
         value-13 :match-decision-skeletons
         match-decision-skeletons)
        value-15
        (assoc value-14 :match-pattern-records match-pattern-records)
        value-16 (assoc value-15 :calls calls)
        value-17 (assoc value-16 :keyword-lookups keyword-lookups)
        value-18 (assoc value-17 :lexical-bindings lexical-bindings)
        value-19 (assoc value-18 :loop-bindings loop-bindings)
        value-20 (assoc value-19 :recur-targets recur-targets)
        value-21 (assoc value-20 :recur-transfers recur-transfers)
        value-22 (assoc value-21 :source-map source-map)
        value-23 (assoc value-22 :identity-preimage identity)]
    (assoc value-23 :provenance-binding-preimage provenance)))

(defn sh07-resolve-core-template [template resolved-digests]
  (if (sh07-exact-keys?
       template
       #{:artifact :schema-version :artifact-id-request
         :provenance-binding-id-request :module :lineage
         :projection-binding :fragment-manifest
         :fragment-coverage :module-assembly-manifest
         :root-core-node-ids :definitions
         :nodes :evaluation-order :control-flow :reference-uses
         :var-references :mutations :error-transfers :error-handlers :calls
         :keyword-lookups
         :match-branch-records :match-decision-skeletons
         :match-pattern-records
         :lexical-bindings :loop-bindings
         :recur-targets :recur-transfers :source-map
         :declared-alias-table
         :preserved-resolution :macro-expansion-trace
         :macro-origin-traces
         :macro-origin-expectation
         :pending-fact-families :identity-preimage
         :provenance-binding-preimage :provenance :diagnostics})
    (if (if (= (get template :artifact)
               :gravity/sh07-canonical-core-template)
          (= (get template :schema-version) 15)
          false)
      (let [artifact-id
            (sh07-resolve-controlled-reference
             (get template :artifact-id-request)
             resolved-digests)
            provenance-id
            (sh07-resolve-controlled-reference
             (get template :provenance-binding-id-request)
             resolved-digests)
            fragments
            (sh07-resolve-b13-fragment-vector
             (get template :fragment-manifest)
             resolved-digests)
            roots
            (sh07-resolve-reference-vector
             (get template :root-core-node-ids)
             resolved-digests)
            definitions
            (sh07-resolve-definition-vector
             (get template :definitions) resolved-digests)
            nodes
            (sh07-resolve-node-vector
             (get template :nodes) resolved-digests)
            evaluation
            (sh07-resolve-evaluation-vector
             (get template :evaluation-order)
             resolved-digests)
            control-flow
            (sh07-resolve-control-flow-vector
             (get template :control-flow)
             resolved-digests)
            reference-uses
            (sh07-resolve-reference-use-vector
             (get template :reference-uses)
             resolved-digests)
            var-references
            (sh07-resolve-var-reference-vector
             (get template :var-references)
             resolved-digests)
            mutations
            (sh07-resolve-mutation-vector
             (get template :mutations)
             resolved-digests)
            error-transfers
            (sh07-resolve-error-transfer-vector
             (get template :error-transfers)
             resolved-digests)
            error-handlers
            (sh07-resolve-error-handler-vector
             (get template :error-handlers)
             resolved-digests)
            match-branch-records
            (sh07-resolve-module-match-branch-vector
             (get template :match-branch-records)
             resolved-digests)
            match-decision-skeletons
            (sh07-resolve-module-match-decision-skeleton-vector
             (get template :match-decision-skeletons)
             resolved-digests)
            match-pattern-records
            (sh07-resolve-module-match-pattern-vector
             (get template :match-pattern-records)
             resolved-digests)
            calls
            (sh07-resolve-call-vector
             (get template :calls)
             resolved-digests)
            keyword-lookups
            (sh07-resolve-keyword-lookup-vector
             (get template :keyword-lookups)
             resolved-digests)
            lexical-bindings
            (sh07-resolve-lexical-binding-vector
             (get template :lexical-bindings)
             resolved-digests)
            loop-bindings
            (sh07-resolve-loop-binding-vector
             (get template :loop-bindings)
             resolved-digests)
            recur-targets
            (sh07-resolve-recur-target-vector
             (get template :recur-targets)
             resolved-digests)
            recur-transfers
            (sh07-resolve-recur-transfer-vector
             (get template :recur-transfers)
             resolved-digests)
            source-map
            (sh07-resolve-source-map-vector
             (get template :source-map)
             resolved-digests)
            identity
            (sh07-resolve-identity-preimage
             (get template :identity-preimage)
             resolved-digests)
            provenance
            (sh07-resolve-provenance-preimage
             (get template :provenance-binding-preimage)
             resolved-digests)]
        (if (= (get artifact-id :status) :accepted)
          (if (= (get provenance-id :status) :accepted)
            (if (= (get fragments :status) :accepted)
            (if (= (get roots :status) :accepted)
              (if (= (get definitions :status) :accepted)
                (if (= (get nodes :status) :accepted)
                  (if (= (get evaluation :status) :accepted)
                    (if (= (get control-flow :status) :accepted)
                      (if (= (get reference-uses :status) :accepted)
                        (if (= (get var-references :status) :accepted)
                          (if (= (get mutations :status) :accepted)
                            (if (= (get error-transfers :status) :accepted)
                              (if (= (get error-handlers :status) :accepted)
                                (if (= (get match-branch-records :status)
                                       :accepted)
                                  (if (= (get match-decision-skeletons :status)
                                         :accepted)
                                    (if (= (get match-pattern-records :status)
                                           :accepted)
                                (if (= (get calls :status) :accepted)
                              (if (= (get keyword-lookups :status) :accepted)
                              (if (= (get lexical-bindings :status) :accepted)
                                (if (= (get loop-bindings :status) :accepted)
                                  (if (= (get recur-targets :status) :accepted)
                                    (if (= (get recur-transfers :status) :accepted)
                                (if (= (get source-map :status) :accepted)
                                  (if (= (get identity :status) :accepted)
                                    (if (= (get provenance :status) :accepted)
                                      (sh07-resolution-success
                                       (sh07-resolved-template-value
                                        (assoc
                                         template
                                         :fragment-manifest
                                         (get fragments :value))
                                        (get artifact-id :value)
                                        (get provenance-id :value)
                                        (get roots :value)
                                        (get definitions :value)
                                        (get nodes :value)
                                        (get evaluation :value)
                                        (get control-flow :value)
                                        (get reference-uses :value)
                                        (get var-references :value)
                                        (get mutations :value)
                                        (get error-transfers :value)
                                        (get error-handlers :value)
                                        (get calls :value)
                                        (get keyword-lookups :value)
                                        (get match-branch-records :value)
                                        (get match-decision-skeletons :value)
                                        (get match-pattern-records :value)
                                        (get lexical-bindings :value)
                                        (get loop-bindings :value)
                                        (get recur-targets :value)
                                        (get recur-transfers :value)
                                        (get source-map :value)
                                        (get identity :value)
                                        (get provenance :value)))
                                      provenance)
                                    identity)
                                  source-map)
                                      recur-transfers)
                                    recur-targets)
                                  loop-bindings)
                                lexical-bindings)
                                keyword-lookups)
                                calls)
                                match-pattern-records)
                              match-decision-skeletons)
                              match-branch-records)
                              error-handlers)
                              error-transfers)
                            mutations)
                          var-references)
                        reference-uses)
                      control-flow)
                    evaluation)
                  nodes)
                definitions)
              roots)
              fragments)
            provenance-id)
          artifact-id))
      (sh07-resolution-failure
       :unexpected-core-template-artifact))
    (sh07-resolution-failure
     :unexpected-core-template-shape)))

(defn sh07-resolved-digests-shape? [requests resolved-digests]
  (if (= (count requests) (count resolved-digests))
    (loop [remaining resolved-digests]
      (if (= (count remaining) 0)
        true
        (if (sh07-sha256-id? (first remaining))
          (recur (rest remaining))
          false)))
    false))

(defn sh07-verify-core-resolved
  [request resolved-core digest-requests resolved-digests]
  (let [resolved-carrier (sh07-carrier-preflight resolved-core)
        requests-carrier (sh07-carrier-preflight digest-requests)
        digests-carrier (sh07-carrier-preflight resolved-digests)]
    (if (= (get resolved-carrier :status) :accepted)
      (if (= (get requests-carrier :status) :accepted)
        (if (= (get digests-carrier :status) :accepted)
          (let [rebuilt (sh07-build-core-template request)]
            (if (= (get rebuilt :status) :accepted)
      (if (= digest-requests (get rebuilt :digest-requests))
        (if (sh07-digest-request-sequence? digest-requests)
          (if (sh07-resolved-digests-shape?
               digest-requests resolved-digests)
            (let [expected
                  (sh07-resolve-core-template
                   (get rebuilt :core-template)
                   resolved-digests)]
              (if (= (get expected :status) :accepted)
                (if (= resolved-core (get expected :value))
                  {:artifact :gravity/sh07-core-resolved-verification
                   :schema-version 15 :status :passed :rule nil}
                  {:artifact :gravity/sh07-core-resolved-verification
                   :schema-version 15 :status :rejected :rule "C6-VERIFY"})
                {:artifact :gravity/sh07-core-resolved-verification
                 :schema-version 15 :status :rejected :rule "C6-VERIFY"}))
            {:artifact :gravity/sh07-core-resolved-verification
             :schema-version 15 :status :rejected :rule "C6-VERIFY"})
          {:artifact :gravity/sh07-core-resolved-verification
           :schema-version 15 :status :rejected :rule "C6-VERIFY"})
        {:artifact :gravity/sh07-core-resolved-verification
         :schema-version 15 :status :rejected :rule "C6-VERIFY"})
      {:artifact :gravity/sh07-core-resolved-verification
       :schema-version 15 :status :rejected :rule "C6-VERIFY"}))
          {:artifact :gravity/sh07-core-resolved-verification
           :schema-version 15 :status :rejected :rule "C6-VERIFY"})
        {:artifact :gravity/sh07-core-resolved-verification
         :schema-version 15 :status :rejected :rule "C6-VERIFY"})
      {:artifact :gravity/sh07-core-resolved-verification
       :schema-version 15 :status :rejected :rule "C6-VERIFY"})))

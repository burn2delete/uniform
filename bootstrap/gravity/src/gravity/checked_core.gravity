(defn sh07-resolve-control-flow-branch
  [branch expected-role expected-predicate resolved-digests]
  (if (sh07-exact-keys?
       branch #{:role :predicate :core-node-id})
    (if (= (get branch :role) expected-role)
      (if (= (get branch :predicate) expected-predicate)
        (let [node-id
              (sh07-resolve-controlled-reference
               (get branch :core-node-id) resolved-digests)]
          (if (= (get node-id :status) :accepted)
            (sh07-resolution-success
             (assoc branch :core-node-id (get node-id :value)))
            node-id))
        (sh07-resolution-failure
         :control-flow-branch-predicate))
      (sh07-resolution-failure :control-flow-branch-role))
    (sh07-resolution-failure
     :control-flow-branch-shape)))

(defn sh07-resolve-if-control-flow [record resolved-digests]
  (if (sh07-exact-keys?
       record
       #{:core-node-id :kind :condition-node-id :branches
         :branch-exclusivity :truthiness :result-policy})
    (let [branches (get record :branches)]
      (if (if (vector? branches) (= (count branches) 2) false)
        (let [core-node-id
              (sh07-resolve-controlled-reference
               (get record :core-node-id) resolved-digests)
              condition-node-id
              (sh07-resolve-controlled-reference
               (get record :condition-node-id) resolved-digests)
              then-branch
              (sh07-resolve-control-flow-branch
               (get branches 0) :then :truthy resolved-digests)
              else-branch
              (sh07-resolve-control-flow-branch
               (get branches 1) :else :falsey resolved-digests)]
          (if (= (get core-node-id :status) :accepted)
            (if (= (get condition-node-id :status) :accepted)
              (if (= (get then-branch :status) :accepted)
                (if (= (get else-branch :status) :accepted)
                  (if (= (get record :branch-exclusivity)
                         :exactly-one)
                    (if (= (get record :truthiness)
                           {:false-values [:nil :false]
                            :other-values :true})
                      (if (= (get record :result-policy)
                             :selected-branch)
                        (sh07-resolution-success
                         (assoc
                          (assoc
                           (assoc record
                                  :core-node-id
                                  (get core-node-id :value))
                           :condition-node-id
                           (get condition-node-id :value))
                          :branches
                          [(get then-branch :value)
                           (get else-branch :value)]))
                        (sh07-resolution-failure
                         :if-result-policy))
                      (sh07-resolution-failure
                       :if-truthiness-policy))
                    (sh07-resolution-failure
                     :if-branch-exclusivity))
                  else-branch)
                then-branch)
              condition-node-id)
            core-node-id))
        (sh07-resolution-failure
         :if-control-flow-branches)))
    (sh07-resolution-failure
     :if-control-flow-shape)))

(defn sh07-resolve-do-control-flow [record resolved-digests]
  (if (sh07-exact-keys?
       record
       #{:core-node-id :kind :ordered-child-node-ids
         :evaluation-order :result-policy})
    (let [core-node-id
          (sh07-resolve-controlled-reference
           (get record :core-node-id) resolved-digests)
          children
          (sh07-resolve-reference-vector
           (get record :ordered-child-node-ids) resolved-digests)
          policy (get record :result-policy)
          result-node-id
          (if (sh07-exact-keys?
               policy #{:kind :core-node-id})
            (sh07-resolve-controlled-reference
             (get policy :core-node-id) resolved-digests)
            (sh07-resolution-failure
             :do-result-policy-shape))]
      (if (= (get core-node-id :status) :accepted)
        (if (= (get children :status) :accepted)
          (if (> (count (get children :value)) 0)
            (if (= (get record :evaluation-order) :left-to-right)
              (if (= (get policy :kind) :last-child)
                (if (= (get result-node-id :status) :accepted)
                  (if (= (get result-node-id :value)
                         (get
                          (get children :value)
                          (- (count (get children :value)) 1)))
                    (sh07-resolution-success
                     (assoc
                      (assoc
                       (assoc record
                              :core-node-id
                              (get core-node-id :value))
                       :ordered-child-node-ids
                       (get children :value))
                      :result-policy
                      {:kind :last-child
                       :core-node-id
                       (get result-node-id :value)}))
                    (sh07-resolution-failure
                     :do-result-is-not-last-child))
                  result-node-id)
                (sh07-resolution-failure
                 :do-result-policy-kind))
              (sh07-resolution-failure
               :do-evaluation-order))
            (sh07-resolution-failure
             :do-nonempty-child-order))
          children)
        core-node-id))
    (sh07-resolution-failure
     :do-control-flow-shape)))

(defn sh07-resolve-control-flow-record [record resolved-digests]
  (if (map? record)
    (if (= (get record :kind) :if)
      (sh07-resolve-if-control-flow record resolved-digests)
      (if (= (get record :kind) :do)
        (sh07-resolve-do-control-flow record resolved-digests)
        (sh07-resolution-failure
         :unknown-control-flow-kind)))
    (sh07-resolution-failure
     :control-flow-record-required)))


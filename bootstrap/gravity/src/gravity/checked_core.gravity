; Gravity-owned SH-07-A/B1/B2/B3/B4/B5/B6/B7/B8/B9/B10/B11/B12/B15 core-form lowering leaf.
(ns gravity.checked-core
  (:profile :meta)
  (:target :jvm)
  (:exports [sh07-core-contract
             sh07-core-bounds
             sh07-core-diagnostic-catalog
             sh07-build-core-template
             sh07-verify-core-template
             sh07-verify-core-resolved])
  (:effects #{})
  (:capabilities #{})
  (:safety :safe)
  (:metadata {:bootstrap
              {:stage :stage1
               :component :core-form-lowering
               :owner :gravity-source
               :source-language :gravity
               :seed :clojure-stage0
               :documents ["D0" "D1" "D2" "D3" "D8" "D9"
                           "L2" "L3" "L6" "L9" "C5" "C6" "C15"
                           "BOOT1" "BOOT3"]
               :depends-on [:sh02-authenticated-envelopes
                            :sh06-namespace-and-binding-resolution]
               :implements [:def-core-form
                             :fn-core-form
                             :quote-core-form
                             :if-core-form
                             :do-core-form
                             :simple-symbol-sequential-let
                             :simple-symbol-sequential-loop
                             :tail-recur-nearest-loop-or-fixed-arity-fn
                             :same-namespace-var-object-reference
                             :same-namespace-top-level-set-mutation
                             :standalone-error-transfer
                             :single-typed-error-handler
                             :multiple-typed-error-handlers
                             :foundational-match-lowering
                             :literal-wildcard-and-binding-patterns
                             :fixed-width-recursive-vector-patterns
                             :branch-local-pattern-bindings
                             :resolved-symbol-references
                             :declared-alias-qualified-expression-and-operator-references
                             :symbol-headed-general-calls
                             :one-operand-keyword-map-lookup
                             :scalar-literals
                             :vector-map-set-literals
                             :stable-evaluation-order
                             :branch-exclusive-evaluation
                             :syntax-origin-preservation
                             :resolved-binding-preservation
                             :content-addressed-core-products]
               :preserves #{:source-spans :syntax-identity
                            :macro-expansion-lineage :resolved-bindings
                            :evaluation-order :module-metadata
                            :artifact-provenance}
               :pending [:types :effects :ownership :safety
                         :map-list-set-record-constructor-patterns
                         :variable-width-vector-patterns
                         :duplicate-pattern-binding-policy
                         :guard-patterns
                         :match-exhaustiveness :match-result-type-join
                         :try-finally
                         :try-protected-sequencing
                         :try-handler-sequencing
                         :alias-qualified-type-references
                         :alias-qualified-var-references
                         :alias-qualified-set-mutations
                         :keyword-default-value-lookup
                         :general-callable-keywords
                         :destructuring-bindings :recursion
                         :var-profile-legality-sh09
                         :set-type-legality-sh08
                         :set-effect-profile-capability-legality-sh09
                         :set-ownership-legality-sh10
                         :set-safety-classification-sh11
                         :throw-type-legality-sh08
                         :throw-effect-profile-capability-legality-sh09
                         :throw-error-lowering-legality-sh09
                         :throw-ownership-legality-sh10
                         :throw-safety-classification-sh11]
               :claim-boundary [:sh07-b15-keyword-map-lookup-subset-v15
                                :coordinator-projected-sh06-input-required
                                :not-complete-c6
                                :not-checked-core
                                :not-self-hosting
                                :not-target-support]}}))

(def sh07-core-contract
  {:artifact :gravity/sh07-core-contract
   :schema-version 15
   :owner :gravity-source
   :governing-contracts ["L2" "L3" "L6" "L7" "L9" "C5" "C6"]
   :authenticated-dependencies ["SH-02" "SH-06"]
   :input :gravity/sh07-authenticated-sh06-core-request
   :output :gravity/sh07-core-template-result
   :resolved-output :gravity/sh07-canonical-core-artifact
   :identity-domain :gravity/sh07-b15-core-v15
   :authoritative-entry 'sh07-build-core-template
   :template-verifier-entry 'sh07-verify-core-template
   :resolved-verifier-entry 'sh07-verify-core-resolved
   :supported-core-forms
   ['def 'fn 'quote 'if 'do 'let 'loop 'recur 'var 'set! 'throw 'try
    'match]
   :supported-literal-kinds
   [:nil :boolean :integer :decimal :ratio :character :string
    :keyword :vector :map :set]
   :pending-fact-families
   [:types :effects :ownership :safety]
   :physical-provenance-excluded-from-identity
   [:actual-source-path]
   :recur-target-id-policy
   {:source :authenticated-syntax-id
    :domain :gravity/sh07-b4-acyclic-recur-target-v1
    :path-neutral? true
    :node-digest-cycle? false}
   :set-mutation-policy
   {:target :same-namespace-top-level-var
    :target-evaluated? false
    :value-evaluation :exactly-once-left-to-right
    :result :unit
    :required-effect :state/write
    :legality :pending-sh08-sh09-sh10-sh11}
   :throw-policy
   {:arity 1
    :value-evaluation :exactly-once
    :construction-order :postorder-after-value
    :runtime-reachability :not-asserted-by-sh07-b7
    :transfer-policy :error-transfer
    :result :never
    :required-effect :error/throw
    :legality :pending-sh08-sh09-sh10-sh11}
   :try-policy
   {:protected-expression-count 1
    :handler-count :one-or-more
    :handler-expression-count 1
    :typed-handler-required true
    :construction-order :protected-then-handlers-source-order-then-try
    :evaluation-order :protected-then-conditional-handler-chain
    :runtime-reachability :not-asserted-by-sh07-b9
    :selection-policy :source-ordered-typed-handler-candidates
    :result-policy :protected-or-selected-handler-result-pending-sh08
    :legality :pending-sh08-sh09-sh10-sh11}
   :match-policy
   {:scrutinee-expression-count 1
    :branch-count :one-or-more
    :supported-pattern-kinds [:literal :wildcard :binding :vector]
    :vector-pattern-policy
    {:width :fixed
     :nesting :recursive
     :binding-names :unique-only
     :duplicate-binding-diagnostic :pending-l7-owner
     :rest-patterns :deferred}
    :scrutinee-evaluation :evaluate-scrutinee-once
    :branch-evaluation :conditionally-evaluate-selected-branch
    :construction-order :scrutinee-then-branches-source-order-then-match
    :evaluation-order :scrutinee-then-source-ordered-pattern-candidates
    :runtime-reachability :not-asserted-by-sh07-b11
    :selection-policy :source-ordered-pattern-candidates
    :result-type-join :pending-sh08
    :exhaustiveness :pending-sh08}
   :keyword-map-lookup-policy
   {:arity 1
    :evaluation-order :keyword-then-map
    :dispatch :keyword-map-lookup
    :missing-key-policy :nil
    :result-policy :map-value-or-nil
    :target-type-legality :pending-sh08}
   :carrier-bound-policy
   :independent-component-caps-with-effective-aggregate-limit
   :host-authority
   [:authenticate-sh06-projection :resolve-digest-requests
    :bind-core-artifact]
   :self-hosted? false
   :whole-language? false
   :target-support? false
   :clojure-seed-boundary? true})


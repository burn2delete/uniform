                    (sh07-resolution-failure
                     :var-reference-authenticated-sh06-artifact-id)))
                (sh07-resolution-failure
                 :var-reference-semantics))
              (sh07-resolution-failure
               :var-reference-binding))
            (sh07-resolution-failure :var-reference-symbol))
          (sh07-resolution-failure :var-reference-source-identity))
        (sh07-resolution-failure :var-reference-ordinal))
      (sh07-resolution-failure :var-reference-ordinal))

        (if (sh07-sha256-id? (get region :if-syntax-id))
          (if (sh07-sha256-id? (get region :if-form-id))
            (if (contains? #{:then :else} (get region :role))
              (if (= (get region :execution)
                     :selected-exactly-once)
                (if (contains?
                     #{:module-initialization :function-body
                       :conditional-branch}
                     (get region :parent-region-kind))
                  (if (if (= (get region :parent-region-kind)
                             :conditional-branch)
                        (if (sh07-sha256-id?
                             (get region :parent-if-syntax-id))
                          (contains?
                           #{:then :else}
                           (get region :parent-branch-role))
                          false)
                        (if (= (get region :parent-if-syntax-id) nil)
                          (= (get region :parent-branch-role) nil)
                          false))
                    true
                    false)
                  false)
                false)
              false)
            false)
          false)
        false)
      false)))


       #{:name :binding-id :core-node-id :value-node-id
         :syntax-id})
    (let [core-node
          (sh07-resolve-controlled-reference
           (get definition :core-node-id) resolved-digests)
          value-node
          (sh07-resolve-controlled-reference
           (get definition :value-node-id) resolved-digests)]
      (if (= (get core-node :status) :accepted)
        (if (= (get value-node :status) :accepted)
          (sh07-resolution-success
           (assoc
            (assoc definition
                   :core-node-id (get core-node :value))
            :value-node-id (get value-node :value)))
          value-node)
        core-node))
    (sh07-resolution-failure
     :unexpected-definition-shape)))


     :provider-declarations :grant-records :artifact-manifest}
   :handles #{:managed-allocation :reference-transcript}
   :legacy-helper-deployment-stdout :unresolved
   :decisions #{:grant :deny}
   :records
   #{:capability-table :decision-log :denial-diagnostic
     :redaction-record}
   :rejects
   #{:ambient-authority :effect-outside-grant
     :provider-contract-violation :live-stdout-from-reference-handler}
   :deny-by-default? true
   :source-principal gravity.bootstrap.p15-s23.runtime
   :handler-principal :gravity.bootstrap/reference-harness
   :delegation :none
   :authority-widening? false
   :source-declaration-is-grant? false
   :capability-table-id :gravity.reference/runtime-capability-table
   :decision-log-schema :gravity.reference/runtime-audit-policy
   :status :complete-for-pinned-reference-runtime-contract-slice})


; Gravity-authored stage2 runtime function set for the accepted hosted-core
; subset.  The Clojure bootstrap supplies only the generic plan runner and
; declared host primitive boundary; runtime value formatting is sourced from
; this module and compiled through the stage2 plan emitter.
(ns gravity.bootstrap.p15-s23.runtime
  (:profile :hosted)
  (:target :jvm)
  (:effects #{:memory/allocate :io/write})
  (:capabilities #{:memory/allocator :io/stdout})
  (:providers [{:capability :memory/allocator
                :provider-id :gravity.reference/jvm-managed-allocator
                :version 1
                :profile :hosted
                :target :jvm
                :phase :runtime
                :mode :pinned-reference}]))

; These records are the exact, source-owned contract for the pinned reference
; runtime slice.  They do not claim a deployable stdout provider, a portable
; allocator provider identity, or normalization of fatal JVM OOM conditions.
; The Clojure seed validates every key, cross-link, source hash, function hash,
; and operation fact before it delegates to the typed reference adapter.
(def p15-s23-reference-runtime-contract
  {:artifact :gravity/p15-s23-reference-runtime-contract
   :schema-version 1
   :status :complete-for-pinned-reference-runtime-contract-slice
   :runtime-family :managed
   :profile :hosted
   :target :jvm
   :source-module gravity.bootstrap.p15-s23.runtime
   :declared-effects #{:memory/allocate :io/write}
   :declared-capabilities #{:memory/allocator :io/stdout}
   :source-provider-selection-ids
   [:gravity.reference/jvm-managed-allocator]
   :handler-provider-selection-ids
   [:gravity.reference/transcript-capture]
   :provider-selection-record-set-id
   :gravity.reference/runtime-provider-selections
   :capability-proof-record-set-id
   :gravity.reference/runtime-capability-proofs
   :effect-graph-id :gravity.reference/runtime-effect-graph
   :function-graph-id :gravity.reference/runtime-function-graph
   :function-effect-table-id :gravity.reference/runtime-function-effects
   :service-manifest-id :gravity.reference/managed-runtime-services
   :managed-adapter-id :gravity.reference/jvm-managed-adapter
   :memory-provider-id :gravity.reference/jvm-managed-allocator
   :capability-manifest-id :gravity.reference/runtime-capabilities
   :observability-manifest-id :gravity.reference/runtime-observability
   :failure-policy-id :gravity.reference/runtime-failure-policy
   :audit-policy-id :gravity.reference/runtime-audit-policy
   :grant-record-set-id :gravity.reference/runtime-grants
   :io-projections
   {:closed-plan-interpreter
    {:direct-handler-function
     p15-s23-runtime-evaluate-closed-instruction
     :transitive-function-scope
     #{p15-s23-runtime-evaluate-arguments
       p15-s23-runtime-evaluate-bindings
       p15-s23-runtime-evaluate-sequence
       p15-s23-runtime-evaluate-closed-instruction
       p15-s23-runtime-execute-closed-plan}
     :handled #{:io/write}
     :escaping #{:memory/allocate}
     :handler-id :gravity.reference/transcript-string-handler
     :live-stdout? false}
    :legacy-println-helpers
    {:function-scope
     #{p15-s23-runtime-println-value
       p15-s23-runtime-println-two}
     :handled #{}
     :escaping #{:memory/allocate :io/write}
     :deployment-provider :unresolved
     :deployment-grant :unresolved
     :reference-handler-authority? false}}
   :generic-emitter-effect-summary
   :superseded-for-pinned-runtime-contract
   :generic-emitter-effect-summary-credited? false
   :program-deployment-stdout :unresolved
   :checked-core-str-println-admission? false
   :checked-core-str-println-admission-status :unresolved
   :typed-fourth-authority :absent
   :typed-fourth-authority-consumed? false
   :target-lowering-credit? false
   :release-credit? false
   :c11-credit? false
   :fatal-host-oom :unproven-fatal-host-boundary
   :global-conformance-residuals
   [:deployment-stdout-provider-and-grant
    :legacy-helper-deployment-stdout-provider-and-grant
    :fatal-jvm-oom-normalization
    :generic-emitter-effect-precision
    :non-jvm-runtime-adapters
    :clojure-seed-bridge-retirement
    :whole-runtime-conformance]
   :mir-derived? false
   :whole-language? false
   :clojure-seed-boundary? true
   :self-hosted? false})


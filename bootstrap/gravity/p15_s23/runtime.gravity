       p15-s23-runtime-evaluate-sequence
       p15-s23-runtime-evaluate-closed-instruction}
     :recursive? true}
    {:scc-id :scc-println-output
     :functions #{p15-s23-runtime-println-output}
     :recursive? true}
    {:scc-id :scc-execute
     :functions #{p15-s23-runtime-execute-closed-plan}
     :recursive? false}]
   :condensation-edges
   #{[:scc-main :scc-format]
     [:scc-evaluator :scc-println-output]
     [:scc-execute :scc-evaluator]}
   :recursive-scc-ids #{:scc-evaluator :scc-println-output}

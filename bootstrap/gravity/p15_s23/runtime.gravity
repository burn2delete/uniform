      p15-s23-runtime-evaluate-sequence
      p15-s23-runtime-evaluate-closed-instruction}
    p15-s23-runtime-execute-closed-plan
    #{p15-s23-runtime-evaluate-sequence}}
   :function-to-scc
   {main :scc-main
    p15-s23-runtime-format-value :scc-format
    p15-s23-runtime-concat :scc-concat
    p15-s23-runtime-println-value :scc-println-value
    p15-s23-runtime-println-two :scc-println-two
    p15-s23-runtime-evaluate-arguments :scc-evaluator
    p15-s23-runtime-evaluate-bindings :scc-evaluator
    p15-s23-runtime-evaluate-sequence :scc-evaluator
    p15-s23-runtime-evaluate-closed-instruction :scc-evaluator
    p15-s23-runtime-println-output :scc-println-output
    p15-s23-runtime-execute-closed-plan :scc-execute}
   :sccs
   [{:scc-id :scc-main :functions #{main} :recursive? false}
    {:scc-id :scc-format
     :functions #{p15-s23-runtime-format-value}
     :recursive? false}
    {:scc-id :scc-concat
     :functions #{p15-s23-runtime-concat}

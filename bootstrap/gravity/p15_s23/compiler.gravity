               :self-hosting-conformance-report
               :trusted-computing-base-delta-record
               :unsafe-audit-report]
    :emits [:rfc-record
            :package-release-record
            :reproducible-release-record
            :registry-policy-decision
            :release-provenance-link
            :auditor-query-record]
    :preserves [:artifact-provenance
                :compiler-lineage
                :rfc-traceability
                :rebuild-artifact-identity
                :conformance-suite-status
                :unsafe-island-index
                :tcb-component-inventory
                :package-safety-metadata
                :registry-policy-decision]}
   :rfc-policy
   {:rfc-id "RFC-P15-S23-CURRENT-STAGE-COMPILER-ARTIFACT"
    :state :implemented
    :affected-documents ["BOOT8" "PKG7" "GOV6" "GOV10" "TEST13"]
    :required-sections [:motivation
                        :design
                        :profile-impact
                        :safety-security-impact
                        :compatibility
                        :implementation-plan
                        :test-plan
                        :migration-plan
                        :stabilization-criteria]
    :review-gates [:architecture
                   :safety
                   :package
                   :conformance
                   :bootstrap-provenance]}
   :package-policy
   {:package "gravity/compiler"
    :namespace "gravity.bootstrap.compiler"
    :version "0.0.0-p15-s23-current-stage"
    :owners ["gravity-language-governance"]
    :profiles [:meta :hosted]
    :targets [:jvm]
    :requires [:stable-identity
               :owner
               :namespace
               :version
               :provenance
               :sbom
               :signature
               :artifact-hashes
               :capability-manifest
               :conformance-report]}
   :release-decision
   {:governance-and-package-policy-satisfied? true
    :release-eligible? false
    :registry-publication-eligible? false
    :release-blockers [:clojure-seed-retired]
    :seed-retirement-required-before-final-release? true}
   :diagnostics {:missing-record "P15S23L001"
                 :rfc-traceability-gap "P15S23L002"
                 :package-metadata-gap "P15S23L003"
                 :reproducibility-provenance-gap "P15S23L004"
                 :registry-policy-gap "P15S23L005"
                 :release-overclaim "P15S23L006"
                 :auditor-query-gap "P15S23L007"}
   :self-hosting-claims {:full-language-compiler-self-hosted? false
                         :clojure-seed-retired? false}
   :status :in-progress})

(defn p15-s23-compiler-source-inventory [source-root source-set]
  (quote {:status :source-inventory
          :source-root source-root
          :source-set source-set
          :stage p15-s23-compiler-stage}))

(def p15-s23-compiler-pipeline-manifest
  {:artifact :gravity/compiler-pipeline-manifest
   :manifest-version 1
   :stage :p15-s23-compiler-pipeline-manifest
   :compiler-stage :p15-s23-compiler-stage
   :input :gravity-source-set
   :output :self-hosting-candidate-artifacts
   :pipeline [:read-source
              :build-syntax
              :macro-expand
              :resolve-names
              :lower-to-core
              :type-check
              :effect-check
              :profile-validate
              :safety-analyze
              :build-mir
              :verify-mir
              :optimize-mir
              :lower-domain-ir
              :verify-domain-ir
              :lower-target
              :emit-artifacts]
   :pass-contracts [{:stage :read-source
                     :input :source-bytes
                     :output :source-unit
                     :preserves [:source-spans]
                     :emits [:source-unit :reader-diagnostics]}
                    {:stage :build-syntax
                     :input :source-unit
                     :output :syntax-object-stream
                     :preserves [:source-spans :syntax-identity]
                     :emits [:syntax-object-stream :syntax-verification-report]}
                    {:stage :macro-expand
                     :input :syntax-object-stream
                     :output :expanded-syntax
                     :preserves [:source-spans :syntax-identity]
                     :emits [:expansion-trace :diagnostic-stream]}
                    {:stage :resolve-names
                     :input :expanded-syntax
                     :output :resolved-core-seed
                     :preserves [:source-spans :syntax-identity]
                     :emits [:namespace-graph :binding-table]}
                    {:stage :lower-to-core
                     :input :resolved-core-seed
                     :output :core-ast
                     :preserves [:source-spans :syntax-identity
                                 :diagnostic-codes]
                     :emits [:core-ast :core-lowering-diagnostics]}
                    {:stage :type-check
                     :input :core-ast
                     :output :typed-core
                     :preserves [:source-spans :syntax-identity]
                     :emits [:type-facts :type-diagnostics]}
                    {:stage :effect-check
                     :input :typed-core
                     :output :effected-core
                     :preserves [:source-spans :syntax-identity]
                     :emits [:effect-facts :capability-facts]}
                    {:stage :profile-validate
                     :input :effected-core
                     :output :profile-valid-core
                     :preserves [:source-spans :syntax-identity]
                     :emits [:profile-report :profile-diagnostics]}
                    {:stage :safety-analyze
                     :input :profile-valid-core
                     :output :checked-core
                     :preserves [:source-spans :syntax-identity
                                 :diagnostic-codes]
                     :emits [:safety-outcomes :unsafe-audit-report]}
                    {:stage :build-mir
                     :input :checked-core
                     :output :gravity-mir
                     :preserves [:source-spans :artifact-provenance]
                     :emits [:mir-module :mir-build-report]}
                    {:stage :verify-mir
                     :input :gravity-mir
                     :output :verified-mir
                     :preserves [:source-spans :artifact-provenance]
                     :emits [:mir-verifier-report]}
                    {:stage :optimize-mir
                     :input :verified-mir
                     :output :optimized-mir
                     :preserves [:source-spans :artifact-provenance]
                     :emits [:optimization-report :proof-carrying-deltas]}
                    {:stage :lower-domain-ir
                     :input :optimized-mir
                     :output :domain-ir-bundle
                     :preserves [:source-spans :artifact-provenance]
                     :emits [:domain-boundary-records]}
                    {:stage :verify-domain-ir
                     :input :domain-ir-bundle
                     :output :verified-domain-ir
                     :preserves [:source-spans :artifact-provenance]
                     :emits [:domain-ir-verifier-report]}
                    {:stage :lower-target
                     :input :verified-domain-ir
                     :output :target-ir
                     :preserves [:source-spans :artifact-provenance
                                 :runtime-capability-manifest]
                     :emits [:runtime-manifest :backend-ir]}
                    {:stage :emit-artifacts
                     :input :target-ir
                     :output :artifact-bundle
                     :preserves [:source-spans :artifact-provenance
                                 :runtime-capability-manifest]
                     :emits [:binary-artifacts :sbom
                             :provenance-attestation]}]
   :preserves [:source-spans
               :syntax-identity
               :diagnostic-codes
               :artifact-provenance
               :pipeline-stage-contracts
               :runtime-capability-manifest]
   :diagnostics {:missing-manifest "P15S23M001"
                 :pipeline-mismatch "P15S23M002"
                 :pass-contract-gap "P15S23M003"
                 :preservation-gap "P15S23M004"
                 :unsupported-claim "P15S23M005"}
   :self-hosting-claims {:full-language-compiler-self-hosted? false
                         :clojure-seed-retired? false}
   :status :in-progress})


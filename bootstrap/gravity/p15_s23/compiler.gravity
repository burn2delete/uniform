(def p15-s23-whole-language-compiler-artifact
  {:artifact :gravity/whole-language-compiler-artifact
   :proof-version 1
   :stage :p15-s23-whole-language-compiler-artifact
   :compiler-stage :p15-s23-compiler-stage
   :input :gravity-source-set
   :output :current-stage-compiler-artifact
   :governing-documents ["BOOT1" "BOOT3" "BOOT6" "BOOT7" "BOOT8"
                         "C1" "C2" "C3" "C4" "C5" "C6" "C15" "R1" "R11"
                         "PKG7" "TEST13" "GOV6" "GOV10"]
   :compiler-artifact-stage
   {:stage :emit-current-stage-compiler-artifact
    :requires [:compiler-source-inventory
               :compiler-pipeline-manifest
               :source-unit-and-syntax-serialization-proof
               :core-lowering-and-diagnostic-preservation-report
               :runtime-manifest-and-capability-enforcement-report
               :accepted-app-execution-proof
               :rejected-app-diagnostic-proof
               :reproducible-rebuild-log
               :stage-comparison-report
               :self-hosting-conformance-report
               :bootstrap-provenance-attestation
               :trusted-computing-base-delta-record
               :unsafe-audit-report]
    :emits [:compiler-artifact-manifest
            :stage-support-matrix
            :compiler-artifact-lineage
            :accepted-application-compile-record
            :rejected-application-diagnostic-record
            :residual-trusted-boundary-record
            :auditor-query-record]
    :preserves [:source-spans
                :syntax-identity
                :diagnostic-codes
                :artifact-provenance
                :pipeline-stage-contracts
                :runtime-capability-manifest
                :accepted-app-output
                :rejected-app-diagnostic-trace
                :compiler-lineage
                :tcb-component-inventory
                :unsafe-island-index]}
   :claimed-language-subset
   {:scope :current-implementation-language-subset
    :includes [:reader :syntax :diagnostics :compiled-hosted-core-app
               :compiler-evidence-bundle]
    :accepted-fixtures
    ["bootstrap/clojure/fixtures/accepted/core-app.gravity"
     "bootstrap/gravity/p15_s23/compiler.gravity"]
    :rejected-fixtures
    ["bootstrap/clojure/fixtures/rejected/core-app-function-arity.gravity"
     "bootstrap/clojure/fixtures/rejected/core-app-builtin-arity.gravity"]
    :stage0-executor-boundary :clojure-instruction-runner}
   :preserves [:source-spans
               :syntax-identity
               :diagnostic-codes
               :artifact-provenance
               :pipeline-stage-contracts
               :runtime-capability-manifest
               :accepted-app-output
               :rejected-app-diagnostic-trace
               :compiler-lineage
               :tcb-component-inventory
               :unsafe-island-index]
   :diagnostics {:missing-artifact "P15S23W001"
                 :source-or-pipeline-gap "P15S23W002"
                 :stage-support-gap "P15S23W003"
                 :provenance-or-equivalence-gap "P15S23W004"
                 :trusted-boundary-or-overclaim "P15S23W005"
                 :diagnostic-fixture-gap "P15S23W006"}
   :self-hosting-claims {:full-language-compiler-self-hosted? false
                         :clojure-seed-retired? false}
   :status :in-progress})

(def p15-s23-stage2-compiler-nucleus
  {:artifact :gravity/stage2-compiler-nucleus
   :proof-version 1
   :stage :p15-s23-stage2-compiler-nucleus
   :compiler-stage :p15-s23-compiler-stage
   :implemented-by :gravity-source
   :verified-by :clojure-stage0
   :module-responsibility :hosted-core-compiled-plan-emission
   :input :macro-expanded-core
   :output :stage0-compatible-instruction-plan-contract
   :governing-documents ["BOOT1" "BOOT3" "BOOT4" "BOOT6" "BOOT7"
                         "BOOT8" "C1" "C6" "C15" "R1" "R11"
                         "TEST13"]
   :nucleus-stage
   {:stage :emit-hosted-core-instruction-plan
    :requires [:source-forms
               :macro-expanded-forms
               :profile-facts
               :effect-facts
               :capability-facts
               :runtime-capability-manifest]
    :emits [:compiled-instruction-plan
            :accepted-output-comparison
            :rejected-diagnostic-comparison
            :stage2-boundary-record]
    :preserves [:source-spans
                :diagnostic-codes
                :effects
                :capabilities
                :profile
                :compiler-lineage
                :artifact-provenance]}
   :accepted-plan-contract
   {:fixture "bootstrap/clojure/fixtures/accepted/core-app.gravity"
    :module core.app
    :profile :hosted
    :target :jvm
    :entrypoint main
    :required-user-functions [build-record render total]
    :required-op-families [:builtin-call
                           :function-call
                           :println
                           :let
                           :if
                           :do]
    :required-effects #{:io/write}
    :required-capabilities #{:io/stdout}
    :expected-stdout "core-app\ngravity:19:2\n(:ok 19)\n"}
   :rejected-diagnostic-contract
   [{:fixture
     "bootstrap/clojure/fixtures/rejected/core-app-function-arity.gravity"
     :expected-diagnostic "L2-FUNCTION-ARITY"
     :rejected-design :wrong-user-function-arity}
    {:fixture
     "bootstrap/clojure/fixtures/rejected/core-app-builtin-arity.gravity"
     :expected-diagnostic "L2-BUILTIN-ARITY"
     :rejected-design :wrong-builtin-arity}]
   :required-evidence-links [:compiler-pipeline-manifest
                             :accepted-app-execution-proof
                             :rejected-app-diagnostic-proof]
   :preserves [:source-spans
               :diagnostic-codes
               :effects
               :capabilities
               :profile
               :compiler-lineage
               :artifact-provenance]
   :emits [:compiled-instruction-plan
           :accepted-output-comparison
           :rejected-diagnostic-comparison
           :stage2-boundary-record]
   :lineage {:source-language :gravity
             :verified-by :clojure-stage0
             :compiled-by :clojure-stage0
             :replaces [:stage0-plan-contract-in-clojure]
             :does-not-replace [:stage0-reader
                                :stage0-macro-expander
                                :stage0-analyzer
                                :stage0-instruction-runner]}
   :seed-boundary {:seed :clojure-stage0
                   :still-trusted? true
                   :stage0-executor-boundary :clojure-instruction-runner
                   :retirement-condition :complete-p15-s23-evidence-bundle}
   :self-hosting-claims {:full-language-compiler-self-hosted? false
                         :clojure-seed-retired? false}
   :next-required-capability
   :replace_stage0_plan_emitter_with_stage2_gravity_execution
   :status :in-progress})

(def p15-s23-stage2-plan-emitter
  {:artifact :gravity/stage2-plan-emitter
   :proof-version 1
   :stage :p15-s23-stage2-plan-emitter
   :compiler-stage :p15-s23-compiler-stage
   :nucleus :p15-s23-stage2-compiler-nucleus
   :engine :gravity-stage2-plan-emitter-rules-v1
   :implemented-by :gravity-source
   :executed-by :clojure-stage0-rule-runner
   :module-responsibility :hosted-core-compiled-plan-emission
   :input :macro-expanded-core
   :output :stage2-instruction-plan
   :governing-documents ["BOOT1" "BOOT3" "BOOT4" "BOOT6" "BOOT7"
                         "BOOT8" "C1" "C6" "C15" "R1" "R11"
                         "TEST13"]
   :accepted-scope
   {:fixture "bootstrap/clojure/fixtures/accepted/core-app.gravity"
    :module core.app
    :profile :hosted
    :target :jvm
    :entrypoint main
    :required-user-functions [build-record render total]
    :expected-stdout "core-app\ngravity:19:2\n(:ok 19)\n"}
   :source-form-rules
   {:function-definitions [defn def]
    :def-fn-shape {:outer def :inner fn}
    :main-arity 0}
   :special-form-rules
   {println {:op :println
             :argument-policy :compile-rest
             :effect :io/write
             :capability :io/stdout}
    do {:op :do
        :argument-policy :compile-body}
    if {:op :if
        :argument-policy :compile-test-then-else
        :arity 3}
    let {:op :let
         :argument-policy :compile-even-binding-vector}
    quote {:op :quote
           :argument-policy :literal-second
           :arity 1}
    host-reflect {:diagnostic "P4-HOST-REFLECTION"
                  :status :rejected}}
   :collection-rules
   {:vector {:op :vector-literal :order :source-order}
    :map {:op :map-literal :order :pr-str-sorted}
    :set {:op :set-literal :order :pr-str-sorted}
    :literal {:op :literal}}
   :call-rules
   {:builtin-op :builtin-call
    :function-op :function-call
    :builtin-functions [* + - / < <= = > >= assoc conj count first get
                        hash-map list pr-str rest second str vector]
    :unknown-callee-diagnostic "L2-UNKNOWN-CORE-FORM"
    :function-arity-diagnostic "L2-FUNCTION-ARITY"
    :builtin-arity-diagnostic "L2-BUILTIN-ARITY"}
   :plan-shape
   {:kind :gravity/stage2-hosted-core-compiled-plan
    :compatibility-kind :gravity/stage0-hosted-core-compiled-plan
    :entrypoint main
    :compiler {:owner :gravity-source
               :stage :stage2-plan-emitter
               :executed-by :clojure-stage0-rule-runner
               :input :macro-expanded-core
               :output :instruction-plan
               :retirement-objective :retire-clojure-seed}}
   :accepted-equivalence
   {:compare-against :stage0-hosted-core-compiled-plan
    :requires [:binding-table
               :function-instructions
               :instruction-summary
               :effect-summary
               :accepted-stdout]}
   :rejected-diagnostic-contract
   [{:fixture
     "bootstrap/clojure/fixtures/rejected/core-app-function-arity.gravity"
     :expected-diagnostic "L2-FUNCTION-ARITY"
     :rejected-design :wrong-user-function-arity}
    {:fixture
     "bootstrap/clojure/fixtures/rejected/core-app-builtin-arity.gravity"
     :expected-diagnostic "L2-BUILTIN-ARITY"
     :rejected-design :wrong-builtin-arity}]
   :required-evidence-links [:stage2-compiler-nucleus
                             :compiler-pipeline-manifest
                             :accepted-app-execution-proof
                             :rejected-app-diagnostic-proof]
   :preserves [:source-spans
               :diagnostic-codes
               :function-bindings
               :instruction-semantics
               :effects
               :capabilities
               :profile
               :compiler-lineage
               :artifact-provenance]
   :emits [:stage2-instruction-plan
           :stage2-plan-execution-record
           :accepted-output-comparison
           :rejected-diagnostic-comparison
           :stage2-emitter-boundary-record]
   :lineage {:source-language :gravity
             :verified-by :clojure-stage0
             :compiled-by :clojure-stage0
             :executes-with :clojure-stage0-rule-runner
             :replaces [:stage0-plan-emitter-in-clojure]
             :does-not-replace [:stage0-reader
                                :stage0-macro-expander
                                :stage0-analyzer
                                :stage0-instruction-runner]}
   :seed-boundary {:seed :clojure-stage0
                   :still-trusted? true
                   :stage0-rule-runner-boundary :clojure-stage0-rule-runner
                   :stage0-executor-boundary :clojure-instruction-runner
                   :retirement-condition :complete-p15-s23-evidence-bundle}
   :self-hosting-claims {:full-language-compiler-self-hosted? false
                         :clojure-seed-retired? false}
   :next-required-capability
   :replace_stage0_instruction_runner_with_stage2_runtime_execution
   :status :in-progress})


  (if (if (= :nonlocal-or-nonfunction (get (get (get context :edges) (get node :node-id)) :classification))
        (= :gravity.type/applied-map-get (get (get (get context :types) (first (get node :children))) :kind)) false)
    (p15-s23-typed-compile-get context node budget)
  (if (if (= :nonlocal-or-nonfunction (get (get (get context :edges) (get node :node-id)) :classification))
        (contains? #{:gravity.type/applied-map-contains :gravity.type/applied-keyword-set-contains :gravity.type/applied-character-set-contains} (get (get (get context :types) (first (get node :children))) :kind)) false)
    (if (contains? #{:gravity.type/applied-keyword-set-contains :gravity.type/applied-character-set-contains} (get (get (get context :types) (first (get node :children))) :kind))
      (p15-s23-typed-compile-keyword-set-contains context node budget)
      (p15-s23-typed-compile-contains context node budget))
  (if (if (= :nonlocal-or-nonfunction (get (get (get context :edges) (get node :node-id)) :classification))
        (contains? #{:gravity.type/applied-not :gravity.type/applied-vector-predicate :gravity.type/applied-integer-predicate :gravity.type/applied-set-conversion :gravity.type/applied-map-predicate  :gravity.type/applied-keyword-predicate :gravity.type/applied-string-predicate :gravity.type/applied-set-predicate :gravity.type/applied-symbol-predicate :gravity.type/applied-boolean-predicate :gravity.type/applied-nil-predicate :gravity.type/applied-character-predicate :gravity.type/applied-atomic-inequality} (get (get (get context :types) (first (get node :children))) :kind)) false)
    (if (contains? #{:gravity.type/applied-vector-predicate :gravity.type/applied-integer-predicate :gravity.type/applied-set-conversion :gravity.type/applied-map-predicate  :gravity.type/applied-keyword-predicate :gravity.type/applied-string-predicate :gravity.type/applied-set-predicate :gravity.type/applied-symbol-predicate :gravity.type/applied-boolean-predicate :gravity.type/applied-nil-predicate :gravity.type/applied-character-predicate :gravity.type/applied-atomic-inequality} (get (get (get context :types) (first (get node :children))) :kind))
      (if (contains? #{:gravity.type/applied-integer-predicate :gravity.type/applied-set-conversion :gravity.type/applied-map-predicate  :gravity.type/applied-keyword-predicate :gravity.type/applied-string-predicate :gravity.type/applied-set-predicate :gravity.type/applied-symbol-predicate :gravity.type/applied-boolean-predicate :gravity.type/applied-nil-predicate :gravity.type/applied-character-predicate :gravity.type/applied-atomic-inequality} (get (get (get context :types) (first (get node :children))) :kind))
        (if (= :gravity.type/applied-set-conversion (get (get (get context :types) (first (get node :children))) :kind))
          (p15-s23-typed-compile-set-conversion context node budget)
          (if (= :gravity.type/applied-atomic-inequality (get (get (get context :types) (first (get node :children))) :kind)) (p15-s23-typed-compile-atomic-inequality context node budget) (if (contains? #{:gravity.type/applied-nil-predicate :gravity.type/applied-character-predicate} (get (get (get context :types) (first (get node :children))) :kind)) (if (= :gravity.type/applied-character-predicate (get (get (get context :types) (first (get node :children))) :kind)) (p15-s23-typed-compile-character-predicate context node budget) (p15-s23-typed-compile-nil-predicate context node budget)) (if (= :gravity.type/applied-boolean-predicate (get (get (get context :types) (first (get node :children))) :kind)) (p15-s23-typed-compile-boolean-predicate context node budget) (if (= :gravity.type/applied-symbol-predicate (get (get (get context :types) (first (get node :children))) :kind)) (p15-s23-typed-compile-symbol-predicate context node budget) (if (= :gravity.type/applied-set-predicate (get (get (get context :types) (first (get node :children))) :kind)) (p15-s23-typed-compile-set-predicate context node budget) (if (= :gravity.type/applied-map-predicate (get (get (get context :types) (first (get node :children))) :kind)) (p15-s23-typed-compile-map-predicate context node budget) (if (= :gravity.type/applied-keyword-predicate (get (get (get context :types) (first (get node :children))) :kind)) (p15-s23-typed-compile-keyword-predicate context node budget) (if (= :gravity.type/applied-string-predicate (get (get (get context :types) (first (get node :children))) :kind)) (p15-s23-typed-compile-string-predicate context node budget) (p15-s23-typed-compile-integer-predicate context node budget))))))))))
        (p15-s23-typed-compile-vector-predicate context node budget))
      (p15-s23-typed-compile-not context node budget))
  (if (if (= :nonlocal-or-nonfunction (get (get (get context :edges) (get node :node-id)) :classification))
        (contains? #{:gravity.type/applied-atomic-equality :gravity.type/applied-vector-equality :gravity.type/applied-integral-equality :gravity.type/applied-keyword-set-equality }
          (get (get (get context :types) (first (get node :children))) :kind)) false)
    (if (contains? #{:gravity.type/applied-vector-equality :gravity.type/applied-keyword-set-equality} (get (get (get context :types) (first (get node :children))) :kind))
      (if (= :gravity.type/applied-keyword-set-equality (get (get (get context :types) (first (get node :children))) :kind))
        (p15-s23-typed-compile-keyword-set-equality context node budget)
        (p15-s23-typed-compile-vector-equality context node budget))
      (if (= :gravity.type/applied-integral-equality (get (get (get context :types) (first (get node :children))) :kind))
        (p15-s23-typed-compile-integral-equality context node budget) (p15-s23-typed-compile-equality context node budget)))
  (if (if (= :nonlocal-or-nonfunction (get (get (get context :edges) (get node :node-id)) :classification))
        (contains? #{:gravity.type/applied-vector-append :gravity.type/applied-list-prepend}
          (get (get (get context :types) (first (get node :children))) :kind)) false)
    (if (= :gravity.type/applied-list-prepend (get (get (get context :types) (first (get node :children))) :kind))
      (p15-s23-typed-compile-prepend context node budget) (p15-s23-typed-compile-append context node budget))
  (if (if (= :nonlocal-or-nonfunction (get (get (get context :edges) (get node :node-id)) :classification))
        (contains? #{:gravity.type/applied-bounded-successor :gravity.type/applied-bounded-unit-addition} (get (get (get context :types) (first (get node :children))) :kind)) false)
    (p15-s23-typed-compile-successor context node budget)
  (if (if (= :nonlocal-or-nonfunction (get (get (get context :edges) (get node :node-id)) :classification))
        (contains? #{:gravity.type/applied-vector-nth :gravity.type/applied-vector-get} (get (get (get context :types) (first (get node :children))) :kind)) false)
    (p15-s23-typed-compile-nth context node budget)
  (if (if (= :nonlocal-or-nonfunction (get (get (get context :edges) (get node :node-id)) :classification))
        (= :gravity.type/applied-collection-count (get (get (get context :types) (first (get node :children))) :kind)) false)
    (p15-s23-typed-compile-count context node budget)
  (if (if (= :nonlocal-or-nonfunction (get (get (get context :edges) (get node :node-id)) :classification))
        (contains? #{:gravity.type/applied-map-association :gravity.type/applied-map-removal}
          (get (get (get context :types) (first (get node :children))) :kind)) false)
    (if (= :gravity.type/applied-map-removal (get (get (get context :types) (first (get node :children))) :kind))
      (p15-s23-typed-compile-removal context node budget) (p15-s23-typed-compile-association context node budget))
  (if (if (= :nonlocal-or-nonfunction (get (get (get context :edges) (get node :node-id)) :classification))
        (= :gravity.type/applied-integral-ordering (get (get (get context :types) (first (get node :children))) :kind)) false)
    (p15-s23-typed-compile-ordering context node budget)
  (let [id (get node :node-id) call (get (get context :calls) id) edge (get (get context :edges) id)
        forms (get context :forms) children (get node :children) owner (get forms (get (get node :source) :form-id))
        ids (get owner :child-form-ids)
        callee-record (loop [remaining (get (get context :core) :function-records) found nil]
                        (if (= 0 (count remaining)) found
                          (if (= (get (first remaining) :definition-binding-id) (get edge :callee-binding-id))
                            (if (= found nil) (recur (rest remaining) (first remaining)) nil) (recur (rest remaining) found))))
        name (get callee-record :definition-name) joined (p15-s23-typed-definition context name) callee (get (get joined :value) :function)
        definition-node (get (get context :nodes) (get callee-record :definition-core-node-id))
        definition-form (get forms (get (get definition-node :source) :form-id))
        definition-name-form (get forms (get (get definition-form :child-form-ids) 1))
        caller (get context :current-function)]
    (if (= false (p15-s23-typed-all [(vector? children) (vector? ids) (vector? (get call :argument-node-ids))]))
      (p15-s23-typed-node-error :malformed-typed-call-family node)
    (if (if (> (count children) 0) (= (count ids) (count children)) false)
    (if (< budget (+ 15 (count children)))
      (assoc (p15-s23-typed-node-error :typed-lowering-work-limit node) :work-count (+ 15 (count children)))
      (let [arguments (subvec children 1 (count children)) operator (get (get context :nodes) (first children))
            binding-id (get call :operator-binding-id) binding (get (get context :bindings) binding-id)
            operator-form (get forms (first ids)) parameters (get callee :parameters)
            types (loop [remaining arguments out []]
                    (if (= 0 (count remaining)) out (recur (rest remaining) (conj out (get (get context :types) (first remaining))))))
            result (loop [remaining types]
                     (if (= 0 (count remaining)) (get callee :return)
                       (if (= :gravity.type/never (first remaining)) :gravity.type/never (recur (rest remaining)))))
            compatibility (loop [i 0 out [] work 0]
                            (if (= i (count parameters)) {:status :accepted :pairs out :work-count work}
                              (let [actual (get types i) chosen (get (get parameters i) :type)
                                    checked (p15-s23-lp-compatibility (get context :core) call edge callee i actual
                                              (get context :nodes) (get context :bindings) (- budget 16 (count arguments) work))
                                    pair {:parameter (get (get parameters i) :binding-id) :argument actual :chosen chosen}
                                    total (+ work (get checked :work-count))]
                                (if (= :accepted (get checked :status))
                                  (recur (+ i 1) (conj out (assoc pair :compatibility (get checked :premise))) total)
                                  (if (= :not-applicable (get checked :status))
                                    (recur (+ i 1) (conj out pair) total)
                                    {:status :rejected :reason (get checked :reason) :work-count total})))))
            pairs (get compatibility :pairs) charge (+ 16 (count arguments) (get compatibility :work-count))
            expected-call {:core-node-id id :operator-node-id (first children) :operator-binding-id binding-id
                           :argument-node-ids arguments :ordered-evaluation-node-ids children
                           :evaluation-order :operator-then-arguments :result-policy :call-result}
            expected-edge {:ordinal (get (get context :call-order) id) :call-core-node-id id
                           :caller-function-syntax-id (get caller :function-syntax-id) :caller-function-core-node-id (get caller :function-core-node-id)
                           :callee-binding-id (get callee-record :definition-binding-id) :callee-definition-syntax-id (get binding :definition-syntax-id)
                           :callee-function-syntax-id (get callee-record :function-syntax-id) :callee-function-core-node-id (get callee-record :function-core-node-id)
                           :argument-core-node-ids arguments :ordered-evaluation-node-ids children
                           :evaluation-order :operator-then-arguments :classification :local-function}
            row (p15-s23-lp-call-row {:constraint-id-request {:domain :gravity/sh08-function-call-constraint-v1 :call-core-node-id id
                                         :callee-function-syntax-id (get callee-record :function-syntax-id)}
                 :kind :equality :lhs (get callee-record :function-syntax-id) :rhs pairs :origin (get (get node :source) :origin-chain)
                 :profile :meta :target :jvm :status :solved :diagnostics []})
            view [:function-id :function-core-node-id :body-core-node-id :parameters :return :signature :thrown-error-effects]]
        (if (if (< budget charge) true (contains? #{:list-parameter-work-limit :map-parameter-work-limit} (get compatibility :reason)))
          (assoc (p15-s23-typed-node-error :typed-lowering-work-limit node) :work-count charge)
        (if (p15-s23-typed-all
              [(= :accepted (get compatibility :status)) (p15-s23-compiler-complete? joined) (= :named-top-level (get callee-record :definition-kind))
               (p15-s23-ds-call-allowed? context call edge) (= expected-call call) (= expected-edge edge)
               (= :reference (get operator :core-form)) (= [binding-id] (get operator :resolved-binding-ids) (get node :resolved-binding-ids))
               (= binding-id (get (get operator :attributes) :binding-id))
               (= (get caller :function-syntax-id) (get (get node :evaluation) :owner-function-syntax-id))
               (= :operator-then-arguments (get (get node :evaluation) :kind))
               (= (loop [i 0 out []] (if (= i (count children)) out
                    (recur (+ i 1) (conj out {:index i :core-node-id (get children i)})))) (get (get node :evaluation) :order))
               (= (get node :source) (p15-s23-typed-source owner)) (= :list (get owner :kind))
               (= (get operator :source) (p15-s23-typed-source operator-form))
               (= :symbol (get operator-form :kind))
               (if (= (get binding :name) (get operator-form :value)) true
                 (= (str (get binding :namespace) "/" (get binding :name)) (str (get operator-form :value))))
               (= {:symbol (get operator-form :value) :position :operator :binding-id binding-id
                   :binding-class (get binding :binding-class) :definition-syntax-id (get binding :definition-syntax-id)} (get operator :attributes))
               (= (get owner :form-id) (get operator-form :parent-form-id))
               (= (get binding :definition-syntax-id) (get definition-name-form :syntax-id))
               (= name (get binding :name) (get definition-name-form :value))
               (= :namespace (get binding :binding-class)) (= :function (get binding :kind))
               (= (get (get (get context :core) :module) :namespace) (get binding :namespace))
               (= (get definition-form :form-id) (get definition-name-form :parent-form-id))
               (= {:operator-child-index 0 :argument-count (count arguments) :argument-child-indexes (p15-s23-typed-index-range 1 (count children))
                   :evaluation-order :operator-then-arguments :dispatch :resolved-symbol-call} (get node :attributes))
               (= (count parameters) (count arguments) (get callee-record :fixed-arity))
               (= (p15-s23-typed-project callee view) (p15-s23-typed-project (get (get context :types) (first children)) view))
               (= result (get (get context :types) id))
               (= row (p15-s23-typed-call-constraint context id))
               (= (p15-s23-typed-call-fact context node edge types result) (get (get context :call-facts) id))
               (loop [i 0]
                 (if (= i (count arguments)) true
                   (let [source-form (get forms (get ids (+ i 1))) argument (get (get context :nodes) (get arguments i)) type (get types i)]
                     (if (p15-s23-typed-all [(= (get owner :form-id) (get source-form :parent-form-id))
                           (= (get argument :source) (p15-s23-typed-source source-form))
                           (if (contains? (get pairs i) :compatibility) true
                             (if (= type :gravity.type/never) true (= type (get (get parameters i) :type))))])
                       (recur (+ i 1)) false))))])
          (let [compiled (loop [remaining arguments used 0 values []]
                           (if (= 0 (count remaining))
                             (assoc (p15-s23-compiler-result values) :work-count used)
                             (let [child (p15-s23-typed-compile-node (assoc context :tail? false) (first remaining) (- budget charge used))]
                               (if (p15-s23-compiler-complete? child)
                                 (recur (rest remaining) (+ used (get child :work-count)) (conj values (get child :value)))
                                 (assoc child :work-count (+ used (get child :work-count 0)))))))]
            (if (p15-s23-compiler-complete? compiled)
              (assoc (p15-s23-compiler-result {:op :function-call :function name :args (get compiled :value)})
                :work-count (+ charge (get compiled :work-count)))
              (assoc compiled :work-count (+ charge (get compiled :work-count 0)))))
          (assoc (p15-s23-typed-node-error :unsupported-or-mismatched-typed-direct-call node) :work-count charge)))))
      (p15-s23-typed-node-error :malformed-typed-call-family node))))))))))))))))

(defn p15-s23-typed-compile-keyword-set [context node budget]
  ; This literal-only constructor uses the existing Set IR and evaluates its children.
  ; Reserve source validation and distinctness work before operand-value comparisons.
  (let [limit (if (< budget 65536) budget 65536) children (get node :children)]
    (if (< limit 12) (assoc (p15-s23-typed-node-error :typed-lowering-work-limit node) :work-count 12)
      (if (= false (vector? children))
        (assoc (p15-s23-typed-node-error :malformed-typed-set node) :work-count 12)
        (let [n (count children) base (+ 12 (* 14 n))]
          (if (if (< n 0) true (> n 1024)) (assoc (p15-s23-typed-node-error :typed-set-width-limit node) :work-count 12)
            (if (> base limit) (assoc (p15-s23-typed-node-error :typed-lowering-work-limit node) :work-count base)
              (let [half (quot n 2) previous (if (> n 0) (- n 1) 0)
                    a (if (= n (+ half half)) half n) b (if (= n (+ half half)) previous (quot previous 2))]
                (if (= false (if (= b 0) true (<= a (quot (- limit base) b))))
                  (assoc (p15-s23-typed-node-error :typed-lowering-work-limit node)
                    :work-count (+ limit 1) :work-count-kind :exceeded-allowance-lower-bound)
                  (let [charge (+ base (* a b)) forms (get context :forms)
                        owner-id (get (get node :source) :form-id)
                        owner-id? (if (keyword? owner-id) true (if (string? owner-id) (= 71 (count owner-id)) false))
                        owner (if owner-id?
                                (get forms owner-id) nil)
                        ids (get owner :child-form-ids) attrs (get node :attributes)
                        type (get (get context :types) (get node :node-id)) elements (get type :element-types)
                        characters? (if (vector? elements) (= :gravity.type/character (get elements 0)) false)
                        child-ids? (loop [i 0]
                                     (if (= i n) true
                                       (let [id (get children i)]
                                         (if (if (keyword? id) true (if (string? id) (= 71 (count id)) false))
                                           (recur (+ i 1)) false))))
                        form-ids? (if (vector? ids)
                                    (if (= n (count ids))
                                      (loop [i 0]
                                        (if (= i n) true
                                          (let [id (get ids i)]
                                            (if (if (keyword? id) true (if (string? id) (= 71 (count id)) false))
                                              (recur (+ i 1)) false)))) false) false)
                        header? (if (if owner-id? (if (map? owner) (if child-ids? form-ids? false) false) false)
                                  (p15-s23-typed-all
                                  [(map? owner) (= :set (get owner :kind)) (= owner-id (get owner :form-id))
                                   (= (get node :source) (p15-s23-typed-source owner))
                                   (= :collection-literal (get node :core-form)) (= [] (get node :resolved-binding-ids))
                                   (map? attrs) (= 3 (if (map? attrs) (count attrs) 0)) (contains? attrs :source-value)
                                   (= :set (get attrs :literal-kind))
                                   (= n (get attrs :element-count)) (vector? ids) (= n (if (vector? ids) (count ids) 0))
                                   (p15-s23-typed-ordered-node? node :left-to-right)
                                   (map? type) (= 3 (if (map? type) (count type) 0)) (= :gravity.type/set (get type :kind))
                                   (= :literal (get type :shape)) (vector? elements) (= n (if (vector? elements) (count elements) 0))]) false)
                        checked
                        (if header?
                          (loop [i 0 values []]
                            (if (= i n) {:status :accepted :values values}
                              (let [id (get children i) form-id (get ids i)
                                    id? (if (keyword? id) true (if (string? id) (= 71 (count id)) false))
                                    form-id? (if (keyword? form-id) true (if (string? form-id) (= 71 (count form-id)) false))
                                    child (if id? (get (get context :nodes) id) nil)
                                    form (if form-id? (get forms form-id) nil) attr (get child :attributes)
                                    value (get form :value)]
                                (if (if characters?
                                      (let [source-valid? (if (char? value) true
                                            (if (map? value)
                                              (if (if (= 4 (count value))
                                                    (loop [fields (keys value)]
                                                      (if (= 0 (count fields)) true
                                                        (if (keyword? (first fields)) (recur (rest fields)) false))) false)
                                                (if (= #{:artifact :schema-version :codepoint :text} (set (keys value)))
                                                  (if (= :gravity/unicode-scalar-character (get value :artifact))
                                                    (if (= 1 (get value :schema-version))
                                                      (if (integer? (get value :codepoint))
                                                        (if (<= 65536 (get value :codepoint) 1114111)
                                                          (if (string? (get value :text)) (= 2 (count (get value :text))) false) false) false) false) false) false) false) false))
                                            attribute-valid? (let [value (get attr :value)] (if (char? value) true
                                            (if (map? value)
                                              (if (if (= 4 (count value))
                                                    (loop [fields (keys value)]
                                                      (if (= 0 (count fields)) true
                                                        (if (keyword? (first fields)) (recur (rest fields)) false))) false)
                                                (if (= #{:artifact :schema-version :codepoint :text} (set (keys value)))
                                                  (if (= :gravity/unicode-scalar-character (get value :artifact))
                                                    (if (= 1 (get value :schema-version))
                                                      (if (integer? (get value :codepoint))
                                                        (if (<= 65536 (get value :codepoint) 1114111)
                                                          (if (string? (get value :text)) (= 2 (count (get value :text))) false) false) false) false) false) false) false) false)))]
                                        (if source-valid? (if attribute-valid?
                                          (if (= :character (get form :kind) (get attr :literal-kind))
                                            (if (= :literal (get child :core-form))
                                              (= :gravity.type/character (get elements i) (get (get context :types) id)) false) false) false) false))
                                      (if (keyword? value) (if (keyword? (get attr :value))
                                        (if (= :keyword (get form :kind)) (if (= :literal (get child :core-form))
                                          (if (= :keyword (get attr :literal-kind))
                                            (= :gravity.type/keyword (get elements i) (get (get context :types) id)) false) false) false) false) false))
                                  (if (p15-s23-typed-all
                                        [id? form-id? (map? child) (map? form) (= id (get child :node-id))
                                         (= form-id (get form :form-id)) (= owner-id (get form :parent-form-id))
                                         (= [] (get child :children) (get child :resolved-binding-ids))
                                         (p15-s23-typed-ordered-node? child :value)
                                         (map? attr) (= 2 (if (map? attr) (count attr) 0)) (= value (get attr :value))
                                         (= (get child :source) (p15-s23-typed-source form))])
                                    (recur (+ i 1) (conj values value))
                                    {:status :rejected :reason :typed-set-source-or-type-mismatch})
                                  {:status :rejected :reason :unsupported-typed-set-member}))))
                          {:status :rejected :reason :typed-set-source-or-type-mismatch})
                        unique? (if (= :accepted (get checked :status))
                                  (let [values (get checked :values)]
                                    (loop [i 0]
                                      (if (= i n) true
                                        (if (loop [j (+ i 1)]
                                              (if (= j n) true
                                                (let [left (get values i) right (get values j)
                                                      same? (if characters?
                                                              (if (char? left) (if (char? right) (= left right) false)
                                                                (if (map? right) (= (get left :codepoint) (get right :codepoint)) false))
                                                              (= left right))]
                                                  (if same? false (recur (+ j 1))))))
                                          (recur (+ i 1)) false)))) false)]
                    (if (= false (= :accepted (get checked :status)))
                      (assoc (p15-s23-typed-node-error (get checked :reason) node) :work-count charge)
                      (if (= false unique?)
                        (assoc (p15-s23-typed-node-error (if characters? :duplicate-typed-set-character :duplicate-typed-set-keyword) node) :work-count charge)
                        (loop [i 0 items [] used charge]
                          (if (= i n)
                            (assoc (p15-s23-compiler-result {:op :set-literal :items items}) :work-count used)
                            (let [child (p15-s23-typed-compile-node (assoc context :tail? false) (get children i) (- limit used))
                                  total (+ used (get child :work-count 1))]
                              (if (p15-s23-compiler-complete? child)
                                (recur (+ i 1) (conj items (get child :value)) total)
                                (assoc child :work-count total)))))))))))))))))

(defn p15-s23-typed-compile-collection [context node budget]
  (let [children (get node :children) attrs (get node :attributes) forms (get context :forms)
        owner (get forms (get (get node :source) :form-id)) ids (get owner :child-form-ids)
        type (get (get context :types) (get node :node-id)) never? (= :gravity.type/never type)
        kind (get attrs :literal-kind) map-literal? (= :map kind)
        elements (get type (if map-literal? :member-types :element-types))
        mismatch (if map-literal? :typed-map-source-or-type-mismatch :typed-vector-source-or-type-mismatch)]
    (if (= false (p15-s23-typed-all [(vector? children) (vector? ids) (= kind (get owner :kind))
              (contains? #{:vector :map} kind) (= [] (get node :resolved-binding-ids))]))
      (p15-s23-typed-node-error (if map-literal? :malformed-typed-map :malformed-typed-vector) node)
      (let [n (count children) charge (+ 12 (* (if map-literal? 14 10) n))]
        (if (< budget charge) (p15-s23-typed-node-error :typed-lowering-work-limit node)
          (if (p15-s23-typed-all [(= n (count ids) (get attrs :element-count))
                (if map-literal? (= n (* 2 (quot n 2))) true)
                (= (get owner :form-id) (get (get node :source) :form-id))
                (= (get owner :syntax-id) (get (get node :source) :syntax-id))
                (p15-s23-typed-ordered-node? node :left-to-right)
                (if never? true (if (map? type)
                  (p15-s23-typed-all [(= (if map-literal? :gravity.type/map :gravity.type/vector) (get type :kind)) (= :literal (get type :shape))
                    (vector? elements) (= n (count elements))]) false))])
            (let [checked
                  (loop [index 0 transfer? false key? true seen #{}]
                    (if (= index n) {:valid? (= never? transfer?)}
                      (let [id (get children index) child (get (get context :nodes) id)
                            form (get forms (get ids index)) child-type (get (get context :types) id)
                            expected (get elements index)
                            literal-key? (if (if map-literal? key? false)
                              (if (keyword? (get form :value))
                              (p15-s23-typed-all [(= :literal (get child :core-form)) (= :keyword (get form :kind))
                                (= :keyword (get (get child :attributes) :literal-kind))
                                (= (get form :value) (get (get child :attributes) :value))
                                (= :gravity.type/keyword child-type) (= false (contains? seen (get form :value)))]) false) true)]
                        (if (= false literal-key?) {:valid? false :unsupported-key? true}
                        (if (p15-s23-typed-all [(map? child) (map? form)
                              (= (get owner :form-id) (get form :parent-form-id))
                              (= (get ids index) (get (get child :source) :form-id))
                              (= (get form :syntax-id) (get (get child :source) :syntax-id))
                              (= false (= nil child-type)) (= false (= :gravity.type/unknown child-type))
                              (if never? true
                                (= (if (map? expected) (get expected :kind) expected)
                                   (if (map? child-type) (get child-type :kind) child-type)))])
                          (recur (+ index 1) (if (= :gravity.type/never child-type) true transfer?) (= false key?)
                                 (if (if map-literal? key? false) (conj seen (get form :value)) seen))
                          {:valid? false}))))) ]
              (if (= true (get checked :valid?))
                (let [compiled (p15-s23-typed-compile-children-mode context children (- budget charge) [] :none 0)]
                  (if (p15-s23-compiler-complete? compiled)
                    (assoc (p15-s23-compiler-result
                             (if map-literal?
                               {:op :map-literal :entries (loop [index 0 entries []]
                                  (if (= index n) entries
                                    (recur (+ index 2) (conj entries {:key (get (get compiled :value) index)
                                                                     :value (get (get compiled :value) (+ index 1))}))))}
                               {:op :vector-literal :items (get compiled :value)}))
                      :work-count (+ charge (get compiled :work-count))) compiled))
                (p15-s23-typed-node-error (if (= true (get checked :unsupported-key?)) :unsupported-typed-map-key mismatch) node)))
            (p15-s23-typed-node-error mismatch node)))))))

(defn p15-s23-typed-compile-keyword-lookup [context node budget]
  ; Current public C7 verification owns recursive shape reconstruction. This
  ; projection joins the solved lookup row to the same source and ordered IR.
  (let [children (get node :children) attrs (get node :attributes) forms (get context :forms)
        owner (get forms (get (get node :source) :form-id)) ids (get owner :child-form-ids)
        key-node (get (get context :nodes) (get children 0)) operand (get (get context :nodes) (get children 1))
        key-form (get forms (get ids 0)) operand-form (get forms (get ids 1)) key (get attrs :keyword)
        records (get (get context :core) :keyword-lookups [])
        row (p15-s23-typed-row context :sh08-keyword-map-lookup-v1 (get node :node-id))
        premise (get row :dependencies) solution (get row :solution)
        type (get (get context :types) (get node :node-id))
        operand-type (get (get context :types) (get operand :node-id))
        type-kind (if (map? type) (get type :kind) type)
        row-type (get row :rhs) selected (get premise :selected-shape)
        presence (get solution :presence) charge (+ 40 (* 4 (count records)))]
    (if (< budget charge) (p15-s23-typed-node-error :typed-lowering-work-limit node)
    (let [record (get (p15-s23-typed-index records :core-node-id) (get node :node-id))]
    (if (if (vector? children) (if (= 2 (count children))
          (if (vector? ids) (if (= 2 (count ids)) (keyword? key) false) false) false) false)
      (if (p15-s23-typed-all
            [(= :solved (get row :status)) (= :equality (get row :kind))
             (= type-kind (if (map? row-type) (get row-type :kind) row-type))
             (= type-kind (let [value (get solution :result-type)] (if (map? value) (get value :kind) value)))
             (= :list (get owner :kind)) (= [] (get node :resolved-binding-ids))
             (= (get owner :syntax-id) (get (get node :source) :syntax-id) (get (get premise :source) :syntax-id))
             (= (get owner :form-id) (get (get premise :source) :form-id))
             (= (get node :node-id) (get record :core-node-id))
             (= record (get premise :lookup-record))
             (= presence (get premise :presence))
             (= (get solution :selected-coordinate) (get premise :selected-coordinate))
             (= (get key-node :node-id) (get record :keyword-node-id) (get premise :keyword-node-id))
             (= (get operand :node-id) (get record :map-node-id) (get premise :operand-node-id))
             (= children (get record :ordered-evaluation-node-ids))
             (= key (get record :keyword) (get key-form :value) (get (get key-node :attributes) :value))
             (= :keyword (get key-form :kind) (get (get key-node :attributes) :literal-kind))
             (= :literal (get key-node :core-form))
             (= :gravity.type/keyword (get (get context :types) (get key-node :node-id)))
             (= (get ids 0) (get (get key-node :source) :form-id))
             (= (get ids 1) (get (get operand :source) :form-id))
             (= (get key-form :syntax-id) (get (get key-node :source) :syntax-id))
             (= (get operand-form :syntax-id) (get (get operand :source) :syntax-id))
             (= (get owner :form-id) (get key-form :parent-form-id) (get operand-form :parent-form-id))
             (= 0 (get attrs :keyword-child-index)) (= 1 (get attrs :map-child-index))
             (= :keyword-map-lookup (get attrs :dispatch))
             (= :nil (get attrs :missing-key-policy) (get record :missing-key-policy))
             (= :map-value-or-nil (get attrs :result-policy) (get record :result-policy))
             (= :keyword-then-map (get attrs :evaluation-order) (get record :evaluation-order))
             (p15-s23-typed-ordered-node? node :keyword-then-map)
             (if (= :gravity.type/never operand-type)
               (p15-s23-typed-all [(= :gravity.type/never type) (= :no-normal-result presence) (= nil selected)])
               (p15-s23-typed-all [(= :map (get (get premise :operand-shape) :shape-kind))
                 (contains? #{:present :absent} presence)
                 (= type-kind (let [value (get selected :type)] (if (map? value) (get value :kind) value)))
                 (if (= :absent presence) (= :gravity.type/nil type) (integer? (get solution :selected-coordinate)))]))])
        (let [compiled (p15-s23-typed-compile-children-mode context children (- budget charge) [] :none 0)]
          (if (p15-s23-compiler-complete? compiled)
            (assoc (p15-s23-compiler-result {:op :keyword-map-lookup :args (get compiled :value)})
              :work-count (+ charge (get compiled :work-count))) compiled))
        (p15-s23-typed-node-error :typed-keyword-lookup-evidence-mismatch node))
      (p15-s23-typed-node-error :malformed-typed-keyword-lookup node))))))

(defn p15-s23-typed-match-records [records field value]
  (loop [remaining records out []]
    (if (= 0 (count remaining)) out
      (recur (rest remaining) (if (= value (get (first remaining) field)) (conj out (first remaining)) out)))))

(defn p15-s23-typed-boolean-match-rows [rows id]
  (loop [remaining rows out []]
    (if (= 0 (count remaining)) out
      (let [row (first remaining) request (get row :constraint-id-request)]
        (recur (rest remaining)
          (if (if (= :sh08-boolean-match-v1 (get row :producer-rule))
                (if (= :gravity/sh08-boolean-match-constraint-v1 (get request :domain)) (= id (get request :match-core-node-id)) false) false)
            (conj out row) out))))))

(defn p15-s23-typed-match-append [left right]
  (if (vector? right)
    (loop [remaining right out left]
      (if (= 0 (count remaining)) out (recur (rest remaining) (conj out (first remaining))))) nil))

(defn p15-s23-typed-match-uses [context root binding budget]
  (loop [pending [root] seen #{} work 0]
    (if (= 0 (count pending))
      (let [sequence (get (get context :core) :nodes) total (+ work (count sequence))]
        (if (> total budget) (p15-s23-typed-error :typed-lowering-work-limit)
          (loop [remaining sequence uses []]
            (if (= 0 (count remaining)) {:status :complete :uses uses :work-count total}
              (let [node (first remaining)]
                (recur (rest remaining)
                  (if (if (contains? seen (get node :node-id))
                        (if (= :reference (get node :core-form)) (= binding (get (get node :attributes) :binding-id)) false) false)
                    (conj uses (get (get node :source) :syntax-id)) uses)))))))
      (if (>= work budget) (p15-s23-typed-error :typed-lowering-work-limit)
        (let [id (first pending) node (get (get context :nodes) id) children (get node :children)]
          (if (if (map? node) (vector? children) false)
            (if (> (+ work 1 (count children)) budget) (p15-s23-typed-error :typed-lowering-work-limit)
            (if (contains? seen id) (p15-s23-typed-error :cyclic-typed-match-body)
              (recur (p15-s23-typed-match-append children (vec (rest pending)))
                     (conj seen id) (+ work 1 (count children)))))
            (p15-s23-typed-error :malformed-typed-match-body)))))))

(defn p15-s23-typed-boolean-match-branch [context node branch pattern row skeleton ordinal domain budget]
  (let [forms (get context :forms) nodes (get context :nodes) owner (get forms (get (get node :source) :form-id))
        ids (get owner :child-form-ids) body-id (get (get node :children) (+ ordinal 1)) body (get nodes body-id)
        pattern-form (get forms (get ids (+ 2 (* 2 ordinal)))) body-form (get forms (get ids (+ 3 (* 2 ordinal))))
        kind (get branch :pattern-kind) value (get branch :pattern-value) binder (get branch :pattern-binding-id)
        binding (get (get context :bindings) binder) name (get binding :name) request (get row :constraint-id-request)
        body-type (get (get context :types) body-id) row-type (get row :rhs)
        result-type (get (get context :types) (get node :node-id))
        tag (if (map? body-type) (get body-type :kind) body-type)
        selected (if (= :literal kind) (if (boolean? value) (if (contains? (set domain) value) [value] []) []) domain)
        residual (loop [remaining domain out []]
                   (if (= 0 (count remaining)) out
                     (recur (rest remaining) (if (contains? (set selected) (first remaining)) out (conj out (first remaining))))))
        clause-fields [:clause-ordinal :branch-child-index :pattern-kind :pattern-form-id :pattern-syntax-id :pattern-value
                       :branch-form-id :branch-syntax-id :pattern-binding-id :pattern-binding-scope-id :pattern-binding-ids]
        fixed (if (= :binding kind) (+ 20 (count (get (get context :core) :nodes))) 20)]
    (if (< budget fixed) (p15-s23-typed-node-error :typed-lowering-work-limit node)
    (if (if (= :literal kind) (boolean? value) (if (contains? #{:wildcard :binding} kind) (symbol? value) false))
    (if (p15-s23-typed-all
          [(contains? #{:literal :wildcard :binding} kind) (= false (contains? branch :guard)) (= false (contains? pattern :guard))
           (if (= :literal kind) (if (= :boolean (get pattern-form :kind)) (contains? #{true false} value) false)
             (if (= :symbol (get pattern-form :kind)) (if (= :wildcard kind) (= '_ value) (if (symbol? value) (= false (= '_ value)) false)) false))
           (= value (get pattern-form :value) (get pattern :pattern-value))
           (= kind (get pattern :pattern-kind)) (= ordinal (get branch :clause-ordinal) (get pattern :clause-ordinal) (get request :clause-ordinal))
           (= (get node :node-id) (get branch :core-node-id) (get pattern :core-node-id) (get request :match-core-node-id))
           (= (+ ordinal 1) (get branch :branch-child-index)) (= body-id (get branch :branch-core-node-id))
           (= body-id (get body :node-id))
           (= (first (get node :children)) (get branch :scrutinee-core-node-id))
           (= (get branch :clause-count) (get (get node :attributes) :branch-count))
           (= (p15-s23-typed-project branch clause-fields) (get (get (get node :attributes) :branch-clauses) ordinal))
           (= branch (get request :branch)) (= pattern (get request :pattern)) (= skeleton (get request :skeleton))
           (= :solved (get row :status)) (= :equality (get row :kind)) (= :sh08-boolean-match-v1 (get row :producer-rule))
           (= [] (get row :diagnostics)) (= (get row :profile) (get (get (get context :core) :module) :profile))
           (= (get row :target) (get (get (get context :core) :module) :target))
           (= :gravity.type/bool (get row :scrutinee-type)) (= body-id (get row :lhs))
           (= tag (if (map? row-type) (get row-type :kind) row-type))
           (= false (= nil tag)) (= false (= :gravity.type/unknown tag))
           (if (= :gravity.type/never tag) true (= tag (if (map? result-type) (get result-type :kind) result-type)))
           (= domain (get row :remaining-before)) (= selected (get row :matched-values)) (= residual (get row :remaining-after))
           (> (count selected) 0) (= (= 0 (count residual)) (get row :exhaustive-after?))
           (= [(first (get node :children)) body-id] (get row :dependencies))
           (= (get pattern-form :form-id) (get branch :pattern-form-id) (get pattern :pattern-form-id))
           (= (get pattern-form :syntax-id) (get branch :pattern-syntax-id) (get pattern :pattern-syntax-id))
           (= (get body-form :form-id) (get branch :branch-form-id) (get (get body :source) :form-id))
           (= (get body-form :syntax-id) (get branch :branch-syntax-id) (get (get body :source) :syntax-id))
           (= (get owner :form-id) (get pattern-form :parent-form-id) (get body-form :parent-form-id))
           (= (get row :source) (p15-s23-typed-source pattern-form)) (= (get row :branch-source) (get body :source) (p15-s23-typed-source body-form))
           (= 0 (get pattern :depth) (get pattern :local-ordinal) (get pattern :root-local-ordinal))
           (= [] (get pattern :path)) (= nil (get pattern :parent-ordinal) (get pattern :parent-local-ordinal))
           (= (get pattern :ordinal) (get pattern :root-ordinal))
           (= {:kind :match-branch :match-syntax-id (get (get node :source) :syntax-id) :clause-ordinal ordinal}
              (get branch :conditional-region) (get (get body :evaluation) :region))
           (= :evaluate-scrutinee-once (get branch :scrutinee-evaluation))
           (= :conditionally-evaluate-selected-branch (get branch :branch-evaluation))
           (= (get (get node :attributes) :authenticated-sh06-artifact-id) (get branch :authenticated-sh06-artifact-id) (get pattern :authenticated-sh06-artifact-id))
           (= (get (get node :attributes) :sh06-semantic-projection-id) (get branch :sh06-semantic-projection-id) (get pattern :sh06-semantic-projection-id))
           (= binder (get pattern :pattern-binding-id) (get row :pattern-binding-id))
           (= (get branch :pattern-binding-scope-id) (get pattern :pattern-binding-scope-id) (get row :pattern-binding-scope-id))
           (= (get branch :pattern-binding-use-syntax-ids) (get pattern :pattern-binding-use-syntax-ids))
           (= (get branch :pattern-binding-ids) (if (= :binding kind) [binder] []))
           (if (= :binding kind)
             (p15-s23-typed-all [(symbol? name) (= name value) (= :lexical (get binding :binding-class))
               (= (get binding :definition-syntax-id) (get pattern-form :syntax-id))
               (= (get binding :scope-id) (get pattern-form :scope-id) (get branch :pattern-binding-scope-id))
               (= :gravity.type/bool (get row :binding-type))])
             (p15-s23-typed-all [(= nil binder (get branch :pattern-binding-scope-id) (get row :binding-type))
                               (= [] (get branch :pattern-binding-use-syntax-ids))]))])
      (let [uses (if (= :binding kind) (p15-s23-typed-match-uses context body-id binder (- budget fixed))
                   {:status :complete :uses [] :work-count 0})
            global (if (= :binding kind)
                     (loop [remaining (get (get context :core) :nodes) out [] valid? true]
                       (if (= 0 (count remaining)) {:uses out :valid? valid?}
                         (let [use (first remaining) source (get use :source) form (get forms (get source :form-id))]
                           (if (if (= :reference (get use :core-form)) (= binder (get (get use :attributes) :binding-id)) false)
                             (recur (rest remaining) (conj out (get source :syntax-id))
                               (if (p15-s23-typed-all [(= :gravity.type/bool (get (get context :types) (get use :node-id)))
                                     (= name (get form :value)) (= :symbol (get form :kind)) (= source (p15-s23-typed-source form))]) valid? false))
                             (recur (rest remaining) out valid?))))) {:uses [] :valid? true})
            used (+ fixed (get uses :work-count 0))
            active (if (= :binding kind) (assoc context :locals (assoc (get context :locals) binder name)
                                                       :parameter-types (assoc (get context :parameter-types) binder :gravity.type/bool)) context)]
        (if (= false (p15-s23-compiler-complete? uses)) uses
        (if (p15-s23-typed-all [(= true (get global :valid?)) (= (get branch :pattern-binding-use-syntax-ids) (get uses :uses) (get global :uses))])
          (let [compiled (p15-s23-typed-compile-node active body-id (- budget used))]
            (if (p15-s23-compiler-complete? compiled)
              (assoc (p15-s23-compiler-result {:instruction (get compiled :value) :kind kind :name name :selected selected :residual residual
                                             :body-type tag}) :work-count (+ used (get compiled :work-count))) compiled))
          (p15-s23-typed-node-error :typed-boolean-match-binding-uses-mismatch node))))
      (p15-s23-typed-node-error :typed-boolean-match-branch-evidence-mismatch node))
      (p15-s23-typed-node-error :unsupported-typed-boolean-pattern node)))))

(defn p15-s23-typed-compile-boolean-match [context node budget]
  (let [core (get context :core) id (get node :node-id) children (get node :children) attrs (get node :attributes)
        all-branches (get core :match-branch-records) all-patterns (get core :match-pattern-records) all-skeletons (get core :match-decision-skeletons)
        forms (get context :forms) owner (get forms (get (get node :source) :form-id)) ids (get owner :child-form-ids)]
    (if (= false (p15-s23-typed-all [(vector? children) (vector? ids) (vector? all-branches) (vector? all-patterns) (vector? all-skeletons)]))
      (p15-s23-typed-node-error :malformed-typed-boolean-match node)
      (let [n (- (count children) 1) fixed (+ 32 (* 2 (+ (count all-branches) (count all-patterns) (count all-skeletons))))]
        (if (< budget fixed) (p15-s23-typed-node-error :typed-lowering-work-limit node)
        (let [branches (p15-s23-typed-match-records all-branches :core-node-id id)
              patterns (p15-s23-typed-match-records all-patterns :core-node-id id)
              skeletons (p15-s23-typed-match-records all-skeletons :core-node-id id) skeleton (first skeletons)
              rows (p15-s23-typed-boolean-match-rows (get context :ledger) id)
              scrutinee (get (get context :nodes) (first children)) scrutinee-form (get forms (get ids 1)) operator (get forms (get ids 0))]
          (if (p15-s23-typed-all [(contains? #{1 2} n) (= n (count branches) (count patterns) (count rows) (get attrs :branch-count))
                (= 1 (count skeletons)) (= (+ 2 (* 2 n)) (count ids)) (= :list (get owner :kind)) (= :symbol (get operator :kind))
                (= 'match (get operator :value)) (= [] (get operator :child-form-ids))
                (= false (contains? attrs :guard-rule-version)) (= false (contains? attrs :guard-child-indexes))
                (= (get owner :form-id) (get operator :parent-form-id) (get scrutinee-form :parent-form-id))
                (= (get node :source) (p15-s23-typed-source owner)) (= (get scrutinee :source) (p15-s23-typed-source scrutinee-form))
                (= (first children) (get scrutinee :node-id))
                (= :gravity.type/bool (get (get context :types) (first children))) (= 0 (get attrs :scrutinee-child-index))
                (= (p15-s23-typed-index-range 1 (+ n 1)) (get attrs :branch-child-indexes))
                (= :scrutinee-then-source-ordered-pattern-candidates (get (get node :evaluation) :kind) (get attrs :evaluation-order))
                (= [{:index 0 :core-node-id (first children)}] (get (get node :evaluation) :order))
                (= (get skeleton :core-node-id) id) (= (get skeleton :scrutinee-core-node-id) (first children))
                (= (get skeleton :branch-core-node-ids) (subvec children 1 (count children)))
                (= :source-ordered-pattern-candidates (get skeleton :selection-policy) (get attrs :selection-policy))
                (= :not-asserted-by-sh07-b11 (get skeleton :runtime-reachability) (get attrs :runtime-reachability))
                (= :pending-sh08 (get skeleton :result-type-join) (get attrs :result-type-join) (get skeleton :exhaustiveness) (get attrs :exhaustiveness))
                (= (get skeleton :authenticated-sh06-artifact-id) (get attrs :authenticated-sh06-artifact-id))
                (= (get skeleton :sh06-semantic-projection-id) (get attrs :sh06-semantic-projection-id))
                (= (get node :resolved-binding-ids) (loop [remaining branches out []]
                     (if (= 0 (count remaining)) out (recur (rest remaining) (p15-s23-typed-match-append out (get (first remaining) :pattern-binding-ids))))))])
            (let [test (p15-s23-typed-compile-node (assoc context :tail? false) (first children) (- budget fixed))]
              (if (p15-s23-compiler-complete? test)
                (loop [index 0 domain [true false] out [] used (+ fixed (get test :work-count)) normal? false]
                  (if (= index n)
                    (if (if (= [] domain)
                          (if (= :gravity.type/never (get (get context :types) id)) (= false normal?) normal?) false)
                      (let [first-branch (get out 0) second-branch (get out 1)
                            wrap (if (= n 1)
                                   (if (= :binding (get first-branch :kind))
                                     {:op :let :bindings [{:name (get first-branch :name) :expr (get test :value)}] :body [(get first-branch :instruction)]}
                                     {:op :do :body [(get test :value) (get first-branch :instruction)]})
                                   (let [second-ir (if (= :binding (get second-branch :kind))
                                                     {:op :let :bindings [{:name (get second-branch :name) :expr {:op :literal :value (first (get second-branch :selected))}}]
                                                      :body [(get second-branch :instruction)]} (get second-branch :instruction))]
                                     {:op :if :test (get test :value)
                                      :then (if (= true (first (get first-branch :selected))) (get first-branch :instruction) second-ir)
                                      :else (if (= false (first (get first-branch :selected))) (get first-branch :instruction) second-ir)}))]
                        (assoc (p15-s23-compiler-result wrap) :work-count used))
                      (p15-s23-typed-node-error (if (= [] domain) :typed-boolean-match-result-type-mismatch :unsupported-partial-typed-boolean-match) node))
                    (let [branch (p15-s23-typed-boolean-match-branch context node (get branches index) (get patterns index) (get rows index)
                                                                  skeleton index domain (- budget used))]
                      (if (p15-s23-compiler-complete? branch)
                        (recur (+ index 1) (get (get branch :value) :residual) (conj out (get branch :value)) (+ used (get branch :work-count))
                               (if (= :gravity.type/never (get (get branch :value) :body-type)) normal? true)) branch)))) test))
            (p15-s23-typed-node-error :unsupported-or-mismatched-typed-boolean-match node))))))))

(defn p15-s23-typed-structural-match-rows [rows id]
  (loop [remaining rows out []]
    (if (= 0 (count remaining)) out
      (let [row (first remaining) request (get row :constraint-id-request)]
        (recur (rest remaining)
          (if (if (= :sh08-structural-match-v1 (get row :producer-rule))
                (if (contains? #{:gravity/sh08-structural-match-constraint-v1 :gravity/sh08-guarded-structural-match-constraint-v1} (get request :domain))
                  (= id (get request :match-core-node-id)) false) false)
            (conj out row) out))))))

(defn p15-s23-typed-pattern-atom? [family value]
  (if (= family :nil) (= nil value)
    (if (= family :boolean) (boolean? value)
      (if (= family :string) (string? value)
        (if (= family :keyword) (keyword? value)
          (if (= family :symbol) (symbol? value)
            (if (= family :character) (char? value)
              (if (= family :integer) (integer? value) false))))))))

(defn p15-s23-typed-map-extend [left right]
  (loop [remaining (keys right) out left]
    (if (= 0 (count remaining)) out
      (recur (rest remaining) (assoc out (first remaining) (get right (first remaining)))))))

(defn p15-s23-typed-pattern-binding [context record form extractions body budget]
  (let [id (get record :pattern-binding-id) binding (get (get context :bindings) id)
        fixed (+ 16 (count extractions) (count (get (get context :core) :nodes)))]
    (if (< budget fixed) (p15-s23-typed-error :typed-lowering-work-limit)
      (let [values (p15-s23-typed-match-records extractions :binding-id id) type (get (first values) :type)
            guard-id (get context :structural-guard-node-id)
            guard-uses (if (= guard-id nil) {:status :complete :uses [] :work-count 0}
                         (p15-s23-typed-match-uses context guard-id id (- budget fixed)))
            body-uses (if (p15-s23-compiler-complete? guard-uses)
                        (p15-s23-typed-match-uses context body id (- budget fixed (get guard-uses :work-count))) guard-uses)
            uses (if (p15-s23-compiler-complete? body-uses)
                   {:status :complete :uses (p15-s23-typed-match-append (get guard-uses :uses) (get body-uses :uses))
                    :work-count (+ (get guard-uses :work-count) (get body-uses :work-count))} body-uses)]
        (if (= false (p15-s23-compiler-complete? uses)) uses
        (if (p15-s23-typed-all [(symbol? (get binding :name)) (= (get binding :name) (get form :value) (get record :pattern-value))
              (= :lexical (get binding :binding-class)) (= (get binding :definition-syntax-id) (get form :syntax-id))
              (= (get binding :scope-id) (get form :scope-id) (get record :pattern-binding-scope-id))
              (> (count values) 0) (= false (= nil type)) (= false (= :gravity.type/unknown type))
              (= (get record :pattern-binding-use-syntax-ids) (get uses :uses))
              (loop [remaining values]
                (if (= 0 (count remaining)) true
                  (let [value (first remaining)]
                    (if (p15-s23-typed-all [(= type (get value :type)) (= (get binding :scope-id) (get value :scope-id))
                          (= (get form :form-id) (get value :pattern-form-id)) (= (get form :syntax-id) (get value :pattern-syntax-id))
                          (= (get record :path) (get value :pattern-path)) (= form (get value :source-form))
                          (vector? (get value :constructor-path))]) (recur (rest remaining)) false))))
              (loop [remaining (get (get context :core) :nodes) out []]
                (if (= 0 (count remaining)) (= out (get uses :uses))
                  (let [node (first remaining) source (get node :source) use-form (get (get context :forms) (get source :form-id))]
                    (if (if (= :reference (get node :core-form)) (= id (get (get node :attributes) :binding-id)) false)
                      (if (p15-s23-typed-all [(= type (get (get context :types) (get node :node-id)))
                            (= (get binding :name) (get use-form :value)) (= :symbol (get use-form :kind))
                            (= source (p15-s23-typed-source use-form))])
                        (recur (rest remaining) (conj out (get source :syntax-id))) false)
                      (recur (rest remaining) out)))))])
          (assoc (p15-s23-compiler-result {:kind :binding :name (get binding :name)})
                 :locals {id (get binding :name)} :types {id type} :binding-ids [id]
                 :work-count (+ fixed (get uses :work-count)))
          (p15-s23-typed-error :typed-structural-binding-evidence-mismatch)))))))

(defn p15-s23-typed-pattern-project [context tree match-id clause root parent path extractions body budget]
  ; Public C7 verification owns partition/shape solving. This bounded traversal
  ; projects its tree and joins exact source coordinates and binding extractions.
  (let [record (get tree :record) form (get tree :form) kind (get record :pattern-kind)
        children (get tree :children) ids (get form :child-form-ids) value (get record :pattern-value)
        guard (get record :guard) guard-index (get guard :source-child-index)
        fixed (+ 16 (count ids) (count children))]
    (if (if (> (count path) 128) true (< budget fixed)) (p15-s23-typed-error :typed-lowering-work-limit)
    (if (p15-s23-typed-all [(map? tree) (map? record) (map? form) (vector? children) (vector? ids)
          (if (= guard nil) true (p15-s23-typed-all [(= [] path) (= :map kind) (= :sh07-root-map-guard-v1 (get guard :rule-version))
            (integer? guard-index) (if (integer? guard-index) (if (> guard-index 0) (< guard-index (count ids)) false) false)]))
          (= match-id (get record :core-node-id)) (= clause (get record :clause-ordinal))
          (= record (get (get (get context :core) :match-pattern-records) (get record :ordinal)))
          (= form (get (get context :forms) (get record :pattern-form-id))) (= (get record :pattern-syntax-id) (get form :syntax-id))
          (= path (get record :path)) (= (count path) (get record :depth)) (= root (get record :root-ordinal))
          (= 0 (get record :root-local-ordinal)) (= (- (get record :ordinal) root) (get record :local-ordinal))
          (= parent (get record :parent-ordinal)) (= (if (= parent nil) nil (- parent root)) (get record :parent-local-ordinal))])
      (if (contains? #{:map :vector} kind)
        (let [map-pattern? (= kind :map) n (count children)]
          (if (p15-s23-typed-all [(= kind (get form :kind)) (= (count ids) (+ (* (if map-pattern? 2 1) n) (if (= guard nil) 0 2)))
                (if (= guard nil) true
                  (let [key (get (get context :forms) (get ids (- guard-index 1))) expression (get (get context :forms) (get ids guard-index))]
                    (p15-s23-typed-all [(= :keyword (get key :kind)) (= :when (get key :value))
                      (= (get form :form-id) (get key :parent-form-id) (get expression :parent-form-id))
                      (= (get guard :form-id) (get expression :form-id)) (= (get guard :syntax-id) (get expression :syntax-id))])))
                (if map-pattern? (= nil (get record :vector-width)) (= n (get record :vector-width)))
                (= nil (get record :pattern-binding-id) (get record :pattern-binding-scope-id))])
            (loop [index 0 out [] locals {} types {} bindings [] seen #{} work fixed count-records 1]
              (if (= index n)
                (assoc (p15-s23-compiler-result (if map-pattern? {:kind :map :entries out} {:kind :vector :items out}))
                  :locals locals :types types :binding-ids bindings :record-count count-records :work-count work)
                (let [child (get children index) raw-coordinate (if map-pattern? (+ 1 (* 2 index)) index)
                      coordinate (if (= guard nil) raw-coordinate (if (>= raw-coordinate guard-index) (+ raw-coordinate 2) raw-coordinate))
                      child-form (get (get context :forms) (get ids coordinate)) key-form (get (get context :forms) (get ids (- coordinate 1)))
                      key (get child :key)]
                  (if (p15-s23-typed-all [(= coordinate (get child :coordinate)) (= (get ids coordinate) (get child :form-id))
                        (= (get form :form-id) (get child-form :parent-form-id))
                        (if map-pattern?
                          (if (keyword? key) (p15-s23-typed-all [(= :keyword (get key-form :kind)) (= key (get key-form :value))
                            (= (get form :form-id) (get key-form :parent-form-id)) (= (get key-form :form-id) (get child :key-form-id))
                            (= false (contains? seen key))]) false) (= nil key (get child :key-form-id)))])
                    (let [projected (p15-s23-typed-pattern-project context (get child :tree) match-id clause root (get record :ordinal)
                                     (conj path coordinate) extractions body (- budget work))]
                      (if (p15-s23-compiler-complete? projected)
                        (if (< (- budget work (get projected :work-count)) (* 2 (count (get projected :binding-ids))))
                          (p15-s23-typed-error :typed-lowering-work-limit)
                        (recur (+ index 1) (conj out (if map-pattern? {:key key :pattern (get projected :value)} (get projected :value)))
                          (p15-s23-typed-map-extend locals (get projected :locals)) (p15-s23-typed-map-extend types (get projected :types))
                          (p15-s23-typed-match-append bindings (get projected :binding-ids)) (if map-pattern? (conj seen key) seen)
                          (+ work (get projected :work-count) (* 2 (count (get projected :binding-ids)))) (+ count-records (get projected :record-count)))) projected))
                    (p15-s23-typed-error :typed-structural-pattern-coordinate-mismatch)))))
            (p15-s23-typed-error :typed-structural-pattern-shape-mismatch)))
        (if (= 0 (count children))
          (if (= kind :binding)
            (let [bound (p15-s23-typed-pattern-binding context record form extractions body (- budget fixed))]
              (if (p15-s23-compiler-complete? bound) (assoc bound :record-count 1 :work-count (+ fixed (get bound :work-count))) bound))
            (let [family (if (= :list (get form :kind)) :symbol (get form :kind))
                  literal? (if (= kind :literal) (p15-s23-typed-pattern-atom? family value) false)]
              (if (if (= kind :wildcard) (if (= :symbol (get form :kind)) (= '_ value (get form :value)) false)
                    (if literal? (if (= :list (get form :kind))
                      (let [operator (get (get context :forms) (get ids 0)) payload (get (get context :forms) (get ids 1))]
                        (p15-s23-typed-all [(= 2 (count ids)) (= :symbol (get operator :kind) (get payload :kind))
                          (= 'quote (get operator :value)) (= value (get payload :value))
                          (= (get form :form-id) (get operator :parent-form-id) (get payload :parent-form-id))]))
                      (= value (get form :value))) false))
                (assoc (p15-s23-compiler-result (if (= kind :wildcard) {:kind :wildcard} {:kind :literal :family family :value value}))
                  :locals {} :types {} :binding-ids [] :record-count 1 :work-count fixed)
                (p15-s23-typed-error :unsupported-typed-structural-pattern-leaf))))
          (p15-s23-typed-error :typed-structural-pattern-leaf-children)))
      (p15-s23-typed-error :typed-structural-pattern-source-mismatch)))))

(defn p15-s23-typed-structural-guard [context node branch row budget]
  (if (contains? branch :guard)
    (let [guard (get branch :guard) id (get guard :node-id) typed (get row :guard)
          expression (get (get context :nodes) id) form (get (get context :forms) (get guard :form-id))
          type (get (get context :types) id) attrs (get expression :attributes)
          literal? (if (= :literal (get expression :core-form)) (= :boolean (get attrs :literal-kind))
                     (if (= :quote (get expression :core-form)) (= :boolean (get attrs :quoted-kind)) false))
          value (if (= :quote (get expression :core-form)) (get attrs :quoted-value) (get attrs :value))
          truth (if (= type :gravity.type/never) :never (if literal? (if value :true :false) :unknown))
          source (p15-s23-typed-project guard [:rule-version :source-child-index :form-id :syntax-id])
          fixed 24]
      (if (< budget fixed) (p15-s23-typed-error :typed-lowering-work-limit)
        (if (p15-s23-typed-all [(contains? #{:gravity.type/bool :gravity.type/never} type)
              (= id (get expression :node-id) (get typed :core-node-id)) (= type (get typed :type)) (= truth (get typed :truth))
              (= id (get (get node :children) (get guard :child-index)))
              (= :sh08-bool-root-map-guard-v1 (get typed :rule-version) (get row :guard-rule-version))
              (= typed (get (get row :constraint-id-request) :guard) (get (get row :dependencies) :guard))
              (= source (get typed :source)) (= (get expression :source) (p15-s23-typed-source form))
              (= source (get (get (get (get row :constraint-id-request) :pattern-tree) :record) :guard))
              (= {:kind :match-guard :match-syntax-id (get (get node :source) :syntax-id) :clause-ordinal (get branch :clause-ordinal)}
                 (get guard :conditional-region) (get typed :conditional-region) (get (get expression :evaluation) :region))
              (= :once-after-structural-success (get guard :evaluation) (get typed :evaluation))
              (= :next-candidate (get guard :on-pattern-failure) (get typed :on-pattern-failure) (get guard :on-false) (get typed :on-false))
              (= :branch-body (get guard :on-true) (get typed :on-true))
              (= (get branch :pattern-binding-ids) (get typed :binding-ids))
              (= {:guard guard :binding-ids (get branch :pattern-binding-ids)} (get typed :dependencies))
              (= truth (get (get row :solution) :guard-truth))
              (= (get row :matched-shapes) (get (get row :solution) :guard-body-shapes))
              (= (get row :remaining-after) (get (get row :solution) :guard-fallthrough-shapes))
              (= (if (contains? #{:false :never} truth) :not-executed :potential) (get (get row :solution) :body-completion))
              (= (if (contains? #{:false :never} truth) :gravity.type/never (get row :rhs)) (get (get row :solution) :effective-result-type))])
          ; Keep lexical ancestry for a guard-local loop's authenticated parent;
          ; tail? false still prevents transfer to that enclosing target.
          (let [compiled (p15-s23-typed-compile-node (assoc context :tail? false) id (- budget fixed))]
            (if (p15-s23-compiler-complete? compiled) (assoc compiled :work-count (+ fixed (get compiled :work-count))) compiled))
          (p15-s23-typed-error :typed-structural-guard-evidence-mismatch))))
    (assoc (p15-s23-compiler-result nil) :work-count 0)))

(defn p15-s23-typed-compile-structural-match [context node budget]
  (let [core (get context :core) id (get node :node-id) children (get node :children) attrs (get node :attributes)
        all-branches (get core :match-branch-records) all-patterns (get core :match-pattern-records) all-skeletons (get core :match-decision-skeletons)
        forms (get context :forms) owner (get forms (get (get node :source) :form-id)) ids (get owner :child-form-ids)
        fixed (+ 40 (* 2 (+ (count all-branches) (count all-patterns) (count all-skeletons))))]
    (if (< budget fixed) (p15-s23-typed-node-error :typed-lowering-work-limit node)
    (if (p15-s23-typed-all [(vector? children) (vector? ids) (vector? all-branches) (vector? all-patterns) (vector? all-skeletons)])
      (let [branches (p15-s23-typed-match-records all-branches :core-node-id id)
            patterns (p15-s23-typed-match-records all-patterns :core-node-id id)
            skeletons (p15-s23-typed-match-records all-skeletons :core-node-id id) skeleton (first skeletons)
            rows (p15-s23-typed-structural-match-rows (get context :ledger) id) n (count branches)
            guard-ids (loop [remaining branches out []]
                        (if (= 0 (count remaining)) out
                          (recur (rest remaining) (if (contains? (first remaining) :guard) (conj out (get (get (first remaining) :guard) :node-id)) out))))
            scrutinee (get (get context :nodes) (first children)) operator (get forms (get ids 0))
            shape (get (first rows) :constructor-shape) type (get (get context :types) id)
            fields [:clause-ordinal :branch-child-index :pattern-kind :pattern-form-id :pattern-syntax-id :pattern-value
                    :branch-form-id :branch-syntax-id :pattern-binding-id :pattern-binding-scope-id :pattern-binding-ids]]
        (if (p15-s23-typed-all [(> n 0) (= n (count rows) (get attrs :branch-count)) (= (+ n 1 (count guard-ids)) (count children))
              (= 1 (count skeletons)) (= (+ 2 (* n 2)) (count ids))
              (= :list (get owner :kind)) (= :symbol (get operator :kind)) (= 'match (get operator :value))
              (= [] (get operator :child-form-ids)) (= (get owner :form-id) (get operator :parent-form-id))
              (if (= 0 (count guard-ids))
                (p15-s23-typed-all [(= false (contains? attrs :guard-rule-version)) (= false (contains? attrs :guard-child-indexes))])
                (p15-s23-typed-all [(= :sh07-root-map-guard-v1 (get attrs :guard-rule-version) (get node :lowering-rule-version))
                  (= (p15-s23-typed-index-range (+ n 1) (+ n 1 (count guard-ids))) (get attrs :guard-child-indexes))
                  (= guard-ids (subvec children (+ n 1) (count children)))]))
              (= (get node :source) (p15-s23-typed-source owner))
              (= (get scrutinee :source) (p15-s23-typed-source (get forms (get ids 1))))
              (= (get owner :form-id) (get (get forms (get ids 1)) :parent-form-id))
              (= (first children) (get scrutinee :node-id)) (= :accepted (get shape :status))
              (if (= :gravity.type/keyword (get (get context :types) (first children)))
                (if (contains? #{:scalar :alternatives} (get shape :shape-kind)) (= :gravity.type/keyword (get shape :type)) false)
                (contains? #{:map :vector :alternatives} (get shape :shape-kind)))
              (= 0 (get attrs :scrutinee-child-index)) (= (p15-s23-typed-index-range 1 (+ n 1)) (get attrs :branch-child-indexes))
              (= :scrutinee-then-source-ordered-pattern-candidates (get attrs :evaluation-order) (get (get node :evaluation) :kind))
              (= [{:index 0 :core-node-id (first children)}] (get (get node :evaluation) :order))
              (= id (get skeleton :core-node-id)) (= (first children) (get skeleton :scrutinee-core-node-id))
              (= (subvec children 1 (+ n 1)) (get skeleton :branch-core-node-ids))
              (= :source-ordered-pattern-candidates (get attrs :selection-policy) (get skeleton :selection-policy))
              (= :not-asserted-by-sh07-b11 (get attrs :runtime-reachability) (get skeleton :runtime-reachability))
              (= :pending-sh08 (get attrs :result-type-join) (get skeleton :result-type-join) (get attrs :exhaustiveness) (get skeleton :exhaustiveness))
              (= (get attrs :authenticated-sh06-artifact-id) (get skeleton :authenticated-sh06-artifact-id))
              (= (get attrs :sh06-semantic-projection-id) (get skeleton :sh06-semantic-projection-id))])
          (let [test (p15-s23-typed-compile-node (assoc context :tail? false) (first children) (- budget fixed))]
            (if (p15-s23-compiler-complete? test)
              (loop [index 0 out [] work (+ fixed (get test :work-count)) previous nil binding-ids [] record-count 0 normal? false]
                (if (= index n)
                  (if (p15-s23-typed-all [(= [] previous) (= (count patterns) record-count)
                        (= binding-ids (get node :resolved-binding-ids))
                        (if (= type :gravity.type/never) (= false normal?) normal?)])
                    (assoc (p15-s23-compiler-result {:op :structural-match :scrutinee (get test :value) :clauses out}) :work-count work)
                    (p15-s23-typed-node-error :typed-structural-match-census-mismatch node))
                  (let [branch (get branches index) row (get rows index) request (get row :constraint-id-request)
                        tree (get request :pattern-tree) root (get tree :record) body-id (get children (+ index 1)) body (get (get context :nodes) body-id)
                        body-form (get forms (get ids (+ 3 (* index 2)))) pattern-form (get forms (get ids (+ 2 (* index 2))))
                        body-type (get (get context :types) body-id) extractions (get row :extractions)
                        guarded? (contains? branch :guard)
                        effective (if guarded? (get (get row :solution) :effective-result-type) body-type)]
                    (if (p15-s23-typed-all [(= index (get branch :clause-ordinal) (get request :clause-ordinal))
                          (= id (get request :match-core-node-id) (get branch :core-node-id)) (= n (get branch :clause-count))
                          (= branch (get request :branch)) (= skeleton (get request :skeleton))
                          (= guarded? (contains? row :guard))
                          (= (let [clause (p15-s23-typed-project branch fields)]
                               (if guarded? (assoc clause :guard (p15-s23-typed-project (get branch :guard)
                                 [:rule-version :source-child-index :form-id :syntax-id :child-index :conditional-region :evaluation
                                  :on-pattern-failure :on-true :on-false :non-boolean-type-effect-legality])) clause))
                             (get (get attrs :branch-clauses) index))
                          (= body-id (get branch :branch-core-node-id) (get body :node-id) (get row :lhs))
                          (= (+ index 1) (get branch :branch-child-index)) (= (first children) (get branch :scrutinee-core-node-id))
                          (= (get pattern-form :form-id) (get branch :pattern-form-id) (get root :pattern-form-id))
                          (= (get pattern-form :syntax-id) (get branch :pattern-syntax-id) (get root :pattern-syntax-id))
                          (= (get body-form :form-id) (get branch :branch-form-id) (get (get body :source) :form-id))
                          (= (get body-form :syntax-id) (get branch :branch-syntax-id) (get (get body :source) :syntax-id))
                          (= (get owner :form-id) (get pattern-form :parent-form-id) (get body-form :parent-form-id))
                          (= (get row :source) (p15-s23-typed-source pattern-form))
                          (= (get row :branch-source) (get body :source) (p15-s23-typed-source body-form))
                          (= {:kind :match-branch :match-syntax-id (get (get node :source) :syntax-id) :clause-ordinal index}
                             (get branch :conditional-region) (get (get body :evaluation) :region))
                          (= :evaluate-scrutinee-once (get branch :scrutinee-evaluation))
                          (= :conditionally-evaluate-selected-branch (get branch :branch-evaluation))
                          (= :solved (get row :status)) (= :equality (get row :kind)) (= [] (get row :diagnostics))
                          (= (get (get core :module) :profile) (get row :profile)) (= (get (get core :module) :target) (get row :target))
                          (= body-type (get row :rhs) (get (get row :solution) :result-type))
                          (if (= effective :gravity.type/never) true (= type effective body-type))
                          (= shape (get row :constructor-shape)) (vector? (get row :remaining-before))
                          (vector? (get row :matched-shapes))
                          (if guarded? (if (vector? (get row :structurally-matched-shapes)) (> (count (get row :structurally-matched-shapes)) 0) false)
                            (> (count (get row :matched-shapes)) 0))
                          (vector? (get row :remaining-after)) (= (= [] (get row :remaining-after)) (get row :exhaustive-after?))
                          (if (= index 0) true (= previous (get row :remaining-before)))
                          (vector? extractions) (= extractions (get (get row :solution) :binding-extractions))
                          (= (get row :matched-shapes) (get (get row :solution) :selected-shapes))
                          (= (let [dependencies {:scrutinee-node-id (first children) :constructor-shape shape :pattern-tree tree :branch-node-id body-id :extractions extractions}]
                               (if guarded? (assoc dependencies :guard (get row :guard)) dependencies))
                             (get row :dependencies))])
                      (let [projected (p15-s23-typed-pattern-project (assoc context :structural-guard-node-id (get (get branch :guard) :node-id))
                                        tree id index (get root :ordinal) nil [] extractions body-id (- budget work))]
                        (if (p15-s23-compiler-complete? projected)
                          (if (= (get projected :binding-ids) (get branch :pattern-binding-ids))
                            (if (< (- budget work (get projected :work-count)) (* 2 (count (get projected :binding-ids))))
                              (p15-s23-typed-error :typed-lowering-work-limit)
                            (let [joined-work (+ (get projected :work-count) (* 2 (count (get projected :binding-ids))))
                                  active (assoc context :locals (p15-s23-typed-map-extend (get context :locals) (get projected :locals))
                                                       :parameter-types (p15-s23-typed-map-extend (get context :parameter-types) (get projected :types)))
                                  guard (p15-s23-typed-structural-guard active node branch row (- budget work joined-work))
                                  compiled (if (p15-s23-compiler-complete? guard)
                                             (p15-s23-typed-compile-node active body-id (- budget work joined-work (get guard :work-count))) guard)]
                              (if (p15-s23-compiler-complete? compiled)
                                (recur (+ index 1) (conj out (let [clause {:pattern (get projected :value) :body (get compiled :value)}]
                                                              (if guarded? (assoc clause :guard (get guard :value)) clause)))
                                  (+ work joined-work (get guard :work-count) (get compiled :work-count)) (get row :remaining-after)
                                  (p15-s23-typed-match-append binding-ids (get projected :binding-ids))
                                  (+ record-count (get projected :record-count)) (if (= effective :gravity.type/never) normal? true)) compiled)))
                            (p15-s23-typed-node-error :typed-structural-branch-bindings-mismatch node)) projected))
                      (p15-s23-typed-node-error :typed-structural-match-row-mismatch node))))) test))
          (p15-s23-typed-node-error :unsupported-or-mismatched-typed-structural-match node)))
      (p15-s23-typed-node-error :malformed-typed-structural-match node)))))

(defn p15-s23-typed-compile-if [context node budget]
  (let [children (get node :children) ledger (get context :ledger []) base (+ 1 (count ledger))
        core (get context :core) types (get context :types) id (get node :node-id)]
    (if (> base budget) (assoc (p15-s23-typed-node-error :typed-lowering-work-limit node) :work-count base)
      (if (if (vector? children) (= 3 (count children)) false)
        (let [checked (p15-s23-ij-derive core node (get context :nodes) types (get context :bindings)
                        (get context :forms) (- budget base))
              work (+ base (get checked :work-count)) premise (get checked :premise)
              retained (loop [remaining ledger out []]
                         (if (= 0 (count remaining)) out
                           (let [row (first remaining)]
                             (recur (rest remaining)
                               (if (if (contains? #{:sh08-list-if-join-v1 :sh08-nil-if-join-v1} (get row :producer-rule)) true
                                     (= :join-compatibility (get row :kind)))
                                 (if (= id (get (get row :lhs) :core-node-id)) (conj out row) out) out)))))
              condition (get types (first children) :gravity.type/unknown)
              left (get types (get children 1) :gravity.type/unknown) right (get types (get children 2) :gravity.type/unknown)
              expected (if (= condition :gravity.type/never) :gravity.type/never
                         (if (p15-s23-ij-unknown? condition) :gravity.type/unknown
                           (if (= :accepted (get checked :status)) (get checked :type)
                             (p15-s23-ij-normal-type left right))))]
          (if (if (> work budget) true (= :rejected (get checked :status)))
            (assoc (p15-s23-typed-node-error (if (> work budget) :typed-lowering-work-limit (get checked :reason)) node)
              :work-count work)
            (if (p15-s23-typed-all
                  [(= expected (get types id)) (= false (= expected :gravity.type/unknown))
                   (= premise (get (get (get context :if-join-context) :premises) id))
                   (= retained (if (= :accepted (get checked :status)) [(p15-s23-ij-row premise)] []))])
              (loop [index 0 used work values []]
                (if (= index 3)
                  (assoc (p15-s23-compiler-result {:op :if :test (first values) :then (get values 1) :else (get values 2)})
                    :work-count used)
                  (let [tail? (if (= true (get context :tail?)) (> index 0) false)
                        child (p15-s23-typed-compile-node (assoc context :tail? tail?) (get children index) (- budget used))]
                    (if (p15-s23-compiler-complete? child)
                      (recur (+ index 1) (+ used (get child :work-count)) (conj values (get child :value)))
                      (assoc child :work-count (+ used (get child :work-count 0)))))))
              (assoc (p15-s23-typed-node-error :typed-if-join-evidence-mismatch node) :work-count work))))
        (assoc (p15-s23-typed-node-error :typed-control-shape-mismatch node) :work-count base)))))

(defn p15-s23-typed-initializer-closure [context id budget]
  (loop [pending [{:id id :depth 0}] work 0]
    (if (= 0 (count pending)) {:status :accepted :work-count work}
      (let [frame (get pending (- (count pending) 1)) node (get (get context :nodes) (get frame :id))
            kind (get node :core-form) children (get node :children) depth (get frame :depth)
            width (if (vector? children) (count children) 0) total (+ work 1 (* 2 width))]
        (if (> total budget) {:status :rejected :reason :typed-lowering-work-limit :work-count total}
          (if (if (if (map? node) (vector? children) false) (<= depth 128) false)
            (if (if (contains? #{:literal :quote} kind) (= 0 width)
                    (if (= :collection-literal kind) (contains? #{:vector :map} (get (get node :attributes) :literal-kind)) false))
              (recur
                (loop [remaining children out (subvec pending 0 (- (count pending) 1))]
                  (if (= 0 (count remaining)) out
                    (recur (rest remaining) (conj out {:id (first remaining) :depth (+ depth 1)})))) total)
              {:status :rejected :reason :unsupported-typed-module-initializer :work-count total})
            {:status :rejected :reason :unsupported-typed-module-initializer :work-count total}))))))

(defn p15-s23-typed-module-initialization-context [context]
  (let [core (get context :core) roots (get core :root-core-node-ids) definitions (get core :definitions)
        nodes (get context :nodes) forms (get context :forms) bindings (get context :bindings)
        vars (get core :var-references []) mutations (get core :mutations [])
        budget (get context :budget)
        families? (p15-s23-typed-all [(vector? roots) (vector? definitions) (vector? vars) (vector? mutations)
                                     (vector? (get context :source-root-form-ids)) (vector? (get core :evaluation-order))])
        base (if families? (+ 64 (count nodes) (count forms) (* 2 (count definitions)) (* 64 (count roots)) (count bindings) (count (get context :records))
                                 (count vars) (count mutations) (count (get core :evaluation-order))) 65537)]
    (if (> base budget) (assoc (p15-s23-typed-error :typed-lowering-work-limit) :work-count base)
      (let [by-node (p15-s23-typed-index definitions :core-node-id)
            by-binding (p15-s23-typed-index definitions :binding-id)
            evaluations (p15-s23-typed-index (get core :evaluation-order) :core-node-id)
            root-set (set roots)
            all-defs (loop [remaining (get core :nodes) out #{}]
                       (if (= 0 (count remaining)) out
                         (recur (rest remaining) (if (= :def (get (first remaining) :core-form))
                                                  (conj out (get (first remaining) :node-id)) out))))]
        (if (p15-s23-typed-all [(map? by-node) (map? by-binding) (= (count roots) (count root-set) (count definitions) (count (get context :source-root-form-ids)))
                               (= root-set all-defs (set (keys by-node)))
                               (map? evaluations) (= (set (keys nodes)) (set (keys evaluations)))])
          (loop [remaining roots ordinal 0 rows [] initializers [] globals {} by-name {} summary {} used base]
            (if (= 0 (count remaining))
              (let [literal-ids (set (keys globals))
                    forbidden? (loop [remaining vars]
                                 (if (= 0 (count remaining))
                                   (loop [items mutations]
                                     (if (= 0 (count items)) false
                                       (if (contains? literal-ids (get (first items) :target-binding-id)) true (recur (rest items)))))
                                   (if (contains? literal-ids (get (first remaining) :binding-id)) true (recur (rest remaining)))))
                    function-names (loop [remaining rows out #{}]
                                     (if (= 0 (count remaining)) out
                                       (recur (rest remaining) (if (= :function (get (first remaining) :kind))
                                                                (conj out (get (first remaining) :name)) out))))
                    manifest (if (= 0 (count initializers)) nil
                               {:version :p15-s23-module-literals-v1 :module (get (get core :module) :namespace)
                                :instance-policy :fresh-per-closed-plan-execution :roots rows :initializers initializers})]
                (if (if forbidden? true (= false (= function-names (set (keys (get context :records))))))
                  (assoc (p15-s23-typed-error :unsupported-typed-module-binding-use) :work-count used)
                  (assoc (p15-s23-compiler-result
                           (assoc context :namespace-definitions globals :module-roots by-name :module-initialization manifest
                                          :module-source-evaluations evaluations :initializer-summary summary :budget (- budget used))) :work-count used)))
              (let [id (first remaining) node (get nodes id) definition (get by-node id)
                    attrs (get node :attributes) bid (get definition :binding-id) binding (get bindings bid)
                    value-id (get definition :value-node-id) value (get nodes value-id)
                    form (get forms (get (get node :source) :form-id)) ids (get form :child-form-ids)
                    operator (get forms (get ids 0)) name-form (get forms (get ids 1)) value-form (get forms (get ids 2))
                    name (get definition :name) raw (get (get context :raw-roots) (get form :form-id))
                    function? (= :fn (get value :core-form)) record (get (get context :records) name)
                    type (get (get context :types) value-id)
                    row {:ordinal ordinal :kind (if function? :function :literal) :name name :visibility (get binding :visibility)
                         :binding-id bid :definition-core-node-id id :definition-syntax-id (get binding :definition-syntax-id)
                         :definition-source (get node :source) :value-core-node-id value-id :value-source (get value :source) :type type}]
                (if (p15-s23-typed-all
                      [(= :def (get node :core-form)) (= :namespace (get binding :binding-class))
                       (= (get (get core :module) :namespace) (get binding :namespace))
                       (= (if function? :function :var) (get binding :kind))
                       (contains? #{:private :public} (get binding :visibility))
                       (= (get binding :visibility) (get attrs :visibility))
                       (= name (get binding :name) (get attrs :name) (get name-form :value))
                       (symbol? name) (= false (contains? by-name name))
                       (= [bid] (get node :resolved-binding-ids)) (= [value-id] (get node :children))
                       (= {:kind :initialize-once :region :module-initialization :owner-function-syntax-id nil
                           :order [{:index 0 :core-node-id value-id}]} (get node :evaluation))
                       (= {:core-node-id id :kind :initialize-once :region :module-initialization :owner-function-syntax-id nil
                           :children [value-id]} (get evaluations id))
                       (= (get definition :syntax-id) (get (get node :source) :syntax-id) (get form :syntax-id))
                       (= (get binding :definition-syntax-id) (get attrs :name-syntax-id) (get name-form :syntax-id))
                       (= (get name-form :form-id) (get attrs :name-form-id))
                       (= :list (get form :kind)) (vector? ids) (= 3 (count ids))
                       (= :symbol (get operator :kind) (get name-form :kind)) (= 'def (get operator :value))
                       (= (get form :form-id) (get operator :parent-form-id) (get name-form :parent-form-id) (get value-form :parent-form-id))
                       (= (p15-s23-typed-source form) (get node :source))
                       (= (get form :form-id) (get (get context :source-root-form-ids) ordinal))
                       (= (p15-s23-typed-source value-form) (get value :source))
                       (if (seq? raw)
                         (if (= 3 (count raw))
                           (if (= 'def (first raw))
                             (if (= name (second raw)) (if function? true (= (get (vec raw) 2) (get value-form :value))) false) false) false) false)
                       (= type (get (get context :types) id)) (= false (contains? #{nil :gravity.type/unknown :gravity.type/never} type))
                       (if function?
                         (p15-s23-typed-all [(map? record) (= bid (get record :definition-binding-id))
                                             (= id (get record :definition-core-node-id)) (= value-id (get record :function-core-node-id))]) true)])
                  (if function?
                    (recur (rest remaining) (+ ordinal 1) (conj rows row) initializers globals (assoc by-name name row) summary used)
                    (let [closure (p15-s23-typed-initializer-closure context value-id (- budget used))
                          prefix (+ used (get closure :work-count))
                          reserved (+ prefix (if (= :accepted (get closure :status)) (get closure :work-count) 0))
                          compiled (if (if (= :accepted (get closure :status)) (<= reserved budget) false)
                                     (p15-s23-typed-compile-node (assoc context :locals {} :parameter-types {} :namespace-definitions {}
                                       :tail? false :nearest-target nil :current-function nil)
                                       value-id (- budget reserved)) nil)
                          total (+ reserved (get compiled :work-count 0))]
                      (if (if (> total budget) true (= :rejected (get closure :status)))
                        (assoc (p15-s23-typed-error (if (> total budget) :typed-lowering-work-limit (get closure :reason))) :work-count total)
                        (if (p15-s23-compiler-complete? compiled)
                          (let [counted (p15-s23-summary-instruction (get compiled :value) summary)]
                            (if (p15-s23-compiler-complete? counted)
                              (recur (rest remaining) (+ ordinal 1) (conj rows row)
                                     (conj initializers {:ordinal ordinal :binding-id bid :instruction (get compiled :value)})
                                     (assoc globals bid row) (assoc by-name name row) (get counted :value) total) counted))
                          (assoc compiled :work-count total)))))
                  (assoc (p15-s23-typed-node-error :typed-module-definition-source-mismatch node) :work-count used)))))
          (assoc (p15-s23-typed-error :unsupported-typed-module-root-census) :work-count base))))))

(defn p15-s23-typed-namespace-reference [context node type budget]
  (let [id (get node :node-id) attrs (get node :attributes) bid (get attrs :binding-id)
        definition (get (get context :namespace-definitions) bid) binding (get (get context :bindings) bid)
        form (get (get context :forms) (get (get node :source) :form-id))
        def-node (get (get context :nodes) (get definition :definition-core-node-id))
        initializer (get (get context :nodes) (get definition :value-core-node-id))
        evaluation (get (get context :module-source-evaluations) id) work 64]
    (if (< budget work) (assoc (p15-s23-typed-node-error :typed-lowering-work-limit node) :work-count work)
      (if (p15-s23-typed-all
            [(map? definition) (= :literal (get definition :kind)) (= :reference (get node :core-form))
             (= [] (get node :children)) (= [bid] (get node :resolved-binding-ids))
             (= {:symbol (get form :value) :position :expression :binding-id bid :binding-class :namespace
                 :definition-syntax-id (get definition :definition-syntax-id)} attrs)
             (= :symbol (get form :kind)) (= (p15-s23-typed-source form) (get node :source))
             (= [:namespace :var (get (get (get context :core) :module) :namespace)]
                [(get binding :binding-class) (get binding :kind) (get binding :namespace)])
             (= (get binding :definition-syntax-id) (get definition :definition-syntax-id))
             (= bid (get binding :binding-id) (get definition :binding-id))
             (= (get binding :name) (get definition :name) (get (get def-node :attributes) :name))
             (= (get binding :visibility) (get definition :visibility) (get (get def-node :attributes) :visibility))
             (= definition (get (get context :module-roots) (get binding :name)))
             (= :def (get def-node :core-form)) (= [bid] (get def-node :resolved-binding-ids))
             (= [(get initializer :node-id)] (get def-node :children))
             (= {:kind :initialize-once :region :module-initialization :owner-function-syntax-id nil
                 :order [{:index 0 :core-node-id (get initializer :node-id)}]} (get def-node :evaluation))
             (= (get definition :definition-source) (get def-node :source))
             (= (get definition :value-source) (get initializer :source))
             (= (get definition :definition-syntax-id) (get (get def-node :attributes) :name-syntax-id))
             (= type (get definition :type) (get (get context :types) (get initializer :node-id)))
             (map? (get context :current-function))
             (= {:core-node-id id :kind :value :region (get evaluation :region)
                 :owner-function-syntax-id (get (get context :current-function) :function-syntax-id) :children []} evaluation)
             (= {:kind :value :region (get evaluation :region) :owner-function-syntax-id (get (get context :current-function) :function-syntax-id)
                 :order []} (get node :evaluation))])
        (assoc (p15-s23-compiler-result
                 {:op :namespace-read :version :p15-s23-namespace-read-v1 :binding-id bid
                  :definition-core-node-id (get definition :definition-core-node-id)
                  :definition-syntax-id (get definition :definition-syntax-id) :definition-source (get definition :definition-source)
                  :value-core-node-id (get definition :value-core-node-id) :value-source (get definition :value-source) :type type
                  :reference-core-node-id id :reference-source (get node :source)}) :work-count work)
        (assoc (p15-s23-typed-node-error :typed-reference-outside-parameters node) :work-count work)))))

(defn p15-s23-typed-compile-node [context id budget]
  (let [node (get (get context :nodes) id) form (get node :core-form) children (get node :children)
        source (get (get context :forms) (get (get node :source) :form-id)) type (get (get context :types) id)]
    (if (<= budget 0) (p15-s23-typed-node-error :typed-lowering-work-limit node)
      (if (if (map? node) (if (= nil type) false
                         (if (= :gravity.type/unknown type) false (p15-s23-ni-valid-view? type))) false)
        (if (= form :match)
          (if (= :gravity.type/bool (get (get context :types) (first children)))
            (p15-s23-typed-compile-boolean-match context node budget)
            (p15-s23-typed-compile-structural-match context node budget))
        (if (= form :if) (p15-s23-typed-compile-if context node budget)
        (if (= form :keyword-map-lookup) (p15-s23-typed-compile-keyword-lookup context node budget)
        (if (= form :loop) (p15-s23-typed-compile-loop context node budget)
        (if (= form :recur) (p15-s23-typed-compile-recur context node budget)
        (if (= form :call) (p15-s23-typed-compile-call context node budget)
        (if (= form :let) (p15-s23-typed-compile-let context node budget)
        (if (= form :try) (p15-s23-typed-compile-try context node budget)
        (if (= form :quote) (p15-s23-typed-quote context node budget)
        (if (= form :collection-literal)
          (if (= :set (get (get node :attributes) :literal-kind))
            (p15-s23-typed-compile-keyword-set context node budget)
            (if (contains? #{:vector :map} (get (get node :attributes) :literal-kind)) (p15-s23-typed-compile-collection context node budget)
              (p15-s23-typed-node-error :unsupported-typed-lowering-operation node)))
        (if (= form :literal)
          (if (if (if (= :character (get source :kind)) true
                    (if (= :character (get (get node :attributes) :literal-kind)) true (= :gravity.type/character type)))
                (= false (if (= :character (get source :kind) (get (get node :attributes) :literal-kind))
                           (if (= :gravity.type/character type) (if (= [] children) (p15-s23-typed-character-carrier? (get source :value)) false) false) false)) false)
            (p15-s23-typed-node-error :typed-character-source-type-mismatch node)
          (if (if (= :decimal (get (get node :attributes) :literal-kind)) true
                (if (map? (get source :value))
                  (= false (if (= :character (get source :kind) (get (get node :attributes) :literal-kind))
                             (if (= :gravity.type/character type) (if (= [] children) (p15-s23-typed-character-carrier? (get source :value)) false) false) false)) false))
            (p15-s23-typed-node-error :unelaborated-typed-numeric-literal node)
          (if (= (get source :value) (get (get node :attributes) :value))
            (assoc (p15-s23-compiler-result {:op :literal :value (get source :value)}) :work-count 1)
            (p15-s23-typed-node-error :typed-literal-source-mismatch node))))
          (if (= form :reference)
            (let [binding (get (get node :attributes) :binding-id) name (get (get context :locals) binding)]
              (if (if (= name nil) false (= type (get (get context :parameter-types) binding)))
                (assoc (p15-s23-compiler-result {:op :local :name name}) :work-count 1)
                (p15-s23-typed-namespace-reference context node type budget)))
            (if (contains? #{:throw :if :do} form)
              (if (if (= form :throw) (if (= 1 (count children)) (= type :gravity.type/never) false)
                    (if (= form :if) (= 3 (count children)) true))
                (let [compiled (p15-s23-typed-compile-children-mode context children (- budget 1) []
                                 (if (= form :if) :branches (if (= form :do) :last :none)) 0) values (get compiled :value)]
                  (if (p15-s23-compiler-complete? compiled)
                    (assoc (p15-s23-compiler-result
                      (if (= form :throw) {:op :throw :value (first values)}
                        (if (= form :if) {:op :if :test (first values) :then (get values 1) :else (get values 2)}
                          {:op :do :body values}))) :work-count (+ 1 (get compiled :work-count))) compiled))
                (p15-s23-typed-node-error :typed-control-shape-mismatch node))
              (p15-s23-typed-node-error :unsupported-typed-lowering-operation node))))))))))))))
        (p15-s23-typed-node-error :missing-typed-core-node node)))))

(defn p15-s23-typed-provenance [context]
  (let [observation (get context :observation) source (get observation :source)]
    {:boundary :current-gravity-typed-lowering :authority :non-authoritative
     :emission-scope (if (map? (get context :module-initialization))
                       :current-c6-typed-function-and-literal-definition-subset :current-c6-typed-function-subset)
     :compiler-sources (get observation :compiler-sources)
     :source {:path (get source :path) :sha256 (get source :sha256)}
     :typed-core-input (get (get context :core) :artifact-id)
     :type-verifier :current-gravity-c7 :effect-legality :pending-c8-and-profile-authority}))

(defn p15-s23-typed-lower-function [module definition context]
  (let [joined (p15-s23-typed-definition context (get definition :name)) value (get joined :value)]
    (if (p15-s23-compiler-complete? joined)
      (if (= definition (get value :definition))
        (let [node (get (get context :nodes) (get (get value :record) :function-core-node-id))
              targeted? (contains? (get node :attributes) :recur-target-id)
              target (get (get context :targets) (get (get node :attributes) :recur-target-id))
              active (assoc context :locals (get value :locals) :parameter-types (get value :parameter-types)
                       :current-function (get value :record) :tail? true :nearest-target target)
              compiled (if (if targeted? (p15-s23-typed-function-target? active target) true)
                         (p15-s23-typed-compile-node active (get (get value :record) :body-core-node-id) (get context :budget))
                         (p15-s23-typed-node-error :typed-function-target-mismatch node))
              function (get value :function)]
          (if (p15-s23-compiler-complete? compiled)
            (p15-s23-compiler-result (assoc (if targeted? (assoc definition :recur-target (get target :target-id)) definition)
              :instructions [(get compiled :value)]
              :binding {:name (get definition :name) :kind :function :namespace (get module :module)
                :profile (get module :profile) :target (get module :target)
                :visibility (if (> (count (get module :exports)) 0)
                              (if (contains? (set (get module :exports)) (get definition :name)) :public :private) :stage2-local)
                :effects (get module :effects) :capabilities (get module :capabilities)}
              :type-input (let [base {:function-id (get function :function-id) :function-core-node-id (get function :function-core-node-id)
                           :body-core-node-id (get function :body-core-node-id)
                           :definition-binding-id (get (get value :record) :definition-binding-id)
                           :parameters (get function :parameters)
                           :return (get function :return) :thrown-error-effects (get function :thrown-error-effects)}
                    premise (get (get context :core) :sh08-private-self-parameter-premise)
                    range (get premise :source-induction)]
                (if (if (= :gravity/sh08-indexed-private-self-entry-premise-v1 (get premise :domain))
                      (= (get function :function-id) (get (get range :function-record) :function-syntax-id)) false)
                  (let [step-id (get (get range :step-header) :call-core-node-id)
                        access-id (get (get range :access-header) :call-core-node-id)
                        step (get (get context :types) (get (get (get context :calls) step-id) :operator-node-id))
                        access (get (get context :types) (get (get (get context :calls) access-id) :operator-node-id))]
                    (assoc base :indexed-private-self
                      {:version :sh08-indexed-private-self-activation-v1 :source-induction range
                       :operations {step-id (p15-s23-ix-ir-proof step active) access-id (p15-s23-ix-ir-proof access active)}})) base))
              :typed-lowering-provenance (p15-s23-typed-provenance context))) compiled))
        (p15-s23-typed-node-error :supplied-definition-does-not-match-typed-source
          (get (get context :nodes) (get (get value :record) :function-core-node-id)))) joined)))

(defn p15-s23-typed-compile-function [emitter module definition input observation]
  (let [initial (p15-s23-typed-context module input observation)
        checked (if (p15-s23-compiler-complete? initial)
                  (p15-s23-typed-module-initialization-context (get initial :value)) initial)]
    (if (p15-s23-compiler-complete? checked)
      (if (p15-s23-typed-module-table? module (get checked :value))
        (p15-s23-typed-lower-function module definition (get checked :value))
        (p15-s23-typed-error :typed-module-function-table-mismatch)) checked)))

(defn p15-s23-typed-module-table? [module context]
  (if (contains? module :function-table)
    (let [table (get module :function-table)]
      (if (if (map? table) (if (= (count table) (count (get context :records)))
                            (= (set (keys table)) (set (keys (get context :records)))) false) false)
        (loop [remaining (keys table)]
          (if (= 0 (count remaining)) true
            (let [expected (p15-s23-typed-definition context (first remaining))]
              (if (if (p15-s23-compiler-complete? expected) (= (get table (first remaining)) (get (get expected :value) :definition)) false)
                (recur (rest remaining)) false)))) false)) true))

(defn p15-s23-typed-assemble-plan-products [emitter module definitions input observation]
  (let [initial (p15-s23-typed-context module input observation)
        checked (if (p15-s23-compiler-complete? initial)
                  (p15-s23-typed-module-initialization-context (get initial :value)) initial)
        context (get checked :value)]
    (if (p15-s23-compiler-complete? checked)
      (if (if (vector? definitions) (= (count definitions) (count (get context :records))) false)
        (let [indexed (p15-s23-typed-index
                  (loop [remaining definitions out []]
                    (if (= 0 (count remaining)) out
                      (let [entry (first remaining)]
                        (if (if (vector? entry) (if (= 2 (count entry))
                              (if (symbol? (first entry)) (map? (second entry)) false) false) false)
                          (recur (rest remaining) (conj out {:name (first entry) :definition (second entry)}))
                          (conj out {}))))) :name)]
      (if (if (map? indexed) (if (p15-s23-typed-module-table? module context)
                              (= (set (keys indexed)) (set (keys (get context :records)))) false) false)
        (loop [remaining definitions functions {} bindings [] summary (get context :initializer-summary {})]
          (if (= 0 (count remaining))
            (let [entrypoint (get (get emitter :plan-shape) :entrypoint 'main)
                  main-function (get functions entrypoint)
                  products (p15-s23-complete-plan-products module
                             {:functions functions :binding-table bindings :instruction-summary summary}
                             (if (= main-function nil) nil entrypoint))
                  products (if (= nil (get context :module-initialization)) products
                               (assoc products :value (assoc (get products :value) :module-initialization (get context :module-initialization))))]
              (if (if (= main-function nil) false (> (count (get main-function :params)) 0))
                (p15-s23-compiler-error "L2-MAIN-ARITY" {:params (get main-function :params)})
                (assoc products :value (assoc (get products :value) :typed-lowering-provenance (p15-s23-typed-provenance context)
                  :effect-summary (assoc (get (get products :value) :effect-summary)
                    :legality :pending-c8-and-profile-authority :authority :non-authoritative)))))
            (let [entry (first remaining) compiled (p15-s23-typed-lower-function module (second entry) context)
                  function (if (= nil (get context :module-initialization)) (get compiled :value)
                               (assoc (get compiled :value) :module-root (get (get context :module-roots) (first entry))))]
              (if (if (= (first entry) (get (second entry) :name)) (p15-s23-compiler-complete? compiled) false)
                (let [counted (p15-s23-summary-instructions (get function :instructions) summary)]
                  (if (p15-s23-compiler-complete? counted)
                    (recur (rest remaining) (assoc functions (first entry) function)
                      (conj bindings (assoc (get function :binding) :arity (get function :arity))) (get counted :value)) counted))
                (if (p15-s23-compiler-complete? compiled) (p15-s23-typed-error :typed-definition-name-mismatch) compiled)))))
        (p15-s23-typed-error :typed-module-definition-census)))
        (p15-s23-typed-error :typed-module-definition-census)) checked)))

(defn main
  []
  (hash-map :artifact :gravity/stage2-expression-lowering
            :status :ready))

     (contains? (set (get binding :target-set)) :all)]) false))

(defn p15-s23-ksm-domain [arguments budget]
  (let [limit (if (< budget 65536) budget 65536)]
    (if (if (vector? arguments) (= 2 (count arguments)) false)
      (if (< limit 2) {:status :rejected :reason :keyword-set-contains-work-limit :work-count 2}
        (let [items (get arguments 0) needle (get arguments 1)
              character? (= :gravity.type/character needle)
              width-reason (if character? :character-set-contains-type-width :keyword-set-contains-type-width)
              work-reason (if character? :character-set-contains-work-limit :keyword-set-contains-work-limit)
              type-reason (if character? :character-set-contains-operand-type-required :keyword-set-contains-operand-type-required)]
          (if (if character? true (if (= :gravity.type/keyword needle) true (= :gravity.type/never needle)))
            (if (= :gravity.type/never items)
              (if character?
                {:status :accepted :work-count 2 :argument-types arguments :set-member-count nil :membership-family :character}
                {:status :accepted :work-count 2 :argument-types arguments :set-member-count nil})
              (if (if (map? items) (if (= 3 (count items))
                    (if (= :gravity.type/set (get items :kind))
                      (if (= :literal (get items :shape)) (vector? (get items :element-types)) false) false) false) false)
                (let [members (get items :element-types) n (count members)]
                  (if (> n 1024) {:status :rejected :reason width-reason :work-count 2}
                    (if (> n (- limit 2))
                      {:status :rejected :reason work-reason :work-count (+ 2 n)}
                      (loop [i 0 family (if character? :character :keyword)]
                        (if (= i n)
                          (if (= :character family)
                            {:status :accepted :work-count (+ 2 n) :argument-types arguments :set-member-count n :membership-family :character}
                            {:status :accepted :work-count (+ 2 n) :argument-types arguments :set-member-count n})
                          (let [member (get members i)]
                            (if (= (if (= :character family) :gravity.type/character :gravity.type/keyword) member)
                              (recur (+ i 1) family)
                              (if (if (= i 0) (if (= :gravity.type/never needle) (= :gravity.type/character member) false) false)
                                (recur 1 :character)
                                {:status :rejected :reason (if (= :character family) :character-set-contains-operand-type-required type-reason)
                                 :work-count (+ 2 n)}))))))))
                {:status :rejected :reason type-reason :work-count 2}))
            {:status :rejected :reason :keyword-set-contains-operand-type-required :work-count 2})))
      {:status :rejected :reason :keyword-set-contains-arity-mismatch :work-count 0})))

(defn p15-s23-ksm-source [core node call edge nodes bindings types module validation]
  (if (if (vector? (get call :argument-node-ids))
        (if (= 2 (count (get call :argument-node-ids)))

; Gravity-authored stage2 expression lowering for the current closed compiler
; subset.  The Clojure seed still parses and compiles this module and provides
; a generic function-plan runner plus explicitly enumerated pure collection
; predicates.  Lowering decisions and diagnostic selection live here.
(ns gravity.bootstrap.p15-s23.emitter
  (:profile :meta)
  (:target :jvm)
  (:effects #{})
  (:capabilities #{})
  (:safety :safe))

(defn p15-s23-compiler-result
  [value]
  (hash-map :status :complete :value value))

(defn p15-s23-compiler-error
  [diagnostic facts]
  (hash-map :status :rejected :diagnostic diagnostic :facts facts))

(defn p15-s23-compiler-complete?
  [result]
  (= :complete (get result :status)))

(defn p15-s23-path-append
  [path suffix]
  (loop [result (vec path) remaining suffix]
    (if (= 0 (count remaining))
      result
      (recur (conj result (first remaining)) (rest remaining)))))

(defn p15-s23-child-module
  [module suffix]
  (assoc
   (assoc module :p15-s23-sh07-callsite-path
          (p15-s23-path-append
           (get module :p15-s23-sh07-callsite-path []) suffix))
   :p15-s23-sh07-child-index-base 0))

; This is independently authored in Gravity, but intentionally has the same
; closed value algebra as the reader identity carrier.  The decorated vectors
; make host map/set iteration irrelevant before sort-by-pr-str is applied.
(defn p15-s23-reader-canonical-value
  [value]
  (if (map? value)
    (loop [remaining (vec (keys value)) decorated []]
      (if (= 0 (count remaining))
        (vector :map (vec (sort-by-pr-str decorated)))
        (let [key (first remaining)]
          (recur
           (rest remaining)
           (conj decorated
                 (vector (p15-s23-reader-canonical-value key)
                         (p15-s23-reader-canonical-value (get value key))))))))
    (if (set? value)
      (loop [remaining (vec value) decorated []]
        (if (= 0 (count remaining))
          (vector :set (vec (sort-by-pr-str decorated)))
          (recur
           (rest remaining)
           (conj decorated
                 (p15-s23-reader-canonical-value (first remaining))))))
      (if (vector? value)
        (loop [remaining value result []]
          (if (= 0 (count remaining))
            (vector :vector result)
            (recur
             (rest remaining)
             (conj result
                   (p15-s23-reader-canonical-value (first remaining))))))
        (if (seq? value)
          (loop [remaining value result []]
            (if (= 0 (count remaining))
              (vector :list result)
              (recur
               (rest remaining)
               (conj result
                     (p15-s23-reader-canonical-value (first remaining))))))
          value)))))

(defn p15-s23-canonical-map-entries
  [value]
  (let [decorated
        (loop [remaining (vec (keys value)) result []]
          (if (= 0 (count remaining))
            result
            (let [key (first remaining)
                  item (get value key)]
              (recur
               (rest remaining)
               (conj result
                     (vector
                      (p15-s23-reader-canonical-value (vector key item))
                      (vector key item)))))))]
    (loop [remaining (sort-by-pr-str decorated) result []]
      (if (= 0 (count remaining))
        result
        (recur (rest remaining)
               (conj result (second (first remaining))))))))

(defn p15-s23-canonical-set-items
  [value]
  (let [decorated
        (loop [remaining (vec value) result []]
          (if (= 0 (count remaining))
            result
            (let [item (first remaining)]
              (recur
               (rest remaining)
               (conj result
                     (vector (p15-s23-reader-canonical-value item) item))))))]
    (loop [remaining (sort-by-pr-str decorated) result []]
      (if (= 0 (count remaining))
        result
        (recur (rest remaining)
               (conj result (second (first remaining))))))))

(defn p15-s23-compile-forms
  [emitter module locals forms compiled]
  (if (= 0 (count forms))
    (p15-s23-compiler-result compiled)
    (if (> (count forms) 64)
      (let [items (vec forms)
            midpoint (quot (count items) 2)
            left
            (p15-s23-compile-forms
             emitter module locals (subvec items 0 midpoint) compiled)]
        (if (p15-s23-compiler-complete? left)
          (p15-s23-compile-forms
           emitter module locals (subvec items midpoint (count items))
           (get left :value))
          left))
      (let [compiled-form
            (p15-s23-compile-expr
             emitter
             (p15-s23-child-module
              module
              (vector (+ (get module :p15-s23-sh07-child-index-base 0)
                         (count compiled))))
             locals (first forms))]
        (if (p15-s23-compiler-complete? compiled-form)
          (p15-s23-compile-forms
           emitter module locals (rest forms)
           (conj compiled (get compiled-form :value)))
          compiled-form)))))

(defn p15-s23-compile-map-entries
  [emitter module locals entries compiled]
  (if (= 0 (count entries))
    (p15-s23-compiler-result compiled)
    (if (> (count entries) 64)
      (let [items (vec entries)
            midpoint (quot (count items) 2)
            left
            (p15-s23-compile-map-entries
             emitter module locals (subvec items 0 midpoint) compiled)]
        (if (p15-s23-compiler-complete? left)
          (p15-s23-compile-map-entries
           emitter module locals (subvec items midpoint (count items))
           (get left :value))
          left))
      (let [entry (first entries)
            entry-index (count compiled)
            compiled-key
            (p15-s23-compile-expr
             emitter (p15-s23-child-module module (vector entry-index 0))
             locals (first entry))]
        (if (p15-s23-compiler-complete? compiled-key)
          (let [compiled-value
                (p15-s23-compile-expr
                 emitter (p15-s23-child-module module (vector entry-index 1))
                 locals (second entry))]
            (if (p15-s23-compiler-complete? compiled-value)
              (p15-s23-compile-map-entries
               emitter module locals (rest entries)
               (conj compiled
                     (hash-map :key (get compiled-key :value)
                               :value (get compiled-value :value))))
              compiled-value))
          compiled-key)))))

(defn p15-s23-compile-collection
  [emitter module locals form]
  (let [collection-rules (get emitter :collection-rules)]
    (if (vector? form)
      (let [items
            (p15-s23-compile-forms emitter module locals form [])]
        (if (p15-s23-compiler-complete? items)
          (p15-s23-compiler-result
           (hash-map :op (get (get collection-rules :vector) :op)
                     :items (get items :value)))
          items))
      (if (map? form)
        (let [entries
              (p15-s23-compile-map-entries
               emitter module locals (p15-s23-canonical-map-entries form) [])]
          (if (p15-s23-compiler-complete? entries)
            (p15-s23-compiler-result
             (hash-map :op (get (get collection-rules :map) :op)
                       :entries (get entries :value)))
            entries))
        (if (set? form)
          (let [items
                (p15-s23-compile-forms
                 emitter module locals (p15-s23-canonical-set-items form) [])]
            (if (p15-s23-compiler-complete? items)
              (p15-s23-compiler-result
               (hash-map :op (get (get collection-rules :set) :op)
                         :items (get items :value)))
              items))
          (p15-s23-compiler-result
           (hash-map :op (get (get collection-rules :literal) :op)
                     :value form)))))))

(defn p15-s23-compile-let-bindings
  [emitter module scope bindings compiled]
  (if (= 0 (count bindings))
    (p15-s23-compiler-result
     (hash-map :scope scope :bindings compiled))
    (if (> (count bindings) 128)
      (let [midpoint (* 2 (quot (count bindings) 4))
            left
            (p15-s23-compile-let-bindings
             emitter module scope (subvec bindings 0 midpoint) compiled)]
        (if (p15-s23-compiler-complete? left)
          (let [products (get left :value)]
            (p15-s23-compile-let-bindings
             emitter module (get products :scope)
             (subvec bindings midpoint (count bindings))
             (get products :bindings)))
          left))
      (let [name (first bindings)
            expression (second bindings)
            pair-index (count compiled)]
        (if (symbol? name)
          (let [compiled-expression
                (p15-s23-compile-expr
                 emitter
                 (p15-s23-child-module
                  module (vector 1 (+ 1 (* 2 pair-index))))
                 scope expression)]
            (if (p15-s23-compiler-complete? compiled-expression)
              (p15-s23-compile-let-bindings
               emitter module (conj scope name) (rest (rest bindings))
               (conj compiled
                     (hash-map :name name
                               :expr (get compiled-expression :value))))
              compiled-expression))
          (p15-s23-compiler-error
           "L2-LET-BINDING" (hash-map :binding name)))))))

(defn p15-s23-compile-let
  [emitter module locals bindings body]
  (if (if (vector? bindings) (even? (count bindings)) false)
    (let [compiled-bindings
          (p15-s23-compile-let-bindings emitter module locals bindings [])]
      (if (p15-s23-compiler-complete? compiled-bindings)
        (let [binding-value (get compiled-bindings :value)
              compiled-body
              (p15-s23-compile-forms
               emitter
               (assoc module :p15-s23-sh07-child-index-base 2)
               (get binding-value :scope) body [])]
          (if (p15-s23-compiler-complete? compiled-body)
            (p15-s23-compiler-result
             (hash-map
              :op (get (get (get emitter :special-form-rules) (quote let)) :op)
              :bindings (get binding-value :bindings)
              :body (get compiled-body :value)))
            compiled-body))
        compiled-bindings))
    (p15-s23-compiler-error
     "L2-LET-BINDING" (hash-map :bindings bindings))))

(defn p15-s23-compile-loop
  [emitter module locals bindings body]
  (if (if (vector? bindings) (even? (count bindings)) false)
    (let [compiled-bindings
          (p15-s23-compile-let-bindings emitter module locals bindings [])]
      (if (p15-s23-compiler-complete? compiled-bindings)
        (let [binding-value (get compiled-bindings :value)
              compiled-body
              (p15-s23-compile-forms
               emitter
               (assoc module :p15-s23-sh07-child-index-base 2)
               (get binding-value :scope) body [])]
          (if (p15-s23-compiler-complete? compiled-body)
            (p15-s23-compiler-result
             (hash-map
              :op :loop
              :bindings (get binding-value :bindings)
              :binding-count (count (get binding-value :bindings))
              :body (get compiled-body :value)))
            compiled-body))
        compiled-bindings))
    (p15-s23-compiler-error
     "L2-UNKNOWN-CORE-FORM" (hash-map :operator (quote loop)))))

(defn p15-s23-nonnegative-path?
  [path]
  (if (vector? path)
    (loop [remaining path]
      (if (= 0 (count remaining))
        true
        (let [ordinal (first remaining)]
          (if (integer? ordinal)
            (if (<= 0 ordinal)
              (recur (rest remaining))
              false)
            false))))
    false))

(defn p15-s23-external-edge-shape?
  [edge ordinal]
  (if (map? edge)
    (if (= #{:ordinal :caller-module-source-id :caller-function
             :caller-function-source-hash :callsite-path
             :callee-module-source-id :callee-function
             :callee-function-source-hash :arity :owner-edge :authorization}
           (set (keys edge)))
      (if (= ordinal (get edge :ordinal))
        (if (p15-s23-nonnegative-path? (get edge :callsite-path))
          (if (integer? (get edge :arity))
            (if (<= 0 (get edge :arity))
              (if (= :authenticated-b51-namespace-external
                     (get edge :authorization))
                (if (contains? #{:producer-internal :root6-internal
                                 :root8-to-producer-interface}
                               (get edge :owner-edge))
                  true
                  false)
                false)
              false)
            false)
          false)
        false)
      false)
    false))

(defn p15-s23-external-binding-shape?
  [binding]
  (if (map? binding)
    (= #{:symbol :callee-module-ordinal :callee-module
         :callee-source-sha256 :callee-definition-source-hash
         :arity :owner-edge}
       (set (keys binding)))
    false))

(defn p15-s23-definition-row-shape?
  [definition]
  (if (map? definition)
    (= #{:name :arity :visibility :source-hash}
       (set (keys definition)))
    false))

(defn p15-s23-link-manifest-census-shape?
  [manifest]
  (if (map? manifest)
    (let [module-source-ids (get manifest :module-source-ids)
          edges (get manifest :edges)]
      (if (vector? module-source-ids)
        (if (= 7 (count module-source-ids))
          (if (= 7 (count (set module-source-ids)))
            (if (vector? edges)
              ;; Attempt30's governed source walk derives 1,480 authenticated
              ;; edges after its compact Root-1 cross-fragment boundaries. Edge
              ;; identity, owner, binding, caller, path, and ordinal checks
              ;; below remain the authority; this is their closed census.
              (= 1480 (count edges))
              false)
            false)
          false)
        false))
    false))

(defn p15-s23-module-descriptor-shape?
  [descriptor manifest]
  (if (map? descriptor)
    (if (= #{:artifact :schema-version :module-source-id :module-ordinal
             :module :logical-source-path :owner :source-byte-count
             :source-sha256 :profile :target :effects :capabilities :safety
             :definitions :exports :core-binding-count
             :lexical-binding-count :external-bindings
             :aggregate-binding-count :builtin-calls}
           (set (keys descriptor)))
      (if (= :gravity/sh07-b51-module-source-v1 (get descriptor :artifact))
        (if (= 1 (get descriptor :schema-version))
          (= (get descriptor :module-source-id)
             (get (get manifest :module-source-ids)
                  (get descriptor :module-ordinal)))
          false)
        false)
      false)
    false))

(defn p15-s23-descriptor-binding-census
  [bindings]
  (loop [remaining bindings symbols #{} valid true]
    (if (= 0 (count remaining))
      (hash-map :valid valid :symbols symbols)
      (let [binding (first remaining)
            symbol (get binding :symbol)
            unique (if (contains? symbols symbol) false true)]
        (recur
         (rest remaining) (conj symbols symbol)
         (if valid
           (if (p15-s23-external-binding-shape? binding) unique false)
           false))))))

(defn p15-s23-descriptor-definition-census
  [definitions]
  (loop [remaining definitions names #{} valid true]
    (if (= 0 (count remaining))
      (hash-map :valid valid :names names)
      (let [definition (first remaining)
            name (get definition :name)
            unique (if (contains? names name) false true)]
        (recur
         (rest remaining) (conj names name)
         (if valid
           (if (p15-s23-definition-row-shape? definition) unique false)
           false))))))

(defn p15-s23-edge-index-callee-census
  [index]
  (loop [remaining (vec (keys index)) callees #{}]
    (if (= 0 (count remaining))
      callees
      (let [edge (get index (first remaining))]
        (recur (rest remaining)
               (conj callees (get edge :callee-function)))))))

(defn p15-s23-edge-index-callers-defined?
  [index definition-names]
  (loop [remaining (vec (keys index))]
    (if (= 0 (count remaining))
      true
      (let [edge (get index (first remaining))]
        (if (contains? definition-names (get edge :caller-function))
          (recur (rest remaining))
          false)))))

(defn p15-s23-descriptor-tables-authentic?
  [descriptor index]
  (let [bindings
        (p15-s23-descriptor-binding-census
         (get descriptor :external-bindings))
        definitions
        (p15-s23-descriptor-definition-census
         (get descriptor :definitions))]
    (if (get bindings :valid)
      (if (get definitions :valid)
        (if (= (get bindings :symbols)
               (p15-s23-edge-index-callee-census index))
          (p15-s23-edge-index-callers-defined?
           index (get definitions :names))
          false)
        false)
      false)))

(defn p15-s23-build-external-edge-index
  [descriptor manifest]
  (if (p15-s23-link-manifest-census-shape? manifest)
    (if (p15-s23-module-descriptor-shape? descriptor manifest)
      (loop [remaining (get manifest :edges)
             ordinal 0 index (hash-map) seen #{}]
        (if (= 0 (count remaining))
          (if (p15-s23-descriptor-tables-authentic? descriptor index)
            (p15-s23-compiler-result index)
            (p15-s23-compiler-error
             "L2-UNKNOWN-CORE-FORM"
             (hash-map :reason :unauthenticated-b51-external-link)))
          (let [edge (first remaining)
                identity
                (vector (get edge :caller-module-source-id)
                        (get edge :caller-function)
                        (get edge :callsite-path))]
            (if (p15-s23-external-edge-shape? edge ordinal)
              (if (contains? seen identity)
                (p15-s23-compiler-error
                 "L2-UNKNOWN-CORE-FORM"
                 (hash-map :reason :unauthenticated-b51-external-link))
                (recur
                 (rest remaining) (+ ordinal 1)
                 (if (= (get descriptor :module-source-id)
                        (get edge :caller-module-source-id))
                   (assoc index
                          (vector (get edge :caller-function)
                                  (get edge :callsite-path))
                          edge)
                   index)
                 (conj seen identity)))
              (p15-s23-compiler-error
               "L2-UNKNOWN-CORE-FORM"
               (hash-map :reason :unauthenticated-b51-external-link))))))
      (p15-s23-compiler-error
       "L2-UNKNOWN-CORE-FORM"
       (hash-map :reason :unauthenticated-b51-external-link)))
    (p15-s23-compiler-error
     "L2-UNKNOWN-CORE-FORM"
     (hash-map :reason :unauthenticated-b51-external-link))))

(defn p15-s23-scan-external-edges
  [edges descriptor caller callee arity path]
  (loop [remaining edges ordinal 0 selected nil matches 0 valid true seen #{}]
    (if (= 0 (count remaining))
      (hash-map :valid valid :selected selected :matches matches)
      (let [edge (first remaining)
            row-valid (p15-s23-external-edge-shape? edge ordinal)
            identity
            (vector (get edge :caller-module-source-id)
                    (get edge :caller-function)
                    (get edge :callsite-path))
            unique (if (contains? seen identity) false true)
            match
            (if row-valid
              (if (= (get descriptor :module-source-id)
                     (get edge :caller-module-source-id))
                (if (= caller (get edge :caller-function))
                  (if (= callee (get edge :callee-function))
                    (if (= arity (get edge :arity))
                      (= path (get edge :callsite-path))
                      false)
                    false)
                  false)
                false)
              false)]
        (recur (rest remaining) (+ ordinal 1)
               (if match edge selected)
               (if match (+ matches 1) matches)
               (if valid (if row-valid unique false) false)
               (conj seen identity))))))

(defn p15-s23-scan-external-bindings
  [bindings edge callee]
  (loop [remaining bindings selected nil matches 0 valid true seen #{}]
    (if (= 0 (count remaining))
      (hash-map :valid valid :selected selected :matches matches)
      (let [binding (first remaining)
            row-valid (p15-s23-external-binding-shape? binding)
            unique (if (contains? seen (get binding :symbol)) false true)
            match
            (if row-valid
              (if (= callee (get binding :symbol))
                (if (= (get edge :callee-function-source-hash)
                       (get binding :callee-definition-source-hash))
                  (if (= (get edge :arity) (get binding :arity))
                    (= (get edge :owner-edge) (get binding :owner-edge))
                    false)
                  false)
                false)
              false)]
        (recur (rest remaining)
               (if match binding selected)
               (if match (+ matches 1) matches)
               (if valid (if row-valid unique false) false)
               (conj seen (get binding :symbol)))))))

(defn p15-s23-scan-definition-rows
  [definitions caller source-hash]
  (loop [remaining definitions selected nil matches 0 valid true seen #{}]
    (if (= 0 (count remaining))
      (hash-map :valid valid :selected selected :matches matches)
      (let [definition (first remaining)
            row-valid (p15-s23-definition-row-shape? definition)
            unique (if (contains? seen (get definition :name)) false true)
            match
            (if row-valid
              (if (= caller (get definition :name))
                (= source-hash (get definition :source-hash))
                false)
              false)]
        (recur (rest remaining)
               (if match definition selected)
               (if match (+ matches 1) matches)
               (if valid (if row-valid unique false) false)
               (conj seen (get definition :name)))))))

(defn p15-s23-selected-edge-authentic?
  [edge descriptor caller callee arity path]
  (if (map? edge)
    (if (= (get descriptor :module-source-id)
           (get edge :caller-module-source-id))
      (if (= caller (get edge :caller-function))
        (if (= callee (get edge :callee-function))
          (if (= arity (get edge :arity))
            (if (= path (get edge :callsite-path))
              (if (= :r1-producer (get descriptor :owner))
                (= :producer-internal (get edge :owner-edge))
                (if (= :r6-independent-verifier (get descriptor :owner))
                  (= :root6-internal (get edge :owner-edge))
                  (if (= :r8-finalizer (get descriptor :owner))
                    (= :root8-to-producer-interface (get edge :owner-edge))
                    false)))
              false)
            false)
          false)
        false)
      false)
    false))

(defn p15-s23-external-call-descriptor
  [module caller callee arity path]
  (let [descriptor (get module :p15-s23-sh07-module-source-descriptor)
        manifest (get module :p15-s23-sh07-link-manifest)
        edge-index (get module :p15-s23-sh07-external-edge-index)
        indexed-edge (if (map? edge-index)
                       (get edge-index (vector caller path)) nil)
        edge-scan
        (if (map? edge-index)
          (hash-map :valid true :selected indexed-edge
                    :matches (if (= nil indexed-edge) 0 1))
          (p15-s23-scan-external-edges
           (get manifest :edges) descriptor caller callee arity path))
        edge (get edge-scan :selected)]
    (if (p15-s23-module-descriptor-shape? descriptor manifest)
      (if (= #{:artifact :schema-version :manifest-id
               :module-source-ids :edges}
             (set (keys manifest)))
        (if (= :gravity/sh07-b51-link-manifest-v1 (get manifest :artifact))
          (if (= 1 (get manifest :schema-version))
            (if (p15-s23-link-manifest-census-shape? manifest)
              (if (get edge-scan :valid)
                (if (= 1 (get edge-scan :matches))
                  (if (p15-s23-selected-edge-authentic?
                       edge descriptor caller callee arity path)
                    (let [binding-scan
                          (p15-s23-scan-external-bindings
                           (get descriptor :external-bindings) edge callee)
                          definition-scan
                          (p15-s23-scan-definition-rows
                           (get descriptor :definitions) caller
                           (get edge :caller-function-source-hash))]
                      (if (get binding-scan :valid)
                        (if (= 1 (get binding-scan :matches))
                          (if (get definition-scan :valid)
                            (if (= 1 (get definition-scan :matches))
                              (hash-map
                               :artifact :gravity/sh07-b51-external-call-v1
                               :manifest-id (get manifest :manifest-id)
                               :edge-ordinal (get edge :ordinal))
                              nil)
                            nil)
                          nil)
                        nil))
                    nil)
                  nil)
                nil)
              nil)
            nil)
          nil)
        nil)
      nil)))

(defn p15-s23-internal-builtin-arity
  [callee]
  (if (= callee (quote sh07-canonical-text-compare))
    2
    (if (= callee (quote sh07-declared-digest-hash))
      1
      (if (= callee (quote sh07-observe-utf8-byte-count))
        3
        (if (= callee
               (quote sh07-b51-admitted-executable-carrier-validation?))
          1
          nil)))))

(defn p15-s23-internal-builtin-caller-governed?
  [callee caller]
  (if (= callee (quote sh07-canonical-text-compare))
    (contains? (quote #{sh07-b51-producer-insert-decoration
                        sh07-b51-r6-decoration-insert})
               caller)
    (if (= callee (quote sh07-observe-utf8-byte-count))
      (contains? (quote #{sh07-b51-producer-observe-decoration-bytes
                          sh07-b51-r6-observe-scalar-bytes})
                 caller)
      (if (= callee (quote sh07-declared-digest-hash))
        (contains?
         (quote #{sh07-b51-success-digest-replay-exact?
           sh07-b51-finalize-rejection
           sh07-b51-producer-decimal-admission
           sh07-b51-producer-decimal-projection-authentic?
           sh07-b51-r6-replay-digests
           sh07-b51-r6-decimal-projection-authentic?
           sh07-b51-r6-predecessor-closure-authentic?
           sh07-b51-r6-projection-binding
           sh07-b51-r6-projected-form-id
           sh07-b51-r6-projected-syntax-id
           sh07-b51-r6-project-decimal
           sh07-b51-r6-projected-macro-traces
           sh07-b51-r6-project-lineage
           sh07-b51-r6-replay-consume-scope
           sh07-b51-r6-replay-reference
           sh07-b51-r6-project-forms
           sh07-b51-r6-project-definition-syntax-id
           sh07-b51-r6-project-scope-catalog
           sh07-b51-r6-project-bindings
           sh07-b51-r6-v18-executable-authentic?})
        caller)
        (if (= callee
               (quote sh07-b51-admitted-executable-carrier-validation?))
          (contains?
           (quote #{sh07-b51-root1-admitted-raw-carrier-shape?
                    sh07-b51-r6-c30-request-proof?})
           caller)
          false)))))

(defn p15-s23-builtin-call-row-shape?
  [row]
  (if (map? row)
    (= #{:caller :caller-function-source-hash :builtin :arity
         :compiler-internal?}
       (set (keys row)))
    false))

(defn p15-s23-scan-internal-builtin-rows
  [rows caller callee arity function-source-hash]
  (if (vector? rows)
    (loop [remaining rows matches 0 valid true]
      (if (= 0 (count remaining))
        (hash-map :valid valid :matches matches)
        (let [row (first remaining)
              shape (p15-s23-builtin-call-row-shape? row)
              same-call
              (if shape
                (if (= caller (get row :caller))
                  (= callee (get row :builtin))
                  false)
                false)
              authentic
              (if same-call
                (if (= arity (get row :arity))
                  (if (= function-source-hash
                         (get row :caller-function-source-hash))
                    (= true (get row :compiler-internal?))
                    false)
                  false)
                true)]
          (recur (rest remaining)
                 (if same-call (+ matches 1) matches)
                 (if valid (if shape authentic false) false)))))
    (hash-map :valid false :matches 0)))

(defn p15-s23-internal-call-occurrence-count
  [definition callee]
  (loop [pending (vector (get definition :body))
         observed 0
         matches 0]
    (if (> observed 8388608)
      -1
      (if (= 0 (count pending))
        matches
        (let [value (first pending)
              quoted
              (if (seq? value)
                (= (quote quote) (first value))
                false)
              children
              (if quoted
                []
                (if (map? value)
                  (loop [entries (p15-s23-canonical-map-entries value)
                         result []]
                    (if (= 0 (count entries))
                      result
                      (let [entry (first entries)]
                        (recur (rest entries)
                               (conj (conj result (first entry))
                                     (second entry))))))
                  (if (set? value)
                    (p15-s23-canonical-set-items value)
                    (if (if (vector? value) true (seq? value))
                      (vec value)
                      []))))
              matched
              (if (seq? value)
                (if (= callee (first value)) 1 0)
                0)]
          (recur (p15-s23-path-append (vec (rest pending)) children)
                 (+ observed 1)
                 (+ matches matched)))))))

(defn p15-s23-value-at-callsite-path
  [definition path]
  (loop [value (get definition :body) remaining path]
    (if (= 0 (count remaining))
      value
      (let [ordinal (first remaining)
            children
            (if (map? value)
              (p15-s23-canonical-map-entries value)
              (if (set? value)
                (p15-s23-canonical-set-items value)
                (if (if (vector? value) true (seq? value))
                  (vec value)
                  [])))]
        (if (integer? ordinal)
          (if (<= 0 ordinal)
            (if (< ordinal (count children))
              (recur (get children ordinal) (rest remaining))
              nil)
            nil)
          nil)))))

(defn p15-s23-internal-callsite-authentic?
  [definition path callee arity]
  (let [value (p15-s23-value-at-callsite-path definition path)]
    (if (seq? value)
      (if (= callee (first value))
        (= arity (- (count value) 1))
        false)
      false)))

(defn p15-s23-internal-call-provenance
  [module caller callee arity path]
  (let [descriptor (get module :p15-s23-sh07-module-source-descriptor)
        manifest (get module :p15-s23-sh07-link-manifest)
        authority (get module :p15-s23-sh07-source-authority)
        definition (get module :p15-s23-sh07-enclosing-definition)
        function-source-hash
        (get (get authority :function-source-hashes) caller)
        definition-scan
        (p15-s23-scan-definition-rows
         (get descriptor :definitions) caller function-source-hash)
        builtin-scan
        (p15-s23-scan-internal-builtin-rows
         (get descriptor :builtin-calls) caller callee arity
         function-source-hash)
        source-occurrences
        (p15-s23-internal-call-occurrence-count definition callee)]
    (if (= #{:artifact :manifest-id :module-source-id :source-sha256
             :function-source-hashes :module :logical-source-path}
           (set (keys authority)))
      (if (= :gravity/sh07-compiler-source-authority-v2
             (get authority :artifact))
        (if (p15-s23-module-descriptor-shape? descriptor manifest)
          (if (= (get manifest :manifest-id) (get authority :manifest-id))
            (if (= (get descriptor :module-source-id)
                   (get authority :module-source-id))
              (if (= (get descriptor :source-sha256)
                     (get authority :source-sha256))
                (if (= (get descriptor :module) (get authority :module))
                  (if (= (get descriptor :logical-source-path)
                         (get authority :logical-source-path))
                    (if (p15-s23-internal-builtin-caller-governed?
                         callee caller)
                      (if (p15-s23-internal-callsite-authentic?
                           definition path callee arity)
                        (if (get definition-scan :valid)
                          (if (= 1 (get definition-scan :matches))
                            (if (get builtin-scan :valid)
                              (if (= source-occurrences
                                     (get builtin-scan :matches))
                                (if (< 0 source-occurrences)
                                (hash-map
                                 :artifact
                                 :gravity/sh07-compiler-internal-call-provenance-v2
                                 :manifest-id (get manifest :manifest-id)
                                 :module-source-id
                                 (get descriptor :module-source-id)
                                 :source-sha256 (get descriptor :source-sha256)
                                 :function caller
                                 :function-source-hash function-source-hash
                                 :callee callee)
                                nil)
                                nil)
                              nil)
                            nil)
                          nil)
                        nil)
                      nil)
                    nil)
                  nil)
                nil)
              nil)
            nil)
          nil)
        nil)
      nil)))

(defn p15-s23-compile-internal-builtin-call
  [emitter module locals callee arguments expected-arity]
  (if (= expected-arity (count arguments))
    (let [caller (get module :p15-s23-sh07-enclosing-function)
          provenance
          (p15-s23-internal-call-provenance
           module caller callee expected-arity
           (get module :p15-s23-sh07-callsite-path []))]
      (if (= nil provenance)
        (p15-s23-compiler-error
         "L2-UNKNOWN-CORE-FORM"
         (hash-map :operator callee
                   :reason :unauthenticated-compiler-provenance))
        (let [args
              (p15-s23-compile-forms
               emitter (assoc module :p15-s23-sh07-child-index-base 1)
               locals arguments [])]
          (if (p15-s23-compiler-complete? args)
            (p15-s23-compiler-result
             (hash-map
              :op (get (get emitter :call-rules) :builtin-op)
              :function callee
              :compiler-internal-caller caller
              :compiler-internal-provenance provenance
              :args (get args :value)))
            args))))
    (p15-s23-compiler-error
     "L2-BUILTIN-ARITY"
     (hash-map :function callee
               :expected-arity expected-arity
               :actual-arity (count arguments)))))

(defn p15-s23-compile-call
  [emitter module locals form]
  (let [callee (first form)
        arguments (rest form)
        special-rules (get emitter :special-form-rules)
        special-rule (get special-rules callee)
        call-rules (get emitter :call-rules)
        builtin-functions (set (get call-rules :builtin-functions))
        internal-arity (p15-s23-internal-builtin-arity callee)]
    (if (= callee (quote throw))
      (if (= 1 (count arguments))
        (let [value (p15-s23-compile-expr
                     emitter (p15-s23-child-module module [1])
                     locals (first arguments))]
          (if (p15-s23-compiler-complete? value)
            (p15-s23-compiler-result
             (hash-map :op :throw :value (get value :value)))
            value))
        (p15-s23-compiler-error
         "L2-UNKNOWN-CORE-FORM"
         (hash-map :operator (quote throw) :reason :throw-arity
                   :expected-arity 1 :actual-arity (count arguments))))
    (if (= callee (quote println))
      (let [args
            (p15-s23-compile-forms
             emitter (assoc module :p15-s23-sh07-child-index-base 1)
             locals arguments [])]
        (if (p15-s23-compiler-complete? args)
          (p15-s23-compiler-result
           (hash-map :op (get special-rule :op)
                     :effect (get special-rule :effect)
                     :capability (get special-rule :capability)
                     :args (get args :value)))
          args))
      (if (= callee (quote do))
        (let [body
              (p15-s23-compile-forms
               emitter (assoc module :p15-s23-sh07-child-index-base 1)
               locals arguments [])]
          (if (p15-s23-compiler-complete? body)
            (p15-s23-compiler-result
             (hash-map :op (get special-rule :op)
                       :body (get body :value)))
            body))
        (if (= callee (quote if))
          (if (= 4 (count form))
            (let [test-result
                  (p15-s23-compile-expr
                   emitter (p15-s23-child-module module [1])
                   locals (second form))]
              (if (p15-s23-compiler-complete? test-result)
                (let [then-result
                      (p15-s23-compile-expr
                       emitter (p15-s23-child-module module [2])
                       locals (first (rest (rest form))))]
                  (if (p15-s23-compiler-complete? then-result)
                    (let [else-result
                          (p15-s23-compile-expr
                           emitter (p15-s23-child-module module [3])
                           locals (first (rest (rest (rest form)))))]
                      (if (p15-s23-compiler-complete? else-result)
                        (p15-s23-compiler-result
                         (hash-map :op (get special-rule :op)
                                   :test (get test-result :value)
                                   :then (get then-result :value)
                                   :else (get else-result :value)))
                        else-result))
                    then-result))
                test-result))
            (p15-s23-compiler-error
             "L2-UNKNOWN-CORE-FORM"
             (hash-map :operator (quote if)
                       :expected-arity 3
                       :actual-arity (- (count form) 1))))
          (if (= callee (quote let))
            (p15-s23-compile-let
             emitter module locals (second form) (rest (rest form)))
            (if (= callee (quote loop))
              (p15-s23-compile-loop
               emitter module locals (second form) (rest (rest form)))
              (if (= callee (quote recur))
                (let [args
                      (p15-s23-compile-forms
                       emitter
                       (assoc module :p15-s23-sh07-child-index-base 1)
                       locals arguments [])]
                  (if (p15-s23-compiler-complete? args)
                    (p15-s23-compiler-result
                     (hash-map :op :recur :args (get args :value)))
                    args))
                (if (= callee (quote quote))
                  (p15-s23-compiler-result
                   (hash-map :op (get special-rule :op) :value (second form)))
                  (if (= callee (quote host-reflect))
                (p15-s23-compiler-error
                 (get special-rule :diagnostic)
                 (hash-map :operator callee))
                (if (integer? internal-arity)
                  (p15-s23-compile-internal-builtin-call
                   emitter module locals callee arguments internal-arity)
                  (if (contains? builtin-functions callee)
                  (let [args
                        (p15-s23-compile-forms
                         emitter
                         (assoc module :p15-s23-sh07-child-index-base 1)
                         locals arguments [])]
                    (if (p15-s23-compiler-complete? args)
                      (p15-s23-compiler-result
                       (hash-map :op (get call-rules :builtin-op)
                                 :function callee
                                 :args (get args :value)))
                      args))
                  (if (contains? (get module :function-table) callee)
                    (let [args
                          (p15-s23-compile-forms
                           emitter
                           (assoc module :p15-s23-sh07-child-index-base 1)
                           locals arguments [])]
                      (if (p15-s23-compiler-complete? args)
                        (p15-s23-compiler-result
                         (hash-map :op (get call-rules :function-op)
                                   :function callee
                                   :args (get args :value)))
                        args))
                    (let [external-link
                          (p15-s23-external-call-descriptor
                           module
                           (get module :p15-s23-sh07-enclosing-function)
                           callee (count arguments)
                           (get module :p15-s23-sh07-callsite-path []))]
                      (if (= nil external-link)
                        (p15-s23-compiler-error
                         (get call-rules :unknown-callee-diagnostic)
                         (hash-map :operator callee
                                   :reason :unauthenticated-b51-external-link))
                        (let [args
                              (p15-s23-compile-forms
                               emitter
                               (assoc module
                                      :p15-s23-sh07-child-index-base 1)
                               locals arguments [])]
                          (if (p15-s23-compiler-complete? args)
                            (p15-s23-compiler-result
                             (hash-map
                              :op (get call-rules :function-op)
                              :function callee
                              :args (get args :value)
                              :external-link external-link))
                            args))))))))))))))))))

(defn p15-s23-compile-expr
  [emitter module locals form]
  (if (symbol? form)
    (if (contains? locals form)
      (p15-s23-compiler-result (hash-map :op :local :name form))
      (p15-s23-compiler-error
       "L2-UNKNOWN-SYMBOL" (hash-map :symbol form)))
    (if (seq? form)
      (p15-s23-compile-call emitter module locals form)
      (if (if (vector? form) true (if (map? form) true (set? form)))
        (p15-s23-compile-collection emitter module locals form)
        (p15-s23-compiler-result
         (hash-map
          :op (get (get (get emitter :collection-rules) :literal) :op)
          :value form))))))

(defn p15-s23-compile-function
  [emitter module definition]
  (let [name (get definition :name)
        params (get definition :params)
        body (get definition :body)
        compile-module
        (assoc
         (assoc
          (assoc module :p15-s23-sh07-enclosing-function name)
          :p15-s23-sh07-enclosing-definition definition)
         :p15-s23-sh07-callsite-path [])
        compiled-body
        (p15-s23-compile-forms
         emitter (assoc compile-module :p15-s23-sh07-child-index-base 0)
         (set params) body [])]
    (if (p15-s23-compiler-complete? compiled-body)
      (let [exports (get module :exports)
            visibility
            (if (> (count exports) 0)
              (if (contains? (set exports) name) :public :private)
              :stage2-local)
            binding
            (hash-map :name name
                      :kind :function
                      :namespace (get module :module)
                      :profile (get module :profile)
                      :target (get module :target)
                      :visibility visibility
                      :effects (get module :effects)
                      :capabilities (get module :capabilities))]
        (p15-s23-compiler-result
         (assoc definition
                :binding binding
                :instructions (get compiled-body :value))))
      compiled-body)))

; Plan assembly is deliberately part of the same Gravity-authored compiler
; artifact as expression lowering.  The host supplies an ordered vector of
; analyzed function definitions and retains only prerequisite validation,
; execution of this closed function plan, and cryptographic sealing.
(defn p15-s23-summary-instructions
  [instructions summary]
  (if (= 0 (count instructions))
    (p15-s23-compiler-result summary)
    (if (> (count instructions) 64)
      (let [midpoint (quot (count instructions) 2)
            left
            (p15-s23-summary-instructions
             (subvec instructions 0 midpoint) summary)]
        (if (p15-s23-compiler-complete? left)
          (p15-s23-summary-instructions
           (subvec instructions midpoint (count instructions))
           (get left :value))
          left))
      (let [next-summary
            (p15-s23-summary-instruction (first instructions) summary)]
        (if (p15-s23-compiler-complete? next-summary)
          (p15-s23-summary-instructions
           (rest instructions) (get next-summary :value))
          next-summary)))))

(defn p15-s23-summary-map-entries
  [entries summary]
  (if (= 0 (count entries))
    (p15-s23-compiler-result summary)
    (if (> (count entries) 64)
      (let [midpoint (quot (count entries) 2)
            left
            (p15-s23-summary-map-entries
             (subvec entries 0 midpoint) summary)]
        (if (p15-s23-compiler-complete? left)
          (p15-s23-summary-map-entries
           (subvec entries midpoint (count entries)) (get left :value))
          left))
      (let [entry (first entries)
            key-summary
            (p15-s23-summary-instruction (get entry :key) summary)]
        (if (p15-s23-compiler-complete? key-summary)
          (let [value-summary
                (p15-s23-summary-instruction
                 (get entry :value) (get key-summary :value))]
            (if (p15-s23-compiler-complete? value-summary)
              (p15-s23-summary-map-entries
               (rest entries) (get value-summary :value))
              value-summary))
          key-summary)))))

(defn p15-s23-summary-let-bindings
  [bindings summary]
  (if (= 0 (count bindings))
    (p15-s23-compiler-result summary)
    (if (> (count bindings) 64)
      (let [midpoint (quot (count bindings) 2)
            left
            (p15-s23-summary-let-bindings
             (subvec bindings 0 midpoint) summary)]
        (if (p15-s23-compiler-complete? left)
          (p15-s23-summary-let-bindings
           (subvec bindings midpoint (count bindings)) (get left :value))
          left))
      (let [binding-summary
            (p15-s23-summary-instruction
             (get (first bindings) :expr) summary)]
        (if (p15-s23-compiler-complete? binding-summary)
          (p15-s23-summary-let-bindings
           (rest bindings) (get binding-summary :value))
          binding-summary)))))

(defn p15-s23-summary-instruction
  [instruction summary]
  (let [op (get instruction :op)
        counted (assoc summary op (+ 1 (get summary op 0)))]
    (if (= op :throw)
      (p15-s23-summary-instruction (get instruction :value) counted)
    (if (= op :println)
      (p15-s23-summary-instructions (get instruction :args) counted)
      (if (= op :do)
        (p15-s23-summary-instructions (get instruction :body) counted)
        (if (= op :if)
          (let [test-summary
                (p15-s23-summary-instruction
                 (get instruction :test) counted)]
            (if (p15-s23-compiler-complete? test-summary)
              (let [then-summary
                    (p15-s23-summary-instruction
                     (get instruction :then) (get test-summary :value))]
                (if (p15-s23-compiler-complete? then-summary)
                  (p15-s23-summary-instruction
                   (get instruction :else) (get then-summary :value))
                  then-summary))
              test-summary))
          (if (contains? #{:let :loop} op)
            (let [binding-summary
                  (p15-s23-summary-let-bindings
                   (get instruction :bindings) counted)]
              (if (p15-s23-compiler-complete? binding-summary)
                (p15-s23-summary-instructions
                 (get instruction :body) (get binding-summary :value))
                binding-summary))
            (if (= op :recur)
              (p15-s23-summary-instructions (get instruction :args) counted)
              (if (= op :builtin-call)
                (p15-s23-summary-instructions (get instruction :args) counted)
                (if (= op :function-call)
                  (p15-s23-summary-instructions (get instruction :args) counted)
                  (if (= op :vector-literal)
                    (p15-s23-summary-instructions
                     (get instruction :items) counted)
                    (if (= op :set-literal)
                      (p15-s23-summary-instructions
                       (get instruction :items) counted)
                      (if (= op :map-literal)
                        (p15-s23-summary-map-entries
                         (get instruction :entries) counted)
                        (p15-s23-compiler-result counted))))))))))))))

(defn p15-s23-assemble-functions
  [emitter module definitions functions bindings summary]
  (if (= 0 (count definitions))
    (p15-s23-compiler-result
     (hash-map :functions functions
               :binding-table bindings
               :instruction-summary summary))
    ; Bound the generic seed runner's call depth without moving assembly
    ; semantics back into the host.  Large ordered tables are divided inside
    ; the Gravity artifact; each leaf retains the same sequential products.
    (if (> (count definitions) 64)
      (let [midpoint (quot (count definitions) 2)
            left
            (p15-s23-assemble-functions
             emitter module (subvec definitions 0 midpoint)
             functions bindings summary)]
        (if (p15-s23-compiler-complete? left)
          (let [products (get left :value)]
            (p15-s23-assemble-functions
             emitter module
             (subvec definitions midpoint (count definitions))
             (get products :functions)
             (get products :binding-table)
             (get products :instruction-summary)))
          left))
      (let [entry (first definitions)
            name (first entry)
            compiled-function
            (p15-s23-compile-function emitter module (second entry))]
        (if (p15-s23-compiler-complete? compiled-function)
          (let [function (get compiled-function :value)
                function-summary
                (p15-s23-summary-instructions
                 (get function :instructions) summary)]
            (if (p15-s23-compiler-complete? function-summary)
              (p15-s23-assemble-functions
               emitter module (rest definitions)
               (assoc functions name function)
               (conj bindings
                     (assoc (get function :binding)
                            :arity (get function :arity)))
               (get function-summary :value))
              function-summary))
          compiled-function)))))

(defn p15-s23-complete-plan-products
  [module products entrypoint]
  (p15-s23-compiler-result
   (assoc products
          :entrypoint entrypoint
          :effect-summary
          (if (> (get (get products :instruction-summary) :throw 0) 0)
            (hash-map
             :declared (get module :effects)
             :inferred :pending-gravity-emitter-effect-inference
             :legality :not-checked :authority :non-authoritative
             :source-operation-occurrences
             (hash-map :throw (get (get products :instruction-summary) :throw))
             :capabilities (get module :capabilities))
          (hash-map
           :declared (get module :effects)
           :inferred
           (if (> (get (get products :instruction-summary) :println 0) 0)
             #{:io/write}
             #{})
           :capabilities (get module :capabilities))))))

(defn p15-s23-assemble-plan-products
  [emitter module definitions]
  (let [descriptor (get module :p15-s23-sh07-module-source-descriptor)
        external-index
        (if (= nil descriptor)
          (p15-s23-compiler-result (hash-map))
          (p15-s23-build-external-edge-index
           descriptor (get module :p15-s23-sh07-link-manifest)))]
    (if (p15-s23-compiler-complete? external-index)
      (let [compile-module
            (if (= nil descriptor)
              module
              (assoc module :p15-s23-sh07-external-edge-index
                     (get external-index :value)))
            assembled
            (p15-s23-assemble-functions
             emitter compile-module definitions (hash-map) [] (hash-map))]
        (if (p15-s23-compiler-complete? assembled)
          (let [products (get assembled :value)
            entrypoint (get (get emitter :plan-shape) :entrypoint)
            main-function (get (get products :functions) entrypoint)]
            (if (= nil main-function)
              (if (= nil descriptor)
                (p15-s23-compiler-error
                 "L3-UNKNOWN-ALIAS" (hash-map :entrypoint entrypoint))
                (p15-s23-complete-plan-products
                 compile-module products nil))
              (if (> (count (get main-function :params)) 0)
            (p15-s23-compiler-error
             "L2-MAIN-ARITY"
             (hash-map :params (get main-function :params)))
                (p15-s23-complete-plan-products
                 compile-module products entrypoint))))
          assembled))
      external-index)))

; Explicit typed lowering consumes ordinary verified pass DATA. The temporary
; Clojure orchestration invokes current Gravity C7 once and supplies its actual
; fresh report separately. Raw kernel arguments are not authority tokens.
(defn p15-s23-typed-path [value fields]
  (loop [remaining fields result value]
    (if (= 0 (count remaining)) result
      (recur (rest remaining) (get result (first remaining))))))

(defn p15-s23-typed-error [reason]
  (p15-s23-compiler-error "P15S23Q002" {:missing-fact :explicit-typed-lowering-input :reason reason}))

(defn p15-s23-typed-node-error [reason node]
  (let [source (get node :source)
        facts {:missing-fact :explicit-typed-lowering-input :reason reason :core-node-id (get node :node-id)
               :syntax-id (get source :syntax-id) :origin-chain (get source :origin-chain)
               :generated-origin (get source :generated-origin) :binding-context (get node :binding-context)}]
    (p15-s23-compiler-error "P15S23Q002"
      (if (map? (get source :semantic-span)) (assoc facts :source-span (get source :semantic-span)) facts))))

(defn p15-s23-typed-index [records field]
  (if (vector? records)
    (loop [remaining records out {}]
      (if (= 0 (count remaining)) out
        (let [record (first remaining) id (get record field)]
          (if (if (map? record) (if (= id nil) false (= false (contains? out id))) false)
            (recur (rest remaining) (assoc out id record)) nil)))) nil))

(defn p15-s23-typed-all [checks]
  (loop [remaining checks]
    (if (= 0 (count remaining)) true
      (if (= true (first remaining)) (recur (rest remaining)) false))))

(defn p15-s23-typed-project [value fields]
  (loop [remaining fields out {}]
    (if (= 0 (count remaining)) out
      (recur (rest remaining) (assoc out (first remaining) (get value (first remaining)))))))

(defn p15-s23-typed-set [values]
  (if (= values nil) #{}
    (if (if (set? values) true (vector? values))
      (if (<= (count values) 65536) (set values) nil) nil)))

(defn p15-s23-typed-atomic-id [name]
  (get '{I8 :gravity.type/i8 I16 :gravity.type/i16 I32 :gravity.type/i32 I64 :gravity.type/i64
         U8 :gravity.type/u8 U16 :gravity.type/u16 U32 :gravity.type/u32 U64 :gravity.type/u64
         F32 :gravity.type/f32 F64 :gravity.type/f64 Bool :gravity.type/bool
         String :gravity.type/string Symbol :gravity.type/symbol Keyword :gravity.type/keyword Ratio :gravity.type/ratio} name))

(defn p15-s23-typed-declaration? [declaration type context]
  (if (= declaration nil) true
    (let [binding (get (get context :bindings) (get declaration :type-binding-id))
          form (get (get context :forms) (get declaration :type-form-id))]
      (p15-s23-typed-all [(= [:core :type 'gravity.core] [(get binding :binding-class) (get binding :kind) (get binding :namespace)])
                         (= type (get declaration :type-id) (p15-s23-typed-atomic-id (get binding :name)))
                         (= (get binding :name) (get declaration :type-symbol) (get form :value))
                         (= (get form :syntax-id) (get declaration :type-syntax-id))]))))

(defn p15-s23-typed-source-equal? [tokens text]
  (if (if (vector? tokens) (string? text) false)
    (loop [remaining tokens position 0]
      (if (= 0 (count remaining)) (= position (count text))
        (let [raw (get (first remaining) :raw)
              match? (if (string? raw)
                       (loop [index 0]
                         (if (= index (count raw)) true
                           (if (= (get raw index) (get text (+ position index)))
                             (recur (+ index 1)) false))) false)]
          (if match? (recur (rest remaining) (+ position (count raw))) false)))) false))

(defn p15-s23-typed-context [module input observation]
  (if (if (map? module) (map? input) false)
  (let [request (get input :request) typed (get input :typed) supplied (get input :verification)
        fresh (get observation :verification) core (get request :canonical-core-artifact)
        authenticated (p15-s23-typed-path request [:b47-context :authenticated-core-request])
        macro-artifact (p15-s23-typed-path request [:b47-context :authenticated-wrapper :sh06-resolution-artifact :sh05-macro-artifact])
        reader (p15-s23-typed-path macro-artifact [:gravity-macro-boundary :authenticated-sh04-artifact :c2-reader-artifact])
        source (get observation :source) source-unit (get reader :source-unit-record)
        nodes (get core :nodes) forms (get authenticated :forms) bindings (get authenticated :binding-table)
        records (get core :function-records) functions (get typed :function-type-table)
        families? (p15-s23-typed-all [(vector? (get reader :token-stream)) (vector? nodes) (vector? forms) (vector? bindings)
                                     (vector? records) (vector? functions) (map? (get typed :type-table))])
        work (if families? (+ (if (string? (get source :text)) (count (get source :text)) 0)
                (count (get reader :token-stream)) (count nodes) (count forms) (count bindings)
                (* (count records) (+ 20 (count nodes) (count forms) (count bindings)))) 65537)]
    (if (= false families?) (p15-s23-typed-error :malformed-typed-input-families)
    (if (> work 65536) (p15-s23-typed-error :typed-lowering-work-limit)
    (if (p15-s23-typed-all
          [(map? input) (if (if (map? input) (= 3 (count input)) false) (= #{:request :typed :verification} (set (keys input))) false)
           (map? module) (vector? (get module :forms))
           (set? (p15-s23-typed-set (get module :effects))) (set? (p15-s23-typed-set (get module :capabilities)))
           (set? (p15-s23-typed-set (get module :exports)))
           (= :accepted (get typed :status))
           (= :gravity/sh08-function-type-verification (get fresh :artifact)) (= :passed (get fresh :status))
           (= typed (get fresh :expected) (get fresh :candidate)) (= supplied fresh)
           (= (get core :artifact-id) (get typed :sh07-shaped-artifact-id))
           (= (get core :module) (get typed :module) (get authenticated :module))
           (= (get module :module) (get (get core :module) :namespace))
           (= (get module :profile) (get (get core :module) :profile))
           (= (get module :target) (get (get core :module) :target))
           (= (get module :safety) (get (get core :module) :safety))
           (= (p15-s23-typed-set (get module :effects)) (p15-s23-typed-set (get (get core :module) :effects)))
           (= (p15-s23-typed-set (get module :capabilities)) (p15-s23-typed-set (get (get core :module) :capabilities)))
           (= (p15-s23-typed-set (get module :exports)) (p15-s23-typed-set (get (get core :module) :exports)))
           (= (get module :forms) (get macro-artifact :expanded-forms))
           (string? (get source :text)) (string? (get source :path))
           (= (get module :source-path) (get source :path) (get source-unit :path))
           (if (contains? module :source-text) (= (get module :source-text) (get source :text)) true)
           (= (get source :sha256) (get source-unit :bytes-hash))])
        (if (p15-s23-typed-source-equal? (get reader :token-stream) (get source :text))
          (let [node-index (p15-s23-typed-index nodes :node-id) form-index (p15-s23-typed-index forms :form-id)
                binding-index (p15-s23-typed-index bindings :binding-id)
                record-index (p15-s23-typed-index records :definition-name)
                function-index (p15-s23-typed-index functions :definition-name)]
            (if (p15-s23-typed-all [(map? node-index) (map? form-index) (map? binding-index)
                                   (map? record-index) (map? function-index) (= (count record-index) (count function-index))])
              (p15-s23-compiler-result {:core core :typed typed :nodes node-index :forms form-index :bindings binding-index
                :records record-index :functions function-index :types (get typed :type-table)
                :observation observation :budget (- 65536 work)})
              (p15-s23-typed-error :typed-source-index-census)))
          (p15-s23-typed-error :typed-source-bytes-mismatch))
      (p15-s23-typed-error :typed-input-source-or-verification-mismatch)))))
    (p15-s23-typed-error :malformed-typed-input-families)))

(defn p15-s23-typed-definition [context name]
  (let [record (get (get context :records) name) function (get (get context :functions) name)
        nodes (get context :nodes) forms (get context :forms) bindings (get context :bindings)
        fn-node (get nodes (get record :function-core-node-id)) def-node (get nodes (get record :definition-core-node-id))
        fn-form (get forms (get (get fn-node :source) :form-id))
        def-form (get forms (get (get def-node :source) :form-id)) fn-ids (get fn-form :child-form-ids)
        signature (get record :signature) body-index (get signature :body-source-child-index 2)
        body-form (get forms (get fn-ids body-index))
        parameter-form (get forms (get fn-ids 1)) names (get (get fn-node :attributes) :parameters)
        parameter-ids (get record :parameter-binding-ids)
        declared? (contains? record :signature)
        return? (= body-index 4)
        definition {:name name :params names :body [(get body-form :value)] :definition-form :def-fn
                    :arity (count names) :body-form-count 1}
        definition (if declared? (assoc definition :source-declarations
                     {:parameters (get parameter-form :value)
                      :return (if return? [:- (get (get forms (get fn-ids 3)) :value)] nil)}) definition)
        locals (loop [ids parameter-ids remaining-names names values {}]
                 (if (= 0 (count ids)) values
                   (recur (rest ids) (rest remaining-names) (assoc values (first ids) (first remaining-names)))))
        parameters (get function :parameters)
        types (loop [remaining parameters values {}]
                (if (= 0 (count remaining)) values
                  (recur (rest remaining) (assoc values (get (first remaining) :binding-id) (get (first remaining) :type)))))]
    (if (p15-s23-typed-all
          [(map? record) (= :named-top-level (get record :definition-kind)) (= :fn (get fn-node :core-form))
           (= :def (get def-node :core-form)) (= [name (get fn-form :value)] (vec (rest (get def-form :value))))
           (= (get record :function-syntax-id) (get (get fn-node :source) :syntax-id) (get function :function-id))
           (= (get record :function-core-node-id) (get function :function-core-node-id) (first (get def-node :children)))
           (= (get record :body-core-node-id) (first (get fn-node :children)) (get function :body-core-node-id))
           (= (get body-form :form-id) (get (get (get nodes (get record :body-core-node-id)) :source) :form-id))
           (= (get record :signature) (get (get fn-node :attributes) :signature) (get function :signature))
           (= parameter-ids (get fn-node :resolved-binding-ids) (get function :parameter-binding-ids))
           (= (p15-s23-typed-project function [:function-id :function-core-node-id :body-core-node-id :parameters :return :signature :thrown-error-effects])
              (p15-s23-typed-project (get (get context :types) (get record :function-core-node-id))
                [:function-id :function-core-node-id :body-core-node-id :parameters :return :signature :thrown-error-effects])
              (p15-s23-typed-project (get (get context :types) (get record :definition-core-node-id))
                [:function-id :function-core-node-id :body-core-node-id :parameters :return :signature :thrown-error-effects]))
           (if (= :gravity.type/never (get (get context :types) (get record :body-core-node-id))) true
             (= (get function :return) (get (get context :types) (get record :body-core-node-id))))
           (p15-s23-typed-declaration? (get signature :return) (get function :return) context)
           (= (count names) (get record :fixed-arity) (get function :fixed-arity) (count parameters))
           (loop [ids parameter-ids remaining-names names ordinal 0]
             (if (= 0 (count ids)) true
               (let [binding (get bindings (first ids)) coordinate (if declared? (get (get signature :parameter-source-child-indexes) ordinal) ordinal)
                     name-form (get forms (get (get parameter-form :child-form-ids) coordinate))]
                 (if (p15-s23-typed-all [(= (first remaining-names) (get binding :name))
                         (= :lexical (get binding :binding-class)) (= :local (get binding :kind))
                         (= (get binding :name) (get name-form :value))
                         (= (get binding :definition-syntax-id) (get name-form :syntax-id))
                         (= (get binding :scope-id) (get name-form :scope-id))
                         (p15-s23-typed-declaration? (get (get signature :parameters) ordinal) (get types (first ids)) context)
                         (= false (contains? #{nil :gravity.type/unknown} (get types (first ids))))])
                   (recur (rest ids) (rest remaining-names) (+ ordinal 1)) false))))])
      (p15-s23-compiler-result {:definition definition :record record :function function :locals locals :parameter-types types})
      (p15-s23-typed-node-error :typed-definition-or-declaration-mismatch fn-node))))

(defn p15-s23-typed-compile-children [context ids budget values]
  (if (= 0 (count ids)) (assoc (p15-s23-compiler-result values) :work-count 0)
    (let [head (p15-s23-typed-compile-node context (first ids) budget)]
      (if (p15-s23-compiler-complete? head)
        (let [tail (p15-s23-typed-compile-children context (rest ids) (- budget (get head :work-count)) (conj values (get head :value)))]
          (if (p15-s23-compiler-complete? tail)
            (assoc tail :work-count (+ (get head :work-count) (get tail :work-count))) tail)) head))))

(defn p15-s23-typed-compile-node [context id budget]
  (let [node (get (get context :nodes) id) form (get node :core-form) children (get node :children)
        source (get (get context :forms) (get (get node :source) :form-id)) type (get (get context :types) id)]
    (if (<= budget 0) (p15-s23-typed-node-error :typed-lowering-work-limit node)
      (if (if (map? node) (= false (contains? #{nil :gravity.type/unknown} type)) false)
        (if (= form :literal)
          (if (if (= :decimal (get (get node :attributes) :literal-kind)) true (map? (get source :value)))
            (p15-s23-typed-node-error :unelaborated-typed-numeric-literal node)
          (if (= (get source :value) (get (get node :attributes) :value))
            (assoc (p15-s23-compiler-result {:op :literal :value (get source :value)}) :work-count 1)
            (p15-s23-typed-node-error :typed-literal-source-mismatch node)))
          (if (= form :reference)
            (let [binding (get (get node :attributes) :binding-id) name (get (get context :locals) binding)]
              (if (if (= name nil) false (= type (get (get context :parameter-types) binding)))
                (assoc (p15-s23-compiler-result {:op :local :name name}) :work-count 1)
                (p15-s23-typed-node-error :typed-reference-outside-parameters node)))
            (if (contains? #{:throw :if :do} form)
              (if (if (= form :throw) (if (= 1 (count children)) (= type :gravity.type/never) false)
                    (if (= form :if) (= 3 (count children)) true))
                (let [compiled (p15-s23-typed-compile-children context children (- budget 1) []) values (get compiled :value)]
                  (if (p15-s23-compiler-complete? compiled)
                    (assoc (p15-s23-compiler-result
                      (if (= form :throw) {:op :throw :value (first values)}
                        (if (= form :if) {:op :if :test (first values) :then (get values 1) :else (get values 2)}
                          {:op :do :body values}))) :work-count (+ 1 (get compiled :work-count))) compiled))
                (p15-s23-typed-node-error :typed-control-shape-mismatch node))
              (p15-s23-typed-node-error :unsupported-typed-lowering-operation node))))
        (p15-s23-typed-node-error :missing-typed-core-node node)))))

(defn p15-s23-typed-provenance [context]
  (let [observation (get context :observation) source (get observation :source)]
    {:boundary :current-gravity-typed-lowering :authority :non-authoritative
     :emission-scope :current-c6-typed-function-subset
     :compiler-sources (get observation :compiler-sources)
     :source {:path (get source :path) :sha256 (get source :sha256)}
     :typed-core-input (get (get context :core) :artifact-id)
     :type-verifier :current-gravity-c7 :effect-legality :pending-c8-and-profile-authority}))

(defn p15-s23-typed-lower-function [module definition context]
  (let [joined (p15-s23-typed-definition context (get definition :name)) value (get joined :value)]
    (if (p15-s23-compiler-complete? joined)
      (if (= definition (get value :definition))
        (let [compiled (p15-s23-typed-compile-node
                         (assoc (assoc context :locals (get value :locals)) :parameter-types (get value :parameter-types))
                         (get (get value :record) :body-core-node-id) (get context :budget))
              function (get value :function)]
          (if (p15-s23-compiler-complete? compiled)
            (p15-s23-compiler-result (assoc definition
              :instructions [(get compiled :value)]
              :binding {:name (get definition :name) :kind :function :namespace (get module :module)
                :profile (get module :profile) :target (get module :target)
                :visibility (if (> (count (get module :exports)) 0)
                              (if (contains? (set (get module :exports)) (get definition :name)) :public :private) :stage2-local)
                :effects (get module :effects) :capabilities (get module :capabilities)}
              :type-input {:function-id (get function :function-id) :function-core-node-id (get function :function-core-node-id)
                           :body-core-node-id (get function :body-core-node-id)
                           :definition-binding-id (get (get value :record) :definition-binding-id)
                           :parameters (get function :parameters)
                           :return (get function :return) :thrown-error-effects (get function :thrown-error-effects)}
              :typed-lowering-provenance (p15-s23-typed-provenance context))) compiled))
        (p15-s23-typed-node-error :supplied-definition-does-not-match-typed-source
          (get (get context :nodes) (get (get value :record) :function-core-node-id)))) joined)))

(defn p15-s23-typed-compile-function [emitter module definition input observation]
  (let [checked (p15-s23-typed-context module input observation)]
    (if (p15-s23-compiler-complete? checked)
      (if (p15-s23-typed-module-table? module (get checked :value))
        (p15-s23-typed-lower-function module definition (get checked :value))
        (p15-s23-typed-error :typed-module-function-table-mismatch)) checked)))

(defn p15-s23-typed-module-table? [module context]
  (if (contains? module :function-table)
    (let [table (get module :function-table)]
      (if (if (map? table) (if (= (count table) (count (get context :records)))
                            (= (set (keys table)) (set (keys (get context :records)))) false) false)
        (loop [remaining (keys table)]
          (if (= 0 (count remaining)) true
            (let [expected (p15-s23-typed-definition context (first remaining))]
              (if (if (p15-s23-compiler-complete? expected) (= (get table (first remaining)) (get (get expected :value) :definition)) false)
                (recur (rest remaining)) false)))) false)) true))

(defn p15-s23-typed-assemble-plan-products [emitter module definitions input observation]
  (let [checked (p15-s23-typed-context module input observation) context (get checked :value)]
    (if (p15-s23-compiler-complete? checked)
      (if (if (vector? definitions) (= (count definitions) (count (get context :records))) false)
        (let [indexed (p15-s23-typed-index
                  (loop [remaining definitions out []]
                    (if (= 0 (count remaining)) out
                      (let [entry (first remaining)]
                        (if (if (vector? entry) (if (= 2 (count entry))
                              (if (symbol? (first entry)) (map? (second entry)) false) false) false)
                          (recur (rest remaining) (conj out {:name (first entry) :definition (second entry)}))
                          (conj out {}))))) :name)]
      (if (if (map? indexed) (if (p15-s23-typed-module-table? module context)
                              (= (set (keys indexed)) (set (keys (get context :records)))) false) false)
        (loop [remaining definitions functions {} bindings [] summary {}]
          (if (= 0 (count remaining))
            (let [entrypoint (get (get emitter :plan-shape) :entrypoint 'main)
                  main-function (get functions entrypoint)
                  products (p15-s23-complete-plan-products module
                             {:functions functions :binding-table bindings :instruction-summary summary}
                             (if (= main-function nil) nil entrypoint))]
              (if (if (= main-function nil) false (> (count (get main-function :params)) 0))
                (p15-s23-compiler-error "L2-MAIN-ARITY" {:params (get main-function :params)})
                (assoc products :value (assoc (get products :value) :typed-lowering-provenance (p15-s23-typed-provenance context)
                  :effect-summary (assoc (get (get products :value) :effect-summary)
                    :legality :pending-c8-and-profile-authority :authority :non-authoritative)))))
            (let [entry (first remaining) compiled (p15-s23-typed-lower-function module (second entry) context)
                  function (get compiled :value)]
              (if (if (= (first entry) (get (second entry) :name)) (p15-s23-compiler-complete? compiled) false)
                (let [counted (p15-s23-summary-instructions (get function :instructions) summary)]
                  (if (p15-s23-compiler-complete? counted)
                    (recur (rest remaining) (assoc functions (first entry) function)
                      (conj bindings (assoc (get function :binding) :arity (get function :arity))) (get counted :value)) counted))
                (if (p15-s23-compiler-complete? compiled) (p15-s23-typed-error :typed-definition-name-mismatch) compiled)))))
        (p15-s23-typed-error :typed-module-definition-census)))
        (p15-s23-typed-error :typed-module-definition-census)) checked)))

(defn main
  []
  (hash-map :artifact :gravity/stage2-expression-lowering
            :status :ready))

     :evaluation-order :operator-then-arguments :source-span (get source :semantic-span) :syntax-id (get source :syntax-id)
     :origin-chain (get source :origin-chain) :generated-origin (get source :generated-origin)
     :profile (get module :profile) :target (get module :target) :effects [] :capabilities [] :status :inferred
     :dispatch :direct-integral-ordering :applied-integral-ordering descriptor :effect-facts-source :audited-numeric-intrinsic}))

(defn p15-s23-typed-compile-ordering [context node budget]
  (let [id (get node :node-id) core (get context :core) forms (get context :forms) nodes (get context :nodes)
        call (get (get context :calls) id) edge (get (get context :edges) id)
        descriptor (p15-s23-io-descriptor core node call edge nodes (get context :bindings) (get context :types) (get core :module))
        owner (get forms (get (get node :source) :form-id)) ids (get owner :child-form-ids)
        children (get node :children) arguments (get call :argument-node-ids)
        rows (loop [remaining (get context :ledger) out []]
               (if (= 0 (count remaining)) out
                 (let [row (first remaining)]
                   (recur (rest remaining) (if (if (= :sh08-integral-ordering-v1 (get row :producer-rule))
                     (= {:core-node-id id :projection :integral-ordering} (get row :lhs)) false) (conj out row) out)))))]
    (if (< budget 64) (p15-s23-typed-node-error :typed-lowering-work-limit node)
      (if (if (map? descriptor)
            (p15-s23-typed-all
              [(= descriptor (get (get context :types) (first children)))

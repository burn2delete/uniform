(defn p15-s23-lsi-index [records field budget]
  (if (if (vector? records) (<= (count records) 65536) false)
    (loop [remaining records out {} work 0]
      (if (= 0 (count remaining)) {:status :accepted :index out :work-count work}
        (let [record (first remaining) fields (if (map? record) (count record) 0) cost (+ 4 fields)]
          (if (> (+ work cost) budget) {:status :rejected :reason :loop-type-work-limit :work-count (+ work cost)}
            (if (if (map? record)
                  (loop [keys (keys record)] (if (= 0 (count keys)) true
                    (if (keyword? (first keys)) (recur (rest keys)) false))) false)
              (let [id (get record field)]
                (if (if (p15-s23-lsi-id? id) (= false (contains? out id)) false)
                  (recur (rest remaining) (assoc out id record) (+ work cost))
                  {:status :rejected :reason :incoherent-loop-member-source :work-count (+ work cost)}))
              {:status :rejected :reason :incoherent-loop-member-source :work-count (+ work cost)})))))
    {:status :rejected :reason :incoherent-loop-member-source :work-count 0}))

(defn p15-s23-lsi-empty-constructor? [node forms]
  (let [source (get node :source) id (get source :form-id)]
    (if (p15-s23-lsi-id? id)

             (if (= input :gravity.type/never) true
               (if (= input :gravity.type/list) (= false (= 'first (get binding :name)))
                 (if (p15-s23-hl-type? input) (if (= 'first (get binding :name)) (map? (get validation :head-proof)) true)
                   (if (map? input) (= :gravity.type/list (get input :kind)) false))))))] )
      (let [header {:kind :gravity.type/applied-list-query :version :sh08-list-query-v1
       :operation (get binding :name) :semantic-owner 'gravity.collections :intrinsic :gravity.collections/persistent-list-query
       :resolution :gravity.core-compatibility :operator-node-id (get operator :node-id) :operator-binding-id bid
       :call-core-node-id (get node :node-id) :source (get node :source) :operator-source (get operator :source)
       :source-call call :source-edge edge :source-binding binding :argument-types arguments
       :query-policy (if (= 'empty? (get binding :name))
                       {:input :persistent-list :operand-evaluation :once :payload-evaluation :none
                        :original :unchanged :test :zero-elements :static-length :not-required}
                     {:input :persistent-list :operand-evaluation :once :payload-evaluation :none
                      :original :unchanged :order :stored-order
                      :head-knowledge (if (p15-s23-hl-type? (first arguments)) :homogeneous-requires-nonempty :finite-positional)
                      :suffix-knowledge (if (p15-s23-hl-type? (first arguments)) :homogeneous-preserved :available-positional-or-bare)})
       :storage-policy (if (= 'empty? (get binding :name))
                         {:representation :development-persistent-list :empty? :stored-emptiness-test :copy :none}
                       {:representation :development-persistent-list :first :stored-head-value
                        :rest :existing-immutable-tail :retention :may-retain-input-storage :copy :none})
       :value-origin {:kind :list-value-query :operation (get binding :name) :operand-node-id (first args)}

       :application (if invoked? :normal :not-invoked)
       :latent-effects [] :direct-effects [] :capabilities [] :thrown-error-effects []
       :profile (get module :profile) :target (get module :target)
       :invalidation [:calls :call-edges :binding-table :source-forms :type-table :lexical-bindings :definitions :function-records
                      :callee-body :operand-types :query-policy :storage-policy :value-origin :profile :target :evaluation-order]}]
        (if vector-first?
          (let [input (first arguments) elements (get input :element-types)]
            (assoc header :kind :gravity.type/applied-vector-first :version :sh08-vector-first-v1
              :intrinsic :gravity.collections/persistent-vector-first
              :query-policy {:input :nonempty-persistent-vector :operand-evaluation :once :payload-evaluation :none
                         :original :unchanged :order :stored-order :selection :stored-index-zero
                         :type-validation :entire-finite-positional-type :empty-result-policy :unselected}
              :storage-policy {:representation :development-persistent-vector :selection :stored-index-zero :copy :none}
              :value-origin {:kind :vector-value-query :operation 'first :operand-node-id (first args)}
              :bounds-proof {:kind :gravity.type/vector-first-nonempty :version :sh08-vector-first-nonempty-v1
                             :basis :validated-finite-positional-type :operand-node-id (first args) :operand-type input
                             :vector-length (count elements) :selected-index 0 :selected-type (get elements 0)
                             :outcome :proven-safe :check-elision :not-authorized :runtime-guards :retained}
              :invalidation (conj (get header :invalidation) :nonempty-evidence)))
        (if (contains? validation :head-proof)
          (assoc header :version :sh08-list-query-v2 :head-proof (get validation :head-proof)
            :invalidation (conj (get header :invalidation) :control-flow :mutations :branch-facts)) header))) nil)) nil) nil) nil))

(defn p15-s23-lq-constraint [descriptor]
  (if (if (keyword? (get descriptor :kind)) (contains? #{:gravity.type/applied-map-keys :gravity.type/applied-private-map-keys} (get descriptor :kind)) false)
(p15-s23-mkeys-constraint descriptor)
(if (= :gravity.type/applied-vector-rest (get descriptor :kind))
    (p15-s23-vrest-constraint descriptor)
  (if (= :gravity.type/applied-vector-empty (get descriptor :kind))
    (p15-s23-vemp-constraint descriptor)
  (let [record {:constraint-id-request {:domain :gravity/sh08-list-query-constraint-v1 :application descriptor}
   :kind :equality :producer-rule :sh08-list-query-v1
   :lhs {:core-node-id (get descriptor :call-core-node-id) :projection :list-query}
   :rhs (get descriptor :result-type) :dependencies descriptor :origin (get (get descriptor :source) :origin-chain)
   :solution {:result-type (get descriptor :result-type) :application (get descriptor :application)
              :direct-effects (get descriptor :direct-effects)}
   :invalidation (get descriptor :invalidation) :profile (get descriptor :profile) :target (get descriptor :target)
   :status :solved :diagnostics []}]
    (if (= :gravity.type/applied-vector-first (get descriptor :kind))
      (assoc record :constraint-id-request {:domain :gravity/sh08-vector-first-constraint-v1 :application descriptor}
        :producer-rule :sh08-vector-first-v1
        :lhs {:core-node-id (get descriptor :call-core-node-id) :projection :vector-first}
        :solution (assoc (get record :solution) :bounds-proof (get descriptor :bounds-proof))) record))
  ))))

(defn p15-s23-lq-call-fact [descriptor module]
  (if (if (keyword? (get descriptor :kind)) (contains? #{:gravity.type/applied-map-keys :gravity.type/applied-private-map-keys} (get descriptor :kind)) false)
(p15-s23-mkeys-call-fact descriptor module)
(if (= :gravity.type/applied-vector-rest (get descriptor :kind))
    (p15-s23-vrest-call-fact descriptor module)
  (if (= :gravity.type/applied-vector-empty (get descriptor :kind))
    (p15-s23-vemp-call-fact descriptor module)
  (let [source (get descriptor :source) edge (get descriptor :source-edge)]
    (if (= :gravity.type/applied-vector-first (get descriptor :kind))
      {:artifact :gravity/c7-call-type-fact
       :fact-id-request {:domain :gravity/sh08-vector-first-call-type-fact-v1 :application descriptor}
       :call-core-node-id (get descriptor :call-core-node-id) :caller-function-syntax-id (get edge :caller-function-syntax-id)
       :callee-function-syntax-id nil :argument-types (get descriptor :argument-types) :result-type (get descriptor :result-type)
       :evaluation-order :operator-then-arguments :source-span (get source :semantic-span) :syntax-id (get source :syntax-id)
       :origin-chain (get source :origin-chain) :generated-origin (get source :generated-origin)
       :profile (get module :profile) :target (get module :target) :effects [] :capabilities [] :status :inferred
       :dispatch :direct-vector-first :applied-vector-first descriptor :effect-facts-source :audited-vector-value-query}
    {:artifact :gravity/c7-call-type-fact
     :fact-id-request {:domain :gravity/sh08-list-query-call-type-fact-v1 :application descriptor}
     :call-core-node-id (get descriptor :call-core-node-id) :caller-function-syntax-id (get edge :caller-function-syntax-id)
     :callee-function-syntax-id nil :argument-types (get descriptor :argument-types) :result-type (get descriptor :result-type)
     :evaluation-order :operator-then-arguments :source-span (get source :semantic-span) :syntax-id (get source :syntax-id)
     :origin-chain (get source :origin-chain) :generated-origin (get source :generated-origin)
     :profile (get module :profile) :target (get module :target) :effects (get descriptor :direct-effects) :capabilities [] :status :inferred
     :dispatch :direct-list-query :applied-list-query descriptor :effect-facts-source :audited-list-value-query}))
  ))))


(defn p15-s23-lq-finish [header]
  (let [input (first (get header :argument-types))
        type (if (= :not-invoked (get header :application)) :gravity.type/never
               (if (= 'empty? (get header :operation)) :gravity.type/bool
                 (if (= 'first (get header :operation))
                   (if (p15-s23-hl-type? input) (get (get header :head-proof) :result-type)
                     (if (= 0 (count (get input :element-types))) :gravity.type/nil
                       (first (get input :element-types))))
                   (if (if (= input :gravity.type/list) true (p15-s23-hl-type? input)) input
                     (assoc input :element-types
                       (if (= 0 (count (get input :element-types))) []
                         (subvec (get input :element-types) 1 (count (get input :element-types)))))))))]
    (assoc header :parameter-types (get header :argument-types) :return type :result-type type)))

(defn p15-s23-hl-parent-index [records nodes budget]
  (loop [remaining records pending [] owner nil ordinal 0 parents {} work 0]
    (if (if (= 0 (count remaining)) (= 0 (count pending)) false)
      {:status :accepted :index parents :work-count work}
      (if (>= work budget) {:status :rejected :reason :list-head-work-limit :work-count work}
        (if (= 0 (count pending))
          (let [node (first remaining)]
            (if (vector? (get node :children))
              (recur (rest remaining) (get node :children) (get node :node-id) 0 parents (+ work 1))
              {:status :rejected :reason :list-head-parent-index-required :work-count (+ work 1)}))
          (let [id (first pending)]
            (if (if (contains? nodes id) (= false (contains? parents id)) false)
              (recur remaining (rest pending) owner (+ ordinal 1) (assoc parents id {:owner owner :ordinal ordinal}) (+ work 1))
              {:status :rejected :reason :list-head-parent-index-required :work-count (+ work 1)})))))))

(defn p15-s23-hl-reference? [node bid bindings]
  (let [binding (get bindings bid)]
    (p15-s23-typed-all [(= :reference (get node :core-form)) (= [] (get node :children))
          (= [:lexical :local] [(get binding :binding-class) (get binding :kind)])
          (= [bid] (get node :resolved-binding-ids))
          (= {:symbol (get binding :name) :position :expression :binding-id bid :binding-class :lexical
              :definition-syntax-id (get binding :definition-syntax-id)} (get node :attributes))])))

(defn p15-s23-hl-path [id nodes parents types budget]
  (loop [current id path [] seen #{} work 0]
    (let [edge (get parents current) owner (get nodes (get edge :owner))]
      (if (= edge nil) {:status :accepted :path path :work-count work}
        (if (if (>= work budget) true (>= work 128))
          {:status :rejected :reason :list-head-work-limit :work-count work}
          (if (contains? seen current)
            {:status :rejected :reason :list-head-cyclic-path :work-count work}
            (if (if (= :if (get owner :core-form)) (= :gravity.type/never (get types (first (get owner :children)))) false)
              {:status :rejected :reason :list-head-unreachable-branch :work-count (+ work 1)}
              (let [next-path (conj path {:owner-core-node-id (get owner :node-id) :child-core-node-id current :child-index (get edge :ordinal)})]
                (if (= :fn (get owner :core-form))
                  {:status :accepted :path next-path :work-count (+ work 1)}
                  (recur (get owner :node-id) next-path (conj seen current) (+ work 1)))))))))))

(defn p15-s23-lq-head-proof [core node call nodes bindings types budget]
  (let [input (get types (first (get call :argument-node-ids)))
        operator (get bindings (get call :operator-binding-id))]
    (if (if (= 'first (get operator :name)) (p15-s23-hl-type? input) false)
      (let [base (+ 128 (count (get core :calls)) (count (get core :call-edges))
                    (count (get core :control-flow)) (* 2 (count (get core :function-records)))
                    (count (get core :lexical-bindings)) (count (get core :mutations)))]
        (if (> base budget) {:status :rejected :reason :list-head-work-limit :work-count base}
          (let [prepared (p15-s23-hl-parent-index (get core :nodes) nodes (- budget base))
                work (+ base (get prepared :work-count 0))]
            (if (= :accepted (get prepared :status))
              (let [path (p15-s23-hl-path (get node :node-id) nodes (get prepared :index) types (- budget work))
                    used (+ work (get path :work-count))
                    selected (loop [entries (get path :path)]
                               (if (= 0 (count entries)) nil
                                 (if (= :if (get (get nodes (get (first entries) :owner-core-node-id)) :core-form))
                                   (first entries) (recur (rest entries)))))
                    branch (get nodes (get selected :owner-core-node-id)) ordinal (get selected :child-index)
                    condition (get nodes (first (get branch :children)))
                    calls (p15-s23-typed-index (get core :calls) :core-node-id) edges (p15-s23-typed-index (get core :call-edges) :call-core-node-id)
                    predicate (get calls (get condition :node-id))
                    receiver (get nodes (first (get call :argument-node-ids)))
                    tested (get nodes (first (get predicate :argument-node-ids)))
                    bid (get (get receiver :attributes) :binding-id) binding (get bindings bid)
                    owner-id (get (get node :evaluation) :owner-function-syntax-id)
                    parameter (loop [records (get core :function-records)]
                                (if (= 0 (count records)) nil
                                  (let [record (first records)]
                                    (if (= owner-id (get record :function-syntax-id))
                                      record (recur (rest records))))))
                    lexical (loop [records (get core :lexical-bindings)]
                              (if (= 0 (count records)) nil
                                (if (= bid (get (first records) :binding-id)) (first records) (recur (rest records)))))
                    parameter-ids (get parameter :parameter-binding-ids)
                    parameter-work (if (vector? parameter-ids) (count parameter-ids) 0)
                    used (+ used parameter-work)
                    parameter-index (if (if (<= used budget) (vector? parameter-ids) false)
                                      (loop [i 0] (if (= i (count parameter-ids)) nil
                                                    (if (= bid (get parameter-ids i)) i (recur (+ i 1))))) nil)
                    declaration (get (get (get parameter :signature) :parameters) parameter-index)
                    entry? (if (= declaration nil) (map? (get core :sh08-private-self-parameter-premise)) false)
                    used (+ used (if entry? (* 2 parameter-work) 0))
                    entry-parameter (if (if entry? (<= used budget) false)
                                      (p15-s23-is-parameter-record core parameter parameter-index binding input) nil)
                    immutable? (if (= :immutable (get lexical :mutability))
                                 (= input (get types (get lexical :initializer-node-id)))
                                 (if (= parameter-index nil) false
                                   (if (p15-s23-hl-declaration? declaration bindings) (= input (get declaration :type-id))
                                     (map? entry-parameter))))
                    mutations? (loop [records (get core :mutations)]
                                 (if (= 0 (count records)) false
                                   (if (= bid (get (first records) :target-binding-id)) true (recur (rest records)))))
                    header (if (if (= :accepted (get path :status))
                                 (if (<= used budget)
                                   (if (vector? (get predicate :argument-node-ids))
                                     (if (= 1 (count (get predicate :argument-node-ids)))
                                       (if (vector? (get condition :children))
                                         (if (= 2 (count (get condition :children)))
                                           (let [binding (get bindings (get predicate :operator-binding-id))]
                                             (if (= 'empty? (get binding :name)) (p15-s23-lq-binding? binding (get core :module)) false)) false) false) false) false) false) false)
                             (p15-s23-lq-source core condition predicate (get edges (get condition :node-id))
                               nodes bindings types (get core :module) (p15-s23-lc-validate-types [input])) nil)
                    control {:core-node-id (get branch :node-id) :kind :if :condition-node-id (get condition :node-id)
                             :branches [{:role :then :predicate :truthy :core-node-id (get (get branch :children) 1)}
                                        {:role :else :predicate :falsey :core-node-id (get (get branch :children) 2)}]
                             :branch-exclusivity :exactly-one :truthiness {:false-values [:nil :false] :other-values :true}
                             :result-policy :selected-branch}
                    controls (loop [records (get core :control-flow) found []]
                               (if (= 0 (count records)) found
                                 (recur (rest records) (if (= (get branch :node-id) (get (first records) :core-node-id)) (conj found (first records)) found))))]
                (if (> used budget) {:status :rejected :reason :list-head-work-limit :work-count used}
                (if (= :accepted (get path :status))
                  (if (p15-s23-typed-all
                        [(map? selected) (contains? #{1 2} ordinal) (= :if (get branch :core-form)) (= 3 (count (get branch :children)))
                         (= {:condition-child-index 0 :then-child-index 1 :else-child-index 2 :condition-evaluation :always-first
                             :branch-evaluation :exactly-one :truthiness {:false-values [:nil :false] :other-values :true}} (get branch :attributes))
                         (= :condition-then-exclusive-branch (get (get branch :evaluation) :kind))
                         (= [{:index 0 :core-node-id (get condition :node-id)}] (get (get branch :evaluation) :order))
                         (= [control] controls) immutable? (= false mutations?)
                         (contains? #{nil :immutable} (get binding :mutability))
                         (p15-s23-hl-reference? receiver bid bindings) (p15-s23-hl-reference? tested bid bindings)
                         (= input (get types (get tested :node-id)))
                         (= owner-id (get (get receiver :evaluation) :owner-function-syntax-id)
                                     (get (get tested :evaluation) :owner-function-syntax-id)
                                     (get (get condition :evaluation) :owner-function-syntax-id)
                                     (get (get branch :evaluation) :owner-function-syntax-id))
                         (map? header) (= 'empty? (get header :operation)) (= :normal (get header :application))
                         (= :gravity.type/bool (get types (get condition :node-id)))
                         (= (p15-s23-lq-finish header) (get types (get predicate :operator-node-id)))])
                    {:status :accepted :work-count used
                     :proof {:kind :gravity.type/list-head-branch :version :sh08-list-head-branch-v1
                             :head-call-core-node-id (get node :node-id) :receiver-core-node-id (get receiver :node-id)
                             :receiver-source (get receiver :source) :receiver-type input
                             :binding-id bid :binding binding
                             :immutable-binding-record (if (map? lexical) lexical
                                                         (if (map? entry-parameter) entry-parameter parameter))
                             :condition-core-node-id (get condition :node-id) :condition (p15-s23-lq-finish header)
                             :predicate-receiver-core-node-id (get tested :node-id) :predicate-receiver-source (get tested :source)
                             :branch-core-node-id (get branch :node-id) :branch-source (get branch :source) :control-flow control
                             :branch-child-index ordinal :branch-root-core-node-id (get (get branch :children) ordinal)
                             :ancestry (get path :path) :knowledge (if (= ordinal 1) :empty :nonempty)
                             :result-type (if (= ordinal 1) :gravity.type/nil (get input :element-type))}}
                    {:status :rejected :reason :list-head-branch-proof-required :work-count used})
                  (assoc path :work-count used))))
              {:status :rejected :reason (if (contains? #{:loop-work-limit :list-head-work-limit} (get prepared :reason)) :list-head-work-limit :list-head-parent-index-required)
               :work-count work}))))
      {:status :not-applicable :work-count 0})))

(defn p15-s23-typed-compile-list-query [context node budget]
  (if (if (map? context)
        (p15-s23-typed-all [(if (map? node) (p15-s23-sse-ids? [(get node :node-id)] 1) false)
                           (map? (get context :calls)) (map? (get context :core)) (map? (get context :types))
                           (map? (get context :nodes)) (map? (get context :bindings))]) false)
    (let [call (get (get context :calls) (get node :node-id))
          unary? (if (vector? (get call :argument-node-ids)) (= 1 (count (get call :argument-node-ids))) false)
          core (get context :core)
          physical? (if unary? (p15-s23-vemp-ids? node call (get context :nodes) (get context :bindings) (get core :module)) true)
          input (if (if unary? physical? false) (get (get context :types) (first (get call :argument-node-ids))) nil)]
      (if (= false physical?)
        (assoc (p15-s23-typed-node-error :unsupported-or-mismatched-typed-vector-empty node) :work-count 0)
        (if (= false (p15-s23-vemp-type-fields? input))
          (assoc (p15-s23-typed-node-error :unsupported-or-mismatched-typed-vector-empty node) :work-count 0)
          (if (p15-s23-mkeys-entry? node call (get context :nodes) (get context :bindings) (get context :types) (get core :module))
(p15-s23-typed-compile-map-keys context node budget)
(if (p15-s23-vrest-entry? node call (get context :nodes) (get context :bindings) (get context :types) (get core :module))
            (p15-s23-typed-compile-vector-rest context node budget)
          (if (p15-s23-vemp-entry? node call (get context :nodes) (get context :bindings) (get context :types) (get core :module))
            (p15-s23-typed-compile-vector-empty context node budget)
  (let [id (get node :node-id) core (get context :core)
        args (get (get (get context :calls) id) :argument-node-ids)
        receiver (get (get context :types) (first args))
        vector-first? (if (= :gravity.type/applied-vector-first (get (get (get context :types) (first (get node :children))) :kind)) true
                        (if (= 'first (get (get (get context :bindings) (get (get (get context :calls) id) :operator-binding-id)) :name))
                          (if (map? receiver) (= :gravity.type/vector (get receiver :kind)) false) false))
        base (+ 64 (count args) (count (get core :function-records))
                (if vector-first? (* 4 (count (get context :ledger))) 0))
        validation (p15-s23-lc-validate-types (p15-s23-io-child-types args (get context :types)))
        charge base
        head (if (if (<= charge budget) (= :accepted (get validation :status)) false)
               (p15-s23-lq-head-proof core node (get (get context :calls) id) (get context :nodes) (get context :bindings) (get context :types) (- budget charge))
               {:status :not-applicable :work-count 0})
        charge (+ charge (get head :work-count))
        validation (if (= :accepted (get head :status)) (assoc validation :head-proof (get head :proof)) validation)]
    (if (if (< budget charge) true false)
      (assoc (p15-s23-typed-node-error :typed-lowering-work-limit node) :work-count charge)
      (if (= :rejected (get head :status))
        (assoc (p15-s23-typed-node-error (get head :reason) node) :work-count charge)
      (let [call (get (get context :calls) id) edge (get (get context :edges) id)
            forms (get context :forms) nodes (get context :nodes)
            owner (get forms (get (get node :source) :form-id)) ids (get owner :child-form-ids)
            header (p15-s23-lq-source core node call edge nodes (get context :bindings) (get context :types) (get core :module) validation)
            descriptor (if (map? header) (p15-s23-lq-finish header) nil)
            producer-ids? (if vector-first?
                            (loop [remaining (get context :ledger)]
                              (if (= 0 (count remaining)) true
                                (let [row (first remaining) lhs (get row :lhs)]
                                  (if (= :sh08-vector-first-v1 (get row :producer-rule))
                                    (if (map? lhs)
                                      (if (= 2 (count lhs))
                                        (if (= :vector-first (get lhs :projection))
                                          (let [row-id (get lhs :core-node-id)]
                                            (if (if (keyword? row-id) true (if (string? row-id) (= 71 (count row-id)) false))
                                              (recur (rest remaining)) false)) false) false) false)
                                    (recur (rest remaining)))))) true)
            rows (if producer-ids? (loop [remaining (get context :ledger) out []]
                   (if (= 0 (count remaining)) out
                     (let [row (first remaining)]
                       (recur (rest remaining)
                         (if (if (= (if (= :gravity.type/applied-vector-first (get descriptor :kind)) :sh08-vector-first-v1 :sh08-list-query-v1) (get row :producer-rule))
                               (= {:core-node-id id :projection (if (= :gravity.type/applied-vector-first (get descriptor :kind)) :vector-first :list-query)} (get row :lhs)) false) (conj out row) out))))) [])]
        (if (if (map? descriptor)
              (p15-s23-typed-all
                [producer-ids?
                 (if vector-first?
                   (loop [remaining (get context :ledger) seen #{}]
                     (if (= 0 (count remaining)) true
                       (let [row (first remaining)]
                         (if (= :sh08-vector-first-v1 (get row :producer-rule))
                           (let [lhs (get row :lhs) row-id (get lhs :core-node-id)
                                 valid-id? (if (keyword? row-id) true (if (string? row-id) (= 71 (count row-id)) false))
                                 source-call (if valid-id? (get (get context :calls) row-id) nil)
                                 operator-id (get source-call :operator-node-id)
                                 source-type (if (if (map? source-call)
                                                  (if (keyword? operator-id) true (if (string? operator-id) (= 71 (count operator-id)) false)) false)
                                               (get (get context :types) operator-id) nil)]
                             (if (if valid-id?
                                   (if (map? lhs) (if (= 2 (count lhs)) (= :vector-first (get lhs :projection)) false) false) false)
                               (if (contains? seen row-id) false
                                 (if (p15-s23-typed-all
                                       [(map? source-call) (= row-id (get source-call :core-node-id))
                                        (= :gravity.type/applied-vector-first (get source-type :kind))
                                        (= source-call (get source-type :source-call))
                                        (= row (p15-s23-lq-constraint source-type))])
                                   (recur (rest remaining) (conj seen row-id)) false)) false))
                           (recur (rest remaining) seen))))) true)
                 (= descriptor (get (get context :types) (get call :operator-node-id)))
                 (= (get descriptor :result-type) (get (get context :types) id))
                 (= (get edge :ordinal) (get (get context :call-order) id))
                 (= (get (get context :current-function) :function-syntax-id) (get edge :caller-function-syntax-id))
                 (= [(p15-s23-lq-constraint descriptor)] rows)
                 (= (p15-s23-lq-call-fact descriptor (get core :module)) (get (get context :call-facts) id))
                 (= :list (get owner :kind)) (vector? ids) (= (+ 1 (count args)) (if (vector? ids) (count ids) 0) (count (get node :children)))
                 (= (get node :source) (p15-s23-typed-source owner))
                 (= {:operator-child-index 0 :argument-count (count args) :argument-child-indexes (loop [index 1 out []] (if (= index (count (get node :children))) out (recur (+ index 1) (conj out index))))
                     :evaluation-order :operator-then-arguments :dispatch :resolved-symbol-call} (get node :attributes))
                 (loop [i 0]
                   (if (= i (count (get node :children))) true
                     (let [form (get forms (get ids i)) child (get nodes (get (get node :children) i))]
                       (if (p15-s23-typed-all [(= (get owner :form-id) (get form :parent-form-id))
                             (= (get child :source) (p15-s23-typed-source form))
                             (if (= i 0) (= (get form :value) (get (get child :attributes) :symbol)) true)])
                         (recur (+ i 1)) false))))]) false)
          (let [compiled (p15-s23-typed-compile-children context (get call :argument-node-ids) (- budget charge) [])]
            (if (p15-s23-compiler-complete? compiled)
              (assoc (p15-s23-compiler-result {:op :builtin-call :function (get descriptor :operation) :args (get compiled :value)})
                :work-count (+ charge (get compiled :work-count)))
              (assoc compiled :work-count (+ charge (get compiled :work-count 0)))))
          (assoc (p15-s23-typed-node-error (if (= :gravity.type/applied-vector-first (get (get (get context :types) (get call :operator-node-id)) :kind)) :unsupported-or-mismatched-typed-vector-first :unsupported-or-mismatched-typed-list-query) node) :work-count charge))))))
          ))))))
    (assoc (p15-s23-typed-node-error :unsupported-or-mismatched-typed-list-query {}) :work-count 0)))

(defn p15-s23-sc-binding? [binding module]
  (if (if (vector? (get binding :profile-set)) (vector? (get binding :target-set)) false)
  (p15-s23-typed-all
    [(= ['str :core :var 'gravity.core {:name 'gravity/core :version "bootstrap-contract-v1"} :gravity.type/core-var :safe]
        [(get binding :name) (get binding :binding-class) (get binding :kind) (get binding :namespace)
         (get binding :package) (get binding :type-ref) (get binding :safety)])
     (= [] (get binding :effects) (get binding :capabilities))
     (contains? (set (get binding :profile-set)) (get module :profile))
     (contains? (set (get binding :target-set)) :all)]) false))

(defn p15-s23-sc-source [core node call edge nodes bindings types module]
  (if (if (vector? (get call :argument-node-ids)) (vector? (get node :children)) false)
  (let [children (get node :children) operator (get nodes (get call :operator-node-id))
        bid (get call :operator-binding-id) binding (get bindings bid) args (get call :argument-node-ids)
        arguments (p15-s23-io-child-types args types)
        invoked? (loop [remaining arguments]
                   (if (= 0 (count remaining)) true
                     (if (= :gravity.type/never (first remaining)) false (recur (rest remaining)))))
        caller (loop [remaining (get core :function-records)]
                 (if (= 0 (count remaining)) nil
                   (if (= (get (first remaining) :function-syntax-id) (get (get node :evaluation) :owner-function-syntax-id))
                     (first remaining) (recur (rest remaining)))))
        expected-call {:core-node-id (get node :node-id) :operator-node-id (first children) :operator-binding-id bid
                       :argument-node-ids (vec (rest children)) :ordered-evaluation-node-ids children
                       :evaluation-order :operator-then-arguments :result-policy :call-result}
        expected-edge {:ordinal (get edge :ordinal) :call-core-node-id (get node :node-id)
                       :caller-function-syntax-id (get caller :function-syntax-id) :caller-function-core-node-id (get caller :function-core-node-id)
                       :callee-binding-id bid :callee-definition-syntax-id (get binding :definition-syntax-id)
                       :callee-function-syntax-id nil :callee-function-core-node-id nil :argument-core-node-ids args
                       :ordered-evaluation-node-ids children :evaluation-order :operator-then-arguments :classification :nonlocal-or-nonfunction}]
    (if (p15-s23-typed-all
          [(= :call (get node :core-form)) (= :reference (get operator :core-form))
           (= 2 (count args)) (= expected-call call) (= expected-edge edge) (p15-s23-sc-binding? binding module)
           (= [bid] (get node :resolved-binding-ids) (get operator :resolved-binding-ids))
           (= {:symbol (get (get operator :attributes) :symbol) :position :operator :binding-id bid :binding-class :core
               :definition-syntax-id (get binding :definition-syntax-id)} (get operator :attributes))
           (contains? '#{str gravity.core/str} (get (get operator :attributes) :symbol))
           (= :operator-then-arguments (get (get node :evaluation) :kind))
           (= (loop [i 0 out []] (if (= i (count children)) out
                (recur (+ i 1) (conj out {:index i :core-node-id (get children i)})))) (get (get node :evaluation) :order))
           (loop [remaining arguments]
             (if (= 0 (count remaining)) true
               (if (contains? #{:gravity.type/string :gravity.type/never} (first remaining))
                 (recur (rest remaining)) false)))
           (loop [remaining arguments]
             (if (= 0 (count remaining)) true
               (if (contains? #{nil :gravity.type/unknown} (first remaining)) false (recur (rest remaining)))))] )
      {:kind :gravity.type/applied-string-concat :version :sh08-string-concat-v1
       :operation 'str :semantic-owner 'gravity.text :intrinsic :gravity.text/binary-string-concat
       :resolution :gravity.core-compatibility :operator-node-id (get operator :node-id) :operator-binding-id bid
       :call-core-node-id (get node :node-id) :source (get node :source) :operator-source (get operator :source)
       :source-call call :source-edge edge :source-binding binding :argument-types arguments
       :concatenation-policy {:domain :binary-strings :order :left-then-right
                              :scalars :exact-sequence-concatenation :normalization :none :coercion :none
                              :formatting :none :operand-evaluation :once :allocation :normal-invocation-even-empty}
       :application (if invoked? :normal :not-invoked)
       :latent-effects [:memory/allocate] :direct-effects (if invoked? [:memory/allocate] []) :capabilities [] :thrown-error-effects []
       :profile (get module :profile) :target (get module :target)
       :invalidation [:calls :call-edges :binding-table :source-forms :type-table :lexical-bindings :definitions :function-records
                      :callee-body :string-operand-types :concatenation-policy :allocation-condition :profile :target :evaluation-order]} nil)) nil))

(defn p15-s23-sc-constraint [descriptor]
  {:constraint-id-request {:domain :gravity/sh08-string-concat-constraint-v1 :application descriptor}
   :kind :equality :producer-rule :sh08-string-concat-v1
   :lhs {:core-node-id (get descriptor :call-core-node-id) :projection :string-concat}
   :rhs (get descriptor :result-type) :dependencies descriptor :origin (get (get descriptor :source) :origin-chain)
   :solution {:result-type (get descriptor :result-type) :application (get descriptor :application)
              :direct-effects (get descriptor :direct-effects)}
   :invalidation (get descriptor :invalidation) :profile (get descriptor :profile) :target (get descriptor :target)
   :status :solved :diagnostics []})

(defn p15-s23-sc-call-fact [descriptor module]
  (let [source (get descriptor :source) edge (get descriptor :source-edge)]
    {:artifact :gravity/c7-call-type-fact
     :fact-id-request {:domain :gravity/sh08-string-concat-call-type-fact-v1 :application descriptor}
     :call-core-node-id (get descriptor :call-core-node-id) :caller-function-syntax-id (get edge :caller-function-syntax-id)
     :callee-function-syntax-id nil :argument-types (get descriptor :argument-types) :result-type (get descriptor :result-type)
     :evaluation-order :operator-then-arguments :source-span (get source :semantic-span) :syntax-id (get source :syntax-id)
     :origin-chain (get source :origin-chain) :generated-origin (get source :generated-origin)
     :profile (get module :profile) :target (get module :target) :effects (get descriptor :direct-effects) :capabilities [] :status :inferred
     :dispatch :direct-string-concat :applied-string-concat descriptor :effect-facts-source :audited-text-intrinsic}))


(defn p15-s23-sc-finish [header]
  (let [type (if (= :normal (get header :application)) :gravity.type/string :gravity.type/never)]
    (assoc header :parameter-types (get header :argument-types) :return type :result-type type)))

(defn p15-s23-typed-compile-string-concat [context node budget]
  (let [id (get node :node-id) core (get context :core)
        charge (+ 66 (count (get core :function-records)))]
    (if (< budget charge) (p15-s23-typed-node-error :typed-lowering-work-limit node)
      (let [call (get (get context :calls) id) edge (get (get context :edges) id)
            forms (get context :forms) nodes (get context :nodes)
            owner (get forms (get (get node :source) :form-id)) ids (get owner :child-form-ids)
            header (p15-s23-sc-source core node call edge nodes (get context :bindings) (get context :types) (get core :module))
            descriptor (if (map? header) (p15-s23-sc-finish header) nil)
            rows (loop [remaining (get context :ledger) out []]
                   (if (= 0 (count remaining)) out
                     (let [row (first remaining)]
                       (recur (rest remaining)
                         (if (if (= :sh08-string-concat-v1 (get row :producer-rule))
                               (= {:core-node-id id :projection :string-concat} (get row :lhs)) false) (conj out row) out)))))]
        (if (if (map? descriptor)
              (p15-s23-typed-all
                [(= descriptor (get (get context :types) (get call :operator-node-id)))
                 (= (get descriptor :result-type) (get (get context :types) id))
                 (= (get edge :ordinal) (get (get context :call-order) id))
                 (= (get (get context :current-function) :function-syntax-id) (get edge :caller-function-syntax-id))
                 (= [(p15-s23-sc-constraint descriptor)] rows)
                 (= (p15-s23-sc-call-fact descriptor (get core :module)) (get (get context :call-facts) id))
                 (= :list (get owner :kind)) (vector? ids) (= 3 (if (vector? ids) (count ids) 0) (count (get node :children)))
                 (= (get node :source) (p15-s23-typed-source owner))
                 (= {:operator-child-index 0 :argument-count 2 :argument-child-indexes [1 2]
                     :evaluation-order :operator-then-arguments :dispatch :resolved-symbol-call} (get node :attributes))
                 (loop [i 0]
                   (if (= i 3) true
                     (let [form (get forms (get ids i)) child (get nodes (get (get node :children) i))]
                       (if (p15-s23-typed-all [(= (get owner :form-id) (get form :parent-form-id))
                             (= (get child :source) (p15-s23-typed-source form))
                             (if (= i 0) (= (get form :value) (get (get child :attributes) :symbol)) true)])
                         (recur (+ i 1)) false))))]) false)
          (let [compiled (p15-s23-typed-compile-children context (get call :argument-node-ids) (- budget charge) [])]
            (if (p15-s23-compiler-complete? compiled)
              (assoc (p15-s23-compiler-result {:op :builtin-call :function 'str :args (get compiled :value)})
                :work-count (+ charge (get compiled :work-count))) compiled))
          (p15-s23-typed-node-error :unsupported-or-mismatched-typed-string-concat node))))))

(defn p15-s23-mg-member-count [type]
  (if (if (map? type) (vector? (get type :member-types)) false) (count (get type :member-types)) 0))

(defn p15-s23-mg-normal-known? [type]
  (if (keyword? type)
    (= false (contains? #{:gravity.type/unknown :gravity.type/never} type))
    (if (map? type) (keyword? (get type :kind)) false)))

(defn p15-s23-mg-map-valid? [type]
  (if (= :gravity.type/map type) true
    (if (if (map? type) (= :gravity.type/map (get type :kind)) false)
      (let [members (get type :member-types)]
        (if (if (vector? members) (<= (count members) 1024) false)
          (loop [i 0]
            (if (= i (count members)) true
              (if (< (+ i 1) (count members))
                (if (if (if (keyword? (get members i)) (contains? #{:gravity.type/nil :gravity.type/bool :gravity.type/integer :gravity.type/decimal :gravity.type/ratio
                                    :gravity.type/character :gravity.type/string :gravity.type/symbol :gravity.type/keyword
                                    :gravity.type/i8 :gravity.type/i16 :gravity.type/i32 :gravity.type/i64
                                    :gravity.type/u8 :gravity.type/u16 :gravity.type/u32 :gravity.type/u64 :gravity.type/f32 :gravity.type/f64}
                                  (get members i)) false)
                        (p15-s23-mg-normal-known? (get members (+ i 1))) false)
                  (recur (+ i 2)) false) false))) false)) false)))

(defn p15-s23-mg-operands? [arguments invoked?]
  (let [map-type (get arguments 0) key-type (get arguments 1) default-type (get arguments 2)]
    (if (if (if (= :gravity.type/never map-type) true (p15-s23-mg-map-valid? map-type))
          (if (contains? #{:gravity.type/string :gravity.type/keyword :gravity.type/never} key-type)
            (if (= :gravity.type/never default-type) true (p15-s23-mg-normal-known? default-type)) false) false)
      (if invoked?
        (if (map? map-type)
          (let [members (get map-type :member-types)]
            (loop [i 0]
              (if (= i (count members)) true
                (if (if (= key-type (get members i)) (= default-type (get members (+ i 1))) true)
                  (recur (+ i 2)) false)))) false)
        true) false)))

(defn p15-s23-mg-present-operands? [arguments args nodes]
  (let [map-type (get arguments 0) key-type (get arguments 1) key-node (get nodes (get args 1))
        normal? (if (= :gravity.type/never map-type) false (= false (= :gravity.type/never key-type)))]
    (if (if (= :gravity.type/never map-type) true (p15-s23-mg-map-valid? map-type))
      (if (if (= :gravity.type/never key-type) true
            (p15-s23-typed-all [(= :gravity.type/keyword key-type) (= :literal (get key-node :core-form))
                  (= [] (get key-node :children)) (= :keyword (get (get key-node :attributes) :literal-kind))
                  (keyword? (get (get key-node :attributes) :value))]))
        (if normal? (if (map? map-type) (= :gravity.type/map (get map-type :kind)) false) true) false) false)))

(defn p15-s23-mg-present-header [header nodes]
  (let [args (get (get header :source-call) :argument-node-ids) key-node (get nodes (get args 1))]
    (assoc header :version :sh08-map-get-present-v1 :intrinsic :gravity.collections/map-lookup-present
      :key-node-id (get args 1) :key (if (= :gravity.type/never (get (get header :argument-types) 1)) nil
                                   (get (get key-node :attributes) :value))
      :lookup-policy {:input :established-finite-map :keys [:literal-keyword] :key-equality :value
                      :presence :proven-present :default :none :normalization :none :coercion :none
                      :operand-evaluation :map-then-key-once :result :selected-stored-type}
      :invalidation (conj (get header :invalidation) :actual-key :finite-map-shape :selected-part))))

(defn p15-s23-mg-present-selection [header input]
  ; C7 owns the source-derived shape. Each consumer joins its actual key,
  ; finite coordinates and selected type without inferring presence from types.
  (let [parts (get input :parts) type (get (get header :argument-types) 0) members (get type :member-types)]
    (if (if (= :normal (get header :application))
          (if (vector? parts) (if (<= (count parts) 512)
            (p15-s23-typed-all [(= :accepted (get input :status)) (= :map (get input :shape-kind))
                  (= type (get input :type)) (vector? members) (= (* 2 (count parts)) (count members))]) false) false) false)
      (loop [index 0 seen #{} selected nil]
        (if (= index (count parts)) selected
          (let [part (get parts index) key (get part :key) shape (get part :shape)]
            (if (p15-s23-typed-all [(keyword? key) (= false (contains? seen key)) (= (+ 1 (* 2 index)) (get part :coordinate))
                      (= :gravity.type/keyword (get members (* 2 index)))
                      (= :accepted (get shape :status)) (p15-s23-mg-normal-known? (get shape :type))
                      (= (get shape :type) (get members (+ 1 (* 2 index))))])
              (recur (+ index 1) (conj seen key) (if (= key (get header :key)) part selected)) nil)))) nil)))

(defn p15-s23-mg-present-finish [header input]
  (let [normal? (= :normal (get header :application)) part (if normal? (p15-s23-mg-present-selection header input) nil)
        type (if normal? (get (get part :shape) :type) :gravity.type/never)]
    (if (if normal? (map? part) (= input nil))
      (assoc header :parameter-types (get header :argument-types) :return type :result-type type
        :presence-proof (if normal?
                          {:kind :finite-map-key-presence :key (get header :key)
                           :operand-node-id (get (get (get header :source-call) :argument-node-ids) 0)
                           :operand-type (get (get header :argument-types) 0) :operand-shape input
                           :selected-part part :selected-coordinate (get part :coordinate) :selected-type type} nil)) nil)))

(defn p15-s23-pe-work [core]
  ; Reserve every global row before measuring selected entries or field widths.
  (+ 64 (* 8 (+ (count (get core :nodes)) (count (get core :definitions)) (count (get core :function-records))
                 (count (get core :reference-uses)) (count (get (get core :preserved-resolution) :resolution-table)) (count (get core :calls))
                 (count (get core :call-edges)) (count (get core :var-references)) (count (get core :mutations))
                 (count (get core :recur-targets)) (count (get core :recur-transfers)) (count (get core :recursion-components))
                 (count (get (get core :module) :exports))))))

(defn p15-s23-pe-reserve [core receiver nodes bindings budget]
  (let [base (p15-s23-pe-work core)
        failure {:status :rejected :reason :map-get-work-limit :work-count base}]
    (if (> base budget) failure
      (if (= false
             (loop [families [(get core :nodes) (get core :definitions) (get core :function-records)
                              (get core :reference-uses) (get (get core :preserved-resolution) :resolution-table) (get core :calls)
                              (get core :call-edges) (get core :var-references) (get core :mutations)
                              (get core :recur-targets) (get core :recur-transfers) (get core :recursion-components)
                              (get (get core :module) :exports)]]
               (if (= 0 (count families)) true
                 (if (vector? (first families)) (recur (rest families)) false))))
        (assoc failure :reason :map-get-entry-families-required)
        (let [record (p15-s23-pe-one (get core :function-records) :function-syntax-id
                       (get (get receiver :evaluation) :owner-function-syntax-id))
              parameters (get record :parameter-binding-ids)
              binding (get bindings (get record :definition-binding-id))
              ids (loop [remaining (get core :nodes) width 0]
                    (if (= 0 (count remaining)) width
                      (let [values (get (first remaining) :resolved-binding-ids)]
                        (if (vector? values) (recur (rest remaining) (+ width (count values))) nil))))
              targets (loop [remaining (get core :recur-targets) maximum 0]
                        (if (= 0 (count remaining)) maximum
                          (let [values (get (first remaining) :binding-ids)]
                            (if (vector? values)
                              (recur (rest remaining) (if (< maximum (count values)) (count values) maximum)) nil))))
              components (loop [remaining (get core :recursion-components) width 0]
                           (if (= 0 (count remaining)) width
                             (let [values (get (first remaining) :function-syntax-ids)]
                               (if (vector? values) (recur (rest remaining) (+ width (count values))) nil))))
              exports (loop [remaining (get (get core :module) :exports) width 0]
                        (if (= 0 (count remaining)) width
                          (if (symbol? (first remaining))
                            (recur (rest remaining) (+ width (count (str (first remaining))))) nil)))
              entries (loop [remaining (get core :calls) matched 0 arguments 0 children 0]
                        (if (= 0 (count remaining))
                          {:matched matched :arguments arguments :children children}
                          (let [call (first remaining)]
                            (if (= (get record :definition-binding-id) (get call :operator-binding-id))
                              (let [args (get call :argument-node-ids) order (get call :ordered-evaluation-node-ids)
                                    child-ids (get (get nodes (get call :core-node-id)) :children)]
                                (if (if (vector? args) (if (vector? order) (vector? child-ids) false) false)
                                  (recur (rest remaining) (+ matched 1) (+ arguments (count args))
                                         (+ children (count child-ids) (count order))) nil))
                              (recur (rest remaining) matched arguments children)))))]
          (if (p15-s23-typed-all [(integer? ids) (integer? targets) (integer? components) (integer? exports)
                    (map? entries) (vector? parameters)])
            (let [name-width (count (str (get binding :name))) namespace-width (count (str (get binding :namespace)))
                  ; Each entry's only row searches are uses, resolutions, edges,
                  ; and caller records. Source/header checks cost 64 units.
                  work (+ base
                          (* (get entries :matched)
                             (+ 64 (* 2 (+ (count (get core :reference-uses)) (count (get (get core :preserved-resolution) :resolution-table))
                                            (count (get core :call-edges)) (count (get core :function-records))))))
                          (* 4 (get entries :children)) (* 5 (get entries :arguments))
                          (* 2 ids) (* 2 components) (count parameters)
                          (* (count (get core :recur-transfers)) (+ 8 (* 2 (count (get core :recur-targets))) targets))
                          (* 3 exports) (* (count (get (get core :module) :exports)) (+ (* 2 name-width) namespace-width 1))
                          (* 2 (+ name-width namespace-width)))]
              (if (> work budget) (assoc failure :work-count work)
                {:status :accepted :work-count work :matched-call-count (get entries :matched)}))
            (assoc failure :reason :map-get-entry-families-required)))))))

(defn p15-s23-pe-select [records key value]
  (loop [remaining records out []]
    (if (= 0 (count remaining)) out
      (recur (rest remaining) (if (= value (get (first remaining) key)) (conj out (first remaining)) out)))))

(defn p15-s23-pe-one [records key value]
  (let [matches (p15-s23-pe-select records key value)]
    (if (= 1 (count matches)) (first matches) nil)))

(defn p15-s23-pe-recursive? [core id]
  (loop [remaining (get core :recursion-components)]
    (if (= 0 (count remaining)) false
      (if (contains? (set (get (first remaining) :function-syntax-ids)) id) true (recur (rest remaining))))))

(defn p15-s23-pe-reentry? [core record]
  (let [parameters (set (get record :parameter-binding-ids)) fid (get record :function-core-node-id)]
    (loop [remaining (get core :recur-transfers)]
      (if (= 0 (count remaining)) false
        (let [transfer (first remaining) target (p15-s23-pe-one (get core :recur-targets) :target-id (get transfer :target-id))]
          (if (if (= target nil) true
                (if (= fid (get target :owner-core-node-id)) true
                (loop [ids (get target :binding-ids)]
                  (if (= 0 (count ids)) false
                    (if (contains? parameters (first ids)) true (recur (rest ids)))))))
            true (recur (rest remaining))))))))

(defn p15-s23-pe-census [header core nodes bindings forms]
  ; Presence belongs to a closed parameter entry set, never a common Map shape.
  (let [receiver (get nodes (get (get (get header :source-call) :argument-node-ids) 0))
        pid (get (get receiver :attributes) :binding-id)
        parameter (get bindings pid)
        record (p15-s23-pe-one (get core :function-records) :function-syntax-id
                 (get (get receiver :evaluation) :owner-function-syntax-id))
        params (get record :parameter-binding-ids) bid (get record :definition-binding-id)
        binding (get bindings bid) definition (p15-s23-pe-one (get core :definitions) :binding-id bid)
        fn-node (get nodes (get record :function-core-node-id))
        def-node (get nodes (get definition :core-node-id))
        def-form (get forms (get (get def-node :source) :form-id))
        name-form (get forms (get (get def-form :child-form-ids) 1))
        fn-form (get forms (get record :function-form-id))
        exports (get (get core :module) :exports)
        uses (p15-s23-pe-select (get core :reference-uses) :binding-id bid)
        resolutions (p15-s23-pe-select (get (get core :preserved-resolution) :resolution-table) :binding-id bid)
        references (loop [remaining (get core :nodes) out []]
                     (if (= 0 (count remaining)) out
                       (let [node (first remaining)]
                         (recur (rest remaining)
                           (if (if (= :reference (get node :core-form))
                                 (if (= bid (get (get node :attributes) :binding-id)) true
                                   (contains? (set (get node :resolved-binding-ids)) bid)) false)
                             (conj out node) out)))))
        calls (p15-s23-pe-select (get core :calls) :operator-binding-id bid)
        edges (loop [remaining (get core :call-edges) out []]
                (if (= 0 (count remaining)) out
                  (let [edge (first remaining)]
                    (recur (rest remaining)
                      (if (if (= bid (get edge :callee-binding-id)) true
                            (= (get record :function-syntax-id) (get edge :callee-function-syntax-id)))
                        (conj out edge) out)))))
        index (loop [i 0 found nil]
                (if (= i (count params)) found
                  (recur (+ i 1) (if (= pid (get params i)) (if (= found nil) i -1) found))))]
    (if (p15-s23-typed-all [(= :normal (get header :application)) (map? record) (map? definition) (integer? index)
          (if (integer? index) (<= 0 index) false) (vector? params)
          (= :reference (get receiver :core-form)) (= [] (get receiver :children))
          (= [pid] (get receiver :resolved-binding-ids))
          (= :expression (get (get receiver :attributes) :position))
          (= :lexical (get parameter :binding-class) (get (get receiver :attributes) :binding-class))
          (= :local (get parameter :kind))
          (= :named-top-level (get record :definition-kind))
          (= :function (get binding :kind)) (= :namespace (get binding :binding-class))
          (= :private (get binding :visibility) (get (get def-node :attributes) :visibility))
          (= (get (get core :module) :namespace) (get binding :namespace))
          (= (get binding :name) (get definition :name) (get record :definition-name) (get name-form :value))
          (= (get binding :definition-syntax-id) (get (get def-node :attributes) :name-syntax-id) (get name-form :syntax-id))
          (= :def (get def-node :core-form)) (= :fn (get fn-node :core-form))
          (= (get record :definition-core-node-id) (get definition :core-node-id) (get def-node :node-id))
          (= [(get fn-node :node-id)] (get def-node :children))
          (= [bid] (get def-node :resolved-binding-ids))
          (= (get record :function-core-node-id) (get definition :value-node-id) (get fn-node :node-id))
          (= [(get record :body-core-node-id)] (get fn-node :children))
          (= params (get fn-node :resolved-binding-ids))
          (= (count params) (get record :fixed-arity))
          (= (get record :function-syntax-id) (get fn-form :syntax-id) (get (get fn-node :source) :syntax-id))
          (= (get record :function-form-id) (get fn-form :form-id) (get (get def-form :child-form-ids) 2))
          (vector? exports)
          (loop [remaining exports]
            (if (= 0 (count remaining)) true
              (if (if (= (str (first remaining)) (str (get binding :name))) true
                    (= (str (first remaining)) (str (get binding :namespace) "/" (get binding :name))))
                false (recur (rest remaining)))))
          (= false (p15-s23-pe-recursive? core (get record :function-syntax-id)))
          (= false (p15-s23-pe-reentry? core record))
          (= 0 (count (p15-s23-pe-select (get core :var-references) :binding-id bid)))
          (= 0 (count (p15-s23-pe-select (get core :mutations) :target-binding-id bid))
               (count (p15-s23-pe-select (get core :mutations) :target-binding-id pid)))
          (< 0 (count calls)) (= (count calls) (count edges) (count uses) (count resolutions) (count references))
          (loop [remaining calls seen #{}]
            (if (= 0 (count remaining)) true
              (let [call (first remaining) id (get call :core-node-id) node (get nodes id)
                    children (get node :children) op (get nodes (get call :operator-node-id))
                    source (get op :source) form (get forms (get source :form-id))
                    owner (get forms (get (get node :source) :form-id))
                    use (p15-s23-pe-one uses :core-node-id (get op :node-id))
                    resolution (p15-s23-pe-one resolutions :reference-syntax-id (get source :syntax-id))
                    edge (p15-s23-pe-one edges :call-core-node-id id)
                    caller (p15-s23-pe-one (get core :function-records) :function-syntax-id (get edge :caller-function-syntax-id))]
                (if (p15-s23-typed-all [(= false (contains? seen (get op :node-id))) (map? caller)
                      (= :call (get node :core-form)) (= :reference (get op :core-form)) (= [] (get op :children))
                      (= [bid] (get node :resolved-binding-ids) (get op :resolved-binding-ids))
                      (= {:symbol (get form :value) :position :operator :binding-id bid :binding-class :namespace
                          :definition-syntax-id (get binding :definition-syntax-id)} (get op :attributes))
                      (= :symbol (get form :kind))
                      (= {:core-node-id (get op :node-id) :form-id (get source :form-id) :syntax-id (get source :syntax-id)
                          :symbol (get form :value) :position :operator :binding-id bid :binding-class :namespace
                          :definition-syntax-id (get binding :definition-syntax-id)} use)
                      (= {:reference-syntax-id (get source :syntax-id) :symbol (get form :value) :position :operator
                          :binding-id bid :upstream-binding-id (get binding :upstream-binding-id)
                          :resolution-order (get resolution :resolution-order) :source-span (get form :source-span)} resolution)
                      (= {:core-node-id id :operator-node-id (first children) :operator-binding-id bid
                          :argument-node-ids (vec (rest children)) :ordered-evaluation-node-ids children
                          :evaluation-order :operator-then-arguments :result-policy :call-result} call)
                      (= {:ordinal (get edge :ordinal) :call-core-node-id id
                          :caller-function-syntax-id (get caller :function-syntax-id)
                          :caller-function-core-node-id (get caller :function-core-node-id)
                          :callee-binding-id bid :callee-definition-syntax-id (get binding :definition-syntax-id)
                          :callee-function-syntax-id (get record :function-syntax-id)
                          :callee-function-core-node-id (get record :function-core-node-id)
                          :argument-core-node-ids (get call :argument-node-ids) :ordered-evaluation-node-ids children
                          :evaluation-order :operator-then-arguments :classification :local-function} edge)
                      (= (get caller :function-syntax-id) (get (get node :evaluation) :owner-function-syntax-id))
                      (= :operator-then-arguments (get (get node :evaluation) :kind))
                      (= (get record :fixed-arity) (count (get call :argument-node-ids)))
                      (= :list (get owner :kind)) (= (count children) (count (get owner :child-form-ids)))
                      (loop [i 0]
                        (if (= i (count children)) true
                          (let [child (get nodes (get children i)) child-form (get forms (get (get owner :child-form-ids) i))]
                            (if (p15-s23-typed-all [(= (get owner :form-id) (get child-form :parent-form-id))
                                  (= (get child :source) (p15-s23-typed-source child-form))
                                  (= {:index i :core-node-id (get child :node-id)} (get (get (get node :evaluation) :order) i))])
                              (recur (+ i 1)) false))))])
                  (recur (rest remaining) (conj seen (get op :node-id))) false))))])
      {:kind :closed-private-parameter-entry :receiver-node-id (get receiver :node-id) :receiver-source (get receiver :source)
       :parameter-index index :parameter-binding parameter :function-record record :definition definition
       :definition-binding binding :exports exports :reference-uses uses :resolutions resolutions :calls calls :edges edges}
      nil)))

(defn p15-s23-pe-invoked? [types arguments]
  (loop [remaining arguments]
    (if (= 0 (count remaining)) true
      (if (= :gravity.type/never (get types (first remaining))) false (recur (rest remaining))))))

(defn p15-s23-pe-vector-root? [type]
  (if (map? type)
    (if (= 3 (count type))
      (if (loop [fields (keys type)]
            (if (= 0 (count fields)) true
              (if (keyword? (first fields)) (recur (rest fields)) false)))
        (if (= #{:kind :shape :element-types} (set (keys type)))
          (if (= :gravity.type/vector (get type :kind))
            (if (= :literal (get type :shape)) (vector? (get type :element-types)) false) false) false) false) false) false))

(defn p15-s23-pe-validate-selected [header census shapes types private-root?]
  ; Validate every selected Vector candidate before deep equality or finish.
  (loop [remaining (get census :calls) inputs shapes]
    (if (= 0 (count remaining))
      (if (= 0 (count inputs)) {:status :accepted}
        {:status :rejected :reason :map-get-private-entry-presence-required})
      (if (= 0 (count inputs)) {:status :rejected :reason :map-get-private-entry-presence-required}
        (let [call (first remaining) args (get call :argument-node-ids) shape (first inputs)
              ids? (if (vector? args)
                     (loop [ids args]
                       (if (= 0 (count ids)) true
                         (let [id (first ids)]
                           (if (if (keyword? id) true (if (string? id) (= 71 (count id)) false))
                             (recur (rest ids)) false)))) false)]
          (if (= false ids?) {:status :rejected :reason :map-get-private-entry-presence-required}
            (let [invoked? (p15-s23-pe-invoked? types args)
                  candidate (if invoked?
                    (let [parts (get shape :parts)
                          actual (get types (get args (get census :parameter-index)))
                          members (get actual :member-types) supplied-members (get (get shape :type) :member-types)]
                      (if (if (vector? parts) (if (<= (count parts) 512) (if (vector? members) (vector? supplied-members) false) false) false)
                        (loop [i 0 seen #{} selected nil]
                          (if (= i (count parts)) {:status :accepted :types selected}
                            (let [part (get parts i) key (get part :key) coordinate (+ 1 (* 2 i))]
                              (if (keyword? key)
                                (if (contains? seen key) {:status :rejected}
                                  (if (= coordinate (get part :coordinate))
                                    (recur (+ i 1) (conj seen key)
                                      (if (= key (get header :key))
                                        [(get (get part :shape) :type) (get members coordinate) (get supplied-members coordinate)] selected))
                                    {:status :rejected})) {:status :rejected})))) {:status :rejected}))
                    {:status :not-invoked})
                  checked (if (= :accepted (get candidate :status))
                            (let [selected (get candidate :types)]
                              (if (vector? selected)
                                (loop [pending selected]
                                  (if (= 0 (count pending)) {:status :accepted}
                                    (let [type (first pending)]
                                      (if (p15-s23-pe-vector-root? type)
                                        (let [walked (p15-s23-lc-validate-types [type])]
                                          (if (= :accepted (get walked :status)) (recur (rest pending))
                                            {:status :rejected :reason :map-get-private-entry-selected-type-required}))
                                        (if (if (= false private-root?) true
                                            (if (keyword? type)
                                              (contains? #{:gravity.type/nil :gravity.type/bool :gravity.type/integer :gravity.type/decimal :gravity.type/ratio
                                                           :gravity.type/character :gravity.type/string :gravity.type/symbol :gravity.type/keyword
                                                           :gravity.type/i8 :gravity.type/i16 :gravity.type/i32 :gravity.type/i64
                                                           :gravity.type/u8 :gravity.type/u16 :gravity.type/u32 :gravity.type/u64 :gravity.type/f32 :gravity.type/f64} type) false))
                                          (recur (rest pending))
                                          {:status :rejected :reason :map-get-private-entry-selected-type-required})))))
                                {:status :rejected :reason :map-get-private-entry-presence-required}))
                            (if (= :not-invoked (get candidate :status)) {:status :accepted}
                              {:status :rejected :reason :map-get-private-entry-presence-required}))]
              (if (= :accepted (get checked :status))
                (recur (rest remaining) (rest inputs)) checked))))))))

(defn p15-s23-pe-finish [header census shapes core nodes types]
  (if (map? census)
    (loop [remaining (get census :calls) inputs shapes entries [] selected nil normal-count 0]
      (if (= 0 (count remaining))
        (if (if (= 0 (count inputs)) (< 0 normal-count) false)
          (assoc header :version :sh08-map-get-private-entry-v1
            :lookup-policy (assoc (get header :lookup-policy) :input :closed-private-parameter-entries)
            :invalidation (conj (get header :invalidation) :visibility :exports :reference-uses :resolution-table
                            :var-references :mutations :recur-targets :recur-transfers :incoming-arguments)
            :parameter-types (get header :argument-types) :return selected :result-type selected
            :presence-proof {:kind :private-call-entry-key-presence :key (get header :key)
                             :entry-census census :entries entries :selected-type selected}) nil)
        (let [call (first remaining) args (get call :argument-node-ids)
              argument-id (get args (get census :parameter-index))
              argument-type (get types argument-id) invoked? (p15-s23-pe-invoked? types args)
              shape (first inputs)
              part (if (if invoked? (= argument-type (get (get header :argument-types) 0)) false) (p15-s23-mg-present-selection
                                  (assoc header :argument-types [argument-type :gravity.type/keyword]) shape) nil)
              value-type (get (get part :shape) :type)]
          (if (p15-s23-typed-all [(< 0 (count inputs))
                (loop [ids args] (if (= 0 (count ids)) true
                  (if (contains? #{nil :gravity.type/unknown} (get types (first ids))) false (recur (rest ids)))))
                (if invoked?
                  (p15-s23-typed-all [(map? part)
                    (if (p15-s23-pe-vector-root? value-type) true
                    (if (keyword? value-type) (contains? #{:gravity.type/nil :gravity.type/bool :gravity.type/integer :gravity.type/decimal :gravity.type/ratio
                                 :gravity.type/character :gravity.type/string :gravity.type/symbol :gravity.type/keyword
                                 :gravity.type/i8 :gravity.type/i16 :gravity.type/i32 :gravity.type/i64
                                 :gravity.type/u8 :gravity.type/u16 :gravity.type/u32 :gravity.type/u64 :gravity.type/f32 :gravity.type/f64} value-type) false))
                    (if (= normal-count 0) true (= selected value-type))])
                  (= shape nil))])
            (recur (rest remaining) (rest inputs)
              (conj entries {:call-core-node-id (get call :core-node-id) :argument-node-id argument-id
                            :argument-source (get (get nodes argument-id) :source) :argument-type argument-type
                            :argument-types (loop [ids args out []] (if (= 0 (count ids)) out
                                              (recur (rest ids) (conj out (get types (first ids))))))
                            :entry (if invoked? :invoked :not-invoked) :argument-shape shape
                            :selected-part part :selected-coordinate (get part :coordinate) :selected-type value-type})
              (if invoked? value-type selected) (if invoked? (+ normal-count 1) normal-count)) nil)))) nil))

(defn p15-s23-pe-check [header descriptor core nodes bindings forms types]
  ; Reconstruct the census and validate selected types before finishing.
  ; Return semantic status and the freshly derived descriptor.
  (let [census (p15-s23-pe-census header core nodes bindings forms)
        entries (get (get descriptor :presence-proof) :entries)]
    (if (if (map? census) (if (vector? entries) (= (count entries) (count (get census :calls))) false) false)
      (let [shapes (loop [remaining entries out []]
                     (if (= 0 (count remaining)) out
                       (recur (rest remaining) (conj out (get (first remaining) :argument-shape)))))
            checked (p15-s23-pe-validate-selected header census shapes types true)
            expected (if (= :accepted (get checked :status)) (p15-s23-pe-finish header census shapes core nodes types) nil)]
        (if (map? expected) (assoc checked :descriptor expected)
          (if (= :rejected (get checked :status)) checked
            {:status :rejected :reason :map-get-private-entry-presence-required})))
      {:status :rejected :reason :map-get-private-entry-presence-required})))

(defn p15-s23-pe-recheck [header descriptor core nodes bindings forms types]
  (let [census (p15-s23-pe-census header core nodes bindings forms)
        entries (get (get descriptor :presence-proof) :entries)]
    (if (if (map? census) (if (vector? entries) (= (count entries) (count (get census :calls))) false) false)
      (let [shapes (loop [remaining entries out []]
                     (if (= 0 (count remaining)) out
                       (recur (rest remaining) (conj out (get (first remaining) :argument-shape)))))]
        (p15-s23-pe-finish header census shapes core nodes types)) nil)))

(defn p15-s23-pc-id? [id]
  (if (keyword? id) true (if (string? id) (= 71 (count id)) false)))

(defn p15-s23-pc-current-node [id nodes]
  (if (p15-s23-pc-id? id)
    (let [node (get nodes id)] (if (map? node) (if (= id (get node :node-id)) node nil) nil)) nil))

(defn p15-s23-pc-even-count? [values]
  (if (vector? values)
    (if (<= (count values) 1024)
      (loop [remaining values]
        (if (= 0 (count remaining)) true
          (if (= 1 (count remaining)) false (recur (rest (rest remaining)))))) false) false))

(defn p15-s23-pc-link-core? [record node core nodes bindings]
  (let [bid (get record :binding-id) owner-id (get record :let-core-node-id)
        initializer-id (get record :initializer-node-id) index (get record :ordinal)]
    (if (if (p15-s23-pc-id? bid) (if (p15-s23-pc-id? owner-id)
          (if (p15-s23-pc-id? initializer-id) (if (integer? index) (<= 0 index) false) false) false) false)
      (let [owner (p15-s23-pc-current-node owner-id nodes) initializer (p15-s23-pc-current-node initializer-id nodes)
            binding (get bindings bid) children (get owner :children) ids (get owner :resolved-binding-ids)
            attrs (get node :attributes) source (get initializer :source)]
        (if (if (map? owner) (if (map? initializer) (if (map? binding)
              (if (vector? children) (if (vector? ids)
                (if (<= (count children) 1024) (if (<= (count ids) 1024)
                  (if (< index (count children)) (< index (count ids)) false) false) false) false) false) false) false) false)
          (if (if (symbol? (get record :name)) (if (symbol? (get binding :name)) (symbol? (get attrs :symbol)) false) false)
            (if (loop [remaining [(get record :definition-syntax-id) (get binding :definition-syntax-id)
                                 (get record :binding-scope-id) (get binding :scope-id)
                                 (get record :initializer-form-id) (get source :form-id)
                                 (get record :initializer-syntax-id) (get source :syntax-id)
                                 (get (get node :evaluation) :owner-function-syntax-id)
                                 (get (get initializer :evaluation) :owner-function-syntax-id)]]
                  (if (= 0 (count remaining)) true
                    (if (p15-s23-pc-id? (first remaining)) (recur (rest remaining)) false)))
              (p15-s23-typed-all
                [(= :immutable (get record :mutability)) (= :let (get owner :core-form))
                 (= :reference (get node :core-form))
                 (if (vector? (get node :children)) (= 0 (count (get node :children))) false)
                 (if (vector? (get node :resolved-binding-ids)) (= [bid] (get node :resolved-binding-ids)) false)
                 (= bid (get attrs :binding-id)) (= :lexical (get attrs :binding-class) (get binding :binding-class))
                 (if (= nil (get binding :mutability)) true (= :immutable (get binding :mutability)))
                 (= initializer-id (get children index)) (= bid (get ids index))
                 (= (get record :definition-syntax-id) (get binding :definition-syntax-id))
                 (= (get record :name) (get binding :name) (get attrs :symbol))
                 (= (get record :binding-scope-id) (get binding :scope-id))
                 (= (get record :initializer-form-id) (get source :form-id))
                 (= (get record :initializer-syntax-id) (get source :syntax-id))
                 (= (get (get node :evaluation) :owner-function-syntax-id)
                    (get (get initializer :evaluation) :owner-function-syntax-id))
                 (loop [remaining (get core :mutations)]
                   (if (= 0 (count remaining)) true
                     (if (= bid (get (first remaining) :target-binding-id)) false (recur (rest remaining)))))]) false) false) false)) false)))

(defn p15-s23-pc-unroll [id core nodes bindings budget]
  (loop [current id links [] seen #{} used 0]
    (if (= false (p15-s23-pc-id? current))
      {:status :rejected :reason :map-get-source-mismatch :work-count used}
      (if (contains? seen current)
        {:status :rejected :reason :map-get-source-mismatch :work-count used}
        (let [prefix (+ used 32)]
          (if (> prefix budget) {:status :rejected :reason :map-get-work-limit :work-count prefix}
            (let [node (p15-s23-pc-current-node current nodes)]
              (if (map? node)
                (let [locals (get core :lexical-bindings) mutations (get core :mutations)
                      work (+ prefix (if (= :reference (get node :core-form))
                                       (+ (* 2 (if (vector? locals) (count locals) 0))
                                          (if (vector? mutations) (count mutations) 0)) 0))]
                  (if (> work budget) {:status :rejected :reason :map-get-work-limit :work-count work}
                    (if (= :reference (get node :core-form))
                      (if (if (vector? locals) (vector? mutations) false)
                        (let [bid (get (get node :attributes) :binding-id)
                              record (if (p15-s23-pc-id? bid) (p15-s23-pe-one locals :binding-id bid) nil)
                              initializer (p15-s23-pc-current-node (get record :initializer-node-id) nodes)
                              binding (if (p15-s23-pc-id? bid) (get bindings bid) nil)
                              measured (p15-s23-pc-evidence-work
                                         {:record-name (get record :name) :binding-name (get binding :name)
                                          :reference-name (get (get node :attributes) :symbol)
                                          :definition (get record :definition-syntax-id) :binding-definition (get binding :definition-syntax-id)
                                          :record-scope (get record :binding-scope-id) :binding-scope (get binding :scope-id)
                                          :initializer-source (get initializer :source)} (- budget work))
                              total (+ work (get measured :work-count))]
                          (if (= :accepted (get measured :status))
                            (if (if (map? record) (p15-s23-pc-link-core? record node core nodes bindings) false)
                              (recur (get record :initializer-node-id)
                                (conj links {:reference-core-node-id current :reference-source (get node :source)
                                             :binding-record record}) (conj seen current) total)
                              {:status :rejected :reason :map-get-source-mismatch :work-count total})
                            (assoc measured :work-count total)))
                        {:status :rejected :reason :map-get-source-mismatch :work-count work})
                      {:status :accepted :node-id current :links links :work-count work})))
                {:status :rejected :reason :map-get-source-mismatch :work-count prefix}))))))))

(defn p15-s23-pc-evidence-work [proof budget]
  ; Budget and first-order checks. Owning reconstruction checks closed field domains.
  ; Parent facts have independent validation in their current typed tables.
  (loop [pending [[proof 0]] used 0]
    (if (= 0 (count pending)) {:status :accepted :work-count used}
      (if (>= used budget) {:status :rejected :reason :map-get-work-limit :work-count used}
        (let [frame (get pending (- (count pending) 1)) value (get frame 0) depth (get frame 1)
              tail (subvec pending 0 (- (count pending) 1)) work (+ used 1)]
          (if (> depth 128) {:status :rejected :reason :map-get-source-mismatch :work-count work}
            (if (if (map? value) true (vector? value))
              (let [width (if (map? value) (* 2 (count value)) (count value))]
                (if (> (+ work (count tail) width) budget)
                  {:status :rejected :reason :map-get-work-limit :work-count (+ work (count tail) width)}
                  (let [next (if (map? value)
                               (loop [entries (vec value) out tail]
                                 (if (= 0 (count entries)) out
                                   (let [entry (first entries)]
                                     (recur (rest entries) (conj (conj out [(get entry 0) (+ depth 1)])
                                                                    [(get entry 1) (+ depth 1)])))))
                               (loop [remaining value out tail]
                                 (if (= 0 (count remaining)) out
                                   (recur (rest remaining) (conj out [(first remaining) (+ depth 1)])))))]
                    (recur next work))))
              (if (if (= nil value) true (if (boolean? value) true (if (keyword? value) true
                    (if (symbol? value) true (if (string? value) true (if (integer? value) true (char? value)))))))
                (let [scalar-work (+ work (if (string? value) (count value)
                                           (if (if (symbol? value) true (keyword? value)) (count (str value)) 0)))]
                  (if (> scalar-work budget) {:status :rejected :reason :map-get-work-limit :work-count scalar-work}
                    (recur tail scalar-work)))
                {:status :rejected :reason :map-get-source-mismatch :work-count work}))))))))

(defn p15-s23-pc-data-child [value family key budget]
  (let [width (if (= :map family) (if (map? value) (count value) 0)
                               (if (vector? value) (count value) 0))
        charge (+ 32 (* 4 width))]
    (if (> charge budget) {:status :rejected :reason :map-get-work-limit :work-count charge}
      (if (= :map family)
        (if (if (keyword? key) (if (map? value) (<= width 512) false) false)
          (loop [remaining (vec value) seen #{} found? false selected nil]
            (if (= 0 (count remaining))
              (if found? {:status :accepted :value selected :work-count charge}
                {:status :rejected :reason :map-get-private-entry-presence-required :work-count charge})
              (let [entry (first remaining) actual-key (get entry 0)]
                (if (keyword? actual-key)
                  (if (contains? seen actual-key)
                    {:status :rejected :reason :map-get-source-mismatch :work-count charge}
                    (recur (rest remaining) (conj seen actual-key) (if (= key actual-key) true found?)
                      (if (= key actual-key) (get entry 1) selected)))
                  {:status :rejected :reason :map-get-source-mismatch :work-count charge}))))
          {:status :rejected :reason :map-get-source-mismatch :work-count charge})
        (if (if (= :vector family) (if (= 0 key) (if (vector? value) (if (< 0 width) (<= width 1024) false) false) false) false)
          {:status :accepted :value (get value 0) :vector-length width :work-count charge}
          {:status :rejected :reason :map-get-source-mismatch :work-count charge})))))

(defn p15-s23-pc-reanchor [quote-id selectors nodes budget]
  (let [base (+ 32 (if (vector? selectors) (* 4 (count selectors)) 0))]
    (if (> base budget) {:status :rejected :reason :map-get-work-limit :work-count base}
      (if (if (p15-s23-pc-id? quote-id) (if (vector? selectors) (<= (count selectors) 3) false) false)
        (let [node (p15-s23-pc-current-node quote-id nodes) attrs (get node :attributes)
              value (get attrs :quoted-value)]
          (if (p15-s23-typed-all
                [(map? node) (= :quote (get node :core-form))
                 (if (vector? (get node :children)) (= 0 (count (get node :children))) false)
                 (if (vector? (get node :resolved-binding-ids)) (= 0 (count (get node :resolved-binding-ids))) false)
                 (= :no-evaluation (get (get node :evaluation) :kind))
                 (if (vector? (get (get node :evaluation) :order)) (= 0 (count (get (get node :evaluation) :order))) false)
                 (p15-s23-pc-id? (get attrs :quoted-form-id)) (p15-s23-pc-id? (get attrs :quoted-syntax-id))
                 (if (= :map (get attrs :quoted-kind)) (map? value)
                   (if (= :vector (get attrs :quoted-kind)) (vector? value) false))])
            (loop [remaining selectors current value used base]
              (if (= 0 (count remaining)) {:status :accepted :value current :work-count used}
                (let [selector (first remaining)
                      fields? (if (map? selector) (if (= 1 (count selector))
                                (loop [keys (keys selector)] (if (= 0 (count keys)) true
                                  (if (keyword? (first keys)) (recur (rest keys)) false))) false) false)]
                  (if fields?
                    (let [family (if (contains? selector :key) :map (if (contains? selector :index) :vector :unsupported))
                          key (if (= :map family) (get selector :key) (get selector :index))
                          child (p15-s23-pc-data-child current family key (- budget used))
                          work (+ used (get child :work-count))]
                      (if (= :accepted (get child :status)) (recur (rest remaining) (get child :value) work)
                        (assoc child :work-count work)))
                    {:status :rejected :reason :map-get-source-mismatch :work-count used}))))
            {:status :rejected :reason :map-get-source-mismatch :work-count base}))
        {:status :rejected :reason :map-get-source-mismatch :work-count base}))))

(defn p15-s23-pc-core-child [cursor family key nodes budget]
  ; Quoted cursors carry logical selectors only. Re-read current C6 data.
  (if (if (= :map family) (keyword? key) (if (= :vector family) (= nil key) false))
    (let [mode (get cursor :source-kind) id (get cursor :node-id)
          node (if (= :core mode) (p15-s23-pc-current-node id nodes) nil)
          quote? (if (map? node) (= :quote (get node :core-form)) false)]
      (if (if (= :quoted-data mode) true quote?)
        (let [quote-id (if quote? id (get cursor :quote-core-node-id))
              selectors (if quote? [] (get cursor :selectors))
              anchored (p15-s23-pc-reanchor quote-id selectors nodes budget)
              used (get anchored :work-count)]
          (if (= :accepted (get anchored :status))
            (let [child (p15-s23-pc-data-child (get anchored :value) family (if (= :vector family) 0 key) (- budget used))
                  work (+ used (get child :work-count))]
              (if (= :accepted (get child :status))
                {:status :accepted :work-count work
                 :cursor {:source-kind :quoted-data :quote-core-node-id quote-id
                          :selectors (conj selectors (if (= :map family) {:key key} {:index 0}))}
                 :location (if (= :map family)
                             {:source-kind :quoted-data :quote-core-node-id quote-id :selectors selectors :key key}
                             {:source-kind :quoted-data :quote-core-node-id quote-id :selectors selectors
                              :coordinate 0 :vector-length (get child :vector-length)})}
                (assoc child :work-count work))) anchored))
        (let [children (get node :children) width (if (vector? children) (count children) 0)
              charge (+ 32 (* 4 width))]
          (if (> charge budget) {:status :rejected :reason :map-get-work-limit :work-count charge}
            (if (if (= :core mode) (if (map? node) (if (= :collection-literal (get node :core-form))
                  (if (= family (get (get node :attributes) :literal-kind))
                    (if (vector? children) (if (<= width 1024) (= width (get (get node :attributes) :element-count)) false) false)
                    false) false) false) false)
              (if (if (= :map family) (p15-s23-pc-even-count? children) (< 0 width))
                (if (= :map family)
                  (loop [i 0 seen #{} selected nil]
                    (if (= i width)
                      (if (map? selected) (assoc selected :status :accepted :work-count charge)
                        {:status :rejected :reason :map-get-private-entry-presence-required :work-count charge})
                      (let [key-id (get children i) value-id (get children (+ i 1))
                            key-node (p15-s23-pc-current-node key-id nodes) value-node (p15-s23-pc-current-node value-id nodes)
                            actual-key (get (get key-node :attributes) :value)]
                        (if (if (map? key-node) (if (map? value-node)
                              (if (= :literal (get key-node :core-form))
                                (if (= :keyword (get (get key-node :attributes) :literal-kind))
                                  (if (keyword? actual-key)
                                    (if (vector? (get key-node :children))
                                      (if (= 0 (count (get key-node :children)))
                                        (if (vector? (get key-node :resolved-binding-ids))
                                          (= 0 (count (get key-node :resolved-binding-ids))) false) false) false)
                                    false) false) false) false) false)
                          (if (contains? seen actual-key)
                            {:status :rejected :reason :map-get-source-mismatch :work-count charge}
                            (recur (+ i 2) (conj seen actual-key)
                              (if (= key actual-key)
                                {:cursor {:source-kind :core :node-id value-id}
                                 :location {:source-kind :evaluated :parent-core-node-id id :coordinate (+ i 1)
                                            :key actual-key :key-node-id key-id :value-node-id value-id}} selected)))
                          {:status :rejected :reason :map-get-source-mismatch :work-count charge}))))
                  (let [child-id (get children 0) child (p15-s23-pc-current-node child-id nodes)]
                    (if (map? child)
                      {:status :accepted :work-count charge :cursor {:source-kind :core :node-id child-id}
                       :location {:source-kind :evaluated :parent-core-node-id id :coordinate 0 :value-node-id child-id :vector-length width}}
                      {:status :rejected :reason :map-get-source-mismatch :work-count charge})))
                {:status :rejected :reason :map-get-source-mismatch :work-count charge})
              {:status :rejected :reason :map-get-source-mismatch :work-count charge})))))
    {:status :rejected :reason :map-get-source-mismatch :work-count 0}))

(defn p15-s23-pc-data-origin [quote-id form path]
  {:kind :quoted-data :quote-core-node-id quote-id :form-id (get form :form-id)
   :syntax-id (get form :syntax-id) :data-path path :child-form-ids (get form :child-form-ids)})

(defn p15-s23-pc-quoted-parent [quote-id path nodes forms budget]
  (if (if (p15-s23-pc-id? quote-id) (if (vector? path) (<= (count path) 2) false) false)
    (let [node (get nodes quote-id) attrs (get node :attributes) source (get node :source)
          owner-id (get source :form-id) payload-id (get attrs :quoted-form-id)
          measured (p15-s23-pc-evidence-work {:source source :path path
                         :payload-id payload-id :payload-syntax-id (get attrs :quoted-syntax-id)} budget)
          base (+ 32 (count path) (get measured :work-count))]
      (if (if (= :rejected (get measured :status)) true (> base budget))
        {:status :rejected :reason (if (if (= :map-get-work-limit (get measured :reason)) true (> base budget))
                                    :map-get-work-limit :map-get-source-mismatch) :work-count base}
        (if (if (p15-s23-pc-id? owner-id) (p15-s23-pc-id? payload-id) false)
          (let [owner (get forms owner-id) ids (get owner :child-form-ids)]
            (if (if (vector? ids) (= 2 (count ids)) false)
              (if (p15-s23-pc-id? (get ids 0))
                (let [operator (get forms (get ids 0)) payload (get forms payload-id)]
                  (if (p15-s23-typed-all
                        [(= :quote (get node :core-form)) (= :list (get owner :kind))
                         (= owner-id (get owner :form-id)) (= (get ids 0) (get operator :form-id))
                         (= source (p15-s23-typed-source owner))
                         (= 'quote (get operator :value)) (= :symbol (get operator :kind))
                         (= [] (get operator :child-form-ids))
                         (= owner-id (get operator :parent-form-id) (get payload :parent-form-id))
                         (= payload-id (get ids 1) (get payload :form-id))
                         (= (get attrs :quoted-syntax-id) (get payload :syntax-id))
                         (= (get attrs :quoted-kind) (get payload :kind))
                         (= [] (get node :children) (get node :resolved-binding-ids))
                         (= :no-evaluation (get (get node :evaluation) :kind)) (= [] (get (get node :evaluation) :order))])
                    (loop [current payload remaining path traversed [] used base]
                      (if (= 0 (count remaining))
                        {:status :accepted :form current :data-path traversed :work-count used}
                        (let [children (get current :child-form-ids) index (first remaining)
                              work (+ used 16 (if (vector? children) (count children) 0))]
                          (if (> work budget) {:status :rejected :reason :map-get-work-limit :work-count work}
                            (if (if (vector? children) (if (<= (count children) 1024)
                                  (if (integer? index) (if (<= 0 index) (< index (count children)) false) false) false) false)
                              (let [child-id (get children index)]
                                (if (p15-s23-pc-id? child-id)
                                  (let [child (get forms child-id)]
                                    (if (if (= child-id (get child :form-id))
                                          (= (get current :form-id) (get child :parent-form-id)) false)
                                      (recur child (rest remaining) (conj traversed index) work)
                                      {:status :rejected :reason :map-get-source-mismatch :work-count work}))
                                  {:status :rejected :reason :map-get-source-mismatch :work-count work}))
                              {:status :rejected :reason :map-get-source-mismatch :work-count work})))))
                    {:status :rejected :reason :map-get-source-mismatch :work-count base}))
                {:status :rejected :reason :map-get-source-mismatch :work-count base})
              {:status :rejected :reason :map-get-source-mismatch :work-count base}))
          {:status :rejected :reason :map-get-source-mismatch :work-count base})))
    {:status :rejected :reason :map-get-source-mismatch :work-count 0}))

(defn p15-s23-pc-value-kind [value]
  ; Selected BU leaves are nil, Bool, Integer, Keyword, String, or Symbol.
  ; Character remains with its existing authenticated owner.
  (if (= nil value) :nil
    (if (boolean? value) :boolean
      (if (keyword? value) :keyword
        (if (string? value) :string
          (if (integer? value) :integer (if (symbol? value) :symbol :unsupported)))))))

(defn p15-s23-pc-literal-type [kind]
  (if (keyword? kind)
    (get {:nil :gravity.type/nil :boolean :gravity.type/bool :integer :gravity.type/integer
          :keyword :gravity.type/keyword :string :gravity.type/string :symbol :gravity.type/symbol} kind) nil))

(defn p15-s23-pc-leaf [cursor shape nodes budget]
  (let [mode (get cursor :source-kind) id (get cursor :node-id)
        node (if (= :core mode) (p15-s23-pc-current-node id nodes) nil)
        anchored (if (= :quoted-data mode)
                   (p15-s23-pc-reanchor (get cursor :quote-core-node-id) (get cursor :selectors) nodes budget)
                   (if (= :core mode) {:status :accepted :value (get (get node :attributes) :value) :work-count 0}
                     {:status :rejected :reason :map-get-source-mismatch :work-count 0}))
        prefix (get anchored :work-count) value (get anchored :value)
        measured (if (= :accepted (get anchored :status))
                   (p15-s23-pc-evidence-work {:value value :shape shape :current-source (get node :source)
                                           :source-path (get cursor :source-path)} (- budget prefix)) anchored)
        used (+ prefix (if (= :accepted (get anchored :status)) (get measured :work-count) 0))]
    (if (= :accepted (get measured :status))
      (let [kind (p15-s23-pc-value-kind value) type (p15-s23-pc-literal-type kind)
            domain (get shape :domain) values (get domain :values)
            fields (if (= :core mode)
                     #{:node-id :type :source :binding-links :shape-size :status :shape-kind :domain}
                     #{:status :type :data-origin :source :binding-links :shape-size :shape-kind :domain})]
        (if (if (= :core mode)
              (if (map? node) (if (= :literal (get node :core-form)) (= kind (get (get node :attributes) :literal-kind)) false) false)
              (= :quoted-data mode))
          (if (if (map? shape) (if (= 8 (count shape))
                (loop [keys (keys shape)] (if (= 0 (count keys)) true
                  (if (keyword? (first keys)) (recur (rest keys)) false))) false) false)
            (if (p15-s23-typed-all
                  [(= fields (set (keys shape))) (keyword? type) (= type (get shape :type))
                   (= :accepted (get shape :status)) (= :scalar (get shape :shape-kind)) (= 1 (get shape :shape-size))
                   (if (vector? (get shape :binding-links)) (= 0 (count (get shape :binding-links))) false)
                   (if (= :core mode) (if (= id (get shape :node-id)) (= (get node :source) (get shape :source)) false)
                     (if (if (= (get (get shape :source) :form-id) (get (get shape :data-origin) :form-id))
                             (= (get (get shape :source) :syntax-id) (get (get shape :data-origin) :syntax-id)) false)
                       (if (= :quoted-data (get (get shape :data-origin) :kind))
                         (if (= (get cursor :quote-core-node-id) (get (get shape :data-origin) :quote-core-node-id))
                           (= (get cursor :source-path) (get (get shape :data-origin) :data-path)) false) false) false))
                   (if (map? domain) (if (= 1 (count domain)) (contains? domain :values) false) false)
                   (if (vector? values) (if (= 1 (count values)) (= value (get values 0)) false) false)])
              {:status :accepted :type type :value value :work-count used}
              {:status :rejected :reason :map-get-source-mismatch :work-count used})
            {:status :rejected :reason :map-get-source-mismatch :work-count used})
          {:status :rejected :reason :map-get-source-mismatch :work-count used}))
      (assoc measured :work-count used))))

(defn p15-s23-pc-key-part [shape key expected budget]
  (let [parts (get shape :parts) width (if (vector? parts) (count parts) 0)
        base (+ 32 (* 4 width))]
    (if (> base budget) {:status :rejected :reason :map-get-work-limit :work-count base}
      (if (if (keyword? key) (if (vector? parts) (<= width 512) false) false)
        (let [checked (p15-s23-lc-validate-types [(get shape :type)]) work base]
          (if (= :accepted (get checked :status))
            (if (if (map? expected) (if (= :gravity.type/map (get expected :kind)) (vector? (get expected :member-types)) false) false)
              (if (p15-s23-typed-all [(= :accepted (get shape :status)) (= :map (get shape :shape-kind))
                  (= expected (get shape :type)) (= :gravity.type/map (get expected :kind))
                  (vector? (get expected :member-types)) (= (* 2 width) (count (get expected :member-types)))])
              (loop [i 0 seen #{} selected nil]
                (if (= i width)
                  (if (map? selected) {:status :accepted :part selected :work-count work}
                    {:status :rejected :reason :map-get-private-first-entry-presence-required :work-count work})
                  (let [part (get parts i) part-key (get part :key) coordinate (+ 1 (* 2 i))]
                    (if (keyword? part-key)
                      (if (contains? seen part-key)
                        {:status :rejected :reason :map-get-source-mismatch :work-count work}
                        (if (if (= coordinate (get part :coordinate))
                              (= :gravity.type/keyword (get (get expected :member-types) (* 2 i))) false)
                          (if (= key part-key)
                            (let [type (get (get part :shape) :type)]
                              (if (if (keyword? type)
                                    (contains? #{:gravity.type/nil :gravity.type/bool :gravity.type/integer :gravity.type/keyword
                                                 :gravity.type/string :gravity.type/symbol} type) false)
                                (if (= type (get (get expected :member-types) coordinate))
                                  (recur (+ i 1) (conj seen part-key) part)
                                  {:status :rejected :reason :map-get-source-mismatch :work-count work})
                                {:status :rejected :reason :map-get-private-first-entry-presence-required :work-count work}))
                            (recur (+ i 1) (conj seen part-key) selected))
                          {:status :rejected :reason :map-get-source-mismatch :work-count work}))
                      {:status :rejected :reason :map-get-source-mismatch :work-count work}))))
              {:status :rejected :reason :map-get-source-mismatch :work-count work})
              {:status :rejected :reason :map-get-source-mismatch :work-count work})
            {:status :rejected :reason :map-get-private-first-entry-presence-required :work-count work}))
        {:status :rejected :reason :map-get-source-mismatch :work-count base}))))

(defn p15-s23-pc-position [cursor child shape part nodes budget]
  ; source-path joins retained C7 origins; it never selects a payload value.
  (let [location (get child :location) kind (get location :source-kind)
        metadata {:source (get shape :source) :origin (get shape :data-origin)
                  :key-origin (get part :key-data-origin) :value-origin (get part :value-data-origin)
                  :child-source (get (get part :shape) :source) :child-origin (get (get part :shape) :data-origin)
                  :source-path (get cursor :source-path)}
        measured (p15-s23-pc-evidence-work metadata budget) work (get measured :work-count)
        coordinate (get part :coordinate) family (get shape :shape-kind) key (get part :key)]
    (if (= :accepted (get measured :status))
      (if (if (integer? coordinate) (if (<= 0 coordinate) (< coordinate 1024) false) false)
        (if (= :evaluated kind)
          (let [parent-id (get location :parent-core-node-id) value-id (get location :value-node-id)
                key-id (get location :key-node-id)]
            (if (if (p15-s23-pc-id? parent-id) (if (p15-s23-pc-id? value-id)
                  (if (= :map family) (p15-s23-pc-id? key-id) (= :vector family)) false) false)
              (let [parent (get nodes parent-id) value (get nodes value-id) key-node (if (= :map family) (get nodes key-id) nil)]
                (if (p15-s23-typed-all
                      [(= parent-id (get shape :constructor-node-id)) (= (get shape :source) (get parent :source))
                       (= coordinate (get location :coordinate)) (= key (get location :key))
                       (= value-id (get part :value-node-id))
                       (if (= :map family) (= key-id (get part :key-node-id)) true)])
                  {:status :accepted :work-count work :cursor (get child :cursor) :location location
                   :source {:source-kind kind :parent-form-id (get (get parent :source) :form-id)
                            :parent-syntax-id (get (get parent :source) :syntax-id) :quote-core-node-id nil :data-path nil
                            :coordinate coordinate :key key :key-form-id (get (get key-node :source) :form-id)
                            :value-form-id (get (get value :source) :form-id) :value-syntax-id (get (get value :source) :syntax-id)}}
                  {:status :rejected :reason :map-get-source-mismatch :work-count work}))
              {:status :rejected :reason :map-get-source-mismatch :work-count work}))
          (if (= :quoted-data kind)
            (let [origin (get shape :data-origin) path (get origin :data-path) ids (get origin :child-form-ids)
                  quote-id (get location :quote-core-node-id) value-origin (get part :value-data-origin)
                  key-origin (get part :key-data-origin) source (get shape :source)
                  parent-core? (= :core (get cursor :source-kind))
                  quote-node (if (if parent-core? (p15-s23-pc-id? (get cursor :node-id)) false)
                               (get nodes (get cursor :node-id)) nil)]
              (if (if (vector? path) (if (<= (count path) 2) (if (vector? ids)
                    (if (<= (count ids) 1024) (< coordinate (count ids)) false) false) false) false)
                (if (p15-s23-typed-all
                      [(= :quoted-data (get shape :constructor-origin)) (= :quoted-data (get origin :kind))
                       (= quote-id (get origin :quote-core-node-id) (get value-origin :quote-core-node-id))
                       (= (get origin :form-id) (get source :form-id)) (= (get origin :syntax-id) (get source :syntax-id))
                       (= (get ids coordinate) (get value-origin :form-id))
                       (= :quoted-data (get value-origin :kind)) (= (conj path coordinate) (get value-origin :data-path))
                       (= value-origin (get (get part :shape) :data-origin))
                       (if (= :map family)
                         (p15-s23-typed-all [(keyword? key) (= key (get location :key)) (< 0 coordinate)
                           (= :quoted-data (get key-origin :kind)) (= quote-id (get key-origin :quote-core-node-id))
                           (= (get ids (- coordinate 1)) (get key-origin :form-id))
                           (= (conj path (- coordinate 1)) (get key-origin :data-path))])
                         (if (= :vector family) (if (= nil key) (= 0 coordinate (get location :coordinate)) false) false))
                       (if parent-core?
                         (if (= :quote (get quote-node :core-form))
                           (if (= [] path)
                             (p15-s23-typed-all [(= quote-id (get quote-node :node-id))
                               (= (get origin :form-id) (get (get quote-node :attributes) :quoted-form-id))
                               (= (get origin :syntax-id) (get (get quote-node :attributes) :quoted-syntax-id))]) false) false)
                         (if (= :quoted-data (get cursor :source-kind))
                           (if (= quote-id (get cursor :quote-core-node-id)) (= path (get cursor :source-path)) false) false))])
                  {:status :accepted :work-count work
                   :cursor (assoc (get child :cursor) :source-path (conj path coordinate))
                   :location (assoc location :data-path path :coordinate coordinate)
                   :source {:source-kind kind :parent-form-id (get origin :form-id) :parent-syntax-id (get origin :syntax-id)
                            :quote-core-node-id quote-id :data-path path :coordinate coordinate :key key
                            :key-form-id (get key-origin :form-id) :value-form-id (get value-origin :form-id)
                            :value-syntax-id (get value-origin :syntax-id)}}
                  {:status :rejected :reason :map-get-source-mismatch :work-count work})
                {:status :rejected :reason :map-get-source-mismatch :work-count work}))
            {:status :rejected :reason :map-get-source-mismatch :work-count work}))
        {:status :rejected :reason :map-get-source-mismatch :work-count work}) measured)))

(defn p15-s23-pc-current-entry [entry outer-key key vector-type map-type nodes budget]
  ; Expected types are results of paid current BT/BS reconstruction, not supplied proof types.
  (let [argument-id (get entry :argument-node-id) call-id (get entry :call-core-node-id)
        base 32 row {:call-core-node-id call-id :argument-node-id argument-id
                     :argument-source (get entry :argument-source) :entry (get entry :entry)}]
    (if (> base budget) {:status :rejected :reason :map-get-work-limit :work-count base}
      (if (if (p15-s23-pc-id? argument-id) (p15-s23-pc-id? call-id) false)
        (let [current (p15-s23-pc-current-node argument-id nodes)
              source-work (p15-s23-pc-evidence-work [(get entry :argument-source) (get current :source)] (- budget base))
              base (+ base (get source-work :work-count))]
          (if (= :accepted (get source-work :status))
            (if (if (map? current) (if (p15-s23-pc-source-domain? (get entry :argument-source))
                  (= (get entry :argument-source) (get current :source)) false) false)
          (if (= :not-invoked (get entry :entry))
          {:status :accepted :row (assoc row :selection nil) :work-count base}
          (if (= :invoked (get entry :entry))
            (let [argument (get entry :argument-shape) outer (get entry :selected-part) vector (get outer :shape)
                  vector-parts (get vector :parts) length (if (vector? vector-parts) (count vector-parts) 0)
                  prefix (+ base 32 (* 2 length))]
              (if (> prefix budget) {:status :rejected :reason :map-get-work-limit :work-count prefix}
                (if (if (vector? vector-parts) (if (< 0 length) (if (<= length 1024)
                      (if (map? vector-type) (if (= :gravity.type/vector (get vector-type :kind))
                        (if (vector? (get vector-type :element-types))
                        (if (map? map-type) (= :gravity.type/map (get map-type :kind)) false) false) false) false) false) false) false)
                  (let [head (get vector-parts 0) map-shape (get head :shape)
                        selected (p15-s23-pc-key-part map-shape key map-type (- budget prefix))
                        used (+ prefix (get selected :work-count)) part (get selected :part)]
                    (if (= :accepted (get selected :status))
                      (if (p15-s23-typed-all
                            [(= vector-type (get vector :type)) (= :vector (get vector :shape-kind))
                             (= length (count (get vector-type :element-types))) (= 0 (get head :coordinate))
                             (= nil (get head :key)) (= map-type (get (get vector-type :element-types) 0))])
                        (loop [i 0 cursor {:source-kind :core :node-id argument-id} sources [] locations [] total used]
                          (if (= i 3)
                            (let [leaf (p15-s23-pc-leaf cursor (get part :shape) nodes (- budget total))
                                  work (+ total (get leaf :work-count))]
                              (if (= :accepted (get leaf :status))
                                {:status :accepted :work-count work :leaf-cursor cursor
                                 :shapes [argument vector map-shape] :parts [outer head part] :locations locations
                                 :row (assoc row :selection {:vector-coordinate 0 :key key :coordinate (get part :coordinate)
                                         :part part :type (get leaf :type) :source-spine sources :logical-path [outer-key 0 key]})}
                                (assoc leaf :work-count work)))
                            (let [family (get [:map :vector :map] i) demanded-key (get [outer-key nil key] i)
                                  shape (get [argument vector map-shape] i) selected-part (get [outer head part] i)
                                  child (p15-s23-pc-core-child cursor family demanded-key nodes (- budget total))
                                  spent (+ total (get child :work-count))]
                              (if (= :accepted (get child :status))
                                (if (if (= i 1) (= length (get (get child :location) :vector-length)) true)
                                  (let [position (p15-s23-pc-position cursor child shape selected-part nodes (- budget spent))
                                        work (+ spent (get position :work-count))]
                                    (if (= :accepted (get position :status))
                                      (recur (+ i 1) (get position :cursor) (conj sources (get position :source))
                                        (conj locations (get position :location)) work)
                                      (assoc position :work-count work)))
                                  {:status :rejected :reason :map-get-source-mismatch :work-count spent})
                                (assoc child :work-count spent)))))
                        {:status :rejected :reason :map-get-source-mismatch :work-count used})
                      (assoc selected :work-count used)))
                  {:status :rejected :reason :map-get-private-first-entry-presence-required :work-count prefix})))
            {:status :rejected :reason :map-get-source-mismatch :work-count base}))
              {:status :rejected :reason :map-get-source-mismatch :work-count base})
            (assoc source-work :work-count base)))
        {:status :rejected :reason :map-get-source-mismatch :work-count base}))))

(defn p15-s23-pc-source-step [location shape nodes forms budget]
  ; Replay one demanded collection level. Unselected values stay inert.
  (let [kind (get location :source-kind) parts (get shape :parts)
        measured (p15-s23-pc-evidence-work {:location location :source (get shape :source)
                                        :origin (get shape :data-origin)} budget)
        used (get measured :work-count)
        parent-node (if (= :evaluated kind) (if (p15-s23-pc-id? (get location :parent-core-node-id))
                      (get nodes (get location :parent-core-node-id)) nil) nil)
        parent-id (get (get parent-node :source) :form-id)
        opened (if (= :accepted (get measured :status))
                 (if (= :quoted-data kind)
                   (p15-s23-pc-quoted-parent (get location :quote-core-node-id) (get location :data-path) nodes forms (- budget used))
                   (if (= :evaluated kind)
                     (if (p15-s23-pc-id? parent-id) {:status :accepted :form (get forms parent-id) :work-count 0}
                       {:status :rejected :reason :map-get-source-mismatch :work-count 0})
                     {:status :rejected :reason :map-get-source-mismatch :work-count 0})) measured)
        work (+ used (if (= :accepted (get measured :status)) (get opened :work-count) 0))]
    (if (= :accepted (get opened :status))
      (let [parent (get opened :form) ids (get parent :child-form-ids) family (get parent :kind)
            width (if (vector? parts) (count parts) 0)
            charge (+ work 32 (* 8 width) (if (vector? ids) (count ids) 0))]
        (if (> charge budget) {:status :rejected :reason :map-get-work-limit :work-count charge}
          (if (if (vector? parts) (if (<= width 1024) (if (vector? ids)
                (if (<= (count ids) 1024) (if (= :map family) (= (* 2 width) (count ids))
                  (if (= :vector family) (= width (count ids)) false)) false) false) false) false)
            (if (p15-s23-typed-all
                  [(= :accepted (get shape :status)) (= family (get shape :shape-kind))
                   (if (vector? (get shape :binding-links)) (= 0 (count (get shape :binding-links))) false)
                   (if (= nil (get shape :call-links)) true
                     (if (vector? (get shape :call-links)) (= 0 (count (get shape :call-links))) false))
                   (= (get shape :source) (p15-s23-typed-source parent))
                   (if (= :quoted-data kind)
                     (if (= :quoted-data (get shape :constructor-origin))
                       (= (get shape :data-origin) (p15-s23-pc-data-origin (get location :quote-core-node-id) parent (get location :data-path))) false)
                     (if (= :collection-literal (get parent-node :core-form))
                       (if (= family (get (get parent-node :attributes) :literal-kind))
                         (if (= (count ids) (count (get parent-node :children)) (get (get parent-node :attributes) :element-count))
                           (= (get shape :constructor-node-id) (get parent-node :node-id)) false) false) false))])
              (loop [i 0 seen #{} selected nil total charge]
                (if (= i width)
                  (if (map? selected) {:status :accepted :source selected :work-count total}
                    {:status :rejected :reason :map-get-source-mismatch :work-count total})
                  (let [part (get parts i) coordinate (if (= :map family) (+ 1 (* 2 i)) i)
                        key-coordinate (if (= :map family) (* 2 i) nil)
                        key-id (if (= :map family) (get ids key-coordinate) nil) value-id (get ids coordinate)
                        evidence (p15-s23-pc-evidence-work
                                   {:key (get part :key) :key-origin (get part :key-data-origin)
                                    :value-origin (get part :value-data-origin)} (- budget total))
                        used (+ total (get evidence :work-count))]
                    (if (= :accepted (get evidence :status))
                      (if (if (p15-s23-pc-id? value-id) (if (= :map family) (p15-s23-pc-id? key-id) true) false)
                        (let [key-form (if (= :map family) (get forms key-id) nil) value-form (get forms value-id)
                              actual-key (get key-form :value)
                              actual-key? (if (= :map family) (if (= :keyword (get key-form :kind)) (keyword? actual-key) false) true)
                              children (get parent-node :children)
                              key-node-id (if (= :map family) (get children key-coordinate) nil)
                              value-node-id (get children coordinate)]
                          (if actual-key?
                            (if (if (= :map family) (contains? seen actual-key) false)
                              {:status :rejected :reason :map-get-source-mismatch :work-count used}
                              (if (p15-s23-typed-all
                                    [(= coordinate (get part :coordinate)) (= actual-key (get part :key))
                                     (= value-id (get value-form :form-id))
                                     (if (= :map family) (= key-id (get key-form :form-id)) true)
                                     (= (get parent :form-id) (get value-form :parent-form-id))
                                     (if (= :map family) (= (get parent :form-id) (get key-form :parent-form-id)) true)
                                     (if (= :quoted-data kind)
                                       (p15-s23-typed-all [(= nil (get part :key-node-id) (get part :value-node-id))
                                         (if (= :map family)
                                           (= (get part :key-data-origin) (p15-s23-pc-data-origin (get location :quote-core-node-id) key-form
                                                                          (conj (get location :data-path) key-coordinate))) true)
                                         (= (get part :value-data-origin) (p15-s23-pc-data-origin (get location :quote-core-node-id) value-form
                                                                           (conj (get location :data-path) coordinate)))])
                                       (if (if (p15-s23-pc-id? value-node-id) (if (= :map family) (p15-s23-pc-id? key-node-id) true) false)
                                         (p15-s23-typed-all
                                           [(= value-node-id (get part :value-node-id))
                                            (if (= :map family)
                                              (let [key-node (get nodes key-node-id)]
                                                (p15-s23-typed-all [(= key-node-id (get part :key-node-id))
                                                  (= :literal (get key-node :core-form)) (= :keyword (get (get key-node :attributes) :literal-kind))
                                                  (= actual-key (get (get key-node :attributes) :value))
                                                  (= (get key-node :source) (p15-s23-typed-source key-form))])) true)
                                            (= (get (get nodes value-node-id) :source) (p15-s23-typed-source value-form))]) false))])
                                (recur (+ i 1) (if (= :map family) (conj seen actual-key) seen)
                                  (if (= coordinate (get location :coordinate))
                                    (if (= actual-key (get location :key))
                                      {:source-kind kind :parent-form-id (get parent :form-id) :parent-syntax-id (get parent :syntax-id)
                                       :quote-core-node-id (get location :quote-core-node-id) :data-path (get location :data-path)
                                       :coordinate coordinate :key actual-key :key-form-id key-id
                                       :value-form-id value-id :value-syntax-id (get value-form :syntax-id)} selected) selected) used)
                                {:status :rejected :reason :map-get-source-mismatch :work-count used}))
                            {:status :rejected :reason :map-get-source-mismatch :work-count used}))
                        {:status :rejected :reason :map-get-source-mismatch :work-count used})
                      (assoc evidence :work-count used)))))
              {:status :rejected :reason :map-get-source-mismatch :work-count charge})
            {:status :rejected :reason :map-get-source-mismatch :work-count charge})))
      (assoc opened :work-count work))))

(defn p15-s23-pc-source-leaf [cursor shape source nodes forms budget]
  (let [id (get source :value-form-id) prefix 32]
    (if (> prefix budget) {:status :rejected :reason :map-get-work-limit :work-count prefix}
      (if (p15-s23-pc-id? id)
        (let [form (get forms id)
              measured (p15-s23-pc-evidence-work {:value (get form :value) :source (get shape :source)
                                              :origin (get shape :data-origin)} (- budget prefix))
              work (+ prefix (get measured :work-count)) kind (get form :kind)
              type (p15-s23-pc-literal-type kind) values (get (get shape :domain) :values)]
          (if (= :accepted (get measured :status))
            (if (p15-s23-typed-all
                  [(= id (get form :form-id)) (keyword? type) (= type (get shape :type)) (= kind (p15-s23-pc-value-kind (get form :value)))
                   (= (get source :value-syntax-id) (get form :syntax-id))
                   (= (get source :parent-form-id) (get form :parent-form-id))
                   (if (vector? (get form :child-form-ids)) (= 0 (count (get form :child-form-ids))) false)
                   (= (get shape :source) (p15-s23-typed-source form))
                   (if (vector? values) (if (= 1 (count values)) (= (get values 0) (get form :value)) false) false)
                   (if (= :quoted-data (get source :source-kind))
                     (= (get shape :data-origin) (p15-s23-pc-data-origin (get source :quote-core-node-id) form
                                                   (conj (get source :data-path) (get source :coordinate))))
                     (if (= :evaluated (get source :source-kind))
                       (if (p15-s23-pc-id? (get cursor :node-id))
                         (= (get (get nodes (get cursor :node-id)) :source) (p15-s23-typed-source form)) false) false))])
              {:status :accepted :work-count work}
              {:status :rejected :reason :map-get-source-mismatch :work-count work})
            (assoc measured :work-count work)))
        {:status :rejected :reason :map-get-source-mismatch :work-count prefix}))))

(defn p15-s23-pc-authenticate-entry [projection nodes forms budget]
  (let [row (get projection :row) shapes (get projection :shapes) locations (get projection :locations)
        parts (get projection :parts)]
    (if (= :not-invoked (get row :entry))
      {:status :accepted :row row :work-count 0}
      (if (if (vector? shapes) (if (vector? locations) (if (vector? parts)
            (= 3 (count shapes) (count locations) (count parts)) false) false) false)
        (loop [i 0 sources [] used 0]
          (if (= i 3)
            (let [leaf (p15-s23-pc-source-leaf (get projection :leaf-cursor) (get (get parts 2) :shape)
                         (get sources 2) nodes forms (- budget used)) work (+ used (get leaf :work-count))]
              (if (= :accepted (get leaf :status))
                (if (= sources (get (get row :selection) :source-spine))
                  {:status :accepted :row (assoc row :selection (assoc (get row :selection) :source-spine sources)) :work-count work}
                  {:status :rejected :reason :map-get-source-mismatch :work-count work})
                (assoc leaf :work-count work)))
            (let [checked (p15-s23-pc-source-step (get locations i) (get shapes i) nodes forms (- budget used))
                  work (+ used (get checked :work-count))]
              (if (= :accepted (get checked :status))
                (recur (+ i 1) (conj sources (get checked :source)) work)
                (assoc checked :work-count work)))))
        {:status :rejected :reason :map-get-source-mismatch :work-count 0}))))

(defn p15-s23-pc-validate-link-types [links types]
  (if (if (vector? links) (<= (count links) 256) false)
    (loop [remaining links]
      (if (= 0 (count remaining)) {:status :accepted}
        (let [link (first remaining) ref-id (get link :reference-core-node-id)
              init-id (get (get link :binding-record) :initializer-node-id)]
          (if (if (p15-s23-pc-id? ref-id) (p15-s23-pc-id? init-id) false)
            (let [ref-type (get types ref-id) init-type (get types init-id)
                  walked (p15-s23-lc-validate-types [ref-type init-type])
]
              (if (= :accepted (get walked :status))
                (if (= ref-type init-type) (recur (rest remaining))
                  {:status :rejected :reason :map-get-source-mismatch})
                {:status :rejected :reason :map-get-private-first-entry-presence-required}))
            {:status :rejected :reason :map-get-source-mismatch}))))
    {:status :rejected :reason :map-get-source-mismatch}))

(defn p15-s23-pc-candidate [core node call nodes types budget]
  ; Source structure chooses this probe; descriptor tags never do.
  (let [args (get call :argument-node-ids)
        receiver (p15-s23-pc-current-node (if (vector? args) (get args 0) nil) nodes)
        key-node (p15-s23-pc-current-node (if (vector? args) (get args 1) nil) nodes)
        receiver-type (get types (get receiver :node-id))]
    (if (if (vector? args) (if (= 2 (count args))
          (if (= :literal (get key-node :core-form))
            (if (if (= :keyword (get (get key-node :attributes) :literal-kind))
                  (if (keyword? (get (get key-node :attributes) :value))
                    (if (vector? (get key-node :children)) (if (= 0 (count (get key-node :children)))
                      (if (vector? (get key-node :resolved-binding-ids)) (= 0 (count (get key-node :resolved-binding-ids))) false) false) false) false) false)
              (if (= :gravity.type/map receiver-type) true
                (if (map? receiver-type) (= :gravity.type/map (get receiver-type :kind)) false)) false) false) false) false)
      (if (= :reference (get receiver :core-form))
        (let [records (get core :lexical-bindings) width (if (vector? records) (count records) 0) work (* 2 width)
              bid (get (get receiver :attributes) :binding-id)]
          (if (> work budget) {:status :rejected :reason :map-get-work-limit :work-count work}
            (if (if (p15-s23-pc-id? bid) (if (vector? records)
                  (map? (p15-s23-pe-one records :binding-id bid)) false) false)
              {:status :accepted :work-count work} {:status :not-applicable :work-count work})))
        (if (= :call (get receiver :core-form))
          (let [children (get receiver :children) operator (p15-s23-pc-current-node (if (vector? children) (get children 0) nil) nodes)
                symbol (get (get operator :attributes) :symbol)]
            (if (if (= :reference (get operator :core-form))
                  (if (symbol? symbol) (if (= 'first symbol) true (= 'gravity.core/first symbol)) false) false)
              {:status :accepted :work-count 0} {:status :not-applicable :work-count 0}))
          {:status :not-applicable :work-count 0}))
      {:status :not-applicable :work-count 0})))

(defn p15-s23-pc-route [core node call nodes bindings budget]
  (let [calls (get core :calls) edges (get core :call-edges)
        base (+ 32 (* 4 (if (vector? calls) (count calls) 0)) (* 4 (if (vector? edges) (count edges) 0)))]
    (if (> base budget) {:status :rejected :reason :map-get-work-limit :work-count base}
      (if (if (vector? calls) (vector? edges) false)
        (let [receiver (get (get call :argument-node-ids) 0)
              outer (p15-s23-pc-unroll receiver core nodes bindings (- budget base))
              used (+ base (get outer :work-count))]
          (if (= :map-get-work-limit (get outer :reason)) (assoc outer :work-count used)
            (if (= :accepted (get outer :status))
              (let [first-id (get outer :node-id) first-node (get nodes first-id)
                    first-call (p15-s23-pe-one calls :core-node-id first-id)
                    first-edge (p15-s23-pe-one edges :call-core-node-id first-id)
                    first-bid (get first-call :operator-binding-id)
                    first-args (get first-call :argument-node-ids)]
                (if (if (p15-s23-pc-id? first-bid) (if (vector? first-args) (= 1 (count first-args)) false) false)
                  (let [first-binding (get bindings first-bid)]
                    (if (if (= 'first (get first-binding :name)) (p15-s23-lq-binding? first-binding (get core :module)) false)
                      (let [inner (p15-s23-pc-unroll (get first-args 0) core nodes bindings (- budget used))
                            total (+ used (get inner :work-count))]
                        (if (= :accepted (get inner :status))
                          (let [get-id (get inner :node-id) get-node (get nodes get-id)
                                get-call (p15-s23-pe-one calls :core-node-id get-id)
                                get-edge (p15-s23-pe-one edges :call-core-node-id get-id)
                                get-bid (get get-call :operator-binding-id) get-args (get get-call :argument-node-ids)]
                            (if (if (p15-s23-pc-id? get-bid) (if (vector? get-args) (if (= 2 (count get-args))
                                  (if (p15-s23-pc-id? (get get-args 0)) (p15-s23-pc-id? (get get-args 1)) false) false) false) false)
                              (if (p15-s23-mg-binding? (get bindings get-bid) (get core :module))
                                (if (if (p15-s23-pc-id? (get (get node :evaluation) :owner-function-syntax-id))
                                    (if (p15-s23-pc-id? (get (get first-node :evaluation) :owner-function-syntax-id))
                                     (if (p15-s23-pc-id? (get (get get-node :evaluation) :owner-function-syntax-id))
                                      (if (p15-s23-pc-id? (get first-edge :caller-function-syntax-id))
                                        (if (p15-s23-pc-id? (get get-edge :caller-function-syntax-id))
                                  (p15-s23-typed-all
                                      [(= :call (get first-node :core-form) (get get-node :core-form))
                                       (= false (= first-id get-id)) (= false (= first-id (get node :node-id)))
                                       (= false (= get-id (get node :node-id)))
                                       (p15-s23-pc-id? (get first-edge :caller-function-syntax-id))
                                       (p15-s23-pc-id? (get get-edge :caller-function-syntax-id))
                                       (p15-s23-pc-id? (get first-call :operator-node-id)) (p15-s23-pc-id? (get get-call :operator-node-id))
                                       (map? first-edge) (map? get-edge)
                                       (= (get (get node :evaluation) :owner-function-syntax-id)
                                          (get (get first-node :evaluation) :owner-function-syntax-id)
                                          (get (get get-node :evaluation) :owner-function-syntax-id)
                                          (get first-edge :caller-function-syntax-id) (get get-edge :caller-function-syntax-id))]) false) false) false) false) false)
                                  {:status :accepted :work-count total
                                   :first-node-id first-id :first-call first-call :first-edge first-edge
                                   :get-node-id get-id :get-call get-call :get-edge get-edge
                                   :receiver-links (get outer :links) :vector-links (get inner :links)}
                                  {:status :rejected :reason :map-get-source-mismatch :work-count total})
                                {:status :rejected :reason :map-get-source-mismatch :work-count total})
                              {:status :rejected :reason :map-get-source-mismatch :work-count total}))
                          (assoc inner :work-count total)))
                      {:status :not-applicable :work-count used}))
                  {:status :not-applicable :work-count used}))
              {:status :not-applicable :work-count used})))
        {:status :rejected :reason :map-get-source-mismatch :work-count base}))))

(defn p15-s23-pc-form-source [form]
  (p15-s23-typed-source form))

(defn p15-s23-pc-keys? [value fields]
  (if (map? value)
    (if (= (count value) (count fields))
      (if (loop [remaining (keys value)]
            (if (= 0 (count remaining)) true
              (if (keyword? (first remaining)) (recur (rest remaining)) false)))
        (= fields (set (keys value))) false) false) false))

(defn p15-s23-pc-selected-type? [type]
  (if (keyword? type)
    (contains? #{:gravity.type/nil :gravity.type/bool :gravity.type/integer :gravity.type/keyword
                 :gravity.type/string :gravity.type/symbol} type) false))

(defn p15-s23-pc-source-domain? [source]
  (if (p15-s23-pc-keys? source #{:form-id :syntax-id :semantic-span :origin-chain :generated-origin})
    (p15-s23-typed-all [(p15-s23-pc-id? (get source :form-id)) (p15-s23-pc-id? (get source :syntax-id))
      (if (= nil (get source :semantic-span)) true (map? (get source :semantic-span)))
      (if (vector? (get source :origin-chain)) (<= (count (get source :origin-chain)) 256) false)
      (if (= nil (get source :generated-origin)) true
        (let [origins (get source :generated-origin)]
          (if (vector? origins)
            (if (<= (count origins) 256)
              (loop [remaining origins]
                (if (= 0 (count remaining)) true
                  (let [origin (first remaining)]
                    (if (p15-s23-pc-keys? origin #{:origin-id :kind :from-syntax-id :role})
                      (if (p15-s23-pc-id? (get origin :origin-id))
                        (if (p15-s23-pc-id? (get origin :from-syntax-id))
                          (recur (rest remaining)) false) false) false)))) false) false)))]) false))

(defn p15-s23-pc-links-domain? [links]
  (if (vector? links)
    (loop [remaining links]
      (if (= 0 (count remaining)) true
        (let [link (first remaining) record (get link :binding-record)]
          (if (p15-s23-typed-all
                [(p15-s23-pc-keys? link #{:reference-core-node-id :reference-source :binding-record})
                 (p15-s23-pc-id? (get link :reference-core-node-id)) (p15-s23-pc-source-domain? (get link :reference-source))
                 (p15-s23-pc-keys? record #{:let-core-node-id :ordinal :name :binding-id :definition-form-id :definition-syntax-id
                                       :binding-scope-id :initializer-form-id :initializer-syntax-id :initializer-scope-id
                                       :initializer-node-id :visible-prior-binding-ids :mutability})
                 (if (integer? (get record :ordinal)) (if (<= 0 (get record :ordinal)) (< (get record :ordinal) 1024) false) false)
                 (symbol? (get record :name)) (= :immutable (get record :mutability))
                 (loop [ids [(get record :let-core-node-id) (get record :binding-id) (get record :definition-form-id)
                             (get record :definition-syntax-id) (get record :binding-scope-id) (get record :initializer-form-id)
                             (get record :initializer-syntax-id) (get record :initializer-scope-id) (get record :initializer-node-id)]]
                   (if (= 0 (count ids)) true (if (p15-s23-pc-id? (first ids)) (recur (rest ids)) false)))
                 (if (vector? (get record :visible-prior-binding-ids))
                   (if (<= (count (get record :visible-prior-binding-ids)) 1024)
                     (loop [ids (get record :visible-prior-binding-ids)]
                       (if (= 0 (count ids)) true (if (p15-s23-pc-id? (first ids)) (recur (rest ids)) false))) false) false)])
            (recur (rest remaining)) false)))) false))

(defn p15-s23-pc-parent-parameter [route core nodes bindings budget]
  ; The outer lookup must be the existing private parameter owner.
  (let [call (get route :get-call) id (get (get call :argument-node-ids) 0)
        receiver (p15-s23-pc-current-node id nodes) owner-id (get (get receiver :evaluation) :owner-function-syntax-id) records (get core :function-records)
        base (+ 32 (* 4 (if (vector? records) (count records) 0)))]
    (if (> base budget) {:status :rejected :reason :map-get-work-limit :work-count base}
      (if (if (vector? records) (p15-s23-pc-id? owner-id) false)
        (let [record (p15-s23-pe-one records :function-syntax-id owner-id)
              ids (get record :parameter-binding-ids) bid (get (get receiver :attributes) :binding-id)
              used (+ base (if (vector? ids) (* 2 (count ids)) 0))]
          (if (> used budget) {:status :rejected :reason :map-get-work-limit :work-count used}
            (if (if (vector? ids) (if (p15-s23-pc-id? bid)
                  (if (= :reference (get receiver :core-form))
                    (if (= :lexical (get (get receiver :attributes) :binding-class))
                      (= 1 (loop [remaining ids matches 0]
                             (if (= 0 (count remaining)) matches
                               (recur (rest remaining) (+ matches (if (= bid (first remaining)) 1 0)))))) false) false) false) false)
              {:status :accepted :work-count used :record record}
              {:status :rejected :reason :map-get-private-first-entry-presence-required :work-count used})))
        {:status :rejected :reason :map-get-source-mismatch :work-count base}))))

(defn p15-s23-pc-entry-set-work [parent record core budget]
  (let [calls (get core :calls) entries (get (get parent :presence-proof) :entries)
        base (+ 32 (* 4 (if (vector? calls) (count calls) 0)) (* 4 (if (vector? entries) (count entries) 0)))]
    (if (> base budget) {:status :rejected :reason :map-get-work-limit :work-count base}
      (if (if (vector? calls) (vector? entries) false)
        (let [actual (p15-s23-pe-select calls :operator-binding-id (get record :definition-binding-id))]
          (if (= (count actual) (count entries))
            (if (loop [i 0]
                  (if (= i (count actual)) true
                    (let [id (get (get entries i) :call-core-node-id)]
                      (if (p15-s23-pc-id? id)
                        (if (= id (get (get actual i) :core-node-id)) (recur (+ i 1)) false) false))))
              {:status :accepted :work-count base}
              {:status :rejected :reason :map-get-source-mismatch :work-count base})
            {:status :rejected :reason :map-get-private-first-entry-presence-required :work-count base}))
        {:status :rejected :reason :map-get-source-mismatch :work-count base}))))

(defn p15-s23-pc-project [header route parent first-descriptor nodes budget]
  ; Parent types have already survived current BT and BS reconstruction.
  (let [proof (get parent :presence-proof) entries (get proof :entries)
        vector-type (get parent :result-type) map-type (get first-descriptor :result-type)
        base (+ 32 (* 8 (if (vector? entries) (count entries) 0)))]
    (if (> base budget) {:status :rejected :reason :map-get-work-limit :work-count base}
      (if (if (= :sh08-map-get-private-entry-v1 (get parent :version))
            (if (= :gravity.type/applied-vector-first (get first-descriptor :kind))
              (if (= :normal (get header :application))
                (if (vector? entries) (if (< 0 (count entries)) (<= (count entries) 1024) false) false) false) false) false)
        (loop [remaining entries rows [] projections [] selected nil normals 0 used base]
          (if (= 0 (count remaining))
            (if (< 0 normals)
              {:status :accepted :work-count used :rows rows :projections projections :type selected}
              {:status :rejected :reason :map-get-private-first-entry-presence-required :work-count used})
            (let [entry (first remaining)
                  projected (p15-s23-pc-current-entry entry (get parent :key) (get header :key)
                              vector-type map-type nodes (- budget used))
                  total (+ used (get projected :work-count)) row (get projected :row)
                  type (get (get row :selection) :type) invoked? (= :invoked (get row :entry))]
              (if (= :accepted (get projected :status))
                (if (if invoked? (if (p15-s23-pc-selected-type? type) (if (= nil selected) true (= selected type)) false) true)
                  (recur (rest remaining) (conj rows row) (conj projections projected)
                    (if invoked? type selected) (+ normals (if invoked? 1 0)) total)
                  {:status :rejected :reason :map-get-private-first-entry-selected-type-required :work-count total})
                (assoc projected :work-count total)))))
        {:status :rejected :reason :map-get-private-first-entry-presence-required :work-count base}))))

(defn p15-s23-pc-authenticate-project [project nodes forms budget]
  (loop [remaining (get project :projections) used 0]
    (if (= 0 (count remaining)) {:status :accepted :work-count used}
      (let [checked (p15-s23-pc-authenticate-entry (first remaining) nodes forms (- budget used))
            total (+ used (get checked :work-count))]
        (if (= :accepted (get checked :status)) (recur (rest remaining) total)
          (assoc checked :work-count total))))))

(defn p15-s23-pc-finish [header route project]
  (let [type (get project :type)]
    (assoc header :version :sh08-map-get-private-first-entry-v1
      :parameter-types (get header :argument-types) :return type :result-type type
      :lookup-policy (assoc (get header :lookup-policy) :input :private-first-entry)
      :presence-proof {:kind :private-first-entry-key-presence
                       :get-call-core-node-id (get route :get-node-id)
                       :first-call-core-node-id (get route :first-node-id)
                       :receiver-links (get route :receiver-links) :vector-links (get route :vector-links)
                       :entries (get project :rows) :selected-type type}
      :invalidation (conj (conj (conj (get header :invalidation) :parent-call-descriptors)
                           :parent-call-facts) :parent-producer-rows :mutations :immutable-binding-links :incoming-arguments :source-spine))))

(defn p15-s23-pc-descriptor-work [supplied expected budget]
  ; Resource payment dominates schema tests and equality. Exact reconstruction
  ; closes every nested row; no supplied field selects a route or table lookup.
  (let [walked (p15-s23-pc-evidence-work supplied budget) used (get walked :work-count)
        proof (get supplied :presence-proof)]
    (if (= :accepted (get walked :status))
      (if (if (p15-s23-pc-keys? proof #{:kind :get-call-core-node-id :first-call-core-node-id
                                   :receiver-links :vector-links :entries :selected-type})
            (if (= :private-first-entry-key-presence (get proof :kind))
              (if (p15-s23-pc-id? (get proof :get-call-core-node-id))
                (if (p15-s23-pc-id? (get proof :first-call-core-node-id))
                  (if (p15-s23-pc-links-domain? (get proof :receiver-links))
                    (if (p15-s23-pc-links-domain? (get proof :vector-links))
                      (if (p15-s23-pc-selected-type? (get proof :selected-type)) (= supplied expected) false) false) false) false) false) false) false)
        {:status :accepted :work-count used}
        {:status :rejected :reason :map-get-source-mismatch :work-count used})
      walked)))

(defn p15-s23-pc-without [value fields]
  (if (map? value)
    (loop [remaining (vec value) out {}]
      (if (= 0 (count remaining)) out
        (let [entry (first remaining) key (get entry 0)]
          (if (keyword? key)
            (recur (rest remaining) (if (contains? fields key) out (assoc out key (get entry 1)))) nil)))) nil))

(defn p15-s23-pc-entry-metadata-work [entries budget]
  (loop [remaining entries out [] used 0]
    (if (= 0 (count remaining)) {:status :accepted :work-count used :value out}
      (let [entry (first remaining) work (+ used 16)]
        (if (> work budget) {:status :rejected :reason :map-get-work-limit :work-count work}
          (if (map? entry)
            (recur (rest remaining)
              (conj out (p15-s23-typed-project entry [:call-core-node-id :argument-node-id :entry])) work)
            {:status :rejected :reason :map-get-source-mismatch :work-count work}))))))

(defn p15-s23-pc-origin-point [origin]
  (if (= nil origin) nil
    [(get origin :kind) (get origin :quote-core-node-id) (get origin :form-id) (get origin :data-path)]))

(defn p15-s23-pc-parent-reference [descriptor]
  (let [source (get descriptor :source) operator (get descriptor :operator-source)
        binding (get descriptor :source-binding)]
    (assoc (p15-s23-typed-project descriptor
             [:kind :version :operation :semantic-owner :intrinsic :resolution :call-core-node-id :operator-node-id
              :operator-binding-id :key-node-id :key :application :profile :target :result-type
              :latent-effects :direct-effects :capabilities :thrown-error-effects])
      :source-ids [(get source :form-id) (get source :syntax-id)]
      :operator-source-ids [(get operator :form-id) (get operator :syntax-id)]
      :binding-source-ids [(get binding :binding-id) (get binding :definition-syntax-id)])))

(defn p15-s23-pc-shape-metadata [shape]
  {:shape-kind (get shape :shape-kind) :constructor-origin (get shape :constructor-origin)
   :constructor-node-id (get shape :constructor-node-id) :node-id (get shape :node-id)
   :form-id (get (get shape :source) :form-id) :origin (p15-s23-pc-origin-point (get shape :data-origin))})

(defn p15-s23-pc-part-metadata [part]
  {:coordinate (get part :coordinate) :key (get part :key)
   :key-node-id (get part :key-node-id) :value-node-id (get part :value-node-id)
   :key-origin (p15-s23-pc-origin-point (get part :key-data-origin))
   :value-origin (p15-s23-pc-origin-point (get part :value-data-origin))})

(defn p15-s23-pc-ancestry-work [entries key budget]
  (if (keyword? key)
  (loop [remaining entries out [] used 0]
    (if (= 0 (count remaining)) {:status :accepted :value out :work-count used}
      (let [entry (first remaining)]
        (if (= :not-invoked (get entry :entry))
          (recur (rest remaining) (conj out nil) used)
          (let [argument (get entry :argument-shape) outer (get entry :selected-part)
                vector (get outer :shape) vector-parts (get vector :parts)
                head (if (vector? vector-parts) (get vector-parts 0) nil)
                map-shape (get head :shape) parts (get map-shape :parts)
                width (if (vector? parts) (count parts) 0) prefix (+ used 32 (* 8 width))]
            (if (> prefix budget) {:status :rejected :reason :map-get-work-limit :work-count prefix}
              (if (if (vector? vector-parts) (if (< 0 (count vector-parts)) (if (vector? parts) (<= width 512) false) false) false)
                (let [selected (loop [i 0 seen #{} found nil]
                                 (if (= i width) found
                                   (let [part (get parts i) actual (get part :key)]
                                     (if (keyword? actual)
                                       (if (contains? seen actual) nil
                                         (if (= (+ 1 (* 2 i)) (get part :coordinate))
                                           (recur (+ i 1) (conj seen actual) (if (= key actual) part found)) nil)) nil))))
                      data {:shapes [(p15-s23-pc-shape-metadata argument) (p15-s23-pc-shape-metadata vector)
                                     (p15-s23-pc-shape-metadata map-shape)]
                            :parts [(p15-s23-pc-part-metadata outer) (p15-s23-pc-part-metadata head)
                                    (p15-s23-pc-part-metadata selected)]
                            :vector-length (count vector-parts)
                            :selected-shape {:type (get (get selected :shape) :type)
                                             :node-id (get (get selected :shape) :node-id)
                                             :source-form-id (get (get (get selected :shape) :source) :form-id)
                                             :origin (p15-s23-pc-origin-point (get (get selected :shape) :data-origin))
                                             :values (get (get (get selected :shape) :domain) :values)}}
                      measured (p15-s23-pc-evidence-work data (- budget prefix)) total (+ prefix (get measured :work-count))]
                  (if (= :accepted (get measured :status))
                    (if (map? selected) (recur (rest remaining) (conj out data) total)
                      {:status :rejected :reason :map-get-private-first-entry-presence-required :work-count total})
                    (assoc measured :work-count total)))
                {:status :rejected :reason :map-get-source-mismatch :work-count prefix})))))))
    {:status :rejected :reason :map-get-private-first-entry-presence-required :work-count 0}))

(defn p15-s23-pc-parent-data-work [descriptor inner-key budget]
  ; A BU dependency projection, not the identity of the entire BT artifact.
  ; Original BT/BS reconstruction owns the census and complete operand types.
  ; The full current source projection owns demanded shape ancestry below.
  (let [proof (get descriptor :presence-proof) entries (get proof :entries)
        base (+ 112 (* 8 (if (vector? entries) (count entries) 0)))]
    (if (> base budget) {:status :rejected :reason :map-get-work-limit :work-count base}
      (if (if (map? descriptor) (if (= :sh08-map-get-private-entry-v1 (get descriptor :version))
            (if (map? proof) (if (vector? entries) (<= (count entries) 1024) false) false) false) false)
        (let [rows (p15-s23-pc-entry-metadata-work entries (- budget base)) prefix (+ base (get rows :work-count))]
          (if (= :accepted (get rows :status))
            (let [data {:parent-reference (p15-s23-pc-parent-reference descriptor)
                        :proof-kind (get proof :kind) :proof-key (get proof :key) :entries (get rows :value)}
                  measured (p15-s23-pc-evidence-work data (- budget prefix)) used (+ prefix (get measured :work-count))]
              (if (= :accepted (get measured :status))
                {:status :accepted :work-count used :value data}
                (assoc measured :work-count used)))
            (assoc rows :work-count prefix)))
        {:status :rejected :reason :map-get-source-mismatch :work-count base}))))

(defn p15-s23-pc-parent-match-work [supplied expected key budget]
  (let [actual (p15-s23-pc-parent-data-work supplied key budget) used (get actual :work-count)
        rebuilt (if (= :accepted (get actual :status))
                  (p15-s23-pc-parent-data-work expected key (- budget used)) actual)
        total (+ used (if (= :accepted (get actual :status)) (get rebuilt :work-count) 0))]
    (if (= :accepted (get rebuilt :status))
      (if (= (get actual :value) (get rebuilt :value))
        {:status :accepted :work-count total
         :parent-reference (get (get rebuilt :value) :parent-reference)}
        {:status :rejected :reason :map-get-source-mismatch :work-count total})
      (assoc rebuilt :work-count total))))

(defn p15-s23-pc-carried-parent-work [descriptor applied-key inner-key budget]
  ; Reference keys are fixed program text. Pay construction before reads,
  ; then walk every independent supplied value, including nested Map keys.
  (let [fields [:kind :version :operation :semantic-owner :intrinsic :resolution :call-core-node-id :operator-node-id
                :operator-binding-id :key-node-id :key :application :profile :target :result-type
                :latent-effects :direct-effects :capabilities :thrown-error-effects
                :source-ids :operator-source-ids :binding-source-ids]
        base (+ 32 (* 4 (count fields)))]
    (if (> base budget) {:status :rejected :reason :map-get-work-limit :work-count base}
      (let [reference (p15-s23-pc-parent-reference descriptor)
            values (loop [remaining fields out []]
                     (if (= 0 (count remaining)) out
                       (recur (rest remaining) (conj out (get reference (first remaining))))))
            walked (p15-s23-pc-evidence-work values (- budget base))
            used (+ base (get walked :work-count))]
        (if (= :accepted (get walked :status))
          (if (if (= :applied-map-get applied-key)
                (if (= :gravity.type/applied-map-get (get reference :kind))
                  (= :sh08-map-get-private-entry-v1 (get reference :version)) false)
                (if (= :applied-vector-first applied-key)
                  (if (= :gravity.type/applied-vector-first (get reference :kind))
                    (= :sh08-vector-first-v1 (get reference :version)) false) false))
            {:status :accepted :work-count used :value reference}
            {:status :rejected :reason :map-get-source-mismatch :work-count used})
          (assoc walked :work-count used))))))

(defn p15-s23-pc-fact-data [fact applied-key application applied]
  {:fields (p15-s23-pc-without fact (conj #{:fact-id-request} applied-key))
   :request (p15-s23-pc-without (get fact :fact-id-request) #{:application}) :application application :applied applied})

(defn p15-s23-pc-fact-data-work [fact applied-key inner-key budget]
  (let [request (get fact :fact-id-request)
        base (+ 32 (* 4 (if (map? fact) (count fact) 0)) (* 4 (if (map? request) (count request) 0)))]
    (if (> base budget) {:status :rejected :reason :map-get-work-limit :work-count base}
      (let [application (p15-s23-pc-carried-parent-work (get request :application) applied-key inner-key (- budget base))
            used (+ base (get application :work-count))
            applied (if (= :accepted (get application :status))
                      (p15-s23-pc-carried-parent-work (get fact applied-key) applied-key inner-key (- budget used)) application)
            spent (+ used (if (= :accepted (get application :status)) (get applied :work-count) 0))]
        (if (= :accepted (get applied :status))
          (let [data (p15-s23-pc-fact-data fact applied-key (get application :value) (get applied :value))
                measured (p15-s23-pc-evidence-work (p15-s23-typed-project data [:fields :request]) (- budget spent))
                total (+ spent (get measured :work-count))]
            (if (= :accepted (get measured :status)) {:status :accepted :work-count total :value data}
              (assoc measured :work-count total)))
          (assoc applied :work-count spent))))))

(defn p15-s23-pc-row-data [row application dependencies]
  {:fields (p15-s23-pc-without row #{:constraint-id-request :dependencies})
   :request (p15-s23-pc-without (get row :constraint-id-request) #{:application}) :application application :dependencies dependencies})

(defn p15-s23-pc-row-data-work [row applied-key inner-key budget]
  (let [request (get row :constraint-id-request)
        base (+ 32 (* 4 (if (map? row) (count row) 0)) (* 4 (if (map? request) (count request) 0)))]
    (if (> base budget) {:status :rejected :reason :map-get-work-limit :work-count base}
      (let [application (p15-s23-pc-carried-parent-work (get request :application) applied-key inner-key (- budget base))
            used (+ base (get application :work-count))
            applied (if (= :accepted (get application :status))
                      (p15-s23-pc-carried-parent-work (get row :dependencies) applied-key inner-key (- budget used)) application)
            spent (+ used (if (= :accepted (get application :status)) (get applied :work-count) 0))]
        (if (= :accepted (get applied :status))
          (let [data (p15-s23-pc-row-data row (get application :value) (get applied :value))
                measured (p15-s23-pc-evidence-work (p15-s23-typed-project data [:fields :request]) (- budget spent))
                total (+ spent (get measured :work-count))]
            (if (= :accepted (get measured :status)) {:status :accepted :work-count total :value data}
              (assoc measured :work-count total)))
          (assoc applied :work-count spent))))))

(defn p15-s23-pc-parent-carriers-work [parents current-parent current-first get-data first-data core facts inner-key budget]
  (let [get-reference (get get-data :parent-reference) first-reference (p15-s23-pc-parent-reference first-data)
        get-id (get parents :get-call-id) first-id (get parents :first-call-id)
        get-facts (p15-s23-pe-select (get facts :call-type-facts) :call-core-node-id get-id)
        first-facts (p15-s23-pe-select (get facts :call-type-facts) :call-core-node-id first-id)
        get-rows (p15-s23-pe-select (p15-s23-pe-select (get facts :constraint-ledger) :producer-rule :sh08-map-get-v1)
                   :lhs {:core-node-id get-id :projection :map-get})
        first-rows (p15-s23-pe-select (p15-s23-pe-select (get facts :constraint-ledger) :producer-rule :sh08-vector-first-v1)
                     :lhs {:core-node-id first-id :projection :vector-first})]
    (if (= 1 (count get-facts) (count first-facts) (count get-rows) (count first-rows))
      (loop [pending [[(first get-facts) :fact :applied-map-get
                       (p15-s23-pc-fact-data (p15-s23-mg-call-fact current-parent (get core :module)) :applied-map-get get-reference get-reference)]
                      [(first first-facts) :fact :applied-vector-first
                       (p15-s23-pc-fact-data (p15-s23-lq-call-fact current-first (get core :module)) :applied-vector-first first-reference first-reference)]
                      [(first get-rows) :row :applied-map-get
                       (p15-s23-pc-row-data (p15-s23-mg-constraint current-parent) get-reference get-reference)]
                      [(first first-rows) :row :applied-vector-first
                       (p15-s23-pc-row-data (p15-s23-lq-constraint current-first) first-reference first-reference)]] used 0]
        (if (= 0 (count pending)) {:status :accepted :work-count used}
          (let [item (first pending)
                checked (if (= :fact (get item 1))
                          (p15-s23-pc-fact-data-work (get item 0) (get item 2) inner-key (- budget used))
                          (p15-s23-pc-row-data-work (get item 0) (get item 2) inner-key (- budget used)))
                total (+ used (get checked :work-count))]
            (if (= :accepted (get checked :status))
              (if (= (get checked :value) (get item 3)) (recur (rest pending) total)
                {:status :rejected :reason :map-get-source-mismatch :work-count total})
              (assoc checked :work-count total)))))
      {:status :rejected :reason :map-get-source-mismatch :work-count 0})))

(defn p15-s23-pc-first-work [route core nodes bindings types budget]
  (let [call (get route :first-call) node (get nodes (get route :first-node-id))
        base (+ 32 (count (get core :function-records)))]
    (if (> base budget) {:status :rejected :reason :map-get-work-limit :work-count base}
      (let [checked (p15-s23-lc-validate-types (p15-s23-io-child-types (get call :argument-node-ids) types))
            used base
            header (if (= :accepted (get checked :status))
                     (p15-s23-lq-source core node call (get route :first-edge) nodes bindings types (get core :module) checked) nil)
            descriptor (if (map? header) (p15-s23-lq-finish header) nil)
            supplied (get types (get call :operator-node-id))
            carrier (if (map? descriptor) (p15-s23-pc-evidence-work supplied (- budget used))
                      {:status :rejected :reason :map-get-source-mismatch :work-count 0})
            spent (+ used (get carrier :work-count))]
        (if (if (= :accepted (get carrier :status)) (if (= :accepted (get checked :status)) (if (map? descriptor)
              (if (= :gravity.type/applied-vector-first (get descriptor :kind))
                (if (= descriptor (get types (get call :operator-node-id)))
                  (= (get descriptor :result-type) (get types (get node :node-id))) false) false) false) false) false)
          {:status :accepted :work-count spent :descriptor descriptor :type-validation checked}
          {:status :rejected :reason (if (= :map-get-work-limit (get carrier :reason)) :map-get-work-limit :map-get-source-mismatch)
           :work-count spent})))))

(defn p15-s23-pc-call-forms-work [node call nodes forms budget]
  (let [owner-id (get (get node :source) :form-id)
        base 32]
    (if (> base budget) {:status :rejected :reason :map-get-work-limit :work-count base}
      (if (p15-s23-pc-id? owner-id)
        (let [owner (get forms owner-id) ids (get owner :child-form-ids) children (get node :children)
              width (if (vector? ids) (count ids) 0) charge (+ base (* 8 width))]
          (if (> charge budget) {:status :rejected :reason :map-get-work-limit :work-count charge}
            (if (if (vector? ids) (if (vector? children) (if (<= width 4) (= width (count children)) false) false) false)
              (let [measured (p15-s23-pc-evidence-work {:source (get node :source) :form-source (p15-s23-pc-form-source owner)}
                               (- budget charge)) used (+ charge (get measured :work-count))]
                (if (= :accepted (get measured :status))
                  (if (if (= owner-id (get owner :form-id)) (if (= :list (get owner :kind))
                        (= (get node :source) (p15-s23-pc-form-source owner)) false) false)
                    (loop [i 0 total used]
                      (if (= i width) {:status :accepted :work-count total}
                        (let [id (get ids i) child-id (get children i)]
                          (if (if (p15-s23-pc-id? id) (p15-s23-pc-id? child-id) false)
                            (let [form (get forms id) child (p15-s23-pc-current-node child-id nodes)
                                  walked (p15-s23-pc-evidence-work {:source (get child :source) :form-source (p15-s23-pc-form-source form)
                                                                :symbol (if (= i 0) (get form :value) nil)
                                                                :literal (if (= :literal (get child :core-form)) (get (get child :attributes) :value) nil)
                                                                :form-literal (if (= :literal (get child :core-form)) (get form :value) nil)}
                                           (- budget total))
                                  spent (+ total (get walked :work-count))]
                              (if (= :accepted (get walked :status))
                                (if (p15-s23-typed-all [(= id (get form :form-id)) (= owner-id (get form :parent-form-id))
                                      (= (get child :source) (p15-s23-pc-form-source form))
                                      (if (= :literal (get child :core-form))
                                        (if (= :keyword (get (get child :attributes) :literal-kind))
                                          (if (= :keyword (get form :kind))
                                            (if (keyword? (get form :value))
                                              (= (get (get child :attributes) :value) (get form :value)) false) false) false) true)
                                      (if (= i 0) (if (= :symbol (get form :kind))
                                        (= (get form :value) (get (get child :attributes) :symbol)) false) true)])
                                  (recur (+ i 1) spent)
                                  {:status :rejected :reason :map-get-source-mismatch :work-count spent})
                                (assoc walked :work-count spent)))
                            {:status :rejected :reason :map-get-source-mismatch :work-count total}))))
                    {:status :rejected :reason :map-get-source-mismatch :work-count used})
                  (assoc measured :work-count used)))
              {:status :rejected :reason :map-get-source-mismatch :work-count charge})))
        {:status :rejected :reason :map-get-source-mismatch :work-count base}))))

(defn p15-s23-pc-links-forms-work [links core nodes bindings forms budget]
  (loop [remaining links used 0]
    (if (= 0 (count remaining)) {:status :accepted :work-count used}
      (let [link (first remaining) record (get link :binding-record)
            measured (p15-s23-pc-evidence-work link (- budget used)) prefix (+ used (get measured :work-count))]
        (if (= :accepted (get measured :status))
          (if (p15-s23-pc-links-domain? [link])
            (let [reference (get nodes (get link :reference-core-node-id))
                  owner (get nodes (get record :let-core-node-id))
                  owner-id (get (get owner :source) :form-id) vector-id (get (get owner :attributes) :binding-vector-form-id)
                  reference-id (get (get reference :source) :form-id)]
              (if (if (p15-s23-pc-id? owner-id) (if (p15-s23-pc-id? vector-id) (p15-s23-pc-id? reference-id) false) false)
                (let [owner-form (get forms owner-id) vector-form (get forms vector-id)
                      ref-form (get forms reference-id) owner-ids (get owner-form :child-form-ids)
                      vector-ids (get vector-form :child-form-ids) index (get record :ordinal)
                      charge (+ prefix 32 (* 4 (if (vector? owner-ids) (count owner-ids) 0))
                                      (* 4 (if (vector? vector-ids) (count vector-ids) 0)))]
                  (if (> charge budget) {:status :rejected :reason :map-get-work-limit :work-count charge}
                    (if (if (vector? owner-ids) (if (vector? vector-ids)
                          (if (<= (count owner-ids) 1024) (if (<= (count vector-ids) 1024)
                            (if (< 1 (count owner-ids)) (< (+ 1 (* 2 index)) (count vector-ids)) false) false) false) false) false)
                      (let [operator-id (get owner-ids 0)
                            metadata (if (p15-s23-pc-id? operator-id)
                              (p15-s23-pc-evidence-work
                                {:reference-source (get reference :source) :ref-form-source (p15-s23-pc-form-source ref-form)
                                 :reference-value (get ref-form :value) :owner-source (get owner :source)
                                 :owner-form-source (p15-s23-pc-form-source owner-form)
                                 :operator-value (get (get forms operator-id) :value)
                                 :binding-form (get forms (get record :definition-form-id))
                                 :initializer-source (p15-s23-pc-form-source (get forms (get record :initializer-form-id)))}
                                (- budget charge))
                              {:status :rejected :reason :map-get-source-mismatch :work-count 0})
                            total (+ charge (get metadata :work-count))]
                        (if (= :accepted (get metadata :status))
                          (if (p15-s23-typed-all
                                [(p15-s23-pc-link-core? record reference core nodes bindings)
                                 (= reference-id (get ref-form :form-id)) (= :symbol (get ref-form :kind))
                                 (= (get record :name) (get ref-form :value))
                                 (= (get reference :source) (p15-s23-pc-form-source ref-form) (get link :reference-source))
                                 (= owner-id (get owner-form :form-id)) (= :list (get owner-form :kind))
                                 (= (get owner :source) (p15-s23-pc-form-source owner-form))
                                 (= operator-id (get (get forms operator-id) :form-id))
                                 (= owner-id (get (get forms operator-id) :parent-form-id))
                                 (= :symbol (get (get forms operator-id) :kind))
                                 (= 'let (get (get forms operator-id) :value))
                                 (= vector-id (get vector-form :form-id) (get owner-ids 1))
                                 (= owner-id (get vector-form :parent-form-id)) (= :vector (get vector-form :kind))
                                 (= (get vector-form :syntax-id) (get (get owner :attributes) :binding-vector-syntax-id))
                                 (= (get vector-ids (* 2 index)) (get record :definition-form-id))
                                 (= (get vector-ids (+ 1 (* 2 index))) (get record :initializer-form-id))
                                 (= (get record :definition-form-id) (get (get forms (get record :definition-form-id)) :form-id))
                                 (= vector-id (get (get forms (get record :definition-form-id)) :parent-form-id))
                                 (= (get record :definition-syntax-id) (get (get forms (get record :definition-form-id)) :syntax-id))
                                 (= (get record :name) (get (get forms (get record :definition-form-id)) :value))
                                 (= :symbol (get (get forms (get record :definition-form-id)) :kind))
                                 (= (get record :binding-scope-id) (get (get forms (get record :definition-form-id)) :scope-id))
                                 (= (get record :initializer-form-id) (get (get forms (get record :initializer-form-id)) :form-id))
                                 (= vector-id (get (get forms (get record :initializer-form-id)) :parent-form-id))
                                 (= (get record :initializer-scope-id) (get (get forms (get record :initializer-form-id)) :scope-id))])
                            (recur (rest remaining) total)
                            {:status :rejected :reason :map-get-source-mismatch :work-count total})
                          (assoc metadata :work-count total)))
                      {:status :rejected :reason :map-get-source-mismatch :work-count charge})))
                {:status :rejected :reason :map-get-source-mismatch :work-count prefix}))
            {:status :rejected :reason :map-get-source-mismatch :work-count prefix})
          (assoc measured :work-count prefix))))))

(defn p15-s23-pc-links [route]
  (loop [remaining (get route :vector-links) out (get route :receiver-links)]
    (if (= 0 (count remaining)) out (recur (rest remaining) (conj out (first remaining))))))

(defn p15-s23-pc-core-project [route parent core node call edge nodes bindings types budget]
  (let [gated (p15-s23-pc-parent-parameter route core nodes bindings budget) gate-work (get gated :work-count)
        entry-set (if (= :accepted (get gated :status))
                    (p15-s23-pc-entry-set-work parent (get gated :record) core (- budget gate-work)) gated)
        prefix (+ gate-work (if (= :accepted (get gated :status)) (get entry-set :work-count) 0))
        first-result (if (= :accepted (get entry-set :status))
                       (p15-s23-pc-first-work route core nodes bindings types (- budget prefix)) entry-set)
        used (+ prefix (if (= :accepted (get entry-set :status)) (get first-result :work-count) 0))
        links (p15-s23-pc-links route)
        linked (if (= :accepted (get first-result :status))
                 (p15-s23-pc-validate-link-types links types) first-result)
        spent used]
    (if (= :accepted (get linked :status))
      (let [header (p15-s23-mg-source core node call edge nodes bindings types (get core :module))
            project (if (map? header)
                      (p15-s23-pc-project header route parent (get first-result :descriptor) nodes (- budget spent))
                      {:status :rejected :reason :map-get-source-mismatch :work-count 0})
            total (+ spent (get project :work-count))]
        (if (= :accepted (get project :status))
          {:status :accepted :work-count total :project project :first-type-validation (get first-result :type-validation) :descriptor (p15-s23-pc-finish header route project)}
          (assoc project :work-count total)))
      (assoc linked :work-count spent))))

(defn p15-s23-pc-full-project [route parent core node call edge nodes bindings types forms budget]
  (let [projected (p15-s23-pc-core-project route parent core node call edge nodes bindings types budget)
        prefix (get projected :work-count)]
    (if (= :accepted (get projected :status))
      (loop [pairs [[node call] [(get nodes (get route :get-node-id)) (get route :get-call)]
                    [(get nodes (get route :first-node-id)) (get route :first-call)]] used prefix]
        (if (= 0 (count pairs))
          (let [links (p15-s23-pc-links route)
                linked (p15-s23-pc-links-forms-work links core nodes bindings forms (- budget used))
                spent (+ used (get linked :work-count))
                checked (if (= :accepted (get linked :status))
                          (p15-s23-pc-authenticate-project (get projected :project) nodes forms (- budget spent)) linked)
                total (+ spent (if (= :accepted (get linked :status)) (get checked :work-count) 0))]
            (if (= :accepted (get checked :status)) (assoc projected :work-count total)
              (assoc checked :work-count total)))
          (let [pair (first pairs) checked (p15-s23-pc-call-forms-work (get pair 0) (get pair 1) nodes forms (- budget used))
                total (+ used (get checked :work-count))]
            (if (= :accepted (get checked :status)) (recur (rest pairs) total)
              (assoc checked :work-count total)))))
      projected)))

(defn p15-s23-pc-parent-rows-work [route parent first-descriptor core facts ledger parent-reference key budget]
  ; The expected reference is already bounded by this invocation's successful
  ; current parent match. Supplied carrier references remain separate inputs.
  (let [base (+ 32 (* 8 (if (vector? facts) (count facts) 0)) (* 8 (if (vector? ledger) (count ledger) 0)))]
    (if (> base budget) {:status :rejected :reason :map-get-work-limit :work-count base}
      (if (if (vector? facts) (vector? ledger) false)
        (let [selectors {:facts (loop [remaining facts out []]
                                  (if (= 0 (count remaining)) out
                                    (recur (rest remaining) (conj out (p15-s23-typed-project (first remaining) [:call-core-node-id])))))
                         :rows (loop [remaining ledger out []]
                                 (if (= 0 (count remaining)) out
                                   (recur (rest remaining) (conj out (p15-s23-typed-project (first remaining) [:producer-rule :lhs])))))}
              measured (p15-s23-pc-evidence-work selectors (- budget base))
              prefix (+ base (get measured :work-count))]
          (if (= :accepted (get measured :status))
            (let [checked (p15-s23-pc-parent-carriers-work
                            {:get-call-id (get route :get-node-id) :first-call-id (get route :first-node-id)}
                            parent first-descriptor {:parent-reference parent-reference} first-descriptor core
                            {:call-type-facts facts :constraint-ledger ledger} key (- budget prefix))]
              (assoc checked :work-count (+ prefix (get checked :work-count))))
            (assoc measured :work-count prefix)))
        {:status :rejected :reason :map-get-source-mismatch :work-count base}))))

(defn p15-s23-pc-full-work [route core node call edge nodes bindings types forms facts ledger budget]
  (let [gated (p15-s23-pc-parent-parameter route core nodes bindings budget) gate-work (get gated :work-count)
        parent-call (get route :get-call) parent-node (get nodes (get route :get-node-id))
        reserved (if (= :accepted (get gated :status))
                   (p15-s23-pe-reserve core (get nodes (get (get parent-call :argument-node-ids) 0)) nodes bindings (- budget gate-work)) gated)
        prefix (+ gate-work (if (= :accepted (get gated :status)) (get reserved :work-count) 0))]
    (if (= :accepted (get reserved :status))
      (let [header (p15-s23-mg-source core parent-node parent-call (get route :get-edge) nodes bindings types (get core :module))
            supplied (get types (get parent-call :operator-node-id))
            parent (if (map? header)
                     (p15-s23-pe-check header supplied core nodes bindings forms types)
                     {:status :rejected :reason :map-get-source-mismatch})
            used prefix]
        (if (= :accepted (get parent :status))
          (let [key-node (get nodes (get (get call :argument-node-ids) 1))
                matched (p15-s23-pc-parent-match-work supplied (get parent :descriptor) (get (get key-node :attributes) :value) (- budget used))
                matched-work (+ used (get matched :work-count))]
          (if (= :accepted (get matched :status))
            (let [projected (p15-s23-pc-full-project route (get parent :descriptor) core node call edge nodes bindings types forms (- budget matched-work))
                  spent (+ matched-work (get projected :work-count))]
              (if (= :accepted (get projected :status))
                (let [first-descriptor (get types (get (get route :first-call) :operator-node-id))
                      rows (p15-s23-pc-parent-rows-work route (get parent :descriptor) first-descriptor core facts ledger (get matched :parent-reference)
                               (get (get projected :descriptor) :key) (- budget spent))
                      total (+ spent (get rows :work-count))]
                  (if (= :accepted (get rows :status))
                    (let [matched (p15-s23-pc-descriptor-work (get types (get call :operator-node-id))
                                    (get projected :descriptor) (- budget total))
                          work (+ total (get matched :work-count))]
                      (if (= :accepted (get matched :status))
                        (assoc projected :work-count work
                          :parents {:get-call-id (get route :get-node-id) :get-operator-id (get parent-call :operator-node-id)
                                    :get-descriptor (get parent :descriptor)
                                    :first-call-id (get route :first-node-id)
                                    :first-operator-id (get (get route :first-call) :operator-node-id)
                                    :first-descriptor first-descriptor :first-type-validation (get projected :first-type-validation)
                                    :fact-count (count facts) :ledger-count (count ledger)})
                        (assoc matched :work-count work)))
                    (assoc rows :work-count total)))
                (assoc projected :work-count spent)))
            (assoc matched :work-count matched-work)))
          (assoc parent :work-count used)))
      (assoc reserved :work-count prefix))))

(defn p15-s23-mg-binding? [binding module]
  (if (if (vector? (get binding :profile-set)) (vector? (get binding :target-set)) false)
  (p15-s23-typed-all
    [(= ['get :core :var 'gravity.core {:name 'gravity/core :version "bootstrap-contract-v1"} :gravity.type/core-var :safe]
        [(get binding :name) (get binding :binding-class) (get binding :kind) (get binding :namespace)
         (get binding :package) (get binding :type-ref) (get binding :safety)])
     (= [] (get binding :effects) (get binding :capabilities))
     (contains? (set (get binding :profile-set)) (get module :profile))
     (contains? (set (get binding :target-set)) :all)]) false))

(defn p15-s23-mg-source [core node call edge nodes bindings types module]
  (if (if (vector? (get call :argument-node-ids)) (vector? (get node :children)) false)
  (let [children (get node :children) operator (get nodes (get call :operator-node-id))
        bid (get call :operator-binding-id) binding (get bindings bid) args (get call :argument-node-ids)
        arguments (p15-s23-io-child-types args types)
        invoked? (loop [remaining arguments]
                   (if (= 0 (count remaining)) true
                     (if (= :gravity.type/never (first remaining)) false (recur (rest remaining)))))
        caller (loop [remaining (get core :function-records)]
                 (if (= 0 (count remaining)) nil
                   (if (= (get (first remaining) :function-syntax-id) (get (get node :evaluation) :owner-function-syntax-id))
                     (first remaining) (recur (rest remaining)))))
        expected-call {:core-node-id (get node :node-id) :operator-node-id (first children) :operator-binding-id bid
                       :argument-node-ids (vec (rest children)) :ordered-evaluation-node-ids children
                       :evaluation-order :operator-then-arguments :result-policy :call-result}
        expected-edge {:ordinal (get edge :ordinal) :call-core-node-id (get node :node-id)
                       :caller-function-syntax-id (get caller :function-syntax-id) :caller-function-core-node-id (get caller :function-core-node-id)
                       :callee-binding-id bid :callee-definition-syntax-id (get binding :definition-syntax-id)
                       :callee-function-syntax-id nil :callee-function-core-node-id nil :argument-core-node-ids args
                       :ordered-evaluation-node-ids children :evaluation-order :operator-then-arguments :classification :nonlocal-or-nonfunction}]
    (if (p15-s23-typed-all
          [(= :call (get node :core-form)) (= :reference (get operator :core-form))
           (contains? #{2 3} (count args)) (= expected-call call) (= expected-edge edge) (p15-s23-mg-binding? binding module)
           (= [bid] (get node :resolved-binding-ids) (get operator :resolved-binding-ids))
           (= {:symbol (get (get operator :attributes) :symbol) :position :operator :binding-id bid :binding-class :core
               :definition-syntax-id (get binding :definition-syntax-id)} (get operator :attributes))
           (contains? '#{get gravity.core/get} (get (get operator :attributes) :symbol))
           (= :operator-then-arguments (get (get node :evaluation) :kind))
           (= (loop [i 0 out []] (if (= i (count children)) out
                (recur (+ i 1) (conj out {:index i :core-node-id (get children i)})))) (get (get node :evaluation) :order))
           (if (= 2 (count args)) (p15-s23-mg-present-operands? arguments args nodes) (p15-s23-mg-operands? arguments invoked?))
           (loop [remaining arguments]
             (if (= 0 (count remaining)) true
               (if (if (= nil (first remaining)) true (= :gravity.type/unknown (first remaining))) false (recur (rest remaining)))))] )
      (let [header {:kind :gravity.type/applied-map-get :version :sh08-map-get-v1
       :operation 'get :semantic-owner 'gravity.collections :intrinsic :gravity.collections/map-lookup-default
       :resolution :gravity.core-compatibility :operator-node-id (get operator :node-id) :operator-binding-id bid
       :call-core-node-id (get node :node-id) :source (get node :source) :operator-source (get operator :source)
       :source-call call :source-edge edge :source-binding binding :argument-types arguments
       :lookup-policy {:input :established-member-map :keys [:string :keyword] :key-equality :value
                       :presence :independent-of-value :default :eager :normalization :none :coercion :none
                       :operand-evaluation :map-then-key-then-default-once :result :one-established-type}
       :application (if invoked? :normal :not-invoked)
       :latent-effects [] :direct-effects [] :capabilities [] :thrown-error-effects []
       :profile (get module :profile) :target (get module :target)
       :invalidation [:calls :call-edges :binding-table :source-forms :type-table :lexical-bindings :definitions :function-records
                      :callee-body :member-types :key-domain :default-type :lookup-policy :profile :target :evaluation-order]}]
        (if (= 2 (count args)) (p15-s23-mg-present-header header nodes) header)) nil)) nil))

(defn p15-s23-mg-constraint [descriptor]
  {:constraint-id-request {:domain :gravity/sh08-map-get-constraint-v1 :application descriptor}
   :kind :equality :producer-rule :sh08-map-get-v1
   :lhs {:core-node-id (get descriptor :call-core-node-id) :projection :map-get}
   :rhs (get descriptor :result-type) :dependencies descriptor :origin (get (get descriptor :source) :origin-chain)
   :solution {:result-type (get descriptor :result-type) :application (get descriptor :application)
              :direct-effects (get descriptor :direct-effects)}
   :invalidation (get descriptor :invalidation) :profile (get descriptor :profile) :target (get descriptor :target)
   :status :solved :diagnostics []})

(defn p15-s23-mg-call-fact [descriptor module]
  (let [source (get descriptor :source) edge (get descriptor :source-edge)]
    {:artifact :gravity/c7-call-type-fact
     :fact-id-request {:domain :gravity/sh08-map-get-call-type-fact-v1 :application descriptor}
     :call-core-node-id (get descriptor :call-core-node-id) :caller-function-syntax-id (get edge :caller-function-syntax-id)
     :callee-function-syntax-id nil :argument-types (get descriptor :argument-types) :result-type (get descriptor :result-type)
     :evaluation-order :operator-then-arguments :source-span (get source :semantic-span) :syntax-id (get source :syntax-id)
     :origin-chain (get source :origin-chain) :generated-origin (get source :generated-origin)
     :profile (get module :profile) :target (get module :target) :effects (get descriptor :direct-effects) :capabilities [] :status :inferred
     :dispatch :direct-map-get :applied-map-get descriptor :effect-facts-source :audited-collection-intrinsic}))


(defn p15-s23-mg-finish [header]
  (let [type (if (= :normal (get header :application)) (get (get header :argument-types) 2) :gravity.type/never)]
    (assoc header :parameter-types (get header :argument-types) :return type :result-type type)))

(defn p15-s23-mg-present-forms? [node nodes forms header]
  (let [owner (get forms (get (get node :source) :form-id)) ids (get owner :child-form-ids)
        children (get node :children)]
    (if (if (vector? ids) (= 3 (count ids) (count children)) false)
      (p15-s23-typed-all [(= :list (get owner :kind)) (= (get node :source) (p15-s23-typed-source owner))
            (= {:operator-child-index 0 :argument-count 2 :argument-child-indexes [1 2]
                :evaluation-order :operator-then-arguments :dispatch :resolved-symbol-call} (get node :attributes))
            (loop [i 0]
              (if (= i 3) true
                (let [form (get forms (get ids i)) child (get nodes (get children i))]
                  (if (p15-s23-typed-all [(= (get owner :form-id) (get form :parent-form-id))
                            (= (get child :source) (p15-s23-typed-source form))
                            (if (= i 0) (= (get form :value) (get (get child :attributes) :symbol)) true)
                            (if (= i 2) (if (= :gravity.type/never (get (get header :argument-types) 1)) true
                              (if (= :keyword (get form :kind)) (= (get header :key) (get form :value)) false)) true)])
                    (recur (+ i 1)) false))))]) false)))

(defn p15-s23-pc-full-context-work [route context node budget]
  (let [table (get context :call-facts) base (+ 32 (* 4 (if (map? table) (count table) 0)))]
    (if (> base budget) {:status :rejected :reason :map-get-work-limit :work-count base}
      (if (map? table)
        (let [facts (loop [remaining (vec table) out []]
                      (if (= 0 (count remaining)) out
                        (recur (rest remaining) (conj out (get (first remaining) 1)))))
              id (get node :node-id)
              checked (p15-s23-pc-full-work route (get context :core) node (get (get context :calls) id)
                        (get (get context :edges) id) (get context :nodes) (get context :bindings) (get context :types)
                        (get context :forms) facts (get context :ledger) (- budget base))]
          (assoc checked :work-count (+ base (get checked :work-count))))
        {:status :rejected :reason :map-get-source-mismatch :work-count base}))))

(defn p15-s23-typed-compile-present-get [context node budget]
  (let [id (get node :node-id) core (get context :core) call (get (get context :calls) id) edge (get (get context :edges) id)
        nodes (get context :nodes) types (get context :types) args (get call :argument-node-ids)
        members (p15-s23-mg-member-count (get types (first args)))
        base (+ 67 (count (get core :function-records)) members (* 2 members))]
    (if (< budget base) (assoc (p15-s23-typed-node-error :typed-lowering-work-limit node) :work-count base)
      (let [supplied (get types (get call :operator-node-id)) proof (get supplied :presence-proof)
            private? (if (= :sh08-map-get-private-entry-v1 (get supplied :version)) true
                       (if (map? proof) (if (contains? proof :entry-census) true (contains? proof :entries)) false))
            candidate (p15-s23-pc-candidate core node call nodes types (- budget base))
            route (if (= :accepted (get candidate :status))
                    (let [r (p15-s23-pc-route core node call nodes (get context :bindings) (- budget base (get candidate :work-count)))]
                      (assoc r :work-count (+ (get candidate :work-count) (get r :work-count)))) candidate)
            route-work (get route :work-count) composed? (= :accepted (get route :status))
            reserved (if composed? {:status :accepted :work-count 0 :matched-call-count 0}
                       (if private?
                       (p15-s23-pe-reserve core (get nodes (first args)) nodes (get context :bindings) (- budget base route-work))
                       {:status :accepted :work-count 0 :matched-call-count 0}))
            charge (+ base route-work (get reserved :work-count) (* (get reserved :matched-call-count 0) (+ 1 (* 2 members))))]
        (if (if (= :rejected (get reserved :status)) true (< budget charge))
          (assoc (p15-s23-typed-node-error
                   (if (if (= :map-get-work-limit (get reserved :reason)) true (< budget charge))
                     :typed-lowering-work-limit :unsupported-or-mismatched-typed-map-get) node) :work-count charge)
      (let [header (p15-s23-mg-source core node call edge nodes (get context :bindings) types (get core :module))
            descriptor (get types (get call :operator-node-id))
            checked (if (map? header)
                      (if composed?
                        (p15-s23-pc-full-context-work route context node (- budget charge))
                        (if private?
                        (p15-s23-pe-check header descriptor core nodes (get context :bindings) (get context :forms) types)
                        (let [walked (if (= :normal (get header :application))
                                       (p15-s23-pe-validate-selected header {:calls [call] :parameter-index 0}
                                         [(get proof :operand-shape)] types false)
                                       {:status :accepted})
                              result (if (= :accepted (get walked :status))
                                       (p15-s23-mg-present-finish header (get proof :operand-shape)) nil)]
                          (if (map? result) (assoc walked :descriptor result)
                            (if (= :rejected (get walked :status)) walked
                              {:status :rejected :reason :map-get-private-entry-presence-required})))))
                      {:status :rejected :reason :map-get-private-entry-presence-required :work-count 0})
            charge (if (contains? checked :work-count) (+ charge (get checked :work-count)) charge)
            expected (get checked :descriptor)
            rows (loop [remaining (get context :ledger) out []]
                   (if (= 0 (count remaining)) out
                     (let [row (first remaining)]
                       (recur (rest remaining)
                         (if (if (= :sh08-map-get-v1 (get row :producer-rule))
                               (= {:core-node-id id :projection :map-get} (get row :lhs)) false) (conj out row) out)))))]
        (if (if (> charge budget) true (= :map-get-work-limit (get checked :reason)))
          (assoc (p15-s23-typed-node-error :typed-lowering-work-limit node) :work-count charge)
        (if (if (map? expected)
              (p15-s23-typed-all
                [(= descriptor expected) (= (get expected :result-type) (get types id))
                 (= (get edge :ordinal) (get (get context :call-order) id))
                 (= (get (get context :current-function) :function-syntax-id) (get edge :caller-function-syntax-id))
                 (= [(p15-s23-mg-constraint expected)] rows)
                 (= (p15-s23-mg-call-fact expected (get core :module)) (get (get context :call-facts) id))
                 (p15-s23-mg-present-forms? node nodes (get context :forms) header)]) false)
          (loop [remaining args values [] used 0]
            (if (= 0 (count remaining))
              (let [key-never? (= :gravity.type/never (get (get header :argument-types) 1))
                    key (get values 1)]
                ; A checked inert Keyword literal can precede the Map in this
                ; existing IR. A transferring key must retain Map-then-key.
                (if (if key-never? true (= {:op :literal :value (get header :key)} key))
                  (assoc (p15-s23-compiler-result
                           (if key-never? {:op :do :body values}
                             {:op :keyword-map-lookup :args [key (get values 0)]}))
                    :work-count (+ charge used))
                  (assoc (p15-s23-typed-node-error :unsupported-or-mismatched-typed-map-get node) :work-count (+ charge used))))
              (let [child (p15-s23-typed-compile-node (assoc context :tail? false) (first remaining) (- budget charge used))]
                (if (p15-s23-compiler-complete? child)
                  (recur (rest remaining) (conj values (get child :value)) (+ used (get child :work-count)))
                  (assoc child :work-count (+ charge used (get child :work-count 0)))))))
          (assoc (p15-s23-typed-node-error :unsupported-or-mismatched-typed-map-get node) :work-count charge)))))))))

(defn p15-s23-typed-compile-get [context node budget]
  (if (= 2 (count (get (get (get context :calls) (get node :node-id)) :argument-node-ids)))
    (p15-s23-typed-compile-present-get context node budget)
  (let [id (get node :node-id) core (get context :core)
        charge (+ 67 (count (get core :function-records))
                  (p15-s23-mg-member-count (get (get context :types) (first (get (get (get context :calls) id) :argument-node-ids)))))]
    (if (< budget charge) (p15-s23-typed-node-error :typed-lowering-work-limit node)
      (let [call (get (get context :calls) id) edge (get (get context :edges) id)
            forms (get context :forms) nodes (get context :nodes)
            owner (get forms (get (get node :source) :form-id)) ids (get owner :child-form-ids)
            header (p15-s23-mg-source core node call edge nodes (get context :bindings) (get context :types) (get core :module))
            descriptor (if (map? header) (p15-s23-mg-finish header) nil)
            rows (loop [remaining (get context :ledger) out []]
                   (if (= 0 (count remaining)) out
                     (let [row (first remaining)]
                       (recur (rest remaining)
                         (if (if (= :sh08-map-get-v1 (get row :producer-rule))
                               (= {:core-node-id id :projection :map-get} (get row :lhs)) false) (conj out row) out)))))]
        (if (if (map? descriptor)
              (p15-s23-typed-all
                [(= descriptor (get (get context :types) (get call :operator-node-id)))
                 (= (get descriptor :result-type) (get (get context :types) id))
                 (= (get edge :ordinal) (get (get context :call-order) id))
                 (= (get (get context :current-function) :function-syntax-id) (get edge :caller-function-syntax-id))
                 (= [(p15-s23-mg-constraint descriptor)] rows)
                 (= (p15-s23-mg-call-fact descriptor (get core :module)) (get (get context :call-facts) id))
                 (= :list (get owner :kind)) (vector? ids) (= 4 (if (vector? ids) (count ids) 0) (count (get node :children)))
                 (= (get node :source) (p15-s23-typed-source owner))
                 (= {:operator-child-index 0 :argument-count 3 :argument-child-indexes [1 2 3]
                     :evaluation-order :operator-then-arguments :dispatch :resolved-symbol-call} (get node :attributes))
                 (loop [i 0]
                   (if (= i 4) true
                     (let [form (get forms (get ids i)) child (get nodes (get (get node :children) i))]
                       (if (p15-s23-typed-all [(= (get owner :form-id) (get form :parent-form-id))
                             (= (get child :source) (p15-s23-typed-source form))
                             (if (= i 0) (= (get form :value) (get (get child :attributes) :symbol)) true)])
                         (recur (+ i 1)) false))))]) false)
          (let [compiled (p15-s23-typed-compile-children context (get call :argument-node-ids) (- budget charge) [])]
            (if (p15-s23-compiler-complete? compiled)
              (assoc (p15-s23-compiler-result {:op :builtin-call :function 'get :args (get compiled :value)})
                :work-count (+ charge (get compiled :work-count))) compiled))
          (p15-s23-typed-node-error :unsupported-or-mismatched-typed-map-get node)))))))

(defn p15-s23-mc-binding? [binding module]
  (if (if (vector? (get binding :profile-set)) (vector? (get binding :target-set)) false)
  (p15-s23-typed-all
    [(= ['contains? :core :var 'gravity.core {:name 'gravity/core :version "bootstrap-contract-v1"} :gravity.type/core-var :safe]
        [(get binding :name) (get binding :binding-class) (get binding :kind) (get binding :namespace)
         (get binding :package) (get binding :type-ref) (get binding :safety)])
     (= [] (get binding :effects) (get binding :capabilities))
     (contains? (set (get binding :profile-set)) (get module :profile))
     (contains? (set (get binding :target-set)) :all)]) false))

(defn p15-s23-sysm-selected? [arguments]
  (if (if (vector? arguments) (= 2 (count arguments)) false)
    (let [items (get arguments 0) needle (get arguments 1)]
      (if (if (= :gravity.type/symbol needle) true (= :gravity.type/never needle))
        (if (= :gravity.type/never items) (= :gravity.type/symbol needle)
        (if (p15-s23-syc-type? items) true
        (if (if (map? items) (if (= 3 (count items))
              (if (loop [fields (keys items)] (if (= 0 (count fields)) true
                    (if (keyword? (first fields)) (recur (rest fields)) false)))
                (if (= :gravity.type/set (get items :kind))
                  (if (= :literal (get items :shape)) (vector? (get items :element-types)) false) false) false) false) false)
          (let [members (get items :element-types)]
            (if (= 0 (count members)) (= :gravity.type/symbol needle)
              (if (= :gravity.type/symbol (get members 0))
                (if (= :gravity.type/symbol needle) true (= :gravity.type/never needle)) false))) false)))
        false)) false))

(defn p15-s23-sysm-domain [arguments budget]
  ; STD3 membership: Symbol spelling is inert DATA, never binding authority.
  (let [limit (if (< budget 65536) budget 65536)]
    (if (< limit 2) {:status :rejected :reason :keyword-set-contains-work-limit :work-count 2}
      (if (if (vector? arguments) (= 2 (count arguments)) false)
        (let [items (get arguments 0) needle (get arguments 1)]
          (if (if (= :gravity.type/symbol needle) true (= :gravity.type/never needle))
            (if (= :gravity.type/never items)
              {:status :accepted :work-count 2 :argument-types arguments :set-member-count nil :membership-family :symbol}
              (if (p15-s23-syc-type? items)
                (if (< limit 3)
                  {:status :rejected :reason :symbol-set-contains-work-limit :work-count 3}
                  {:status :accepted :work-count 3 :argument-types arguments :set-member-count nil :membership-family :symbol})

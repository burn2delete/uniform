                             (conj fields :control-flow) fields)) fields)))} nil)) nil) nil))
(defn p15-s23-vsl-finish [header]
  (let [type (if (= :normal (get header :application))
               {:kind :gravity.type/vector :shape :literal :element-types (get (get header :bounds-proof) :selected-types)}
               :gravity.type/never)]

                {:status :rejected :reason :map-keys-source-mismatch :work-count work})
              {:status :rejected :reason :map-keys-source-mismatch :work-count work})))))))

(defn p15-s23-mkeys-evidence [core ledger facts node call edge nodes bindings types budget]
  (if (if (vector? ledger) (if (if (vector? facts) true (map? facts))
                          (if (vector? (get core :calls)) (vector? (get core :call-edges)) false) false) false)
    (let [limit (if (> budget 65536) 65536 budget)
          derived (p15-s23-mkeys-header core node call edge nodes bindings types (get core :module) limit)
          base (+ (get derived :work-count) (* 2 (count (get core :calls))) (* 2 (count (get core :call-edges))))]
      (if (= :accepted (get derived :status))
        (if (> base limit) {:status :rejected :reason :map-keys-work-limit :work-count base}
          (let [id (get node :node-id) descriptor (get derived :descriptor)
                original-calls (p15-s23-mkeys-originals (get core :calls) :core-node-id id)
                original-edges (p15-s23-mkeys-originals (get core :call-edges) :call-core-node-id id)]
            (if (p15-s23-typed-all [(= :accepted (get original-calls :status)) (= :accepted (get original-edges :status))
                                   (= [call] (get original-calls :items)) (= [edge] (get original-edges :items))])
              (let [rows (p15-s23-mkeys-row-census core ledger nodes bindings types (get original-calls :index) (get original-edges :index)
                           id descriptor (- limit base)) work (+ base (get rows :work-count))]
                (if (= :accepted (get rows :status))
                  (let [calls (p15-s23-mkeys-fact-census facts (get core :module) (get rows :descriptors) id (- limit work))
                        total (+ work (get calls :work-count))]
                    (if (if (= :accepted (get calls :status))
                          (if (= [(p15-s23-mkeys-constraint descriptor)] (get rows :items))
                            (= [(p15-s23-mkeys-call-fact descriptor (get core :module))] (get calls :items)) false) false)
                      {:status :accepted :descriptor descriptor :work-count total}
                      {:status :rejected :reason (if (= :map-keys-work-limit (get calls :reason)) :map-keys-work-limit :map-keys-source-mismatch)
                       :work-count total}))
                  {:status :rejected :reason (get rows :reason) :work-count work}))
              {:status :rejected :reason :map-keys-source-mismatch :work-count base})))
        derived))
    {:status :rejected :reason :map-keys-source-mismatch :work-count 0}))

(defn p15-s23-mkeys-forms? [node call nodes forms]
  (let [owner (get forms (get (get node :source) :form-id)) ids (get owner :child-form-ids)]
    (if (p15-s23-sse-ids? ids 2)
      (if (= :list (get owner :kind))
        (if (= (get node :source) (p15-s23-typed-source owner))
          (loop [index 0]
            (if (= index 2) true
              (let [form (get forms (get ids index)) child (get nodes (get (get node :children) index))]
                (if (if (= (get owner :form-id) (get form :parent-form-id))
                      (if (= (get child :source) (p15-s23-typed-source form))
                        (if (= index 0) (if (symbol? (get form :value))
                                         (= (get form :value) (get (get child :attributes) :symbol)) false) true) false) false)
                  (recur (+ index 1)) false)))) false) false) false)))

(defn p15-s23-pmk-id-vector? [values]
  (if (vector? values)
    (loop [remaining values]
      (if (= 0 (count remaining)) true
        (if (p15-s23-sse-ids? [(first remaining)] 1) (recur (rest remaining)) false))) false))

(defn p15-s23-pmk-record-ids? [record required optional vectors]
  (if (map? record)
    (if (loop [fields required]
          (if (= 0 (count fields)) true
            (if (p15-s23-sse-ids? [(get record (first fields))] 1) (recur (rest fields)) false)))
      (if (loop [fields optional]
            (if (= 0 (count fields)) true
              (let [value (get record (first fields))]
                (if (= nil value) (recur (rest fields))
                  (if (p15-s23-sse-ids? [value] 1) (recur (rest fields)) false)))))
        (loop [fields vectors]
          (if (= 0 (count fields)) true
            (if (p15-s23-pmk-id-vector? (get record (first fields))) (recur (rest fields)) false))) false) false) false))

(defn p15-s23-pmk-fields? [value expected]
  (if (map? value)
    (if (= (count value) (count expected))
      (if (loop [fields (keys value)]
            (if (= 0 (count fields)) true
              (if (keyword? (first fields)) (recur (rest fields)) false)))
        (= expected (set (keys value))) false) false) false))

(defn p15-s23-pmk-physical [core nodes bindings forms budget]
  ; Only the source fields traversed by the existing private-entry census.
  ; Reserve global visits first, then every variable ID field before traversal.
  (let [families [(get core :nodes) (get core :definitions) (get core :function-records)
                  (get core :reference-uses) (get (get core :preserved-resolution) :resolution-table)
                  (get core :calls) (get core :call-edges) (get core :var-references) (get core :mutations)
                  (get core :recur-targets) (get core :recur-transfers) (get core :recursion-components)]
        base (+ 128 (* 8 (+ (if (map? nodes) (count nodes) 0) (if (map? bindings) (count bindings) 0) (if (map? forms) (count forms) 0)))
                    (* 8 (+ (if (vector? (get (get core :module) :effects)) (count (get (get core :module) :effects)) 0)
                            (if (vector? (get (get core :module) :capabilities)) (count (get (get core :module) :capabilities)) 0)))
                    (* 8 (loop [rows families n 0] (if (= 0 (count rows)) n (recur (rest rows) (+ n (if (vector? (first rows)) (count (first rows)) 0)))))))]
    (if (> base budget) {:status :rejected :reason :private-map-keys-work-limit :work-count base}
      (if (if (if (map? nodes) (if (map? bindings) (map? forms) false) false)
            (if (if (symbol? (get (get core :module) :namespace))
                  (if (vector? (get (get core :module) :exports))
                    (if (vector? (get (get core :module) :effects))
                      (if (vector? (get (get core :module) :capabilities))
                        (loop [groups [(get (get core :module) :effects) (get (get core :module) :capabilities)]]
                          (if (= 0 (count groups)) true
                            (if (loop [values (first groups)]
                                  (if (= 0 (count values)) true
                                    (if (keyword? (first values)) (recur (rest values)) false)))
                              (recur (rest groups)) false))) false) false) false) false)
              (loop [rows families] (if (= 0 (count rows)) true (if (vector? (first rows)) (recur (rest rows)) false))) false) false)
        (let [width (loop [groups [[(get core :nodes) [:children :resolved-binding-ids]]
                                  [(get core :function-records) [:parameter-binding-ids]]
                                  [(get core :calls) [:argument-node-ids :ordered-evaluation-node-ids]]
                                  [(get core :call-edges) [:argument-core-node-ids :ordered-evaluation-node-ids]]
                                  [(get core :recur-targets) [:binding-ids]]
                                  [(get core :recursion-components) [:function-syntax-ids]]]
                          n 0]
                      (if (= 0 (count groups)) n
                        (let [group (first groups) measured
                              (loop [rows (get group 0) size 0]
                                (if (= 0 (count rows)) size
                                  (if (map? (first rows))
                                    (let [next (loop [fields (get group 1) out size]
                                                 (if (= 0 (count fields)) out
                                                   (let [value (get (first rows) (first fields))]
                                                     (if (= nil value) (recur (rest fields) out)
                                                       (if (vector? value) (recur (rest fields) (+ out (count value))) nil)))))]
                                      (if (integer? next) (recur (rest rows) next) nil)) nil)))]
                          (if (integer? measured) (recur (rest groups) (+ n measured)) nil))))
              nested-width (loop [rows (get core :nodes) n 0]
                             (if (= 0 (count rows)) n
                               (let [row (first rows) evaluation (get row :evaluation) source (get row :source) attributes (get row :attributes)]
                                 (if (if (map? evaluation) (if (map? source) (if (map? attributes) (vector? (get evaluation :order)) false) false) false)
                                   (recur (rest rows) (+ n (count (get evaluation :order)))) nil))))
              form-width (loop [ids (keys forms) n 0]
                           (if (= 0 (count ids)) n
                             (if (p15-s23-sse-ids? [(first ids)] 1)
                               (let [row (get forms (first ids)) children (get row :child-form-ids)]
                                 (if (if (map? row) (vector? children) false)
                                   (recur (rest ids) (+ n (count children))) nil)) nil)))
              work (+ base (* 4 (+ (if (integer? width) width 0) (if (integer? nested-width) nested-width 0)
                                     (if (integer? form-width) form-width 0))))]
          (if (> work budget) {:status :rejected :reason :private-map-keys-work-limit :work-count work}
            (if (if (if (integer? width) (if (integer? nested-width) (integer? form-width) false) false)
                  (loop [groups [[(get core :nodes) [:node-id] [] [:children :resolved-binding-ids]]
                                [(get core :definitions) [:binding-id :core-node-id :value-node-id] [:syntax-id] []]
                                [(get core :function-records) [:function-syntax-id :function-core-node-id] [:body-core-node-id :definition-binding-id :definition-core-node-id :function-form-id] []]
                                [(get core :reference-uses) [:core-node-id :form-id :syntax-id :binding-id] [:definition-syntax-id] []]
                                [(get (get core :preserved-resolution) :resolution-table) [:reference-syntax-id :binding-id] [:upstream-binding-id] []]
                                [(get core :calls) [:core-node-id :operator-node-id :operator-binding-id] [] [:argument-node-ids :ordered-evaluation-node-ids]]
                                [(get core :call-edges) [:call-core-node-id :callee-binding-id] [:caller-function-syntax-id :caller-function-core-node-id :callee-definition-syntax-id :callee-function-syntax-id :callee-function-core-node-id] [:argument-core-node-ids :ordered-evaluation-node-ids]]
                                [(get core :var-references) [:binding-id] [] []] [(get core :mutations) [:target-binding-id] [] []]
                                [(get core :recur-targets) [:target-id :owner-core-node-id] [] [:binding-ids]]
                                [(get core :recur-transfers) [:target-id] [] []]
                                [(get core :recursion-components) [] [] [:function-syntax-ids]]]]
                    (if (= 0 (count groups)) true
                      (let [group (first groups)]
                        (if (loop [rows (get group 0)]
                              (if (= 0 (count rows)) true
                                (if (p15-s23-pmk-record-ids? (first rows) (get group 1) (get group 2) (get group 3))
                                  (recur (rest rows)) false))) (recur (rest groups)) false)))) false)
              (if (p15-s23-typed-all
                  [(loop [rows (get core :nodes)]
                     (if (= 0 (count rows)) true
                       (let [row (first rows) source (get row :source) attrs (get row :attributes) evaluation (get row :evaluation)]
                         (if (if (keyword? (get row :core-form))
                               (if (p15-s23-pmk-record-ids? source [:form-id :syntax-id] [] [])
                                 (if (p15-s23-pmk-record-ids? attrs [] [:binding-id :definition-syntax-id] [])
                                   (if (if (= nil (get attrs :symbol)) true (symbol? (get attrs :symbol)))
                                     (if (if (= nil (get attrs :binding-class)) true (keyword? (get attrs :binding-class)))
                                       (if (p15-s23-pmk-record-ids? evaluation [] [:owner-function-syntax-id] [])
                                         (loop [order (get evaluation :order)]
                                           (if (= 0 (count order)) true
                                             (if (if (p15-s23-pmk-record-ids? (first order) [:core-node-id] [] [])
                                                   (integer? (get (first order) :index)) false)
                                               (recur (rest order)) false))) false) false) false) false) false) false)
                           (recur (rest rows)) false))))
                   (loop [rows (get core :function-records)]
                     (if (= 0 (count rows)) true
                       (let [parameters (get (first rows) :parameter-binding-ids)]
                         (if (if (= nil parameters) true (p15-s23-pmk-id-vector? parameters))
                           (recur (rest rows)) false))))
                   (loop [ids (keys forms)]
                     (if (= 0 (count ids)) true
                       (let [row (get forms (first ids)) kind (get row :kind)]
                         (if (if (p15-s23-pmk-record-ids? row [:form-id :syntax-id] [:parent-form-id] [:child-form-ids])
                               (if (keyword? kind)
                                 (if (= :symbol kind) (symbol? (get row :value))
                                   (if (= :keyword kind) (keyword? (get row :value)) true)) false) false)
                           (recur (rest ids)) false))))
                   (loop [ids (keys bindings)]
                     (if (= 0 (count ids)) true
                       (if (p15-s23-sse-ids? [(first ids)] 1)
                         (let [binding (get bindings (first ids))]
                           (if (if (p15-s23-pmk-record-ids? binding [:binding-id] [:definition-syntax-id :upstream-binding-id :scope-id] [])
                                 (if (symbol? (get binding :name))
                                   (if (if (= nil (get binding :namespace)) true (symbol? (get binding :namespace)))
                                     (loop [fields [:binding-class :kind :visibility :mutability]]
                                       (if (= 0 (count fields)) true
                                         (let [value (get binding (first fields))]
                                           (if (= nil value) (recur (rest fields))
                                             (if (keyword? value) (recur (rest fields)) false))))) false) false) false)
                             (recur (rest ids)) false)) false)))])
                (if (loop [exports (get (get core :module) :exports)]
                      (if (= 0 (count exports)) true
                        (if (symbol? (first exports)) (recur (rest exports)) false)))
                  {:status :accepted :work-count work}
                  {:status :rejected :reason :private-map-keys-source-mismatch :work-count work})
                {:status :rejected :reason :private-map-keys-source-mismatch :work-count work})
              {:status :rejected :reason :private-map-keys-source-mismatch :work-count work})))
        {:status :rejected :reason :private-map-keys-source-mismatch :work-count base}))))

(defn p15-s23-pmk-source [core node call edge nodes bindings types module budget]
  (if (vector? (get core :function-records))
  (let [limit (if (> budget 65536) 65536 budget)
        base (+ 129 (count (get core :function-records)))]
    (if (> base limit) {:status :rejected :reason :private-map-keys-work-limit :work-count base}
      (if (p15-s23-mkeys-ids? node call nodes bindings module)
        (let [args (get call :argument-node-ids) children (get node :children)
              operator (get nodes (get call :operator-node-id)) bid (get call :operator-binding-id)
              binding (get bindings bid) receiver (get types (first args))
              reserved (+ base (* 2 (+ (count (get binding :profile-set)) (count (get binding :target-set)))))]
          (if (> reserved limit) {:status :rejected :reason :private-map-keys-work-limit :work-count reserved}
            (let [validation (p15-s23-lc-validate-types [receiver])
                  work reserved]
              (if (= false (= :accepted (get validation :status)))
                {:status :rejected :reason :private-map-keys-finite-keyword-map-type-required
                 :work-count work}
                (if (if (keyword? receiver) (= :gravity.type/map receiver) false)
                  (let [normal? true key-domain-work 0 construction-work 1
                        total (+ work key-domain-work construction-work)]
                    (if (> total limit) {:status :rejected :reason :private-map-keys-work-limit :work-count total}
                      (if true
                      (let [result-type (if normal? {:kind :gravity.type/list :shape :homogeneous :element-type :gravity.type/keyword} :gravity.type/never)
                            work total]
                        (if (if (p15-s23-nq-ids? node call nodes bindings module)
                        (if (map? edge)
                          (if (integer? (get edge :ordinal))
                            (if (>= (get edge :ordinal) 0)
                              (p15-s23-typed-all [(p15-s23-mkeys-optional-id? (get (get node :evaluation) :owner-function-syntax-id))
                                                 (p15-s23-mkeys-optional-id? (get edge :caller-function-syntax-id))
                                                 (p15-s23-mkeys-optional-id? (get edge :caller-function-core-node-id))]) false) false) false) false)
                    (let [caller (loop [remaining (get core :function-records)]
                                   (if (= 0 (count remaining)) nil
                                     (let [record (first remaining)]
                                       (if (if (map? record)
                                             (p15-s23-sse-ids? [(get record :function-syntax-id) (get record :function-core-node-id)] 2) false)
                                         (if (= (get (get node :evaluation) :owner-function-syntax-id) (get record :function-syntax-id))
                                           record (recur (rest remaining))) :invalid-map-keys-owner))))
                          expected-call {:core-node-id (get node :node-id) :operator-node-id (first children) :operator-binding-id bid
                                         :argument-node-ids (vec (rest children)) :ordered-evaluation-node-ids children
                                         :evaluation-order :operator-then-arguments :result-policy :call-result}
                          expected-edge {:ordinal (get edge :ordinal) :call-core-node-id (get node :node-id)
                                         :caller-function-syntax-id (get caller :function-syntax-id) :caller-function-core-node-id (get caller :function-core-node-id)
                                         :callee-binding-id bid :callee-definition-syntax-id (get binding :definition-syntax-id)
                                         :callee-function-syntax-id nil :callee-function-core-node-id nil :argument-core-node-ids args
                                         :ordered-evaluation-node-ids children :evaluation-order :operator-then-arguments :classification :nonlocal-or-nonfunction}]
                      (if (p15-s23-typed-all
                            [(= false (= :invalid-map-keys-owner caller))
                             (= :call (get node :core-form)) (= :reference (get operator :core-form))
                             (= {:operator-child-index 0 :argument-count 1 :argument-child-indexes [1]
                                 :evaluation-order :operator-then-arguments :dispatch :resolved-symbol-call} (get node :attributes))
                             (= expected-call call) (= expected-edge edge) (p15-s23-mkeys-binding? binding module)
                             (= 'keys (get binding :name))
                             (= [bid] (get node :resolved-binding-ids) (get operator :resolved-binding-ids))
                             (= {:symbol (get (get operator :attributes) :symbol) :position :operator :binding-id bid :binding-class :core
                                 :definition-syntax-id (get binding :definition-syntax-id)} (get operator :attributes))
                             (contains? '#{keys gravity.core/keys} (get (get operator :attributes) :symbol))
                             (= :operator-then-arguments (get (get node :evaluation) :kind))
                             (= [{:index 0 :core-node-id (first children)} {:index 1 :core-node-id (get children 1)}]
                                (get (get node :evaluation) :order))])
                        {:status :accepted :work-count work
                         :descriptor {:kind :gravity.type/applied-private-map-keys :version :sh08-private-map-keys-v1
                                      :operation 'keys :semantic-owner 'gravity.collections :intrinsic :gravity.collections/private-parameter-map-keys
                                      :resolution :gravity.core-compatibility :operator-node-id (get operator :node-id) :operator-binding-id bid
                                      :call-core-node-id (get node :node-id) :source (get node :source) :operator-source (get operator :source)
                                      :source-call call :source-edge edge :source-binding binding :argument-types [receiver]
                                      :query-policy (if normal? {:input :private-bare-map-with-complete-key-domain-proof :operand-evaluation :once :operand-position :non-tail
                                                     :payload-evaluation :none :original :unchanged :order :unspecified
                                                     :provider-order :preserved :selection :each-stored-key-once :result-carrier :persistent-list :flow-refinement :none
                                                     :type-validation :all-normal-entry-maps-including-all-values}
                                                    {:operand-evaluation :once :operand-position :non-tail :invocation :not-reached})
                                      :allocation-policy {:behavior :possible-persistent-map-key-list-construction :condition :normal-operand-completion
                                                          :effect :memory/allocate :empty-result :possible}
                                      :storage-policy (if normal? {:representation :development-persistent-list :collection-construction :list-spine-copy
                                                       :copy :list-spine :stored-values :shallow-share :input-storage :not-retained :borrow :none
                                                       :lifetime :persistent-values :allocation :possible-even-empty
                                                       :provider-allocation-bound :not-established}
                                                      {:collection-construction :not-invoked})
                                      :value-origin {:kind :map-value-keys :operation 'keys :operand-node-id (first args)}
                                       :profile-validation-work (- reserved base)
                                      :key-domain-work key-domain-work :construction-work construction-work
                                      :application (if normal? :normal :not-invoked) :latent-effects [:memory/allocate] :direct-effects (if normal? [:memory/allocate] []) :capabilities [] :thrown-error-effects []
                                      :parameter-types [receiver] :return result-type :result-type result-type
                                      :profile (get module :profile) :target (get module :target)
                                      :invalidation [:calls :call-edges :binding-table :source-forms :type-table :lexical-bindings :definitions :function-records
                                                     :callee-body :operand-types :query-policy :storage-policy :value-origin :allocation-policy :construction-work
                                                     :private-entry-domain :caller-entries :reference-uses :preserved-resolution :exports :mutations :var-references :recur-targets :recur-transfers :recursion-components
                                                     :result-type :stored-value-lifetimes :result-storage-policy :profile :target :evaluation-order]}}
                        {:status :rejected :reason :private-map-keys-source-mismatch :work-count work}))
                    {:status :rejected :reason :private-map-keys-source-mismatch :work-count work}))
                      {:status :rejected :reason :private-map-keys-finite-keyword-map-type-required :work-count total})))
                  {:status :rejected :reason :private-map-keys-finite-keyword-map-type-required :work-count work})))))
        {:status :rejected :reason :private-map-keys-source-mismatch :work-count base})))
    {:status :rejected :reason :private-map-keys-source-mismatch :work-count 129}))

(defn p15-s23-pmk-parameter [census core node nodes bindings forms budget]
  (let [record (get census :function-record) params (get record :parameter-binding-ids)
        signature (get record :signature) fn-node (get nodes (get record :function-core-node-id))
        attrs (get fn-node :attributes) parameter (get census :parameter-binding)
        index (get census :parameter-index) fn-form (get forms (get record :function-form-id))
        parameter-form (get forms (get attrs :parameter-form-id)) names (get parameter-form :child-form-ids)
        declarations (get signature :parameters) coordinates (get signature :parameter-source-child-indexes)
        base (+ 64 (* 12 (count params)) (if (vector? names) (count names) 0))]
    (if (> base budget) {:status :rejected :reason :private-map-keys-work-limit :work-count base}
      (if (if (p15-s23-pmk-fields? signature #{:rule-version :mapping-rule-version :parameters :return :parameter-source-child-indexes :body-source-child-index})
            (if (vector? declarations) (if (vector? coordinates) (p15-s23-pmk-id-vector? names) false) false) false)
        (if (p15-s23-typed-all
              [(= [:sh07-atomic-function-signature-v1 :sh07-atomic-function-declaration-map-v1]
                  [(get signature :rule-version) (get signature :mapping-rule-version)])
               (= nil (get signature :return)) (= 2 (get signature :body-source-child-index))
               (= (count params) (count declarations) (count coordinates) (get record :fixed-arity))
               (p15-s23-pmk-record-ids? attrs [:parameter-form-id :parameter-syntax-id :recur-target-id] [] [])
               (= (get record :function-syntax-id) (get attrs :recur-target-id))
               (= :sh07-atomic-function-signature-v1 (get fn-node :lowering-rule-version))
               (vector? (get attrs :parameters)) (= (count params) (count (get attrs :parameters)))
               (contains? #{nil :immutable} (get parameter :mutability))
               (= :list (get fn-form :kind)) (= :vector (get parameter-form :kind))
               (vector? (get parameter-form :value)) (= (count names) (count (get parameter-form :value)))
               (= (get parameter-form :syntax-id) (get attrs :parameter-syntax-id))
               (p15-s23-sse-ids? (get fn-form :child-form-ids) 3)])
          (let [fn-ids (get fn-form :child-form-ids) operator (get forms (get fn-ids 0))
                body (get nodes (get record :body-core-node-id))]
            (if (p15-s23-typed-all
                  [(= :symbol (get operator :kind)) (= 'fn (get operator :value))
                   (= (get fn-form :form-id) (get operator :parent-form-id) (get parameter-form :parent-form-id))
                   (= (get parameter-form :form-id) (get fn-ids 1))
                   (= (get (get body :source) :form-id) (get fn-ids 2))
                   (= (get fn-node :source) (p15-s23-typed-source fn-form))])
              (loop [i 0 coordinate 0 slots []]
                (if (= i (count params))
                  (if (= coordinate (count names))
                    (if (= signature (get attrs :signature))
                      {:status :accepted :work-count base
                       :callee {:function-id (get record :function-syntax-id) :signature signature :parameters slots}
                       :source {:function-node fn-node :function-form fn-form :parameter-form parameter-form
                                :declaration (get declarations index) :parameter-index index :parameter-binding parameter}}
                      {:status :rejected :reason :private-map-keys-source-mismatch :work-count base})
                    {:status :rejected :reason :private-map-keys-source-mismatch :work-count base})
                  (let [binding (get bindings (get params i)) name-form (get forms (get names coordinate))
                        declaration (get declarations i) declared? (= false (= nil declaration))
                        step (if declared? 3 1)]
                    (if (if (integer? (get coordinates i)) (= coordinate (get coordinates i)) false)
                      (if (p15-s23-typed-all
                            [(= :symbol (get name-form :kind)) (= (get binding :name) (get name-form :value) (get (get attrs :parameters) i))
                             (= (get binding :definition-syntax-id) (get name-form :syntax-id))
                             (= (get parameter-form :form-id) (get name-form :parent-form-id))
                             (if declared?
                               (if (p15-s23-pmk-fields? declaration #{:source-child-index :marker-form-id :marker-syntax-id :type-form-id :type-syntax-id :type-symbol :type-binding-id :type-id})
                                 (if (p15-s23-pmk-record-ids? declaration [:marker-form-id :marker-syntax-id :type-form-id :type-syntax-id :type-binding-id] [] [])
                                   (if (symbol? (get declaration :type-symbol)) (keyword? (get declaration :type-id)) false) false) false) true)])
                        (let [marker (if declared? (get forms (get declaration :marker-form-id)) nil)
                              type-form (if declared? (get forms (get declaration :type-form-id)) nil)
                              type-binding (if declared? (get bindings (get declaration :type-binding-id)) nil)]
                          (if (if declared?
                                (p15-s23-typed-all
                                  [(= (+ coordinate 1) (get declaration :source-child-index))
                                   (= [(get declaration :marker-form-id) (get declaration :type-form-id)] [(get names (+ coordinate 1)) (get names (+ coordinate 2))])
                                   (= :keyword (get marker :kind)) (= :- (get marker :value))
                                   (= (get declaration :marker-syntax-id) (get marker :syntax-id))
                                   (= (get declaration :type-syntax-id) (get type-form :syntax-id))
                                   (= :symbol (get type-form :kind)) (= (get declaration :type-symbol) (get type-form :value) (get type-binding :name))
                                   (= :core (get type-binding :binding-class)) (= :type (get type-binding :kind)) (= 'gravity.core (get type-binding :namespace))
                                   (= (get parameter-form :form-id) (get marker :parent-form-id) (get type-form :parent-form-id))
                                   (if (= i index) (= ['Map :gravity.type/map] [(get declaration :type-symbol) (get declaration :type-id)]) true)])
                                (= false (= i index)))
                            (recur (+ i 1) (+ coordinate step) (conj slots {:binding-id (get params i) :type (if declared? (get declaration :type-id) :gravity.type/unknown)}))
                            {:status :rejected :reason :private-map-keys-entry-domain-required :work-count base}))
                        {:status :rejected :reason :private-map-keys-source-mismatch :work-count base})
                      {:status :rejected :reason :private-map-keys-source-mismatch :work-count base}))))
              {:status :rejected :reason :private-map-keys-source-mismatch :work-count base}))
          {:status :rejected :reason :private-map-keys-source-mismatch :work-count base})
        {:status :rejected :reason :private-map-keys-entry-domain-required :work-count base}))))

(defn p15-s23-pmk-map-source [argument actual nodes forms types budget]
  ; The initial entry-source subset uses original finite Map constructors.
  ; All member types were validated before this source/domain walk.
  (let [children (get argument :children) members (get actual :member-types)
        work (+ 16 (* 8 (count members))) source (get argument :source)
        owner (get forms (get source :form-id))]
    (if (> work budget) {:status :rejected :reason :private-map-keys-work-limit :work-count work}
      (if (p15-s23-typed-all
            [(= :collection-literal (get argument :core-form)) (= :map (get (get argument :attributes) :literal-kind))
             (= (count members) (get (get argument :attributes) :element-count) (count children) (count (get owner :child-form-ids)))
             (= :map (get owner :kind)) (= source (p15-s23-typed-source owner))])
        (if (loop [i 0]
              (if (= i (count members)) true
                (let [child (get nodes (get children i)) form (get forms (get (get owner :child-form-ids) i))
                      type (get types (get children i)) key? (= i (* 2 (quot i 2)))]
                  (if (p15-s23-typed-all
                        [(= (get owner :form-id) (get form :parent-form-id))
                         (= (get child :source) (p15-s23-typed-source form))
                         (= type (get members i))
                         (= {:index i :core-node-id (get child :node-id)} (get (get (get argument :evaluation) :order) i))
                         (if key?
                           (if (= :literal (get child :core-form))
                             (if (= :keyword (get (get child :attributes) :literal-kind))
                               (if (keyword? (get (get child :attributes) :value))
                                 (if (= :keyword (get form :kind))
                                   (if (keyword? (get form :value))
                                     (= (get form :value) (get (get child :attributes) :value)) false) false) false) false) false) true)])
                    (recur (+ i 1)) false))))
          {:status :accepted :work-count work :source-node argument :source-form owner}
          {:status :rejected :reason :private-map-keys-source-mismatch :work-count work})
        {:status :rejected :reason :private-map-keys-entry-domain-required :work-count work}))))

(defn p15-s23-pmk-acyclic [core root budget]
  (let [edges (get core :call-edges) maximum (+ 1 (count (get core :function-records)))
        work (+ 8 (* 4 maximum (count edges)))]
    (if (> work budget) {:status :rejected :reason :private-map-keys-work-limit :work-count work}
      (loop [pass 0 reached #{root}]
        (if (> pass maximum) {:status :rejected :reason :private-map-keys-entry-domain-required :work-count work}
          (let [next (loop [remaining edges out reached]
                       (if (= 0 (count remaining)) out
                         (let [edge (first remaining) caller (get edge :caller-function-syntax-id) callee (get edge :callee-function-syntax-id)]
                           (if (if (= nil callee) false (contains? reached caller))
                             (if (= root callee) nil (recur (rest remaining) (conj out callee)))
                             (recur (rest remaining) out)))))]
            (if (= nil next) {:status :rejected :reason :private-map-keys-entry-domain-required :work-count work}
              (if (= next reached) {:status :accepted :work-count work}
                (recur (+ pass 1) next)))))))))

(defn p15-s23-pmk-metadata-work [proof budget]
  ; Budget and first-order checks. Owning reconstruction checks closed field domains.
  ; Parent facts have independent validation in their current typed tables.
  (loop [pending [[proof 0]] used 0]
    (if (= 0 (count pending)) {:status :accepted :work-count used}
      (if (>= used budget) {:status :rejected :reason :private-map-keys-work-limit :work-count used}
        (let [frame (get pending (- (count pending) 1)) value (get frame 0) depth (get frame 1)
              tail (subvec pending 0 (- (count pending) 1)) work (+ used 1)]
          (if (> depth 128) {:status :rejected :reason :private-map-keys-source-mismatch :work-count work}
            (if (if (map? value) true (vector? value))
              (let [width (if (map? value) (* 2 (count value)) (count value))]
                (if (> (+ work (count tail) width) budget)
                  {:status :rejected :reason :private-map-keys-work-limit :work-count (+ work (count tail) width)}
                  (let [next (if (map? value)
                               (loop [entries (vec value) out tail]
                                 (if (= 0 (count entries)) out
                                   (let [entry (first entries)]
                                     (recur (rest entries) (conj (conj out [(get entry 0) (+ depth 1)])
                                                                    [(get entry 1) (+ depth 1)])))))
                               (loop [remaining value out tail]
                                 (if (= 0 (count remaining)) out
                                   (recur (rest remaining) (conj out [(first remaining) (+ depth 1)])))))]
                    (recur next work))))
              (if (if (= nil value) true (if (boolean? value) true (if (keyword? value) true
                    (if (symbol? value) true (if (string? value) true (if (integer? value) true (char? value)))))))
                (let [scalar-work (+ work (if (string? value) (count value)
                                           (if (if (symbol? value) true (keyword? value)) (count (str value)) 0)))]
                  (if (> scalar-work budget) {:status :rejected :reason :private-map-keys-work-limit :work-count scalar-work}
                    (recur tail scalar-work)))
                {:status :rejected :reason :private-map-keys-source-mismatch :work-count work}))))))))

(defn p15-s23-pmk-unknown? [value]
  (if (= nil value) true
    (if (keyword? value) (= :gravity.type/unknown value) false)))

(defn p15-s23-pmk-proof [header core node nodes bindings types forms budget]
  (let [physical (p15-s23-pmk-physical core nodes bindings forms budget) first-work (get physical :work-count)]
    (if (= :accepted (get physical :status))
      (let [receiver (get nodes (first (get (get header :source-call) :argument-node-ids)))
            reserved (p15-s23-pe-reserve core receiver nodes bindings (- budget first-work))
            work (+ first-work (get reserved :work-count))]
        (if (= :accepted (get reserved :status))
          (let [census (p15-s23-pe-census header core nodes bindings forms)]
            (if (map? census)
              (let [parameter (p15-s23-pmk-parameter census core node nodes bindings forms (- budget work))
                    used (+ work (get parameter :work-count))
                    graph (if (= :accepted (get parameter :status))
                            (p15-s23-pmk-acyclic core (get (get census :function-record) :function-syntax-id) (- budget used))
                            parameter)
                    work (+ used (if (= :accepted (get parameter :status)) (get graph :work-count) 0))]
                (if (if (= :accepted (get parameter :status)) (= :accepted (get graph :status)) false)
                  (loop [remaining (get census :calls) entries [] normal-count 0 used work domain-work 0]
                    (if (= 0 (count remaining))
                      (if (< 0 normal-count)
                        {:status :accepted :work-count used :key-domain-work domain-work
                         :proof {:kind :complete-private-call-entry-key-domain :version :sh08-private-map-keys-entry-domain-v1
                                 :domain :keyword :parameter-type :gravity.type/map :result-refinement :none
                                 :parameter-binding-id (get (get census :parameter-binding) :binding-id)
                                 :parameter-index (get census :parameter-index) :function-syntax-id (get (get census :function-record) :function-syntax-id)
                                 :normal-witness-count normal-count :entries entries :census census :parameter-source (get parameter :source)
                                 :keys-use {:source (get header :source) :source-call (get header :source-call) :source-edge (get header :source-edge)}
                                 :coverage :all-resolved-private-entries :normality :all-argument-coordinates
                                 :validation :entire-normal-map-including-all-values :ground :independent-entry-types-and-original-source
                                 :no-refinement [:common-shape :key-presence :key-identity :extent :cardinality :nonempty :flow :specialization]}}
                        {:status :rejected :reason :private-map-keys-entry-domain-required :work-count used})
                      (let [call (first remaining) args (get call :argument-node-ids)
                            prefix (+ used 32 (* 2 (count args)))
                            arguments (if (> prefix budget) [] (p15-s23-io-child-types args types))
                            complete? (if (> prefix budget) false
                                        (loop [values arguments]
                                          (if (= 0 (count values)) true
                                            (if (p15-s23-pmk-unknown? (first values)) false (recur (rest values))))))]
                        (if (> prefix budget) {:status :rejected :reason :private-map-keys-work-limit :work-count prefix}
                          (if (= false complete?) {:status :deferred :reason :private-map-keys-entry-domain-required :type :gravity.type/unknown :work-count prefix}
                            (let [validation (p15-s23-lc-validate-types arguments)
                                  used prefix normal? (p15-s23-pe-invoked? types args)
                                  index (get census :parameter-index) argument-id (get args index)
                                  argument (get nodes argument-id) actual (get arguments index)
                                  call-node (get nodes (get call :core-node-id)) call-source (get call-node :source)
                                  call-form (get forms (get call-source :form-id))
                                  edge (p15-s23-pe-one (get census :edges) :call-core-node-id (get call :core-node-id))]
                              (if (= :accepted (get validation :status))
                                (if (= call-source (p15-s23-typed-source call-form))
                                (if normal?
                                  (if (p15-s23-mkeys-type? actual)
                                    (let [key-work (quot (count (get actual :member-types)) 2)
                                          prefix (+ used key-work)
                                          source (if (> prefix budget) {:status :rejected :reason :private-map-keys-work-limit :work-count 0}
                                                   (p15-s23-pmk-map-source argument actual nodes forms types (- budget prefix)))
                                          used (+ prefix (get source :work-count))
                                          compatibility (if (= :accepted (get source :status))
                                                          (p15-s23-mp-compatibility core call edge (get parameter :callee) index actual nodes bindings (- budget used)) source)
                                          total (+ used (if (= :accepted (get source :status)) (get compatibility :work-count) 0))]
                                      (if (if (= :accepted (get source :status)) (= :accepted (get compatibility :status)) false)
                                        (recur (rest remaining)
                                          (conj entries {:call-core-node-id (get call :core-node-id) :argument-node-id argument-id :argument-source (get argument :source) :call-source call-source
                                                         :argument-type actual :argument-types arguments :entry :normal :source-call call :source-edge edge
                                                         :source-node (get source :source-node) :source-form (get source :source-form)
                                                         :compatibility (get compatibility :premise)
                                                         :call-input-facts {:call-core-node-id (get call :core-node-id) :caller-function-syntax-id (get edge :caller-function-syntax-id)
                                                                            :callee-function-syntax-id (get edge :callee-function-syntax-id) :argument-types arguments
                                                                            :evaluation-order :operator-then-arguments
                                                                            :source-span (get call-source :semantic-span) :syntax-id (get call-source :syntax-id)
                                                                            :origin-chain (get call-source :origin-chain) :generated-origin (get call-source :generated-origin)
                                                                            :profile (get (get core :module) :profile) :target (get (get core :module) :target)}})
                                          (+ normal-count 1) total (+ domain-work key-work))
                                        {:status :rejected :reason (if (if (= :private-map-keys-work-limit (get source :reason)) true
                                                                                                      (= :map-parameter-work-limit (get compatibility :reason)))
                                                                 :private-map-keys-work-limit :private-map-keys-source-mismatch) :work-count total}))
                                    {:status :rejected :reason :private-map-keys-entry-domain-required :work-count used})
                                  (recur (rest remaining)
                                    (conj entries {:call-core-node-id (get call :core-node-id) :argument-node-id argument-id :argument-source (get argument :source) :call-source call-source
                                                   :argument-type actual :argument-types arguments :entry :not-invoked :source-call call :source-edge edge :compatibility nil
                                                   :call-input-facts {:call-core-node-id (get call :core-node-id) :caller-function-syntax-id (get edge :caller-function-syntax-id)
                                                                      :callee-function-syntax-id (get edge :callee-function-syntax-id) :argument-types arguments
                                                                      :evaluation-order :operator-then-arguments
                                                                            :source-span (get call-source :semantic-span) :syntax-id (get call-source :syntax-id)
                                                                            :origin-chain (get call-source :origin-chain) :generated-origin (get call-source :generated-origin)
                                                                            :profile (get (get core :module) :profile) :target (get (get core :module) :target)}})
                                    normal-count used domain-work))
                                  {:status :rejected :reason :private-map-keys-source-mismatch :work-count used})
                                {:status :rejected :reason :private-map-keys-entry-domain-required :work-count used})))))))
                  {:status :rejected :reason (get graph :reason) :work-count work}))
              {:status :rejected :reason :private-map-keys-entry-domain-required :work-count work}))
          {:status :rejected :reason (if (= :map-get-work-limit (get reserved :reason)) :private-map-keys-work-limit :private-map-keys-source-mismatch)
           :work-count work}))
      physical)))

(defn p15-s23-pmk-header [core node call edge nodes bindings types forms budget]
  (let [limit (if (> budget 65536) 65536 budget)
        source (p15-s23-pmk-source core node call edge nodes bindings types (get core :module) limit)
        initial (+ 3 (get source :work-count))]
    (if (> initial limit) {:status :rejected :reason :private-map-keys-work-limit :work-count initial}
      (if (= :accepted (get source :status))
        (let [proof (p15-s23-pmk-proof (get source :descriptor) core node nodes bindings types forms (- limit initial))
              work (+ initial (get proof :work-count))]
          (if (= :accepted (get proof :status))
            {:status :accepted :work-count work
             :descriptor (assoc (get source :descriptor) :key-domain-proof (get proof :proof)
                           :key-domain-work (get proof :key-domain-work)
                           :result-type-work 3 :construction-work-basis :one-static-operation-with-separate-existing-runtime-census)}
            (assoc proof :work-count work)))
        (assoc source :work-count initial)))))

(defn p15-s23-pmk-constraint [descriptor]
  {:constraint-id-request {:domain :gravity/sh08-private-map-keys-constraint-v1 :application descriptor}
   :kind :equality :producer-rule :sh08-private-map-keys-v1
   :lhs {:core-node-id (get descriptor :call-core-node-id) :projection :private-map-keys}
   :rhs (get descriptor :result-type) :dependencies descriptor :origin (get (get descriptor :source) :origin-chain)
   :solution {:result-type (get descriptor :result-type) :application (get descriptor :application) :direct-effects (get descriptor :direct-effects)
              :construction-work (get descriptor :construction-work) :allocation-policy (get descriptor :allocation-policy)
              :storage-policy (get descriptor :storage-policy) :key-domain-proof (get descriptor :key-domain-proof)}
   :invalidation (get descriptor :invalidation) :profile (get descriptor :profile) :target (get descriptor :target)
   :status :solved :diagnostics []})

(defn p15-s23-pmk-call-fact [descriptor module]
  (let [source (get descriptor :source) edge (get descriptor :source-edge)]
    {:artifact :gravity/c7-call-type-fact
     :fact-id-request {:domain :gravity/sh08-private-map-keys-call-type-fact-v1 :application descriptor}
     :call-core-node-id (get descriptor :call-core-node-id) :caller-function-syntax-id (get edge :caller-function-syntax-id)
     :callee-function-syntax-id nil :argument-types (get descriptor :argument-types) :result-type (get descriptor :result-type)
     :evaluation-order :operator-then-arguments :source-span (get source :semantic-span) :syntax-id (get source :syntax-id)
     :origin-chain (get source :origin-chain) :generated-origin (get source :generated-origin)
     :profile (get module :profile) :target (get module :target) :effects (get descriptor :direct-effects) :capabilities [] :status :inferred
     :dispatch :direct-private-map-keys :applied-private-map-keys descriptor :effect-facts-source :audited-private-entry-map-key-list-construction}))

(defn p15-s23-pmk-entry? [node call nodes bindings types module]
  (if (p15-s23-mkeys-entry? node call nodes bindings types module)
    (if (if (map? call) (vector? (get call :argument-node-ids)) false)
      (if (p15-s23-sse-ids? (get call :argument-node-ids) 1)
        (let [type (get types (first (get call :argument-node-ids)))]
          (if (keyword? type) (= :gravity.type/map type) false)) false) false) false))

(defn p15-s23-pmk-entry-evidence [core ledger facts descriptor nodes bindings types budget]
  (let [proof (get descriptor :key-domain-proof) entries (get proof :entries)
        census (get proof :census) record (get census :function-record) params (get record :parameter-binding-ids)
        index (get proof :parameter-index)
        callee {:function-id (get record :function-syntax-id) :signature (get record :signature)
                :parameters (loop [i 0 out []]
                              (if (= i (count params)) out
                                (recur (+ i 1) (conj out {:binding-id (get params i) :type (if (= i index) :gravity.type/map :gravity.type/unknown)}))))}
        base (+ 16 (* 4 (count params)))]
    (if (> base budget) {:status :rejected :reason :private-map-keys-work-limit :work-count base}
      (loop [remaining entries used base]
        (if (= 0 (count remaining)) {:status :accepted :work-count used}
          (let [entry (first remaining) id (get entry :call-core-node-id)
                prefix (+ used 32 (* 4 (+ (count ledger) (count facts))) (* 4 (count params)))]
            (if (> prefix budget) {:status :rejected :reason :private-map-keys-work-limit :work-count prefix}
              (let [selected-facts
                    (loop [rows (if (map? facts) (keys facts) facts) out []]
                      (if (= 0 (count rows)) out
                        (let [item (first rows) fact (if (map? facts) (if (p15-s23-sse-ids? [item] 1) (get facts item) nil) item)
                              fact-id (if (map? fact) (get fact :call-core-node-id) nil)]
                          (if (p15-s23-sse-ids? [fact-id] 1)
                            (recur (rest rows) (if (= id fact-id) (conj out fact) out)) nil))))
                    selected-rows
                    (loop [rows ledger out []]
                      (if (= 0 (count rows)) out
                        (let [row (first rows) request (get row :constraint-id-request) domain (get request :domain)]
                          (if (if (map? row) (if (map? request) (keyword? domain) false) false)
                            (if (= :gravity/sh08-function-call-constraint-v1 domain)
                              (let [row-id (get request :call-core-node-id)]
                                (if (p15-s23-sse-ids? [row-id] 1)
                                  (recur (rest rows) (if (= id row-id) (conj out row) out)) nil))
                              (recur (rest rows) out)) nil))))]
                (if (if (vector? selected-facts) (if (vector? selected-rows) (= 1 (count selected-facts) (count selected-rows)) false) false)
                  (let [fact (first selected-facts) row (first selected-rows)
                        metadata (p15-s23-pmk-metadata-work [fact row] (- budget prefix))
                        used (+ prefix (get metadata :work-count))]
                    (if (= :accepted (get metadata :status))
                      (let [call (get entry :source-call) edge (get entry :source-edge) actual (get entry :argument-type)
                            normal? (= :normal (get entry :entry))
                            compatibility (if normal? {:status :accepted :work-count 0 :premise (get entry :compatibility)}
                                            (if (if (map? actual) (= :gravity.type/map (get actual :kind)) false)
                                              (p15-s23-mp-compatibility core call edge callee index actual nodes bindings (- budget used))
                                              {:status :not-applicable :work-count 0}))
                            total (+ used (get compatibility :work-count))
                            pair {:parameter (get params index) :argument actual :chosen :gravity.type/map}
                            pair (if (= :accepted (get compatibility :status)) (assoc pair :compatibility (get compatibility :premise)) pair)
                            call-type (get types id)
                            type-validation (p15-s23-lc-validate-types [call-type])
                            spent total
                            expected-fact (assoc (get entry :call-input-facts)
                                            :artifact :gravity/c7-call-type-fact
                                            :fact-id-request {:domain :gravity/sh08-call-type-fact-v1 :call-core-node-id id
                                                              :callee-function-syntax-id (get record :function-syntax-id)
                                                              :argument-types (get entry :argument-types) :result-type call-type}
                                            :result-type call-type :effects (get (get core :module) :effects)
                                            :capabilities (get (get core :module) :capabilities) :status :inferred)
                            pairs (get row :rhs) kind (get row :kind)]
                        (if (if (> spent budget) true (= :map-parameter-work-limit (get compatibility :reason)))
                          {:status :rejected :reason :private-map-keys-work-limit :work-count spent}
                          (if (p15-s23-typed-all
                                [(= :accepted (get type-validation :status)) (= false (p15-s23-pmk-unknown? call-type))
                                 (= expected-fact fact)
                                 (= {:domain :gravity/sh08-function-call-constraint-v1 :call-core-node-id id
                                     :callee-function-syntax-id (get record :function-syntax-id)} (get row :constraint-id-request))
                                 (= (get record :function-syntax-id) (get row :lhs))
                                 (if (keyword? kind) (contains? #{:equality :argument-compatibility} kind) false)
                                 (if (= :argument-compatibility kind)
                                   (= :sh08-map-list-parameter-compatibility-v1 (get row :compatibility-rule-version)) true)
                                 (vector? pairs) (= (count params) (count pairs))
                                 (= pair (get pairs index))
                                 (if (= :accepted (get compatibility :status)) (= :argument-compatibility kind) (= :gravity.type/never actual))
                                 (= :solved (get row :status)) (= [] (get row :diagnostics))
                                 (= (get (get core :module) :profile) (get row :profile))
                                 (= (get (get core :module) :target) (get row :target))
                                 (= (get (get (get nodes id) :source) :origin-chain) (get row :origin))
                                 (loop [i 0]
                                   (if (= i (count params)) true
                                     (let [pair (get pairs i)]
                                       (if (if (= (get params i) (get pair :parameter))
                                             (= (get (get entry :argument-types) i) (get pair :argument)) false)
                                         (recur (+ i 1)) false))))])
                            (recur (rest remaining) spent)
                            {:status :rejected :reason :private-map-keys-source-mismatch :work-count spent})))
                      {:status :rejected :reason (get metadata :reason) :work-count used}))

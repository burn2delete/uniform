(defn p15-s23-ksm-finish [header]
  (let [type (if (= :normal (get header :application)) :gravity.type/bool :gravity.type/never)]
    (assoc header :parameter-types (get header :argument-types) :return type :result-type type)))

(defn p15-s23-sysm-ledger-ids? [context rows]
  (loop [remaining rows]
    (if (= 0 (count remaining)) true
      (let [id (get (get (first remaining) :lhs) :core-node-id)]
        (if (p15-s23-sse-ids? [id] 1)
          (let [call (get (get context :calls) id) node (get (get context :nodes) id)]
            (if (p15-s23-sysm-source-ids? node call (get context :nodes) (get context :bindings) (get (get context :core) :module))
              (if (= id (get call :core-node-id) (get node :node-id)) (recur (rest remaining)) false) false)) false)))))

(defn p15-s23-typed-compile-keyword-set-contains [context node budget]
  (let [id (get node :node-id) core (get context :core)
        charge (+ 66 (count (get core :function-records)) (* 4 (count (get context :ledger))))]
    (if (< budget charge) (assoc (p15-s23-typed-node-error :typed-lowering-work-limit node) :work-count charge)
      (if (if (p15-s23-sse-ids? [id] 1) (p15-s23-sse-call-ids? node (get (get context :calls) id)) false)
      (let [call (get (get context :calls) id) edge (get (get context :edges) id)
            forms (get context :forms) nodes (get context :nodes)
            owner (get forms (get (get node :source) :form-id)) ids (get owner :child-form-ids)
            args (get call :argument-node-ids)
            domain (if (if (vector? args) (= 2 (count args)) false)
                     (p15-s23-ksm-domain (p15-s23-io-child-types args (get context :types)) (- budget charge))
                     {:status :rejected :work-count 0})
            charge (+ charge (get domain :work-count))
            header (if (= :accepted (get domain :status))
                     (p15-s23-ksm-source core node call edge nodes (get context :bindings) (get context :types) (get core :module) domain) nil)
            descriptor (if (map? header) (p15-s23-ksm-finish header) nil)
            producer-rows (loop [remaining (get context :ledger) out []]
                            (if (= 0 (count remaining)) out
                              (recur (rest remaining)
                                (if (if (keyword? (get (first remaining) :producer-rule)) (contains? #{:sh08-keyword-set-contains-v1 :sh08-character-set-contains-v1 :sh08-string-set-contains-v2 :sh08-symbol-set-contains-v2 :sh08-integer-set-contains-v1} (get (first remaining) :producer-rule)) false)
                                  (conj out (first remaining)) out))))
            producer-ids? (loop [remaining producer-rows]
                            (if (= 0 (count remaining)) true
                              (let [row (first remaining) lhs (get row :lhs)]
                                (if (map? lhs)
                                  (if (if (= 2 (count lhs))
                                        (if (if (keyword? (get lhs :projection)) (contains? #{:keyword-set-contains :character-set-contains :string-set-contains :symbol-set-contains :integer-set-contains} (get lhs :projection)) false)
                                          (let [row-id (get lhs :core-node-id)]
                                            (if (keyword? row-id) true (if (string? row-id) (= 71 (count row-id)) false))) false) false)
                                    (recur (rest remaining)) false) false))))
            rows (if producer-ids?
                   (p15-s23-pe-select producer-rows :lhs {:core-node-id id :projection (if (= :gravity.type/applied-integer-set-contains (get descriptor :kind)) :integer-set-contains
                     (if (= :gravity.type/applied-symbol-set-contains (get descriptor :kind)) :symbol-set-contains
                     (if (= :gravity.type/applied-character-set-contains (get descriptor :kind)) :character-set-contains
                     (if (= :gravity.type/applied-string-set-contains (get descriptor :kind)) :string-set-contains :keyword-set-contains))))}) [])]
        (if (> charge budget) (assoc (p15-s23-typed-node-error :typed-lowering-work-limit node) :work-count charge)
        (if (if (if (map? descriptor) (if (contains? #{:symbol :integer} (get domain :membership-family))
                  (if (p15-s23-ksin-call-forms? node nodes forms) (p15-s23-sysm-ledger-ids? context producer-rows) false) true) false)
              (p15-s23-typed-all
                [(if producer-ids? (loop [remaining producer-rows]
                         (if (= 0 (count remaining)) true
                           (let [row (first remaining) row-id (get (get row :lhs) :core-node-id)
                                 source-call (if (if (keyword? row-id) true (if (string? row-id) (= 71 (count row-id)) false))
                                               (get (get context :calls) row-id) nil)
                                 source-node (if (map? source-call) (get nodes row-id) nil)
                                 source-type (if (if (map? source-call)
                                                   (if (keyword? (get source-call :operator-node-id)) true
                                                     (if (string? (get source-call :operator-node-id)) (= 71 (count (get source-call :operator-node-id))) false)) false)
                                               (get (get context :types) (get source-call :operator-node-id)) nil)]
                             (if (p15-s23-typed-all [(= row-id (get source-call :core-node-id) (get source-node :node-id))
                                   (map? source-call) (map? source-node)
                                   (contains? #{:gravity.type/applied-keyword-set-contains :gravity.type/applied-character-set-contains :gravity.type/applied-string-set-contains :gravity.type/applied-symbol-set-contains :gravity.type/applied-integer-set-contains} (get source-type :kind))
                                   (= source-call (get source-type :source-call))
                                   (= row (p15-s23-ksm-constraint source-type))])
                               (recur (rest remaining)) false)))) false)
                 (= descriptor (get (get context :types) (get call :operator-node-id)))
                 (= (get descriptor :result-type) (get (get context :types) id))
                 (= (get edge :ordinal) (get (get context :call-order) id))
                 (= (get (get context :current-function) :function-syntax-id) (get edge :caller-function-syntax-id))
                 (= [(p15-s23-ksm-constraint descriptor)] rows)
                 (= (p15-s23-ksm-call-fact descriptor (get core :module)) (get (get context :call-facts) id))
                 (= :list (get owner :kind)) (vector? ids) (= 3 (if (vector? ids) (count ids) 0) (count (get node :children)))
                 (= (get node :source) (p15-s23-typed-source owner))
                 (= {:operator-child-index 0 :argument-count 2 :argument-child-indexes [1 2]
                     :evaluation-order :operator-then-arguments :dispatch :resolved-symbol-call} (get node :attributes))
                 (loop [i 0]
                   (if (= i 3) true
                     (let [form (get forms (get ids i)) child (get nodes (get (get node :children) i))]
                       (if (p15-s23-typed-all [(= (get owner :form-id) (get form :parent-form-id))
                             (= (get child :source) (p15-s23-typed-source form))
                             (if (= i 0) (= (get form :value) (get (get child :attributes) :symbol)) true)])
                         (recur (+ i 1)) false))))]) false)
          (loop [remaining args values [] used charge]
            (if (= 0 (count remaining))
              (assoc (p15-s23-compiler-result {:op :builtin-call :function 'contains? :args values}) :work-count used)
              (if (>= used budget)
                (assoc (p15-s23-typed-node-error :typed-lowering-work-limit node) :work-count (+ used 1))
                (let [compiled (p15-s23-typed-compile-node (assoc context :tail? false) (first remaining) (- budget used))
                      total (+ used (get compiled :work-count 1))]
                  (if (p15-s23-compiler-complete? compiled)
                    (recur (rest remaining) (conj values (get compiled :value)) total)
                    (assoc compiled :work-count total))))))
          (assoc (p15-s23-typed-node-error (if (= :integer (get domain :membership-family)) :unsupported-or-mismatched-typed-integer-set-contains
                     (if (= :symbol (get domain :membership-family)) :unsupported-or-mismatched-typed-symbol-set-contains
                             (if (= :character (get domain :membership-family)) :unsupported-or-mismatched-typed-character-set-contains
                             (if (= :string (get domain :membership-family)) :unsupported-or-mismatched-typed-string-set-contains :unsupported-or-mismatched-typed-keyword-set-contains)))) node) :work-count charge))))
      (assoc (p15-s23-typed-node-error :typed-set-contains-source-identities-required node) :work-count charge)))))

(defn p15-s23-mc-source [core node call edge nodes bindings types module]
  (if (if (vector? (get call :argument-node-ids)) (vector? (get node :children)) false)
  (let [children (get node :children) operator (get nodes (get call :operator-node-id))
        bid (get call :operator-binding-id) binding (get bindings bid) args (get call :argument-node-ids)
        arguments (p15-s23-io-child-types args types)
        invoked? (loop [remaining arguments]
                   (if (= 0 (count remaining)) true
                     (if (= :gravity.type/never (first remaining)) false (recur (rest remaining)))))
        caller (loop [remaining (get core :function-records)]
                 (if (= 0 (count remaining)) nil
                   (if (= (get (first remaining) :function-syntax-id) (get (get node :evaluation) :owner-function-syntax-id))
                     (first remaining) (recur (rest remaining)))))
        expected-call {:core-node-id (get node :node-id) :operator-node-id (first children) :operator-binding-id bid
                       :argument-node-ids (vec (rest children)) :ordered-evaluation-node-ids children
                       :evaluation-order :operator-then-arguments :result-policy :call-result}
        expected-edge {:ordinal (get edge :ordinal) :call-core-node-id (get node :node-id)
                       :caller-function-syntax-id (get caller :function-syntax-id) :caller-function-core-node-id (get caller :function-core-node-id)
                       :callee-binding-id bid :callee-definition-syntax-id (get binding :definition-syntax-id)
                       :callee-function-syntax-id nil :callee-function-core-node-id nil :argument-core-node-ids args
                       :ordered-evaluation-node-ids children :evaluation-order :operator-then-arguments :classification :nonlocal-or-nonfunction}]
    (if (p15-s23-typed-all
          [(= :call (get node :core-form)) (= :reference (get operator :core-form))
           (= 2 (count args)) (= expected-call call) (= expected-edge edge) (p15-s23-mc-binding? binding module)
           (= [bid] (get node :resolved-binding-ids) (get operator :resolved-binding-ids))
           (= {:symbol (get (get operator :attributes) :symbol) :position :operator :binding-id bid :binding-class :core
               :definition-syntax-id (get binding :definition-syntax-id)} (get operator :attributes))
           (contains? '#{contains? gravity.core/contains?} (get (get operator :attributes) :symbol))
           (= :operator-then-arguments (get (get node :evaluation) :kind))
           (= (loop [i 0 out []] (if (= i (count children)) out
                (recur (+ i 1) (conj out {:index i :core-node-id (get children i)})))) (get (get node :evaluation) :order))
           (if (= :gravity.type/never (first arguments)) true
             (= :gravity.type/map (if (map? (first arguments)) (get (first arguments) :kind) (first arguments))))
           (contains? #{:gravity.type/string :gravity.type/keyword :gravity.type/never} (get arguments 1))
           (loop [remaining arguments]
             (if (= 0 (count remaining)) true
               (if (contains? #{nil :gravity.type/unknown} (first remaining)) false (recur (rest remaining)))))] )
      {:kind :gravity.type/applied-map-contains :version :sh08-map-contains-v1
       :operation 'contains? :semantic-owner 'gravity.collections :intrinsic :gravity.collections/map-membership
       :resolution :gravity.core-compatibility :operator-node-id (get operator :node-id) :operator-binding-id bid
       :call-core-node-id (get node :node-id) :source (get node :source) :operator-source (get operator :source)
       :source-call call :source-edge edge :source-binding binding :argument-types arguments
       :membership-policy {:input :established-map :keys [:string :keyword] :key-equality :value
                           :presence :independent-of-value :normalization :none :coercion :none
                           :operand-evaluation :map-then-key-once :values :unobserved}
       :application (if invoked? :normal :not-invoked)
       :latent-effects [] :direct-effects [] :capabilities [] :thrown-error-effects []
       :profile (get module :profile) :target (get module :target)
       :invalidation [:calls :call-edges :binding-table :source-forms :type-table :lexical-bindings :definitions :function-records
                      :callee-body :map-type :key-domain :membership-policy :profile :target :evaluation-order]} nil)) nil))

(defn p15-s23-mc-constraint [descriptor]
  {:constraint-id-request {:domain :gravity/sh08-map-contains-constraint-v1 :application descriptor}
   :kind :equality :producer-rule :sh08-map-contains-v1
   :lhs {:core-node-id (get descriptor :call-core-node-id) :projection :map-contains}
   :rhs (get descriptor :result-type) :dependencies descriptor :origin (get (get descriptor :source) :origin-chain)
   :solution {:result-type (get descriptor :result-type) :application (get descriptor :application)
              :direct-effects (get descriptor :direct-effects)}
   :invalidation (get descriptor :invalidation) :profile (get descriptor :profile) :target (get descriptor :target)
   :status :solved :diagnostics []})

(defn p15-s23-mc-call-fact [descriptor module]
  (let [source (get descriptor :source) edge (get descriptor :source-edge)]
    {:artifact :gravity/c7-call-type-fact
     :fact-id-request {:domain :gravity/sh08-map-contains-call-type-fact-v1 :application descriptor}
     :call-core-node-id (get descriptor :call-core-node-id) :caller-function-syntax-id (get edge :caller-function-syntax-id)
     :callee-function-syntax-id nil :argument-types (get descriptor :argument-types) :result-type (get descriptor :result-type)
     :evaluation-order :operator-then-arguments :source-span (get source :semantic-span) :syntax-id (get source :syntax-id)
     :origin-chain (get source :origin-chain) :generated-origin (get source :generated-origin)
     :profile (get module :profile) :target (get module :target) :effects (get descriptor :direct-effects) :capabilities [] :status :inferred
     :dispatch :direct-map-contains :applied-map-contains descriptor :effect-facts-source :audited-collection-intrinsic}))


(defn p15-s23-mc-finish [header]
  (let [type (if (= :normal (get header :application)) :gravity.type/bool :gravity.type/never)]
    (assoc header :parameter-types (get header :argument-types) :return type :result-type type)))

(defn p15-s23-typed-compile-contains [context node budget]
  (let [id (get node :node-id) core (get context :core)
        charge (+ 66 (count (get core :function-records)))]
    (if (< budget charge) (p15-s23-typed-node-error :typed-lowering-work-limit node)
      (let [call (get (get context :calls) id) edge (get (get context :edges) id)
            forms (get context :forms) nodes (get context :nodes)
            owner (get forms (get (get node :source) :form-id)) ids (get owner :child-form-ids)
            header (p15-s23-mc-source core node call edge nodes (get context :bindings) (get context :types) (get core :module))
            descriptor (if (map? header) (p15-s23-mc-finish header) nil)
            rows (loop [remaining (get context :ledger) out []]
                   (if (= 0 (count remaining)) out
                     (let [row (first remaining)]
                       (recur (rest remaining)
                         (if (if (= :sh08-map-contains-v1 (get row :producer-rule))
                               (= {:core-node-id id :projection :map-contains} (get row :lhs)) false) (conj out row) out)))))]
        (if (if (map? descriptor)
              (p15-s23-typed-all
                [(= descriptor (get (get context :types) (get call :operator-node-id)))
                 (= (get descriptor :result-type) (get (get context :types) id))
                 (= (get edge :ordinal) (get (get context :call-order) id))
                 (= (get (get context :current-function) :function-syntax-id) (get edge :caller-function-syntax-id))
                 (= [(p15-s23-mc-constraint descriptor)] rows)
                 (= (p15-s23-mc-call-fact descriptor (get core :module)) (get (get context :call-facts) id))
                 (= :list (get owner :kind)) (vector? ids) (= 3 (if (vector? ids) (count ids) 0) (count (get node :children)))
                 (= (get node :source) (p15-s23-typed-source owner))
                 (= {:operator-child-index 0 :argument-count 2 :argument-child-indexes [1 2]
                     :evaluation-order :operator-then-arguments :dispatch :resolved-symbol-call} (get node :attributes))
                 (loop [i 0]
                   (if (= i 3) true
                     (let [form (get forms (get ids i)) child (get nodes (get (get node :children) i))]
                       (if (p15-s23-typed-all [(= (get owner :form-id) (get form :parent-form-id))
                             (= (get child :source) (p15-s23-typed-source form))
                             (if (= i 0) (= (get form :value) (get (get child :attributes) :symbol)) true)])
                         (recur (+ i 1)) false))))]) false)
          (let [compiled (p15-s23-typed-compile-children context (get call :argument-node-ids) (- budget charge) [])]
            (if (p15-s23-compiler-complete? compiled)
              (assoc (p15-s23-compiler-result {:op :builtin-call :function 'contains? :args (get compiled :value)})
                :work-count (+ charge (get compiled :work-count))) compiled))
          (p15-s23-typed-node-error :unsupported-or-mismatched-typed-map-contains node))))))

(defn p15-s23-st-type-work [arguments budget]
  (if (< budget 1) {:status :rejected :reason :work-limit :work-count 1}
    (if (if (vector? arguments) (= 1 (count arguments)) false)
      (let [type (first arguments)]
        (if (= :gravity.type/never type) {:status :accepted :input-element-count nil :work-count 1}

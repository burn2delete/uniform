    {:artifact :gravity/c7-call-type-fact
     :fact-id-request {:domain :gravity/sh08-nonnegative-integer-quotient-call-type-fact-v1 :application descriptor}
     :call-core-node-id (get descriptor :call-core-node-id) :caller-function-syntax-id (get edge :caller-function-syntax-id)
     :callee-function-syntax-id nil :argument-types (get descriptor :argument-types) :result-type (get descriptor :result-type)
     :evaluation-order :operator-then-arguments :source-span (get source :semantic-span) :syntax-id (get source :syntax-id)
     :origin-chain (get source :origin-chain) :generated-origin (get source :generated-origin)
     :profile (get module :profile) :target (get module :target) :effects (get descriptor :direct-effects) :capabilities [] :status :inferred
     :dispatch :direct-nonnegative-integer-quotient :applied-nonnegative-integer-quotient descriptor :effect-facts-source :audited-numeric-intrinsic}))

(defn p15-s23-nq-finish [header]
  (let [type (if (= :normal (get header :application)) :gravity.type/integer :gravity.type/never)]
    (assoc header :parameter-types (get header :argument-types) :return type :result-type type)))

(defn p15-s23-typed-compile-nonnegative-integer-quotient [context node budget]

  (if (p15-s23-sse-ids? [(get node :node-id) (get (get node :source) :form-id)] 2)
    (let [id (get node :node-id) core (get context :core)
        charge (+ 66 (count (get core :function-records))
                  (* 8 (+ (count (get context :ledger)) (count (get context :call-facts)))))]
    (if (< budget charge) (assoc (p15-s23-typed-node-error :typed-lowering-work-limit node) :work-count charge)
      (let [call (get (get context :calls) id) edge (get (get context :edges) id)
            forms (get context :forms) nodes (get context :nodes)
            owner (get forms (get (get node :source) :form-id)) ids (get owner :child-form-ids)
            checked (p15-s23-nq-proof core node call nodes (get context :bindings) (get context :types) forms (- budget charge))
            charge (+ charge (get checked :work-count))
            header (if (= :accepted (get checked :status))
                     (p15-s23-nq-source core node call edge nodes (get context :bindings) (get context :types)
                       (get core :module) (get checked :proof)) nil)
            descriptor (if (map? header) (p15-s23-nq-finish header) nil)
            rows (loop [remaining (get context :ledger) out []]
                   (if (= 0 (count remaining)) out
                     (let [row (first remaining)]
                       (recur (rest remaining)
                         (if (if (= :sh08-nonnegative-integer-quotient-v1 (get row :producer-rule))
                               (= {:core-node-id id :projection :nonnegative-integer-quotient} (get row :lhs)) false) (conj out row) out)))))]
        (if (> charge budget)
          (assoc (p15-s23-typed-node-error :typed-lowering-work-limit node) :work-count charge)
          (if (if (map? descriptor)
              (p15-s23-typed-all
                [(let [dividend (get (get checked :proof) :dividend)]
                   (if (= :authenticated-cardinality (get dividend :kind))
                     (let [counted (get dividend :descriptor) count-id (get counted :call-core-node-id)
                           count-rows (loop [remaining (get context :ledger) out []]
                                        (if (= 0 (count remaining)) out
                                          (let [row (first remaining)]
                                            (recur (rest remaining)
                                              (if (if (= :sh08-collection-count-v1 (get row :producer-rule))
                                                    (= {:core-node-id count-id :projection :collection-cardinality} (get row :lhs)) false)
                                                (conj out row) out)))))]
                       (if (= [(p15-s23-cq-constraint counted)] count-rows)
                         (= (p15-s23-cq-call-fact counted (get core :module)) (get (get context :call-facts) count-id)) false)) true))
                 (= descriptor (get (get context :types) (get call :operator-node-id)))
                 (= (get descriptor :result-type) (get (get context :types) id))
                 (= (get edge :ordinal) (get (get context :call-order) id))
                 (= (get (get context :current-function) :function-syntax-id) (get edge :caller-function-syntax-id))
                 (= [(p15-s23-nq-constraint descriptor)] rows)
                 (= (p15-s23-nq-call-fact descriptor (get core :module)) (get (get context :call-facts) id))
                 (= :list (get owner :kind)) (vector? ids) (= 3 (if (vector? ids) (count ids) 0) (count (get node :children)))
                 (= (get node :source) (p15-s23-typed-source owner))
                 (= {:operator-child-index 0 :argument-count 2 :argument-child-indexes [1 2]
                     :evaluation-order :operator-then-arguments :dispatch :resolved-symbol-call} (get node :attributes))
                 (loop [i 0]
                   (if (= i 3) true
                     (let [form (get forms (get ids i)) child (get nodes (get (get node :children) i))]
                       (if (p15-s23-typed-all [(= (get owner :form-id) (get form :parent-form-id))
                             (= (get child :source) (p15-s23-typed-source form))
                             (if (= i 0) (= (get form :value) (get (get child :attributes) :symbol)) true)])
                         (recur (+ i 1)) false))))]) false)
          (let [compiled (p15-s23-typed-compile-children context (get call :argument-node-ids) (- budget charge) [])]
            (if (p15-s23-compiler-complete? compiled)
              (assoc (p15-s23-compiler-result {:op :builtin-call :function 'quot :args (get compiled :value)})
                :work-count (+ charge (get compiled :work-count))) (assoc compiled :work-count (+ charge (get compiled :work-count 0)))))
          (assoc (p15-s23-typed-node-error :unsupported-or-mismatched-typed-nonnegative-integer-quotient node) :work-count charge))))))
    (assoc (p15-s23-typed-node-error :unsupported-or-mismatched-typed-nonnegative-integer-quotient {}) :work-count 1)))

(defn p15-s23-si-binding? [binding module]
  (if (if (vector? (get binding :profile-set)) (vector? (get binding :target-set)) false)
  (p15-s23-typed-all
    [(contains? '#{inc +} (get binding :name))
     (= [(get binding :name) :core :var 'gravity.core {:name 'gravity/core :version "bootstrap-contract-v1"} :gravity.type/core-var :safe]
        [(get binding :name) (get binding :binding-class) (get binding :kind) (get binding :namespace)
         (get binding :package) (get binding :type-ref) (get binding :safety)])
     (= [] (get binding :effects) (get binding :capabilities))
     (contains? (set (get binding :profile-set)) (get module :profile))
     (contains? (set (get binding :target-set)) :all)]) false))

(defn p15-s23-si-source [core node call edge nodes bindings types module]
  (if (if (vector? (get call :argument-node-ids)) (vector? (get node :children)) false)
  (let [children (get node :children) operator (get nodes (get call :operator-node-id))
        bid (get call :operator-binding-id) binding (get bindings bid) args (get call :argument-node-ids)
        addition? (= '+ (get binding :name))
        unit (get nodes (get args 1))
        arguments (p15-s23-io-child-types args types)
        invoked? (loop [remaining arguments]
                   (if (= 0 (count remaining)) true
                     (if (= :gravity.type/never (first remaining)) false (recur (rest remaining)))))
        caller (loop [remaining (get core :function-records)]
                 (if (= 0 (count remaining)) nil
                   (if (= (get (first remaining) :function-syntax-id) (get (get node :evaluation) :owner-function-syntax-id))
                     (first remaining) (recur (rest remaining)))))
        expected-call {:core-node-id (get node :node-id) :operator-node-id (first children) :operator-binding-id bid
                       :argument-node-ids (vec (rest children)) :ordered-evaluation-node-ids children
                       :evaluation-order :operator-then-arguments :result-policy :call-result}
        expected-edge {:ordinal (get edge :ordinal) :call-core-node-id (get node :node-id)
                       :caller-function-syntax-id (get caller :function-syntax-id) :caller-function-core-node-id (get caller :function-core-node-id)
                       :callee-binding-id bid :callee-definition-syntax-id (get binding :definition-syntax-id)
                       :callee-function-syntax-id nil :callee-function-core-node-id nil :argument-core-node-ids args
                       :ordered-evaluation-node-ids children :evaluation-order :operator-then-arguments :classification :nonlocal-or-nonfunction}]
    (if (p15-s23-typed-all
          [(= :call (get node :core-form)) (= :reference (get operator :core-form))
           (= (if addition? 2 1) (count args)) (= expected-call call) (= expected-edge edge) (p15-s23-si-binding? binding module)
           (= [bid] (get node :resolved-binding-ids) (get operator :resolved-binding-ids))
           (= {:symbol (get (get operator :attributes) :symbol) :position :operator :binding-id bid :binding-class :core
               :definition-syntax-id (get binding :definition-syntax-id)} (get operator :attributes))
           (contains? (if addition? '#{+ gravity.core/+} '#{inc gravity.core/inc}) (get (get operator :attributes) :symbol))
           (= :operator-then-arguments (get (get node :evaluation) :kind))
           (= (loop [i 0 out []] (if (= i (count children)) out
                (recur (+ i 1) (conj out {:index i :core-node-id (get children i)})))) (get (get node :evaluation) :order))
           (= :gravity.type/integer (first arguments))
           (if addition? (if (= :gravity.type/integer (second arguments))
             (if (= :literal (get unit :core-form))
               (if (= :integer (get (get unit :attributes) :literal-kind))
                 (if (= 1 (get (get unit :attributes) :value)) (= [] (get unit :children)) false) false) false) false) true)
           (loop [remaining arguments]
             (if (= 0 (count remaining)) true
               (if (contains? #{nil :gravity.type/unknown} (first remaining)) false (recur (rest remaining)))))] )
      {:kind (if addition? :gravity.type/applied-bounded-unit-addition :gravity.type/applied-bounded-successor)
       :version (if addition? :sh08-bounded-unit-addition-v1 :sh08-bounded-successor-v1)
       :operation (if addition? '+ 'inc) :semantic-owner 'gravity.math
       :intrinsic (if addition? :gravity.math.core/bounded-unit-addition :gravity.math.core/bounded-successor)
       :resolution :gravity.core-compatibility :operator-node-id (get operator :node-id) :operator-binding-id bid
       :call-core-node-id (get node :node-id) :source (get node :source) :operator-source (get operator :source)
       :source-call call :source-edge edge :source-binding binding :argument-types arguments
       :numeric-mode :proof-required :layer0-owner 'gravity.math.core
       :successor-semantics {:operation (if addition? :integer-binary-unit-addition :integer-unit-successor) :construction :none
                             :operand-evaluation (if addition? :left-then-right-once :once)
                             :normal-input (if addition? :invariant-bounded-integer-and-literal-one :invariant-bounded-integer)}
       :application :normal
       :latent-effects [] :direct-effects [] :capabilities [] :thrown-error-effects []
       :profile (get module :profile) :target (get module :target)
       :invalidation [:calls :call-edges :binding-table :source-forms :type-table :lexical-bindings :definitions :function-records
                      :loop-bindings :recur-targets :recur-transfers :callee-body :profile :target :evaluation-order]} nil)) nil))

(defn p15-s23-si-constraint [descriptor]
  {:constraint-id-request {:domain (if (= :sh08-indexed-private-self-unit-addition-v1 (get descriptor :version))
                     :gravity/sh08-indexed-private-self-unit-addition-constraint-v1
                   (if (= :sh08-bounded-unit-addition-v1 (get descriptor :version))
                     :gravity/sh08-bounded-unit-addition-constraint-v1
                     (if (= :sh08-bounded-successor-v2 (get descriptor :version))
                       :gravity/sh08-bounded-successor-constraint-v2 :gravity/sh08-bounded-successor-constraint-v1))) :application descriptor}
   :kind :numeric-mode :producer-rule (get descriptor :version)
   :lhs {:core-node-id (get descriptor :call-core-node-id) :projection (if (= :gravity.type/applied-bounded-unit-addition (get descriptor :kind)) :numeric-unit-addition :numeric-successor)}
   :rhs (get descriptor :result-type) :dependencies descriptor :origin (get (get descriptor :source) :origin-chain)
   :solution {:result-type (get descriptor :result-type) :application (get descriptor :application)
              :direct-effects (get descriptor :direct-effects) :range-proof (get descriptor :range-proof)
              :numeric-mode (get descriptor :numeric-mode)}
   :invalidation (get descriptor :invalidation) :profile (get descriptor :profile) :target (get descriptor :target)
   :status :solved :diagnostics []})

(defn p15-s23-si-call-fact [descriptor module]
  (let [source (get descriptor :source) edge (get descriptor :source-edge)]
    {:artifact :gravity/c7-call-type-fact
     :fact-id-request {:domain (if (= :sh08-indexed-private-self-unit-addition-v1 (get descriptor :version))
                     :gravity/sh08-indexed-private-self-unit-addition-call-type-fact-v1
                   (if (= :sh08-bounded-unit-addition-v1 (get descriptor :version))
                   :gravity/sh08-bounded-unit-addition-call-type-fact-v1
                   (if (= :sh08-bounded-successor-v2 (get descriptor :version))
                     :gravity/sh08-bounded-successor-call-type-fact-v2 :gravity/sh08-bounded-successor-call-type-fact-v1))) :application descriptor}
     :call-core-node-id (get descriptor :call-core-node-id) :caller-function-syntax-id (get edge :caller-function-syntax-id)
     :callee-function-syntax-id nil :argument-types (get descriptor :argument-types) :result-type (get descriptor :result-type)
     :evaluation-order :operator-then-arguments :source-span (get source :semantic-span) :syntax-id (get source :syntax-id)
     :origin-chain (get source :origin-chain) :generated-origin (get source :generated-origin)
     :profile (get module :profile) :target (get module :target) :effects (get descriptor :direct-effects) :capabilities [] :status :inferred
     :dispatch (if (= :gravity.type/applied-bounded-unit-addition (get descriptor :kind)) :direct-bounded-unit-addition :direct-bounded-successor)
     (if (= :gravity.type/applied-bounded-unit-addition (get descriptor :kind)) :applied-bounded-unit-addition :applied-bounded-successor) descriptor :effect-facts-source :audited-numeric-intrinsic}))

(defn p15-s23-si-finish [header]
  (let [type (if (= :normal (get header :application)) :gravity.type/integer :gravity.type/never)]
    (assoc header
      :version (if (= :gravity.type/applied-bounded-unit-addition (get header :kind))
                 (if (= :sh08-indexed-private-self-range-v1 (get (get header :range-proof) :version))
                   :sh08-indexed-private-self-unit-addition-v1 :sh08-bounded-unit-addition-v1)
                 (if (= :sh08-bounded-unit-step-v2 (get (get header :range-proof) :version))
                   :sh08-bounded-successor-v2 :sh08-bounded-successor-v1))
      :parameter-types (get header :argument-types) :return type :result-type type)))

(defn p15-s23-si-record [records field value]
  (loop [remaining records found nil]
    (if (= 0 (count remaining)) found
      (if (= value (get (first remaining) field))
        (if (= found nil) (recur (rest remaining) (first remaining)) nil)
        (recur (rest remaining) found)))))

(defn p15-s23-si-origin-closed? [origin operand expected core nodes types]
  (let [links (get origin :binding-links) extent (get origin :extent) constructor (get origin :node)]
    (if (if (vector? links) (<= (count links) 128) false)
      (if (p15-s23-typed-all [(= :gravity.type/vector (get expected :kind)) (vector? (get expected :element-types))
             (= extent (count (get expected :element-types))) (if (integer? extent) (<= 0 extent 1024) false)
             (= expected (get origin :type)) (= constructor (get nodes (get constructor :node-id)))
             (contains? #{:collection-literal :quote} (get constructor :core-form))
             (= (get constructor :source) (p15-s23-typed-source (get origin :source-form)))
             (if (= :collection-literal (get constructor :core-form))
               (if (vector? (get (get origin :source-form) :child-form-ids))
                 (= extent (count (get constructor :children)) (get (get constructor :attributes) :element-count)
                    (count (get (get origin :source-form) :child-form-ids))) false) true)])
        (loop [id operand index (- (count links) 1)]
          (if (< index 0) (= id (get constructor :node-id))
            (let [record (get links index) node (get nodes id) bid (get record :binding-id)]
              (if (p15-s23-typed-all [(= :reference (get node :core-form))
                     (= bid (get (get node :attributes) :binding-id)) (= [bid] (get node :resolved-binding-ids))
                     (= expected (get types id)) (= :immutable (get record :mutability))
                     (= record (p15-s23-si-record (get core :lexical-bindings) :binding-id bid))])
                (recur (get record :initializer-node-id) (- index 1)) false)))) false) false)))

(defn p15-s23-si-step-source-valid? [record header nodes]
  (if (if (map? record) (map? header) false)
    (let [call (get header :source-call) operation (get header :operation)
          unit (get nodes (get (get call :argument-node-ids) 1)) source (get record :unit-source)]
      (if (= operation 'inc)
        (= record {:operation-core-node-id (get call :core-node-id) :operation 'inc :unit-node nil :unit-source nil})
        (if (if (= operation '+) (map? source) false)
          (p15-s23-typed-all
            [(= record {:operation-core-node-id (get call :core-node-id) :operation '+ :unit-node unit :unit-source source})
             (= :literal (get unit :core-form)) (= [] (get unit :children))
             (= :integer (get (get unit :attributes) :literal-kind) (get source :kind))
             (= 1 (get (get unit :attributes) :value) (get source :value))
             (= (get unit :source) (p15-s23-typed-source source))
             (= (get (get header :source) :form-id) (get source :parent-form-id))
             (= [] (get source :child-form-ids))]) false))) false))

(defn p15-s23-si-step-forms-valid? [proof core nodes forms]
  (if (= :sh08-bounded-unit-step-v2 (get proof :version))
    (let [records (get proof :step-sources) incoming (get proof :incoming-transfers)
          actual (get core :recur-transfers)]
      (if (if (vector? records)
            (if (vector? incoming)
              (if (vector? actual)
                (if (> (count records) 0)
                  (if (<= (count records) (count actual)) (= (count records) (count incoming)) false) false) false) false) false)
        (loop [remaining records]
          (if (= 0 (count remaining)) true
            (let [record (first remaining) node (get nodes (get record :operation-core-node-id))
                  children (get node :children) owner (get forms (get (get node :source) :form-id))
                  ids (get owner :child-form-ids) addition? (= '+ (get record :operation))
                  unit (get nodes (get children 2)) source (get forms (get (get unit :source) :form-id))]
              (if (if (vector? children) (vector? ids) false)
                (if (p15-s23-typed-all
                      [(contains? '#{inc +} (get record :operation))
                       (= (if addition? 3 2) (count children) (count ids))
                       (= :list (get owner :kind)) (= (get node :source) (p15-s23-typed-source owner))
                       (if addition? (p15-s23-typed-all [(= source (get record :unit-source))
                         (= unit (get record :unit-node)) (= :integer (get source :kind))
                         (= 1 (get source :value) (get (get unit :attributes) :value))]) true)
                       (loop [i 0]
                         (if (= i (count children)) true
                           (let [child (get nodes (get children i)) form (get forms (get ids i))]
                             (if (p15-s23-typed-all [(= (get owner :form-id) (get form :parent-form-id))
                                   (= (get child :source) (p15-s23-typed-source form))
                                   (if (= i 0) (= (get form :value) (get (get child :attributes) :symbol)) true)])
                               (recur (+ i 1)) false))))])
                  (recur (rest remaining)) false) false))))
        false))
    (= :sh08-bounded-successor-v1 (get proof :version))))

(defn p15-s23-si-proof-closed? [proof core node nodes bindings types]
  ; Finite consumers check the canonical premise links and arithmetic clause,
  ; not a caller-provided acceptance flag or a second range-analysis worklist.
  (let [target (p15-s23-si-record (get core :recur-targets) :target-id (get (get proof :target) :target-id))
        bid (first (get target :binding-ids)) slot (p15-s23-si-record (get core :loop-bindings) :binding-id bid)
        owner (get nodes (get target :owner-core-node-id)) initializer (get nodes (get slot :initializer-node-id))
        branch (get nodes (get (get owner :children) 1)) test (get nodes (first (get branch :children)))
        calls (p15-s23-typed-index (get core :calls) :core-node-id) edges (p15-s23-typed-index (get core :call-edges) :call-core-node-id)
        guard-call (get calls (get test :node-id)) guard-args (get guard-call :argument-node-ids)
        count-node (get nodes (get guard-args 1)) count-call (get calls (get count-node :node-id))
        count-header (p15-s23-cq-source core count-node count-call (get edges (get count-node :node-id)) nodes bindings types (get core :module))
        guard (p15-s23-io-descriptor core test guard-call (get edges (get test :node-id)) nodes bindings types (get core :module))
        expected (first (get count-header :argument-types)) extent (if (vector? (get expected :element-types)) (count (get expected :element-types)) nil)
        incoming (loop [remaining (get core :recur-transfers) out []]
                   (if (= 0 (count remaining)) out
                     (recur (rest remaining) (if (= (get target :target-id) (get (first remaining) :target-id)) (conj out (first remaining)) out))))
        extended? (loop [remaining incoming]
                    (if (= 0 (count remaining)) false
                      (let [call (get calls (first (get (first remaining) :argument-node-ids)))]
                        (if (= '+ (get (get bindings (get call :operator-binding-id)) :name)) true (recur (rest remaining))))))
        steps (get proof :step-sources)
        paths (get proof :backedge-paths) origin (get proof :vector-origin)
        true-id (get (get branch :children) 1) exit-id (get (get branch :children) 2)
        initial-source (get proof :initializer-source)]
    (if (if (map? count-header) (if (map? guard) (if (integer? extent) (vector? paths) false) false) false)
      (p15-s23-typed-all [(= :loop (get target :target-kind)) (= 1 (get target :arity)) (= 2 (count (get owner :children)))
        (= 0 (get (get initializer :attributes) :value) (get initial-source :value))
        (= :literal (get initializer :core-form)) (= :integer (get (get initializer :attributes) :literal-kind) (get initial-source :kind))
        (= (get initializer :source) (p15-s23-typed-source initial-source))
        (= :if (get branch :core-form)) (= 3 (count (get branch :children))) (= '< (get guard :operation))
        (= :normal (get count-header :application) (get guard :application))
        (= :reference (get (get nodes (first guard-args)) :core-form) (get (get nodes exit-id) :core-form))
        (= bid (get (get (get nodes (first guard-args)) :attributes) :binding-id) (get (get (get nodes exit-id) :attributes) :binding-id))
        (= :gravity.type/integer (get types (first guard-args)) (get types exit-id))
        (= :vector (get (get (get origin :node) :attributes) :literal-kind :vector))
        (p15-s23-si-origin-closed? origin (first (get count-call :argument-node-ids)) expected core nodes types)
        (> (count incoming) 0) (= (count incoming) (count paths))
        (if extended? (if (vector? steps) (= (count incoming) (count steps)) false) (= nil steps))
        (loop [index 0 found false]
          (if (= index (count incoming)) found
            (let [transfer (get incoming index) increment-id (first (get transfer :argument-node-ids))
                  increment (get nodes increment-id) call (get calls increment-id)
                  header (p15-s23-si-source core increment call (get edges increment-id) nodes bindings types (get core :module))
                  path (get paths index)]
              (if (if (vector? path)
                    (if (if (> (count path) 0) (<= (count path) 129) false)
                      (p15-s23-typed-all [(map? header) (if extended? (p15-s23-si-step-source-valid? (get steps index) header nodes) true)
                     (= 1 (count (get transfer :argument-node-ids)))
                     (= (get transfer :recur-core-node-id) (get (get (first path) :node) :node-id))
                     (= true-id (get (get (get path (- (count path) 1)) :node) :node-id))
                     (= increment-id (get (get (get (first path) :node) :children) 0))
                     (= bid (get (get (get nodes (first (get call :argument-node-ids))) :attributes) :binding-id))
                     (loop [i 0]
                       (if (= i (count path)) true
                         (let [entry (get path i) actual (get entry :node)]
                           (if (if (= actual (get nodes (get actual :node-id)))
                                 (if (= i 0) (= nil (get entry :child-index))
                                   (= (get (get (get path (- i 1)) :node) :node-id)
                                      (get (get actual :children) (get entry :child-index)))) false)
                             (recur (+ i 1)) false))))]) false) false)
                (recur (+ index 1) (if (= increment-id (get node :node-id)) true found)) false))))
        (= proof (let [expected {:kind :gravity.safety/bounded-integer-successor
          :version (if extended? :sh08-bounded-unit-step-v2 :sh08-bounded-successor-v1)

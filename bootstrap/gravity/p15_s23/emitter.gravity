                         (if (= (get callee :function-id) (get (first remaining) :function-syntax-id))
                           (first remaining) (recur (rest remaining))))))
            declaration (get (get (get record :signature) :parameters) index)
            bid (get parameter :binding-id) binding (get bindings bid)
            type-binding (get bindings (get declaration :type-binding-id))
            argument-id (get (get call :argument-node-ids) index) argument (get nodes argument-id)
            node (get nodes (get call :core-node-id))]

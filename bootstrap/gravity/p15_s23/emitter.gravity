                   (if (= :gravity.type/applied-vector-get (get descriptor :kind))
                     :unsupported-or-mismatched-typed-vector-get :unsupported-or-mismatched-typed-vector-nth) node)
                 :work-count charge))))))

))

(defn p15-s23-typed-compile-nth [context node budget]

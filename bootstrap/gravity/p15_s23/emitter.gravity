(defn p15-s23-pl-finish [header]
  (assoc header :parameter-types (get header :argument-types) :return (get header :result-type)))

(defn p15-s23-ksin-ledger-ids? [context]
  (loop [remaining (get context :ledger)]
    (if (= 0 (count remaining)) true
      (let [row (first remaining) producer (get row :producer-rule)]
        (if (if (keyword? producer) (contains? #{:sh08-vector-append-v1 :sh08-list-prepend-v1 :sh08-string-set-insertion-v2 :sh08-keyword-set-insertion-v1 :sh08-symbol-set-insertion-v2} producer) false)
          (let [lhs (get row :lhs) id (get lhs :core-node-id)]
            (if (if (map? lhs) (if (= 2 (count lhs)) (p15-s23-sse-ids? [id] 1) false) false)
              (let [call (get (get context :calls) id) node (get (get context :nodes) id)]
                (if (p15-s23-ksin-source-ids? node call (get context :nodes) (get context :bindings) (get (get context :core) :module))
                  (if (= id (get call :core-node-id) (get node :node-id)) (recur (rest remaining)) false) false)) false))
          (recur (rest remaining)))))))

(defn p15-s23-typed-compile-prepend [context node budget]
  (let [id (get node :node-id) core (get context :core)
        call (get (get context :calls) id) args (get call :argument-node-ids)]
    (if (= false (vector? args))
      (assoc (p15-s23-typed-node-error :typed-list-prepend-call-shape-required node) :work-count 1)
      (let [base (+ 64 (count args) (count (get core :function-records)) (count (get context :ledger)))]
        (if (< budget base) (assoc (p15-s23-typed-node-error :typed-lowering-work-limit node) :work-count base)
          (if (= false (= 2 (count args)))
            (assoc (p15-s23-typed-node-error :typed-list-prepend-arity-required node) :work-count base)
            (if (= false (if (vector? (get node :children)) (= 3 (count (get node :children))) false))
              (assoc (p15-s23-typed-node-error :typed-list-prepend-call-shape-required node) :work-count base)
            (if (let [children (get node :children)] (loop [remaining (conj (conj (conj (conj (conj (conj (conj args (get children 0)) (get children 1)) (get children 2)) (get call :operator-node-id)) (get call :operator-binding-id)) (get node :node-id)) (get (get node :source) :form-id))] (if (= 0 (count remaining)) true (if (if (keyword? (first remaining)) true (if (string? (first remaining)) (= 71 (count (first remaining))) false)) (recur (rest remaining)) false))))
              (let [receiver (get (get context :types) (get args 0))

                              {:status :accepted :work-count (+ 2 n) :argument-types arguments :set-member-count n}))
                          (let [member (get members i)]
                            (if (= (if (= :character family) :gravity.type/character (if (= :string family) :gravity.type/string :gravity.type/keyword)) member)
                              (recur (+ i 1) family)
                              (if (if (= i 0) (if (= :gravity.type/never needle)

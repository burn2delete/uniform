    (let [source (get node :source) owner (get forms (get source :form-id))
          ids (get owner :child-form-ids) children (get node :children)]
      (if (if (p15-s23-sse-ids? [(get owner :form-id) (get owner :syntax-id)] 2)
            (if (vector? children) (if (= 3 (count children)) (p15-s23-sse-ids? ids 3) false) false) false)
        (if (= (get source :form-id) (get owner :form-id))
          (if (= :list (get owner :kind))
            (if (= source (p15-s23-typed-source owner))
              (loop [i 0]
                (if (= i 3) true
                  (let [form (get forms (get ids i)) child (get nodes (get children i))]
                    (if (p15-s23-sse-ids? [(get form :form-id) (get form :syntax-id)
                                     (get (get child :source) :form-id) (get (get child :source) :syntax-id)] 4)
                      (if (= (get ids i) (get form :form-id) (get (get child :source) :form-id))
                        (if (= (get owner :form-id) (get form :parent-form-id))
                          (if (= (get child :source) (p15-s23-typed-source form))
                            (if (= i 0)
                              (if (symbol? (get form :value))
                                (if (= (get (get child :attributes) :symbol) (get form :value)) (recur (+ i 1)) false) false)
                              (recur (+ i 1))) false) false) false) false)))) false) false) false) false)) false))

(defn p15-s23-pl-validation? [validation]
  ; This is a closed semantic cell, not a transferable proof or cost report.
  (let [header (bootstrap-native-carrier-header validation) kind (get header 0)]
    (if (if (= :map kind) true
          (if (= :tree-map kind) (= :default-comparator (get header 4)) false))
      (if (>= (get header 2) 0)
        (if (loop [fields (keys validation)]
              (if (= 0 (count fields)) true
                (if (keyword? (first fields)) (recur (rest fields)) false)))
          (if (= :accepted (get validation :status))
            (let [fields (set (keys validation))]
              (if (= #{:status :result-type} fields)
                (= :accepted (get (p15-s23-lc-validate-types [(get validation :result-type)]) :status))
                (if (= #{:status :collection-family :argument-types :input-extent :result-type} fields)
                  (if (keyword? (get validation :collection-family))
                    (if (contains? #{:string-set-insertion :symbol-set-insertion :keyword-set-insertion}
                                   (get validation :collection-family))
                      (if (if (= nil (get validation :input-extent)) true
                            (if (integer? (get validation :input-extent))
                              (>= (get validation :input-extent) 0) false))
                        (if (= :accepted (get (p15-s23-lc-validate-types (get validation :argument-types)) :status))
                          (= :accepted (get (p15-s23-lc-validate-types [(get validation :result-type)]) :status)) false)
                        false) false) false) false))) false) false) false) false)))

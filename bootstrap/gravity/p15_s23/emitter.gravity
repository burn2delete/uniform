(defn p15-s23-lsi-first-data-work [value budget]
  ; Only first-order data carriers are traversed; lazy sequences are unsupported.
  ; Reserve native container visits/comparison candidates before materialization.
  (loop [pending [[value 0]] used 0]
    (if (= 0 (count pending)) {:status :accepted :work-count used}
      (if (>= used budget) {:status :rejected :reason :loop-type-work-limit :work-count (+ used 1)}
        (let [frame (get pending (- (count pending) 1)) value (get frame 0) depth (get frame 1)
              tail (subvec pending 0 (- (count pending) 1))]
          (if (> depth 128) {:status :rejected :reason :unsupported-loop-member-grounding :work-count (+ used 1)}
            (if (if (map? value) true (if (vector? value) true (if (set? value) true (list? value))))
              (let [size (count value) width (if (map? value) (* 2 size) size)
                    comparison (if (map? value) (+ (* size size) width)
                                 (if (set? value) (+ (* size size) width) width))
                    work (+ used 1 comparison)]
                (if (> size 1024) {:status :rejected :reason :unsupported-loop-member-grounding :work-count (+ used 1)}
                  (if (> (+ work (count tail) width) budget)
                    {:status :rejected :reason :loop-type-work-limit :work-count (+ work (count tail) width)}
                    (let [items (if (map? value)
                                  (loop [entries (vec value) out []]
                                    (if (= 0 (count entries)) out
                                      (let [entry (first entries)]
                                        (recur (rest entries) (conj (conj out (get entry 0)) (get entry 1)))))) (vec value))]
                      (recur (loop [remaining items out tail]
                               (if (= 0 (count remaining)) out
                                 (recur (rest remaining) (conj out [(first remaining) (+ depth 1)])))) work)))))
              (if (if (= nil value) true (if (boolean? value) true (if (keyword? value) true
                    (if (symbol? value) true (if (string? value) true (if (number? value) true (char? value)))))))
                ; Keyword atoms keep two visits without rendering a discarded name.
                (let [work (+ used 2 (if (string? value) (count value)
                                      (if (symbol? value) (count (str value)) 0)))]
                  (if (> work budget) {:status :rejected :reason :loop-type-work-limit :work-count work}
                    (recur tail work)))
                {:status :rejected :reason :unsupported-loop-member-grounding :work-count (+ used 1)}))))))))

(defn p15-s23-lsi-first-ids? [ids]

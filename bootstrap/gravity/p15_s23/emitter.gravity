        (= proof (p15-s23-vl-bounds header invariant origin path nodes))
        (= descriptor (p15-s23-vn-finish (assoc header :bounds-proof proof)))]) false)))


(defn p15-s23-typed-compile-loop-nth [context node budget]
  (let [id (get node :node-id) core (get context :core)
        call (get (get context :calls) id) types (get context :types)

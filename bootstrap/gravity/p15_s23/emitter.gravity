                                 (= {:literal-kind :integer :value value} (get child :attributes))
                                 (= [] (get child :children) (get child :resolved-binding-ids) (get child-form :child-form-ids))
                                 (= :integer (get child-form :kind)) (= source (p15-s23-typed-source child-form))

(defn p15-s23-typed-compile-keyword-set-equality [context node budget]
  (if (if (if (map? context) (map? node) false)
    (if (if (p15-s23-sse-ids? [(get node :node-id)] 1)
          (p15-s23-typed-all [(map? (get context :calls)) (map? (get context :core))
                             (map? (get context :types)) (map? (get context :bindings)) (map? (get context :nodes))]) false)
      (if (p15-s23-bka-entry? node (get (get context :calls) (get node :node-id))
            (get context :nodes) (get context :bindings) (get context :types) (get (get context :core) :module)) true
        (if (vector? (get node :children))
          (if (p15-s23-sse-ids? [(first (get node :children))] 1)
            (let [kind (get (get (get context :types) (first (get node :children))) :kind)]
              (if (keyword? kind) (= :gravity.type/applied-bare-keyword-anchor-set-equality kind) false)) false) false)) false) false)
    (p15-s23-typed-compile-bare-keyword-anchor-set-equality context node budget)
    (let [id (get node :node-id) core (get context :core)
        charge (+ 66 (count (get core :function-records)) (* 4 (count (get context :ledger))))]
    (if (< budget charge) (assoc (p15-s23-typed-node-error :typed-lowering-work-limit node) :work-count charge)
      (if (if (if (p15-s23-sse-ids? (get node :children) 3) (p15-s23-sse-ids? [(get node :node-id) (get (get node :source) :form-id) (get (get node :source) :syntax-id)] 3) false)
          (if (p15-s23-sse-call-ids? node (get (get context :calls) id))
            (p15-s23-sse-ids? (get (get (get context :forms) (get (get node :source) :form-id)) :child-form-ids) 3) false) false)
        (let [call (get (get context :calls) id) edge (get (get context :edges) id)
            forms (get context :forms) nodes (get context :nodes)
            owner (get forms (get (get node :source) :form-id)) ids (get owner :child-form-ids)
            args (get call :argument-node-ids)
            domain (if (if (vector? args) (= 2 (count args)) false)
                     (p15-s23-sse-domain (p15-s23-io-child-types args (get context :types)) (- budget charge))
                     {:status :rejected :work-count 0})
            charge (+ charge (get domain :work-count))
            header (if (= :accepted (get domain :status))
                     (p15-s23-kse-source core node call edge nodes (get context :bindings) (get context :types) (get core :module) domain) nil)
            descriptor (if (map? header) (p15-s23-kse-finish header) nil)
            carrier? (= :string-set-carrier (get domain :comparison-domain))
        strings? (if carrier? true (= :string-set (get domain :comparison-domain)))
            producer-rows (p15-s23-pe-select (get context :ledger) :producer-rule (if carrier? :sh08-string-set-carrier-equality-v1 (if strings? :sh08-string-set-equality-v1 :sh08-keyword-set-equality-v1)))
            rows (p15-s23-pe-select producer-rows :lhs {:core-node-id id :projection (if carrier? :string-set-carrier-equality (if strings? :string-set-equality :keyword-set-equality))})]
        (if (> charge budget) (assoc (p15-s23-typed-node-error :typed-lowering-work-limit node) :work-count charge)
        (if (if (map? descriptor)
              (p15-s23-typed-all
                [(loop [remaining producer-rows]
                         (if (= 0 (count remaining)) true
                           (let [row (first remaining) row-id (get (get row :lhs) :core-node-id)
                                 source-call (if (if (keyword? row-id) true (if (string? row-id) (= 71 (count row-id)) false))
                                               (get (get context :calls) row-id) nil)
                                 source-node (if (map? source-call) (get nodes row-id) nil)
                                 source-type (if (if (map? source-call)
                                                   (if (keyword? (get source-call :operator-node-id)) true
                                                     (if (string? (get source-call :operator-node-id)) (= 71 (count (get source-call :operator-node-id))) false)) false)
                                               (get (get context :types) (get source-call :operator-node-id)) nil)]
                             (if (p15-s23-typed-all [(= row-id (get source-call :core-node-id) (get source-node :node-id))
                                   (map? source-call) (map? source-node)
                                   (= (if strings? :gravity.type/applied-string-set-equality :gravity.type/applied-keyword-set-equality) (get source-type :kind))
                                   (= source-call (get source-type :source-call))
                                   (= row (p15-s23-kse-constraint source-type))])
                               (recur (rest remaining)) false))))
                 (= descriptor (get (get context :types) (get call :operator-node-id)))
                 (= (get descriptor :result-type) (get (get context :types) id))
                 (= (get edge :ordinal) (get (get context :call-order) id))
                 (= (get (get context :current-function) :function-syntax-id) (get edge :caller-function-syntax-id))

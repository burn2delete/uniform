                (let [lhs (get row :lhs) id (if (map? lhs) (get lhs :core-node-id) nil)]
                  (if (p15-s23-sse-ids? [id] 1)
                    (if (contains? seen id) {:status :rejected :reason :vector-empty-source-mismatch :work-count used}
                      (let [source-call (get calls id) source-edge (get edges id) source-node (get nodes id)
                            result (if (= target id) {:status :accepted :descriptor descriptor :work-count 0}
                                     (p15-s23-vemp-header core source-node source-call source-edge nodes bindings types (get core :module) (- budget used)))

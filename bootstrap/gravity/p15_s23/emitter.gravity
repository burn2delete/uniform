     :dispatch :direct-string-character-vector :applied-string-character-vector descriptor :effect-facts-source :audited-text-intrinsic}))

(defn p15-s23-typed-compile-string-character-vector [context node budget]
  (if (p15-s23-sse-ids? [(get node :node-id) (get (get node :source) :form-id)] 2)
    (let [id (get node :node-id) core (get context :core)
          charge (+ 66 (count (get core :function-records))
                    (* 8 (+ (count (get context :ledger)) (count (get context :call-facts)))))]
      (if (< budget charge) (assoc (p15-s23-typed-node-error :typed-lowering-work-limit node) :work-count charge)
        (let [call (get (get context :calls) id) edge (get (get context :edges) id)
              nodes (get context :nodes) bindings (get context :bindings) types (get context :types)
              checked (p15-s23-scv-proof core node call nodes bindings types (get context :forms) (- budget charge))
              charge (+ charge (get checked :work-count))
              header (if (= :accepted (get checked :status))
                       (p15-s23-scv-source core node call edge nodes bindings types (get core :module) (get checked :proof)) nil)
              descriptor (if (map? header) (p15-s23-scv-finish header) nil)]
          (if (> charge budget) (assoc (p15-s23-typed-node-error :typed-lowering-work-limit node) :work-count charge)
            (if (if (map? descriptor) (= descriptor (get types (get call :operator-node-id))) false)
              (let [rows (loop [remaining (get context :ledger) out []]
                           (if (= 0 (count remaining)) out
                             (let [row (first remaining)]
                               (recur (rest remaining)
                                 (if (if (= :sh08-string-character-vector-v1 (get row :producer-rule))
                                       (= {:core-node-id id :projection :string-character-vector} (get row :lhs)) false)
                                   (conj out row) out)))))]
                (if (p15-s23-typed-all
                      [(= (get descriptor :result-type) (get types id))
                       (= (get edge :ordinal) (get (get context :call-order) id))
                       (= (get (get context :current-function) :function-syntax-id) (get edge :caller-function-syntax-id))
                       (= [(p15-s23-scv-constraint descriptor)] rows)
                       (= (p15-s23-scv-call-fact descriptor (get core :module)) (get (get context :call-facts) id))
                       (= {:operator-child-index 0 :argument-count 1 :argument-child-indexes [1]
                           :evaluation-order :operator-then-arguments :dispatch :resolved-symbol-call} (get node :attributes))])
                  (let [compiled (p15-s23-typed-compile-children context (get call :argument-node-ids) (- budget charge) [])]
                    (if (p15-s23-compiler-complete? compiled)
                      (assoc (p15-s23-compiler-result {:op :builtin-call :function 'vec :args (get compiled :value)})
                        :work-count (+ charge (get compiled :work-count)))
                      (assoc compiled :work-count (+ charge (get compiled :work-count 0)))))
                  (assoc (p15-s23-typed-node-error :unsupported-or-mismatched-typed-string-character-vector node) :work-count charge)))
              (assoc (p15-s23-typed-node-error :unsupported-or-mismatched-typed-string-character-vector node) :work-count charge))))))
    (assoc (p15-s23-typed-node-error :unsupported-or-mismatched-typed-string-character-vector {}) :work-count 1)))


(defn p15-s23-cqs-binding? [binding module]
  (if (symbol? (get binding :name))
    (if (keyword? (get module :profile))
      (if (if (vector? (get binding :profile-set)) (vector? (get binding :target-set)) false)
        (if (loop [remaining (get binding :profile-set)]

           (= 3 (count args)) (= expected-call call) (= expected-edge edge)
           (= expected-call (p15-s23-nq-one (get core :calls) :core-node-id (get node :node-id)))
           (= expected-edge (p15-s23-nq-one (get core :call-edges) :call-core-node-id (get node :node-id))) (p15-s23-vsl-binding? binding module)

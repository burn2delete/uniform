     :call-core-node-id (get descriptor :call-core-node-id) :caller-function-syntax-id (get edge :caller-function-syntax-id)
     :callee-function-syntax-id nil :argument-types (get descriptor :argument-types) :result-type (get descriptor :result-type)
     :evaluation-order :operator-then-arguments :source-span (get source :semantic-span) :syntax-id (get source :syntax-id)
     :origin-chain (get source :origin-chain) :generated-origin (get source :generated-origin)
     :profile (get module :profile) :target (get module :target) :effects (get descriptor :direct-effects) :capabilities [] :status :inferred
     :dispatch :direct-list-prepend :applied-list-prepend descriptor :effect-facts-source :audited-collection-intrinsic}))


(defn p15-s23-pl-finish [header]
  (assoc header :parameter-types (get header :argument-types) :return (get header :result-type)))

(defn p15-s23-typed-compile-prepend [context node budget]
  (let [id (get node :node-id) core (get context :core)
        call (get (get context :calls) id) args (get call :argument-node-ids)]
    (if (= false (vector? args))
      (assoc (p15-s23-typed-node-error :typed-list-prepend-call-shape-required node) :work-count 1)
      (let [base (+ 64 (count args) (count (get core :function-records)) (count (get context :ledger)))]
        (if (< budget base) (assoc (p15-s23-typed-node-error :typed-lowering-work-limit node) :work-count base)
          (if (= false (= 2 (count args)))
            (assoc (p15-s23-typed-node-error :typed-list-prepend-arity-required node) :work-count base)
            (if (= false (if (vector? (get node :children)) (= 3 (count (get node :children))) false))
              (assoc (p15-s23-typed-node-error :typed-list-prepend-call-shape-required node) :work-count base)
            (let [validation (p15-s23-pl-type-work [(get (get context :types) (get args 0) :gravity.type/unknown)
                                                   (get (get context :types) (get args 1) :gravity.type/unknown)] (- budget base))
                  charge (+ base (get validation :work-count))]
              (if (= :list-prepend-work-limit (get validation :reason))
                (assoc (p15-s23-typed-node-error :typed-lowering-work-limit node) :work-count charge)
                (if (= false (= :accepted (get validation :status)))
                  (assoc (p15-s23-typed-node-error (get validation :reason) node) :work-count charge)
      (let [edge (get (get context :edges) id)
            forms (get context :forms) nodes (get context :nodes)
            owner (get forms (get (get node :source) :form-id)) ids (get owner :child-form-ids)
            header (p15-s23-pl-source core node call edge nodes (get context :bindings) (get context :types) (get core :module) validation)
            descriptor (if (map? header) (p15-s23-pl-finish header) nil)
            rows (loop [remaining (get context :ledger) out []]
                   (if (= 0 (count remaining)) out
                     (let [row (first remaining)]
                       (recur (rest remaining)
                         (if (if (contains? #{:sh08-list-prepend-v1 :sh08-vector-append-v1} (get row :producer-rule))
                               (= id (get (get row :lhs) :core-node-id)) false) (conj out row) out)))))]
        (if (if (map? descriptor)
              (p15-s23-typed-all
                [(= descriptor (get (get context :types) (get call :operator-node-id)))
                 (= (get descriptor :result-type) (get (get context :types) id))
                 (= (get edge :ordinal) (get (get context :call-order) id))
                 (= (get (get context :current-function) :function-syntax-id) (get edge :caller-function-syntax-id))
                 (= [(p15-s23-pl-constraint descriptor)] rows)
                 (= (p15-s23-pl-call-fact descriptor (get core :module)) (get (get context :call-facts) id))
                 (= :list (get owner :kind)) (vector? ids) (= 3 (if (vector? ids) (count ids) 0) (count (get node :children)))
                 (= (get node :source) (p15-s23-typed-source owner))
                 (= {:operator-child-index 0 :argument-count 2 :argument-child-indexes [1 2]
                     :evaluation-order :operator-then-arguments :dispatch :resolved-symbol-call} (get node :attributes))
                 (loop [i 0]
                   (if (= i 3) true
                     (let [form (get forms (get ids i)) child (get nodes (get (get node :children) i))]
                       (if (p15-s23-typed-all [(= (get owner :form-id) (get form :parent-form-id))
                             (= (get child :source) (p15-s23-typed-source form))
                             (if (= i 0) (= (get form :value) (get (get child :attributes) :symbol)) true)])
                         (recur (+ i 1)) false))))]) false)
          (let [compiled (p15-s23-typed-compile-children context (get call :argument-node-ids) (- budget charge) [])]
            (if (p15-s23-compiler-complete? compiled)
              (assoc (p15-s23-compiler-result {:op :builtin-call :function 'conj :args (get compiled :value)})
                :work-count (+ charge (get compiled :work-count)))
              (assoc compiled :work-count (+ charge (get compiled :work-count 0)))))
          (assoc (p15-s23-typed-node-error :unsupported-or-mismatched-typed-list-prepend node) :work-count charge)))))))))))))

(defn p15-s23-typed-compile-append [context node budget]
  (let [id (get node :node-id) core (get context :core)
        charge (+ 64 2 1024 (count (get core :function-records)))]
    (if (< budget charge) (p15-s23-typed-node-error :typed-lowering-work-limit node)
      (let [call (get (get context :calls) id) edge (get (get context :edges) id)
            forms (get context :forms) nodes (get context :nodes)
            owner (get forms (get (get node :source) :form-id)) ids (get owner :child-form-ids)
            header (p15-s23-va-source core node call edge nodes (get context :bindings) (get context :types) (get core :module))
            descriptor (if (map? header) (p15-s23-va-finish header) nil)
            rows (loop [remaining (get context :ledger) out []]
                   (if (= 0 (count remaining)) out
                     (let [row (first remaining)]
                       (recur (rest remaining)
                         (if (if (= :sh08-vector-append-v1 (get row :producer-rule))
                               (= {:core-node-id id :projection :vector-append} (get row :lhs)) false) (conj out row) out)))))]
        (if (if (map? descriptor)
              (p15-s23-typed-all
                [(= descriptor (get (get context :types) (get call :operator-node-id)))
                 (= (get descriptor :result-type) (get (get context :types) id))
                 (= (get edge :ordinal) (get (get context :call-order) id))
                 (= (get (get context :current-function) :function-syntax-id) (get edge :caller-function-syntax-id))
                 (= [(p15-s23-va-constraint descriptor)] rows)
                 (= (p15-s23-va-call-fact descriptor (get core :module)) (get (get context :call-facts) id))
                 (= :list (get owner :kind)) (vector? ids) (= 3 (if (vector? ids) (count ids) 0) (count (get node :children)))
                 (= (get node :source) (p15-s23-typed-source owner))
                 (= {:operator-child-index 0 :argument-count 2 :argument-child-indexes [1 2]
                     :evaluation-order :operator-then-arguments :dispatch :resolved-symbol-call} (get node :attributes))
                 (loop [i 0]
                   (if (= i 3) true
                     (let [form (get forms (get ids i)) child (get nodes (get (get node :children) i))]
                       (if (p15-s23-typed-all [(= (get owner :form-id) (get form :parent-form-id))
                             (= (get child :source) (p15-s23-typed-source form))
                             (if (= i 0) (= (get form :value) (get (get child :attributes) :symbol)) true)])
                         (recur (+ i 1)) false))))]) false)
          (let [compiled (p15-s23-typed-compile-children context (get call :argument-node-ids) (- budget charge) [])]
            (if (p15-s23-compiler-complete? compiled)
              (assoc (p15-s23-compiler-result {:op :builtin-call :function 'conj :args (get compiled :value)})
                :work-count (+ charge (get compiled :work-count))) compiled))
          (p15-s23-typed-node-error :unsupported-or-mismatched-typed-vector-append node))))))

; L2/L5/STD3 evaluated first-order values, not syntax or quoted-data authority.
(defn p15-s23-hl-type? [type]
  (if (map? type)
    (if (= #{:kind :shape :element-type} (set (keys type)))
      (if (= [:gravity.type/list :homogeneous] [(get type :kind) (get type :shape)])
        (contains? #{:gravity.type/i8 :gravity.type/i16 :gravity.type/i32 :gravity.type/i64

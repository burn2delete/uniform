              scope (get (get let-node :attributes) :body-scope-id)
              owner (get (get node :evaluation) :owner-function-syntax-id) region (get (get node :evaluation) :region)]
          (if (if (p15-s23-sse-ids? ids 4)
                (if (p15-s23-sse-ids? [(get form :form-id) (get form :syntax-id) (get form :scope-id)] 3)
                  (if (if (= nil owner) true (p15-s23-sse-ids? [owner] 1))
                    (loop [remaining branch-nodes] (if (= 0 (count remaining)) true
                      (let [child (first remaining) child-owner (get (get child :evaluation) :owner-function-syntax-id)]
                        (if (p15-s23-sse-ids? [(get child :node-id) (get (get child :source) :form-id) (get (get child :source) :syntax-id)] 3)
                          (if (if (= nil child-owner) true (p15-s23-sse-ids? [child-owner] 1)) (recur (rest remaining)) false) false)))) false) false) false)
            (let [operator (get forms (get ids 0)) condition-form (get forms (get ids 1))
                  then-form (get forms (get ids 2)) else-form (get forms (get ids 3))
                  selected-forms [form operator condition-form then-form else-form]
                  region-fields? (if (map? region) (if (= 8 (count region))
                                   (loop [remaining (keys region)] (if (= 0 (count remaining)) true
                                     (if (keyword? (first remaining)) (recur (rest remaining)) false))) false) false)
                  region-valid? (if (keyword? region) (contains? #{:module-initialization :function-body} region)
                                  (if region-fields?
                                    (if (if (p15-s23-sse-ids? [(get region :if-syntax-id) (get region :if-form-id)] 2)
                                          (if (if (= nil (get region :parent-if-syntax-id)) true (p15-s23-sse-ids? [(get region :parent-if-syntax-id)] 1))
                                            (if (keyword? (get region :role))
                                              (if (keyword? (get region :parent-region-kind))
                                                (if (= nil (get region :parent-branch-role)) true (keyword? (get region :parent-branch-role))) false) false) false) false)
                                      (p15-s23-typed-all [(= #{:kind :if-syntax-id :if-form-id :role :execution :parent-region-kind :parent-if-syntax-id :parent-branch-role} (set (keys region)))
                                            (= :conditional-branch (get region :kind)) (= :selected-exactly-once (get region :execution))
                                            (contains? #{:then :else} (get region :role))
                                            (contains? #{:module-initialization :function-body :conditional-branch :match-guard} (get region :parent-region-kind))
                                            (if (= :conditional-branch (get region :parent-region-kind))
                                              (if (p15-s23-sse-ids? [(get region :parent-if-syntax-id)] 1)
                                                (contains? #{:then :else} (get region :parent-branch-role)) false)
                                              (if (= nil (get region :parent-if-syntax-id)) (= nil (get region :parent-branch-role)) false))]) false) false))]
              (if (if region-valid?
                    (if (symbol? (get operator :value))
                      (if (p15-s23-sse-ids? [(get control :condition-node-id) (get (get (get control :branches) 0) :core-node-id)
                                 (get (get (get control :branches) 1) :core-node-id)] 3)
                        (loop [remaining selected-forms] (if (= 0 (count remaining)) true
                          (let [item (first remaining)]
                            (if (p15-s23-sse-ids? [(get item :form-id) (get item :syntax-id) (get item :scope-id)] 3) (recur (rest remaining)) false)))) false) false) false)
                (if (p15-s23-typed-all [
                      (= :if (get node :core-form)) (= :let (get let-node :core-form)) (= [] (get node :resolved-binding-ids))

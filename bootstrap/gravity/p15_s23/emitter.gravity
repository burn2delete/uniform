            {:status :rejected :reason :vector-slice-receiver-proof-required :work-count work}))))))

(defn p15-s23-vsl-receiver [core node nodes bindings types forms budget]
  (let [calls (get core :calls) edges (get core :call-edges)
        work (+ 64 (* 3 (count calls)) (* 3 (count edges)) (count (get core :function-records)))]
    (if (> work budget) {:status :rejected :reason :vector-slice-work-limit :work-count work}
      (if (if (vector? calls) (vector? edges) false)
        (if (if (p15-s23-sse-ids? [(get node :node-id)] 1)
              (if (loop [remaining calls]
                    (if (= 0 (count remaining)) true
                      (if (p15-s23-sse-ids? [(get (first remaining) :core-node-id)] 1)
                        (recur (rest remaining)) false)))
                (loop [remaining edges]
                  (if (= 0 (count remaining)) true
                    (if (p15-s23-sse-ids? [(get (first remaining) :call-core-node-id)] 1)
                      (recur (rest remaining)) false))) false) false)
          (let [id (get node :node-id) type (get types id)
                call (p15-s23-nq-one calls :core-node-id id) edge (p15-s23-nq-one edges :call-core-node-id id)
                selected? (if (p15-s23-sse-ids? [(get call :operator-binding-id)] 1)
                            (p15-s23-scv-binding? (get bindings (get call :operator-binding-id)) (get core :module)) false)]
            (if selected?
              (let [checked (p15-s23-scv-proof core node call nodes bindings types forms (- budget work))
                    total (+ work (get checked :work-count))
                    header (if (= :accepted (get checked :status))
                             (p15-s23-scv-source core node call edge nodes bindings types (get core :module) (get checked :proof)) nil)
                    descriptor (if (map? header) (p15-s23-scv-finish header) nil)]
                (if (= :accepted (get checked :status))
                  (if (if (map? descriptor)
                        (if (= descriptor (get types (get call :operator-node-id)))
                          (= (get descriptor :result-type) type) false) false)
                    {:status :accepted :work-count total :type type
                     :source-forms (get (get checked :proof) :source-forms)
                     :receiver {:kind :authenticated-string-character-vector :descriptor descriptor
                                :constraint (p15-s23-scv-constraint descriptor)
                                :call-fact (p15-s23-scv-call-fact descriptor (get core :module))}}
                    {:status :rejected :reason :vector-slice-source-mismatch :work-count total})
                  (assoc checked :work-count total)))
              (if (= :gravity.type/never type)
                {:status :accepted :work-count work :type type :source-forms [] :receiver {:kind :non-invoked-operand}}
              (if (= :collection-literal (get node :core-form))
                (let [literal (p15-s23-vsl-literal node nodes types forms (- budget work))]
                  (assoc literal :work-count (+ work (get literal :work-count))))
                {:status :rejected :reason (if (if (= :gravity.type/unknown type) true
                                                  (if (map? type) (= :gravity.type/vector (get type :kind)) false))
                                            :vector-slice-receiver-proof-required :vector-slice-receiver-type-required)
                 :work-count work}))))
          {:status :rejected :reason :vector-slice-source-mismatch :work-count work})
        {:status :rejected :reason :vector-slice-source-mismatch :work-count work}))))

(defn p15-s23-vsl-prefix-call-region? [container region]
  ; Only the actual then region of this fixed original if, including its parent.
  (let [parent (get (get container :evaluation) :region)
        candidates (if (map? parent) [region parent] [region])]
    (if (loop [remaining candidates]

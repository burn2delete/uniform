            owner (get forms (get (get node :source) :form-id)) ids (get owner :child-form-ids)
            header (p15-s23-si-source core node call edge nodes (get context :bindings) (get context :types) (get core :module))
            addition? (= '+ (get header :operation))
            descriptor (if (map? header) (p15-s23-si-finish (assoc header :range-proof (get (get (get context :types) (get call :operator-node-id)) :range-proof))) nil)
            rows (loop [remaining (get context :ledger) out []]

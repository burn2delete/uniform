(defn p15-s23-chp-classification [type]
  (if (= :gravity.type/never type)
    {:version :sh08-character-query-classification-v1 :operand-type type :case :never :lowering :original-transfer}
    (if (= :gravity.type/character type)
      {:version :sh08-character-query-classification-v1 :operand-type type :case :known-character :lowering :evaluate-then-true}
      (if (if (map? type) (if (= :gravity.type/nil-or (get type :kind))
                         (= :gravity.type/character (get type :value-type)) false) false)
        {:version :sh08-character-query-classification-v1 :operand-type type :case :nil-or-character
         :atomic-type :gravity.type/character :lowering :owned-atomic-nil-complement}
        {:version :sh08-character-query-classification-v1 :operand-type type :case :known-non-character :lowering :evaluate-then-false}))))


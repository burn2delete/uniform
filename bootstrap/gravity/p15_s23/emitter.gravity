            forms (get context :forms) nodes (get context :nodes)
            owner (get forms (get (get node :source) :form-id)) ids (get owner :child-form-ids)
            header (p15-s23-va-source core node call edge nodes (get context :bindings) (get context :types) (get core :module))
            descriptor (if (map? header) (p15-s23-va-finish header) nil)
            rows (loop [remaining (get context :ledger) out []]
                   (if (= 0 (count remaining)) out
                     (let [row (first remaining)]
                       (recur (rest remaining)
                         (if (if (= :sh08-vector-append-v1 (get row :producer-rule))
                               (= {:core-node-id id :projection :vector-append} (get row :lhs)) false) (conj out row) out)))))]
        (if (if (map? descriptor)
              (p15-s23-typed-all
                [(= descriptor (get (get context :types) (get call :operator-node-id)))
                 (= (get descriptor :result-type) (get (get context :types) id))
                 (= (get edge :ordinal) (get (get context :call-order) id))
                 (= (get (get context :current-function) :function-syntax-id) (get edge :caller-function-syntax-id))
                 (= [(p15-s23-va-constraint descriptor)] rows)
                 (= (p15-s23-va-call-fact descriptor (get core :module)) (get (get context :call-facts) id))
                 (= :list (get owner :kind)) (vector? ids) (= 3 (if (vector? ids) (count ids) 0) (count (get node :children)))
                 (= (get node :source) (p15-s23-typed-source owner))
                 (= {:operator-child-index 0 :argument-count 2 :argument-child-indexes [1 2]
                     :evaluation-order :operator-then-arguments :dispatch :resolved-symbol-call} (get node :attributes))
                 (loop [i 0]
                   (if (= i 3) true
                     (let [form (get forms (get ids i)) child (get nodes (get (get node :children) i))]
                       (if (p15-s23-typed-all [(= (get owner :form-id) (get form :parent-form-id))
                             (= (get child :source) (p15-s23-typed-source form))
                             (if (= i 0) (= (get form :value) (get (get child :attributes) :symbol)) true)])
                         (recur (+ i 1)) false))))]) false)
          (let [compiled (p15-s23-typed-compile-children context (get call :argument-node-ids) (- budget charge) [])]
            (if (p15-s23-compiler-complete? compiled)
              (assoc (p15-s23-compiler-result {:op :builtin-call :function 'conj :args (get compiled :value)})
                :work-count (+ charge (get compiled :work-count))) compiled))
          (p15-s23-typed-node-error :unsupported-or-mismatched-typed-vector-append node))))))


            (if (p15-s23-typed-all
                  [(= :collection-literal (get node :core-form)) (= :vector (get form :kind))
                   (= [] (get node :resolved-binding-ids)) (= (get node :source) (p15-s23-typed-source form))
                   (= {:kind :gravity.type/vector :shape :literal :element-types members} type)
                   (= #{:literal-kind :element-count :source-value} (set (keys attrs)))
                   (= :vector (get attrs :literal-kind)) (= n (get attrs :element-count))
                   (if (vector? (get attrs :source-value)) (= n (count (get attrs :source-value))) false)
                   (= :left-to-right (get (get node :evaluation) :kind))
                   (= (loop [i 0 out []] (if (= i n) out
                        (recur (+ i 1) (conj out {:index i :core-node-id (get children i)}))))
                      (get (get node :evaluation) :order))])
              (loop [i 0 selected [form] seen #{} seen-forms #{(get form :form-id)}]
                (if (= i n)
                  {:status :accepted :work-count work :type type :source-forms selected
                   :receiver {:kind :original-integer-vector-literal :node node :source-forms selected :type type}}
                  (let [id (get children i) child (get nodes id) source (get child :source)]
                    (if (if (p15-s23-sse-ids? [id (get source :form-id) (get source :syntax-id)] 3)
                          (if (= false (contains? seen id)) (= false (contains? seen-forms (get source :form-id))) false) false)

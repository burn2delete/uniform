(defn p15-s23-typed-compile-keyword-set-equality [context node budget]
  (let [id (get node :node-id) core (get context :core)
        charge (+ 66 (count (get core :function-records)) (* 4 (count (get context :ledger))))]
    (if (< budget charge) (assoc (p15-s23-typed-node-error :typed-lowering-work-limit node) :work-count charge)
      (let [call (get (get context :calls) id) edge (get (get context :edges) id)
            forms (get context :forms) nodes (get context :nodes)
            owner (get forms (get (get node :source) :form-id)) ids (get owner :child-form-ids)
            args (get call :argument-node-ids)
            domain (if (if (vector? args) (= 2 (count args)) false)
                     (p15-s23-kse-domain (p15-s23-io-child-types args (get context :types)) (- budget charge))
                     {:status :rejected :work-count 0})
            charge (+ charge (get domain :work-count))

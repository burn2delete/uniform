(defn p15-s23-vsl-count-end [core slice-node node receiver nodes bindings types forms budget]
  ; The caller independently checked the immutable local or parameter Vector.
  ; Prepay table/type visits; reserve membership scans after physical ID checks.
  (let [calls (get core :calls) edges (get core :call-edges) functions (get core :function-records)
        members (get (get receiver :type) :element-types)
        body-consumer (get (get receiver :receiver) :body-consumer)
        first-body? (= :direct-vector-first (get body-consumer :kind))
        parameter? (= :immutable-parameter-vector (get (get receiver :receiver) :kind))
        work (+ 128 (if first-body? 32 0) (* 8 (+ (if (vector? calls) (count calls) 0)
                            (if (vector? edges) (count edges) 0)
                            (if (vector? functions) (count functions) 0)))
                    (* 8 (+ 1 (if (vector? members) (count members) 0))))]
    (if (> work budget) {:status :rejected :reason :vector-slice-work-limit :work-count work}
      (if (if (if (vector? calls) (vector? edges) false) (vector? functions) false)
        (if (p15-s23-typed-all
              [(p15-s23-sse-ids? [(get node :node-id) (get (get node :source) :form-id) (get (get node :source) :syntax-id)] 3)
               (loop [rows calls] (if (= 0 (count rows)) true
                 (if (p15-s23-sse-ids? [(get (first rows) :core-node-id)] 1) (recur (rest rows)) false)))
               (loop [rows edges] (if (= 0 (count rows)) true
                 (if (p15-s23-sse-ids? [(get (first rows) :call-core-node-id)] 1) (recur (rest rows)) false)))
               (loop [rows functions] (if (= 0 (count rows)) true
                 (if (p15-s23-sse-ids? [(get (first rows) :function-syntax-id) (get (first rows) :function-core-node-id)] 2)
                   (recur (rest rows)) false)))])
          (let [call (p15-s23-nq-one calls :core-node-id (get node :node-id))
                edge (p15-s23-nq-one edges :call-core-node-id (get node :node-id))
                lexical (get receiver :receiver) original (get lexical :reference)
                local-binding (get lexical :binding) record (get lexical :record)]
            (if (if (if (map? call) (map? edge) false)
                  (if (p15-s23-typed-all [(p15-s23-sse-ids? [(get call :operator-node-id) (get call :operator-binding-id)] 2)
                                      (p15-s23-sse-ids? (get node :children) 2)
                                      (p15-s23-sse-ids? (get call :argument-node-ids) 1)])
                    (if (integer? (get edge :ordinal)) (>= (get edge :ordinal) 0) false) false) false)
              (let [operator (get nodes (get call :operator-node-id)) binding (get bindings (get call :operator-binding-id))
                    children (get node :children) argument (get nodes (get children 1))
                    profiles (get binding :profile-set) targets (get binding :target-set)
                    work (+ work (* 4 (+ (if (vector? profiles) (count profiles) 0) (if (vector? targets) (count targets) 0))))]
                (if (> work budget) {:status :rejected :reason :vector-slice-work-limit :work-count work}
                  (if (p15-s23-nq-ids? node call nodes bindings (get core :module))
                    (if (if (p15-s23-typed-all [(p15-s23-sse-ids? [(get argument :node-id) (get (get argument :source) :form-id) (get (get argument :source) :syntax-id)
                                        (get (get argument :attributes) :binding-id) (get (get argument :attributes) :definition-syntax-id)
                                        (get argument :binding-context)] 6)
                                        (p15-s23-sse-ids? [(get node :binding-context) (get operator :binding-context)
                                        (get binding :definition-syntax-id) (get (get operator :attributes) :definition-syntax-id)] 4)])
                        (if (keyword? (get (get core :module) :target))
                          (if (loop [rows profiles] (if (= 0 (count rows)) true (if (keyword? (first rows)) (recur (rest rows)) false)))
                            (loop [rows targets] (if (= 0 (count rows)) true (if (keyword? (first rows)) (recur (rest rows)) false))) false) false) false)
                    (let [owner (get forms (get (get node :source) :form-id))
                          op-form (get forms (get (get operator :source) :form-id))
                          arg-form (get forms (get (get argument :source) :form-id))
                          slice-form (get forms (get (get slice-node :source) :form-id))
                          scope (if parameter? (get local-binding :scope-id) (get record :binding-scope-id)) region (get (get slice-node :evaluation) :region)
                          caller (get (get slice-node :evaluation) :owner-function-syntax-id)]
                      (if (if (p15-s23-typed-all [(p15-s23-sse-ids? [(get owner :form-id) (get owner :syntax-id) (get op-form :form-id) (get op-form :syntax-id)
                                            (get arg-form :form-id) (get arg-form :syntax-id)] 6)
                                            (p15-s23-sse-ids? [(get owner :scope-id) (get op-form :scope-id) (get arg-form :scope-id)] 3)])
                            (if (symbol? (get op-form :value)) (if (symbol? (get arg-form :value))
                              (if (symbol? (get (get argument :attributes) :symbol))
                                (if (= nil caller) true (p15-s23-sse-ids? [caller] 1)) false) false) false) false)
                        (if (p15-s23-typed-all
                              [(if parameter? true (= :immutable-let-vector (get lexical :kind)))
                               (if parameter? true (= :authenticated-string-character-vector (get (get lexical :origin) :kind)))
                               (if (= nil body-consumer)
                                 (= (get slice-node :node-id) (get (get (get lexical :owner) :children) (if parameter? 0 1)))
                                 (if first-body?
                                   (let [head-node (get body-consumer :node) head-op (get body-consumer :operator)]
                                     (if (if (p15-s23-sse-ids? [(get head-node :node-id) (get head-op :node-id)] 2)
                                           (p15-s23-sse-ids? (get head-node :children) 2) false)
                                       (p15-s23-typed-all [(= head-node (get nodes (get head-node :node-id)))
                                                (= head-op (get nodes (get head-op :node-id)))
                                                (= (get head-node :node-id) (get (get (get lexical :owner) :children) 1))
                                                (= [(get head-op :node-id) (get slice-node :node-id)] (get head-node :children))]) false))
                                   false))
                               (= node (get nodes (get node :node-id)))
                               (= :call (get node :core-form)) (= 2 (count children))
                               (= :reference (get argument :core-form))
                               (= false (= (get argument :node-id) (get original :node-id)))
                               (= false (= (get (get argument :source) :form-id) (get (get original :source) :form-id)))
                               (= [] (get argument :children))
                               (= [(get local-binding :binding-id)] (get argument :resolved-binding-ids))
                               (= {:symbol (get local-binding :name) :position :expression :binding-id (get local-binding :binding-id)
                                   :binding-class :lexical :definition-syntax-id (get local-binding :definition-syntax-id)} (get argument :attributes))
                               (= (get local-binding :name) (get arg-form :value))
                               (= :symbol (get arg-form :kind)) (= [] (get arg-form :child-form-ids))
                               (= :value (get (get argument :evaluation) :kind)) (= [] (get (get argument :evaluation) :order))
                               (= (get (get argument :source) :form-id) (get (get owner :child-form-ids) 1))
                               (= (get owner :form-id) (get arg-form :parent-form-id) (get op-form :parent-form-id))
                               (= (get slice-form :form-id) (get owner :parent-form-id))
                               (= scope (get node :binding-context) (get operator :binding-context) (get argument :binding-context)
                                        (get owner :scope-id) (get op-form :scope-id) (get arg-form :scope-id))
                               (if (keyword? region) (contains? #{:module-initialization :function-body} region) false)
                               (= region (get (get node :evaluation) :region) (get (get operator :evaluation) :region) (get (get argument :evaluation) :region))
                               (= caller (get (get node :evaluation) :owner-function-syntax-id)
                                         (get (get operator :evaluation) :owner-function-syntax-id) (get (get argument :evaluation) :owner-function-syntax-id))
                               (= (get receiver :type) (get types (get argument :node-id)))])
                          (let [count-proof (p15-s23-nq-count core node nodes bindings types forms)]
                            (if (map? count-proof)
                              {:status :accepted :work-count work :source-forms [op-form arg-form]
                               :proof {:kind :same-immutable-vector-count :node node :source-form owner
                                       :operator operator :reference argument :binding local-binding :record record
                                       :cardinality-proof count-proof :value (count members)
                                       :relation :nonnegative :law :same-immutable-vector-cardinality}}
                              {:status :rejected :reason :vector-slice-source-mismatch :work-count work}))
                          {:status :rejected :reason :vector-slice-source-mismatch :work-count work})
                        {:status :rejected :reason :vector-slice-source-mismatch :work-count work}))
                    {:status :rejected :reason :vector-slice-source-mismatch :work-count work})
                    {:status :rejected :reason :vector-slice-source-mismatch :work-count work})))
              {:status :rejected :reason :vector-slice-source-mismatch :work-count work}))
          {:status :rejected :reason :vector-slice-source-mismatch :work-count work})
        {:status :rejected :reason :vector-slice-source-mismatch :work-count work}))))

(defn p15-s23-vsl-proof [core node call nodes bindings types forms budget]
  ; STD3 bounds apply only to a normal invocation. Each normal operand still
  ; requires its own proof; a child proof is reconstructed and paid again.
  (let [base (+ 128 (count (get core :function-records)))]
    (if (> base budget) {:status :rejected :reason :vector-slice-work-limit :work-count base}
      (if (if (vector? (get call :argument-node-ids)) (= 3 (count (get call :argument-node-ids))) false)
        (if (p15-s23-vsl-ids? node call nodes bindings (get core :module))
          (let [args (get call :argument-node-ids) children (get node :children)
                receiver-node (get nodes (get args 0)) start-node (get nodes (get args 1)) end-node (get nodes (get args 2))
                arguments (p15-s23-io-child-types args types)
                owner (get forms (get (get node :source) :form-id)) ids (get owner :child-form-ids)]
            (if (if (p15-s23-sse-ids? ids 4)
                  (loop [remaining args]
                    (if (= 0 (count remaining)) true
                      (let [operand (get nodes (first remaining))]
                        (if (p15-s23-sse-ids? [(get operand :node-id) (get (get operand :source) :form-id)
                                            (get (get operand :source) :syntax-id)] 3)
                          (recur (rest remaining)) false)))) false)
              (let [operator (get nodes (first children))
                    selected (loop [remaining children out [owner]]
                               (if (= 0 (count remaining)) out
                                 (recur (rest remaining) (conj out (get forms (get (get (get nodes (first remaining)) :source) :form-id))))))
                    valid-source? (if (symbol? (get (get selected 1) :value))
                                    (p15-s23-typed-all
                                      [(= :list (get owner :kind)) (= (get node :source) (p15-s23-typed-source owner))
                                       (loop [i 0]
                                         (if (= i 4) true
                                           (let [form (get selected (+ i 1)) child (get nodes (get children i))]
                                             (if (p15-s23-typed-all [(= (get ids i) (get form :form-id))
                                                   (= (get owner :form-id) (get form :parent-form-id))
                                                   (= (get child :source) (p15-s23-typed-source form))
                                                   (if (= i 0) (if (= :symbol (get form :kind))
                                                     (if (= [] (get form :child-form-ids)) (= (get form :value) (get (get child :attributes) :symbol)) false) false) true)])
                                               (recur (+ i 1)) false))))]) false)]
                (if valid-source?
                  (let [receiver (if (if (= :reference (get receiver-node :core-form))
                                  (= false (= :gravity.type/never (get types (get receiver-node :node-id)))) false)
                             (let [parameter (p15-s23-vsl-parameter core node receiver-node nodes bindings types forms (- budget base))]
                               (if (= :not-applicable (get parameter :status))
                                 (let [local (p15-s23-vsl-let core node receiver-node nodes bindings types forms
                                               (- budget base (get parameter :work-count)))]
                                   (assoc local :work-count (+ (get parameter :work-count) (get local :work-count)))) parameter))
                             (p15-s23-vsl-receiver core receiver-node nodes bindings types forms (- budget base)))
                        work (+ base (get receiver :work-count))]
                    (if (= :accepted (get receiver :status))
                      (let [start-type (get arguments 1) end-type (get arguments 2)
                            start (if (= :gravity.type/never start-type) {:kind :non-invoked-operand}
                                    (p15-s23-nq-literal start-node start-type forms false))
                            end-check (if (= :gravity.type/never end-type) {:status :accepted :work-count 0 :proof {:kind :non-invoked-operand}}
                                        (if (= :call (get end-node :core-form))
                                          (p15-s23-vsl-count-end core node end-node receiver nodes bindings types forms (- budget work))
                                          {:status :accepted :work-count 0 :proof (p15-s23-nq-literal end-node end-type forms false)}))
                            end (get end-check :proof)
                            normal? (loop [remaining arguments]
                                      (if (= 0 (count remaining)) true
                                        (if (= :gravity.type/never (first remaining)) false (recur (rest remaining)))))
                            members (get (get receiver :type) :element-types)
                            n (if (vector? members) (count members) 0)
                            work (+ work (get end-check :work-count) (* 16 (+ n 1)))]
                        (if (> work budget) {:status :rejected :reason :vector-slice-work-limit :work-count work}
                          (if (= :rejected (get end-check :status)) (assoc end-check :work-count work)
                          (if (if (keyword? start-type) (contains? #{:gravity.type/integer :gravity.type/never} start-type) false)
                            (if (if (keyword? end-type) (contains? #{:gravity.type/integer :gravity.type/never} end-type) false)
                              (if (if (map? start) (map? end) false)
                                (if (if normal? (<= 0 (get start :value) (get end :value) n) true)
                                  {:status :accepted :work-count work

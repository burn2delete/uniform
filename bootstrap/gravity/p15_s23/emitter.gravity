                 (if (= :gravity.type/vector (get type :kind))
                   (if (= :literal (get type :shape)) (vector? (get type :element-types)) false) false) false) false)))
           (loop [remaining (rest arguments)]
             (if (= 0 (count remaining)) true
               (if (keyword? (first remaining))
                 (if (contains? #{:gravity.type/integer :gravity.type/never} (first remaining))
                   (recur (rest remaining)) false) false)))
           (= (if invoked? :normal :not-invoked) (get proof :application))
           (if (= nil (first arguments)) false (= false (= :gravity.type/unknown (first arguments))))] )
      {:kind :gravity.type/applied-vector-slice :version :sh08-vector-slice-v1
       :operation 'subvec :semantic-owner 'gravity.collections :intrinsic :gravity.collections/proven-vector-slice
       :resolution :gravity.core-compatibility :operator-node-id (get operator :node-id) :operator-binding-id bid
       :call-core-node-id (get node :node-id) :source (get node :source) :operator-source (get operator :source)
       :source-call call :source-edge edge :source-binding binding :argument-types arguments
       :slice-policy {:range :start-inclusive-end-exclusive
                      :receiver (if (= :immutable-parameter-vector (get (get proof :receiver) :kind)) :immutable-parameter-vector
                                  (if (= :immutable-let-vector (get (get proof :receiver) :kind)) :immutable-let-vector
                                  (if (= :original-integer-vector-literal (get (get proof :receiver) :kind))
                                    :original-integer-vector-literal :authenticated-string-character-vector)))
                      :indexes (if (= :same-immutable-vector-count (get (get proof :end) :kind))
                                 :source-proven-literal-start-and-same-vector-count-end :source-proven-nonnegative-integer-literals)
                      :bounds :zero-le-start-le-end-le-count :operand-evaluation :receiver-then-start-then-end-once
                      :input-preserved? true :payloads :inert :allocation :normal-invocation-even-empty-or-full
                      :index-conversion :exact-in-bounded-range :check-elision :not-authorized :runtime-guards :retained
                      :value-work :logical-element-and-integer-units :integer-precision-bound :not-established
                      :provider-cpu-bound :not-established :provider-heap-bound :not-established}

       :bounds-proof proof :safety :proven-safe
       :storage-policy {:allocation :may-allocate-vector-slice :condition :normal-invocation
                        :representation :pending-profile-representation :provider :pending-runtime-provider
                        :ownership :pending-ownership-analysis}

       :application (if invoked? :normal :not-invoked)
       :latent-effects [:memory/allocate] :direct-effects (if invoked? [:memory/allocate] []) :capabilities [] :thrown-error-effects []
       :profile (get module :profile) :target (get module :target)

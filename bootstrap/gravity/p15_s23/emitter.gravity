                                (if (if (vector? items) (= 2 (count items)) false)
                                  (if (if (symbol? (get items 0)) (= 'quote (get items 0)) false)
                                    (if (symbol? (get items 1))
                                      (if (= (get items 1) (get attrs :quoted-value))
                                        (p15-s23-lsi-leaf? node forms :member) false) false) false) false)) false) false) false) false)) false)) false) false)
            (if (= :literal (get node :core-form))
              (if (if (symbol? (get attrs :value)) (symbol? (get owner :value)) false)
                (p15-s23-lsi-leaf? node forms :member) false) false)) false) false)) false))

(defn p15-s23-lsi-first-reference? [node env]
  (if (p15-s23-lsi-first-node? node)
    (let [bid (get (get node :attributes) :binding-id)]

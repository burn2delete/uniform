            (if (if (keyword? type) (contains? #{:gravity.type/nil :gravity.type/bool :gravity.type/integer :gravity.type/decimal :gravity.type/ratio
                            :gravity.type/i8 :gravity.type/i16 :gravity.type/i32 :gravity.type/i64

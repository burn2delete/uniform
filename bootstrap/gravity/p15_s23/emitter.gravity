(defn p15-s23-vsl-if-container [core let-node node nodes bindings forms local-call? budget]
  ; Exactly one original if container; no parent walk or branch-result inference.
  (let [controls (get core :control-flow) children (get node :children)
        work (+ 256 (if local-call? 32 0) (if (vector? controls) (* 6 (count controls)) 0))]
    (if (> work budget) {:status :rejected :reason :vector-slice-work-limit :work-count work}
      (if (if (if (boolean? local-call?) (vector? controls) false)
            (if (p15-s23-sse-ids? children 3)
              (if (p15-s23-sse-ids? [(get node :node-id) (get (get node :source) :form-id) (get (get node :source) :syntax-id)
                         (get let-node :node-id) (get (get let-node :source) :form-id) (get (get let-node :attributes) :body-scope-id)] 6)
                (loop [remaining controls] (if (= 0 (count remaining)) true
                  (if (p15-s23-sse-ids? [(get (first remaining) :core-node-id)] 1) (recur (rest remaining)) false))) false) false) false)
        (let [form (get forms (get (get node :source) :form-id)) ids (get form :child-form-ids)
              branch-nodes [(get nodes (get children 0)) (get nodes (get children 1)) (get nodes (get children 2))]

                  {:status :rejected :reason :map-get-source-mismatch :work-count work})
                {:status :rejected :reason (if (= :work-limit (get walked :reason)) :map-get-work-limit
                                             :map-get-private-first-entry-presence-required) :work-count work}))
            {:status :rejected :reason :map-get-source-mismatch :work-count used}))))
    {:status :rejected :reason :map-get-source-mismatch :work-count 0}))

(defn p15-s23-pc-candidate [core node call nodes types budget]
  ; Source structure chooses this probe; descriptor tags never do.
  (let [args (get call :argument-node-ids)
        receiver (p15-s23-pc-current-node (if (vector? args) (get args 0) nil) nodes)
        key-node (p15-s23-pc-current-node (if (vector? args) (get args 1) nil) nodes)
        receiver-type (get types (get receiver :node-id))]
    (if (if (vector? args) (if (= 2 (count args))
          (if (= :literal (get key-node :core-form))
            (if (if (= :keyword (get (get key-node :attributes) :literal-kind))
                  (if (keyword? (get (get key-node :attributes) :value))
                    (if (vector? (get key-node :children)) (if (= 0 (count (get key-node :children)))
                      (if (vector? (get key-node :resolved-binding-ids)) (= 0 (count (get key-node :resolved-binding-ids))) false) false) false) false) false)
              (if (= :gravity.type/map receiver-type) true
                (if (map? receiver-type) (= :gravity.type/map (get receiver-type :kind)) false)) false) false) false) false)
      (if (= :reference (get receiver :core-form))
        (let [records (get core :lexical-bindings) width (if (vector? records) (count records) 0) work (* 2 width)
              bid (get (get receiver :attributes) :binding-id)]
          (if (> work budget) {:status :rejected :reason :map-get-work-limit :work-count work}
            (if (if (p15-s23-pc-id? bid) (if (vector? records)
                  (map? (p15-s23-pe-one records :binding-id bid)) false) false)
              {:status :accepted :work-count work} {:status :not-applicable :work-count work})))
        (if (= :call (get receiver :core-form))
          (let [children (get receiver :children) operator (p15-s23-pc-current-node (if (vector? children) (get children 0) nil) nodes)
                symbol (get (get operator :attributes) :symbol)]
            (if (if (= :reference (get operator :core-form))
                  (if (symbol? symbol) (if (= 'first symbol) true (= 'gravity.core/first symbol)) false) false)
              {:status :accepted :work-count 0} {:status :not-applicable :work-count 0}))
          {:status :not-applicable :work-count 0}))
      {:status :not-applicable :work-count 0})))

(defn p15-s23-pc-route [core node call nodes bindings budget]
  (let [calls (get core :calls) edges (get core :call-edges)
        base (+ 32 (* 4 (if (vector? calls) (count calls) 0)) (* 4 (if (vector? edges) (count edges) 0)))]
    (if (> base budget) {:status :rejected :reason :map-get-work-limit :work-count base}
      (if (if (vector? calls) (vector? edges) false)
        (let [receiver (get (get call :argument-node-ids) 0)
              outer (p15-s23-pc-unroll receiver core nodes bindings (- budget base))
              used (+ base (get outer :work-count))]
          (if (= :map-get-work-limit (get outer :reason)) (assoc outer :work-count used)
            (if (= :accepted (get outer :status))
              (let [first-id (get outer :node-id) first-node (get nodes first-id)
                    first-call (p15-s23-pe-one calls :core-node-id first-id)
                    first-edge (p15-s23-pe-one edges :call-core-node-id first-id)
                    first-bid (get first-call :operator-binding-id)
                    first-args (get first-call :argument-node-ids)]
                (if (if (p15-s23-pc-id? first-bid) (if (vector? first-args) (= 1 (count first-args)) false) false)
                  (let [first-binding (get bindings first-bid)]
                    (if (if (= 'first (get first-binding :name)) (p15-s23-lq-binding? first-binding (get core :module)) false)
                      (let [inner (p15-s23-pc-unroll (get first-args 0) core nodes bindings (- budget used))
                            total (+ used (get inner :work-count))]
                        (if (= :accepted (get inner :status))
                          (let [get-id (get inner :node-id) get-node (get nodes get-id)
                                get-call (p15-s23-pe-one calls :core-node-id get-id)
                                get-edge (p15-s23-pe-one edges :call-core-node-id get-id)
                                get-bid (get get-call :operator-binding-id) get-args (get get-call :argument-node-ids)]
                            (if (if (p15-s23-pc-id? get-bid) (if (vector? get-args) (if (= 2 (count get-args))
                                  (if (p15-s23-pc-id? (get get-args 0)) (p15-s23-pc-id? (get get-args 1)) false) false) false) false)
                              (if (p15-s23-mg-binding? (get bindings get-bid) (get core :module))
                                (if (if (p15-s23-pc-id? (get (get node :evaluation) :owner-function-syntax-id))
                                    (if (p15-s23-pc-id? (get (get first-node :evaluation) :owner-function-syntax-id))
                                     (if (p15-s23-pc-id? (get (get get-node :evaluation) :owner-function-syntax-id))
                                      (if (p15-s23-pc-id? (get first-edge :caller-function-syntax-id))
                                        (if (p15-s23-pc-id? (get get-edge :caller-function-syntax-id))
                                  (p15-s23-typed-all
                                      [(= :call (get first-node :core-form) (get get-node :core-form))
                                       (= false (= first-id get-id)) (= false (= first-id (get node :node-id)))
                                       (= false (= get-id (get node :node-id)))
                                       (p15-s23-pc-id? (get first-edge :caller-function-syntax-id))
                                       (p15-s23-pc-id? (get get-edge :caller-function-syntax-id))
                                       (p15-s23-pc-id? (get first-call :operator-node-id)) (p15-s23-pc-id? (get get-call :operator-node-id))
                                       (map? first-edge) (map? get-edge)
                                       (= (get (get node :evaluation) :owner-function-syntax-id)
                                          (get (get first-node :evaluation) :owner-function-syntax-id)
                                          (get (get get-node :evaluation) :owner-function-syntax-id)
                                          (get first-edge :caller-function-syntax-id) (get get-edge :caller-function-syntax-id))]) false) false) false) false) false)
                                  {:status :accepted :work-count total
                                   :first-node-id first-id :first-call first-call :first-edge first-edge
                                   :get-node-id get-id :get-call get-call :get-edge get-edge
                                   :receiver-links (get outer :links) :vector-links (get inner :links)}
                                  {:status :rejected :reason :map-get-source-mismatch :work-count total})
                                {:status :rejected :reason :map-get-source-mismatch :work-count total})
                              {:status :rejected :reason :map-get-source-mismatch :work-count total}))
                          (assoc inner :work-count total)))
                      {:status :not-applicable :work-count used}))
                  {:status :not-applicable :work-count used}))
              {:status :not-applicable :work-count used})))
        {:status :rejected :reason :map-get-source-mismatch :work-count base}))))

(defn p15-s23-pc-form-source [form]
  (p15-s23-typed-source form))

(defn p15-s23-pc-keys? [value fields]
  (if (map? value)
    (if (= (count value) (count fields))
      (if (loop [remaining (keys value)]
            (if (= 0 (count remaining)) true
              (if (keyword? (first remaining)) (recur (rest remaining)) false)))
        (= fields (set (keys value))) false) false) false))

(defn p15-s23-pc-selected-type? [type]
  (if (keyword? type)
    (contains? #{:gravity.type/nil :gravity.type/bool :gravity.type/integer :gravity.type/keyword
                 :gravity.type/string :gravity.type/symbol} type) false))

(defn p15-s23-pc-source-domain? [source]
  (if (p15-s23-pc-keys? source #{:form-id :syntax-id :semantic-span :origin-chain :generated-origin})
    (p15-s23-typed-all [(p15-s23-pc-id? (get source :form-id)) (p15-s23-pc-id? (get source :syntax-id))
      (if (= nil (get source :semantic-span)) true (map? (get source :semantic-span)))
      (if (vector? (get source :origin-chain)) (<= (count (get source :origin-chain)) 256) false)
      (if (= nil (get source :generated-origin)) true
        (let [origins (get source :generated-origin)]
          (if (vector? origins)
            (if (<= (count origins) 256)
              (loop [remaining origins]
                (if (= 0 (count remaining)) true
                  (let [origin (first remaining)]
                    (if (p15-s23-pc-keys? origin #{:origin-id :kind :from-syntax-id :role})
                      (if (p15-s23-pc-id? (get origin :origin-id))
                        (if (p15-s23-pc-id? (get origin :from-syntax-id))
                          (recur (rest remaining)) false) false) false)))) false) false)))]) false))

(defn p15-s23-pc-links-domain? [links]
  (if (if (vector? links) (<= (count links) 128) false)
    (loop [remaining links]
      (if (= 0 (count remaining)) true
        (let [link (first remaining) record (get link :binding-record)]
          (if (p15-s23-typed-all
                [(p15-s23-pc-keys? link #{:reference-core-node-id :reference-source :binding-record})
                 (p15-s23-pc-id? (get link :reference-core-node-id)) (p15-s23-pc-source-domain? (get link :reference-source))
                 (p15-s23-pc-keys? record #{:let-core-node-id :ordinal :name :binding-id :definition-form-id :definition-syntax-id
                                       :binding-scope-id :initializer-form-id :initializer-syntax-id :initializer-scope-id
                                       :initializer-node-id :visible-prior-binding-ids :mutability})
                 (if (integer? (get record :ordinal)) (if (<= 0 (get record :ordinal)) (< (get record :ordinal) 1024) false) false)
                 (symbol? (get record :name)) (= :immutable (get record :mutability))
                 (loop [ids [(get record :let-core-node-id) (get record :binding-id) (get record :definition-form-id)
                             (get record :definition-syntax-id) (get record :binding-scope-id) (get record :initializer-form-id)
                             (get record :initializer-syntax-id) (get record :initializer-scope-id) (get record :initializer-node-id)]]
                   (if (= 0 (count ids)) true (if (p15-s23-pc-id? (first ids)) (recur (rest ids)) false)))
                 (if (vector? (get record :visible-prior-binding-ids))
                   (if (<= (count (get record :visible-prior-binding-ids)) 1024)
                     (loop [ids (get record :visible-prior-binding-ids)]
                       (if (= 0 (count ids)) true (if (p15-s23-pc-id? (first ids)) (recur (rest ids)) false))) false) false)])
            (recur (rest remaining)) false)))) false))

(defn p15-s23-pc-parent-parameter [route core nodes bindings budget]
  ; The outer lookup must be the existing private parameter owner.
  (let [call (get route :get-call) id (get (get call :argument-node-ids) 0)
        receiver (p15-s23-pc-current-node id nodes) owner-id (get (get receiver :evaluation) :owner-function-syntax-id) records (get core :function-records)
        base (+ 32 (* 4 (if (vector? records) (count records) 0)))]
    (if (> base budget) {:status :rejected :reason :map-get-work-limit :work-count base}
      (if (if (vector? records) (p15-s23-pc-id? owner-id) false)
        (let [record (p15-s23-pe-one records :function-syntax-id owner-id)
              ids (get record :parameter-binding-ids) bid (get (get receiver :attributes) :binding-id)
              used (+ base (if (vector? ids) (* 2 (count ids)) 0))]
          (if (> used budget) {:status :rejected :reason :map-get-work-limit :work-count used}
            (if (if (vector? ids) (if (p15-s23-pc-id? bid)
                  (if (= :reference (get receiver :core-form))
                    (if (= :lexical (get (get receiver :attributes) :binding-class))
                      (= 1 (loop [remaining ids matches 0]
                             (if (= 0 (count remaining)) matches
                               (recur (rest remaining) (+ matches (if (= bid (first remaining)) 1 0)))))) false) false) false) false)
              {:status :accepted :work-count used :record record}
              {:status :rejected :reason :map-get-private-first-entry-presence-required :work-count used})))
        {:status :rejected :reason :map-get-source-mismatch :work-count base}))))

(defn p15-s23-pc-entry-set-work [parent record core budget]
  (let [calls (get core :calls) entries (get (get parent :presence-proof) :entries)
        base (+ 32 (* 4 (if (vector? calls) (count calls) 0)) (* 4 (if (vector? entries) (count entries) 0)))]
    (if (> base budget) {:status :rejected :reason :map-get-work-limit :work-count base}
      (if (if (vector? calls) (vector? entries) false)
        (let [actual (p15-s23-pe-select calls :operator-binding-id (get record :definition-binding-id))]
          (if (= (count actual) (count entries))
            (if (loop [i 0]
                  (if (= i (count actual)) true
                    (let [id (get (get entries i) :call-core-node-id)]
                      (if (p15-s23-pc-id? id)
                        (if (= id (get (get actual i) :core-node-id)) (recur (+ i 1)) false) false))))
              {:status :accepted :work-count base}
              {:status :rejected :reason :map-get-source-mismatch :work-count base})
            {:status :rejected :reason :map-get-private-first-entry-presence-required :work-count base}))
        {:status :rejected :reason :map-get-source-mismatch :work-count base}))))

(defn p15-s23-pc-project [header route parent first-descriptor nodes budget]
  ; Parent types have already survived current BT and BS reconstruction.
  (let [proof (get parent :presence-proof) entries (get proof :entries)
        vector-type (get parent :result-type) map-type (get first-descriptor :result-type)
        base (+ 32 (* 8 (if (vector? entries) (count entries) 0)))]
    (if (> base budget) {:status :rejected :reason :map-get-work-limit :work-count base}
      (if (if (= :sh08-map-get-private-entry-v1 (get parent :version))
            (if (= :gravity.type/applied-vector-first (get first-descriptor :kind))
              (if (= :normal (get header :application))
                (if (vector? entries) (if (< 0 (count entries)) (<= (count entries) 1024) false) false) false) false) false)
        (loop [remaining entries rows [] projections [] selected nil normals 0 used base]
          (if (= 0 (count remaining))
            (if (< 0 normals)
              {:status :accepted :work-count used :rows rows :projections projections :type selected}
              {:status :rejected :reason :map-get-private-first-entry-presence-required :work-count used})
            (let [entry (first remaining)
                  projected (p15-s23-pc-current-entry entry (get parent :key) (get header :key)
                              vector-type map-type nodes (- budget used))
                  total (+ used (get projected :work-count)) row (get projected :row)
                  type (get (get row :selection) :type) invoked? (= :invoked (get row :entry))]
              (if (= :accepted (get projected :status))
                (if (if invoked? (if (p15-s23-pc-selected-type? type) (if (= nil selected) true (= selected type)) false) true)
                  (recur (rest remaining) (conj rows row) (conj projections projected)
                    (if invoked? type selected) (+ normals (if invoked? 1 0)) total)
                  {:status :rejected :reason :map-get-private-first-entry-selected-type-required :work-count total})
                (assoc projected :work-count total)))))
        {:status :rejected :reason :map-get-private-first-entry-presence-required :work-count base}))))

(defn p15-s23-pc-authenticate-project [project nodes forms budget]
  (loop [remaining (get project :projections) used 0]
    (if (= 0 (count remaining)) {:status :accepted :work-count used}
      (let [checked (p15-s23-pc-authenticate-entry (first remaining) nodes forms (- budget used))
            total (+ used (get checked :work-count))]
        (if (= :accepted (get checked :status)) (recur (rest remaining) total)
          (assoc checked :work-count total))))))

(defn p15-s23-pc-finish [header route project]
  (let [type (get project :type)]
    (assoc header :version :sh08-map-get-private-first-entry-v1
      :parameter-types (get header :argument-types) :return type :result-type type
      :lookup-policy (assoc (get header :lookup-policy) :input :private-first-entry)
      :presence-proof {:kind :private-first-entry-key-presence
                       :get-call-core-node-id (get route :get-node-id)
                       :first-call-core-node-id (get route :first-node-id)
                       :receiver-links (get route :receiver-links) :vector-links (get route :vector-links)
                       :entries (get project :rows) :selected-type type}
      :invalidation (conj (conj (conj (get header :invalidation) :parent-call-descriptors)
                           :parent-call-facts) :parent-producer-rows :mutations :immutable-binding-links :incoming-arguments :source-spine))))

(defn p15-s23-pc-descriptor-work [supplied expected budget]
  ; Resource payment dominates schema tests and equality. Exact reconstruction
  ; closes every nested row; no supplied field selects a route or table lookup.
  (let [walked (p15-s23-pc-evidence-work supplied budget) used (get walked :work-count)
        proof (get supplied :presence-proof)]
    (if (= :accepted (get walked :status))
      (if (if (p15-s23-pc-keys? proof #{:kind :get-call-core-node-id :first-call-core-node-id
                                   :receiver-links :vector-links :entries :selected-type})
            (if (= :private-first-entry-key-presence (get proof :kind))
              (if (p15-s23-pc-id? (get proof :get-call-core-node-id))
                (if (p15-s23-pc-id? (get proof :first-call-core-node-id))
                  (if (p15-s23-pc-links-domain? (get proof :receiver-links))
                    (if (p15-s23-pc-links-domain? (get proof :vector-links))
                      (if (p15-s23-pc-selected-type? (get proof :selected-type)) (= supplied expected) false) false) false) false) false) false) false)
        {:status :accepted :work-count used}
        {:status :rejected :reason :map-get-source-mismatch :work-count used})
      walked)))

(defn p15-s23-pc-without [value fields]
  (if (map? value)
    (loop [remaining (vec value) out {}]
      (if (= 0 (count remaining)) out
        (let [entry (first remaining) key (get entry 0)]
          (if (keyword? key)
            (recur (rest remaining) (if (contains? fields key) out (assoc out key (get entry 1)))) nil)))) nil))

(defn p15-s23-pc-entry-metadata-work [entries budget]
  (loop [remaining entries out [] used 0]
    (if (= 0 (count remaining)) {:status :accepted :work-count used :value out}
      (let [entry (first remaining) work (+ used 16)]
        (if (> work budget) {:status :rejected :reason :map-get-work-limit :work-count work}
          (if (map? entry)
            (recur (rest remaining)
              (conj out (p15-s23-typed-project entry [:call-core-node-id :argument-node-id :entry])) work)
            {:status :rejected :reason :map-get-source-mismatch :work-count work}))))))

(defn p15-s23-pc-origin-point [origin]
  (if (= nil origin) nil
    [(get origin :kind) (get origin :quote-core-node-id) (get origin :form-id) (get origin :data-path)]))

(defn p15-s23-pc-parent-reference [descriptor]
  (let [source (get descriptor :source) operator (get descriptor :operator-source)
        binding (get descriptor :source-binding)]
    (assoc (p15-s23-typed-project descriptor
             [:kind :version :operation :semantic-owner :intrinsic :resolution :call-core-node-id :operator-node-id
              :operator-binding-id :key-node-id :key :application :profile :target :result-type
              :latent-effects :direct-effects :capabilities :thrown-error-effects])
      :source-ids [(get source :form-id) (get source :syntax-id)]
      :operator-source-ids [(get operator :form-id) (get operator :syntax-id)]
      :binding-source-ids [(get binding :binding-id) (get binding :definition-syntax-id)])))

(defn p15-s23-pc-shape-metadata [shape]
  {:shape-kind (get shape :shape-kind) :constructor-origin (get shape :constructor-origin)
   :constructor-node-id (get shape :constructor-node-id) :node-id (get shape :node-id)
   :form-id (get (get shape :source) :form-id) :origin (p15-s23-pc-origin-point (get shape :data-origin))})

(defn p15-s23-pc-part-metadata [part]
  {:coordinate (get part :coordinate) :key (get part :key)
   :key-node-id (get part :key-node-id) :value-node-id (get part :value-node-id)
   :key-origin (p15-s23-pc-origin-point (get part :key-data-origin))
   :value-origin (p15-s23-pc-origin-point (get part :value-data-origin))})

(defn p15-s23-pc-ancestry-work [entries key budget]
  (if (keyword? key)
  (loop [remaining entries out [] used 0]
    (if (= 0 (count remaining)) {:status :accepted :value out :work-count used}
      (let [entry (first remaining)]
        (if (= :not-invoked (get entry :entry))
          (recur (rest remaining) (conj out nil) used)
          (let [argument (get entry :argument-shape) outer (get entry :selected-part)
                vector (get outer :shape) vector-parts (get vector :parts)
                head (if (vector? vector-parts) (get vector-parts 0) nil)
                map-shape (get head :shape) parts (get map-shape :parts)
                width (if (vector? parts) (count parts) 0) prefix (+ used 32 (* 8 width))]
            (if (> prefix budget) {:status :rejected :reason :map-get-work-limit :work-count prefix}
              (if (if (vector? vector-parts) (if (< 0 (count vector-parts)) (if (vector? parts) (<= width 512) false) false) false)
                (let [selected (loop [i 0 seen #{} found nil]
                                 (if (= i width) found
                                   (let [part (get parts i) actual (get part :key)]
                                     (if (keyword? actual)
                                       (if (contains? seen actual) nil
                                         (if (= (+ 1 (* 2 i)) (get part :coordinate))
                                           (recur (+ i 1) (conj seen actual) (if (= key actual) part found)) nil)) nil))))
                      data {:shapes [(p15-s23-pc-shape-metadata argument) (p15-s23-pc-shape-metadata vector)
                                     (p15-s23-pc-shape-metadata map-shape)]
                            :parts [(p15-s23-pc-part-metadata outer) (p15-s23-pc-part-metadata head)
                                    (p15-s23-pc-part-metadata selected)]
                            :vector-length (count vector-parts)
                            :selected-shape {:type (get (get selected :shape) :type)
                                             :node-id (get (get selected :shape) :node-id)
                                             :source-form-id (get (get (get selected :shape) :source) :form-id)
                                             :origin (p15-s23-pc-origin-point (get (get selected :shape) :data-origin))
                                             :values (get (get (get selected :shape) :domain) :values)}}
                      measured (p15-s23-pc-evidence-work data (- budget prefix)) total (+ prefix (get measured :work-count))]
                  (if (= :accepted (get measured :status))
                    (if (map? selected) (recur (rest remaining) (conj out data) total)
                      {:status :rejected :reason :map-get-private-first-entry-presence-required :work-count total})
                    (assoc measured :work-count total)))
                {:status :rejected :reason :map-get-source-mismatch :work-count prefix})))))))
    {:status :rejected :reason :map-get-private-first-entry-presence-required :work-count 0}))

(defn p15-s23-pc-parent-data-work [descriptor inner-key budget]
  ; A BU dependency projection, not the identity of the entire BT artifact.
  ; Original BT/BS reconstruction owns the census and complete operand types.
  ; The full current source projection owns demanded shape ancestry below.
  (let [proof (get descriptor :presence-proof) entries (get proof :entries)
        base (+ 112 (* 8 (if (vector? entries) (count entries) 0)))]
    (if (> base budget) {:status :rejected :reason :map-get-work-limit :work-count base}
      (if (if (map? descriptor) (if (= :sh08-map-get-private-entry-v1 (get descriptor :version))
            (if (map? proof) (if (vector? entries) (<= (count entries) 1024) false) false) false) false)
        (let [rows (p15-s23-pc-entry-metadata-work entries (- budget base)) prefix (+ base (get rows :work-count))]
          (if (= :accepted (get rows :status))
            (let [data {:parent-reference (p15-s23-pc-parent-reference descriptor)
                        :proof-kind (get proof :kind) :proof-key (get proof :key) :entries (get rows :value)}
                  measured (p15-s23-pc-evidence-work data (- budget prefix)) used (+ prefix (get measured :work-count))]
              (if (= :accepted (get measured :status))
                {:status :accepted :work-count used :value data}
                (assoc measured :work-count used)))
            (assoc rows :work-count prefix)))
        {:status :rejected :reason :map-get-source-mismatch :work-count base}))))

(defn p15-s23-pc-parent-match-work [supplied expected key budget]
  (let [actual (p15-s23-pc-parent-data-work supplied key budget) used (get actual :work-count)
        rebuilt (if (= :accepted (get actual :status))
                  (p15-s23-pc-parent-data-work expected key (- budget used)) actual)
        total (+ used (if (= :accepted (get actual :status)) (get rebuilt :work-count) 0))]
    (if (= :accepted (get rebuilt :status))
      (if (= (get actual :value) (get rebuilt :value))
        {:status :accepted :work-count total
         :parent-reference (get (get rebuilt :value) :parent-reference)}
        {:status :rejected :reason :map-get-source-mismatch :work-count total})
      (assoc rebuilt :work-count total))))

(defn p15-s23-pc-carried-parent-work [descriptor applied-key inner-key budget]
  ; Reference keys are fixed program text. Pay construction before reads,
  ; then walk every independent supplied value, including nested Map keys.
  (let [fields [:kind :version :operation :semantic-owner :intrinsic :resolution :call-core-node-id :operator-node-id
                :operator-binding-id :key-node-id :key :application :profile :target :result-type
                :latent-effects :direct-effects :capabilities :thrown-error-effects
                :source-ids :operator-source-ids :binding-source-ids]
        base (+ 32 (* 4 (count fields)))]
    (if (> base budget) {:status :rejected :reason :map-get-work-limit :work-count base}
      (let [reference (p15-s23-pc-parent-reference descriptor)
            values (loop [remaining fields out []]
                     (if (= 0 (count remaining)) out
                       (recur (rest remaining) (conj out (get reference (first remaining))))))
            walked (p15-s23-pc-evidence-work values (- budget base))
            used (+ base (get walked :work-count))]
        (if (= :accepted (get walked :status))
          (if (if (= :applied-map-get applied-key)
                (if (= :gravity.type/applied-map-get (get reference :kind))
                  (= :sh08-map-get-private-entry-v1 (get reference :version)) false)
                (if (= :applied-vector-first applied-key)
                  (if (= :gravity.type/applied-vector-first (get reference :kind))
                    (= :sh08-vector-first-v1 (get reference :version)) false) false))
            {:status :accepted :work-count used :value reference}
            {:status :rejected :reason :map-get-source-mismatch :work-count used})
          (assoc walked :work-count used))))))

(defn p15-s23-pc-fact-data [fact applied-key application applied]
  {:fields (p15-s23-pc-without fact (conj #{:fact-id-request} applied-key))
   :request (p15-s23-pc-without (get fact :fact-id-request) #{:application}) :application application :applied applied})

(defn p15-s23-pc-fact-data-work [fact applied-key inner-key budget]
  (let [request (get fact :fact-id-request)
        base (+ 32 (* 4 (if (map? fact) (count fact) 0)) (* 4 (if (map? request) (count request) 0)))]
    (if (> base budget) {:status :rejected :reason :map-get-work-limit :work-count base}
      (let [application (p15-s23-pc-carried-parent-work (get request :application) applied-key inner-key (- budget base))
            used (+ base (get application :work-count))
            applied (if (= :accepted (get application :status))
                      (p15-s23-pc-carried-parent-work (get fact applied-key) applied-key inner-key (- budget used)) application)
            spent (+ used (if (= :accepted (get application :status)) (get applied :work-count) 0))]
        (if (= :accepted (get applied :status))
          (let [data (p15-s23-pc-fact-data fact applied-key (get application :value) (get applied :value))
                measured (p15-s23-pc-evidence-work (p15-s23-typed-project data [:fields :request]) (- budget spent))
                total (+ spent (get measured :work-count))]
            (if (= :accepted (get measured :status)) {:status :accepted :work-count total :value data}
              (assoc measured :work-count total)))
          (assoc applied :work-count spent))))))

(defn p15-s23-pc-row-data [row application dependencies]
  {:fields (p15-s23-pc-without row #{:constraint-id-request :dependencies})
   :request (p15-s23-pc-without (get row :constraint-id-request) #{:application}) :application application :dependencies dependencies})

(defn p15-s23-pc-row-data-work [row applied-key inner-key budget]
  (let [request (get row :constraint-id-request)
        base (+ 32 (* 4 (if (map? row) (count row) 0)) (* 4 (if (map? request) (count request) 0)))]
    (if (> base budget) {:status :rejected :reason :map-get-work-limit :work-count base}
      (let [application (p15-s23-pc-carried-parent-work (get request :application) applied-key inner-key (- budget base))
            used (+ base (get application :work-count))
            applied (if (= :accepted (get application :status))
                      (p15-s23-pc-carried-parent-work (get row :dependencies) applied-key inner-key (- budget used)) application)
            spent (+ used (if (= :accepted (get application :status)) (get applied :work-count) 0))]
        (if (= :accepted (get applied :status))
          (let [data (p15-s23-pc-row-data row (get application :value) (get applied :value))
                measured (p15-s23-pc-evidence-work (p15-s23-typed-project data [:fields :request]) (- budget spent))
                total (+ spent (get measured :work-count))]
            (if (= :accepted (get measured :status)) {:status :accepted :work-count total :value data}
              (assoc measured :work-count total)))
          (assoc applied :work-count spent))))))

(defn p15-s23-pc-parent-carriers-work [parents current-parent current-first get-data first-data core facts inner-key budget]
  (let [get-reference (get get-data :parent-reference) first-reference (p15-s23-pc-parent-reference first-data)
        get-id (get parents :get-call-id) first-id (get parents :first-call-id)
        get-facts (p15-s23-pe-select (get facts :call-type-facts) :call-core-node-id get-id)
        first-facts (p15-s23-pe-select (get facts :call-type-facts) :call-core-node-id first-id)
        get-rows (p15-s23-pe-select (p15-s23-pe-select (get facts :constraint-ledger) :producer-rule :sh08-map-get-v1)
                   :lhs {:core-node-id get-id :projection :map-get})
        first-rows (p15-s23-pe-select (p15-s23-pe-select (get facts :constraint-ledger) :producer-rule :sh08-vector-first-v1)
                     :lhs {:core-node-id first-id :projection :vector-first})]
    (if (= 1 (count get-facts) (count first-facts) (count get-rows) (count first-rows))
      (loop [pending [[(first get-facts) :fact :applied-map-get
                       (p15-s23-pc-fact-data (p15-s23-mg-call-fact current-parent (get core :module)) :applied-map-get get-reference get-reference)]
                      [(first first-facts) :fact :applied-vector-first
                       (p15-s23-pc-fact-data (p15-s23-lq-call-fact current-first (get core :module)) :applied-vector-first first-reference first-reference)]
                      [(first get-rows) :row :applied-map-get
                       (p15-s23-pc-row-data (p15-s23-mg-constraint current-parent) get-reference get-reference)]
                      [(first first-rows) :row :applied-vector-first
                       (p15-s23-pc-row-data (p15-s23-lq-constraint current-first) first-reference first-reference)]] used 0]
        (if (= 0 (count pending)) {:status :accepted :work-count used}
          (let [item (first pending)
                checked (if (= :fact (get item 1))
                          (p15-s23-pc-fact-data-work (get item 0) (get item 2) inner-key (- budget used))
                          (p15-s23-pc-row-data-work (get item 0) (get item 2) inner-key (- budget used)))
                total (+ used (get checked :work-count))]
            (if (= :accepted (get checked :status))
              (if (= (get checked :value) (get item 3)) (recur (rest pending) total)
                {:status :rejected :reason :map-get-source-mismatch :work-count total})
              (assoc checked :work-count total)))))
      {:status :rejected :reason :map-get-source-mismatch :work-count 0})))

(defn p15-s23-pc-first-work [route core nodes bindings types budget]
  (let [call (get route :first-call) node (get nodes (get route :first-node-id))
        base (+ 32 (count (get core :function-records)))]
    (if (> base budget) {:status :rejected :reason :map-get-work-limit :work-count base}
      (let [checked (p15-s23-lc-type-work (p15-s23-io-child-types (get call :argument-node-ids) types) (- budget base))
            used (+ base (get checked :work-count))
            header (if (= :accepted (get checked :status))
                     (p15-s23-lq-source core node call (get route :first-edge) nodes bindings types (get core :module) checked) nil)
            descriptor (if (map? header) (p15-s23-lq-finish header) nil)
            supplied (get types (get call :operator-node-id))
            carrier (if (map? descriptor) (p15-s23-pc-evidence-work supplied (- budget used))
                      {:status :rejected :reason :map-get-source-mismatch :work-count 0})
            spent (+ used (get carrier :work-count))]
        (if (if (= :accepted (get carrier :status)) (if (= :accepted (get checked :status)) (if (map? descriptor)
              (if (= :gravity.type/applied-vector-first (get descriptor :kind))
                (if (= descriptor (get types (get call :operator-node-id)))
                  (= (get descriptor :result-type) (get types (get node :node-id))) false) false) false) false) false)
          {:status :accepted :work-count spent :descriptor descriptor :type-validation checked}
          {:status :rejected :reason (if (if (= :work-limit (get checked :reason)) true (= :map-get-work-limit (get carrier :reason))) :map-get-work-limit :map-get-source-mismatch)
           :work-count spent})))))

(defn p15-s23-pc-call-forms-work [node call nodes forms budget]
  (let [owner-id (get (get node :source) :form-id)
        base 32]
    (if (> base budget) {:status :rejected :reason :map-get-work-limit :work-count base}
      (if (p15-s23-pc-id? owner-id)
        (let [owner (get forms owner-id) ids (get owner :child-form-ids) children (get node :children)
              width (if (vector? ids) (count ids) 0) charge (+ base (* 8 width))]
          (if (> charge budget) {:status :rejected :reason :map-get-work-limit :work-count charge}
            (if (if (vector? ids) (if (vector? children) (if (<= width 4) (= width (count children)) false) false) false)
              (let [measured (p15-s23-pc-evidence-work {:source (get node :source) :form-source (p15-s23-pc-form-source owner)}
                               (- budget charge)) used (+ charge (get measured :work-count))]
                (if (= :accepted (get measured :status))
                  (if (if (= owner-id (get owner :form-id)) (if (= :list (get owner :kind))
                        (= (get node :source) (p15-s23-pc-form-source owner)) false) false)
                    (loop [i 0 total used]
                      (if (= i width) {:status :accepted :work-count total}
                        (let [id (get ids i) child-id (get children i)]
                          (if (if (p15-s23-pc-id? id) (p15-s23-pc-id? child-id) false)
                            (let [form (get forms id) child (p15-s23-pc-current-node child-id nodes)
                                  walked (p15-s23-pc-evidence-work {:source (get child :source) :form-source (p15-s23-pc-form-source form)
                                                                :symbol (if (= i 0) (get form :value) nil)
                                                                :literal (if (= :literal (get child :core-form)) (get (get child :attributes) :value) nil)
                                                                :form-literal (if (= :literal (get child :core-form)) (get form :value) nil)}
                                           (- budget total))
                                  spent (+ total (get walked :work-count))]
                              (if (= :accepted (get walked :status))
                                (if (p15-s23-typed-all [(= id (get form :form-id)) (= owner-id (get form :parent-form-id))
                                      (= (get child :source) (p15-s23-pc-form-source form))
                                      (if (= :literal (get child :core-form))
                                        (if (= :keyword (get (get child :attributes) :literal-kind))
                                          (if (= :keyword (get form :kind))
                                            (if (keyword? (get form :value))
                                              (= (get (get child :attributes) :value) (get form :value)) false) false) false) true)
                                      (if (= i 0) (if (= :symbol (get form :kind))
                                        (= (get form :value) (get (get child :attributes) :symbol)) false) true)])
                                  (recur (+ i 1) spent)
                                  {:status :rejected :reason :map-get-source-mismatch :work-count spent})
                                (assoc walked :work-count spent)))
                            {:status :rejected :reason :map-get-source-mismatch :work-count total}))))
                    {:status :rejected :reason :map-get-source-mismatch :work-count used})
                  (assoc measured :work-count used)))
              {:status :rejected :reason :map-get-source-mismatch :work-count charge})))
        {:status :rejected :reason :map-get-source-mismatch :work-count base}))))

(defn p15-s23-pc-links-forms-work [links core nodes bindings forms budget]
  (loop [remaining links used 0]
    (if (= 0 (count remaining)) {:status :accepted :work-count used}
      (let [link (first remaining) record (get link :binding-record)
            measured (p15-s23-pc-evidence-work link (- budget used)) prefix (+ used (get measured :work-count))]
        (if (= :accepted (get measured :status))
          (if (p15-s23-pc-links-domain? [link])
            (let [reference (get nodes (get link :reference-core-node-id))
                  owner (get nodes (get record :let-core-node-id))
                  owner-id (get (get owner :source) :form-id) vector-id (get (get owner :attributes) :binding-vector-form-id)
                  reference-id (get (get reference :source) :form-id)]
              (if (if (p15-s23-pc-id? owner-id) (if (p15-s23-pc-id? vector-id) (p15-s23-pc-id? reference-id) false) false)
                (let [owner-form (get forms owner-id) vector-form (get forms vector-id)
                      ref-form (get forms reference-id) owner-ids (get owner-form :child-form-ids)
                      vector-ids (get vector-form :child-form-ids) index (get record :ordinal)
                      charge (+ prefix 32 (* 4 (if (vector? owner-ids) (count owner-ids) 0))
                                      (* 4 (if (vector? vector-ids) (count vector-ids) 0)))]
                  (if (> charge budget) {:status :rejected :reason :map-get-work-limit :work-count charge}
                    (if (if (vector? owner-ids) (if (vector? vector-ids)
                          (if (<= (count owner-ids) 1024) (if (<= (count vector-ids) 1024)
                            (if (< 1 (count owner-ids)) (< (+ 1 (* 2 index)) (count vector-ids)) false) false) false) false) false)
                      (let [operator-id (get owner-ids 0)
                            metadata (if (p15-s23-pc-id? operator-id)
                              (p15-s23-pc-evidence-work
                                {:reference-source (get reference :source) :ref-form-source (p15-s23-pc-form-source ref-form)
                                 :reference-value (get ref-form :value) :owner-source (get owner :source)
                                 :owner-form-source (p15-s23-pc-form-source owner-form)
                                 :operator-value (get (get forms operator-id) :value)
                                 :binding-form (get forms (get record :definition-form-id))
                                 :initializer-source (p15-s23-pc-form-source (get forms (get record :initializer-form-id)))}
                                (- budget charge))
                              {:status :rejected :reason :map-get-source-mismatch :work-count 0})
                            total (+ charge (get metadata :work-count))]
                        (if (= :accepted (get metadata :status))
                          (if (p15-s23-typed-all
                                [(p15-s23-pc-link-core? record reference core nodes bindings)
                                 (= reference-id (get ref-form :form-id)) (= :symbol (get ref-form :kind))
                                 (= (get record :name) (get ref-form :value))
                                 (= (get reference :source) (p15-s23-pc-form-source ref-form) (get link :reference-source))
                                 (= owner-id (get owner-form :form-id)) (= :list (get owner-form :kind))
                                 (= (get owner :source) (p15-s23-pc-form-source owner-form))
                                 (= operator-id (get (get forms operator-id) :form-id))
                                 (= owner-id (get (get forms operator-id) :parent-form-id))
                                 (= :symbol (get (get forms operator-id) :kind))
                                 (= 'let (get (get forms operator-id) :value))
                                 (= vector-id (get vector-form :form-id) (get owner-ids 1))
                                 (= owner-id (get vector-form :parent-form-id)) (= :vector (get vector-form :kind))
                                 (= (get vector-form :syntax-id) (get (get owner :attributes) :binding-vector-syntax-id))
                                 (= (get vector-ids (* 2 index)) (get record :definition-form-id))
                                 (= (get vector-ids (+ 1 (* 2 index))) (get record :initializer-form-id))
                                 (= (get record :definition-form-id) (get (get forms (get record :definition-form-id)) :form-id))
                                 (= vector-id (get (get forms (get record :definition-form-id)) :parent-form-id))
                                 (= (get record :definition-syntax-id) (get (get forms (get record :definition-form-id)) :syntax-id))
                                 (= (get record :name) (get (get forms (get record :definition-form-id)) :value))
                                 (= :symbol (get (get forms (get record :definition-form-id)) :kind))
                                 (= (get record :binding-scope-id) (get (get forms (get record :definition-form-id)) :scope-id))
                                 (= (get record :initializer-form-id) (get (get forms (get record :initializer-form-id)) :form-id))
                                 (= vector-id (get (get forms (get record :initializer-form-id)) :parent-form-id))
                                 (= (get record :initializer-scope-id) (get (get forms (get record :initializer-form-id)) :scope-id))])
                            (recur (rest remaining) total)
                            {:status :rejected :reason :map-get-source-mismatch :work-count total})
                          (assoc metadata :work-count total)))
                      {:status :rejected :reason :map-get-source-mismatch :work-count charge})))
                {:status :rejected :reason :map-get-source-mismatch :work-count prefix}))
            {:status :rejected :reason :map-get-source-mismatch :work-count prefix})
          (assoc measured :work-count prefix))))))

(defn p15-s23-pc-links [route]
  (loop [remaining (get route :vector-links) out (get route :receiver-links)]
    (if (= 0 (count remaining)) out (recur (rest remaining) (conj out (first remaining))))))

(defn p15-s23-pc-core-project [route parent core node call edge nodes bindings types budget]
  (let [gated (p15-s23-pc-parent-parameter route core nodes bindings budget) gate-work (get gated :work-count)
        entry-set (if (= :accepted (get gated :status))
                    (p15-s23-pc-entry-set-work parent (get gated :record) core (- budget gate-work)) gated)
        prefix (+ gate-work (if (= :accepted (get gated :status)) (get entry-set :work-count) 0))
        first-result (if (= :accepted (get entry-set :status))
                       (p15-s23-pc-first-work route core nodes bindings types (- budget prefix)) entry-set)
        used (+ prefix (if (= :accepted (get entry-set :status)) (get first-result :work-count) 0))
        links (p15-s23-pc-links route)
        linked (if (= :accepted (get first-result :status))
                 (p15-s23-pc-link-types-work links types (- budget used)) first-result)
        spent (+ used (if (= :accepted (get first-result :status)) (get linked :work-count) 0))]
    (if (= :accepted (get linked :status))
      (let [header (p15-s23-mg-source core node call edge nodes bindings types (get core :module))
            project (if (map? header)
                      (p15-s23-pc-project header route parent (get first-result :descriptor) nodes (- budget spent))
                      {:status :rejected :reason :map-get-source-mismatch :work-count 0})
            total (+ spent (get project :work-count))]
        (if (= :accepted (get project :status))
          {:status :accepted :work-count total :project project :first-type-validation (get first-result :type-validation) :descriptor (p15-s23-pc-finish header route project)}
          (assoc project :work-count total)))
      (assoc linked :work-count spent))))

(defn p15-s23-pc-full-project [route parent core node call edge nodes bindings types forms budget]
  (let [projected (p15-s23-pc-core-project route parent core node call edge nodes bindings types budget)
        prefix (get projected :work-count)]
    (if (= :accepted (get projected :status))
      (loop [pairs [[node call] [(get nodes (get route :get-node-id)) (get route :get-call)]
                    [(get nodes (get route :first-node-id)) (get route :first-call)]] used prefix]
        (if (= 0 (count pairs))
          (let [links (p15-s23-pc-links route)
                linked (p15-s23-pc-links-forms-work links core nodes bindings forms (- budget used))
                spent (+ used (get linked :work-count))
                checked (if (= :accepted (get linked :status))
                          (p15-s23-pc-authenticate-project (get projected :project) nodes forms (- budget spent)) linked)
                total (+ spent (if (= :accepted (get linked :status)) (get checked :work-count) 0))]
            (if (= :accepted (get checked :status)) (assoc projected :work-count total)
              (assoc checked :work-count total)))
          (let [pair (first pairs) checked (p15-s23-pc-call-forms-work (get pair 0) (get pair 1) nodes forms (- budget used))
                total (+ used (get checked :work-count))]
            (if (= :accepted (get checked :status)) (recur (rest pairs) total)
              (assoc checked :work-count total)))))
      projected)))

(defn p15-s23-pc-parent-rows-work [route parent first-descriptor core facts ledger parent-reference key budget]
  ; The expected reference is already bounded by this invocation's successful
  ; current parent match. Supplied carrier references remain separate inputs.
  (let [base (+ 32 (* 8 (if (vector? facts) (count facts) 0)) (* 8 (if (vector? ledger) (count ledger) 0)))]
    (if (> base budget) {:status :rejected :reason :map-get-work-limit :work-count base}
      (if (if (vector? facts) (vector? ledger) false)
        (let [selectors {:facts (loop [remaining facts out []]
                                  (if (= 0 (count remaining)) out
                                    (recur (rest remaining) (conj out (p15-s23-typed-project (first remaining) [:call-core-node-id])))))
                         :rows (loop [remaining ledger out []]
                                 (if (= 0 (count remaining)) out
                                   (recur (rest remaining) (conj out (p15-s23-typed-project (first remaining) [:producer-rule :lhs])))))}
              measured (p15-s23-pc-evidence-work selectors (- budget base))
              prefix (+ base (get measured :work-count))]
          (if (= :accepted (get measured :status))
            (let [checked (p15-s23-pc-parent-carriers-work
                            {:get-call-id (get route :get-node-id) :first-call-id (get route :first-node-id)}
                            parent first-descriptor {:parent-reference parent-reference} first-descriptor core
                            {:call-type-facts facts :constraint-ledger ledger} key (- budget prefix))]
              (assoc checked :work-count (+ prefix (get checked :work-count))))
            (assoc measured :work-count prefix)))
        {:status :rejected :reason :map-get-source-mismatch :work-count base}))))

(defn p15-s23-pc-full-work [route core node call edge nodes bindings types forms facts ledger budget]
  (let [gated (p15-s23-pc-parent-parameter route core nodes bindings budget) gate-work (get gated :work-count)
        parent-call (get route :get-call) parent-node (get nodes (get route :get-node-id))
        reserved (if (= :accepted (get gated :status))
                   (p15-s23-pe-reserve core (get nodes (get (get parent-call :argument-node-ids) 0)) nodes bindings (- budget gate-work)) gated)
        prefix (+ gate-work (if (= :accepted (get gated :status)) (get reserved :work-count) 0))]
    (if (= :accepted (get reserved :status))
      (let [header (p15-s23-mg-source core parent-node parent-call (get route :get-edge) nodes bindings types (get core :module))
            supplied (get types (get parent-call :operator-node-id))
            parent (if (map? header)
                     (p15-s23-pe-check-work header supplied core nodes bindings forms types (- budget prefix))
                     {:status :rejected :reason :map-get-source-mismatch :work-count 0})
            used (+ prefix (get parent :work-count))]
        (if (= :accepted (get parent :status))
          (let [key-node (get nodes (get (get call :argument-node-ids) 1))
                matched (p15-s23-pc-parent-match-work supplied (get parent :descriptor) (get (get key-node :attributes) :value) (- budget used))
                matched-work (+ used (get matched :work-count))]
          (if (= :accepted (get matched :status))
            (let [projected (p15-s23-pc-full-project route (get parent :descriptor) core node call edge nodes bindings types forms (- budget matched-work))
                  spent (+ matched-work (get projected :work-count))]
              (if (= :accepted (get projected :status))
                (let [first-descriptor (get types (get (get route :first-call) :operator-node-id))
                      rows (p15-s23-pc-parent-rows-work route (get parent :descriptor) first-descriptor core facts ledger (get matched :parent-reference)
                               (get (get projected :descriptor) :key) (- budget spent))
                      total (+ spent (get rows :work-count))]
                  (if (= :accepted (get rows :status))
                    (let [matched (p15-s23-pc-descriptor-work (get types (get call :operator-node-id))
                                    (get projected :descriptor) (- budget total))
                          work (+ total (get matched :work-count))]
                      (if (= :accepted (get matched :status))
                        (assoc projected :work-count work
                          :parents {:get-call-id (get route :get-node-id) :get-operator-id (get parent-call :operator-node-id)
                                    :get-descriptor (get parent :descriptor)
                                    :first-call-id (get route :first-node-id)
                                    :first-operator-id (get (get route :first-call) :operator-node-id)
                                    :first-descriptor first-descriptor :first-type-validation (get projected :first-type-validation)
                                    :fact-count (count facts) :ledger-count (count ledger)})
                        (assoc matched :work-count work)))
                    (assoc rows :work-count total)))
                (assoc projected :work-count spent)))
            (assoc matched :work-count matched-work)))
          (assoc parent :work-count used)))
      (assoc reserved :work-count prefix))))

(defn p15-s23-mg-binding? [binding module]
  (if (if (vector? (get binding :profile-set)) (vector? (get binding :target-set)) false)
  (p15-s23-typed-all
    [(= ['get :core :var 'gravity.core {:name 'gravity/core :version "bootstrap-contract-v1"} :gravity.type/core-var :safe]
        [(get binding :name) (get binding :binding-class) (get binding :kind) (get binding :namespace)
         (get binding :package) (get binding :type-ref) (get binding :safety)])
     (= [] (get binding :effects) (get binding :capabilities))
     (contains? (set (get binding :profile-set)) (get module :profile))
     (contains? (set (get binding :target-set)) :all)]) false))

(defn p15-s23-mg-source [core node call edge nodes bindings types module]
  (if (if (vector? (get call :argument-node-ids)) (vector? (get node :children)) false)
  (let [children (get node :children) operator (get nodes (get call :operator-node-id))
        bid (get call :operator-binding-id) binding (get bindings bid) args (get call :argument-node-ids)
        arguments (p15-s23-io-child-types args types)
        invoked? (loop [remaining arguments]
                   (if (= 0 (count remaining)) true
                     (if (= :gravity.type/never (first remaining)) false (recur (rest remaining)))))
        caller (loop [remaining (get core :function-records)]
                 (if (= 0 (count remaining)) nil
                   (if (= (get (first remaining) :function-syntax-id) (get (get node :evaluation) :owner-function-syntax-id))
                     (first remaining) (recur (rest remaining)))))
        expected-call {:core-node-id (get node :node-id) :operator-node-id (first children) :operator-binding-id bid
                       :argument-node-ids (vec (rest children)) :ordered-evaluation-node-ids children
                       :evaluation-order :operator-then-arguments :result-policy :call-result}
        expected-edge {:ordinal (get edge :ordinal) :call-core-node-id (get node :node-id)
                       :caller-function-syntax-id (get caller :function-syntax-id) :caller-function-core-node-id (get caller :function-core-node-id)
                       :callee-binding-id bid :callee-definition-syntax-id (get binding :definition-syntax-id)
                       :callee-function-syntax-id nil :callee-function-core-node-id nil :argument-core-node-ids args
                       :ordered-evaluation-node-ids children :evaluation-order :operator-then-arguments :classification :nonlocal-or-nonfunction}]
    (if (p15-s23-typed-all
          [(= :call (get node :core-form)) (= :reference (get operator :core-form))
           (contains? #{2 3} (count args)) (= expected-call call) (= expected-edge edge) (p15-s23-mg-binding? binding module)
           (= [bid] (get node :resolved-binding-ids) (get operator :resolved-binding-ids))
           (= {:symbol (get (get operator :attributes) :symbol) :position :operator :binding-id bid :binding-class :core
               :definition-syntax-id (get binding :definition-syntax-id)} (get operator :attributes))
           (contains? '#{get gravity.core/get} (get (get operator :attributes) :symbol))
           (= :operator-then-arguments (get (get node :evaluation) :kind))
           (= (loop [i 0 out []] (if (= i (count children)) out
                (recur (+ i 1) (conj out {:index i :core-node-id (get children i)})))) (get (get node :evaluation) :order))
           (if (= 2 (count args)) (p15-s23-mg-present-operands? arguments args nodes) (p15-s23-mg-operands? arguments invoked?))
           (loop [remaining arguments]
             (if (= 0 (count remaining)) true
               (if (if (= nil (first remaining)) true (= :gravity.type/unknown (first remaining))) false (recur (rest remaining)))))] )
      (let [header {:kind :gravity.type/applied-map-get :version :sh08-map-get-v1
       :operation 'get :semantic-owner 'gravity.collections :intrinsic :gravity.collections/map-lookup-default
       :resolution :gravity.core-compatibility :operator-node-id (get operator :node-id) :operator-binding-id bid
       :call-core-node-id (get node :node-id) :source (get node :source) :operator-source (get operator :source)
       :source-call call :source-edge edge :source-binding binding :argument-types arguments
       :lookup-policy {:input :established-member-map :keys [:string :keyword] :key-equality :value
                       :presence :independent-of-value :default :eager :normalization :none :coercion :none
                       :operand-evaluation :map-then-key-then-default-once :result :one-established-type}
       :application (if invoked? :normal :not-invoked)
       :latent-effects [] :direct-effects [] :capabilities [] :thrown-error-effects []
       :profile (get module :profile) :target (get module :target)
       :invalidation [:calls :call-edges :binding-table :source-forms :type-table :lexical-bindings :definitions :function-records
                      :callee-body :member-types :key-domain :default-type :lookup-policy :profile :target :evaluation-order]}]
        (if (= 2 (count args)) (p15-s23-mg-present-header header nodes) header)) nil)) nil))

(defn p15-s23-mg-constraint [descriptor]
  {:constraint-id-request {:domain :gravity/sh08-map-get-constraint-v1 :application descriptor}
   :kind :equality :producer-rule :sh08-map-get-v1
   :lhs {:core-node-id (get descriptor :call-core-node-id) :projection :map-get}
   :rhs (get descriptor :result-type) :dependencies descriptor :origin (get (get descriptor :source) :origin-chain)
   :solution {:result-type (get descriptor :result-type) :application (get descriptor :application)
              :direct-effects (get descriptor :direct-effects)}
   :invalidation (get descriptor :invalidation) :profile (get descriptor :profile) :target (get descriptor :target)
   :status :solved :diagnostics []})

(defn p15-s23-mg-call-fact [descriptor module]
  (let [source (get descriptor :source) edge (get descriptor :source-edge)]
    {:artifact :gravity/c7-call-type-fact
     :fact-id-request {:domain :gravity/sh08-map-get-call-type-fact-v1 :application descriptor}
     :call-core-node-id (get descriptor :call-core-node-id) :caller-function-syntax-id (get edge :caller-function-syntax-id)
     :callee-function-syntax-id nil :argument-types (get descriptor :argument-types) :result-type (get descriptor :result-type)
     :evaluation-order :operator-then-arguments :source-span (get source :semantic-span) :syntax-id (get source :syntax-id)
     :origin-chain (get source :origin-chain) :generated-origin (get source :generated-origin)
     :profile (get module :profile) :target (get module :target) :effects (get descriptor :direct-effects) :capabilities [] :status :inferred
     :dispatch :direct-map-get :applied-map-get descriptor :effect-facts-source :audited-collection-intrinsic}))


(defn p15-s23-mg-finish [header]
  (let [type (if (= :normal (get header :application)) (get (get header :argument-types) 2) :gravity.type/never)]
    (assoc header :parameter-types (get header :argument-types) :return type :result-type type)))

(defn p15-s23-mg-present-forms? [node nodes forms header]
  (let [owner (get forms (get (get node :source) :form-id)) ids (get owner :child-form-ids)
        children (get node :children)]
    (if (if (vector? ids) (= 3 (count ids) (count children)) false)
      (p15-s23-typed-all [(= :list (get owner :kind)) (= (get node :source) (p15-s23-typed-source owner))
            (= {:operator-child-index 0 :argument-count 2 :argument-child-indexes [1 2]
                :evaluation-order :operator-then-arguments :dispatch :resolved-symbol-call} (get node :attributes))
            (loop [i 0]
              (if (= i 3) true
                (let [form (get forms (get ids i)) child (get nodes (get children i))]
                  (if (p15-s23-typed-all [(= (get owner :form-id) (get form :parent-form-id))
                            (= (get child :source) (p15-s23-typed-source form))
                            (if (= i 0) (= (get form :value) (get (get child :attributes) :symbol)) true)
                            (if (= i 2) (if (= :gravity.type/never (get (get header :argument-types) 1)) true
                              (if (= :keyword (get form :kind)) (= (get header :key) (get form :value)) false)) true)])
                    (recur (+ i 1)) false))))]) false)))

(defn p15-s23-pc-full-context-work [route context node budget]
  (let [table (get context :call-facts) base (+ 32 (* 4 (if (map? table) (count table) 0)))]
    (if (> base budget) {:status :rejected :reason :map-get-work-limit :work-count base}
      (if (map? table)
        (let [facts (loop [remaining (vec table) out []]
                      (if (= 0 (count remaining)) out
                        (recur (rest remaining) (conj out (get (first remaining) 1)))))
              id (get node :node-id)
              checked (p15-s23-pc-full-work route (get context :core) node (get (get context :calls) id)
                        (get (get context :edges) id) (get context :nodes) (get context :bindings) (get context :types)
                        (get context :forms) facts (get context :ledger) (- budget base))]
          (assoc checked :work-count (+ base (get checked :work-count))))
        {:status :rejected :reason :map-get-source-mismatch :work-count base}))))

(defn p15-s23-typed-compile-present-get [context node budget]
  (let [id (get node :node-id) core (get context :core) call (get (get context :calls) id) edge (get (get context :edges) id)
        nodes (get context :nodes) types (get context :types) args (get call :argument-node-ids)
        members (p15-s23-mg-member-count (get types (first args)))
        base (+ 67 (count (get core :function-records)) members (* 2 members))]
    (if (< budget base) (assoc (p15-s23-typed-node-error :typed-lowering-work-limit node) :work-count base)
      (let [supplied (get types (get call :operator-node-id)) proof (get supplied :presence-proof)
            private? (if (= :sh08-map-get-private-entry-v1 (get supplied :version)) true
                       (if (map? proof) (if (contains? proof :entry-census) true (contains? proof :entries)) false))
            candidate (p15-s23-pc-candidate core node call nodes types (- budget base))
            route (if (= :accepted (get candidate :status))
                    (let [r (p15-s23-pc-route core node call nodes (get context :bindings) (- budget base (get candidate :work-count)))]
                      (assoc r :work-count (+ (get candidate :work-count) (get r :work-count)))) candidate)
            route-work (get route :work-count) composed? (= :accepted (get route :status))
            reserved (if composed? {:status :accepted :work-count 0 :matched-call-count 0}
                       (if private?
                       (p15-s23-pe-reserve core (get nodes (first args)) nodes (get context :bindings) (- budget base route-work))
                       {:status :accepted :work-count 0 :matched-call-count 0}))
            charge (+ base route-work (get reserved :work-count) (* (get reserved :matched-call-count 0) (+ 1 (* 2 members))))]
        (if (if (= :rejected (get reserved :status)) true (< budget charge))
          (assoc (p15-s23-typed-node-error
                   (if (if (= :map-get-work-limit (get reserved :reason)) true (< budget charge))
                     :typed-lowering-work-limit :unsupported-or-mismatched-typed-map-get) node) :work-count charge)
      (let [header (p15-s23-mg-source core node call edge nodes (get context :bindings) types (get core :module))
            descriptor (get types (get call :operator-node-id))
            checked (if (map? header)
                      (if composed?
                        (p15-s23-pc-full-context-work route context node (- budget charge))
                        (if private?
                        (p15-s23-pe-check-work header descriptor core nodes (get context :bindings) (get context :forms) types (- budget charge))
                        (let [walked (if (= :normal (get header :application))
                                       (p15-s23-pe-selected-work header {:calls [call] :parameter-index 0}
                                         [(get proof :operand-shape)] types false (- budget charge))
                                       {:status :accepted :work-count 0})
                              result (if (= :accepted (get walked :status))
                                       (p15-s23-mg-present-finish header (get proof :operand-shape)) nil)]
                          (if (map? result) (assoc walked :descriptor result)
                            (if (= :rejected (get walked :status)) walked
                              {:status :rejected :reason :map-get-private-entry-presence-required :work-count (get walked :work-count)})))))
                      {:status :rejected :reason :map-get-private-entry-presence-required :work-count 0})
            charge (+ charge (get checked :work-count))
            expected (get checked :descriptor)
            rows (loop [remaining (get context :ledger) out []]
                   (if (= 0 (count remaining)) out
                     (let [row (first remaining)]
                       (recur (rest remaining)
                         (if (if (= :sh08-map-get-v1 (get row :producer-rule))
                               (= {:core-node-id id :projection :map-get} (get row :lhs)) false) (conj out row) out)))))]
        (if (if (> charge budget) true (= :map-get-work-limit (get checked :reason)))
          (assoc (p15-s23-typed-node-error :typed-lowering-work-limit node) :work-count charge)
        (if (if (map? expected)
              (p15-s23-typed-all
                [(= descriptor expected) (= (get expected :result-type) (get types id))
                 (= (get edge :ordinal) (get (get context :call-order) id))
                 (= (get (get context :current-function) :function-syntax-id) (get edge :caller-function-syntax-id))
                 (= [(p15-s23-mg-constraint expected)] rows)
                 (= (p15-s23-mg-call-fact expected (get core :module)) (get (get context :call-facts) id))
                 (p15-s23-mg-present-forms? node nodes (get context :forms) header)]) false)
          (loop [remaining args values [] used 0]
            (if (= 0 (count remaining))
              (let [key-never? (= :gravity.type/never (get (get header :argument-types) 1))
                    key (get values 1)]
                ; A checked inert Keyword literal can precede the Map in this
                ; existing IR. A transferring key must retain Map-then-key.
                (if (if key-never? true (= {:op :literal :value (get header :key)} key))
                  (assoc (p15-s23-compiler-result
                           (if key-never? {:op :do :body values}
                             {:op :keyword-map-lookup :args [key (get values 0)]}))
                    :work-count (+ charge used))
                  (assoc (p15-s23-typed-node-error :unsupported-or-mismatched-typed-map-get node) :work-count (+ charge used))))
              (let [child (p15-s23-typed-compile-node (assoc context :tail? false) (first remaining) (- budget charge used))]
                (if (p15-s23-compiler-complete? child)
                  (recur (rest remaining) (conj values (get child :value)) (+ used (get child :work-count)))
                  (assoc child :work-count (+ charge used (get child :work-count 0)))))))
          (assoc (p15-s23-typed-node-error :unsupported-or-mismatched-typed-map-get node) :work-count charge)))))))))

(defn p15-s23-typed-compile-get [context node budget]
  (if (= 2 (count (get (get (get context :calls) (get node :node-id)) :argument-node-ids)))
    (p15-s23-typed-compile-present-get context node budget)
  (let [id (get node :node-id) core (get context :core)
        charge (+ 67 (count (get core :function-records))
                  (p15-s23-mg-member-count (get (get context :types) (first (get (get (get context :calls) id) :argument-node-ids)))))]
    (if (< budget charge) (p15-s23-typed-node-error :typed-lowering-work-limit node)
      (let [call (get (get context :calls) id) edge (get (get context :edges) id)
            forms (get context :forms) nodes (get context :nodes)
            owner (get forms (get (get node :source) :form-id)) ids (get owner :child-form-ids)
            header (p15-s23-mg-source core node call edge nodes (get context :bindings) (get context :types) (get core :module))
            descriptor (if (map? header) (p15-s23-mg-finish header) nil)
            rows (loop [remaining (get context :ledger) out []]
                   (if (= 0 (count remaining)) out
                     (let [row (first remaining)]
                       (recur (rest remaining)
                         (if (if (= :sh08-map-get-v1 (get row :producer-rule))
                               (= {:core-node-id id :projection :map-get} (get row :lhs)) false) (conj out row) out)))))]
        (if (if (map? descriptor)
              (p15-s23-typed-all
                [(= descriptor (get (get context :types) (get call :operator-node-id)))
                 (= (get descriptor :result-type) (get (get context :types) id))
                 (= (get edge :ordinal) (get (get context :call-order) id))
                 (= (get (get context :current-function) :function-syntax-id) (get edge :caller-function-syntax-id))
                 (= [(p15-s23-mg-constraint descriptor)] rows)
                 (= (p15-s23-mg-call-fact descriptor (get core :module)) (get (get context :call-facts) id))
                 (= :list (get owner :kind)) (vector? ids) (= 4 (if (vector? ids) (count ids) 0) (count (get node :children)))
                 (= (get node :source) (p15-s23-typed-source owner))
                 (= {:operator-child-index 0 :argument-count 3 :argument-child-indexes [1 2 3]
                     :evaluation-order :operator-then-arguments :dispatch :resolved-symbol-call} (get node :attributes))
                 (loop [i 0]
                   (if (= i 4) true
                     (let [form (get forms (get ids i)) child (get nodes (get (get node :children) i))]
                       (if (p15-s23-typed-all [(= (get owner :form-id) (get form :parent-form-id))
                             (= (get child :source) (p15-s23-typed-source form))
                             (if (= i 0) (= (get form :value) (get (get child :attributes) :symbol)) true)])
                         (recur (+ i 1)) false))))]) false)
          (let [compiled (p15-s23-typed-compile-children context (get call :argument-node-ids) (- budget charge) [])]
            (if (p15-s23-compiler-complete? compiled)
              (assoc (p15-s23-compiler-result {:op :builtin-call :function 'get :args (get compiled :value)})
                :work-count (+ charge (get compiled :work-count))) compiled))
          (p15-s23-typed-node-error :unsupported-or-mismatched-typed-map-get node)))))))

(defn p15-s23-mc-binding? [binding module]
  (if (if (vector? (get binding :profile-set)) (vector? (get binding :target-set)) false)
  (p15-s23-typed-all

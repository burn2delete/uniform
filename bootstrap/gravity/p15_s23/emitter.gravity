                       (recur (rest remaining)
                         (if (if (= (get (p15-s23-si-constraint descriptor) :producer-rule) (get row :producer-rule))
                               (= (get (p15-s23-si-constraint descriptor) :lhs) (get row :lhs)) false) (conj out row) out)))))]
        (if (if (map? descriptor)

                      (if (<= (count type) 3)
                        (loop [fields (keys type)]
                          (if (= 0 (count fields)) true
                            (if (keyword? (first fields)) (recur (rest fields)) false))) false) false)
                  (let [kind (get type :kind) members? (= :gravity.type/map kind) homogeneous? (if (keyword? (get type :element-type)) (p15-s23-hl-type? type) false)
                        nil-bearing? (if (keyword? (get type :value-type)) (p15-s23-ni-type? type) false)
                        children (if nil-bearing? [(get type :value-type)]
                                   (if homogeneous? [(get type :element-type)] (get type (if members? :member-types :element-types))))
                        valid? (if nil-bearing? true (if homogeneous? true (if (if (keyword? kind) (contains? #{:gravity.type/list :gravity.type/vector :gravity.type/map :gravity.type/set} kind) false)
                                 (if (= (if members? #{:kind :member-types :shape} #{:kind :element-types :shape}) (set (keys type)))
                                   (if (= :literal (get type :shape))
                                     (if (vector? children)
                                       (if (<= (count children) 1024)
                                         (if members? (loop [remaining children]
                                                        (if (= 0 (count remaining)) true

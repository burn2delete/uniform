                     (p15-s23-kse-source core node call edge nodes (get context :bindings) (get context :types) (get core :module) domain) nil)
            descriptor (if (map? header) (p15-s23-kse-finish header) nil)
            producer-rows (p15-s23-pe-select (get context :ledger) :producer-rule :sh08-keyword-set-equality-v1)
            rows (p15-s23-pe-select producer-rows :lhs {:core-node-id id :projection :keyword-set-equality})]
        (if (> charge budget) (assoc (p15-s23-typed-node-error :typed-lowering-work-limit node) :work-count charge)
        (if (if (map? descriptor)
              (p15-s23-typed-all
                [(loop [remaining producer-rows]
                         (if (= 0 (count remaining)) true
                           (let [row (first remaining) row-id (get (get row :lhs) :core-node-id)
                                 source-call (if (if (keyword? row-id) true (if (string? row-id) (= 71 (count row-id)) false))
                                               (get (get context :calls) row-id) nil)
                                 source-node (if (map? source-call) (get nodes row-id) nil)
                                 source-type (get (get context :types) (get source-call :operator-node-id))]
                             (if (p15-s23-typed-all [(= row-id (get source-call :core-node-id) (get source-node :node-id))
                                   (map? source-call) (map? source-node)
                                   (= :gravity.type/applied-keyword-set-equality (get source-type :kind))
                                   (= source-call (get source-type :source-call))
                                   (= row (p15-s23-kse-constraint source-type))])
                               (recur (rest remaining)) false))))
                 (= descriptor (get (get context :types) (get call :operator-node-id)))
                 (= (get descriptor :result-type) (get (get context :types) id))
                 (= (get edge :ordinal) (get (get context :call-order) id))
                 (= (get (get context :current-function) :function-syntax-id) (get edge :caller-function-syntax-id))
                 (= [(p15-s23-kse-constraint descriptor)] rows)
                 (= (p15-s23-kse-call-fact descriptor (get core :module)) (get (get context :call-facts) id))
                 (= :list (get owner :kind)) (vector? ids) (= 3 (if (vector? ids) (count ids) 0) (count (get node :children)))
                 (= (get node :source) (p15-s23-typed-source owner))
                 (= {:operator-child-index 0 :argument-count 2 :argument-child-indexes [1 2]
                     :evaluation-order :operator-then-arguments :dispatch :resolved-symbol-call} (get node :attributes))
                 (loop [i 0]
                   (if (= i 3) true
                     (let [form (get forms (get ids i)) child (get nodes (get (get node :children) i))]
                       (if (p15-s23-typed-all [(= (get owner :form-id) (get form :parent-form-id))
                             (= (get child :source) (p15-s23-typed-source form))
                             (if (= i 0) (= (get form :value) (get (get child :attributes) :symbol)) true)])
                         (recur (+ i 1)) false))))]) false)
          (loop [remaining args values [] used charge]
            (if (= 0 (count remaining))
              (assoc (p15-s23-compiler-result {:op :builtin-call :function '= :args values}) :work-count used)
              (if (>= used budget)
                (assoc (p15-s23-typed-node-error :typed-lowering-work-limit node) :work-count (+ used 1))
                (let [compiled (p15-s23-typed-compile-node (assoc context :tail? false) (first remaining) (- budget used))
                      total (+ used (get compiled :work-count 1))]
                  (if (p15-s23-compiler-complete? compiled)
                    (recur (rest remaining) (conj values (get compiled :value)) total)
                    (assoc compiled :work-count total))))))
          (assoc (p15-s23-typed-node-error :unsupported-or-mismatched-typed-keyword-set-equality node) :work-count charge)))))))

(defn p15-s23-ve-domain [arguments budget]
  (let [limit (if (< budget 65536) budget 65536)]
  ; Positional types suffice for a value query; no constructor identity is used.
  (if (if (vector? arguments) (= 2 (count arguments)) false)
    (if (< limit 2) {:status :rejected :reason :vector-equality-work-limit :work-count 2}
      (loop [pending [[(get arguments 1) 0 true] [(get arguments 0) 0 true]] work 2]
        (if (= 0 (count pending)) {:status :accepted :work-count work}
          (let [frame (get pending (- (count pending) 1)) tail (subvec pending 0 (- (count pending) 1))
                type (get frame 0) depth (get frame 1) outer? (get frame 2)]
            (if (> depth 128) {:status :rejected :reason :vector-equality-type-depth :work-count work}
              (if (if outer? (= :gravity.type/never type)
                      (if (keyword? type)
                        (contains? #{:gravity.type/nil :gravity.type/bool :gravity.type/character :gravity.type/string
                                     :gravity.type/symbol :gravity.type/keyword} type)
                        (if (map? type)
                          (if (= 2 (count type))
                            (if (keyword? (get type :value-type))
                              (if (loop [fields (keys type)]
                                    (if (= 0 (count fields)) true
                                      (if (keyword? (first fields)) (recur (rest fields)) false)))
                                (p15-s23-ni-type? type) false) false) false) false)))
                (recur tail work)
                (if (if (map? type)
                      (if (= 3 (count type))
                        (if (= :gravity.type/vector (get type :kind))
                          (if (= :literal (get type :shape)) (vector? (get type :element-types)) false) false) false) false)
                  (let [members (get type :element-types) total (+ work (count members))]
                    (if (> (count members) 1024) {:status :rejected :reason :vector-equality-type-width :work-count work}
                    (if (> total limit) {:status :rejected :reason :vector-equality-work-limit :work-count total}
                      (if (if (= depth 128) (> (count members) 0) false)
                        {:status :rejected :reason :vector-equality-type-depth :work-count total}
                        (let [children (loop [i (- (count members) 1) out tail]
                                       (if (< i 0) out
                                         (recur (- i 1) (conj out [(get members i) (+ depth 1) false]))))]
                          (recur children total))))))
                  {:status :rejected :reason :vector-equality-operand-type-required :work-count work})))))))
    {:status :rejected :reason :vector-equality-arity-mismatch :work-count 0})))

(defn p15-s23-ve-source [core node call edge nodes bindings types module]
  (if (if (vector? (get call :argument-node-ids))
        (if (= 2 (count (get call :argument-node-ids)))
          (if (vector? (get node :children)) (= 3 (count (get node :children))) false) false) false)
  (let [children (get node :children) operator (get nodes (get call :operator-node-id))
        bid (get call :operator-binding-id) binding (get bindings bid) args (get call :argument-node-ids)
        arguments (p15-s23-io-child-types args types)
        invoked? (loop [remaining arguments]
                   (if (= 0 (count remaining)) true
                     (if (= :gravity.type/never (first remaining)) false (recur (rest remaining)))))
        caller (loop [remaining (get core :function-records)]
                 (if (= 0 (count remaining)) nil
                   (if (= (get (first remaining) :function-syntax-id) (get (get node :evaluation) :owner-function-syntax-id))
                     (first remaining) (recur (rest remaining)))))
        expected-call {:core-node-id (get node :node-id) :operator-node-id (first children) :operator-binding-id bid
                       :argument-node-ids (vec (rest children)) :ordered-evaluation-node-ids children
                       :evaluation-order :operator-then-arguments :result-policy :call-result}
        expected-edge {:ordinal (get edge :ordinal) :call-core-node-id (get node :node-id)
                       :caller-function-syntax-id (get caller :function-syntax-id) :caller-function-core-node-id (get caller :function-core-node-id)
                       :callee-binding-id bid :callee-definition-syntax-id (get binding :definition-syntax-id)
                       :callee-function-syntax-id nil :callee-function-core-node-id nil :argument-core-node-ids args
                       :ordered-evaluation-node-ids children :evaluation-order :operator-then-arguments :classification :nonlocal-or-nonfunction}]
    (if (p15-s23-typed-all

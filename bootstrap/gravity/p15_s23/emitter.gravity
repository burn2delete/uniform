(defn p15-s23-lc-source [core node call edge nodes bindings types module validation]
  (if (p15-s23-lc-native-map? validation)
    (if (= {:status :accepted} validation)
      (if (if (vector? (get call :argument-node-ids)) (vector? (get node :children)) false)

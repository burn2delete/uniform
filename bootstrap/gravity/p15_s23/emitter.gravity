                 (= (get descriptor :result-type) (get (get context :types) id))
                 (= (get edge :ordinal) (get (get context :call-order) id))
                 (= (get (get context :current-function) :function-syntax-id) (get edge :caller-function-syntax-id))
                 (= [(p15-s23-ae-constraint descriptor)] rows)
                 (= (p15-s23-ae-call-fact descriptor (get core :module)) (get (get context :call-facts) id))
                 (= :list (get owner :kind)) (vector? ids) (= 3 (if (vector? ids) (count ids) 0) (count (get node :children)))
                 (= (get node :source) (p15-s23-typed-source owner))
                 (= {:operator-child-index 0 :argument-count 2 :argument-child-indexes [1 2]
                     :evaluation-order :operator-then-arguments :dispatch :resolved-symbol-call} (get node :attributes))
                 (loop [i 0]
                   (if (= i 3) true
                     (let [form (get forms (get ids i)) child (get nodes (get (get node :children) i))]
                       (if (p15-s23-typed-all [(= (get owner :form-id) (get form :parent-form-id))
                             (= (get child :source) (p15-s23-typed-source form))
                             (if (= i 0) (= (get form :value) (get (get child :attributes) :symbol)) true)])
                         (recur (+ i 1)) false))))]) false)
          (let [compiled (p15-s23-typed-compile-children context (get call :argument-node-ids) (- budget charge) [])]
            (if (p15-s23-compiler-complete? compiled)
              (assoc (p15-s23-compiler-result {:op :builtin-call :function '= :args (get compiled :value)})
                :work-count (+ charge (get compiled :work-count))) compiled))
          (p15-s23-typed-node-error :unsupported-or-mismatched-typed-atomic-equality node)))))))

(defn p15-s23-kse-domain [arguments budget]
  ; Independent finite literal Set types establish one Keyword or String member family.
  (let [limit (if (< budget 65536) budget 65536)]
    (if (if (vector? arguments) (= 2 (count arguments)) false)
      (if (< limit 2) {:status :rejected :reason :keyword-set-equality-work-limit :work-count 2}
        (loop [side 0 work 2 counts [] member-type nil]
          (if (= side 2)
            (let [result {:status :accepted :work-count work :argument-types arguments :operand-counts counts}]
              (if (= :gravity.type/string member-type) (assoc result :comparison-domain :string-set) result))
            (let [type (get arguments side) strings? (= :gravity.type/string member-type)]
              (if (= :gravity.type/never type)
                (recur (+ side 1) work (conj counts nil) member-type)
                (if (if (map? type) (if (= 3 (count type))
                      (if (= :gravity.type/set (get type :kind))
                        (if (= :literal (get type :shape)) (vector? (get type :element-types)) false) false) false) false)
                  (let [members (get type :element-types) width (count members)]
                    (if (> width 1024)
                      {:status :rejected :reason (if strings? :string-set-equality-type-width :keyword-set-equality-type-width) :work-count work}
                      (if (> width (- limit work))
                        {:status :rejected :reason (if strings? :string-set-equality-work-limit :keyword-set-equality-work-limit) :work-count (+ work width)}
                        (let [total (+ work width)
                              checked (loop [i 0 family member-type]
                                        (if (= i width) {:status :accepted :member-type family}
                                          (let [member (get members i)]
                                            (if (if (= :gravity.type/keyword member) true (= :gravity.type/string member))
                                              (if (if (= nil family) true (= family member))
                                                (recur (+ i 1) member)
                                                {:status :rejected :member-type family})
                                              {:status :rejected :member-type family}))))]
                          (if (= :accepted (get checked :status))
                            (recur (+ side 1) total (conj counts width) (get checked :member-type))
                            {:status :rejected :reason (if (= :gravity.type/string (get checked :member-type))
                                                        :string-set-equality-operand-type-required :keyword-set-equality-operand-type-required)
                             :work-count total})))))
                  {:status :rejected :reason (if strings? :string-set-equality-operand-type-required :keyword-set-equality-operand-type-required)
                   :work-count work}))))))
      {:status :rejected :reason :keyword-set-equality-arity-mismatch :work-count 0})))

(defn p15-s23-sse-ids? [ids width]
  (if (vector? ids) (if (<= (count ids) 6) (if (= (count ids) width)
    (loop [remaining ids]
      (if (= 0 (count remaining)) true
        (if (if (keyword? (first remaining)) true
              (if (string? (first remaining)) (= 71 (count (first remaining))) false))
          (recur (rest remaining)) false))) false) false) false))

(defn p15-s23-sse-call-ids? [node call]
  (if (if (map? node) (map? call) false)
    (if (p15-s23-sse-ids? (get node :children) 3)
      (if (p15-s23-sse-ids? (get call :argument-node-ids) 2)
        (p15-s23-sse-ids? [(get node :node-id) (get call :core-node-id)
                      (get call :operator-node-id) (get call :operator-binding-id)
                      (get (get node :source) :form-id) (get (get node :source) :syntax-id)] 6) false) false) false))

(defn p15-s23-sse-domain [arguments budget]
  ; Standalone carrier equality only. Vector Set leaves retain kse-domain.
  (let [limit (if (< budget 65536) budget 65536)]
    (if (< limit 2) (p15-s23-kse-domain arguments budget)
      (if (if (vector? arguments) (= 2 (count arguments)) false)
        (if (if (p15-s23-ss-type? (get arguments 0)) true (p15-s23-ss-type? (get arguments 1)))
          (loop [side 0 work 2 domains []]
            (if (= side 2)
              {:status :accepted :comparison-domain :string-set-carrier :argument-types arguments
               :operand-domains domains :carrier-schema :gravity/homogeneous-string-set-type-v1 :work-count work}
              (let [type (get arguments side)]
                (if (= :gravity.type/never type)
                  (recur (+ side 1) work (conj domains :never))
                  (let [paid (+ work 3)]
                    (if (> paid limit)
                      {:status :rejected :comparison-domain :string-set-carrier :reason :string-set-carrier-equality-work-limit :work-count paid}
                      (if (p15-s23-ss-type? type)
                        (recur (+ side 1) paid (conj domains :homogeneous-string-set))
                        (if (if (map? type) (if (= 3 (count type))
                              (if (= :gravity.type/set (get type :kind))
                                (if (= :literal (get type :shape)) (vector? (get type :element-types)) false) false) false) false)
                          (let [members (get type :element-types) width (count members) total (+ paid width)]
                            (if (> width 1024)
                              {:status :rejected :comparison-domain :string-set-carrier :reason :string-set-carrier-equality-type-width :work-count paid}
                              (if (> total limit)
                                {:status :rejected :comparison-domain :string-set-carrier :reason :string-set-carrier-equality-work-limit :work-count total}
                                (if (loop [i 0] (if (= i width) true
                                      (if (= :gravity.type/string (get members i)) (recur (+ i 1)) false)))
                                  (recur (+ side 1) total (conj domains :finite-string-set))
                                  {:status :rejected :comparison-domain :string-set-carrier :reason :string-set-carrier-equality-operand-type-required :work-count total}))))
                          {:status :rejected :comparison-domain :string-set-carrier :reason :string-set-carrier-equality-operand-type-required :work-count paid}))))))))
          (p15-s23-kse-domain arguments budget))
        (p15-s23-kse-domain arguments budget)))))

(defn p15-s23-kse-source [core node call edge nodes bindings types module validation]
  (if (p15-s23-sse-call-ids? node call)
  (if (if (vector? (get call :argument-node-ids))
        (if (= 2 (count (get call :argument-node-ids)))
          (if (vector? (get node :children)) (= 3 (count (get node :children))) false) false) false)

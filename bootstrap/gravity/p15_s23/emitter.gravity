                                                 (p15-s23-vrest-optional-id? (get edge :caller-function-syntax-id))
                                                 (p15-s23-vrest-optional-id? (get edge :caller-function-core-node-id))]) false) false) false) false)
                    (let [caller (loop [remaining (get core :function-records)]
                                   (if (= 0 (count remaining)) nil

(defn p15-s23-typed-bindings [context node records vector-form budget kind]
  (let [forms (get context :forms) children (get node :children) ids (get vector-form :child-form-ids)]
    (loop [index 0 current context prior [] compiled [] used 0 scope (get (get forms (get (get node :source) :form-id)) :scope-id)]
      (if (= index (count records))
        (assoc (p15-s23-compiler-result {:context current :bindings compiled :body-scope scope}) :work-count used)
        (let [record (get records index) binding (get (get context :bindings) (get record :binding-id))
              name-form (get forms (get ids (* 2 index))) init-form (get forms (get ids (+ 1 (* 2 index))))
              initializer (get (get context :nodes) (get children index)) type (get (get context :types) (get children index))
              expected {:ordinal index :name (get name-form :value)
                        :binding-id (get binding :binding-id) :definition-form-id (get name-form :form-id)
                        :definition-syntax-id (get name-form :syntax-id) :binding-scope-id (get binding :scope-id)
                        :initializer-form-id (get init-form :form-id) :initializer-syntax-id (get init-form :syntax-id)
                        :initializer-scope-id scope :initializer-node-id (get initializer :node-id)
                        :visible-prior-binding-ids prior :mutability :immutable}
              expected (assoc expected (if (= kind :loop) :loop-core-node-id :let-core-node-id) (get node :node-id))]
          (if (< (- budget used) 8) (p15-s23-typed-node-error :typed-lowering-work-limit node)
            (if (p15-s23-typed-all
                  [(= expected record) (= [:lexical :local] [(get binding :binding-class) (get binding :kind)])
                   (= (get name-form :syntax-id) (get binding :definition-syntax-id))
                   (= (get name-form :scope-id) (get binding :scope-id)) (= (get name-form :value) (get binding :name))
                   (symbol? (get binding :name)) (= :symbol (get name-form :kind)) (= [] (get name-form :child-form-ids))
                   (= (get vector-form :form-id) (get name-form :parent-form-id) (get init-form :parent-form-id))
                   (= scope (get init-form :scope-id)) (= (get initializer :source) (p15-s23-typed-source init-form))
                   (if (= kind :loop) (= scope (get initializer :binding-context)) true)
                   (= false (contains? (get current :locals) (get binding :binding-id)))
                   (if (= kind :loop) (p15-s23-typed-loop-slot? context record initializer type)
                     (= (p15-s23-typed-let-fact context record initializer type) (get (get context :local-facts) (get binding :binding-id))))])
              (let [value (p15-s23-typed-compile-node (assoc current :tail? false) (get initializer :node-id) (- budget used 8))]
                (if (p15-s23-compiler-complete? value)
                  (recur (+ index 1)
                    (assoc current :locals (assoc (get current :locals) (get binding :binding-id) (get binding :name))
                                   :parameter-types (assoc (get current :parameter-types) (get binding :binding-id) type))
                    (conj prior (get binding :binding-id)) (conj compiled {:name (get binding :name) :expr (get value :value)})
                    (+ used 8 (get value :work-count)) (get binding :scope-id)) value))
              (p15-s23-typed-node-error :typed-let-binding-or-type-mismatch node))))))))

(defn p15-s23-typed-compile-let [context node budget]
  (let [attrs (get node :attributes) children (get node :children) forms (get context :forms)
        owner (get forms (get (get node :source) :form-id)) ids (get owner :child-form-ids)
        vector-form (get forms (get attrs :binding-vector-form-id)) vector-ids (get vector-form :child-form-ids)
        count-bindings (get attrs :binding-count) count-body (get attrs :body-count)
        records (loop [remaining (get context :lexical) out []]
                  (if (= 0 (count remaining)) out
                    (recur (rest remaining) (if (= (get node :node-id) (get (first remaining) :let-core-node-id))
                                             (conj out (first remaining)) out))))]
    (if (= false (p15-s23-typed-all [(vector? children) (vector? ids) (vector? vector-ids)
                                    (integer? count-bindings) (integer? count-body)]))
      (p15-s23-typed-node-error :malformed-typed-let-family node)
    (if (if (>= count-bindings 0) (if (> count-body 0) (<= (+ count-bindings count-body) 65536) false) false)
    (if (= false (p15-s23-typed-all [(= (+ count-bindings count-body) (count children))
                                    (= (+ count-body 2) (count ids)) (= (* 2 count-bindings) (count vector-ids))]))
      (p15-s23-typed-node-error :typed-let-source-or-census-mismatch node)
    (if (< budget (+ 1 (* 8 count-bindings) (* 4 count-body))) (p15-s23-typed-node-error :typed-lowering-work-limit node)
      (let [fixed-work (+ 1 (* 4 count-body)) body-ids (subvec children count-bindings (count children))
            expected-attrs {:binding-vector-form-id (get vector-form :form-id) :binding-vector-syntax-id (get vector-form :syntax-id)
                            :outer-scope-id (get owner :scope-id) :body-scope-id (get (get forms (get ids 2)) :scope-id)
                            :binding-count count-bindings :body-count count-body
                            :initializer-child-indexes (p15-s23-typed-index-range 0 count-bindings)
                            :body-child-indexes (p15-s23-typed-index-range count-bindings (+ count-bindings count-body))
                            :evaluation-order :initializers-then-body-left-to-right
                            :result-policy {:kind :last-body :child-index (- (+ count-bindings count-body) 1)}}
            normal-type (loop [remaining children result (get (get context :types) (get children (- (count children) 1))) never? false]
                          (if (= 0 (count remaining)) (if never? :gravity.type/never result)
                            (recur (rest remaining) result (if (= :gravity.type/never (get (get context :types) (first remaining))) true never?))))]
        (if (p15-s23-typed-all
              [(= attrs expected-attrs) (= count-bindings (count records)) (= (* 2 count-bindings) (count vector-ids))
               (= :list (get owner :kind)) (= :symbol (get (get forms (get ids 0)) :kind))
               (= 'let (get (get forms (get ids 0)) :value)) (= [] (get (get forms (get ids 0)) :child-form-ids))
               (= (get owner :form-id) (get (get forms (get ids 0)) :parent-form-id))
               (= (+ count-bindings count-body) (count children)) (= (+ count-body 2) (count ids))
               (= :vector (get vector-form :kind)) (= (get ids 1) (get vector-form :form-id))
               (= (get owner :form-id) (get vector-form :parent-form-id))
               (= (get node :source) (p15-s23-typed-source owner))
               (= (get node :resolved-binding-ids) (loop [remaining records out []]
                   (if (= 0 (count remaining)) out (recur (rest remaining) (conj out (get (first remaining) :binding-id))))))
               (= normal-type (get (get context :types) (get node :node-id)))
               (loop [i 0]
                 (if (= i count-body) true
                   (let [form (get forms (get ids (+ i 2))) body (get (get context :nodes) (get body-ids i))]
                     (if (p15-s23-typed-all [(= (get body :source) (p15-s23-typed-source form))
                           (= (get owner :form-id) (get form :parent-form-id)) (= (get attrs :body-scope-id) (get form :scope-id))])
                       (recur (+ i 1)) false))))])
          (let [bindings (p15-s23-typed-let-bindings context node records vector-form (- budget fixed-work))]
            (if (p15-s23-compiler-complete? bindings)
              (if (= (get attrs :body-scope-id) (get (get bindings :value) :body-scope))
                (let [body (p15-s23-typed-compile-children-mode (get (get bindings :value) :context) body-ids (- budget fixed-work (get bindings :work-count)) [] :last 0)]
                  (if (p15-s23-compiler-complete? body)
                    (assoc (p15-s23-compiler-result
                      (loop [index (- count-bindings 1) out {:op :do :body (get body :value)}]
                        (if (< index 0) out (recur (- index 1) {:op :let :bindings [(get (get (get bindings :value) :bindings) index)] :body [out]}))))
                      :work-count (+ fixed-work (get bindings :work-count) (get body :work-count))) body))
                (p15-s23-typed-node-error :typed-let-body-scope-mismatch node)) bindings))
          (p15-s23-typed-node-error :typed-let-source-or-census-mismatch node)))))
      (p15-s23-typed-node-error :malformed-typed-let-family node)))))

(defn p15-s23-typed-ordered-node? [node kind]
  (let [children (get node :children) order (get (get node :evaluation) :order)]
    (if (if (vector? children) (vector? order) false)
      (if (= kind (get (get node :evaluation) :kind))
        (if (= (count children) (count order))
          (loop [i 0]
            (if (= i (count children)) true
              (if (= {:index i :core-node-id (get children i)} (get order i)) (recur (+ i 1)) false))) false) false) false)))

(defn p15-s23-typed-compile-loop [context node budget]
  (let [attrs (get node :attributes) children (get node :children) forms (get context :forms)
        owner (get forms (get (get node :source) :form-id)) ids (get owner :child-form-ids)
        vector-form (get forms (get attrs :binding-vector-form-id)) vector-ids (get vector-form :child-form-ids)
        n (get attrs :binding-count) b (get attrs :body-count) target (get (get context :targets) (get attrs :target-id))
        records (loop [remaining (get context :loop-bindings) out []]
                  (if (= 0 (count remaining)) out (recur (rest remaining)
                    (if (= (get node :node-id) (get (first remaining) :loop-core-node-id)) (conj out (first remaining)) out))))]
    (if (= false (p15-s23-typed-all [(vector? children) (vector? ids) (vector? vector-ids) (integer? n) (integer? b)]))
      (p15-s23-typed-node-error :malformed-typed-loop-family node)
    (if (if (>= n 0) (if (> b 0) (<= (+ n b) 65536) false) false)
    (if (= false (p15-s23-typed-all [(= (+ n b) (count children)) (= (+ b 2) (count ids)) (= (* 2 n) (count vector-ids)) (= n (count records))]))
      (p15-s23-typed-node-error :typed-loop-source-or-census-mismatch node)
    (if (< budget (+ 20 (* 8 n) (* 4 b))) (p15-s23-typed-node-error :typed-lowering-work-limit node)
      (let [body-ids (subvec children n (count children)) scope (get (get forms (get ids 2)) :scope-id)
            expected-target {:target-id (get (get node :source) :syntax-id) :target-kind :loop :owner-core-node-id (get node :node-id)
                             :owner-form-id (get owner :form-id) :owner-syntax-id (get owner :syntax-id) :arity n
                             :binding-ids (get node :resolved-binding-ids) :body-scope-id scope
                             :parent-target-id (get (get context :nearest-target) :target-id) :type-compatibility :pending-sh08}
            expected-attrs {:target-id (get target :target-id) :binding-vector-form-id (get vector-form :form-id)
                            :binding-vector-syntax-id (get vector-form :syntax-id) :binding-count n :body-count b
                            :initializer-child-indexes (p15-s23-typed-index-range 0 n) :body-child-indexes (p15-s23-typed-index-range n (+ n b))
                            :evaluation-order :initializers-then-body-left-to-right :result-policy {:kind :last-body :child-index (- (+ n b) 1)}}
            normal-type (loop [remaining children]
                          (if (= 0 (count remaining)) (get (get context :types) (get children (- (count children) 1)))
                            (if (= :gravity.type/never (get (get context :types) (first remaining))) :gravity.type/never (recur (rest remaining)))))
            fixed (+ 20 (* 4 b))]
        (if (p15-s23-typed-all
              [(= target expected-target) (= attrs expected-attrs) (p15-s23-typed-loop-parent? context target)
               (= (get (get context :target-owners) (get node :node-id)) target)
               (= :list (get owner :kind)) (= 'loop (get (get forms (get ids 0)) :value))
               (= (get owner :form-id) (get (get forms (get ids 0)) :parent-form-id))
               (= :vector (get vector-form :kind)) (= (get ids 1) (get vector-form :form-id))
               (= (get owner :form-id) (get vector-form :parent-form-id))
               (= (get node :source) (p15-s23-typed-source owner))
               (= (get target :binding-ids) (loop [remaining records out []]
                   (if (= 0 (count remaining)) out (recur (rest remaining) (conj out (get (first remaining) :binding-id))))))
               (= normal-type (get (get context :types) (get node :node-id)))
               (p15-s23-typed-ordered-node? node :initializers-then-body-left-to-right)
               (loop [i 0]
                 (if (= i b) true
                   (let [form (get forms (get ids (+ i 2))) body (get (get context :nodes) (get body-ids i))]
                     (if (p15-s23-typed-all [(= (get body :source) (p15-s23-typed-source form))
                           (= (get owner :form-id) (get form :parent-form-id)) (= scope (get form :scope-id) (get body :binding-context))])
                       (recur (+ i 1)) false))))])
          (let [bindings (p15-s23-typed-bindings context node records vector-form (- budget fixed) :loop)]
            (if (p15-s23-compiler-complete? bindings)
              (if (= scope (get (get bindings :value) :body-scope))
                (let [body-context (assoc (get (get bindings :value) :context) :nearest-target target :tail? true)
                      body (p15-s23-typed-compile-children-mode body-context body-ids (- budget fixed (get bindings :work-count)) [] :last 0)]
                  (if (p15-s23-compiler-complete? body)
                    (assoc (p15-s23-compiler-result {:op :loop :target (get target :target-id) :bindings (get (get bindings :value) :bindings) :body (get body :value)})
                      :work-count (+ fixed (get bindings :work-count) (get body :work-count))) body))
                (p15-s23-typed-node-error :typed-loop-body-scope-mismatch node)) bindings))
          (p15-s23-typed-node-error :typed-loop-source-or-target-mismatch node)))))
      (p15-s23-typed-node-error :malformed-typed-loop-family node)))))

(defn p15-s23-typed-compile-recur [context node budget]
  (let [attrs (get node :attributes) target (get (get context :targets) (get attrs :target-id))
        transfer (get (get context :transfers) (get node :node-id)) children (get node :children)
        forms (get context :forms) owner (get forms (get (get node :source) :form-id)) ids (get owner :child-form-ids)]
    (if (= false (p15-s23-typed-all [(vector? children) (vector? ids) (vector? (get target :binding-ids))]))
      (p15-s23-typed-node-error :malformed-typed-recur-family node)
    (if (= false (= (count children) (count (get target :binding-ids)))) (p15-s23-typed-node-error :typed-recur-slot-count-mismatch node)
    (if (< budget (+ 20 (* 4 (count children)))) (p15-s23-typed-node-error :typed-lowering-work-limit node)
      (let [kind (get target :target-kind) function? (= :function kind)
            types (loop [remaining children out []]
                    (if (= 0 (count remaining)) out (recur (rest remaining) (conj out (get (get context :types) (first remaining))))))
            slots (if function? (p15-s23-typed-function-slots context target)
                    (loop [remaining (get target :binding-ids) out []]
                    (if (= 0 (count remaining)) out
                      (let [record (get (get context :loop-binding-index) (first remaining))]
                        (recur (rest remaining) (conj out (get (get context :types) (get record :initializer-node-id))))))))
            normal? (loop [remaining types]
                      (if (= 0 (count remaining)) true (if (= :gravity.type/never (first remaining)) false (recur (rest remaining)))))
            expected-transfer {:recur-core-node-id (get node :node-id) :recur-form-id (get owner :form-id) :recur-syntax-id (get owner :syntax-id)
                               :target-id (get target :target-id) :target-kind kind :argument-node-ids children :arity (count children)
                               :tail-position true :evaluation-order :arguments-left-to-right :transfer-policy :nearest-lexical-recur-target :type-compatibility :pending-sh08}
            premise {:kind :loop-recur-type :source-transfer transfer :source-target target :argument-types types :slot-types slots
                     :result-type :gravity.type/never :normal-transfer? normal? :status :solved}]
        (if (p15-s23-typed-all
              [(contains? #{:loop :function} kind) (vector? slots) (= true (get context :tail?)) (= target (get context :nearest-target))
               (= transfer expected-transfer) (= (count children) (get target :arity) (count slots)) (= (+ 1 (count children)) (count ids))
               (= :list (get owner :kind)) (= 'recur (get (get forms (get ids 0)) :value))
               (= (get owner :form-id) (get (get forms (get ids 0)) :parent-form-id))
               (= (get node :source) (p15-s23-typed-source owner)) (= :gravity.type/never (get (get context :types) (get node :node-id)))
               (= {:target-id (get target :target-id) :target-kind kind :arity (count children) :semantic-rule "L2-RECUR-TARGET" :type-compatibility :pending-sh08} attrs)
               (= (get target :binding-ids) (get node :resolved-binding-ids)) (p15-s23-typed-ordered-node? node :arguments-left-to-right-then-transfer)
               (= (p15-s23-typed-loop-row context premise node) (get (get context :loop-rows) [:loop-recur-type (get node :node-id)]))
               (loop [i 0]
                 (if (= i (count children)) true
                   (let [form (get forms (get ids (+ i 1))) argument (get (get context :nodes) (get children i))
                         record (get (get context :loop-binding-index) (get (get target :binding-ids) i))
                         initializer (get (get context :nodes) (get record :initializer-node-id))]
                     (if (p15-s23-typed-all [(= (get owner :form-id) (get form :parent-form-id))
                           (= (get argument :source) (p15-s23-typed-source form)) (= (get argument :binding-context) (get form :scope-id))
                           (if function? true (p15-s23-typed-loop-slot? context record initializer (get slots i)))
                           (if (= :gravity.type/never (get types i)) true (= (get types i) (get slots i)))])
                       (recur (+ i 1)) false))))])
          (let [compiled (p15-s23-typed-compile-children context children (- budget 20 (* 4 (count children))) [])]
            (if (p15-s23-compiler-complete? compiled)
              (assoc (p15-s23-compiler-result {:op :recur :target (get target :target-id) :args (get compiled :value)})
                :work-count (+ 20 (* 4 (count children)) (get compiled :work-count))) compiled))
          (p15-s23-typed-node-error :unsupported-or-mismatched-typed-loop-transfer node))))))))

(defn p15-s23-typed-call-constraint [context id]
  (loop [remaining (get context :ledger) found nil]
    (if (= 0 (count remaining)) found
      (let [row (first remaining) request (get row :constraint-id-request)]
        (if (if (= :gravity/sh08-function-call-constraint-v1 (get request :domain)) (= id (get request :call-core-node-id)) false)
          (if (= found nil) (recur (rest remaining) row) nil) (recur (rest remaining) found))))))

(defn p15-s23-typed-call-fact [context node edge arguments result]
  (let [source (get node :source) module (get (get context :core) :module)]
    {:artifact :gravity/c7-call-type-fact
     :fact-id-request {:domain :gravity/sh08-call-type-fact-v1 :call-core-node-id (get node :node-id)
                       :callee-function-syntax-id (get edge :callee-function-syntax-id) :argument-types arguments :result-type result}
     :call-core-node-id (get node :node-id) :caller-function-syntax-id (get edge :caller-function-syntax-id)
     :callee-function-syntax-id (get edge :callee-function-syntax-id) :argument-types arguments :result-type result
     :evaluation-order :operator-then-arguments :source-span (get source :semantic-span) :syntax-id (get source :syntax-id)
     :origin-chain (get source :origin-chain) :generated-origin (get source :generated-origin)
     :profile (get module :profile) :target (get module :target) :effects (get module :effects)
     :capabilities (get module :capabilities) :status :inferred}))

(defn p15-s23-typed-compile-call [context node budget]
  (let [id (get node :node-id) call (get (get context :calls) id) edge (get (get context :edges) id)
        forms (get context :forms) children (get node :children) owner (get forms (get (get node :source) :form-id))
        ids (get owner :child-form-ids)
        callee-record (loop [remaining (get (get context :core) :function-records) found nil]
                        (if (= 0 (count remaining)) found
                          (if (= (get (first remaining) :definition-binding-id) (get edge :callee-binding-id))
                            (if (= found nil) (recur (rest remaining) (first remaining)) nil) (recur (rest remaining) found))))
        name (get callee-record :definition-name) joined (p15-s23-typed-definition context name) callee (get (get joined :value) :function)
        definition-node (get (get context :nodes) (get callee-record :definition-core-node-id))
        definition-form (get forms (get (get definition-node :source) :form-id))
        definition-name-form (get forms (get (get definition-form :child-form-ids) 1))
        caller (get context :current-function)]
    (if (= false (p15-s23-typed-all [(vector? children) (vector? ids) (vector? (get call :argument-node-ids))]))
      (p15-s23-typed-node-error :malformed-typed-call-family node)
    (if (if (> (count children) 0) (= (count ids) (count children)) false)
    (if (< budget (+ 16 (count children))) (p15-s23-typed-node-error :typed-lowering-work-limit node)
      (let [arguments (subvec children 1 (count children)) operator (get (get context :nodes) (first children))
            binding-id (get call :operator-binding-id) binding (get (get context :bindings) binding-id)
            operator-form (get forms (first ids)) parameters (get callee :parameters)
            types (loop [remaining arguments out []]
                    (if (= 0 (count remaining)) out (recur (rest remaining) (conj out (get (get context :types) (first remaining))))))
            result (loop [remaining types]
                     (if (= 0 (count remaining)) (get callee :return)
                       (if (= :gravity.type/never (first remaining)) :gravity.type/never (recur (rest remaining)))))
            pairs (loop [i 0 out []]
                    (if (= i (count parameters)) out (recur (+ i 1)
                      (conj out {:parameter (get (get parameters i) :binding-id) :argument (get types i) :chosen (get (get parameters i) :type)}))))
            expected-call {:core-node-id id :operator-node-id (first children) :operator-binding-id binding-id
                           :argument-node-ids arguments :ordered-evaluation-node-ids children
                           :evaluation-order :operator-then-arguments :result-policy :call-result}
            expected-edge {:ordinal (get (get context :call-order) id) :call-core-node-id id
                           :caller-function-syntax-id (get caller :function-syntax-id) :caller-function-core-node-id (get caller :function-core-node-id)
                           :callee-binding-id (get callee-record :definition-binding-id) :callee-definition-syntax-id (get binding :definition-syntax-id)
                           :callee-function-syntax-id (get callee-record :function-syntax-id) :callee-function-core-node-id (get callee-record :function-core-node-id)
                           :argument-core-node-ids arguments :ordered-evaluation-node-ids children
                           :evaluation-order :operator-then-arguments :classification :local-function}
            row {:constraint-id-request {:domain :gravity/sh08-function-call-constraint-v1 :call-core-node-id id
                                         :callee-function-syntax-id (get callee-record :function-syntax-id)}
                 :kind :equality :lhs (get callee-record :function-syntax-id) :rhs pairs :origin (get (get node :source) :origin-chain)
                 :profile :meta :target :jvm :status :solved :diagnostics []}
            view [:function-id :function-core-node-id :body-core-node-id :parameters :return :signature :thrown-error-effects]]
        (if (< budget (+ 16 (count arguments))) (p15-s23-typed-node-error :typed-lowering-work-limit node)
        (if (p15-s23-typed-all
              [(p15-s23-compiler-complete? joined) (= :named-top-level (get callee-record :definition-kind))
               (= [] (get context :recursion-components)) (= expected-call call) (= expected-edge edge)
               (= :reference (get operator :core-form)) (= [binding-id] (get operator :resolved-binding-ids) (get node :resolved-binding-ids))
               (= binding-id (get (get operator :attributes) :binding-id))
               (= (get caller :function-syntax-id) (get (get node :evaluation) :owner-function-syntax-id))
               (= :operator-then-arguments (get (get node :evaluation) :kind))
               (= (loop [i 0 out []] (if (= i (count children)) out
                    (recur (+ i 1) (conj out {:index i :core-node-id (get children i)})))) (get (get node :evaluation) :order))
               (= (get node :source) (p15-s23-typed-source owner)) (= :list (get owner :kind))
               (= (get operator :source) (p15-s23-typed-source operator-form))
               (= :symbol (get operator-form :kind))
               (if (= (get binding :name) (get operator-form :value)) true
                 (= (str (get binding :namespace) "/" (get binding :name)) (str (get operator-form :value))))
               (= {:symbol (get operator-form :value) :position :operator :binding-id binding-id
                   :binding-class (get binding :binding-class) :definition-syntax-id (get binding :definition-syntax-id)} (get operator :attributes))
               (= (get owner :form-id) (get operator-form :parent-form-id))
               (= (get binding :definition-syntax-id) (get definition-name-form :syntax-id))
               (= name (get binding :name) (get definition-name-form :value))
               (= :namespace (get binding :binding-class)) (= :function (get binding :kind))
               (= (get (get (get context :core) :module) :namespace) (get binding :namespace))
               (= (get definition-form :form-id) (get definition-name-form :parent-form-id))
               (= {:operator-child-index 0 :argument-count (count arguments) :argument-child-indexes (p15-s23-typed-index-range 1 (count children))
                   :evaluation-order :operator-then-arguments :dispatch :resolved-symbol-call} (get node :attributes))
               (= (count parameters) (count arguments) (get callee-record :fixed-arity))
               (= (p15-s23-typed-project callee view) (p15-s23-typed-project (get (get context :types) (first children)) view))
               (= result (get (get context :types) id))
               (= row (p15-s23-typed-call-constraint context id))
               (= (p15-s23-typed-call-fact context node edge types result) (get (get context :call-facts) id))
               (loop [i 0]
                 (if (= i (count arguments)) true
                   (let [source-form (get forms (get ids (+ i 1))) argument (get (get context :nodes) (get arguments i)) type (get types i)]
                     (if (p15-s23-typed-all [(= (get owner :form-id) (get source-form :parent-form-id))
                           (= (get argument :source) (p15-s23-typed-source source-form))
                           (if (= type :gravity.type/never) true (= type (get (get parameters i) :type)))])
                       (recur (+ i 1)) false))))])
          (let [compiled (p15-s23-typed-compile-children context arguments (- budget 16 (count arguments)) [])]
            (if (p15-s23-compiler-complete? compiled)
              (assoc (p15-s23-compiler-result {:op :function-call :function name :args (get compiled :value)})
                :work-count (+ 16 (count arguments) (get compiled :work-count))) compiled))
          (p15-s23-typed-node-error :unsupported-or-mismatched-typed-direct-call node)))))
      (p15-s23-typed-node-error :malformed-typed-call-family node)))))

(defn p15-s23-typed-compile-node [context id budget]
  (let [node (get (get context :nodes) id) form (get node :core-form) children (get node :children)
        source (get (get context :forms) (get (get node :source) :form-id)) type (get (get context :types) id)]
    (if (<= budget 0) (p15-s23-typed-node-error :typed-lowering-work-limit node)
      (if (if (map? node) (= false (contains? #{nil :gravity.type/unknown} type)) false)
        (if (= form :loop) (p15-s23-typed-compile-loop context node budget)
        (if (= form :recur) (p15-s23-typed-compile-recur context node budget)
        (if (= form :call) (p15-s23-typed-compile-call context node budget)
        (if (= form :let) (p15-s23-typed-compile-let context node budget)
        (if (= form :try) (p15-s23-typed-compile-try context node budget)
        (if (= form :quote) (p15-s23-typed-symbol-quote context node budget)
        (if (= form :literal)
          (if (if (= :decimal (get (get node :attributes) :literal-kind)) true (map? (get source :value)))
            (p15-s23-typed-node-error :unelaborated-typed-numeric-literal node)
          (if (= (get source :value) (get (get node :attributes) :value))
            (assoc (p15-s23-compiler-result {:op :literal :value (get source :value)}) :work-count 1)
            (p15-s23-typed-node-error :typed-literal-source-mismatch node)))
          (if (= form :reference)
            (let [binding (get (get node :attributes) :binding-id) name (get (get context :locals) binding)]
              (if (if (= name nil) false (= type (get (get context :parameter-types) binding)))
                (assoc (p15-s23-compiler-result {:op :local :name name}) :work-count 1)
                (p15-s23-typed-node-error :typed-reference-outside-parameters node)))
            (if (contains? #{:throw :if :do} form)
              (if (if (= form :throw) (if (= 1 (count children)) (= type :gravity.type/never) false)
                    (if (= form :if) (= 3 (count children)) true))
                (let [compiled (p15-s23-typed-compile-children-mode context children (- budget 1) []
                                 (if (= form :if) :branches (if (= form :do) :last :none)) 0) values (get compiled :value)]
                  (if (p15-s23-compiler-complete? compiled)
                    (assoc (p15-s23-compiler-result
                      (if (= form :throw) {:op :throw :value (first values)}
                        (if (= form :if) {:op :if :test (first values) :then (get values 1) :else (get values 2)}
                          {:op :do :body values}))) :work-count (+ 1 (get compiled :work-count))) compiled))
                (p15-s23-typed-node-error :typed-control-shape-mismatch node))
              (p15-s23-typed-node-error :unsupported-typed-lowering-operation node))))))))))
        (p15-s23-typed-node-error :missing-typed-core-node node)))))

(defn p15-s23-typed-provenance [context]
  (let [observation (get context :observation) source (get observation :source)]
    {:boundary :current-gravity-typed-lowering :authority :non-authoritative
     :emission-scope :current-c6-typed-function-subset
     :compiler-sources (get observation :compiler-sources)
     :source {:path (get source :path) :sha256 (get source :sha256)}
     :typed-core-input (get (get context :core) :artifact-id)
     :type-verifier :current-gravity-c7 :effect-legality :pending-c8-and-profile-authority}))

(defn p15-s23-typed-lower-function [module definition context]
  (let [joined (p15-s23-typed-definition context (get definition :name)) value (get joined :value)]
    (if (p15-s23-compiler-complete? joined)
      (if (= definition (get value :definition))
        (let [node (get (get context :nodes) (get (get value :record) :function-core-node-id))
              targeted? (contains? (get node :attributes) :recur-target-id)
              target (get (get context :targets) (get (get node :attributes) :recur-target-id))
              active (assoc context :locals (get value :locals) :parameter-types (get value :parameter-types)
                       :current-function (get value :record) :tail? true :nearest-target target)
              compiled (if (if targeted? (p15-s23-typed-function-target? active target) true)
                         (p15-s23-typed-compile-node active (get (get value :record) :body-core-node-id) (get context :budget))
                         (p15-s23-typed-node-error :typed-function-target-mismatch node))
              function (get value :function)]
          (if (p15-s23-compiler-complete? compiled)
            (p15-s23-compiler-result (assoc (if targeted? (assoc definition :recur-target (get target :target-id)) definition)
              :instructions [(get compiled :value)]
              :binding {:name (get definition :name) :kind :function :namespace (get module :module)
                :profile (get module :profile) :target (get module :target)
                :visibility (if (> (count (get module :exports)) 0)
                              (if (contains? (set (get module :exports)) (get definition :name)) :public :private) :stage2-local)
                :effects (get module :effects) :capabilities (get module :capabilities)}
              :type-input {:function-id (get function :function-id) :function-core-node-id (get function :function-core-node-id)
                           :body-core-node-id (get function :body-core-node-id)
                           :definition-binding-id (get (get value :record) :definition-binding-id)
                           :parameters (get function :parameters)
                           :return (get function :return) :thrown-error-effects (get function :thrown-error-effects)}
              :typed-lowering-provenance (p15-s23-typed-provenance context))) compiled))
        (p15-s23-typed-node-error :supplied-definition-does-not-match-typed-source
          (get (get context :nodes) (get (get value :record) :function-core-node-id)))) joined)))

(defn p15-s23-typed-compile-function [emitter module definition input observation]
  (let [checked (p15-s23-typed-context module input observation)]
    (if (p15-s23-compiler-complete? checked)
      (if (p15-s23-typed-module-table? module (get checked :value))
        (p15-s23-typed-lower-function module definition (get checked :value))
        (p15-s23-typed-error :typed-module-function-table-mismatch)) checked)))

(defn p15-s23-typed-module-table? [module context]
  (if (contains? module :function-table)
    (let [table (get module :function-table)]
      (if (if (map? table) (if (= (count table) (count (get context :records)))
                            (= (set (keys table)) (set (keys (get context :records)))) false) false)
        (loop [remaining (keys table)]
          (if (= 0 (count remaining)) true
            (let [expected (p15-s23-typed-definition context (first remaining))]
              (if (if (p15-s23-compiler-complete? expected) (= (get table (first remaining)) (get (get expected :value) :definition)) false)
                (recur (rest remaining)) false)))) false)) true))

(defn p15-s23-typed-assemble-plan-products [emitter module definitions input observation]
  (let [checked (p15-s23-typed-context module input observation) context (get checked :value)]
    (if (p15-s23-compiler-complete? checked)
      (if (if (vector? definitions) (= (count definitions) (count (get context :records))) false)
        (let [indexed (p15-s23-typed-index
                  (loop [remaining definitions out []]
                    (if (= 0 (count remaining)) out
                      (let [entry (first remaining)]
                        (if (if (vector? entry) (if (= 2 (count entry))
                              (if (symbol? (first entry)) (map? (second entry)) false) false) false)
                          (recur (rest remaining) (conj out {:name (first entry) :definition (second entry)}))
                          (conj out {}))))) :name)]
      (if (if (map? indexed) (if (p15-s23-typed-module-table? module context)
                              (= (set (keys indexed)) (set (keys (get context :records)))) false) false)
        (loop [remaining definitions functions {} bindings [] summary {}]
          (if (= 0 (count remaining))
            (let [entrypoint (get (get emitter :plan-shape) :entrypoint 'main)
                  main-function (get functions entrypoint)
                  products (p15-s23-complete-plan-products module
                             {:functions functions :binding-table bindings :instruction-summary summary}
                             (if (= main-function nil) nil entrypoint))]
              (if (if (= main-function nil) false (> (count (get main-function :params)) 0))
                (p15-s23-compiler-error "L2-MAIN-ARITY" {:params (get main-function :params)})
                (assoc products :value (assoc (get products :value) :typed-lowering-provenance (p15-s23-typed-provenance context)
                  :effect-summary (assoc (get (get products :value) :effect-summary)
                    :legality :pending-c8-and-profile-authority :authority :non-authoritative)))))
            (let [entry (first remaining) compiled (p15-s23-typed-lower-function module (second entry) context)
                  function (get compiled :value)]
              (if (if (= (first entry) (get (second entry) :name)) (p15-s23-compiler-complete? compiled) false)
                (let [counted (p15-s23-summary-instructions (get function :instructions) summary)]
                  (if (p15-s23-compiler-complete? counted)
                    (recur (rest remaining) (assoc functions (first entry) function)
                      (conj bindings (assoc (get function :binding) :arity (get function :arity))) (get counted :value)) counted))
                (if (p15-s23-compiler-complete? compiled) (p15-s23-typed-error :typed-definition-name-mismatch) compiled)))))
        (p15-s23-typed-error :typed-module-definition-census)))
        (p15-s23-typed-error :typed-module-definition-census)) checked)))

(defn main
  []
  (hash-map :artifact :gravity/stage2-expression-lowering
            :status :ready))

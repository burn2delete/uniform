(defn p15-s23-mkeys-row-census [core ledger nodes bindings types calls edges target descriptor budget]
  (let [base (* 4 (count ledger))]
    (if (> base budget) {:status :rejected :reason :map-keys-work-limit :work-count base}
      (loop [index 0 items [] seen #{} descriptors {} used base]
        (if (= index (count ledger)) {:status :accepted :items items :descriptors descriptors :work-count used}
          (let [row (get ledger index) producer (if (typed-ledger-record? row) (get row :producer-rule :ordinary-local-function-call) nil)]
            (if (keyword? producer)
              (if (if (= :sh08-map-keys-v1 producer) true
                    (let [lhs (get row :lhs) dependencies (get row :dependencies) request (get row :constraint-id-request)
                          projection (if (typed-ledger-record? lhs) (get lhs :projection) nil)
                          kind (if (typed-ledger-record? dependencies) (get dependencies :kind) nil)
                          domain (if (typed-ledger-record? request) (get request :domain) nil)]
                      (if (if (keyword? projection) (= :map-keys projection) false) true
                        (if (if (keyword? kind) (= :gravity.type/applied-map-keys kind) false) true
                          (if (keyword? domain) (= :gravity/sh08-map-keys-constraint-v1 domain) false)))))
                (let [lhs (get row :lhs) id (if (typed-ledger-record? lhs) (get lhs :core-node-id) nil)]
                  (if (p15-s23-sse-ids? [id] 1)

                    {:status :rejected :reason :vector-rest-source-mismatch :work-count work}))))
                  {:status :rejected :reason :vector-rest-finite-positional-vector-type-required :work-count work})))))
        {:status :rejected :reason :vector-rest-source-mismatch :work-count base})))

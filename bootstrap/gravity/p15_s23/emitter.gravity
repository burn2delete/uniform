                      :callee-body :equality-domain :inferred-member-carrier :carrier-schema :finite-member-types
                      :string-equality-policy :representation-work :value-policy :profile :target :evaluation-order]}
      (let [header {:kind :gravity.type/applied-keyword-set-equality :version :sh08-keyword-set-equality-v1
       :operation '= :semantic-owner 'gravity.collections :intrinsic :gravity.collections/keyword-set-value-equality
       :resolution :gravity.core-compatibility :operator-node-id (get operator :node-id) :operator-binding-id bid

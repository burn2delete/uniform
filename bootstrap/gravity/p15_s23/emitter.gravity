                           (= (get argument :source) (p15-s23-typed-source form)) (= (get argument :binding-context) (get form :scope-id))
                           (if function? true (p15-s23-typed-loop-slot? context record initializer
                             (get (get context :types) (get record :initializer-node-id))))
                           (if (map? (get invariants (get (get target :binding-ids) i)))
                             (p15-s23-lsi-compatible? (get types i) (get slots i))
                             (if (= :gravity.type/never (get types i)) true (= (get types i) (get slots i))))])
                       (recur (+ i 1)) false))))])
          (let [compiled (p15-s23-typed-compile-children context children (- budget 20 (* 4 (count children)) member-work) [])]
            (if (p15-s23-compiler-complete? compiled)

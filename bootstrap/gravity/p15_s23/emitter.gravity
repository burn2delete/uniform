          (if (if character? true (if strings? true (if (= :gravity.type/keyword needle) true (= :gravity.type/never needle))))
            (if (= :gravity.type/never items)
              (if character?
                {:status :accepted :work-count 2 :argument-types arguments :set-member-count nil :membership-family :character}
                (if strings?
                  {:status :accepted :work-count 2 :argument-types arguments :set-member-count nil :membership-family :string}
                  {:status :accepted :work-count 2 :argument-types arguments :set-member-count nil}))
              (if (if (if (map? items) (if (= 3 (count items))
                    (loop [fields (keys items)]
                      (if (= 0 (count fields)) true (if (keyword? (first fields)) (recur (rest fields)) false))) false) false) (= :homogeneous (get items :shape)) false)
                (if (< limit 3)

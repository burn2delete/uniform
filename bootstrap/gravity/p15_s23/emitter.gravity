            argument-id (get (get call :argument-node-ids) index) argument (get nodes argument-id)
            node (get nodes (get call :core-node-id))]
        (if (if (> base budget) true (= :work-limit (get validation :reason)))
          {:status :rejected :reason :list-parameter-work-limit :work-count work}
          (if (p15-s23-typed-all
                [(= :accepted (get validation :status))
                 (= :local-function (get edge :classification))
                 (= (get callee :function-id) (get edge :callee-function-syntax-id) (get record :function-syntax-id))
                 (= (get record :signature) (get callee :signature))
                 (= (get record :function-core-node-id) (get edge :callee-function-core-node-id))
                 (= bid (get (get record :parameter-binding-ids) index) (get binding :binding-id))
                 (= [:lexical :local] [(get binding :binding-class) (get binding :kind)])
                 (= [:core :type 'gravity.core 'List] [(get type-binding :binding-class) (get type-binding :kind)
                                                       (get type-binding :namespace) (get type-binding :name)])
                 (if homogeneous?
                   (p15-s23-typed-all [(p15-s23-hl-declaration? declaration bindings) (= expected (get declaration :type-id))
                     (if (if (= :accepted (get validation :status)) (vector? (get actual :element-types)) false)
                       (loop [members (get actual :element-types)]
                         (if (= 0 (count members)) true
                           (if (= (first members) (get expected :element-type)) (recur (rest members)) false))) false)])
                   (= ['List :gravity.type/list] [(get declaration :type-symbol) (get declaration :type-id)]))
                 (= (get declaration :source-child-index) (+ 1 (get (get (get record :signature) :parameter-source-child-indexes) index -100)))
                 (= (get call :core-node-id) (get edge :call-core-node-id) (get node :node-id))
                 (= (get call :argument-node-ids) (get edge :argument-core-node-ids) (vec (rest (get node :children))))
                 (= argument-id (get argument :node-id))])
            {:status :accepted :work-count work
             :premise (let [premise {:version :sh08-bare-list-parameter-v1 :relation :forget-positional-list-refinement
                       :call-core-node-id (get call :core-node-id) :argument-node-id argument-id :argument-index index
                       :actual-type actual :declared-type expected
                       :callee-function-syntax-id (get record :function-syntax-id)
                       :parameter-binding-id bid :parameter-binding binding :declaration declaration :type-binding type-binding
                       :argument-source (get argument :source) :call-source (get node :source)
                       :source-call call :source-edge edge :operand-type-work (get validation :work-count)
                       :forgets [:positional-element-types :static-length]
                       :preserves [:value :provenance :schema :ownership :linearity :regions :profile :memory-obligations]
                       :profile (get (get core :module) :profile) :target (get (get core :module) :target)}]
                        (if homogeneous?
                          (assoc premise :version :sh08-homogeneous-list-parameter-v1 :relation :all-positional-elements-match
                            :forgets [:static-length] :element-binding (get bindings (get declaration :element-binding-id))
                            :checked-element-type (get expected :element-type) :checked-element-count (count (get actual :element-types))) premise))}
            {:status :rejected :reason (if homogeneous? :homogeneous-list-parameter-incompatible :list-parameter-declaration-required) :work-count work})))
      {:status :not-applicable :work-count 0}))))

(defn p15-s23-lp-pairs-adapted? [pairs]
  (loop [remaining pairs]
    (if (= 0 (count remaining)) false
      (if (contains? (first remaining) :compatibility) true (recur (rest remaining))))))

(defn p15-s23-lp-call-row [row]
  (if (p15-s23-lp-pairs-adapted? (get row :rhs))
    (assoc row :kind :argument-compatibility :compatibility-rule-version
      (loop [pairs (get row :rhs) map? false homogeneous? false]
        (if (= 0 (count pairs))
          (if map? :sh08-map-list-parameter-compatibility-v1
            (if homogeneous? :sh08-list-parameter-compatibility-v2 :sh08-bare-list-parameter-v1))
          (let [version (get (get (first pairs) :compatibility) :version)]
            (recur (rest pairs) (if map? true (= version :sh08-bare-map-parameter-v1))
                               (if homogeneous? true (= version :sh08-homogeneous-list-parameter-v1))))))) row))

(defn p15-s23-typed-compile-call [context node budget]
  (if (if (= :nonlocal-or-nonfunction (get (get (get context :edges) (get node :node-id)) :classification))
        (contains? #{:gravity.type/applied-string-concat :gravity.type/applied-list-construction :gravity.type/applied-list-query :gravity.type/applied-vector-first}
          (get (get (get context :types) (first (get node :children))) :kind)) false)
    (if (contains? #{:gravity.type/applied-list-query :gravity.type/applied-vector-first} (get (get (get context :types) (first (get node :children))) :kind))
      (p15-s23-typed-compile-list-query context node budget)
    (if (= :gravity.type/applied-list-construction (get (get (get context :types) (first (get node :children))) :kind))
      (p15-s23-typed-compile-list-construction context node budget)

     :slot-binding-id (get proof :slot-binding-id) :slot-name (get (get context :locals) (get proof :slot-binding-id))
     :guard-core-node-id (get (get proof :guard-node) :node-id) :condition-core-node-id (get (get proof :condition) :call-core-node-id)
     :count-core-node-id (get (get proof :count-query) :call-core-node-id)
     :count-operand-node-id (first (get (get (get proof :count-query) :source-call) :argument-node-ids))
     :vector-origin-node-id (get (get (get proof :vector-origin) :node) :node-id)
     :vector-extent (get proof :vector-extent) :maximum-vector-extent 1024 :lower 0 :step 1
     :guard-relation :zero-le-counter-lt-extent :result-relation :zero-lt-successor-le-extent}]

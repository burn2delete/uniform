                         (if (if (= (get (p15-s23-vn-constraint descriptor) :producer-rule) (get row :producer-rule))
                               (= (get (p15-s23-vn-constraint descriptor) :lhs) (get row :lhs)) false) (conj out row) out)))))]
        (if (if (p15-s23-vl-proof-valid? descriptor core node nodes (get context :bindings) types)
              (p15-s23-typed-all
                [(p15-s23-si-step-forms-valid? (get (get (get descriptor :bounds-proof) :loop-invariant) :range-proof) core nodes forms)
                 (= call (get descriptor :source-call)) (= edge (get descriptor :source-edge))

                           (= :conditional-branch (get item :kind)) (= :selected-exactly-once (get item :execution))
                           (contains? #{:then :else} (get item :role))
                           (contains? #{:module-initialization :function-body :conditional-branch :match-guard} (get item :parent-region-kind))
                           (if (= :conditional-branch (get item :parent-region-kind))
                             (if (p15-s23-sse-ids? [(get item :parent-if-syntax-id)] 1)

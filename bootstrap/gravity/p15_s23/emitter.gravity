(defn p15-s23-pl-constraint [descriptor]
  (if (= :sh08-symbol-set-insertion-v2 (get descriptor :version))
    {:constraint-id-request {:domain :gravity/sh08-symbol-set-insertion-constraint-v2 :application descriptor}
     :kind :equality :producer-rule :sh08-symbol-set-insertion-v2
     :lhs {:core-node-id (get descriptor :call-core-node-id) :projection :symbol-set-insertion}
     :rhs (get descriptor :result-type) :dependencies descriptor :origin (get (get descriptor :source) :origin-chain)
     :solution {:result-type (get descriptor :result-type) :application (get descriptor :application)
                :direct-effects (get descriptor :direct-effects) :insertion-semantics (get descriptor :insertion-semantics)
                :allocation-policy (get descriptor :allocation-policy) :storage-policy (get descriptor :storage-policy)}
     :invalidation (get descriptor :invalidation) :profile (get descriptor :profile) :target (get descriptor :target)
     :status :solved :diagnostics []}
    (if (= :sh08-keyword-set-insertion-v1 (get descriptor :version))
    {:constraint-id-request {:domain :gravity/sh08-keyword-set-insertion-constraint-v1 :application descriptor}
     :kind :equality :producer-rule :sh08-keyword-set-insertion-v1
     :lhs {:core-node-id (get descriptor :call-core-node-id) :projection :keyword-set-insertion}
     :rhs (get descriptor :result-type) :dependencies descriptor :origin (get (get descriptor :source) :origin-chain)
     :solution {:result-type (get descriptor :result-type) :application (get descriptor :application)
                :direct-effects (get descriptor :direct-effects) :insertion-semantics (get descriptor :insertion-semantics)
                :allocation-policy (get descriptor :allocation-policy) :storage-policy (get descriptor :storage-policy)}
     :invalidation (get descriptor :invalidation) :profile (get descriptor :profile) :target (get descriptor :target)
     :status :solved :diagnostics []}
    {:constraint-id-request {:domain (if (= :sh08-string-set-insertion-v2 (get descriptor :version)) :gravity/sh08-string-set-insertion-constraint-v2 :gravity/sh08-list-prepend-constraint-v1) :application descriptor}
   :kind :equality :producer-rule (if (= :sh08-string-set-insertion-v2 (get descriptor :version)) :sh08-string-set-insertion-v2 :sh08-list-prepend-v1)
   :lhs {:core-node-id (get descriptor :call-core-node-id) :projection (if (= :sh08-string-set-insertion-v2 (get descriptor :version)) :string-set-insertion :list-prepend)}
   :rhs (get descriptor :result-type) :dependencies descriptor :origin (get (get descriptor :source) :origin-chain)
   :solution (if (= :sh08-string-set-insertion-v2 (get descriptor :version))
               (assoc {:result-type (get descriptor :result-type) :application (get descriptor :application)
              :direct-effects (get descriptor :direct-effects)}
                 :insertion-semantics (get descriptor :insertion-semantics)
                 :allocation-policy (get descriptor :allocation-policy) :storage-policy (get descriptor :storage-policy))
               {:result-type (get descriptor :result-type) :application (get descriptor :application)
              :direct-effects (get descriptor :direct-effects)})
   :invalidation (get descriptor :invalidation) :profile (get descriptor :profile) :target (get descriptor :target)
   :status :solved :diagnostics []})))


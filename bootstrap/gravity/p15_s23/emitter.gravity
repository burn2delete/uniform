             \u00F0 \u00F1 \u00F2 \u00F3 \u00F4 \u00F5 \u00F6 \u00F7 \u00F8 \u00F9 \u00FA \u00FB \u00FC \u00FD \u00FE \u00FF}
                                valid? (loop [remaining value i 0]
                                         (if (= i n) true
                                           (let [unit (first remaining)]
                                             (if (if (char? unit) (contains? latin1 unit) false)
                                               (recur (rest remaining) (+ i 1)) false))))]
                            (if valid?
                              {:status :accepted :work-count work
                               :proof (assoc {:schema :gravity/string-character-vector-proof-v1
                               :call-core-node-id (get node :node-id) :source-forms [owner op-form arg-form]
                               :operand (if normal? {:kind :original-string-literal :node argument :source-form arg-form :value value}
                                            {:kind :non-invoked-operand})

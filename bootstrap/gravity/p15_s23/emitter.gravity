(defn p15-s23-vemp-row-census [core ledger nodes bindings types calls edges target descriptor budget]
  (let [base (* 4 (count ledger))]
    (if (> base budget) {:status :rejected :reason :vector-empty-work-limit :work-count base}
      (loop [index 0 items [] seen #{} descriptors {} used base]
        (if (= index (count ledger)) {:status :accepted :items items :descriptors descriptors :work-count used}
          (let [row (get ledger index) producer (if (map? row) (get row :producer-rule) nil)]
            (if (keyword? producer)

; Gravity-authored stage2 expression lowering for the current closed compiler
; subset.  The Clojure seed still parses and compiles this module and provides
; a generic function-plan runner plus explicitly enumerated pure collection
; predicates.  Lowering decisions and diagnostic selection live here.
(ns gravity.bootstrap.p15-s23.emitter
  (:profile :meta)
  (:target :jvm)
  (:effects #{})
  (:capabilities #{})
  (:safety :safe))

(defn p15-s23-compiler-result
  [value]
  (hash-map :status :complete :value value))

(defn p15-s23-compiler-error
  [diagnostic facts]
  (hash-map :status :rejected :diagnostic diagnostic :facts facts))

(defn p15-s23-compiler-complete?
  [result]
  (= :complete (get result :status)))

(defn p15-s23-path-append
  [path suffix]
  (loop [result (vec path) remaining suffix]
    (if (= 0 (count remaining))
      result
      (recur (conj result (first remaining)) (rest remaining)))))

(defn p15-s23-child-module
  [module suffix]
  (assoc
   (assoc module :p15-s23-sh07-callsite-path
          (p15-s23-path-append
           (get module :p15-s23-sh07-callsite-path []) suffix))
   :p15-s23-sh07-child-index-base 0))

; This is independently authored in Gravity, but intentionally has the same
; closed value algebra as the reader identity carrier.  The decorated vectors
; make host map/set iteration irrelevant before sort-by-pr-str is applied.
(defn p15-s23-reader-canonical-value
  [value]
  (if (map? value)
    (loop [remaining (vec (keys value)) decorated []]
      (if (= 0 (count remaining))
        (vector :map (vec (sort-by-pr-str decorated)))
        (let [key (first remaining)]
          (recur
           (rest remaining)
           (conj decorated
                 (vector (p15-s23-reader-canonical-value key)
                         (p15-s23-reader-canonical-value (get value key))))))))
    (if (set? value)
      (loop [remaining (vec value) decorated []]
        (if (= 0 (count remaining))
          (vector :set (vec (sort-by-pr-str decorated)))
          (recur
           (rest remaining)
           (conj decorated
                 (p15-s23-reader-canonical-value (first remaining))))))
      (if (vector? value)
        (loop [remaining value result []]
          (if (= 0 (count remaining))
            (vector :vector result)
            (recur
             (rest remaining)
             (conj result
                   (p15-s23-reader-canonical-value (first remaining))))))
        (if (seq? value)
          (loop [remaining value result []]
            (if (= 0 (count remaining))
              (vector :list result)
              (recur
               (rest remaining)
               (conj result
                     (p15-s23-reader-canonical-value (first remaining))))))
          value)))))

(defn p15-s23-canonical-map-entries
  [value]
  (let [decorated
        (loop [remaining (vec (keys value)) result []]
          (if (= 0 (count remaining))
            result
            (let [key (first remaining)
                  item (get value key)]
              (recur
               (rest remaining)
               (conj result
                     (vector
                      (p15-s23-reader-canonical-value (vector key item))
                      (vector key item)))))))]
    (loop [remaining (sort-by-pr-str decorated) result []]
      (if (= 0 (count remaining))
        result
        (recur (rest remaining)
               (conj result (second (first remaining))))))))

(defn p15-s23-canonical-set-items
  [value]
  (let [decorated
        (loop [remaining (vec value) result []]
          (if (= 0 (count remaining))
            result
            (let [item (first remaining)]
              (recur
               (rest remaining)
               (conj result
                     (vector (p15-s23-reader-canonical-value item) item))))))]
    (loop [remaining (sort-by-pr-str decorated) result []]
      (if (= 0 (count remaining))
        result
        (recur (rest remaining)
               (conj result (second (first remaining))))))))

(defn p15-s23-compile-forms
  [emitter module locals forms compiled]
  (if (= 0 (count forms))
    (p15-s23-compiler-result compiled)
    (if (> (count forms) 64)
      (let [items (vec forms)
            midpoint (quot (count items) 2)
            left
            (p15-s23-compile-forms
             emitter module locals (subvec items 0 midpoint) compiled)]
        (if (p15-s23-compiler-complete? left)
          (p15-s23-compile-forms
           emitter module locals (subvec items midpoint (count items))
           (get left :value))
          left))
      (let [compiled-form
            (p15-s23-compile-expr
             emitter
             (p15-s23-child-module
              module
              (vector (+ (get module :p15-s23-sh07-child-index-base 0)
                         (count compiled))))
             locals (first forms))]
        (if (p15-s23-compiler-complete? compiled-form)
          (p15-s23-compile-forms
           emitter module locals (rest forms)
           (conj compiled (get compiled-form :value)))
          compiled-form)))))

(defn p15-s23-compile-map-entries
  [emitter module locals entries compiled]
  (if (= 0 (count entries))
    (p15-s23-compiler-result compiled)
    (if (> (count entries) 64)
      (let [items (vec entries)
            midpoint (quot (count items) 2)
            left
            (p15-s23-compile-map-entries
             emitter module locals (subvec items 0 midpoint) compiled)]
        (if (p15-s23-compiler-complete? left)
          (p15-s23-compile-map-entries
           emitter module locals (subvec items midpoint (count items))
           (get left :value))
          left))
      (let [entry (first entries)
            entry-index (count compiled)
            compiled-key
            (p15-s23-compile-expr
             emitter (p15-s23-child-module module (vector entry-index 0))
             locals (first entry))]
        (if (p15-s23-compiler-complete? compiled-key)
          (let [compiled-value
                (p15-s23-compile-expr
                 emitter (p15-s23-child-module module (vector entry-index 1))
                 locals (second entry))]
            (if (p15-s23-compiler-complete? compiled-value)
              (p15-s23-compile-map-entries
               emitter module locals (rest entries)
               (conj compiled
                     (hash-map :key (get compiled-key :value)
                               :value (get compiled-value :value))))
              compiled-value))
          compiled-key)))))

(defn p15-s23-compile-collection
  [emitter module locals form]
  (let [collection-rules (get emitter :collection-rules)]
    (if (vector? form)
      (let [items
            (p15-s23-compile-forms emitter module locals form [])]
        (if (p15-s23-compiler-complete? items)
          (p15-s23-compiler-result
           (hash-map :op (get (get collection-rules :vector) :op)
                     :items (get items :value)))
          items))
      (if (map? form)
        (let [entries
              (p15-s23-compile-map-entries
               emitter module locals (p15-s23-canonical-map-entries form) [])]
          (if (p15-s23-compiler-complete? entries)
            (p15-s23-compiler-result
             (hash-map :op (get (get collection-rules :map) :op)
                       :entries (get entries :value)))
            entries))
        (if (set? form)
          (let [items
                (p15-s23-compile-forms
                 emitter module locals (p15-s23-canonical-set-items form) [])]
            (if (p15-s23-compiler-complete? items)
              (p15-s23-compiler-result
               (hash-map :op (get (get collection-rules :set) :op)
                         :items (get items :value)))
              items))
          (p15-s23-compiler-result
           (hash-map :op (get (get collection-rules :literal) :op)
                     :value form)))))))

(defn p15-s23-compile-let-bindings
  [emitter module scope bindings compiled]
  (if (= 0 (count bindings))
    (p15-s23-compiler-result
     (hash-map :scope scope :bindings compiled))
    (if (> (count bindings) 128)
      (let [midpoint (* 2 (quot (count bindings) 4))
            left
            (p15-s23-compile-let-bindings
             emitter module scope (subvec bindings 0 midpoint) compiled)]
        (if (p15-s23-compiler-complete? left)
          (let [products (get left :value)]
            (p15-s23-compile-let-bindings
             emitter module (get products :scope)
             (subvec bindings midpoint (count bindings))
             (get products :bindings)))
          left))
      (let [name (first bindings)
            expression (second bindings)
            pair-index (count compiled)]
        (if (symbol? name)
          (let [compiled-expression
                (p15-s23-compile-expr
                 emitter
                 (p15-s23-child-module
                  module (vector 1 (+ 1 (* 2 pair-index))))
                 scope expression)]
            (if (p15-s23-compiler-complete? compiled-expression)
              (p15-s23-compile-let-bindings
               emitter module (conj scope name) (rest (rest bindings))
               (conj compiled
                     (hash-map :name name
                               :expr (get compiled-expression :value))))
              compiled-expression))
          (p15-s23-compiler-error
           "L2-LET-BINDING" (hash-map :binding name)))))))

(defn p15-s23-compile-let
  [emitter module locals bindings body]
  (if (if (vector? bindings) (even? (count bindings)) false)
    (let [compiled-bindings
          (p15-s23-compile-let-bindings emitter module locals bindings [])]
      (if (p15-s23-compiler-complete? compiled-bindings)
        (let [binding-value (get compiled-bindings :value)
              compiled-body
              (p15-s23-compile-forms
               emitter
               (assoc module :p15-s23-sh07-child-index-base 2)
               (get binding-value :scope) body [])]
          (if (p15-s23-compiler-complete? compiled-body)
            (p15-s23-compiler-result
             (hash-map
              :op (get (get (get emitter :special-form-rules) (quote let)) :op)
              :bindings (get binding-value :bindings)
              :body (get compiled-body :value)))
            compiled-body))
        compiled-bindings))
    (p15-s23-compiler-error
     "L2-LET-BINDING" (hash-map :bindings bindings))))

(defn p15-s23-compile-loop
  [emitter module locals bindings body]
  (if (if (vector? bindings) (even? (count bindings)) false)
    (let [compiled-bindings
          (p15-s23-compile-let-bindings emitter module locals bindings [])]
      (if (p15-s23-compiler-complete? compiled-bindings)
        (let [binding-value (get compiled-bindings :value)
              compiled-body
              (p15-s23-compile-forms
               emitter
               (assoc module :p15-s23-sh07-child-index-base 2)
               (get binding-value :scope) body [])]
          (if (p15-s23-compiler-complete? compiled-body)
            (p15-s23-compiler-result
             (hash-map
              :op :loop
              :bindings (get binding-value :bindings)
              :binding-count (count (get binding-value :bindings))
              :body (get compiled-body :value)))
            compiled-body))
        compiled-bindings))
    (p15-s23-compiler-error
     "L2-UNKNOWN-CORE-FORM" (hash-map :operator (quote loop)))))

(defn p15-s23-nonnegative-path?
  [path]
  (if (vector? path)
    (loop [remaining path]
      (if (= 0 (count remaining))
        true
        (let [ordinal (first remaining)]
          (if (integer? ordinal)
            (if (<= 0 ordinal)
              (recur (rest remaining))
              false)
            false))))
    false))

(defn p15-s23-external-edge-shape?
  [edge ordinal]
  (if (map? edge)
    (if (= #{:ordinal :caller-module-source-id :caller-function
             :caller-function-source-hash :callsite-path
             :callee-module-source-id :callee-function
             :callee-function-source-hash :arity :owner-edge :authorization}
           (set (keys edge)))
      (if (= ordinal (get edge :ordinal))
        (if (p15-s23-nonnegative-path? (get edge :callsite-path))
          (if (integer? (get edge :arity))
            (if (<= 0 (get edge :arity))
              (if (= :authenticated-b51-namespace-external
                     (get edge :authorization))
                (if (contains? #{:producer-internal :root6-internal
                                 :root8-to-producer-interface}
                               (get edge :owner-edge))
                  true
                  false)
                false)
              false)
            false)
          false)
        false)
      false)
    false))

(defn p15-s23-external-binding-shape?
  [binding]
  (if (map? binding)
    (= #{:symbol :callee-module-ordinal :callee-module
         :callee-source-sha256 :callee-definition-source-hash
         :arity :owner-edge}
       (set (keys binding)))
    false))

(defn p15-s23-definition-row-shape?
  [definition]
  (if (map? definition)
    (= #{:name :arity :visibility :source-hash}
       (set (keys definition)))
    false))

(defn p15-s23-link-manifest-census-shape?
  [manifest]
  (if (map? manifest)
    (let [module-source-ids (get manifest :module-source-ids)
          edges (get manifest :edges)]
      (if (vector? module-source-ids)
        (if (= 7 (count module-source-ids))
          (if (= 7 (count (set module-source-ids)))
            (if (vector? edges)
              ;; Attempt30's governed source walk derives 1,480 authenticated
              ;; edges after its compact Root-1 cross-fragment boundaries. Edge
              ;; identity, owner, binding, caller, path, and ordinal checks
              ;; below remain the authority; this is their closed census.
              (= 1480 (count edges))
              false)
            false)
          false)
        false))
    false))

(defn p15-s23-module-descriptor-shape?
  [descriptor manifest]
  (if (map? descriptor)
    (if (= #{:artifact :schema-version :module-source-id :module-ordinal
             :module :logical-source-path :owner :source-byte-count
             :source-sha256 :profile :target :effects :capabilities :safety
             :definitions :exports :core-binding-count
             :lexical-binding-count :external-bindings
             :aggregate-binding-count :builtin-calls}
           (set (keys descriptor)))
      (if (= :gravity/sh07-b51-module-source-v1 (get descriptor :artifact))
        (if (= 1 (get descriptor :schema-version))
          (= (get descriptor :module-source-id)
             (get (get manifest :module-source-ids)
                  (get descriptor :module-ordinal)))
          false)
        false)
      false)
    false))

(defn p15-s23-descriptor-binding-census
  [bindings]
  (loop [remaining bindings symbols #{} valid true]
    (if (= 0 (count remaining))
      (hash-map :valid valid :symbols symbols)
      (let [binding (first remaining)
            symbol (get binding :symbol)
            unique (if (contains? symbols symbol) false true)]
        (recur
         (rest remaining) (conj symbols symbol)
         (if valid
           (if (p15-s23-external-binding-shape? binding) unique false)
           false))))))

(defn p15-s23-descriptor-definition-census
  [definitions]
  (loop [remaining definitions names #{} valid true]
    (if (= 0 (count remaining))
      (hash-map :valid valid :names names)
      (let [definition (first remaining)
            name (get definition :name)
            unique (if (contains? names name) false true)]
        (recur
         (rest remaining) (conj names name)
         (if valid
           (if (p15-s23-definition-row-shape? definition) unique false)
           false))))))

(defn p15-s23-edge-index-callee-census
  [index]
  (loop [remaining (vec (keys index)) callees #{}]
    (if (= 0 (count remaining))
      callees
      (let [edge (get index (first remaining))]
        (recur (rest remaining)
               (conj callees (get edge :callee-function)))))))

(defn p15-s23-edge-index-callers-defined?
  [index definition-names]
  (loop [remaining (vec (keys index))]
    (if (= 0 (count remaining))
      true
      (let [edge (get index (first remaining))]
        (if (contains? definition-names (get edge :caller-function))
          (recur (rest remaining))
          false)))))

(defn p15-s23-descriptor-tables-authentic?
  [descriptor index]
  (let [bindings
        (p15-s23-descriptor-binding-census
         (get descriptor :external-bindings))
        definitions
        (p15-s23-descriptor-definition-census
         (get descriptor :definitions))]
    (if (get bindings :valid)
      (if (get definitions :valid)
        (if (= (get bindings :symbols)
               (p15-s23-edge-index-callee-census index))
          (p15-s23-edge-index-callers-defined?
           index (get definitions :names))
          false)
        false)
      false)))

(defn p15-s23-build-external-edge-index
  [descriptor manifest]
  (if (p15-s23-link-manifest-census-shape? manifest)
    (if (p15-s23-module-descriptor-shape? descriptor manifest)
      (loop [remaining (get manifest :edges)
             ordinal 0 index (hash-map) seen #{}]
        (if (= 0 (count remaining))
          (if (p15-s23-descriptor-tables-authentic? descriptor index)
            (p15-s23-compiler-result index)
            (p15-s23-compiler-error
             "L2-UNKNOWN-CORE-FORM"
             (hash-map :reason :unauthenticated-b51-external-link)))
          (let [edge (first remaining)
                identity
                (vector (get edge :caller-module-source-id)
                        (get edge :caller-function)
                        (get edge :callsite-path))]
            (if (p15-s23-external-edge-shape? edge ordinal)
              (if (contains? seen identity)
                (p15-s23-compiler-error
                 "L2-UNKNOWN-CORE-FORM"
                 (hash-map :reason :unauthenticated-b51-external-link))
                (recur
                 (rest remaining) (+ ordinal 1)
                 (if (= (get descriptor :module-source-id)
                        (get edge :caller-module-source-id))
                   (assoc index
                          (vector (get edge :caller-function)
                                  (get edge :callsite-path))
                          edge)
                   index)
                 (conj seen identity)))
              (p15-s23-compiler-error
               "L2-UNKNOWN-CORE-FORM"
               (hash-map :reason :unauthenticated-b51-external-link))))))
      (p15-s23-compiler-error
       "L2-UNKNOWN-CORE-FORM"
       (hash-map :reason :unauthenticated-b51-external-link)))
    (p15-s23-compiler-error
     "L2-UNKNOWN-CORE-FORM"
     (hash-map :reason :unauthenticated-b51-external-link))))

(defn p15-s23-scan-external-edges
  [edges descriptor caller callee arity path]
  (loop [remaining edges ordinal 0 selected nil matches 0 valid true seen #{}]
    (if (= 0 (count remaining))
      (hash-map :valid valid :selected selected :matches matches)
      (let [edge (first remaining)
            row-valid (p15-s23-external-edge-shape? edge ordinal)
            identity
            (vector (get edge :caller-module-source-id)
                    (get edge :caller-function)
                    (get edge :callsite-path))
            unique (if (contains? seen identity) false true)
            match
            (if row-valid
              (if (= (get descriptor :module-source-id)
                     (get edge :caller-module-source-id))
                (if (= caller (get edge :caller-function))
                  (if (= callee (get edge :callee-function))
                    (if (= arity (get edge :arity))
                      (= path (get edge :callsite-path))
                      false)
                    false)
                  false)
                false)
              false)]
        (recur (rest remaining) (+ ordinal 1)
               (if match edge selected)
               (if match (+ matches 1) matches)
               (if valid (if row-valid unique false) false)
               (conj seen identity))))))

(defn p15-s23-scan-external-bindings
  [bindings edge callee]
  (loop [remaining bindings selected nil matches 0 valid true seen #{}]
    (if (= 0 (count remaining))
      (hash-map :valid valid :selected selected :matches matches)
      (let [binding (first remaining)
            row-valid (p15-s23-external-binding-shape? binding)
            unique (if (contains? seen (get binding :symbol)) false true)
            match
            (if row-valid
              (if (= callee (get binding :symbol))
                (if (= (get edge :callee-function-source-hash)
                       (get binding :callee-definition-source-hash))
                  (if (= (get edge :arity) (get binding :arity))
                    (= (get edge :owner-edge) (get binding :owner-edge))
                    false)
                  false)
                false)
              false)]
        (recur (rest remaining)
               (if match binding selected)
               (if match (+ matches 1) matches)
               (if valid (if row-valid unique false) false)
               (conj seen (get binding :symbol)))))))

(defn p15-s23-scan-definition-rows
  [definitions caller source-hash]
  (loop [remaining definitions selected nil matches 0 valid true seen #{}]
    (if (= 0 (count remaining))
      (hash-map :valid valid :selected selected :matches matches)
      (let [definition (first remaining)
            row-valid (p15-s23-definition-row-shape? definition)
            unique (if (contains? seen (get definition :name)) false true)
            match
            (if row-valid
              (if (= caller (get definition :name))
                (= source-hash (get definition :source-hash))
                false)
              false)]
        (recur (rest remaining)
               (if match definition selected)
               (if match (+ matches 1) matches)
               (if valid (if row-valid unique false) false)
               (conj seen (get definition :name)))))))

(defn p15-s23-selected-edge-authentic?
  [edge descriptor caller callee arity path]
  (if (map? edge)
    (if (= (get descriptor :module-source-id)
           (get edge :caller-module-source-id))
      (if (= caller (get edge :caller-function))
        (if (= callee (get edge :callee-function))
          (if (= arity (get edge :arity))
            (if (= path (get edge :callsite-path))
              (if (= :r1-producer (get descriptor :owner))
                (= :producer-internal (get edge :owner-edge))
                (if (= :r6-independent-verifier (get descriptor :owner))
                  (= :root6-internal (get edge :owner-edge))
                  (if (= :r8-finalizer (get descriptor :owner))
                    (= :root8-to-producer-interface (get edge :owner-edge))
                    false)))
              false)
            false)
          false)
        false)
      false)
    false))

(defn p15-s23-external-call-descriptor
  [module caller callee arity path]
  (let [descriptor (get module :p15-s23-sh07-module-source-descriptor)
        manifest (get module :p15-s23-sh07-link-manifest)
        edge-index (get module :p15-s23-sh07-external-edge-index)
        indexed-edge (if (map? edge-index)
                       (get edge-index (vector caller path)) nil)
        edge-scan
        (if (map? edge-index)
          (hash-map :valid true :selected indexed-edge
                    :matches (if (= nil indexed-edge) 0 1))
          (p15-s23-scan-external-edges
           (get manifest :edges) descriptor caller callee arity path))
        edge (get edge-scan :selected)]
    (if (p15-s23-module-descriptor-shape? descriptor manifest)
      (if (= #{:artifact :schema-version :manifest-id
               :module-source-ids :edges}
             (set (keys manifest)))
        (if (= :gravity/sh07-b51-link-manifest-v1 (get manifest :artifact))
          (if (= 1 (get manifest :schema-version))
            (if (p15-s23-link-manifest-census-shape? manifest)
              (if (get edge-scan :valid)
                (if (= 1 (get edge-scan :matches))
                  (if (p15-s23-selected-edge-authentic?
                       edge descriptor caller callee arity path)
                    (let [binding-scan
                          (p15-s23-scan-external-bindings
                           (get descriptor :external-bindings) edge callee)
                          definition-scan
                          (p15-s23-scan-definition-rows
                           (get descriptor :definitions) caller
                           (get edge :caller-function-source-hash))]
                      (if (get binding-scan :valid)
                        (if (= 1 (get binding-scan :matches))
                          (if (get definition-scan :valid)
                            (if (= 1 (get definition-scan :matches))
                              (hash-map
                               :artifact :gravity/sh07-b51-external-call-v1
                               :manifest-id (get manifest :manifest-id)
                               :edge-ordinal (get edge :ordinal))
                              nil)
                            nil)
                          nil)
                        nil))
                    nil)
                  nil)
                nil)
              nil)
            nil)
          nil)
        nil)
      nil)))

(defn p15-s23-internal-builtin-arity
  [callee]
  (if (= callee (quote sh07-canonical-text-compare))
    2
    (if (= callee (quote sh07-declared-digest-hash))
      1
      (if (= callee (quote sh07-observe-utf8-byte-count))
        3
        (if (= callee
               (quote sh07-b51-admitted-executable-carrier-validation?))
          1
          nil)))))

(defn p15-s23-internal-builtin-caller-governed?
  [callee caller]
  (if (= callee (quote sh07-canonical-text-compare))
    (contains? (quote #{sh07-b51-producer-insert-decoration
                        sh07-b51-r6-decoration-insert})
               caller)
    (if (= callee (quote sh07-observe-utf8-byte-count))
      (contains? (quote #{sh07-b51-producer-observe-decoration-bytes
                          sh07-b51-r6-observe-scalar-bytes})
                 caller)
      (if (= callee (quote sh07-declared-digest-hash))
        (contains?
         (quote #{sh07-b51-success-digest-replay-exact?
           sh07-b51-finalize-rejection
           sh07-b51-producer-decimal-admission
           sh07-b51-producer-decimal-projection-authentic?
           sh07-b51-r6-replay-digests
           sh07-b51-r6-decimal-projection-authentic?
           sh07-b51-r6-predecessor-closure-authentic?
           sh07-b51-r6-projection-binding
           sh07-b51-r6-projected-form-id
           sh07-b51-r6-projected-syntax-id
           sh07-b51-r6-project-decimal
           sh07-b51-r6-projected-macro-traces
           sh07-b51-r6-project-lineage
           sh07-b51-r6-replay-consume-scope
           sh07-b51-r6-replay-reference
           sh07-b51-r6-project-forms
           sh07-b51-r6-project-definition-syntax-id
           sh07-b51-r6-project-scope-catalog
           sh07-b51-r6-project-bindings
           sh07-b51-r6-v18-executable-authentic?})
        caller)
        (if (= callee
               (quote sh07-b51-admitted-executable-carrier-validation?))
          (contains?
           (quote #{sh07-b51-root1-admitted-raw-carrier-shape?
                    sh07-b51-r6-c30-request-proof?})
           caller)
          false)))))

(defn p15-s23-builtin-call-row-shape?
  [row]
  (if (map? row)
    (= #{:caller :caller-function-source-hash :builtin :arity
         :compiler-internal?}
       (set (keys row)))
    false))

(defn p15-s23-scan-internal-builtin-rows
  [rows caller callee arity function-source-hash]
  (if (vector? rows)
    (loop [remaining rows matches 0 valid true]
      (if (= 0 (count remaining))
        (hash-map :valid valid :matches matches)
        (let [row (first remaining)
              shape (p15-s23-builtin-call-row-shape? row)
              same-call
              (if shape
                (if (= caller (get row :caller))
                  (= callee (get row :builtin))
                  false)
                false)
              authentic
              (if same-call
                (if (= arity (get row :arity))
                  (if (= function-source-hash
                         (get row :caller-function-source-hash))
                    (= true (get row :compiler-internal?))
                    false)
                  false)
                true)]
          (recur (rest remaining)
                 (if same-call (+ matches 1) matches)
                 (if valid (if shape authentic false) false)))))
    (hash-map :valid false :matches 0)))

(defn p15-s23-internal-call-occurrence-count
  [definition callee]
  (loop [pending (vector (get definition :body))
         observed 0
         matches 0]
    (if (> observed 8388608)
      -1
      (if (= 0 (count pending))
        matches
        (let [value (first pending)
              quoted
              (if (seq? value)
                (= (quote quote) (first value))
                false)
              children
              (if quoted
                []
                (if (map? value)
                  (loop [entries (p15-s23-canonical-map-entries value)
                         result []]
                    (if (= 0 (count entries))
                      result
                      (let [entry (first entries)]
                        (recur (rest entries)
                               (conj (conj result (first entry))
                                     (second entry))))))
                  (if (set? value)
                    (p15-s23-canonical-set-items value)
                    (if (if (vector? value) true (seq? value))
                      (vec value)
                      []))))
              matched
              (if (seq? value)
                (if (= callee (first value)) 1 0)
                0)]
          (recur (p15-s23-path-append (vec (rest pending)) children)
                 (+ observed 1)
                 (+ matches matched)))))))

(defn p15-s23-value-at-callsite-path
  [definition path]
  (loop [value (get definition :body) remaining path]
    (if (= 0 (count remaining))
      value
      (let [ordinal (first remaining)
            children
            (if (map? value)
              (p15-s23-canonical-map-entries value)
              (if (set? value)
                (p15-s23-canonical-set-items value)
                (if (if (vector? value) true (seq? value))
                  (vec value)
                  [])))]
        (if (integer? ordinal)
          (if (<= 0 ordinal)
            (if (< ordinal (count children))
              (recur (get children ordinal) (rest remaining))
              nil)
            nil)
          nil)))))

(defn p15-s23-internal-callsite-authentic?
  [definition path callee arity]
  (let [value (p15-s23-value-at-callsite-path definition path)]
    (if (seq? value)
      (if (= callee (first value))
        (= arity (- (count value) 1))
        false)
      false)))

(defn p15-s23-internal-call-provenance
  [module caller callee arity path]
  (let [descriptor (get module :p15-s23-sh07-module-source-descriptor)
        manifest (get module :p15-s23-sh07-link-manifest)
        authority (get module :p15-s23-sh07-source-authority)
        definition (get module :p15-s23-sh07-enclosing-definition)
        function-source-hash
        (get (get authority :function-source-hashes) caller)
        definition-scan
        (p15-s23-scan-definition-rows
         (get descriptor :definitions) caller function-source-hash)
        builtin-scan
        (p15-s23-scan-internal-builtin-rows
         (get descriptor :builtin-calls) caller callee arity
         function-source-hash)
        source-occurrences
        (p15-s23-internal-call-occurrence-count definition callee)]
    (if (= #{:artifact :manifest-id :module-source-id :source-sha256
             :function-source-hashes :module :logical-source-path}
           (set (keys authority)))
      (if (= :gravity/sh07-compiler-source-authority-v2
             (get authority :artifact))
        (if (p15-s23-module-descriptor-shape? descriptor manifest)
          (if (= (get manifest :manifest-id) (get authority :manifest-id))
            (if (= (get descriptor :module-source-id)
                   (get authority :module-source-id))
              (if (= (get descriptor :source-sha256)
                     (get authority :source-sha256))
                (if (= (get descriptor :module) (get authority :module))
                  (if (= (get descriptor :logical-source-path)
                         (get authority :logical-source-path))
                    (if (p15-s23-internal-builtin-caller-governed?
                         callee caller)
                      (if (p15-s23-internal-callsite-authentic?
                           definition path callee arity)
                        (if (get definition-scan :valid)
                          (if (= 1 (get definition-scan :matches))
                            (if (get builtin-scan :valid)
                              (if (= source-occurrences
                                     (get builtin-scan :matches))
                                (if (< 0 source-occurrences)
                                (hash-map
                                 :artifact
                                 :gravity/sh07-compiler-internal-call-provenance-v2
                                 :manifest-id (get manifest :manifest-id)
                                 :module-source-id
                                 (get descriptor :module-source-id)
                                 :source-sha256 (get descriptor :source-sha256)
                                 :function caller
                                 :function-source-hash function-source-hash
                                 :callee callee)
                                nil)
                                nil)
                              nil)
                            nil)
                          nil)
                        nil)
                      nil)
                    nil)
                  nil)
                nil)
              nil)
            nil)
          nil)
        nil)
      nil)))

(defn p15-s23-compile-internal-builtin-call
  [emitter module locals callee arguments expected-arity]
  (if (= expected-arity (count arguments))
    (let [caller (get module :p15-s23-sh07-enclosing-function)
          provenance
          (p15-s23-internal-call-provenance
           module caller callee expected-arity
           (get module :p15-s23-sh07-callsite-path []))]
      (if (= nil provenance)
        (p15-s23-compiler-error
         "L2-UNKNOWN-CORE-FORM"
         (hash-map :operator callee
                   :reason :unauthenticated-compiler-provenance))
        (let [args
              (p15-s23-compile-forms
               emitter (assoc module :p15-s23-sh07-child-index-base 1)
               locals arguments [])]
          (if (p15-s23-compiler-complete? args)
            (p15-s23-compiler-result
             (hash-map
              :op (get (get emitter :call-rules) :builtin-op)
              :function callee
              :compiler-internal-caller caller
              :compiler-internal-provenance provenance
              :args (get args :value)))
            args))))
    (p15-s23-compiler-error
     "L2-BUILTIN-ARITY"
     (hash-map :function callee
               :expected-arity expected-arity
               :actual-arity (count arguments)))))

(defn p15-s23-compile-call
  [emitter module locals form]
  (let [callee (first form)
        arguments (rest form)
        special-rules (get emitter :special-form-rules)
        special-rule (get special-rules callee)
        call-rules (get emitter :call-rules)
        builtin-functions (set (get call-rules :builtin-functions))
        internal-arity (p15-s23-internal-builtin-arity callee)]
    (if (= callee (quote throw))
      (if (= 1 (count arguments))
        (let [value (p15-s23-compile-expr
                     emitter (p15-s23-child-module module [1])
                     locals (first arguments))]
          (if (p15-s23-compiler-complete? value)
            (p15-s23-compiler-result
             (hash-map :op :throw :value (get value :value)))
            value))
        (p15-s23-compiler-error
         "L2-UNKNOWN-CORE-FORM"
         (hash-map :operator (quote throw) :reason :throw-arity
                   :expected-arity 1 :actual-arity (count arguments))))
    (if (= callee (quote println))
      (let [args
            (p15-s23-compile-forms
             emitter (assoc module :p15-s23-sh07-child-index-base 1)
             locals arguments [])]
        (if (p15-s23-compiler-complete? args)
          (p15-s23-compiler-result
           (hash-map :op (get special-rule :op)
                     :effect (get special-rule :effect)
                     :capability (get special-rule :capability)
                     :args (get args :value)))
          args))
      (if (= callee (quote do))
        (let [body
              (p15-s23-compile-forms
               emitter (assoc module :p15-s23-sh07-child-index-base 1)
               locals arguments [])]
          (if (p15-s23-compiler-complete? body)
            (p15-s23-compiler-result
             (hash-map :op (get special-rule :op)
                       :body (get body :value)))
            body))
        (if (= callee (quote if))
          (if (= 4 (count form))
            (let [test-result
                  (p15-s23-compile-expr
                   emitter (p15-s23-child-module module [1])
                   locals (second form))]
              (if (p15-s23-compiler-complete? test-result)
                (let [then-result
                      (p15-s23-compile-expr
                       emitter (p15-s23-child-module module [2])
                       locals (first (rest (rest form))))]
                  (if (p15-s23-compiler-complete? then-result)
                    (let [else-result
                          (p15-s23-compile-expr
                           emitter (p15-s23-child-module module [3])
                           locals (first (rest (rest (rest form)))))]
                      (if (p15-s23-compiler-complete? else-result)
                        (p15-s23-compiler-result
                         (hash-map :op (get special-rule :op)
                                   :test (get test-result :value)
                                   :then (get then-result :value)
                                   :else (get else-result :value)))
                        else-result))
                    then-result))
                test-result))
            (p15-s23-compiler-error
             "L2-UNKNOWN-CORE-FORM"
             (hash-map :operator (quote if)
                       :expected-arity 3
                       :actual-arity (- (count form) 1))))
          (if (= callee (quote let))
            (p15-s23-compile-let
             emitter module locals (second form) (rest (rest form)))
            (if (= callee (quote loop))
              (p15-s23-compile-loop
               emitter module locals (second form) (rest (rest form)))
              (if (= callee (quote recur))
                (let [args
                      (p15-s23-compile-forms
                       emitter
                       (assoc module :p15-s23-sh07-child-index-base 1)
                       locals arguments [])]
                  (if (p15-s23-compiler-complete? args)
                    (p15-s23-compiler-result
                     (hash-map :op :recur :args (get args :value)))
                    args))
                (if (= callee (quote quote))
                  (p15-s23-compiler-result
                   (hash-map :op (get special-rule :op) :value (second form)))
                  (if (= callee (quote host-reflect))
                (p15-s23-compiler-error
                 (get special-rule :diagnostic)
                 (hash-map :operator callee))
                (if (integer? internal-arity)
                  (p15-s23-compile-internal-builtin-call
                   emitter module locals callee arguments internal-arity)
                  (if (contains? builtin-functions callee)
                  (let [args
                        (p15-s23-compile-forms
                         emitter
                         (assoc module :p15-s23-sh07-child-index-base 1)
                         locals arguments [])]
                    (if (p15-s23-compiler-complete? args)
                      (p15-s23-compiler-result
                       (hash-map :op (get call-rules :builtin-op)
                                 :function callee
                                 :args (get args :value)))
                      args))
                  (if (contains? (get module :function-table) callee)
                    (let [args
                          (p15-s23-compile-forms
                           emitter
                           (assoc module :p15-s23-sh07-child-index-base 1)
                           locals arguments [])]
                      (if (p15-s23-compiler-complete? args)
                        (p15-s23-compiler-result
                         (hash-map :op (get call-rules :function-op)
                                   :function callee
                                   :args (get args :value)))
                        args))
                    (let [external-link
                          (p15-s23-external-call-descriptor
                           module
                           (get module :p15-s23-sh07-enclosing-function)
                           callee (count arguments)
                           (get module :p15-s23-sh07-callsite-path []))]
                      (if (= nil external-link)
                        (p15-s23-compiler-error
                         (get call-rules :unknown-callee-diagnostic)
                         (hash-map :operator callee
                                   :reason :unauthenticated-b51-external-link))
                        (let [args
                              (p15-s23-compile-forms
                               emitter
                               (assoc module
                                      :p15-s23-sh07-child-index-base 1)
                               locals arguments [])]
                          (if (p15-s23-compiler-complete? args)
                            (p15-s23-compiler-result
                             (hash-map
                              :op (get call-rules :function-op)
                              :function callee
                              :args (get args :value)
                              :external-link external-link))
                            args))))))))))))))))))

(defn p15-s23-compile-expr
  [emitter module locals form]
  (if (symbol? form)
    (if (contains? locals form)
      (p15-s23-compiler-result (hash-map :op :local :name form))
      (p15-s23-compiler-error
       "L2-UNKNOWN-SYMBOL" (hash-map :symbol form)))
    (if (seq? form)
      (p15-s23-compile-call emitter module locals form)
      (if (if (vector? form) true (if (map? form) true (set? form)))
        (p15-s23-compile-collection emitter module locals form)
        (p15-s23-compiler-result
         (hash-map
          :op (get (get (get emitter :collection-rules) :literal) :op)
          :value form))))))

(defn p15-s23-compile-function
  [emitter module definition]
  (let [name (get definition :name)
        params (get definition :params)
        body (get definition :body)
        compile-module
        (assoc
         (assoc
          (assoc module :p15-s23-sh07-enclosing-function name)
          :p15-s23-sh07-enclosing-definition definition)
         :p15-s23-sh07-callsite-path [])
        compiled-body
        (p15-s23-compile-forms
         emitter (assoc compile-module :p15-s23-sh07-child-index-base 0)
         (set params) body [])]
    (if (p15-s23-compiler-complete? compiled-body)
      (let [exports (get module :exports)
            visibility
            (if (> (count exports) 0)
              (if (contains? (set exports) name) :public :private)
              :stage2-local)
            binding
            (hash-map :name name
                      :kind :function
                      :namespace (get module :module)
                      :profile (get module :profile)
                      :target (get module :target)
                      :visibility visibility
                      :effects (get module :effects)
                      :capabilities (get module :capabilities))]
        (p15-s23-compiler-result
         (assoc definition
                :binding binding
                :instructions (get compiled-body :value))))
      compiled-body)))

; Plan assembly is deliberately part of the same Gravity-authored compiler
; artifact as expression lowering.  The host supplies an ordered vector of
; analyzed function definitions and retains only prerequisite validation,
; execution of this closed function plan, and cryptographic sealing.
(defn p15-s23-summary-instructions
  [instructions summary]
  (if (= 0 (count instructions))
    (p15-s23-compiler-result summary)
    (if (> (count instructions) 64)
      (let [midpoint (quot (count instructions) 2)
            left
            (p15-s23-summary-instructions
             (subvec instructions 0 midpoint) summary)]
        (if (p15-s23-compiler-complete? left)
          (p15-s23-summary-instructions
           (subvec instructions midpoint (count instructions))
           (get left :value))
          left))
      (let [next-summary
            (p15-s23-summary-instruction (first instructions) summary)]
        (if (p15-s23-compiler-complete? next-summary)
          (p15-s23-summary-instructions
           (rest instructions) (get next-summary :value))
          next-summary)))))

(defn p15-s23-summary-map-entries
  [entries summary]
  (if (= 0 (count entries))
    (p15-s23-compiler-result summary)
    (if (> (count entries) 64)
      (let [midpoint (quot (count entries) 2)
            left
            (p15-s23-summary-map-entries
             (subvec entries 0 midpoint) summary)]
        (if (p15-s23-compiler-complete? left)
          (p15-s23-summary-map-entries
           (subvec entries midpoint (count entries)) (get left :value))
          left))
      (let [entry (first entries)
            key-summary
            (p15-s23-summary-instruction (get entry :key) summary)]
        (if (p15-s23-compiler-complete? key-summary)
          (let [value-summary
                (p15-s23-summary-instruction
                 (get entry :value) (get key-summary :value))]
            (if (p15-s23-compiler-complete? value-summary)
              (p15-s23-summary-map-entries
               (rest entries) (get value-summary :value))
              value-summary))
          key-summary)))))

(defn p15-s23-summary-let-bindings
  [bindings summary]
  (if (= 0 (count bindings))
    (p15-s23-compiler-result summary)
    (if (> (count bindings) 64)
      (let [midpoint (quot (count bindings) 2)
            left
            (p15-s23-summary-let-bindings
             (subvec bindings 0 midpoint) summary)]
        (if (p15-s23-compiler-complete? left)
          (p15-s23-summary-let-bindings
           (subvec bindings midpoint (count bindings)) (get left :value))
          left))
      (let [binding-summary
            (p15-s23-summary-instruction
             (get (first bindings) :expr) summary)]
        (if (p15-s23-compiler-complete? binding-summary)
          (p15-s23-summary-let-bindings
           (rest bindings) (get binding-summary :value))
          binding-summary)))))

(defn p15-s23-summary-instruction
  [instruction summary]
  (let [op (get instruction :op)
        counted (assoc summary op (+ 1 (get summary op 0)))]
    (if (= op :structural-match)
      (let [test (p15-s23-summary-instruction (get instruction :scrutinee) counted)]
        (if (p15-s23-compiler-complete? test)
          (loop [remaining (get instruction :clauses) out (get test :value)]
            (if (= 0 (count remaining)) (p15-s23-compiler-result out)
              (let [guard (if (contains? (first remaining) :guard)
                            (p15-s23-summary-instruction (get (first remaining) :guard) out) (p15-s23-compiler-result out))
                    body (if (p15-s23-compiler-complete? guard)
                           (p15-s23-summary-instruction (get (first remaining) :body) (get guard :value)) guard)]
                (if (p15-s23-compiler-complete? body) (recur (rest remaining) (get body :value)) body)))) test))
    (if (= op :try)
      (let [protected (p15-s23-summary-instruction (get instruction :protected) counted)]
        (if (p15-s23-compiler-complete? protected)
          (loop [remaining (get instruction :handlers) out (get protected :value)]
            (if (= 0 (count remaining)) (p15-s23-compiler-result out)
              (let [body (p15-s23-summary-instruction (get (first remaining) :body) out)]
                (if (p15-s23-compiler-complete? body) (recur (rest remaining) (get body :value)) body)))) protected))
    (if (= op :throw)
      (p15-s23-summary-instruction (get instruction :value) counted)
    (if (= op :println)
      (p15-s23-summary-instructions (get instruction :args) counted)
      (if (= op :do)
        (p15-s23-summary-instructions (get instruction :body) counted)
        (if (= op :if)
          (let [test-summary
                (p15-s23-summary-instruction
                 (get instruction :test) counted)]
            (if (p15-s23-compiler-complete? test-summary)
              (let [then-summary
                    (p15-s23-summary-instruction
                     (get instruction :then) (get test-summary :value))]
                (if (p15-s23-compiler-complete? then-summary)
                  (p15-s23-summary-instruction
                   (get instruction :else) (get then-summary :value))
                  then-summary))
              test-summary))
          (if (contains? #{:let :loop} op)
            (let [binding-summary
                  (p15-s23-summary-let-bindings
                   (get instruction :bindings) counted)]
              (if (p15-s23-compiler-complete? binding-summary)
                (p15-s23-summary-instructions
                 (get instruction :body) (get binding-summary :value))
                binding-summary))
            (if (= op :recur)
              (p15-s23-summary-instructions (get instruction :args) counted)
              (if (contains? #{:builtin-call :keyword-map-lookup} op)
                (p15-s23-summary-instructions (get instruction :args) counted)
                (if (= op :function-call)
                  (p15-s23-summary-instructions (get instruction :args) counted)
                  (if (= op :vector-literal)
                    (p15-s23-summary-instructions
                     (get instruction :items) counted)
                    (if (= op :set-literal)
                      (p15-s23-summary-instructions
                       (get instruction :items) counted)
                      (if (= op :map-literal)
                        (p15-s23-summary-map-entries
                         (get instruction :entries) counted)
                        (p15-s23-compiler-result counted))))))))))))))))

(defn p15-s23-assemble-functions
  [emitter module definitions functions bindings summary]
  (if (= 0 (count definitions))
    (p15-s23-compiler-result
     (hash-map :functions functions
               :binding-table bindings
               :instruction-summary summary))
    ; Bound the generic seed runner's call depth without moving assembly
    ; semantics back into the host.  Large ordered tables are divided inside
    ; the Gravity artifact; each leaf retains the same sequential products.
    (if (> (count definitions) 64)
      (let [midpoint (quot (count definitions) 2)
            left
            (p15-s23-assemble-functions
             emitter module (subvec definitions 0 midpoint)
             functions bindings summary)]
        (if (p15-s23-compiler-complete? left)
          (let [products (get left :value)]
            (p15-s23-assemble-functions
             emitter module
             (subvec definitions midpoint (count definitions))
             (get products :functions)
             (get products :binding-table)
             (get products :instruction-summary)))
          left))
      (let [entry (first definitions)
            name (first entry)
            compiled-function
            (p15-s23-compile-function emitter module (second entry))]
        (if (p15-s23-compiler-complete? compiled-function)
          (let [function (get compiled-function :value)
                function-summary
                (p15-s23-summary-instructions
                 (get function :instructions) summary)]
            (if (p15-s23-compiler-complete? function-summary)
              (p15-s23-assemble-functions
               emitter module (rest definitions)
               (assoc functions name function)
               (conj bindings
                     (assoc (get function :binding)
                            :arity (get function :arity)))
               (get function-summary :value))
              function-summary))
          compiled-function)))))

(defn p15-s23-complete-plan-products
  [module products entrypoint]
  (p15-s23-compiler-result
   (assoc products
          :entrypoint entrypoint
          :effect-summary
          (if (> (get (get products :instruction-summary) :throw 0) 0)
            (hash-map
             :declared (get module :effects)
             :inferred :pending-gravity-emitter-effect-inference
             :legality :not-checked :authority :non-authoritative
             :source-operation-occurrences
             (hash-map :throw (get (get products :instruction-summary) :throw))
             :capabilities (get module :capabilities))
          (hash-map
           :declared (get module :effects)
           :inferred
           (if (> (get (get products :instruction-summary) :println 0) 0)
             #{:io/write}
             #{})
           :capabilities (get module :capabilities))))))

(defn p15-s23-assemble-plan-products
  [emitter module definitions]
  (let [descriptor (get module :p15-s23-sh07-module-source-descriptor)
        external-index
        (if (= nil descriptor)
          (p15-s23-compiler-result (hash-map))
          (p15-s23-build-external-edge-index
           descriptor (get module :p15-s23-sh07-link-manifest)))]
    (if (p15-s23-compiler-complete? external-index)
      (let [compile-module
            (if (= nil descriptor)
              module
              (assoc module :p15-s23-sh07-external-edge-index
                     (get external-index :value)))
            assembled
            (p15-s23-assemble-functions
             emitter compile-module definitions (hash-map) [] (hash-map))]
        (if (p15-s23-compiler-complete? assembled)
          (let [products (get assembled :value)
            entrypoint (get (get emitter :plan-shape) :entrypoint)
            main-function (get (get products :functions) entrypoint)]
            (if (= nil main-function)
              (if (= nil descriptor)
                (p15-s23-compiler-error
                 "L3-UNKNOWN-ALIAS" (hash-map :entrypoint entrypoint))
                (p15-s23-complete-plan-products
                 compile-module products nil))
              (if (> (count (get main-function :params)) 0)
            (p15-s23-compiler-error
             "L2-MAIN-ARITY"
             (hash-map :params (get main-function :params)))
                (p15-s23-complete-plan-products
                 compile-module products entrypoint))))
          assembled))
      external-index)))

; Explicit typed lowering consumes ordinary verified pass DATA. The temporary
; Clojure orchestration invokes current Gravity C7 once and supplies its actual
; fresh report separately. Raw kernel arguments are not authority tokens.
(defn p15-s23-typed-path [value fields]
  (loop [remaining fields result value]
    (if (= 0 (count remaining)) result
      (recur (rest remaining) (get result (first remaining))))))

(defn p15-s23-typed-error [reason]
  (p15-s23-compiler-error "P15S23Q002" {:missing-fact :explicit-typed-lowering-input :reason reason}))

(defn p15-s23-typed-node-error [reason node]
  (let [source (get node :source)
        facts {:missing-fact :explicit-typed-lowering-input :reason reason :core-node-id (get node :node-id)
               :syntax-id (get source :syntax-id) :origin-chain (get source :origin-chain)
               :generated-origin (get source :generated-origin) :binding-context (get node :binding-context)}]
    (p15-s23-compiler-error "P15S23Q002"
      (if (map? (get source :semantic-span)) (assoc facts :source-span (get source :semantic-span)) facts))))

(defn p15-s23-typed-index [records field]
  (if (vector? records)
    (loop [remaining records out {}]
      (if (= 0 (count remaining)) out
        (let [record (first remaining) id (get record field)]
          (if (if (map? record) (if (= id nil) false (= false (contains? out id))) false)
            (recur (rest remaining) (assoc out id record)) nil)))) nil))

(defn p15-s23-typed-all [checks]
  (loop [remaining checks]
    (if (= 0 (count remaining)) true
      (if (= true (first remaining)) (recur (rest remaining)) false))))

(defn p15-s23-typed-project [value fields]
  (loop [remaining fields out {}]
    (if (= 0 (count remaining)) out
      (recur (rest remaining) (assoc out (first remaining) (get value (first remaining)))))))

(defn p15-s23-typed-set [values]
  (if (= values nil) #{}
    (if (if (set? values) true (vector? values))
      (if (<= (count values) 65536) (set values) nil) nil)))

(defn p15-s23-typed-atomic-id [name]
  (get '{I8 :gravity.type/i8 I16 :gravity.type/i16 I32 :gravity.type/i32 I64 :gravity.type/i64
         U8 :gravity.type/u8 U16 :gravity.type/u16 U32 :gravity.type/u32 U64 :gravity.type/u64
         F32 :gravity.type/f32 F64 :gravity.type/f64 Bool :gravity.type/bool
         String :gravity.type/string Symbol :gravity.type/symbol Keyword :gravity.type/keyword Ratio :gravity.type/ratio} name))

(defn p15-s23-hl-declaration? [declaration bindings]
  (if (map? declaration)
    (let [constructor (get bindings (get declaration :type-binding-id))
          member (get bindings (get declaration :element-binding-id))]
      (p15-s23-typed-all
        [(= #{:rule-version :source-child-index :marker-form-id :marker-syntax-id :type-form-id :type-syntax-id
               :type-symbol :type-binding-id :type-id :constructor-form-id :constructor-syntax-id
               :element-form-id :element-syntax-id :element-symbol :element-binding-id} (set (keys declaration)))
         (= :sh07-list-parameter-declaration-v1 (get declaration :rule-version))
         (= ['List :core :type 'gravity.core] [(get constructor :name) (get constructor :binding-class)
                                             (get constructor :kind) (get constructor :namespace)])
         (= [:core :type 'gravity.core] [(get member :binding-class) (get member :kind) (get member :namespace)])
         (= ['List (get member :name)] [(get declaration :type-symbol) (get declaration :element-symbol)])
         (p15-s23-hl-type? (get declaration :type-id))
         (= (get (get declaration :type-id) :element-type) (p15-s23-typed-atomic-id (get member :name)))
         (if (integer? (get declaration :source-child-index)) (>= (get declaration :source-child-index) 0) false)
         (loop [ids [(get declaration :marker-form-id) (get declaration :marker-syntax-id)
           (get declaration :type-form-id) (get declaration :type-syntax-id) (get declaration :type-binding-id)
           (get declaration :constructor-form-id) (get declaration :constructor-syntax-id)
           (get declaration :element-form-id) (get declaration :element-syntax-id) (get declaration :element-binding-id)]]
           (if (= 0 (count ids)) true (if (string? (first ids)) (recur (rest ids)) false)))])) false))

(defn p15-s23-typed-declaration? [declaration type context]
  (if (= declaration nil) true
    (let [binding (get (get context :bindings) (get declaration :type-binding-id))
          form (get (get context :forms) (get declaration :type-form-id))]
      (p15-s23-typed-all [(= [:core :type 'gravity.core] [(get binding :binding-class) (get binding :kind) (get binding :namespace)])
                         (= type (get declaration :type-id)
                            (if (= 'Map (get binding :name)) :gravity.type/map
                              (if (= 'List (get binding :name)) :gravity.type/list (p15-s23-typed-atomic-id (get binding :name)))))
                         (= (get binding :name) (get declaration :type-symbol))
                         (if (= (get binding :name) (get form :value)) true
                           (if (symbol? (get form :value))
                             (= (str (get binding :namespace) "/" (get binding :name))
                                (str (get form :value))) false))
                         (= (get form :syntax-id) (get declaration :type-syntax-id))]))))

(defn p15-s23-typed-parameter-declaration? [declaration type context]
  (if (= :sh07-list-parameter-declaration-v1 (get declaration :rule-version))
    (let [forms (get context :forms) bindings (get context :bindings)
          form (get forms (get declaration :type-form-id))
          constructor (get forms (get declaration :constructor-form-id))
          member (get forms (get declaration :element-form-id))]
      (p15-s23-typed-all
        [(p15-s23-hl-declaration? declaration bindings) (= type (get declaration :type-id))
         (= :list (get form :kind))
         (= [(get constructor :form-id) (get member :form-id)] (get form :child-form-ids))
         (= (get form :syntax-id) (get declaration :type-syntax-id))
         (= (get constructor :syntax-id) (get declaration :constructor-syntax-id))
         (= (get member :syntax-id) (get declaration :element-syntax-id))
         (= (get form :form-id) (get constructor :parent-form-id) (get member :parent-form-id))
         (contains? '#{List gravity.core/List} (get constructor :value))
         (if (= (get declaration :element-symbol) (get member :value)) true
           (= (str "gravity.core/" (get declaration :element-symbol)) (str (get member :value))))]))
    (p15-s23-typed-declaration? declaration type context)))

(defn p15-s23-typed-source-equal? [tokens text]
  (if (if (vector? tokens) (string? text) false)
    (loop [remaining tokens position 0]
      (if (= 0 (count remaining)) (= position (count text))
        (let [raw (get (first remaining) :raw)
              match? (if (string? raw)
                       (loop [index 0]
                         (if (= index (count raw)) true
                           (if (= (get raw index) (get text (+ position index)))
                             (recur (+ index 1)) false))) false)]
          (if match? (recur (rest remaining) (+ position (count raw))) false)))) false))

(defn p15-s23-typed-loop-row-index [rows]
  (loop [remaining rows out {}]
    (if (= 0 (count remaining)) out
      (let [row (first remaining) premise (get (get row :dependencies) :loop-premise) key [(get premise :kind) (get row :lhs)]]
        (if (= :sh08-loop-target-types-v1 (get row :producer-rule))
          (if (if (contains? #{:loop-slot-type :loop-recur-type} (get premise :kind)) (= false (contains? out key)) false)
            (recur (rest remaining) (assoc out key row)) nil) (recur (rest remaining) out))))))

(defn p15-s23-typed-raw-roots [raw roots core-roots nodes forms]
  ; C4/C6 preserve the same namespace-body root order. Source values remain
  ; separate from normalized C6 literal descriptors and never drive compilation.
  (if (= (count raw) (count roots) (count core-roots))
    (let [root-set (set roots)
          parent-roots (loop [ids (keys forms) out #{}]
                         (if (= 0 (count ids)) out
                           (recur (rest ids) (if (= nil (get (get forms (first ids)) :parent-form-id))
                                              (conj out (first ids)) out))))]
      (if (if (= (count roots) (count root-set)) (= root-set parent-roots) false)
        (loop [remaining roots node-ids core-roots values raw out {}]
          (if (= 0 (count remaining)) out
            (let [id (first remaining) form (get forms id) node (get nodes (first node-ids))]
              (if (p15-s23-typed-all [(map? form) (contains? form :parent-form-id)
                     (= nil (get form :parent-form-id)) (= id (get (get node :source) :form-id))])
                (recur (rest remaining) (rest node-ids) (rest values) (assoc out id (first values))) nil)))) nil)) nil))

; A checked singleton declared self component permits ordinary calls. The
; emitter reconstructs its source joins independently; no recur conversion.
(defn p15-s23-ds-type? [type]
  (if (p15-s23-hl-type? type) true
    (contains? #{:gravity.type/i8 :gravity.type/i16 :gravity.type/i32 :gravity.type/i64
                :gravity.type/u8 :gravity.type/u16 :gravity.type/u32 :gravity.type/u64
                :gravity.type/f32 :gravity.type/f64 :gravity.type/bool :gravity.type/string
                :gravity.type/symbol :gravity.type/keyword :gravity.type/ratio} type)))

; Independently reconstruct the private self VALUE signature and finite
; source premise before permitting ordinary calls or an inferred List head.
(defn p15-s23-is-exact-keys? [value fields]
  (if (map? value) (= fields (set (keys value))) false))

(defn p15-s23-is-function-index [records] (p15-s23-typed-index records :function-syntax-id))
(defn p15-s23-is-known? [type]
  (if (p15-s23-ij-unknown? type) false (p15-s23-ni-valid-view? type)))

(defn p15-s23-is-private-call? [call edge uses resolutions record binding core nodes forms]
  (let [bid (get record :definition-binding-id) id (get call :core-node-id)
        node (get nodes id) children (get node :children) op (get nodes (get call :operator-node-id))
        source (get op :source) form (get forms (get source :form-id))
        owner (get forms (get (get node :source) :form-id))
        use (p15-s23-pe-one uses :core-node-id (get op :node-id))
        resolution (p15-s23-pe-one resolutions :reference-syntax-id (get source :syntax-id))
        caller-id (get edge :caller-function-syntax-id)
        caller (p15-s23-pe-one (get core :function-records) :function-syntax-id caller-id)]
    (p15-s23-typed-all
      [(if (= caller-id nil) (= nil (get edge :caller-function-core-node-id)) (map? caller))
       (= :call (get node :core-form)) (= :reference (get op :core-form)) (= [] (get op :children))
       (= [bid] (get node :resolved-binding-ids) (get op :resolved-binding-ids))
       (= {:symbol (get form :value) :position :operator :binding-id bid :binding-class :namespace
           :definition-syntax-id (get binding :definition-syntax-id)} (get op :attributes))
       (= :symbol (get form :kind))
       (= {:core-node-id (get op :node-id) :form-id (get source :form-id) :syntax-id (get source :syntax-id)
           :symbol (get form :value) :position :operator :binding-id bid :binding-class :namespace
           :definition-syntax-id (get binding :definition-syntax-id)} use)
       (= {:reference-syntax-id (get source :syntax-id) :symbol (get form :value) :position :operator
           :binding-id bid :upstream-binding-id (get binding :upstream-binding-id)
           :resolution-order (get resolution :resolution-order) :source-span (get form :source-span)} resolution)
       (= {:core-node-id id :operator-node-id (first children) :operator-binding-id bid
           :argument-node-ids (vec (rest children)) :ordered-evaluation-node-ids children
           :evaluation-order :operator-then-arguments :result-policy :call-result} call)
       (= {:ordinal (get edge :ordinal) :call-core-node-id id
           :caller-function-syntax-id caller-id :caller-function-core-node-id (get caller :function-core-node-id)
           :callee-binding-id bid :callee-definition-syntax-id (get binding :definition-syntax-id)
           :callee-function-syntax-id (get record :function-syntax-id) :callee-function-core-node-id (get record :function-core-node-id)
           :argument-core-node-ids (get call :argument-node-ids) :ordered-evaluation-node-ids children
           :evaluation-order :operator-then-arguments :classification :local-function} edge)
       (= caller-id (get (get node :evaluation) :owner-function-syntax-id))
       (= :operator-then-arguments (get (get node :evaluation) :kind))
       (= (get record :fixed-arity) (count (get call :argument-node-ids)))
       (= :list (get owner :kind)) (= (count children) (count (get owner :child-form-ids)))
       (loop [i 0]
         (if (= i (count children)) true
           (let [child (get nodes (get children i)) child-form (get forms (get (get owner :child-form-ids) i))]
             (if (p15-s23-typed-all
                   [(= (get owner :form-id) (get child-form :parent-form-id))
                    (= (get child :source) (p15-s23-typed-source child-form))
                    (= {:index i :core-node-id (get child :node-id)} (get (get (get node :evaluation) :order) i))])
               (recur (+ i 1)) false))))])))

(defn p15-s23-is-private-census [record core nodes bindings forms]
  (let [params (get record :parameter-binding-ids) bid (get record :definition-binding-id)
        binding (get bindings bid) definition (p15-s23-pe-one (get core :definitions) :binding-id bid)
        fn-node (get nodes (get record :function-core-node-id))
        def-node (get nodes (get definition :core-node-id))
        def-form (get forms (get (get def-node :source) :form-id))
        name-form (get forms (get (get def-form :child-form-ids) 1))
        fn-form (get forms (get record :function-form-id))
        exports (get (get core :module) :exports)
        uses (p15-s23-pe-select (get core :reference-uses) :binding-id bid)
        resolutions (p15-s23-pe-select (get (get core :preserved-resolution) :resolution-table) :binding-id bid)
        references (loop [remaining (get core :nodes) out []]
                     (if (= 0 (count remaining)) out
                       (let [node (first remaining)]
                         (recur (rest remaining)
                           (if (if (= :reference (get node :core-form))
                                 (if (= bid (get (get node :attributes) :binding-id)) true
                                   (contains? (set (get node :resolved-binding-ids)) bid)) false)
                             (conj out node) out)))))
        calls (p15-s23-pe-select (get core :calls) :operator-binding-id bid)
        edges (loop [remaining (get core :call-edges) out []]
                (if (= 0 (count remaining)) out
                  (let [edge (first remaining)]
                    (recur (rest remaining)
                      (if (if (= bid (get edge :callee-binding-id)) true
                            (= (get record :function-syntax-id) (get edge :callee-function-syntax-id)))
                        (conj out edge) out)))))
        self-edges (p15-s23-pe-select edges :caller-function-syntax-id (get record :function-syntax-id))
        mutated (loop [remaining (get core :mutations) out #{}]
                  (if (= 0 (count remaining)) out
                    (recur (rest remaining) (conj out (get (first remaining) :target-binding-id)))))
        component {:ordinal 0 :kind :self-recursive :function-syntax-ids [(get record :function-syntax-id)]
                   :function-core-node-ids [(get record :function-core-node-id)]
                   :internal-call-edge-ordinals [(get (first self-edges) :ordinal)]}
        parameters (loop [remaining params out []]
                     (if (= 0 (count remaining)) out
                       (recur (rest remaining) (conj out (get bindings (first remaining))))))]
    ; This must dominate the eager predicate vector's per-call joins. A valid
    ; source escape may have arbitrarily more references than direct calls.
    (if (if (> (count calls) 0)
          (= (count calls) (count edges) (count uses) (count resolutions) (count references)) false)
    (if (p15-s23-typed-all
          [(map? record) (map? definition) (vector? params) (> (count params) 0) (<= (count params) 1024)
           (= (count params) (count (set params)) (get record :fixed-arity))
           (= :named-top-level (get record :definition-kind))
           (= :function (get binding :kind)) (= :namespace (get binding :binding-class))
           (= :private (get binding :visibility) (get (get def-node :attributes) :visibility))
           (= (get (get core :module) :namespace) (get binding :namespace))
           (= (get binding :name) (get definition :name) (get record :definition-name) (get name-form :value))
           (= (get binding :definition-syntax-id) (get (get def-node :attributes) :name-syntax-id) (get name-form :syntax-id))
           (= :def (get def-node :core-form)) (= :fn (get fn-node :core-form))
           (= (get record :definition-core-node-id) (get definition :core-node-id) (get def-node :node-id))
           (= [(get fn-node :node-id)] (get def-node :children)) (= [bid] (get def-node :resolved-binding-ids))
           (= (get record :function-core-node-id) (get definition :value-node-id) (get fn-node :node-id))
           (= [(get record :body-core-node-id)] (get fn-node :children))
           (= params (get fn-node :resolved-binding-ids))
           (= (get record :function-syntax-id) (get fn-form :syntax-id) (get (get fn-node :source) :syntax-id))
           (= (get record :function-form-id) (get fn-form :form-id) (get (get def-form :child-form-ids) 2))
           (vector? exports)
           (loop [remaining exports]
             (if (= 0 (count remaining)) true
               (if (if (= (str (first remaining)) (str (get binding :name))) true
                     (= (str (first remaining)) (str (get binding :namespace) "/" (get binding :name))))
                 false (recur (rest remaining)))))
           (= [component] (get core :recursion-components)) (= 1 (count self-edges))
           (= false (p15-s23-pe-reentry? core record))
           (= 0 (count (p15-s23-pe-select (get core :var-references) :binding-id bid)))
           (= 0 (count (p15-s23-pe-select (get core :mutations) :target-binding-id bid)))
           (loop [remaining parameters ids params]
             (if (= 0 (count remaining)) true
               (let [parameter (first remaining)]
                 (if (p15-s23-typed-all
                       [(= (first ids) (get parameter :binding-id)) (= [:lexical :local] [(get parameter :binding-class) (get parameter :kind)])
                        (contains? #{nil :immutable} (get parameter :mutability))
                        (= false (contains? mutated (first ids)))])
                   (recur (rest remaining) (rest ids)) false))))
           (> (count calls) 0) (= (count calls) (count edges) (count uses) (count resolutions) (count references))
           (loop [remaining calls seen #{}]
             (if (= 0 (count remaining)) true
               (let [call (first remaining) op-id (get call :operator-node-id)
                     edge (p15-s23-pe-one edges :call-core-node-id (get call :core-node-id))]
                 (if (if (= false (contains? seen op-id))
                       (p15-s23-is-private-call? call edge uses resolutions record binding core nodes forms) false)
                   (recur (rest remaining) (conj seen op-id)) false))))])
      {:kind :closed-private-self-use-census-v1 :function-record record :definition definition :definition-binding binding
       :parameter-bindings parameters :exports exports :reference-uses uses :resolutions resolutions
       :reference-node-ids (loop [remaining references out []]
                             (if (= 0 (count remaining)) out
                               (recur (rest remaining) (conj out (get (first remaining) :node-id)))))
       :calls calls :edges edges :component component}
      nil) nil)))

(defn p15-s23-is-cold-cut [core record nodes mode budget]
  (if (contains? #{:entries :body} mode)
  (let [sequence (get core :nodes) calls (get core :calls) edges (get core :call-edges)
        id (get record :function-syntax-id)
        base (+ (* 2 (count sequence)) (count calls) (count edges)
                (count (get core :definitions)) (count (get core :lexical-bindings)) (count (get core :function-records)))]
    (if (> base budget) {:status :rejected :reason :private-self-work-limit :work-count base}
      (let [definitions (p15-s23-typed-index (get core :definitions) :binding-id)
            lexical (p15-s23-typed-index (get core :lexical-bindings) :binding-id)
            functions (p15-s23-is-function-index (get core :function-records))
            edge-index (p15-s23-typed-index edges :call-core-node-id)
            initial (loop [remaining sequence out (set [(get record :function-core-node-id) (get record :definition-core-node-id)])]
                      (if (= 0 (count remaining)) out
                        (let [node (first remaining)]
                          (recur (rest remaining)
                            (if (if (= mode :entries) (= id (get (get node :evaluation) :owner-function-syntax-id)) false)
                              (conj out (get node :node-id)) out)))))
            initial (loop [remaining calls out initial]
                      (if (= 0 (count remaining)) out
                        (let [call (first remaining) edge (get edge-index (get call :core-node-id))]
                          (recur (rest remaining)
                            (if (= id (get edge :callee-function-syntax-id))
                              (conj (conj out (get call :core-node-id)) (get call :operator-node-id)) out)))))]
        (loop [remaining sequence excluded initial next initial work base rounds 0]
          (if (= 0 (count remaining))
            (if (= excluded next)
              {:status :accepted :mode mode :work-count work
               :excluded-node-ids
               (loop [remaining sequence out []]
                 (if (= 0 (count remaining)) out
                   (recur (rest remaining)
                     (if (contains? next (get (first remaining) :node-id)) (conj out (get (first remaining) :node-id)) out))))}
              (if (< rounds (count sequence))
                (recur sequence next next work (+ rounds 1))
                {:status :rejected :reason :private-self-cold-cut-nonconvergence :work-count work}))
            (let [node (first remaining) node-id (get node :node-id) kind (get node :core-form)
                  bid (get (get node :attributes) :binding-id)
                  initializer (if (= kind :reference)
                                (get (get lexical bid) :initializer-node-id (get (get definitions bid) :value-node-id)) nil)
                  target (if (= kind :call)
                           (get (get functions (get (get edge-index node-id) :callee-function-syntax-id)) :body-core-node-id) nil)
                  children (if (contains? #{:fn :quote :throw :recur} kind) [] (get node :children))
                  deps (if (= initializer nil) children (conj children initializer))
                  deps (if (= target nil) deps (conj deps target))
                  used (+ work 1 (count deps))]
              (if (> used budget)
                {:status :rejected :reason :private-self-work-limit :work-count used}
                (recur (rest remaining) excluded
                  (if (if (contains? next node-id) true
                        (loop [remaining deps]
                          (if (= 0 (count remaining)) false
                            (if (contains? next (first remaining)) true (recur (rest remaining))))))
                    (conj next node-id) next)
                  used rounds))))))))
    {:status :rejected :reason :private-self-cold-mode-required :work-count 0}))

(defn p15-s23-is-entry-values [census nodes types budget]
  (let [record (get census :function-record) id (get record :function-syntax-id)
        arity (get record :fixed-arity) calls (get census :calls) edges (get census :edges)]
    (if (if (if (vector? calls) (vector? edges) false)
          (if (= (count calls) (count edges)) (if (integer? arity) (> arity 0) false) false) false)
      (loop [remaining calls remaining-edges edges entries [] selected nil normal-count 0 work 3]
        (if (> work budget)
          {:status :rejected :reason :private-self-work-limit :work-count work}
          (if (= 0 (count remaining))
            (if (> normal-count 0)
              {:status :accepted :parameter-types selected :entries entries :normal-entry-count normal-count :work-count work}
              {:status :rejected :reason :private-self-normal-entry-required :work-count work})
            (let [call (first remaining) edge (first remaining-edges) args (get call :argument-node-ids)
                  self? (= id (get edge :caller-function-syntax-id))
                  charge (if self? 1 (+ 8 (* 4 (count args))))
                  used (+ work charge)]
              (if (> used budget)
                {:status :rejected :reason :private-self-work-limit :work-count used}
                (if (if (= (get call :core-node-id) (get edge :call-core-node-id))
                      (if (= id (get edge :callee-function-syntax-id))
                        (if (= :local-function (get edge :classification))
                          (if (vector? args) (= arity (count args)) false) false) false) false)
                  (if self?
                    (recur (rest remaining) (rest remaining-edges) entries selected normal-count used)
                    (let [arguments (p15-s23-io-child-types args types)
                          invoked? (p15-s23-pe-invoked? types args)
                          complete? (loop [values arguments]
                                      (if (= 0 (count values)) true
                                        (if (p15-s23-ds-type? (first values)) (recur (rest values)) false)))
                          entry {:call-core-node-id (get call :core-node-id)
                                 :caller-function-syntax-id (get edge :caller-function-syntax-id)
                                 :source-call call :source-edge edge :source (get (get nodes (get call :core-node-id)) :source)
                                 :argument-node-ids args :argument-types arguments
                                 :normal-invocation? invoked? :invocation-guard :all-operand-types-normal
                                 :callee-result-is-not-invocation-guard true}]
                      (if (if invoked? (= false complete?) false)
                        {:status :rejected :reason :private-self-independent-entry-types-required
                         :entry entry :work-count used}
                        (if (if invoked? (if (= selected nil) false (= false (= selected arguments))) false)
                          {:status :rejected :reason :private-self-entry-type-conflict
                           :expected selected :actual arguments :entry entry :work-count used}
                          (recur (rest remaining) (rest remaining-edges) (conj entries entry)
                            (if invoked? arguments selected) (if invoked? (+ normal-count 1) normal-count) used)))))
                  {:status :rejected :reason :private-self-entry-census-mismatch :work-count used}))))))
      {:status :rejected :reason :private-self-entry-families-required :work-count 0})))

(defn p15-s23-is-parameter-record [core parameter index binding type]
  (let [premise (get core :sh08-private-self-parameter-premise)
        census (get premise :source-census) entries (get premise :entry-values)
        declaration (get (get (get parameter :signature) :parameters) index)]
    (if (p15-s23-typed-all
          [(= :gravity/sh08-private-self-entry-parameter-premise-v1 (get premise :domain))
           (= :closed-private-self-use-census-v1 (get census :kind))
           (= parameter (get census :function-record)) (= :accepted (get entries :status))
           (> (get entries :normal-entry-count 0) 0)
           (= declaration nil) (integer? index) (if (integer? index) (>= index 0) false)
           (= (get parameter :function-syntax-id) (get (get census :function-record) :function-syntax-id))
           (= binding (get (get census :parameter-bindings) index))
           (= (get binding :binding-id) (get (get parameter :parameter-binding-ids) index))
           (contains? #{nil :immutable} (get binding :mutability))
           (= type (get (get entries :parameter-types) index)) (p15-s23-hl-type? type)])
      {:kind :gravity.type/private-self-entry-parameter :version :sh08-private-self-entry-parameter-v1
       :function-record parameter :parameter-index index :binding binding :type type
       :parameter-value-premise premise}
      nil)))

(defn p15-s23-is-return-witness [record nodes types budget]
  (let [body (get record :body-core-node-id)]
    (loop [queue [{:node-id body :path [body] :control-records []}] offset 0
           witnesses [] pending [] selected nil work 0]
      (if (= offset (count queue))
        (if (> (count witnesses) 0)
          {:status :accepted :return-type selected :witnesses witnesses
           :pending-return-node-ids pending :work-count work}
          {:status :rejected :reason :private-self-independent-return-required
           :pending-return-node-ids pending :work-count work})
        (let [frame (get queue offset) id (get frame :node-id) node (get nodes id)
              kind (get node :core-form) children (get node :children)
              path (get frame :path) controls (get frame :control-records)
              type (get types id :gravity.type/unknown)
              used (+ work 1 (* (+ 3 (count path) (count controls)) (+ 1 (count children))))]
          (if (> used budget)
            {:status :rejected :reason :private-self-work-limit :work-count used}
            (if (> (count path) 128)
              {:status :rejected :reason :private-self-return-path-bound :work-count used}
              (if (= false (map? node))
                {:status :rejected :reason :private-self-return-source-required :work-count used}
                (if (= kind :if)
                  (if (= 3 (count children))
                    (let [condition-id (first children) condition (get nodes condition-id)
                          condition-type (get types condition-id :gravity.type/unknown)
                          attributes (get condition :attributes)
                          literal? (= :literal (get condition :core-form))
                          branches (if (= condition-type :gravity.type/nil) [2]
                                     (if (= condition-type :gravity.type/bool)
                                       (if (if literal? (contains? attributes :value) false)
                                         (if (= true (get attributes :value)) [1] [2]) [1 2])
                                       (if (p15-s23-ni-type? condition-type) [1 2] [1])))
                          control {:owner-core-node-id id :condition-core-node-id condition-id
                                   :condition-type condition-type :condition-source (get condition :source)
                                   :selected-branch-indexes branches :rule :independent-normal-condition}]
                      (if (= condition-type :gravity.type/never)
                        (recur queue (+ offset 1) witnesses pending selected used)
                        (if (p15-s23-is-known? condition-type)
                          (recur
                            (loop [remaining branches out queue]
                              (if (= 0 (count remaining)) out
                                (let [child (get children (first remaining))]
                                  (recur (rest remaining)
                                    (conj out {:node-id child :path (conj path child)
                                               :control-records (conj controls control)})))))
                            (+ offset 1) witnesses pending selected used)
                          (recur queue (+ offset 1) witnesses (conj pending id) selected used))))
                    {:status :rejected :reason :private-self-return-source-required :work-count used})
                  (if (contains? #{:do :let} kind)
                    (if (> (count children) 0)
                      (let [prefix (loop [i 0 out [] normal? true abort? false]
                                     (if (= i (- (count children) 1))
                                       {:rows out :normal? normal? :abort? abort?}
                                       (let [child (get children i) child-type (get types child :gravity.type/unknown)]
                                         (recur (+ i 1) (conj out {:node-id child :type child-type})
                                           (if (p15-s23-is-known? child-type) normal? false)
                                           (if (= child-type :gravity.type/never) true abort?)))))
                            last-id (get children (- (count children) 1))]
                        (if (get prefix :abort?)
                          (recur queue (+ offset 1) witnesses pending selected used)
                          (if (get prefix :normal?)
                            (recur (conj queue {:node-id last-id :path (conj path last-id)
                                                :control-records (conj controls {:owner-core-node-id id
                                                                                 :rule :independent-normal-prefix
                                                                                 :prefix (get prefix :rows)})})
                              (+ offset 1) witnesses pending selected used)
                            (recur queue (+ offset 1) witnesses (conj pending id) selected used))))
                      {:status :rejected :reason :private-self-independent-return-required :work-count used})
                    (if (if (contains? #{:throw :recur} kind) true (= type :gravity.type/never))
                      (recur queue (+ offset 1) witnesses pending selected used)
                      (if (contains? #{:try :alternatives :loop :match} kind)
                        {:status :rejected :reason :private-self-return-shape-required :work-count used}
                        (if (p15-s23-ds-type? type)
                          (if (if (= selected nil) false (= false (= selected type)))
                            {:status :rejected :reason :private-self-return-type-conflict
                             :expected selected :actual type :node-id id :work-count used}
                            (recur queue (+ offset 1)
                              (conj witnesses {:node-id id :source (get node :source) :type type
                                               :path path :control-records controls
                                               :rule :independent-normal-return-value})
                              pending type used))
                          (if (p15-s23-ij-unknown? type)
                            (recur queue (+ offset 1) witnesses (conj pending id) selected used)
                            {:status :rejected :reason :private-self-return-value-type-required
                             :actual type :node-id id :work-count used}))))))))))))))

(defn p15-s23-is-cold-call-ids [core record cut]
  (let [id (get record :function-syntax-id) excluded (set (get cut :excluded-node-ids))]
    (loop [calls (get core :calls) edges (get core :call-edges) out []]
      (if (= 0 (count calls)) out
        (let [call (first calls) edge (first edges)
              keep? (if (= id (get edge :callee-function-syntax-id)) false
                      (if (if (= :entries (get cut :mode)) (= id (get edge :caller-function-syntax-id)) false) false
                        (if (= :local-function (get edge :classification)) true
                          (= false (contains? excluded (get call :core-node-id))))))]
          (recur (rest calls) (rest edges) (if keep? (conj out (get call :core-node-id)) out)))))))

(defn p15-s23-is-cold-metadata-valid? [core facts record bindings forms cold cut]
  (let [records (get core :function-records) calls (get core :calls) sequence (get core :nodes)
        locals (get core :lexical-bindings) definitions (get core :definitions)
        excluded (set (get cut :excluded-node-ids))
        slots (loop [remaining records total 0]
                (if (= 0 (count remaining)) total
                  (recur (rest remaining) (+ total (count (get (first remaining) :parameter-binding-ids))))))
        arguments (loop [remaining calls total 0]
                    (if (= 0 (count remaining)) total
                      (recur (rest remaining) (+ total (count (get (first remaining) :argument-node-ids))))))
        selected-nodes (loop [remaining sequence total 0]
                         (if (= 0 (count remaining)) total
                           (recur (rest remaining) (+ total (if (contains? excluded (get (first remaining) :node-id)) 0 1)))))
        selected-locals (loop [remaining locals total 0]
                          (if (= 0 (count remaining)) total
                            (recur (rest remaining) (+ total (if (contains? excluded (get (first remaining) :initializer-node-id)) 0 1)))))
        ids (p15-s23-is-cold-call-ids core record cut)
        preparation (+ (get cut :work-count) (* 4 (count sequence)) (* 4 (count records)) (* 2 slots)
                       (* 4 (count calls)) (count (get core :call-edges)) arguments (* 2 (count locals))
                       (* 2 (count definitions)) (count forms) (count bindings) (count (get facts :imported-function-types)))
        round-work (+ (* 6 (count sequence)) (* 3 (count locals)) (* 3 (count definitions)) (* 7 (count records))
                      (* 5 slots) (* 5 (count calls)) (* 3 arguments) (* 3 (count bindings)) (* 2 (count forms)))
        bound (+ 2 selected-nodes (- (count records) 1) (- slots (count (get record :parameter-binding-ids))) (count ids) selected-locals)]
    (if (p15-s23-typed-all
          [(p15-s23-is-exact-keys? cold #{:mode :cut :source-argument-call-node-ids :source-preparation-work-count
                                   :quote-work-count :round-count :round-bound :work-count})
           (= cut (get cold :cut)) (= (get cut :mode) (get cold :mode))
           (= ids (get cold :source-argument-call-node-ids)) (= preparation (get cold :source-preparation-work-count))
           (= bound (get cold :round-bound))
           (loop [remaining [(get cold :quote-work-count) (get cold :round-count) (get cold :work-count)]]
             (if (= 0 (count remaining)) true
               (if (integer? (first remaining)) (if (>= (first remaining) 0) (recur (rest remaining)) false) false)))])
      (p15-s23-typed-all [(> (get cold :round-count) 0) (<= (get cold :round-count) bound)
                  (<= (get cold :quote-work-count) (count forms))
                  (<= (+ preparation (get cold :quote-work-count) (* round-work (get cold :round-count))) (get cold :work-count))
                  (<= (get cold :work-count) 65536)]) false)))

(defn p15-s23-is-source-cost [core bindings forms record arguments target-slots]
  (let [nodes (count (get core :nodes)) calls (count (get core :calls)) edges (count (get core :call-edges))
        records (count (get core :function-records)) locals (count (get core :lexical-bindings))
        arity (count (get record :parameter-binding-ids))
        prior (+ 32 (* 8 nodes) (* 8 calls) (* 4 edges) (* 4 (count bindings)) (* 4 records) (* 4 locals)
                 (* 2 arguments) (* calls (count bindings)))
        reservation (+ prior (if (= 3 arity) (* 4 calls) 0) 16 records calls (count (get core :recur-targets))
                       (* 8 nodes) (* 4 (count bindings)) (* 2 (count forms)) (* 4 (count (get core :definitions)))
                       (* 4 locals) (* 3 (count (get core :mutations))) (count (get core :var-references))
                       (* 2 (count (get core :reference-uses))) (* 2 (count (get (get core :preserved-resolution) :resolution-table)))
                       (count (get (get core :module) :exports)) (* 4 records) (* 4 arguments) (* 4 arity)
                       (count (get core :recur-transfers))
                       (* (count (get core :recur-transfers)) (+ (count (get core :recur-targets)) target-slots))
                       (* calls (+ 32 (* 3 calls) records (* 4 arity))))]
    {:prior-attempt-work prior :source-reservation-work reservation}))

(defn p15-s23-ix-form-source [form]
  (p15-s23-typed-source form))


(defn p15-s23-ix-intrinsic [kind core node call edge nodes bindings types forms budget]
  (let [work (+ 64 (count (get call :argument-node-ids)) (count (get core :function-records)))]
    (if (> work budget) {:status :rejected :rule "C7-GENERIC" :reason :indexed-self-work-limit :work-count work}
      (let [header (if (= kind :count) (p15-s23-cq-source core node call edge nodes bindings types (get core :module))
                     (if (= kind :integral) (p15-s23-ie-source core node call edge nodes bindings types (get core :module))
                       (p15-s23-ae-source core node call edge nodes bindings types (get core :module))))
            descriptor (if (= kind :count) (p15-s23-cq-finish header)
                         (if (= kind :atomic) (p15-s23-ae-finish header) header))]
        (if (if (map? header) (p15-s23-ix-call-forms? node nodes forms) false)
          {:status :accepted :descriptor descriptor :type (get descriptor :result-type) :work-count work}
          {:status :rejected :reason :indexed-self-source-intrinsic-required :work-count work})))))


(defn p15-s23-ix-types? [types]
  (= [{:kind :gravity.type/vector :shape :literal
       :element-types [:gravity.type/keyword :gravity.type/keyword :gravity.type/keyword
                       :gravity.type/keyword :gravity.type/keyword :gravity.type/keyword :gravity.type/keyword]}
      :gravity.type/keyword :gravity.type/integer] types))


(defn p15-s23-ix-literal? [node kind value forms]
  (let [form (get forms (get (get node :source) :form-id))]
    (p15-s23-typed-all
      [(= :literal (get node :core-form)) (= [] (get node :children))
       (= {:literal-kind kind :value value} (get node :attributes))
       (= kind (get form :kind)) (= value (get form :value))
       (= [] (get form :child-form-ids))
       (= (get node :source) (p15-s23-ix-form-source form))])))


(defn p15-s23-ix-entry-values [census nodes types forms budget]
  (let [record (get census :function-record) id (get record :function-syntax-id)
        calls (get census :calls) edges (get census :edges)]
    (if (if (vector? calls) (if (vector? edges) (= (count calls) (count edges)) false) false)
      (loop [remaining calls rows edges entries [] selected nil normal-count 0 work 3]
        (if (> work budget)
          {:status :rejected :reason :indexed-self-work-limit :work-count work}
          (if (= 0 (count remaining))
            (if (> normal-count 0)
              {:status :accepted :parameter-types selected :entries entries :normal-entry-count normal-count :work-count work}
              {:status :rejected :reason :indexed-self-normal-entry-required :work-count work})
            (let [call (first remaining) edge (first rows) args (get call :argument-node-ids)
                  self? (= id (get edge :caller-function-syntax-id))
                  used (+ work (if self? 1 (+ 16 (* 4 (count args)))))]
              (if (> used budget)
                {:status :rejected :reason :indexed-self-work-limit :work-count used}
                (if (p15-s23-typed-all
                      [(= (get call :core-node-id) (get edge :call-core-node-id))
                       (= id (get edge :callee-function-syntax-id)) (= :local-function (get edge :classification))
                       (vector? args) (= 3 (count args)) (= 3 (get record :fixed-arity))])
                  (if self?
                    (recur (rest remaining) (rest rows) entries selected normal-count used)
                    (let [arguments (p15-s23-io-child-types args types)
                          invoked? (p15-s23-pe-invoked? types args)
                          index (get nodes (get args 2))
                          zero? (p15-s23-ix-literal? index :integer 0 forms)
                          entry {:call-core-node-id (get call :core-node-id)
                                 :caller-function-syntax-id (get edge :caller-function-syntax-id)
                                 :source-call call :source-edge edge :source (get (get nodes (get call :core-node-id)) :source)
                                 :argument-node-ids args :argument-types arguments
                                 :normal-invocation? invoked? :invocation-guard :all-operand-types-normal
                                 :callee-result-is-not-invocation-guard true
                                 :index-entry-source (if invoked? {:node index :form (get forms (get (get index :source) :form-id))} nil)}]
                      (if (if invoked? (= false (p15-s23-ix-types? arguments)) false)
                        {:status :rejected :reason :indexed-self-independent-entry-types-required :entry entry :work-count used}
                        (if (if invoked? (= false zero?) false)
                          {:status :rejected :reason :indexed-self-zero-source-entry-required :entry entry :work-count used}
                          (if (if invoked? (if (= selected nil) false (= false (= selected arguments))) false)
                            {:status :rejected :reason :indexed-self-entry-type-conflict
                             :expected selected :actual arguments :entry entry :work-count used}
                            (recur (rest remaining) (rest rows) (conj entries entry)
                              (if invoked? arguments selected) (if invoked? (+ normal-count 1) normal-count) used))))))
                  {:status :rejected :reason :indexed-self-entry-census-mismatch :work-count used}))))))
      {:status :rejected :reason :indexed-self-entry-families-required :work-count 0})))


(defn p15-s23-ix-if-source? [core node nodes forms]
  (let [children (get node :children) form (get forms (get (get node :source) :form-id))
        ids (get form :child-form-ids) op (get forms (first ids))
        control {:core-node-id (get node :node-id) :kind :if :condition-node-id (first children)
                 :branches [{:role :then :predicate :truthy :core-node-id (get children 1)}
                            {:role :else :predicate :falsey :core-node-id (get children 2)}]
                 :branch-exclusivity :exactly-one :truthiness {:false-values [:nil :false] :other-values :true}
                 :result-policy :selected-branch}]
    (if (if (vector? children) (if (= 3 (count children)) (if (vector? ids) (= 4 (count ids)) false) false) false)
      (p15-s23-typed-all
        [(= :if (get node :core-form)) (= :list (get form :kind)) (= [:symbol 'if] [(get op :kind) (get op :value)])
         (= (get node :source) (p15-s23-ix-form-source form))
         (= {:condition-child-index 0 :then-child-index 1 :else-child-index 2 :condition-evaluation :always-first
             :branch-evaluation :exactly-one :truthiness {:false-values [:nil :false] :other-values :true}} (get node :attributes))
         (= :condition-then-exclusive-branch (get (get node :evaluation) :kind))
         (= [{:index 0 :core-node-id (first children)}] (get (get node :evaluation) :order))
         (= [control] (p15-s23-pe-select (get core :control-flow) :core-node-id (get node :node-id)))
         (loop [i 0]
           (if (= i 3) true
             (let [child (get nodes (get children i)) child-form (get forms (get ids (+ i 1)))]
               (if (p15-s23-typed-all [(= (get form :form-id) (get child-form :parent-form-id))
                                      (= (get child :source) (p15-s23-ix-form-source child-form))])
                 (recur (+ i 1)) false))))]) false)))


(defn p15-s23-ix-source [core census entries nodes bindings forms budget]
  (let [record (get census :function-record) params (get record :parameter-binding-ids)
        sequence (get core :nodes) calls (get core :calls) edges (get core :call-edges)
        base (+ 384 (* 2 (count sequence)) (* 2 (count calls)) (* 2 (count edges))
                (* 2 (count forms)) (count bindings) (* 6 (count (get core :function-records)))
                (* 2 (count (get core :control-flow))))]
    (if (> base budget) {:status :rejected :reason :indexed-self-work-limit :work-count base}
      (if (= false (if (= :accepted (get entries :status)) (p15-s23-ix-types? (get entries :parameter-types)) false))
        {:status :rejected :reason :indexed-self-entry-premise-required :work-count base}
        (let [call-index (p15-s23-typed-index calls :core-node-id) edge-index (p15-s23-typed-index edges :call-core-node-id)
              id (get record :function-syntax-id)
              body (get nodes (get record :body-core-node-id)) outer (get body :children)
              guard (get nodes (first outer)) base-node (get nodes (get outer 1)) inner (get nodes (get outer 2))
              inner-children (get inner :children) match (get nodes (first inner-children))
              true-node (get nodes (get inner-children 1)) self (get call-index (get inner-children 2))
              self-edge (get edge-index (get self :core-node-id)) self-args (get self :argument-node-ids)
              step (get nodes (get self-args 2)) step-call (get call-index (get step :node-id))
              guard-call (get call-index (get guard :node-id)) guard-args (get guard-call :argument-node-ids)
              counted (get nodes (get guard-args 1)) count-call (get call-index (get counted :node-id))
              match-call (get call-index (get match :node-id)) match-args (get match-call :argument-node-ids)
              access (get nodes (get match-args 1)) access-call (get call-index (get access :node-id))
              access-args (get access-call :argument-node-ids) step-args (get step-call :argument-node-ids)
              owned-calls (p15-s23-pe-select edges :caller-function-syntax-id id)
              normal-entry-ids (loop [remaining (get entries :entries) out []]
                                 (if (= 0 (count remaining)) out
                                   (recur (rest remaining)
                                     (if (= true (get (first remaining) :normal-invocation?))
                                       (conj out (get (first remaining) :call-core-node-id)) out))))
              source-ok?
              (p15-s23-typed-all
                [(= 3 (count params)) (= record (get census :function-record))
                 (p15-s23-ix-if-source? core body nodes forms) (p15-s23-ix-if-source? core inner nodes forms)
                 (p15-s23-ix-literal? base-node :boolean false forms) (p15-s23-ix-literal? true-node :boolean true forms)
                 (= (get self-edge :caller-function-syntax-id) id (get self-edge :callee-function-syntax-id))
                 (= [self-edge] (p15-s23-pe-select (get census :edges) :caller-function-syntax-id id))
                 (= self (p15-s23-pe-one (get census :calls) :core-node-id (get self :core-node-id)))
                 (= 6 (count owned-calls))
                 (= (set [(get guard :node-id) (get counted :node-id) (get match :node-id)
                          (get access :node-id) (get step :node-id) (get self :core-node-id)])
                    (set (loop [remaining owned-calls out []]
                           (if (= 0 (count remaining)) out
                             (recur (rest remaining) (conj out (get (first remaining) :call-core-node-id)))))))
                 (= 2 (count guard-args) (count match-args) (count access-args) (count step-args))
                 (= 1 (count (get count-call :argument-node-ids)))
                 (p15-s23-ix-ref? (get nodes (first guard-args)) (get params 2) forms bindings)
                 (p15-s23-ix-ref? (get nodes (first (get count-call :argument-node-ids))) (first params) forms bindings)
                 (p15-s23-ix-ref? (get nodes (first match-args)) (get params 1) forms bindings)
                 (p15-s23-ix-ref? (get nodes (first access-args)) (first params) forms bindings)
                 (p15-s23-ix-ref? (get nodes (get access-args 1)) (get params 2) forms bindings)
                 (p15-s23-ix-ref? (get nodes (first self-args)) (first params) forms bindings)
                 (p15-s23-ix-ref? (get nodes (get self-args 1)) (get params 1) forms bindings)
                 (p15-s23-ix-ref? (get nodes (first step-args)) (get params 2) forms bindings)
                 (p15-s23-ix-literal? (get nodes (get step-args 1)) :integer 1 forms)
                 (p15-s23-ix-call-forms? access nodes forms) (p15-s23-ix-call-forms? step nodes forms)])]
          (if (= false source-ok?)
            {:status :rejected :reason :indexed-self-source-induction-required :work-count base}
            (let [types (loop [remaining sequence out {}]
                          (if (= 0 (count remaining)) out
                            (let [node (first remaining) bid (get (get node :attributes) :binding-id)
                                  type (if (= :reference (get node :core-form))
                                         (if (= bid (first params)) (first (get entries :parameter-types))
                                           (if (= bid (get params 1)) :gravity.type/keyword
                                             (if (= bid (get params 2)) :gravity.type/integer :gravity.type/unknown)))
                                         (if (= :literal (get node :core-form))
                                           (p15-s23-ix-literal-type node)
                                           :gravity.type/unknown))]
                              (recur (rest remaining) (assoc out (get node :node-id) type)))))
                  count-result (p15-s23-ix-intrinsic :count core counted count-call (get edge-index (get counted :node-id))
                                 nodes bindings types forms (- budget base))
                  after-count (+ base (get count-result :work-count 0))
                  types (assoc types (get counted :node-id) (get count-result :type :gravity.type/unknown))
                  guard-result (if (= :accepted (get count-result :status))
                                 (p15-s23-ix-intrinsic :integral core guard guard-call (get edge-index (get guard :node-id))
                                   nodes bindings types forms (- budget after-count)) count-result)
                  after-guard (+ after-count (if (= :accepted (get count-result :status)) (get guard-result :work-count 0) 0))
                  access-header (if (= :accepted (get guard-result :status))
                                  (p15-s23-vl-source core access access-call (get edge-index (get access :node-id))
                                    nodes bindings types (get core :module)) nil)
                  types (assoc types (get access :node-id) (get access-header :selected-type :gravity.type/unknown))
                  match-result (if (map? access-header)
                                 (p15-s23-ix-intrinsic :atomic core match match-call (get edge-index (get match :node-id))
                                   nodes bindings types forms (- budget after-guard))
                                 {:status :rejected :reason :indexed-self-get-source-required :work-count 0})
                  work (+ after-guard (get match-result :work-count 0))
                  step-header (if (= :accepted (get match-result :status))
                                (p15-s23-si-source core step step-call (get edge-index (get step :node-id))
                                  nodes bindings types (get core :module)) nil)]
              (if (> work budget) {:status :rejected :reason :indexed-self-work-limit :work-count work}
              (if (p15-s23-typed-all
                    [(= :accepted (get count-result :status) (get guard-result :status) (get match-result :status))
                     (= :normal (get (get count-result :descriptor) :application)
                                (get (get guard-result :descriptor) :application) (get (get match-result :descriptor) :application))
                     (= :gravity.type/bool (get guard-result :type) (get match-result :type))
                     (= 'get (get access-header :operation)) (= :gravity.type/keyword (get access-header :selected-type))
                     (= '+ (get step-header :operation)) (= [:gravity.type/integer :gravity.type/integer] (get step-header :argument-types))])
                (let [control {:owner-core-node-id (get body :node-id) :condition-core-node-id (get guard :node-id)
                               :condition-type :gravity.type/bool :condition-source (get guard :source)
                               :selected-branch-indexes [1 2] :rule :independent-normal-condition}
                      witness {:status :accepted :return-type :gravity.type/bool
                               :witnesses [{:node-id (get base-node :node-id) :source (get base-node :source) :type :gravity.type/bool
                                            :path [(get body :node-id) (get base-node :node-id)] :control-records [control]
                                            :rule :independent-normal-return-value}]
                               :pending-return-node-ids [(get inner :node-id)] :work-count work}]
                  {:status :accepted :work-count work :return-witness witness
                   :proof {:kind :gravity.safety/indexed-private-self-range :version :sh08-indexed-private-self-range-v1
                           :rule "SAFE9-OVERFLOW" :outcome :proven-safe :scope :ordinary-function-entry-induction
                           :function-record record :parameter-binding-ids params :parameter-types (get entries :parameter-types)
                           :entry-call-node-ids normal-entry-ids :initial-index 0 :minimum-index 0 :maximum-index 7 :vector-extent 7
                           :body-node body :inner-node inner :base-node base-node :true-node true-node
                           :guard-call guard-call :guard-edge (get edge-index (get guard :node-id))
                           :guard-descriptor (get guard-result :descriptor) :count-descriptor (get count-result :descriptor)
                           :match-descriptor (get match-result :descriptor) :access-header access-header :step-header step-header
                           :unit-node (get nodes (get step-args 1))
                           :unit-source (get forms (get (get (get nodes (get step-args 1)) :source) :form-id))
                           :source-forms (loop [ids (keys forms) out []]
                                           (if (= 0 (count ids)) out
                                             (recur (rest ids) (conj out (get forms (first ids))))))
                           :self-call self :self-edge self-edge :strict-access-edge :equality-false
                           :vector-and-needle :original-immutable-parameter-references
                           :step :binary-source-integer-literal-one :numeric-mode :proof-required :integer-type :gravity.type/integer
                           :check-elision :not-authorized :runtime-guards :retained}})
                {:status :rejected :reason (if (if (= :rejected (get count-result :status))
                                               (= "C7-GENERIC" (get count-result :rule)) false)
                                            :indexed-self-work-limit :indexed-self-source-induction-required)
                 :work-count work})))))))))


(defn p15-s23-ix-ref? [node binding forms bindings]
  (let [form (get forms (get (get node :source) :form-id))]
    (p15-s23-typed-all [(= :reference (get node :core-form)) (= [] (get node :children))
      (= binding (get (get node :attributes) :binding-id)) (= [binding] (get node :resolved-binding-ids))
      (= :symbol (get form :kind)) (= (get form :value) (get (get bindings binding) :name))
      (= (get node :source) (p15-s23-ix-form-source form))])))


(defn p15-s23-ix-call-forms? [node nodes forms]
  (let [owner (get forms (get (get node :source) :form-id)) ids (get owner :child-form-ids) children (get node :children)]
    (if (if (vector? ids) (vector? children) false)
      (p15-s23-typed-all [(= :list (get owner :kind)) (= (count ids) (count children))
        (= (get node :source) (p15-s23-ix-form-source owner))
        (= {:operator-child-index 0 :argument-count (- (count children) 1)
            :argument-child-indexes (loop [i 1 out []] (if (= i (count children)) out (recur (+ i 1) (conj out i))))
            :evaluation-order :operator-then-arguments :dispatch :resolved-symbol-call} (get node :attributes))
        (loop [i 0] (if (= i (count children)) true
          (let [form (get forms (get ids i)) child (get nodes (get children i))]
            (if (p15-s23-typed-all [(= (get owner :form-id) (get form :parent-form-id))
                  (= (get child :source) (p15-s23-ix-form-source form))
                  (if (= i 0) (= (get form :value) (get (get child :attributes) :symbol)) true)])
              (recur (+ i 1)) false))))]) false)))


(defn p15-s23-ix-finish [header range node call nodes]
  (if (= :gravity.type/applied-bounded-unit-addition (get header :kind))
    (p15-s23-si-finish (assoc header :range-proof range))
    (p15-s23-vn-finish
      (assoc header :version :sh08-vector-get-indexed-private-self-v1
        :query-semantics (assoc (get header :query-semantics) :normal-input :indexed-private-self-vector-and-index)
        :bounds-proof {:kind :gravity.safety/vector-index-bounds :rule "SAFE2-BOUNDS" :outcome :proven-safe
                       :scope :indexed-private-self-equality-false-edge :predicate :zero-le-index-lt-length
                       :access-core-node-id (get node :node-id) :vector-node-id (first (get call :argument-node-ids))
                       :index-node-id (get (get call :argument-node-ids) 1)
                       :vector-type (first (get header :argument-types)) :index-value nil :vector-length 7
                       :selected-type :gravity.type/keyword
                       :index-source (get (get nodes (get (get call :argument-node-ids) 1)) :source)
                       :source-induction range :check-elision :not-authorized :runtime-guards :retained}))))

(defn p15-s23-ix-literal-type [node]
  (if (= :literal (get node :core-form))
    (get {:nil :gravity.type/nil :boolean :gravity.type/bool :integer :gravity.type/integer
          :string :gravity.type/string :keyword :gravity.type/keyword :symbol :gravity.type/symbol}
         (get (get node :attributes) :literal-kind)) nil))


(defn p15-s23-ix-proof-valid? [core facts]
  (let [proof (get facts :recursive-proof)
        indexed? (= :gravity/sh08-indexed-private-self-value-proof-v1 (get proof :domain))
        component (first (get core :recursion-components))
        id (first (get component :function-syntax-ids))
        record (p15-s23-pe-one (get core :function-records) :function-syntax-id id)
        function (p15-s23-pe-one (get facts :function-type-table) :function-id id)
        definition (p15-s23-pe-one (get core :definitions) :binding-id (get record :definition-binding-id))
        nodes (p15-s23-typed-index (get core :nodes) :node-id)
        edge (get (get core :call-edges) (first (get component :internal-call-edge-ordinals)))
        call (p15-s23-pe-one (get core :calls) :core-node-id (get edge :call-core-node-id))
        parameters (loop [remaining (get function :parameters) out []]
                     (if (= 0 (count remaining)) out
                       (recur (rest remaining) (conj out (get (first remaining) :type)))))
        owned (loop [remaining (get core :nodes) out []]
                (if (= 0 (count remaining)) out
                  (recur (rest remaining)
                    (if (= id (get (get (first remaining) :evaluation) :owner-function-syntax-id))
                      (conj out (get (first remaining) :node-id)) out))))
        incoming (loop [remaining (get core :call-edges) out []]
                   (if (= 0 (count remaining)) out
                     (recur (rest remaining)
                       (if (= id (get (first remaining) :callee-function-syntax-id))
                         (conj out (get (first remaining) :call-core-node-id)) out))))
        expected {:domain (if indexed? :gravity/sh08-indexed-private-self-value-proof-v1 :gravity/sh08-private-self-value-proof-v1)
                  :function-syntax-id id :function-core-node-id (get record :function-core-node-id)
                  :definition-binding-id (get record :definition-binding-id) :definition-syntax-id (get definition :syntax-id)
                  :body-core-node-id (get record :body-core-node-id) :parameter-binding-ids (get record :parameter-binding-ids)
                  :parameter-types parameters :inferred-return-type (get function :return)
                  :signature (get record :signature) :component component
                  :self-call-core-node-id (get call :core-node-id) :self-call call :self-edge edge
                  :self-call-source (get (get nodes (get call :core-node-id)) :source)
                  :owned-node-ids owned :incoming-call-node-ids incoming
                  :parameter-value-premise (get proof :parameter-value-premise)
                  :cold-body-derivation (get proof :cold-body-derivation) :return-witness (get proof :return-witness)
                  :value-inference (if indexed? :closed-private-indexed-normal-entries-and-source-induction
                                      :closed-private-monomorphic-normal-entries-and-return-witness)
                  :value-check :complete-body-and-all-incoming-arguments :effect-error-status :pending-sh09-recursive-body
                  :captures :own-parameters-and-lexical-locals-only :prior-attempt-work (get proof :prior-attempt-work)
                  :source-reservation-work (get proof :source-reservation-work) :work-count (get proof :work-count)}]
    (p15-s23-typed-all
      [(= expected proof) (= [component] (get core :recursion-components))
       (= {:ordinal 0 :kind :self-recursive :function-syntax-ids [id]
           :function-core-node-ids [(get record :function-core-node-id)]
           :internal-call-edge-ordinals [(get edge :ordinal)]} component)
       (= :named-top-level (get record :definition-kind))
       (= (get record :fixed-arity) (count parameters) (count (get record :parameter-binding-ids)))
       (> (count parameters) 0) (<= (count parameters) 1024)
       (if indexed?
         (if (p15-s23-ix-types? parameters) (= :gravity.type/bool (get function :return)) false)
       (loop [remaining (conj parameters (get function :return))]
         (if (= 0 (count remaining)) true
           (if (p15-s23-ds-type? (first remaining)) (recur (rest remaining)) false))))
       (= (get record :signature) (get function :signature))
       (= [:pending-sh09] (get function :thrown-error-effects))
       (= id (get edge :caller-function-syntax-id) (get edge :callee-function-syntax-id)
          (get (get (get nodes (get call :core-node-id)) :evaluation) :owner-function-syntax-id))
       (= :local-function (get edge :classification))
       (= (get function :return) (get (get proof :return-witness) :return-type))
       (loop [remaining [(get proof :work-count) (get proof :source-reservation-work) (get proof :prior-attempt-work)
                         (get (get (get proof :parameter-value-premise) :cold-entry-derivation) :work-count)
                         (get (get proof :cold-body-derivation) :work-count) (get (get proof :return-witness) :work-count)]]
         (if (= 0 (count remaining)) true
           (if (integer? (first remaining)) (if (if (>= (first remaining) 0) (<= (first remaining) 65536) false)
                                              (recur (rest remaining)) false) false))) ])))


(defn p15-s23-ix-context [core facts bindings source-forms budget]
  (if (= false (p15-s23-is? facts))
    {:status :accepted :parameter-value-premise nil :work-count 0}
    (let [proof (get facts :recursive-proof)
          indexed? (= :gravity/sh08-indexed-private-self-value-proof-v1 (get proof :domain))
          record (p15-s23-pe-one (get core :function-records) :function-syntax-id (get proof :function-syntax-id))
          calls (get core :calls) targets (get core :recur-targets)
          prefix (+ 32 (count calls) (count targets) (count (get core :function-records)))]
      (if (> prefix budget) {:status :rejected :reason :typed-lowering-work-limit :work-count prefix}
        (let [args (loop [remaining calls total 0]
                     (if (= 0 (count remaining)) total
                       (recur (rest remaining) (+ total (count (get (first remaining) :argument-node-ids))))))
              slots (loop [remaining targets total 0]
                      (if (= 0 (count remaining)) total
                        (recur (rest remaining) (+ total (count (get (first remaining) :binding-ids))))))
              work (+ prefix (* 12 (count (get core :nodes))) (* 6 (count bindings)) (* 4 (count source-forms))
                      (* 6 (count (get core :definitions))) (* 6 (count (get core :lexical-bindings)))
                      (* 4 (count (get core :mutations))) (count (get core :var-references))
                      (* 3 (count (get core :reference-uses))) (* 3 (count (get (get core :preserved-resolution) :resolution-table)))
                      (count (get (get core :module) :exports)) (* 4 (count (get core :function-records)))
                      (* 6 args) (* (count (get core :recur-transfers)) (+ 1 (count targets) slots))
                      (* (count calls) (+ 40 (* 3 (count calls)) (count (get core :function-records))
                                        (* 4 (count (get record :parameter-binding-ids))))))]
          (if (> work budget) {:status :rejected :reason :typed-lowering-work-limit :work-count work}
            (if (= false (p15-s23-is-proof-valid? core facts))
              {:status :rejected :reason :private-self-source-proof-shape :work-count work}
            (let [nodes (p15-s23-typed-index (get core :nodes) :node-id) forms (p15-s23-typed-index source-forms :form-id)
                  census (p15-s23-is-private-census record core nodes bindings forms)
                  premise (get proof :parameter-value-premise)
                  cold-entry (get premise :cold-entry-derivation)
                  entries (get premise :entry-values)
                  cut (p15-s23-is-cold-cut core record nodes :entries (- budget work))
                  after-cut (+ work (get cut :work-count 0))]
              (if (if (= :accepted (get cut :status)) (map? census) false)
                (let [cold-types (p15-s23-is-entry-types census entries (get facts :type-table)
                                   (set (get cut :excluded-node-ids)) (- budget after-cut))
                      after-types (+ after-cut (get cold-types :work-count 0))
                      derived (if (= :accepted (get cold-types :status))
                                (if indexed?
                                  (p15-s23-ix-entry-values census nodes (get cold-types :types) forms (- budget after-types))
                                  (p15-s23-is-entry-values census nodes (get cold-types :types) (- budget after-types))) cold-types)
                      after-entries (+ after-types (if (= :accepted (get cold-types :status)) (get derived :work-count 0) 0))
                      induction (if (if indexed? (= :accepted (get derived :status)) false)
                                  (p15-s23-ix-source core census derived nodes bindings forms (- budget after-entries))
                                  {:status :not-applicable :work-count 0})
                      after-induction (+ after-entries (get induction :work-count 0))
                      body-cut (if (= :rejected (get induction :status)) induction
                                 (if (= :accepted (get derived :status))
                                   (p15-s23-is-cold-cut core record nodes :body (- budget after-induction)) derived))
                      after-body (+ after-induction (if (= :rejected (get induction :status)) 0
                                                     (if (= :accepted (get derived :status)) (get body-cut :work-count 0) 0)))
                      excluded (set (get body-cut :excluded-node-ids))
                      independent (loop [remaining (get core :nodes) out {}]
                                    (if (= 0 (count remaining)) out
                                      (let [id (get (first remaining) :node-id)]
                                        (recur (rest remaining)
                                          (if (contains? excluded id) out (assoc out id (get (get facts :type-table) id :gravity.type/unknown)))))))
                      witness (if indexed? (get induction :return-witness induction)
                                (if (= :accepted (get body-cut :status))
                                  (p15-s23-is-return-witness record nodes independent (- budget after-body)) body-cut))
                      total (+ after-body (if indexed? 0
                                            (if (= :accepted (get body-cut :status)) (get witness :work-count 0) 0)))
                      expected (if indexed?
                                 {:domain :gravity/sh08-indexed-private-self-entry-premise-v1
                                  :source-census census :entry-values derived :cold-entry-derivation cold-entry
                                  :source-induction (get induction :proof)
                                  :invalidation [:private-use-census :entry-call-sources :cold-value-dependencies
                                                 :parameter-bindings :mutations :function-records :source-induction]}
                                 {:domain :gravity/sh08-private-self-entry-parameter-premise-v1
                                  :source-census census :entry-values derived :cold-entry-derivation cold-entry
                                  :invalidation [:private-use-census :entry-call-sources :cold-value-dependencies
                                                 :parameter-bindings :mutations :function-records]})
                      row {:constraint-id-request {:domain (if indexed? :gravity/sh08-indexed-private-self-value-constraint-v1
                                                              :gravity/sh08-private-self-value-constraint-v1) :premise proof}
                           :kind (if indexed? :recursive-indexed-private-value :recursive-private-value)
                           :producer-rule (if indexed? :sh08-indexed-private-self-value-v1 :sh08-private-self-value-v1)
                           :lhs (get proof :function-syntax-id) :rhs (get proof :inferred-return-type) :dependencies proof
                           :profile (get (get core :module) :profile) :target (get (get core :module) :target)
                           :status :solved :diagnostics []}]
                  (if (> total budget) {:status :rejected :reason :typed-lowering-work-limit :work-count total}
                  (if (p15-s23-typed-all
                        [(= :accepted (get cold-types :status)) (= :accepted (get derived :status))
                         (= :accepted (get body-cut :status)) (= :accepted (get witness :status))
                         (p15-s23-is-proof-valid? core facts) (= expected premise)
                         (p15-s23-is-cold-metadata-valid? core facts record bindings source-forms cold-entry cut)
                         (p15-s23-is-cold-metadata-valid? core facts record bindings source-forms (get proof :cold-body-derivation) body-cut)
                         (= (p15-s23-is-source-cost core bindings source-forms record args slots)
                            {:prior-attempt-work (get proof :prior-attempt-work) :source-reservation-work (get proof :source-reservation-work)})
                         (= cut (get cold-entry :cut)) (= :entries (get cold-entry :mode))
                         (= body-cut (get (get proof :cold-body-derivation) :cut))
                         (= :body (get (get proof :cold-body-derivation) :mode))
                         (= witness (get proof :return-witness))
                         (= (get derived :parameter-types) (get proof :parameter-types))
                         (= [row] (p15-s23-pe-select (get facts :constraint-ledger) :producer-rule
                                    (if indexed? :sh08-indexed-private-self-value-v1 :sh08-private-self-value-v1)))
                         (= (+ (get proof :source-reservation-work) (get cold-entry :work-count) (get derived :work-count)
                               (get (get proof :cold-body-derivation) :work-count) (get witness :work-count)) (get proof :work-count))])
                    {:status :accepted :parameter-value-premise expected :proof proof :component (get proof :component) :work-count total}
                    {:status :rejected :reason :private-self-source-value-premise-mismatch :work-count total})))
                {:status :rejected :reason (if (= :rejected (get cut :status)) :typed-lowering-work-limit
                                            :private-self-source-census-mismatch) :work-count after-cut})))))))))

(defn p15-s23-ix-ir-proof [descriptor context]
  (let [range (if (= :sh08-indexed-private-self-unit-addition-v1 (get descriptor :version))
                (get descriptor :range-proof) (get (get descriptor :bounds-proof) :source-induction))
        params (get range :parameter-binding-ids)
        record (get range :function-record)
        names (loop [remaining params out []]
                (if (= 0 (count remaining)) out
                  (recur (rest remaining) (conj out (get (get context :locals) (first remaining))))))
        addition? (= :sh08-indexed-private-self-unit-addition-v1 (get descriptor :version))]
    {:kind (if addition? :gravity.runtime/indexed-private-self-unit-addition :gravity.runtime/indexed-private-self-vector-get)
     :version :sh08-indexed-private-self-runtime-v1
     :function-id (get record :function-syntax-id) :function-core-node-id (get record :function-core-node-id)
     :parameter-binding-ids params :parameter-names names
     :operation-core-node-id (get descriptor :call-core-node-id)
     :guard-core-node-id (get (get range :body-node) :node-id)
     :condition-core-node-id (get (get range :guard-call) :core-node-id)
     :count-core-node-id (get (get range :count-descriptor) :call-core-node-id)
     :access-core-node-id (get (get range :access-header) :call-core-node-id)
     :step-core-node-id (get (get range :step-header) :call-core-node-id)
     :unit-core-node-id (get (get range :unit-node) :node-id) :unit-source (get range :unit-source)
     :self-call-core-node-id (get (get range :self-call) :core-node-id)
     :vector-extent 7 :initial-index 0 :lower 0 :step 1
     :strict-access-edge :equality-false :numeric-mode :proof-required :integer-type :gravity.type/integer}))

(defn p15-s23-typed-compile-indexed-operation [context node budget]
  (let [core (get context :core) id (get node :node-id)
        charge (+ 80 (count (get core :function-records)) (count (get context :ledger)))]
    (if (> charge budget) (assoc (p15-s23-typed-node-error :typed-lowering-work-limit node) :work-count charge)
      (let [call (get (get context :calls) id) edge (get (get context :edges) id)
            nodes (get context :nodes) forms (get context :forms) types (get context :types)
            descriptor (get types (get call :operator-node-id))
            addition? (= :sh08-indexed-private-self-unit-addition-v1 (get descriptor :version))
            range (get (get core :sh08-private-self-parameter-premise) :source-induction)
            header (if addition? (p15-s23-si-source core node call edge nodes (get context :bindings) types (get core :module))
                                 (p15-s23-vl-source core node call edge nodes (get context :bindings) types (get core :module)))
            expected (if (map? header) (p15-s23-ix-finish header range node call nodes) nil)
            row (if addition? (p15-s23-si-constraint expected) (p15-s23-vn-constraint expected))]
        (if (p15-s23-typed-all
              [(= :accepted (get (get context :declared-self-context) :status))
               (= :gravity/sh08-indexed-private-self-entry-premise-v1
                  (get (get core :sh08-private-self-parameter-premise) :domain))
               (map? expected) (= expected descriptor)
               (= header (get range (if addition? :step-header :access-header)))
               (= (get (get context :current-function) :function-syntax-id) (get edge :caller-function-syntax-id)
                  (get (get range :function-record) :function-syntax-id))
               (= (get edge :ordinal) (get (get context :call-order) id))
               (= (get expected :result-type) (get types id))
               (p15-s23-ix-call-forms? node nodes forms)
               (= (get range :unit-source) (get forms (get (get (get range :unit-node) :source) :form-id)))
               (= [row] (p15-s23-pe-select (p15-s23-pe-select (get context :ledger) :producer-rule (get row :producer-rule)) :lhs (get row :lhs)))
               (= (if addition? (p15-s23-si-call-fact expected (get core :module)) (p15-s23-vn-call-fact expected (get core :module)))
                  (get (get context :call-facts) id))])
          (loop [remaining (get call :argument-node-ids) values [] used charge]
            (if (= 0 (count remaining))
              (assoc (p15-s23-compiler-result
                       {:op :builtin-call :function (if addition? '+ 'get) :args values
                        :proof (p15-s23-ix-ir-proof descriptor context)}) :work-count used)
              (let [operand (p15-s23-typed-compile-node (assoc context :tail? false) (first remaining) (- budget used))
                    total (+ used (get operand :work-count 0))]
                (if (p15-s23-compiler-complete? operand)
                  (recur (rest remaining) (conj values (get operand :value)) total)
                  (assoc operand :work-count total)))))
          (assoc (p15-s23-typed-node-error :unsupported-or-mismatched-indexed-private-source-operation node) :work-count charge))))))

(defn p15-s23-is? [facts]
  (contains? #{:gravity/sh08-private-self-value-proof-v1 :gravity/sh08-indexed-private-self-value-proof-v1}
    (get (get facts :recursive-proof) :domain)))

(defn p15-s23-is-proof-valid? [core facts]
  (if (= :gravity/sh08-indexed-private-self-value-proof-v1 (get (get facts :recursive-proof) :domain))
    (p15-s23-ix-proof-valid? core facts)
  (let [proof (get facts :recursive-proof) component (first (get core :recursion-components))
        id (first (get component :function-syntax-ids))
        record (p15-s23-pe-one (get core :function-records) :function-syntax-id id)
        function (p15-s23-pe-one (get facts :function-type-table) :function-id id)
        definition (p15-s23-pe-one (get core :definitions) :binding-id (get record :definition-binding-id))
        nodes (p15-s23-typed-index (get core :nodes) :node-id)
        edge (get (get core :call-edges) (first (get component :internal-call-edge-ordinals)))
        call (p15-s23-pe-one (get core :calls) :core-node-id (get edge :call-core-node-id))
        parameters (loop [remaining (get function :parameters) out []]
                     (if (= 0 (count remaining)) out
                       (recur (rest remaining) (conj out (get (first remaining) :type)))))
        owned (loop [remaining (get core :nodes) out []]
                (if (= 0 (count remaining)) out
                  (recur (rest remaining)
                    (if (= id (get (get (first remaining) :evaluation) :owner-function-syntax-id))
                      (conj out (get (first remaining) :node-id)) out))))
        incoming (loop [remaining (get core :call-edges) out []]
                   (if (= 0 (count remaining)) out
                     (recur (rest remaining)
                       (if (= id (get (first remaining) :callee-function-syntax-id))
                         (conj out (get (first remaining) :call-core-node-id)) out))))
        expected {:domain :gravity/sh08-private-self-value-proof-v1
                  :function-syntax-id id :function-core-node-id (get record :function-core-node-id)
                  :definition-binding-id (get record :definition-binding-id) :definition-syntax-id (get definition :syntax-id)
                  :body-core-node-id (get record :body-core-node-id) :parameter-binding-ids (get record :parameter-binding-ids)
                  :parameter-types parameters :inferred-return-type (get function :return)
                  :signature (get record :signature) :component component
                  :self-call-core-node-id (get call :core-node-id) :self-call call :self-edge edge
                  :self-call-source (get (get nodes (get call :core-node-id)) :source)
                  :owned-node-ids owned :incoming-call-node-ids incoming
                  :parameter-value-premise (get proof :parameter-value-premise)
                  :cold-body-derivation (get proof :cold-body-derivation) :return-witness (get proof :return-witness)
                  :value-inference :closed-private-monomorphic-normal-entries-and-return-witness
                  :value-check :complete-body-and-all-incoming-arguments :effect-error-status :pending-sh09-recursive-body
                  :captures :own-parameters-and-lexical-locals-only :prior-attempt-work (get proof :prior-attempt-work)
                  :source-reservation-work (get proof :source-reservation-work) :work-count (get proof :work-count)}]
    (p15-s23-typed-all
      [(= expected proof) (= [component] (get core :recursion-components))
       (= {:ordinal 0 :kind :self-recursive :function-syntax-ids [id]
           :function-core-node-ids [(get record :function-core-node-id)]
           :internal-call-edge-ordinals [(get edge :ordinal)]} component)
       (= :named-top-level (get record :definition-kind))
       (= (get record :fixed-arity) (count parameters) (count (get record :parameter-binding-ids)))
       (> (count parameters) 0) (<= (count parameters) 1024)
       (loop [remaining (conj parameters (get function :return))]
         (if (= 0 (count remaining)) true
           (if (p15-s23-ds-type? (first remaining)) (recur (rest remaining)) false)))
       (= (get record :signature) (get function :signature))
       (= [:pending-sh09] (get function :thrown-error-effects))
       (= id (get edge :caller-function-syntax-id) (get edge :callee-function-syntax-id)
          (get (get (get nodes (get call :core-node-id)) :evaluation) :owner-function-syntax-id))
       (= :local-function (get edge :classification))
       (= (get function :return) (get (get proof :return-witness) :return-type))
       (loop [remaining [(get proof :work-count) (get proof :source-reservation-work) (get proof :prior-attempt-work)
                         (get (get (get proof :parameter-value-premise) :cold-entry-derivation) :work-count)
                         (get (get proof :cold-body-derivation) :work-count) (get (get proof :return-witness) :work-count)]]
         (if (= 0 (count remaining)) true
           (if (integer? (first remaining)) (if (if (>= (first remaining) 0) (<= (first remaining) 65536) false)
                                              (recur (rest remaining)) false) false))) ]))))

; Match the finite cold entry projection to current C7-verified VALUE facts.
; An aborting entry never supplies a parameter seed; Unknown is retained there.
(defn p15-s23-is-entry-types [census claimed types excluded budget]
  (let [calls (get census :calls) rows (get claimed :entries)
        id (get (get census :function-record) :function-syntax-id)
        base (+ (count calls) (* (count calls) (if (vector? rows) (count rows) 0)))]
    (if (> base budget) {:status :rejected :reason :typed-lowering-work-limit :work-count base}
      (if (if (vector? rows) (= (count rows) (- (count calls) 1)) false)
        (loop [remaining calls edges (get census :edges) out {} work base]
          (if (= 0 (count remaining)) {:status :accepted :types out :work-count work}
            (let [call (first remaining) edge (first edges) args (get call :argument-node-ids)
                  row (p15-s23-pe-one rows :call-core-node-id (get call :core-node-id))
                  values (get row :argument-types) used (+ work 1 (* 5 (count args)))]
              (if (> used budget) {:status :rejected :reason :typed-lowering-work-limit :work-count used}
                (if (= id (get edge :caller-function-syntax-id))
                  (recur (rest remaining) (rest edges) out used)
                  (if (if (vector? values) (= (count args) (count values)) false)
                    (let [normal? (loop [remaining values]
                                    (if (= 0 (count remaining)) true
                                      (if (= :gravity.type/never (first remaining)) false (recur (rest remaining)))))
                          checked (loop [ids args remaining values result out]
                                    (if (= 0 (count ids)) result
                                      (let [node-id (first ids) value (first remaining) current (get types node-id :gravity.type/unknown)]
                                        (if (if (contains? result node-id) (= false (= value (get result node-id))) false) nil
                                          (if (if (p15-s23-ij-unknown? value) (= false normal?)
                                                (if (= value current) (= false (contains? excluded node-id)) false))
                                            (recur (rest ids) (rest remaining) (assoc result node-id value)) nil)))))]
                      (if (map? checked) (recur (rest remaining) (rest edges) checked used)
                        {:status :rejected :reason :private-self-entry-current-value-mismatch :work-count used}))
                    {:status :rejected :reason :private-self-entry-current-value-mismatch :work-count used}))))))
        {:status :rejected :reason :private-self-entry-coverage-mismatch :work-count base}))))

(defn p15-s23-is-context [core facts bindings source-forms budget]
  (if (= :gravity/sh08-indexed-private-self-value-proof-v1 (get (get facts :recursive-proof) :domain))
    (if (contains? #{:private-inferred-monomorphic-named-self-value :direct-imported-functions-types-only} (get facts :scope))
    (p15-s23-ix-context core facts bindings source-forms budget)
    {:status :rejected :reason :private-self-typed-scope-mismatch :work-count 0})
  (if (= false (p15-s23-is? facts))
    {:status :accepted :parameter-value-premise nil :work-count 0}
    (if (= false (contains? #{:private-inferred-monomorphic-named-self-value :direct-imported-functions-types-only} (get facts :scope)))
      {:status :rejected :reason :private-self-typed-scope-mismatch :work-count 0}
    (let [proof (get facts :recursive-proof) record (p15-s23-pe-one (get core :function-records) :function-syntax-id (get proof :function-syntax-id))
          calls (get core :calls) targets (get core :recur-targets)
          prefix (+ 32 (count calls) (count targets) (count (get core :function-records)))]
      (if (> prefix budget) {:status :rejected :reason :typed-lowering-work-limit :work-count prefix}
        (let [args (loop [remaining calls total 0]
                     (if (= 0 (count remaining)) total
                       (recur (rest remaining) (+ total (count (get (first remaining) :argument-node-ids))))))
              slots (loop [remaining targets total 0]
                      (if (= 0 (count remaining)) total
                        (recur (rest remaining) (+ total (count (get (first remaining) :binding-ids))))))
              work (+ prefix (* 12 (count (get core :nodes))) (* 6 (count bindings)) (* 4 (count source-forms))
                      (* 6 (count (get core :definitions))) (* 6 (count (get core :lexical-bindings)))
                      (* 4 (count (get core :mutations))) (count (get core :var-references))
                      (* 3 (count (get core :reference-uses))) (* 3 (count (get (get core :preserved-resolution) :resolution-table)))
                      (count (get (get core :module) :exports)) (* 4 (count (get core :function-records)))
                      (* 6 args) (* (count (get core :recur-transfers)) (+ 1 (count targets) slots))
                      (* (count calls) (+ 40 (* 3 (count calls)) (count (get core :function-records))
                                        (* 4 (count (get record :parameter-binding-ids))))))]
          (if (> work budget) {:status :rejected :reason :typed-lowering-work-limit :work-count work}
            (if (= false (p15-s23-is-proof-valid? core facts))
              {:status :rejected :reason :private-self-source-proof-shape :work-count work}
            (let [nodes (p15-s23-typed-index (get core :nodes) :node-id) forms (p15-s23-typed-index source-forms :form-id)
                  census (p15-s23-is-private-census record core nodes bindings forms)
                  premise (get proof :parameter-value-premise)
                  cold-entry (get premise :cold-entry-derivation)
                  entries (get premise :entry-values)
                  cut (p15-s23-is-cold-cut core record nodes :entries (- budget work))
                  after-cut (+ work (get cut :work-count 0))]
              (if (if (= :accepted (get cut :status)) (map? census) false)
                (let [cold-types (p15-s23-is-entry-types census entries (get facts :type-table)
                                   (set (get cut :excluded-node-ids)) (- budget after-cut))
                      after-types (+ after-cut (get cold-types :work-count 0))
                      derived (if (= :accepted (get cold-types :status))
                                (p15-s23-is-entry-values census nodes (get cold-types :types) (- budget after-types)) cold-types)
                      after-entries (+ after-types (if (= :accepted (get cold-types :status)) (get derived :work-count 0) 0))
                      body-cut (if (= :accepted (get derived :status))
                                 (p15-s23-is-cold-cut core record nodes :body (- budget after-entries)) derived)
                      after-body (+ after-entries (if (= :accepted (get derived :status)) (get body-cut :work-count 0) 0))
                      excluded (set (get body-cut :excluded-node-ids))
                      independent (loop [remaining (get core :nodes) out {}]
                                    (if (= 0 (count remaining)) out
                                      (let [id (get (first remaining) :node-id)]
                                        (recur (rest remaining)
                                          (if (contains? excluded id) out (assoc out id (get (get facts :type-table) id :gravity.type/unknown)))))))
                      witness (if (= :accepted (get body-cut :status))
                                (p15-s23-is-return-witness record nodes independent (- budget after-body)) body-cut)
                      total (+ after-body (if (= :accepted (get body-cut :status)) (get witness :work-count 0) 0))
                      expected {:domain :gravity/sh08-private-self-entry-parameter-premise-v1
                                :source-census census :entry-values derived :cold-entry-derivation cold-entry
                                :invalidation [:private-use-census :entry-call-sources :cold-value-dependencies
                                               :parameter-bindings :mutations :function-records]}
                      row {:constraint-id-request {:domain :gravity/sh08-private-self-value-constraint-v1 :premise proof}
                           :kind :recursive-private-value :producer-rule :sh08-private-self-value-v1
                           :lhs (get proof :function-syntax-id) :rhs (get proof :inferred-return-type) :dependencies proof
                           :profile (get (get core :module) :profile) :target (get (get core :module) :target)
                           :status :solved :diagnostics []}]
                  (if (> total budget) {:status :rejected :reason :typed-lowering-work-limit :work-count total}
                  (if (p15-s23-typed-all
                        [(= :accepted (get cold-types :status)) (= :accepted (get derived :status))
                         (= :accepted (get body-cut :status)) (= :accepted (get witness :status))
                         (p15-s23-is-proof-valid? core facts) (= expected premise)
                         (p15-s23-is-cold-metadata-valid? core facts record bindings source-forms cold-entry cut)
                         (p15-s23-is-cold-metadata-valid? core facts record bindings source-forms (get proof :cold-body-derivation) body-cut)
                         (= (p15-s23-is-source-cost core bindings source-forms record args slots)
                            {:prior-attempt-work (get proof :prior-attempt-work) :source-reservation-work (get proof :source-reservation-work)})
                         (= cut (get cold-entry :cut)) (= :entries (get cold-entry :mode))
                         (= body-cut (get (get proof :cold-body-derivation) :cut))
                         (= :body (get (get proof :cold-body-derivation) :mode))
                         (= witness (get proof :return-witness))
                         (= (get derived :parameter-types) (get proof :parameter-types))
                         (= [row] (p15-s23-pe-select (get facts :constraint-ledger) :producer-rule :sh08-private-self-value-v1))
                         (= (+ (get proof :source-reservation-work) (get cold-entry :work-count) (get derived :work-count)
                               (get (get proof :cold-body-derivation) :work-count) (get witness :work-count)) (get proof :work-count))])
                    {:status :accepted :parameter-value-premise expected :proof proof :component (get proof :component) :work-count total}
                    {:status :rejected :reason :private-self-source-value-premise-mismatch :work-count total})))
                {:status :rejected :reason (if (= :rejected (get cut :status)) :typed-lowering-work-limit
                                            :private-self-source-census-mismatch) :work-count after-cut})))))))))))

(defn p15-s23-ds-context [core typed nodes bindings budget]
  (let [components (get core :recursion-components []) proof (get typed :recursive-proof)]
    (if (= [] components)
      (if (= proof nil) {:status :accepted :component nil :work-count 0}
        {:status :rejected :reason :unexpected-recursive-proof :work-count 0})
      (let [records (get core :function-records) functions (get typed :function-type-table)
            calls (get core :calls) edges (get core :call-edges) lexical (get core :lexical-bindings)
            work (+ 32 (* 6 (count nodes)) (* 5 (count calls)) (* 5 (count edges))
                    (* 3 (count records)) (* 3 (count functions)) (* 2 (count bindings))
                    (* 3 (count lexical)) (count (get typed :constraint-ledger)))]
        (if (> work budget) {:status :rejected :reason :typed-lowering-work-limit :work-count work}
          (let [id (get proof :function-syntax-id)
                record (get (p15-s23-typed-index records :function-syntax-id) id)
                function (get (p15-s23-typed-index functions :function-id) id)
                definitions (p15-s23-typed-index (get core :definitions) :binding-id)
                definition (get definitions (get record :definition-binding-id))
                signature (get record :signature) declarations (get signature :parameters)
                parameters (loop [remaining declarations out []]
                             (if (= 0 (count remaining)) out
                               (recur (rest remaining) (conj out (get (first remaining) :type-id)))))
                component (first components) ordinal (first (get component :internal-call-edge-ordinals))
                edge (if (integer? ordinal) (get edges ordinal) nil)
                call (get (p15-s23-typed-index calls :core-node-id) (get edge :call-core-node-id))
                self (get nodes (get call :core-node-id))
                incoming (loop [remaining edges out []]
                           (if (= 0 (count remaining)) out
                             (recur (rest remaining)
                               (if (= id (get (first remaining) :callee-function-syntax-id))
                                 (conj out (get (first remaining) :call-core-node-id)) out))))
                owned (loop [remaining (get core :nodes) out []]
                        (if (= 0 (count remaining)) out
                          (recur (rest remaining)
                            (if (= id (get (get (first remaining) :evaluation) :owner-function-syntax-id))
                              (conj out (get (first remaining) :node-id)) out))))
                local-ids (loop [remaining lexical out (set (get record :parameter-binding-ids))]
                            (if (= 0 (count remaining)) out
                              (let [local (first remaining)]
                                (recur (rest remaining)
                                  (if (= id (get (get (get nodes (get local :let-core-node-id)) :evaluation) :owner-function-syntax-id))
                                    (conj out (get local :binding-id)) out)))))
                argument-work (loop [remaining calls total 0]
                                (if (= 0 (count remaining)) total
                                  (recur (rest remaining) (+ total (* 2 (count (get (first remaining) :argument-node-ids)))))))
                c7-work (+ 32 (* 8 (count nodes)) (* 8 (count calls)) (* 4 (count edges))
                           (* 4 (count bindings)) (* 4 (count records)) (* 4 (count lexical))
                           argument-work (* (count calls) (count bindings)))
                expected {:domain :gravity/sh08-declared-self-value-proof-v1
                          :function-syntax-id id :function-core-node-id (get record :function-core-node-id)
                          :definition-binding-id (get record :definition-binding-id) :definition-syntax-id (get definition :syntax-id)
                          :body-core-node-id (get record :body-core-node-id) :parameter-binding-ids (get record :parameter-binding-ids)
                          :parameter-types parameters :declared-return-type (get (get signature :return) :type-id)
                          :signature signature :component component :self-call-core-node-id (get call :core-node-id)
                          :self-call call :self-edge edge :self-call-source (get self :source)
                          :owned-node-ids owned :incoming-call-node-ids incoming
                          :value-check :complete-body-and-all-incoming-arguments
                          :effect-error-status :pending-sh09-recursive-body :captures :own-parameters-and-lexical-locals-only
                          :work-count c7-work}
                captures? (loop [remaining (get core :nodes)]
                            (if (= 0 (count remaining)) true
                              (let [node (first remaining) bid (get (get node :attributes) :binding-id) binding (get bindings bid)]
                                (if (if (= id (get (get node :evaluation) :owner-function-syntax-id))
                                      (if (contains? #{:try :loop :recur} (get node :core-form)) false
                                        (if (= :reference (get node :core-form))
                                          (if (contains? local-ids bid) true
                                            (if (= bid (get record :definition-binding-id))
                                              (= (get node :node-id) (first (get self :children)))
                                              (= [:core :var 'gravity.core]
                                                 [(get binding :binding-class) (get binding :kind) (get binding :namespace)]))) true)) true)
                                  (recur (rest remaining)) false))))]
            (if (p15-s23-typed-all
                  [(= expected proof)
                   (= :declared-monomorphic-named-self-value (get typed :scope))
                   (= [component] components (get (get typed :function-products) :recursion-components))
                   (= {:ordinal 0 :kind :self-recursive :function-syntax-ids [id]
                       :function-core-node-ids [(get record :function-core-node-id)] :internal-call-edge-ordinals [ordinal]} component)
                   (= :named-top-level (get record :definition-kind))
                   (if (integer? (get record :fixed-arity)) (if (> (get record :fixed-arity) 0) (<= (get record :fixed-arity) 1024) false) false)
                   (= (get record :fixed-arity) (count parameters) (count (get record :parameter-binding-ids)))
                   (p15-s23-ds-type? (get (get signature :return) :type-id))
                   (loop [remaining parameters]
                     (if (= 0 (count remaining)) true
                       (if (p15-s23-ds-type? (first remaining)) (recur (rest remaining)) false)))
                   (= signature (get function :signature))
                   (= parameters (loop [remaining (get function :parameters) out []]
                                   (if (= 0 (count remaining)) out
                                     (recur (rest remaining) (conj out (get (first remaining) :type))))))
                   (= (get function :return) (get (get signature :return) :type-id))
                   (= [:pending-sh09] (get function :thrown-error-effects))
                   (= id (get edge :caller-function-syntax-id) (get edge :callee-function-syntax-id)
                      (get (get self :evaluation) :owner-function-syntax-id))
                   (= :local-function (get edge :classification)) captures?
                   (= 1 (loop [remaining edges total 0]
                          (if (= 0 (count remaining)) total
                            (recur (rest remaining)
                              (if (= id (get (first remaining) :caller-function-syntax-id) (get (first remaining) :callee-function-syntax-id))
                                (+ total 1) total)))))])
              {:status :accepted :proof proof :component component :work-count work}
              {:status :rejected :reason :declared-self-source-join-mismatch :work-count work})))))))

(defn p15-s23-ds-call-allowed? [context call edge]
  (if (= [] (get context :recursion-components)) true
    (let [checked (get context :declared-self-context) proof (get checked :proof)
          id (get proof :function-syntax-id)]
      (if (p15-s23-typed-all [(= :accepted (get checked :status))
                            (contains? #{:gravity/sh08-declared-self-value-proof-v1 :gravity/sh08-private-self-value-proof-v1 :gravity/sh08-indexed-private-self-value-proof-v1}
                              (get proof :domain))
                            (= [(get checked :component)] (get context :recursion-components))
                            (= edge (get (get (get context :core) :call-edges) (get edge :ordinal)))
                            (= call (get (get (get context :core) :calls) (get edge :ordinal)))])
        (if (= (get edge :caller-function-syntax-id) (get edge :callee-function-syntax-id))
          (p15-s23-typed-all [(= id (get edge :caller-function-syntax-id))
                             (= (get call :core-node-id) (get proof :self-call-core-node-id))
                             (= edge (get proof :self-edge))])
          true) false))))

(defn p15-s23-typed-context [module input observation]
  (if (if (map? module) (map? input) false)
  (let [request (get input :request) typed (get input :typed) supplied (get input :verification)
        fresh (get observation :verification) core (get request :canonical-core-artifact)
        authenticated (p15-s23-typed-path request [:b47-context :authenticated-core-request])
        macro-artifact (p15-s23-typed-path request [:b47-context :authenticated-wrapper :sh06-resolution-artifact :sh05-macro-artifact])
        reader (p15-s23-typed-path macro-artifact [:gravity-macro-boundary :authenticated-sh04-artifact :c2-reader-artifact])
        source (get observation :source) source-unit (get reader :source-unit-record)
        nodes (get core :nodes) forms (get authenticated :forms) bindings (get authenticated :binding-table)
        roots (get authenticated :top-level-form-ids) core-roots (get core :root-core-node-ids) raw (get module :forms)
        records (get core :function-records) functions (get typed :function-type-table)
        ledger (get typed :constraint-ledger []) handlers (get core :error-handlers [])
        lexical (get core :lexical-bindings []) local-facts (get typed :local-binding-facts [])
        calls (get core :calls []) edges (get core :call-edges []) call-facts (get typed :call-type-facts [])
        recursive (get core :recursion-components [])
        loop-bindings (get core :loop-bindings []) targets (get core :recur-targets []) transfers (get core :recur-transfers [])
        families? (p15-s23-typed-all [(vector? (get reader :token-stream)) (vector? nodes) (vector? forms) (vector? bindings)
                                     (vector? roots) (vector? core-roots) (vector? raw)
                                     (vector? records) (vector? functions) (map? (get typed :type-table))
                                     (vector? ledger) (vector? handlers) (vector? lexical) (vector? local-facts)
                                     (vector? calls) (vector? edges) (vector? call-facts) (vector? recursive)
                                     (vector? loop-bindings) (vector? targets) (vector? transfers)])
        base-work (if families? (+ (if (string? (get source :text)) (count (get source :text)) 0)
                (count (get reader :token-stream)) (count nodes) (count forms) (count bindings)
                (* (count records) (+ 20 (count nodes) (count forms) (count bindings)))
                (* (count calls) (+ 20 (count nodes) (count forms) (count bindings)))
                (* (+ 1 (count nodes)) (+ (count ledger) (count handlers) (count lexical) (count local-facts)
                                         (count calls) (count edges) (count call-facts) (count recursive)))) 65537)
        work (if families? (+ base-work (count raw) (count roots) (count core-roots) (count forms)
                              (* (+ 1 (count nodes)) (+ (count loop-bindings) (count targets) (count transfers)))) base-work)]
    (if (= false families?) (p15-s23-typed-error :malformed-typed-input-families)
    (if (> work 65536) (p15-s23-typed-error :typed-lowering-work-limit)
    (if (p15-s23-typed-all
          [(map? input) (if (if (map? input) (= 3 (count input)) false) (= #{:request :typed :verification} (set (keys input))) false)
           (map? module) (vector? (get module :forms))
           (set? (p15-s23-typed-set (get module :effects))) (set? (p15-s23-typed-set (get module :capabilities)))
           (set? (p15-s23-typed-set (get module :exports)))
           (= :accepted (get typed :status))
           (= :gravity/sh08-function-type-verification (get fresh :artifact)) (= :passed (get fresh :status))
           (= typed (get fresh :expected) (get fresh :candidate)) (= supplied fresh)
           (= (get core :artifact-id) (get typed :sh07-shaped-artifact-id))
           (= (get core :module) (get typed :module) (get authenticated :module))
           (= (get module :module) (get (get core :module) :namespace))
           (= (get module :profile) (get (get core :module) :profile))
           (= (get module :target) (get (get core :module) :target))
           (= (get module :safety) (get (get core :module) :safety))
           (= (p15-s23-typed-set (get module :effects)) (p15-s23-typed-set (get (get core :module) :effects)))
           (= (p15-s23-typed-set (get module :capabilities)) (p15-s23-typed-set (get (get core :module) :capabilities)))
           (= (p15-s23-typed-set (get module :exports)) (p15-s23-typed-set (get (get core :module) :exports)))
           (= (get module :forms) (get macro-artifact :expanded-forms))
           (string? (get source :text)) (string? (get source :path))
           (= (get module :source-path) (get source :path) (get source-unit :path))
           (if (contains? module :source-text) (= (get module :source-text) (get source :text)) true)
           (= (get source :sha256) (get source-unit :bytes-hash))])
        (if (p15-s23-typed-source-equal? (get reader :token-stream) (get source :text))
          (let [node-index (p15-s23-typed-index nodes :node-id) form-index (p15-s23-typed-index forms :form-id)
                binding-index (p15-s23-typed-index bindings :binding-id)
                record-index (p15-s23-typed-index records :definition-name)
                function-index (p15-s23-typed-index functions :definition-name)
                lexical-index (p15-s23-typed-index lexical :binding-id) fact-index (p15-s23-typed-index local-facts :binding-id)
                call-index (p15-s23-typed-index calls :core-node-id) edge-index (p15-s23-typed-index edges :call-core-node-id)
                call-fact-index (p15-s23-typed-index call-facts :call-core-node-id)
                loop-index (p15-s23-typed-index loop-bindings :binding-id) target-index (p15-s23-typed-index targets :target-id)
                owner-index (p15-s23-typed-index targets :owner-core-node-id) transfer-index (p15-s23-typed-index transfers :recur-core-node-id)
                loop-rows (p15-s23-typed-loop-row-index ledger)
                raw-roots (p15-s23-typed-raw-roots raw roots core-roots node-index form-index)
                owner-ids (loop [remaining nodes out #{}]
                            (if (= 0 (count remaining)) out
                              (let [node (first remaining)]
                                (recur (rest remaining) (if (if (= :loop (get node :core-form)) true
                                     (if (= :fn (get node :core-form)) (if (map? (get node :attributes)) (contains? (get node :attributes) :recur-target-id) false) false))
                                     (conj out (get node :node-id)) out)))))
                transfer-ids (loop [remaining nodes out #{}]
                               (if (= 0 (count remaining)) out (recur (rest remaining)
                                 (if (= :recur (get (first remaining) :core-form)) (conj out (get (first remaining) :node-id)) out))))
                call-ids (loop [remaining nodes out #{}]
                           (if (= 0 (count remaining)) out
                             (recur (rest remaining) (if (= :call (get (first remaining) :core-form)) (conj out (get (first remaining) :node-id)) out))))
                core (assoc core :sh08-private-self-parameter-premise nil)
                declared (if (p15-s23-is? typed)
                           (p15-s23-is-context core typed binding-index forms (- 65536 work))
                           (p15-s23-ds-context core typed node-index binding-index (- 65536 work)))
                core (assoc core :sh08-private-self-parameter-premise
                       (if (= :accepted (get declared :status)) (get declared :parameter-value-premise) nil))
                returns (if (= :accepted (get declared :status))
                          (p15-s23-lr-context core typed binding-index form-index (- 65536 work (get declared :work-count))) declared)
                joins (if (= :accepted (get returns :status))
                        (p15-s23-ij-context core typed binding-index form-index
                          (- 65536 work (get declared :work-count) (get returns :work-count))) returns)]
            (if (= :rejected (get joins :status))
              (assoc (p15-s23-typed-error (get joins :reason)) :work-count
                  (+ work (get declared :work-count 0)
                     (if (= :accepted (get declared :status)) (get returns :work-count) 0)
                     (if (= :accepted (get returns :status)) (get joins :work-count) 0)))
            (if (p15-s23-typed-all [(map? node-index) (map? form-index) (map? binding-index)
                                   (map? record-index) (map? function-index) (= (count record-index) (count function-index))
                                   (map? raw-roots)
                                   (map? lexical-index) (map? fact-index)
                                   (= (set (keys lexical-index)) (set (keys fact-index)))
                                   (= lexical (get (get typed :function-products) :lexical-bindings []))
                                   (map? call-index) (map? edge-index) (map? call-fact-index)
                                   (= call-ids (set (keys call-index)) (set (keys edge-index)) (set (keys call-fact-index)))
                                   (= edges (get (get typed :function-products) :call-edges []))
                                    (map? loop-index) (map? target-index) (map? owner-index) (map? transfer-index)
                                    (map? loop-rows)
                                    (= (set (keys loop-index)) (loop [remaining (keys loop-rows) out #{}]
                                      (if (= 0 (count remaining)) out (recur (rest remaining)
                                        (if (= :loop-slot-type (first (first remaining))) (conj out (get (first remaining) 1)) out)))))
                                    (= (set (keys transfer-index)) (loop [remaining (keys loop-rows) out #{}]
                                      (if (= 0 (count remaining)) out (recur (rest remaining)
                                        (if (= :loop-recur-type (first (first remaining))) (conj out (get (first remaining) 1)) out)))))
                                    (= owner-ids (set (keys owner-index))) (= transfer-ids (set (keys transfer-index)))])
              (p15-s23-compiler-result {:core core :typed typed :nodes node-index :forms form-index :bindings binding-index :raw-roots raw-roots
                :source-root-form-ids roots
                :records record-index :functions function-index :types (get typed :type-table)
                :observation observation :ledger ledger :error-handlers handlers :lexical lexical :local-facts fact-index
                :calls call-index :edges edge-index :call-facts call-fact-index :recursion-components recursive
                :declared-self-context declared
                :loop-bindings loop-bindings :loop-binding-index loop-index :loop-rows loop-rows
                :targets target-index :target-owners owner-index :transfers transfer-index
                :call-order (loop [remaining calls i 0 out {}]
                              (if (= 0 (count remaining)) out (recur (rest remaining) (+ i 1) (assoc out (get (first remaining) :core-node-id) i))))
                :if-join-context (get joins :context) :return-context (get returns :context)
                :budget (- 65536 work (get declared :work-count) (get returns :work-count) (get joins :work-count))})
              (p15-s23-typed-error :typed-source-index-census))))
          (p15-s23-typed-error :typed-source-bytes-mismatch))
      (p15-s23-typed-error :typed-input-source-or-verification-mismatch)))))
    (p15-s23-typed-error :malformed-typed-input-families)))

(defn p15-s23-lr-declaration? [declaration bindings]
  (if (map? declaration)
    (let [constructor (get bindings (get declaration :type-binding-id))
          member (get bindings (get declaration :element-binding-id))]
      (p15-s23-typed-all
        [(symbol? (get declaration :constructor-reference-symbol)) (symbol? (get declaration :element-reference-symbol))
         (= #{:rule-version :source-child-index :marker-form-id :marker-syntax-id :type-form-id :type-syntax-id
               :type-symbol :type-binding-id :type-id :constructor-form-id :constructor-syntax-id
               :element-form-id :element-syntax-id :element-symbol :element-binding-id
               :constructor-reference-symbol :element-reference-symbol} (set (keys declaration)))
         (= :sh07-list-return-declaration-v1 (get declaration :rule-version))
         (= ['List :core :type 'gravity.core] [(get constructor :name) (get constructor :binding-class)
                                             (get constructor :kind) (get constructor :namespace)])
         (= [:core :type 'gravity.core] [(get member :binding-class) (get member :kind) (get member :namespace)])
         (= ['List (get member :name)] [(get declaration :type-symbol) (get declaration :element-symbol)])
         (p15-s23-hl-type? (get declaration :type-id))
         (= (get (get declaration :type-id) :element-type) (p15-s23-typed-atomic-id (get member :name)))
         (if (integer? (get declaration :source-child-index)) (>= (get declaration :source-child-index) 0) false)
         (loop [ids [(get declaration :marker-form-id) (get declaration :marker-syntax-id)
           (get declaration :type-form-id) (get declaration :type-syntax-id) (get declaration :type-binding-id)
           (get declaration :constructor-form-id) (get declaration :constructor-syntax-id)
           (get declaration :element-form-id) (get declaration :element-syntax-id) (get declaration :element-binding-id)]]
           (if (= 0 (count ids)) true (if (string? (first ids)) (recur (rest ids)) false)))])) false))

(defn p15-s23-lr-source [form]
  {:form-id (get form :form-id) :syntax-id (get form :syntax-id) :semantic-span (get form :source-span)
   :origin-chain (get form :origin-chain) :generated-origin (get form :generated-origin)})

(defn p15-s23-lr-type-work [declared actual budget]
  (let [members (if (map? actual) (get actual :element-types) nil)
        finite? (if (map? actual) (= [:gravity.type/list :literal] [(get actual :kind) (get actual :shape)]) false)
        member-work (if (if finite? (vector? members) false) (count members) 0)
        base (+ 1 member-work)]
    (if (> base budget) {:status :rejected :reason :list-return-work-limit :work-count base}
      (if (= false (p15-s23-hl-type? declared))
        {:status :rejected :reason :list-return-declaration-required :work-count base}
        (let [validation (p15-s23-lc-type-work [actual declared] (- budget base))
              work (+ base (get validation :work-count))]
          (if (= :accepted (get validation :status))
            (let [relation (if (= actual :gravity.type/never) :non-returning-bottom
                             (if (= actual declared) :homogeneous-list-identity
                               (if finite?
                                 (if (loop [remaining members]
                                       (if (= 0 (count remaining)) true
                                         (if (= (first remaining) (get declared :element-type))
                                           (recur (rest remaining)) false))) :all-positional-elements-match nil) nil)))]
              (if (= relation nil)
                {:status :rejected :reason :homogeneous-list-return-incompatible :work-count work}
                {:status :accepted :relation relation :work-count work :member-work member-work
                 :type-work (get validation :work-count) :checked-member-count (if finite? (count members) nil)}))
            {:status :rejected :reason (if (= :work-limit (get validation :reason)) :list-return-work-limit :homogeneous-list-return-incompatible)
             :type-check-reason (get validation :reason) :work-count work}))))))

(defn p15-s23-lr-derive [core record function nodes types bindings forms budget]
  (let [signature (get record :signature) declaration (get signature :return)
        declared (get declaration :type-id) body-id (get record :body-core-node-id)
        actual (get types body-id :gravity.type/unknown)
        base (+ 64 (if (vector? (get signature :parameters)) (count (get signature :parameters)) 0))]
    (if (> base budget) {:status :rejected :reason :list-return-work-limit :work-count base}
      (let [validation (p15-s23-lr-type-work declared actual (- budget base)) work (+ base (get validation :work-count))]
        (if (= :accepted (get validation :status))
          (let [fn-node (get nodes (get record :function-core-node-id)) body (get nodes body-id)
                fn-form (get forms (get (get fn-node :source) :form-id))
                body-form (get forms (get (get body :source) :form-id))
                ids (get fn-form :child-form-ids) parameter-form (get forms (get ids 1))
                marker (get forms (get declaration :marker-form-id)) application (get forms (get declaration :type-form-id))
                constructor (get forms (get declaration :constructor-form-id)) member (get forms (get declaration :element-form-id))
                type-binding (get bindings (get declaration :type-binding-id))
                element-binding (get bindings (get declaration :element-binding-id))
                definition-binding (get bindings (get record :definition-binding-id))]
            (if (p15-s23-typed-all
                  [(p15-s23-lr-declaration? declaration bindings)
                   (= :fn (get fn-node :core-form)) (= [body-id] (get fn-node :children))
                   (= :list (get fn-form :kind)) (vector? ids) (= 5 (if (vector? ids) (count ids) 0))
                   (= (get record :function-syntax-id) (get function :function-id) (get (get fn-node :source) :syntax-id))
                   (= (get record :function-core-node-id) (get function :function-core-node-id))
                   (= body-id (get function :body-core-node-id) (get body :node-id))
                   (= (get record :function-form-id) (get fn-form :form-id))
                   (= signature (get function :signature) (get (get fn-node :attributes) :signature))
                   (= declared (get function :return))
                   (= [2 4] [(get declaration :source-child-index) (get signature :body-source-child-index)])
                   (= [(get marker :form-id) (get application :form-id) (get body-form :form-id)]
                      [(get ids 2) (get ids 3) (get ids 4)])
                   (= [(get marker :kind) (get marker :value)] [:keyword ':-])
                   (= (get marker :syntax-id) (get declaration :marker-syntax-id))
                   (= :list (get application :kind))
                   (= [(get constructor :form-id) (get member :form-id)] (get application :child-form-ids))
                   (= (get application :syntax-id) (get declaration :type-syntax-id))
                   (= (get constructor :syntax-id) (get declaration :constructor-syntax-id))
                   (= (get member :syntax-id) (get declaration :element-syntax-id))
                   (= (get fn-form :form-id) (get marker :parent-form-id) (get application :parent-form-id) (get body-form :parent-form-id))
                   (= (get application :form-id) (get constructor :parent-form-id) (get member :parent-form-id))
                   (= (get application :scope-id) (get constructor :scope-id) (get member :scope-id) (get parameter-form :scope-id))
                   (= :symbol (get constructor :kind) (get member :kind))
                   (= [(get constructor :value) (get member :value)]
                      [(get declaration :constructor-reference-symbol) (get declaration :element-reference-symbol)])
                   (= (get fn-node :source) (p15-s23-lr-source fn-form))
                   (= (get body :source) (p15-s23-lr-source body-form))
                   (= (get record :definition-binding-id) (get definition-binding :binding-id))
                   (= (get record :definition-name) (get definition-binding :name))])
              {:status :accepted :work-count work
               :premise {:version :sh08-homogeneous-list-return-v1 :relation (get validation :relation)
                         :function-id (get function :function-id) :function-core-node-id (get record :function-core-node-id)
                         :body-core-node-id body-id :actual-body-type actual :declared-return-type declared
                         :declaration declaration :function-record record :definition-binding definition-binding
                         :type-binding type-binding :element-binding element-binding
                         :function-source (get fn-node :source) :body-source (get body :source)
                         :return-source (p15-s23-lr-source application) :constructor-source (p15-s23-lr-source constructor)
                         :element-source (p15-s23-lr-source member)
                         :checked-element-type (get declared :element-type) :checked-element-count (get validation :checked-member-count)
                         :type-work (get validation :type-work) :member-work (get validation :member-work)
                         :normal-completion? (= false (= actual :gravity.type/never))
                         :forgets (if (= :all-positional-elements-match (get validation :relation)) [:static-length] [])
                         :preserves [:value :actual-body-type :provenance :schema :ownership :linearity :regions :effects :allocation-obligations]
                         :profile (get (get core :module) :profile) :target (get (get core :module) :target)}}
              {:status :rejected :reason :list-return-source-mismatch :work-count work}))
          (assoc validation :work-count work))))))

(defn p15-s23-lr-row [premise]
  {:constraint-id-request {:domain :gravity/sh08-homogeneous-list-return-constraint-v1 :return-compatibility premise}
   :kind :return-compatibility :producer-rule :sh08-homogeneous-list-return-v1
   :lhs {:function-id (get premise :function-id) :body-core-node-id (get premise :body-core-node-id) :role :return}
   :rhs {:actual-body-type (get premise :actual-body-type) :declared-return-type (get premise :declared-return-type)}
   :dependencies premise
   :solution {:return-type (get premise :declared-return-type) :actual-body-type (get premise :actual-body-type)
              :normal-completion? (get premise :normal-completion?)}
   :invalidation [:function-records :function-signature :body-core-node :body-type :return-declaration :source-forms
                  :type-bindings :definition-binding :profile :target]
   :profile (get premise :profile) :target (get premise :target) :status :solved :diagnostics []})

(defn p15-s23-lr-context [core facts bindings source-forms budget]
  (let [records (get core :function-records) ledger (get facts :constraint-ledger)
        scan (+ (count records) (count ledger))]
    (if (> scan budget) {:status :rejected :reason :list-return-work-limit :work-count scan}
      (let [rows (loop [remaining ledger out []]
                   (if (= 0 (count remaining)) out
                     (let [row (first remaining)]
                       (recur (rest remaining)
                         (if (if (= :sh08-homogeneous-list-return-v1 (get row :producer-rule)) true
                               (= :return-compatibility (get row :kind))) (conj out row) out)))))
            active? (loop [remaining records]
                      (if (= 0 (count remaining)) false
                        (if (= :sh07-list-return-declaration-v1 (get (get (get (first remaining) :signature) :return) :rule-version))
                          true (recur (rest remaining)))))]
        (if (= false active?)
          (if (= [] rows) {:status :accepted :work-count scan :context {:premises {}}}
            {:status :rejected :reason :list-return-constraint-census :work-count scan})
          (let [base (+ scan (count (get core :nodes)) (count (get facts :function-type-table))
                        (if (map? source-forms) 0 (count source-forms)))]
            (if (> base budget) {:status :rejected :reason :list-return-work-limit :work-count base}
              (let [nodes (p15-s23-typed-index (get core :nodes) :node-id)
                    functions (p15-s23-typed-index (get facts :function-type-table) :function-id)
                    forms (if (map? source-forms) source-forms (p15-s23-typed-index source-forms :form-id))
                    types (get facts :type-table)]
                (if (= false (= (count functions) (count records) (count (get facts :function-type-table))))
                  {:status :rejected :reason :list-return-function-census :work-count base}
                  (loop [remaining records used base expected [] premises {}]
                    (if (= 0 (count remaining))
                      (if (= expected rows) {:status :accepted :work-count used :context {:premises premises}}
                        {:status :rejected :reason :list-return-constraint-census :work-count used})
                      (let [record (first remaining) id (get record :function-syntax-id) function (get functions id)]
                        (if (= :sh07-list-return-declaration-v1 (get (get (get record :signature) :return) :rule-version))
                          (let [checked (p15-s23-lr-derive core record function nodes types bindings forms (- budget used))
                                total (+ used (get checked :work-count)) premise (get checked :premise)]
                            (if (= :accepted (get checked :status))
                              (if (if (= (get function :return-actual-type) (get types (get record :body-core-node-id)))
                                    (= premise (get function :return-compatibility)) false)
                                (recur (rest remaining) total (conj expected (p15-s23-lr-row premise)) (assoc premises id premise))
                                {:status :rejected :reason :list-return-function-evidence :work-count total})
                              (assoc checked :work-count total)))
                          (if (if (contains? function :return-compatibility) true (contains? function :return-actual-type))
                            {:status :rejected :reason :list-return-function-evidence :work-count used}
                            (recur (rest remaining) used expected premises)))))))))))))))

(defn p15-s23-ij-unknown? [type]
  (if (= type nil) true (= type :gravity.type/unknown)))

; L5 canonical-if fallback: branch evidence supplies T, never an expected return.
(defn p15-s23-ni-atomic? [type]
  (contains? #{:gravity.type/bool :gravity.type/character :gravity.type/string :gravity.type/symbol :gravity.type/keyword} type))

(defn p15-s23-ni-tagged? [type]
  (if (map? type) (= :gravity.type/nil-or (get type :kind)) false))

(defn p15-s23-ni-type? [type]
  (if (p15-s23-ni-tagged? type)
    (if (= 2 (count type))
      (if (= #{:kind :value-type} (set (keys type))) (p15-s23-ni-atomic? (get type :value-type)) false) false) false))

(defn p15-s23-ni-valid-view? [type]
  (if (p15-s23-ni-tagged? type) (p15-s23-ni-type? type) true))

(defn p15-s23-ni-candidate? [left right]
  (if (= :gravity.type/nil left) true
    (if (= :gravity.type/nil right) true
      (if (p15-s23-ni-tagged? left) true (p15-s23-ni-tagged? right)))))

(defn p15-s23-ni-branch [type]
  (if (= :gravity.type/nil type) {:relation :nil-alternative :value-type nil}
    (if (p15-s23-ni-atomic? type) {:relation :atomic-alternative :value-type type}
      (if (p15-s23-ni-type? type) {:relation :nil-or-identity :value-type (get type :value-type)} nil))))

(defn p15-s23-ni-type-work [left right budget]
  (if (< budget 4) {:status :rejected :reason :list-if-join-work-limit :work-count 4}
    (let [a (p15-s23-ni-branch left) b (p15-s23-ni-branch right)
          x (get a :value-type) y (get b :value-type) value (if (= x nil) y x)]
      (if (if (p15-s23-ni-candidate? left right)
            (if (map? a) (if (map? b)
              (if (= value nil) false (if (= x nil) true (if (= y nil) true (= x y)))) false) false) false)
        {:status :accepted :join-family :nil-or :type {:kind :gravity.type/nil-or :value-type value}
         :branch-types [left right] :branch-compatibility [a b] :nil-type :gravity.type/nil :value-type value :work-count 4}
        {:status :not-applicable :reason :independent-nil-or-atomic-required :work-count 4}))))

(defn p15-s23-ij-atomic? [type]
  (if (keyword? type)
    (p15-s23-hl-type? {:kind :gravity.type/list :shape :homogeneous :element-type type}) false))

(defn p15-s23-ij-element [type budget]
  (let [members (if (map? type) (get type :element-types) nil)
        finite? (if (map? type)
                  (if (= 3 (count type))
                    (if (= #{:kind :shape :element-types} (set (keys type)))
                      (= [:gravity.type/list :literal] [(get type :kind) (get type :shape)]) false) false) false)
        width (if (if finite? (vector? members) false) (count members) 0)
        work (+ 1 width)]
    (if (> work budget) {:status :rejected :reason :list-if-join-work-limit :work-count work}
      (if (if (map? type) (keyword? (get type :element-type)) false)
        (if (p15-s23-hl-type? type)
          {:status :accepted :element-type (get type :element-type) :relation :homogeneous-list-identity
           :checked-member-count nil :work-count work}
          {:status :not-applicable :reason :independent-list-element-required :work-count work})
        (if (if finite? (if (vector? members) (<= width 1024) false) false)
          (if (= width 0)
            {:status :accepted :element-type nil :relation :empty-positional-list :checked-member-count 0 :work-count work}
            (let [element (first members)]
              (if (p15-s23-ij-atomic? element)
                (if (loop [remaining members]
                      (if (= 0 (count remaining)) true
                        (if (= element (first remaining)) (recur (rest remaining)) false)))
                  {:status :accepted :element-type element :relation :all-positional-elements-match
                   :checked-member-count width :work-count work}
                  {:status :not-applicable :reason :incompatible-list-elements :work-count work})
                {:status :not-applicable :reason :independent-atomic-element-required :work-count work})))
          {:status :not-applicable :reason :independent-list-element-required :work-count work})))))

(defn p15-s23-ij-type-work [left right budget]
  (if (p15-s23-ni-candidate? left right)
    (p15-s23-ni-type-work left right budget)
  (let [a (p15-s23-ij-element left budget)
        b (if (= :accepted (get a :status))
            (p15-s23-ij-element right (- budget (get a :work-count))) nil)
        work (+ (get a :work-count) (get b :work-count 0))]
    (if (= :rejected (get a :status)) a
      (if (= :accepted (get a :status))
        (if (= :rejected (get b :status)) (assoc b :work-count work)
          (if (= :accepted (get b :status))
            (let [x (get a :element-type) y (get b :element-type)
                  element (if (= x nil) y x)]
              (if (if (= element nil) false (if (= x nil) true (if (= y nil) true (= x y))))
                {:status :accepted :type {:kind :gravity.type/list :shape :homogeneous :element-type element}
                 :branch-types [left right]
                 :branch-compatibility [(p15-s23-typed-project a [:element-type :relation :checked-member-count])
                                        (p15-s23-typed-project b [:element-type :relation :checked-member-count])]
                 :element-type element :work-count work}
                {:status :not-applicable :reason :incompatible-independent-list-elements :work-count work}))
            {:status :not-applicable :reason (get b :reason) :work-count work}))
        {:status :not-applicable :reason (get a :reason) :work-count work})))))

(defn p15-s23-ij-normal-type [left right]
  (if (if (p15-s23-ni-valid-view? left) (p15-s23-ni-valid-view? right) false)
  (if (= left right) left
    (if (= left :gravity.type/never) right
      (if (= right :gravity.type/never) left
        (get (p15-s23-ij-type-work left right 65536) :type :gravity.type/unknown)))) :gravity.type/unknown))

(defn p15-s23-ij-derive [core node nodes types bindings forms budget]
  (let [children (get node :children)]
    (if (if (= :if (get node :core-form)) (if (vector? children) (= 3 (count children)) false) false)
      (let [condition (get types (first children) :gravity.type/unknown)
            left (get types (get children 1) :gravity.type/unknown)
            right (get types (get children 2) :gravity.type/unknown)]
        (if (if (= condition :gravity.type/never) true
              (if (p15-s23-ij-unknown? condition) true
                (if (= left right) true
                  (if (= left :gravity.type/never) true (= right :gravity.type/never)))))
          {:status :not-applicable :work-count 1}
          (let [base (+ 64 (count (get core :function-records)) (count (get core :control-flow)))]
            (if (> base budget) {:status :rejected :reason :list-if-join-work-limit :work-count base}
              (let [validation (p15-s23-ij-type-work left right (- budget base))
                    work (+ base (get validation :work-count))]
                (if (= :accepted (get validation :status))
                  (let [owner (get (get node :evaluation) :owner-function-syntax-id)
                        function (loop [remaining (get core :function-records)]
                                   (if (= 0 (count remaining)) nil
                                     (if (= owner (get (first remaining) :function-syntax-id))
                                       (first remaining) (recur (rest remaining)))))
                        binding (get bindings (get function :definition-binding-id))
                        form (get forms (get (get node :source) :form-id))
                        ids (get form :child-form-ids)
                        operator (get forms (get ids 0))
                        control {:core-node-id (get node :node-id) :kind :if :condition-node-id (first children)
                                 :branches [{:role :then :predicate :truthy :core-node-id (get children 1)}
                                            {:role :else :predicate :falsey :core-node-id (get children 2)}]
                                 :branch-exclusivity :exactly-one
                                 :truthiness {:false-values [:nil :false] :other-values :true}
                                 :result-policy :selected-branch}
                        controls (loop [remaining (get core :control-flow) out []]
                                   (if (= 0 (count remaining)) out
                                     (recur (rest remaining)
                                       (if (= (get node :node-id) (get (first remaining) :core-node-id))
                                         (conj out (first remaining)) out))))
                        branch-nodes (loop [remaining children out []]
                                       (if (= 0 (count remaining)) out
                                         (recur (rest remaining) (conj out (get nodes (first remaining))))))
                        reference-work (loop [remaining branch-nodes used 0]
                                         (if (= 0 (count remaining)) used
                                           (recur (rest remaining)
                                             (+ used (if (vector? (get (first remaining) :resolved-binding-ids))
                                                       (* 2 (count (get (first remaining) :resolved-binding-ids))) 0)))))
                        work (+ work reference-work)
                        branch-bindings (if (> work budget) [] (loop [remaining branch-nodes out []]
                                          (if (= 0 (count remaining)) out
                                            (recur (rest remaining)
                                              (conj out (loop [ids (if (vector? (get (first remaining) :resolved-binding-ids))
                                                                    (get (first remaining) :resolved-binding-ids) []) records []]
                                                          (if (= 0 (count ids)) records
                                                            (recur (rest ids) (conj records (get bindings (first ids)))))))))))]
                    (if (p15-s23-typed-all
                          [(<= work budget) (map? function) (= owner (get function :function-syntax-id))
                           (= (get function :definition-binding-id) (get binding :binding-id))
                           (= (get function :definition-name) (get binding :name))
                           (= [:namespace :function (get (get core :module) :namespace)]
                              [(get binding :binding-class) (get binding :kind) (get binding :namespace)])
                           (= :list (get form :kind)) (vector? ids) (= 4 (count ids))
                           (= :symbol (get operator :kind)) (= 'if (get operator :value))
                           (= (get form :form-id) (get operator :parent-form-id))
                           (= (p15-s23-lr-source form) (get node :source))
                           (= [] (get node :resolved-binding-ids))
                           (= {:condition-child-index 0 :then-child-index 1 :else-child-index 2 :condition-evaluation :always-first
                               :branch-evaluation :exactly-one :truthiness {:false-values [:nil :false] :other-values :true}} (get node :attributes))
                           (= :condition-then-exclusive-branch (get (get node :evaluation) :kind))
                           (= [{:index 0 :core-node-id (first children)}] (get (get node :evaluation) :order))
                           (= [control] controls)
                           (loop [i 0]
                             (if (= i 3) true
                               (let [child (get branch-nodes i) source (get forms (get ids (+ i 1)))
                                     references (get child :resolved-binding-ids) records (get branch-bindings i)]
                                 (if (p15-s23-typed-all
                                       [(= (get child :node-id) (get children i))
                                        (= (p15-s23-lr-source source) (get child :source))
                                        (= (get form :form-id) (get source :parent-form-id))
                                        (= owner (get (get child :evaluation) :owner-function-syntax-id))
                                        (vector? references) (= references (loop [rows records out []]
                                                                            (if (= 0 (count rows)) out
                                                                              (recur (rest rows) (conj out (get (first rows) :binding-id))))))])
                                   (recur (+ i 1)) false))))])
                      {:status :accepted :work-count work :type (get validation :type)
                       :premise (let [premise {:version :sh08-list-if-join-v1 :relation :independent-homogeneous-list-join
                                 :if-core-node-id (get node :node-id) :source-node node
                                 :function-record function :definition-binding binding
                                 :condition-type condition :branch-types [left right]
                                 :branch-node-ids [(get children 1) (get children 2)]
                                 :child-sources (loop [remaining branch-nodes out []]
                                                  (if (= 0 (count remaining)) out
                                                    (recur (rest remaining) (conj out (get (first remaining) :source)))))
                                 :child-bindings branch-bindings :source-form (p15-s23-lr-source form)
                                 :operator-source (p15-s23-lr-source operator) :control-flow control
                                 :branch-compatibility (get validation :branch-compatibility)
                                 :result-type (get validation :type)
                                 :expected-return-premise :none :runtime-conversion :none
                                 :preserves [:actual-branch-types :source :bindings :value :ownership :linearity :regions :effects]
                                 :profile (get (get core :module) :profile) :target (get (get core :module) :target)}]
                         (if (= :nil-or (get validation :join-family))
                           (assoc premise :version :sh08-nil-if-join-v1
                             :relation :independent-nil-or-atomic-join :nil-type :gravity.type/nil :value-type (get validation :value-type))
                           (assoc premise :element-type (get validation :element-type))))}
                      {:status :rejected :reason (if (> work budget) :list-if-join-work-limit :list-if-join-source-mismatch) :work-count work}))
                  (assoc validation :work-count work :type-work-count (get validation :work-count))))))))
      {:status :not-applicable :work-count 1})))

(defn p15-s23-ij-row [premise]
  {:constraint-id-request {:domain (if (= :sh08-nil-if-join-v1 (get premise :version))
                                     :gravity/sh08-nil-if-join-constraint-v1 :gravity/sh08-list-if-join-constraint-v1)
                            :join-compatibility premise}
   :kind :join-compatibility :producer-rule (if (= :sh08-nil-if-join-v1 (get premise :version))
                                            :sh08-nil-if-join-v1 :sh08-list-if-join-v1)
   :lhs {:core-node-id (get premise :if-core-node-id) :role :canonical-if-result}
   :rhs {:actual-branch-types (get premise :branch-types) :result-type (get premise :result-type)}
   :dependencies premise :solution {:result-type (get premise :result-type)}
   :invalidation [:source-forms :if-node :control-flow :branch-nodes :branch-types :source-bindings
                  :function-records :definition-binding :profile :target]
   :profile (get premise :profile) :target (get premise :target) :status :solved :diagnostics []})

(defn p15-s23-ij-context [core facts bindings source-forms budget]
  (let [sequence (get core :nodes) ledger (get facts :constraint-ledger []) types (get facts :type-table)
        base (+ (count sequence) (count ledger) (if (map? source-forms) 0 (count source-forms)))]
    (if (> base budget) {:status :rejected :reason :list-if-join-work-limit :work-count base}
      (let [nodes (p15-s23-typed-index sequence :node-id)
            forms (if (map? source-forms) source-forms (p15-s23-typed-index source-forms :form-id))
            rows (loop [remaining ledger out []]
                   (if (= 0 (count remaining)) out
                     (recur (rest remaining)
                       (if (if (contains? #{:sh08-list-if-join-v1 :sh08-nil-if-join-v1} (get (first remaining) :producer-rule)) true
                             (= :join-compatibility (get (first remaining) :kind)))
                         (conj out (first remaining)) out))))]
        (loop [remaining sequence used base expected [] premises {}]
          (if (= 0 (count remaining))
            (if (= expected rows)
              {:status :accepted :work-count used :context {:premises premises}}
              {:status :rejected :reason :list-if-join-constraint-census :work-count used})
            (let [node (first remaining) id (get node :node-id)]
              (if (= :if (get node :core-form))
                (let [checked (p15-s23-ij-derive core node nodes types bindings forms (- budget used))
                      work (+ used (get checked :work-count)) children (get node :children)
                      condition (get types (first children) :gravity.type/unknown)
                      left (get types (get children 1) :gravity.type/unknown)
                      right (get types (get children 2) :gravity.type/unknown)
                      result (if (= condition :gravity.type/never) :gravity.type/never
                               (if (p15-s23-ij-unknown? condition) :gravity.type/unknown
                                 (if (= :accepted (get checked :status)) (get checked :type)
                                   (p15-s23-ij-normal-type left right))))]
                  (if (if (> work budget) true (= :rejected (get checked :status)))
                    (if (> work budget) {:status :rejected :reason :list-if-join-work-limit :work-count work}
                      (assoc checked :work-count work))
                    (if (if (= result :gravity.type/unknown) false (= result (get types id)))
                      (recur (rest remaining) work
                        (if (= :accepted (get checked :status)) (conj expected (p15-s23-ij-row (get checked :premise))) expected)
                        (if (= :accepted (get checked :status)) (assoc premises id (get checked :premise)) premises))
                      {:status :rejected :reason :list-if-join-result-type-mismatch :work-count work})))
                (recur (rest remaining) used expected premises)))))))))

(defn p15-s23-typed-return-declaration? [declaration type context]
  (let [forms (get context :forms) bindings (get context :bindings)
        form (get forms (get declaration :type-form-id))
        constructor (get forms (get declaration :constructor-form-id)) member (get forms (get declaration :element-form-id))
        marker (get forms (get declaration :marker-form-id))]
    (p15-s23-typed-all
      [(p15-s23-lr-declaration? declaration bindings) (= type (get declaration :type-id))
       (= :list (get form :kind)) (= [:keyword ':-] [(get marker :kind) (get marker :value)])
       (= (get marker :syntax-id) (get declaration :marker-syntax-id))
       (= [(get constructor :form-id) (get member :form-id)] (get form :child-form-ids))
       (= (get form :syntax-id) (get declaration :type-syntax-id))
       (= (get constructor :syntax-id) (get declaration :constructor-syntax-id))
       (= (get member :syntax-id) (get declaration :element-syntax-id))
       (= (get form :form-id) (get constructor :parent-form-id) (get member :parent-form-id))
       (= (get form :scope-id) (get constructor :scope-id) (get member :scope-id))
       (= [(get constructor :value) (get member :value)]
          [(get declaration :constructor-reference-symbol) (get declaration :element-reference-symbol)])])))

(defn p15-s23-typed-definition [context name]
  (let [record (get (get context :records) name) function (get (get context :functions) name)
        nodes (get context :nodes) forms (get context :forms) bindings (get context :bindings)
        fn-node (get nodes (get record :function-core-node-id)) def-node (get nodes (get record :definition-core-node-id))
        fn-form (get forms (get (get fn-node :source) :form-id))
        def-form (get forms (get (get def-node :source) :form-id)) fn-ids (get fn-form :child-form-ids)
        signature (get record :signature) body-index (get signature :body-source-child-index 2)
        body-form (get forms (get fn-ids body-index))
        parameter-form (get forms (get fn-ids 1)) names (get (get fn-node :attributes) :parameters)
        parameter-ids (get record :parameter-binding-ids)
        raw-def (get (get context :raw-roots) (get (get def-node :source) :form-id))
        raw-fn (if (seq? raw-def) (get (vec raw-def) 2) nil)
        raw-values (if (seq? raw-fn) (vec raw-fn) [])
        raw-parameters (get raw-values 1)
        declared? (contains? record :signature)
        return? (= body-index 4)
        definition {:name name :params names :body [(get raw-values body-index)] :definition-form :def-fn
                    :arity (count names) :body-form-count 1}
        definition (if declared? (assoc definition :source-declarations
                     {:parameters raw-parameters
                      :return (if return? [:- (get raw-values 3)] nil)}) definition)
        locals (loop [ids parameter-ids remaining-names names values {}]
                 (if (= 0 (count ids)) values
                   (recur (rest ids) (rest remaining-names) (assoc values (first ids) (first remaining-names)))))
        parameters (get function :parameters)
        types (loop [remaining parameters values {}]
                (if (= 0 (count remaining)) values
                  (recur (rest remaining) (assoc values (get (first remaining) :binding-id) (get (first remaining) :type)))))]
    (if (p15-s23-typed-all
          [(map? record) (= :named-top-level (get record :definition-kind)) (= :fn (get fn-node :core-form))
           (p15-s23-ni-valid-view? (get function :return))
           (p15-s23-ni-valid-view? (get (get context :types) (get record :body-core-node-id)))
           (if (seq? raw-def) (= ['def name raw-fn] (vec raw-def)) false)
           (seq? raw-fn) (= 'fn (first raw-values)) (contains? #{2 4} body-index)
           (= (+ body-index 1) (count raw-values) (count fn-ids))
           (vector? raw-parameters) (= raw-parameters (get parameter-form :value))
           (if return? (= [:- (get (get forms (get fn-ids 3)) :value)] [(get raw-values 2) (get raw-values 3)]) true)
           (= (get fn-form :form-id) (get (get def-form :child-form-ids) 2))
           (= (get def-form :form-id) (get fn-form :parent-form-id))
           (= (get fn-form :form-id) (get parameter-form :parent-form-id) (get body-form :parent-form-id))
           (= :def (get def-node :core-form)) (= [name (get fn-form :value)] (vec (rest (get def-form :value))))
           (= (get record :function-syntax-id) (get (get fn-node :source) :syntax-id) (get function :function-id))
           (= (get record :function-core-node-id) (get function :function-core-node-id) (first (get def-node :children)))
           (= (get record :body-core-node-id) (first (get fn-node :children)) (get function :body-core-node-id))
           (= (get body-form :form-id) (get (get (get nodes (get record :body-core-node-id)) :source) :form-id))
           (= (get record :signature) (get (get fn-node :attributes) :signature) (get function :signature))
           (= parameter-ids (get fn-node :resolved-binding-ids) (get function :parameter-binding-ids))
           (= (p15-s23-typed-project function [:function-id :function-core-node-id :body-core-node-id :parameters :return :signature :thrown-error-effects :return-actual-type :return-compatibility])
              (p15-s23-typed-project (get (get context :types) (get record :function-core-node-id))
                [:function-id :function-core-node-id :body-core-node-id :parameters :return :signature :thrown-error-effects :return-actual-type :return-compatibility])
              (p15-s23-typed-project (get (get context :types) (get record :definition-core-node-id))
                [:function-id :function-core-node-id :body-core-node-id :parameters :return :signature :thrown-error-effects :return-actual-type :return-compatibility]))
           (if (= :sh07-list-return-declaration-v1 (get (get signature :return) :rule-version))
             (let [premise (get (get (get context :return-context) :premises) (get record :function-syntax-id))]
               (if (map? premise)
                 (p15-s23-typed-all [(= premise (get function :return-compatibility))
                   (= (get function :return-actual-type) (get (get context :types) (get record :body-core-node-id)))
                   (= (get function :return) (get (get signature :return) :type-id))]) false))
             (if (= :gravity.type/never (get (get context :types) (get record :body-core-node-id))) true
               (= (get function :return) (get (get context :types) (get record :body-core-node-id)))))
           (if (= :sh07-list-return-declaration-v1 (get (get signature :return) :rule-version))
             (p15-s23-typed-all [(p15-s23-typed-return-declaration? (get signature :return) (get function :return) context)
               (= [(get (get signature :return) :marker-form-id) (get (get signature :return) :type-form-id)]
                  [(get fn-ids 2) (get fn-ids 3)])])
             (p15-s23-typed-declaration? (get signature :return) (get function :return) context))
           (= (count names) (get record :fixed-arity) (get function :fixed-arity) (count parameters))
           (loop [ids parameter-ids remaining-names names ordinal 0]
             (if (= 0 (count ids)) true
               (let [binding (get bindings (first ids)) coordinate (if declared? (get (get signature :parameter-source-child-indexes) ordinal) ordinal)
                     name-form (get forms (get (get parameter-form :child-form-ids) coordinate))]
                 (if (p15-s23-typed-all [(= (first remaining-names) (get binding :name))
                         (= :lexical (get binding :binding-class)) (= :local (get binding :kind))
                         (= (get binding :name) (get name-form :value))
                         (= (get binding :definition-syntax-id) (get name-form :syntax-id))
                         (= (get binding :scope-id) (get name-form :scope-id))
                         (p15-s23-typed-parameter-declaration? (get (get signature :parameters) ordinal) (get types (first ids)) context)
                         (= false (contains? #{nil :gravity.type/unknown} (get types (first ids))))])
                   (recur (rest ids) (rest remaining-names) (+ ordinal 1)) false))))])
      (p15-s23-compiler-result {:definition definition :record record :function function :locals locals :parameter-types types})
      (p15-s23-typed-node-error :typed-definition-or-declaration-mismatch fn-node))))

(defn p15-s23-typed-compile-children [context ids budget values]
  (p15-s23-typed-compile-children-mode context ids budget values :none 0))

(defn p15-s23-typed-compile-children-mode [context ids budget values mode index]
  (if (= 0 (count ids)) (assoc (p15-s23-compiler-result values) :work-count 0)
    (let [tail? (if (= true (get context :tail?))
                  (if (= mode :last) (= 1 (count ids)) (if (= mode :branches) (> index 0) false)) false)
          head (p15-s23-typed-compile-node (assoc context :tail? tail?) (first ids) budget)]
      (if (p15-s23-compiler-complete? head)
        (let [tail (p15-s23-typed-compile-children-mode context (rest ids) (- budget (get head :work-count)) (conj values (get head :value)) mode (+ index 1))]
          (if (p15-s23-compiler-complete? tail)
            (assoc tail :work-count (+ (get head :work-count) (get tail :work-count))) tail)) head))))

(defn p15-s23-typed-row [context producer id]
  (loop [remaining (get context :ledger) found nil]
    (if (= 0 (count remaining)) found
      (let [row (first remaining) lhs (get row :lhs)
            row-id (if (= producer :sh08-atomic-typed-catch-v1) (get lhs :core-node-id) lhs)]
        (if (if (= producer (get row :producer-rule)) (= id row-id) false)
          (if (= found nil) (recur (rest remaining) row) nil)
          (recur (rest remaining) found))))))

(defn p15-s23-typed-source [form]
  {:form-id (get form :form-id) :syntax-id (get form :syntax-id) :semantic-span (get form :source-span)
   :origin-chain (get form :origin-chain) :generated-origin (get form :generated-origin)})

; Representation guard only. The authenticated C2 occurrence owns scalar
; decoding, including the codepoint/text theorem; a map tag grants no authority.
(defn p15-s23-typed-character-carrier? [value]
  (if (char? value) true
    (if (map? value)
      (if (= #{:artifact :schema-version :codepoint :text} (set (keys value)))
        (if (= :gravity/unicode-scalar-character (get value :artifact))
          (if (= 1 (get value :schema-version))
            (if (integer? (get value :codepoint))
              (if (<= 65536 (get value :codepoint) 1114111)
                (if (string? (get value :text)) (= 2 (count (get value :text))) false) false) false) false) false) false) false)))

(defn p15-s23-typed-quote [context node budget]
  ; Fresh public C7 verification and typed-context joins own recursive DATA
  ; validation. This private projection checks scalar root identities only.
  (let [row (p15-s23-typed-row context :sh08-recursive-quoted-data-v1 (get node :node-id))
        forms (get context :forms) owner (get forms (get (get node :source) :form-id)) ids (get owner :child-form-ids)
        operator (get forms (get ids 0)) payload (get forms (get ids 1)) attrs (get node :attributes)
        data (get row :quoted-data) origin (get data :origin)
        premise (get (get row :dependencies) :quote)
        kind (get data :kind)
        expected (get {:nil :gravity.type/nil :boolean :gravity.type/bool :integer :gravity.type/integer
                       :character :gravity.type/character :string :gravity.type/string :keyword :gravity.type/keyword
                       :symbol :gravity.type/symbol :list :gravity.type/list :vector :gravity.type/vector
                       :map :gravity.type/map :set :gravity.type/set} kind)
        type (get (get context :types) (get node :node-id)) row-type (get row :rhs)
        data-type (get data :type) solution-type (get (get row :solution) :type)]
    (if (= false (vector? ids)) (p15-s23-typed-node-error :unsupported-or-mismatched-typed-quote node)
    (if (< budget 4) (p15-s23-typed-node-error :typed-lowering-work-limit node)
      (if (p15-s23-typed-all
          [(= :solved (get row :status)) (= :equality (get row :kind)) (= :quote (get node :core-form))
           (= false (= nil expected))
           (= expected (if (map? type) (get type :kind) type) (if (map? row-type) (get row-type :kind) row-type)
              (if (map? data-type) (get data-type :kind) data-type) (if (map? solution-type) (get solution-type :kind) solution-type))
           (= [] (get node :children) (get node :resolved-binding-ids))
           (= :no-evaluation (get (get node :evaluation) :kind)) (= [] (get (get node :evaluation) :order))
           (= :no-evaluation (get (get row :solution) :evaluation))
           (= :list (get owner :kind)) (= 2 (count ids)) (= kind (get payload :kind) (get attrs :quoted-kind))
           (= (get ids 0) (get operator :form-id)) (= (get ids 1) (get payload :form-id) (get attrs :quoted-form-id))
           (= (get payload :syntax-id) (get attrs :quoted-syntax-id))
           (= (get owner :form-id) (get payload :parent-form-id) (get operator :parent-form-id))
           (= 'quote (get operator :value)) (= :symbol (get operator :kind)) (= [] (get operator :child-form-ids))
           (= (get owner :form-id) (get (get node :source) :form-id) (get (get premise :source) :form-id))
           (= (get owner :syntax-id) (get (get node :source) :syntax-id) (get (get premise :source) :syntax-id))
           (= (get node :node-id) (get premise :core-node-id) (get origin :quote-core-node-id))
           (= :quoted-data (get origin :kind)) (= [] (get origin :data-path))
           (= (get payload :form-id) (get origin :form-id) (get (get data :source) :form-id))
           (= (get payload :syntax-id) (get origin :syntax-id) (get (get data :source) :syntax-id))
           (if (= :character kind)
             (if (= (get payload :value) (get attrs :quoted-value) (get data :value))
               (p15-s23-typed-character-carrier? (get payload :value)) false) true)])
        (assoc (p15-s23-compiler-result {:op :quote :value (get data :value)}) :work-count 4)
        (p15-s23-typed-node-error :unsupported-or-mismatched-typed-quote node))))))

(defn p15-s23-typed-try-handlers [context node row budget]
  (let [premise (get row :dependencies) records (get premise :source-handlers) types (get premise :catch-types)
        forms (get context :forms) owner (get forms (get (get node :source) :form-id)) ids (get owner :child-form-ids)
        children (get node :children) clauses (get (get node :attributes) :handler-clauses)
        original-records (loop [remaining (get context :error-handlers) out []]
                           (if (= 0 (count remaining)) out
                             (recur (rest remaining) (if (= (get node :node-id) (get (first remaining) :core-node-id))
                                                      (conj out (first remaining)) out))))]
    (if (= false (p15-s23-typed-all [(vector? records) (vector? types) (vector? clauses) (vector? children) (vector? ids)]))
      (p15-s23-typed-node-error :typed-handler-ledger-or-source-mismatch node)
    (if (p15-s23-typed-all
          [(vector? records) (vector? types) (vector? clauses) (vector? children) (vector? ids)
           (> (count clauses) 0) (= (count records) (count types) (count clauses))
           (= (+ 1 (count clauses)) (count children)) (= (+ 2 (count clauses)) (count ids))
           (= original-records records) (= :solved (get row :status)) (= :equality (get row :kind))
           (= node (get premise :source-node)) (= :sh08-atomic-typed-catch-v1 (get premise :version))
           (= {:domain :gravity/sh08-atomic-typed-catch-v1 :premise premise} (get row :constraint-id-request))
           (= {:core-node-id (get node :node-id) :projection :source-error-handler-result} (get row :lhs))
           (= (get (get context :types) (get node :node-id)) (get premise :normal-result-type) (get (get row :solution) :normal-result-type))
           (= (get node :source) (p15-s23-typed-source owner))
           (= :list (get owner :kind)) (= 'try (get (get forms (first ids)) :value))
           (= (get (get (get context :nodes) (first children)) :source) (p15-s23-typed-source (get forms (get ids 1))))])
      (loop [index 0 out [] used 0]
        (if (= index (count clauses)) (assoc (p15-s23-compiler-result out) :work-count used)
          (let [record (get records index) clause (get clauses index) type (get types index)
                catch-form (get forms (get ids (+ 2 index))) catch-ids (get catch-form :child-form-ids)
                type-form (get forms (get catch-ids 1)) binder-form (get forms (get catch-ids 2)) body-form (get forms (get catch-ids 3))
                binder (get (get context :bindings) (get record :catch-binding-id))
                type-binding (get (get context :bindings) (get record :error-type-binding-id))
                body-id (get children (+ index 1)) body (get (get context :nodes) body-id)
                fields [:clause-ordinal :handler-child-index :catch-clause-form-id :catch-clause-syntax-id :error-type-form-id :error-type-syntax-id
                        :error-type-binding-id :catch-binding-form-id :catch-binding-syntax-id :catch-binding-id :catch-binding-scope-id]]
            (if (< (- budget used) 8) (p15-s23-typed-node-error :typed-lowering-work-limit node)
              (if (p15-s23-typed-all
                    [(contains? #{:gravity.type/bool :gravity.type/string :gravity.type/symbol :gravity.type/keyword} type)
                     (= type (p15-s23-typed-atomic-id (get type-binding :name)))
                     (= [:core :type 'gravity.core] [(get type-binding :binding-class) (get type-binding :kind) (get type-binding :namespace)])
                     (= [:lexical :local] [(get binder :binding-class) (get binder :kind)])
                     (= clause (p15-s23-typed-project record fields)) (= index (get record :clause-ordinal))
                     (= (+ index 1) (get record :handler-child-index)) (= (first children) (get record :protected-core-node-id))
                     (= body-id (get record :handler-core-node-id)) (= (get owner :form-id) (get record :form-id) (get catch-form :parent-form-id))
                     (= (get catch-form :form-id) (get record :catch-clause-form-id)) (= (get catch-form :syntax-id) (get record :catch-clause-syntax-id))
                     (= 4 (if (vector? catch-ids) (count catch-ids) 0)) (= (get type-form :form-id) (get record :error-type-form-id))
                     (= :list (get catch-form :kind)) (= 'catch (get (get forms (get catch-ids 0)) :value))
                     (= (get catch-form :form-id) (get type-form :parent-form-id) (get binder-form :parent-form-id) (get body-form :parent-form-id))
                     (= (get catch-form :value) (list 'catch (get type-form :value) (get binder-form :value) (get body-form :value)))
                     (= (get type-form :syntax-id) (get record :error-type-syntax-id)) (= (get type-form :value) (get type-binding :name))
                     (= (get binder-form :form-id) (get record :catch-binding-form-id))
                     (= (get binder-form :syntax-id) (get record :catch-binding-syntax-id) (get binder :definition-syntax-id))
                     (= (get binder-form :scope-id) (get record :catch-binding-scope-id) (get binder :scope-id))
                     (= (get binder-form :value) (get binder :name)) (symbol? (get binder :name))
                     (= (get body :source) (p15-s23-typed-source body-form))])
                (let [handler-context (assoc context :tail? false :locals (assoc (get context :locals) (get binder :binding-id) (get binder :name))
                                                    :parameter-types (assoc (get context :parameter-types) (get binder :binding-id) type))
                      compiled (p15-s23-typed-compile-node handler-context body-id (- budget used 8))]
                  (if (p15-s23-compiler-complete? compiled)
                    (recur (+ index 1) (conj out {:type type :name (get binder :name) :body (get compiled :value)})
                      (+ used 8 (get compiled :work-count))) compiled))
                (p15-s23-typed-node-error :typed-handler-source-or-binding-mismatch node))))))
      (p15-s23-typed-node-error :typed-handler-ledger-or-source-mismatch node)))))

(defn p15-s23-typed-compile-try [context node budget]
  (let [row (p15-s23-typed-row context :sh08-atomic-typed-catch-v1 (get node :node-id))
        handlers (p15-s23-typed-try-handlers context node row (- budget 1))]
    (if (p15-s23-compiler-complete? handlers)
      (let [protected (p15-s23-typed-compile-node (assoc context :tail? false) (first (get node :children)) (- budget 1 (get handlers :work-count)))]
        (if (p15-s23-compiler-complete? protected)
          (assoc (p15-s23-compiler-result {:op :try :protected (get protected :value) :handlers (get handlers :value)})
            :work-count (+ 1 (get handlers :work-count) (get protected :work-count))) protected)) handlers)))

(defn p15-s23-typed-index-range [start end]
  (loop [i start out []] (if (= i end) out (recur (+ i 1) (conj out i)))))

(defn p15-s23-typed-let-fact [context record initializer type]
  (let [module (get (get context :core) :module) source (get initializer :source)]
    {:artifact :gravity/c7-local-binding-fact
     :fact-id-request {:domain :gravity/sh08-local-binding-fact-v1 :binding-id (get record :binding-id)
                       :initializer-node-id (get initializer :node-id) :type type :profile (get module :profile) :target (get module :target)}
     :binding-id (get record :binding-id) :name (get record :name) :type type
     :initializer-node-id (get initializer :node-id) :let-core-node-id (get record :let-core-node-id)
     :source-span (get source :semantic-span) :syntax-id (get source :syntax-id) :origin-chain (get source :origin-chain)
     :generated-origin (get source :generated-origin) :profile (get module :profile) :target (get module :target)
     :effects (get module :effects) :capabilities (get module :capabilities) :status :inferred}))

(defn p15-s23-typed-let-bindings [context node records vector-form budget]
  (p15-s23-typed-bindings context node records vector-form budget :let))

(defn p15-s23-typed-loop-row [context premise node]
  (let [target (get premise :source-target) slot? (= :loop-slot-type (get premise :kind))
        lhs (if slot? (get premise :binding-id) (get node :node-id)) rhs (if slot? (get premise :type) :gravity.type/never)
        module (get (get context :core) :module)]
    {:constraint-id-request {:domain :gravity/sh08-loop-type-constraint-v1 :core-node-id (get node :node-id)
                            :binding-or-transfer lhs :target-id (get target :target-id) :premise premise}
     :kind :equality :producer-rule :sh08-loop-target-types-v1 :lhs lhs :rhs rhs
     :origin (get (get node :source) :origin-chain) :profile (get module :profile) :target (get module :target)
     :dependencies {:loop-premise premise :core-node-id (get node :node-id) :target-owner-core-node-id (get target :owner-core-node-id)}
     :solution {:type rhs :slot-types (get premise :slot-types) :argument-types (get premise :argument-types) :normal-transfer? (get premise :normal-transfer?)}
     :invalidation [:loop-bindings :recur-targets :recur-transfers :type-table :binding-table] :status :solved :diagnostics []}))

(defn p15-s23-typed-loop-slot? [context record initializer type]
  (let [target (get (get context :target-owners) (get record :loop-core-node-id))
        premise {:kind :loop-slot-type :binding-id (get record :binding-id) :initializer-node-id (get initializer :node-id)
                 :type type :source-loop-binding record :source-target target :status :solved}]
    (if (if (= :loop (get target :target-kind)) (= false (contains? #{nil :gravity.type/unknown} type)) false)
      (= (p15-s23-typed-loop-row context premise initializer) (get (get context :loop-rows) [:loop-slot-type (get record :binding-id)])) false)))

(defn p15-s23-typed-function-target? [context target]
  (let [record (get context :current-function) node (get (get context :nodes) (get record :function-core-node-id))
        body (get (get context :nodes) (get record :body-core-node-id))
        expected {:target-id (get (get node :attributes) :recur-target-id) :target-kind :function :owner-core-node-id (get node :node-id)
                  :owner-form-id (get (get node :source) :form-id) :owner-syntax-id (get (get node :source) :syntax-id)
                  :arity (get record :fixed-arity) :binding-ids (get record :parameter-binding-ids)
                  :body-scope-id (get body :binding-context) :parent-target-id nil :type-compatibility :pending-sh08}]
    (if (if (map? target) (vector? (get target :binding-ids)) false)
      (p15-s23-typed-all [(string? (get target :target-id))
        (if (string? (get target :target-id)) (if (> (count (get target :target-id)) 0) (<= (count (get target :target-id)) 256) false) false)
        (= :fn (get node :core-form)) (= target expected)
        (= target (get (get context :targets) (get target :target-id)) (get (get context :target-owners) (get node :node-id)))
        (= (get target :binding-ids) (get node :resolved-binding-ids))
        (= (get target :arity) (count (get target :binding-ids)))]) false)))

(defn p15-s23-typed-function-slots [context target]
  (if (p15-s23-typed-function-target? context target)
    ; typed-lower-function already joined the complete source/header exactly
    ; once. Per-transfer work visits only the current ordered parameter facts;
    ; it must not traverse the function's source body again.
    (let [record (get context :current-function) declarations (get (get record :signature) :parameters)
          function (get (get context :functions) (get record :definition-name))
          parameters (get function :parameters) node (get (get context :nodes) (get record :function-core-node-id))]
      (if (p15-s23-typed-all [(= record (get (get context :records) (get record :definition-name)))
            (= (get record :function-syntax-id) (get function :function-id) (get (get node :source) :syntax-id))
            (= (get record :function-core-node-id) (get function :function-core-node-id))
            (= (get record :body-core-node-id) (get function :body-core-node-id))
            (= (get record :parameter-binding-ids) (get function :parameter-binding-ids))
            (= (get record :signature) (get function :signature) (get (get node :attributes) :signature))
            (if (vector? parameters) (= (count parameters) (count (get target :binding-ids))) false)])
        (if (if (= 0 (count (get target :binding-ids))) true
              (if (vector? declarations) (= (count declarations) (count (get target :binding-ids))) false))
          (loop [ids (get target :binding-ids) i 0 out []]
            (if (= 0 (count ids)) out
              (let [parameter (get parameters i) type (get parameter :type) declaration (get declarations i)]
                (if (p15-s23-typed-all [(map? declaration) (= (first ids) (get parameter :binding-id))
                        (= false (contains? #{nil :gravity.type/unknown} type))
                        (= type (get (get context :parameter-types) (first ids)))
                        (p15-s23-typed-parameter-declaration? declaration type context)])
                  (recur (rest ids) (+ i 1) (conj out type)) nil)))) nil) nil)) nil))

(defn p15-s23-typed-loop-parent? [context target]
  (let [parent (get context :nearest-target) record (get context :current-function)
        node (get (get context :nodes) (get record :function-core-node-id)) body (get (get context :nodes) (get record :body-core-node-id))
        expected {:target-id (get (get node :attributes) :recur-target-id) :target-kind :function :owner-core-node-id (get node :node-id)
                  :owner-form-id (get (get node :source) :form-id) :owner-syntax-id (get (get node :source) :syntax-id)
                  :arity (get record :fixed-arity) :binding-ids (get record :parameter-binding-ids)
                  :body-scope-id (get body :binding-context) :parent-target-id nil :type-compatibility :pending-sh08}]
    (if (= (get target :parent-target-id) (get parent :target-id))

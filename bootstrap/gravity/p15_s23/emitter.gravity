                (if (if (vector? children) (vector? ids) false)
                  (if (if (vector? values) (vector? members) false)
                    (if (= n (count ids) (count values) (count members))
                      (if (p15-s23-sse-ids? [(get node :node-id) (get (get node :source) :form-id)

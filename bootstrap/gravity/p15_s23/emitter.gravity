            (if (if (p15-s23-lsi-id? (get node :binding-context)) (p15-s23-lsi-id? (get owner :scope-id)) false)
              (if (= (get (get node :source) :syntax-id) (get owner :syntax-id))
                (if (map? record)
                  (if (p15-s23-lsi-id? (get record :initializer-form-id))
                    (if (p15-s23-lsi-id? (get record :initializer-syntax-id))
                      (if (p15-s23-lsi-id? (get source-binding :definition-syntax-id))
                        (if (p15-s23-lsi-id? (get source-binding :scope-id))
                          (if (p15-s23-lsi-id? (get record :initializer-node-id))
                            (p15-s23-lsi-first-node? (get (get env :nodes) (get record :initializer-node-id))) false) false) false) false) false) true) false) false) false)) false)) false))

(defn p15-s23-lsi-first-call-input [node env budget]
  ; Prepay three fixed node/form projections: 3 * (32 + 24) + 8 units.
  (if (> 176 budget) {:status :rejected :reason :loop-type-work-limit :work-count 176}
    (let [result
  (if (if (p15-s23-lsi-first-node? node)
        (if (keyword? (get (get (get env :core) :module) :profile))
          (keyword? (get (get (get env :core) :module) :target)) false) false)
    (let [id (get node :node-id) call (get (get env :calls) id) edge (get (get env :edges) id)
          children (get node :children) forms (get env :forms) nodes (get env :nodes)]
      (if (if (= 2 (count children)) (if (map? call) (if (= 7 (count call))
            (if (map? edge) (= 12 (count edge)) false) false) false) false)
        (let [op-id (get children 0) arg-id (get children 1) bid (get call :operator-binding-id)]
          (if (if (if (p15-s23-lsi-id? op-id) (p15-s23-lsi-id? arg-id) false)
              (if (p15-s23-lsi-id? bid) (if (p15-s23-lsi-id? (get call :operator-node-id))
                (if (p15-s23-lsi-id? (get call :core-node-id))
                  (if (p15-s23-lsi-first-ids? (get call :argument-node-ids))
                    (if (= 1 (count (get call :argument-node-ids)))
                      (if (p15-s23-lsi-id? (get (get call :argument-node-ids) 0))
                        (if (p15-s23-lsi-first-ids? (get call :ordered-evaluation-node-ids))
                          (if (= 2 (count (get call :ordered-evaluation-node-ids)))
                            (if (p15-s23-lsi-id? (get (get call :ordered-evaluation-node-ids) 0))
                              (p15-s23-lsi-id? (get (get call :ordered-evaluation-node-ids) 1)) false) false) false) false) false) false) false) false) false) false)
            (let [operator (get nodes op-id) arg (get nodes arg-id) binding (get (get env :bindings) bid)
                  owner (get forms (get (get node :source) :form-id))]
              (if (if (p15-s23-lsi-first-node? operator) (p15-s23-lsi-first-node? arg) false)
                (if (if (p15-s23-lsi-first-form? owner)
                      (if (= 2 (count (get owner :child-form-ids)))
                        (if (p15-s23-lsi-id? (get (get owner :child-form-ids) 0))
                          (p15-s23-lsi-id? (get (get owner :child-form-ids) 1)) false) false) false)
                  (let [ids (get owner :child-form-ids) op-form (get forms (get ids 0)) arg-form (get forms (get ids 1))
                        raw (p15-s23-lsi-first-data-work [(p15-s23-lsi-first-node-data node) (p15-s23-lsi-first-node-data operator) (p15-s23-lsi-first-node-data arg)
                              call edge binding (p15-s23-lsi-first-form-data owner) (p15-s23-lsi-first-form-data op-form)
                              (p15-s23-lsi-first-form-data arg-form)
                              {:profile (get (get (get env :core) :module) :profile)
                               :target (get (get (get env :core) :module) :target)}] (- budget 176))]
                    (if (= :accepted (get raw :status))
                      (if (if (p15-s23-lsi-first-form? op-form) (p15-s23-lsi-first-form? arg-form) false)
                        (if (if (symbol? (get binding :name)) (= 'first (get binding :name)) false)
                          (if (p15-s23-lsi-id? (get binding :definition-syntax-id))
                            (assoc raw :node node :call call :edge edge :operator operator :argument arg :owner arg-form)
                            (assoc raw :status :rejected :reason :unsupported-loop-member-grounding))
                          (assoc raw :status :rejected :reason :unsupported-loop-member-grounding))
                        (assoc raw :status :rejected :reason :unsupported-loop-member-grounding)) raw))
                  {:status :rejected :reason :unsupported-loop-member-grounding :work-count 0})
                {:status :rejected :reason :unsupported-loop-member-grounding :work-count 0}))
            {:status :rejected :reason :unsupported-loop-member-grounding :work-count 0}))
        {:status :rejected :reason :unsupported-loop-member-grounding :work-count 0}))
    {:status :rejected :reason :unsupported-loop-member-grounding :work-count 0})]
      (assoc result :work-count (+ 176 (get result :work-count))))))

(defn p15-s23-lsi-first-caller [records owner budget]
  (if (if (vector? records) (<= (count records) 65536) false)
    (loop [remaining records used 0]
      (if (= 0 (count remaining)) {:status :accepted :work-count used}
        (if (> (+ used 3) budget) {:status :rejected :reason :loop-type-work-limit :work-count (+ used 3)}
          (let [record (first remaining) syntax (get record :function-syntax-id) core (get record :function-core-node-id)]
            (if (if (p15-s23-lsi-id? syntax) (p15-s23-lsi-id? core) false)
              (if (= syntax owner) {:status :accepted :work-count (+ used 3)}
                (recur (rest remaining) (+ used 3)))
              {:status :rejected :reason :unsupported-loop-member-grounding :work-count (+ used 3)})))))
    {:status :rejected :reason :unsupported-loop-member-grounding :work-count 0}))

(defn p15-s23-lsi-vector-first [node binding env seen budget]
  (let [input (p15-s23-lsi-first-call-input node env budget) base (get input :work-count)]
    (if (= :accepted (get input :status))
      (let [arg (get input :argument) owner (get input :owner) attrs (get arg :attributes)
            children (get arg :children) forms (get env :forms) nodes (get env :nodes) types (get env :types)
            arg-id (get arg :node-id) arg-type (get types arg-id :gravity.type/unknown)]
        (if (if (= :collection-literal (get arg :core-form))
              (if (if (> (count children) 0) (<= (count children) 1024) false)
                (if (if (= :vector (get owner :kind))
                      (if (vector? (get owner :value))
                        (if (vector? (get attrs :source-value))
                          (if (= (count children) (count (get owner :value)))
                            (= (count children) (count (get owner :child-form-ids))) false) false) false) false)
                (if (map? attrs) (if (= 3 (count attrs))
                  (if (= :vector (get attrs :literal-kind))
                    (if (integer? (get attrs :element-count)) (= (count children) (get attrs :element-count)) false) false) false) false) false) false) false)
          (let [ids (get owner :child-form-ids)
                scanned (loop [i 0 out [] used base]
                  (if (= i (count children)) {:status :accepted :work-count used :types out}
                    (if (> (+ used 64) budget) {:status :rejected :reason :loop-type-work-limit :work-count (+ used 64)}
                      (let [child-id (get children i) source-id (if (< i (count ids)) (get ids i) nil)
                            child (if (p15-s23-lsi-id? child-id) (get nodes child-id) nil)
                            source (if (p15-s23-lsi-id? source-id) (get forms source-id) nil)
                            raw (p15-s23-lsi-first-data-work [(p15-s23-lsi-first-node-data child) (p15-s23-lsi-first-form-data source)] (- budget used 64)) total (+ used 64 (get raw :work-count))]
                        (if (= :accepted (get raw :status))
                          (if (if (p15-s23-lsi-first-node? child) (p15-s23-lsi-first-form? source) false)
                            (if (= (get owner :form-id) (get source :parent-form-id))
                              (if (if (= (get child :source) (p15-s23-ix-form-source source))
                                    (= (get (get owner :value) i) (get source :value)) false)
                                (recur (+ i 1) (conj out (get types (get children i) :gravity.type/unknown)) total)
                                {:status :rejected :reason :unsupported-loop-member-grounding :work-count total})
                              {:status :rejected :reason :unsupported-loop-member-grounding :work-count total})
                            {:status :rejected :reason :unsupported-loop-member-grounding :work-count total}) (assoc raw :work-count total))))))
                used (get scanned :work-count)]
            (if (= :accepted (get scanned :status))
              (let [cold-type {:kind :gravity.type/vector :shape :literal :element-types (get scanned :types)}
                    actual (p15-s23-lc-validate-types [arg-type])
                    cold (p15-s23-lc-validate-types [cold-type])]
                (if (if (= :accepted (get actual :status)) (= :accepted (get cold :status)) false)
                  (let [raw (p15-s23-lsi-first-data-work [arg-type cold-type] (- budget used)) used (+ used (get raw :work-count))]
                    (if (= :accepted (get raw :status))
                      (if (if (= cold-type arg-type)
                            (if (= :vector (get owner :kind))
                              (if (= (count children) (count ids))
                                (if (vector? (get attrs :source-value))
                                  (if (vector? (get owner :value))
                                    (if (= (count children) (count (get owner :value)))
                                      (if (= (get attrs :source-value) (get owner :value))
                                        (if (= (get arg :source) (p15-s23-ix-form-source owner))
                                          (if (= [] (get arg :resolved-binding-ids))
                                            (if (= :left-to-right (get (get arg :evaluation) :kind))
                                              (= (get (get arg :evaluation) :order)
                                                 (loop [i 0 out []] (if (= i (count children)) out
                                                   (recur (+ i 1) (conj out {:index i :core-node-id (get children i)}))))) false) false) false) false) false) false) false) false) false) false)
                        (if (contains? seen arg-id)
                          {:status :rejected :reason :circular-loop-member-grounding :work-count used}
                          (let [head (p15-s23-lsi-path-from-seen (get children 0) :literal-head binding env (conj seen arg-id) (- budget used))
                                used (+ used (get head :work-count) (count (get head :path [])))]
                            (if (= :accepted (get head :status))
                              (let [caller (p15-s23-lsi-first-caller (get (get env :core) :function-records)
                                             (get (get node :evaluation) :owner-function-syntax-id) (- budget used))
                                    used (+ used (get caller :work-count))]
                                (if (= :accepted (get caller :status))
                                  (let [reserved (+ used 64)
                                        header (if (<= reserved budget) (p15-s23-lq-source (get env :core) node (get input :call) (get input :edge)
                                                   nodes (get env :bindings) types (get (get env :core) :module) actual) nil)
                                        used reserved
                                        descriptor (if (map? header) (p15-s23-lq-finish header) nil)
                                        compared (p15-s23-lsi-first-data-work (get types (get (get input :call) :operator-node-id)) (- budget used)) used (+ used (get compared :work-count))]
                                    (if (= :accepted (get compared :status))
                                      (if (if (= :sh08-vector-first-v1 (get descriptor :version))
                                            (if (= :normal (get descriptor :application))
                                              (if (= :gravity.type/symbol (get descriptor :result-type))
                                                (if (p15-s23-ix-call-forms? node nodes forms)
                                                  (= descriptor (get types (get (get input :call) :operator-node-id))) false) false) false) false)
                                        {:status :accepted :path (p15-s23-lsi-first-append [arg-id] (get head :path)) :leaf (get head :leaf) :work-count used}
                                        {:status :rejected :reason :unsupported-loop-member-grounding :work-count used})
                                      (assoc compared :work-count used))) (assoc caller :work-count used))) (assoc head :work-count used))))
                        {:status :rejected :reason :unsupported-loop-member-grounding :work-count used}) (assoc raw :work-count used)))
                  {:status :rejected :reason :unsupported-loop-member-grounding :work-count used})) scanned))
          {:status :rejected :reason :unsupported-loop-member-grounding :work-count base})) input)))

(defn p15-s23-lsi-path-from-seen [start mode binding env initial-seen budget]
  (loop [id start path [] seen initial-seen work 0]
    (if (> (+ work 16) budget) {:status :rejected :reason :loop-type-work-limit :work-count (+ work 16)}
      (if (p15-s23-lsi-id? id)
        (if (contains? seen id) {:status :rejected :reason :circular-loop-member-grounding :work-count (+ work 16)}
          (let [node (get (get env :nodes) id) kind (get node :core-form)
                actual-type (get (get env :types) id :gravity.type/unknown)
                bid (get (get node :attributes) :binding-id) aliases (get env :aliases)
                record (if (p15-s23-lsi-id? bid) (get aliases bid) nil)
                next-path (conj path id) used (+ work 16)]
            (if (if (if (= mode :member) true (= mode :literal-head)) (= :gravity.type/symbol actual-type)
                  (if (= mode :result) (p15-s23-syc-type? actual-type)
                    (if (= mode :initializer) (p15-s23-lsi-empty? actual-type)
                      (if (p15-s23-lsi-empty? actual-type) true (p15-s23-syc-type? actual-type)))))
              (if (if (keyword? kind) (if (p15-s23-lsi-id? (get node :node-id)) (= id (get node :node-id)) false) false)
              (if (if (= mode :result) (= kind :call) false)
                {:status :accepted :path next-path :leaf id :work-count used}
                (if (if (= mode :member) (= :call kind) false)
                  (let [first (p15-s23-lsi-vector-first node binding env (conj seen id) (- budget used))
                        total (+ used (get first :work-count) (count (get first :path [])))]
                    (if (> total budget) {:status :rejected :reason :loop-type-work-limit :work-count total}
                    (if (= :accepted (get first :status))
                      (assoc first :path (p15-s23-lsi-first-append next-path (get first :path)) :work-count total)
                      (assoc first :work-count total))))
                (if (= kind :reference)
                  (if (if (if (if (= mode :member) true (= mode :literal-head))
                                  (p15-s23-lsi-first-reference? node env) true)
                        (if (p15-s23-lsi-id? bid)
                        (if (p15-s23-lsi-id? (get (get node :source) :form-id))
                          (let [form (get (get env :forms) (get (get node :source) :form-id))
                                source-binding (get (get env :bindings) bid)]
                            (if (= [bid] (get node :resolved-binding-ids))
                              (if (= (get node :binding-context) (get form :scope-id))
                                (if (symbol? (get form :value))
                                  (if (symbol? (get source-binding :name)) (= (get form :value) (get source-binding :name)) false) false) false) false)) false) false) false)
                    (if (if (= mode :receiver) (= bid binding) false)
                      {:status :accepted :path next-path :leaf id :origin :slot :work-count used}
                      (if (if (map? record) (if (if (p15-s23-lsi-id? (get record :initializer-node-id))
                          (if (p15-s23-lsi-id? (get record :definition-syntax-id))
                            (if (p15-s23-lsi-id? (get record :binding-scope-id)) (= :immutable (get record :mutability)) false) false) false)
                            (if (= bid (get record :binding-id))
                              (let [source-binding (get (get env :bindings) bid)
                                    initializer (get (get env :nodes) (get record :initializer-node-id))]
                                (if (= (get record :definition-syntax-id) (get source-binding :definition-syntax-id))
                                  (if (= (get record :binding-scope-id) (get source-binding :scope-id))
                                    (if (= (get record :initializer-form-id) (get (get initializer :source) :form-id))
                                      (= (get record :initializer-syntax-id) (get (get initializer :source) :syntax-id)) false) false) false)) false) false) false)
                        (recur (get record :initializer-node-id) next-path (conj seen id) used)
                        {:status :rejected :reason :ungrounded-loop-member-reference :work-count used}))
                    {:status :rejected :reason :incoherent-loop-member-reference :work-count used})
                  (if (if (= mode :result) false (if (= mode :literal-head) (p15-s23-lsi-first-head? node (get env :forms))
                                                  (p15-s23-lsi-leaf? node (get env :forms) mode)))
                    {:status :accepted :path next-path :leaf id :work-count used}
                    {:status :rejected :reason :unsupported-loop-member-grounding :work-count used}))))
              {:status :rejected :reason :incoherent-loop-member-source :work-count used})
              {:status :rejected :reason :unknown-loop-member-grounding :work-count used})))
        {:status :rejected :reason :incoherent-loop-member-source :work-count (+ work 16)}))))

(defn p15-s23-lsi-path [start mode binding env budget]
  (p15-s23-lsi-path-from-seen start mode binding env #{} budget))

(defn p15-s23-lsi-insertion [env node call edge types budget]
  (let [core (get env :core) args (get call :argument-node-ids) base (+ 66 (count (get core :function-records)))]
    (if (> base budget) {:status :rejected :reason :loop-type-work-limit :work-count base}
      (if (if (p15-s23-sse-call-ids? node call)
            (if (vector? args) (if (= 2 (count args))
              (if (vector? (get node :children)) (= 3 (count (get node :children))) false) false) false) false)
        (let [validation (p15-s23-syin-validate-types [(get types (get args 0) :gravity.type/unknown) (get types (get args 1) :gravity.type/unknown)])
              work base]
          (if (= :accepted (get validation :status))
            (let [header (p15-s23-pl-source core node call edge (get env :nodes) (get env :bindings) types (get core :module) validation)]
              (if (if (map? header) (if (p15-s23-ksin-call-forms? node (get env :nodes) (get env :forms))
                    (= {:operator-child-index 0 :argument-count 2 :argument-child-indexes [1 2]
                        :evaluation-order :operator-then-arguments :dispatch :resolved-symbol-call} (get node :attributes)) false) false)
                (let [descriptor (p15-s23-pl-finish header)]
                  {:status :accepted :work-count work :type (get descriptor :result-type) :descriptor descriptor})
                {:status :rejected :reason :unsupported-loop-member-grounding :work-count work}))
            {:status :rejected :reason :unsupported-loop-member-grounding :work-count work}))
        {:status :rejected :reason :unsupported-loop-member-grounding :work-count base}))))

(defn p15-s23-lsi-ground [transfer coordinate binding env budget]
  (let [argument (get (get transfer :argument-node-ids) coordinate)
        result (p15-s23-lsi-path argument :result binding env budget)
        node (get (get env :nodes) (get result :leaf))
        call (get (get env :calls) (get result :leaf))
        edge (get (get env :edges) (get result :leaf)) args (get call :argument-node-ids) work (get result :work-count)]
    (if (= :accepted (get result :status))
      (if (if (vector? args) (= 2 (count args)) false)
        (let [receiver (p15-s23-lsi-path (get args 0) :receiver binding env (- budget work))
              used (+ work (get receiver :work-count))]
          (if (= :accepted (get receiver :status))
            (let [member (p15-s23-lsi-path (get args 1) :member binding env (- budget used))
                  used (+ used (get member :work-count))]
              (if (= :accepted (get member :status))
                (let [warm (p15-s23-lsi-insertion env node call edge (get env :types) (- budget used))
                      used (+ used (get warm :work-count 0)) descriptor (get warm :descriptor)
                      comparison (+ 2 (if (map? descriptor) (count descriptor) 0))]
                  (if (> (+ used comparison) budget) {:status :rejected :reason :loop-type-work-limit :work-count (+ used comparison)}
                    (if (= :accepted (get warm :status))
                      (let [actual (get (get env :types) (get call :operator-node-id)) used (+ used comparison)
                            coherent (if (map? actual) (if (= (count descriptor) (count actual))
                              (if (loop [fields (keys actual)] (if (= 0 (count fields)) true
                                    (if (keyword? (first fields)) (recur (rest fields)) false)))
                                (if (= :sh08-symbol-set-insertion-v2 (get actual :version))
                                  (if (= descriptor actual) (p15-s23-syc-type? (get warm :type)) false) false) false) false) false)]
                        (if coherent
                          (let [empty-type {:kind :gravity.type/set :shape :literal :element-types []}
                                cold-types (assoc (assoc (get env :types) (get args 0) empty-type) (get args 1) :gravity.type/symbol)
                                cold (p15-s23-lsi-insertion env node call edge cold-types (- budget used))
                                total (+ used (get cold :work-count 0) 10) cold-descriptor (get cold :descriptor)]
                            (if (> total budget) {:status :rejected :reason :loop-type-work-limit :work-count total}
                              (if (if (= :accepted (get cold :status))
                                    (if (= :sh08-symbol-set-insertion-v2 (get cold-descriptor :version)) (= :normal (get cold-descriptor :application)) false) false)
                                {:status :accepted :work-count total :grounding
                                 {:schema :gravity/sh08-loop-symbol-set-grounding-v2
                                  :transfer-node-id (get transfer :recur-core-node-id) :argument-node-id argument
                                  :producer-node-id (get node :node-id) :receiver-path (get receiver :path)
                                  :member-path (get member :path) :result-path (get result :path)
                                  :receiver-type empty-type :member-type :gravity.type/symbol :result-type (get cold-descriptor :result-type)}}
                                {:status :rejected :reason :unsupported-loop-member-grounding :work-count total})))
                          {:status :rejected :reason :unsupported-loop-member-grounding :work-count used}))
                      {:status :rejected :reason (if (= :loop-type-work-limit (get warm :reason)) :loop-type-work-limit :unsupported-loop-member-grounding) :work-count used})))
                (assoc member :work-count used)))
            (assoc receiver :work-count used)))
        {:status :rejected :reason :unsupported-loop-member-grounding :work-count work}) result)))

(defn p15-s23-lsi-entry-index [transfers types budget]
  (loop [remaining transfers out {} work 0]
    (if (= 0 (count remaining)) {:status :accepted :index out :work-count work}
      (let [transfer (first remaining) args (get transfer :argument-node-ids)
            cost (+ 2 (if (vector? args) (count args) 0)) target (get transfer :target-id)]
        (if (> (+ work cost) budget) {:status :rejected :reason :loop-type-work-limit :work-count (+ work cost)}
          (if (if (vector? args) (p15-s23-lsi-id? target) false)
            (let [actual (loop [ids args values []]
                           (if (= 0 (count ids)) values
                             (recur (rest ids) (conj values (if (p15-s23-lsi-id? (first ids))
                               (get types (first ids) :gravity.type/unknown) :gravity.type/unknown)))))
                  normal (loop [values actual] (if (= 0 (count values)) true
                           (if (= :gravity.type/never (first values)) false (recur (rest values)))))
                  known (loop [values actual] (if (= 0 (count values)) true
                          (if (= :gravity.type/unknown (first values)) false
                            (if (= nil (first values)) false (recur (rest values))))))]
              (recur (rest remaining) (assoc out target (conj (get out target [])
                {:transfer transfer :types actual :normal? normal :known? known})) (+ work cost)))
            {:status :rejected :reason :incoherent-loop-member-source :work-count (+ work cost)}))))))

(defn p15-s23-lsi-slot [record target entries env budget]
  (let [binding (get record :binding-id) coordinate (get record :ordinal)
        empty-type (get (get env :types) (get record :initializer-node-id))
        carrier {:kind :gravity.type/set :shape :homogeneous :element-type :gravity.type/symbol}
        initializer (p15-s23-lsi-path (get record :initializer-node-id) :initializer binding env budget)]
    (if (if (= :accepted (get initializer :status)) (= false (= :slot (get initializer :origin))) false)
      (loop [remaining entries witness nil evidence [] pending false conflict nil work (get initializer :work-count)]
      (if (= 0 (count remaining))
        (if (if (map? witness) (= false pending) false)
          (if (= conflict nil)
            (if (> (+ work 8) budget)
              {:status :rejected :reason :loop-type-work-limit :work-count (+ work 8)}
              (let [invariant {:schema :gravity/sh08-loop-symbol-set-invariant-v2 :target-id (get target :target-id)
              :binding-id binding :initializer-node-id (get record :initializer-node-id)
              :initializer-type empty-type :invariant-type carrier :grounding witness :entries evidence}
                    measured (p15-s23-pc-evidence-work invariant (- budget work 8))
                    total (+ work 8 (* 2 (get measured :work-count)))]
                (if (if (= :accepted (get measured :status)) (<= total budget) false)
                  {:status :accepted :work-count total :invariant invariant}
                  {:status :rejected :reason :loop-type-work-limit :work-count total})))
            {:status :rejected :reason :loop-recur-slot-type-mismatch :core-node-id (get conflict :argument-node-id)
             :parameter-binding-id binding :expected carrier :actual (get conflict :argument-type) :work-count work})
          {:status :accepted :work-count work})
        (if (> (+ work 2) budget) {:status :rejected :reason :loop-type-work-limit :work-count (+ work 2)}
          (let [entry (first remaining) transfer (get entry :transfer) actual (get (get entry :types) coordinate)
                normal (get entry :normal?)
                compatible (if (= actual :gravity.type/never) true
                             (if (p15-s23-lsi-empty? actual) true (p15-s23-syc-type? actual)))
                proof (if (if (= witness nil) (if normal (if (get entry :known?) (p15-s23-syc-type? actual) false) false) false)
                        (p15-s23-lsi-ground transfer coordinate binding env (- budget work 2))
                        {:status :accepted :work-count 0})
                used (+ work 2 (get proof :work-count))
                row {:transfer-node-id (get transfer :recur-core-node-id)
                     :argument-node-id (get (get transfer :argument-node-ids) coordinate) :argument-type actual
                     :normal-transfer? normal :compatibility (if (= false normal) :existing-noninvoked-transfer-rules
                       (if (p15-s23-lsi-empty? actual) :empty-set-to-symbol-carrier :exact-carrier))}]
            (if (if (= :rejected (get proof :status)) (= :loop-type-work-limit (get proof :reason)) false)
              (assoc proof :work-count used)
              (recur (rest remaining) (if (map? (get proof :grounding)) (get proof :grounding) witness)
                (conj evidence row) (if (= false (get entry :known?)) true pending)
                (if (if normal (if (get entry :known?) (= false compatible) false) false) row conflict) used))))))
      {:status :accepted :work-count (get initializer :work-count)})))

(defn p15-s23-lsi-solve [core types source budget]
  (if (= 0 (count (get core :loop-bindings)))
    {:status :accepted :invariants {} :work-count 0}
    (if (if (map? (get source :forms)) (map? (get source :bindings)) false)
    (let [aliases (p15-s23-lsi-index (get core :lexical-bindings []) :binding-id budget)
          calls (p15-s23-lsi-index (get core :calls []) :core-node-id (- budget (get aliases :work-count)))
          edges (p15-s23-lsi-index (get core :call-edges []) :call-core-node-id (- budget (get aliases :work-count) (get calls :work-count)))
          targets (p15-s23-lsi-index (get core :recur-targets []) :owner-core-node-id (- budget (get aliases :work-count) (get calls :work-count) (get edges :work-count)))
          entries (p15-s23-lsi-entry-index (get core :recur-transfers []) types
                    (- budget (get aliases :work-count) (get calls :work-count) (get edges :work-count) (get targets :work-count)))
          base (+ (get aliases :work-count) (get calls :work-count) (get edges :work-count) (get targets :work-count) (get entries :work-count))
          env {:core core :types types :nodes (get source :nodes) :forms (get source :forms) :bindings (get source :bindings)
               :aliases (get aliases :index) :calls (get calls :index) :edges (get edges :index)}]
      (if (if (= :accepted (get aliases :status)) (if (= :accepted (get calls :status))
            (if (= :accepted (get edges :status)) (if (= :accepted (get targets :status)) (= :accepted (get entries :status)) false) false) false) false)
        (loop [remaining (get core :loop-bindings) out {} work base]
          (if (= 0 (count remaining))
            (let [reads (if (if (= true (get source :warm?)) (> (count out) 0) false)
                          (p15-s23-lsi-reads core types out (- budget work)) {:status :accepted :work-count 0})]
              (if (= :accepted (get reads :status))
                {:status :accepted :invariants out :work-count (+ work (get reads :work-count))}
                (assoc reads :work-count (+ work (get reads :work-count)))))
            (if (>= work budget) {:status :rejected :reason :loop-type-work-limit :work-count (+ work 1)}
              (let [record (first remaining) type (get types (get record :initializer-node-id))
                    target (get (get targets :index) (get record :loop-core-node-id))
                    checked (if (p15-s23-lsi-empty? type)
                              (p15-s23-lsi-slot record target (get (get entries :index) (get target :target-id) []) env (- budget work 1))
                              {:status :accepted :work-count 0}) total (+ work 1 (get checked :work-count))]
                (if (= :accepted (get checked :status))
                  (recur (rest remaining) (if (map? (get checked :invariant))
                    (assoc out (get record :binding-id) (get checked :invariant)) out) total)
                  (assoc checked :work-count total))))))
        {:status :rejected :reason (if (> base budget) :loop-type-work-limit :incoherent-loop-member-source) :work-count base}))
    {:status :accepted :invariants {} :work-count 0})))

(defn p15-s23-lsi-reads [core types invariants budget]
  (loop [remaining (get core :nodes) work 0]
    (if (= 0 (count remaining)) {:status :accepted :work-count work}
      (if (>= work budget) {:status :rejected :reason :loop-type-work-limit :work-count (+ work 1)}
        (let [node (first remaining) binding (get (get node :attributes) :binding-id)
              invariant (if (= :reference (get node :core-form))
                          (if (p15-s23-lsi-id? binding) (get invariants binding) nil) nil)]
          (if (if (map? invariant)
                (= false (p15-s23-syc-type? (get types (get node :node-id)))) false)
            {:status :rejected :reason :incoherent-loop-member-reference :work-count (+ work 1)}
            (recur (rest remaining) (+ work 1))))))))

(defn p15-s23-lsi-row-index [rows budget]
  (loop [remaining rows out {} work 0]
    (if (= 0 (count remaining)) {:status :accepted :index out :work-count work}
      (let [row (first remaining) measured (p15-s23-pc-evidence-work row (- budget work))
            total (+ work (* 2 (get measured :work-count)) 3)]
        (if (if (= :rejected (get measured :status)) true (> total budget))
          {:status :rejected :reason (if (> total budget) :loop-type-work-limit :incoherent-loop-member-ledger) :work-count total}
          (let [premise (get (get row :dependencies) :loop-premise) id (get row :lhs)
                kind (get premise :kind) key [kind id]]
            (if (if (p15-s23-lsi-id? id)
                  (if (if (= :loop-slot-type kind) true (= :loop-recur-type kind))
                    (= false (contains? out key)) false) false)
              (recur (rest remaining) (assoc out key row) total)
              {:status :rejected :reason :incoherent-loop-member-ledger :work-count total})))))))

(defn p15-s23-lsi-target-rows [core target rows budget]
  (let [cost (+ (count (get target :binding-ids)) (count (get core :recur-transfers)))]
    (if (> cost budget) {:status :rejected :reason :loop-type-work-limit :work-count cost}
      (let [slots (loop [ids (get target :binding-ids) out []]
                    (if (= 0 (count ids)) out
                      (recur (rest ids) (conj out (get rows [:loop-slot-type (first ids)])))))
            all (loop [transfers (get core :recur-transfers) out slots]
                  (if (= 0 (count transfers)) out
                    (let [transfer (first transfers)]
                      (recur (rest transfers) (if (= (get target :target-id) (get transfer :target-id))
                        (conj out (get rows [:loop-recur-type (get transfer :recur-core-node-id)])) out)))))
            checked (p15-s23-lsi-row-index all (- budget cost))]
        (assoc checked :work-count (+ cost (get checked :work-count)))))))

(defn p15-s23-lsi-target-bindings [target invariants]
  (loop [remaining (get target :binding-ids) out []]
    (if (= 0 (count remaining)) out
      (recur (rest remaining) (if (contains? invariants (first remaining)) (conj out (first remaining)) out)))))

(defn p15-s23-lsi-compatible? [actual expected]
  (if (p15-s23-syc-type? expected)
    (if (= :gravity.type/never actual) true
      (if (p15-s23-lsi-empty? actual) true (p15-s23-syc-type? actual))) false))

(defn p15-s23-typed-loop-row [context premise node]
  (let [module (get (get context :core) :module)]
  (let [slot? (= :loop-slot-type (get premise :kind)) id (get node :node-id)
        target (get premise :source-target) lhs (if slot? (get premise :binding-id) id)
        rhs (if slot? (get premise :type) :gravity.type/never)
        selected (if (map? (get premise :member-invariant)) true
                   (if (vector? (get premise :member-invariant-bindings)) (> (count (get premise :member-invariant-bindings)) 0) false))
        solution {:type rhs :slot-types (get premise :slot-types) :argument-types (get premise :argument-types)
                  :normal-transfer? (get premise :normal-transfer?)}]
    {:constraint-id-request {:domain (if selected :gravity/sh08-loop-type-constraint-v2 :gravity/sh08-loop-type-constraint-v1)
       :core-node-id id :binding-or-transfer lhs :target-id (get target :target-id) :premise premise}
     :kind :equality :producer-rule (if selected :sh08-loop-target-types-v2 :sh08-loop-target-types-v1) :lhs lhs :rhs rhs
     :origin (get (get node :source) :origin-chain) :profile (get module :profile) :target (get module :target)
     :dependencies {:loop-premise premise :core-node-id id :target-owner-core-node-id (get target :owner-core-node-id)}
     :solution (if selected
                 (if slot? (assoc solution :initializer-type (get premise :initializer-type) :member-invariant (get premise :member-invariant))
                   (assoc solution :member-invariant-bindings (get premise :member-invariant-bindings))) solution)
     :invalidation (if selected
       [:loop-bindings :recur-targets :recur-transfers :type-table :binding-table :calls :call-edges :source-forms :lexical-bindings :loop-member-grounding]
       [:loop-bindings :recur-targets :recur-transfers :type-table :binding-table])
     :status :solved :diagnostics []}))
)

(defn p15-s23-typed-loop-slot? [context record initializer type]
  (let [target (get (get context :target-owners) (get record :loop-core-node-id))
        invariant (get (get context :loop-member-invariants) (get record :binding-id))
        premise {:kind :loop-slot-type :binding-id (get record :binding-id) :initializer-node-id (get initializer :node-id)
                 :type (if (map? invariant) (get invariant :invariant-type) type) :source-loop-binding record :source-target target :status :solved}
        premise (if (map? invariant) (assoc premise :initializer-type type :member-invariant invariant) premise)]
    (if (if (= :loop (get target :target-kind)) (= false (contains? #{nil :gravity.type/unknown} type)) false)
      (= (p15-s23-typed-loop-row context premise initializer) (get (get context :loop-rows) [:loop-slot-type (get record :binding-id)])) false)))

(defn p15-s23-typed-function-target? [context target]
  (let [record (get context :current-function) node (get (get context :nodes) (get record :function-core-node-id))
        body (get (get context :nodes) (get record :body-core-node-id))
        expected {:target-id (get (get node :attributes) :recur-target-id) :target-kind :function :owner-core-node-id (get node :node-id)
                  :owner-form-id (get (get node :source) :form-id) :owner-syntax-id (get (get node :source) :syntax-id)
                  :arity (get record :fixed-arity) :binding-ids (get record :parameter-binding-ids)
                  :body-scope-id (get body :binding-context) :parent-target-id nil :type-compatibility :pending-sh08}]
    (if (if (map? target) (vector? (get target :binding-ids)) false)
      (p15-s23-typed-all [(string? (get target :target-id))
        (if (string? (get target :target-id)) (if (> (count (get target :target-id)) 0) (<= (count (get target :target-id)) 256) false) false)
        (= :fn (get node :core-form)) (= target expected)
        (= target (get (get context :targets) (get target :target-id)) (get (get context :target-owners) (get node :node-id)))
        (= (get target :binding-ids) (get node :resolved-binding-ids))
        (= (get target :arity) (count (get target :binding-ids)))]) false)))

(defn p15-s23-typed-function-slots [context target]
  (if (p15-s23-typed-function-target? context target)
    ; typed-lower-function already joined the complete source/header exactly
    ; once. Per-transfer work visits only the current ordered parameter facts;
    ; it must not traverse the function's source body again.
    (let [record (get context :current-function) declarations (get (get record :signature) :parameters)
          function (get (get context :functions) (get record :definition-name))
          parameters (get function :parameters) node (get (get context :nodes) (get record :function-core-node-id))]
      (if (p15-s23-typed-all [(= record (get (get context :records) (get record :definition-name)))
            (= (get record :function-syntax-id) (get function :function-id) (get (get node :source) :syntax-id))
            (= (get record :function-core-node-id) (get function :function-core-node-id))
            (= (get record :body-core-node-id) (get function :body-core-node-id))
            (= (get record :parameter-binding-ids) (get function :parameter-binding-ids))
            (= (get record :signature) (get function :signature) (get (get node :attributes) :signature))
            (if (vector? parameters) (= (count parameters) (count (get target :binding-ids))) false)])
        (if (if (= 0 (count (get target :binding-ids))) true
              (if (vector? declarations) (= (count declarations) (count (get target :binding-ids))) false))
          (loop [ids (get target :binding-ids) i 0 out []]
            (if (= 0 (count ids)) out
              (let [parameter (get parameters i) type (get parameter :type) declaration (get declarations i)]
                (if (p15-s23-typed-all [(map? declaration) (= (first ids) (get parameter :binding-id))
                        (= false (contains? #{nil :gravity.type/unknown} type))
                        (= type (get (get context :parameter-types) (first ids)))
                        (p15-s23-typed-parameter-declaration? declaration type context)])
                  (recur (rest ids) (+ i 1) (conj out type)) nil)))) nil) nil)) nil))

(defn p15-s23-typed-loop-parent? [context target]
  (let [parent (get context :nearest-target) record (get context :current-function)
        node (get (get context :nodes) (get record :function-core-node-id)) body (get (get context :nodes) (get record :body-core-node-id))
        expected {:target-id (get (get node :attributes) :recur-target-id) :target-kind :function :owner-core-node-id (get node :node-id)
                  :owner-form-id (get (get node :source) :form-id) :owner-syntax-id (get (get node :source) :syntax-id)
                  :arity (get record :fixed-arity) :binding-ids (get record :parameter-binding-ids)
                  :body-scope-id (get body :binding-context) :parent-target-id nil :type-compatibility :pending-sh08}]
    (if (= (get target :parent-target-id) (get parent :target-id))
      (if (= :function (get parent :target-kind)) (= expected parent)
        (if (= :loop (get parent :target-kind)) true (= record nil))) false)))

(defn p15-s23-typed-bindings [context node records vector-form budget kind]
  (let [forms (get context :forms) children (get node :children) ids (get vector-form :child-form-ids)]
    (loop [index 0 current context prior [] compiled [] used 0 scope (get (get forms (get (get node :source) :form-id)) :scope-id)]
      (if (= index (count records))
        (assoc (p15-s23-compiler-result {:context current :bindings compiled :body-scope scope}) :work-count used)
        (let [record (get records index) binding (get (get context :bindings) (get record :binding-id))
              name-form (get forms (get ids (* 2 index))) init-form (get forms (get ids (+ 1 (* 2 index))))
              initializer (get (get context :nodes) (get children index)) type (get (get context :types) (get children index))
              expected {:ordinal index :name (get name-form :value)
                        :binding-id (get binding :binding-id) :definition-form-id (get name-form :form-id)
                        :definition-syntax-id (get name-form :syntax-id) :binding-scope-id (get binding :scope-id)
                        :initializer-form-id (get init-form :form-id) :initializer-syntax-id (get init-form :syntax-id)
                        :initializer-scope-id scope :initializer-node-id (get initializer :node-id)
                        :visible-prior-binding-ids prior :mutability :immutable}
              expected (assoc expected (if (= kind :loop) :loop-core-node-id :let-core-node-id) (get node :node-id))]
          (if (< (- budget used) 8) (p15-s23-typed-node-error :typed-lowering-work-limit node)
            (if (p15-s23-typed-all
                  [(= expected record) (= [:lexical :local] [(get binding :binding-class) (get binding :kind)])
                   (= (get name-form :syntax-id) (get binding :definition-syntax-id))
                   (= (get name-form :scope-id) (get binding :scope-id)) (= (get name-form :value) (get binding :name))
                   (symbol? (get binding :name)) (= :symbol (get name-form :kind)) (= [] (get name-form :child-form-ids))
                   (= (get vector-form :form-id) (get name-form :parent-form-id) (get init-form :parent-form-id))
                   (= scope (get init-form :scope-id)) (= (get initializer :source) (p15-s23-typed-source init-form))
                   (if (= kind :loop) (= scope (get initializer :binding-context)) true)
                   (= false (contains? (get current :locals) (get binding :binding-id)))
                   (if (= kind :loop) (p15-s23-typed-loop-slot? context record initializer type)
                     (= (p15-s23-typed-let-fact context record initializer type) (get (get context :local-facts) (get binding :binding-id))))])
              (let [value (p15-s23-typed-compile-node (assoc current :tail? false) (get initializer :node-id) (- budget used 8))]
                (if (p15-s23-compiler-complete? value)
                  (recur (+ index 1)
                    (assoc current :locals (assoc (get current :locals) (get binding :binding-id) (get binding :name))
                                   :parameter-types (assoc (get current :parameter-types) (get binding :binding-id)
                                     (if (if (= kind :loop) (map? (get (get context :loop-member-invariants) (get binding :binding-id))) false)
                                       (get (get (get context :loop-member-invariants) (get binding :binding-id)) :invariant-type) type)))
                    (conj prior (get binding :binding-id)) (conj compiled {:name (get binding :name) :expr (get value :value)})
                    (+ used 8 (get value :work-count)) (get binding :scope-id)) value))
              (p15-s23-typed-node-error :typed-let-binding-or-type-mismatch node))))))))

(defn p15-s23-typed-compile-let [context node budget]
  (let [attrs (get node :attributes) children (get node :children) forms (get context :forms)
        owner (get forms (get (get node :source) :form-id)) ids (get owner :child-form-ids)
        vector-form (get forms (get attrs :binding-vector-form-id)) vector-ids (get vector-form :child-form-ids)
        count-bindings (get attrs :binding-count) count-body (get attrs :body-count)
        records (loop [remaining (get context :lexical) out []]
                  (if (= 0 (count remaining)) out
                    (recur (rest remaining) (if (= (get node :node-id) (get (first remaining) :let-core-node-id))
                                             (conj out (first remaining)) out))))]
    (if (= false (p15-s23-typed-all [(vector? children) (vector? ids) (vector? vector-ids)
                                    (integer? count-bindings) (integer? count-body)]))
      (p15-s23-typed-node-error :malformed-typed-let-family node)
    (if (if (>= count-bindings 0) (if (> count-body 0) (<= (+ count-bindings count-body) 65536) false) false)
    (if (= false (p15-s23-typed-all [(= (+ count-bindings count-body) (count children))
                                    (= (+ count-body 2) (count ids)) (= (* 2 count-bindings) (count vector-ids))]))
      (p15-s23-typed-node-error :typed-let-source-or-census-mismatch node)
    (if (< budget (+ 1 (* 8 count-bindings) (* 4 count-body))) (p15-s23-typed-node-error :typed-lowering-work-limit node)
      (let [fixed-work (+ 1 (* 4 count-body)) body-ids (subvec children count-bindings (count children))
            expected-attrs {:binding-vector-form-id (get vector-form :form-id) :binding-vector-syntax-id (get vector-form :syntax-id)
                            :outer-scope-id (get owner :scope-id) :body-scope-id (get (get forms (get ids 2)) :scope-id)
                            :binding-count count-bindings :body-count count-body
                            :initializer-child-indexes (p15-s23-typed-index-range 0 count-bindings)
                            :body-child-indexes (p15-s23-typed-index-range count-bindings (+ count-bindings count-body))
                            :evaluation-order :initializers-then-body-left-to-right
                            :result-policy {:kind :last-body :child-index (- (+ count-bindings count-body) 1)}}
            normal-type (loop [remaining children result (get (get context :types) (get children (- (count children) 1))) never? false]
                          (if (= 0 (count remaining)) (if never? :gravity.type/never result)
                            (recur (rest remaining) result (if (= :gravity.type/never (get (get context :types) (first remaining))) true never?))))]
        (if (p15-s23-typed-all
              [(= attrs expected-attrs) (= count-bindings (count records)) (= (* 2 count-bindings) (count vector-ids))
               (= :list (get owner :kind)) (= :symbol (get (get forms (get ids 0)) :kind))
               (= 'let (get (get forms (get ids 0)) :value)) (= [] (get (get forms (get ids 0)) :child-form-ids))
               (= (get owner :form-id) (get (get forms (get ids 0)) :parent-form-id))
               (= (+ count-bindings count-body) (count children)) (= (+ count-body 2) (count ids))
               (= :vector (get vector-form :kind)) (= (get ids 1) (get vector-form :form-id))
               (= (get owner :form-id) (get vector-form :parent-form-id))
               (= (get node :source) (p15-s23-typed-source owner))
               (= (get node :resolved-binding-ids) (loop [remaining records out []]
                   (if (= 0 (count remaining)) out (recur (rest remaining) (conj out (get (first remaining) :binding-id))))))
               (= normal-type (get (get context :types) (get node :node-id)))
               (loop [i 0]
                 (if (= i count-body) true
                   (let [form (get forms (get ids (+ i 2))) body (get (get context :nodes) (get body-ids i))]
                     (if (p15-s23-typed-all [(= (get body :source) (p15-s23-typed-source form))
                           (= (get owner :form-id) (get form :parent-form-id)) (= (get attrs :body-scope-id) (get form :scope-id))])
                       (recur (+ i 1)) false))))])
          (let [bindings (p15-s23-typed-let-bindings context node records vector-form (- budget fixed-work))]
            (if (p15-s23-compiler-complete? bindings)
              (if (= (get attrs :body-scope-id) (get (get bindings :value) :body-scope))
                (let [body (p15-s23-typed-compile-children-mode (get (get bindings :value) :context) body-ids (- budget fixed-work (get bindings :work-count)) [] :last 0)]
                  (if (p15-s23-compiler-complete? body)
                    (assoc (p15-s23-compiler-result
                      (loop [index (- count-bindings 1) out {:op :do :body (get body :value)}]
                        (if (< index 0) out (recur (- index 1) {:op :let :bindings [(get (get (get bindings :value) :bindings) index)] :body [out]}))))
                      :work-count (+ fixed-work (get bindings :work-count) (get body :work-count))) body))
                (p15-s23-typed-node-error :typed-let-body-scope-mismatch node)) bindings))
          (p15-s23-typed-node-error :typed-let-source-or-census-mismatch node)))))

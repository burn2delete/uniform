(defn p15-s23-ane-type-work [arguments budget]
  (let [limit (if (< budget 65536) budget 65536)]
    (if (< limit 1) {:status :rejected :reason :work-limit :work-count 1}
      (if (if (vector? arguments) (= 2 (count arguments)) false)
        (loop [index 0 used 1 integral-type nil atomic-seen? false]
          (if (= index 2)
            (if (if (= false (= nil integral-type)) atomic-seen? false)
              {:status :rejected :reason :unsupported-inequality-type-pair :work-count used}
              (if (= false (= nil integral-type))
                (if (= :gravity.type/integer integral-type)
                  {:status :accepted :work-count used :comparison-domain :integer}
                  {:status :accepted :work-count used :comparison-domain :fixed-integral :integer-type integral-type})
                {:status :accepted :work-count used}))
            (let [next (+ used 1)]
              (if (> next limit) {:status :rejected :reason :work-limit :work-count next}
                (let [type (get arguments index)]
                  (if (keyword? type)
                    (if (contains? #{:gravity.type/integer :gravity.type/i8 :gravity.type/i16 :gravity.type/i32 :gravity.type/i64
                                     :gravity.type/u8 :gravity.type/u16 :gravity.type/u32 :gravity.type/u64} type)
                      (if (if (= false (= nil integral-type)) (= integral-type type) true)
                        (recur (+ index 1) next type atomic-seen?)
                        {:status :rejected :reason :unsupported-inequality-type-pair :work-count next})
                      (if (contains? #{:gravity.type/nil :gravity.type/bool :gravity.type/character :gravity.type/string
                                       :gravity.type/symbol :gravity.type/keyword :gravity.type/never} type)
                        (recur (+ index 1) next integral-type (if (= :gravity.type/never type) atomic-seen? true))
                        {:status :rejected :reason :nonnumeric-atomic-type-required :work-count next}))
                    (if (map? type)
                      (let [work (+ used 3)]
                        (if (> work limit) {:status :rejected :reason :work-limit :work-count work}
                          (let [size (count type)]
                            (if (= 3 size)
                              (let [kind (get type :kind)]
                                (if (= :gravity.type/vector kind)
                                  (let [domain (p15-s23-ve-domain arguments (- limit work))
                                      total (+ work (get domain :work-count))]
                                  (if (= :accepted (get domain :status))
                                    {:status :accepted :comparison-domain :vector :vector-domain-work (get domain :work-count) :work-count total}
                                    {:status :rejected :reason (if (= :vector-equality-work-limit (get domain :reason))
                                                                :vector-inequality-work-limit (get domain :reason))
                                     :work-count total}))
                                  (if (= :gravity.type/set kind)
                                    (let [domain (p15-s23-kse-domain arguments (- limit work))
                                          total (+ work (get domain :work-count))]
                                      (if (= :accepted (get domain :status))
                                        {:status :accepted :comparison-domain :keyword-set
                                         :keyword-set-domain-work (get domain :work-count)
                                         :operand-counts (get domain :operand-counts) :work-count total}
                                        {:status :rejected :reason (if (= :keyword-set-equality-work-limit (get domain :reason))
                                                                    :keyword-set-inequality-work-limit (get domain :reason))
                                         :work-count total}))
                                    {:status :rejected :reason :nonnumeric-atomic-type-required :work-count work})))
                              (if (if (= 2 size)
                                (if (= :gravity.type/nil-or (get type :kind))
                                  (let [value (get type :value-type)]
                                    (if (keyword? value)
                                      (contains? #{:gravity.type/bool :gravity.type/character :gravity.type/string
                                                   :gravity.type/symbol :gravity.type/keyword} value) false)) false) false) (recur (+ index 1) work integral-type true) {:status :rejected :reason :nonnumeric-atomic-type-required :work-count work})))))
                      {:status :rejected :reason :nonnumeric-atomic-type-required :work-count next})))))))
        {:status :rejected :reason :binary-type-input-required :work-count 1}))))

(defn p15-s23-ane-binding? [binding module]
  (if (if (vector? (get binding :profile-set)) (vector? (get binding :target-set)) false)
  (p15-s23-typed-all
    [(= ['not= :core :var 'gravity.core {:name 'gravity/core :version "bootstrap-contract-v1"} :gravity.type/core-var :safe]
        [(get binding :name) (get binding :binding-class) (get binding :kind) (get binding :namespace)
         (get binding :package) (get binding :type-ref) (get binding :safety)])
     (= [] (get binding :effects) (get binding :capabilities))
     (= :jvm (get module :target))
     (contains? (set (get binding :profile-set)) (get module :profile))
     (contains? (set (get binding :target-set)) :all)]) false))

(defn p15-s23-ane-source [core node call edge nodes bindings types module validation]
  (if (if (vector? (get call :argument-node-ids))
        (if (= 2 (count (get call :argument-node-ids)))
          (if (vector? (get node :children)) (= 3 (count (get node :children))) false) false) false)
  (if (loop [remaining (conj (conj (conj (conj (conj (get call :argument-node-ids) (get call :operator-node-id)) (get call :operator-binding-id)) (get node :node-id)) (get (get node :source) :form-id)) (get (get node :source) :syntax-id))] (if (= 0 (count remaining)) (loop [remaining (get node :children)] (if (= 0 (count remaining)) true (if (if (keyword? (first remaining)) true (if (string? (first remaining)) (= 71 (count (first remaining))) false)) (recur (rest remaining)) false))) (if (if (keyword? (first remaining)) true (if (string? (first remaining)) (= 71 (count (first remaining))) false)) (recur (rest remaining)) false)))
(let [children (get node :children) operator (get nodes (get call :operator-node-id))
        bid (get call :operator-binding-id) binding (get bindings bid) args (get call :argument-node-ids)
        arguments (p15-s23-io-child-types args types)

        invoked? (loop [remaining arguments]
                   (if (= 0 (count remaining)) true
                     (if (= :gravity.type/never (first remaining)) false (recur (rest remaining)))))
        caller (loop [remaining (get core :function-records)]
                 (if (= 0 (count remaining)) nil
                   (if (= (get (first remaining) :function-syntax-id) (get (get node :evaluation) :owner-function-syntax-id))
                     (first remaining) (recur (rest remaining)))))
        expected-call {:core-node-id (get node :node-id) :operator-node-id (first children) :operator-binding-id bid
                       :argument-node-ids (vec (rest children)) :ordered-evaluation-node-ids children
                       :evaluation-order :operator-then-arguments :result-policy :call-result}
        expected-edge {:ordinal (get edge :ordinal) :call-core-node-id (get node :node-id)
                       :caller-function-syntax-id (get caller :function-syntax-id) :caller-function-core-node-id (get caller :function-core-node-id)
                       :callee-binding-id bid :callee-definition-syntax-id (get binding :definition-syntax-id)
                       :callee-function-syntax-id nil :callee-function-core-node-id nil :argument-core-node-ids args
                       :ordered-evaluation-node-ids children :evaluation-order :operator-then-arguments :classification :nonlocal-or-nonfunction}]
    (if (p15-s23-typed-all
          [(= :accepted (get validation :status))  (= :call (get node :core-form)) (= :reference (get operator :core-form))
           (= 2 (count args)) (= expected-call call) (= expected-edge edge) (p15-s23-ane-binding? binding module)
           (= [bid] (get node :resolved-binding-ids) (get operator :resolved-binding-ids))
           (= {:symbol (get (get operator :attributes) :symbol) :position :operator :binding-id bid :binding-class :core
               :definition-syntax-id (get binding :definition-syntax-id)} (get operator :attributes))
           (contains? '#{not= gravity.core/not=} (get (get operator :attributes) :symbol))
           (= :operator-then-arguments (get (get node :evaluation) :kind))
           (= (loop [i 0 out []] (if (= i (count children)) out
                (recur (+ i 1) (conj out {:index i :core-node-id (get children i)})))) (get (get node :evaluation) :order))
           (loop [remaining arguments]
             (if (= 0 (count remaining)) true
               (if (if (= nil (first remaining)) true (= :gravity.type/unknown (first remaining))) false (recur (rest remaining)))))] )
      (let [header {:kind :gravity.type/applied-atomic-inequality :version :sh08-atomic-inequality-v1
       :operation 'not= :semantic-owner 'gravity.core :intrinsic :gravity.core/atomic-value-inequality
       :resolution :gravity.core-compatibility :operator-node-id (get operator :node-id) :operator-binding-id bid
       :call-core-node-id (get node :node-id) :source (get node :source) :operator-source (get operator :source)
       :source-call call :source-edge edge :source-binding binding :argument-types arguments :operand-type-work (get validation :work-count)

       :inequality-policy {:operation :complement-of-binary-atomic-value-equality
                         :domain [:nil :boolean :character :string :symbol :keyword]
                         :operand-evaluation :left-to-right-once :operand-position :non-tail
                         :nil-bearing :compare-original-values :cross-family :actual-value-families
                         :identity :unobserved :coercion :none :normalization :none :locale :none
                         :numeric :unsupported :collections :unsupported :construction :none
                         :lowering :owned-equality-branch-complement :entry-contract :type-conforming-typed-calls}
       :application (if invoked? :normal :not-invoked)
       :latent-effects [] :direct-effects [] :capabilities [] :thrown-error-effects []
       :profile (get module :profile) :target (get module :target)
       :invalidation [:calls :call-edges :binding-table :source-forms :type-table :lexical-bindings :definitions :function-records
                      :callee-body :inequality-policy  :operand-type :profile :target :evaluation-order]}]
        (if (= :integer (get validation :comparison-domain))
          (assoc header :numeric-equality {:version :sh08-integer-inequality-v1
                           :semantic-owner 'gravity.math :layer0-owner 'gravity.math.core
                           :integer-type :gravity.type/integer :numeric-mode :proof-required :safety :proven-safe
                           :safety-rule :same-integral-value-equality-no-conversion-overflow-or-rounding
                           :equality-policy {:domain :same-integral-type :comparison :original-integer-values
                                             :conversion :none :arithmetic :none :overflow :impossible
                                             :rounding :none :cross-type :unsupported}}
                 :inequality-policy {:operation :complement-of-binary-atomic-value-equality
                           :domain [:integer] :operand-evaluation :left-to-right-once :operand-position :non-tail
                           :nil-bearing :unsupported :cross-family :unsupported :identity :unobserved
                           :coercion :none :normalization :none :locale :none :numeric :same-established-integer
                           :collections :unsupported :construction :none :lowering :owned-equality-branch-complement
                           :entry-contract :type-conforming-typed-calls}
                 :invalidation (conj (conj (conj (conj (get header :invalidation) :numeric-equality) :integral-type) :numeric-mode) :value-policy))
          (if (= :fixed-integral (get validation :comparison-domain))
            (assoc header :numeric-equality {:version :sh08-fixed-integral-inequality-v1
                           :semantic-owner 'gravity.math :layer0-owner 'gravity.math.core
                           :integer-type (get validation :integer-type) :numeric-mode :proof-required :safety :proven-safe
                           :safety-rule :same-integral-value-equality-no-conversion-overflow-or-rounding
                           :equality-policy {:domain :same-integral-type :comparison :original-integer-values
                                             :conversion :none :arithmetic :none :overflow :impossible
                                             :rounding :none :cross-type :unsupported}}
                   :inequality-policy {:operation :complement-of-binary-atomic-value-equality
                           :domain :same-integral-type :integer-type (get validation :integer-type)
                           :operand-evaluation :left-to-right-once :operand-position :non-tail
                           :nil-bearing :unsupported :cross-family :unsupported :identity :unobserved
                           :coercion :none :normalization :none :locale :none :numeric :same-established-fixed-integral-type
                           :collections :unsupported :construction :none :lowering :owned-equality-branch-complement
                           :entry-contract :type-conforming-typed-calls}
                   :invalidation (conj (conj (conj (conj (get header :invalidation) :numeric-equality) :integral-type) :numeric-mode) :value-policy))
            (if (= :vector (get validation :comparison-domain))
              (assoc header :intrinsic :gravity.core/vector-value-inequality
                     :vector-equality {:version :sh08-vector-inequality-v1 :semantic-owner 'gravity.collections
                            :equality-version :sh08-vector-equality-v1
                            :equality-policy {:domain :finite-persistent-vectors :members :recursive-vector-and-supported-atomic
                         :count :equal :order :corresponding-values :leaves :original-values
                         :nil-bearing :compare-original-values :cross-family :actual-value-families
                         :nested-vector-versus-atomic :false
                         :identity :unobserved :payload-evaluation :none :mutation :none :numeric :unsupported}
                            :type-domain {:shape :literal-positional :maximum-width 1024 :maximum-depth 128
                                          :maximum-work 65536 :scalar-leaves [:nil :boolean :character :string :symbol :keyword]
                                          :nil-or-leaves :five-closed-nonnumeric-atomic-views
                                          :whole-nil-or-vector :unsupported :nested-never :unsupported
                                          :validation :both-complete-domains-before-value-comparison}
                            :domain-type-work (get validation :vector-domain-work)}
                     :inequality-policy {:operation :complement-of-binary-vector-value-equality
                            :domain :finite-persistent-vectors :members :recursive-vector-and-supported-atomic
                            :operand-evaluation :left-to-right-once :operand-position :non-tail
                            :nil-bearing :compare-original-values :cross-family :actual-value-families
                            :cross-collection :unsupported :identity :unobserved :coercion :none :normalization :none :locale :none
                            :numeric :unsupported :collections :finite-persistent-vectors :construction :none
                            :payload-evaluation :none :mutation :none :lowering :owned-equality-branch-complement
                            :entry-contract :type-conforming-typed-calls}
                     :invalidation (conj (conj (conj (get header :invalidation) :vector-equality) :equality-domain) :value-policy))
              (if (= :keyword-set (get validation :comparison-domain))
                (if (= :jvm (get module :target))
                  (assoc header :intrinsic :gravity.core/keyword-set-value-inequality
                         :keyword-set-equality {:version :sh08-keyword-set-inequality-v1 :semantic-owner 'gravity.collections
                            :equality-version :sh08-keyword-set-equality-v1
                            :equality-policy {:domain :finite-persistent-keyword-sets :members :keyword-only
                         :comparison :guarded-atomic-keyword-leaf :order :unobserved
                         :domain-validation :both-complete-before-result
                         :member-uniqueness :validated-before-cardinality :budget :full-worst-case-reservation
                         :identity :unobserved :payload-evaluation :none :mutation :none
                         :collection-construction :none :provider-cpu-bound :not-established}
                            :type-domain {:shape :literal :members :keyword-only :maximum-width 1024 :maximum-work 65536
                                          :validation :both-complete-domains-before-value-comparison
                                          :whole-nil-or-set :unsupported :nested-members :unsupported}
                            :operand-counts (get validation :operand-counts)
                            :domain-type-work (get validation :keyword-set-domain-work)}
                         :inequality-policy {:operation :complement-of-binary-keyword-set-value-equality
                            :domain :finite-persistent-keyword-sets :members :keyword-only
                            :operand-evaluation :left-to-right-once :operand-position :non-tail
                            :order :unobserved :domain-validation :both-complete-before-result
                            :member-uniqueness :validated-before-cardinality :budget :full-worst-case-reservation
                            :cross-collection :unsupported :nil-bearing :unsupported :identity :unobserved
                            :coercion :none :normalization :none :locale :none :numeric :unsupported
                            :collections :finite-persistent-keyword-sets :construction :none
                            :payload-evaluation :none :mutation :none :provider-cpu-bound :not-established
                            :lowering :owned-equality-branch-complement :entry-contract :type-conforming-typed-calls}
                         :invalidation (conj (conj (conj (get header :invalidation) :keyword-set-equality) :equality-domain) :value-policy)) nil)
                header))))) nil)) nil) nil))

(defn p15-s23-ane-constraint [descriptor]
  {:constraint-id-request {:domain :gravity/sh08-atomic-inequality-constraint-v1 :application descriptor}
   :kind :equality :producer-rule :sh08-atomic-inequality-v1
   :lhs {:core-node-id (get descriptor :call-core-node-id) :projection :atomic-inequality}
   :rhs (get descriptor :result-type) :dependencies descriptor :origin (get (get descriptor :source) :origin-chain)
   :solution (let [solution {:result-type (get descriptor :result-type) :application (get descriptor :application)
              :direct-effects (get descriptor :direct-effects)
              }]
                (if (contains? descriptor :numeric-equality)
                  (assoc solution :numeric-equality (get descriptor :numeric-equality))
                  (if (contains? descriptor :vector-equality)
                    (assoc solution :vector-equality (get descriptor :vector-equality))
                    (if (contains? descriptor :keyword-set-equality)
                      (assoc solution :keyword-set-equality (get descriptor :keyword-set-equality)) solution))))
   :invalidation (get descriptor :invalidation) :profile (get descriptor :profile) :target (get descriptor :target)
   :status :solved :diagnostics []})

(defn p15-s23-ane-call-fact [descriptor module]
  (let [source (get descriptor :source) edge (get descriptor :source-edge)]
    {:artifact :gravity/c7-call-type-fact
     :fact-id-request {:domain :gravity/sh08-atomic-inequality-call-type-fact-v1 :application descriptor}
     :call-core-node-id (get descriptor :call-core-node-id) :caller-function-syntax-id (get edge :caller-function-syntax-id)
     :callee-function-syntax-id nil :argument-types (get descriptor :argument-types) :result-type (get descriptor :result-type)
     :evaluation-order :operator-then-arguments :source-span (get source :semantic-span) :syntax-id (get source :syntax-id)
     :origin-chain (get source :origin-chain) :generated-origin (get source :generated-origin)
     :profile (get module :profile) :target (get module :target) :effects (get descriptor :direct-effects) :capabilities [] :status :inferred

     :dispatch :direct-atomic-inequality :applied-atomic-inequality descriptor :effect-facts-source (if (contains? descriptor :vector-equality) :audited-vector-inequality-intrinsic
       (if (contains? descriptor :keyword-set-equality) :audited-keyword-set-inequality-intrinsic :audited-atomic-inequality-intrinsic))}))

(defn p15-s23-ane-finish [header]
  (let [type (if (= :normal (get header :application)) :gravity.type/bool :gravity.type/never)]
    (assoc header :parameter-types (get header :argument-types) :return type :result-type type)))

(defn p15-s23-typed-compile-atomic-inequality [context node budget]
  (let [id (get node :node-id) core (get context :core)
        charge (+ 70 (count (get core :function-records)) (* 4 (count (get context :ledger))))]
    (if (> charge budget) (assoc (p15-s23-typed-node-error :typed-lowering-work-limit node) :work-count charge)
      (let [call (if (if (keyword? id) true (if (string? id) (= 71 (count id)) false)) (get (get context :calls) id) nil) edge (if (if (keyword? id) true (if (string? id) (= 71 (count id)) false)) (get (get context :edges) id) nil)
            args (get call :argument-node-ids) children (get node :children)]
        (if (= false (if (vector? args) (if (= 2 (count args))
                      (if (vector? children) (= 3 (count children)) false) false) false))
          (assoc (p15-s23-typed-node-error :unsupported-or-mismatched-typed-atomic-inequality node) :work-count charge)
          (if (loop [remaining (conj (conj (conj (conj (conj (get call :argument-node-ids) (get call :operator-node-id)) (get call :operator-binding-id)) (get node :node-id)) (get (get node :source) :form-id)) (get (get node :source) :syntax-id))] (if (= 0 (count remaining)) (loop [remaining (get node :children)] (if (= 0 (count remaining)) true (if (if (keyword? (first remaining)) true (if (string? (first remaining)) (= 71 (count (first remaining))) false)) (recur (rest remaining)) false))) (if (if (keyword? (first remaining)) true (if (string? (first remaining)) (= 71 (count (first remaining))) false)) (recur (rest remaining)) false))) (let [nodes (get context :nodes) forms (get context :forms)
                validation (p15-s23-ane-type-work [(get (get context :types) (first args) :gravity.type/unknown) (get (get context :types) (get args 1) :gravity.type/unknown)] (- budget charge))
                work (+ charge (get validation :work-count))

                      :callee-body :original-string-literal :conversion-policy :source-scalar-proof :result-storage-policy :allocation-condition :profile :target :evaluation-order]} nil)) nil) nil))

(defn p15-s23-scv-finish [header]
  (let [normal? (= :normal (get header :application))
        n (get (get header :conversion-proof) :scalar-count)
        type (if normal?
               {:kind :gravity.type/vector :shape :literal
                :element-types (loop [i 0 out []]
                                 (if (= i n) out (recur (+ i 1) (conj out :gravity.type/character))))}
               :gravity.type/never)]
    (assoc header :parameter-types (get header :argument-types) :return type :result-type type)))



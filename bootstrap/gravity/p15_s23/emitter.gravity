            {:status :rejected :reason :map-get-source-mismatch :work-count charge})))
      (assoc opened :work-count work))))

(defn p15-s23-pc-source-leaf [cursor shape source nodes forms budget]
  (let [id (get source :value-form-id) prefix 32]
    (if (> prefix budget) {:status :rejected :reason :map-get-work-limit :work-count prefix}
      (if (p15-s23-pc-id? id)
        (let [form (get forms id)
              measured (p15-s23-pc-evidence-work {:value (get form :value) :source (get shape :source)
                                              :origin (get shape :data-origin)} (- budget prefix))
              work (+ prefix (get measured :work-count)) kind (get form :kind)
              type (p15-s23-pc-literal-type kind) values (get (get shape :domain) :values)]
          (if (= :accepted (get measured :status))
            (if (p15-s23-typed-all
                  [(= id (get form :form-id)) (keyword? type) (= type (get shape :type)) (= kind (p15-s23-pc-value-kind (get form :value)))
                   (= (get source :value-syntax-id) (get form :syntax-id))
                   (= (get source :parent-form-id) (get form :parent-form-id))
                   (if (vector? (get form :child-form-ids)) (= 0 (count (get form :child-form-ids))) false)
                   (= (get shape :source) (p15-s23-typed-source form))
                   (if (vector? values) (if (= 1 (count values)) (= (get values 0) (get form :value)) false) false)
                   (if (= :quoted-data (get source :source-kind))
                     (= (get shape :data-origin) (p15-s23-pc-data-origin (get source :quote-core-node-id) form
                                                   (conj (get source :data-path) (get source :coordinate))))

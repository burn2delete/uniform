                      (let [source-call (get calls id) source-edge (get edges id) source-node (get nodes id)
                            result (if (= target id) {:status :accepted :descriptor descriptor :work-count 0}
                                     (p15-s23-mkeys-header core source-node source-call source-edge nodes bindings types (get core :module) (- budget used)))
                            total (+ used (get result :work-count)) canonical (get result :descriptor)]

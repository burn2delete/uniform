                      {:status :rejected :reason (if (= :vector-empty-work-limit (get calls :reason)) :vector-empty-work-limit :vector-empty-source-mismatch)
                       :work-count total}))
                  {:status :rejected :reason (get rows :reason) :work-count work}))
              {:status :rejected :reason :vector-empty-source-mismatch :work-count base})))
        derived))
    {:status :rejected :reason :vector-empty-source-mismatch :work-count 0}))

(defn p15-s23-vemp-forms? [node call nodes forms]

                                       (if (if (map? record)
                                             (p15-s23-sse-ids? [(get record :function-syntax-id) (get record :function-core-node-id)] 2) false)
                                         (if (= (get (get node :evaluation) :owner-function-syntax-id) (get record :function-syntax-id))

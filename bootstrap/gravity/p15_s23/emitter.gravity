(defn p15-s23-cqs-quotient [core node nodes bindings types forms budget]
  ; Reconstruct the existing quotient and its exact source, paying its work.
  (let [work (+ 64 2 (count (get core :function-records))
                  (* 2 (count (get core :calls))) (* 2 (count (get core :call-edges))))]
    (if (> work budget) {:status :rejected :reason :count-quotient-scaling-work-limit :work-count work}
      (if (p15-s23-sse-ids? [(get node :node-id)] 1)
        (let [call (p15-s23-nq-one (get core :calls) :core-node-id (get node :node-id))
              edge (p15-s23-nq-one (get core :call-edges) :call-core-node-id (get node :node-id))]
          (if (if (p15-s23-nq-ids? node call nodes bindings (get core :module))
                (if (integer? (get edge :ordinal)) (>= (get edge :ordinal) 0) false) false)
            (let [count-node (get nodes (get (get call :argument-node-ids) 0))
                  count-call (p15-s23-nq-one (get core :calls) :core-node-id (get (get call :argument-node-ids) 0))]
              (if (p15-s23-nq-ids? count-node count-call nodes bindings (get core :module))
                (let [operator (get nodes (get call :operator-node-id))
                      count-operator (get nodes (get count-call :operator-node-id))
                      operator-form (get forms (get (get operator :source) :form-id))
                      count-operator-form (get forms (get (get count-operator :source) :form-id))]
                  (if (if (symbol? (get operator-form :value)) (symbol? (get count-operator-form :value)) false)
                    (let [checked (p15-s23-nq-proof core node call nodes bindings types forms (- budget work))
                  work (+ work (get checked :work-count))
                  proof (get checked :proof)
                  header (if (= :accepted (get checked :status))
                           (p15-s23-nq-source core node call edge nodes bindings types (get core :module) proof) nil)
                  owner (get forms (get (get node :source) :form-id)) ids (get owner :child-form-ids)]
              (if (if (map? header)
                    (if (= :normal (get header :application))
                      (= :authenticated-cardinality (get (get proof :dividend) :kind)) false) false)
                (if (p15-s23-typed-all
                      [(= :gravity.type/integer (get types (get node :node-id)))
                       (= :list (get owner :kind)) (= (get node :source) (p15-s23-typed-source owner))
                       (if (vector? ids) (if (= 3 (count ids)) (p15-s23-sse-ids? ids 3) false) false)
                       (= {:operator-child-index 0 :argument-count 2 :argument-child-indexes [1 2]
                           :evaluation-order :operator-then-arguments :dispatch :resolved-symbol-call} (get node :attributes))
                       (if (if (vector? ids) (if (= 3 (count ids)) (p15-s23-sse-ids? ids 3) false) false) (loop [i 0] (if (= i 3) true
                         (let [form (get forms (get ids i)) child (get nodes (get (get node :children) i))]
                           (if (if (= (get owner :form-id) (get form :parent-form-id))
                                 (if (= (get child :source) (p15-s23-typed-source form))
                                   (if (= i 0) (if (symbol? (get form :value)) (= (get form :value) (get (get child :attributes) :symbol)) false) true) false) false)
                             (recur (+ i 1)) false)))) false)])
                  (let [descriptor (p15-s23-nq-finish header)]
                    (if (= descriptor (get types (get call :operator-node-id)))
                      {:status :accepted :work-count work
                       :quotient {:kind :authenticated-count-quotient :descriptor descriptor
                                  :constraint (p15-s23-nq-constraint descriptor)
                                  :call-fact (p15-s23-nq-call-fact descriptor (get core :module))}}
                      {:status :rejected :reason :count-quotient-scaling-source-mismatch :work-count work}))
                  {:status :rejected :reason :count-quotient-scaling-source-mismatch :work-count work})
                {:status :rejected :reason (if (= :nonnegative-integer-quotient-work-limit (get checked :reason))
                                             :count-quotient-scaling-work-limit :count-quotient-scaling-proof-required)
                 :work-count work}))
                    {:status :rejected :reason :count-quotient-scaling-source-mismatch :work-count work}))
                {:status :rejected :reason :count-quotient-scaling-proof-required :work-count work}))
            {:status :rejected :reason :count-quotient-scaling-source-mismatch :work-count work}))
        {:status :rejected :reason :count-quotient-scaling-source-mismatch :work-count work}))))

(defn p15-s23-cqs-proof [core node call nodes bindings types forms budget]
  ; d*q <= count is the premise; q <= count alone does not bound k*q.
  (let [base (+ 128 (* 2 (count (get core :calls))) (* 2 (count (get core :call-edges)))
                   (* 4 (count (get core :function-records))))]
    (if (> base budget) {:status :rejected :reason :count-quotient-scaling-work-limit :work-count base}
      (if (if (vector? (get call :argument-node-ids)) (= 2 (count (get call :argument-node-ids))) false)
        (if (p15-s23-nq-ids? node call nodes bindings (get core :module))
          (let [operator (get nodes (get call :operator-node-id))
                operator-form (get forms (get (get operator :source) :form-id))
                owner-form (get forms (get (get node :source) :form-id))
                owner-ids (get owner-form :child-form-ids)]
            (if (if (symbol? (get operator-form :value))
                  (if (= [] (get operator-form :child-form-ids))
                    (if (vector? owner-ids) (if (= 3 (count owner-ids)) (p15-s23-sse-ids? owner-ids 3) false) false) false) false)
              (let [ids (get call :argument-node-ids) left-type (get types (get ids 0)) right-type (get types (get ids 1))
                factor (if (= :gravity.type/never left-type) {:kind :non-invoked-operand}
                         (p15-s23-nq-literal (get nodes (get ids 0)) left-type forms false))
                checked (if (= :gravity.type/never right-type)
                          {:status :accepted :work-count 0 :quotient {:kind :non-invoked-operand}}
                          (if (= :gravity.type/integer right-type)
                            (p15-s23-cqs-quotient core (get nodes (get ids 1)) nodes bindings types forms (- budget base))
                            {:status :rejected :reason :count-quotient-scaling-proof-required :work-count 0}))
                work (+ base (get checked :work-count))
                quotient (get checked :quotient) descriptor (get quotient :descriptor)
                qproof (get descriptor :range-proof) divisor (get (get qproof :divisor) :value)
                normal? (if (= :gravity.type/never left-type) false (= :gravity.type/integer right-type))
                bounded? (if normal? (if (map? factor) (if (integer? divisor) (<= (get factor :value) divisor) false) false) true)]
            (if (if (map? factor) (if (= :accepted (get checked :status)) bounded? false) false)
              (let [outer (loop [remaining (get node :children) out [(get forms (get (get node :source) :form-id))]]
                            (if (= 0 (count remaining)) out
                              (recur (rest remaining) (conj out (get forms (get (get (get nodes (first remaining)) :source) :form-id))))))
                    qforms (if (= :authenticated-count-quotient (get quotient :kind))
                             (get qproof :source-forms) [])
                    count-forms (if (= :authenticated-count-quotient (get quotient :kind))
                                  (get (get qproof :dividend) :child-source-forms) [])
                    joined-q (loop [remaining qforms out outer]
                             (if (= 0 (count remaining)) out (recur (rest remaining) (conj out (first remaining)))))
                    joined (loop [remaining count-forms out joined-q]
                             (if (= 0 (count remaining)) out (recur (rest remaining) (conj out (first remaining)))))]
                {:status :accepted :work-count work
                 :proof {:schema :gravity/count-quotient-scaling-proof-v1 :call-core-node-id (get node :node-id)
                         :source-forms joined :factor factor :quotient quotient :mode :proof-required
                         :application (if normal? :normal :not-invoked)
                         :law :scaled-quotient-bounded-by-original-count
                         :euclidean-premise :divisor-times-quotient-at-most-count
                         :coefficient-bound (if normal? :zero-through-original-positive-divisor :not-required-for-aborted-invocation)
                         :result-value-bound (if normal? :zero-through-original-count :not-invoked)
                         :overflow :impossible :conversion :none}})
              {:status :rejected :reason (if (= :count-quotient-scaling-work-limit (get checked :reason))
                                          :count-quotient-scaling-work-limit
                                          (if (= :count-quotient-scaling-source-mismatch (get checked :reason))
                                            :count-quotient-scaling-source-mismatch :count-quotient-scaling-proof-required))
               :work-count work}))
              {:status :rejected :reason :count-quotient-scaling-source-mismatch :work-count base}))
          {:status :rejected :reason :count-quotient-scaling-source-mismatch :work-count base})
        {:status :rejected :reason :count-quotient-scaling-arity-mismatch :work-count base}))))

(defn p15-s23-cqs-source [core node call edge nodes bindings types module proof]
  (if (if (map? edge) (if (integer? (get edge :ordinal)) (>= (get edge :ordinal) 0) false) false)
    (if (p15-s23-nq-ids? node call nodes bindings module)
  (if (if (vector? (get call :argument-node-ids)) (vector? (get node :children)) false)
  (let [children (get node :children) operator (get nodes (get call :operator-node-id))
        bid (get call :operator-binding-id) binding (get bindings bid) args (get call :argument-node-ids)
        arguments (p15-s23-io-child-types args types)
        invoked? (loop [remaining arguments]
                   (if (= 0 (count remaining)) true
                     (if (= :gravity.type/never (first remaining)) false (recur (rest remaining)))))
        caller (loop [remaining (get core :function-records)]
                 (if (= 0 (count remaining)) nil
                   (if (= (get (first remaining) :function-syntax-id) (get (get node :evaluation) :owner-function-syntax-id))
                     (first remaining) (recur (rest remaining)))))
        expected-call {:core-node-id (get node :node-id) :operator-node-id (first children) :operator-binding-id bid
                       :argument-node-ids (vec (rest children)) :ordered-evaluation-node-ids children
                       :evaluation-order :operator-then-arguments :result-policy :call-result}
        expected-edge {:ordinal (get edge :ordinal) :call-core-node-id (get node :node-id)
                       :caller-function-syntax-id (get caller :function-syntax-id) :caller-function-core-node-id (get caller :function-core-node-id)
                       :callee-binding-id bid :callee-definition-syntax-id (get binding :definition-syntax-id)
                       :callee-function-syntax-id nil :callee-function-core-node-id nil :argument-core-node-ids args
                       :ordered-evaluation-node-ids children :evaluation-order :operator-then-arguments :classification :nonlocal-or-nonfunction}]
    (if (p15-s23-typed-all
          [(= :jvm (get module :target)) (map? proof) (= :gravity/count-quotient-scaling-proof-v1 (get proof :schema))
           (= :call (get node :core-form)) (= :reference (get operator :core-form))
           (= 2 (count args)) (= expected-call call) (= expected-edge edge) (p15-s23-cqs-binding? binding module)
           (= [bid] (get node :resolved-binding-ids) (get operator :resolved-binding-ids))
           (= {:symbol (get (get operator :attributes) :symbol) :position :operator :binding-id bid :binding-class :core

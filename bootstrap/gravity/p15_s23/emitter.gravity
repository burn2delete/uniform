                producer-ids? (loop [remaining producer-rows] (if (= 0 (count remaining)) true (let [lhs (get (first remaining) :lhs) row-id (get lhs :core-node-id)] (if (if (map? lhs) (if (= 2 (count lhs)) (if (= :nil-predicate (get lhs :projection)) (if (keyword? row-id) true (if (string? row-id) (= 71 (count row-id)) false)) false) false) false) (recur (rest remaining)) false))))
                rows (if producer-ids? (p15-s23-pe-select producer-rows :lhs {:core-node-id id :projection :nil-predicate}) [])]
            (if (= :work-limit (get validation :reason))
              (assoc (p15-s23-typed-node-error :typed-lowering-work-limit node) :work-count work)
              (if (if (if producer-ids? (if (map? descriptor) (if (vector? ids) (if (= 2 (count ids)) (loop [remaining ids] (if (= 0 (count remaining)) true (if (if (keyword? (first remaining)) true (if (string? (first remaining)) (= 71 (count (first remaining))) false)) (recur (rest remaining)) false))) false) false) false) false)
                    (p15-s23-typed-all

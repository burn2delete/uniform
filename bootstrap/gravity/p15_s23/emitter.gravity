                                (if (= canonical (get types (get source-call :operator-node-id)))
                                  (= (p15-s23-mkeys-constraint canonical) row) false) false)
                            (recur (+ index 1) (if (= target id) (conj items row) items) (conj seen id) (assoc descriptors id canonical) total)
                            {:status :rejected :reason :map-keys-source-mismatch :work-count total})
                          {:status :rejected :reason (get result :reason) :work-count total})))
                    {:status :rejected :reason :map-keys-source-mismatch :work-count used}))

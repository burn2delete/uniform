              (let [child (p15-s23-typed-compile-node (assoc context :tail? false)
                            (get (get call :argument-node-ids) index) (- budget used))]
                (if (p15-s23-compiler-complete? child)
                  (recur (+ index 1) (+ used (get child :work-count)) (conj values (get child :value)))
                  (assoc child :work-count (+ used (get child :work-count 0)))))))
          (assoc (p15-s23-typed-node-error :unsupported-or-mismatched-typed-map-removal node) :work-count charge))))))


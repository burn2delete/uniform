(defn p15-s23-kse-domain [arguments budget]
  ; Only independently finite literal Set domains establish Keyword membership.
  (let [limit (if (< budget 65536) budget 65536)]
    (if (if (vector? arguments) (= 2 (count arguments)) false)
      (if (< limit 2) {:status :rejected :reason :keyword-set-equality-work-limit :work-count 2}
        (loop [side 0 work 2 counts []]
          (if (= side 2) {:status :accepted :work-count work :argument-types arguments :operand-counts counts}
            (let [type (get arguments side)]
              (if (= :gravity.type/never type)
                (recur (+ side 1) work (conj counts nil))
                (if (if (map? type) (if (= 3 (count type))
                      (if (= :gravity.type/set (get type :kind))
                        (if (= :literal (get type :shape)) (vector? (get type :element-types)) false) false) false) false)
                  (let [members (get type :element-types) width (count members)]
                    (if (> width 1024) {:status :rejected :reason :keyword-set-equality-type-width :work-count work}
                      (if (> width (- limit work))
                        {:status :rejected :reason :keyword-set-equality-work-limit :work-count (+ work width)}
                        (let [total (+ work width)
                              valid? (loop [i 0]
                                       (if (= i width) true
                                         (if (= :gravity.type/keyword (get members i)) (recur (+ i 1)) false)))]
                          (if valid? (recur (+ side 1) total (conj counts width))
                            {:status :rejected :reason :keyword-set-equality-operand-type-required :work-count total})))))
                  {:status :rejected :reason :keyword-set-equality-operand-type-required :work-count work}))))))
      {:status :rejected :reason :keyword-set-equality-arity-mismatch :work-count 0})))

(defn p15-s23-kse-source [core node call edge nodes bindings types module validation]
  (if (if (vector? (get call :argument-node-ids))
        (if (= 2 (count (get call :argument-node-ids)))
          (if (vector? (get node :children)) (= 3 (count (get node :children))) false) false) false)
  (let [children (get node :children) operator (get nodes (get call :operator-node-id))
        bid (get call :operator-binding-id) binding (get bindings bid) args (get call :argument-node-ids)
        arguments (p15-s23-io-child-types args types)
        invoked? (loop [remaining arguments]
                   (if (= 0 (count remaining)) true

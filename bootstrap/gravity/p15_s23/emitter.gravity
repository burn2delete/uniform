; L5: a Map parameter forgets only independently checked member refinements.
(defn p15-s23-mp-compatibility [core call edge callee index actual nodes bindings budget]
  (let [parameter (get (get callee :parameters) index)]
    (if (if (= :gravity.type/map (get parameter :type))
          (if (map? actual) (= :gravity.type/map (get actual :kind)) false) false)
      (let [records (get core :function-records) base (+ 32 (count records))
            validation (p15-s23-lc-type-work [actual] (if (> base budget) 0 (- budget base)))
            work (+ base (get validation :work-count))

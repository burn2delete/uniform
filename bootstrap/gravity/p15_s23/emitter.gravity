                                                     :result-type :stored-value-lifetimes :result-storage-policy :profile :target :evaluation-order]}}
                        {:status :rejected :reason :map-keys-source-mismatch :work-count work}))
                    {:status :rejected :reason :map-keys-source-mismatch :work-count work}))
                      {:status :rejected :reason :map-keys-finite-keyword-map-type-required :work-count total})))
                  {:status :rejected :reason :map-keys-finite-keyword-map-type-required :work-count work})))))

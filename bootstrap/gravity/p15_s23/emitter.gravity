                                      {:status :accepted :work-count 0})
                        total (+ work (get branch-call :work-count))]
                    (if (= :accepted (get branch-call :status))
                      (let [work total
                            witness (if local-call?
                                      (loop [remaining (rest (get branch-call :source-forms))
                                             out [form operator then-form else-form (get forms (get (get (get nodes (get then-ids 1)) :source) :form-id))]]
                                        (if (= 0 (count remaining)) out (recur (rest remaining) (conj out (first remaining)))))
                                      [form operator then-form else-form])]
                        (loop [i 0]
                    (if (= i 3)
                      {:status :accepted :work-count work :root node :condition (get branch-nodes 0) :form form
                       :source-forms witness
                       :proof (let [proof {:kind :prefix-gate-if :node node :condition (get branch-nodes 0) :then (get branch-nodes 1) :else (get branch-nodes 2)
                               :control control :source-forms witness}]
                                 (if local-call? (assoc proof :kind :prefix-gate-call-if :then-call (get branch-call :proof)) proof))}
                      (let [child (get branch-nodes i) child-form (get selected-forms (+ i 2))
                            value (get (get child :attributes) :value)
                            expected-region (if (= i 0) region
                                              {:kind :conditional-branch :if-syntax-id (get form :syntax-id) :if-form-id (get form :form-id)
                                               :role (if (= i 1) :then :else) :execution :selected-exactly-once
                                               :parent-region-kind (if (map? region) (get region :kind) region)
                                               :parent-if-syntax-id (if (map? region) (get region :if-syntax-id) nil)
                                               :parent-branch-role (if (map? region) (get region :role) nil)})]
                        (if (if (if local-call? (= i 2) false) (if (boolean? value) (= false value) false) (if (if local-call? (= i 1) false) true (if (= i 0) true (if (boolean? value) (boolean? (get child-form :value)) false))))
                          (if (p15-s23-typed-all [(= (get children i) (get child :node-id)) (= (get child :source) (p15-s23-typed-source child-form))
                                    (= scope (get child :binding-context) (get child-form :scope-id))
                                    (= owner (get (get child :evaluation) :owner-function-syntax-id))
                                    (= expected-region (get (get child :evaluation) :region))
                                    (if (if local-call? (= i 1) false) true (if (= i 0) true
                                      (p15-s23-typed-all [(= :literal (get child :core-form)) (= :boolean (get child-form :kind))
                                            (= {:literal-kind :boolean :value value} (get child :attributes)) (= value (get child-form :value))
                                            (= [] (get child :children) (get child :resolved-binding-ids) (get child-form :child-form-ids))
                                            (= :value (get (get child :evaluation) :kind)) (= [] (get (get child :evaluation) :order))])))])
                            (recur (+ i 1)) {:status :rejected :reason :vector-slice-source-mismatch :work-count work})
                          {:status :rejected :reason :vector-slice-source-mismatch :work-count work})))))
                      (assoc branch-call :work-count total)))
                  {:status :rejected :reason :vector-slice-source-mismatch :work-count work})
                {:status :rejected :reason :vector-slice-source-mismatch :work-count work}))
            {:status :rejected :reason :vector-slice-source-mismatch :work-count work}))
        {:status :rejected :reason :vector-slice-source-mismatch :work-count work}))))

(defn p15-s23-vsl-prefix-if [core let-node node nodes forms budget]
  ; Existing both-literal branch subset and its proof/work remain unchanged.
  (p15-s23-vsl-if-container core let-node node nodes {} forms false budget))

(defn p15-s23-vsl-prefix-call-body [core let-node slice-node nodes bindings types forms budget]
  ; Exactly if -> then call -> this argument; its condition keeps its own slice proof.
  (let [base 128 ids (get let-node :children)]
    (if (> base budget) {:status :rejected :reason :vector-slice-work-limit :work-count base}
      (if (p15-s23-sse-ids? ids 2)
        (let [root (get nodes (get ids 1))
              container (p15-s23-vsl-if-container core let-node root nodes bindings forms true (- budget base))
              work (+ base (get container :work-count))]
          (if (= :accepted (get container :status))
            (let [condition (get container :condition) condition-ids (get condition :children)]
              (if (p15-s23-sse-ids? condition-ids 3)
                (let [prefix (get nodes (get condition-ids 1)) prefix-ids (get prefix :children) tail-ids (get slice-node :children)
                      local-ids (get let-node :resolved-binding-ids)]
                  (if (if (p15-s23-sse-ids? prefix-ids 4) (if (p15-s23-sse-ids? tail-ids 4)
                        (if (p15-s23-sse-ids? local-ids 1)
                          (p15-s23-sse-ids? [(get prefix :node-id) (get (get prefix :source) :form-id) (get (get prefix :source) :syntax-id)
                                         (get slice-node :node-id) (get (get slice-node :source) :form-id)] 5) false) false) false)
                    (let [prefix-op (get nodes (get prefix-ids 0)) prefix-ref (get nodes (get prefix-ids 1))
                          tail-op (get nodes (get tail-ids 0)) tail-ref (get nodes (get tail-ids 1))]
                      (if (if (p15-s23-sse-ids? [(get (get prefix-op :attributes) :binding-id) (get (get tail-op :attributes) :binding-id)
                                            (get (get prefix-ref :attributes) :binding-id) (get (get tail-ref :attributes) :binding-id)] 4)
                            (symbol? (get (get prefix-op :attributes) :symbol)) false)
                        (if (p15-s23-typed-all
                              [(= :call (get prefix :core-form)) (= false (= (get prefix :node-id) (get slice-node :node-id)))
                               (= (get slice-node :node-id) (get (get (get (get (get container :proof) :then-call) :call) :argument-node-ids) 0))
                               (contains? '#{subvec gravity.core/subvec} (get (get prefix-op :attributes) :symbol))
                               (= (get (get prefix-op :attributes) :binding-id) (get (get tail-op :attributes) :binding-id))
                               (= (get local-ids 0) (get (get prefix-ref :attributes) :binding-id) (get (get tail-ref :attributes) :binding-id))])
                          (let [comparison (p15-s23-vsl-let-equality-body core let-node prefix nodes bindings types forms (- budget work))
                                total (+ work (get comparison :work-count))]
                            (if (= :accepted (get comparison :status))
                              {:status :accepted :work-count total :node root :form (get container :form)
                               :source-forms (loop [remaining (get comparison :source-forms) out []]
                                               (if (= 0 (count remaining)) out
                                                 (let [form (first remaining)]
                                                   (recur (rest remaining) (if (= (get (get slice-node :source) :form-id) (get form :form-id)) out (conj out form))))))
                               :proof (assoc (get (get container :proof) :then-call)
                                             :kind :prefix-gated-local-function-slice-argument
                                             :condition-container (get container :proof) :prefix-comparison (get comparison :proof))}
                              (assoc comparison :work-count total)))
                          {:status :rejected :reason :vector-slice-source-mismatch :work-count work})
                        {:status :rejected :reason :vector-slice-source-mismatch :work-count work}))
                    {:status :rejected :reason :vector-slice-source-mismatch :work-count work}))
                {:status :rejected :reason :vector-slice-source-mismatch :work-count work}))
            (assoc container :work-count work)))
        {:status :rejected :reason :vector-slice-source-mismatch :work-count base}))))

(defn p15-s23-vsl-first-parent [core let-node node expected-id slice-node nodes bindings forms budget]
  ; Fixed original first edge; the 128-unit charge also covers caller root selection.
  (let [base 128 ids (get node :children)]
    (if (> base budget) {:status :rejected :reason :vector-slice-work-limit :work-count base}
      (if (if (p15-s23-sse-ids? ids 2)
                (p15-s23-sse-ids? [(get node :node-id) expected-id (get (get node :source) :form-id) (get (get node :source) :syntax-id)] 4) false)
            (let [operator (get nodes (get ids 0)) bid (get (get operator :attributes) :binding-id)
                  scope (get (get let-node :attributes) :body-scope-id)]
              (if (if (p15-s23-sse-ids? [(get operator :node-id) bid scope (get slice-node :node-id)] 4)
                    (if (p15-s23-sse-ids? [(get (get operator :source) :form-id) (get (get operator :source) :syntax-id)
                               (get (get slice-node :source) :form-id) (get (get slice-node :source) :syntax-id)] 4)
                      (symbol? (get (get operator :attributes) :symbol)) false) false)
                (let [binding (get bindings bid) owner (get forms (get (get node :source) :form-id))
                      op-form (get forms (get (get operator :source) :form-id))
                      profiles (get binding :profile-set) targets (get binding :target-set)
                      work (+ base (if (vector? profiles) (* 2 (count profiles)) 0) (if (vector? targets) (* 2 (count targets)) 0))
                      region (get (get node :evaluation) :region)
                      caller (get (get node :evaluation) :owner-function-syntax-id)]
                  (if (> work budget) {:status :rejected :reason :vector-slice-work-limit :work-count work}
                    (if (if (p15-s23-sse-ids? [(get owner :form-id) (get owner :syntax-id) (get op-form :form-id) (get op-form :syntax-id)
                                   (get binding :definition-syntax-id)] 5)
                          (if (p15-s23-sse-ids? (get owner :child-form-ids) 2)
                            (if (if (symbol? (get binding :name)) (symbol? (get op-form :value)) false)
                              (if (if (vector? profiles) (vector? targets) false)
                                (if (loop [remaining profiles] (if (= 0 (count remaining)) true
                                      (if (keyword? (first remaining)) (recur (rest remaining)) false)))
                                  (if (loop [remaining targets] (if (= 0 (count remaining)) true
                                        (if (keyword? (first remaining)) (recur (rest remaining)) false)))
                                    (if (keyword? region) (if (= nil caller) true (p15-s23-sse-ids? [caller] 1)) false) false) false) false) false) false) false)
                      (if (p15-s23-typed-all [
                            (= :call (get node :core-form)) (= :reference (get operator :core-form))
                            (= [(get operator :node-id) (get slice-node :node-id)] ids)
                            (= (get node :node-id) expected-id)
                            (= [] (get operator :children)) (= [bid] (get node :resolved-binding-ids) (get operator :resolved-binding-ids))
                            (= {:symbol (get (get operator :attributes) :symbol) :position :operator :binding-id bid :binding-class :core
                                :definition-syntax-id (get binding :definition-syntax-id)} (get operator :attributes))
                            (contains? '#{first gravity.core/first} (get (get operator :attributes) :symbol))
                            (= 'first (get binding :name)) (p15-s23-lq-binding? binding (get core :module))
                            (= {:operator-child-index 0 :argument-count 1 :argument-child-indexes [1]
                                :evaluation-order :operator-then-arguments :dispatch :resolved-symbol-call} (get node :attributes))
                            (= :operator-then-arguments (get (get node :evaluation) :kind))
                            (= [{:index 0 :core-node-id (get operator :node-id)} {:index 1 :core-node-id (get slice-node :node-id)}]
                               (get (get node :evaluation) :order))
                            (= [] (get (get operator :evaluation) :order))
                            (contains? #{:module-initialization :function-body} region)
                            (= region (get (get let-node :evaluation) :region) (get (get slice-node :evaluation) :region))
                            (= caller (get (get slice-node :evaluation) :owner-function-syntax-id) (get (get let-node :evaluation) :owner-function-syntax-id))
                            (= :list (get owner :kind)) (= :symbol (get op-form :kind)) (= [] (get op-form :child-form-ids))
                            (= (get (get operator :attributes) :symbol) (get op-form :value))
                            (= [(get op-form :form-id) (get (get slice-node :source) :form-id)] (get owner :child-form-ids))
                            (= (get owner :form-id) (get op-form :parent-form-id))
                            (= (get node :source) (p15-s23-typed-source owner)) (= (get operator :source) (p15-s23-typed-source op-form))
                            (= scope (get node :binding-context) (get operator :binding-context) (get owner :scope-id) (get op-form :scope-id))])
                        {:status :accepted :work-count work :node node :form owner :source-forms [owner op-form]
                         :proof {:kind :direct-vector-first :node node :operator operator :binding binding :source-forms [owner op-form]}}
                        {:status :rejected :reason :vector-slice-source-mismatch :work-count work})
                      {:status :rejected :reason :vector-slice-source-mismatch :work-count work})))
                {:status :rejected :reason :vector-slice-source-mismatch :work-count base}))
            {:status :rejected :reason :vector-slice-source-mismatch :work-count base}))))

(defn p15-s23-vsl-let-first-body [core let-node slice-node nodes bindings forms budget]
  ; The original direct-first entry retains its inputs, proof and logical work.
  (let [base 128 children (get let-node :children)]
    (if (> base budget) {:status :rejected :reason :vector-slice-work-limit :work-count base}
      (if (p15-s23-sse-ids? children 2)
        (p15-s23-vsl-first-parent core let-node (get nodes (get children 1)) (get children 1) slice-node nodes bindings forms budget)
        {:status :rejected :reason :vector-slice-source-mismatch :work-count base}))))

(defn p15-s23-vsl-character-set [node parent scope region caller nodes forms budget]
  ; Original flat Character Set source only; this emits no member-type fact.
  (let [ids (get node :children) n (if (vector? ids) (count ids) 0) work (+ 128 (* 32 n))]
    (if (> work budget) {:status :rejected :reason :vector-slice-work-limit :work-count work}
      (if (> n 1024) {:status :rejected :reason :vector-slice-source-mismatch :work-count work}
        (if (if (p15-s23-sse-ids? [(get node :node-id) (get (get node :source) :form-id) (get (get node :source) :syntax-id) parent scope] 5)
              (if (keyword? region) (if (if (= nil caller) true (p15-s23-sse-ids? [caller] 1))
                (if (vector? ids) (loop [remaining ids] (if (= 0 (count remaining)) true
                  (if (p15-s23-sse-ids? [(first remaining)] 1) (recur (rest remaining)) false))) false) false) false) false)
          (let [form (get forms (get (get node :source) :form-id)) attrs (get node :attributes)
                values (get form :value) source-values (get attrs :source-value) source-ids (get form :child-form-ids)
                node-caller (get (get node :evaluation) :owner-function-syntax-id)]
            (if (if (p15-s23-sse-ids? [(get form :form-id) (get form :syntax-id) (get form :parent-form-id) (get form :scope-id)] 4)
                  (if (if (= nil node-caller) true (p15-s23-sse-ids? [node-caller] 1))
                    (if (if (vector? source-ids) (= n (count source-ids)) false)
                      (if (loop [remaining source-ids] (if (= 0 (count remaining)) true
                            (if (p15-s23-sse-ids? [(first remaining)] 1) (recur (rest remaining)) false)))
                        (if (if (set? values) (set? source-values) false)
                          (if (if (<= (count values) n) (<= (count source-values) n) false)
                            (if (loop [members (vec values) i 0] (if (= i (count members)) true
                                  (if (char? (get members i)) (recur members (+ i 1)) false)))
                              (loop [members (vec source-values) i 0] (if (= i (count members)) true
                                (if (char? (get members i)) (recur members (+ i 1)) false))) false) false) false) false) false) false) false)
              (if (p15-s23-typed-all [
                    (contains? #{:module-initialization :function-body} region)
                    (= :collection-literal (get node :core-form)) (= [] (get node :resolved-binding-ids))
                    (= {:literal-kind :set :element-count n :source-value source-values} attrs)
                    (= :left-to-right (get (get node :evaluation) :kind))
                    (= (loop [i 0 out []] (if (= i n) out (recur (+ i 1) (conj out {:index i :core-node-id (get ids i)}))))
                       (get (get node :evaluation) :order))
                    (= scope (get node :binding-context) (get form :scope-id))
                    (= region (get (get node :evaluation) :region)) (= caller node-caller)
                    (= :set (get form :kind)) (= parent (get form :parent-form-id))
                    (= (get node :source) (p15-s23-typed-source form))])
                (loop [i 0 selected [form] members [] seen #{} seen-forms #{(get form :form-id)}]
                  (if (= i n)
                    ; L1/C2 uniqueness is checked after the complete physical Character census.
                    (if (if (= n (count values) (count source-values)) (= (set members) values source-values) false)
                      {:status :accepted :work-count work :node node :form form :source-forms selected}
                      {:status :rejected :reason :vector-slice-source-mismatch :work-count work})
                    (let [id (get ids i) child (get nodes id) source (get child :source)]
                      (if (if (p15-s23-sse-ids? [id (get child :node-id) (get source :form-id) (get source :syntax-id)] 4)
                            (if (= false (contains? seen id)) (= false (contains? seen-forms (get source :form-id))) false) false)
                        (let [original (get forms (get source :form-id)) value (get (get child :attributes) :value)
                              child-caller (get (get child :evaluation) :owner-function-syntax-id)]
                          (if (if (p15-s23-sse-ids? [(get original :form-id) (get original :syntax-id) (get original :parent-form-id) (get original :scope-id)] 4)
                                (if (if (= nil child-caller) true (p15-s23-sse-ids? [child-caller] 1))
                                  (if (char? value) (char? (get original :value)) false) false) false)
                            (if (p15-s23-typed-all [
                                  (= id (get child :node-id)) (= (get source-ids i) (get original :form-id))
                                  (= :literal (get child :core-form)) (= {:literal-kind :character :value value} (get child :attributes))
                                  (= [] (get child :children) (get child :resolved-binding-ids) (get original :child-form-ids))
                                  (= :character (get original :kind)) (= value (get original :value))
                                  (= source (p15-s23-typed-source original)) (= (get form :form-id) (get original :parent-form-id))
                                  (= scope (get child :binding-context) (get original :scope-id))
                                  (= :value (get (get child :evaluation) :kind)) (= [] (get (get child :evaluation) :order))
                                  (= region (get (get child :evaluation) :region)) (= caller child-caller)])
                              (recur (+ i 1) (conj selected original) (conj members value) (conj seen id) (conj seen-forms (get source :form-id)))
                              {:status :rejected :reason :vector-slice-source-mismatch :work-count work})
                            {:status :rejected :reason :vector-slice-source-mismatch :work-count work}))
                        {:status :rejected :reason :vector-slice-source-mismatch :work-count work}))))
                {:status :rejected :reason :vector-slice-source-mismatch :work-count work})
              {:status :rejected :reason :vector-slice-source-mismatch :work-count work}))
          {:status :rejected :reason :vector-slice-source-mismatch :work-count work})))))

(defn p15-s23-vsl-let-first-membership-body [core let-node slice-node nodes bindings forms budget]
  ; Exactly contains?(original Character Set, first(actual slice)); no ancestry walk.
  (let [base 128 root-ids (get let-node :children)]
    (if (> base budget) {:status :rejected :reason :vector-slice-work-limit :work-count base}
      (if (p15-s23-sse-ids? root-ids 2)
        (let [node (get nodes (get root-ids 1)) children (get node :children)]
          (if (if (p15-s23-sse-ids? children 3)
                (p15-s23-sse-ids? [(get node :node-id) (get (get node :source) :form-id) (get (get node :source) :syntax-id)] 3) false)
            (let [operator (get nodes (get children 0)) items (get nodes (get children 1)) first-node (get nodes (get children 2))
                  bid (get (get operator :attributes) :binding-id) scope (get (get let-node :attributes) :body-scope-id)]
              (if (if (p15-s23-sse-ids? [(get operator :node-id) bid (get items :node-id) (get first-node :node-id) scope] 5)
                    (if (p15-s23-sse-ids? [(get (get operator :source) :form-id) (get (get operator :source) :syntax-id)
                               (get (get items :source) :form-id) (get (get items :source) :syntax-id)
                               (get (get first-node :source) :form-id) (get (get first-node :source) :syntax-id)] 6)
                      (symbol? (get (get operator :attributes) :symbol)) false) false)
                (let [binding (get bindings bid) owner (get forms (get (get node :source) :form-id))
                      op-form (get forms (get (get operator :source) :form-id)) first-form (get forms (get (get first-node :source) :form-id))
                      profiles (get binding :profile-set) targets (get binding :target-set)
                      work (+ base (if (vector? profiles) (* 2 (count profiles)) 0) (if (vector? targets) (* 2 (count targets)) 0))
                      region (get (get node :evaluation) :region) caller (get (get node :evaluation) :owner-function-syntax-id)
                      first-caller (get (get first-node :evaluation) :owner-function-syntax-id)]
                  (if (> work budget) {:status :rejected :reason :vector-slice-work-limit :work-count work}
                    (if (if (p15-s23-sse-ids? [(get owner :form-id) (get owner :syntax-id) (get op-form :form-id) (get op-form :syntax-id)
                                   (get first-form :form-id) (get first-form :syntax-id)] 6)
                          (if (p15-s23-sse-ids? [(get binding :definition-syntax-id) (get first-form :parent-form-id) (get first-form :scope-id)
                                     (get owner :scope-id) (get op-form :scope-id)] 5)
                            (if (p15-s23-sse-ids? (get owner :child-form-ids) 3)
                              (if (if (symbol? (get binding :name)) (symbol? (get op-form :value)) false)
                                (if (if (vector? profiles) (vector? targets) false)
                                  (if (loop [remaining profiles] (if (= 0 (count remaining)) true
                                        (if (keyword? (first remaining)) (recur (rest remaining)) false)))
                                    (if (loop [remaining targets] (if (= 0 (count remaining)) true
                                          (if (keyword? (first remaining)) (recur (rest remaining)) false)))
                                      (if (keyword? region) (if (if (= nil caller) true (p15-s23-sse-ids? [caller] 1))
                                        (if (= nil first-caller) true (p15-s23-sse-ids? [first-caller] 1)) false) false) false) false) false) false) false) false) false)
                      (if (p15-s23-typed-all [
                            (= :call (get node :core-form)) (= :reference (get operator :core-form))
                            (= (get node :node-id) (get root-ids 1))
                            (= [(get operator :node-id) (get items :node-id) (get first-node :node-id)] children)
                            (= [] (get operator :children)) (= [bid] (get node :resolved-binding-ids) (get operator :resolved-binding-ids))
                            (= {:symbol (get (get operator :attributes) :symbol) :position :operator :binding-id bid :binding-class :core
                                :definition-syntax-id (get binding :definition-syntax-id)} (get operator :attributes))
                            (contains? '#{contains? gravity.core/contains?} (get (get operator :attributes) :symbol))
                            (= 'contains? (get binding :name)) (p15-s23-mc-binding? binding (get core :module))
                            (= {:operator-child-index 0 :argument-count 2 :argument-child-indexes [1 2]
                                :evaluation-order :operator-then-arguments :dispatch :resolved-symbol-call} (get node :attributes))
                            (= :operator-then-arguments (get (get node :evaluation) :kind))
                            (= [{:index 0 :core-node-id (get operator :node-id)} {:index 1 :core-node-id (get items :node-id)}
                                {:index 2 :core-node-id (get first-node :node-id)}] (get (get node :evaluation) :order))
                            (= [] (get (get operator :evaluation) :order))
                            (contains? #{:module-initialization :function-body} region)
                            (= region (get (get first-node :evaluation) :region)) (= caller first-caller)
                            (= :list (get owner :kind)) (= :symbol (get op-form :kind)) (= [] (get op-form :child-form-ids))
                            (= (get (get operator :attributes) :symbol) (get op-form :value))
                            (= [(get op-form :form-id) (get (get items :source) :form-id) (get first-form :form-id)] (get owner :child-form-ids))
                            (= (get owner :form-id) (get op-form :parent-form-id) (get first-form :parent-form-id))
                            (= (get node :source) (p15-s23-typed-source owner)) (= (get operator :source) (p15-s23-typed-source op-form))
                            (= (get first-node :source) (p15-s23-typed-source first-form))
                            (= scope (get node :binding-context) (get operator :binding-context) (get first-node :binding-context)
                                     (get owner :scope-id) (get op-form :scope-id) (get first-form :scope-id))])
                        (let [literal (p15-s23-vsl-character-set items (get owner :form-id) scope region caller nodes forms (- budget work))
                              work (+ work (get literal :work-count))]
                          (if (= :accepted (get literal :status))
                            (let [first-parent (p15-s23-vsl-first-parent core let-node first-node (get children 2) slice-node nodes bindings forms (- budget work))
                                  work (+ work (get first-parent :work-count))]
                              (if (= :accepted (get first-parent :status))
                                (let [container-forms (loop [remaining (get literal :source-forms) out [owner op-form]]
                                                        (if (= 0 (count remaining)) out (recur (rest remaining) (conj out (first remaining)))))
                                      selected (loop [remaining (get first-parent :source-forms) out container-forms]
                                                 (if (= 0 (count remaining)) out (recur (rest remaining) (conj out (first remaining)))))]
                                  {:status :accepted :work-count work :node node :form owner :source-forms selected
                                   :proof (assoc (get first-parent :proof) :kind :direct-character-set-first-membership :source-forms selected
                                            :membership-container {:kind :character-set-membership :node node :operator operator :binding binding
                                                                   :set-node items :source-forms container-forms})})
                                (assoc first-parent :work-count work)))
                            (assoc literal :work-count work)))
                        {:status :rejected :reason :vector-slice-source-mismatch :work-count work})
                      {:status :rejected :reason :vector-slice-source-mismatch :work-count work})))
                {:status :rejected :reason :vector-slice-source-mismatch :work-count base}))
            {:status :rejected :reason :vector-slice-source-mismatch :work-count base}))
        {:status :rejected :reason :vector-slice-source-mismatch :work-count base}))))

(defn p15-s23-vsl-let-call-body [core let-node slice-node nodes bindings forms budget]
  ; Retain the original direct let/body proof, including its existing work count.
  (let [calls (get core :calls) edges (get core :call-edges) records (get core :function-records) definitions (get core :definitions)
        base (+ 256 (* 8 (+ (if (vector? calls) (count calls) 0) (if (vector? edges) (count edges) 0)
                            (if (vector? records) (count records) 0) (if (vector? definitions) (count definitions) 0))))
        ids (get let-node :children)]
    (if (> base budget) {:status :rejected :reason :vector-slice-work-limit :work-count base}
      (if (p15-s23-sse-ids? ids 2)
        (p15-s23-vsl-call-body core let-node let-node (get nodes (get ids 1)) slice-node nodes bindings forms budget)
        {:status :rejected :reason :vector-slice-source-mismatch :work-count base}))))

(defn p15-s23-vsl-let-equality-body [core let-node slice-node nodes bindings types forms budget]
  ; One fixed parent edge. The enclosing VE still proves its own operand domain.
  (let [children (get let-node :children) base 64]
    (if (> base budget) {:status :rejected :reason :vector-slice-work-limit :work-count base}
      (if (p15-s23-sse-ids? children 2)
        (let [root (get nodes (get children 1)) first-consumer? (if (vector? (get root :children)) (= 2 (count (get root :children))) false)
              membership-consumer? (if (p15-s23-sse-ids? (get root :children) 3)
                                     (let [left (get nodes (get (get root :children) 1))]
                                       (if (= :collection-literal (get left :core-form)) (= :set (get (get left :attributes) :literal-kind)) false)) false)
              local-call-consumer? (if (p15-s23-sse-ids? (get root :children) 2)
                                  (let [operator (get nodes (get (get root :children) 0))
                                        bid (get (get operator :attributes) :binding-id)]
                                    (if (p15-s23-sse-ids? [bid] 1)
                                      (= [:namespace :function] [(get (get bindings bid) :binding-class) (get (get bindings bid) :kind)]) false)) false)
              conditional? (= :if (get root :core-form))
              then-node (if (if conditional? (p15-s23-sse-ids? (get root :children) 3) false)
                          (get nodes (get (get root :children) 1)) nil)
              then-ids (get then-node :children)
              call-branch? (if (p15-s23-sse-ids? then-ids 2) (= :call (get then-node :core-form)) false)
              conditional-call-consumer? (if call-branch? (if (p15-s23-sse-ids? [(get slice-node :node-id)] 1)
                                            (= (get slice-node :node-id) (get then-ids 1)) false) false)
              base (+ base (if call-branch? 32 0))
              container (if conditional? (if conditional-call-consumer? nil
                          (if call-branch? (p15-s23-vsl-if-container core let-node root nodes bindings forms true (- budget base))
                            (p15-s23-vsl-prefix-if core let-node root nodes forms (- budget base)))) nil)
              container-work (if conditional? (if conditional-call-consumer? 0 (get container :work-count)) 0)
              node (if conditional? (get container :condition) root) children (get node :children)]
          (if conditional-call-consumer?
            (let [selected (p15-s23-vsl-prefix-call-body core let-node slice-node nodes bindings types forms (- budget base))]
              (assoc selected :work-count (+ base (get selected :work-count))))
            (if local-call-consumer?
            (let [selected (p15-s23-vsl-let-call-body core let-node slice-node nodes bindings forms (- budget base))]
              (assoc selected :work-count (+ base (get selected :work-count))))
            (if first-consumer?
            (let [selected (p15-s23-vsl-let-first-body core let-node slice-node nodes bindings forms (- budget base))]
              (assoc selected :work-count (+ base (get selected :work-count))))
            (if membership-consumer?
              (let [selected (p15-s23-vsl-let-first-membership-body core let-node slice-node nodes bindings forms (- budget base))]
                (assoc selected :work-count (+ base (get selected :work-count))))
              (if (if conditional? (= :accepted (get container :status)) true)
            (if (if (p15-s23-sse-ids? children 3)
                (p15-s23-sse-ids? [(get node :node-id) (get (get node :source) :form-id) (get (get node :source) :syntax-id)] 3) false)
            (let [operator (get nodes (get children 0)) right (get nodes (get children 2))
                  ids (get right :children) n (if (vector? ids) (count ids) 0) work (+ 128 container-work (* 32 n))
                  bid (get (get operator :attributes) :binding-id)]
              (if (> work budget) {:status :rejected :reason :vector-slice-work-limit :work-count work}
                (if (> n 1024) {:status :rejected :reason :vector-slice-source-mismatch :work-count work}
                  (if (if (if (vector? ids)
                              (loop [remaining ids] (if (= 0 (count remaining)) true
                                (if (p15-s23-sse-ids? [(first remaining)] 1) (recur (rest remaining)) false))) false)
                        (if (p15-s23-sse-ids? [(get operator :node-id) (get right :node-id) bid] 3)
                          (if (p15-s23-sse-ids? [(get (get operator :source) :form-id) (get (get operator :source) :syntax-id)
                                     (get (get right :source) :form-id) (get (get right :source) :syntax-id)] 4)
                            (symbol? (get (get operator :attributes) :symbol)) false) false) false)
                    (let [owner (get forms (get (get node :source) :form-id))
                          op-form (get forms (get (get operator :source) :form-id))
                          right-form (get forms (get (get right :source) :form-id)) binding (get bindings bid)
                          values (get right-form :value) attrs (get right :attributes) source-values (get attrs :source-value)
                          scope (get (get let-node :attributes) :body-scope-id)
                          profiles (get binding :profile-set) targets (get binding :target-set)
                          work (+ work (if (vector? profiles) (* 2 (count profiles)) 0) (if (vector? targets) (* 2 (count targets)) 0))]
                      (if (> work budget) {:status :rejected :reason :vector-slice-work-limit :work-count work}
                        (if (if (p15-s23-sse-ids? [(get owner :form-id) (get owner :syntax-id) (get op-form :form-id) (get op-form :syntax-id)
                                     (get right-form :form-id) (get right-form :syntax-id)] 6)
                            (if (p15-s23-sse-ids? (get owner :child-form-ids) 3)
                              (if (if (vector? (get right-form :child-form-ids))
                                    (if (= n (count (get right-form :child-form-ids)))
                                      (loop [remaining (get right-form :child-form-ids)] (if (= 0 (count remaining)) true
                                        (if (p15-s23-sse-ids? [(first remaining)] 1) (recur (rest remaining)) false))) false) false)
                                (if (if (vector? values) (vector? source-values) false)
                                  (if (p15-s23-sse-ids? [scope (get binding :definition-syntax-id)] 2)
                                    (if (if (symbol? (get op-form :value)) (symbol? (get binding :name)) false)
                                      (if (if (vector? profiles) (vector? targets) false)
                                        (if (loop [remaining profiles] (if (= 0 (count remaining)) true
                                              (if (keyword? (first remaining)) (recur (rest remaining)) false)))
                                          (if (loop [remaining targets] (if (= 0 (count remaining)) true
                                                (if (keyword? (first remaining)) (recur (rest remaining)) false)))
                                            (= n (count values) (count source-values)) false) false) false) false) false) false) false) false) false)
                        (if (p15-s23-typed-all [
                              (= :call (get node :core-form)) (= :reference (get operator :core-form))
                              (= [(get operator :node-id) (get slice-node :node-id) (get right :node-id)] children)
                              (= [bid] (get node :resolved-binding-ids) (get operator :resolved-binding-ids))
                              (= [] (get operator :children))
                              (= {:symbol (get (get operator :attributes) :symbol) :position :operator :binding-id bid :binding-class :core
                                  :definition-syntax-id (get binding :definition-syntax-id)} (get operator :attributes))
                              (contains? '#{= gravity.core/=} (get (get operator :attributes) :symbol))
                              (p15-s23-ae-binding? binding (get core :module))
                              (= {:operator-child-index 0 :argument-count 2 :argument-child-indexes [1 2]
                                  :evaluation-order :operator-then-arguments :dispatch :resolved-symbol-call} (get node :attributes))
                              (= :operator-then-arguments (get (get node :evaluation) :kind))
                              (= [{:index 0 :core-node-id (get operator :node-id)} {:index 1 :core-node-id (get slice-node :node-id)}
                                  {:index 2 :core-node-id (get right :node-id)}] (get (get node :evaluation) :order))
                              (= (get (get node :evaluation) :owner-function-syntax-id) (get (get slice-node :evaluation) :owner-function-syntax-id))
                              (= :list (get owner :kind)) (= :symbol (get op-form :kind))
                              (symbol? (get op-form :value)) (= (get (get operator :attributes) :symbol) (get op-form :value))
                              (= [] (get op-form :child-form-ids))
                              (= [(get op-form :form-id) (get (get slice-node :source) :form-id) (get right-form :form-id)] (get owner :child-form-ids))
                              (= (get owner :form-id) (get op-form :parent-form-id) (get right-form :parent-form-id))
                              (= (get node :source) (p15-s23-typed-source owner)) (= (get operator :source) (p15-s23-typed-source op-form))
                              (= (get right :source) (p15-s23-typed-source right-form))
                              (= scope (get node :binding-context) (get operator :binding-context) (get right :binding-context)
                                       (get owner :scope-id) (get op-form :scope-id) (get right-form :scope-id))
                              (= :collection-literal (get right :core-form)) (= [] (get right :resolved-binding-ids))
                              (= :vector (get right-form :kind))
                              (= {:literal-kind :vector :element-count n :source-value source-values} attrs)
                              (= :left-to-right (get (get right :evaluation) :kind))
                              (= (loop [i 0 out []] (if (= i n) out (recur (+ i 1) (conj out {:index i :core-node-id (get ids i)}))))
                                 (get (get right :evaluation) :order))])
                          (loop [i 0 selected (loop [remaining (if conditional? (get container :source-forms) []) out [owner op-form right-form]]
                                               (if (= 0 (count remaining)) out (recur (rest remaining) (conj out (first remaining))))) members [] seen #{} seen-forms #{(get right-form :form-id)}]
                            (if (= i n)
                              (let [expected {:kind :gravity.type/vector :shape :literal :element-types members}
                                    actual (get types (get right :node-id) :gravity.type/unknown)]
                                ; A cold left operand cannot borrow a future RHS type. VE must establish it later.
                                (if (if (= :gravity.type/unknown actual) true (= expected actual))
                                  {:status :accepted :work-count work :node (if conditional? root node) :form (if conditional? (get container :form) owner) :source-forms selected
                                   :proof (let [proof {:kind :direct-left-vector-equality :node node :operator operator :binding binding :right right
                                           :literal-type expected :source-forms selected}] (if conditional? (assoc proof :condition-container (get container :proof)) proof))}
                                  {:status :rejected :reason :vector-slice-source-mismatch :work-count work}))
                              (let [id (get ids i) child (get nodes id) source (get child :source)]
                                (if (if (p15-s23-sse-ids? [id (get source :form-id) (get source :syntax-id)] 3)
                                      (if (= false (contains? seen id)) (= false (contains? seen-forms (get source :form-id))) false) false)
                                  (let [form (get forms (get source :form-id)) value (get (get child :attributes) :value)
                                        kind (get (get child :attributes) :literal-kind)
                                        valid? (if (p15-s23-sse-ids? [(get form :form-id) (get form :syntax-id) (get form :parent-form-id) (get form :scope-id)] 4)
                                                 (if (= :integer kind)
                                                 (if (integer? value) (if (integer? (get form :value))
                                                   (if (integer? (get values i)) (integer? (get source-values i)) false) false) false)
                                                 (if (= :character kind) (if (char? value) (if (char? (get form :value))
                                                   (if (char? (get values i)) (char? (get source-values i)) false) false) false) false)) false)]
                                    (if (if valid? (p15-s23-typed-all [
                                          (= id (get child :node-id)) (= (get (get right-form :child-form-ids) i) (get form :form-id))
                                          (= :literal (get child :core-form)) (= {:literal-kind kind :value value} (get child :attributes))
                                          (= [] (get child :children) (get child :resolved-binding-ids) (get form :child-form-ids))
                                          (= kind (get form :kind)) (= source (p15-s23-typed-source form))
                                          (= value (get form :value) (get values i) (get source-values i))
                                          (= (get right-form :form-id) (get form :parent-form-id)) (= scope (get form :scope-id))
                                          (= :value (get (get child :evaluation) :kind)) (= [] (get (get child :evaluation) :order))]) false)
                                      (recur (+ i 1) (conj selected form) (conj members (if (= :integer kind) :gravity.type/integer :gravity.type/character))
                                             (conj seen id) (conj seen-forms (get source :form-id)))
                                      {:status :rejected :reason :vector-slice-source-mismatch :work-count work}))
                                  {:status :rejected :reason :vector-slice-source-mismatch :work-count work}))))
                          {:status :rejected :reason :vector-slice-source-mismatch :work-count work})
                        {:status :rejected :reason :vector-slice-source-mismatch :work-count work})))
                    {:status :rejected :reason :vector-slice-source-mismatch :work-count work}))))
            {:status :rejected :reason :vector-slice-source-mismatch :work-count base})
            (assoc container :work-count (+ base container-work))))))))
        {:status :rejected :reason :vector-slice-source-mismatch :work-count base}))))

(defn p15-s23-vsl-parameter [core slice-node reference nodes bindings types forms budget]
  ; The owning function slot is an existing typing premise. Whole-product C7
  ; verification dominates the cold C8/lowering consumers of this local rule.
  (let [records (get core :function-records) mutations (get core :mutations [])
        owner (get (get reference :evaluation) :owner-function-syntax-id)
        bid (get (get reference :attributes) :binding-id)
        base (+ 128 (* 8 (if (vector? records) (count records) 0))
                    (* 2 (if (vector? mutations) (count mutations) 0)))]
    (if (> base budget) {:status :rejected :reason :vector-slice-work-limit :work-count base}
      (if (= nil owner) {:status :not-applicable :work-count base}
        (if (if (if (vector? records) (vector? mutations) false)
              (p15-s23-sse-ids? [owner bid (get reference :node-id)] 3) false)
          (if (loop [rows records]
                (if (= 0 (count rows)) true
                  (if (p15-s23-sse-ids? [(get (first rows) :function-syntax-id) (get (first rows) :function-core-node-id)] 2)
                    (recur (rest rows)) false)))
            (let [record (p15-s23-nq-one records :function-syntax-id owner)
                  params (get record :parameter-binding-ids)]
              (if (if (p15-s23-sse-ids? params 1) (= [bid] params) false)
                (let [fn-node (get nodes (get record :function-core-node-id))
                      function (get types (get record :function-core-node-id))
                      parameters (get function :parameters)
                      slot (if (vector? parameters) (if (= 1 (count parameters)) (get parameters 0) nil) nil)
                      binding (get bindings bid) type (get types (get reference :node-id))
                      members (if (map? type) (get type :element-types) nil)
                      n (if (vector? members) (count members) 0)
                      work (+ base (* 16 (+ n 1)))]
                  (if (> work budget) {:status :rejected :reason :vector-slice-work-limit :work-count work}
                    (if (> n 1024) {:status :rejected :reason :vector-slice-receiver-proof-required :work-count work}
                      (let [validation (p15-s23-lc-validate-types [type (get slot :type)])
]
                        (if (= false (= :accepted (get validation :status)))
                          {:status :rejected :reason :vector-slice-receiver-proof-required :work-count work}
                          (if (if (p15-s23-sse-ids? [(get (get fn-node :source) :form-id) (get (get fn-node :source) :syntax-id)
                                      (get (get fn-node :attributes) :parameter-form-id) (get binding :definition-syntax-id)
                                      (get binding :scope-id) (get reference :binding-context)] 6)
                                (p15-s23-sse-ids? [(get (get reference :source) :form-id) (get (get reference :source) :syntax-id)
                                      (get (get slice-node :source) :form-id) (get slice-node :node-id)] 4) false)
                            (let [fn-form (get forms (get (get fn-node :source) :form-id))
                                  ids (get fn-form :child-form-ids)
                                  parameter-form (get forms (get (get fn-node :attributes) :parameter-form-id))
                                  names (get parameter-form :child-form-ids)]
                              (if (if (p15-s23-sse-ids? ids 3) (p15-s23-sse-ids? names 1) false)
                                (let [operator (get forms (get ids 0)) name-form (get forms (get names 0))
                                      ref-form (get forms (get (get reference :source) :form-id))
                                      scope (get binding :scope-id)]
                                  (if (if (symbol? (get binding :name))
                                        (if (= nil (get binding :mutability)) true (keyword? (get binding :mutability))) false)
                                  (if (p15-s23-typed-all
                                        [(= :accepted (get validation :status))
                                         (= {:kind :gravity.type/vector :shape :literal :element-types members} type)
                                         (= :gravity/c7-function-type (get function :artifact))
                                         (= :inferred (get function :status))
                                         (= owner (get function :function-id) (get record :function-syntax-id) (get fn-form :syntax-id))
                                         (= (get record :function-core-node-id) (get fn-node :node-id) (get function :function-core-node-id))
                                         (p15-s23-sse-ids? (get function :parameter-binding-ids) 1)
                                         (p15-s23-sse-ids? (get fn-node :resolved-binding-ids) 1)
                                         (= params (get function :parameter-binding-ids) (get fn-node :resolved-binding-ids))
                                         (= 1 (get function :fixed-arity) (get record :fixed-arity))
                                         (= nil (get record :signature) (get function :signature) (get (get fn-node :attributes) :signature))
                                         (= :fn (get fn-node :core-form)) (p15-s23-sse-ids? (get fn-node :children) 1)
                                         (= [(get slice-node :node-id)] (get fn-node :children))
                                         (= :call (get (get nodes (get (get slice-node :children) 3)) :core-form))
                                         (= (get slice-node :node-id) (get record :body-core-node-id) (get function :body-core-node-id))
                                         (= :list (get fn-form :kind)) (= :symbol (get operator :kind)) (= 'fn (get operator :value))
                                         (= [] (get operator :child-form-ids))
                                         (= [(get operator :form-id) (get parameter-form :form-id) (get (get slice-node :source) :form-id)] ids)
                                         (= (get fn-form :form-id) (get record :function-form-id) (get operator :parent-form-id)
                                              (get parameter-form :parent-form-id) (get (get forms (get (get slice-node :source) :form-id)) :parent-form-id))
                                         (= :vector (get parameter-form :kind))
                                         (= (get parameter-form :syntax-id) (get (get fn-node :attributes) :parameter-syntax-id))
                                         (= (get parameter-form :form-id) (get name-form :parent-form-id))
                                         (= :symbol (get name-form :kind) (get ref-form :kind))
                                         (= [] (get name-form :child-form-ids) (get ref-form :child-form-ids))
                                         (symbol? (get binding :name))
                                         (if (vector? (get parameter-form :value)) (= 1 (count (get parameter-form :value))) false)
                                         (if (vector? (get (get fn-node :attributes) :parameters)) (= 1 (count (get (get fn-node :attributes) :parameters))) false)
                                         (= [(get binding :name)] (get parameter-form :value) (get (get fn-node :attributes) :parameters))
                                         (= (get binding :name) (get name-form :value) (get ref-form :value))
                                         (= (get binding :definition-syntax-id) (get name-form :syntax-id))
                                         (= [:lexical :local] [(get binding :binding-class) (get binding :kind)])
                                         (= bid (get binding :binding-id) (get slot :binding-id))
                                         (if (vector? (get function :parameters)) (= 1 (count (get function :parameters))) false)
                                         (if (map? slot) (if (= 2 (count slot))
                                           (if (loop [fields (keys slot)] (if (= 0 (count fields)) true
                                                 (if (keyword? (first fields)) (recur (rest fields)) false)))
                                             (= #{:binding-id :type} (set (keys slot))) false) false) false)
                                         (= type (get slot :type))
                                         (contains? #{nil :immutable} (get binding :mutability))
                                         (= :reference (get reference :core-form)) (= [] (get reference :children))
                                         (= [bid] (get reference :resolved-binding-ids))
                                         (= {:symbol (get binding :name) :position :expression :binding-id bid :binding-class :lexical
                                             :definition-syntax-id (get binding :definition-syntax-id)} (get reference :attributes))
                                         (= (get reference :source) (p15-s23-ix-form-source ref-form))
                                         (= (get fn-node :source) (p15-s23-ix-form-source fn-form))
                                         (= scope (get name-form :scope-id) (get ref-form :scope-id) (get reference :binding-context)
                                                  (get slice-node :binding-context))
                                         (= :function-body (get (get reference :evaluation) :region) (get (get slice-node :evaluation) :region))
                                         (= owner (get (get slice-node :evaluation) :owner-function-syntax-id))
                                         (= :value (get (get reference :evaluation) :kind)) (= [] (get (get reference :evaluation) :order))
                                         (loop [rows mutations]
                                           (if (= 0 (count rows)) true
                                             (if (= bid (get (first rows) :target-binding-id)) false (recur (rest rows)))))])
                                    {:status :accepted :work-count work :type type
                                     :source-forms [fn-form operator parameter-form name-form]
                                     :receiver {:kind :immutable-parameter-vector :reference reference :binding binding :record record
                                                :owner fn-node :parameter-index 0 :parameter-type type}}
                                    {:status :rejected :reason :vector-slice-source-mismatch :work-count work})
                                  {:status :rejected :reason :vector-slice-source-mismatch :work-count work}))
                                {:status :rejected :reason :vector-slice-source-mismatch :work-count work}))
                            {:status :rejected :reason :vector-slice-source-mismatch :work-count work}))))))
                {:status :not-applicable :work-count base}))
            {:status :rejected :reason :vector-slice-source-mismatch :work-count base})
          {:status :rejected :reason :vector-slice-source-mismatch :work-count base})))))

(defn p15-s23-vsl-let [core slice-node reference nodes bindings types forms budget]
  ; One immutable binding, a direct slice or fixed left equality consumer; no parameter origin.
  (let [records (get core :lexical-bindings []) mutations (get core :mutations [])
      work (+ 128 (if (vector? records) (* 8 (count records)) 0) (if (vector? mutations) (* 2 (count mutations)) 0))
      bid (get (get reference :attributes) :binding-id) ]
    (if (> work budget)
      {:status :rejected :reason :vector-slice-work-limit :work-count work}
      (if (if (if (vector? records) (vector? mutations) false)
          (if (p15-s23-sse-ids? [(get reference :node-id) (get (get reference :source) :form-id) (get (get reference :source) :syntax-id) bid (get slice-node :node-id)] 5)
            (p15-s23-sse-ids? [(get (get slice-node :source) :form-id) (get (get slice-node :source) :syntax-id)] 2) false) false)
        (if (if (loop [rows records] (if (= 0 (count rows)) true
                (if (p15-s23-sse-ids? [(get (first rows) :binding-id) (get (first rows) :let-core-node-id)] 2) (recur (rest rows)) false)))
            (loop [rows mutations] (if (= 0 (count rows)) true
                (if (= nil (get (first rows) :target-binding-id)) (recur (rest rows))

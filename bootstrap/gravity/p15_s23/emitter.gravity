                            {:status :rejected :reason :vector-empty-source-mismatch :work-count total})
                          {:status :rejected :reason (get result :reason) :work-count total})))
                    {:status :rejected :reason :vector-empty-source-mismatch :work-count used}))
                (recur (+ index 1) items seen descriptors used))
              {:status :rejected :reason :vector-empty-source-mismatch :work-count used})))))))

(defn p15-s23-vemp-fact-census [facts module descriptors target budget]
  (let [work (* 3 (count facts))]
